openapi: 3.1.0
info:
  title: Berg CRM API
  description: >
    # Knowledge base
      Detailed information about the API can be found in [knowledge base](https://help.bergsystem.pl/pl/)
    # About this document

    The following specification describes REST API for Berg CRM.

    # Versioning

    Specification versioning follows [Semantic Versioning](https://semver.org/)

    # Cloud version vs server version

    There's one specification for both versions as cloud version difference is
    only additional field for tenant identification (X-Tenant).

    # Authorization

    API uses oAuth 2.0 protocol for authorization. To receive an access token, use the `/token` endpoint. <br>

    The `/token` endpoint is the only endpoint with `content-type application/x-www-form-urlencoded`, all others use `application/vnd.api+json`. <br>

    If you use default `machine_to_machine` authorization, you should use the following keys in the POST request to the token endpoint: `client_id`, `client_secret`, `scope`, `grant_type`. All values can be found on the API configuration page.<br>

    If you use `api_all` authorization, you should also send `username` and `password` (without the `x-tenant` header). Details can be found in the Knowledge Base.<br>

    For the Cloud version API, the `X-Tenant` header is required for every request (even for the `/token` endpoint). To obtain it, you should use the `api_all` scope and log in via username and password, or check it on the API configuration page.<br>
    
    # Prevents duplication
    
    Our API includes built-in duplicate protection mechanisms for Customers, Companies, and Employees endpoints to ensure data integrity. This prevents the creation of identical records and helps maintain a clean database. <br>

    However, we understand there may be situations where you need to bypass this protection and force the addition of records, even if they appear to be duplicates. <br>

    To disable the duplicate protection and force the addition of a record, you should use the option `forceAdd = true` within your request. This option is applicable to the Customers, Companies, and Employees endpoints. <br>

    By setting `forceAdd` to `true`, you will instruct the API to ignore the duplicate check and proceed with adding the provided data as a new record. Please use this option judiciously and only when you have a legitimate need to create potentially duplicate entries. <br>

    # Language support

    API supports polish and english language, independently from profile settings. For english results, include `lang = en` in your requests, for example `/person/1/fields?lang=en`.

  version: 0.9.0
servers:
  - url: 'https://app.bergsystem.pl/api'
    description: Production server (currently only example)
security:
  - OAuth2: []
paths:
  /token:
    post:
      summary: Request for authentication token
      requestBody:
        required: true
        content:
          application/x-www-form-urlencoded:
            schema:
              type: object
              required:
                - client_id
                - grant_type
                - scope
              properties:
                client_id:
                  type: string
                  example: api-client
                client_secret:
                  type: string
                  example: secret
                grant_type:
                  type: string
                  enum:
                    - password
                    - refresh_token
                    - authorization_code
                    - client_credentials
                  example: password
                scope:
                  type: string
                username:
                  type: string
                  example: john.doe@bersystem.pl
                  nullable: true
                password:
                  description: if API returns 422 (2fa is enabled) -> password should look like that - `password:code:code_from_sms`
                  type: string
                  example: my_secret or for 2fa, `my_secret:code:1234`
                  nullable: true
                refresh_token:
                  type: string
                  nullable: true
      responses:
        '200':
          description: OK
          content:
            application/json:
              schema:
                type: object
                required:
                  - token_type
                  - expires_in
                  - access_token
                  - refresh_token
                properties:
                  token_type:
                    type: string
                    enum:
                      - Bearer
                  expires_in:
                    type: integer
                    example: 3600
                  access_token:
                    type: string
                    example: very_long_string
                  refresh_token:
                    type: string
                    example: very_long_string2
                  tenant:
                    type: string
                    example: My company
                    description: OPTIONAL - this field is being used on cloud version only
        '400':
          $ref: '#/components/responses/400BadRequest'
        '401':
          $ref: '#/components/responses/401Unauthorized'
        '422':
          description: 2fa is enabled
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'
            application/vnd.api+json:
              schema:
                $ref: '#/components/schemas/Error'
  /customers:
    parameters:
      - $ref: '#/components/parameters/tenant'
    get:
      summary: Get customers list.
      tags:
        - Customers
      parameters:
        - $ref: '#/components/parameters/page_number'
        - $ref: '#/components/parameters/itemsPerPage'
        - in: query
          name: page
          schema:
            type: integer
          required: false
        - $ref: '#/components/parameters/sort'
        - name: filter[id]
          in: query
          description: |
            Filter by customer id.
          schema:
            type: integer
            example: 33
        - name: filter[parentCompany]
          in: query
          description: |
            Filter by parent company name or part of it.
          schema:
            type: string
            example: TheCompany
        - name: filter[firstname]
          in: query
          description: |
            Filter by customer's firstname or part of it.
          schema:
            type: string
            example: Jan
        - name: filter[lastname]
          in: query
          description: |
            Filter by customer's lastname or part of it.
          schema:
            type: string
            example: Kowalski
        - name: filter[city]
          in: query
          description: |
            Filter by customer's city name or part of it. Field "miasto" can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/2).
          schema:
            type: string
            example: Gniezno
        - name: filter[phone]
          in: query
          description: |
            Filter by customer's phone number or part of it. Field "telefon" can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/2).
          schema:
            type: string
            example: '00500500'
        - name: filter[email]
          in: query
          description: |
            Filter by customer's email or part of it. Field can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/2).
          schema:
            type: string
            example: t@op.pl
        - name: filter[stateId]
          in: query
          description: |
            Filter by customer's state id or collection separated by comma.
          schema:
            type: string
            example: '1,2'
        - name: filter[originsId]
          in: query
          description: |
            Filter by customer's origins id or collection separated by comma. 
            IDs and its meaning can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/2) (click on "Pochodzenie").
          schema:
            type: string
            example: '1,5'
        - name: filter[pesel]
          in: query
          description: |
            Filter by customer's PESEL or part of it.
          schema:
            type: string
            example: '41110142824'
        - name: filter[parentUserId]
          in: query
          description: |
            Filter by parent empoloyee's id or collection separated by comma. "Opiekun" (it's id) - can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/2).
          schema:
            type: string
            example: '1,3'
        - name: filter[creationDateFromd]
          in: query
          description: |
            Filter by creation date from (inclusive).
          schema:
            type: string
            format: date
            example: '2020-01-30'
        - name: filter[creationDateTo]
          in: query
          description: |
            Filter by creation date to (inclusive).
          schema:
            type: string
            format: date
            example: '2020-03-30'
        - name: filter[tagId]
          in: query
          description: |
            Filter by tag id or tag ids separated by comma. Field "tagi" - can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/2).
          schema:
            type: string
            example: '2,8,10'
        - name: filter[crmStatusId]
          in: query
          description: |
            Filter by CRM status id or CRM status ids separated by comma. Field "Status CRM" can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/2).
          schema:
            type: string
            example: '2,8,10'
        - name: filter[personalDataProcessingAgreement]
          in: query
          description: >
            Filter customer's by personal data processing agreeement. 0 - for "no", 1 - for "yes". Field can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/2) - "Zgoda na przetwarzanie danych osobowych w celu realizacji i obsługi  umowy/zamówienia".
          schema:
            type: integer
            enum:
              - 0
              - 1
            example: 1
        - name: filter[marketingContentAgreement]
          in: query
          description: >
            Filter customer's by markenting content agreement. 0 - for "no", 1 - for "yes". Field can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/2) - "Zgoda na otrzymywanie informacji marketingowych drogą elektroniczną".
          schema:
            type: integer
            enum:
              - 0
              - 1
            example: 1
        - name: filter[mailSmsMessagesAgreement]
          in: query
          description: >
            Filter customer's by e-mail and SMS messages delivery agreement. 0  for "no", 1 - for "yes". Field can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/2) - "Zgoda na używanie telekomunikacyjnych urządzeń końcowych i automatycznych systemów wywołujących".
          schema:
            type: integer
            enum:
              - 0
              - 1
            example: 1
        - name: filter[commercialContentAgreement]
          in: query
          description: >
            Filter customer's by commercial content delivery agreement. 0 - for  "no", 1 - for "yes". Field can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/2) - "Zgoda na otrzymywanie informacji handlowych drogą elektroniczną".
          schema:
            type: integer
            enum:
              - 0
              - 1
            example: 1
        - name: filter[emailAgreement]
          in: query
          description: >
            Filter customer's by email agreement. 0 - for  "no", 1 - for "yes".
          schema:
            type: integer
            enum:
              - 0
              - 1
            example: 1
        - name: filter[productCategoryId]
          in: query
          description: |
            Filter by customer's product category id or ids separated by comma.
            IDs and its meaning can be found at [Rodzaje produktów](https://app.bergsystem.pl/category/).
          schema:
            type: string
            example: '1,11'
        - name: filter[productProducerId]
          in: query
          description: |
            Filter by customers product producer id or ids separated by comma.
            IDs and its meaning can be found at [Producenci produktów](https://app.bergsystem.pl/producer/).
          schema:
            type: string
            example: '1,11'
        - name: filter[productId]
          in: query
          description: |
            Filter by customers product id or ids separated by comma.
            IDs and its meaning can be found at [Produkty](https://app.bergsystem.pl/product/).
          schema:
            type: string
            example: '1,11'
        - name: filter[contractStatusId]
          in: query
          description: |
            Filter by contract status id or ids separated by comma.
            "Status umowy" (id) can be found at [https://app.bergsystem.pl/contractstate/](https://app.bergsystem.pl/contractstate/)
          schema:
            type: string
            example: '1,11'
        - name: filter[externalId]
          in: query
          description: |
            Filter by customer's externalId or part of it.
          schema:
            type: string
            example: 1234356assd
        - name: filter
          in: query
          description: >-
            Extra fields filter. For example
            ```?filter%5BextraField_myFieldd%5D=myValue```
          schema:
            type: object
            additionalProperties: true
            example:
              extraField_myField: myValue
          style: deepObject
      responses:
        '200':
          $ref: '#/components/responses/CustomersList'
        '400':
          $ref: '#/components/responses/400BadRequest'
        '401':
          $ref: '#/components/responses/401Unauthorized'
        '403':
          $ref: '#/components/responses/403Forbidden'
    post:
      summary: Create customer
      tags:
        - Customers
      requestBody:
        $ref: '#/components/requestBodies/CustomerSave'
      responses:
        '201':
          $ref: '#/components/responses/Customer'
        '400':
          $ref: '#/components/responses/400BadRequest'
        '401':
          $ref: '#/components/responses/401Unauthorized'
        '403':
          $ref: '#/components/responses/403Forbidden'
        '404':
          $ref: '#/components/responses/404NotFound'
  /customers/{customerId}:
    parameters:
      - $ref: '#/components/parameters/tenant'
    get:
      summary: Get customer's data
      tags:
        - Customers
      parameters:
        - name: customerId
          in: path
          description: Customer id
          schema:
            type: integer
            example: 33
          required: true
      responses:
        200:
          $ref: '#/components/responses/Customer'
        400:
          $ref: '#/components/responses/400BadRequest'
        401:
          $ref: '#/components/responses/401Unauthorized'
        403:
          $ref: '#/components/responses/403Forbidden'
    patch:
      summary: Update customer by id.
      tags:
        - Customers
      parameters:
        - name: customerId
          in: path
          description: Customer id
          schema:
            type: integer
            example: 33
          required: true
      requestBody:
        $ref: '#/components/requestBodies/CustomerSave'
      responses:
        '200':
          $ref: '#/components/responses/Customer'
        '400':
          $ref: '#/components/responses/400BadRequest'
        '401':
          $ref: '#/components/responses/401Unauthorized'
        '403':
          $ref: '#/components/responses/403Forbidden'
  /customers/agreements:
    parameters:
      - $ref: '#/components/parameters/tenant'
    get:
      summary: Get all customer agreements
      tags:
        - Customer Agreements
      responses:
        '200':
          $ref: '#/components/responses/RodoList'
        '400':
          $ref: '#/components/responses/400BadRequest'
        '401':
          $ref: '#/components/responses/401Unauthorized'
        '403':
          $ref: '#/components/responses/403Forbidden'
    post:
      summary: Create customer agreement
      tags:
        - Customer Agreements
      requestBody:
        required: true
        content:
          application/vnd.api+json:
            schema:
              type: object
              properties:
                data:
                  type: object
                  properties:
                    attributes:
                      $ref: '#/components/schemas/Rodo'
      responses:
        '201':
          $ref: '#/components/responses/Rodo'
        '400':
          $ref: '#/components/responses/400BadRequest'
        '401':
          $ref: '#/components/responses/401Unauthorized'
        '403':
          $ref: '#/components/responses/403Forbidden'
        '404':
          $ref: '#/components/responses/404NotFound'
  /customers/agreements/{id}:
    parameters:
      - in: path
        name: id
        schema:
          type: integer
        required: true
        description: Agreement identifier
        example: 1
      - $ref: '#/components/parameters/tenant'
    get:
      summary: Get customer agreement by it id.
      tags:
        - Customer Agreements
      responses:
        '200':
          $ref: '#/components/responses/Rodo'
        '400':
          $ref: '#/components/responses/400BadRequest'
        '401':
          $ref: '#/components/responses/401Unauthorized'
        '403':
          $ref: '#/components/responses/403Forbidden'
  /customer_extra_agreements:
    get:
      summary: Get active customer extra agreements
      tags:
        - Customer Extra Agreements
      responses:
        '200':
          $ref: '#/components/responses/CustomerExtraAgreementsList'
        '400':
          $ref: '#/components/responses/400BadRequest'
        '401':
          $ref: '#/components/responses/401Unauthorized'
        '403':
          $ref: '#/components/responses/403Forbidden'
  /customer_extra_fields:
    get:
      summary: Get active customer extra fields
      tags:
        - Customer Extra Fields
      responses:
        '200':
          $ref: '#/components/responses/CustomerExtraFieldsList'
        '400':
          $ref: '#/components/responses/400BadRequest'
        '401':
          $ref: '#/components/responses/401Unauthorized'
        '403':
          $ref: '#/components/responses/403Forbidden'
  /companies:
    parameters:
      - $ref: '#/components/parameters/tenant'
    get:
      summary: Get all companies
      tags:
        - Companies
      parameters:
        - $ref: '#/components/parameters/page_number'
        - $ref: '#/components/parameters/itemsPerPage'
        - $ref: '#/components/parameters/sort_companies'
        - in: query
          name: page
          schema:
            type: integer
          required: false
        - name: filter[id]
          in: query
          description: |
            Filter by company id.
          schema:
            type: integer
            example: 33
        - name: filter[name]
          in: query
          description: |
            Filter by company's name or part of it. Field "nazwa firmy" - can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/2).
          schema:
            type: string
            example: Apple
        - name: filter[city]
          in: query
          description: |
            Filter by company's city name or part of it. Field "miasto" can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/2).
          schema:
            type: string
            example: Gniezno
        - name: filter[nip]
          in: query
          description: |
            Filter by company's NIP number. Field "NIP" - can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/2).
          schema:
            type: string
            example: 9538925678
        - name: filter[phone]
          in: query
          description: |
            Filter by company's phone number or part of it. Field "telefon" can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/2).
          schema:
            type: string
            example: '00500500'
        - name: filter[email]
          in: query
          description: |
            Filter by company's email or part of it. Field can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/2).
          schema:
            type: string
            example: t@op.pl
        - name: filter[stateId]
          in: query
          description: |
            Filter by company's state id or collection separated by comma. Field can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/2) - click "Powiat".
          schema:
            type: string
            example: '1,2'
        - name: filter[originsId]
          in: query
          description: |
            Filter by company's origins id or collection separated by comma. 
            IDs and its meaning can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/2) (click on "Pochodzenie").
          schema:
            type: string
            example: '1,5'
        - name: filter[parentUserId]
          in: query
          description: |
            Filter by parent empoloyee's id or collection separated by comma. "Opiekun" (it's id) - can be found at [Zespółi](https://app.bergsystem.pl/userdata/?view=employee) ("id" column).
          schema:
            type: string
            example: '1,3'
        - name: filter[creationDateFrom]
          in: query
          description: |
            Filter by creation date from (inclusive).
          schema:
            type: string
            format: date
            example: '2020-01-30'
        - name: filter[creationDateTo]
          in: query
          description: |
            Filter by creation date to (inclusive).
          schema:
            type: string
            format: date
            example: '2020-03-30'
        - name: filter[tagId]
          in: query
          description: |
            Filter by tag id or tag ids separated by comma. Field "tagi" - can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/2).
          schema:
            type: string
            example: '2,8,10'
        - name: filter[crmStatusId]
          in: query
          description: |
            Filter by CRM status id or CRM status ids separated by comma. Field "Status CRM" can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/2).
          schema:
            type: string
            example: '2,8,10'
        - name: filter[productCategoryId]
          in: query
          description: |
            Filter by customer's product category id or ids separated by comma.
            IDs and its meaning can be found at [Rodzaje produktów](https://app.bergsystem.pl/category/).
          schema:
            type: string
            example: '1,11'
        - name: filter[productProducerId]
          in: query
          description: |
            Filter by customers product producer id or ids separated by comma.
            IDs and its meaning can be found at [Producenci produktów](https://app.bergsystem.pl/producer/).
          schema:
            type: string
            example: '1,11'
        - name: filter[productId]
          in: query
          description: |
            Filter by customers product id or ids separated by comma.
            IDs and its meaning can be found at [Produkty](https://app.bergsystem.pl/product/).
          schema:
            type: string
            example: '1,11'
        - name: filter[contractStatusId]
          in: query
          description: |
            Filter by contract status id or ids separated by comma.
            "Status umowy" (id) can be found at [https://app.bergsystem.pl/contractstate/](https://app.bergsystem.pl/contractstate/)
          schema:
            type: string
            example: '1,11'
        - name: filter[externalId]
          in: query
          description: |
            Filter by company's externalId or part of it.
          schema:
            type: string
            example: 1234356assd
        - name: filter
          in: query
          description: >-
            Extra fields filter. For example
            ```?filter%5BextraField_myFieldd%5D=myValue```
          schema:
            type: object
            additionalProperties: true
            example:
              extraField_myField: myValue
          style: deepObject
      responses:
        '200':
          $ref: '#/components/responses/CompanyList'
        '400':
          $ref: '#/components/responses/400BadRequest'
        '401':
          $ref: '#/components/responses/401Unauthorized'
        '403':
          $ref: '#/components/responses/403Forbidden'
    post:
      summary: Create company
      tags:
        - Companies
      requestBody:
        $ref: '#/components/requestBodies/CompanySave'
      responses:
        '201':
          $ref: '#/components/responses/Company'
        '400':
          $ref: '#/components/responses/400BadRequest'
        '401':
          $ref: '#/components/responses/401Unauthorized'
        '403':
          $ref: '#/components/responses/403Forbidden'
        '404':
          $ref: '#/components/responses/404NotFound'
  /companies/{id}:
    parameters:
      - in: path
        name: id
        schema:
          type: integer
        required: true
        description: Company identifier
        example: 1
      - $ref: '#/components/parameters/tenant'
    get:
      summary: Get company by it id.
      tags:
        - Companies
      responses:
        '200':
          $ref: '#/components/responses/Company'
        '400':
          $ref: '#/components/responses/400BadRequest'
        '401':
          $ref: '#/components/responses/401Unauthorized'
        '403':
          $ref: '#/components/responses/403Forbidden'
    patch:
      summary: Update company by id.
      tags:
        - Companies
      requestBody:
        $ref: '#/components/requestBodies/CompanySave'
      responses:
        '200':
          $ref: '#/components/responses/Company'
        '400':
          $ref: '#/components/responses/400BadRequest'
        '401':
          $ref: '#/components/responses/401Unauthorized'
        '403':
          $ref: '#/components/responses/403Forbidden'
  /contract_extra_fields:
    get:
      summary: Get active sales and sales opportunities extra fields
      tags:
        - Contract Extra Fields
      responses:
        '200':
          $ref: '#/components/responses/ContractExtraFieldsList'
        '400':
          $ref: '#/components/responses/400BadRequest'
        '401':
          $ref: '#/components/responses/401Unauthorized'
        '403':
          $ref: '#/components/responses/403Forbidden'
  /employees:
    parameters:
      - $ref: '#/components/parameters/tenant'
    get:
      summary: Get all employees
      tags:
        - Employees
      responses:
        '200':
          $ref: '#/components/responses/EmployeesList'
        '400':
          $ref: '#/components/responses/400BadRequest'
        '401':
          $ref: '#/components/responses/401Unauthorized'
        '403':
          $ref: '#/components/responses/403Forbidden'
    post:
      summary: Create employee
      tags:
        - Employees
      requestBody:
        $ref: '#/components/requestBodies/EmployeeSave'
      responses:
        '201':
          $ref: '#/components/responses/Employee'
        '400':
          $ref: '#/components/responses/400BadRequest'
        '401':
          $ref: '#/components/responses/401Unauthorized'
        '403':
          $ref: '#/components/responses/403Forbidden'
        '404':
          $ref: '#/components/responses/404NotFound'
  /employees/{id}:
