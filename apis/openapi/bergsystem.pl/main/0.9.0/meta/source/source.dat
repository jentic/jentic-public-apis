          schema:
            type: integer
          required: true
          description: Origin identifier
          example: 1
        - $ref: '#/components/parameters/tenant'
      summary: Get origins by it id.
      tags:
        - User Origins
      responses:
        '200':
          $ref: '#/components/responses/Product'
        '400':
          $ref: '#/components/responses/400BadRequest'
        '401':
          $ref: '#/components/responses/401Unauthorized'
        '403':
          $ref: '#/components/responses/403Forbidden'
  /usertypes:
    get:
      parameters:
        - $ref: '#/components/parameters/tenant'
      summary: Get all user types
      tags:
        - User types
      responses:
        '200':
          $ref: '#/components/responses/UserTypeList'
        '400':
          $ref: '#/components/responses/400BadRequest'
        '401':
          $ref: '#/components/responses/401Unauthorized'
        '403':
          $ref: '#/components/responses/403Forbidden'
    post:
      parameters:
        - $ref: '#/components/parameters/tenant'
      summary: Create user type
      tags:
        - User types
      requestBody:
        required: true
        content:
          application/vnd.api+json:
            schema:
              type: object
              properties:
                data:
                  type: object
                  properties:
                    attributes:
                      $ref: '#/components/schemas/UserType'
      responses:
        '201':
          $ref: '#/components/responses/UserType'
        '400':
          $ref: '#/components/responses/400BadRequest'
        '401':
          $ref: '#/components/responses/401Unauthorized'
        '403':
          $ref: '#/components/responses/403Forbidden'
        '404':
          $ref: '#/components/responses/404NotFound'
  /usertypes/{id}:
    get:
      parameters:
        - in: path
          name: id
          schema:
            type: integer
          required: true
          description: User type identifier
          example: 1
        - $ref: '#/components/parameters/tenant'
      summary: Get user type by it id.
      tags:
        - User types
      responses:
        '200':
          $ref: '#/components/responses/UserType'
        '400':
          $ref: '#/components/responses/400BadRequest'
        '401':
          $ref: '#/components/responses/401Unauthorized'
        '403':
          $ref: '#/components/responses/403Forbidden'
  /items:
    get:
      summary: Get all items
      tags:
        - Items
      parameters:
        - $ref: '#/components/parameters/tenant'
        - $ref: '#/components/parameters/page_number'
        - $ref: '#/components/parameters/itemsPerPage'
        - in: query
          name: page
          schema:
            type: integer
          required: false
        - name: filter[employee]
          in: query
          description: |
            Filter by employee id.
          schema:
            type: integer
            example: 33
        - name: filter[itemType.name]
          in: query
          description: |
            Filter by itemType name.
          schema:
            type: string
            example: Pojazdy
        - name: filter[itemFieldValues.value]
          in: query
          description: |
            Filter by item field value
          schema:
            type: string
            example: PY 12345
        - name: filter[itemFieldValues.itemFieldType.apiName]
          in: query
          description: |
            Filter by type of field
          schema:
            type: string
            example: registerNumber
      responses:
        '200':
          $ref: '#/components/responses/ItemList'
        '400':
          $ref: '#/components/responses/400BadRequest'
        '401':
          $ref: '#/components/responses/401Unauthorized'
        '403':
          $ref: '#/components/responses/403Forbidden'
  /items/{id}:
    get:
      parameters:
        - in: path
          name: id
          schema:
            type: integer
          required: true
          description: Item identifier
          example: 1
        - $ref: '#/components/parameters/tenant'
      summary: Get item by it id.
      tags:
        - Items
      responses:
        '200':
          $ref: '#/components/responses/Item'
        '400':
          $ref: '#/components/responses/400BadRequest'
        '401':
          $ref: '#/components/responses/401Unauthorized'
        '403':
          $ref: '#/components/responses/403Forbidden'
webhooks:
  deleteUserData:
    post:
      parameters:
        - in: header
          name: x-signature
          schema:
            type: string
      requestBody:
        description: Information about a delete user in the system
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/DeleteUserData"
      responses:
        "200":
          description: Return a 200 status to indicate that the data was received successfully
  updateUserData:
    post:
      parameters:
        - in: header
          name: x-signature
          schema:
            type: string
      requestBody:
        description: Information about a update user in the system
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/EditUserData"
      responses:
        "200":
          description: Return a 200 status to indicate that the data was received successfully
components:
  schemas:
    BaseUserData:
      type: object
      properties:
        _id:
          type: integer
          readOnly: true
          example: 12333
        parentUserId:
          type: integer
          example: 1
          description: |
            "Opiekun" (it's id) - can be found at [Zespółi](https://app.bergsystem.pl/userdata/?view=employee) ("id" column).
        parentUser:
          $ref: '#/components/schemas/PersonData'
        personalDataProcessingAgreement:
          type: boolean
          example: true
          description: |
            Can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/2) - "Zgoda na przetwarzanie danych osobowych w celu realizacji i obsługi  umowy/zamówienia".
        commercialContentAgreement:
          type: boolean
          example: true
          description: |
            Can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/2) - "Zgoda na otrzymywanie informacji handlowych drogą elektroniczną".
        marketingContentAgreement:
          type: boolean
          example: false
          description: |
            Can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/2) - "Zgoda na otrzymywanie informacji marketingowych drogą elektroniczną".
        mailSmsMessagesAgreement:
          type: boolean
          example: true
          description: |
            Can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/2) - "Zgoda na używanie telekomunikacyjnych urządzeń końcowych i automatycznych systemów wywołujących".
        emailAgreement:
          type: boolean
          example: true
          description: |
            Can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/2) - "Zgoda na wysyłkę wiadomości email".
        personalDataProcessingAgreementModified:
          type: string
          description: Data modyfikacji zgody na SMS/e-mail.
          readOnly: true
          format: date-time
          example: '2013-07-09T14:09:49+02:00'
        commercialContentAgreementModified:
          type: string
          description: Data modyfikacji zgody na otrzymywanie wiadomości handlowych drogą elektroniczną.
          readOnly: true
          format: date-time
          example: '2013-07-09T14:09:49+02:00'
        marketingContentAgreementModified:
          type: string
          description: Data modyfikacji zgody na otrzymywanie informacji marketingowych drogą elektroniczną.
          readOnly: true
          format: date-time
          example: '2013-07-09T14:09:49+02:00'
        mailSmsMessagesAgreementModified:
          type: string
          description: Data modyfikacja zgody na przetwarzanie danych osobowych w celu realizacji i obsługi umowy/zamówienia
          readOnly: true
          format: date-time
          example: '2013-07-09T14:09:49+02:00'
        emailAgreementModified:
          type: string
          description: Data modyfikacja zgody na wysyłkę wiadomości email
          readOnly: true
          format: date-time
          example: '2013-07-09T14:09:49+02:00'
        visibility:
          type: string
          enum:
            - ALL_COMPANY
            - STRUCTURAL
            - ADVISER_ONLY
          example: ADVISER_ONLY
          description: "Widoczność"
        idCardSeries:
          type: string
          description: |
            Nr dowodu osobistego - can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/2).
          example: STM
        phone:
          type: string
          example: '48943210675'
          description: |
            Telefon - can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/2).
        email:
          type: string
          format: email
          example: kljkasd@o2.pl
          description: |
            Can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/2). Field can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/2).
        city:
          type: string
          example: Wroclaw
          description: |
            Miasto - can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/2).
        street:
          type: string
          example: Jaworowa
          description: |
            Ulica - can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/2).
        houseNumber:
          type: string
          example: 20A/77
          description: |
            Numer domu - can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/2).
        premisesNumber:
          type: string
          example: '18'
          description: |
            Numer lokalu - can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/2).
        postcode:
          type: string
          example: 00-930
          description: |
            Kod pocztowy - can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/2).
        invoiceEmail:
          type: string
