          example: '26-536'
        createdDate:
          type: string
          description: "Data dodania"
          readOnly: true
          format: date-time
          example: '2020-09-25T00:00:00+02:00'
        modifiedDate:
          type: string
          readOnly: true
          format: date-time
          example: '2020-09-25T00:00:00+02:00'
        tags:
          type: array
          items:
            type: string
            description: |
              Field "tagi" - can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/2).
            example: VIP
        description:
          type: string
          description: |
            Field "opis" - can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/2).
          example: My description
        linkedIn:
          type: string
          description: |
            Field "linkedin" - can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/2).
        facebook:
          type: string
          description: |
            Field "facebook" - can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/2).
        extraFields:
          description: User defined fields
          type: object
          additionalProperties:
            anyOf:
              - type: string
              - type: integer
              - type: boolean
        extraAgreements:
          description: User defined agreements - can be found at [RODO](https://app.bergsystem.pl/rodoSettings/).  It's JSON object with "rodo_[id_of_agreement]" as keys, and boolean as value.
          type: object
          example: {"rodo_999999999999": true}
          additionalProperties:
            anyOf:
              - type: boolean
        externalId:
          type: string
          description: |
            Field "ID zewnętrznego systemu" - can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/2).
          nullable: true
          example: 'EXT1'
        name:
          type: string
          description: |
            Field "nazwa firmy" - can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/2).
          nullable: true
        nip:
          type: string
          description: |
            Field "NIP" - can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/2).
          nullable: true
        regon:
          type: string
