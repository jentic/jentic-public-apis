    Gdpr:
      description: List of gdpr
      content:
        application/vnd.api+json:
          schema:
            type: object
            required:
              - data
            properties:
              links:
                $ref: '#/components/schemas/PaginationLinks'
              meta:
                $ref: '#/components/schemas/Meta'
              data:
                type: array
                readOnly: true
                items:
                  type: object
                  properties:
                    id:
                      type: string
                      example: /api/gdprs/pdo
                    type:
                      type: string
                      default: Gdpr
                    attributes:
                      type: object
                      properties:
                        _id:
                          type: string
                          example: 1
                        active:
                          type: boolean
                          example: true
                          nullable: true
                        required:
                          type: boolean
                          example: true
                          nullable: true
                        name:
                          type: string
                          example: Simple name
                        description:
                          type: string
                          example: Simple description
                          nullable: true
                        apiName:
                          type: string
                          example: Api name
                          nullable: true
                        userDataType:
                          type: number
                          nullable: true
                          enum:
                            - 0
                            - 1
                            - 2
                            - 3
                            - 11
                          description: 0 - all, 1 - employees, 2 - customers, 11 - companies, 3 - customers and companies
                        _type:
                          type: string
                          enum:
                            - standard
                            - extra
