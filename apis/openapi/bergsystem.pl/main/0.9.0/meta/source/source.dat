          example: 30A/36
        invoicePremisesNumber:
          type: string
          description: |
            Numer lokalu (in "Dane do faktur" data group) - can be found at [Zarządzanie polami](https://app.bergsystem.pl/userdatashow/2).
          example: 37A
        invoicePostcode:
