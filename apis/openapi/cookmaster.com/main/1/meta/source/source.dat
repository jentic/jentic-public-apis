{
  "openapi": "3.0.0",
  "info": {
    "title": "CookMaster API",
    "version": "1",
    "description": "API para la gestión de recetas, ingredientes, categorías y valoraciones. Orientada a aplicaciones móviles, webs gastronómicas y plataformas de planificación de comidas.\n",
    "contact": {
      "name": "Equipo CookMaster",
      "email": "soporte@cookmaster.com"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/egibidevitoriaalava/CookMaster/1"
  },
  "servers": [
    {
      "url": "https://api.cookmaster.com/v1",
      "description": "Servidor principal de producción"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/recetas/todas": {
      "get": {
        "summary": "Obtener todas las recetas",
        "description": "Devuelve una lista completa de recetas sin aplicar filtros.",
        "operationId": "getRecetasTodas",
        "responses": {
          "200": {
            "description": "Lista de recetas obtenida correctamente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Receta"
                  }
                },
                "example": [
                  {
                    "id": 1,
                    "nombre": "Tortilla de Patatas",
                    "categoria": "tradicional",
                    "dificultad": "media",
                    "tiempoPreparacion": 30,
                    "ingredientes": [
                      {
                        "nombre": "Patatas",
                        "cantidad": "500g"
                      },
                      {
                        "nombre": "Huevos",
                        "cantidad": "4 unidades"
                      }
                    ],
                    "pasos": [
                      "Pelar y cortar las patatas.",
                      "Batir los huevos.",
                      "Freír y mezclar."
                    ],
                    "valoracionMedia": 4.5
                  }
                ]
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/recetas/{id}": {
      "get": {
        "summary": "Obtener receta por ID",
        "operationId": "getRecetaById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID único de la receta",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Receta encontrada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receta"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      },
      "delete": {
        "summary": "Eliminar receta por ID",
        "operationId": "deleteReceta",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID de la receta a eliminar",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Receta eliminada correctamente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "mensaje": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "mensaje": "Receta eliminada con éxito"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/recetas": {
      "post": {
        "summary": "Crear nueva receta",
        "operationId": "createReceta",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecetaCrear"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Receta creada correctamente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer"
                    },
                    "mensaje": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "id": 45,
                  "mensaje": "Receta creada con éxito"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Clave API necesaria para autenticar las peticiones. Ejemplo: X-API-Key: 12345ABC"
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Solicitud inválida o datos incorrectos"
      },
      "NotFound": {
        "description": "Recurso no encontrado"
      },
      "Conflict": {
        "description": "Conflicto con el estado actual del recurso"
      },
      "InternalServerError": {
        "description": "Error interno del servidor"
      }
    },
    "schemas": {
      "Ingrediente": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string"
          },
          "cantidad": {
            "type": "string"
          }
        },
        "required": [
          "nombre",
          "cantidad"
        ],
        "example": {
          "nombre": "Harina",
          "cantidad": "200g"
        }
      },
      "Receta": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "nombre": {
            "type": "string"
          },
          "categoria": {
            "type": "string"
          },
          "dificultad": {
            "type": "string",
            "enum": [
              "facil",
              "media",
              "dificil"
            ]
          },
          "tiempoPreparacion": {
            "type": "integer",
            "description": "Minutos totales de preparación"
          },
          "ingredientes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Ingrediente"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "pasos": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "valoracionMedia": {
            "type": "number",
            "format": "float"
          }
        },
        "required": [
          "nombre",
          "categoria",
          "ingredientes",
          "pasos"
        ],
        "example": {
          "id": 12,
          "nombre": "Ensalada César",
          "categoria": "ensaladas",
          "dificultad": "facil",
          "tiempoPreparacion": 15,
          "ingredientes": [
            {
              "nombre": "Lechuga",
              "cantidad": "1 unidad"
            },
            {
              "nombre": "Pollo",
              "cantidad": "150g"
            }
          ],
          "pasos": [
            "Lavar la lechuga.",
            "Cocinar el pollo.",
            "Mezclar todo."
          ],
          "valoracionMedia": 4.5
        }
      },
      "RecetaCrear": {
        "type": "object",
        "description": "Modelo para crear una receta (sin ID)",
        "properties": {
          "nombre": {
            "type": "string"
          },
          "categoria": {
            "type": "string"
          },
          "dificultad": {
            "type": "string",
            "enum": [
              "facil",
              "media",
              "dificil"
            ]
          },
          "tiempoPreparacion": {
            "type": "integer"
          },
          "ingredientes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Ingrediente"
            },
            "minItems": 1
          },
          "pasos": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        },
        "required": [
          "nombre",
          "categoria",
          "ingredientes",
          "pasos"
        ],
        "example": {
          "nombre": "Crepes Dulces",
          "categoria": "postres",
          "dificultad": "facil",
          "tiempoPreparacion": 20,
          "ingredientes": [
            {
              "nombre": "Harina",
              "cantidad": "150g"
            },
            {
              "nombre": "Huevos",
              "cantidad": "2 unidades"
            }
          ],
          "pasos": [
            "Mezclar ingredientes.",
            "Cocinar en una sartén."
          ]
        }
      }
    }
  }
}
