{
  "openapi": "3.0.3",
  "info": {
    "title": "Efficient.Studio GBP Manager API",
    "version": "2.0.0",
    "description": "Final Operational Contract for Efficient.Studio.\nSupports: Real-time Monitoring, Smart Replies, Standardization, and Photo Management.\nBackend: FastAPI | DB: Supabase | Async: Celery\n",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/efficei/efficientstudio-gbp-manager-api/2.0.0"
  },
  "servers": [
    {
      "url": "https://api.efficient.studio/v2",
      "description": "Production Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "SupabaseAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "ProfileSummary": {
        "type": "object",
        "properties": {
          "company_name": {
            "type": "string",
            "example": "Efficient.Studio"
          },
          "primary_category": {
            "type": "string",
            "example": "Software Company"
          },
          "total_branches": {
            "type": "integer",
            "example": 700
          }
        }
      },
      "HealthCheckStats": {
        "type": "object",
        "properties": {
          "consistency_score": {
            "type": "integer",
            "example": 98,
            "description": "Percentage"
          },
          "missing_attributes_count": {
            "type": "integer",
            "example": 12
          },
          "review_performance": {
            "type": "number",
            "example": 4.9
          },
          "review_trend_pct": {
            "type": "number",
            "example": 5.0,
            "description": "+5% increase"
          }
        }
      },
      "LocationListItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "Verified",
              "Pending",
              "Suspended"
            ]
          },
          "rating": {
            "type": "number",
            "example": 4.9
          },
          "review_count": {
            "type": "integer",
            "example": 1234
          },
          "last_update": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Template": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "enum": [
              "NAME",
              "ATTRIBUTE"
            ]
          },
          "name": {
            "type": "string",
            "example": "Branch Name Template"
          },
          "pattern": {
            "type": "string",
            "example": "[Company Name] - [Branch Name]"
          },
          "fields": {
            "type": "object",
            "description": "JSON of hours, phone, etc."
          }
        }
      },
      "ComplianceItem": {
        "type": "object",
        "description": "Represents a row in 'Branches Not Following Template'",
        "properties": {
          "location_id": {
            "type": "string",
            "format": "uuid"
          },
          "branch_name": {
            "type": "string"
          },
          "mismatched_attributes": {
            "type": "array",
            "items": {
              "type": "string",
              "example": "Name"
            }
          },
          "last_update": {
            "type": "string",
            "example": "1 day ago"
          }
        }
      },
      "PhotoGallery": {
        "type": "object",
        "properties": {
          "pinned_photo": {
            "type": "string",
            "format": "uri"
          },
          "owner_photos": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "customer_photos": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      },
      "SentimentStats": {
        "type": "object",
        "properties": {
          "total_reviews": {
            "type": "integer",
            "example": 1234
          },
          "positive_count": {
            "type": "integer",
            "example": 1102
          },
          "negative_count": {
            "type": "integer",
            "example": 56
          },
          "neutral_count": {
            "type": "integer",
            "example": 76
          },
          "avg_rating": {
            "type": "number",
            "example": 4.9
          },
          "top_branches": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "rating": {
                  "type": "number"
                }
              }
            }
          }
        }
      },
      "ReviewItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "visitor_name": {
            "type": "string"
          },
          "branch_name": {
            "type": "string"
          },
          "rating": {
            "type": "number"
          },
          "comment": {
            "type": "string"
          },
          "sentiment": {
            "type": "string",
            "enum": [
              "Positive",
              "Negative",
              "Neutral"
            ]
          },
          "date": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "SmartReplyStats": {
        "type": "object",
        "properties": {
          "total_reply_count": {
            "type": "integer"
          },
          "not_replied_count": {
            "type": "integer"
          },
          "need_reply_count": {
            "type": "integer",
            "description": "Waiting for approval"
          },
          "active_templates": {
            "type": "integer"
          }
        }
      },
      "ReplyItem": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ReviewItem"
          },
          {
            "type": "object",
            "properties": {
              "ai_suggestion": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "tone": {
                    "type": "string",
                    "example": "POSITIVE"
                  }
                }
              },
              "status": {
                "type": "string",
                "enum": [
                  "WAITING_SUGGESTION",
                  "READY_TO_REVIEW",
                  "PUBLISHED"
                ]
              }
            }
          }
        ]
      },
      "BulkReplyRequest": {
        "type": "object",
        "properties": {
          "review_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "DefenseStats": {
        "type": "object",
        "properties": {
          "total_attacks_24h": {
            "type": "integer"
          },
          "branches_affected": {
            "type": "integer"
          },
          "active_incidents": {
            "type": "integer"
          },
          "auto_defense_actions": {
            "type": "integer"
          }
        }
      },
      "ProfileChangeIncident": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "branch_name": {
            "type": "string"
          },
          "attribute_changed": {
            "type": "string",
            "example": "Operational Hours"
          },
          "timestamp": {
            "type": "string"
          },
          "old_value": {
            "type": "string"
          },
          "new_value": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "ROLLED_BACK"
            ]
          }
        }
      },
      "ReviewSpikeIncident": {
        "type": "object",
        "properties": {
          "branch_name": {
            "type": "string"
          },
          "negative_count": {
            "type": "integer"
          },
          "time_window": {
            "type": "string"
          },
          "pattern_detected": {
            "type": "string"
          },
          "rating_impact": {
            "type": "number",
            "example": -0.3
          }
        }
      }
    }
  },
  "security": [
    {
      "SupabaseAuth": []
    }
  ],
  "paths": {
    "/profile/summary": {
      "get": {
        "summary": "Get Header Info & Health Cards",
        "description": "Returns Company Name, Category, and Health Check Metrics (Consistency, Missing Attributes).",
        "responses": {
          "200": {
            "description": "Successful retrieval of profile summary and health stats",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "profile": {
                      "$ref": "#/components/schemas/ProfileSummary"
                    },
                    "health": {
                      "$ref": "#/components/schemas/HealthCheckStats"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/locations": {
      "get": {
        "summary": "List All GBP Locations",
        "description": "Populates the \"All GBP Locations\" table.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A paginated list of locations",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LocationListItem"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Add New Location",
        "responses": {
          "201": {
            "description": "Location created successfully"
          }
        }
      }
    },
    "/templates": {
      "get": {
        "summary": "Get Active Templates",
        "description": "Populates \"Branch Name Template\" and \"Branch Attribute Template\" cards.",
        "responses": {
          "200": {
            "description": "List of active standardization templates",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Template"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/templates/{id}": {
      "put": {
        "summary": "Edit Template",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Template"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Template updated successfully"
          }
        }
      }
    },
    "/standardize/compliance": {
      "get": {
        "summary": "Get Branches Not Following Template",
        "description": "Populates the bottom list. Shows mismatched attributes.",
        "responses": {
          "200": {
            "description": "List of branches with compliance violations",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ComplianceItem"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/standardize/apply": {
      "post": {
        "summary": "Update Selected Branches (Async)",
        "description": "Triggered by \"Update Selected\" button. Uses Celery.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "location_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uuid"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Bulk update task accepted. Returns Task ID."
          }
        }
      }
    },
    "/locations/{location_id}/media": {
      "get": {
        "summary": "Get Galleries",
        "description": "Returns Pinned, Owner Gallery, and Visitor Gallery.",
        "parameters": [
          {
            "name": "location_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Object containing different photo categories",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PhotoGallery"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Upload Photo",
        "description": "Handles the \"Upload Photo\" drag-and-drop zone.",
        "parameters": [
          {
            "name": "location_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  },
                  "category": {
                    "type": "string",
                    "enum": [
                      "PROFILE",
                      "INTERIOR",
                      "EXTERIOR"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Photo uploaded successfully"
          }
        }
      }
    },
    "/insights/summary": {
      "get": {
        "summary": "Get Analysis Cards & Charts",
        "description": "Returns Total Reviews, Sentiment Breakdown, Top 5 Branches, and Trend data.",
        "responses": {
          "200": {
            "description": "Aggregated sentiment statistics and chart data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SentimentStats"
                }
              }
            }
          }
        }
      }
    },
    "/reviews": {
      "get": {
        "summary": "Get Table Reviews",
        "description": "Populates the \"Table Reviews\" list with sentiment labels.",
        "responses": {
          "200": {
            "description": "List of reviews with sentiment analysis",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ReviewItem"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/smart-reply/stats": {
      "get": {
        "summary": "Get Smart Reply Cards",
        "description": "Returns \"Total Reply\", \"Not Replied\", \"Need Reply\", etc.",
        "responses": {
          "200": {
            "description": "Summary statistics for the smart reply module",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SmartReplyStats"
                }
              }
            }
          }
        }
      }
    },
    "/smart-reply/pending": {
      "get": {
        "summary": "Get 'Table Need Reply'",
        "description": "Returns reviews specifically waiting for approval, including AI suggestion.",
        "responses": {
          "200": {
            "description": "List of reviews requiring manual approval",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ReplyItem"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/smart-reply/bulk-publish": {
      "post": {
        "summary": "Reply to All Selected",
        "description": "Publishes the AI suggestion for selected reviews.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkReplyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Batch publish completed successfully"
          }
        }
      }
    },
    "/defense/stats": {
      "get": {
        "summary": "Get Defense Cards",
        "description": "Returns \"Total Attacks\", \"Branches Affected\", \"Active Incidents\".",
        "responses": {
          "200": {
            "description": "Real-time defense summary statistics",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DefenseStats"
                }
              }
            }
          }
        }
      }
    },
    "/defense/incidents": {
      "get": {
        "summary": "Get Unusual Profile Changes",
        "description": "Populates the list of attribute changes (Red/Orange highlights).",
        "responses": {
          "200": {
            "description": "List of detected profile change incidents",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProfileChangeIncident"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/defense/spikes": {
      "get": {
        "summary": "Get Negative Review Spikes",
        "description": "Populates the bottom \"Negative Review Spike\" table.",
        "responses": {
          "200": {
            "description": "List of detected negative review spikes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ReviewSpikeIncident"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/defense/rollback/{incident_id}": {
      "post": {
        "summary": "Auto-Rollback Action",
        "description": "Triggered by the purple \"Auto-Rollback\" button.",
        "parameters": [
          {
            "name": "incident_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Rollback executed successfully"
          }
        }
      }
    }
  }
}
