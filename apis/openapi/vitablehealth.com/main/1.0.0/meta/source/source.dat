 limit exceeded","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"500":{"description":"Internal Server Error - An unexpected error occurred","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"502":{"description":"Bad Gateway - External service error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}},"security":[{"APIKeyAuth":[]}]}},"/v1/plans":{"get":{"operationId":"plans_list","summary":"List organization plans","description":"Returns a paginated list of benefit plans linked to the authenticated organization.","tags":["Plans"],"parameters":[{"name":"limit","in":"query","description":"Items per page (default: 20, max: 100)","required":false,"schema":{"$ref":"#/components/schemas/Limit","default":20}},{"name":"page","in":"query","description":"Page number (default: 1)","required":false,"schema":{"$ref":"#/components/schemas/Page","default":1}}],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PlanListResponse"}}}},"400":{"description":"Bad Request - Invalid input or validation error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"401":{"description":"Unauthorized - Invalid or missing API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"403":{"description":"Forbidden - Insufficient permissions for this resource","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"404":{"description":"Not Found - The requested resource does not exist","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"409":{"description":"Conflict - Resource already exists or conflicts with current state","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"429":{"description":"Too Many Requests - Rate limit exceeded","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"500":{"description":"Internal Server Error - An unexpected error occurred","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"502":{"description":"Bad Gateway - External service error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}},"security":[{"APIKeyAuth":[]}]}},"/v1/carrier-applications/{carrier_application_id}":{"get":{"operationId":"carrierApplications_get_carrier_application","summary":"Get a carrier application","description":"Returns application details, including finalized carrier-question responses and applicant information and the latest recorded carrier statuses. Unknown applications and applications outside the caller's access return 404.","tags":["carrierApplications"],"parameters":[{"name":"carrier_application_id","in":"path","required":true,"schema":{"$ref":"#/components/schemas/CarrierApplicationId"}},{"name":"X-Vitable-Organization","in":"header","description":"Organization to act as for this request (e.g. `org_SGVsbG8gV29ybGQ`). Optional when your credentials reach a single organization. Required when they reach several — omitting it then returns 400 `organization_required`. A malformed value returns 400 `invalid_organization_header`, and naming an organization you do not have access to returns 403 `organization_access_denied`.","required":false,"schema":{"$ref":"#/components/schemas/XVitableOrganization"}}],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CarrierApplicationDetailResponse"}}}},"400":{"description":"Invalid request.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"401":{"description":"Unauthorized - Invalid or missing API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"403":{"description":"Forbidden - Insufficient permissions for this resource","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"404":{"description":"Resource not found.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"409":{"description":"Conflict - Resource already exists or conflicts with current state","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"429":{"description":"Too Many Requests - Rate limit exceeded","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"500":{"description":"Internal Server Error - An unexpected error occurred","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"502":{"description":"Bad Gateway - External service error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}},"security":[{"APIKeyAuth":[]}]}},"/v1/carrier-applications/{carrier_application_id}/agent-of-record":{"put":{"operationId":"carrierApplications_change_carrier_application_agent_of_record","summary":"Change Carrier Application Agent Of Record","description":"Changes the agent of record on a carrier application without moving its assignee. The agent must be active and carry a complete provider identity. Partner callers may choose an agent at the application's current agency or Vitable's default agent; Vitable staff may choose any agent. `status` is `pending` while HealthSherpa confirms the change on an application it already holds, and `confirmed` otherwise. HealthSherpa applications accept a change only before submission; direct-to-carrier applications also accept one after submission, until the application is cancelled or coverage ends. The queue's `authorized_actions` advertises `agent_of_record` on exactly the rows this route would accept.","tags":["carrierApplications"],"parameters":[{"name":"carrier_application_id","in":"path","required":true,"schema":{"$ref":"#/components/schemas/CarrierApplicationId"}},{"name":"X-Vitable-Organization","in":"header","description":"Organization to act as for this request (e.g. `org_SGVsbG8gV29ybGQ`). Optional when your credentials reach a single organization. Required when they reach several — omitting it then returns 400 `organization_required`. A malformed value returns 400 `invalid_organization_header`, and naming an organization you do not have access to returns 403 `organization_access_denied`.","required":false,"schema":{"$ref":"#/components/schemas/XVitableOrganization"}}],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CarrierApplicationAssignmentResponse"}}}},"400":{"description":"Invalid request.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"401":{"description":"Unauthorized - Invalid or missing API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"403":{"description":"Forbidden - Insufficient permissions for this resource","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"404":{"description":"Resource not found.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"409":{"description":"Conflict - Resource already exists or conflicts with current state","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"422":{"description":"Unprocessable Entity - Business rule or domain invariant violated","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"429":{"description":"Too Many Requests - Rate limit exceeded","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"500":{"description":"Internal Server Error - An unexpected error occurred","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"502":{"description":"Bad Gateway - External service error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}},"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChangeCarrierApplicationAgentOfRecordRequest"}}}},"security":[{"APIKeyAuth":[]}]}},"/v1/carrier-applications/{carrier_application_id}/assignment":{"post":{"operationId":"carrierApplications_assign_carrier_application","summary":"Assign Carrier Application","description":"Routes a carrier application to an enrollment agent, deriving the enrollment channel and the agent of record from that agent's agency. `status` is `confirmed` when the new route is authoritative and `pending` while it awaits provider confirmation. Assignment is refused once processing has begun or the application has been submitted, cancelled or reached terminal coverage; the queue's `authorized_actions` advertises `assign` on exactly the rows this route would accept. Authorized Partner callers may assign to an active agent within the current agency. Vitable staff may also assign across agencies.","tags":["carrierApplications"],"parameters":[{"name":"carrier_application_id","in":"path","required":true,"schema":{"$ref":"#/components/schemas/CarrierApplicationId"}},{"name":"X-Vitable-Organization","in":"header","description":"Organization to act as for this request (e.g. `org_SGVsbG8gV29ybGQ`). Optional when your credentials reach a single organization. Required when they reach several — omitting it then returns 400 `organization_required`. A malformed value returns 400 `invalid_organization_header`, and naming an organization you do not have access to returns 403 `organization_access_denied`.","required":false,"schema":{"$ref":"#/components/schemas/XVitableOrganization"}}],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CarrierApplicationAssignmentResponse"}}}},"400":{"description":"Invalid request.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"401":{"description":"Unauthorized - Invalid or missing API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"403":{"description":"Forbidden - Insufficient permissions for this resource","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"404":{"description":"Resource not found.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"409":{"description":"Conflict - Resource already exists or conflicts with current state","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"422":{"description":"Unprocessable Entity - Business rule or domain invariant violated","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"429":{"description":"Too Many Requests - Rate limit exceeded","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"500":{"description":"Internal Server Error - An unexpected error occurred","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"502":{"description":"Bad Gateway - External service error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}},"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AssignCarrierApplicationRequest"}}}},"security":[{"APIKeyAuth":[]}]}},"/v1/carrier-applications/{carrier_application_id}/deeplink":{"get":{"operationId":"carrierApplications_get_carrier_application_deeplink","summary":"Open the provider-hosted enrollment session","description":"Returns a HealthSherpa-hosted enrollment session for a deeplink-routed application, for the authorized agent to open in their own browser. Available only while `authorized_actions` contains the `deeplink` rel.\n\nEach call opens a new session, so request one per launch rather than storing the URL. `expires_at` is null when the provider does not state an expiry; that means unknown, not unlimited. Nothing on the application changes until HealthSherpa reports the hosted application back, so keep polling the application details rather than assuming it launched.","tags":["carrierApplications"],"parameters":[{"name":"carrier_application_id","in":"path","required":true,"schema":{"$ref":"#/components/schemas/CarrierApplicationId"}},{"name":"X-Vitable-Organization","in":"header","description":"Organization to act as for this request (e.g. `org_SGVsbG8gV29ybGQ`). Optional when your credentials reach a single organization. Required when they reach several — omitting it then returns 400 `organization_required`. A malformed value returns 400 `invalid_organization_header`, and naming an organization you do not have access to returns 403 `organization_access_denied`.","required":false,"schema":{"$ref":"#/components/schemas/XVitableOrganization"}}],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CarrierApplicationDeeplinkResponse"}}}},"400":{"description":"Invalid request.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"401":{"description":"Unauthorized - Invalid or missing API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"403":{"description":"Forbidden - Insufficient permissions for this resource","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"404":{"description":"Resource not found.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"409":{"description":"Conflict with the current resource state.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"429":{"description":"Too Many Requests - Rate limit exceeded","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"500":{"description":"Internal Server Error - An unexpected error occurred","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"502":{"description":"Bad Gateway - External service error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}},"security":[{"APIKeyAuth":[]}]}},"/v1/carrier-applications/{carrier_application_id}/payment-redirect":{"get":{"operationId":"carrierApplications_get_carrier_application_payment_redirect","summary":"Get the carrier payment page","description":"Returns the URL and form fields needed to open the carrier's payment page for this application. Submit the fields using the returned method. Check the application details for payment updates.","tags":["carrierApplications"],"parameters":[{"name":"carrier_application_id","in":"path","required":true,"schema":{"$ref":"#/components/schemas/CarrierApplicationId"}},{"name":"X-Vitable-Organization","in":"header","description":"Organization to act as for this request (e.g. `org_SGVsbG8gV29ybGQ`). Optional when your credentials reach a single organization. Required when they reach several — omitting it then returns 400 `organization_required`. A malformed value returns 400 `invalid_organization_header`, and naming an organization you do not have access to returns 403 `organization_access_denied`.","required":false,"schema":{"$ref":"#/components/schemas/XVitableOrganization"}}],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CarrierApplicationPaymentRedirectResponse"}}}},"400":{"description":"Invalid request.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"401":{"description":"Unauthorized - Invalid or missing API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"403":{"description":"Forbidden - Insufficient permissions for this resource","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"404":{"description":"Resource not found.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"409":{"description":"Conflict with the current resource state.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"429":{"description":"Too Many Requests - Rate limit exceeded","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"500":{"description":"Internal Server Error - An unexpected error occurred","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"502":{"description":"Bad Gateway - External service error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}},"security":[{"APIKeyAuth":[]}]}},"/v1/carrier-applications/{carrier_application_id}/status-updates":{"post":{"operationId":"carrierApplications_record_carrier_application_status_update","summary":"Record a carrier application status update","description":"Records the latest status the carrier reported for an application completed directly with the carrier, and returns the updated application. Include only the statuses that changed; sending the same statuses with a later `observed_at` confirms they are still current. Returns 409 when the application doesn't accept status updates, the update conflicts with its current status, or a more recent `observed_at` has already been recorded, and 404 when the application doesn't exist or isn't accessible.","tags":["carrierApplications"],"parameters":[{"name":"carrier_application_id","in":"path","required":true,"schema":{"$ref":"#/components/schemas/CarrierApplicationId"}},{"name":"X-Vitable-Organization","in":"header","description":"Organization to act as for this request (e.g. `org_SGVsbG8gV29ybGQ`). Optional when your credentials reach a single organization. Required when they reach several — omitting it then returns 400 `organization_required`. A malformed value returns 400 `invalid_organization_header`, and naming an organization you do not have access to returns 403 `organization_access_denied`.","required":false,"schema":{"$ref":"#/components/schemas/XVitableOrganization"}}],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CarrierApplicationDetailResponse"}}}},"400":{"description":"Invalid request.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"401":{"description":"Unauthorized - Invalid or missing API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"403":{"description":"Forbidden - Insufficient permissions for this resource","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"404":{"description":"Resource not found.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"409":{"description":"Conflict with the current resource state.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"429":{"description":"Too Many Requests - Rate limit exceeded","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"500":{"description":"Internal Server Error - An unexpected error occurred","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"502":{"description":"Bad Gateway - External service error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}},"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RecordCarrierApplicationStatusUpdateRequest"}}}},"security":[{"APIKeyAuth":[]}]}},"/v1/carrier-applications/carriers":{"get":{"operationId":"carrierApplications_list_carrier_application_carriers","summary":"List carrier application carriers","description":"Returns every carrier in the caller's carrier-application queue, once per carrier. Spelling variants of one carrier's name share a `key` and are listed under the most-used spelling. Pass a `key` as `carrier_key` to `GET /v1/carrier-applications` to filter the queue to that carrier. The list reflects the caller's access only, not any other filter, and is ordered by name.","tags":["carrierApplications"],"parameters":[{"name":"X-Vitable-Organization","in":"header","description":"Organization to act as for this request (e.g. `org_SGVsbG8gV29ybGQ`). Optional when your credentials reach a single organization. Required when they reach several — omitting it then returns 400 `organization_required`. A malformed value returns 400 `invalid_organization_header`, and naming an organization you do not have access to returns 403 `organization_access_denied`.","required":false,"schema":{"$ref":"#/components/schemas/XVitableOrganization"}}],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CarrierApplicationCarriersResponse"}}}},"400":{"description":"Bad Request - Invalid input or validation error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"401":{"description":"Unauthorized - Invalid or missing API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"403":{"description":"Forbidden - Insufficient permissions for this resource","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"404":{"description":"Resource not found.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"409":{"description":"Conflict - Resource already exists or conflicts with current state","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"429":{"description":"Too Many Requests - Rate limit exceeded","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"500":{"description":"Internal Server Error - An unexpected error occurred","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"502":{"description":"Bad Gateway - External service error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}},"security":[{"APIKeyAuth":[]}]}},"/v1/organization-domains":{"get":{"operationId":"organizationDomains_list_organization_domains","summary":"List the organization's email domains","description":"Every domain the authenticated organization claims, verified or pending. A verified domain auto-joins any new user whose identity-provider-verified email is at that exact domain; a pending claim grants nothing until Vitable confirms ownership.","tags":["organizationDomains"],"parameters":[{"name":"X-Vitable-Organization","in":"header","description":"Organization to act as for this request (e.g. `org_SGVsbG8gV29ybGQ`). Optional when your credentials reach a single organization. Required when they reach several — omitting it then returns 400 `organization_required`. A malformed value returns 400 `invalid_organization_header`, and naming an organization you do not have access to returns 403 `organization_access_denied`.","required":false,"schema":{"$ref":"#/components/schemas/XVitableOrganization"}}],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/OrganizationDomainsResponse"}}}},"400":{"description":"Bad Request - Invalid input or validation error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"401":{"description":"Unauthorized - Invalid or missing API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"403":{"description":"Forbidden - Insufficient permissions for this resource","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"404":{"description":"Not Found - The requested resource does not exist","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"409":{"description":"Conflict - Resource already exists or conflicts with current state","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"429":{"description":"Too Many Requests - Rate limit exceeded","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"500":{"description":"Internal Server Error - An unexpected error occurred","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"502":{"description":"Bad Gateway - External service error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}},"security":[{"APIKeyAuth":[]}]},"post":{"operationId":"organizationDomains_request_organization_domain","summary":"Request an email domain","description":"Records a pending claim on a domain for Vitable to verify. The claim grants nothing until then — it does not auto-join anyone and does not reserve the domain against another organization. Requesting a domain the organization already claims returns that claim unchanged rather than creating a second one.","tags":["organizationDomains"],"parameters":[{"name":"X-Vitable-Organization","in":"header","description":"Organization to act as for this request (e.g. `org_SGVsbG8gV29ybGQ`). Optional when your credentials reach a single organization. Required when they reach several — omitting it then returns 400 `organization_required`. A malformed value returns 400 `invalid_organization_header`, and naming an organization you do not have access to returns 403 `organization_access_denied`.","required":false,"schema":{"$ref":"#/components/schemas/XVitableOrganization"}}],"responses":{"201":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/OrganizationDomainResponse"}}}},"400":{"description":"Bad Request - Invalid input or validation error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"401":{"description":"Unauthorized - Invalid or missing API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"403":{"description":"Forbidden - Insufficient permissions for this resource","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"404":{"description":"Not Found - The requested resource does not exist","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"409":{"description":"`organization_domain_already_claimed` — another organization already holds this domain verified. A domain another organization merely has pending does not conflict.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"429":{"description":"Too Many Requests - Rate limit exceeded","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"500":{"description":"Internal Server Error - An unexpected error occurred","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"502":{"description":"Bad Gateway - External service error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}},"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RequestOrganizationDomainRequest"}}}},"security":[{"APIKeyAuth":[]}]}},"/v1/organization-domains/{organization_domain_id}":{"delete":{"operationId":"organizationDomains_remove_organization_domain","summary":"Remove a claimed email domain","description":"Gives up a domain claim, pending or verified. Users already in the organization keep their membership; the domain simply stops auto-joining anyone and becomes available for another organization to claim. Only the authenticated organization's own claims can be removed; any other id is reported as not found.","tags":["organizationDomains"],"parameters":[{"name":"organization_domain_id","in":"path","description":"Unique organization domain claim identifier (orgdom_*)","required":true,"schema":{"$ref":"#/components/schemas/OrganizationDomainId"}},{"name":"X-Vitable-Organization","in":"header","description":"Organization to act as for this request (e.g. `org_SGVsbG8gV29ybGQ`). Optional when your credentials reach a single organization. Required when they reach several — omitting it then returns 400 `organization_required`. A malformed value returns 400 `invalid_organization_header`, and naming an organization you do not have access to returns 403 `organization_access_denied`.","required":false,"schema":{"$ref":"#/components/schemas/XVitableOrganization"}}],"responses":{"204":{"description":"Domain claim removed.","content":{"application/json":{"schema":{"type":"object","properties":{}}}}},"400":{"description":"Bad Request - Invalid input or validation error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"401":{"description":"Unauthorized - Invalid or missing API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"403":{"description":"Forbidden - Insufficient permissions for this resource","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"404":{"description":"`organization_domain_not_found`","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"409":{"description":"Conflict - Resource already exists or conflicts with current state","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"429":{"description":"Too Many Requests - Rate limit exceeded","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"500":{"description":"Internal Server Error - An unexpected error occurred","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"502":{"description":"Bad Gateway - External service error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}},"security":[{"APIKeyAuth":[]}]}},"/v1/organization-user-invitations":{"get":{"operationId":"organizationUserInvitations_list_organization_user_invitations","summary":"List pending organization-user invitations","description":"Invitations for the authenticated organization that have not yet been accepted, expired or revoked. Held by the identity provider, not stored locally.","tags":["organizationUserInvitations"],"parameters":[{"name":"X-Vitable-Organization","in":"header","description":"Organization to act as for this request (e.g. `org_SGVsbG8gV29ybGQ`). Optional when your credentials reach a single organization. Required when they reach several — omitting it then returns 400 `organization_required`. A malformed value returns 400 `invalid_organization_header`, and naming an organization you do not have access to returns 403 `organization_access_denied`.","required":false,"schema":{"$ref":"#/components/schemas/XVitableOrganization"}}],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/OrganizationUserInvitationsResponse"}}}},"400":{"description":"Bad Request - Invalid input or validation error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"401":{"description":"Unauthorized - Invalid or missing API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"403":{"description":"Forbidden - Insufficient permissions for this resource","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"404":{"description":"Not Found - The requested resource does not exist","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"409":{"description":"`organization_not_federated` — the organization has no identity-provider organization yet (it is provisioned asynchronously; retry shortly).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"429":{"description":"Too Many Requests - Rate limit exceeded","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"500":{"description":"Internal Server Error - An unexpected error occurred","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"502":{"description":"Bad Gateway - External service error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}},"security":[{"APIKeyAuth":[]}]},"post":{"operationId":"organizationUserInvitations_invite_organization_user","summary":"Invite a user to the organization","description":"Invites an email address to join the authenticated organization. The identity provider sends the email and hosts acceptance; the membership is written on the invitee's first sign-in. Any email domain is accepted, which is the only way to add a teammate whose domain the organization does not claim.","tags":["organizationUserInvitations"],"parameters":[{"name":"X-Vitable-Organization","in":"header","description":"Organization to act as for this request (e.g. `org_SGVsbG8gV29ybGQ`). Optional when your credentials reach a single organization. Required when they reach several — omitting it then returns 400 `organization_required`. A malformed value returns 400 `invalid_organization_header`, and naming an organization you do not have access to returns 403 `organization_access_denied`.","required":false,"schema":{"$ref":"#/components/schemas/XVitableOrganization"}}],"responses":{"201":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/OrganizationUserInvitationResponse"}}}},"400":{"description":"Bad Request - Invalid input or validation error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"401":{"description":"Unauthorized - Invalid or missing API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"403":{"description":"Forbidden - Insufficient permissions for this resource","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"404":{"description":"Not Found - The requested resource does not exist","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"409":{"description":"`organization_user_already_invited` — a pending invitation for this address already exists; or `organization_not_federated` — see above.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"429":{"description":"Too Many Requests - Rate limit exceeded","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"500":{"description":"Internal Server Error - An unexpected error occurred","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"502":{"description":"Bad Gateway - External service error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}},"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/InviteOrganizationUserRequest"}}}},"security":[{"APIKeyAuth":[]}]}},"/v1/organization-user-invitations/{invitation_id}":{"delete":{"operationId":"organizationUserInvitations_revoke_organization_user_invitation","summary":"Revoke a pending invitation","description":"Revokes an invitation that has not been accepted. Only invitations belonging to the authenticated organization can be revoked; any other id is reported as not found.","tags":["organizationUserInvitations"],"parameters":[{"name":"invitation_id","in":"path","description":"Identity-provider invitation id","required":true,"schema":{"$ref":"#/components/schemas/InvitationId"}},{"name":"X-Vitable-Organization","in":"header","description":"Organization to act as for this request (e.g. `org_SGVsbG8gV29ybGQ`). Optional when your credentials reach a single organization. Required when they reach several — omitting it then returns 400 `organization_required`. A malformed value returns 400 `invalid_organization_header`, and naming an organization you do not have access to returns 403 `organization_access_denied`.","required":false,"schema":{"$ref":"#/components/schemas/XVitableOrganization"}}],"responses":{"204":{"description":"Invitation revoked.","content":{"application/json":{"schema":{"type":"object","properties":{}}}}},"400":{"description":"Bad Request - Invalid input or validation error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"401":{"description":"Unauthorized - Invalid or missing API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"403":{"description":"Forbidden - Insufficient permissions for this resource","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"404":{"description":"`organization_invitation_not_found`","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"409":{"description":"`organization_not_federated` — the organization has no identity-provider organization yet (it is provisioned asynchronously; retry shortly).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"429":{"description":"Too Many Requests - Rate limit exceeded","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"500":{"description":"Internal Server Error - An unexpected error occurred","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"502":{"description":"Bad Gateway - External service error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}},"security":[{"APIKeyAuth":[]}]}}},"tags":[{"name":"Auth"},{"name":"Employees"},{"name":"Employers"},{"name":"Enrollments"},{"name":"webhookEvents"},{"name":"Groups"},{"name":"sync"},{"name":"Members"},{"name":"Organizations"},{"name":"Plans"},{"name":"ca