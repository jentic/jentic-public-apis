on":"High-level benefit grouping (e.g., Medical, Dental)\n\n* `Medical` - Medical\n* `Dental` - Dental\n* `Vision` - Vision\n* `Hospital` - Hospital"},"product_code":{"$ref":"#/components/schemas/ProductCode","description":"The benefit product this enrollment is for\n\n* `EBA` - Eba Mec\n* `VPC` - Vpc Enhanced\n* `VPC_CORE` - Vpc Core\n* `MEC` - Vpc Mec\n* `MEC2` - Mec2\n* `MEC_PLUS` - Mec Plus\n* `MVP` - Mvp\n* `MVP2` - Mvp2\n* `MVPSL` - Mvpsl\n* `MVPSL2` - Mvpsl2\n* `VD` - Dental\n* `VV` - Vision\n* `ICHRA` - Ichra\n* `ICHRA_PREMIUM_PLUS` - Ichra Premium Plus\n* `ICHRA_REIMBURSEMENT_ONLY` - Ichra Reimbursement Only"},"requires_qle_for_reissue":{"type":"boolean","description":"Whether a qualifying life event would be required to reissue this enrollment under the product and open-enrollment rule at the time this list was read"},"product_name":{"type":"string","description":"Display name of the benefit product"},"employer_name":{"type":"string","description":"Name of the employer the enrollment is through"},"carrier_name":{"type":["string","null"],"description":"Insurance carrier name; null when no active carrier period is resolvable"},"plan_name":{"type":["string","null"],"description":"Chosen benefit plan name; null unless the row is an election"},"tier_name":{"type":["string","null"],"description":"Chosen benefit plan tier name (e.g., Employee Only); null unless the row is an election"},"employee_deduction_in_cents":{"type":["integer","null"],"description":"Employee monthly payroll deduction in cents; null unless the row is an election"},"employer_contribution_in_cents":{"type":["integer","null"],"description":"Employer monthly contribution in cents; null unless the row is an election"},"premium_in_cents":{"type":["integer","null"],"description":"Total monthly plan premium in cents; null unless the row is an election"},"coverage_start":{"type":["string","null"],"format":"date","description":"Coverage window start date (YYYY-MM-DD)"},"coverage_end":{"type":["string","null"],"format":"date","description":"Coverage window end date (YYYY-MM-DD); null while coverage is open-ended"},"cancelled_date":{"type":["string","null"],"format":"date","description":"Earliest applicable coverage boundary (YYYY-MM-DD) when coverage was cancelled before its effective start; null unless the enrollment was cancelled"},"plan_year_coverage_end":{"type":["string","null"],"format":"date","description":"Benefit plan-year coverage end date (YYYY-MM-DD), distinct from this enrollment's coverage_end; null when the plan year is open-ended"},"issued_date":{"type":"string","format":"date","description":"Date the enrollment record was created (YYYY-MM-DD), the value Ops labels Issued on. Present on every row whatever the member answered, and distinct from `coverage_start`. It equals `enrollment_window_start` for a row issued once its open enrollment had already opened, and precedes it for a row issued ahead of open enrollment."},"enrolled_date":{"type":["string","null"],"format":"date","description":"Date the member enrolled (YYYY-MM-DD); null unless the row is an election"},"enrollment_window_start":{"type":"string","format":"date","description":"First date the member could answer this enrollment (YYYY-MM-DD). Open enrollment's start date for a row issued before open enrollment opened, otherwise the date the row was issued -- an enrollment is never answerable before it exists, so this is never earlier than `issued_date`."},"enrollment_window_end":{"type":["string","null"],"format":"date","description":"Enrollment / open-enrollment window end date (YYYY-MM-DD); null when open-ended"},"election_status":{"$ref":"#/components/schemas/PlanYearEnrollmentElectionStatus","description":"Where the member stands: `Enrolled` or `Waived` if they answered, otherwise `Pending` while their enrollment window is open and `Expired` once it has closed.\n\n* `Enrolled` - Enrolled\n* `Waived` - Waived\n* `Pending` - Pending\n* `Expired` - Expired"},"policy_status":{"oneOf":[{"$r