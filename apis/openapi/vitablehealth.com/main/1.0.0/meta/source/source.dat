":{"type":"string","maxLength":1000,"description":"The finalized signed answer."}},"required":["question_id","question_label","applicant_id","answer"],"title":"CarrierApplicationQuestionResponse"},"CarrierApplicationSEPDocumentDeliveryStatus":{"type":"string","enum":["missing","prepared","attempted","uncertain","uploaded","failed"],"description":"* `missing` - Missing\n* `prepared` - Prepared\n* `attempted` - Attempted\n* `uncertain` - Uncertain\n* `uploaded` - Uploaded\n* `failed` - Failed","title":"CarrierApplicationSEPDocumentDeliveryStatus"},"CarrierApplicationApplicant":{"type":"object","properties":{"applicant_id":{"type":"string","description":"The stable Vitable enrollment applicant identifier."},"name":{"type":"string","description":"The applicant's display name from finalized signing evidence."},"date_of_birth":{"type":"string","format":"date","description":"The applicant's birth date for household disambiguation."},"relationship":{"type":["string","null"],"description":"Relationship to the primary applicant."},"current_values":{"type":["object","null"],"additionalProperties":{"type":"string","maxLength":1000}}},"required":["applicant_id","name","date_of_birth","relationship"],"title":"CarrierApplicationApplicant"},"CarrierPaymentInstructions":{"type":"object","properties":{"payment_required_with_submission":{"type":"boolean"},"payment_redirect_supported":{"type":"boolean"},"pay_by_phone_supported":{"type":"boolean"},"payment_phone_number":{"type":["string","null"]}},"required":["payment_required_with_submission","payment_redirect_supported","pay_by_phone_supported","payment_phone_number"],"title":"CarrierPaymentInstructions"},"CarrierReportedPaymentStatus":{"type":"string","enum":["unpaid_binder","paid_binder","paid","past_due"],"description":"* `unpaid_binder` - Unpaid Binder\n* `paid_binder` - Paid Binder\n* `paid` - Paid\n* `past_due` - Past Due","title":"CarrierReportedPaymentStatus"},"CarrierReportedPayment":{"type":"object","properties":{"payment_st