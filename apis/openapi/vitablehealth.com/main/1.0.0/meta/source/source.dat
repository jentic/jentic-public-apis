XX)"},"email":{"type":"string","format":"email","description":"Email address for billing and communications"},"address":{"$ref":"#/components/schemas/EmployerAddressInput","description":"Employer address"},"phone_number":{"type":["string","null"],"description":"Employer phone number (10-digit US format, e.g. 5551234567)"},"reference_id":{"type":["string","null"],"maxLength":255,"description":"External reference ID for this employer"}},"required":["name","legal_name","ein","email","address"],"title":"CreateEmployerRequest"},"EmployerAddress":{"type":"object","properties":{"address_line_1":{"type":"string","description":"Primary street address"},"address_line_2":{"type":["string","null"],"description":"Secondary street address (apt, suite, etc.)"},"city":{"type":"string","description":"City name"},"state":{"type":"string","description":"Two-letter state code (e.g., CA, NY)"},"zipcode":{"type":"string","description":"ZIP code (5 or 9 digit)"}},"required":["address_line_1","city","state","zipcode"],"description":"Nested address within EmployerSerializer.","title":"EmployerAddress"},"EmployerContact":{"type":"object","properties":{"email":{"type":["string","null"],"format":"email","description":"Primary contact email"},"phone":{"type":["string","null"],"description":"Primary contact phone, or null"}},"required":["email","phone"],"description":"Primary company-admin contact (email + phone; company admins have no person name).","title":"EmployerContact"},"Employer":{"type":"object","properties":{"id":{"type":"string","description":"Unique employer identifier with 'empr_' prefix"},"organization_id":{"type":["string","null"],"description":"ID of the parent organization (org_*)"},"name":{"type":"string","description":"Display name of the employer"},"legal_name":{"type":"string","description":"Legal business name for compliance and tax purposes"},"ein":{"type":["string","null"],"description":"Employer Identification Number (format: XX-XXXXXXX)"},"reference_id":{"type":["string