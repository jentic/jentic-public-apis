,"description":"Carrier website on the card; null for an rx card"},"plan_disclaimer":{"type":["string","null"],"description":"Plan-specific disclaimer text; null for an rx card"},"general_disclaimer":{"type":["string","null"],"description":"General disclaimer text; null for an rx card"},"nsa_table":{"type":"array","items":{"type":"array","items":{"type":"string"}},"description":"No Surprises Act cost-sharing table rendered on the card; empty for an rx card"}},"required":["card_type","group_id","group_member_id","member_name","nsa_table"],"description":"Wire serializer for :class:`DigitalBenefitCardDTO` (one benefit ID card).","title":"DigitalBenefitCard"},"MemberDigitalBenefitCardsResponse":{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/DigitalBenefitCard"},"description":"The member's digital benefit cards."}},"required":["data"],"description":"Unpaginated ``{\"data\": [...]}`` list of member digital benefit cards.","title":"MemberDigitalBenefitCardsResponse"},"Status":{"type":"string","enum":["approved","denied","pending"],"description":"Optional. Filter to a single QLE status; omit to return all statuses.","title":"Status"},"QualifyingLifeEventType":{"type":"string","enum":["lost_job_based_coverage","aged_off_parent_plan","lost_medicaid_chip_medicare","lost_decertified_individual_plan","married","divorced","had_baby","adopted_child","foster_care_placement","death_of_spouse_or_dependent","court_ordered","moved_to_new_coverage_area","moved_to_us","moved_to_or_from_school_housing","moved_to_or_from_seasonal_work_housing","became_us_citizen","left_incarceration","gained_tribal_status","started_or_ended_americorps_service","new_child","other"],"description":"* `lost_job_based_coverage` - lost_job_based_coverage\n* `aged_off_parent_plan` - aged_off_parent_plan\n* `lost_medicaid_chip_medicare` - lost_medicaid_chip_medicare\n* `lost_decertified_individual_plan` - lost_decertified_individual_plan\n* `married` - married\n* `divorced` - divorced\n* `had_baby` - had_baby\n* `adopted_child` - adopted_child\n* `foster_care_placement` - foster_care_placement\n* `death_of_spouse_or_dependent` - death_of_spouse_or_dependent\n* `court_ordered` - court_ordered\n* `moved_to_new_coverage_area` - moved_to_new_coverage_area\n* `moved_to_us` - moved_to_us\n* `moved_to_or_from_school_housing` - moved_to_or_from_school_housing\n* `moved_to_or_from_seasonal_work_housing` - moved_to_or_from_seasonal_work_housing\n* `became_us_citizen` - became_us_citizen\n* `left_incarceration` - left_incarceration\n* `gained_tribal_status` - gained_tribal_status\n* `started_or_ended_americorps_service` - started_or_ended_americorps_service\n* `new_child` - new_child\n* `other` - other","title":"QualifyingLifeEventType"},"QualifyingLifeEventStatus":{"type":"string","enum":["pending","approved","denied"],"description":"* `pending` - Pending\n* `approved` - Approved\n* `denied` - Denied","title":"QualifyingLifeEventStatus"},"MemberQualifyingLifeEvent":{"type":"object","properties":{"id":{"type":"string","description":"Opaque qualifying life event identifier"},"event_type":{"$ref":"#/components/schemas/QualifyingLifeEventType","description":"The member-submitted qualifying life event type\n\n* `lost_job_based_coverage` - Losing job-based health insurance\n* `aged_off_parent_plan` - Aging off a parent's plan at age 26\n* `lost_medicaid_chip_medicare` - Losing Medicaid, CHIP, or Medicare eligibility\n* `lost_decertified_individual_plan` - Losing individual coverage because a plan was decertified\n* `married` - Getting married\n* `divorced` - Getting divorced or legally separated\n* `had_baby` - Having a baby\n* `adopted_child` - Adopting a child\n* `foster_care_placement` - Foster-care placement\n* `death_of_spouse_or_dependent` - Death of a covered spouse or dependent\n* `court_ordered` - Court order to add a dependent\n* `moved_to_new_coverage_area` - Moving to a new ZIP code, county, or state where different plans are available\n* `moved_to_us` - Moving to the U.S. from another country\n* `moved_to_or_from_school_housing` - Moving to or from school housing\n* `moved_to_or_from_seasonal_work_housing` - Moving to or from housing for seasonal work\n* `became_us_citizen` - Becoming a U.S. citizen\n* `left_incarceration` - Leaving incarceration\n* `gained_tribal_status` - Gaining status as a member of a federally recognized tribe or Alaska Native corporation\n* `started_or_ended_americorps_service` - Starting or ending AmeriCorps service\n* `new_child` - New child\n* `other` - Other"},"event_type_label":{"type":"string","description":"Human-readable label for event_type"},"other_event":{"type":["string","null"],"description":"Custom event description when event_type is Other; otherwise normally null"},"status":{"$ref":"#/components/schemas/QualifyingLifeEventStatus","description":"Review status of the qualifying life event\n\n* `pending` - Pending\n* `approved` - Approved\n* `denied` - Denied"},"submitted_at":{"type":"string","format":"date-time","description":"When the member submitted the event"}},"required":["id","event_type","event_type_label","other_event","status","submitted_at"],"title":"MemberQualifyingLifeEvent"},"MemberQualifyingLifeEventListResponse":{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/MemberQualifyingLifeEvent"},"description":"This page of qualifying life events."},"pagination":{"$ref":"#/components/schemas/Pagination","description":"Page metadata. Request the next page by incrementing `page`."}},"required":["data","pagination"],"description":"Paginated list response containing member qualifying life event resources.","title":"MemberQualifyingLifeEventListResponse"},"MemberEnrollmentAuditOperation":{"type":"string","enum":["enrolled","terminated","reissued"],"description":"* `enrolled` - Enrolled\n* `terminated` - Terminated\n* `reissued` - Reissued","title":"MemberEnrollmentAuditOperation"},"ActorType":{"type":"string","enum