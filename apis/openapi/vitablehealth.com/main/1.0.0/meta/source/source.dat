cy"],"description":"One plan year, detail view.\n\nStandalone (no shared base) so the exact detail payload is readable in one place; the list\nserializer is a separate class even where fields overlap. Detail carries the SPD link and omits\nthe list-only ``is_current`` flag.","title":"BenefitPlanYearDetail"},"EmployerBenefitPlanYearResponse":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/BenefitPlanYearDetail","description":"The benefit plan year, including its plans and contribution rules."}},"required":["data"],"description":"Response containing a single employer benefit plan year resource.","title":"EmployerBenefitPlanYearResponse"},"ElectionStatusItems":{"type":"string","enum":["Enrolled","Expired","Pending","Waived"],"title":"ElectionStatusItems"},"ElectionStatus":{"type":"array","items":{"$ref":"#/components/schemas/ElectionStatusItems"},"description":"Filter by election status. Repeat the parameter to match several.","title":"ElectionStatus"},"EmployerSearch":{"type":"string","description":"Case-insensitive search. Matches member name partially, and the `member_id` exactly — either your own reference id or the prefixed `grpmbr_<...>` id.","title":"EmployerSearch"},"PlanYearEnrollmentElectionStatus":{"type":"string","enum":["Enrolled","Waived","Pending","Expired"],"description":"* `Enrolled` - Enrolled\n* `Waived` - Waived\n* `Pending` - Pending\n* `Expired` - Expired","title":"PlanYearEnrollmentElectionStatus"},"PlanYearEnrollmentPolicyStatus":{"type":"string","enum":["Coverage Upcoming","Coverage Effective","Coverage Ended","Cancelled"],"description":"* `Coverage Upcoming` - Coverage Upcoming\n* `Coverage Effective` - Coverage Effective\n* `Coverage Ended` - Coverage Ended\n* `Cancelled` - Cancelled","title":"PlanYearEnrollmentPolicyStatus"},"PlanYearIchraAffordability":{"type":"string","enum":["Affordable","Not Affordable"],"description":"* `Affordable` - Affordable\n* `Not Affordable` - Not Affordable","title":"PlanYearIchraAffordability"},"PlanYearEnrollment":{"type":"object","properties":{"member_id":{"type":"string","description":"Our id for the person (`mbr_<...>`). Stable across every employer they work for."},"employee_id":{"type":"string","description":"Our id for this person's employment with this employer (`empl_<...>`). A person who leaves and is rehired has two."},"employee_external_reference_id":{"type":["string","null"],"description":"Your own reference id for this employee, as you supplied it. Null when you have not set one."},"member_first_name":{"type":"string","description":"The member's first name."},"member_last_name":{"type":"string","description":"The member's last name."},"election_status":{"$ref":"#/components/schemas/PlanYearEnrollmentElectionStatus","description":"Where the member stands: `Enrolled` or `Waived` if they answered, otherwise `Pending` while their enrollment window is open and `Expired` once it has closed.\n\n* `Enrolled` - Enrolled\n* `Waived` - Waived\n* `Pending` - Pending\n* `Expired` - Expired"},"policy_status":{"oneOf":[{"$ref":"#/components/schemas/PlanYearEnrollmentPolicyStatus"},{"type":"null"}],"description":"Where the member's coverage stands: `Coverage Upcoming`, `Coverage Effective`, `Coverage Ended`, or `Cancelled`. Null unless the member enrolled.\n\n* `Coverage Upcoming` - Coverage Upcoming\n* `Coverage Effective` - Coverage Effective\n* `Coverage Ended` - Coverage Ended\n* `Cancelled` - Cancelled"},"dependent_count":{"type":"integer","minimum":0,"description":"Dependents covered under this enrollment today. Counts the same dependents `premium_in_cents` is priced for, so a dependent whose termination is dated in the future still counts."},"carrier":{"type":["string","null"],"description":"The carrier for this enrollment: the individual-market carrier for an ICHRA plan, otherwise the benefit's own. Null when the benefit has no carrier."},"plan":{"type":["string","null"],"description":"Chosen plan name, or null when unanswered/waived."},"tier":{"