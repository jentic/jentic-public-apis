A)."},"network_names":{"type":"array","items":{"type":"string"},"description":"Displayed networks: [\"multi\"] for ICHRA, otherwise the plan year's distinct network names."},"premium_in_cents":{"type":["integer","null"],"description":"Monthly premium in cents; only for an ICHRA benefit with effective coverage."},"employee_contribution":{"oneOf":[{"$ref":"#/components/schemas/ContributionRange"},{"type":"null"}],"description":"Employee contribution range."},"employer_contribution":{"oneOf":[{"$ref":"#/components/schemas/ContributionRange"},{"type":"null"}],"description":"Employer contribution range."},"status":{"$ref":"#/components/schemas/BenefitStatus","description":"`active`/`upcoming`/`inactive`.\n\n* `active` - Active\n* `upcoming` - Upcoming\n* `open_enrollment` - Open Enrollment\n* `inactive` - Inactive"},"coverage_start":{"type":"string","format":"date","description":"Coverage start."},"coverage_end":{"type":["string","null"],"format":"date","description":"Coverage end."},"open_enrollment_start":{"type":"string","format":"date","description":"Open-enrollment start."},"open_enrollment_end":{"type":["string","null"],"format":"date","description":"Open-enrollment end."},"offered_states":{"type":"array","items":{"type":"string"},"description":"Distinct offered state codes."},"is_current":{"type":"boolean","description":"Whether this is the current plan year."},"enrollment_rate":{"$ref":"#/components/schemas/EnrollmentRate","description":"Enrolled/eligible rate for this plan year."}},"required":["benefit_plan_year_id","benefit_id","year","family","product_name","carrier","network_names","premium_in_cents","employee_contribution","employer_contribution","status","coverage_start","coverage_end","open_enrollment_start","open_enrollment_end","offered_states","is_current","enrollment_rate"],"description":"One plan year, list view.\n\nStandalone (no shared base) so the exact list payload is readable in one place; the detail\nserializer is a separate class even where fie