ry","description":"Items per page (default: 20, max: 100)","required":false,"schema":{"$ref":"#/components/schemas/Limit","default":20}},{"name":"page","in":"query","description":"Page number (default: 1)","required":false,"schema":{"$ref":"#/components/schemas/Page","default":1}},{"name":"search","in":"query","description":"Case-insensitive search. Matches member name partially, and the `member_id` exactly — either your own reference id or the prefixed `grpmbr_<...>` id.","required":false,"schema":{"$ref":"#/components/schemas/EmployerSearch"}},{"name":"X-Vitable-Organization","in":"header","description":"Organization to act as for this request (e.g. `org_SGVsbG8gV29ybGQ`). Optional when your credentials reach a single organization. Required when they reach several — omitting it then returns 400 `organization_required`. A malformed value returns 400 `invalid_organization_header`, and naming an organization you do not have access to returns 403 `organization_access_denied`.","required":false,"schema":{"$ref":"#/components/schemas/XVitableOrganization"}}],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PlanYearEnrollmentListResponse"}}}},"400":{"description":"Bad Request - Invalid input or validation error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"401":{"description":"Unauthorized - Invalid or missing API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"403":{"description":"Forbidden - Insufficient permissions for this resource","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"404":{"description":"Resource not found.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"409":{"description":"Conflict - Resource already exists or conflicts with current state","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse