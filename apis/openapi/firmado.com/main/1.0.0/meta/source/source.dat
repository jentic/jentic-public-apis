{
  "openapi": "3.0.3",
  "info": {
    "title": "Firmado API",
    "description": "Firmado is a Cloudflare-native document signing microservice for Tesoro CRM.\n\n## Authentication\nAll API endpoints require authentication using an API key in the `X-API-Key` header.\n\n## Rate Limits\n- 100 requests/minute per API key\n- 1,000 submissions/day per tenant\n",
    "version": "1.0.0",
    "contact": {
      "name": "Firmado Support",
      "email": "support@firmado.com"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/JOHN_89/firmado-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.firmado.com/v1",
      "description": "Production"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "tags": [
    {
      "name": "Templates",
      "description": "Manage document templates"
    },
    {
      "name": "Submissions",
      "description": "Create and manage signing requests"
    },
    {
      "name": "Webhooks",
      "description": "Configure webhook endpoints"
    }
  ],
  "paths": {
    "/templates": {
      "get": {
        "tags": [
          "Templates"
        ],
        "summary": "List templates",
        "description": "Get a list of all templates for the authenticated tenant",
        "operationId": "listTemplates",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 50,
              "maximum": 100
            },
            "description": "Maximum number of templates to return"
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 0
            },
            "description": "Number of templates to skip"
          },
          {
            "name": "archived",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Include archived templates"
          }
        ],
        "responses": {
          "200": {
            "description": "List of templates",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "templates": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Template"
                      }
                    },
                    "total": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "post": {
        "tags": [
          "Templates"
        ],
        "summary": "Create template",
        "description": "Upload a PDF and create a new template",
        "operationId": "createTemplate",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "file"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Template name",
                    "example": "Purchase Contract"
                  },
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "PDF file to upload"
                  },
                  "folder_id": {
                    "type": "string",
                    "description": "Optional folder ID"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Template created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Template"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/templates/{templateId}": {
      "get": {
        "tags": [
          "Templates"
        ],
        "summary": "Get template",
        "description": "Get details of a specific template",
        "operationId": "getTemplate",
        "parameters": [
          {
            "$ref": "#/components/parameters/templateId"
          }
        ],
        "responses": {
          "200": {
            "description": "Template details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Template"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "patch": {
        "tags": [
          "Templates"
        ],
        "summary": "Update template",
        "description": "Update template name or schema",
        "operationId": "updateTemplate",
        "parameters": [
          {
            "$ref": "#/components/parameters/templateId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "schema": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Template updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Template"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Templates"
        ],
        "summary": "Delete template",
        "description": "Delete a template (soft delete)",
        "operationId": "deleteTemplate",
        "parameters": [
          {
            "$ref": "#/components/parameters/templateId"
          }
        ],
        "responses": {
          "204": {
            "description": "Template deleted"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/templates/{templateId}/clone": {
      "post": {
        "tags": [
          "Templates"
        ],
        "summary": "Clone template",
        "description": "Create a copy of an existing template",
        "operationId": "cloneTemplate",
        "parameters": [
          {
            "$ref": "#/components/parameters/templateId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Copy of Purchase Contract"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Template cloned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Template"
                }
              }
            }
          }
        }
      }
    },
    "/submissions": {
      "get": {
        "tags": [
          "Submissions"
        ],
        "summary": "List submissions",
        "description": "Get a list of all submissions",
        "operationId": "listSubmissions",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "pending",
                "completed",
                "declined",
                "expired"
              ]
            },
            "description": "Filter by status"
          },
          {
            "name": "template_id",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Filter by template ID"
          },
          {
            "name": "external_id",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Filter by external ID (e.g., Tesoro deal ID)"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 50
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of submissions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "submissions": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Submission"
                      }
                    },
                    "total": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Submissions"
        ],
        "summary": "Create submission",
        "description": "Create a new signing request. This will:\n1. Create the submission with all submitters\n2. Optionally send invitation emails to submitters\n3. Return signing URLs for each submitter\n",
        "operationId": "createSubmission",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSubmissionRequest"
              },
              "examples": {
                "basic": {
                  "summary": "Basic submission",
                  "value": {
                    "template_id": "tpl_abc123",
                    "submitters": [
                      {
                        "name": "Jan Jansen",
                        "email": "jan@example.com",
                        "role": "Buyer"
                      }
                    ]
                  }
                },
                "tesoro": {
                  "summary": "Tesoro CRM integration",
                  "value": {
                    "template_id": "tpl_abc123",
                    "external_id": "tesoro_deal_12345",
                    "send_email": true,
                    "submitters": [
                      {
                        "name": "Jan Jansen",
                        "email": "jan@example.com",
                        "role": "Buyer 1"
                      },
                      {
                        "name": "Marie Jansen",
                        "email": "marie@example.com",
                        "role": "Buyer 2"
                      },
                      {
                        "name": "Piet Pietersen",
                        "email": "piet@example.com",
                        "role": "Seller"
                      }
                    ],
                    "metadata": {
                      "deal_id": "12345",
                      "deal_name": "Hoofdstraat 1, Amsterdam",
                      "agent_email": "agent@realestate.nl"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Submission created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Submission"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "description": "Template not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/submissions/{submissionId}": {
      "get": {
        "tags": [
          "Submissions"
        ],
        "summary": "Get submission",
        "description": "Get details of a specific submission including all submitters and their status",
        "operationId": "getSubmission",
        "parameters": [
          {
            "$ref": "#/components/parameters/submissionId"
          }
        ],
        "responses": {
          "200": {
            "description": "Submission details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Submission"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/submissions/{submissionId}/download": {
      "get": {
        "tags": [
          "Submissions"
        ],
        "summary": "Download signed PDF",
        "description": "Download the signed PDF document. Only available for completed submissions.",
        "operationId": "downloadSignedPdf",
        "parameters": [
          {
            "$ref": "#/components/parameters/submissionId"
          }
        ],
        "responses": {
          "200": {
            "description": "Signed PDF file",
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "Submission not completed"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/submissions/{submissionId}/audit-trail-pdf": {
      "get": {
        "tags": [
          "Submissions"
        ],
        "summary": "Download audit trail",
        "description": "Download the audit trail as a PDF document with timestamps, IP addresses, and signatures.",
        "operationId": "downloadAuditTrail",
        "parameters": [
          {
            "$ref": "#/components/parameters/submissionId"
          }
        ],
        "responses": {
          "200": {
            "description": "Audit trail PDF",
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/submissions/{submissionId}/send-reminders": {
      "post": {
        "tags": [
          "Submissions"
        ],
        "summary": "Send reminders",
        "description": "Send reminder emails to all submitters who haven't completed yet",
        "operationId": "sendReminders",
        "parameters": [
          {
            "$ref": "#/components/parameters/submissionId"
          }
        ],
        "responses": {
          "200": {
            "description": "Reminders sent",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "sent_to": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "example": [
                        "jan@example.com",
                        "marie@example.com"
                      ]
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/webhooks": {
      "get": {
        "tags": [
          "Webhooks"
        ],
        "summary": "List webhooks",
        "description": "Get all configured webhook endpoints",
        "operationId": "listWebhooks",
        "responses": {
          "200": {
            "description": "List of webhooks",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "webhooks": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Webhook"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Webhooks"
        ],
        "summary": "Create webhook",
        "description": "Register a new webhook endpoint",
        "operationId": "createWebhook",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "url",
                  "events"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "example": "https://api.tesoro.nl/webhooks/firmado"
                  },
                  "events": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "submission.created",
                        "submission.completed",
                        "submission.declined",
                        "submission.expired",
                        "submitter.completed"
                      ]
                    },
                    "example": [
                      "submission.completed",
                      "submission.declined"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Webhook created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Webhook"
                }
              }
            }
          }
        }
      }
    },
    "/webhooks/{webhookId}": {
      "delete": {
        "tags": [
          "Webhooks"
        ],
        "summary": "Delete webhook",
        "description": "Remove a webhook endpoint",
        "operationId": "deleteWebhook",
        "parameters": [
          {
            "name": "webhookId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Webhook deleted"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "API key for authentication. Format: `fir_live_...` (production) or `fir_test_...` (test)\n"
      }
    },
    "parameters": {
      "templateId": {
        "name": "templateId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "Template ID (e.g., tpl_abc123)",
        "example": "tpl_abc123"
      },
      "submissionId": {
        "name": "submissionId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "Submission ID (e.g., sub_xyz789)",
        "example": "sub_xyz789"
      }
    },
    "schemas": {
      "Template": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "tpl_abc123"
          },
          "name": {
            "type": "string",
            "example": "Purchase Contract"
          },
          "schema": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Field definitions"
          },
          "folder_id": {
            "type": "string",
            "nullable": true
          },
          "archived": {
            "type": "boolean",
            "default": false
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Submission": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "sub_xyz789"
          },
          "template_id": {
            "type": "string",
            "example": "tpl_abc123"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "completed",
              "declined",
              "expired"
            ]
          },
          "external_id": {
            "type": "string",
            "nullable": true,
            "example": "tesoro_deal_12345"
          },
          "submitters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Submitter"
            }
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "completed_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "Submitter": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "smr_001"
          },
          "name": {
            "type": "string",
            "example": "Jan Jansen"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "jan@example.com"
          },
          "role": {
            "type": "string",
            "example": "Buyer 1"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "awaiting",
              "completed",
              "declined"
            ]
          },
          "signing_url": {
            "type": "string",
            "format": "uri",
            "example": "https://sign.firmado.com/s/abc123"
          },
          "completed_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "CreateSubmissionRequest": {
        "type": "object",
        "required": [
          "template_id",
          "submitters"
        ],
        "properties": {
          "template_id": {
            "type": "string",
            "description": "ID of the template to use",
            "example": "tpl_abc123"
          },
          "external_id": {
            "type": "string",
            "description": "Your reference ID (e.g., Tesoro deal ID)",
            "example": "tesoro_deal_12345"
          },
          "send_email": {
            "type": "boolean",
            "default": true,
            "description": "Send invitation emails to submitters"
          },
          "submitters": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "object",
              "required": [
                "name",
                "email",
                "role"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "example": "Jan Jansen"
                },
                "email": {
                  "type": "string",
                  "format": "email",
                  "example": "jan@example.com"
                },
                "role": {
                  "type": "string",
                  "example": "Buyer 1"
                },
                "phone": {
                  "type": "string",
                  "example": "+31612345678"
                }
              }
            }
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true,
            "description": "Custom metadata to store with the submission",
            "example": {
              "deal_id": "12345",
              "deal_name": "Hoofdstraat 1, Amsterdam"
            }
          }
        }
      },
      "Webhook": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "whk_abc123"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "events": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "secret": {
            "type": "string",
            "description": "Secret for signature verification (only shown once on creation)"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "Template not found"
          },
          "code": {
            "type": "string",
            "example": "NOT_FOUND"
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "Missing required field",
              "code": "INVALID_REQUEST"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Invalid or missing API key",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "Invalid API key",
              "code": "UNAUTHORIZED"
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "Resource not found",
              "code": "NOT_FOUND"
            }
          }
        }
      },
      "RateLimited": {
        "description": "Rate limit exceeded",
        "headers": {
          "X-RateLimit-Limit": {
            "schema": {
              "type": "integer"
            },
            "description": "Request limit per minute"
          },
          "X-RateLimit-Remaining": {
            "schema": {
              "type": "integer"
            },
            "description": "Remaining requests"
          },
          "X-RateLimit-Reset": {
            "schema": {
              "type": "integer"
            },
            "description": "Unix timestamp when limit resets"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "Rate limit exceeded",
              "code": "RATE_LIMITED"
            }
          }
        }
      }
    }
  }
}
