        }
      }
    },
    "/v1/public/vouchers/lookup": {
      "get": {
        "tags": ["Customer Vouchers"],
        "operationId": "lookupCustomerVoucher",
        "summary": "Look up voucher by code",
        "description": "Finds a customer voucher by its exact human-readable code.",
        "x-remy-scope": "vouchers:read",
        "security": [{ "ApiKeyAuth": [] }],
        "parameters": [{ "name": "code", "in": "query", "required": true, "schema": { "type": "string" }, "example": "GIFT8HD42K", "description": "Issued voucher code." }],
        "responses": {
          "200": { "description": "Voucher retrieved.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CustomerVoucherResponse" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/v1/public/vouchers/{id}/cancel": {
      "post": {
        "tags": ["Customer Vouchers"],
        "operationId": "cancelCustomerVoucher",
        "summary": "Cancel voucher",
        "description": "Cancels an eligible customer voucher and records the reason. This operation requires an idempotency key.",
        "x-remy-scope": "vouchers:manage",
        "security": [{ "ApiKeyAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/VoucherId" }, { "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReasonRequest" }, "example": { "reason": "Customer order refunded" } } } },
        "responses": {
          "200": { "description": "Voucher cancelled.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CustomerVoucherResponse" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/NotFound" }, "409": { "$ref": "#/components/responses/Conflict" }, "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/v1/public/vouchers/{id}/adjust": {
      "post": {
        "tags": ["Customer Vouchers"],
        "operationId": "adjustCustomerVoucher",
        "summary": "Adjust voucher balance",
        "description": "Sets a customer voucher's remaining value and records an immutable adjustment reason. The value cannot exceed the original value. This operation requires an idempotency key.",
        "x-remy-scope": "vouchers:manage",
        "security": [{ "ApiKeyAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/VoucherId" }, { "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AdjustVoucherRequest" }, "example": { "remainingValue": 20, "reason": "Till correction REF-1042" } } } },
        "responses": {
          "200": { "description": "Voucher balance adjusted.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CustomerVoucherResponse" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/NotFound" }, "409": { "$ref": "#/components/responses/Conflict" }, "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/v1/public/vouchers/{id}/send": {
      "post": {
        "tags": ["Customer Vouchers"],
        "operationId": "sendCustomerVoucher",
        "summary": "Send voucher email",
        "description": "Emails an eligible customer voucher to its recorded recipient. This operation requires an idempotency key.",
        "x-remy-scope": "vouchers:manage",
        "security": [{ "ApiKeyAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/VoucherId" }, { "$ref": "#/components/parameters/IdempotencyKey" }],
        "responses": {
          "200": { "description": "Voucher email sent.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MessageResponse" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "403": { "$ref": "#/components/responses/Forbidden" }, "404": { "$ref": "#/components/responses/NotFound" }, "409": { "$ref": "#/components/responses/Conflict" }, "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "The API key from the merchant's Remy integration settings."
      }
    },
    "parameters": {
      "VoucherId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "The customer voucher's returned `id` or `externalId`.",
        "schema": {
          "type": "string",
          "example": "66c735e253f2836fbe941234"
        }
      },
      "ResourceId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "The resource's returned `id` or `externalId`.",
        "schema": { "type": "string", "example": "66c735e253f2836fbe941234" }
      },
      "CustomerId": {
        "name": "customerId",
        "in": "path",
        "required": true,
        "description": "The customer's returned `id` or `externalId`.",
        "schema": { "type": "string", "example": "66c735e253f2836fbe941235" }
      },
      "CustomerCardId": {
        "name": "cardId",
        "in": "path",
        "required": true,
        "description": "The customer loyalty-card instance's returned `id` or `externalId`, not its template ID.",
        "schema": { "type": "string", "example": "66c735e253f2836fbe941237" }
      },
      "CustomerRewardId": {
        "name": "rewardId",
        "in": "path",
        "required": true,
        "description": "The customer reward's returned `id` or `externalId`, not its template ID.",
        "schema": { "type": "string", "example": "66c735e253f2836fbe941236" }
      },
      "CustomerVoucherId": {
        "name": "voucherId",
        "in": "path",
        "required": true,
        "description": "The customer voucher instance's returned `id` or `externalId`, not its template ID.",
        "schema": { "type": "string", "example": "66c735e253f2836fbe941239" }
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "required": false,
        "description": "Opaque `nextCursor` returned by the previous list request. Do not construct or modify it.",
        "schema": { "type": "string" }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "description": "Maximum resources to return.",
        "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "description": "A unique key for this logical write operation. Keys are retained for 24 hours.",
        "schema": { "type": "string", "minLength": 8, "maxLength": 200, "example": "order-1042-redeem-1" }
      },
      "IdempotencyKeyOptional": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": false,
        "description": "Recommended unique key for this logical write operation. Keys are retained for 24 hours.",
        "schema": { "type": "string", "minLength": 8, "maxLength": 200, "example": "order-1042-operation-1" }
      }
    },
    "schemas": {
      "CursorPagination": {
        "type": "object",
        "required": ["limit", "hasMore", "nextCursor"],
        "properties": {
          "limit": { "type": "integer" },
          "hasMore": { "type": "boolean" },
          "nextCursor": { "type": "string", "nullable": true }
        }
      },
      "CustomerSummary": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "externalId": { "type": "string" },
          "name": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "lifetimeStamps": { "type": "number" },
          "lifetimePoints": { "type": "number" },
          "lifetimeRedemptions": { "type": "number" },
          "rewardsIssued": { "type": "number" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "orderNumber": { "type": "string" },
          "value": { "type": "number" },
          "source": { "type": "string" },
          "type": { "type": "string" },
          "sku": { "type": "string" },
          "integrationType": { "type": "string" },
          "stampsAwarded": { "type": "number" },
          "customerId": { "type": "string", "nullable": true },
          "customer": { "$ref": "#/components/schemas/VoucherRecipient" },
          "cardId": { "type": "string", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "CustomerReward": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "externalId": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "value": { "type": "number" },
          "couponCode": { "type": "string" },
          "status": { "type": "string", "enum": ["active", "redeemed", "expired"] },
          "expiry": { "type": "string", "format": "date-time", "nullable": true },
          "redeemedAt": { "type": "string", "format": "date-time", "nullable": true },
          "customer": { "$ref": "#/components/schemas/CustomerSummary" },
          "locationId": { "type": "string", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "RewardTemplate": {
        "type": "object",
        "description": "A merchant-owned reward definition. It is not a customer reward instance.",
        "properties": {
          "id": { "type": "string" },
          "externalId": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "hiddenText": { "type": "string" },
          "value": { "type": "number" },
          "active": { "type": "boolean" },
          "giftable": { "type": "boolean" },
          "expiryDays": { "type": "number", "description": "Number of days an issued instance remains valid. Zero means no configured expiry." },
          "locationIds": { "type": "array", "items": { "type": "string" } },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "Card": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "externalId": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "terms": { "type": "string" },
          "active": { "type": "boolean" },
          "type": { "type": "string" },
          "numberOfStamps": { "type": "number" },
          "joinStamps": { "type": "number" },
          "points": { "type": "object", "additionalProperties": true },
          "rewards": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
          "locationIds": { "type": "array", "items": { "type": "string" } },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "CustomerCard": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "externalId": { "type": "string" },
          "cardId": { "type": "string", "description": "ID of the merchant loyalty-card template." },
          "title": { "type": "string" },
          "type": { "type": "string" },
          "stamps": { "type": "number" },
          "points": { "type": "number" },
          "resets": { "type": "number" },
          "lastActivityAt": { "type": "string", "format": "date-time", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "OrderResponse": {
        "type": "object",
        "required": ["success", "data"],
        "properties": { "success": { "type": "boolean" }, "data": { "$ref": "#/components/schemas/Order" } },
        "example": { "success": true, "data": { "id": "66c735e253f2836fbe941234", "orderNumber": "ORDER-1042", "value": 24.5, "source": "Shopify", "integrationType": "zapier", "stampsAwarded": 2, "customerId": "66c735e253f2836fbe941235", "createdAt": "2026-08-23T11:00:00.000Z" } }
      },
      "OrderListResponse": {
        "type": "object",
        "properties": { "success": { "type": "boolean" }, "data": { "type": "array", "items": { "$ref": "#/components/schemas/Order" } }, "pagination": { "$ref": "#/components/schemas/CursorPagination" } },
        "example": { "success": true, "data": [], "pagination": { "limit": 25, "hasMore": false, "nextCursor": null } }
      },
      "CustomerResponse": {
        "type": "object",
        "properties": { "success": { "type": "boolean" }, "data": { "$ref": "#/components/schemas/CustomerSummary" } },
        "example": { "success": true, "data": { "id": "66c735e253f2836fbe941235", "externalId": "P6d3kL9xQ2", "name": "Alex Morgan", "email": "alex@example.com", "lifetimeStamps": 14, "lifetimePoints": 230 } }
      },
      "CustomerListResponse": {
        "type": "object",
        "properties": { "success": { "type": "boolean" }, "data": { "type": "array", "items": { "$ref": "#/components/schemas/CustomerSummary" } }, "pagination": { "$ref": "#/components/schemas/CursorPagination" } },
        "example": { "success": true, "data": [], "pagination": { "limit": 25, "hasMore": false, "nextCursor": null } }
      },
      "CustomerLoyaltyResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data": {
            "type": "object",
            "properties": {
              "customer": { "$ref": "#/components/schemas/CustomerSummary" },
              "cards": { "type": "array", "items": { "$ref": "#/components/schemas/CustomerCard" } },
              "rewards": { "type": "array", "items": { "$ref": "#/components/schemas/CustomerReward" } },
              "vouchers": { "type": "array", "items": { "$ref": "#/components/schemas/CustomerVoucher" } }
            }
          }
        },
        "example": { "success": true, "data": { "customer": { "id": "66c735e253f2836fbe941235", "name": "Alex Morgan", "email": "alex@example.com" }, "cards": [], "rewards": [], "vouchers": [] } }
      },
      "RewardTemplateResponse": {
        "type": "object",
        "properties": { "success": { "type": "boolean" }, "data": { "$ref": "#/components/schemas/RewardTemplate" } },
        "example": { "success": true, "data": { "id": "66c735e253f2836fbe941236", "title": "Free Coffee", "description": "Any regular coffee", "active": true, "expiryDays": 30 } }
      },
      "RewardTemplateListResponse": {
        "type": "object",
        "properties": { "success": { "type": "boolean" }, "data": { "type": "array", "items": { "$ref": "#/components/schemas/RewardTemplate" } }, "pagination": { "$ref": "#/components/schemas/CursorPagination" } },
        "example": { "success": true, "data": [], "pagination": { "limit": 25, "hasMore": false, "nextCursor": null } }
      },
      "CustomerRewardResponse": {
        "type": "object",
        "properties": { "success": { "type": "boolean" }, "data": { "$ref": "#/components/schemas/CustomerReward" } },
        "example": { "success": true, "data": { "id": "66c735e253f2836fbe941236", "title": "Free Coffee", "status": "active", "expiry": "2026-09-23T11:00:00.000Z" } }
      },
      "CustomerRewardListResponse": {
        "type": "object",
        "properties": { "success": { "type": "boolean" }, "data": { "type": "array", "items": { "$ref": "#/components/schemas/CustomerReward" } }, "pagination": { "$ref": "#/components/schemas/CursorPagination" } },
        "example": { "success": true, "data": [], "pagination": { "limit": 25, "hasMore": false, "nextCursor": null } }
      },
      "CardResponse": {
        "type": "object",
        "properties": { "success": { "type": "boolean" }, "data": { "$ref": "#/components/schemas/Card" } },
        "example": { "success": true, "data": { "id": "66c735e253f2836fbe941237", "title": "Coffee Club", "active": true, "type": "stamp", "numberOfStamps": 10 } }
      },
      "CardListResponse": {
        "type": "object",
        "properties": { "success": { "type": "boolean" }, "data": { "type": "array", "items": { "$ref": "#/components/schemas/Card" } }, "pagination": { "$ref": "#/components/schemas/CursorPagination" } },
        "example": { "success": true, "data": [], "pagination": { "limit": 25, "hasMore": false, "nextCursor": null } }
      },
      "CustomerCardResponse": {
        "type": "object",
        "properties": { "success": { "type": "boolean" }, "data": { "$ref": "#/components/schemas/CustomerCard" } },
        "example": { "success": true, "data": { "id": "66c735e253f2836fbe941237", "cardId": "66c735e253f2836fbe941238", "title": "Coffee Club", "type": "stamp", "stamps": 4, "points": 0 } }
      },
      "CustomerCardListResponse": {
        "type": "object",
        "properties": { "success": { "type": "boolean" }, "data": { "type": "array", "items": { "$ref": "#/components/schemas/CustomerCard" } }, "pagination": { "$ref": "#/components/schemas/CursorPagination" } },
        "example": { "success": true, "data": [], "pagination": { "limit": 25, "hasMore": false, "nextCursor": null } }
      },
      "CustomerCardMutationResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "stampsGiven": { "type": "integer" },
          "pointsGiven": { "type": "number" },
          "issuedRewardIds": { "type": "array", "items": { "type": "string" } },
          "data": { "$ref": "#/components/schemas/CustomerCard" }
        }
      },
      "GiveCustomerRewardResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/CustomerReward" } }
        }
      },
      "MeResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data": { "type": "object", "properties": { "merchant": { "type": "object", "additionalProperties": true }, "integration": { "type": "object", "additionalProperties": true }, "scopes": { "type": "array", "items": { "type": "string" } } } }
        },
        "example": { "success": true, "data": { "merchant": { "id": "66c735e253f2836fbe941230", "name": "Example Coffee" }, "integration": { "id": "66c735e253f2836fbe941231", "type": "zapier" }, "scopes": ["orders:read", "vouchers:read"] } }
      },
      "UsageResponse": {
        "type": "object",
        "properties": { "success": { "type": "boolean" }, "data": { "type": "object", "additionalProperties": true } },
        "example": { "success": true, "data": { "minute": { "used": 12, "limit": 120, "remaining": 108 }, "day": { "used": 340, "limit": 10000, "remaining": 9660, "windowSeconds": 86400 }, "concurrencyLimit": 10, "endpointLimits": { "orderCreationsPerMinute": 60, "voucherRedemptionsPerMinute": 60, "voucherPdfsPerMinute": 10 }, "endpoints": [{ "method": "GET", "route": "/v1/public/customers", "requests": 120, "errors": 2, "averageDurationMs": 34 }] } }
      },
      "IssueVoucherRequest": {
        "type": "object",
        "required": ["voucherTemplateId"],
        "properties": {
          "voucherTemplateId": { "type": "string", "description": "Active merchant voucher-template ID." },
          "customerId": { "type": "string", "description": "Existing customer ID. Supply this or recipientEmail." },
          "recipientEmail": { "type": "string", "format": "email", "description": "Recipient email. Supply this or customerId." },
          "recipientName": { "type": "string" },
          "value": { "type": "number", "exclusiveMinimum": 0, "description": "Required for a monetary-value template; ignored for a fixed-value template." },
          "send": { "type": "boolean", "default": false, "description": "Attempt to email the voucher immediately." },
          "externalReference": { "type": "string", "description": "Your reference for this issuance." }
        }
      },
      "RedeemRewardRequest": {
        "type": "object",
        "properties": { "locationId": { "type": "string", "description": "Optional active merchant location responsible for the redemption." } }
      },
      "GiveLoyaltyQuantityRequest": {
        "type": "object",
        "required": ["quantity"],
        "properties": {
          "quantity": { "type": "number", "exclusiveMinimum": 0 },
          "locationId": { "type": "string", "description": "Optional active merchant location responsible for the award." }
        }
      },
      "AdjustCustomerPointsRequest": {
        "type": "object",
        "required": ["points"],
        "properties": {
          "points": { "type": "number", "minimum": 0, "description": "New absolute balance for the open-ended points card." }
        }
      },
      "GiveCustomerRewardRequest": {
        "type": "object",
        "required": ["rewardId"],
        "properties": {
          "rewardId": { "type": "string", "description": "Active merchant reward-template ID." },
          "quantity": { "type": "integer", "minimum": 1, "maximum": 100, "default": 1 },
          "locationId": { "type": "string", "description": "Optional active merchant location responsible for the issuance." }
        }
      },
      "ReasonRequest": {
        "type": "object",
        "required": ["reason"],
        "properties": { "reason": { "type": "string", "description": "Human-readable audit reason." } }
      },
      "AdjustVoucherRequest": {
        "type": "object",
        "required": ["remainingValue", "reason"],
        "properties": {
          "remainingValue": { "type": "number", "minimum": 0, "description": "New absolute remaining balance; it cannot exceed the issued value." },
          "reason": { "type": "string", "description": "Human-readable audit reason." }
        }
      },
      "MessageResponse": {
        "type": "object",
        "properties": { "success": { "type": "boolean" }, "message": { "type": "string" } },
        "example": { "success": true, "message": "Voucher email sent" }
      },
      "AuthResponse": {
        "type": "object",
        "required": ["success", "merchant"],
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Whether authentication succeeded."
          },
          "merchant": {
            "type": "string",
            "description": "The name of the connected merchant."
          }
        }
      },
      "CreateOrderRequest": {
        "type": "object",
        "required": ["customer_email", "order_value", "order_source"],
        "properties": {
          "customer_email": {
            "type": "string",
            "format": "email",
            "description": "Email address used to find or create the customer."
          },
          "order_value": {
            "oneOf": [{ "type": "number" }, { "type": "string" }],
            "description": "Order value as a number or a numeric string."
          },
          "order_number": {
            "type": "string",
            "description": "Source-system order identifier. Remy generates an identifier when this is omitted or invalid."
          },
          "order_source": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9]+$",
            "description": "Source system name containing letters and numbers only."
          },
          "first_name": {
            "type": "string",
            "description": "Customer's first name."
          },
          "name": {
            "type": "string",
            "description": "Customer's full name."
          },
          "coupon_code": {
            "type": "string",
            "description": "Coupon to redeem when reward automation is enabled."
          }
        }
      },
      "CreateOrderResponse": {
        "type": "object",
        "required": ["success", "stamps", "rewards", "points", "couponRedeemed"],
        "properties": {
          "success": { "type": "boolean" },
          "stamps": {
            "type": "integer",
            "description": "Number of stamps awarded."
          },
          "rewards": {
            "type": "array",
            "description": "Rewards issued while processing the order.",
            "items": { "type": "object", "additionalProperties": true }
          },
          "points": {
            "type": "number",
            "description": "Number of points awarded."
          },
          "couponRedeemed": {
            "type": "boolean",
            "description": "Whether the supplied coupon matched and redeemed an active reward."
          }
        }
      },
      "UpdateRewardCouponRequest": {
        "type": "object",
        "required": ["userRewardId", "couponCode"],
        "properties": {
          "userRewardId": {
            "type": "string",
            "description": "Identifier of the issued customer reward."
          },
          "couponCode": {
            "type": "string",
            "description": "Coupon code to attach to the reward. Remy converts it to uppercase."
          }
        }
      },
      "UpdateRewardCouponResponse": {
        "type": "object",
        "required": ["success", "userRewardId", "couponCode"],
        "properties": {
          "success": { "type": "boolean" },
          "userRewardId": {
            "type": "string",
            "description": "Identifier of the updated reward."
          },
          "couponCode": {
            "type": "string",
            "description": "The stored uppercase coupon code."
          }
        }
      },
      "VoucherTemplate": {
        "type": "object",
        "description": "A merchant-owned voucher definition. It is not a customer voucher instance.",
        "properties": {
          "id": { "type": "string" },
          "externalId": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "type": { "type": "string", "enum": ["fixed", "monetary"] },
          "value": { "type": "number", "nullable": true },
          "cost": { "type": "number", "nullable": true },
          "currency": { "type": "object", "additionalProperties": true },
          "expiryDays": { "type": "number", "nullable": true },
          "quantityLimit": { "type": "number", "nullable": true },
          "active": { "type": "boolean" },
          "terms": { "type": "string" },
          "allowPartialRedemption": { "type": "boolean" },
          "monetaryOptions": { "type": "object", "nullable": true, "additionalProperties": true },
          "visibility": { "type": "array", "items": { "type": "string", "enum": ["app", "web"] } },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "VoucherTemplateResponse": {
        "type": "object",
        "properties": { "success": { "type": "boolean" }, "data": { "$ref": "#/components/schemas/VoucherTemplate" } },
        "example": { "success": true, "data": { "id": "66c735e253f2836fbe941111", "title": "£25 Gift Voucher", "type": "fixed", "value": 25, "currency": { "symbol": "£", "code": "GBP" }, "active": true } }
      },
      "VoucherTemplateListResponse": {
        "type": "object",
        "properties": { "success": { "type": "boolean" }, "data": { "type": "array", "items": { "$ref": "#/components/schemas/VoucherTemplate" } }, "pagination": { "$ref": "#/components/schemas/CursorPagination" } },
        "example": { "success": true, "data": [], "pagination": { "limit": 25, "hasMore": false, "nextCursor": null } }
      },
      "CustomerVoucher": {
        "type": "object",
        "required": [
          "id",
          "code",
          "title",
          "value",
          "remainingValue",
          "status",
          "allowPartialRedemption",
          "recipient",
          "redemptions",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Identifier of this customer voucher instance."
          },
          "externalId": {
            "type": "string",
            "description": "Stable short identifier for this customer voucher."
          },
          "code": {
            "type": "string",
            "description": "Human-readable voucher code."
          },
          "title": {
            "type": "string",
            "description": "Voucher title captured for the issued instance."
          },
          "value": {
            "type": "number",
            "description": "Original voucher value."
          },
          "remainingValue": {
            "type": "number",
            "description": "Value still available to redeem."
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217 currency code."
          },
          "status": {
            "type": "string",
            "enum": ["pending", "active", "expired", "redeemed", "cancelled", "partial"]
          },
          "allowPartialRedemption": {
            "type": "boolean",
            "description": "Whether the voucher can be redeemed over multiple transactions."
          },
          "expiry": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "recipient": {
            "$ref": "#/components/schemas/VoucherRecipient"
          },
          "redemptions": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/VoucherRedemption" }
          },
          "adjustments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "previousRemainingValue": { "type": "number" },
                "remainingValue": { "type": "number" },
                "amount": { "type": "number" },
                "reason": { "type": "string" },
                "date": { "type": "string", "format": "date-time" }
              }
            }
          },
          "cancellation": {
            "type": "object",
            "nullable": true,
            "properties": {
              "reason": { "type": "string" },
              "date": { "type": "string", "format": "date-time" }
            }
          },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "VoucherRecipient": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "email": { "type": "string", "format": "email" }
        }
      },
      "VoucherRedemption": {
        "type": "object",
        "required": ["amount", "type", "date"],
        "properties": {
          "amount": { "type": "number" },
          "type": { "type": "string", "enum": ["full", "partial"] },
          "date": { "type": "string", "format": "date-time" }
        }
      },
      "Pagination": {
        "type": "object",
        "required": ["currentPage", "totalPages", "totalItems", "itemsPerPage", "hasNextPage", "hasPrevPage"],
        "properties": {
          "currentPage": { "type": "integer", "nullable": true },
          "totalPages": { "type": "integer" },
          "totalItems": { "type": "integer" },
          "itemsPerPage": { "type": "integer" },
          "hasNextPage": { "type": "boolean" },
          "hasPrevPage": { "type": "boolean", "nullable": true },
          "hasMore": { "type": "boolean" },
          "nextCursor": { "type": "string", "nullable": true }
        }
      },
      "CustomerVoucherResponse": {
        "type": "object",
        "required": ["success", "data"],
        "properties": {
          "success": { "type": "boolean" },
          "emailSent": { "type": "boolean", "description": "Present when issuing a voucher." },
          "data": { "$ref": "#/components/schemas/CustomerVoucher" }
        }
      },
      "CustomerVoucherListResponse": {
        "type": "object",
        "required": ["success", "data", "pagination"],
        "properties": {
          "success": { "type": "boolean" },
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/CustomerVoucher" }
          },
          "pagination": { "$ref": "#/components/schemas/CursorPagination" }
        }
      },
      "RedeemVoucherRequest": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Amount to redeem. Omit to redeem the full remaining value."
          }
        }
      },
      "RedeemVoucherResponse": {
        "type": "object",
        "required": ["success", "redeemedAmount", "data"],
        "properties": {
          "success": { "type": "boolean" },
          "redeemedAmount": { "type": "number" },
          "data": { "$ref": "#/components/schemas/CustomerVoucher" }
        }
      },
      "Error": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "integer" },
          "message": { "type": "string" }
        }
      },
      "RateLimitError": {
        "type": "object",
        "required": ["code", "message", "retryAfter"],
        "properties": {
          "code": { "type": "integer", "example": 429 },
          "message": { "type": "string" },
          "retryAfter": {
            "type": "integer",
            "description": "Seconds to wait before retrying."
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "The request is missing a required value or contains invalid data.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": {
              "code": 400,
              "message": "Customer email not provided"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "The API key is missing or invalid.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": {
              "code": 401,
              "message": "Invalid API key"
            }
          }
        }
      },
      "Forbidden": {
        "description": "The API key is valid but does not have the required scope.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": { "code": 403, "message": "API key does not have the required scope" }
          }
        }
      },
      "Conflict": {
        "description": "The idempotency key is already processing or was used for a different request.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": { "code": 409, "message": "Idempotency-Key has already been used for a different request" }
          }
        }
      },
      "NotFound": {
        "description": "The requested integration resource was not found.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": {
              "code": 404,
              "message": "Merchant not found"
            }
          }
        }
      },
      "InternalServerError": {
        "description": "The voucher PDF could not be generated.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": {
              "code": 500,
              "message": "Failed to generate voucher PDF"
            }
          }
        }
      },
      "TooManyRequests": {
        "description": "A rate or concurrency limit was exceeded.",
        "headers": {
          "Retry-After": {
            "description": "Seconds to wait before retrying.",
            "schema": { "type": "integer" }
          },
          "RateLimit-Limit": {
            "description": "Maximum requests allowed in the active window.",
            "schema": { "type": "integer" }
          },
          "RateLimit-Remaining": {
            "description": "Requests remaining in the active window.",
            "schema": { "type": "integer" }
          },
          "RateLimit-Reset": {
            "description": "Seconds until the active window resets.",
            "schema": { "type": "integer" }
          }
        },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/RateLimitError" },
            "example": {
              "code": 429,
              "message": "Public API rate limit exceeded",
              "retryAfter": 42
            }
          }
        }
      }
    }
  }
}
