{
  "openapi": "3.0.3",
  "info": {
    "title": "Remy Public API",
    "version": "1.3.0",
    "description": "Public integration endpoints for orders, customers, merchant loyalty-card, reward, and voucher templates, customer loyalty state, and API usage in Remy."
  },
  "servers": [
    {
      "url": "https://api.remyrewards.co.uk",
      "description": "Production"
    }
  ],
  "tags": [
    {
      "name": "Authentication",
      "description": "Verify integration credentials."
    },
    {
      "name": "Orders",
      "description": "Send completed orders to Remy and reconcile order history."
    },
    {
      "name": "Customers",
      "description": "Read merchant customers and their loyalty state."
    },
    {
      "name": "Rewards",
      "description": "Read merchant reward templates."
    },
    {
      "name": "Customer Rewards",
      "description": "Read, issue, update, and redeem customer reward instances."
    },
    {
      "name": "Vouchers",
      "description": "Read merchant voucher templates."
    },
    {
      "name": "Customer Vouchers",
      "description": "Read, issue, deliver, adjust, cancel, and redeem customer voucher instances."
    },
    {
      "name": "Loyalty Cards",
      "description": "Read merchant loyalty-card templates."
    },
    {
      "name": "Customer Loyalty Cards",
      "description": "Read customer loyalty-card instances and change their stamp or point balances."
    },
    {
      "name": "Usage",
      "description": "Inspect the authenticated integration and its API usage."
    }
  ],
  "paths": {
    "/v1/public/auth": {
      "get": {
        "tags": ["Authentication"],
        "operationId": "verifyApiKey",
        "summary": "Verify an API key",
        "description": "Verifies the API key and returns the merchant connected to the integration",
        "x-remy-scope": null,
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "The API key is valid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                },
                "example": {
                  "success": true,
                  "merchant": "Example Coffee"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/v1/public/orders/create": {
      "post": {
        "tags": ["Orders"],
        "operationId": "createOrder",
        "summary": "Process an order",
        "description": "Sends a completed order to Remy. Depending on the merchant's Developer API order settings, the order can award stamps or points, issue rewards, and redeem an existing coupon. Developer API order settings are configured independently from Zapier and other integrations.",
        "x-remy-scope": "orders:write",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrderRequest"
              },
              "example": {
                "customer_email": "alex@example.com",
                "order_value": 24.5,
                "order_number": "ORDER-1042",
                "order_source": "Shopify",
                "first_name": "Alex",
                "name": "Alex Morgan",
                "coupon_code": "WELCOME10"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The order was processed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateOrderResponse"
                },
                "example": {
                  "success": true,
                  "stamps": 2,
                  "rewards": [],
                  "points": 24,
                  "couponRedeemed": false
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/v1/public/rewards/update-coupon": {
      "post": {
        "tags": ["Customer Rewards"],
        "operationId": "updateRewardCoupon",
        "summary": "Update a reward coupon code",
        "description": "Sets the coupon code on a reward belonging to the authenticated merchant. Redeemed or expired rewards cannot be updated. Coupon codes are stored in uppercase.",
        "x-remy-scope": "rewards:write",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKeyOptional" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateRewardCouponRequest"
              },
              "example": {
                "userRewardId": "66c735e253f2836fbe941234",
                "couponCode": "summer20"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The coupon code was updated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpdateRewardCouponResponse"
                },
                "example": {
                  "success": true,
                  "userRewardId": "66c735e253f2836fbe941234",
                  "couponCode": "SUMMER20"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/v1/public/vouchers": {
      "get": {
        "tags": ["Vouchers"],
        "operationId": "listVoucherTemplates",
        "summary": "Get vouchers",
        "description": "Lists the merchant's voucher templates. Customer voucher instances are available under `/customers/{customerId}/vouchers`.",
        "x-remy-scope": "vouchers:read",
        "security": [{ "ApiKeyAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/Cursor" },
          { "$ref": "#/components/parameters/Limit" },
          { "name": "active", "in": "query", "schema": { "type": "boolean" }, "description": "Filter by active state." }
        ],
        "responses": {
          "200": {
            "description": "Voucher templates retrieved.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/VoucherTemplateListResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      },
      "post": {
        "tags": ["Customer Vouchers"],
        "operationId": "issueVoucher",
        "summary": "Issue voucher",
        "description": "Issues one customer voucher from an active merchant voucher template. This operation requires an idempotency key.",
        "x-remy-scope": "vouchers:issue",
        "security": [{ "ApiKeyAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/IssueVoucherRequest" },
              "example": {
                "voucherTemplateId": "66c735e253f2836fbe941111",
                "recipientEmail": "alex@example.com",
                "recipientName": "Alex Morgan",
                "send": true,
                "externalReference": "CRM-ISSUE-1042"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Voucher issued.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CustomerVoucherResponse" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/v1/public/vouchers/{id}": {
      "get": {
        "tags": ["Vouchers"],
        "operationId": "getVoucherTemplate",
        "summary": "Get voucher by ID",
        "description": "Returns one merchant voucher template.",
        "x-remy-scope": "vouchers:read",
        "security": [{ "ApiKeyAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/ResourceId" }],
        "responses": {
          "200": {
            "description": "Voucher template retrieved.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/VoucherTemplateResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/v1/public/vouchers/{id}/pdf": {
      "get": {
        "tags": ["Customer Vouchers"],
        "operationId": "downloadCustomerVoucherPdf",
        "summary": "Get voucher PDF",
        "description": "Generates and downloads a PDF for a customer voucher.",
        "x-remy-scope": "vouchers:read",
        "security": [{ "ApiKeyAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/VoucherId" }],
        "responses": {
          "200": {
            "description": "Voucher PDF.",
            "headers": {
              "Content-Disposition": {
                "description": "Attachment filename for the voucher PDF.",
                "schema": { "type": "string" }
              }
            },
            "content": {
              "application/pdf": {
                "schema": { "type": "string", "format": "binary" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/v1/public/vouchers/{id}/redeem": {
      "post": {
        "tags": ["Customer Vouchers"],
        "operationId": "redeemCustomerVoucher",
        "summary": "Redeem voucher",
        "description": "Redeems a customer voucher. Omit `amount` to redeem the full remaining value. Supply a positive amount smaller than the remaining value for a partial redemption; the voucher must allow partial redemption.",
        "x-remy-scope": "vouchers:redeem",
        "security": [{ "ApiKeyAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/VoucherId" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RedeemVoucherRequest" },
              "example": { "amount": 10 }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Voucher redeemed in full or in part.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RedeemVoucherResponse" },
                "example": {
                  "success": true,
                  "redeemedAmount": 10,
                  "data": {
                    "id": "66c735e253f2836fbe941234",
                    "code": "GIFT-8HD42K",
                    "title": "£25 Gift Voucher",
                    "value": 25,
                    "remainingValue": 15,
                    "currency": "GBP",
                    "status": "partial",
                    "allowPartialRedemption": true,
                    "expiry": "2027-08-23T23:59:59.000Z",
                    "recipient": { "name": "Alex Morgan", "email": "alex@example.com" },
                    "redemptions": [{ "amount": 10, "type": "partial", "date": "2026-08-23T11:00:00.000Z" }],
                    "createdAt": "2026-08-01T09:00:00.000Z",
                    "updatedAt": "2026-08-23T11:00:00.000Z"
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/v1/public/me": {
      "get": {
        "tags": ["Authentication"],
        "operationId": "getPublicApiIdentity",
        "summary": "Get API identity",
        "description": "Returns the merchant, integration, and scopes associated with the API key.",
        "x-remy-scope": "profile:read",
        "security": [{ "ApiKeyAuth": [] }],
        "responses": {
          "200": { "description": "API identity retrieved.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MeResponse" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/v1/public/usage": {
      "get": {
        "tags": ["Usage"],
        "operationId": "getPublicApiUsage",
        "summary": "Get API usage",
        "description": "Returns request usage for the current rolling minute and 24-hour windows.",
        "x-remy-scope": "usage:read",
        "security": [{ "ApiKeyAuth": [] }],
        "responses": {
          "200": { "description": "Usage retrieved.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UsageResponse" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/v1/public/orders": {
      "get": {
        "tags": ["Orders"],
        "operationId": "listOrders",
        "summary": "Get orders",
        "description": "Lists orders processed for the authenticated merchant in newest-first order.",
        "x-remy-scope": "orders:read",
        "security": [{ "ApiKeyAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/Cursor" },
          { "$ref": "#/components/parameters/Limit" },
          { "name": "orderNumber", "in": "query", "schema": { "type": "string" }, "description": "Filter by an exact source-system order number." },
          { "name": "customerId", "in": "query", "schema": { "type": "string" }, "description": "Filter by a customer ID." }
        ],
        "responses": {
          "200": { "description": "Orders retrieved.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrderListResponse" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/v1/public/orders/{id}": {
      "get": {
        "tags": ["Orders"],
        "operationId": "getOrder",
        "summary": "Get order by ID",
        "description": "Returns one processed order belonging to the authenticated merchant.",
        "x-remy-scope": "orders:read",
        "security": [{ "ApiKeyAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/ResourceId" }],
        "responses": {
          "200": { "description": "Order retrieved.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrderResponse" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/v1/public/customers": {
      "get": {
        "tags": ["Customers"],
        "operationId": "listCustomers",
        "summary": "Get customers",
        "description": "Lists merchant-specific customer records. Use email for exact lookup or search for a case-insensitive name or email match.",
        "x-remy-scope": "customers:read",
        "security": [{ "ApiKeyAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/Cursor" },
          { "$ref": "#/components/parameters/Limit" },
          { "name": "email", "in": "query", "schema": { "type": "string", "format": "email" }, "description": "Filter by an exact email address." },
          { "name": "search", "in": "query", "schema": { "type": "string" }, "description": "Search names and email addresses." }
        ],
        "responses": {
          "200": { "description": "Customers retrieved.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CustomerListResponse" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/v1/public/customers/{id}": {
      "get": {
        "tags": ["Customers"],
        "operationId": "getCustomer",
        "summary": "Get customer by ID",
        "description": "Returns one merchant-specific customer record.",
        "x-remy-scope": "customers:read",
        "security": [{ "ApiKeyAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/ResourceId" }],
        "responses": {
          "200": { "description": "Customer retrieved.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CustomerResponse" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/v1/public/customers/{id}/loyalty": {
      "get": {
        "tags": ["Customers"],
        "operationId": "getCustomerLoyalty",
        "summary": "Get customer loyalty",
        "description": "Returns a consolidated customer view containing customer loyalty cards, customer rewards, and customer vouchers.",
        "x-remy-scope": "customers:read",
        "security": [{ "ApiKeyAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/ResourceId" }],
        "responses": {
          "200": { "description": "Customer loyalty state retrieved.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CustomerLoyaltyResponse" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/v1/public/customers/{customerId}/cards": {
      "get": {
        "tags": ["Customer Loyalty Cards"],
        "operationId": "listCustomerLoyaltyCards",
        "summary": "Get customer loyalty cards",
        "description": "Lists loyalty-card instances belonging to one merchant customer, including their current stamp or point balances.",
        "x-remy-scope": "customers:read",
        "security": [{ "ApiKeyAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/CustomerId" },
          { "$ref": "#/components/parameters/Cursor" },
          { "$ref": "#/components/parameters/Limit" }
        ],
        "responses": {
          "200": { "description": "Customer loyalty cards retrieved.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CustomerCardListResponse" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/v1/public/customers/{customerId}/cards/{cardId}": {
      "get": {
        "tags": ["Customer Loyalty Cards"],
        "operationId": "getCustomerLoyaltyCard",
        "summary": "Get customer loyalty card by ID",
        "description": "Returns one customer loyalty-card instance. The card ID identifies the customer instance, while `cardId` in the response identifies its merchant template.",
        "x-remy-scope": "customers:read",
        "security": [{ "ApiKeyAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/CustomerId" },
          { "$ref": "#/components/parameters/CustomerCardId" }
        ],
        "responses": {
          "200": { "description": "Customer loyalty card retrieved.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CustomerCardResponse" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/v1/public/customers/{customerId}/cards/{cardId}/stamps": {
      "post": {
        "tags": ["Customer Loyalty Cards"],
        "operationId": "giveCustomerStamps",
        "summary": "Give stamps",
        "description": "Adds stamps to a customer stamp card and issues any rewards reached through the card progression. This operation requires an idempotency key.",
        "x-remy-scope": "customers:write",
        "security": [{ "ApiKeyAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/CustomerId" },
          { "$ref": "#/components/parameters/CustomerCardId" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GiveLoyaltyQuantityRequest" }, "example": { "quantity": 1, "locationId": "66c735e253f2836fbe941333" } } } },
        "responses": {
          "200": { "description": "Stamps given.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CustomerCardMutationResponse" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/v1/public/customers/{customerId}/cards/{cardId}/points": {
      "post": {
        "tags": ["Customer Loyalty Cards"],
        "operationId": "giveCustomerPoints",
        "summary": "Give points",
        "description": "Adds points to a customer points card and issues any rewards reached through the card progression. This operation requires an idempotency key.",
        "x-remy-scope": "customers:write",
        "security": [{ "ApiKeyAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/CustomerId" },
          { "$ref": "#/components/parameters/CustomerCardId" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GiveLoyaltyQuantityRequest" }, "example": { "quantity": 25, "locationId": "66c735e253f2836fbe941333" } } } },
        "responses": {
          "200": { "description": "Points given.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CustomerCardMutationResponse" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/v1/public/customers/{customerId}/cards/{cardId}/points/adjust": {
      "post": {
        "tags": ["Customer Loyalty Cards"],
        "operationId": "adjustCustomerPoints",
        "summary": "Adjust points",
        "description": "Sets the absolute balance of an open-ended customer points card. This does not change the customer's lifetime-points counter. This operation requires an idempotency key.",
        "x-remy-scope": "customers:write",
        "security": [{ "ApiKeyAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/CustomerId" },
          { "$ref": "#/components/parameters/CustomerCardId" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
