        "description": "Lists the merchant's loyalty-card definitions. These are programme definitions, not customer card instances.",
        "x-remy-scope": "cards:read",
        "security": [{ "ApiKeyAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/Cursor" },
          { "$ref": "#/components/parameters/Limit" },
