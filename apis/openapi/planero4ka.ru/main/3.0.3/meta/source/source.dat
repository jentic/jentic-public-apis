        "schema": {
          "type": "string"
        },
        "example": "P-2"
      },
      "CommentId": {
        "name": "commentId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "HistoryEntryId": {
        "name": "historyEntryId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "ArchiveId": {
        "name": "archiveId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      },
      "MediaId": {
        "name": "mediaId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 100
        }
      },
      "CommentsLimit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 200
        }
      },
      "Offset": {
        "name": "offset",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      },
      "OrderDesc": {
        "name": "order",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "enum": [
            "asc",
            "desc"
          ],
          "default": "desc"
        }
      },
      "OrderAsc": {
        "name": "order",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "enum": [
            "asc",
            "desc"
          ],
          "default": "asc"
        }
      },
      "HistoryKind": {
        "name": "kind",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "enum": [
            "all",
            "create",
            "move",
            "delete",
            "restore"
          ]
        }
      },
      "FavoritesStatus": {
        "name": "status",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "enum": [
            "all",
            "queue",
            "doing",
            "review",
            "done",
            "freedom"
          ]
        }
      },
      "ArchiveReason": {
        "name": "reason",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "enum": [
            "all",
            "overflow",
            "delete",
            "card-delete"
          ]
        }
      }
    },
    "responses": {
      "ErrorResponse": {
        "description": "Error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "examples": {
              "generic": {
                "value": {
                  "error": "INVALID_REQUEST",
                  "message": "Validation failed"
                }
              },
              "repeatedDelete": {
                "value": {
                  "error": "Ты реально пытаешься удалить удаленное второй раз?"
                }
              }
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Unauthorized",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "examples": {
              "unauthorized": {
                "value": {
                  "error": "UNAUTHORIZED"
                }
              }
            }
          }
        }
      },
      "BadRequest": {
        "description": "Bad request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "index": {
            "type": "integer"
          },
          "cardId": {
            "type": "string"
          },
          "currentVersion": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "windowMs": {
            "type": "integer"
          },
          "retryAfterMs": {
            "type": "integer"
          }
        },
        "additionalProperties": true
      },
      "User": {
        "type": "object",
        "required": [
          "id",
          "login",
          "email"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "login": {
            "type": "string",
            "minLength": 2,
            "maxLength": 32,
            "pattern": "^[A-Za-zА-Яа-яЁё]+$"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "avatarUrl": {
            "type": "string",
            "nullable": true,
            "description": "data:image/*;base64,..."
          },
          "firstName": {
            "type": "string",
            "nullable": true,
            "maxLength": 96
          },
          "lastName": {
            "type": "string",
            "nullable": true,
            "maxLength": 96
          },
          "birthDate": {
            "type": "string",
            "nullable": true,
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "role": {
            "type": "string",
            "nullable": true,
            "maxLength": 128
          },
          "city": {
            "type": "string",
            "nullable": true,
            "maxLength": 128
          },
          "about": {
            "type": "string",
            "nullable": true,
            "maxLength": 2000
          }
        }
      },
      "UserEnvelope": {
        "type": "object",
        "required": [
          "user"
        ],
        "properties": {
          "user": {
            "$ref": "#/components/schemas/User"
          }
        }
      },
      "AuthResponse": {
        "type": "object",
        "required": [
          "token",
          "user"
        ],
        "properties": {
          "token": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        }
      },
      "OkResponse": {
        "type": "object",
        "required": [
          "ok"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": [
          "login",
          "email",
          "password"
        ],
        "properties": {
          "login": {
            "type": "string",
            "minLength": 2,
            "maxLength": 32,
            "pattern": "^[A-Za-zА-Яа-яЁё]+$",
            "description": "Только кириллица/латиница, без цифр и символов"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 6
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "login",
          "password"
        ],
        "properties": {
          "login": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "ProfilePatchRequest": {
        "type": "object",
        "description": "Все поля опциональны. birthDate должен быть валидной датой и 16+.",
        "properties": {
          "login": {
            "type": "string",
            "minLength": 2,
            "maxLength": 32,
            "pattern": "^[A-Za-zА-Яа-яЁё]+$"
          },
          "avatarUrl": {
            "type": "string",
            "nullable": true,
            "description": "data:image/(png|jpeg|webp|gif);base64,..."
          },
          "firstName": {
            "type": "string",
            "nullable": true,
            "maxLength": 96
          },
          "lastName": {
            "type": "string",
            "nullable": true,
            "maxLength": 96
          },
          "birthDate": {
            "type": "string",
            "nullable": true,
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "role": {
            "type": "string",
            "nullable": true,
            "maxLength": 128
          },
          "city": {
            "type": "string",
            "nullable": true,
            "maxLength": 128
          },
          "about": {
            "type": "string",
            "nullable": true,
            "maxLength": 150
          }
        }
      },
      "BoardPutRequest": {
        "type": "object",
        "required": [
          "state"
        ],
        "properties": {
          "state": {
            "$ref": "#/components/schemas/BoardState"
          },
          "baseVersion": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "expectedVersion": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          }
        }
      },
      "BoardState": {
        "type": "object",
        "required": [
          "cardsById",
          "columns",
          "floatingById",
          "history"
        ],
        "properties": {
          "cardsById": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/Card"
            }
          },
          "columns": {
            "type": "object",
            "required": [
              "queue",
              "doing",
              "review",
              "done"
            ],
            "properties": {
              "queue": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "doing": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "review": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "done": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "floatingById": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "x",
                "y",
                "swayOffsetMs"
              ],
              "properties": {
                "x": {
                  "type": "integer"
                },
                "y": {
                  "type": "integer"
                },
                "swayOffsetMs": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "history": {
            "type": "array",
            "maxItems": 500,
            "items": {
              "$ref": "#/components/schemas/HistoryEntry"
            }
          }
        }
      },
      "CardImageInput": {
        "type": "object",
        "description": "Для входа обязателен id и минимум fileId или dataUrl",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 128
          },
          "fileId": {
            "type": "string"
          },
          "dataUrl": {
            "type": "string",
            "description": "data:image/*;base64,..."
          },
          "mime": {
            "type": "string",
            "enum": [
              "image/png",
              "image/jpeg",
              "image/webp",
              "image/gif"
            ]
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 921600
          },
          "name": {
            "type": "string",
            "maxLength": 128
          },
          "createdAt": {
            "type": "integer",
            "format": "int64"
          },
          "previewFileId": {
            "type": "string",
            "nullable": true
          },
          "previewUrl": {
            "type": "string",
            "nullable": true
          },
          "previewMime": {
            "type": "string",
            "nullable": true,
            "enum": [
              "image/png",
              "image/jpeg",
              "image/webp",
              "image/gif"
            ]
          },
          "previewSize": {
            "type": "integer",
            "nullable": true,
            "minimum": 1,
            "maximum": 921600
          }
        },
        "oneOf": [
          {
            "required": [
              "fileId"
            ]
          },
          {
            "required": [
              "dataUrl"
            ]
          }
        ]
      },
      "CardImage": {
        "type": "object",
        "required": [
          "id",
          "dataUrl",
          "mime",
          "size",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "fileId": {
            "type": "string",
            "nullable": true
          },
          "dataUrl": {
            "type": "string"
          },
          "mime": {
            "type": "string",
            "enum": [
              "image/png",
              "image/jpeg",
              "image/webp",
              "image/gif"
            ]
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 921600
          },
          "name": {
            "type": "string",
            "nullable": true,
            "maxLength": 128
          },
          "createdAt": {
            "type": "integer",
            "format": "int64"
          },
          "previewFileId": {
            "type": "string",
            "nullable": true
          },
          "previewUrl": {
            "type": "string",
            "nullable": true
          },
          "previewMime": {
            "type": "string",
            "nullable": true,
            "enum": [
              "image/png",
              "image/jpeg",
              "image/webp",
              "image/gif"
            ]
          },
          "previewSize": {
            "type": "integer",
            "nullable": true
          }
        }
      },
      "ChecklistItemInput": {
        "type": "object",
        "description": "Поля id и text обязательны, иначе элемент будет отброшен сервером.",
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 128,
            "example": "chk-001"
          },
          "text": {
            "type": "string",
            "maxLength": 220,
            "example": "Согласовать макет"
          },
          "done": {
            "type": "boolean",
            "default": false
          },
          "createdAt": {
            "type": "integer",
            "format": "int64",
            "example": 1771800000000
          }
        }
      },
      "ChecklistItem": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ChecklistItemInput"
          },
          {
            "type": "object",
            "required": [
              "id",
              "text",
              "done",
              "createdAt"
            ]
          }
        ]
      },
      "Comment": {
        "type": "object",
        "required": [
          "id",
          "text",
          "images",
          "createdAt",
          "updatedAt",
          "author"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 128
          },
          "text": {
            "type": "string",
            "maxLength": 4000,
            "description": "Rich text HTML после серверной санитизации"
          },
          "images": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "$ref": "#/components/schemas/CardImage"
            }
          },
          "createdAt": {
            "type": "integer",
            "format": "int64"
          },
          "updatedAt": {
            "type": "integer",
            "format": "int64"
          },
          "author": {
            "type": "string",
            "nullable": true,
            "maxLength": 64
          }
        }
      },
      "Card": {
        "type": "object",
        "required": [
          "id",
          "title",
          "description",
          "images",
          "checklist",
          "createdBy",
          "isFavorite",
          "comments",
          "createdAt",
          "status",
          "urgency",
          "doingStartedAt",
          "doingTotalMs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "P-1"
          },
          "title": {
            "type": "string",
            "maxLength": 512
          },
          "description": {
            "type": "string",
            "maxLength": 5000
          },
          "images": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "$ref": "#/components/schemas/CardImage"
            }
          },
          "checklist": {
            "type": "array",
            "maxItems": 120,
            "items": {
              "$ref": "#/components/schemas/ChecklistItem"
            }
          },
          "createdBy": {
            "type": "string",
            "nullable": true,
            "maxLength": 64
          },
          "isFavorite": {
            "type": "boolean"
          },
          "comments": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "$ref": "#/components/schemas/Comment"
            }
          },
          "createdAt": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "type": "string",
            "enum": [
              "queue",
              "doing",
              "review",
              "done",
              "freedom"
            ]
          },
          "urgency": {
            "type": "string",
            "enum": [
              "white",
              "yellow",
              "pink",
              "red"
            ]
          },
          "doingStartedAt": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "doingTotalMs": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "CardCreateRequest": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 512
          },
          "description": {
            "type": "string",
            "maxLength": 5000
          },
          "urgency": {
            "type": "string",
            "enum": [
              "white",
              "yellow",
              "pink",
              "red"
            ],
            "default": "white"
          },
          "columnId": {
            "type": "string",
            "enum": [
              "queue",
              "doing",
              "review",
              "done"
            ],
            "default": "queue"
          },
          "index": {
            "type": "integer"
          },
          "images": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "$ref": "#/components/schemas/CardImageInput"
            }
          },
          "checklist": {
            "type": "array",
            "maxItems": 120,
            "items": {
              "$ref": "#/components/schemas/ChecklistItemInput"
            }
          }
        },
        "example": {
          "title": "Подготовить релиз",
          "description": "Финальный проход по задачам",
          "urgency": "yellow",
          "columnId": "queue",
          "index": 0,
          "checklist": [
            {
              "id": "chk-001",
              "text": "Прогнать тесты",
              "done": false,
              "createdAt": 1771800000000
            },
            {
              "id": "chk-002",
              "text": "Проверить миграции",
              "done": false,
              "createdAt": 1771800100000
            }
          ]
        }
      },
      "CardPatchRequest": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 512
          },
          "description": {
            "type": "string",
            "maxLength": 5000
          },
          "urgency": {
            "type": "string",
            "enum": [
              "white",
              "yellow",
              "pink",
              "red"
            ]
          },
          "isFavorite": {
            "type": "boolean"
          },
          "images": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "$ref": "#/components/schemas/CardImageInput"
            }
          },
          "checklist": {
            "type": "array",
            "maxItems": 120,
            "items": {
              "$ref": "#/components/schemas/ChecklistItemInput"
            }
          }
        }
      },
      "CardMoveRequest": {
        "type": "object",
        "required": [
          "toColumnId"
        ],
        "properties": {
          "toColumnId": {
            "type": "string",
            "enum": [
              "queue",
              "doing",
              "review",
              "done"
            ]
          },
          "toIndex": {
            "type": "integer"
          }
        }
      },
      "BulkMoveRequest": {
        "type": "object",
        "required": [
          "moves"
        ],
        "properties": {
          "continueOnError": {
            "type": "boolean",
            "default": false
          },
          "moves": {
            "type": "array",
            "minItems": 1,
            "maxItems": 200,
            "items": {
              "type": "object",
              "required": [
                "cardId",
                "toColumnId"
              ],
              "properties": {
                "cardId": {
                  "type": "string"
                },
                "toColumnId": {
                  "type": "string",
                  "enum": [
                    "queue",
                    "doing",
                    "review",
                    "done"
                  ]
                },
                "toIndex": {
                  "type": "integer"
                }
              }
            }
          }
        }
      },
      "BulkDeleteRequest": {
        "type": "object",
        "required": [
          "cardIds"
        ],
        "properties": {
          "continueOnError": {
            "type": "boolean",
            "default": false
          },
          "cardIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 200,
            "items": {
              "type": "string"
            }
          }
        }
      },
      "CommentCreateRequest": {
        "type": "object",
        "description": "Передай text или images (или оба). Пустой text без изображений не пройдет.",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 4000
          },
          "images": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "$ref": "#/components/schemas/CardImageInput"
            }
          }
        }
      },
      "CommentPatchRequest": {
        "type": "object",
        "description": "Если поле images не передать, картинки комментария останутся как есть.",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 4000
          },
          "images": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "$ref": "#/components/schemas/CardImageInput"
            }
          }
        }
      },
      "MediaUploadRequest": {
        "type": "object",
        "required": [
          "mime",
          "dataBase64"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 128
          },
          "name": {
            "type": "string",
            "maxLength": 128
          },
          "mime": {
            "type": "string",
            "enum": [
              "image/png",
              "image/jpeg",
              "image/webp",
              "image/gif"
            ]
          },
          "dataBase64": {
            "type": "string",
            "description": "Только payload base64 без префикса data:..."
          },
          "createdAt": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "HistoryMeta": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 512
          },
          "fromCol": {
            "type": "string",
