{
  "openapi": "3.1.0",
  "info": {
    "title": "Network Data Labs API",
    "version": "0.1.0",
    "summary": "IP geolocation and IP intelligence API",
    "description": "Developer-first IP intelligence API from Network Data Labs.\n\nEvery geo response includes `accuracy_radius_km` and `confidence` — we do not publish\nsingle-number \"99% city accuracy\" claims.\n\n**Base URL:** `https://api.networkdatalabs.com`\n\n**Auth:** `Authorization: Bearer <api_key>` or `?api_key=`\n\n**Languages:** Docs and support in Spanish and English.\n",
    "contact": {
      "name": "Network Data Labs",
      "email": "hello@networkdatalabs.com",
      "url": "https://networkdatalabs.com"
    },
    "license": {
      "name": "Proprietary",
      "url": "https://networkdatalabs.com"
    },
    "x-jentic-source-url": "https://www.networkdatalabs.com/openapi.json"
  },
  "servers": [
    {
      "url": "https://api.networkdatalabs.com",
      "description": "Production"
    }
  ],
  "paths": {
    "/v0/ip": {
      "get": {
        "tags": [
          "IP Lookup"
        ],
        "operationId": "getOwnIpLookup",
        "summary": "Look up your own IP",
        "description": "Same response as `GET /v0/ip/{ip}`, for the IP the request comes from\n(the caller's public IP as seen by the API). Counts toward the daily quota\nlike any other lookup.\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/ApiKeyQueryOptional"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful lookup of the caller's IP",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IpLookup"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidIp"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          }
        }
      }
    },
    "/v0/ip/{ip}": {
      "get": {
        "tags": [
          "IP Lookup"
        ],
        "operationId": "getIpLookup",
        "summary": "Full IP intelligence lookup",
        "description": "Primary endpoint. Returns location (with accuracy radius + confidence),\nnetwork/ASN, traits (hosting/Tor/VPN/relay/etc.).\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/IpPath"
          },
          {
            "$ref": "#/components/parameters/ApiKeyQueryOptional"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful lookup",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IpLookup"
                },
                "examples": {
                  "google_dns": {
                    "summary": "8.8.8.8 (Google Public DNS)",
                    "value": {
                      "ip": "8.8.8.8",
                      "location": {
                        "continent_code": "NA",
                        "country_code": "US",
                        "country": "United States",
                        "is_eu": false,
                        "region": "California",
                        "region_code": "CA",
                        "city": "Mountain View",
                        "postal": null,
                        "latitude": 37.422,
                        "longitude": -122.085,
                        "timezone": "America/Los_Angeles",
                        "accuracy_radius_km": 50.0,
                        "confidence": "medium"
                      },
                      "network": {
                        "asn": 15169,
                        "as_org": "Google LLC",
                        "isp": "Google LLC",
                        "organization": "Google LLC",
                        "network": "8.8.8.0/24"
                      },
                      "traits": {
                        "is_anycast": true,
                        "is_hosting": true,
                        "is_mobile": false,
                        "is_satellite": false,
                        "is_bogon": false,
                        "is_proxy": false,
                        "is_vpn": false,
                        "is_tor": false,
                        "is_relay": false
                      }
                    }
                  },
                  "us_ip": {
                    "summary": "4.2.2.2 (US example)",
                    "value": {
                      "ip": "4.2.2.2",
                      "location": {
                        "continent_code": "NA",
                        "country_code": "US",
                        "country": "United States",
                        "is_eu": false,
                        "region": "Kansas",
                        "region_code": null,
                        "city": "Independence",
                        "postal": null,
                        "latitude": 37.2262,
                        "longitude": -95.7341,
                        "timezone": null,
                        "accuracy_radius_km": 50,
                        "confidence": "medium"
                      },
                      "network": {
                        "asn": 3356,
                        "as_org": "Level 3 Communications, Inc.",
                        "isp": "Level 3 Communications, Inc.",
                        "organization": "Level 3 Communications, Inc.",
                        "network": null,
                        "rir": null
                      },
                      "traits": {
                        "is_anycast": false,
                        "is_hosting": false,
                        "is_mobile": false,
                        "is_satellite": false,
                        "is_bogon": false,
                        "is_proxy": false,
                        "is_vpn": false,
                        "is_tor": false,
                        "is_relay": false
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidIp"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          }
        }
      }
    },
    "/v0/asn/{asn}": {
      "get": {
        "tags": [
          "ASN"
        ],
        "operationId": "getAsn",
        "summary": "ASN detail",
        "description": "Autonomous System name, org, type, RIR, and sample prefixes.",
        "parameters": [
          {
            "name": "asn",
            "in": "path",
            "required": true,
            "description": "ASN number (with or without `AS` prefix)",
            "schema": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "example": 15169
                },
                {
                  "type": "string",
                  "pattern": "^(AS|as)?[0-9]+$",
                  "example": "AS15169"
                }
              ]
            },
            "examples": {
              "numeric": {
                "value": 15169
              },
              "prefixed": {
                "value": "AS15169"
              }
            }
          },
          {
            "$ref": "#/components/parameters/ApiKeyQueryOptional"
          }
        ],
        "responses": {
          "200": {
            "description": "ASN details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AsnDetail"
                },
                "examples": {
                  "google": {
                    "summary": "AS15169 Google",
                    "value": {
                      "asn": 15169,
                      "name": "GOOGLE",
                      "org": "Google LLC",
                      "domain": "google.com",
                      "type": "hosting",
                      "country_code": "US",
                      "rir": "ARIN",
                      "prefixes_sample": [
                        "8.8.8.0/24",
                        "8.8.4.0/24"
                      ]
                    }
                  },
                  "us_network": {
                    "summary": "AS3356 (US network)",
                    "value": {
                      "asn": 3356,
                      "name": "AS3356",
                      "org": "Level 3 Communications, Inc.",
                      "domain": null,
                      "type": "unknown",
                      "country_code": null,
                      "rir": null,
                      "prefixes_sample": [
                        "4.0.0.0/12",
                        "4.16.0.0/15",
                        "4.18.0.0/16"
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          }
        }
      }
    },
    "/v0/bulk": {
      "post": {
        "tags": [
          "Bulk"
        ],
        "operationId": "postBulk",
        "summary": "Bulk IP lookup",
        "description": "Batch lookup up to **100 IPs** per request in v0.\n**Paid plans only** (Starter, Growth, Scale). Free keys receive `403 PLAN_REQUIRED`\nbefore the request body is read. Unauthenticated requests stay `401`.\nReturns a map of results keyed by IP; per-IP failures appear under `errors`\n(partial success — one bad IP does not fail the whole batch).\n\n**Quota:** counts as **1** request toward the per-minute rate limit, but **N**\n(number of IPs in the body) toward the daily UTC quota.\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/ApiKeyQueryOptional"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkRequest"
              },
              "examples": {
                "mixed": {
                  "summary": "Bulk lookup example",
                  "value": {
                    "ips": [
                      "8.8.8.8",
                      "4.2.2.2",
                      "208.67.222.222"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bulk results (partial success possible)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BulkResponse"
                },
                "examples": {
                  "success": {
                    "summary": "Three successful lookups",
                    "value": {
                      "results": {
                        "8.8.8.8": {
                          "ip": "8.8.8.8",
                          "location": {
                            "continent_code": "NA",
                            "country_code": "US",
                            "country": "United States",
                            "is_eu": false,
                            "region": "California",
                            "region_code": "CA",
                            "city": "Mountain View",
                            "postal": null,
                            "latitude": 37.422,
                            "longitude": -122.085,
                            "timezone": "America/Los_Angeles",
                            "accuracy_radius_km": 50.0,
                            "confidence": "medium"
                          },
                          "network": {
                            "asn": 15169,
                            "as_org": "Google LLC",
                            "isp": "Google LLC",
                            "organization": "Google LLC",
                            "network": "8.8.8.0/24"
                          },
                          "traits": {
                            "is_anycast": true,
                            "is_hosting": true,
                            "is_mobile": false,
                            "is_satellite": false,
                            "is_bogon": false,
                            "is_proxy": false,
                            "is_vpn": false,
                            "is_tor": false,
                            "is_relay": false
                          }
                        },
                        "4.2.2.2": {
                          "ip": "4.2.2.2",
                          "location": {
                            "continent_code": "NA",
                            "country_code": "US",
                            "country": "United States",
                            "is_eu": false,
                            "region": "Kansas",
                            "region_code": null,
                            "city": "Independence",
                            "postal": null,
                            "latitude": 37.2262,
                            "longitude": -95.7341,
                            "timezone": null,
                            "accuracy_radius_km": 50,
                            "confidence": "medium"
                          },
                          "network": {
                            "asn": 3356,
                            "as_org": "Level 3 Communications, Inc.",
                            "isp": "Level 3 Communications, Inc.",
                            "organization": "Level 3 Communications, Inc.",
                            "network": null,
                            "rir": null
                          },
                          "traits": {
                            "is_anycast": false,
                            "is_hosting": false,
                            "is_mobile": false,
                            "is_satellite": false,
                            "is_bogon": false,
                            "is_proxy": false,
                            "is_vpn": false,
                            "is_tor": false,
                            "is_relay": false
                          }
                        },
                        "208.67.222.222": {
                          "ip": "208.67.222.222",
                          "location": {
                            "continent_code": "NA",
                            "country_code": "US",
                            "country": "United States",
                            "is_eu": false,
                            "region": "California",
                            "region_code": null,
                            "city": "San Jose (Tasman and Zanker)",
                            "postal": null,
                            "latitude": 37.4084,
                            "longitude": -121.954,
                            "timezone": null,
                            "accuracy_radius_km": 50,
                            "confidence": "medium"
                          },
                          "network": {
                            "asn": 36692,
                            "as_org": "Cisco OpenDNS, LLC",
                            "isp": "Cisco OpenDNS, LLC",
                            "organization": "Cisco OpenDNS, LLC",
                            "network": null,
                            "rir": null
                          },
                          "traits": {
                            "is_anycast": true,
                            "is_hosting": false,
                            "is_mobile": false,
