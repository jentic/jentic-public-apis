          }
        }
      }
    },
    "/v0/me": {
      "get": {
        "tags": [
          "Account"
        ],
        "operationId": "getMe",
        "summary": "Caller IP and account info",
        "description": "Returns the caller's apparent IP (from the request) plus plan/quota hints\nwhen authenticated. Useful for \"what's my IP\" and key validation.\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/ApiKeyQueryOptional"
          }
        ],
        "responses": {
          "200": {
            "description": "Caller context",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                },
                "examples": {
                  "authenticated": {
                    "summary": "Authenticated caller",
                    "value": {
                      "ip": "4.2.2.2",
                      "plan": "free",
                      "requests_remaining_today": 847
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Account"
        ],
        "operationId": "getHealth",
        "summary": "Service health",
        "description": "Liveness and data-freshness check. No authentication, rate limit or quota.\n`mode` is `live` when all data is loaded, `degraded` when only part of it is,\nand `stub` when none is. `data_updated` is the build date (UTC) of the\ngeolocation/ASN data currently served.\n",
        "security": [],
        "responses": {
          "200": {
            "description": "Service is up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                },
                "example": {
                  "status": "ok",
                  "mode": "live",
                  "data_updated": "2026-10-01",
                  "traits_loaded": true
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API key",
        "description": "API keys are issued by Network Data Labs. Prefer\n`Authorization: Bearer YOUR_API_KEY` (or `ndl_live_…` style keys).\nUnknown or missing keys return `401 UNAUTHORIZED`. Any non-empty\nstring is **not** accepted.\n"
      },
      "ApiKeyQuery": {
        "type": "apiKey",
        "in": "query",
        "name": "api_key",
        "description": "Optional alternative to Bearer — useful for quick curl tests. Prefer header in production."
      }
    },
    "parameters": {
      "IpPath": {
        "name": "ip",
        "in": "path",
        "required": true,
        "description": "IPv4 or IPv6 address",
        "schema": {
          "type": "string",
          "examples": [
            "8.8.8.8",
            "4.2.2.2",
            "2001:4860:4860::8888"
          ]
        }
      },
      "ApiKeyQueryOptional": {
        "name": "api_key",
        "in": "query",
        "required": false,
        "description": "Optional API key (if not using Bearer header)",
        "schema": {
          "type": "string",
          "example": "YOUR_API_KEY"
        }
      }
    },
    "responses": {
      "InvalidIp": {
        "description": "Malformed or unsupported IP address",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "INVALID_IP",
                "message": "Malformed IP address"
              }
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or invalid API key",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "UNAUTHORIZED",
                "message": "Missing or invalid API key"
              }
            }
          }
        }
      },
      "PlanRequired": {
        "description": "Endpoint requires a paid plan (Starter or higher)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "PLAN_REQUIRED",
                "message": "Bulk lookups require a paid plan."
              }
            }
          }
        }
      },
      "RateLimited": {
        "description": "Burst (per-minute) or daily quota exceeded.\nPer-minute → `RATE_LIMITED`; daily UTC quota → `QUOTA_EXCEEDED`.\n",
        "headers": {
          "Retry-After": {
            "description": "Seconds until quota resets (when known)",
            "schema": {
              "type": "integer"
            }
          },
          "X-RateLimit-Limit": {
            "description": "Per-minute request limit",
            "schema": {
              "type": "integer"
            }
          },
          "X-RateLimit-Remaining": {
            "description": "Remaining requests in the current minute window",
            "schema": {
              "type": "integer"
            }
          },
          "X-RateLimit-Limit-Day": {
            "description": "Daily quota (calendar UTC day)",
            "schema": {
              "type": "integer"
            }
          },
          "X-RateLimit-Remaining-Day": {
            "description": "Remaining daily quota units",
            "schema": {
              "type": "integer"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "rate_limited": {
                "summary": "Per-minute burst exceeded",
                "value": {
                  "error": {
                    "code": "RATE_LIMITED",
                    "message": "Rate limit exceeded (60 requests per minute). Retry after 12s."
                  }
                }
              },
              "quota_exceeded": {
                "summary": "Daily UTC quota exceeded",
                "value": {
                  "error": {
                    "code": "QUOTA_EXCEEDED",
                    "message": "Daily quota exceeded (1000 requests per UTC calendar day). Resets in 3600s (UTC midnight)."
                  }
                }
              }
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found (e.g. unknown ASN)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "NOT_FOUND",
                "message": "ASN not found"
              }
            }
          }
        }
      },
      "Internal": {
        "description": "Unexpected server error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "INTERNAL",
                "message": "Internal server error"
              }
            }
          }
        }
      }
    },
    "schemas": {
      "Location": {
        "type": "object",
        "required": [
          "continent_code",
          "country_code",
          "country",
          "accuracy_radius_km",
          "confidence"
        ],
        "properties": {
          "continent_code": {
            "type": "string",
            "description": "Continent code (e.g. NA, EU, AS)",
            "examples": [
              "NA",
              "EU"
            ]
          },
          "country_code": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO-3166-1 alpha-2",
            "examples": [
              "US"
            ]
          },
          "country": {
            "type": [
              "string",
              "null"
            ],
            "examples": [
              "United States"
            ]
          },
          "is_eu": {
            "type": "boolean",
            "description": "Whether the country is in the European Union"
          },
          "region": {
            "type": [
              "string",
              "null"
            ],
            "examples": [
              "California",
              "Kansas"
            ]
          },
          "region_code": {
            "type": [
              "string",
              "null"
            ],
            "examples": [
              "CA",
              "B"
            ]
          },
          "city": {
            "type": [
              "string",
              "null"
            ],
            "examples": [
              "Mountain View",
              "Independence"
            ]
          },
          "postal": {
            "type": [
              "string",
              "null"
            ]
          },
          "latitude": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "longitude": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "timezone": {
            "type": [
              "string",
              "null"
            ],
            "description": "IANA timezone",
            "examples": [
              "America/Los_Angeles",
              "America/Chicago"
            ]
          },
          "accuracy_radius_km": {
            "type": [
              "number",
              "null"
            ],
            "description": "Estimated accuracy radius in kilometers. Always present when geo is returned;\nit tells you how precise the location is. Wide radii (e.g. 1000) mean city is a best-effort guess.\n",
            "examples": [
              50,
              1000
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low",
              "unknown"
            ],
            "description": "Qualitative confidence in the geo estimate"
          }
        }
      },
      "Network": {
        "type": "object",
        "properties": {
          "asn": {
            "type": [
              "integer",
              "null"
            ],
            "examples": [
              15169,
              3356
            ]
          },
          "as_org": {
            "type": [
              "string",
              "null"
            ],
            "examples": [
              "Google LLC",
              "Level 3 Communications, Inc."
            ]
          },
          "isp": {
            "type": [
              "string",
              "null"
            ]
          },
          "organization": {
            "type": [
              "string",
              "null"
            ]
          },
          "network": {
            "type": [
              "string",
              "null"
            ],
            "description": "Containing prefix (CIDR)",
            "examples": [
              "8.8.8.0/24",
              "4.0.0.0/12"
            ]
          },
          "rir": {
            "type": [
              "string",
              "null"
            ],
            "description": "Regional Internet Registry",
            "examples": [
              "ARIN",
              "LACNIC",
              "RIPE",
              "APNIC",
              "AFRINIC"
            ]
          }
        }
      },
      "Traits": {
        "type": "object",
        "required": [
          "is_hosting",
          "is_proxy",
          "is_vpn",
          "is_tor",
          "is_bogon",
          "is_mobile",
          "is_satellite",
          "is_relay"
        ],
        "properties": {
          "is_anycast": {
            "type": "boolean",
            "description": "Detects well-known anycast DNS resolver IPs (e.g. 8.8.8.8, 1.1.1.1). Limits: only that fixed set; other anycast IPs return false."
          },
          "is_hosting": {
            "type": "boolean",
            "description": "Detects IPs in hosting, datacenter, cloud and CDN networks."
          },
          "is_mobile": {
            "type": "boolean",
            "description": "Detects IPs on mobile carrier networks. Limits: estimate; not every carrier is covered, and some fixed-wireless or business/static blocks may be flagged."
          },
          "is_satellite": {
            "type": "boolean",
            "description": "Detects satellite internet IPs. Limits: covers one major satellite internet provider; other satellite ISPs return false."
          },
          "is_bogon": {
            "type": "boolean",
            "description": "Detects private and reserved IP ranges (RFC1918 private, loopback, link-local, multicast, reserved, documentation/benchmark). Limits: unallocated-but-unrouted space is not checked."
          },
          "is_proxy": {
            "type": "boolean",
            "description": "Proxy flag."
          },
          "is_vpn": {
            "type": "boolean",
            "description": "Detects IPs in known VPN networks, including major commercial VPN providers. Limits: whole networks of VPN-heavy hosting providers are included, so non-VPN servers in those networks are also true; major public clouds are not included. Privacy relay egress IPs are reported as is_relay, never as is_vpn."
          },
          "is_tor": {
            "type": "boolean",
            "description": "Detects current Tor exit nodes. Limits: exit nodes only (not guard/middle relays or bridges); very recently added exits may return false."
          },
          "is_relay": {
            "type": "boolean",
            "description": "Detects privacy relay egress IPs. Limits: covers one major consumer privacy relay service; other privacy relays and VPN-style relays return false."
          }
        }
      },
      "IpLookup": {
        "type": "object",
        "required": [
          "ip",
          "location",
          "network",
          "traits"
        ],
        "properties": {
          "ip": {
            "type": "string"
          },
          "location": {
            "$ref": "#/components/schemas/Location"
          },
          "network": {
            "$ref": "#/components/schemas/Network"
          },
          "traits": {
            "$ref": "#/components/schemas/Traits"
          }
        }
      },
      "AsnDetail": {
        "type": "object",
        "required": [
          "asn",
          "name",
          "org"
        ],
        "properties": {
          "asn": {
            "type": "integer"
          },
          "name": {
            "type": "string",
            "examples": [
              "GOOGLE"
            ]
          },
          "org": {
            "type": "string"
          },
          "domain": {
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "type": [
              "string",
              "null"
            ],
            "description": "Coarse ASN category",
            "enum": [
              "hosting",
              "isp",
              "education",
              "government",
              "business",
              "unknown",
              null
            ]
          },
          "country_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "rir": {
            "type": [
              "string",
              "null"
            ]
          },
          "prefixes_sample": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Sample of announced prefixes (not exhaustive)"
          }
        }
      },
      "BulkRequest": {
        "type": "object",
        "required": [
          "ips"
        ],
        "properties": {
          "ips": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "string"
            },
            "description": "IPv4/IPv6 addresses to look up (max 100 in v0)",
            "examples": [
              [
                "8.8.8.8",
                "4.2.2.2",
                "208.67.222.222"
              ]
            ]
          }
        }
      },
      "BulkResponse": {
        "type": "object",
        "required": [
          "results",
          "errors"
        ],
        "properties": {
          "results": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/IpLookup"
            },
            "description": "Map of IP → full lookup result"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/ErrorBody"
            },
            "description": "Map of IP → error for failed lookups (empty object if all succeeded)"
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status",
          "mode",
          "data_updated"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          },
          "mode": {
            "type": "string",
            "enum": [
              "live",
              "degraded",
              "stub"
            ],
            "description": "`live` = all data loaded; `degraded` = partial; `stub` = no data loaded"
          },
          "data_updated": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "Build date (UTC) of the geolocation/ASN data currently served; null in stub mode"
          },
          "traits_loaded": {
            "type": "boolean",
            "description": "True when every trait list (Tor, VPN, relay, hosting, mobile, satellite) is loaded"
          }
        }
      },
      "Me": {
        "type": "object",
        "required": [
          "ip",
          "plan"
        ],
        "properties": {
          "ip": {
            "type": "string",
            "description": "Apparent client IP"
          },
          "plan": {
            "type": "string",
            "description": "Account plan. Env/internal keys report `internal`.",
            "examples": [
              "free",
              "starter",
              "growth",
              "scale",
              "internal"
            ]
          },
          "requests_remaining_today": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INVALID_IP",
              "INVALID_EMAIL",
              "INVALID_REQUEST",
              "UNAUTHORIZED",
              "PLAN_REQUIRED",
              "RATE_LIMITED",
              "QUOTA_EXCEEDED",
              "NOT_FOUND",
              "SERVICE_UNAVAILABLE",
              "INTERNAL"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        }
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    },
    {
      "ApiKeyQuery": []
    }
  ],
  "tags": [
    {
      "name": "IP Lookup",
      "description": "Geolocation, network, and traits for a single IP"
    },
    {
      "name": "ASN",
      "description": "Autonomous System details"
    },
    {
      "name": "Bulk",
      "description": "Batch lookups (up to 100 IPs in v0)"
    },
    {
      "name": "Account",
      "description": "Caller identity and quota"
    }
  ]
}