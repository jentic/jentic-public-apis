    "/v1/x/monitors": {
      "post": {
        "summary": "Create an X (Twitter) monitor that polls a profile, search, list, or replies and fires a webhook on new matches.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-payment-info": {
          "intent": "session",
          "method": "stripe",
          "amount": 19,
          "currency": "USD",
          "description": "Every account includes a free plan: 500 credits a month, no card. One credit is one page, whatever that page needs. Paid plans add larger monthly allowances and research runs. See the dashboard for access and pricing.",
