{
  "openapi": "3.1.0",
  "info": {
    "title": "webclaw API",
    "version": "1.0.0",
    "description": "Web extraction API for AI agents. Scrape, crawl, search, map, batch, extract, summarize, diff, research, and inspect brand signals from public web pages."
  },
  "servers": [
    {
      "url": "https://api.webclaw.io"
    }
  ],
  "externalDocs": {
    "description": "webclaw API documentation",
    "url": "https://webclaw.io/docs/api"
  },
  "x-service-info": {
    "categories": [
      "developer-tools",
      "data",
      "search"
    ],
    "docs": {
      "homepage": "https://webclaw.io",
      "apiReference": "https://webclaw.io/docs/api",
      "llms": "https://webclaw.io/llms.txt"
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Use a webclaw API key from the dashboard or an OAuth device-flow token. Agent integrations should use scoped tokens with only the required endpoint scopes."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "ScrapeResult": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "markdown": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "rawHtml": {
            "type": "string"
          },
          "llm": {
            "type": "string"
          },
          "extraction": {
            "type": "object",
            "additionalProperties": true
          },
          "extract": {},
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string"
                },
                "href": {
                  "type": "string"
                }
              }
            }
          },
          "screenshot": {
            "type": "string",
            "description": "Base64-encoded PNG when requested."
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      },
      "JobStatus": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "running",
              "completed",
              "failed",
              "interrupted"
            ]
          },
          "pages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "markdown": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "rawHtml": {
                  "type": "string"
                },
                "llm": {
                  "type": "string"
                },
                "extraction": {
                  "type": "object",
                  "additionalProperties": true
                },
                "extract": {},
                "links": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "text": {
                        "type": "string"
                      },
                      "href": {
                        "type": "string"
                      }
                    }
                  }
                },
                "screenshot": {
                  "type": "string",
                  "description": "Base64-encoded PNG when requested."
                },
                "metadata": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "additionalProperties": true
            }
          },
          "total": {
            "type": "integer"
          },
          "completed": {
            "type": "integer"
          },
          "errors": {
            "type": "integer"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "paths": {
    "/v1/scrape": {
      "post": {
        "summary": "Extract content from a single URL.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-payment-info": {
          "intent": "session",
          "method": "stripe",
          "amount": 19,
          "currency": "USD",
          "description": "Every account includes a free plan: 500 credits a month, no card. One credit is one page, whatever that page needs. Paid plans add larger monthly allowances and research runs. See the dashboard for access and pricing.",
          "url": "https://webclaw.io/pricing"
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "url"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "formats": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "markdown",
                        "text",
                        "llm",
                        "json",
                        "links",
                        "rawHtml",
                        "attributes",
                        "query",
                        "extract"
                      ]
                    },
                    "default": [
                      "markdown"
                    ]
                  },
                  "format": {
                    "type": "string",
                    "enum": [
                      "markdown",
                      "text",
                      "llm",
                      "json",
                      "links",
                      "rawHtml",
                      "attributes",
                      "query",
                      "extract"
                    ]
                  },
                  "include_selectors": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "exclude_selectors": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "only_main_content": {
                    "type": "boolean",
                    "default": false
                  },
                  "no_cache": {
                    "type": "boolean",
                    "default": false
                  },
                  "max_cache_age": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Maximum cache age in seconds."
                  },
                  "mobile": {
                    "type": "boolean",
                    "default": false,
                    "description": "Mobile user agent for HTTP fetches. Cannot be combined with screenshots or browser actions."
                  },
                  "screenshot": {
                    "type": "boolean",
                    "default": false
                  },
                  "actions": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "type"
                      ],
                      "properties": {
                        "type": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": true
                    }
                  },
                  "query": {
                    "type": "string",
                    "minLength": 1
                  },
                  "attribute_selectors": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": [
                        "selector",
                        "attribute"
                      ],
                      "properties": {
                        "selector": {
                          "type": "string"
                        },
                        "attribute": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "extract": {
                    "type": "object",
                    "properties": {
                      "schema": {
                        "type": "object",
                        "additionalProperties": true
                      },
                      "prompt": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "anyOf": [
                      {
                        "required": [
                          "schema"
                        ]
                      },
                      {
                        "required": [
                          "prompt"
                        ]
                      }
                    ],
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false,
                "description": "Use format or formats, not both. The extract format requires nested extract options and vice versa. Query requires a nonempty query; attributes requires selectors. Query and attributes cannot combine with actions or screenshots.",
                "not": {
                  "required": [
                    "format",
                    "formats"
                  ]
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "markdown": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string"
                    },
                    "rawHtml": {
                      "type": "string"
                    },
                    "llm": {
                      "type": "string"
                    },
                    "extraction": {
                      "type": "object",
                      "additionalProperties": true
                    },
                    "extract": {},
                    "links": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "text": {
                            "type": "string"
                          },
                          "href": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "screenshot": {
                      "type": "string",
                      "description": "Base64-encoded PNG when requested."
                    },
                    "metadata": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing API key",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          },
          "402": {
            "description": "Payment required or insufficient credits",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/v1/crawl": {
      "post": {
        "summary": "Start an asynchronous crawl job from a seed URL.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-payment-info": {
          "intent": "session",
          "method": "stripe",
          "amount": 19,
          "currency": "USD",
          "description": "Every account includes a free plan: 500 credits a month, no card. One credit is one page, whatever that page needs. Paid plans add larger monthly allowances and research runs. See the dashboard for access and pricing.",
          "url": "https://webclaw.io/pricing"
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "url"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "max_pages": {
                    "type": "integer",
                    "minimum": 0,
                    "default": 50,
                    "description": "Zero removes the page cap; credits and cancellation still apply."
                  },
                  "max_depth": {
                    "type": "integer",
                    "minimum": 0,
                    "default": 2,
                    "description": "Capped at 10."
                  },
                  "allow_subdomains": {
                    "type": "boolean",
                    "default": false
                  },
                  "allow_external_links": {
                    "type": "boolean",
                    "default": false
                  },
                  "use_sitemap": {
                    "type": "boolean"
                  },
                  "include_patterns": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "exclude_patterns": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "webhook_url": {
                    "type": "string",
                    "format": "uri"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "pending",
                        "running",
                        "completed",
                        "failed",
                        "interrupted"
                      ]
                    },
                    "pages": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "success": {
                            "type": "boolean"
                          },
                          "url": {
                            "type": "string",
                            "format": "uri"
                          },
                          "markdown": {
                            "type": "string"
                          },
                          "text": {
                            "type": "string"
                          },
                          "rawHtml": {
                            "type": "string"
                          },
                          "llm": {
                            "type": "string"
                          },
                          "extraction": {
                            "type": "object",
                            "additionalProperties": true
                          },
                          "extract": {},
                          "links": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "text": {
                                  "type": "string"
                                },
                                "href": {
                                  "type": "string"
                                }
                              }
                            }
                          },
                          "screenshot": {
                            "type": "string",
                            "description": "Base64-encoded PNG when requested."
                          },
                          "metadata": {
                            "type": "object",
                            "additionalProperties": true
                          }
                        },
                        "additionalProperties": true
                      }
                    },
                    "total": {
                      "type": "integer"
                    },
                    "completed": {
                      "type": "integer"
                    },
                    "errors": {
                      "type": "integer"
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing API key",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          },
          "402": {
            "description": "Payment required or insufficient credits",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/v1/crawl/{id}": {
      "get": {
        "summary": "Get crawl job status and results.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Crawl status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "pending",
                        "running",
                        "completed",
                        "failed",
                        "interrupted"
                      ]
                    },
                    "pages": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "success": {
                            "type": "boolean"
                          },
                          "url": {
                            "type": "string",
                            "format": "uri"
                          },
                          "markdown": {
                            "type": "string"
                          },
                          "text": {
                            "type": "string"
                          },
                          "rawHtml": {
                            "type": "string"
                          },
                          "llm": {
                            "type": "string"
                          },
                          "extraction": {
                            "type": "object",
                            "additionalProperties": true
                          },
                          "extract": {},
                          "links": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "text": {
                                  "type": "string"
                                },
                                "href": {
                                  "type": "string"
                                }
                              }
                            }
                          },
                          "screenshot": {
                            "type": "string",
                            "description": "Base64-encoded PNG when requested."
                          },
                          "metadata": {
                            "type": "object",
                            "additionalProperties": true
                          }
                        },
                        "additionalProperties": true
                      }
                    },
                    "total": {
                      "type": "integer"
                    },
                    "completed": {
                      "type": "integer"
                    },
                    "errors": {
                      "type": "integer"
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          },
          "404": {
            "description": "Crawl not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/v1/crawl/{id}/pages": {
      "get": {
        "summary": "List crawl pages with server-side pagination.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated crawl pages",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "pages": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "success": {
                            "type": "boolean"
                          },
                          "url": {
                            "type": "string",
                            "format": "uri"
                          },
                          "markdown": {
                            "type": "string"
                          },
                          "text": {
                            "type": "string"
                          },
                          "rawHtml": {
                            "type": "string"
                          },
                          "llm": {
                            "type": "string"
                          },
                          "extraction": {
                            "type": "object",
                            "additionalProperties": true
                          },
                          "extract": {},
                          "links": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "text": {
                                  "type": "string"
                                },
                                "href": {
                                  "type": "string"
                                }
                              }
                            }
                          },
                          "screenshot": {
                            "type": "string",
                            "description": "Base64-encoded PNG when requested."
                          },
                          "metadata": {
                            "type": "object",
                            "additionalProperties": true
                          }
                        },
                        "additionalProperties": true
                      }
                    },
                    "page": {
                      "type": "integer"
                    },
                    "per_page": {
                      "type": "integer"
                    },
                    "total": {
                      "type": "integer"
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/v1/map": {
      "post": {
        "summary": "Discover URLs from robots.txt and sitemap.xml.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-payment-info": {
          "intent": "session",
          "method": "stripe",
          "amount": 19,
          "currency": "USD",
          "description": "Every account includes a free plan: 500 credits a month, no card. One credit is one page, whatever that page needs. Paid plans add larger monthly allowances and research runs. See the dashboard for access and pricing.",
          "url": "https://webclaw.io/pricing"
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "url"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 50000,
                    "default": 5000
                  },
                  "search": {
                    "type": "string"
                  },
                  "cursor": {
                    "type": "string",
                    "description": "Opaque next_cursor from the preceding response."
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "urls": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "format": "uri"
                      }
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing API key",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          },
          "402": {
            "description": "Payment required or insufficient credits",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
