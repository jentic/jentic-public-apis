          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "kind",
                  "target"
                ],
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "profile",
                      "search",
                      "list",
                      "replies"
                    ]
                  },
                  "target": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "interval_minutes": {
                    "type": "integer",
                    "minimum": 5,
                    "maximum": 10080,
                    "default": 15
                  },
                  "webhook_url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "include_retweets": {
                    "type": "boolean",
                    "default": true
                  },
                  "include_replies": {
                    "type": "boolean",
                    "default": true
                  },
                  "include_quotes": {
                    "type": "boolean",
                    "default": true
                  },
                  "min_faves": {
                    "type": "integer",
                    "minimum": 0,
                    "default": 0
                  },
                  "keyword": {
                    "type": "string"
                  },
                  "lang": {
                    "type": "string"
                  }
                },
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
