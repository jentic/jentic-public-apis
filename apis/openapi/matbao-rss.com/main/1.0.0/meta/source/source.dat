                "type": "object",
                "properties": {
                  "payment_id": {
                    "type": "string"
                  },
                  "payment_url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "payment_method": {
                    "type": "string"
                  }
                }
              },
              "status": {
                "type": "string",
                "example": "PENDING_PAYMENT"
              },
              "next_step": {
                "type": "string",
                "enum": [
                  "PAYMENT",
                  "EKYC",
                  "ACTIVATE"
                ]
              }
            }
          }
        }
      },
      "DocumentListItem": {
        "type": "object",
        "properties": {
          "document_id": {
            "type": "string"
          },
          "document_name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "UPLOADED",
              "SIGNING",
              "SIGNED",
              "FAILED"
            ]
          },
          "file_size": {
            "type": "integer"
          },
          "page_count": {
            "type": "integer"
          },
          "signatures": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "signature_id": {
                  "type": "string"
                },
                "signed_by": {
                  "type": "string"
                },
                "signed_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "DocumentDetail": {
        "type": "object",
        "properties": {
          "document_id": {
            "type": "string"
          },
          "document_name": {
            "type": "string"
          },
          "file_size": {
            "type": "integer"
          },
          "page_count": {
            "type": "integer"
          },
          "status": {
            "type": "string"
          },
          "download_url": {
            "type": "string",
            "format": "uri"
          },
          "download_url_expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "signatures": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "signature_id": {
                  "type": "string"
                },
                "signed_by": {
                  "type": "string"
                },
                "certificate_id": {
                  "type": "string"
                },
                "signed_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "signature_position": {
                  "$ref": "#/components/schemas/SignaturePosition"
                }
              }
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SignaturePosition": {
        "type": "object",
        "required": [
          "page",
          "x",
          "y",
          "width",
          "height"
        ],
        "properties": {
          "page": {
            "type": "integer",
            "example": 2
          },
          "x": {
            "type": "integer",
            "example": 100
          },
          "y": {
            "type": "integer",
            "example": 200
          },
          "width": {
            "type": "integer",
            "example": 200
          },
          "height": {
            "type": "integer",
            "example": 50
          },
          "signature_template_id": {
            "type": "string",
            "nullable": true,
            "description": "Optional"
          }
        }
      },
      "SignDocumentRequest": {
        "type": "object",
        "required": [
          "signing_session_id",
          "certificate_id",
          "signature_positions"
        ],
        "properties": {
          "signing_session_id": {
            "type": "string",
            "example": "session_123456"
          },
          "certificate_id": {
            "type": "string"
          },
          "pin": {
            "type": "string",
            "pattern": "^[0-9]{6}$",
            "description": "Hoặc biometric_verified: true"
          },
          "biometric_verified": {
            "type": "boolean",
            "default": false
          },
          "signature_positions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SignaturePosition"
            }
          }
        }
      },
      "OrderListItem": {
        "type": "object",
        "properties": {
          "order_id": {
            "type": "string"
          },
          "order_type": {
            "type": "string",
            "enum": [
              "CERTIFICATE",
              "SIGNING_QUOTA",
              "RENEWAL"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING_PAYMENT",
              "PAID",
              "COMPLETED",
              "CANCELLED"
            ]
          },
          "amount": {
            "type": "integer"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "completed_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "OrderDetail": {
        "type": "object",
        "properties": {
          "order_id": {
            "type": "string"
          },
          "order_type": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "product_name": {
                  "type": "string"
                },
                "quantity": {
                  "type": "integer"
                },
                "unit_price": {
                  "type": "integer"
                },
                "total_price": {
                  "type": "integer"
                }
              }
            }
          },
          "payment": {
            "type": "object",
            "properties": {
              "payment_method": {
                "type": "string"
              },
              "paid_amount": {
                "type": "integer"
              },
              "paid_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "certificate": {
            "type": "object",
            "nullable": true,
            "properties": {
              "certificate_id": {
                "type": "string"
              },
              "serial_number": {
                "type": "string"
              }
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "completed_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "Notification": {
        "type": "object",
        "properties": {
          "notification_id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "DOCUMENT_SIGNED",
              "CERTIFICATE_ACTIVATED",
              "ORDER_COMPLETED",
              "MULTI_SIGNER_PENDING"
            ]
          },
          "title": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "is_read": {
            "type": "boolean"
          },
          "data": {
            "type": "object",
            "description": "Additional data (document_id, signature_id, etc.)"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "MultiSignerRequest": {
        "type": "object",
        "required": [
          "signers",
          "pin"
        ],
        "properties": {
          "signers": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": [
                "user_id",
                "certificate_id",
                "signature_position",
                "order"
              ],
              "properties": {
                "user_id": {
                  "type": "string",
                  "description": "Người ký (chính mình hoặc người khác)"
                },
                "certificate_id": {
                  "type": "string"
                },
                "signature_position": {
                  "$ref": "#/components/schemas/SignaturePosition"
                },
                "order": {
                  "type": "integer",
                  "description": "Thứ tự ký (1, 2, 3...)"
                }
              }
            }
          },
          "pin": {
            "type": "string",
            "pattern": "^[0-9]{6}$"
          }
        }
      },
      "MultiSignerSession": {
        "type": "object",
        "properties": {
          "multi_sign_session_id": {
            "type": "string",
            "example": "multi_session_123456"
          },
          "document_id": {
            "type": "string"
          },
          "total_signers": {
            "type": "integer"
          },
          "current_signer": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": [
              "IN_PROGRESS",
              "COMPLETED",
              "CANCELLED"
            ]
          },
          "signers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "user_id": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "SIGNED",
                    "PENDING"
                  ]
                },
                "signed_at": {
                  "type": "string",
                  "format": "date-time",
                  "nullable": true
                },
                "notified_at": {
                  "type": "string",
                  "format": "date-time",
                  "nullable": true
                }
              }
            }
          }
        }
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "example": 1
          },
          "limit": {
            "type": "integer",
            "example": 20
          },
          "total": {
            "type": "integer"
          },
          "total_pages": {
            "type": "integer"
          }
        }
      },
      "SuccessResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "example": "INVALID_REQUEST"
              },
              "message": {
                "type": "string",
                "example": "Request không hợp lệ"
              },
              "details": {
                "type": "object",
                "nullable": true,
                "properties": {
                  "field": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ]
}
