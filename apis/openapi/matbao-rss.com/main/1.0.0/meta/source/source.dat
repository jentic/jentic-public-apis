    "/multi-sign/{multi_sign_session_id}/status": {
      "get": {
        "tags": [
          "Multi-signer"
        ],
        "summary": "Get Multi-signer Status",
        "description": "Lấy trạng thái ký tuần tự",
        "operationId": "getMultiSignerStatus",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "multi_sign_session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "multi_session_123456"
          }
        ],
        "responses": {
          "200": {
            "description": "Multi-signer status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "multi_sign_session_id": {
                          "type": "string"
                        },
                        "document_id": {
                          "type": "string"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "IN_PROGRESS",
                            "COMPLETED",
                            "CANCELLED"
                          ]
                        },
                        "total_signers": {
                          "type": "integer"
                        },
                        "signed_count": {
                          "type": "integer"
                        },
                        "signers": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "user_id": {
                                "type": "string"
                              },
                              "status": {
                                "type": "string",
                                "enum": [
                                  "SIGNED",
                                  "PENDING"
                                ]
                              },
                              "signed_at": {
                                "type": "string",
                                "format": "date-time",
                                "nullable": true
                              }
                            }
                          }
                        },
                        "completed_at": {
                          "type": "string",
                          "format": "date-time",
                          "nullable": true
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT token authentication (Token TTL: 1 hour)"
      }
    },
    "parameters": {
      "XClientVersion": {
        "name": "X-Client-Version",
        "in": "header",
        "required": false,
        "description": "Version của mobile app (format: major.minor.patch)",
        "schema": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "example": "1.0.0"
      },
      "XDeviceID": {
        "name": "X-Device-ID",
        "in": "header",
        "required": false,
        "description": "Unique device identifier",
        "schema": {
          "type": "string"
        },
        "example": "device_uuid_12345"
      },
      "XPlatform": {
        "name": "X-Platform",
        "in": "header",
        "required": false,
        "description": "Platform của mobile app",
        "schema": {
          "type": "string",
          "enum": [
            "iOS",
            "Android"
          ]
        },
        "example": "iOS"
      },
      "XAPIVersion": {
        "name": "X-API-Version",
        "in": "header",
        "required": false,
        "description": "API version (default: v1)",
        "schema": {
          "type": "string",
          "default": "v1"
        },
        "example": "v1"
      },
      "XLanguage": {
        "name": "X-Language",
        "in": "header",
        "required": false,
        "description": "Language preference (vi, en)",
        "schema": {
          "type": "string",
          "enum": [
            "vi",
            "en"
          ],
          "default": "vi"
        },
        "example": "vi"
      }
    },
    "headers": {
      "XRequestID": {
        "description": "Request ID để tracking (nếu có)",
        "schema": {
          "type": "string",
          "example": "req_123456789"
        }
      },
      "XRateLimitLimit": {
        "description": "Số lượng request tối đa trong time window",
        "schema": {
          "type": "integer",
          "example": 100
        }
      },
      "XRateLimitRemaining": {
        "description": "Số lượng request còn lại trong time window hiện tại",
        "schema": {
          "type": "integer",
          "example": 95
        }
      },
      "XRateLimitReset": {
        "description": "Timestamp (Unix) khi rate limit sẽ reset",
        "schema": {
          "type": "integer",
          "example": 1640995200
        }
      }
    },
    "schemas": {
      "RegisterRequest": {
        "type": "object",
        "required": [
          "full_name",
          "phone",
          "otp",
          "pin",
          "confirm_pin",
          "device_info"
        ],
        "properties": {
          "full_name": {
            "type": "string",
            "example": "Nguyễn Văn A"
          },
          "phone": {
            "type": "string",
            "pattern": "^[0-9]{10,11}$",
            "example": "0901234567"
          },
          "otp": {
            "type": "string",
            "description": "OTP từ SMS",
            "example": "123456"
          },
          "pin": {
            "type": "string",
            "pattern": "^[0-9]{6}$",
            "description": "6 số",
            "example": "123456"
          },
          "confirm_pin": {
            "type": "string",
            "pattern": "^[0-9]{6}$",
            "example": "123456"
          },
          "device_info": {
            "$ref": "#/components/schemas/DeviceInfo"
          },
          "language": {
            "type": "string",
            "enum": [
              "vi",
              "en"
            ],
            "default": "vi"
          }
        }
      },
      "RegisterResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "type": "object",
            "properties": {
              "user_id": {
                "type": "string",
                "example": "user_123456"
              },
              "phone": {
                "type": "string"
              },
              "full_name": {
                "type": "string"
              },
              "device_bound": {
                "type": "boolean",
                "example": true
              },
              "registered_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "message": {
            "type": "string",
            "example": "Account registered successfully"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "phone",
          "pin",
          "device_info"
        ],
        "properties": {
          "phone": {
            "type": "string",
            "example": "0901234567"
          },
          "pin": {
            "type": "string",
            "pattern": "^[0-9]{6}$",
            "example": "123456"
          },
          "device_info": {
            "$ref": "#/components/schemas/DeviceInfo"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "type": "object",
            "properties": {
              "access_token": {
                "type": "string",
                "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
              },
              "refresh_token": {
                "type": "string"
              },
              "token_type": {
                "type": "string",
                "example": "Bearer"
              },
              "expires_in": {
                "type": "integer",
                "description": "Seconds",
                "example": 3600
              },
              "user": {
                "$ref": "#/components/schemas/UserProfile"
              }
            }
          }
        }
      },
      "ChangeDeviceRequest": {
        "type": "object",
        "required": [
          "phone",
          "pin",
          "otp",
          "new_device_info"
        ],
        "properties": {
          "phone": {
            "type": "string"
          },
          "pin": {
            "type": "string",
            "pattern": "^[0-9]{6}$"
          },
          "otp": {
            "type": "string",
            "description": "OTP xác thực đổi thiết bị"
          },
          "new_device_info": {
            "$ref": "#/components/schemas/DeviceInfo"
          }
        }
      },
      "DeviceInfo": {
        "type": "object",
        "required": [
          "device_id",
          "device_name",
          "os",
          "os_version"
        ],
        "properties": {
          "device_id": {
            "type": "string",
            "description": "Unique device ID",
            "example": "device_uuid_12345"
          },
          "device_name": {
            "type": "string",
            "example": "iPhone 14 Pro"
          },
          "os": {
            "type": "string",
            "enum": [
              "iOS",
              "Android"
            ],
            "example": "iOS"
          },
          "os_version": {
            "type": "string",
            "example": "17.0"
          },
          "app_version": {
            "type": "string",
            "example": "1.0.0"
          }
        }
      },
      "UserProfile": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string",
            "example": "user_123456"
          },
          "full_name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "user_type": {
            "type": "string",
            "enum": [
              "INDIVIDUAL",
              "ORGANIZATION",
              "EMPLOYEE"
            ]
          },
          "organization_id": {
            "type": "string",
            "nullable": true
          },
          "organization_name": {
            "type": "string",
            "nullable": true
          },
          "ekyc_verified": {
            "type": "boolean"
          },
          "ekyc_verified_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CertificateListItem": {
        "type": "object",
        "properties": {
          "certificate_id": {
            "type": "string",
            "example": "cert_789012345"
          },
          "common_name": {
            "type": "string",
            "description": "Tên người dùng/tổ chức (để hiển thị trong list)",
            "example": "NGUYỄN THỊ NGUYÊN THẢO"
          },
          "serial_number": {
            "type": "string",
            "description": "Số serial (có thể mask một phần)",
            "example": "5401010192*********"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "EXPIRED",
              "REVOKED"
            ],
            "description": "ACTIVE = Đang hoạt động"
          },
          "type": {
            "type": "string",
            "enum": [
              "INDIVIDUAL",
              "ORGANIZATION",
              "EMPLOYEE"
            ]
          },
          "package_name": {
            "type": "string",
            "description": "Tên gói dịch vụ",
            "example": "Gói cơ bản Cá nhân - 1 năm"
          },
          "valid_from": {
            "type": "string",
            "format": "date-time"
          },
          "valid_to": {
            "type": "string",
            "format": "date-time"
          },
          "days_remaining": {
            "type": "integer"
          },
          "signing_quota": {
            "type": "object",
            "properties": {
              "total": {
                "type": "integer"
              },
              "used": {
                "type": "integer"
              },
              "remaining": {
                "type": "integer",
                "description": "Số lượt ký còn lại (hiển thị \"X lượt\")"
              }
            }
          }
        }
      },
      "CertificateDetail": {
        "type": "object",
        "properties": {
          "certificate_id": {
            "type": "string"
          },
          "common_name": {
            "type": "string",
            "description": "Tên người dùng/tổ chức",
            "example": "NGUYỄN THỊ NGUYÊN THẢO"
          },
          "serial_number": {
            "type": "string",
            "description": "Số serial (có thể mask một phần)",
            "example": "5401010192*********"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "EXPIRED",
              "REVOKED"
            ],
            "description": "ACTIVE = Đang hoạt động"
          },
          "type": {
            "type": "string",
            "enum": [
              "INDIVIDUAL",
              "ORGANIZATION",
              "EMPLOYEE"
            ]
          },
          "package_name": {
            "type": "string",
            "description": "Tên gói dịch vụ",
            "example": "Gói cơ bản Cá nhân - 1 năm"
          },
          "validity": {
            "type": "object",
            "properties": {
              "valid_from": {
                "type": "string",
                "format": "date-time"
              },
              "valid_to": {
                "type": "string",
                "format": "date-time"
              },
              "days_remaining": {
                "type": "integer"
              }
            }
          },
          "signing_quota": {
            "type": "object",
            "properties": {
              "total": {
                "type": "integer"
              },
              "used": {
                "type": "integer"
              },
              "remaining": {
                "type": "integer",
                "description": "Số lượt ký còn lại (hiển thị \"X lượt\")"
              }
            }
          },
          "issued_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "UpdateCertificateRequest": {
        "type": "object",
        "required": [
          "pin",
          "signature_image"
        ],
        "description": "Thông tin cập nhật chứng thư số. Cần PIN và chữ ký số để xác nhận. Nếu thay đổi CCCD thì cần eKYC.",
        "properties": {
          "full_name": {
            "type": "string",
            "description": "Họ và tên",
            "example": "Nguyễn Thị Nguyên Thảo"
          },
          "date_of_birth": {
            "type": "string",
            "format": "date",
            "description": "Ngày sinh",
            "example": "1990-01-15"
          },
          "cccd_number": {
            "type": "string",
            "description": "Số CCCD (nếu thay đổi thì cần eKYC)",
            "example": "001234567890"
          },
          "cccd_issue_place": {
            "type": "string",
            "description": "Nơi cấp CCCD",
            "example": "Công an Hà Nội"
          },
          "address": {
            "type": "string",
            "description": "Địa chỉ",
            "example": "123 Đường ABC, Quận Cầu Giấy, Hà Nội"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Email",
            "example": "nguyenthithao@example.com"
          },
          "phone": {
            "type": "string",
            "description": "Số điện thoại",
            "example": "0901234567"
          },
          "pin": {
            "type": "string",
            "pattern": "^[0-9]{6}$",
            "description": "Mã PIN 6 chữ số để xác thực",
            "example": "123456"
          },
          "signature_image": {
            "type": "string",
            "format": "byte",
            "description": "Chữ ký số dạng base64 encoded image (PNG/JPG) để ký vào phiếu yêu cầu"
          },
          "ekyc_data": {
            "type": "object",
            "description": "Bắt buộc nếu thay đổi CCCD hoặc thông tin quan trọng",
            "properties": {
              "cccd_number": {
                "type": "string"
              },
              "cccd_images": {
                "type": "object",
                "properties": {
                  "front": {
                    "type": "string",
                    "format": "byte",
                    "description": "Base64 encoded image"
                  },
                  "back": {
                    "type": "string",
                    "format": "byte"
                  }
                }
              },
              "selfie": {
                "type": "string",
                "format": "byte"
              }
            }
          }
        }
      },
      "BuyCertificateRequest": {
        "type": "object",
        "required": [
          "package_id",
          "payment_method",
          "pin",
          "signature_image"
        ],
        "properties": {
