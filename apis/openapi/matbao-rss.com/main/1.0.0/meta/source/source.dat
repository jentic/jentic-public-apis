{
  "openapi": "3.0.3",
  "info": {
    "title": "Mắt Bão RSS - Mobile App APIs",
    "description": "API Specification cho Mobile App (iOS/Android) gọi lên Backend.\n\nBao gồm:\n- Authentication & Authorization\n- User Management\n- Certificate Management\n- Document Signing\n- Order Management\n- Notification\n- Multi-signer (Sequential Signing)\n",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/theapp4ucom/mat-bao-rss-mobile-app-apis/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.matbao-rss.com/api/v1",
      "description": "Production Server"
    }
  ],
  "tags": [
    {
      "name": "Authentication",
      "description": "Đăng ký, đăng nhập, quản lý PIN và Device Binding"
    },
    {
      "name": "User",
      "description": "Quản lý thông tin người dùng"
    },
    {
      "name": "Certificates",
      "description": "Quản lý chứng thư số"
    },
    {
      "name": "Documents",
      "description": "Upload và quản lý tài liệu"
    },
    {
      "name": "Signing",
      "description": "Ký số tài liệu"
    },
    {
      "name": "Signature Templates",
      "description": "Quản lý mẫu chữ ký"
    },
    {
      "name": "Orders",
      "description": "Quản lý đơn hàng"
    },
    {
      "name": "Notifications",
      "description": "Thông báo"
    },
    {
      "name": "Multi-signer",
      "description": "Ký tuần tự nhiều người"
    }
  ],
  "paths": {
    "/auth/register": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Register Account (Đăng ký)",
        "description": "Đăng ký tài khoản cá nhân mới",
        "operationId": "registerAccount",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Account registered successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": "INVALID_OTP",
                    "message": "OTP không đúng hoặc đã hết hạn"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Login (Đăng nhập)",
        "description": "Đăng nhập vào hệ thống",
        "operationId": "login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Device not bound",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Refresh Token",
        "description": "Refresh access token",
        "operationId": "refreshToken",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "refresh_token"
                ],
                "properties": {
                  "refresh_token": {
                    "type": "string",
                    "example": "refresh_token_123456"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token refreshed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "access_token": {
                          "type": "string"
                        },
                        "refresh_token": {
                          "type": "string"
                        },
                        "expires_in": {
                          "type": "integer",
                          "example": 3600
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/forgot-pin": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Forgot PIN (Quên mã PIN) - Step 1",
        "description": "Xác thực OTP để reset PIN",
        "operationId": "forgotPin",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "phone",
                  "otp"
                ],
                "properties": {
                  "phone": {
                    "type": "string",
                    "example": "0901234567"
                  },
                  "otp": {
                    "type": "string",
                    "example": "123456"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OTP verified, reset token provided",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "reset_token": {
                          "type": "string"
                        },
                        "expires_in": {
                          "type": "integer",
                          "description": "Seconds",
                          "example": 600
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/reset-pin": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Reset PIN (Đặt lại mã PIN) - Step 2",
        "description": "Đặt lại mã PIN sau khi đã verify OTP",
        "operationId": "resetPin",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "reset_token",
                  "new_pin",
                  "confirm_pin"
                ],
                "properties": {
                  "reset_token": {
                    "type": "string"
                  },
                  "new_pin": {
                    "type": "string",
                    "pattern": "^[0-9]{6}$",
                    "example": "654321"
                  },
                  "confirm_pin": {
                    "type": "string",
                    "example": "654321"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "PIN reset successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/change-pin": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Change PIN (Đổi mã PIN)",
        "description": "Đổi mã PIN khi đã đăng nhập",
        "operationId": "changePin",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "old_pin",
                  "new_pin",
                  "confirm_pin"
                ],
                "properties": {
                  "old_pin": {
                    "type": "string",
                    "pattern": "^[0-9]{6}$",
                    "example": "123456"
                  },
                  "new_pin": {
                    "type": "string",
                    "pattern": "^[0-9]{6}$",
                    "example": "654321"
                  },
                  "confirm_pin": {
                    "type": "string",
                    "example": "654321"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "PIN changed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/change-device": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Device Binding (Đổi thiết bị)",
        "description": "Đổi thiết bị khi đăng nhập trên thiết bị mới",
        "operationId": "changeDevice",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangeDeviceRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Device changed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "device_bound": {
                          "type": "boolean"
                        },
                        "old_device_unbound": {
                          "type": "boolean"
                        },
                        "access_token": {
                          "type": "string"
                        },
                        "refresh_token": {
                          "type": "string"
                        }
                      }
                    },
                    "message": {
                      "type": "string",
                      "example": "Device changed successfully"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/users/me": {
      "get": {
        "tags": [
          "User"
        ],
        "summary": "Get User Profile",
        "description": "Lấy thông tin user hiện tại",
        "operationId": "getUserProfile",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "User profile",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/UserProfile"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "User"
        ],
        "summary": "Update User Profile",
        "description": "Cập nhật thông tin user",
        "operationId": "updateUserProfile",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "full_name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profile updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/certificates": {
      "get": {
        "tags": [
          "Certificates"
        ],
        "summary": "Get Certificates List",
        "description": "Lấy danh sách chứng thư số",
        "operationId": "getCertificatesList",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "ACTIVE",
                "EXPIRED",
                "REVOKED"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Certificates list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "certificates": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/CertificateListItem"
                          }
                        },
                        "pagination": {
                          "$ref": "#/components/schemas/Pagination"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/certificates/{certificate_id}": {
      "get": {
        "tags": [
          "Certificates"
        ],
        "summary": "Get Certificate Detail",
        "description": "Lấy thông tin chi tiết của chứng thư số",
        "operationId": "getCertificateDetail",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "certificate_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "cert_789012345"
          }
        ],
        "responses": {
          "200": {
            "description": "Certificate detail",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/CertificateDetail"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "put": {
        "tags": [
          "Certificates"
        ],
        "summary": "Update Certificate Information (Thay đổi thông tin CTS)",
        "description": "Cập nhật thông tin chứng thư số (Họ tên, Ngày sinh, CCCD, Địa chỉ, Email, Số điện thoại)",
        "operationId": "updateCertificateInfo",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "certificate_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "cert_789012345"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCertificateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Certificate information update request submitted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "request_id": {
                          "type": "string",
                          "description": "ID của yêu cầu thay đổi thông tin",
                          "example": "update_req_123456"
                        },
                        "certificate_id": {
                          "type": "string",
                          "example": "cert_789012345"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "PENDING_REVIEW",
                            "APPROVED",
                            "REJECTED"
                          ],
                          "example": "PENDING_REVIEW"
                        },
                        "message": {
                          "type": "string",
                          "example": "Yêu cầu thay đổi thông tin đã được gửi. Thông tin sẽ được duyệt bởi CA và gửi về cho bạn các thông báo."
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/certificates/{certificate_id}/update/preview": {
      "post": {
        "tags": [
          "Certificates"
        ],
        "summary": "Preview Update Certificate Request Form (Xem trước phiếu yêu cầu thay đổi thông tin)",
        "description": "Lấy thông tin phiếu yêu cầu thay đổi thông tin chứng thư số để hiển thị trước khi xác nhận",
        "operationId": "previewUpdateCertificate",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "certificate_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "cert_789012345"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "Các field cần thay đổi (tất cả optional)",
                "properties": {
                  "full_name": {
                    "type": "string"
                  },
                  "date_of_birth": {
                    "type": "string",
                    "format": "date"
                  },
                  "cccd_number": {
                    "type": "string"
                  },
                  "cccd_issue_place": {
                    "type": "string"
                  },
                  "address": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "phone": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Update request form preview",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpdateCertificateFormPreview"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/certificates/purchase/preview": {
      "get": {
        "tags": [
          "Certificates"
        ],
        "summary": "Preview Service Request Form (Xem trước phiếu yêu cầu)",
        "description": "Lấy thông tin phiếu yêu cầu dịch vụ chứng thư số để hiển thị trước khi xác nhận",
        "operationId": "previewCertificatePurchase",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "package_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID gói dịch vụ chứng thư số"
          },
          {
            "name": "promotion_code",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Mã khuyến mãi (nếu có)"
          }
        ],
        "responses": {
          "200": {
            "description": "Service request form preview",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceRequestFormPreview"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/certificates/purchase": {
      "post": {
        "tags": [
          "Certificates"
        ],
        "summary": "Buy Certificate (Mua CTS)",
        "description": "Mua chứng thư số",
        "operationId": "buyCertificate",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BuyCertificateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Purchase order created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BuyCertificateResponse"
                }
              }
            }
          }
        }
      }
    },
    "/certificates/{certificate_id}/purchase-quota": {
      "post": {
        "tags": [
          "Certificates"
        ],
        "summary": "Buy Signing Quota (Mua lượt ký)",
        "description": "Mua thêm lượt ký cho chứng thư số",
        "operationId": "buySigningQuota",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "certificate_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "quota_package_id",
                  "payment_method"
                ],
                "properties": {
                  "quota_package_id": {
                    "type": "string",
                    "example": "pkg_quota_100"
                  },
                  "promotion_code": {
                    "type": "string",
                    "nullable": true
                  },
                  "payment_method": {
                    "type": "string",
                    "enum": [
                      "BANK_TRANSFER",
                      "E_WALLET"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Quota purchase order created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "order_id": {
                          "type": "string"
                        },
                        "certificate_id": {
                          "type": "string"
                        },
                        "quota_amount": {
                          "type": "integer"
                        },
                        "amount": {
                          "type": "integer"
                        },
                        "payment": {
                          "type": "object",
                          "properties": {
                            "payment_id": {
