            "example": "BANK_TRANSFER"
          },
          "pin": {
            "type": "string",
            "pattern": "^[0-9]{6}$",
            "description": "Mã PIN 6 chữ số để xác thực",
            "example": "123456"
          },
          "signature_image": {
            "type": "string",
            "format": "byte",
            "description": "Chữ ký số dạng base64 encoded image (PNG/JPG) để ký vào phiếu yêu cầu"
          },
          "ekyc_data": {
            "type": "object",
            "description": "Nếu chưa eKYC",
            "properties": {
              "cccd_number": {
                "type": "string"
              },
              "cccd_images": {
                "type": "object",
                "properties": {
                  "front": {
                    "type": "string",
                    "format": "byte",
                    "description": "Base64 encoded image"
                  },
                  "back": {
                    "type": "string",
                    "format": "byte"
                  }
                }
              },
              "selfie": {
                "type": "string",
                "format": "byte"
              }
            }
          }
        }
      },
