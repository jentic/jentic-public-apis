{
  "openapi": "3.0.3",
  "info": {
    "title": "TagoIO API",
    "description": "REST API for the TagoIO IoT platform. Manage devices, send and retrieve device data, manage dashboards, handle files, and configure analysis and actions.",
    "version": "v1",
    "contact": {
      "name": "TagoIO",
      "url": "https://tago.io"
    },
    "x-jentic-source-url": "https://docs.tago.io",
    "x-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://api.tago.io",
      "description": "TagoIO API (default/US East)"
    },
    {
      "url": "https://api.us-e1.tago.io",
      "description": "TagoIO US East 1"
    },
    {
      "url": "https://api.eu-w1.tago.io",
      "description": "TagoIO Europe West 1"
    }
  ],
  "security": [
    {
      "profileToken": []
    }
  ],
  "paths": {
    "/device": {
      "get": {
        "operationId": "listDevices",
        "summary": "List devices",
        "description": "Retrieve a list of devices in your account.",
        "security": [{ "profileToken": [] }],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": { "type": "integer", "default": 1 },
            "description": "Page number for pagination"
          },
          {
            "name": "amount",
            "in": "query",
            "schema": { "type": "integer", "default": 20 },
            "description": "Number of items per page"
          },
          {
            "name": "filter",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Filter devices by name or tag"
          },
          {
            "name": "fields",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Comma-separated list of fields to return"
          }
        ],
        "responses": {
          "200": {
            "description": "List of devices",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "boolean" },
                    "result": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string" },
                          "name": { "type": "string" },
                          "active": { "type": "boolean" },
                          "visible": { "type": "boolean" },
                          "tags": { "type": "array", "items": { "type": "object" } },
                          "created_at": { "type": "string", "format": "date-time" },
                          "updated_at": { "type": "string", "format": "date-time" }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      },
      "post": {
        "operationId": "createDevice",
        "summary": "Create a device",
        "description": "Create a new device in your TagoIO account.",
        "security": [{ "profileToken": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string", "description": "Device name" },
                  "description": { "type": "string" },
                  "active": { "type": "boolean", "default": true },
                  "visible": { "type": "boolean", "default": true },
                  "connector": { "type": "string", "description": "Connector ID" },
                  "network": { "type": "string", "description": "Network ID" },
                  "type": { "type": "string", "enum": ["mutable", "immutable"], "default": "mutable" },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "key": { "type": "string" },
                        "value": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Device created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "boolean" },
                    "result": {
                      "type": "object",
                      "properties": {
                        "device_id": { "type": "string" },
                        "token": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/device/{deviceId}": {
      "get": {
        "operationId": "getDeviceInfo",
        "summary": "Get device information",
        "description": "Retrieve detailed information about a specific device.",
        "security": [{ "profileToken": [] }],
        "parameters": [
          {
            "name": "deviceId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Device ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Device information",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "boolean" },
                    "result": { "type": "object" }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Device not found" }
        }
      },
      "put": {
        "operationId": "editDevice",
        "summary": "Edit a device",
        "description": "Update device properties.",
        "security": [{ "profileToken": [] }],
        "parameters": [
          {
            "name": "deviceId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "description": { "type": "string" },
                  "active": { "type": "boolean" },
                  "visible": { "type": "boolean" },
                  "tags": { "type": "array", "items": { "type": "object" } }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Device updated" },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Device not found" }
        }
      },
      "delete": {
        "operationId": "deleteDevice",
        "summary": "Delete a device",
        "description": "Delete a device from your account.",
        "security": [{ "profileToken": [] }],
        "parameters": [
          {
            "name": "deviceId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Device deleted" },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Device not found" }
        }
      }
    },
    "/device/{deviceId}/data": {
      "get": {
        "operationId": "getDeviceData",
        "summary": "Get device data",
        "description": "Retrieve data records for a specific device. Can be called with either a Device-Token or Profile-Token.",
        "security": [
          { "deviceToken": [] },
          { "profileToken": [] }
        ],
        "parameters": [
          {
            "name": "deviceId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "variable",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Filter by variable name"
          },
          {
            "name": "qty",
            "in": "query",
            "schema": { "type": "integer" },
            "description": "Number of records to return"
          },
          {
            "name": "start_date",
            "in": "query",
            "schema": { "type": "string", "format": "date-time" },
            "description": "Start date filter"
          },
          {
            "name": "end_date",
            "in": "query",
            "schema": { "type": "string", "format": "date-time" },
            "description": "End date filter"
          },
          {
            "name": "query",
            "in": "query",
            "schema": { "type": "string", "enum": ["last_value", "last_item", "last_insert", "min", "max", "count", "avg", "sum"] },
            "description": "Aggregation query type"
          }
        ],
        "responses": {
          "200": {
            "description": "Device data records",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "boolean" },
                    "result": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string" },
                          "variable": { "type": "string" },
                          "value": {},
                          "unit": { "type": "string" },
                          "time": { "type": "string", "format": "date-time" },
                          "serie": { "type": "string" },
                          "metadata": { "type": "object" },
                          "location": {
                            "type": "object",
                            "properties": {
                              "lat": { "type": "number" },
                              "lng": { "type": "number" }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      },
      "post": {
        "operationId": "sendDeviceData",
        "summary": "Send device data",
        "description": "Send data to a device. Typically used with a Device-Token.",
        "security": [
          { "deviceToken": [] },
          { "profileToken": [] }
        ],
        "parameters": [
          {
            "name": "deviceId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "required": ["variable", "value"],
                    "properties": {
                      "variable": { "type": "string" },
                      "value": {},
                      "unit": { "type": "string" },
                      "time": { "type": "string", "format": "date-time" },
                      "serie": { "type": "string" },
                      "metadata": { "type": "object" },
                      "location": {
                        "type": "object",
                        "properties": {
                          "lat": { "type": "number" },
                          "lng": { "type": "number" }
                        }
                      }
                    }
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["variable", "value"],
                      "properties": {
                        "variable": { "type": "string" },
                        "value": {},
                        "unit": { "type": "string" },
                        "time": { "type": "string", "format": "date-time" }
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Data sent successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "boolean" },
                    "result": { "type": "string" }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      },
      "delete": {
        "operationId": "deleteDeviceData",
        "summary": "Delete device data",
        "description": "Delete specific data records from a device.",
        "security": [{ "profileToken": [] }],
        "parameters": [
          {
            "name": "deviceId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "ids": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Array of data record IDs to delete"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Data deleted" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/device/{deviceId}/empty": {
      "delete": {
        "operationId": "emptyDeviceStorage",
        "summary": "Empty device storage",
        "description": "Remove all data records from a device.",
        "security": [{ "profileToken": [] }],
        "parameters": [
          {
            "name": "deviceId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Device storage emptied" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/device/{deviceId}/data/count": {
      "get": {
        "operationId": "getDeviceDataAmount",
        "summary": "Get device data count",
        "description": "Get the number of data records stored for a device.",
        "security": [{ "profileToken": [] }],
        "parameters": [
          {
            "name": "deviceId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Data count",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "boolean" },
                    "result": { "type": "integer" }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/device/{deviceId}/token": {
      "get": {
        "operationId": "listDeviceTokens",
        "summary": "List device tokens",
        "description": "Retrieve all tokens associated with a device.",
        "security": [{ "profileToken": [] }],
        "parameters": [
          {
            "name": "deviceId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "List of device tokens",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "boolean" },
                    "result": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "token": { "type": "string" },
                          "name": { "type": "string" },
                          "permission": { "type": "string" },
                          "created_at": { "type": "string", "format": "date-time" }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      },
      "post": {
        "operationId": "createDeviceToken",
        "summary": "Create a device token",
        "description": "Generate a new token for a device.",
        "security": [{ "profileToken": [] }],
        "parameters": [
          {
            "name": "deviceId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "permission"],
                "properties": {
                  "name": { "type": "string", "description": "Token name" },
                  "permission": { "type": "string", "enum": ["full", "write", "read"], "description": "Token permission level" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Token created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "boolean" },
                    "result": {
                      "type": "object",
                      "properties": {
                        "token": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/dashboard": {
      "get": {
        "operationId": "listDashboards",
        "summary": "List dashboards",
        "description": "Retrieve a list of dashboards in your account.",
        "security": [{ "profileToken": [] }],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": { "type": "integer", "default": 1 }
          },
          {
            "name": "amount",
            "in": "query",
            "schema": { "type": "integer", "default": 20 }
          }
        ],
        "responses": {
          "200": {
            "description": "List of dashboards",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "boolean" },
                    "result": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string" },
                          "label": { "type": "string" },
                          "created_at": { "type": "string", "format": "date-time" }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      },
      "post": {
        "operationId": "createDashboard",
        "summary": "Create a dashboard",
        "description": "Create a new dashboard.",
        "security": [{ "profileToken": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["label"],
                "properties": {
                  "label": { "type": "string", "description": "Dashboard label/name" },
                  "arrangement": { "type": "array", "items": { "type": "object" } },
                  "tags": { "type": "array", "items": { "type": "object" } }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Dashboard created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "boolean" },
                    "result": {
                      "type": "object",
                      "properties": {
                        "id": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/analysis": {
      "get": {
        "operationId": "listAnalyses",
        "summary": "List analyses",
        "description": "Retrieve a list of analysis scripts in your account.",
        "security": [{ "profileToken": [] }],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": { "type": "integer", "default": 1 }
          },
          {
            "name": "amount",
            "in": "query",
            "schema": { "type": "integer", "default": 20 }
          }
        ],
        "responses": {
          "200": {
            "description": "List of analyses",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "boolean" },
                    "result": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string" },
                          "name": { "type": "string" },
                          "active": { "type": "boolean" }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/action": {
      "get": {
        "operationId": "listActions",
        "summary": "List actions",
        "description": "Retrieve a list of actions (triggers) in your account.",
        "security": [{ "profileToken": [] }],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": { "type": "integer", "default": 1 }
          },
          {
            "name": "amount",
            "in": "query",
            "schema": { "type": "integer", "default": 20 }
          }
        ],
        "responses": {
          "200": {
            "description": "List of actions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "boolean" },
                    "result": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string" },
                          "name": { "type": "string" },
                          "active": { "type": "boolean" },
                          "type": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "profileToken": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header",
        "description": "Profile-Token for profile-level management across resources"
      },
      "deviceToken": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header",
        "description": "Device-Token for device-scoped operations"
      }
    }
  }
}