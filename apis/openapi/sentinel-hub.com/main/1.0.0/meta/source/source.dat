{
  "openapi": "3.0.3",
  "info": {
    "title": "Copernicus Sentinel Hub API",
    "description": "Access Copernicus Sentinel satellite Earth observation data through processing, catalog search, statistical analysis, and batch processing endpoints. Provides on-the-fly processing of satellite imagery with custom evalscripts.",
    "version": "1.0.0",
    "contact": {
      "name": "Sentinel Hub",
      "url": "https://docs.sentinel-hub.com/api/latest/"
    },
    "x-jentic-source-url": "https://docs.sentinel-hub.com/api/latest/"
  },
  "x-jentic-provenance": "jentic-generated",
  "servers": [
    {
      "url": "https://services.sentinel-hub.com",
      "description": "Sentinel Hub Services"
    }
  ],
  "security": [
    {
      "oauth2": [
        "sentinel-hub"
      ]
    }
  ],
  "paths": {
    "/api/v1/process": {
      "post": {
        "operationId": "processImage",
        "summary": "Process satellite imagery with evalscript",
        "description": "Processes satellite data on-the-fly using a custom evalscript. Supports Sentinel-1, Sentinel-2, Sentinel-3, Sentinel-5P, Landsat, MODIS, and other data collections.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProcessRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Processed image data",
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/tiff": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid evalscript or parameters"
          },
          "401": {
            "description": "Unauthorized - invalid or expired token"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
    "/api/v1/catalog/1.0.0/": {
      "get": {
        "operationId": "getCatalogRoot",
        "summary": "Get root STAC catalog",
        "description": "Returns the root STAC Catalog that is the entry point for browsing available data collections.",
        "responses": {
          "200": {
            "description": "STAC catalog root",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "conformsTo": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "links": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Link"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/catalog/1.0.0/collections": {
      "get": {
        "operationId": "getCatalogCollections",
        "summary": "List available data collections",
        "description": "Returns all available satellite data collections (Sentinel-1, Sentinel-2, etc.).",
        "responses": {
          "200": {
            "description": "List of STAC collections",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "collections": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Collection"
                      }
                    },
                    "links": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Link"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/v1/catalog/1.0.0/collections/{collectionId}": {
      "get": {
        "operationId": "getCatalogCollection",
        "summary": "Get specific data collection details",
        "description": "Returns details for a specific satellite data collection.",
        "parameters": [
          {
            "name": "collectionId",
            "in": "path",
            "required": true,
            "description": "Collection identifier (e.g., sentinel-2-l2a)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "STAC collection details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Collection"
                }
              }
            }
          },
          "404": {
            "description": "Collection not found"
          }
        }
      }
    },
    "/api/v1/catalog/1.0.0/search": {
      "post": {
        "operationId": "searchCatalog",
        "summary": "Search for satellite data items",
        "description": "Full-featured STAC item search with spatial, temporal, and property filters.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CatalogSearchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Search results as STAC FeatureCollection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeatureCollection"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/v1/catalog/1.0.0/collections/{collectionId}/items": {
      "get": {
        "operationId": "getCollectionItems",
        "summary": "Get items in a collection",
        "description": "Fetch features (satellite data items) from a specific collection.",
        "parameters": [
          {
            "name": "collectionId",
            "in": "path",
            "required": true,
            "description": "Collection identifier",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum number of items to return",
            "schema": {
              "type": "integer",
              "default": 10,
              "maximum": 100
            }
          },
          {
            "name": "bbox",
            "in": "query",
            "required": false,
            "description": "Bounding box filter (minLon,minLat,maxLon,maxLat)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "datetime",
            "in": "query",
            "required": false,
            "description": "Temporal filter (ISO 8601 date/time or interval)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "STAC FeatureCollection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeatureCollection"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/catalog/1.0.0/collections/{collectionId}/items/{featureId}": {
      "get": {
        "operationId": "getCollectionItem",
        "summary": "Get a specific catalog item",
        "description": "Fetch a single satellite data item by its feature ID.",
        "parameters": [
          {
            "name": "collectionId",
            "in": "path",
            "required": true,
            "description": "Collection identifier",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "featureId",
            "in": "path",
            "required": true,
            "description": "Feature identifier",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "STAC Feature",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Feature"
                }
              }
            }
          },
          "404": {
            "description": "Feature not found"
          }
        }
      }
    },
    "/api/v1/statistics": {
      "post": {
        "operationId": "calculateStatistics",
        "summary": "Calculate statistics for satellite data",
        "description": "Computes statistical summaries (mean, median, std dev, histograms) for satellite data over a specified area and time range.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StatisticsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Statistical results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "interval": {
                            "type": "object",
                            "properties": {
                              "from": {
                                "type": "string",
                                "format": "date-time"
                              },
                              "to": {
                                "type": "string",
                                "format": "date-time"
                              }
                            }
                          },
                          "outputs": {
                            "type": "object"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/v1/batch/process": {
      "post": {
        "operationId": "createBatchProcess",
        "summary": "Create a batch processing request",
        "description": "Submit a large-area batch processing job. Results are delivered to cloud storage.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "processRequest",
                  "tilingGrid",
                  "output"
                ],
                "properties": {
                  "processRequest": {
                    "$ref": "#/components/schemas/ProcessRequest"
                  },
                  "tilingGrid": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "integer"
                      },
                      "resolution": {
                        "type": "number"
                      }
                    }
                  },
                  "output": {
                    "type": "object",
                    "properties": {
                      "defaultTilePath": {
                        "type": "string"
                      }
                    }
                  },
                  "description": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Batch request created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      },
      "get": {
        "operationId": "listBatchProcesses",
        "summary": "List batch processing requests",
        "description": "Query and list batch processing requests.",
        "responses": {
          "200": {
            "description": "List of batch requests",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "member": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/BatchResponse"
                      }
                    },
                    "links": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Link"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/batch/process/{taskId}": {
      "get": {
        "operationId": "getBatchProcess",
        "summary": "Get batch processing request status",
        "description": "Retrieve the status and details of a specific batch processing request.",
        "parameters": [
          {
            "name": "taskId",
            "in": "path",
            "required": true,
            "description": "Batch task identifier",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Batch request details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchResponse"
                }
              }
            }
          },
          "404": {
            "description": "Task not found"
          }
        }
      }
    },
    "/api/v1/batch/process/{taskId}/start": {
      "post": {
        "operationId": "startBatchProcess",
        "summary": "Start batch processing",
        "description": "Start execution of a batch processing request that has been analyzed.",
        "parameters": [
          {
            "name": "taskId",
            "in": "path",
            "required": true,
            "description": "Batch task identifier",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Batch processing started"
          },
          "404": {
            "description": "Task not found"
          }
        }
      }
    },
    "/api/v1/batch/process/{taskId}/analyse": {
      "post": {
        "operationId": "analyseBatchProcess",
        "summary": "Analyse batch processing request",
        "description": "Analyse a batch processing request to estimate tile count and processing units before starting.",
        "parameters": [
          {
            "name": "taskId",
            "in": "path",
            "required": true,
            "description": "Batch task identifier",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Analysis started"
          },
          "404": {
            "description": "Task not found"
          }
        }
      }
    },
    "/api/v1/batch/process/{taskId}/stop": {
      "post": {
        "operationId": "stopBatchProcess",
        "summary": "Stop batch processing",
        "description": "Stop a running batch processing request.",
        "parameters": [
          {
            "name": "taskId",
            "in": "path",
            "required": true,
            "description": "Batch task identifier",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Batch processing stopped"
          },
          "404": {
            "description": "Task not found"
          }
        }
      }
    },
    "/api/v1/async/process": {
      "post": {
        "operationId": "createAsyncProcess",
        "summary": "Submit async processing request",
        "description": "Submit an asynchronous image processing request for large or complex operations.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProcessRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Async request accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/async/process/{requestId}": {
      "get": {
        "operationId": "getAsyncProcessStatus",
        "summary": "Get async processing request status",
        "description": "Check the status of an async processing request.",
        "parameters": [
          {
            "name": "requestId",
            "in": "path",
            "required": true,
            "description": "Async request identifier",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Async request status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "CREATED",
                        "RUNNING",
                        "DONE",
                        "FAILED"
                      ]
                    },
                    "created": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "completed": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Request not found"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "oauth2": {
        "type": "oauth2",
        "description": "OAuth2 Client Credentials flow. Obtain client_id and client_secret from Sentinel Hub Dashboard at https://apps.sentinel-hub.com/dashboard/",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://services.sentinel-hub.com/auth/realms/main/protocol/openid-connect/token",
            "scopes": {
              "sentinel-hub": "Access Sentinel Hub services"
            }
          }
        }
      }
    },
    "schemas": {
      "ProcessRequest": {
        "type": "object",
        "required": [
          "input",
          "output",
          "evalscript"
        ],
        "properties": {
          "input": {
            "type": "object",
            "required": [
              "bounds",
              "data"
            ],
            "properties": {
              "bounds": {
                "type": "object",
                "properties": {
                  "bbox": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 4,
                    "maxItems": 4,
                    "description": "Bounding box [minLon, minLat, maxLon, maxLat]"
                  },
                  "geometry": {
                    "type": "object",
                    "description": "GeoJSON geometry for area of interest"
                  },
                  "properties": {
                    "type": "object",
                    "properties": {
                      "crs": {
                        "type": "string",
                        "description": "Coordinate reference system URL"
                      }
                    }
                  }
                }
              },
              "data": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "description": "Data collection type (e.g., sentinel-2-l2a)"
                    },
                    "dataFilter": {
                      "type": "object",
                      "properties": {
                        "timeRange": {
                          "type": "object",
                          "properties": {
                            "from": {
                              "type": "string",
                              "format": "date-time"
                            },
                            "to": {
                              "type": "string",
                              "format": "date-time"
                            }
                          }
                        },
                        "maxCloudCoverage": {
                          "type": "number"
                        },
                        "mosaickingOrder": {
                          "type": "string",
                          "enum": [
                            "mostRecent",
                            "leastRecent",
                            "leastCC"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "output": {
            "type": "object",
            "properties": {
              "width": {
                "type": "integer",
                "description": "Output image width in pixels"
              },
              "height": {
                "type": "integer",
                "description": "Output image height in pixels"
              },
              "resx": {
                "type": "number",
                "description": "Output resolution in x direction (meters)"
              },
              "resy": {
                "type": "number",
                "description": "Output resolution in y direction (meters)"
              },
              "responses": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "identifier": {
                      "type": "string"
                    },
                    "format": {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "enum": [
                            "image/png",
                            "image/tiff",
                            "image/jpeg",
                            "application/json"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "evalscript": {
            "type": "string",
            "description": "JavaScript evalscript defining how to process the satellite data"
          }
        }
      },
      "CatalogSearchRequest": {
        "type": "object",
        "properties": {
          "collections": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Collection IDs to search"
          },
          "datetime": {
            "type": "string",
            "description": "ISO 8601 date-time or interval"
          },
          "bbox": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "intersects": {
            "type": "object",
            "description": "GeoJSON geometry"
          },
          "limit": {
            "type": "integer",
            "default": 10,
            "maximum": 100
          },
          "next": {
            "type": "string",
            "description": "Pagination token"
          },
          "filter": {
            "type": "object",
            "description": "CQL2 filter expression"
          }
        }
      },
      "StatisticsRequest": {
        "type": "object",
        "required": [
          "input",
          "aggregation",
          "evalscript"
        ],
        "properties": {
          "input": {
            "type": "object",
            "properties": {
              "bounds": {
                "type": "object",
                "properties": {
                  "bbox": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  },
                  "geometry": {
                    "type": "object"
                  }
                }
              },
              "data": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "dataFilter": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "aggregation": {
            "type": "object",
            "properties": {
              "timeRange": {
                "type": "object",
                "properties": {
                  "from": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "to": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              },
              "aggregationInterval": {
                "type": "object",
                "properties": {
                  "of": {
                    "type": "string",
                    "enum": [
                      "P1D",
                      "P5D",
                      "P10D",
                      "P1M"
                    ]
                  }
                }
              },
              "resx": {
                "type": "number"
              },
              "resy": {
                "type": "number"
              }
            }
          },
          "evalscript": {
            "type": "string"
          },
          "calculations": {
            "type": "object"
          }
        }
      },
      "Collection": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "extent": {
            "type": "object",
            "properties": {
              "spatial": {
                "type": "object",
                "properties": {
                  "bbox": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      }
                    }
                  }
                }
              },
              "temporal": {
                "type": "object",
                "properties": {
                  "interval": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "nullable": true
                      }
                    }
                  }
                }
              }
            }
          },
          "links": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Link"
            }
          }
        }
      },
      "FeatureCollection": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "FeatureCollection"
            ]
          },
          "features": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Feature"
            }
          },
          "links": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Link"
            }
          },
          "context": {
            "type": "object",
            "properties": {
              "next": {
                "type": "string"
              },
              "limit": {
                "type": "integer"
              },
              "returned": {
                "type": "integer"
              }
            }
          }
        }
      },
      "Feature": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "Feature"
            ]
          },
          "id": {
            "type": "string"
          },
          "geometry": {
            "type": "object"
          },
          "properties": {
            "type": "object"
          },
          "assets": {
            "type": "object"
          },
          "links": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Link"
            }
          }
        }
      },
      "BatchResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "CREATED",
              "ANALYSING",
              "ANALYSIS_DONE",
              "PROCESSING",
              "DONE",
              "FAILED",
              "CANCELLED"
            ]
          },
          "created": {
            "type": "string",
            "format": "date-time"
          },
          "processRequest": {
            "type": "object"
          },
          "tilingGrid": {
            "type": "object"
          },
          "output": {
            "type": "object"
          },
          "tileCount": {
            "type": "integer"
          },
          "valueEstimate": {
            "type": "number"
          }
        }
      },
      "Link": {
        "type": "object",
        "properties": {
          "href": {
            "type": "string"
          },
          "rel": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        }
      }
    }
  }
}
