                        "allOf": [
                          {
                            "$ref": "#/components/schemas/DiagnosisSummary"
                          },
                          {
                            "$ref": "#/components/schemas/TextSearch"
                          }
                        ]
                      }
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/libraries/{audience}/diagnoses/search/by-code": {
      "get": {
        "summary": "Get diagnoses by code",
        "description": "Search for Diagnoses that match the specified code and system.",
        "tags": [
