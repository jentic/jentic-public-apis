    "/libraries/{audience}/diagnoses/{id}": {
      "get": {
        "summary": "Get a diagnosis writeup",
        "description": "This request returns a detailed writeup of the diagnosis for a clinical audience. This request returns the default view of the Diagnosis Details, however each diagnosis may support additional views. Additional views may be enumerated from the response to this endpoint via the array found at JSONPath `$.views` An optional list of findings may be included that will be considered when ordering images (e.g. by body location).\n",
        "tags": [
          "Library"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/audience"
          },
          {
            "$ref": "#/components/parameters/conceptId"
          },
          {
            "$ref": "#/components/parameters/viewId"
          },
          {
            "$ref": "#/components/parameters/textFormat"
          },
          {
            "$ref": "#/components/parameters/findingIds"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/DiagnosisWriteup"
                    },
                    "views": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/DiagnosisView"
                      }
                    }
                  },
                  "required": [
                    "data",
                    "views"
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/libraries/{audience}/diagnoses/{id}/handout": {
      "get": {
        "summary": "Get a diagnosis handout",
        "description": "This request returns a handout for a diagnosis.",
        "tags": [
          "Library"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/audience"
          },
          {
            "$ref": "#/components/parameters/conceptId"
          },
          {
            "$ref": "#/components/parameters/textFormat"
          },
          {
            "in": "header",
            "name": "Accept-Language",
            "description": "The code identifying the requested language of the content returned by the handout if one exists, otherwise it returns the handout in en-US",
            "required": false,
            "schema": {
              "type": "string",
              "default": "en-US"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/DiagnosisWriteup"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            },
            "headers": {
              "Content-Language": {
                "description": "The code identifying the language of the content returned by the handout (i.e. en-US)",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/libraries/{audience}/diagnoses/{id}/views": {
      "get": {
        "summary": "Get diagnosis views",
        "description": "Retrieve a list of the alternative diagnosis views that can be retrieved for the specified diagnosis.",
        "tags": [
          "Library"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/audience"
          },
          {
            "$ref": "#/components/parameters/conceptId"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/DiagnosisView"
                      }
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/libraries/{audience}/diagnoses/specialties": {
      "get": {
        "summary": "Get all diagnosis specialties",
        "description": "Returns a list of diagnosis specialties, each with an ID and display name.",
        "tags": [
          "Library"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/audience"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Specialty"
                      }
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/usage/report": {
      "get": {
        "summary": "Get billable usage metrics",
        "description": "Retrieve billable API operation counts for all billable periods.  Only billable endpoints are reported.",
        "tags": [
          "Usage"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "partnerId": {
                            "type": "string",
                            "description": "Your partner identifier."
                          },
                          "segment": {
                            "type": "string",
                            "description": "The billing period.",
                            "pattern": "^\\d{4}-\\d{2}$"
                          }
                        },
                        "required": [
                          "partnerId",
                          "segment"
                        ],
                        "additionalProperties": {
                          "type": "integer"
                        },
                        "example": {
                          "partnerId": "example-partner",
                          "segment": "2000-07",
                          "count_submitInference": 101,
                          "count_differential": 42
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "textFormat": {
        "name": "textFormat",
        "in": "query",
        "description": "The format to use for text content.",
        "required": false,
        "schema": {
          "type": "string",
          "enum": [
            "html",
            "md",
            "plain"
          ],
          "default": "html"
        }
      },
      "audience": {
        "name": "audience",
        "in": "path",
        "description": "The dataset to use when performing an operation.",
        "required": true,
        "schema": {
          "type": "string",
          "enum": [
            "clinical",
            "consumer"
          ]
        },
        "example": "clinical"
      },
      "searchQuery": {
        "name": "q",
        "in": "query",
        "description": "The search query.",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 2
        },
        "example": "hypoplasia"
      },
      "pageNumber": {
        "name": "pageNumber",
        "in": "query",
        "description": "Return the given page number in the sequence.",
        "schema": {
          "type": "integer"
        }
      },
      "pageCapacity": {
        "name": "pageCapacity",
        "in": "query",
        "description": "Return a page of data with the following capacity.",
        "schema": {
          "type": "integer"
        }
      },
      "externalCodeSystem": {
        "name": "system",
        "in": "query",
        "description": "The external coding system in which to find `code`.",
        "schema": {
          "type": "string"
        },
        "example": "SNOMEDCT"
      },
      "externalCodeValue": {
        "name": "code",
        "in": "query",
        "description": "The external coding system code.",
        "schema": {
          "type": "string"
        },
        "required": true,
        "example": "SNO123"
      },
      "conceptId": {
        "name": "id",
        "in": "path",
        "description": "The unique identifier for the concept.",
        "schema": {
          "type": "integer"
        },
        "required": true,
        "example": 1234
      },
      "viewId": {
        "name": "viewId",
        "in": "query",
        "description": "The identifier for a specific view.",
        "schema": {
          "type": "integer"
        },
        "example": 1234
      },
      "findingIds": {
        "name": "findingIds",
        "in": "query",
        "description": "A list of finding IDs.",
        "required": false,
        "style": "form",
        "explode": true,
        "schema": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "example": [
            101,
            202,
            303
          ]
        }
      }
    },
    "schemas": {
      "ConceptId": {
        "description": "The unique identifier for the concept.",
        "type": "integer",
        "example": 1234
      },
      "ConceptName": {
        "description": "The name of the concept.",
        "type": "string"
      },
      "ConceptConfidence": {
        "description": "The confidence that the prediction matches the identified feature.",
        "type": "number",
        "default": 1.0,
        "minimum": 0.0,
        "maximum": 1.0
      },
      "ConceptSummary": {
        "description": "A brief summary of the concept.",
        "type": "string"
      },
      "Diagnosis": {
        "description": "A medical concept representing a diagnosis.",
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/ConceptId"
          },
          "confidence": {
            "$ref": "#/components/schemas/ConceptConfidence"
          }
        },
        "required": [
          "id"
        ]
      },
      "Finding": {
        "description": "A medical concept representing a finding.",
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/ConceptId"
          },
          "confidence": {
            "$ref": "#/components/schemas/ConceptConfidence"
          },
          "required": {
            "description": "Whether or not the finding is required in the differential.",
            "type": "boolean"
          }
        },
        "required": [
          "id"
        ]
      },
      "Age": {
        "description": "Age of the patient in months or years.",
        "type": "object",
        "properties": {
          "value": {
            "description": "Age of subject in months or years as indicated by `unit`.",
            "type": "integer"
          },
          "unit": {
            "description": "The unit of measurement for the patient's age.",
            "type": "string",
            "enum": [
              "month",
              "year"
            ]
          }
        },
        "required": [
          "value",
          "unit"
        ]
      },
      "AgeCategory": {
        "description": "Age ranges in which a condition may present.\n\n* `INFANT` < 1 month\n* `CHILD` 2 months - 19 years\n* `ADULT` 20+ years\n",
        "type": "string",
        "enum": [
          "INFANT",
          "CHILD",
          "ADULT"
        ]
      },
      "Sex": {
        "description": "Sex of the patient.\n\n* `F` Female\n* `M` Male\n* `U` Unspecified\n",
        "type": "string",
        "enum": [
          "F",
          "M",
          "U"
        ]
      },
      "Inference": {
        "type": "object",
        "properties": {
          "findings": {
            "description": "The list of weighted finding predictions.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InferenceResult"
            }
          },
          "diagnoses": {
            "description": "The list of weighted diagnosis predictions.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InferenceResult"
            }
          }
        },
        "required": [
          "findings",
          "diagnoses"
        ]
      },
      "InferenceResult": {
        "description": "A medical concept representing a diagnosis.",
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/ConceptId"
          },
          "confidence": {
            "$ref": "#/components/schemas/ConceptConfidence"
          }
        },
        "required": [
          "id"
        ]
      },
      "Workup": {
        "type": "object",
        "properties": {
          "age": {
            "$ref": "#/components/schemas/Age"
          },
          "sex": {
            "$ref": "#/components/schemas/Sex"
          },
          "findings": {
            "description": "The list of weighted finding inputs.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Finding"
            }
          },
          "diagnoses": {
            "description": "The list of weighted diagnosis inputs.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Diagnosis"
            }
          }
        }
      },
      "Differential": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/DiagnosisMatch"
        }
      },
      "DiagnosisMatch": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/ConceptId"
          },
          "name": {
            "$ref": "#/components/schemas/ConceptName"
          },
          "summary": {
            "$ref": "#/components/schemas/ConceptSummary"
          },
          "matchStrength": {
            "description": "A numeric representation of how strong the diagnosis matches the workup.",
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "viewId": {
            "description": "The diagnosis view best matched to the workup values.",
            "type": "integer"
          },
          "specialties": {
            "$ref": "#/components/schemas/DiagnosisSpecialties"
          },
          "images": {
            "$ref": "#/components/schemas/DiagnosisImages"
          },
          "commonality": {
            "type": "integer",
            "description": "An integer value representing how common this diagnosis is.",
            "example": 1
          },
          "severity": {
            "type": "string",
            "description": "Severity level of the diagnosis.",
            "enum": [
              "STANDARD",
              "EMERGENCY",
              "LIFE_THREATENING"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "summary",
          "matchStrength",
          "viewId",
          "specialties",
          "images"
        ]
      },
      "Image": {
        "type": "object",
        "properties": {
          "id": {
            "description": "The unique identifier for the image.",
            "type": "integer"
          },
          "sensitive": {
            "description": "The image contains content that may be graphic or disturbing.",
            "type": "boolean"
          },
          "skinType": {
            "description": "Skin-type identification of the depicted image, returned as an integer representation of the [Fitzpatrick Scale](https://en.wikipedia.org/wiki/Fitzpatrick_scale).",
            "type": "integer"
          },
          "bodyLocations": {
            "description": "The clinically significant body location findings represented in the image.  See finding category \"Body Locations\".",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConceptId"
            }
          },
          "type": {
            "description": "Image type code. Integer-encoded based on internal enum.\nExample values:\n  1 = Clinical\n  2 = Dermoscopic\n  3 = ECG\n  4 = Icon\n  5 = Illustration\n  6 = Imaging studies\n  7 = Irritant or object\n  8 = Lab\n  9 = Medical graphic\n  10 = Ophthalmic imaging\n  11 = Organism\n  12 = Procedure\n  13 = substance\n",
            "type": "integer"
          },
          "sex": {
            "description": "Sex of the subject in the image. One of: M (Male), F (Female), U (Unknown).\n",
            "type": "string",
            "enum": [
              "M",
              "F",
              "U"
            ]
          }
        },
        "required": [
          "id"
        ],
        "example": {
          "id": 1234,
          "sensitive": true,
          "skinType": 3,
          "bodyLocations": [
            1253,
            1273
          ],
          "type": 1,
          "sex": "M"
        }
      },
      "FindingSummary": {
        "description": "A summary of information about a finding.",
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/ConceptId"
          },
          "classification": {
            "description": "Fully scoped classification of the finding.",
            "type": "string",
            "example": "Distribution:Extensive Rash Pattern:Intertriginous distribution"
          },
          "codes": {
            "$ref": "#/components/schemas/CodeMap"
          }
        }
      },
      "DiagnosisSummary": {
        "description": "A summary of information about a diagnosis.",
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/ConceptId"
          },
          "name": {
            "$ref": "#/components/schemas/ConceptName"
          },
          "summary": {
            "$ref": "#/components/schemas/ConceptSummary"
          },
          "severity": {
            "$ref": "#/components/schemas/DiagnosisSeverity"
          },
          "specialties": {
            "$ref": "#/components/schemas/DiagnosisSpecialties"
          },
          "images": {
            "$ref": "#/components/schemas/DiagnosisImages"
          },
          "ageCategories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AgeCategory"
            }
          }
        },
        "required": [
          "id",
          "name",
          "summary",
          "severity",
          "specialties"
        ]
      },
      "CodeMap": {
        "description": "Lists of external codes keyed by system.",
        "type": "object",
        "additionalProperties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "example": {
          "SNOMEDCT": [
            "SNO123",
            "SNO456"
          ]
        }
      },
      "TextSearch": {
        "type": "object",
        "properties": {
          "searchMatch": {
            "description": "The full text that matches the search term.",
            "type": "string"
          },
          "searchHighlight": {
            "description": "A set of substrings in `searchMatch` that can be used for highlighting.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "searchScore": {
            "description": "A numeric representation of the match.",
            "type": "number"
          }
        }
      },
      "DiagnosisSeverity": {
        "description": "The severity of the condition.",
        "type": "string",
        "enum": [
          "STANDARD",
          "EMERGENCY",
          "LIFE_THREATENING"
        ],
        "example": "STANDARD"
      },
      "DiagnosisSpecialties": {
        "description": "The specialties associated with the diagnosis.",
        "type": "array",
        "items": {
          "type": "integer"
        },
        "example": [
          0,
          2,
          5
        ]
      },
      "DiagnosisImages": {
        "description": "A sample of images of the diagnosis.",
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Image"
        }
      },
      "PageInfo": {
        "description": "Information about a paged response.",
        "type": "object",
        "properties": {
          "totalElements": {
            "description": "The total number of elements.",
            "type": "integer",
            "example": 512
          },
          "totalPages": {
            "description": "The total nubmer of pages.",
            "type": "integer",
            "example": 26
          },
          "number": {
            "description": "The current page number.",
            "type": "integer",
            "example": 1
          },
          "elements": {
            "description": "The current number of elements.",
            "type": "integer",
            "example": 20
          },
          "capacity": {
            "description": "The maximum number of elements in the page.",
            "type": "integer",
            "example": 20
          }
        }
      },
      "DiagnosisWriteup": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/ConceptId"
          },
          "name": {
            "$ref": "#/components/schemas/ConceptName"
          },
          "severity": {
            "$ref": "#/components/schemas/DiagnosisSeverity"
          },
          "authors": {
            "description": "The authors who contributed to the writeup.",
            "type": "string"
          },
          "specialties": {
            "$ref": "#/components/schemas/DiagnosisSpecialties"
          },
          "viewId": {
            "description": "The view ID associated with this diagnosis content",
            "type": "integer"
          },
          "updated": {
            "description": "The date the writeup was last updated.",
            "type": "string",
            "format": "date"
          },
          "images": {
            "$ref": "#/components/schemas/DiagnosisImages"
          },
          "sections": {
            "description": "The text sections of the writeup.",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "description": "The section title.",
                  "type": "string"
                },
                "body": {
                  "description": "The formatted section body.  See \"Text Content\".",
                  "type": "string"
                }
              }
            }
          }
        },
        "required": [
          "id",
          "name",
          "sections",
          "authors",
          "specialties",
          "updated",
          "images"
        ]
      },
      "DiagnosisView": {
        "description": "A view of a diagnosis.",
        "type": "object",
        "properties": {
          "id": {
            "description": "The view identifier.",
            "type": "integer",
            "example": 100
          },
          "name": {
            "description": "The name of the view.",
            "type": "string",
            "example": "Adult"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "Specialty": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 3
          },
          "name": {
            "type": "string",
            "example": "Dermatology"
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "The server could not understand the request due to invalid syntax."
      },
      "Unauthorized": {
        "description": "The client has not specified valid authentication credentials."
      },
      "Forbidden": {
        "description": "The client is not authorized to access the content."
      },
      "NotFound": {
        "description": "The requested resource does not exist."
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "The client muss pass its `access_token` in the authorization header through Bearer HTTP authorization.  Obtain a bearer token using `/auth/token`.\n"
      },
      "BasicAuth": {
        "type": "http",
        "scheme": "basic",
        "description": "The client must pass its **API Key** and **API Secret** in the authorization header through Basic HTTP authorization. The secret is `Basic Base64Encode(key:secret)`."
      }
    }
  }
}