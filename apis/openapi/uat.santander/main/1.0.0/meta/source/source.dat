{
  "openapi": "3.0.3",
  "info": {
    "title": "Evaluacion Crediticia de Riesgos - Modellica",
    "description": "Microservicio que habilita la evaluación Crediticia para la admision de creditos. Ejecuta evaluación en el Motor Modellica.\n",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/MARCOARIASMESIA/evaluacion-crediticia-de-riesgos-modellica/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.uat.santander/originacion",
      "description": "Ambiente UAT"
    },
    {
      "url": "https://api.dev.santander/originacion",
      "description": "Ambiente DEV"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Originacion",
      "description": "Evaluacion Crediticia de Riesgos - Modellica"
    }
  ],
  "paths": {
    "/evaluation": {
      "post": {
        "tags": [
          "Originacion"
        ],
        "summary": "Ejecutar evaluación de Admisión de Crédito",
        "operationId": "executeEvaluation",
        "parameters": [
          {
            "$ref": "#/components/parameters/CorrelationIdHeader"
          },
          {
            "$ref": "#/components/parameters/ChannelHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/evaluationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Evaluación ejecutada correctamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/evaluationResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/evaluation/{solicitudeId}": {
      "get": {
        "tags": [
          "Originacion"
        ],
        "summary": "Consultar evaluación por número de Solicitud",
        "operationId": "getEvaluationBySolicitudeId",
        "parameters": [
          {
            "$ref": "#/components/parameters/CorrelationIdHeader"
          },
          {
            "name": "solicitudeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "9999999999"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Evaluación encontrada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/evaluationResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/evaluation/customer/{documentType}/{documentNumber}": {
      "get": {
        "tags": [
          "Originacion"
        ],
        "summary": "Consultar historial de evaluaciones de un cliente",
        "operationId": "listCustomerEvaluations",
        "parameters": [
          {
            "$ref": "#/components/parameters/CorrelationIdHeader"
          },
          {
            "name": "documentType",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "DNI"
            }
          },
          {
            "$ref": "#/components/parameters/CorrelationIdHeader"
          },
          {
            "name": "documentNumber",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "12345678"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de evaluaciones",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/evaluationResponse"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "CorrelationIdHeader": {
        "name": "x-correlation-id",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string"
        },
        "description": "Identificador único de trazabilidad por request"
      },
      "ChannelHeader": {
        "name": "x-channel",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string"
        },
        "description": "Canal origen de la invocación"
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Request inválido – Error en los parámetros de entrada o estructura JSON",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "examples": {
              "invalidRequestExample": {
                "value": {
                  "code": "ORI-400",
                  "message": "Parámetros inválidos en la solicitud",
                  "details": "El campo 'xxxxxx' es requerido o tiene un formato incorrecto"
                }
              }
            }
          }
        }
      },
      "Unauthorized": {
        "description": "No autorizado – Token inválido o expirado",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "examples": {
              "unauthorizedExample": {
                "value": {
                  "code": "ORI-401",
                  "message": "No autorizado",
                  "details": "El token JWT es inválido o ha expirado"
                }
              }
            }
          }
        }
      },
      "NotFound": {
        "description": "Recurso no encontrado – No existe información para la solicitud realizada",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "examples": {
              "notFoundExample": {
                "value": {
                  "code": "ORI-404",
                  "message": "Evaluación no encontrada",
                  "details": "No existe información para el solicitudeId proporcionado"
                }
              }
            }
          }
        }
      },
      "InternalError": {
        "description": "Error interno del microservicio",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "examples": {
              "internalErrorExample": {
                "value": {
                  "code": "ORI-500",
                  "message": "Error interno del servicio",
                  "details": "NullPointerException en EvaluacionService"
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "ORI-500"
          },
          "message": {
            "type": "string",
            "example": "Error interno del servicio"
          },
          "details": {
            "type": "string",
            "example": "NullPointerException en EvaluacionService"
          }
        }
      },
      "evaluationRequest": {
        "type": "object",
        "required": [
          "globalParameters",
          "customerData",
          "productData"
        ],
        "properties": {
          "globalParameters": {
            "$ref": "#/components/schemas/globalParameters"
          },
          "customerData": {
            "$ref": "#/components/schemas/customerData"
          },
          "spouseData": {
            "$ref": "#/components/schemas/spouseData"
          },
          "productData": {
            "$ref": "#/components/schemas/productData"
          },
          "campaignData": {
            "$ref": "#/components/schemas/campaignData"
          },
          "channelData": {
            "$ref": "#/components/schemas/channelData"
          },
          "PastDueData": {
            "$ref": "#/components/schemas/PastDueData"
          },
          "screeningData": {
            "$ref": "#/components/schemas/screeningData"
          },
          "rccData": {
            "$ref": "#/components/schemas/rccData"
          },
          "riskData": {
            "$ref": "#/components/schemas/riskData"
          }
        }
      },
      "globalParameters": {
        "type": "object",
        "required": [
          "channel",
          "application",
          "solicitudeType",
          "solicitudeId",
          "evaluationType",
          "callType",
          "processDate"
        ],
        "properties": {
          "channel": {
            "type": "string",
            "example": "Santander_Consumer",
            "description": "canal desde el cual se esta realizando la transaccion"
          },
          "application": {
            "type": "string",
            "example": "Front_Originacion"
          },
          "solicitudeType": {
            "type": "integer",
            "example": 1
          },
          "solicitudeId": {
            "type": "string",
            "example": "9999999999"
          },
          "evaluationType": {
            "type": "integer",
            "example": 1
          },
          "callType": {
            "type": "integer",
            "example": 1
          },
          "processDate": {
            "type": "string",
            "format": "date",
            "example": "2026-02-03"
          }
        }
      },
      "customerData": {
        "type": "object",
        "properties": {
          "documentType": {
            "type": "string",
            "example": "01"
          },
          "documentNumber": {
            "type": "string",
            "example": "71234567"
          },
          "maritalStatus": {
            "type": "integer",
            "example": 1
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date",
            "example": "1990-01-15"
          }
        }
      },
      "spouseData": {
        "type": "object",
        "properties": {
          "documentType": {
            "type": "string",
            "example": "01"
          },
          "documentNumber": {
            "type": "string",
            "example": "1234545"
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "productData": {
        "type": "object",
        "required": [
          "product",
          "amount",
          "term"
        ],
        "properties": {
          "product": {
            "type": "integer",
            "example": 1
          },
          "subProduct": {
            "type": "string",
            "example": "LD-Recurrente"
          },
          "amount": {
            "type": "number",
            "example": 4500
          },
          "term": {
            "type": "integer",
            "example": 60
          },
          "rate": {
            "type": "number",
            "example": 0.25
          },
          "pct": {
            "type": "string",
            "example": "CL3"
          }
        }
      },
      "campaignData": {
        "type": "object",
        "properties": {
          "campaignFlag": {
            "type": "integer",
            "example": 1
          },
          "campaignType": {
            "type": "integer",
            "example": 1
          },
          "campaignName": {
            "type": "string",
            "example": "SSD-NO CLIENTE"
          }
        }
      },
      "channelData": {
        "type": "object",
        "properties": {
          "saleChannel": {
            "type": "integer",
            "example": 2
          },
          "saleType": {
            "type": "integer",
            "example": 1
          },
          "cdr": {
            "type": "integer",
            "example": 530
          },
          "registerPersonRole": {
            "type": "string",
            "example": "Ejecutivo"
          }
        }
      },
      "PastDueData": {
        "type": "object",
        "properties": {
          "currentDaysPastDue": {
            "type": "integer",
            "example": 0
          },
          "currentAmountPastDue": {
            "type": "number",
            "example": 0
          },
          "monthDaysPastDue": {
            "type": "integer",
            "example": 0
          },
          "monthAmountPastDue": {
            "type": "number",
            "example": 0
          }
        }
      },
      "screeningData": {
        "type": "object",
        "properties": {
          "customerReportDate": {
            "type": "string",
            "format": "date"
          },
          "customerReportType": {
            "type": "string",
            "example": "BASE NEGATIVA"
          },
          "customerReportRelationship": {
            "type": "string",
            "example": "Titular"
          },
          "customerReportReason": {
            "type": "string",
            "example": "(CRD) ALTO RIESGO MES"
          },
          "spouseReportDate": {
            "type": "string",
            "format": "date",
            "example": "2026-01-20"
          },
          "spouseReportType": {
            "type": "string",
            "example": "RESTRICTIVA"
          },
          "spouseReportRelationship": {
            "type": "string",
            "example": "Madre"
          },
          "spouseReportReason": {
            "type": "string",
            "example": "PEP"
          }
        }
      },
      "rccData": {
        "type": "object",
        "properties": {
          "lastMonthNormalAmount": {
            "type": "number"
          },
          "lastMonthCppAmount": {
            "type": "number"
          },
          "lastMonthSubstandardAmount": {
            "type": "number"
          },
          "lastMonthDoubtfulAmount": {
            "type": "number"
          },
          "lastMonthLossAmount": {
            "type": "number"
          },
          "lastMonthPastDueAmount": {
            "type": "number"
          },
          "lastMonthNormalPercentage": {
            "type": "number"
          },
          "lastMonthCppPercentage": {
            "type": "number"
          },
          "lastMonthSubstandardPercentage": {
            "type": "number"
          },
          "lastMonthDoubtfulPercentage": {
            "type": "number"
          },
          "lastMonthLossPercentage": {
            "type": "number"
          },
          "lastMonthPastDuePercentage": {
            "type": "number"
          },
          "lastMonthEntitiesCount": {
            "type": "integer"
          }
        }
      },
      "riskData": {
        "type": "object",
        "properties": {
          "bureauScore": {
            "type": "integer"
          },
          "relatedEntitiesCount": {
            "type": "integer"
          },
          "score1": {
            "type": "integer"
          },
          "score2": {
            "type": "integer"
          },
          "score3": {
            "type": "integer"
          },
          "score4": {
            "type": "integer"
          },
          "ratio1": {
            "type": "number"
          },
          "ratio2": {
            "type": "number"
          },
          "ratio3": {
            "type": "number"
          },
          "ratio4": {
            "type": "number"
          },
          "amount1": {
            "type": "integer"
          },
          "amount2": {
            "type": "integer"
          },
          "amount3": {
            "type": "integer"
          },
          "amount4": {
            "type": "integer"
          },
          "flag1": {
            "type": "integer"
          },
          "flag2": {
            "type": "integer"
          }
        }
      },
      "evaluationResponse": {
        "type": "object",
        "properties": {
          "globalParameters": {
            "$ref": "#/components/schemas/globalParameters"
          },
          "customerData": {
            "$ref": "#/components/schemas/customerDataResponse"
          },
          "creditDecision": {
            "$ref": "#/components/schemas/creditDecision"
          },
          "evaluationResult": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/evaluationResult"
            }
          }
        }
      },
      "customerDataResponse": {
        "type": "object",
        "properties": {
          "documentType": {
            "type": "string",
            "example": "01"
          },
          "documentNumber": {
            "type": "string",
            "example": "12345678"
          }
        }
      },
      "creditDecision": {
        "type": "object",
        "properties": {
          "decisionDetail": {
            "type": "string",
            "example": "APROBADO"
          },
          "concessionsDesk": {
            "type": "integer"
          },
          "autonomyLevel": {
            "type": "integer"
          },
          "requiredAutonomyLevel": {
            "type": "string"
          },
          "policy": {
            "type": "string"
          },
          "pilot": {
            "type": "string"
          },
          "flow": {
            "type": "string"
          }
        }
      },
      "evaluationResult": {
        "type": "object",
        "properties": {
          "indicatorCode": {
            "type": "string",
            "example": "S1"
          },
          "indicatorResult": {
            "type": "string",
            "example": "R"
          },
          "indicatorName": {
            "type": "string",
            "example": "Mora"
          },
          "reasons": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/evaluationReason"
            }
          }
        }
      },
      "evaluationReason": {
        "type": "object",
        "properties": {
          "reasonCode": {
            "type": "string",
            "example": "PB2"
          },
          "reasonDetail": {
            "type": "string",
            "example": "Mora en el mes"
          },
          "reasonValue": {
            "type": "string",
            "example": "15"
          }
        }
      }
    }
  }
}
