        ],
        "summary": "public/partial-auth0",
        "description": "public/partial-auth0",
        "operationId": "publicPartialAuth0",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "acceptTerms": {
                    "type": "boolean",
                    "example": true
                  },
                  "email": {
                    "type": "string",
