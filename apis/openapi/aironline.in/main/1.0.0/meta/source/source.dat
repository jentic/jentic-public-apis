                  },
                  "firstName": {
                    "type": "string",
                    "example": "angira"
                  },
                  "fullName": {
                    "type": "string",
                    "example": "angira n gaupale"
                  },
                  "lastName": {
                    "type": "string",
                    "example": "gaupale"
                  },
                  "middleName": {
                    "type": "string",
                    "example": ""
                  },
                  "mobilePhoneCountryCode": {
                    "type": "string",
                    "example": "+91"
                  },
                  "mobilePhoneNumber": {
                    "type": "string",
                    "example": "9922350092"
                  },
                  "password": {
                    "type": "string",
                    "example": "angira123"
                  },
                  "rePassword": {
                    "type": "string",
                    "example": "angira123"
                  },
                  "username": {
                    "type": "string",
                    "example": "angira123"
                  }
                }
              },
              "examples": {
                "public/partial-auth0": {
                  "value": {
                    "acceptTerms": true,
                    "email": "angira@gmail.com",
                    "firstName": "angira",
                    "fullName": "angira n gaupale",
                    "lastName": "gaupale",
                    "middleName": "",
                    "mobilePhoneCountryCode": "+91",
                    "mobilePhoneNumber": "9922350092",
                    "password": "angira123",
                    "rePassword": "angira123",
                    "username": "angira123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        }
