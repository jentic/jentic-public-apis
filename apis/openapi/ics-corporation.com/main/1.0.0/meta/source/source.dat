{
  "openapi": "3.0.3",
  "info": {
    "title": "CSI Corporation API",
    "version": "1.0.0",
    "description": "Standalone OpenAPI spec for the Express API.",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/icscorporation/ICS-Corporation-API/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.ics-corporation.com/",
      "description": "Production environment API"
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-KEY",
        "description": "API key for authentication"
      }
    },
    "schemas": {
      "DataRecord": {
        "type": "object",
        "properties": {
          "from": {
            "required": [
              "address_line_1",
              "city",
              "state",
              "zip_code"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Recipient or sender name",
                "maxLength": 40,
                "example": "John Doe"
              },
              "company": {
                "type": "string",
                "description": "Company name",
                "maxLength": 40,
                "example": "Acme Corporation"
              },
              "address_line_1": {
                "type": "string",
                "description": "Primary street address",
                "maxLength": 64,
                "example": "123 Main St"
              },
              "address_line_2": {
                "type": "string",
                "description": "Secondary address information (suite, apt, etc.)",
                "maxLength": 64,
                "example": "Suite 200"
              },
              "city": {
                "type": "string",
                "description": "City name",
                "maxLength": 28,
                "example": "Springfield"
              },
              "state": {
                "type": "string",
                "description": "Two-letter state code",
                "pattern": "^[A-Z]{2}$",
                "example": "IL"
              },
              "zip_code": {
                "type": "string",
                "description": "5-digit or 9-digit ZIP code (ZIP+4)",
                "pattern": "^\\d{5}(-\\d{4})?$",
                "example": "62701-1234"
              }
            }
          },
          "to": {
            "required": [
              "address_line_1",
              "city",
              "state",
              "zip_code"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Recipient or sender name",
                "maxLength": 40,
                "example": "John Doe"
              },
              "company": {
                "type": "string",
                "description": "Company name",
                "maxLength": 40,
                "example": "Acme Corporation"
              },
              "address_line_1": {
                "type": "string",
                "description": "Primary street address",
                "maxLength": 64,
                "example": "123 Main St"
              },
              "address_line_2": {
                "type": "string",
                "description": "Secondary address information (suite, apt, etc.)",
                "maxLength": 64,
                "example": "Suite 200"
              },
              "city": {
                "type": "string",
                "description": "City name",
                "maxLength": 28,
                "example": "Springfield"
              },
              "state": {
                "type": "string",
                "description": "Two-letter state code",
                "pattern": "^[A-Z]{2}$",
                "example": "IL"
              },
              "zip_code": {
                "type": "string",
                "description": "5-digit or 9-digit ZIP code (ZIP+4)",
                "pattern": "^\\d{5}(-\\d{4})?$",
                "example": "62701-1234"
              }
            }
          },
          "merge_variables": {
            "type": "object",
            "description": "Dynamic key-value pairs for personalization.",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "example": {
              "promo_code": "SAVE2026",
              "is_member": true
            }
          },
          "metadata": {
            "type": "object",
            "description": "Internal tracking data (not for print).",
            "additionalProperties": {
              "type": "string"
            },
            "example": {
              "campaign_id": "spring_2026",
              "source_system": "salesforce"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/v1.1/": {
      "post": {
        "summary": "Create a record",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DataRecord"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DataRecord"
                }
              }
            }
          },
          "400": {
            "description": "Missing or invalid parameters"
          },
          "401": {
            "description": "Invalid API key"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/v1.1/{id}": {
      "get": {
        "summary": "Fetch a record by ID",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DataRecord"
                }
              }
            }
          },
          "400": {
            "description": "Missing parameters"
          },
          "401": {
            "description": "Invalid API key"
          },
          "404": {
            "description": "Not found"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    }
  }
}
