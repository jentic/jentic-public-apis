{
  "openapi": "3.1.0",
  "info": {
    "title": "ContactLint API",
    "version": "1.0.0",
    "description": "Email and phone validation API.",
    "x-jentic-source-url": "https://contactlint.com/openapi.json"
  },
  "servers": [
    {
      "url": "https://contactlint.com"
    }
  ],
  "paths": {
    "/v1/email/validate": {
      "post": {
        "summary": "Validate an email address",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email"
                ],
                "properties": {
                  "email": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "$ref": "#/components/schemas/EmailResult"
                    },
                    "usage": {
                      "$ref": "#/components/schemas/Usage"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Bad key"
          },
          "402": {
            "description": "Quota exceeded"
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    },
    "/v1/email/validate/batch": {
      "post": {
        "summary": "Validate up to 50 email addresses in one request. Billed per address; counts as one request toward the rate limit. Fails with 402 and charges nothing if the key lacks checks for the whole batch.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "emails"
                ],
                "properties": {
                  "emails": {
                    "type": "array",
                    "maxItems": 50,
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "One result per address, in order",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/EmailResult"
                      }
                    },
                    "summary": {
                      "type": "object"
                    },
                    "usage": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad input or more than 50 emails"
          },
          "401": {
            "description": "Bad key"
          },
          "402": {
            "description": "Not enough checks for the batch"
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    },
    "/v1/phone/validate": {
      "post": {
        "summary": "Validate a phone number",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "phone"
                ],
                "properties": {
                  "phone": {
                    "type": "string"
                  },
                  "country": {
                    "type": "string"
                  },
                  "carrier_lookup": {
                    "type": "boolean",
                    "description": "Paid tier, currently disabled"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "$ref": "#/components/schemas/PhoneResult"
                    },
                    "usage": {
                      "$ref": "#/components/schemas/Usage"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Bad key"
          },
          "402": {
            "description": "Quota exceeded"
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    },
    "/v1/usage": {
      "get": {
        "summary": "Usage and credit balance",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/account/export": {
      "get": {
        "summary": "Download everything stored for your key as JSON: key details, usage by month, credit ledger, auto-reload, publishable keys and referrals",
        "responses": {
          "200": {
            "description": "Export"
          }
        }
      }
    },
    "/v1/account": {
      "delete": {
        "summary": "Permanently delete your key and its data. Send {\"confirm\": \"<your key prefix>\"}. Unused credits are lost; payment records are kept.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "confirm"
                ],
                "properties": {
                  "confirm": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Deleted"
          },
          "400": {
            "description": "Confirmation missing"
          }
        }
      }
    },
    "/mcp": {
      "post": {
        "summary": "MCP streamable HTTP endpoint (JSON-RPC 2.0). Tools: validate_email, validate_emails (up to 50 per call), validate_phone",
        "responses": {
          "200": {
            "description": "JSON-RPC response"
          }
        }
      }
    },
    "/signup": {
      "post": {
        "summary": "Create an API key (email required, shown once)",
        "security": [],
        "responses": {
          "201": {
            "description": "Key created, shown once"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      },
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      }
    },
    "schemas": {
      "Usage": {
        "type": "object",
        "properties": {
          "billed_as": {
            "enum": [
              "free",
              "credit",
              "not_billed"
            ],
            "description": "not_billed: the DNS lookup failed (reason dns_error), so the check was given back. This covers unknown results and risky results flagged only by local checks."
          },
          "free_used_this_month": {
            "type": "integer"
          },
          "free_limit": {
            "type": "integer"
          },
          "credits_remaining": {
            "type": "integer"
          }
        }
      },
      "EmailResult": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string"
          },
          "syntax_valid": {
            "type": "boolean"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "not_a_string",
              "too_long",
              "missing_at_or_local",
              "local_too_long",
              "invalid_local_part",
              "invalid_domain",
              "numeric_tld",
              "no_mx_or_a",
              "dns_error",
              "possible_typo",
              "disposable",
              "role_address",
              null
            ],
            "description": "Why the verdict is not valid. Null when the verdict is valid. Invalid: a syntax reason (not_a_string, too_long, missing_at_or_local, local_too_long, invalid_local_part, invalid_domain, numeric_tld) or no_mx_or_a. Unknown: dns_error. Risky: possible_typo, disposable or role_address. When several risky signals apply, precedence is possible_typo, then disposable, then role_address; the disposable, role_address and did_you_mean fields still show every signal. A failed DNS lookup keeps reason dns_error even when local checks make the verdict risky."
          },
          "domain": {
            "type": [
              "string",
              "null"
            ]
          },
          "disposable": {
            "type": "boolean"
          },
          "role_address": {
            "type": "boolean"
          },
          "did_you_mean": {
            "type": [
              "string",
              "null"
            ],
            "description": "Suggested correction when the domain looks like a typo of a major provider (for example gmial.com). The verdict is risky with reason possible_typo."
          },
          "free_provider": {
            "type": "boolean"
          },
          "mx_found": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "a_found": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "mx_records": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "deliverable_domain": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "verdict": {
            "enum": [
              "valid",
              "risky",
              "invalid",
              "unknown"
            ]
          }
        }
      },
      "PhoneResult": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string"
          },
          "parsed": {
            "type": "boolean"
          },
          "valid": {
            "type": "boolean"
          },
          "possible": {
            "type": "boolean"
          },
          "type": {
            "type": [
              "string",
              "null"
            ]
          },
          "region": {
            "type": [
              "string",
              "null"
            ]
          },
          "country_calling_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "e164": {
            "type": [
              "string",
              "null"
            ]
          },
          "national": {
            "type": [
              "string",
              "null"
            ]
          },
          "international": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "bearer": []
    },
    {
      "apiKey": []
    }
  ]
}