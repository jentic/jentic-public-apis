{
  "openapi": "3.1.0",
  "info": {
    "title": "Santa's Surprise Backend API",
    "description": "Backend API for Toy Kingdom's Santa's Surprise AR Game.\n\nThis API handles game sessions, prize distribution, and voucher management for the holiday promotion.\n\n**Features:**\n- Device-based play tracking (no upfront registration)\n- Weighted random prize distribution\n- Time-based and region-based prize restrictions\n- Daily limits and abuse prevention\n- On-demand registration for grand prize (5K Shopping Spree)\n- Explicit no-prize fallback for non-winning rounds\n- Shared API key protection for all routes\n\n**Base URL:** Set this to your deployed Functions URL after deployment.\n\n**Authentication:** All routes require the shared API key from Firestore.\n",
    "version": "1.0.0",
    "contact": {
      "name": "Toy Kingdom",
      "email": "support@toykingdom.com"
    },
    "license": {
      "name": "Proprietary"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/ABELBESAS29/tk-summer-pop/1.0.0"
  },
  "servers": [
    {
      "url": "https://api-eu5ad5gvfa-uc.a.run.app",
      "description": "Relative server URL. Replace with your deployed API base URL when publishing docs."
    }
  ],
  "tags": [
    {
      "name": "Branches",
      "description": "Branch location and information"
    },
    {
      "name": "Game",
      "description": "Game session and prize distribution"
    },
    {
      "name": "Prizes",
      "description": "Prize information and validation"
    }
  ],
  "paths": {
    "/api/branches": {
      "get": {
        "tags": [
          "Branches"
        ],
        "summary": "Get all branches",
        "description": "Returns a list of all Toy Kingdom branches with their locations and regions",
        "operationId": "getBranches",
        "responses": {
          "200": {
            "description": "Branches fetched successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "branches": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Branch"
                          }
                        },
                        "count": {
                          "type": "integer",
                          "example": 103
                        }
                      }
                    },
                    "message": {
                      "type": "string",
                      "example": "Branches fetched successfully"
                    }
                  }
                },
                "examples": {
                  "success": {
                    "value": {
                      "success": true,
                      "data": {
                        "branches": [
                          {
                            "branchId": "tk-fairview",
                            "name": "TK - Fairview",
                            "location": "Fairview",
                            "region": "NCR2",
                            "brand": "Toy Kingdom"
                          },
                          {
                            "branchId": "tk-megamall",
                            "name": "TK - Megamall",
                            "location": "Megamall",
                            "region": "NCR2",
                            "brand": "Toy Kingdom"
                          }
                        ],
                        "count": 103
                      },
                      "message": "Branches fetched successfully"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/game/start": {
      "post": {
        "tags": [
          "Game"
        ],
        "summary": "Start a new game session",
        "description": "Initiates a new game session for a device at a specific branch.\n\n**Device Limits:**\n- Maximum 2 plays per device per day (configurable)\n- After exceeding the daily limit, users can still play but those rounds are no longer prize-eligible\n- Hourly limit checking is currently disabled\n\n**Rate Limiting Behavior:**\n- Users who exceed daily limits receive `isRateLimited: true` in response\n- Rate-limited rounds resolve to the fallback `No Prize` outcome\n- This allows continuous play while protecting the actual prize inventory\n\nReturns a session ID to be used for completing the game.\n",
        "operationId": "startGame",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "deviceId",
                  "branchId"
                ],
                "properties": {
                  "deviceId": {
                    "type": "string",
                    "description": "Unique device identifier (generated by Unity)",
                    "example": "device_abc123xyz789"
                  },
                  "branchId": {
                    "type": "string",
                    "description": "Branch ID where the user is playing",
                    "example": "tk-fairview"
                  },
                  "deviceInfo": {
                    "type": "object",
                    "description": "Optional device metadata",
                    "properties": {
                      "platform": {
                        "type": "string",
                        "example": "WebGL"
                      },
                      "screenResolution": {
                        "type": "string",
                        "example": "1920x1080"
                      }
                    }
                  }
                }
              },
              "examples": {
                "standard": {
                  "value": {
                    "deviceId": "device_abc123xyz789",
                    "branchId": "tk-fairview",
                    "deviceInfo": {
                      "platform": "WebGL",
                      "screenResolution": "1920x1080"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Game session started successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "sessionId": {
                          "type": "string",
                          "example": "session_abc123"
                        },
                        "status": {
                          "type": "string",
                          "example": "in_progress"
                        },
                        "startedAt": {
                          "type": "string",
                          "format": "date-time",
                          "example": "2025-11-12T10:30:00Z"
                        },
                        "isRateLimited": {
                          "type": "boolean",
                          "description": "True if user exceeded daily limit and this session is not prize-eligible",
                          "example": false
                        }
                      }
                    },
                    "message": {
                      "type": "string",
                      "description": "Optional message (present when rate limited)",
                      "example": null
                    }
                  }
                },
                "examples": {
                  "normalPlay": {
                    "summary": "Normal Play (Within Limits)",
                    "value": {
                      "success": true,
                      "data": {
                        "sessionId": "session_1731408600123_abc123xyz",
                        "status": "in_progress",
                        "startedAt": "2025-11-12T10:30:00Z",
                        "isRateLimited": false
                      }
                    }
                  },
                  "rateLimited": {
                    "summary": "Rate Limited Play",
                    "value": {
                      "success": true,
                      "data": {
                        "sessionId": "session_1731408600123_abc123xyz",
                        "status": "in_progress",
                        "startedAt": "2025-11-12T10:30:00Z",
                        "isRateLimited": true
                      },
                      "message": "You've reached your daily play limit (2 plays). You can still play, but additional rounds are no longer eligible for prizes today."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/game/complete": {
      "post": {
        "tags": [
          "Game"
        ],
        "summary": "Complete game and assign prize",
        "description": "Completes a game session and assigns a prize based on weighted random selection.\n\n**Prize Assignment Logic:**\n- Weighted random selection (higher priority = more likely)\n- Filters prizes based on: time limits, region restrictions, daily limits, per-branch limits, per-device limits\n- **Rate-limited users:** Only eligible for the fallback `No Prize` outcome\n- **Non-rate-limited users:** Eligible for all currently available prizes, with `\u20b15,000 Shopping Spree` as the rarest outcome\n\n**Response varies by context:**\n- **Instant-win prizes:** Voucher code provided immediately, no registration required\n- **5K Shopping Spree:** requiresRegistration=true, must call /api/game/register-winner\n- **No Prize:** No voucher returned\n",
        "operationId": "completeGame",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "sessionId",
                  "deviceId"
                ],
                "properties": {
                  "sessionId": {
                    "type": "string",
                    "description": "Session ID from /api/game/start",
                    "example": "session_1731408600123_abc123xyz"
                  },
                  "deviceId": {
                    "type": "string",
                    "description": "Device ID (must match the one used in start)",
                    "example": "device_abc123xyz789"
                  },
                  "score": {
                    "type": "integer",
                    "description": "Optional game score",
                    "example": 2000
                  }
                }
              },
              "examples": {
                "withScore": {
                  "value": {
                    "sessionId": "session_1731408600123_abc123xyz",
                    "deviceId": "device_abc123xyz789",
                    "score": 2000
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Game completed and prize assigned",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "sessionId": {
                          "type": "string",
                          "example": "session_1731408600123_abc123xyz"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "completed",
                            "pending_registration"
                          ],
                          "example": "completed"
                        },
                        "prize": {
                          "type": "object",
                          "properties": {
                            "prizeId": {
                              "type": "string",
                              "example": "prize-blind-box"
                            },
                            "name": {
                              "type": "string",
                              "example": "Blind Box"
                            },
                            "description": {
                              "type": "string",
                              "example": "Congratulations! You've won a Blind Box prize from the promo."
                            },
                            "category": {
                              "type": "string",
                              "enum": [
                                "grand",
                                "toy",
                                "none",
                                "discount",
                                "sticker",
                                "tickets"
                              ],
                              "example": "toy"
                            },
                            "type": {
                              "type": "string",
                              "enum": [
                                "limited",
                                "consolation",
                                "none"
                              ],
                              "example": "limited"
                            },
                            "imageUrl": {
                              "type": "string",
                              "example": "https://example.com/blind-box.jpg"
                            }
                          }
                        },
                        "requiresRegistration": {
                          "type": "boolean",
                          "description": "If true, user must call /api/game/register-winner",
                          "example": false
                        },
                        "isRateLimited": {
                          "type": "boolean",
                          "description": "If true, the session was rate limited",
                          "example": false
                        },
                        "voucher": {
                          "type": "object",
                          "nullable": true,
                          "description": "Present only for instant-win prizes that do not require registration",
                          "properties": {
                            "code": {
                              "type": "string",
                              "example": "SANTA-BBX-ABC123XY"
                            },
                            "expiresAt": {
                              "type": "string",
                              "format": "date-time",
                              "example": "2026-02-15T23:59:59Z"
                            },
                            "status": {
                              "type": "string",
                              "example": "active"
                            }
                          }
                        }
                      }
                    },
                    "message": {
                      "type": "string",
                      "example": "Congratulations! You won a prize!"
                    }
                  }
                },
                "examples": {
                  "instantWinPrize": {
                    "summary": "Instant-Win Prize",
                    "value": {
                      "success": true,
                      "data": {
                        "sessionId": "session_1731408600123_abc123xyz",
                        "status": "completed",
                        "prize": {
                          "prizeId": "prize-blind-box",
                          "name": "Blind Box",
                          "description": "Congratulations! You've won a Blind Box prize from the promo.",
                          "category": "toy",
                          "type": "limited",
                          "imageUrl": "https://example.com/blind-box.jpg"
                        },
                        "requiresRegistration": false,
                        "isRateLimited": false,
                        "voucher": {
                          "code": "SANTA-BBX-ABC123XY",
                          "expiresAt": "2026-02-15T23:59:59.000Z",
                          "status": "active"
                        }
                      },
                      "message": "Congratulations! You won a prize!"
                    }
                  },
                  "grandPrize": {
                    "summary": "Grand Prize (Requires Registration)",
                    "value": {
                      "success": true,
                      "data": {
                        "sessionId": "session_1731408600123_abc123xyz",
                        "status": "pending_registration",
                        "prize": {
                          "prizeId": "prize-5k-shopping-spree",
                          "name": "\u20b15,000 Shopping Spree",
                          "description": "Congratulations! You've won a \u20b15,000 Shopping Spree at Toy Kingdom. Please complete registration so our team can coordinate prize claiming.",
                          "category": "grand",
                          "type": "limited",
                          "imageUrl": "https://example.com/5k-prize.jpg"
                        },
                        "requiresRegistration": true,
                        "isRateLimited": false,
                        "voucher": null
                      },
                      "message": "Congratulations! Please provide your details to claim this prize."
                    }
                  },
                  "noPrize": {
                    "summary": "No Prize Outcome",
                    "value": {
                      "success": true,
                      "data": {
                        "sessionId": "session_1731408600123_abc123xyz",
                        "status": "completed",
                        "prize": {
                          "prizeId": "prize-no-win",
                          "name": "No Prize",
                          "description": "Thanks for playing. This round did not win a prize.",
                          "category": "none",
                          "type": "none",
                          "imageUrl": "https://example.com/no-prize.jpg"
                        },
                        "requiresRegistration": false,
                        "isRateLimited": false,
                        "voucher": null
                      },
                      "message": "Thanks for playing! Better luck next time."
                    }
                  },
                  "rateLimitedNoPrize": {
                    "summary": "Rate-Limited No Prize Outcome",
                    "value": {
                      "success": true,
                      "data": {
                        "sessionId": "session_1731408600123_abc123xyz",
                        "status": "completed",
                        "prize": {
                          "prizeId": "prize-no-win",
                          "name": "No Prize",
                          "description": "Thanks for playing. This round did not win a prize.",
                          "category": "none",
                          "type": "none",
                          "imageUrl": "https://example.com/no-prize.jpg"
                        },
                        "requiresRegistration": false,
                        "isRateLimited": true,
                        "voucher": null
                      },
                      "message": "You've reached the daily play limit for prize-eligible rounds. This play ends without a prize."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "404": {
            "description": "Session not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "sessionNotFound": {
                    "value": {
                      "success": false,
                      "error": {
                        "code": "SESSION_NOT_FOUND",
                        "message": "Game session not found"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/game/register-winner": {
      "post": {
        "tags": [
          "Game"
        ],
        "summary": "Register winner for grand prize",
        "description": "Register user details for the 5K Shopping Spree grand prize.\n\n**Only required when:**\n- /api/game/complete returns requiresRegistration: true\n- User won the \u20b15,000 Shopping Spree\n\n**After registration:**\n- User document created\n- Voucher code generated\n- Prize inventory decremented\n- Toy Kingdom team will contact winner\n",
        "operationId": "registerWinner",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "sessionId",
                  "name",
                  "address",
                  "contactNumber",
                  "email"
                ],
                "properties": {
                  "sessionId": {
                    "type": "string",
                    "description": "Session ID from /api/game/complete",
                    "example": "session_1731408600123_abc123xyz"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 100,
                    "example": "Juan Dela Cruz"
                  },
                  "address": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 500,
                    "example": "123 Main St, Quezon City, Metro Manila"
                  },
                  "contactNumber": {
                    "type": "string",
                    "pattern": "^\\\\+639\\\\d{9}$",
                    "description": "Philippine mobile number format (+639XXXXXXXXX)",
                    "example": "+639171234567"
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "juan.delacruz@example.com"
                  }
                }
              },
              "examples": {
                "complete": {
                  "value": {
                    "sessionId": "session_1731408600123_abc123xyz",
                    "name": "Juan Dela Cruz",
                    "address": "123 Main St, Barangay Santo Domingo, Quezon City, Metro Manila 1100",
                    "contactNumber": "+639171234567",
                    "email": "juan.delacruz@example.com"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Winner registered successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "userId": {
                          "type": "string",
                          "example": "user_1731408700456_xyz789abc"
                        },
                        "sessionId": {
                          "type": "string",
                          "example": "session_1731408600123_abc123xyz"
                        },
                        "prize": {
                          "type": "object",
                          "properties": {
                            "name": {
                              "type": "string",
                              "example": "\u20b15,000 Shopping Spree"
                            },
                            "description": {
                              "type": "string",
                              "example": "Grand prize shopping spree at Toy Kingdom"
                            }
                          }
                        },
                        "voucher": {
                          "type": "object",
                          "properties": {
                            "code": {
                              "type": "string",
                              "example": "SANTA-5K-ABC123XY"
                            },
                            "expiresAt": {
                              "type": "string",
                              "format": "date-time",
                              "example": "2025-12-31T23:59:59.000Z"
                            },
                            "status": {
                              "type": "string",
                              "example": "active"
                            }
                          }
                        }
                      }
                    },
                    "message": {
                      "type": "string",
                      "example": "Registration successful! You will be contacted by our team."
                    }
                  }
                },
                "examples": {
                  "success": {
                    "value": {
                      "success": true,
                      "data": {
                        "userId": "user_1731408700456_xyz789abc",
                        "sessionId": "session_1731408600123_abc123xyz",
                        "prize": {
                          "name": "\u20b15,000 Shopping Spree",
                          "description": "Grand prize shopping spree at Toy Kingdom"
                        },
                        "voucher": {
                          "code": "SANTA-5K-ABC123XY",
                          "expiresAt": "2025-12-31T23:59:59.000Z",
                          "status": "active"
                        }
                      },
                      "message": "Registration successful! You will be contacted by our team."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "404": {
            "description": "Session not found or not eligible for registration",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "sessionNotFound": {
                    "value": {
                      "success": false,
                      "error": {
                        "code": "SESSION_NOT_FOUND",
                        "message": "Game session not found or already registered"
                      }
                    }
                  },
                  "registrationNotRequired": {
                    "value": {
                      "success": false,
                      "error": {
                        "code": "REGISTRATION_NOT_REQUIRED",
                        "message": "This prize does not require registration"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/prize/{prizeId}": {
      "get": {
        "tags": [
          "Prizes"
        ],
        "summary": "Get prize details",
        "description": "Returns detailed information about a specific prize, including availability and restrictions",
        "operationId": "getPrize",
        "parameters": [
          {
            "name": "prizeId",
            "in": "path",
            "required": true,
            "description": "Unique prize identifier",
            "schema": {
              "type": "string"
            },
            "example": "prize-5k-shopping-spree"
          }
        ],
        "responses": {
          "200": {
            "description": "Prize details fetched successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "prize": {
                          "$ref": "#/components/schemas/Prize"
                        }
                      }
                    },
                    "message": {
                      "type": "string",
                      "example": "Prize details fetched successfully"
                    }
                  }
                },
                "examples": {
                  "grandPrize": {
                    "summary": "5K Shopping Spree",
                    "value": {
                      "success": true,
                      "data": {
                        "prize": {
                          "prizeId": "prize-5k-shopping-spree",
                          "name": "\u20b15,000 Shopping Spree",
                          "description": "Congratulations! You've won a \u20b15,000 Shopping Spree at Toy Kingdom. Please complete registration so our team can coordinate prize claiming.",
                          "type": "limited",
                          "category": "grand",
                          "imageUrl": "https://example.com/5k-prize.jpg",
                          "value": "\u20b15,000 Shopping Spree",
                          "limits": {
                            "perBranch": -1,
                            "total": 10,
                            "perUser": 1,
                            "perDay": null
                          },
                          "distributed": {
                            "total": 0,
                            "perBranch": {}
                          },
                          "active": true,
                          "validUntil": null,
                          "allowedRegions": null
                        }
                      }
                    }
                  },
                  "ncrPrize": {
                    "summary": "Blind Box",
                    "value": {
                      "success": true,
                      "data": {
                        "prize": {
                          "prizeId": "prize-blind-box",
                          "name": "Blind Box",
                          "description": "Congratulations! You've won a Blind Box prize from the promo.",
                          "type": "limited",
                          "category": "toy",
                          "imageUrl": "https://example.com/blind-box.jpg",
                          "value": "Blind Box",
                          "limits": {
                            "perBranch": -1,
                            "total": 40,
                            "perUser": 1,
                            "perDay": null
                          },
                          "distributed": {
                            "total": 12,
                            "perBranch": {
                              "tk-fairview": 2,
                              "tk-megamall": 1
                            }
                          },
                          "active": true,
                          "validUntil": null,
                          "allowedRegions": [
                            "NCR1",
                            "NCR2",
                            "NCR3"
                          ]
                        }
                      }
                    }
                  },
                  "noPrize": {
                    "summary": "Fallback No Prize Record",
                    "value": {
                      "success": true,
                      "data": {
                        "prize": {
                          "prizeId": "prize-no-win",
                          "name": "No Prize",
                          "description": "Thanks for playing. This round did not win a prize.",
                          "type": "none",
                          "category": "none",
                          "imageUrl": "https://example.com/no-prize.jpg",
                          "value": "No prize",
                          "limits": {
                            "perBranch": -1,
                            "total": -1,
                            "perUser": -1,
                            "perDay": null
                          },
                          "distributed": {
                            "total": 150,
                            "perBranch": {
                              "tk-fairview": 18,
                              "tk-megamall": 12
                            }
                          },
                          "active": true,
                          "validUntil": null,
                          "allowedRegions": null
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Prize not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "notFound": {
                    "value": {
                      "success": false,
                      "error": {
                        "code": "PRIZE_NOT_FOUND",
                        "message": "Prize not found"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/voucher/validate": {
      "get": {
        "tags": [
          "Prizes"
        ],
        "summary": "Validate a voucher code",
        "description": "Validates a voucher code and returns its details.\n\nUsed by:\n- Store staff to verify voucher authenticity before redemption\n- Users to check voucher status\n\n**Note:** This only validates. Actual redemption is done via admin API.\n",
        "operationId": "validateVoucher",
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "required": true,
            "description": "Voucher code to validate",
            "schema": {
              "type": "string"
            },
            "example": "SANTA-BBX-ABC123XY"
          }
        ],
        "responses": {
          "200": {
            "description": "Voucher validated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "voucher": {
                          "type": "object",
                          "properties": {
                            "voucherCode": {
                              "type": "string",
                              "example": "SANTA-BBX-ABC123XY"
                            },
                            "prizeId": {
                              "type": "string",
                              "example": "prize-blind-box"
                            },
                            "prizeName": {
                              "type": "string",
                              "example": "Blind Box"
                            },
                            "status": {
                              "type": "string",
                              "enum": [
                                "active",
                                "pending",
                                "contacted",
                                "redeemed",
                                "expired"
                              ],
                              "example": "active"
                            },
                            "branchId": {
                              "type": "string",
                              "example": "tk-fairview"
                            },
                            "createdAt": {
                              "type": "string",
                              "format": "date-time",
                              "example": "2025-11-12T10:35:00.000Z"
                            },
                            "expiresAt": {
                              "type": "string",
                              "format": "date-time",
                              "example": "2026-02-15T23:59:59.000Z"
                            },
                            "redeemedAt": {
                              "type": "string",
                              "format": "date-time",
                              "nullable": true,
                              "example": null
                            }
                          }
                        }
                      }
                    },
                    "message": {
                      "type": "string",
                      "example": "Voucher is valid"
                    }
                  }
                },
                "examples": {
                  "validVoucher": {
                    "summary": "Valid Active Voucher",
                    "value": {
                      "success": true,
                      "data": {
                        "voucher": {
                          "voucherCode": "SANTA-BBX-ABC123XY",
                          "prizeId": "prize-blind-box",
                          "prizeName": "Blind Box",
                          "status": "active",
                          "branchId": "tk-fairview",
                          "createdAt": "2025-11-12T10:35:00.000Z",
                          "expiresAt": "2026-02-15T23:59:59.000Z",
                          "redeemedAt": null
                        }
                      },
                      "message": "Voucher is valid"
                    }
                  },
                  "redeemedVoucher": {
                    "summary": "Already Redeemed",
                    "value": {
                      "success": true,
                      "data": {
                        "voucher": {
                          "voucherCode": "SANTA-BBX-ABC123XY",
                          "prizeId": "prize-blind-box",
                          "prizeName": "Blind Box",
                          "status": "redeemed",
                          "branchId": "tk-fairview",
                          "createdAt": "2025-11-12T10:35:00.000Z",
                          "expiresAt": "2026-02-15T23:59:59.000Z",
                          "redeemedAt": "2025-11-15T14:20:00.000Z"
                        }
                      },
                      "message": "Voucher has already been redeemed"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "missingCode": {
                    "value": {
                      "success": false,
                      "error": {
                        "code": "VALIDATION_ERROR",
                        "message": "Voucher code is required"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Voucher not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "notFound": {
                    "value": {
                      "success": false,
                      "error": {
                        "code": "VOUCHER_NOT_FOUND",
                        "message": "Voucher not found"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Branch": {
        "type": "object",
        "properties": {
          "branchId": {
            "type": "string",
            "example": "tk-fairview"
          },
          "name": {
            "type": "string",
            "example": "TK - Fairview"
          },
          "location": {
            "type": "string",
            "example": "Fairview"
          },
          "region": {
            "type": "string",
            "description": "Region code (NCR1, NCR2, NCR3, Luzon, Visayas, Mindanao)",
            "example": "NCR2"
          },
          "brand": {
            "type": "string",
            "description": "Brand name (Toy Kingdom, Toy Kingdom Xpress, Toys R Us)",
            "example": "Toy Kingdom"
          }
        }
      },
      "Prize": {
        "type": "object",
        "properties": {
          "prizeId": {
            "type": "string",
            "example": "prize-5k-shopping-spree"
          },
          "name": {
            "type": "string",
            "example": "\u20b15,000 Shopping Spree"
          },
          "description": {
            "type": "string",
            "example": "Grand prize shopping spree at Toy Kingdom"
          },
          "type": {
            "type": "string",
            "enum": [
              "limited",
              "consolation",
              "none"
            ],
            "example": "limited"
          },
          "category": {
            "type": "string",
            "enum": [
              "grand",
              "toy",
              "none",
              "discount",
              "sticker",
              "tickets"
            ],
            "example": "grand"
          },
          "imageUrl": {
            "type": "string",
            "example": "https://example.com/prize.jpg"
          },
          "value": {
            "type": "string",
            "description": "Prize label or value shown to the user",
            "example": "\u20b15,000 Shopping Spree"
          },
          "limits": {
            "type": "object",
            "properties": {
              "perBranch": {
                "type": "integer",
                "description": "Maximum per branch (-1 = no limit)",
                "example": -1
              },
              "total": {
                "type": "integer",
                "description": "Maximum total across all branches (-1 = no limit)",
                "example": 10
              },
              "perUser": {
                "type": "integer",
                "description": "Maximum per user/device (-1 = no limit)",
                "example": 1
              },
              "perDay": {
                "type": "integer",
                "nullable": true,
                "description": "Maximum per day per branch when applicable",
                "example": null
              }
            }
          },
          "distributed": {
            "type": "object",
            "properties": {
              "total": {
                "type": "integer",
                "description": "Total distributed so far",
                "example": 0
              },
              "perBranch": {
                "type": "object",
                "description": "Distribution count per branch",
                "additionalProperties": {
                  "type": "integer"
                },
                "example": {
                  "tk-fairview": 5,
                  "tk-megamall": 3
                }
              },
              "today": {
                "type": "object",
                "description": "Today's distribution per branch (for daily limits)",
                "additionalProperties": {
                  "type": "integer"
                },
                "example": {
                  "tk-fairview": 2
                }
              }
            }
          },
          "active": {
            "type": "boolean",
            "example": true
          },
          "validUntil": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Prize expiration date (null = no expiration)",
            "example": "2025-12-31T23:59:59.000Z"
          },
          "allowedRegions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true,
            "description": "Allowed regions (null = all regions)",
            "example": [
              "NCR1",
              "NCR2",
              "NCR3"
            ]
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "VALIDATION_ERROR",
                  "SESSION_NOT_FOUND",
                  "PRIZE_NOT_FOUND",
                  "VOUCHER_NOT_FOUND",
                  "DEVICE_LIMIT_EXCEEDED",
                  "PRIZE_EXPIRED",
                  "PRIZE_REGION_RESTRICTED",
                  "REGISTRATION_REQUIRED",
                  "REGISTRATION_NOT_REQUIRED",
                  "INTERNAL_ERROR"
                ],
                "example": "VALIDATION_ERROR"
              },
              "message": {
                "type": "string",
                "example": "Invalid input data"
              },
              "details": {
                "type": "object",
                "description": "Additional error context",
                "additionalProperties": true
              }
            }
          }
        }
      }
    },
    "responses": {
      "ValidationError": {
        "description": "Validation error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "examples": {
              "missingField": {
                "value": {
                  "success": false,
                  "error": {
                    "code": "VALIDATION_ERROR",
                    "message": "Missing required field",
                    "details": {
                      "field": "deviceId",
                      "message": "deviceId is required"
                    }
                  }
                }
              },
              "invalidFormat": {
                "value": {
                  "success": false,
                  "error": {
                    "code": "VALIDATION_ERROR",
                    "message": "Invalid input format",
                    "details": {
                      "field": "contactNumber",
                      "message": "Contact number must be in format +639XXXXXXXXX"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "InternalError": {
        "description": "Internal server error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "examples": {
              "serverError": {
                "value": {
                  "success": false,
                  "error": {
                    "code": "INTERNAL_ERROR",
                    "message": "An unexpected error occurred"
                  }
                }
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Shared API key required for all routes. `X-Admin-API-Key` is also accepted for backward compatibility."
      }
    }
  },
  "security": [
    {
      "ApiKeyAuth": []
    }
  ]
}