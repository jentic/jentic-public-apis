            "$ref": "#/components/parameters/id"
          }
        ],
        "responses": {
          "200": {
            "description": "The requested customer.",
            "content": {
              "application/vnd.moonclerk+json;version=1": {
                "schema": {
                  "type": "object",
                  "required": [
                    "customer"
                  ],
                  "properties": {
                    "customer": {
                      "$ref": "#/components/schemas/Customer"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          },
          "502": {
            "$ref": "#/components/responses/ServerError"
          },
          "503": {
            "$ref": "#/components/responses/ServerError"
          },
          "504": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/payments": {
      "get": {
        "operationId": "listPayments",
        "summary": "List payments",
        "description": "Returns individual payments. Filters may be combined; date filters are `YYYY-MM-DD` and UTC-based, with `date_from` starting at the beginning of the day and `date_to` running through the end of it.",
        "tags": [
          "Payments"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/count"
          },
          {
            "$ref": "#/components/parameters/offset"
          },
          {
            "$ref": "#/components/parameters/formId"
          },
          {
            "name": "customer_id",
            "in": "query",
            "required": false,
            "description": "The associated MoonClerk customer ID.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "date_from",
            "in": "query",
            "required": false,
            "description": "Payments charged on or after this date.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "date_to",
            "in": "query",
            "required": false,
            "description": "Payments charged on or before this date.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Payment status.",
            "schema": {
              "type": "string",
              "enum": [
                "successful",
                "refunded",
                "failed"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of payments.",
            "content": {
              "application/vnd.moonclerk+json;version=1": {
                "schema": {
                  "type": "object",
                  "required": [
                    "payments"
                  ],
                  "properties": {
                    "payments": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Payment"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          },
          "502": {
            "$ref": "#/components/responses/ServerError"
          },
          "503": {
            "$ref": "#/components/responses/ServerError"
          },
          "504": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/payments/{id}": {
      "get": {
        "operationId": "getPayment",
        "summary": "Get a payment",
        "description": "Returns one payment by its MoonClerk ID.",
        "tags": [
          "Payments"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/id"
          }
        ],
        "responses": {
          "200": {
            "description": "The requested payment.",
            "content": {
              "application/vnd.moonclerk+json;version=1": {
                "schema": {
                  "type": "object",
                  "required": [
                    "payment"
                  ],
                  "properties": {
                    "payment": {
                      "$ref": "#/components/schemas/Payment"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          },
          "502": {
            "$ref": "#/components/responses/ServerError"
          },
          "503": {
            "$ref": "#/components/responses/ServerError"
          },
          "504": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Account API key, sent as `Token token=YOUR_API_KEY`. Note the `Token token=` prefix — this is not a Bearer token. The key grants read access to all account data; there are no narrower scopes. Generate one at https://app.moonclerk.com/settings/api-key."
      }
    },
    "parameters": {
      "count": {
        "name": "count",
        "in": "query",
        "required": false,
        "description": "Number of rows to return.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 10
        }
      },
      "offset": {
        "name": "offset",
        "in": "query",
        "required": false,
        "description": "Starting position of the result set.",
        "schema": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      },
      "id": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "MoonClerk ID of the record.",
        "schema": {
          "type": "integer"
        }
      },
      "formId": {
        "name": "form_id",
        "in": "query",
        "required": false,
        "description": "The associated MoonClerk form ID.",
        "schema": {
          "type": "integer"
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing or invalid API key. The body is currently `text/plain` (`HTTP Token: Access denied.`), not JSON.",
        "content": {
          "text/plain": {
            "schema": {
              "type": "string"
            }
          }
        }
      },
      "TooManyRequests": {
        "description": "Throttling limit exceeded. Reduce the number and frequency of calls, then retry. No `RateLimit` or `Retry-After` headers are currently published.",
        "content": {
          "text/plain": {
            "schema": {
              "type": "string"
            }
          }
        }
      },
      "ServerError": {
        "description": "MoonClerk is unavailable — `500` means the app is entirely down; `502`, `503` and `504` are gateway and timeout conditions. Retrying later is the caller's responsibility.",
        "content": {
          "text/plain": {
            "schema": {
              "type": "string"
            }
          }
        }
      }
    },
    "schemas": {
      "Form": {
        "type": "object",
        "description": "A payment form.",
        "properties": {
          "id": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "access_token": {
            "type": "string",
            "description": "Public token used in the hosted checkout URL."
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217 currency code."
          },
          "payment_volume": {
            "type": "integer",
            "description": "Total volume collected through this form, in cents."
          },
          "successful_checkout_count": {
            "type": "integer"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Customer": {
        "type": "object",
        "description": "A customer and their subscription. Called a \"Plan\" in the MoonClerk web interface.",
        "properties": {
          "id": {
            "type": "integer"
          },
          "account_balance": {
            "type": "integer",
            "description": "In cents."
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "payment_method": {
            "$ref": "#/components/schemas/PaymentMethod"
          },
          "custom_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Set when one of the MoonClerk integration methods is used."
          },
          "customer_reference": {
            "type": [
              "string",
              "null"
            ],
            "description": "Stripe customer ID."
          },
          "discount": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Discount"
              },
              {
                "type": "null"
              }
            ],
            "description": "Null when there is no current discount."
          },
          "delinquent": {
            "type": "boolean"
          },
          "management_url": {
            "type": "string",
            "format": "uri",
            "description": "Self-service URL where the payer manages this subscription."
          },
          "custom_fields": {
            "$ref": "#/components/schemas/CustomFields"
          },
          "form_id": {
            "type": "integer"
          },
          "checkout": {
            "$ref": "#/components/schemas/Checkout"
          },
          "subscription": {
            "$ref": "#/components/schemas/Subscription"
          }
        }
      },
      "Payment": {
        "type": "object",
        "description": "A single payment.",
        "properties": {
          "id": {
            "type": "integer"
          },
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "successful",
              "refunded",
              "failed"
            ]
          },
          "currency": {
            "type": "string"
          },
          "amount": {
            "type": "integer",
            "description": "In cents."
          },
          "fee": {
            "type": "integer",
            "description": "The Stripe fee, in cents."
          },
          "amount_refunded": {
            "type": "integer",
            "description": "In cents."
          },
          "amount_description": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "payment_method": {
            "$ref": "#/components/schemas/PaymentMethod"
          },
          "charge_reference": {
            "type": [
              "string",
              "null"
            ],
            "description": "Stripe charge ID."
          },
          "customer_id": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Present only when the payment came from a recurring checkout."
          },
          "customer_reference": {
            "type": [
              "string",
              "null"
            ],
            "description": "Stripe customer ID. Null for a one-time payment."
          },
          "invoice_reference": {
            "type": [
              "string",
              "null"
            ],
            "description": "Stripe invoice ID. Null for a one-off payment."
          },
          "custom_fields": {
            "$ref": "#/components/schemas/CustomFields"
          },
          "form_id": {
            "type": "integer"
          },
          "custom_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "checkout": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Checkout"
              },
              {
                "type": "null"
              }
            ],
            "description": "Present only when the payment came from a one-time checkout."
          },
          "coupon": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Coupon"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "PaymentMethod": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "examples": [
              "card"
            ]
          },
          "last4": {
            "type": "string"
          },
          "exp_month": {
            "type": [
              "integer",
              "null"
            ]
          },
          "exp_year": {
            "type": [
              "integer",
              "null"
            ]
          },
          "brand": {
            "type": "string",
            "examples": [
              "Visa"
            ]
          }
        }
      },
      "Coupon": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "duration": {
            "type": "string",
            "examples": [
              "once"
            ]
          },
          "amount_off": {
            "type": [
              "integer",
              "null"
            ],
            "description": "In cents."
          },
          "currency": {
            "type": [
              "string",
              "null"
            ]
          },
          "percent_off": {
            "type": [
              "number",
              "null"
            ]
          },
          "duration_in_months": {
            "type": [
              "integer",
              "null"
            ]
          },
          "max_redemptions": {
            "type": [
              "integer",
              "null"
            ]
          },
          "redeem_by": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "Discount": {
        "type": "object",
        "properties": {
          "coupon": {
            "$ref": "#/components/schemas/Coupon"
          },
          "starts_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "ends_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "CustomFields": {
        "type": "object",
        "description": "Responses to the form's Additional Information fields, keyed by the field name configured in the form builder. Keys therefore vary per form.",
        "additionalProperties": {
          "$ref": "#/components/schemas/CustomField"
        }
      },
      "CustomField": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "type": {
            "type": "string",
            "examples": [
              "string",
              "address"
            ]
          },
          "response": {
            "description": "A scalar for most field types, or an address object when `type` is `address`.",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Address"
              }
            ]
          }
        }
      },
      "Address": {
        "type": "object",
        "properties": {
          "line1": {
