    "/v1/properties/{id}/score": {
      "get": {
        "operationId": "getWebsiteScore",
        "summary": "Website-level summary",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "apiKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
