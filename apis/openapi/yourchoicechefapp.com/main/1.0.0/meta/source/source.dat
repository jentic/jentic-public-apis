{
  "openapi": "3.0.4",
  "info": {
    "title": "Your Choice Chef Booking API",
    "description": "This API supports a chef booking application similar to Coox app, including admin panel, user panel, and chef registration app.\n",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/yourchoice/GeneratedAPI_2025-10-22-1004/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.yourchoicechefapp.com/v1"
    }
  ],
  "tags": [
    {
      "name": "admin",
      "description": "Admin panel operations"
    },
    {
      "name": "user",
      "description": "User panel operations"
    },
    {
      "name": "chef",
      "description": "Chef registration and management"
    }
  ],
  "paths": {
    "/admin/chefs": {
      "get": {
        "tags": [
          "admin"
        ],
        "summary": "List all registered chefs",
        "operationId": "listChefsAdmin",
        "responses": {
          "200": {
            "description": "A list of chefs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Chef"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Server error"
          }
        }
      },
      "post": {
        "tags": [
          "admin"
        ],
        "summary": "Add a new chef (admin)",
        "operationId": "addChefAdmin",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChefCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Chef created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Chef"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/admin/chefs/{chefId}": {
      "get": {
        "tags": [
          "admin"
        ],
        "summary": "Get chef details by ID (admin)",
        "operationId": "getChefByIdAdmin",
        "parameters": [
          {
            "name": "chefId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Chef details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Chef"
                }
              }
            }
          },
          "404": {
            "description": "Chef not found"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      },
      "put": {
        "tags": [
          "admin"
        ],
        "summary": "Update chef details (admin)",
        "operationId": "updateChefAdmin",
        "parameters": [
          {
            "name": "chefId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChefUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Chef updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Chef"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "404": {
            "description": "Chef not found"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      },
      "delete": {
        "tags": [
          "admin"
        ],
        "summary": "Delete a chef (admin)",
        "operationId": "deleteChefAdmin",
        "parameters": [
          {
            "name": "chefId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Chef deleted successfully"
          },
          "404": {
            "description": "Chef not found"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/user/register": {
      "post": {
        "tags": [
          "user"
        ],
        "summary": "Register a new user",
        "operationId": "registerUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User registered successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          }
        }
      }
    },
    "/user/login": {
      "post": {
        "tags": [
          "user"
        ],
        "summary": "User login",
        "operationId": "loginUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                },
                "required": [
                  "username",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid username or password"
          }
        }
      }
    },
    "/user/logout": {
      "post": {
        "tags": [
          "user"
        ],
        "summary": "User logout",
        "operationId": "logoutUser",
        "responses": {
          "200": {
            "description": "Logout successful"
          }
        }
      }
    },
    "/user/profile": {
      "get": {
        "tags": [
          "user"
        ],
        "summary": "Get current user profile",
        "operationId": "getUserProfile",
        "responses": {
          "200": {
            "description": "User profile details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      },
      "put": {
        "tags": [
          "user"
        ],
        "summary": "Update current user profile",
        "operationId": "updateUserProfile",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User profile updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/chef/register": {
      "post": {
        "tags": [
          "chef"
        ],
        "summary": "Register a new chef",
        "operationId": "registerChef",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChefCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Chef registered successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Chef"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          }
        }
      }
    },
    "/chef/login": {
      "post": {
        "tags": [
          "chef"
        ],
        "summary": "Chef login",
        "operationId": "loginChef",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                },
                "required": [
                  "username",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid username or password"
          }
        }
      }
    },
    "/chef/profile": {
      "get": {
        "tags": [
          "chef"
        ],
        "summary": "Get current chef profile",
        "operationId": "getChefProfile",
        "responses": {
          "200": {
            "description": "Chef profile details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Chef"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      },
      "put": {
        "tags": [
          "chef"
        ],
        "summary": "Update current chef profile",
        "operationId": "updateChefProfile",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChefUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Chef profile updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Chef"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}
