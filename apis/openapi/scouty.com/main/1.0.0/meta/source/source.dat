{
  "openapi": "3.0.0",
  "info": {
    "title": "Scouty API",
    "description": "Backend API for Scouty - A workforce management and communication platform for Japanese businesses.\n\n## Features\n- User authentication with OTP\n- Store and employee management\n- Real-time chat and messaging\n- Voice/video calling (Agora)\n- Attendance tracking\n- Payroll management\n- Bulletin board system\n\n## Authentication\nMost endpoints require JWT authentication. Include the token in the Authorization header:\n```\nAuthorization: Bearer <your_jwt_token>\n```\n",
    "version": "1.0.0",
    "contact": {
      "name": "Scouty API Support",
      "email": "support@scouty.com"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/digitaltrench/scouty-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.scouty.com",
      "description": "Production server"
    }
  ],
  "tags": [
    {
      "name": "Authentication",
      "description": "User registration, login, and OTP verification"
    },
    {
      "name": "Profile",
      "description": "User profile management"
    },
    {
      "name": "Admin",
      "description": "Admin operations (user approval, store management, etc.)"
    },
    {
      "name": "Store",
      "description": "Store search, bookmarks, and management"
    },
    {
      "name": "Chat",
      "description": "Real-time messaging and group chats"
    },
    {
      "name": "Bulletin",
      "description": "Bulletin board posts and comments"
    },
    {
      "name": "Memo",
      "description": "Personal memos"
    },
    {
      "name": "Attendance",
      "description": "Clock in/out and attendance tracking"
    },
    {
      "name": "Payroll",
      "description": "Payroll data retrieval"
    },
    {
      "name": "Form Records",
      "description": "Form submission management"
    },
    {
      "name": "Upload",
      "description": "File upload operations"
    },
    {
      "name": "Notifications",
      "description": "Push notification management"
    },
    {
      "name": "Settings",
      "description": "Application settings"
    },
    {
      "name": "Agora",
      "description": "Video call token generation"
    },
    {
      "name": "Grades",
      "description": "Grade/evaluation management"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT token obtained from login"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "error": {
            "type": "string",
            "example": "Error message"
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "phoneNumber": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "manager",
              "admin"
            ]
          },
          "group": {
            "type": "string",
            "enum": [
              "A",
              "B",
              "C",
              "G",
              null
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "rejected",
              "banned"
            ]
          },
          "accountVerified": {
            "type": "boolean"
          },
          "profilePicture": {
            "type": "string"
          },
          "store": {
            "type": "string"
          },
          "company": {
            "type": "string"
          },
          "position": {
            "type": "string"
          },
          "team": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Store": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "storeName": {
            "type": "string"
          },
          "storeAddress": {
            "type": "string"
          },
          "storeImage": {
            "type": "string"
          },
          "Industry": {
            "type": "string"
          },
          "subArea": {
            "type": "string"
          },
          "hashTag": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rating": {
            "type": "number"
          },
          "Details": {
            "type": "string"
          }
        }
      },
      "Bulletin": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "content": {
            "type": "string"
          },
          "images": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "likes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "comments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Comment"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Comment": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "content": {
            "type": "string"
          },
          "images": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "likes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "paths": {
    "/api/auth/register": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Register a new user",
        "description": "Register a new user with phone number and personal details",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "phoneNumber",
                  "address"
                ],
                "properties": {
                  "firstName": {
                    "type": "string"
                  },
                  "lastName": {
                    "type": "string"
                  },
                  "displayName": {
                    "type": "string"
                  },
                  "phoneNumber": {
                    "type": "string"
                  },
                  "address": {
                    "type": "string"
                  },
                  "dob": {
                    "type": "string",
                    "format": "date"
                  },
                  "governmentID": {
                    "type": "string"
                  },
                  "device_id": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User registered successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/register-store-manager": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Register a store manager",
        "description": "Register a new store manager with store association",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "firstName",
                  "lastName",
                  "phoneNumber",
                  "storeName"
                ],
                "properties": {
                  "firstName": {
                    "type": "string"
                  },
                  "lastName": {
                    "type": "string"
                  },
                  "phoneNumber": {
                    "type": "string"
                  },
                  "storeName": {
                    "type": "string"
                  },
                  "storeManager": {
                    "type": "string"
                  },
                  "device_id": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Manager registered successfully"
          },
          "400": {
            "description": "Bad request"
          }
        }
      }
    },
    "/api/auth/verify-otp": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Verify OTP code",
        "description": "Verify the OTP code sent to user's phone number",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "phoneNumber",
                  "otp"
                ],
                "properties": {
                  "phoneNumber": {
                    "type": "string"
                  },
                  "otp": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OTP verified successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    },
                    "token": {
                      "type": "string"
                    },
                    "symbols": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login-otp": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Login with OTP",
        "description": "Request OTP for login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "phoneNumber"
                ],
                "properties": {
                  "phoneNumber": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OTP sent successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    },
                    "otp": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/update-device-id": {
      "put": {
        "tags": [
          "Authentication"
        ],
        "summary": "Update device ID",
        "description": "Update user's device ID for push notifications",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "device_id"
                ],
                "properties": {
                  "device_id": {
                    "type": "string"
                  },
                  "phoneNumber": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Device ID updated successfully"
          }
        }
      }
    },
    "/api/auth/update-voip-token": {
      "put": {
        "tags": [
          "Authentication"
        ],
        "summary": "Update VoIP token",
        "description": "Update user's VoIP token for call notifications",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "voip_token"
                ],
                "properties": {
                  "voip_token": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "VoIP token updated successfully"
          }
        }
      }
    },
    "/api/profile": {
      "get": {
        "tags": [
          "Profile"
        ],
        "summary": "Get user profile",
        "description": "Get authenticated user's profile information",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Profile retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "$ref": "#/components/schemas/User"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Profile"
        ],
        "summary": "Update user profile",
        "description": "Update authenticated user's profile",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "firstName": {
                    "type": "string"
                  },
                  "lastName": {
                    "type": "string"
                  },
                  "displayName": {
                    "type": "string"
                  },
                  "address": {
                    "type": "string"
                  },
                  "dob": {
                    "type": "string",
                    "format": "date"
                  },
                  "profilePicture": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profile updated successfully"
          }
        }
      }
    },
    "/api/profile/presigned-url": {
      "get": {
        "tags": [
          "Profile"
        ],
        "summary": "Get presigned URL for profile picture upload",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "fileName",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fileType",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Presigned URL generated"
          }
        }
      }
    },
    "/api/admin/user/{id}/approve": {
      "put": {
        "tags": [
          "Admin"
        ],
        "summary": "Approve or reject user",
        "description": "Admin endpoint to approve or reject pending users",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "status"
                ],
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "approved",
                      "rejected"
                    ]
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "user",
                      "manager",
                      "admin"
                    ]
                  },
                  "company": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User status updated"
          }
        }
      }
    },
    "/api/admin/user/pending": {
      "get": {
        "tags": [
          "Admin"
        ],
        "summary": "Get pending users",
        "description": "Get all users with pending status",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Pending users retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "count": {
                      "type": "integer"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/User"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/users": {
      "get": {
        "tags": [
          "Admin"
        ],
        "summary": "Get all approved users",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "company",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Users retrieved successfully"
          }
        }
      }
    },
    "/api/admin/user": {
      "post": {
        "tags": [
          "Admin"
        ],
        "summary": "Add new user (Admin)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "phoneNumber",
                  "role"
                ],
                "properties": {
                  "firstName": {
                    "type": "string"
                  },
                  "lastName": {
                    "type": "string"
                  },
                  "phoneNumber": {
                    "type": "string"
                  },
                  "address": {
                    "type": "string"
                  },
                  "dob": {
                    "type": "string",
                    "format": "date"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "user",
                      "manager",
                      "admin"
                    ]
                  },
                  "store": {
                    "type": "string"
                  },
                  "group": {
                    "type": "string",
                    "enum": [
                      "A",
                      "B",
                      "C",
                      "G"
                    ]
                  },
                  "company": {
                    "type": "string"
                  },
                  "position": {
                    "type": "string"
                  },
                  "rewardRate": {
                    "type": "number"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created successfully"
          }
        }
      }
    },
    "/api/admin/user/{id}": {
      "get": {
        "tags": [
          "Admin"
        ],
        "summary": "Get user by ID",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User retrieved"
          }
        }
      },
      "put": {
        "tags": [
          "Admin"
        ],
        "summary": "Update user by ID",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/User"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User updated"
          }
        }
      },
      "delete": {
        "tags": [
          "Admin"
        ],
        "summary": "Delete user by ID",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User deleted"
          }
        }
      }
    },
    "/api/admin/stores": {
      "get": {
        "tags": [
          "Admin"
        ],
        "summary": "Get all stores (paginated)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "q",
            "in": "query",
            "description": "Search query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Stores retrieved"
          }
        }
      }
    },
    "/api/admin/store": {
      "post": {
        "tags": [
          "Admin"
        ],
        "summary": "Add new store",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "storeName",
                  "storeAddress",
                  "subArea",
                  "Industry",
                  "hashTag"
                ],
                "properties": {
                  "storeName": {
                    "type": "string"
                  },
                  "storeAddress": {
                    "type": "string"
                  },
                  "subArea": {
                    "type": "string"
                  },
                  "Industry": {
                    "type": "string"
                  },
                  "hashTag": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "storeImage": {
                    "type": "string"
                  },
                  "Details": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Store created"
          }
        }
      }
    },
    "/api/admin/store/{id}": {
      "get": {
        "tags": [
          "Admin"
        ],
        "summary": "Get store by ID",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Store retrieved"
          }
        }
      },
      "put": {
        "tags": [
          "Admin"
        ],
        "summary": "Update store by ID",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Store"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Store updated"
          }
        }
      },
      "delete": {
        "tags": [
          "Admin"
        ],
        "summary": "Delete store by ID",
        "security": [
          {
            "bearerAuth": []
          }
