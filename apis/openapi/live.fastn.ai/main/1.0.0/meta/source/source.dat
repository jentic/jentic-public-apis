            },
            "properties": {}
          },
          "articles": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/Article"
            },
            "properties": {}
          }
        }
      },
      "Story": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
