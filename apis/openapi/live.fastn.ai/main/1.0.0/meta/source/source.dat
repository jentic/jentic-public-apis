{
  "openapi": "3.0.1",
  "info": {
    "title": "Fastn Send Notification API",
    "description": "The **Send Notification API** enables Perigon Systems to deliver signals,\nevents, topical reports, and curated article data into a variety of\ndownstream platforms using the **Fastn integration platform**.\n\nThis API is used to transmit structured content into:\n- CRM platforms  \n- Communication and messaging tools  \n- Productivity and workflow systems  \n- Any Fastn-connected enterprise application  \n\nThe API accepts structured metadata—including events, topical content,\nstory references, and article lists—which Fastn processes and routes\naccording to predefined workflows and notification rules within each\nconnected platform.\n",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/fastnai/fastn-send-notification-api/1.0.0"
  },
  "tags": [
    {
      "name": "Notifications"
    }
  ],
  "paths": {
    "/sendNotification": {
