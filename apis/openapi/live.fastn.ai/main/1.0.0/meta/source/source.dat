      "ErrorResponse": {
        "type": "object",
        "description": "Standardized error response structure for API failures",
        "required": [
          "code",
          "statusCode",
          "isCustomAuthError",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Machine-readable error code",
            "example": "FLOW_NOT_DEPLOYED"
          },
          "statusCode": {
            "type": "integer",
            "description": "HTTP status code associated with the error",
            "example": 400
          },
          "isCustomAuthError": {
            "type": "boolean",
            "description": "Indicates if the error is caused by custom authentication logic",
            "example": false
          },
          "step": {
            "type": "string",
            "description": "The step or process where the error occurred",
            "example": "parent"
          },
          "message": {
            "type": "string",
            "description": "Human-readable explanation of the error",
            "example": "Flow with the name sendNotification and project ID ac5c6a5c-e8fe-4cc5-98f2-9f807a5a7b6f is not deployed to LIV"
          }
        }
      }
    },
