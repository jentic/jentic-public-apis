  /spaces/{spaceId}/prompts:
    get:
      summary: List prompts
      description: >-
        List the insight prompt templates available in the workspace. Use a
        prompt's id with the **Create insight** endpoint to generate an insight
        from it.
      operationId: ""
      tags:
        - Insights
      parameters:
        - in: path
          name: spaceId
          description: ID of the workspace.
          schema:
            type: string
          required: true
      responses:
        "200":
          description: List of prompts
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/Prompt"
        "400":
          $ref: "#/components/responses/400 - Bad Request"
        "401":
          $ref: "#/components/responses/401 - Unauthorized"
        "403":
          $ref: "#/components/responses/403 - Forbidden"
        "404":
          $ref: "#/components/responses/404 - Not Found"
      security:
        - x-api-key: []
    post:
      summary: Create prompt
      description: >-
        Create a new insight prompt template in the workspace — for example a
        prompt tailored to a specific task. The prompt is saved to the
        workspace's prompt library; it does not run automatically on future
        transcriptions. Use the returned id with the **Create insight** endpoint.
      operationId: ""
      tags:
        - Insights
      parameters:
        - in: path
          name: spaceId
          description: ID of the workspace.
          schema:
            type: string
          required: true
      requestBody:
        description: Prompt details
        content:
          application/json:
            schema:
              type: object
              properties:
                title:
                  type: string
                  description: Short, human-readable name for the prompt.
                prompt:
                  type: string
                  description: The instruction run against the transcript.
                sampleContent:
                  type: string
                  nullable: true
                  description: >-
                    Optional example of the desired output, to steer the
                    formatting and style.
              required:
                - title
                - prompt
      responses:
        "200":
          description: Created prompt
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Prompt"
        "400":
          $ref: "#/components/responses/400 - Bad Request"
        "401":
          $ref: "#/components/responses/401 - Unauthorized"
        "403":
          $ref: "#/components/responses/403 - Forbidden"
        "404":
          $ref: "#/components/responses/404 - Not Found"
      security:
        - x-api-key: []
    parameters: []
  /spaces/{spaceId}/prompts/{promptId}:
    patch:
      summary: Update prompt
      description: >-
        Update a prompt's title, instruction, and sample content. Replaces all
        three fields, so send the full prompt definition.


        A prompt is owned by you, not by a single workspace, so this edits the
        prompt itself: the change applies to **every** workspace the prompt is
        linked to, not just this one (the spaceId in the path only locates the
        prompt). Only prompts you created can be updated; built-in
        (admin-managed) prompts cannot.
      operationId: ""
      tags:
        - Insights
      parameters:
        - in: path
          name: spaceId
          description: ID of the workspace.
          schema:
            type: string
          required: true
        - in: path
          name: promptId
          description: ID of the prompt to update.
          schema:
            type: string
          required: true
      requestBody:
        description: Updated prompt details
        content:
          application/json:
            schema:
              type: object
              properties:
                title:
                  type: string
                prompt:
                  type: string
                sampleContent:
                  type: string
                  nullable: true
              required:
                - title
                - prompt
      responses:
        "200":
          description: Updated prompt
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Prompt"
        "400":
          $ref: "#/components/responses/400 - Bad Request"
        "401":
          $ref: "#/components/responses/401 - Unauthorized"
        "403":
          $ref: "#/components/responses/403 - Forbidden"
        "404":
          $ref: "#/components/responses/404 - Not Found"
      security:
        - x-api-key: []
    parameters: []
  /spaces/{spaceId}/recordings/{recordingId}/insights:
    get:
      summary: Get insights
      description: This will return all insights generated from this recording's transcript
      operationId: get-insights
      tags:
        - Insights
      parameters:
        - in: path
          name: spaceId
          description: >-
            ID of the workspace. You can find from the url in dashboard when you
            open the workspace or using the list workspaces endpoint.
          schema: *ref_4
          required: true
        - in: path
          name: recordingId
          description: >-
            ID of the recording. You can find from the url in dashboard when you
            open the workspace or using the list recordings endpoint.
          schema: *ref_4
          required: true
      responses:
        "200":
          headers: {}
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/Insight"
                description: Insights generated on the recording
          description: Insights
        "400":
          $ref: "#/components/responses/400 - Bad Request"
        "401":
          $ref: "#/components/responses/401 - Unauthorized"
        "403":
          $ref: "#/components/responses/403 - Forbidden"
        "404":
          $ref: "#/components/responses/404 - Not Found"
      security: *ref_5
    parameters: []
    post:
      summary: Create insight
      description: >-
        This will create a new AI insight for a prompt and additional
        customisations / tweaks that you want to apply only to this generation.


        **Tip:** Get a `promptId` from the **List prompts** endpoint, or create
        a task-specific prompt with the **Create prompt** endpoint.
      operationId: create-insight
      tags:
        - Insights
      parameters:
        - in: path
          name: spaceId
          description: >-
            ID of the workspace. You can find from the url in dashboard when you
            open the workspace or using the list workspaces endpoint.
          schema: *ref_4
          required: true
        - in: path
          name: recordingId
          description: >-
            ID of the recording. You can find from the url in dashboard when you
            open the workspace or using the list recordings endpoint.
          schema: *ref_4
          required: true
      responses:
        "200":
          headers: {}
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Insight"
                description: AI insight generated from the given inputs
          description: >-
            AI models can take a few minutes to complete so, this endpoint can
            take much longer than our other endpoints
      requestBody:
        content:
          application/json:
            schema:
              type: object
              properties:
                promptId:
                  type: string
                  description: >-
                    Id of the prompt to use for this insight generation. 


                    **How to get prompt id**: 

                    use the **List prompts** endpoint to see the workspace's
                    prompts, or the **Create prompt** endpoint to add your own.
                tweakQuery:
                  type: string
                  description: >-
                    Any additional tweaks or requests you want to inject into
                    the prompt used to generate the insight.


                    This is a good way to provide requests specific to this
                    recording without having to edit the prompt itself.
              required:
                - promptId
  /spaces/{spaceId}/recordings/{recordingId}/uploads:
    post:
      summary: Start a new upload
      description: >-
        Use this endpoint to start the upload of a media for a recording. Use
        the **uploadId** returned by the endpoint to upload content and complete
        the upload.


        Here's a code sample on how to use our file upload APIs: [Transcript
        File Upload
        Guide](https://gist.github.com/pkpio/25e036810262b6f90201cb10c48fdc4f)
      operationId: ""
      tags:
        - Upload
      parameters:
        - in: path
          name: spaceId
          description: >-
            ID of the workspace. You can find from the url in dashboard when you
            open the workspace or using the list workspaces endpoint.
          schema: *ref_4
          required: true
        - in: path
          name: recordingId
          description: >-
            ID of the recording. You can find from the url in dashboard when you
            open the workspace or using the list recordings endpoint.
          schema: *ref_4
          required: true
      responses:
        "200":
          headers: {}
          content:
            application/json:
              schema:
                type: object
                properties:
                  uploadId:
                    type: string
                    description: >-
                      ID of the upload. You will use this in all requests
                      related to this upload.
                required:
                  - uploadId
          description: Upload metadata
        "400":
          $ref: "#/components/responses/400 - Bad Request"
        "401":
          $ref: "#/components/responses/401 - Unauthorized"
        "403":
          $ref: "#/components/responses/403 - Forbidden"
        "404":
          $ref: "#/components/responses/404 - Not Found"
      requestBody:
        content:
          application/json:
            schema:
              type: object
              properties:
                mimeType:
                  type: string
                  description: >-
                    Mime Type of the media file that is going to be uploaded.
                    Examples of the mimeType format:


                    - video/mp4

                    - video/webm

                    - audio/mp4

                    - audio/mp3
              required:
                - mimeType
        description: Metadata
      security: *ref_9
    parameters: []
  /spaces/{spaceId}/recordings/{recordingId}/uploads/{uploadId}/parts/{partNumber}:
    post:
      summary: Upload permit
      description: >-
        This endpoint will return an url where you can upload a part or all of
        your media. You will be uploading the media straight to S3 compatible
        storage by performing a PUT request with the content of the part.


        **NOTE:** 

        - Part numbers start from 1, strictly monotonic, and have no gaps

        - Search for guides on **S3 multipart uploads** on how it works

        - **Upload ID** is returned by the **Start a new upload** endpoint
      operationId: ""
      tags:
        - Upload
      parameters:
        - in: path
          name: spaceId
          description: >-
            ID of the workspace. You can find from the url in dashboard when you
            open the workspace or using the list workspaces endpoint.
          schema: *ref_4
          required: true
        - in: path
          name: recordingId
          description: >-
            ID of the recording. You can find from the url in dashboard when you
            open the workspace or using the list recordings endpoint.
          schema: *ref_4
          required: true
        - in: path
          name: uploadId
          description: >-
            ID of the upload. You will receive this when you start an upload
            using the start upload endpoint
          schema: *ref_4
          required: true
        - in: path
          name: partNumber
          description: Index of the part you are uploading
          schema: *ref_7
          required: true
      responses:
        "200":
          description: Part upload permit
          content:
            application/json:
              schema:
                type: object
                properties:
                  partUploadUrl:
                    type: string
                    description: >-
                      Signed s3 url to upload the content of your multipart
                      upload
                required:
                  - partUploadUrl
        "400":
          $ref: "#/components/responses/400 - Bad Request"
        "401":
          $ref: "#/components/responses/401 - Unauthorized"
        "403":
          $ref: "#/components/responses/403 - Forbidden"
        "404":
          $ref: "#/components/responses/404 - Not Found"
      security: *ref_9
    parameters: []
  /spaces/{spaceId}/recordings/{recordingId}/uploads/{uploadId}/complete:
    post:
      summary: Complete upload
      description: >-
        Call this endpoint only after all part(s) of the media file have been
        successfully. You will use information from each part upload call to
        complete the upload. 


        **Transcription will begin as soon as the upload is complete using this
        endpoint**
      operationId: ""
      tags:
        - Upload
      parameters:
        - in: path
          name: spaceId
          description: >-
            ID of the workspace. You can find from the url in dashboard when you
            open the workspace or using the list workspaces endpoint.
          schema: *ref_4
          required: true
        - in: path
          name: recordingId
          description: >-
            ID of the recording. You can find from the url in dashboard when you
            open the workspace or using the list recordings endpoint.
          schema: *ref_4
          required: true
        - in: path
          name: uploadId
          description: >-
            ID of the upload. You will receive this when you start an upload
            using the start upload endpoint
          schema: *ref_4
          required: true
      responses:
        "200":
          description: OK
          content:
            application/json:
              schema:
                type: object
                properties:
                  success:
                    type: boolean
                    description: true if upload is completed successfully
                required:
                  - success
        "400":
          $ref: "#/components/responses/400 - Bad Request"
        "401":
          $ref: "#/components/responses/401 - Unauthorized"
        "402":
          $ref: "#/components/responses/402 - Payment Required"
        "403":
          $ref: "#/components/responses/403 - Forbidden"
        "404":
          $ref: "#/components/responses/404 - Not Found"
      requestBody:
        content:
          application/json:
            schema:
              type: object
              properties:
                parts:
                  type: array
                  items:
                    type: object
                    properties:
                      ETag:
                        type: string
                        description: Etag returned for the part upload
                      PartNumber:
                        type: string
                        description: Part number for this ETag is for
                    required:
                      - ETag
                      - PartNumber
                  description: Information of each uploaded part
              required:
                - parts
        description: Parts metadata
      security: *ref_9
    parameters: []
  /webhooks:
    get:
      summary: "List all webhooks "
      description: Lists all webhooks set by your account
      operationId: ""
      tags:
        - Webhook
      parameters: &ref_15 []
      responses:
        "200":
          description: Webhooks
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/Webhook"
        "400": *ref_10
        "401": *ref_11
        "403": *ref_12
        "404": *ref_13
      security: *ref_14
    post:
      summary: Register webhook
      description: Creates a new webhook that listens for specified events in a workspace.
      operationId: ""
      tags:
        - Webhook
      parameters: *ref_15
      responses:
        "200":
          description: New webhook object
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Webhook"
        "400": *ref_16
        "401": *ref_17
        "403": *ref_18
        "404": *ref_19
      security: *ref_20
      requestBody:
        description: Webhook options
        content:
          application/json:
            schema:
              type: object
              properties:
                event:
                  $ref: "#/components/schemas/WebhookEvent"
                  description: >
                    Events you want to subscribe to. 


                    To subscribe to multiple events, create multiple webhooks
                    with the same url and different event types.
                url:
                  type: string
                  description: URL where you will be notifed when the event occurs
                workspaceId:
                  type: string
                  description: >-
                    ID of the workspace on which you get notified about the
                    events
              required:
                - language
                - templateId
                - name
                - event
                - url
                - workspaceId
    parameters: []
  /webhooks/{webhookId}:
    delete:
      summary: Delete webhook
      description: Deletes a webhook set by you
      operationId: ""
      tags:
        - Webhook
      parameters:
        - in: path
          name: webhookId
          description: ID of the webhook
          schema: *ref_4
          required: true
      responses: *ref_21
      security: *ref_22
    parameters: []
components:
  schemas:
    User:
      type: object
      properties:
        subscriptionInfo:
          type: object
          description: >-
            Autumn-derived billing profile. `plan` is the active Autumn base plan id
            (`free`, `unlimited-monthly` or `unlimited-yearly`); `ltdPlan` is the
            highest active lifetime plan id (`lifetime-tier1`..`lifetime-tier4`) or null.
          properties:
            plan:
              type: string
              enum:
                - free
                - unlimited-monthly
                - unlimited-yearly
            ltdPlan:
              type:
                - string
                - "null"
              enum:
                - lifetime-tier1
                - lifetime-tier2
                - lifetime-tier3
                - lifetime-tier4
                - null
          required:
            - plan
            - ltdPlan
        id:
          type: string
        createdAt:
          type: string
        updatedAt:
          type: string
        email:
          type: string
        signInProvider:
          type: string
        name:
          type: string
        avatarUrl:
          type: string
      x-examples:
        Example 1:
          subscriptionInfo:
            plan: unlimited-monthly
            ltdPlan: null
          id: 669c25b595b446e06dc64fca
          createdAt: "2024-07-20T21:01:41.135Z"
          updatedAt: "2024-08-09T17:17:05.237Z"
          email: praveendath92@gmail.com
          signInProvider: google.com
          name: Praveen Pendyala
          avatarUrl: >-
            https://lh3.googleusercontent.com/a/ACg8ocIKItKgkir2-BmATLeoF6AVVUbLZ_8FtN-hqlzjJgAYUxJ5uLZCZQ=s96-c
      title: User
      required:
        - subscriptionInfo
        - id
        - createdAt
        - updatedAt
        - email
        - signInProvider
        - name
        - avatarUrl
    LanguageCode:
      title: LanguageCode
      enum:
        - bg
        - ca
        - zh
        - zh-CN
        - zh-Hans
        - zh-TW
        - zh-Hant
        - cs
        - da
        - da-DK
        - nl
        - en
        - en-US
        - en-AU
        - en-GB
        - en-NZ
        - en-IN
        - et
        - fi
        - nl-BE
        - fr
        - fr-CA
        - de
        - de-CH
        - el
        - hi
        - hu
        - id
        - it
        - ja
        - ko
        - lv
        - lt
        - ms
        - multi
        - "no"
        - pl
        - pt
        - pt-BR
        - ro
        - ru
        - sk
        - es
        - es-419
        - sv
        - th
        - tr
        - uk
        - vi
      description: ""
    Workspace:
      type: object
      x-examples:
        Example 1:
          findAndReplaceWords:
            - find: John
              replace: Jon
          id: 669c285a95b446e06dc64fcc
          createdAt: "2024-07-20T21:12:58.893Z"
          updatedAt: "2024-08-18T21:04:04.799Z"
          name: Business YouTube
          language: en
          templateId: 669c226295b446e06dc64fa6
          ownerId: 669c25b595b446e06dc64fca
          _count:
            recordings: 36
            speakers: 2
      properties:
        findAndReplaceWords:
          type: array
          items:
            type: object
            properties:
              find:
                type: string
              replace:
                type: string
        id:
          type: string
        createdAt:
          type: string
        updatedAt:
          type: string
        name:
          type: string
        language:
          $ref: "#/components/schemas/LanguageCode"
        templateId:
          type: string
        ownerId:
          type: string
        _count:
          type: object
          properties:
            recordings:
              type: integer
            speakers:
              type: integer
          required:
            - recordings
            - speakers
        privacy:
          $ref: "#/components/schemas/WorkspacePrivacy"
      title: Workspace
      required:
        - createdAt
        - updatedAt
        - name
        - language
        - templateId
        - ownerId
        - _count
        - findAndReplaceWords
        - privacy
    WorkspaceDetail:
      allOf:
        - $ref: "#/components/schemas/Workspace"
        - type: object
          properties:
            owner:
              type: object
              properties:
                name:
                  type: string
                id:
                  type: string
                email:
                  type: string
                ownedTeam:
                  type: object
                  properties:
                    name:
                      type: string
                  required:
                    - name
              required:
                - name
                - id
                - email
                - ownedTeam
            memberships:
              type: array
              items:
                $ref: "#/components/schemas/WorkspaceMembership"
              description: relevant only for shared workspaces
            monthlyCreditLimit:
              type: integer
            autoDeleteMediaAfterDays:
              type: integer
          required:
            - owner
            - memberships
    MediaType:
      title: MediaType
      enum:
        - AUDIO
        - VIDEO
    MediaSource:
      title: MediaSource
      enum:
        - FILE_UPLOAD
        - YOUTUBE
        - VIMEO
        - INSTAGRAM
        - X
        - FACEBOOK
        - TIKTOK
        - UNKNOWN
      type: string
    WorkspacePrivacy:
      title: WorkspacePrivacy
      enum:
        - PRIVATE
        - WHOLE_TEAM
        - SPECIFIC_MEMBERS
      type: string
    WorkspaceMembership:
      type: object
      properties:
        id:
          type: string
        createdAt:
          type: string
        teamMembership:
          $ref: "#/components/schemas/TeamMembership"
    TeamMembership:
      type: object
      properties:
        id:
          type: string
          description: Team membership id
        user:
          type: object
          properties:
            name:
              type: string
            id:
              type: string
            email:
              type: string
    Recording:
      type: object
      properties:
        id:
          type: string
        createdAt:
          type: string
        updatedAt:
          type: string
        workspaceId:
          type: string
        title:
          type: string
        sourceUrl:
          type: string
          description: Only when recording is created using a URL
        mediaType:
          $ref: "#/components/schemas/MediaType"
        source:
          type: string
        duration:
          type: number
        status:
          $ref: "#/components/schemas/RecordingStatus"
        recordingFolderId:
          type: string
          description: Only if it is part of a folder
        isMediaDeleted:
          type: boolean
        createdById:
          type: string
        autoDeleteMediaAfter:
          type: string
          description: If set, media of the recording will be auto-deleted after this date
      required:
        - id
        - createdAt
        - updatedAt
        - workspaceId
        - title
        - mediaType
        - status
        - source
        - sourceUrl
        - createdById
    Folder:
      type: object
      properties:
        id:
          type: string
        createdAt:
          type: string
        updatedAt:
          type: string
        name:
          type: string
        workspaceId:
          type: string
        parentFolderId:
          type: string
      required:
        - workspaceId
        - name
        - updatedAt
        - id
        - createdAt
    Speaker:
      type: object
      properties:
        id:
          type: string
        createdAt:
          type: string
        updatedAt:
          type: string
        name:
          type: string
        role:
          type: string
          enum:
            - HOST
            - GUEST
            - CALLER
        workspaceId:
          type: string
        imageId:
          type: string
      required:
        - id
        - name
        - role
        - workspaceId
        - createdAt
        - updatedAt
    Prompt:
      type: object
      properties:
        id:
          type: string
          description: >-
            The prompt ID. Pass this as promptId to the Create insight endpoint.
        title:
          type: string
          description: Short, human-readable name for the prompt.
        prompt:
          type: string
          description: The instruction run against the transcript.
        sampleContent:
          type: string
          nullable: true
          description: >-
            Optional example of the desired output, used to steer formatting and
            style.
        adminManaged:
          type: boolean
          description: >-
            Whether this is a built-in prompt managed by transcript.lol.
            Admin-managed prompts cannot be edited.
        autoGenerate:
          type: boolean
          description: >-
            Whether this prompt runs automatically when a recording finishes
            transcribing. Only returned by the List prompts endpoint.
      required:
        - id
        - title
        - prompt
    RecordingStatus:
      title: RecordingStatus
      enum:
        - MEDIA_IMPORT_UPLOADING
        - MEDIA_IMPORT_PENDING
        - MEDIA_IMPORT_COMPLETE
        - MEDIA_IMPORT_FAILED
        - TRANSCRIPTION_QUEUED
        - TRANSCRIPTION_PENDING
        - TRANSCRIPTION_COMPLETE
        - TRANSCRIPTION_FAILED
      type: string
    RecordingWithAssets:
      type: object
      properties:
        transcript:
          $ref: "#/components/schemas/TranscriptMetadata"
        audioFile:
          $ref: "#/components/schemas/BlobFile"
          description: >-
            If there is an audio file for the recording. Only relavant if the
            original upload was a video
        originalFile:
          $ref: "#/components/schemas/BlobFile"
          description: The original uploaded media file
        webhooks:
          type: array
          items:
            $ref: "#/components/schemas/Webhook"
      required:
        - transcript
        - webhooks
    BlobFile:
      type: object
      properties:
        id:
          type: string
        createdAt:
          type: string
        updatedAt:
          type: string
        mimeType:
          type: string
        type:
          type: string
        size:
          type: number
        publicUrl:
          type: string
        publicUrlExpiry:
          type: string
        workspaceId:
          type: string
      required:
        - id
        - createdAt
        - updatedAt
        - filePath
        - mimeType
        - type
        - size
        - publicUrl
        - publicUrlExpiry
        - workspaceId
    TranscriptStatus:
      title: MediaType
      enum:
        - NOT_STARTED
        - IN_QUEUE
        - IN_PROGRESS
        - COMPLETE
        - FAILED
      type: string
    TranslationStatus:
      title: TranslationStatus
      enum:
        - NOT_STARTED
        - IN_QUEUE
        - IN_PROGRESS
        - COMPLETE
        - FAILED
      type: string
    Translation:
      type: object
      properties:
        id:
          type: string
        createdAt:
          type: string
        updatedAt:
          type: string
        recordingId:
          type: string
          description: ID of the recording this is a translation for
        language:
          $ref: "#/components/schemas/LanguageCode"
          description: Target language for the translation
        status:
          $ref: "#/components/schemas/TranslationStatus"
        failure:
          type: string
          description: Error message if translation failed
        aiModelId:
          type: string
          description: AI model used for translation
        contentBlobId:
          type: string
          description: ID of the blob containing processed translation content
        contentRawBlobId:
          type: string
          description: ID of the blob containing raw translation content
        createdById:
          type: string
          description: ID of the user who created this translation
        queuedAt:
          type: string
          description: Date time when it was queued for translation
        startedAt:
          type: string
          description: Date time when the translation started processing
        completedAt:
          type: string
          description: Date time when the translation was complete
      required:
        - id
        - createdAt
        - updatedAt
        - recordingId
        - language
        - status
        - createdById
    SpeakerAssignment:
      type: object
      properties:
        speakerIndex:
          type: number
          description: Index of the speaker in the transcript content
        speakerId:
          type: string
          description: ID of the speaker you have created in your workspace
      required:
        - speakerIndex
        - speakerId
    TranscriptMetadata:
      type: object
      properties:
        speakerAssignments:
          type: array
          items:
            $ref: "#/components/schemas/SpeakerAssignment"
        id:
          type: string
        createdAt:
          type: string
        updatedAt:
          type: string
        transcriptForId:
          type: string
          description: ID of the recording for which this is a transcript
        language:
          $ref: "#/components/schemas/LanguageCode"
        status:
          $ref: "#/components/schemas/TranscriptStatus"
        queuedAt:
          type: string
          description: Date time when it was queued for transcription
        completedAt:
          type: string
          description: Date time when the transcription was complete
      required:
        - speakerAssignments
        - id
        - createdAt
        - updatedAt
        - transcriptForId
        - language
        - status
        - queuedAt
        - completedAt
        - completedAt
        - completedAt
    TranscriptJsonContent:
      type: object
      properties:
        words:
          type: array
          items:
            $ref: "#/components/schemas/TranscriptWord"
        paragraphs:
          type: array
          items:
            $ref: "#/components/schemas/TranscriptParagraph"
        segments:
          type: array
          items:
            $ref: "#/components/schemas/TranscriptSegment"
      description: Options passed to the transcript determine which fields are available
    TranscriptWord:
      type: object
      properties:
        word:
          type: string
          description: A single word with punctuation if applicable
        start:
          type: number
          description: >-
            Time in original media when this word utterance has started.


            Can be off by a few milliseconds sometimes due to media format and
            bitrate conversions for transcription. Original media with fixed
            bitrates tend to do better.
        end:
          type: number
          description: >-
            Time in original media when this word utterance has finished.


            Can be off by a few milliseconds sometimes due to media format and
            bitrate conversions for transcription. Original media with fixed
            bitrates tend to do better.
        confidence:
          type: number
          description: >-
            Confidence of the model when detecting this word. Ranges between 0.0
            to 1.0
        speaker:
          type: number
          description: >-
            Index of the speaker. 


            Our models estimate the total number of speakers in the given audio
            and gives each distinct voice an index starting 0 to total number of
            speakers - 1.


            For example:

            If we detect 3 distinct speakers in the audio. The speaker index can
            be any of 0, 1 or 2. 


            **NOTE:** Additional speakers may be added manually while editing
            the transcript in our dashboard.
      required:
        - word
        - start
        - end
        - confidence
        - speaker
    TranscriptParagraph:
      type: object
      properties:
        text:
          type: string
          description: Content of the paragraph
        start:
          type: number
          description: >-
            Time in original media when this paragraph utterance has started.


            Can be off by a few milliseconds sometimes due to media format and
            bitrate conversions for transcription. Original media with fixed
            bitrates tend to do better.
        end:
          type: number
          description: >-
            Time in original media when this paragraph utterance has finished.


            Can be off by a few milliseconds sometimes due to media format and
            bitrate conversions for transcription. Original media with fixed
            bitrates tend to do better.
        speaker:
          type: number
          description: >-
            Index of the speaker. 


            Our models estimate the total number of speakers in the given audio
            and gives each distinct voice an index starting 0 to total number of
            speakers - 1.


            For example:

            If we detect 3 distinct speakers in the audio. The speaker index can
            be any of 0, 1 or 2. 


            **NOTE:** Additional speakers may be added manually while editing
            the transcript in our dashboard.
      required:
        - text
        - start
        - end
        - confidence
        - speaker
    TranscriptSegment:
      type: object
      properties:
        text:
          type: string
          description: Text in this segment
        start:
          type: number
          description: Start time of this segment
        end:
          type: number
          description: End time of this segment
        speaker:
          type: number
          description: |-
            Speaker index of the segment speaker. 

            NOTE: Available only when transcribed with diarization enabled.
      required:
        - text
        - start
        - end
    ApiError:
      type: object
      properties:
        error:
          type: string
          description: short description of the error
        errorDetails:
          type: object
          properties: {}
          description: additional details for the cause of the error if available
      required:
        - error
    Webhook:
      type: object
      properties:
        event:
          $ref: "#/components/schemas/WebhookEvent"
        workspaceId:
          type: string
          description: >-
            Workspace the webhook is linked to. Only triggers for contents of
            this workspace.
        createdById:
          type: string
          description: ID of the user that created this webhook
        url:
          type: string
          description: Webhook url
      required:
        - event
        - workspaceId
        - createdById
        - url
    WebhookEvent:
      title: WebhookEvent
      enum:
        - TRANSCRIPT_CREATED
        - TRANSLATION_CREATED
        - INSIGHT_CREATED
      type: string
    BasePrompt:
      type: object
      properties:
        id:
          type: string
          description: ID of prompt
        title:
          type: string
          description: Title of the prompt
      required:
        - id
        - title
    Insight:
      type: object
      properties:
        id:
          type: string
          description: ID of the insight
        content:
          type: string
          description: Content of the insight generated by AI model
        tweaks:
          type: array
          items:
            type: string
            description: |-
              A tweak passed by the user.

              Examples:
              - Make it shorter
              - Make it formal
          description: List of user tweaks passed  in while generating this insight
        prompt:
          $ref: "#/components/schemas/BasePrompt"
          description: Prompt used while generating this insight
      required:
        - id
        - content
        - tweaks
        - prompt
  securitySchemes:
    x-api-key:
      name: x-api-key
      type: apiKey
      in: header
      description: >-
        API key from Dashboard → Account → Integrations. Prefer a dedicated
        key for Muse / agents. Keys look like `tlol_sk_api_access_…` (other
        `tlol_sk_*` role keys also work for REST). Example:


        ```

        curl "https://transcript.lol/api/v1/me" \
          -H "x-api-key: tlol_sk_api_access_YOUR_KEY"

        ```
  responses:
    400 - Bad Request:
      description: Invalid input
      headers: {}
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/ApiError"
    401 - Unauthorized:
      description: Authentication failed
      headers: {}
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/ApiError"
    402 - Payment Required:
      headers: {}
      description: Insufficient credits or need payment
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/ApiError"
    403 - Forbidden:
      description: You don't have access
      headers: &ref_23 {}
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/ApiError"
    404 - Not Found:
      description: Not found or don't have access
      headers: *ref_23
      content:
