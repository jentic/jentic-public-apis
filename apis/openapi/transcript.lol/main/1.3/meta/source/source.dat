openapi: 3.1.0
info:
  title: Transcript LOL - API Documentation
  version: "1.3"
  description: >-
    The following documentation describes how to use the Transcript LOL REST API
    in your own workflows and AI agents (including Meta Muse connectors).


    ## Machine-readable spec


    - OpenAPI 3.1 (this document): https://transcript.lol/openapi.yaml

    - Alternate path (same file): https://transcript.lol/api/openapi.yaml

    - Human docs: https://transcript.lol/docs


    ## Getting Started


    To get started, you need to create an account and get an API key.

    - Sign up for a free account at [Transcript
    LOL](https://transcript.lol/auth/register)

    - Get an API key from [Integrations
    page](https://transcript.lol/dashboard/account/integrations)

    - Send the key on every request as the `x-api-key` header (see
    `components.securitySchemes`)


    ## Muse / agent starter paths


    Typical connector flow:

    1. `GET /me` — verify the API key

    2. `GET /spaces` — list workspaces (`spaceId`)

    3. `GET /spaces/{spaceId}/recordings/search?q=…` — search transcripts

    4. `GET /spaces/{spaceId}/recordings/{recordingId}/transcript` — read text

    5. `POST /spaces/{spaceId}/recordings` with `sourceUrl` — transcribe a
    public URL

    6. `GET|POST /spaces/{spaceId}/recordings/{recordingId}/insights` — read or
    generate insights


    ## Workspaces


    Transcript LOL organises your content in workspaces. You can use different
    workspaces for different types of content. This gives the following
    benefits:

    - Spending breakdown per workspace

    - Setup custom prompts specific to each content type and get insights

    - Isolation of content and settings per workspace 


    Alternatively you can also choose to keep all your content under a single
    workspace.
  contact:
    name: Praveen
    url: https://transcript.lol
    email: support@transcript.lol
servers:
  - url: https://transcript.lol/api/v1
    description: Production
paths:
  /me:
    get:
      summary: Get user
      description: >-
        Get your account info. Useful to check if you are authenticated
        correctly.
      tags:
        - Account
      responses:
        "200":
          description: User info
          content:
            application/json:
              schema:
                type: object
                $ref: "#/components/schemas/User"
        "401":
          $ref: "#/components/responses/401 - Unauthorized"
      operationId: get-user
      security:
        - x-api-key: []
    parameters: []
    servers: []
  /spaces:
    get:
      summary: List workspaces
      description: List all workspaces the current user has access to.
      operationId: list-workspaces
      tags:
        - Workspace
      parameters: &ref_0 []
      responses:
        "200":
          headers: {}
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/Workspace"
          description: List of workspaces
        "401":
          $ref: "#/components/responses/401 - Unauthorized"
      security:
        - x-api-key: []
    post:
      summary: Create workspace
      description: Create a new workspace. The new workspace will be owned by you.
      operationId: create-workspace
      tags:
        - Workspace
      parameters: *ref_0
      responses:
        "200":
          description: New workspace info
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Workspace"
        "400":
          $ref: "#/components/responses/400 - Bad Request"
        "401":
          $ref: "#/components/responses/401 - Unauthorized"
      security:
        - x-api-key: []
      requestBody:
        content:
          application/json:
            schema:
              type: object
              properties:
                name:
                  type: string
                language:
                  $ref: "#/components/schemas/LanguageCode"
                privacy:
                  $ref: "#/components/schemas/WorkspacePrivacy"
              required:
                - name
                - language
                - privacy
                - templateId
        description: New workspace preferences
  /spaces/{spaceId}:
    get:
      summary: Get workspace
      description: Get the metadata and settings of a workspace
      operationId: ""
      tags:
        - Workspace
      parameters:
        - in: path
          name: spaceId
          description: >-
            ID of the workspace. You can find from the url in dashboard when you
            open the workspace or using the list workspaces endpoint.
          schema:
            type: string
          required: true
      responses:
        "200":
          description: Workspace info and memberships
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/WorkspaceDetail"
        "400": &ref_10
          $ref: "#/components/responses/400 - Bad Request"
        "401": &ref_11
          $ref: "#/components/responses/401 - Unauthorized"
        "403": &ref_12
          $ref: "#/components/responses/403 - Forbidden"
        "404": &ref_13
          $ref: "#/components/responses/404 - Not Found"
      security: &ref_14
        - x-api-key: []
    delete:
      summary: Delete workspace
      description: Deletes the workspace. The workspace must be empty.
      operationId: ""
      tags:
        - Workspace
      parameters:
        - in: path
          name: spaceId
          description: >-
            ID of the workspace. You can find from the url in dashboard when you
            open the workspace or using the list workspaces endpoint.
          schema: &ref_1
            type: string
          required: true
      responses: &ref_21
        "200":
          description: OK
          content:
            application/json:
              schema:
                type: object
                properties:
                  success:
                    type: boolean
                required:
                  - success
        "400":
          $ref: "#/components/responses/400 - Bad Request"
        "401":
          $ref: "#/components/responses/401 - Unauthorized"
        "403":
          $ref: "#/components/responses/403 - Forbidden"
        "404":
          $ref: "#/components/responses/404 - Not Found"
      security: &ref_22
        - x-api-key: []
    patch:
      summary: Update workspace
      description: Update workspace settings or metadata
      operationId: ""
      tags:
        - Workspace
      parameters:
        - in: path
          name: spaceId
          description: >-
            ID of the workspace. You can find from the url in dashboard when you
            open the workspace or using the list workspaces endpoint.
          schema: *ref_1
          required: true
      responses:
        "200":
          description: Updated workspace info
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Workspace"
        "400": &ref_16
          $ref: "#/components/responses/400 - Bad Request"
        "401": &ref_17
          $ref: "#/components/responses/401 - Unauthorized"
        "403": &ref_18
          $ref: "#/components/responses/403 - Forbidden"
        "404": &ref_19
          $ref: "#/components/responses/404 - Not Found"
      security: &ref_20
        - x-api-key: []
      requestBody:
        content:
          application/json:
            schema:
              type: object
              properties:
                findAndReplaceWords:
                  type: array
                  items:
                    type: object
                    properties:
                      find:
                        type: string
                      replace:
                        type: string
                name:
                  type: string
                language:
                  type: string
                templateId:
                  type: string
                monthlyCreditLimit:
                  type: number
                privacy:
                  $ref: "#/components/schemas/WorkspacePrivacy"
              required:
                - language
                - templateId
                - name
                - privacy
        description: Workspace preferences
    parameters: []
  /spaces/{spaceId}/folders:
    get:
      summary: List folders
      description: List all folders in the workspace. Returns a flat list of all folders.
      operationId: ""
      tags:
        - Folder
      parameters:
        - in: path
          name: spaceId
          description: >-
            ID of the workspace. You can find from the url in dashboard when you
            open the workspace or using the list workspaces endpoint.
          schema:
            type: string
          required: true
      responses:
        "200":
          description: List of folders
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/Folder"
        "400":
          $ref: "#/components/responses/400 - Bad Request"
        "401":
          $ref: "#/components/responses/401 - Unauthorized"
        "403":
          $ref: "#/components/responses/403 - Forbidden"
        "404":
          $ref: "#/components/responses/404 - Not Found"
      security:
        - x-api-key: []
    post:
      summary: Create folder
      description: Create a new folder in the workspace. You can create a root-level folder or a sub-folder by specifying a parentFolderId.
      operationId: ""
      tags:
        - Folder
      parameters:
        - in: path
          name: spaceId
          description: >-
            ID of the workspace. You can find from the url in dashboard when you
            open the workspace or using the list workspaces endpoint.
          schema:
            type: string
          required: true
      requestBody:
        content:
          application/json:
            schema:
              type: object
              properties:
                name:
                  type: string
                  description: Name of the folder
                parentFolderId:
                  type:
                    - string
                    - "null"
                  description: ID of the parent folder. Pass null to create a root-level folder.
              required:
                - name
                - parentFolderId
            examples:
              root-folder:
                summary: Create a root-level folder
                value:
                  name: "My Folder"
                  parentFolderId: null
              sub-folder:
                summary: Create a sub-folder
                value:
                  name: "Sub Folder"
                  parentFolderId: "parent-folder-id"
        description: Folder details
      responses:
        "200":
          description: Created folder
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Folder"
        "400":
          $ref: "#/components/responses/400 - Bad Request"
        "401":
          $ref: "#/components/responses/401 - Unauthorized"
        "403":
          $ref: "#/components/responses/403 - Forbidden"
        "404":
          $ref: "#/components/responses/404 - Not Found"
      security:
        - x-api-key: []
    parameters: []
  /spaces/{spaceId}/folders/{folderId}:
    patch:
      summary: Rename folder
      description: Rename an existing folder.
      operationId: ""
      tags:
        - Folder
      parameters:
        - in: path
          name: spaceId
          description: >-
            ID of the workspace. You can find from the url in dashboard when you
            open the workspace or using the list workspaces endpoint.
          schema:
            type: string
          required: true
        - in: path
          name: folderId
          description: ID of the folder to rename
          schema:
            type: string
          required: true
      requestBody:
        content:
          application/json:
            schema:
              type: object
              properties:
                name:
                  type: string
                  description: New name for the folder
              required:
                - name
        description: Updated folder details
      responses:
        "200":
          description: Updated folder
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Folder"
        "400":
          $ref: "#/components/responses/400 - Bad Request"
        "401":
          $ref: "#/components/responses/401 - Unauthorized"
        "403":
          $ref: "#/components/responses/403 - Forbidden"
        "404":
          $ref: "#/components/responses/404 - Not Found"
      security:
        - x-api-key: []
    delete:
      summary: Delete folder
      description: Delete a folder. The folder must be empty (no recordings or sub-folders).
      operationId: ""
      tags:
        - Folder
      parameters:
        - in: path
          name: spaceId
          description: >-
            ID of the workspace. You can find from the url in dashboard when you
            open the workspace or using the list workspaces endpoint.
          schema:
            type: string
          required: true
        - in: path
          name: folderId
          description: ID of the folder to delete
          schema:
            type: string
          required: true
      responses:
        "200":
          description: OK
          content:
            application/json:
              schema:
                type: object
                properties:
                  success:
                    type: boolean
                required:
                  - success
        "400":
          $ref: "#/components/responses/400 - Bad Request"
        "401":
          $ref: "#/components/responses/401 - Unauthorized"
        "403":
          $ref: "#/components/responses/403 - Forbidden"
        "404":
          $ref: "#/components/responses/404 - Not Found"
      security:
        - x-api-key: []
    parameters: []
  /spaces/{spaceId}/speakers:
    get:
      summary: List speakers
      description: List all named speakers in the workspace.
      operationId: ""
      tags:
        - Speaker
      parameters:
        - in: path
          name: spaceId
          description: ID of the workspace.
          schema:
            type: string
          required: true
      responses:
        "200":
          description: List of speakers
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/Speaker"
        "400":
          $ref: "#/components/responses/400 - Bad Request"
        "401":
          $ref: "#/components/responses/401 - Unauthorized"
        "403":
          $ref: "#/components/responses/403 - Forbidden"
        "404":
          $ref: "#/components/responses/404 - Not Found"
      security:
        - x-api-key: []
    post:
      summary: Create speaker
      description: Create a new named speaker in the workspace.
      operationId: ""
      tags:
        - Speaker
      parameters:
        - in: path
          name: spaceId
          description: ID of the workspace.
          schema:
            type: string
          required: true
      requestBody:
        description: Speaker details
        content:
          application/json:
            schema:
              type: object
              properties:
                name:
                  type: string
                  description: Display name of the speaker.
                role:
                  type: string
                  enum:
                    - HOST
                    - GUEST
                    - CALLER
              required:
                - name
                - role
      responses:
        "200":
          description: Created speaker
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Speaker"
        "400":
          $ref: "#/components/responses/400 - Bad Request"
        "401":
          $ref: "#/components/responses/401 - Unauthorized"
        "403":
          $ref: "#/components/responses/403 - Forbidden"
        "404":
          $ref: "#/components/responses/404 - Not Found"
      security:
        - x-api-key: []
    parameters: []
  /spaces/{spaceId}/speakers/{speakerId}:
    patch:
      summary: Update speaker
      description: Update a speaker's name and role.
      operationId: ""
      tags:
        - Speaker
      parameters:
        - in: path
          name: spaceId
          description: ID of the workspace.
          schema:
            type: string
          required: true
        - in: path
          name: speakerId
          description: ID of the speaker to update.
          schema:
            type: string
          required: true
      requestBody:
        description: Updated speaker details
        content:
          application/json:
            schema:
              type: object
              properties:
                name:
                  type: string
                role:
                  type: string
                  enum:
                    - HOST
                    - GUEST
                    - CALLER
              required:
                - name
                - role
      responses:
        "200":
          description: Updated speaker
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Speaker"
        "400":
          $ref: "#/components/responses/400 - Bad Request"
        "401":
          $ref: "#/components/responses/401 - Unauthorized"
        "403":
          $ref: "#/components/responses/403 - Forbidden"
        "404":
          $ref: "#/components/responses/404 - Not Found"
      security:
        - x-api-key: []
    delete:
      summary: Delete speaker
      description: Delete a speaker from the workspace.
      operationId: ""
      tags:
        - Speaker
      parameters:
        - in: path
          name: spaceId
          description: ID of the workspace.
          schema:
            type: string
          required: true
        - in: path
          name: speakerId
          description: ID of the speaker to delete.
          schema:
            type: string
          required: true
      responses:
        "200":
          description: OK
          content:
            application/json:
              schema:
                type: object
                properties:
                  success:
                    type: boolean
                required:
                  - success
        "400":
          $ref: "#/components/responses/400 - Bad Request"
        "401":
          $ref: "#/components/responses/401 - Unauthorized"
        "403":
          $ref: "#/components/responses/403 - Forbidden"
        "404":
          $ref: "#/components/responses/404 - Not Found"
      security:
        - x-api-key: []
    parameters: []
  /spaces/{spaceId}/recordings:
    post:
      summary: Create recording
      description: >-
        Transcribe an audio or video file by importing the recording to
        Transcript LOL.


        **You can import using these 2 options:**

        1. A public url to the media

        2. Upload the media to Transcript using our API
      operationId: create-recording
      tags:
        - Transcript
      parameters:
        - in: path
          name: spaceId
          description: >-
            ID of the workspace. You can find from the url in dashboard when you
            open the workspace or using the list workspaces endpoint.
          schema: *ref_1
          required: true
      responses:
        "200":
          description: Recording metadata
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Recording"
        "400":
          $ref: "#/components/responses/400 - Bad Request"
        "401":
          $ref: "#/components/responses/401 - Unauthorized"
        "402":
          $ref: "#/components/responses/402 - Payment Required"
        "403":
          $ref: "#/components/responses/403 - Forbidden"
        "404":
          $ref: "#/components/responses/404 - Not Found"
      security:
        - x-api-key: []
      requestBody:
        description: Recording options
        content:
          application/json:
            schema:
              type: object
              properties:
                title:
                  type: string
                language:
                  $ref: "#/components/schemas/LanguageCode"
                  description: >-
                    Language of the audio/video content. This will be used for
                    transcription.
                translationLanguages:
                  type: array
                  items:
                    $ref: "#/components/schemas/LanguageCode"
                  description: >-
                    Optional. List of language codes to automatically create
                    translations for this recording. Translations will be
                    queued after transcription completes.
                mediaType:
                  $ref: "#/components/schemas/MediaType"
                source:
                  $ref: "#/components/schemas/MediaSource"
                  description: >-
                    Please set this based on how your media content
                    (audio/video) is being imported to Transcript:


                    - **FILE_UPLOAD**: If you are going to upload a file

                    - **UNKNOWN**: If none of the other values are suitable
                sourceUrl:
                  type: string
                  description: Only public urls to audio / video files are acceptable.
                autoDeletePolicy:
                  type: object
                  properties:
                    mediaDeleteAfterDays:
                      type: integer
                      description: >-
                        Number of days after which the recording media is auto
                        deleted. If not set, media is retained until you delete
                        it manually.
                  description: >-
                    Auto deletion policy to apply to this recording. Useful if
                    you prefer your data to be deleted automatically. If not
                    set, no auto deletion occurs.
                speakerDiarization:
                  type: boolean
                  description: >-
                    Set this to true to enable speaker diarization - detection
                    of speakers for each part of the transcript
                speakerCount:
                  type: number
                  description: >-
                    Relavent only when **speakerDiarization** is enabled.


                    If you know the number of speakers in the audio, pass it
                    here to improve diarization accuracy.


                    NOTE: 

                    - Speaker diarization is not perfect. But passing this value
                    can help to some extent.

                    - Further, our speaker diarization model is not good at
                    overlaping conversations - where multiple speakers are
                    speaking at the same time.
                recordingFolderId:
                  type: string
                  description: >-
                    Optional. ID of the folder to place this recording in.
                    Use the List Folders endpoint to get available folder IDs.
                    If not set, the recording will be placed in the root of
                    the workspace.
                externalId:
                  type: string
                  description: >-
                    This id also acts an as **idempotency key**.


                    This could be a unique id you maintain in your system for
                    this recording or file or url.


                    **Idempotency Key Behaviour: **

                    - This is relavent only when you set a value for externalId

                    - When set, this id must be unique across all recordings in
                    this workspace

                    - A new recording will be created only if there is no
                    existing recording in this workspace with the same external
                    id

                    - If there is an existing recording in this workspace with
                    the same externalId, we will respond with the existing
                    recording
              required:
                - title
                - language
                - mediaType
                - source
            examples:
              example1:
                value:
                  title: My Audio
                  language: en
                  mediaType: AUDIO
                  source: UNKNOWN
              example2:
                value:
                  title: My Audio with Translations
                  language: en
                  translationLanguages:
                    - es
                    - fr
                  mediaType: AUDIO
                  source: UNKNOWN
    get:
      summary: List recordings
      description: List all recordings in the workspace. This endpoint is paginated.
      operationId: list-recordings
      tags:
        - Transcript
      parameters:
        - in: query
          name: limit
          description: Maximum number of items per page
          schema:
            type: number
            default: 100
            minimum: 10
            maximum: 500
        - in: query
          name: pagination
          description: >-
            Set to 1 or true.


            **Exists due to legacy reasons:**

            Passing this parameter will always give a paginated response. Not
            passing the parameter will give an array of recordings without the
            pagination cursors.
          schema:
            type: boolean
            default: true
          required: true
        - in: query
          name: before
          description: >-
            Optional. Cursor to access the previous page in the recording list.


            Set this to **prev_cursor** value you received from an earlier call
            to this endpoint
          schema: &ref_2
            type: string
        - in: query
          name: after
          description: >-
            Optional. Cursor to access the next page in the recording list.


            Set this to **next_cursor** value you received from an earlier call
            to this endpoint
          schema: *ref_2
        - in: query
          name: recordingFolderId
          description: >-
            Optional. Filter recordings by parent folder. When set, only
            recordings that belong to the specified folder are returned.
          schema:
            type: string
        - in: query
          name: orderBy
          description: >-
            Field to sort recordings by. Can be one of:

            - **createdAt**: Sort by creation date

            - **title**: Sort by recording title

            - **status**: Sort by recording status


            Defaults to **createdAt**
          schema:
            type: string
            enum:
              - createdAt
              - title
              - status
            default: createdAt
        - in: query
          name: orderDirection
          description: >-
            Sort direction. Can be one of:

            - **asc**: Ascending order

            - **desc**: Descending order


            Defaults to **desc**
          schema:
            type: string
            enum:
              - asc
              - desc
            default: desc
        - in: path
          name: spaceId
          description: >-
            ID of the workspace. You can find from the url in dashboard when you
            open the workspace or using the list workspaces endpoint.
          schema: *ref_1
          required: true
      responses:
        "200":
          headers: {}
          description: List of recordings
          content:
            application/json:
              schema:
                type: object
                properties:
                  recordings:
                    type: array
                    items:
                      $ref: "#/components/schemas/Recording"
                    description: >-
                      List of recordings in the current page. If no page
                      parameters are set, this will be the first page.
                  prev_cursor:
                    type: string
                    description: Cursor to access the previous page of results
                  next_cursor:
                    type: string
                    description: Cursor to access the next page of results
                required:
                  - recordings
        "400":
          $ref: "#/components/responses/400 - Bad Request"
        "401":
          $ref: "#/components/responses/401 - Unauthorized"
        "403":
          $ref: "#/components/responses/403 - Forbidden"
        "404":
          $ref: "#/components/responses/404 - Not Found"
      security:
        - x-api-key: []
    parameters: []
  /spaces/{spaceId}/recordings/search:
    get:
      summary: Search transcripts
      description: >-
        Search the transcripts in a workspace and return matching snippets with
        their recording, timestamps and speakers. Defaults to semantic search
        (find by meaning); pass mode=exact for literal keyword matching.
        Optionally narrow by folder, speaker, or recording date.
      operationId: search-transcripts
      tags:
        - Transcript
      parameters:
        - in: path
          name: spaceId
          description: ID of the workspace.
          schema: *ref_1
          required: true
        - in: query
          name: q
          description: What to look for in the transcripts.
          schema:
            type: string
          required: true
        - in: query
          name: mode
          description: >-
            "semantic" (default) finds results by meaning; "exact" matches the
            literal keywords.
          schema:
            type: string
            enum:
              - semantic
              - exact
          required: false
        - in: query
          name: folderIds
          description: Restrict to these folder IDs. Repeat the param or comma-separate.
          schema:
            type: array
            items:
              type: string
          required: false
        - in: query
          name: speakerIds
          description: >-
            Restrict to chunks where these speakers talk. Repeat the param or
            comma-separate.
          schema:
            type: array
            items:
              type: string
          required: false
        - in: query
          name: dateFrom
          description: Only recordings created on/after this ISO 8601 date.
          schema:
            type: string
            format: date-time
          required: false
        - in: query
          name: dateTo
          description: Only recordings created on/before this ISO 8601 date.
          schema:
            type: string
            format: date-time
          required: false
      responses:
        "200":
          description: Matching transcript snippets
          content:
            application/json:
              schema:
                type: array
                items:
                  type: object
                  properties:
                    documentId:
                      type: string
                    text:
                      type: string
                      description: Speaker-labeled snippet of the matching chunk.
                    start:
                      type: number
                      description: Chunk start within the recording, in seconds.
                    end:
                      type: number
                      description: Chunk end within the recording, in seconds.
                    speakers:
                      type: array
                      items:
                        type: string
                      description: Speaker names present in the snippet.
                    score:
                      type: number
                      description: Similarity score (0-1); present for semantic results only.
                    transcriptId:
                      type: string
                    recording:
                      $ref: "#/components/schemas/Recording"
        "400":
          $ref: "#/components/responses/400 - Bad Request"
        "401":
          $ref: "#/components/responses/401 - Unauthorized"
        "402":
          $ref: "#/components/responses/402 - Payment Required"
        "403":
          $ref: "#/components/responses/403 - Forbidden"
        "404":
          $ref: "#/components/responses/404 - Not Found"
      security:
        - x-api-key: []
  /spaces/{spaceId}/recordings/{recordingId}:
    get:
      summary: Get recording metadata
      description: >-
        This will only return **Recording metadata** and media links (if
        available)


        **To get transcript content, use the /transcript endpoint**
      operationId: get-recording
      tags:
        - Transcript
      parameters:
        - in: path
          name: spaceId
          description: >-
            ID of the workspace. You can find from the url in dashboard when you
            open the workspace or using the list workspaces endpoint.
          schema: &ref_3
            type: string
          required: true
        - in: path
          name: recordingId
          description: >-
            ID of the recording. You can find from the url in dashboard when you
            open the workspace or using the list recordings endpoint.
          schema: *ref_3
          required: true
      responses:
        "200":
          description: Recording metadata
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/RecordingWithAssets"
        "400":
          $ref: "#/components/responses/400 - Bad Request"
        "401":
          $ref: "#/components/responses/401 - Unauthorized"
        "403":
          $ref: "#/components/responses/403 - Forbidden"
        "404":
          $ref: "#/components/responses/404 - Not Found"
      security: &ref_5
        - x-api-key: []
    delete:
      summary: Delete recording
      description: |-
        Deletes the recording and all its contents. This includes:
        - Transcript contents
        - Media files
        - Insights
        - Everything else under this recording
      operationId: ""
      tags:
        - Transcript
      parameters:
        - in: path
          name: spaceId
          description: >-
            ID of the workspace. You can find from the url in dashboard when you
            open the workspace or using the list workspaces endpoint.
          schema: &ref_4
            type: string
          required: true
        - in: path
          name: recordingId
          description: >-
            ID of the recording. You can find from the url in dashboard when you
            open the workspace or using the list recordings endpoint.
          schema: *ref_4
          required: true
      responses:
        "200":
          description: OK
          content:
            application/json:
              schema:
                type: object
                properties:
                  success:
                    type: boolean
                required:
                  - success
        "400":
          $ref: "#/components/responses/400 - Bad Request"
        "401":
          $ref: "#/components/responses/401 - Unauthorized"
        "403":
          $ref: "#/components/responses/403 - Forbidden"
        "404":
          $ref: "#/components/responses/404 - Not Found"
      security:
        - x-api-key: []
    patch:
      summary: Update recording metadata
      description: Rename a recording and/or move it into a folder.
      operationId: ""
      tags:
        - Transcript
      parameters:
        - in: path
          name: spaceId
          description: >-
            ID of the workspace. You can find from the url in dashboard when you
            open the workspace or using the list workspaces endpoint.
          schema: *ref_4
          required: true
        - in: path
          name: recordingId
          description: >-
            ID of the recording. You can find from the url in dashboard when you
            open the workspace or using the list recordings endpoint.
          schema: *ref_4
          required: true
      responses:
        "200":
          description: Recording metadata
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Recording"
        "400":
          $ref: "#/components/responses/400 - Bad Request"
        "401":
          $ref: "#/components/responses/401 - Unauthorized"
        "403":
          $ref: "#/components/responses/403 - Forbidden"
        "404":
          $ref: "#/components/responses/404 - Not Found"
      requestBody:
        content:
          application/json:
            schema:
              type: object
              properties:
                title:
                  type: string
                  description: New title for the recording.
                recordingFolderId:
                  type: string
                  nullable: true
                  description: >-
                    Move the recording into this folder. Pass null to move it
                    out of any folder, back to the workspace root. Get folder
                    IDs from the List folders endpoint.
        description: >-
          Recording fields to update — provide title, recordingFolderId, or
          both.
      security: &ref_9
        - x-api-key: []
    parameters: []
  /spaces/{spaceId}/recordings/{recordingId}/transcript:
    get:
      summary: Get transcript content
      description: >-
        This will return the contents of the transcript. Can be called only
        after transcription job is completed successfully.
      operationId: get-transcript
      tags:
        - Transcript
      responses:
        "200":
          description: Transcript content in requested format
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/TranscriptJsonContent"
            text:
              schema:
                type: string
            others:
              schema:
                type: string
        "400":
          $ref: "#/components/responses/400 - Bad Request"
        "401":
          $ref: "#/components/responses/401 - Unauthorized"
        "402":
          $ref: "#/components/responses/402 - Payment Required"
        "403":
          $ref: "#/components/responses/403 - Forbidden"
        "404":
          $ref: "#/components/responses/404 - Not Found"
      security: *ref_5
      parameters:
        - in: path
          name: spaceId
          description: >-
            ID of the workspace. You can find from the url in dashboard when you
            open the workspace or using the list workspaces endpoint.
          schema: &ref_6
            type: string
          required: true
        - in: path
          name: recordingId
          description: >-
            ID of the recording. You can find from the url in dashboard when you
            open the workspace or using the list recordings endpoint.
          schema: *ref_6
          required: true
        - in: query
          name: format
          description: |-
            Format of the transcript content. Can be one of:

            - json
            - text
            - csv
            - pdf
            - word
            - srt
            - vtt

            Defaults to **json**
          schema:
            type: string
        - in: query
          name: jsonContentType
          description: >-
            Response format type of JSON contents


            Can be one of 

            - words

            - paragraphs

            - segments


            Details on each format:

            - **Words**: Gives an array of words with timings.

            - **Paragraphs**: Gives an array of paragraphs - constructed using
            our own carefully calibrated heuristics.

            - **Segments**: Gives an array of segments as given by Whisper
            model.


            Defaults to **paragraphs**
          schema: *ref_4
        - in: query
          name: subMaxCharactersPerLine
          description: >-
            Maximum characters per line of subtitle. Lines cannot be shorter
            than a single word.


            Only relavent for subtitle formats
          schema: &ref_7
            type: integer
        - in: query
          name: subMaxSecondsPerLine
          description: >-
            Maximum duration in seconds per subtitle block. Subtitle blocks cannot be shorter than
            a single word.


            Only relevant for subtitle formats
          schema: *ref_7
        - in: query
          name: subMaxLinesPerSubtitle
          description: >-
            Maximum number of lines per subtitle block. Controls how many lines
            can appear simultaneously on screen.


            Only relevant for subtitle formats. Defaults to **1**
          schema: *ref_7
        - in: query
          name: docIncludeSpeakers
          description: >-
            If set, document formats will include speaker information for each
            paragraphs.


            Only relavent for text, csv, word formats. Defaults to **true**
          schema: &ref_8
            type: boolean
        - in: query
          name: docIncludeTimestamps
          description: >-
            If set, document formats will include time information for each
            paragraphs.



            Only relavent for text, csv, word formats. Defaults to **true**
          schema: *ref_8
        - in: query
          name: docIncludeTlolBranding
          description: |-
            If set, document formats will include limited transcript branding.


            Only relavent for text, pdf, word formats. Defaults to **true**
          schema: *ref_4
        - in: query
          name: startTime
          description: >-
            If set, only transcript content from this time onward (in seconds)
            is returned. Omit for the start of the recording.


            Combine with endTime to fetch a single time window — e.g. the
            portion around a search match.
          schema:
            type: number
        - in: query
          name: endTime
          description: >-
            If set, only transcript content up to this time (in seconds) is
            returned. Omit for the end of the recording.
          schema:
            type: number
    parameters: []
  /spaces/{spaceId}/recordings/{recordingId}/translations:
    get:
      summary: List translations
      description: This will list all translations generated for this recording
      operationId: ""
      tags:
        - Translation
      parameters:
        - in: path
          name: spaceId
          description: >-
            ID of the workspace. You can find from the url in dashboard when you
            open the workspace or using the list workspaces endpoint.
          schema: *ref_4
          required: true
        - in: path
          name: recordingId
          description: >-
            ID of the recording. You can find from the url in dashboard when you
            open the workspace or using the list recordings endpoint.
          schema: *ref_4
          required: true
      responses:
        "200":
          headers: {}
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/Translation"
                description: Translations generated for the recording
          description: Translations
        "400":
          $ref: "#/components/responses/400 - Bad Request"
        "401":
          $ref: "#/components/responses/401 - Unauthorized"
        "403":
          $ref: "#/components/responses/403 - Forbidden"
        "404":
          $ref: "#/components/responses/404 - Not Found"
      security: *ref_5
    post:
      summary: Create translation
      description: >-
        Create a new translation for the recording in the specified target
        language.
      operationId: ""
      tags:
        - Translation
      parameters:
        - in: path
          name: spaceId
          description: >-
            ID of the workspace. You can find from the url in dashboard when you
            open the workspace or using the list workspaces endpoint.
          schema: *ref_4
          required: true
        - in: path
          name: recordingId
          description: >-
            ID of the recording. You can find from the url in dashboard when you
            open the workspace or using the list recordings endpoint.
          schema: *ref_4
          required: true
      responses:
        "200":
          description: Translation metadata
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Translation"
        "400":
          $ref: "#/components/responses/400 - Bad Request"
        "401":
          $ref: "#/components/responses/401 - Unauthorized"
        "402":
          $ref: "#/components/responses/402 - Payment Required"
        "403":
          $ref: "#/components/responses/403 - Forbidden"
        "404":
          $ref: "#/components/responses/404 - Not Found"
      security: *ref_5
      requestBody:
        description: Translation options
        content:
          application/json:
            schema:
              type: object
              properties:
                language:
                  $ref: "#/components/schemas/LanguageCode"
                  description: >-
                    Target language code for the translation. The translation
                    will convert the transcript into this language.
              required:
                - language
            examples:
              example1:
                value:
                  language: es
    parameters: []
