    "/drivewealth/dw/violations": {
      "get": {
        "operationId": "getViolations",
        "tags": [
          "dw"
        ],
        "description": "Get account violations for the user's DW account",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "goodFaithViolations": {
                      "type": "number"
                    },
                    "patternDayTrades": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          },
