    "/kyc/{entity}/{formId}": {
      "get": {
        "operationId": "get_user_kyc",
        "tags": [
          "kyc"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "formId",
            "required": true
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "entity",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "entity": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "user_id": {
                      "type": "string"
                    },
                    "form_instance_id": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "INCOMPLETE",
                        "PENDING_DOCUMENTS_UPLOAD",
                        "PENDING_DOCUMENTS_VERIFICATION",
                        "DOCUMENTS_REJECTED",
                        "LEVEL_1_COMPLETED",
                        "APPROVED",
                        "PENDING_KYC_REVIEW",
                        "REJECTED",
                        "INACTIVE"
                      ]
                    },
                    "section": {
                      "type": "number"
                    },
                    "answers": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string"
                      }
                    },
                    "account_type": {
                      "default": "amana",
                      "type": "string",
                      "enum": [
                        "amana",
                        "mt5_netting",
                        "mt5_hedged",
                        "mt4",
                        "copy_trading",
                        "snb"
                      ]
                    },
                    "trading_accounts": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "external_id": {
                            "type": "string"
                          },
                          "external_user": {
                            "type": "string"
                          },
                          "type": {
                            "type": "string"
                          },
                          "currency": {
                            "type": "string"
                          },
                          "group": {
                            "type": "string"
                          },
                          "kyc_id": {
                            "type": "string"
                          },
                          "last_active": {
                            "type": "string",
                            "format": "date-time",
                            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
                          }
                        },
                        "required": [
                          "id",
                          "external_id",
                          "type",
                          "currency",
                          "group",
                          "kyc_id"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "created_at": {
                      "type": "string"
                    },
                    "updated_at": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "entity",
                    "id",
                    "name",
                    "user_id",
                    "form_instance_id",
                    "status",
                    "section",
                    "answers",
                    "account_type",
                    "created_at",
                    "updated_at"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
