    "/topmovers": {
      "get": {
        "operationId": "getTopMovers",
        "summary": "Get top moving symbols",
        "tags": [
          "watchlists"
        ],
        "description": "Retrieves a list of top moving trading symbols based on market activity",
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 10
            },
            "in": "query",
            "name": "count",
            "required": false
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "sector",
            "required": false,
            "description": "Sector filter. comma separated numbers"
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "industry",
            "required": false,
            "description": "Industry filter. comma separated numbers"
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "_id": {
                        "type": "string",
                        "description": "Unique identifier for the symbol"
                      },
                      "logo": {
                        "type": "string",
                        "format": "uri",
                        "description": "URL to symbol logo/image"
                      },
                      "friendlyName": {
                        "type": "string",
                        "description": "User friendly name of the symbol"
                      },
                      "percent": {
                        "type": "number",
                        "description": "Percentage change"
                      },
                      "chg": {
                        "type": "number",
                        "description": "Absolute change"
                      },
                      "price": {
                        "type": "number",
                        "description": "Current price"
                      },
                      "digits": {
                        "type": "integer",
                        "description": "Number of decimal places for the price"
                      },
                      "delayed": {
                        "type": "boolean",
                        "description": "Indicates if the data is delayed"
                      },
                      "leveraged": {
                        "type": "boolean",
                        "description": "Indicates if the symbol is leveraged"
                      },
                      "sharia": {
                        "type": "boolean",
                        "description": "Indicates if the symbol is Sharia compliant"
                      },
                      "close": {
                        "type": "number",
                        "description": "Previous closing price"
                      }
                    },
                    "required": [
                      "_id",
                      "logo",
                      "friendlyName",
                      "percent",
                      "chg",
                      "price",
                      "digits",
                      "close"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
