{
  "openapi": "3.0.3",
  "info": {
    "title": "Amana API",
    "version": "1.0.0",
    "description": "API documentation for Amana Api",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/ALZALABANY_1/onboarding-api/1.0.0"
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT token obtained from authentication endpoints"
      }
    },
    "schemas": {}
  },
  "paths": {
    "/health": {
      "get": {
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/trending": {
      "get": {
        "operationId": "getTrendingSymbols",
        "summary": "Get trending symbols",
        "tags": [
          "symbols"
        ],
        "description": "Retrieves a list of trending trading symbols",
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "_id": {
                        "type": "string"
                      },
                      "logo": {
                        "type": "string"
                      },
                      "friendlyName": {
                        "type": "string"
                      },
                      "price": {
                        "type": "number"
                      },
                      "daily": {
                        "type": "number"
                      },
                      "digits": {
                        "type": "number"
                      },
                      "delayed": {
                        "default": false,
                        "type": "boolean"
                      },
                      "leveraged": {
                        "default": false,
                        "type": "boolean"
                      },
                      "sharia": {
                        "default": false,
                        "type": "boolean"
                      },
                      "close": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "_id",
                      "logo",
                      "friendlyName",
                      "price",
                      "daily",
                      "digits",
                      "delayed",
                      "leveraged",
                      "sharia",
                      "close"
                    ],
                    "additionalProperties": false
                  }
                }
              }
            }
          }
        }
      }
    },
    "/alerts/": {
      "get": {
        "operationId": "getAlerts",
        "summary": "Retrieve all price alerts for the authenticated user",
        "tags": [
          "alerts"
        ],
        "description": "Fetches a list of price alerts associated with the logged-in user.",
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "symbol": {
                        "type": "string"
                      },
                      "price": {
                        "type": "number"
                      },
                      "notification_methods": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "required": [
                      "id",
                      "price",
                      "notification_methods",
                      "symbol"
                    ],
                    "additionalProperties": false
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createAlert",
        "summary": "Create a new price alert for the authenticated user",
        "tags": [
          "alerts"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "symbol": {
                    "type": "string"
                  },
                  "price": {
                    "type": "number"
                  },
                  "notification_methods": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "PUSH",
                        "EMAIL",
                        "SMS"
                      ]
                    }
                  }
                },
                "required": [
                  "symbol",
                  "price",
                  "notification_methods"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "success"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "500": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
