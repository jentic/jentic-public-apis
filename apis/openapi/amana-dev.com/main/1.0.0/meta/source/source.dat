    "/mt/etp/balances": {
      "post": {
        "operationId": "processEtpBalances",
        "summary": "Process ETP balances CSV",
        "tags": [
          "mt"
        ],
        "description": "Apply balance adjustments for each row (login,balance,comment) streaming progress back to client.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "csv": {
                    "type": "string",
                    "minLength": 10
                  },
                  "pin": {
                    "type": "string"
                  },
                  "type": {
                    "type": "number",
                    "enum": [
                      2,
                      3,
                      6,
                      15
                    ],
                    "description": "Balance adjustment type (MT5 internal code)",
                    "default": 15
                  }
                },
                "required": [
                  "csv"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Streamed CSV with appended Deal id column",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "description": "Streamed CSV with appended Deal id column"
                }
              }
            }
          },
          "400": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
