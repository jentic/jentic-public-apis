    "/trading/activity": {
      "get": {
        "operationId": "getUserActivity",
        "summary": "Get current user activity",
        "tags": [
          "trading"
        ],
        "description": "Retrieves all deals for the authenticated user",
        "parameters": [
          {
            "schema": {
              "type": "number"
            },
            "in": "query",
            "name": "to",
            "required": true,
            "description": "End timestamp in milliseconds"
          },
          {
            "schema": {
              "type": "number",
              "default": 3
            },
            "in": "query",
            "name": "count",
            "required": false,
            "description": "Number of days to look back from \"to\" timestamp"
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "symbol",
            "required": false,
            "description": "Filter by symbol"
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "deals": {
                      "type": "array",
                      "items": {
                        "oneOf": [
                          {
                            "type": "object",
                            "properties": {
                              "reason": {
                                "type": "string",
                                "enum": [
                                  "money"
                                ]
                              },
                              "id": {
                                "type": "string"
                              },
