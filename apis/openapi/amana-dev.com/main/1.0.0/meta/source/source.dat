      "post": {
        "operationId": "placeOrder",
        "summary": "Place a new trade order",
        "tags": [
          "trading"
        ],
        "description": "Opens a new position or places a pending order",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "symbol": {
                    "type": "string",
                    "description": "Trading symbol"
                  },
                  "side": {
                    "type": "string",
                    "enum": [
                      "buy",
                      "sell"
                    ],
                    "description": "Trade direction"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "unit",
                      "amount"
                    ],
                    "description": "Amount type"
                  },
                  "amount": {
                    "type": "number",
                    "minimum": 0,
                    "description": "Trade amount"
                  },
                  "sl": {
                    "type": "number",
                    "minimum": 0,
                    "description": "Stop Loss price"
                  },
                  "tp": {
                    "type": "number",
                    "minimum": 0,
                    "description": "Take Profit price"
                  },
                  "price": {
                    "type": "number",
                    "minimum": 0,
                    "description": "Limit order price"
                  },
                  "slAmount": {
                    "type": "number",
                    "description": "Stop Loss amount (for amount type)"
                  },
                  "tpAmount": {
                    "type": "number",
                    "description": "Take Profit amount (for amount type)"
                  }
                },
                "required": [
                  "symbol",
                  "side",
                  "type",
                  "amount"
                ],
                "additionalProperties": false
              }
            }
          }
        },
