                              },
                              "profit": {
                                "type": "number"
                              },
                              "digits": {
                                "default": 2,
                                "type": "number"
                              },
                              "comment": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "reason",
                              "id",
                              "time",
                              "type",
                              "profit",
                              "digits",
                              "comment"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "reason": {
                                "type": "string"
                              },
                              "id": {
                                "type": "string"
                              },
                              "login": {
                                "type": "string"
                              },
                              "symbol": {
                                "type": "string",
                                "minLength": 1
                              },
                              "logo": {
                                "type": "string"
                              },
                              "friendlyName": {
                                "type": "string"
                              },
                              "delayed": {
                                "type": "boolean"
                              },
                              "sharia": {
                                "type": "boolean"
                              },
                              "leverage": {
                                "type": "number"
                              },
                              "order": {
                                "type": "string"
                              },
                              "position": {
                                "type": "string"
                              },
                              "time": {
                                "type": "number"
                              },
                              "type": {
                                "type": "string"
                              },
                              "dir": {
                                "type": "string"
                              },
                              "digits": {
                                "type": "number"
                              },
                              "units": {
                                "type": "number"
                              },
                              "invested": {
                                "type": "number"
                              },
                              "sl": {
                                "type": "number"
                              },
                              "tp": {
                                "type": "number"
                              },
                              "priceOpen": {
                                "type": "number"
                              },
                              "profit": {
                                "type": "number"
                              },
                              "commission": {
                                "type": "number"
                              },
                              "storage": {
                                "type": "number"
                              },
                              "fee": {
