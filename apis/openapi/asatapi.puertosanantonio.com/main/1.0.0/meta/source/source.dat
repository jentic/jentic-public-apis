    "/api/v2/auth/getToken": {
      "post": {
        "summary": "getTokenApp",
        "description": "getTokenApp",
        "operationId": "gettokenapp",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "grant_type": {
                    "type": "string",
                    "example": "client_credentials"
                  }
                }
              },
              "examples": {
                "getTokenApp": {
                  "value": {
                    "grant_type": "client_credentials"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "basicAuth": []
          }
        ]
      }
    },
    "/api/entrances/AddVirtualEntrance": {
      "post": {
        "summary": "AddVirtualEntrance",
        "description": "AddVirtualEntrance",
        "operationId": "addvirtualentrance",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "containerId": {
                    "type": "string",
                    "example": "MACU8494510"
                  },
                  "isocode": {
                    "type": "string",
                    "example": "22G1"
                  },
                  "licencePlate": {
                    "type": "string",
                    "example": "ABCD19"
                  },
                  "timestamp": {
                    "type": "string",
                    "example": "2025-11-04T14:32:44.801Z"
                  }
                }
              },
              "examples": {
                "AddVirtualEntrance": {
                  "value": {
                    "containerId": "MACU8494510",
                    "isocode": "22G1",
                    "licencePlate": "ABCD19",
                    "timestamp": "2025-11-04T14:32:44.801Z"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
