    "/like/create": {
      "post": {
        "tags": [
          "Like"
        ],
        "summary": "Toggle like/unlike for a post or comment",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateLikeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Like toggled successfully",
            "content": {
              "application/json": {
                "examples": {
                  "likeAdded": {
                    "summary": "Added a new like",
                    "value": {
                      "result": "Success",
                      "responseObj": {
                        "responseId": "res_891a7f",
                        "responseTs": 1730463021,
                        "responseApiVersion": "v1",
                        "responseCode": 200,
                        "responseMessage": "Like added successfully!",
                        "responseDataParams": {
                          "data": {
                            "guid": "like_672f0d0f91",
                            "currentUserLiked": true,
                            "likeCounter": 12
                          }
                        }
                      }
                    }
                  },
                  "likeRemoved": {
                    "summary": "Like removed",
                    "value": {
                      "result": "Success",
                      "responseObj": {
                        "responseId": "res_891a8a",
                        "responseTs": 1730463025,
                        "responseApiVersion": "v1",
                        "responseCode": 200,
                        "responseMessage": "Like removed successfully!",
                        "responseDataParams": {
                          "data": {
                            "guid": "like_672f0d0f91",
                            "currentUserLiked": false,
                            "likeCounter": 11
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing required field",
            "content": {
              "application/json": {
                "example": {
                  "result": "Error",
                  "responseObj": {
                    "responseId": "err_901b22",
                    "responseTs": 1730463026,
                    "responseApiVersion": "v1",
                    "responseCode": 400,
                    "responseMessage": "User GUID is required!"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Unauthorized like attempt",
            "content": {
              "application/json": {
                "example": {
                  "result": "Error",
                  "responseObj": {
                    "responseId": "err_902a12",
                    "responseTs": 1730463028,
                    "responseApiVersion": "v1",
                    "responseCode": 403,
                    "responseMessage": "You are not allowed to like this post."
                  }
                }
              }
            }
          },
          "404": {
            "description": "Post or user not found",
            "content": {
              "application/json": {
                "example": {
                  "result": "Error",
                  "responseObj": {
                    "responseId": "err_903b21",
                    "responseTs": 1730463031,
                    "responseApiVersion": "v1",
                    "responseCode": 404,
                    "responseMessage": "Post not found!"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "example": {
                  "result": "Error",
                  "responseObj": {
                    "responseId": "err_904c11",
                    "responseTs": 1730463035,
                    "responseApiVersion": "v1",
                    "responseCode": 500,
                    "responseMessage": "Database connection failed!"
                  }
                }
              }
            }
          }
        }
      }
    },
