          {
            "name": "guid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "object",
                    "properties": {
                      "message": {
                        "type": "string"
                      },
                      "approval_status": {
                        "type": "integer",
                        "enum": [
                          0,
                          1,
                          2
                        ]
                      },
                      "reason": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "url": {
                        "type": "string",
                        "nullable": true
                      },
                      "video_url": {
                        "type": "string",
                        "nullable": true
                      },
                      "video_id": {
                        "type": "string",
                        "nullable": true
                      },
                      "content": {
                        "type": "object",
                        "properties": {
                          "metadata": {
                            "type": "object",
                            "properties": {
                              "visibility": {
                                "type": "integer"
                              },
                              "pinned": {
                                "type": "boolean"
                              },
                              "archived": {
                                "type": "boolean"
                              },
                              "hidden": {
                                "type": "boolean"
                              },
                              "locked_comments": {
                                "type": "boolean"
                              },
                              "scheduled_at": {
                                "type": "string",
                                "format": "date-time"
                              }
