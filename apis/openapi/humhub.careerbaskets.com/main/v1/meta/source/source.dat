  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "ModelParam": {
        "name": "model",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string",
          "enum": [
            "post",
            "comment"
          ]
        },
        "example": "post"
      },
      "AuthHeader": {
        "name": "Authorization",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "example": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VyX2lkIjoxMjM0LCJuYW1lIjoiRGhhcmFuaXNoIiwiaWF0IjoxNzMwMDAwMDAwfQ.abc123XYZ456def789"
        }
      },
      "ObjectGuidParam": {
        "name": "guid",
