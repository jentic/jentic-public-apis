{
  "openapi": "3.0.3",
  "info": {
    "title": "EdEE (Custom HumHub) API",
    "version": "v1",
    "description": "This is the official REST API documentation for **EdEE**, a customized platform built on top of the HumHub framework.  \nThe API extends HumHub’s core functionalities to support EdEE’s specific use cases, including enhanced post management,  \nevent handling, membership logic, notifications, and user engagement features.\n\nAll endpoints follow REST conventions and return responses in a standardized JSON format for easy integration  \nwith mobile apps, SDKs, and external systems.\n\n🔐 **Note:** Most endpoints require Bearer Token authentication.  \n⚙️ **Tip:** Use the “Authorize” button in the Swagger UI to provide your token before testing endpoints.\n",
    "license": {
      "name": "EdEE",
      "url": "https://edee.careerbaskets.com/terms"
    },
    "termsOfService": "https://edee.careerbaskets.com/terms",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/RAMESHARAVINDHKARTHI/edee-custom-humhub-api/v1"
  },
  "servers": [
    {
      "url": "https://humhub.careerbaskets.com/api/v1",
      "description": "Staging Server (Pre-production)"
    }
  ],
  "paths": {
    "/follow": {
      "post": {
        "summary": "Follow or Unfollow a User or Forum",
        "description": "Toggle follow relationship. Creates notification for users.\nSupports `user` or `forum` (space).\n",
        "tags": [
          "Follow"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "follower_guid",
                  "followee_guid",
                  "category_type"
                ],
                "properties": {
                  "follower_guid": {
                    "type": "string",
                    "description": "GUID of the user who wants to follow",
                    "example": "u101"
                  },
                  "followee_guid": {
                    "type": "string",
                    "description": "GUID of the target user or forum",
                    "example": "u102"
                  },
                  "category_type": {
                    "type": "string",
                    "enum": [
                      "user",
                      "forum"
                    ],
                    "description": "Type of entity to follow",
                    "example": "user"
                  }
                }
              },
              "example": {
                "follower_guid": "u101",
                "followee_guid": "u102",
                "category_type": "user"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Follow status toggled",
            "content": {
              "application/json": {
                "examples": {
                  "follow": {
                    "summary": "Now following",
                    "value": {
                      "result": "Success",
                      "responseObj": {
                        "responseId": "674f2a1b9c8d7",
                        "responseTs": 1731500000,
                        "responseApiVersion": "v1",
                        "responseCode": 200,
                        "responseMessage": "Now following the user.",
                        "responseDataParams": {
                          "data": {
                            "followerGuid": "u101",
                            "followeeGuid": "u102",
                            "categoryType": "user",
                            "isFollowing": true
                          }
                        }
                      }
                    }
                  },
                  "unfollow": {
                    "summary": "Unfollowed",
                    "value": {
                      "result": "Success",
                      "responseObj": {
                        "responseId": "674f2a2c8d9e1",
                        "responseTs": 1731500100,
                        "responseApiVersion": "v1",
                        "responseCode": 200,
                        "responseMessage": "Unfollowed the user.",
                        "responseDataParams": {
                          "data": {
                            "followerGuid": "u101",
                            "followeeGuid": "u102",
                            "categoryType": "user",
                            "isFollowing": false
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "examples": {
                  "missing_params": {
                    "summary": "Missing required fields",
                    "value": {
                      "result": "Error",
                      "responseObj": {
                        "responseCode": 400,
                        "responseMessage": "follower_guid, followee_guid, and category_type are required."
                      }
                    }
                  },
                  "invalid_type": {
                    "summary": "Invalid category_type",
                    "value": {
                      "result": "Error",
                      "responseObj": {
                        "responseCode": 400,
                        "responseMessage": "Invalid category_type. Must be \"user\" or \"forum\"."
                      }
                    }
                  },
                  "self_follow": {
                    "summary": "Cannot follow self",
                    "value": {
                      "result": "Error",
                      "responseObj": {
                        "responseCode": 400,
                        "responseMessage": "You cannot follow yourself."
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "example": {
                  "result": "Error",
                  "responseObj": {
                    "responseCode": 500,
                    "responseMessage": "Could not follow the user."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/activity/": {
      "get": {
        "summary": "List All Activities",
        "description": "Global activity stream (excluding own content). Skips posts with `approval_status != 1`.\n",
        "tags": [
          "Activities"
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Activity stream",
            "content": {
              "application/json": {
                "example": {
                  "result": "Success",
                  "responseObj": {
                    "responseId": "673a1f2e9d4c1",
