    "/post/container/:{containerId}": {
      "get": {
        "summary": "Get posts by container",
        "description": "Fetches a paginated list of posts that belong to a specific container (e.g., space, group, or forum).\nRequires valid authentication if the container is private.\n",
        "tags": [
          "Posts"
        ],
        "parameters": [
          {
            "name": "containerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Numeric ID of the container to fetch posts from."
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            },
            "description": "Page number for pagination."
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 10
            },
            "description": "Number of posts to fetch per page."
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "newest",
                "oldest",
                "trending"
              ],
              "default": "newest"
            },
            "description": "Sort order of the posts."
