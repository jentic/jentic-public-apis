    "/activity/my": {
      "get": {
        "summary": "My Activities (Filtered by Type)",
        "description": "Fetch user's own activities. Optional `type` filter:\n- `post`, `comment`, `like`, `forum`, `forum_join`, `event`, `event_join`\n",
        "tags": [
          "Activities"
        ],
        "parameters": [
          {
            "name": "guid",
            "in": "query",
            "description": "Fetch for another user (admin only)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "post",
                "comment",
                "like",
                "forum",
                "forum_join",
                "event",
                "event_join"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "My activities",
            "content": {
              "application/json": {
                "examples": {
                  "all": {
                    "summary": "All activities",
                    "value": {
