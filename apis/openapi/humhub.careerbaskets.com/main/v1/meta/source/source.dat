    "/post/container/{containerId}": {
      "post": {
        "summary": "Create a post",
        "description": "Creates a post in a forum/space. Approval is required unless the user is the owner.",
        "tags": [
          "Posts"
        ],
        "parameters": [
          {
            "name": "containerId",
            "in": "path",
            "required": true,
            "description": "Content-container (forum/space) ID",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "data"
                ],
                "properties": {
                  "data": {
                    "type": "object",
                    "required": [
                      "message"
                    ],
                    "properties": {
                      "message": {
                        "type": "string",
                        "example": "Just testing out the new forum"
                      },
                      "url": {
                        "type": "string",
                        "nullable": true
                      },
                      "video_url": {
                        "type": "string",
                        "nullable": true
                      },
                      "video_id": {
                        "type": "string",
                        "nullable": true
                      },
                      "content": {
                        "type": "object",
                        "properties": {
                          "metadata": {
                            "type": "object",
                            "properties": {
                              "visibility": {
                                "type": "integer",
                                "enum": [
                                  0,
                                  1,
                                  2
                                ],
                                "description": "0=private, 1=public, 2=protected"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              "example": {
                "data": {
                  "message": "Just testing out the new forum",
                  "content": {
                    "metadata": {
                      "visibility": 1
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Post created (may be pending approval)",
