      },
      "PageParam": {
        "name": "page",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "description": "Page number for pagination"
      },
      "LimitParam": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        },
        "description": "Number of items per page"
      },
      "messageId": {
        "name": "messageId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer"
        },
        "description": "Group‑chat ID (same as `message_id` in DB)"
      },
      "groupId": {
        "name": "groupId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer"
        },
        "description": "Alias for `messageId`"
      },
      "guid": {
        "name": "guid",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "User GUID"
      },
      "filterValue": {
        "name": "filterValue",
        "in": "query",
        "schema": {
          "type": "string"
        }
      },
      "q": {
        "name": "q",
        "in": "query",
        "schema": {
          "type": "string"
        }
      },
      "ApprovalStatusParam": {
        "name": "approval_status",
        "in": "query",
        "schema": {
          "type": "integer",
          "enum": [
            0,
            1,
            2
          ]
        },
        "description": "0=pending,1=approved,2=rejected"
      },
      "FilterValueParam": {
        "name": "filterValue",
        "in": "query",
        "schema": {
          "type": "string"
        },
        "description": "Search string applied to forum name and description"
      },
      "ForumGuidParam": {
        "name": "guid",
