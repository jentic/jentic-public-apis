{
  "openapi": "3.1.0",
  "info": {
    "title": "Houzz Pro API v1",
    "version": "0.1.0",
    "description": "The Houzz Pro API gives verified partners programmatic access to the data and workflows that pros use every day — projects, leads, contacts, tasks, scheduling, files, and more.\n\nAll endpoints require OAuth 2.0 authentication using the client credentials flow. Include a Bearer token in the `Authorization` header on every request. Tokens are issued per scope; the required scope is listed under the **Authorization** section of each operation.\n\n**Base URL:** `https://pro-api.houzz.com/api`\n\n**Versioning:** All endpoints are prefixed with `/v1`. Breaking changes will be introduced under a new version prefix.\n\n**Pagination:** List endpoints accept `limit` (max 300, default 20) and `offset` query parameters and return `{ data, limit, offset, total }`.\n\n**Errors:** All errors return `{ error: { code, message } }` with a standard HTTP status code."
  },
  "servers": [
    {
      "url": "https://pro-api.houzz.com/api"
    }
  ],
  "tags": [
    {
      "name": "PostalAddress",
      "description": "A postal location — street, city, state, postal code, country. Postal addresses do not have their own endpoints; they appear inline on the resources that carry them. Project and lead addresses additionally carry an id and a name (see those resources)."
    },
    {
      "name": "CustomField",
      "description": "A custom field definition scoped to a company and an entity type. Used by integrations to store cross-reference IDs such as external_id."
    },
    {
      "name": "CustomFieldEntry",
      "description": "Reads and writes custom field entry values on any entity. Used by integrations to store cross-reference IDs such as external_id after creating a record."
    },
    {
      "name": "Project",
      "description": "A project tracks an active home improvement job managed by a pro. Projects are linked to a client, carry a status, budget, type, and one or more addresses. Related resources such as tasks, milestones, daily logs, and files are scoped under a project. Archiving a project hides it from active views without deleting it; the delete operation permanently removes the project."
    },
    {
      "name": "Project Status",
      "description": "A project status represents a workflow state for a project (e.g. Active, On Hold, Completed). This is a read-only reference list that includes both system-defined and account-specific custom statuses. Retrieve available statuses and pass the desired statusId when creating or updating a project."
    },
    {
      "name": "Project Type",
      "description": "A project type is a custom categorization label defined by the pro's account (e.g. Kitchen Remodel, New Construction). This is a read-only reference list — retrieve available types and pass the desired type ID as the projectType field when creating or updating a project."
    },
    {
      "name": "Lead",
      "description": "A lead (also called an inquiry) tracks a potential job opportunity before it becomes a formal project. Leads capture client interest, budget, expected start date, and current pipeline phase. A lead can be converted to a project — once converted, the associated projectId is populated. Leads support soft deletion via archiving."
    },
    {
      "name": "Lead Phase",
      "description": "A lead phase represents a stage in the pre-project sales pipeline. Built-in phases include New Inquiry, Follow Up, Meeting, Estimate, Connected, and Won; accounts may also define custom phases with their own IDs. This is a read-only reference list — retrieve available phases and pass the desired phaseId when creating or updating a lead."
    },
    {
      "name": "Milestone",
      "description": "A milestone is an item on a project or lead schedule. Milestones form a hierarchy by milestoneType: a PHASE is a top-level grouping without its own dates, while ITEM and CHECKPOINT rows carry start/due dates and a status (OPEN or COMPLETED) and are nested under a phase via parentMilestoneId. When a schedule baseline has been set, milestones also expose baseline planned dates. Tasks can be linked to a milestone. List and create operations are scoped under the parent resource path (e.g. /v1/projects/:projectId/milestones)."
    },
    {
      "name": "Daily Log",
      "description": "A daily log is a timestamped field note attached to a project. Pros use daily logs to record on-site activity, progress notes, or events for a specific date range. Each log belongs to exactly one project and supports free-text content."
    },
    {
      "name": "Punchlist",
      "description": "A punchlist is a shared checklist of outstanding items attached to a project, used to track completion items before handover. Each project has exactly one punchlist; if none exists yet, it is created automatically the first time it is fetched, so there is no separate punchlist-creation endpoint. The punchlist itself can be set to Private or Shared visibility; individual punchlist items are managed through the Tasks resource."
    },
    {
      "name": "Task",
      "description": "A task is an actionable work item belonging to a project, lead, or punchlist. Tasks have a title, optional due date, completion status, and visibility (Private or Shared). Tasks can be linked to a milestone for scheduling purposes. List and create operations are scoped under the parent resource path (e.g. /v1/projects/:projectId/tasks). Punchlist tasks are created by supplying a punchlistId on the project task create endpoint. A task's parent and any punchlist link are fixed at creation and cannot be changed afterward."
    },
    {
      "name": "File",
      "description": "A file represents an uploaded document, image, or other asset attached to a project or other resource. Files are organized in a folder hierarchy — both files and folders are returned by this resource (distinguished by the type field). Files can be archived or permanently deleted. Additional operations allow creating folders and bulk-copying or moving files between locations."
    },
    {
      "name": "Team Member",
      "description": "A team member is an internal employee or staff person on a pro's account. Team members are invited by email, assigned a role, and can have a status of PENDING, CONNECTED, or DEACTIVATED. The delete operation deactivates the team member rather than permanently removing them from the account."
    },
    {
      "name": "Subcontractor",
      "description": "A subcontractor is an external trade professional or company invited to collaborate on a pro's jobs. Subcontractors are identified by their trade specializations and can have a status of PENDING, CONNECTED, or DEACTIVATED. Creating a subcontractor sends an invitation to the provided email address. The delete operation deactivates the subcontractor rather than permanently removing them."
    },
    {
      "name": "Subcontractor Trade",
      "description": "A subcontractor trade represents a specialized construction discipline (e.g. Electrical, Plumbing, HVAC). This is a read-only reference list — retrieve available trades and pass the desired trade IDs when creating or updating a subcontractor."
    },
    {
      "name": "Vendor",
      "description": "A vendor is a business or individual that provides materials, products, or services to a pro. Vendors are scoped at the company level and can be linked to catalog items, purchase orders, purchase documents, contracts, and project items. They carry contact details, payment terms, tax settings, and account information used in purchasing workflows. Vendors are never permanently deleted — retire one with the archive operation, and restore it with unarchive."
    },
    {
      "name": "Contact",
      "description": "A contact represents an individual person in a pro's address book — typically a homeowner, business owner, or other point of contact. Contacts can be associated with projects, belong to a contact group, and carry contact details such as email, phone, and address. Deleting a contact is permanent and optionally removes any connected leads."
    },
    {
      "name": "Contact Group",
      "description": "A contact group is a named collection of contacts (homeowners or businesses) that belong to a pro's account, also referred to internally as a CRM account. Groups can be typed as HOMEOWNER or BUSINESS and support soft deletion via the archived flag. Each group can have multiple contacts linked at either PRIMARY or SECONDARY level."
    },
    {
      "name": "Contact Group Contact",
      "description": "A contact-group membership links an individual contact to a contact group at a designated level (PRIMARY or SECONDARY). Use these endpoints to add a contact to a group, change their level, or remove them from the group. Add and update operations return the updated contact group, including its full contactGroupConnections list (the graph mutations return the parent group; individual connections are not addressable in the response)."
    },
    {
      "name": "Entity Assignment",
      "description": "Read and manage the assignees on a supported entity. An assignee can be a pro team member or subcontractor, a client, or a person who has been invited but has not yet joined the team."
    },
    {
      "name": "Webhook Subscription",
      "description": "A webhook subscription registers an HTTPS endpoint to receive real-time event notifications for your Houzz Pro account. Each subscription targets one URL and can be configured with one or more triggers that determine which resource events (create, update, delete) trigger a delivery. Subscriptions are scoped to your company and enforced via service discovery against the houzz-api-grpc deployment."
    },
    {
      "name": "Webhook Trigger",
      "description": "A webhook trigger represents a specific event type on a resource that can fire a webhook delivery. This endpoint returns the full catalog of available triggers across all supported resources. Subscribe to a trigger by referencing its resourceName and eventType when configuring a webhook subscription. The complete catalog is listed below.\n\n### Available triggers\n\n| resourceName | eventType | label | description |\n| --- | --- | --- | --- |\n| `client` | `create` | Client Created | Fires when a new client is added to the company |\n| `client` | `update` | Client Updated | Fires when a client record is modified |\n| `client` | `delete` | Client Deleted | Fires when a client is removed from the company |\n| `project` | `create` | Project Created | Fires when a new project is created |\n| `project` | `update` | Project Updated | Fires when a project is modified |\n| `project` | `delete` | Project Deleted | Fires when a project is deleted |\n| `lead` | `create` | Lead Created | Fires when a new lead is received |\n| `lead` | `update` | Lead Updated | Fires when a lead record is modified |\n| `lead` | `delete` | Lead Deleted | Fires when a lead is removed |\n| `task` | `create` | Task Created | Fires when a new task is created |\n| `task` | `update` | Task Updated | Fires when a task is modified |\n| `task` | `delete` | Task Deleted | Fires when a task is deleted |\n| `milestone` | `create` | Milestone Created | Fires when a new milestone is created |\n| `milestone` | `update` | Milestone Updated | Fires when a milestone is modified |\n| `milestone` | `delete` | Milestone Deleted | Fires when a milestone is deleted |\n| `vendor` | `create` | Vendor Created | Fires when a new vendor is added |\n| `vendor` | `update` | Vendor Updated | Fires when a vendor record is modified |\n| `file` | `create` | File Created | Fires when a new file is uploaded |\n| `file` | `update` | File Updated | Fires when a file record is modified |\n| `file` | `delete` | File Deleted | Fires when a file is permanently deleted from the trash |\n| `team-member` | `create` | Team Member Created | Fires when a new team member is added |\n| `team-member` | `update` | Team Member Updated | Fires when a team member record is modified |\n| `subcontractor` | `create` | Subcontractor Created | Fires when a new subcontractor is added |\n| `subcontractor` | `update` | Subcontractor Updated | Fires when a subcontractor record is modified |\n| `daily-log` | `create` | Daily Log Created | Fires when a new daily log is created |\n| `daily-log` | `update` | Daily Log Updated | Fires when a daily log is modified |\n| `daily-log` | `delete` | Daily Log Deleted | Fires when a daily log is deleted |\n| `contact-group` | `create` | Contact Group Created | Fires when a new contact group is created |\n| `contact-group` | `update` | Contact Group Updated | Fires when a contact group is modified |\n| `contact-group` | `delete` | Contact Group Deleted | Fires when a contact group is deleted |"
    },
    {
      "name": "Note",
      "description": "A note is a free-text entry attached to exactly one project or lead. Notes can also represent CRM call logs by setting type to CALL_LOG along with a subType describing the outcome of the call. There is no hard delete — archiving (via the archive operation) is the only way to remove a note."
    }
  ],
  "paths": {
    "/v1/customFields": {
      "get": {
        "operationId": "customfield.list",
        "tags": [
          "CustomField"
        ],
        "summary": "List custom field definitions",
        "description": "Filter by customableType",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20,
              "maximum": 300
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0
            }
          },
          {
            "in": "query",
            "name": "customableType",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Filter by entity type the custom field is scoped to. Omit to return custom fields for all entity types.",
              "enum": [
                "Lead",
                "Project",
                "Contact",
                "Vendor",
                "DailyLog",
                "Task"
              ]
            },
            "description": "Filter by entity type the custom field is scoped to. Omit to return custom fields for all entity types."
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/XRateLimitLimit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/XRateLimitRemaining"
              },
              "X-RateLimit-Reset": {
                "$ref": "#/components/headers/XRateLimitReset"
              },
              "X-Usage-Limit": {
                "$ref": "#/components/headers/XUsageLimit"
              },
              "X-Usage-Remaining": {
                "$ref": "#/components/headers/XUsageRemaining"
              },
              "X-Usage-Reset": {
                "$ref": "#/components/headers/XUsageReset"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "limit",
                    "offset"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/CustomField"
                      }
                    },
                    "limit": {
                      "type": "integer"
                    },
                    "offset": {
                      "type": "integer"
                    },
                    "total": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "post": {
        "operationId": "customfield.create",
        "tags": [
          "CustomField"
        ],
        "summary": "Create custom field",
        "description": "Create a custom field definition for a given entity type.",
        "responses": {
          "201": {
            "description": "Success",
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/XRateLimitLimit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/XRateLimitRemaining"
              },
              "X-RateLimit-Reset": {
                "$ref": "#/components/headers/XRateLimitReset"
              },
              "X-Usage-Limit": {
                "$ref": "#/components/headers/XUsageLimit"
              },
              "X-Usage-Remaining": {
                "$ref": "#/components/headers/XUsageRemaining"
              },
              "X-Usage-Reset": {
                "$ref": "#/components/headers/XUsageReset"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/CustomField"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Field name"
                  },
                  "type": {
                    "type": "string",
                    "description": "Field type (text, checkbox, link, date, single_select, duration)"
                  },
                  "customableType": {
                    "type": "string",
                    "description": "Entity type the custom field is scoped to",
                    "enum": [
                      "Lead",
                      "Project",
                      "Contact",
                      "Vendor",
                      "DailyLog",
                      "Task"
                    ]
                  },
                  "description": {
                    "type": "string",
                    "description": "Field description"
                  },
                  "options": {
                    "type": "array",
                    "description": "Options for single_select type",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "name",
                  "type",
                  "customableType"
                ]
              }
            }
          }
        }
      }
    },
    "/v1/customFields/getEntityByCustomFieldValue": {
      "get": {
        "operationId": "customfield.getEntityByCustomFieldValue",
        "tags": [
          "CustomField"
        ],
        "summary": "Get entity by custom field value",
        "description": "Resolve the entity whose custom field named `fieldName` holds `value`. Requires the read scope for the requested entityType — a token without it receives no data.",
        "parameters": [
          {
            "in": "query",
            "name": "entityType",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Entity type to search.",
              "enum": [
                "Lead",
                "Project",
                "Contact",
                "Vendor",
                "DailyLog",
                "Task"
              ]
            },
            "description": "Entity type to search."
          },
          {
            "in": "query",
            "name": "fieldName",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Name of the custom field to match (e.g. external_id)."
            },
            "description": "Name of the custom field to match (e.g. external_id)."
          },
          {
            "in": "query",
            "name": "value",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Value to match against the custom field."
            },
            "description": "Value to match against the custom field."
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/XRateLimitLimit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/XRateLimitRemaining"
              },
              "X-RateLimit-Reset": {
                "$ref": "#/components/headers/XRateLimitReset"
              },
              "X-Usage-Limit": {
                "$ref": "#/components/headers/XUsageLimit"
              },
              "X-Usage-Remaining": {
                "$ref": "#/components/headers/XUsageRemaining"
              },
              "X-Usage-Reset": {
                "$ref": "#/components/headers/XUsageReset"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "entityType": {
                          "type": "string",
                          "description": "Type of the matched entity.",
                          "enum": [
                            "Lead",
                            "Project",
                            "Contact",
                            "Vendor",
                            "DailyLog",
                            "Task"
                          ]
                        },
                        "entityId": {
                          "type": "integer",
                          "description": "ID of the matched entity."
                        },
                        "entity": {
                          "type": "object",
                          "description": "The matched entity, shaped like the corresponding resource — see `entityType` to determine which."
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/customFieldEntries": {
      "get": {
        "operationId": "customfieldentry.list",
        "tags": [
          "CustomFieldEntry"
        ],
        "summary": "List custom field entries",
        "description": "List the custom field entry values stored on a single entity.",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20,
              "maximum": 300
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0
            }
          },
          {
            "in": "query",
            "name": "entityType",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Entity type the custom field entries belong to.",
              "enum": [
                "Lead",
                "Project",
                "Contact",
                "Vendor",
                "DailyLog",
                "Task"
              ]
            },
            "description": "Entity type the custom field entries belong to."
          },
          {
            "in": "query",
            "name": "entityId",
            "required": true,
            "schema": {
              "type": "integer",
              "description": "ID of the entity."
            },
            "description": "ID of the entity."
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/XRateLimitLimit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/XRateLimitRemaining"
              },
              "X-RateLimit-Reset": {
                "$ref": "#/components/headers/XRateLimitReset"
              },
              "X-Usage-Limit": {
                "$ref": "#/components/headers/XUsageLimit"
              },
              "X-Usage-Remaining": {
                "$ref": "#/components/headers/XUsageRemaining"
              },
              "X-Usage-Reset": {
                "$ref": "#/components/headers/XUsageReset"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "limit",
                    "offset"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/CustomFieldEntry"
                      }
                    },
                    "limit": {
                      "type": "integer"
                    },
                    "offset": {
                      "type": "integer"
                    },
                    "total": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "patch": {
        "operationId": "customfieldentry.set",
        "tags": [
          "CustomFieldEntry"
        ],
        "summary": "Set custom field entries",
        "description": "Set custom field entry values on an entity.",
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/XRateLimitLimit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/XRateLimitRemaining"
              },
              "X-RateLimit-Reset": {
                "$ref": "#/components/headers/XRateLimitReset"
              },
              "X-Usage-Limit": {
                "$ref": "#/components/headers/XUsageLimit"
              },
              "X-Usage-Remaining": {
                "$ref": "#/components/headers/XUsageRemaining"
              },
              "X-Usage-Reset": {
                "$ref": "#/components/headers/XUsageReset"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/CustomFieldEntry"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        },
        "security": [
          {
            "bearerAuth": [
              "write:leads"
            ]
          },
          {
            "bearerAuth": [
              "write:projects"
            ]
          },
          {
            "bearerAuth": [
              "write:contacts"
            ]
          },
          {
            "bearerAuth": [
              "write:vendors"
            ]
          },
          {
            "bearerAuth": [
              "write:daily-logs"
            ]
          },
          {
            "bearerAuth": [
              "write:tasks"
            ]
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "entityId": {
                    "type": "integer",
                    "description": "ID of the entity"
                  },
                  "entityType": {
                    "type": "string",
                    "description": "Entity type the custom field entries belong to.",
                    "enum": [
                      "Lead",
                      "Project",
                      "Contact",
                      "Vendor",
                      "DailyLog",
                      "Task"
                    ]
                  },
                  "customFieldEntries": {
                    "type": "array",
                    "description": "Entries to set. Each item needs value plus either id or customFieldId.",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer",
                          "description": "ID of an existing entry to update"
                        },
                        "customFieldId": {
                          "type": "integer",
                          "description": "ID of the custom field definition. Required when id is not given."
                        },
                        "value": {
                          "type": "string",
                          "description": "Value to store"
                        }
                      },
                      "required": [
                        "value"
                      ]
                    }
                  }
                },
                "required": [
                  "entityId",
                  "entityType",
                  "customFieldEntries"
                ]
              }
            }
          }
        }
      }
    },
