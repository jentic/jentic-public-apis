          {
            "bearerAuth": [
              "write:projects"
            ]
          },
          {
            "bearerAuth": [
              "write:leads"
            ]
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "content": {
                    "type": "string",
                    "description": "Note body text"
                  },
                  "type": {
                    "type": "string",
                    "description": "Note type",
                    "enum": [
                      "DEFAULT",
                      "CALL_LOG"
                    ]
                  },
                  "subType": {
                    "type": "string",
                    "description": "Note sub-type (used with CALL_LOG)",
                    "enum": [
                      "NOT_AVAILABLE",
                      "GOOD_DISCUSSION",
                      "NO_ANSWER",
                      "CALL_LATER",
                      "NOT_INTERESTED"
                    ]
                  },
                  "source": {
                    "type": "string",
                    "description": "Originating system"
                  }
                }
              }
            }
          }
        }
      }
    },
