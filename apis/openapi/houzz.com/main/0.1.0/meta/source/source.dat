  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "oauth2",
        "description": "OAuth 2.0 client credentials flow",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://auth.houzz.com/oauth/token",
            "scopes": {
              "read:api-metadata": "View API version and available scopes",
              "read:projects": "View project details and list projects",
              "write:projects": "Create and update projects",
              "admin:projects": "Full administrative access to projects including deletion",
              "read:leads": "View lead details and list leads",
              "write:leads": "Create and update leads",
              "admin:leads": "Full administrative access to leads including deletion",
              "read:schedule": "View milestones and schedule details",
              "write:schedule": "Create and update milestones",
              "admin:schedule": "Full administrative access to schedule including deletion",
              "read:daily-logs": "View daily log details and list daily logs",
              "write:daily-logs": "Create and update daily logs",
              "admin:daily-logs": "Full administrative access to daily logs including deletion",
              "read:tasks": "View tasks, punchlist, and related items",
              "write:tasks": "Create and update tasks and punchlist visibility",
              "admin:tasks": "Full administrative access to tasks including deletion",
              "read:files": "View file details and list files",
              "write:files": "Upload and update files",
              "admin:files": "Delete files",
              "read:team-members": "View team member details and list team members",
              "write:team-members": "Invite and update team members",
              "admin:team-members": "Deactivate and archive team members",
              "read:subcontractors": "View subcontractor details and list subcontractors",
              "write:subcontractors": "Invite and update subcontractors",
              "admin:subcontractors": "Deactivate and archive subcontractors",
              "read:vendors": "View vendor details and list vendors",
              "write:vendors": "Create and update vendors",
              "admin:vendors": "Archive vendors",
              "read:entity-assignments": "View entity assignments and assignee candidates",
              "write:entity-assignments": "Assign and reassign entities",
              "read:contacts": "View contact details and list contacts",
              "write:contacts": "Create and update contacts",
              "admin:contacts": "Delete contacts"
            },
            "x-scalar-security-body": {
              "audience": "https://pro-api.houzz.com"
            }
          }
        }
      }
    },
