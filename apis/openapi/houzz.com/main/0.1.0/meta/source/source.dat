      },
      "TooManyRequests": {
        "description": "Too Many Requests. Three limits apply: a per-company bucket (RATE_LIMIT_EXCEEDED), a service-wide bucket (RATE_LIMIT_EXCEEDED), and a monthly request allowance (MONTHLY_LIMIT_EXCEEDED). Branch on error.code — backing off clears the first two, but a monthly allowance only resets at the start of the next UTC month, which Retry-After and X-Usage-Reset both point at. The X-RateLimit-* headers describe your company bucket and are omitted when the request was shed by the service-wide limit; the X-Usage-* headers are omitted when no monthly allowance applies.",
        "headers": {
          "Retry-After": {
            "$ref": "#/components/headers/RetryAfter"
          },
          "X-RateLimit-Limit": {
            "$ref": "#/components/headers/XRateLimitLimit"
          },
          "X-RateLimit-Remaining": {
            "$ref": "#/components/headers/XRateLimitRemaining"
          },
          "X-RateLimit-Reset": {
            "$ref": "#/components/headers/XRateLimitReset"
          },
          "X-Usage-Limit": {
            "$ref": "#/components/headers/XUsageLimit"
          },
          "X-Usage-Remaining": {
            "$ref": "#/components/headers/XUsageRemaining"
          },
          "X-Usage-Reset": {
            "$ref": "#/components/headers/XUsageReset"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "error"
              ],
              "properties": {
                "error": {
                  "type": "object",
                  "required": [
                    "code",
                    "message"
                  ],
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "headers": {
      "XRateLimitLimit": {
        "description": "Requests available in a full bucket for your company.",
        "schema": {
          "type": "integer"
        }
      },
      "XRateLimitRemaining": {
        "description": "Requests remaining in your company bucket.",
        "schema": {
          "type": "integer"
        }
      },
      "XRateLimitReset": {
        "description": "Unix time (seconds) at which your bucket refills to capacity.",
        "schema": {
          "type": "integer"
        }
      },
      "RetryAfter": {
        "description": "Seconds to wait before retrying. Always at least 1.",
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      },
      "XUsageLimit": {
        "description": "Your account's monthly request allowance. Omitted when no allowance applies.",
        "schema": {
          "type": "integer"
        }
      },
      "XUsageRemaining": {
        "description": "Requests left in your monthly allowance, this request included.",
        "schema": {
          "type": "integer"
        }
      },
      "XUsageReset": {
        "description": "Unix time (seconds) at which the monthly allowance resets (start of the next UTC month).",
        "schema": {
          "type": "integer"
        }
      }
    }
  }
}
