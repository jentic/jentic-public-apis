{
  "openapi": "3.1.0",
  "info": {
    "title": "WombatLink API",
    "version": "1.0.0",
    "description": "WombatLink is a tool for tour operators that turns bookings into shareable\npickup-detail pages for guests (maps, times, and auto-translated\ninstructions). This API lets you create and manage those pickup links\nprogrammatically from any booking platform or automation tool.\n\n## Authentication\nAll endpoints require an API key sent as a Bearer token:\n\n```\nAuthorization: Bearer wbl_live_xxxxxxxxxxxxxxxxxxxx\n```\n\nGenerate keys in the dashboard at **Dashboard → API Keys**\n(https://wombatlink.com/dashboard/api-keys). Keys begin with `wbl_live_`.\nEach key carries scopes (`pickups.read`, `pickups.write`) and only operates\non pickups owned by the key's account.\n\n## Rate limits\nLimits are applied per API key:\n- **Reads** (GET): 60 requests per minute\n- **Writes** (POST / PATCH / DELETE): 30 requests per minute\n\nExceeding a limit returns `429 Too Many Requests`.\n\n## Errors\nErrors use standard HTTP status codes and return a JSON body with a\n`statusCode` and a human-readable `message` / `statusMessage`.\n",
    "contact": {
      "name": "WombatLink Support",
      "url": "https://wombatlink.com"
    },
    "x-jentic-source-url": "https://wombatlink.com/openapi.yaml"
  },
  "servers": [
    {
      "url": "https://wombatlink.com",
      "description": "Production"
    }
  ],
  "paths": {
    "/api/v1/pickups": {
      "get": {
        "tags": [
          "Pickups"
        ],
        "summary": "List pickups",
        "description": "Returns pickups owned by the authenticated account, newest first.\nSupports pagination and filtering. Requires the `pickups.read` scope.\n",
        "operationId": "listPickups",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Max number of results (1–100).",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Number of results to skip (for pagination).",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "external_ref",
            "in": "query",
            "description": "Filter to pickups matching this external reference (your booking/order ID).",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "created_after",
            "in": "query",
            "description": "Only return pickups created at or after this ISO-8601 timestamp.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "created_before",
            "in": "query",
            "description": "Only return pickups created at or before this ISO-8601 timestamp.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of pickups.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Pickup"
                      }
                    },
                    "total": {
                      "type": "integer",
                      "description": "Total matching pickups (ignoring pagination)."
                    },
                    "limit": {
                      "type": "integer"
                    },
                    "offset": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      },
      "post": {
        "tags": [
          "Pickups"
        ],
        "summary": "Create a pickup",
        "description": "Creates a new pickup link and returns it, including the public guest\n`url` and the `guide_url`. Requires the `pickups.write` scope.\nSubject to the account's pickup quota — returns `403` when the limit\nis reached.\n",
        "operationId": "createPickup",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PickupCreate"
              },
              "example": {
                "title": "Bondi Sunrise Walk",
                "pickup_when": "8:30 AM, 15 Jun 2026",
                "lat": -33.891,
                "lng": 151.276,
                "tour_guide_name": "Sarah",
                "guest_name": "John Smith",
                "pickup_location_name": "Bondi Pavilion",
                "pickup_instructions": "Meet by the main entrance, look for the blue flag.",
                "tour_guide_phone": "+61400123456",
                "default_language": "en",
                "external_ref": "REZDY-12345",
                "enable_chat": true
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Pickup created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pickup"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "description": "Missing `pickups.write` scope, or the account's pickup limit has been reached.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "statusCode": 403,
                  "statusMessage": "Pickup limit reached. Upgrade your plan to create more."
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/api/v1/pickups/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "The pickup's UUID.",
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "tags": [
          "Pickups"
        ],
        "summary": "Get a pickup by ID",
        "description": "Returns a single pickup owned by the account. Requires the `pickups.read` scope.",
        "operationId": "getPickup",
        "responses": {
          "200": {
            "description": "The pickup.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pickup"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      },
      "patch": {
        "tags": [
          "Pickups"
        ],
        "summary": "Update a pickup",
        "description": "Partially updates a pickup. Only the fields you send are changed.\nRequires the `pickups.write` scope. An empty body returns `400`.\n",
        "operationId": "updatePickup",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PickupUpdate"
              },
              "example": {
                "guest_name": "Jane Doe",
                "pickup_when": "9:00 AM, 15 Jun 2026"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated pickup.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pickup"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      },
      "delete": {
        "tags": [
          "Pickups"
        ],
        "summary": "Delete a pickup",
        "description": "Permanently deletes a pickup and any photos attached to it.\nRequires the `pickups.write` scope.\n",
        "operationId": "deletePickup",
        "responses": {
          "200": {
            "description": "Pickup deleted.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "example": true
                    },
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    }
                  }
                },
                "example": {
                  "ok": true,
                  "id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/api/v1/pickups/by-slug/{slug}": {
      "get": {
        "tags": [
          "Pickups"
        ],
        "summary": "Get a pickup by slug",
        "description": "Returns a single pickup by its URL slug (the segment after `/p/` in the\nguest link). Requires the `pickups.read` scope.\n",
        "operationId": "getPickupBySlug",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "description": "The pickup's slug, e.g. `bondi-sunrise-walk-x7k2m`.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The pickup.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pickup"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "API key as a Bearer token. The key starts with `wbl_live_`. Generate\nkeys at https://wombatlink.com/dashboard/api-keys.\n"
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Validation failed. The message lists each problem, separated by `; `.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "statusCode": 400,
              "statusMessage": "title is required; lat must be between -90 and 90"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or invalid API key.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "statusCode": 401,
              "statusMessage": "Missing or invalid API key"
            }
          }
        }
      },
      "Forbidden": {
        "description": "The key is revoked/expired or lacks the required scope.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "statusCode": 403,
              "statusMessage": "API key does not have the 'pickups.write' scope"
            }
          }
        }
      },
      "NotFound": {
        "description": "No pickup with that identifier is owned by this account.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "statusCode": 404,
              "statusMessage": "Pickup not found"
            }
          }
        }
      },
      "RateLimited": {
        "description": "Too many requests for this API key.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "statusCode": 429,
              "statusMessage": "Rate limit exceeded. Max 60 reads per minute."
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "integer",
            "example": 400
          },
          "statusMessage": {
            "type": "string",
            "example": "title is required"
          },
          "message": {
            "type": "string",
            "description": "Alias of statusMessage on some responses."
          }
        }
      },
      "ItineraryItem": {
        "type": "object",
        "required": [
          "time",
          "title"
        ],
        "properties": {
          "time": {
            "type": "string",
            "example": "09:00",
            "description": "Free-text time label."
          },
          "title": {
            "type": "string",
            "example": "Hotel pickup"
          },
          "description": {
            "type": "string",
            "example": "Wait in the lobby."
          }
        }
      },
      "Pickup": {
        "type": "object",
        "description": "A pickup link as returned by the API.",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string",
            "example": "bondi-sunrise-walk-x7k2m"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Public guest-facing pickup page.",
            "example": "https://wombatlink.com/p/bondi-sunrise-walk-x7k2m"
          },
          "guide_url": {
            "type": "string",
            "format": "uri",
            "description": "Guide-facing page for the same pickup.",
            "example": "https://wombatlink.com/guide/bondi-sunrise-walk-x7k2m"
          },
          "title": {
            "type": "string",
            "example": "Bondi Sunrise Walk"
          },
          "guest_name": {
            "type": [
              "string",
              "null"
            ],
            "example": "John Smith"
          },
          "pickup_when": {
            "type": "string",
            "description": "Free-text date/time as entered (not necessarily ISO-8601). May be values like \"TBD\".",
            "example": "8:30 AM, 15 Jun 2026"
          },
          "lat": {
            "type": "number",
            "format": "float",
            "example": -33.891
          },
          "lng": {
            "type": "number",
            "format": "float",
            "example": 151.276
          },
          "place_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Google Places ID",
            "if set.": null
          },
          "pickup_location_name": {
            "type": [
              "string",
              "null"
            ],
            "example": "Bondi Pavilion"
          },
          "pickup_address": {
            "type": [
              "string",
              "null"
            ]
          },
          "pickup_instructions": {
            "type": [
              "string",
              "null"
            ],
            "description": "Auto-translated for guests."
          },
          "tour_guide_name": {
            "type": "string",
            "example": "Sarah"
          },
          "tour_guide_phone": {
            "type": [
              "string",
              "null"
            ],
            "example": "+61400123456"
          },
          "enable_chat": {
            "type": "boolean",
            "example": true
          },
          "share_location": {
            "type": "boolean",
            "example": false
          },
          "default_language": {
            "type": "string",
            "enum": [
              "en",
              "es",
              "fr",
              "zh-hans",
              "zh-hant",
              "ko",
              "ar",
              "de",
              "pt",
              "id"
            ],
            "example": "en"
          },
          "itinerary_enabled": {
            "type": "boolean",
            "example": false
          },
          "itinerary": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/ItineraryItem"
            }
          },
          "external_ref": {
            "type": [
              "string",
              "null"
            ],
            "description": "Your booking/order ID for cross-referencing.",
            "example": "REZDY-12345"
          },
          "source": {
            "type": "string",
            "description": "How the pickup was created (e.g. dashboard, api, rezdy).",
            "example": "api"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "example": {
          "id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
          "slug": "bondi-sunrise-walk-x7k2m",
          "url": "https://wombatlink.com/p/bondi-sunrise-walk-x7k2m",
          "guide_url": "https://wombatlink.com/guide/bondi-sunrise-walk-x7k2m",
          "title": "Bondi Sunrise Walk",
          "guest_name": "John Smith",
          "pickup_when": "8:30 AM, 15 Jun 2026",
          "lat": -33.891,
          "lng": 151.276,
          "place_id": null,
          "pickup_location_name": "Bondi Pavilion",
          "pickup_address": null,
          "pickup_instructions": "Meet by the main entrance, look for the blue flag.",
          "tour_guide_name": "Sarah",
          "tour_guide_phone": "+61400123456",
          "enable_chat": true,
          "share_location": false,
          "default_language": "en",
          "itinerary_enabled": false,
          "itinerary": null,
          "external_ref": "REZDY-12345",
          "source": "api",
          "created_at": "2026-05-28T12:00:00.000Z",
          "updated_at": "2026-05-28T12:00:00.000Z"
        }
      },
      "PickupCreate": {
        "type": "object",
        "required": [
          "title",
          "pickup_when",
          "lat",
          "lng",
          "tour_guide_name"
        ],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 100,
            "description": "Tour or booking name."
          },
          "pickup_when": {
            "type": "string",
            "maxLength": 100,
            "description": "Free-text date and time, e.g. \"8:30 AM, 15 Jun 2026\". Stored as-is."
          },
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "lng": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "tour_guide_name": {
            "type": "string",
            "maxLength": 50
          },
          "guest_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "place_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Google Places ID."
          },
          "pickup_location_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "pickup_address": {
            "type": [
              "string",
              "null"
            ]
          },
          "pickup_instructions": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000,
            "description": "Directions for the guest. Auto-translated."
          },
          "tour_guide_phone": {
            "type": [
              "string",
              "null"
            ],
            "description": "7–15 digits (spaces, dashes, parens, and a leading + are allowed)."
          },
          "enable_chat": {
            "type": "boolean",
            "default": true
          },
          "share_location": {
            "type": "boolean",
            "default": false
          },
          "default_language": {
            "type": "string",
            "enum": [
              "en",
              "es",
              "fr",
              "zh-hans",
              "zh-hant",
              "ko",
              "ar",
              "de",
              "pt",
              "id"
            ],
            "default": "en"
          },
          "itinerary_enabled": {
            "type": "boolean",
            "default": false
          },
          "itinerary": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/ItineraryItem"
            }
          },
          "external_ref": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 255,
            "description": "Your booking/order ID for cross-referencing."
          }
        }
      },
      "PickupUpdate": {
        "type": "object",
        "description": "Same fields as PickupCreate, but all are optional. Only fields present are updated.",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 100
          },
          "pickup_when": {
            "type": "string",
            "maxLength": 100
          },
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "lng": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "tour_guide_name": {
            "type": "string",
            "maxLength": 50
          },
          "guest_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "place_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "pickup_location_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "pickup_address": {
            "type": [
              "string",
              "null"
            ]
          },
          "pickup_instructions": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          },
          "tour_guide_phone": {
            "type": [
              "string",
              "null"
            ]
          },
          "enable_chat": {
            "type": "boolean"
          },
          "share_location": {
            "type": "boolean"
          },
          "default_language": {
            "type": "string",
            "enum": [
              "en",
              "es",
              "fr",
              "zh-hans",
              "zh-hant",
              "ko",
              "ar",
              "de",
              "pt",
              "id"
            ]
          },
          "itinerary_enabled": {
            "type": "boolean"
          },
          "itinerary": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/ItineraryItem"
            }
          },
          "external_ref": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 255
          }
        }
      }
    }
  },
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "tags": [
    {
      "name": "Pickups",
      "description": "Create and manage shareable guest pickup links."
    }
  ]
}