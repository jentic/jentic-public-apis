{
  "components": {
    "schemas": {
      "Contact": {
        "properties": {
          "email": {
            "type": "string"
          },
          "firstName": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string"
          },
          "lastName": {
            "type": [
              "string",
              "null"
            ]
          },
          "mailingLists": {
            "description": "An object of mailing list IDs and boolean subscription statuses.",
            "examples": [
              {
                "list_123": true
              }
            ],
            "type": "object"
          },
          "optInStatus": {
            "description": "Double opt-in status.",
            "enum": [
              "accepted",
              "pending",
              "rejected",
              null
            ],
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "type": "string"
          },
          "subscribed": {
            "type": "boolean"
          },
          "userGroup": {
            "type": "string"
          },
          "userId": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "ContactDeleteRequest": {
        "properties": {
          "email": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "userId"
        ],
        "type": "object"
      },
      "ContactDeleteResponse": {
        "properties": {
          "message": {
            "examples": [
              "Contact deleted."
            ],
            "type": "string"
          },
          "success": {
            "examples": [
              true
            ],
            "type": "boolean"
          }
        },
        "required": [
          "success",
          "message"
        ],
        "type": "object"
      },
      "ContactFailureResponse": {
        "properties": {
          "message": {
            "type": "string"
          },
          "success": {
            "examples": [
              false
            ],
            "type": "boolean"
          }
        },
        "required": [
          "success",
          "message"
        ],
        "type": "object"
      },
      "ContactProperty": {
        "examples": [
          {
            "key": "favoriteColor",
            "label": "Favorite color",
            "type": "string"
          }
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "label",
          "type"
        ],
        "type": "object"
      },
      "ContactPropertyCreateRequest": {
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "type"
        ],
        "type": "object"
      },
      "ContactPropertyFailureResponse": {
        "properties": {
          "message": {
            "type": "string"
          },
          "success": {
            "examples": [
              false
            ],
            "type": "boolean"
          }
        },
        "required": [
          "success",
          "message"
        ],
        "type": "object"
      },
      "ContactPropertySuccessResponse": {
        "properties": {
          "success": {
            "examples": [
              true
            ],
            "type": "boolean"
          }
        },
        "required": [
          "success"
        ],
        "type": "object"
      },
      "ContactRequest": {
        "additionalProperties": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "properties": {
          "email": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "mailingLists": {
            "description": "An object of mailing list IDs and boolean subscription statuses.",
            "examples": [
              {
                "list_123": true
              }
            ],
            "type": "object"
          },
          "subscribed": {
            "type": "boolean"
          },
          "userGroup": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "type": "object"
      },
      "ContactSuccessResponse": {
        "properties": {
          "id": {
            "type": "string"
          },
          "success": {
            "examples": [
              true
            ],
            "type": "boolean"
          }
        },
        "required": [
          "success",
          "id"
        ],
        "type": "object"
      },
      "ContactUpdateRequest": {
        "additionalProperties": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "properties": {
          "email": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "mailingLists": {
            "description": "An object of mailing list IDs and boolean subscription statuses.",
            "examples": [
              {
                "list_123": true
              }
            ],
            "type": "object"
          },
          "subscribed": {
            "type": "boolean"
          },
          "userGroup": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "EventFailureResponse": {
        "properties": {
          "message": {
            "type": "string"
          },
          "success": {
            "examples": [
              false
            ],
            "type": "boolean"
          }
        },
        "required": [
          "success",
          "message"
        ],
        "type": "object"
      },
      "EventRequest": {
        "additionalProperties": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "properties": {
          "email": {
            "type": "string"
          },
          "eventName": {
            "type": "string"
          },
          "eventProperties": {
            "description": "An object containing event property data for the event, available in emails sent by the event.",
            "type": "object"
          },
          "mailingLists": {
            "description": "An object of mailing list IDs and boolean subscription statuses.",
            "examples": [
              {
                "list_123": true
              }
            ],
            "type": "object"
          },
          "userId": {
            "type": "string"
          }
        },
        "required": [
          "eventName"
        ],
        "type": "object"
      },
      "EventSuccessResponse": {
        "properties": {
          "success": {
            "examples": [
              true
            ],
            "type": "boolean"
          }
        },
        "required": [
          "success"
        ],
        "type": "object"
      },
      "IdempotencyKeyFailureResponse": {
        "properties": {
          "message": {
            "type": "string"
          },
          "success": {
            "examples": [
              false
            ],
            "type": "boolean"
          }
        },
        "required": [
          "success",
          "message"
        ],
        "type": "object"
      },
      "ListTransactionalsResponse": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/TransactionalEmail"
            },
            "type": "array"
          },
          "pagination": {
            "properties": {
              "nextCursor": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "nextPage": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "perPage": {
                "type": "number"
              },
              "returnedResults": {
                "type": "number"
              },
              "totalPages": {
                "type": "number"
              },
              "totalResults": {
                "type": "number"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "MailingList": {
        "examples": [
          {
            "description": "Mailing list description",
            "id": "list_123",
            "isPublic": true,
            "name": "Main mailing list"
          }
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "isPublic": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "isPublic"
        ],
        "type": "object"
      },
      "TransactionalEmail": {
        "examples": [
          {
            "dataVariables": [
              "confirmationUrl"
            ],
            "id": "cll42l54f20i1la0lfooe3z12",
            "lastUpdated": "2025-02-02 02:56:28.845000+00:00",
            "name": "Sign up confirmation"
          }
        ],
        "properties": {
          "dataVariables": {
            "type": "array"
          },
          "id": {
            "type": "string"
          },
          "lastUpdated": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "lastUpdated",
          "dataVariables"
        ],
        "type": "object"
      },
      "TransactionalFailure2Response": {
        "properties": {
          "message": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "success": {
            "examples": [
              false
            ],
            "type": "boolean"
          }
        },
        "required": [
          "success",
          "message",
          "path"
        ],
        "type": "object"
      },
      "TransactionalFailure3Response": {
        "properties": {
          "error": {
            "properties": {
              "message": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "message": {
            "type": "string"
          },
          "success": {
            "examples": [
              false
            ],
            "type": "boolean"
          }
        },
        "required": [
          "success",
          "message",
          "error"
        ],
        "type": "object"
      },
      "TransactionalFailure4Response": {
        "properties": {
          "error": {
            "properties": {
              "path": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "message": {
            "type": "string"
          },
          "success": {
            "examples": [
              false
            ],
            "type": "boolean"
          }
        },
        "required": [
          "success",
          "message",
          "error"
        ],
        "type": "object"
      },
      "TransactionalFailure5Response": {
        "properties": {
          "error": {
            "properties": {
              "message": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "message": {
            "type": "string"
          },
          "success": {
            "examples": [
              false
            ],
            "type": "boolean"
          },
          "transactionalId": {
            "type": "string"
          }
        },
        "required": [
          "success",
          "message",
          "error",
          "transactionalId"
        ],
        "type": "object"
      },
      "TransactionalFailureResponse": {
        "properties": {
          "message": {
            "type": "string"
          },
          "success": {
            "examples": [
              false
            ],
            "type": "boolean"
          }
        },
        "required": [
          "success",
          "message"
        ],
        "type": "object"
      },
      "TransactionalRequest": {
        "properties": {
          "addToAudience": {
            "description": "If `true`, a contact will be created in your audience using the `email` value (if a matching contact doesn't already exist).",
            "type": "boolean"
          },
          "attachments": {
            "description": "A list containing file objects to be sent along with an email message.",
            "items": {
              "properties": {
                "contentType": {
                  "description": "The MIME type of the file.",
                  "type": "string"
                },
                "data": {
                  "description": "The base64-encoded content of the file.",
                  "type": "string"
                },
                "filename": {
                  "description": "The name of the file, shown in email clients.",
                  "type": "string"
                }
              },
              "required": [
                "filename",
                "contentType",
                "data"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "dataVariables": {
            "description": "An object containing contact data as defined by the data variables added to the transactional email template.",
            "examples": [
              {
                "name": "Chris",
                "passwordResetLink": "https://example.com/reset-password"
              }
            ],
            "type": "object"
          },
          "email": {
            "type": "string"
          },
          "transactionalId": {
            "description": "The ID of the transactional email to send.",
            "type": "string"
          }
        },
        "required": [
          "email",
          "transactionalId"
        ],
        "type": "object"
      },
      "TransactionalSuccessResponse": {
        "properties": {
          "success": {
            "examples": [
              true
            ],
            "type": "boolean"
          }
        },
        "required": [
          "success"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "apiKey": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "This is the OpenAPI Spec for the [Loops API](https://loops.so/docs/api).",
    "title": "Loops OpenAPI Spec",
    "version": "1.7.0",
    "x-jentic-source-url": "https://app.loops.so/openapi.yaml"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api-key": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "success": {
                      "examples": [
                        true
                      ],
                      "type": "boolean"
                    },
                    "teamName": {
                      "description": "The name of the team the API key belongs to.",
                      "examples": [
                        "Company name"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "success",
                    "teamName"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Success"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "error": {
                      "examples": [
                        "Invalid API key"
                      ],
                      "type": "string"
                    },
                    "message": {
                      "examples": [
                        "Invalid API key"
                      ],
                      "type": "string"
                    },
                    "success": {
                      "examples": [
                        false
                      ],
                      "type": "boolean"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Invalid API key"
          }
        },
        "security": [
          {
            "apiKey": []
          }
        ],
        "summary": "Test your API key",
        "tags": [
          "API key"
        ]
      }
    },
    "/contacts/create": {
      "post": {
        "description": "Add a contact to your audience.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContactRequest"
              }
            }
          },
          "description": "You can add custom contact properties as keys in this request (of type `string`, `number`, `boolean` or `date` ([see available date formats](https://loops.so/docs/contacts/properties#dates))).<br>Make sure to create the properties in Loops before using them in API calls.",
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactSuccessResponse"
                }
              }
            },
            "description": "Successful create."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactFailureResponse"
                }
              }
            },
            "description": "Bad request (e.g. invalid email address)."
          },
          "405": {
            "description": "Wrong HTTP request method."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactFailureResponse"
                }
              }
            },
            "description": "Email or `userId` already exists."
          }
        },
        "security": [
          {
            "apiKey": []
          }
        ],
        "summary": "Create a contact",
        "tags": [
          "Contacts"
        ]
      }
    },
    "/contacts/delete": {
      "post": {
        "description": "Delete a contact by `email` or `userId`.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContactDeleteRequest"
              }
            }
          },
          "description": "Include only one of `email` or `userId`.",
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactDeleteResponse"
                }
              }
            },
            "description": "Successful delete."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactFailureResponse"
                }
              }
            },
            "description": "Bad request (e.g. `email` and `userId` are both provided)."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactFailureResponse"
                }
              }
            },
            "description": "Contact not found."
          },
          "405": {
            "description": "Wrong HTTP request method."
          }
        },
        "security": [
          {
            "apiKey": []
          }
        ],
        "summary": "Delete a contact",
        "tags": [
          "Contacts"
        ]
      }
    },
    "/contacts/find": {
      "get": {
        "description": "Search for a contact by `email` or `userId`. Only one parameter is allowed.",
        "parameters": [
          {
            "description": "Email address (URI-encoded)",
            "in": "query",
            "name": "email",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "userId",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Contact"
                  },
                  "type": "array"
                }
              }
            },
            "description": "List of contacts (or an empty array if no contact was found). Contact objects will include any custom properties."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactFailureResponse"
                }
              }
            },
            "description": "Bad request (e.g. invalid email address)."
          },
          "405": {
            "description": "Wrong HTTP request method."
          }
        },
        "security": [
          {
            "apiKey": []
          }
        ],
        "summary": "Find a contact",
        "tags": [
          "Contacts"
        ]
      }
    },
    "/contacts/properties": {
      "get": {
        "description": "Retrieve a list of your account's contact properties.<br>Use the `list` parameter to query \"all\" or \"custom\" properties.",
        "parameters": [
          {
            "description": "\\\"all\\\" (default) or \\\"custom\\\"",
            "in": "query",
            "name": "list",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ContactProperty"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Successful."
          },
          "405": {
            "description": "Wrong HTTP request method."
          }
        },
        "security": [
          {
            "apiKey": []
          }
        ],
        "summary": "Get a list of contact properties",
        "tags": [
          "Contact properties"
        ]
      },
      "post": {
        "description": "Add a contact property to your team.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContactPropertyCreateRequest"
              }
            }
          },
          "description": "The name value must be in camelCase, like `planName`.",
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactPropertySuccessResponse"
                }
              }
            },
            "description": "Successful create."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactPropertyFailureResponse"
                }
              }
            },
            "description": "Bad request (e.g. invalid type)."
          },
          "405": {
            "description": "Wrong HTTP request method."
          }
        },
        "security": [
          {
            "apiKey": []
          }
        ],
        "summary": "Create a contact property",
        "tags": [
          "Contact properties"
        ]
      }
    },
    "/contacts/update": {
      "put": {
        "description": "Update a contact by `email` or `userId`. You must provide one of these parameters.<br>If you want to update a contact’s email address, the contact will first need a `userId` value. You can then make a request containing the userId field along with an updated email address.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContactUpdateRequest"
              }
            }
          },
          "description": "You can add custom contact properties as keys in this request (of type `string`, `number`, `boolean` or `date` ([see available date formats](https://loops.so/docs/contacts/properties#dates))).<br>Make sure to create the properties in Loops before using them in API calls.",
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactSuccessResponse"
                }
              }
            },
            "description": "Successful update."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactFailureResponse"
                }
              }
            },
            "description": "Bad request (e.g. `email` or `userId` are missing)."
          },
          "405": {
            "description": "Wrong HTTP request method."
          }
        },
        "security": [
          {
            "apiKey": []
          }
        ],
        "summary": "Update a contact",
        "tags": [
          "Contacts"
        ]
      }
    },
    "/dedicated-sending-ips": {
      "get": {
        "description": "Retrieve a list of Loops' dedicated sending IP addresses.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "description": "List of dedicated sending IP addresses",
                  "items": {
                    "description": "IP address",
                    "examples": [
                      "1.2.3.4"
                    ],
                    "type": "string"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Successful."
          },
          "405": {
            "description": "Wrong HTTP request method."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "success": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "success",
                    "message"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Internal server error."
          }
        },
        "security": [
          {
            "apiKey": []
          }
        ],
        "summary": "Get dedicated sending IP addresses",
        "tags": [
          "Dedicated sending IPs"
        ]
      }
    },
    "/events/send": {
      "post": {
        "description": "Send events to trigger emails in Loops.",
        "parameters": [
          {
            "description": "Include a unique ID for this request (maximum 100 characters) to avoid duplicate events. [More info](https://loops.so/docs/api-reference/send-event#param-idempotency-key)",
            "in": "header",
            "name": "Idempotency-Key",
            "schema": {
              "maxLength": 100,
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EventRequest"
              }
            }
          },
          "description": "Provide either `email` or `userId` to identify the contact ([read more](https://loops.so/docs/api-reference/send-event#body)).<br>You can add event properties, which will be available in emails sent by this event. Values can be of type string, number, boolean or date ([see allowed date formats](https://loops.so/docs/events/properties#important-information-about-event-properties)).<br>Make sure to create the properties in Loops before using them in API calls.<br>You can add contact properties as keys in this request (of type `string`, `number`, `boolean` or `date` ([see available date formats](https://loops.so/docs/contacts/properties#dates))).",
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventSuccessResponse"
                }
              }
            },
            "description": "Successful send."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventFailureResponse"
                }
              }
            },
            "description": "Bad request (e.g. `eventName` is missing)."
          },
          "405": {
            "description": "Wrong HTTP request method."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IdempotencyKeyFailureResponse"
                }
              }
            },
            "description": "Idempotency key has been used."
          }
        },
        "security": [
          {
            "apiKey": []
          }
        ],
        "summary": "Send an event",
        "tags": [
          "Events"
        ]
      }
    },
    "/lists": {
      "get": {
        "description": "Retrieve a list of your account's mailing lists.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/MailingList"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Successful."
          },
          "405": {
            "description": "Wrong HTTP request method."
          }
        },
        "security": [
          {
            "apiKey": []
          }
        ],
        "summary": "Get a list of mailing lists",
        "tags": [
          "Mailing lists"
        ]
      }
    },
    "/transactional": {
      "get": {
        "description": "Get a list of published transactional emails.",
        "parameters": [
          {
            "description": "How many results to return in each request. Must be between 10 and 50. Default is 20.",
            "in": "query",
            "name": "perPage",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "A cursor, to return a specific page of results. Cursors can be found from the `pagination.nextCursor` value in each response.",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListTransactionalsResponse"
                }
              }
            },
            "description": "Successful."
          },
          "405": {
            "description": "Wrong HTTP request method."
          }
        },
        "security": [
          {
            "apiKey": []
          }
        ],
        "summary": "List transactional emails",
        "tags": [
          "Transactional emails"
        ]
      },
      "post": {
        "description": "Send a transactional email to a contact.<br>Please [email us](mailto:help@loops.so) to enable attachments on your account before using them with the API.",
        "parameters": [
          {
            "description": "Include a unique ID for this request (maximum 100 characters) to avoid duplicate emails. [More info](https://loops.so/docs/api-reference/send-transactional-email#param-idempotency-key)",
            "in": "header",
            "name": "Idempotency-Key",
            "schema": {
              "maxLength": 100,
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransactionalRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionalSuccessResponse"
                }
              }
            },
            "description": "Successful send."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/TransactionalFailureResponse"
                    },
                    {
                      "$ref": "#/components/schemas/TransactionalFailure2Response"
                    },
                    {
                      "$ref": "#/components/schemas/TransactionalFailure3Response"
                    },
                    {
                      "$ref": "#/components/schemas/TransactionalFailure4Response"
                    },
                    {
                      "$ref": "#/components/schemas/TransactionalFailure5Response"
                    }
                  ]
                }
              }
            },
            "description": "Bad request (e.g. transactional email is not published)."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionalFailure3Response"
                }
              }
            },
            "description": "Transactional email not found."
          },
          "405": {
            "description": "Wrong HTTP request method."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IdempotencyKeyFailureResponse"
                }
              }
            },
            "description": "Idempotency key has been used."
          }
        },
        "security": [
          {
            "apiKey": []
          }
        ],
        "summary": "Send a transactional email",
        "tags": [
          "Transactional emails"
        ]
      }
    }
  },
