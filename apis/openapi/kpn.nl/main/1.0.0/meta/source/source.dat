{
  "openapi": "3.0.3",
  "info": {
    "title": "KPN Product Catalog API",
    "version": "1.0.0",
    "description": "API to browse KPN products, bundles and equipment for telecom/subscription use-cases (mobile, broadband, add-ons). Designed to be consumed by a Salesforce LWC that lists available products.",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/kpn_demo/ProductAPI/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.kpn.nl/catalog",
      "description": "KPN Product API (example)"
    }
  ],
  "paths": {
    "/v1/products": {
      "get": {
        "summary": "List products",
        "description": "Returns a paginated list of orderable products/bundles. This is the lightweight shape intended for listing in the UI. Call GET /v1/products/{productId} for full details.",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Filter by product category e.g. MOBILE, BROADBAND, ADDON"
          },
          {
            "name": "isBundle",
            "in": "query",
            "schema": {
              "type": "boolean"
            },
            "description": "If true, return only bundle products"
          },
          {
            "name": "includeEquipment",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "If true, also return equipment like routers/extenders"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20,
              "minimum": 1,
              "maximum": 200
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 0,
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Product list response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductListResponse"
                },
                "example": {
                  "success": true,
                  "data": [
                    {
                      "productId": "01t-kpn-mob-unl-nl",
                      "name": "KPN Mobile Unlimited NL",
                      "productCode": "KPN-MOB-UNL-NL",
                      "category": "MOBILE",
                      "description": "Unlimited calls, SMS and data in the Netherlands",
                      "price": 27.5,
                      "currency": "EUR",
                      "availability": "Available",
                      "isBundle": false,
                      "orderable": true,
                      "imageUrl": "https://cdn.kpn.com/products/mobile-unlimited.jpg"
                    },
                    {
                      "productId": "01t-kpn-mob-sim-10gb",
                      "name": "KPN Sim Only 10GB",
                      "productCode": "KPN-MOB-SIM-10GB",
                      "category": "MOBILE",
                      "description": "10GB data, unlimited calls/SMS, EU roaming included",
                      "price": 15.0,
                      "currency": "EUR",
                      "availability": "Available",
                      "isBundle": false,
                      "orderable": true,
                      "imageUrl": "https://cdn.kpn.com/products/sim-10gb.jpg"
                    },
                    {
                      "productId": "01t-kpn-mob-family-40gb",
                      "name": "KPN Family Mobile 40GB",
                      "productCode": "KPN-MOB-FAM-40GB",
                      "category": "MOBILE",
                      "description": "Shared 40GB for family, includes 5G",
                      "price": 34.0,
                      "currency": "EUR",
                      "availability": "Available",
                      "isBundle": true,
                      "orderable": true,
                      "imageUrl": "https://cdn.kpn.com/products/mobile-family.jpg"
                    },
                    {
                      "productId": "01t-kpn-fiber-complete-1g",
                      "name": "KPN Fiber Complete 1 Gbps",
                      "productCode": "KPN-FIBER-1G",
                      "category": "BROADBAND",
                      "description": "1 Gbps fiber internet incl. router and Wi-Fi extender",
                      "price": 49.0,
                      "currency": "EUR",
                      "availability": "Available",
                      "isBundle": true,
                      "orderable": true,
                      "imageUrl": "https://cdn.kpn.com/products/fiber-1g.jpg"
                    },
                    {
                      "productId": "01t-kpn-dsl-100",
                      "name": "KPN Internet 100 Mbps (DSL)",
                      "productCode": "KPN-DSL-100",
                      "category": "BROADBAND",
                      "description": "Up to 100 Mbps over DSL, modem included",
                      "price": 37.5,
                      "currency": "EUR",
                      "availability": "Available",
                      "isBundle": false,
                      "orderable": true,
                      "imageUrl": "https://cdn.kpn.com/products/dsl-100.jpg"
                    },
                    {
                      "productId": "01t-kpn-addon-tv-plus",
                      "name": "KPN TV Plus Pack",
                      "productCode": "KPN-TV-PLUS",
                      "category": "ADDON",
                      "description": "Extra TV channels to add on existing KPN internet/TV",
                      "price": 9.5,
                      "currency": "EUR",
                      "availability": "Available",
                      "isBundle": false,
                      "orderable": true,
                      "imageUrl": "https://cdn.kpn.com/products/tv-plus.jpg"
                    },
                    {
                      "productId": "01t-kpn-addon-security",
                      "name": "KPN Online Security",
                      "productCode": "KPN-SEC-ONLINE",
                      "category": "ADDON",
                      "description": "Device security, parental controls and safe browsing",
                      "price": 4.0,
                      "currency": "EUR",
                      "availability": "Available",
                      "isBundle": false,
                      "orderable": true,
                      "imageUrl": "https://cdn.kpn.com/products/security.jpg"
                    },
                    {
                      "productId": "01t-kpn-equip-router",
                      "name": "KPN SuperRouter AX",
                      "productCode": "KPN-ROUTER-AX",
                      "category": "EQUIPMENT",
                      "description": "Wi-Fi 6 router, typically included in broadband bundles",
                      "price": 0,
                      "currency": "EUR",
                      "availability": "Available",
                      "isBundle": false,
                      "orderable": false,
                      "imageUrl": "https://cdn.kpn.com/products/router.jpg"
                    }
                  ],
                  "pagination": {
                    "totalRecords": 8,
                    "limit": 20,
                    "offset": 0,
                    "hasMore": false,
                    "currentPage": 1,
                    "totalPages": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/products/search": {
      "post": {
        "summary": "Search products",
        "description": "Advanced search for products. Unknown fields in 'specifications' will be ignored.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductSearchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Search result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/products/{productId}": {
      "get": {
        "summary": "Get product by id",
        "description": "Returns the full product definition, including bundle items, specifications and pricing references.",
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Product detail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductDetailResponse"
                },
                "example": {
                  "success": true,
                  "data": {
                    "productId": "01t-kpn-fiber-complete-1g",
                    "name": "KPN Fiber Complete 1 Gbps",
                    "productCode": "KPN-FIBER-1G",
                    "category": "BROADBAND",
                    "description": "1 Gbps fiber internet including router, Wi-Fi extender and installation.",
                    "price": 49.0,
                    "currency": "EUR",
                    "availability": "Available",
                    "isBundle": true,
                    "orderable": true,
                    "imageUrl": "https://cdn.kpn.com/products/fiber-1g.jpg",
                    "bundleItems": [
                      {
                        "itemId": "ROUTER-001",
                        "itemName": "KPN Wi-Fi Router",
                        "itemType": "EQUIPMENT",
                        "included": true,
                        "quantity": 1,
                        "itemPrice": 0
                      },
                      {
                        "itemId": "EXTENDER-001",
                        "itemName": "KPN Wi-Fi Extender",
                        "itemType": "EQUIPMENT",
                        "included": true,
                        "quantity": 1,
                        "itemPrice": 0
                      },
                      {
                        "itemId": "INSTALL-001",
                        "itemName": "Professional Installation",
                        "itemType": "SERVICE",
                        "included": true,
                        "quantity": 1,
                        "itemPrice": 25
                      }
                    ],
                    "specifications": {
                      "downloadSpeed": "1 Gbps",
                      "uploadSpeed": "100 Mbps",
                      "connectionType": "Fiber",
                      "contractDuration": "12 months",
                      "wifiStandard": "Wi-Fi 6"
                    },
                    "features": [
                      "High-speed fiber internet",
                      "Wi-Fi router included",
                      "Wi-Fi extender included"
                    ]
                  }
                }
              }
            }
          },
          "404": {
            "description": "Product not found"
          }
        }
      }
    },
    "/v1/products/{productId}/pricing": {
      "get": {
        "summary": "Get pricing for a product",
        "description": "Returns the price breakdown (one-time vs recurring) for a product.",
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Pricing info",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductPricingResponse"
                },
                "example": {
                  "success": true,
                  "data": {
                    "productId": "01t-kpn-fiber-complete-1g",
                    "billingPeriod": "MONTHLY",
                    "monthlyFee": 49.0,
                    "annualPrice": 540.0,
                    "setupFee": 25.0,
                    "taxRate": 21.0
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/categories": {
      "get": {
        "summary": "List product categories",
        "responses": {
          "200": {
            "description": "Category list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CategoryListResponse"
                },
                "example": {
                  "success": true,
                  "data": [
                    {
                      "code": "MOBILE",
                      "name": "Mobile"
                    },
                    {
                      "code": "BROADBAND",
                      "name": "Broadband"
                    },
                    {
                      "code": "ADDON",
                      "name": "Add-on Services"
                    },
                    {
                      "code": "EQUIPMENT",
                      "name": "Equipment"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProductListResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "type": "array",
            "description": "Lightweight product records suitable for list views",
            "items": {
              "$ref": "#/components/schemas/Product"
            }
          },
          "pagination": {
            "$ref": "#/components/schemas/Pagination"
          }
        }
      },
      "ProductDetailResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "$ref": "#/components/schemas/ProductDetail"
          }
        }
      },
      "ProductPricingResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "$ref": "#/components/schemas/ProductPricing"
          }
        }
      },
      "CategoryListResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Category"
            }
          }
        }
      },
      "Product": {
        "type": "object",
        "description": "Lightweight product shape for list view",
        "properties": {
          "productId": {
            "type": "string",
            "example": "01t5g000000MOB001"
          },
          "name": {
            "type": "string",
            "example": "KPN Unlimited Mobile"
          },
          "productCode": {
            "type": "string",
            "example": "KPN-MOB-UNL-001"
          },
          "category": {
            "type": "string",
            "example": "MOBILE"
          },
          "description": {
            "type": "string",
            "example": "Unlimited calls, SMS and data in Netherlands"
          },
          "price": {
            "type": "number",
            "format": "double",
            "example": 27.5,
            "description": "Display/list price, typically monthly for mobile"
          },
          "currency": {
            "type": "string",
            "example": "EUR"
          },
          "availability": {
            "type": "string",
            "example": "Available"
          },
          "isBundle": {
            "type": "boolean",
            "example": false
          },
          "orderable": {
            "type": "boolean",
            "example": true,
            "description": "If false, UI should not allow adding to order"
          },
          "imageUrl": {
            "type": "string",
            "example": "https://cdn.kpn.com/products/mobile-unlimited.jpg"
          }
        },
        "required": [
          "productId",
          "name",
          "productCode",
          "price"
        ]
      },
      "ProductDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Product"
          },
          {
            "type": "object",
            "properties": {
              "bundleItems": {
                "type": "array",
                "description": "Items that are part of this bundle (router, Wi-Fi extender, installation)",
                "items": {
                  "$ref": "#/components/schemas/BundleItem"
                }
              },
              "specifications": {
                "type": "object",
                "description": "Key-value specs. Unknown keys may be ignored by the backend.",
                "additionalProperties": true,
                "example": {
                  "dataAllowance": "10GB",
                  "callMinutes": "Unlimited",
                  "smsMessages": "Unlimited",
                  "networkType": "5G",
                  "roaming": "EU included",
                  "contractDuration": "12 months",
                  "downloadSpeed": "1 Gbps",
                  "uploadSpeed": "100 Mbps",
                  "connectionType": "Fiber"
                }
              },
              "features": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "example": [
                  "Unlimited data in Netherlands",
                  "5G network included",
                  "EU roaming included"
                ]
              }
            }
          }
        ]
      },
      "BundleItem": {
        "type": "object",
        "properties": {
          "itemId": {
            "type": "string",
            "example": "ROUTER-001"
          },
          "itemName": {
            "type": "string",
            "example": "KPN Wi-Fi Router"
          },
          "itemType": {
            "type": "string",
            "example": "EQUIPMENT"
          },
          "included": {
            "type": "boolean",
            "example": true
          },
          "quantity": {
            "type": "integer",
            "example": 1
          },
          "itemPrice": {
            "type": "number",
            "format": "double",
            "example": 0
          }
        }
      },
      "ProductPricing": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string",
            "example": "01t5g000000MOB001"
          },
          "billingPeriod": {
            "type": "string",
            "enum": [
              "ONCE",
              "MONTHLY",
              "YEARLY"
            ],
            "example": "MONTHLY"
          },
          "monthlyFee": {
            "type": "number",
            "format": "double",
            "example": 27.5
          },
          "annualPrice": {
            "type": "number",
            "format": "double",
            "example": 300
          },
          "setupFee": {
            "type": "number",
            "format": "double",
            "example": 25
          },
          "taxRate": {
            "type": "number",
            "format": "double",
            "example": 21
          }
        }
      },
      "ProductSearchRequest": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "Free text to match name or description"
          },
          "category": {
            "type": "string",
            "description": "Filter by category e.g. MOBILE, BROADBAND, ADDON"
          },
          "isBundle": {
            "type": "boolean",
            "description": "If true, return only bundle products"
          },
          "includeEquipment": {
            "type": "boolean",
            "description": "If true, return equipment along with services/bundles"
          },
          "specifications": {
            "type": "object",
            "description": "Key-value filters. Unknown keys will be ignored.",
            "additionalProperties": true,
            "example": {
              "downloadSpeed": "1 Gbps"
            }
          },
          "limit": {
            "type": "integer",
            "default": 20
          },
          "offset": {
            "type": "integer",
            "default": 0
          }
        }
      },
      "Category": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "MOBILE"
          },
          "name": {
            "type": "string",
            "example": "Mobile"
          }
        }
      },
      "Pagination": {
        "type": "object",
        "description": "Pagination info aligned with Order API",
        "properties": {
          "totalRecords": {
            "type": "integer",
            "example": 45
          },
          "limit": {
            "type": "integer",
            "example": 20
          },
          "offset": {
            "type": "integer",
            "example": 0
          },
          "hasMore": {
            "type": "boolean",
            "example": true
          },
          "currentPage": {
            "type": "integer",
            "example": 1
          },
          "totalPages": {
            "type": "integer",
            "example": 3
          }
        }
      }
    },
    "securitySchemes": {
      "oauth2": {
        "type": "oauth2",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://api-prd.kpn.com/oauth/client_credential/accesstoken",
            "scopes": {}
          }
        }
      }
    }
  },
  "security": [
    {
      "oauth2": []
    }
  ]
}
