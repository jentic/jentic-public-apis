{
  "openapi": "3.0.3",
  "info": {
    "title": "Claims Details API",
    "description": "This API allows users to request all up-to-date claim data",
    "version": "1.0.1",
    "contact": {
      "email": "support@example.com"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/ddrtlimited/cadr-claim-info-api/1.0.1"
  },
  "servers": [
    {
      "url": "https://portal.canadianadr.ca/api",
      "description": "CADR UAT Server"
    }
  ],
  "paths": {
    "/claims/{claim_id}": {
      "get": {
        "summary": "Retrieve claim information",
        "description": "Retrieves detailed information for a specific claim by its unique identifier",
        "operationId": "getClaimById",
        "tags": [
          "Claims"
        ],
        "parameters": [
          {
            "name": "claim_id",
            "in": "path",
            "required": true,
            "description": "Unique identifier for the claim",
            "schema": {
              "type": "string"
            },
            "example": "695f774d855ffc8e19061d13"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with claim details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClaimResponse"
                },
                "example": {
                  "code": 200,
                  "message": null,
                  "data": {
                    "id": "695f774d855ffc8e19061d13",
                    "customer": {
                      "id": "68de3f045f99ed64a80db122",
                      "first_name": "Joe",
                      "last_name": "Bloggs",
                      "email": "security@ddrt.co.uk",
                      "status": 1,
                      "roles": [
                        "ad",
                        "sa"
                      ]
                    },
                    "booking_reference": "4ipq4",
                    "stage": {
                      "name": "Adjudication",
                      "stage": "adjudication",
                      "order": 2
                    },
                    "date": "2026-01-08T09:50:15.000000Z",
                    "final": true,
                    "created_at": "2026-01-08T09:50:15.675000Z",
                    "updated_at": "2026-01-14T15:53:37.429000Z"
                  },
                  "error": null
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Unauthorized",
                  "message": "Authentication credentials were not provided or are invalid"
                }
              }
            }
          },
          "404": {
            "description": "Claim not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": null,
                  "message": "Claim not found"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Internal Server Error",
                  "message": "An unexpected error occurred"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ClaimResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "description": "HTTP status code",
            "example": 200
          },
          "message": {
            "type": "string",
            "nullable": true,
            "description": "Optional message"
          },
          "data": {
            "$ref": "#/components/schemas/Claim"
          },
          "error": {
            "type": "string",
            "nullable": true,
            "description": "Error message if applicable"
          }
        },
        "required": [
          "code",
          "data"
        ]
      },
