  "paths": {
    "/api/registroCodeUsuario": {
      "post": {
        "summary": "Registrar usuário enviando código de verificação",
        "tags": [
          "App"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterUsuarioCodeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Código enviado com sucesso"
          },
          "400": {
            "description": "Erro ao enviar código"
          },
          "500": {
            "description": "Erro interno"
          }
        }
      }
    },
    "/api/verifyCodeUsuario": {
      "post": {
        "summary": "Verificar código de validação do usuário",
        "tags": [
          "App"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyUsuarioCodeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Código verificado com sucesso"
          },
          "400": {
            "description": "Código inválido"
          },
          "500": {
            "description": "Erro interno"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Autenticar usuário (app ou dashboard)",
