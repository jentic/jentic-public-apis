{
  "openapi": "3.0.0",
  "info": {
    "version": "1.4.0",
    "title": "GrantOne Accounting API",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/Grant-Aps/Accounting/1.4.0"
  },
  "servers": [
    {
      "url": "https://grant-a.demo.grant.nu"
    }
  ],
  "paths": {
    "/api/integration/authenticate": {
      "post": {
        "summary": "Obtain a session token.",
        "tags": [
          "auth"
        ],
        "parameters": [
          {
            "name": "username",
            "in": "query",
            "description": "The username assigned by Grant.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "password",
            "in": "query",
            "description": "The password assigned by Grant.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "401": {
            "description": "Authentication failed."
          },
          "200": {
            "description": "Successful authentication.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/integration/postings/batch": {
      "get": {
        "summary": "Fetch up to 50 postings/journal entries for exporting.",
        "tags": [
          "Accounting"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "batch",
            "in": "query",
            "description": "Optionally specify a previously fetched batch.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A paged array of postings",
            "headers": {
              "x-Grant-Count": {
                "description": "The total number of postings for export including the current posting.",
                "schema": {
                  "type": "number"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Postings"
                }
              }
            }
          },
          "401": {
            "description": "Authentication failed."
          },
          "422": {
            "description": "Request could not be completed."
          }
        }
      }
    },
    "/api/integration/postings/batch/{id}/export": {
      "patch": {
        "summary": "Mark a batch of postings as \"exported\".",
        "tags": [
          "Accounting"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The id of the batch to mark",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Expected response to a valid request"
          },
          "401": {
            "description": "Authentication failed."
          },
          "422": {
            "description": "Request could not be completed."
          }
        }
      }
    },
    "/api/integration/postings/batch/{id}/reset": {
      "patch": {
        "summary": "Reset a batch of postings previously marked as exported. Only available while testing.",
        "tags": [
          "Accounting"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The id of the batch to reset",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Any postings/journal entries with the specified batch has been reset."
          },
          "401": {
            "description": "Authentication failed."
          },
          "422": {
            "description": "Request could not be completed."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Attachment": {
        "type": "object",
        "description": "A file attachment",
        "required": [
          "filename",
          "content_type",
          "content"
        ],
        "properties": {
          "filename": {
            "type": "string",
            "description": "Suggested file name."
          },
          "content_type": {
            "type": "string",
            "description": "File content type, e.g. application/pdf"
          },
          "content": {
            "type": "string",
            "format": "base64",
            "description": "Base 64 encoded file content."
          }
        }
      },
      "Posting": {
        "type": "object",
        "description": "A journal entry/posting.",
        "required": [
          "id",
          "batch",
          "amount",
          "currency",
          "exchange_rate",
          "date",
          "exported",
          "journal_no",
          "account",
          "contra_account",
          "text",
          "type"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "batch": {
            "type": "string",
            "format": "uuid"
          },
          "amount": {
            "type": "number",
            "format": "float",
            "min": 0.01
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3
          },
          "exchange_rate": {
            "type": "number",
            "format": "float"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "exported": {
            "type": "boolean"
          },
          "journal_no": {
            "type": "string",
            "minLength": 10,
            "maxLength": 50
          },
          "account": {
            "type": "string"
          },
          "account_type": {
            "type": "string"
          },
          "contra_account": {
            "type": "string"
          },
          "contra_account_type": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "attachment": {
            "$ref": "#/components/schemas/Attachment"
          },
          "type": {
            "type": "string",
            "enum": [
              "addendum",
              "dropped",
              "outgoing",
              "incoming"
            ]
          }
        },
        "example": {
          "id": 100,
          "currency": "DKK",
          "exchange_rate": 100.0,
          "batch": "b9bf40dd-b4ec-4b44-8ddb-e2a77322a1b3",
          "amount": 123.5,
          "date": "2025-01-01",
          "exported": false,
          "journal_no": "2024-0001",
          "account": 1234,
          "contra_account": 4321,
          "text": "Bevilling / J.nr. 2024-0001",
          "type": "addendum"
        }
      },
      "Postings": {
        "type": "array",
        "maxItems": 50,
        "items": {
          "$ref": "#/components/schemas/Posting"
        }
      },
      "AuthResponse": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "failed"
            ]
          },
          "token": {
            "type": "string",
            "description": "Token valid for 15 minutes."
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}
