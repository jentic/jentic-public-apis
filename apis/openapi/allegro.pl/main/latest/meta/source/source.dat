          "404": {
            "description": "Not Found - command does not exist or belongs to a different seller",
            "content": {
              "application/vnd.allegro.public.v1+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorsHolder"
                },
                "example": {
                  "errors": [
                    {
                      "code": "COMMAND_NOT_FOUND",
                      "message": "Command not found.",
                      "details": null,
                      "path": null,
                      "userMessage": "Command not found.",
                      "metadata": {}
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/sale/allegro-prices/offers-queries": {
      "post": {
        "tags": [
          "Allegro Prices"
        ],
        "summary": "Query Allegro Prices offers status",
        "description": "Use this resource to retrieve a list of offers and their status in the Allegro Prices program with optional filtering and pagination. Allows filtering by offer IDs, marketplace, and scope (WITH_DECLARATION, DISCOUNTED, or EXCLUDED). Only offers in ACTIVATING, ACTIVE, or ENDED statuses are considered.",
        "operationId": "getAllegroPricesOffers",
        "security": [
          {
            "bearer-token-for-user": [
              "allegro:api:campaigns"
            ]
          }
        ],
        "parameters": [
          {
            "name": "Accept-Language",
            "in": "header",
            "required": false,
            "description": "Expected language of messages.",
            "example": "pl-PL",
            "schema": {
              "type": "string",
              "format": "BCP-47 language code",
              "enum": [
                "en-US",
                "pl-PL",
                "uk-UA",
                "sk-SK",
                "cs-CZ",
                "hu-HU"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/vnd.allegro.public.v1+json": {
              "schema": {
                "$ref": "#/components/schemas/OfferStatusQueryRequestDto"
              },
              "examples": {
                "filterByScope": {
                  "summary": "Filter offers by scope (WITH_DECLARATION)",
                  "value": {
                    "marketplace": {
                      "id": "allegro-pl"
                    },
                    "offer": {
                      "scope": "WITH_DECLARATION"
                    },
                    "limit": 50,
                    "offset": 0
                  }
                },
                "filterByIds": {
                  "summary": "Filter specific offers by IDs",
                  "value": {
                    "marketplace": {
                      "id": "allegro-pl"
                    },
                    "offer": {
                      "ids": [
                        "10000000001",
                        "10000000002",
                        "10000000003"
                      ]
                    },
                    "limit": 20
                  }
                },
                "filterDiscounted": {
                  "summary": "Get currently discounted offers",
                  "value": {
                    "marketplace": {
                      "id": "allegro-cz"
                    },
                    "offer": {
                      "scope": "DISCOUNTED"
                    },
                    "limit": 100,
                    "offset": 0
                  }
                },
                "allOffers": {
                  "summary": "Get all offers for marketplace",
                  "value": {
                    "marketplace": {
                      "id": "allegro-pl"
                    },
                    "limit": 20,
                    "offset": 0
                  }
                },
                "filterBySubstatus": {
                  "summary": "Filter offers by substatus (DISCOUNT_OPPORTUNITY)",
                  "value": {
                    "marketplace": {
                      "id": "allegro-pl"
                    },
                    "offer": {
                      "substatus": "DISCOUNT_OPPORTUNITY"
                    },
                    "limit": 50,
                    "offset": 0
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully retrieved offers",
            "content": {
              "application/vnd.allegro.public.v1+json": {
                "schema": {
                  "$ref": "#/components/schemas/OfferStatusQueryResponseDto"
                },
                "examples": {
                  "withDiscountedOffers": {
                    "summary": "Response with discounted offers",
                    "value": {
                      "offers": [
                        {
                          "id": "10000000001",
                          "name": "Smartphone XYZ Pro 256GB",
                          "marketplace": {
                            "id": "allegro-pl"
                          },
                          "basePrice": {
                            "amount": "2999.00",
                            "currency": "PLN"
                          },
                          "discount": {
                            "opportunity": true
                          },
                          "recommendedPriceReduction": {
                            "sellerMaxDeclaredPercentage": "18.0"
                          },
                          "declaredPriceReduction": {
                            "sellerMaxDeclaredPercentage": "15.0",
                            "sellerMaxDeclaredDiscount": {
                              "amount": "449.85",
                              "currency": "PLN"
                            }
                          },
                          "actualPriceReduction": {
                            "sellerMaxDeclaredPercentage": "15.0",
                            "sellerMaxDeclaredDiscount": {
                              "amount": "449.85",
                              "currency": "PLN"
                            },
                            "sellerDiscount": {
                              "amount": "269.91",
                              "currency": "PLN"
                            },
                            "allegroDiscount": {
                              "amount": "629.79",
                              "currency": "PLN"
                            },
                            "finalPriceForTheBuyer": {
                              "amount": "2099.30",
                              "currency": "PLN"
                            }
                          },
                          "discountedAt": "2024-01-15T10:30:00.000Z",
