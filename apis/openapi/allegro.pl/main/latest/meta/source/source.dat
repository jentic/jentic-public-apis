                        },
                        {
                          "id": "10000000002",
                          "name": "Laptop ABC 15.6' 16GB RAM",
                          "marketplace": {
                            "id": "allegro-pl"
                          },
                          "basePrice": {
                            "amount": "4500.00",
                            "currency": "PLN"
                          },
                          "discount": {
                            "opportunity": true
                          },
                          "recommendedPriceReduction": {
                            "sellerMaxDeclaredPercentage": "18.0"
                          },
                          "declaredPriceReduction": {
                            "sellerMaxDeclaredPercentage": "10.0",
                            "sellerMaxDeclaredDiscount": {
                              "amount": "450.00",
                              "currency": "PLN"
                            }
                          },
                          "actualPriceReduction": {
                            "sellerMaxDeclaredPercentage": "10.0",
                            "sellerMaxDeclaredDiscount": {
                              "amount": "450.00",
                              "currency": "PLN"
                            },
                            "sellerDiscount": {
                              "amount": "270.00",
                              "currency": "PLN"
                            },
                            "allegroDiscount": {
