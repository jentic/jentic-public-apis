            "type": "string",
            "maxLength": 80
          },
          "city": {
            "type": "string",
            "maxLength": 40
          },
          "zipCode": {
            "type": "string",
            "maxLength": 10
          },
          "state": {
            "type": "string",
            "maxLength": 40
          },
