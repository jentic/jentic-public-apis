            "required": false,
            "description": "Expected language of messages.",
            "example": "en-US",
            "schema": {
              "type": "string",
              "format": "BCP-47 language code",
              "enum": [
                "en-US",
                "pl-PL",
                "uk-UA",
                "sk-SK",
                "cs-CZ",
                "hu-HU"
              ]
            }
          }
        ],
        "responses": {
