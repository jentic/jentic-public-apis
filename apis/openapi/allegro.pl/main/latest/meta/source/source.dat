                "schema": {
                  "$ref": "#/components/schemas/ErrorsHolder"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer-token-for-user": [
              "allegro:api:sale:offers:read"
            ]
          }
        ]
      },
      "put": {
        "tags": [
          "Rebates and promotions"
        ],
        "summary": "Modify a promotion",
        "description": "Use this resource to update a promotion by its unique id. <br> It supports editing bundle's discount, wholesale price lists and large order discounts. Read more about: Large order discount <a href=\"../../tutorials/jak-zarzadzac-rabatami-promocjami-yPya2mj6zUP#edytuj-progi-rabatowe\" target=\"_blank\">PL</a> / <a href=\"../../tutorials/how-to-manage-rebates-and-promotions-g05avdL0vT4#edit-discount-thresholds\" target=\"_blank\">EN</a>, Wholesale price list <a href=\"../../tutorials/jak-zarzadzac-rabatami-promocjami-yPya2mj6zUP#edytuj-cennik\" target=\"_blank\">PL</a> / <a href=\"../../tutorials/how-to-manage-rebates-and-promotions-g05avdL0vT4#edit-wholesale-price-list\" target=\"_blank\">EN</a>.",
        "operationId": "updatePromotionUsingPUT",
        "parameters": [
          {
