      "SaleProductOfferRequestBase": {
        "allOf": [
          {
            "type": "object",
            "properties": {
              "category": {
                "type": "object",
                "allOf": [
                  {
                    "$ref": "#/components/schemas/OfferCategoryRequest"
                  }
                ]
              },
              "name": {
                "type": "string",
