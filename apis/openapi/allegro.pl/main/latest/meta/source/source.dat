        "required": [
          "fileName",
          "size"
        ]
      },
      "MessageAuthorRole": {
        "type": "string",
        "enum": [
          "BUYER",
          "SELLER",
          "ADMIN",
          "SYSTEM",
          "FULFILLMENT"
        ],
        "example": "SELLER"
      },
      "MessageRequest": {
        "type": "object",
        "description": "Request body to add message to the dispute. Presence of text or attachment fields or both is required.",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 20000,
            "example": "Good morning. Please clarify the problem."
          },
          "attachments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PostPurchaseIssueAttachmentId"
            }
          },
          "type": {
            "type": "string",
            "enum": [
              "REGULAR",
              "END_REQUEST",
              "RETURN_REQUIRED_SELLER_LABEL",
              "RETURN_REQUIRED_CUSTOM",
              "RETURN_NOT_REQUIRED"
            ],
            "example": "REGULAR",
            "description": "Type of message, `END_REQUEST` is only allowed for disputes while return-related types are only allowed for claims."
          }
        },
        "required": [
          "text",
          "attachment",
          "type"
        ]
      },
      "ClaimStatusChangeRequest": {
        "type": "object",
        "description": "Request to change status of a claim",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ACCEPTED_REPAIR",
              "ACCEPTED_REFUND",
              "ACCEPTED_EXCHANGE",
              "ACCEPTED_PARTIAL_REFUND",
              "REJECTED_ADDITIONAL_REQUIREMENTS_NOT_COMPLETED",
              "REJECTED_PRODUCT_NOT_RETURNED",
              "REJECTED_PRODUCT_DAMAGED_BY_USER",
              "REJECTED_PRODUCT_CONFORMS_TO_CONTRACT",
              "REJECTED_MINOR_DEFECT",
              "REJECTED_OTHER"
            ],
            "example": "ACCEPTED_PARTIAL_REFUND"
          },
          "message": {
            "type": "string",
            "example": "I accept a partial refund"
          },
          "partialRefund": {
            "$ref": "#/components/schemas/Price"
          }
        },
        "required": [
          "status",
          "message"
        ]
      },
      "TagRequest": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 25,
            "example": "Shoes"
          },
          "hidden": {
            "type": "boolean",
            "example": false
          }
        }
      },
      "TagId": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "500fedd3-2140-4225-87d4-a22484222776"
          }
        }
      },
      "TagResponse": {
        "type": "object",
        "required": [
          "id",
          "name",
          "hidden"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "500fedd3-2140-4225-87d4-a22484222776"
          },
          "name": {
            "type": "string",
            "example": "Shoes"
          },
          "hidden": {
            "type": "boolean",
            "example": false
          }
        }
      },
      "TagListResponse": {
        "type": "object",
        "required": [
          "tags"
        ],
        "properties": {
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TagResponse"
            }
          }
        }
      },
      "TagIdsRequest": {
        "type": "object",
        "required": [
          "tags"
        ],
        "properties": {
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TagId"
            }
          }
        }
      },
