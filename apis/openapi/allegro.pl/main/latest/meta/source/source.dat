      },
      "TurnoverDiscountListDto": {
        "type": "array",
        "description": "List of turnover discounts for marketplaces.",
        "items": {
          "$ref": "#/components/schemas/NullableTurnoverDiscountDto"
        }
      },
      "NullableTurnoverDiscountDto": {
        "type": "object",
        "description": "Turnover discount for a marketplace.",
        "properties": {
          "marketplaceId": {
            "type": "string",
            "description": "Marketplace ID.",
            "example": "allegro-business-cz"
          },
          "status": {
            "type": "string",
            "nullable": true,
            "description": "Turnover discount status.",
            "example": "ACTIVATING",
            "enum": [
              "ACTIVATING",
              "ACTIVE",
              "DEACTIVATING",
              null
            ]
          },
          "definitions": {
            "type": "array",
            "nullable": true,
            "description": "Definitions currently active or active in the future.",
            "items": {
              "$ref": "#/components/schemas/TurnoverDiscountDefinitionDto"
            }
          }
        }
      },
      "TurnoverDiscountDto": {
        "type": "object",
        "description": "Turnover discount for a marketplace.",
        "properties": {
          "marketplaceId": {
            "type": "string",
            "description": "Marketplace ID.",
            "example": "allegro-business-cz"
          },
          "status": {
            "type": "string",
            "description": "Turnover discount status.",
            "example": "ACTIVATING",
            "enum": [
              "ACTIVATING",
              "ACTIVE",
              "DEACTIVATING"
            ]
          },
          "definitions": {
            "type": "array",
            "description": "Definitions currently active or active in the future.",
            "items": {
              "$ref": "#/components/schemas/TurnoverDiscountDefinitionDto"
            }
          }
        }
      },
      "TurnoverDiscountDefinitionDto": {
        "type": "object",
        "description": "Turnover discount definition.",
        "properties": {
          "cumulatingFromDate": {
            "type": "string",
            "format": "date",
            "description": "First day of cumulating turnover against definition.",
            "example": "2024-12-01"
          },
          "cumulatingToDate": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "description": "First day when cumulating turnover against definition is no longer happening. If empty - cumulating turnover will be continued indefinitely.",
            "example": null
          },
          "spendingFromDate": {
            "type": "string",
            "format": "date",
            "description": "First day of applying discount from this definition based on cumulated turnover.",
            "example": "2025-01-01"
          },
          "spendingToDate": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "description": "First day when applying discount from definition is no longer happening. If empty - applying discount will be continued indefinitely.",
            "example": null
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Creation date of the definition.",
            "example": "2024-11-16T10:12:32.321Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Last update date of the definition.",
            "example": "2024-11-16T22:41:12.523Z"
          },
          "thresholds": {
            "type": "array",
            "description": "Turnover discount thresholds.",
            "items": {
              "$ref": "#/components/schemas/TurnoverDiscountThresholdDto"
            }
          }
        }
      },
      "TurnoverDiscountThresholdDto": {
        "type": "object",
        "description": "Turnover discount threshold.",
        "properties": {
          "minimumTurnover": {
            "type": "object",
            "description": "The minimum turnover that the buyer is required to accumulate in order to receive a discount for the next month.",
            "properties": {
              "amount": {
                "type": "string",
                "description": "Amount of the minimal turnover. The fractional part must be absent or equal to 0.",
                "example": "4000"
              },
              "currency": {
                "type": "string",
                "format": "ISO 4217",
                "description": "The currency provided as a 3-letter code in accordance with ISO 4217 standard (https://en.wikipedia.org/wiki/ISO_4217). Must meet the base currency for the marketplace.",
                "example": "CZK"
              }
            }
          },
          "discount": {
            "type": "object",
            "description": "Discount obtained by user after reaching turnover threshold.",
            "properties": {
              "percentage": {
                "type": "string",
                "description": "Discount percentage value. The fractional part must be absent or equal to 0.",
                "example": "5"
              }
            }
          }
        }
      },
      "PostPurchaseIssueListResponse": {
        "type": "object",
        "properties": {
          "issues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PostPurchaseIssue"
            }
          }
        }
      },
      "PostPurchaseIssue": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Identifier of the issue",
            "example": "54b50cb5-2dd3-4ce0-9c41-57ac5981d2ab"
          },
          "type": {
            "type": "string",
            "description": "Whether the issue is a dispute or a claim",
            "enum": [
              "DISPUTE",
              "CLAIM"
            ],
            "example": "CLAIM"
          },
          "referenceNumber": {
            "type": "string",
            "nullable": true,
            "description": "Human readable claim identifier. Null for disputes",
            "example": "123/2024"
          },
          "decisionDueDate": {
            "type": "string",
            "nullable": true,
            "format": "date-time",
            "description": "Deadline for claim acceptance or rejection. Null for disputes",
            "example": "2025-06-29T18:12:12.000.019Z"
          },
          "openedDate": {
            "type": "string",
            "format": "date-time",
            "example": "2025-06-15T18:12:12.000.019Z",
            "description": "The most recent date when the issue has been opened or reopened"
          },
          "subject": {
            "type": "string",
            "description": "Subject of the issue, possible values in english based on the reason field: - NO_PRODUCT_RECEIVED - I have not received the product - NO_PRODUCT_IN_PARCEL - no product in the parcel - NO_PROOF_OF_PURCHASE_MANUAL_OR_WARRANTY - no proof of purchase, manual, or warranty - MISSING_PRODUCT_ELEMENT - missing product element - PRODUCT_AND_PARCEL_DAMAGED_IN_TRANSIT - product and parcel damaged (in transit) - PRODUCT_DAMAGED_PARCEL_INTACT - the product is damaged, but the parcel is intact - DEFECT_FOUND_DURING_USE - defects emerged during use - NOT_AS_DESCRIBED - does not match the description - SELLER_DOES_NOT_WANT_TO_ACCEPT_RETURN - the seller does not want to accept the return - PROBLEM_WITH_SENDING_PRODUCT_BACK - I have a problem returning the product - NO_REFUND_AFTER_RETURNING_PRODUCT - no refund after returning the product - NO_REFUND_AFTER_CANCELING_ORDER - no refund after canceling the order - DID_NOT_RECEIVE_GOODS_AFTER_PAYMENT - I did not receive the goods after payment - RECEIVED_ITEMS_NOT_MATCHING_DESCRIPTION - I received an order inconsistent with the description - RECEIVED_INCOMPLETE_ORDER - I received an incomplete order - ITEM_IS_DAMAGED - the product is damaged - PROBLEM_WITH_WITHDRAWAL_CANCELLATION_OF_PURCHASE - problem with withdrawal/cancelation of purchase - PROBLEM_WITH_GOODS_RETURN_CANCELLATION_OF_PURCHASE - I have a problem returning the goods/canceling the purchase",
            "nullable": true,
            "example": "PRODUCT_AND_PARCEL_DAMAGED_IN_TRANSIT"
          },
          "buyer": {
            "$ref": "#/components/schemas/PostPurchaseIssueUser"
          },
          "checkoutForm": {
            "$ref": "#/components/schemas/PostPurchaseIssueCheckoutForm"
          },
          "currentState": {
            "$ref": "#/components/schemas/PostPurchaseIssueState"
          },
          "chat": {
            "$ref": "#/components/schemas/PostPurchaseIssueChat"
          },
          "expectations": {
            "type": "array",
            "description": "A list of expected solutions",
            "items": {
              "$ref": "#/components/schemas/PostPurchaseIssueExpectation"
            }
          },
          "description": {
            "type": "string",
            "nullable": true,
            "example": "Package damaged"
          },
          "offer": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PostPurchaseIssueOffer"
              }
            ],
            "description": "Data about offer that is the subject of this issue, if any."
          },
          "product": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PostPurchaseIssueProduct"
              }
            ],
            "description": "Data about product that is the subject of this issue, if any."
          },
          "reason": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PostPurchaseIssueReason"
              }
            ],
            "description": "Claim reason. Not present for disputes"
          },
          "right": {
            "type": "string",
            "description": "Field only present for claims (not disputes)",
            "nullable": true,
            "enum": [
              "WARRANTY",
              "COMPLAINT"
            ],
            "example": "WARRANTY"
          },
          "attachments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PostPurchaseIssueAttachment"
            }
          }
        }
      },
      "PostPurchaseIssueStatus": {
        "type": "string",
        "enum": [
          "DISPUTE_CLOSED",
          "DISPUTE_ONGOING",
          "DISPUTE_UNRESOLVED",
          "CLAIM_SUBMITTED",
          "CLAIM_ACCEPTED",
          "CLAIM_REJECTED"
        ],
        "example": "DISPUTE_ONGOING"
      },
      "PostPurchaseIssueUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "123324643"
          },
          "login": {
            "type": "string",
            "example": "loginAllegro"
          }
        }
      },
      "PostPurchaseIssueCheckoutForm": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "54b50cb5-2dd3-4ce0-9c41-57ac5981d2ab"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2025-05-10T12:12:12.019Z"
          }
        }
      },
      "PostPurchaseIssueState": {
        "type": "object",
        "description": "Formal claim state data",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/PostPurchaseIssueStatus"
          },
          "statusDueDate": {
            "type": "string",
            "format": "date-time",
            "example": "2025-06-15T12:12:12.019Z",
            "nullable": true,
            "description": "Deadline for the seller to accept or reject the claim. Null for disputes"
          },
          "returnRequired": {
            "type": "boolean",
            "nullable": true,
            "description": "Return decision made by the seller. For claims `true` means return was specified to be required, `false` means return is not required, and `null` means the seller haven't made a decision yet. For disputes it's always `null`."
          },
          "chatActive": {
            "type": "boolean",
            "example": true,
            "nullable": false,
            "description": "Indicates whether it is currently possible to send new messages within this post-purchase issue.\n  true – Sending of new messages for this issue is active (allowed).\n  false – Sending of new messages for this issue is inactive (not allowed)."
          }
        }
      },
      "PostPurchaseIssueChat": {
        "type": "object",
        "description": "Message and state change notification data",
        "properties": {
          "lastMessage": {
            "$ref": "#/components/schemas/PostPurchaseIssueLastMessage"
          },
          "messagesCount": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "initialMessage": {
            "$ref": "#/components/schemas/PostPurchaseIssueFirstMessage"
          }
        }
      },
      "PostPurchaseIssueLastMessage": {
        "type": "object",
        "description": "Summary of the most recent message data",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "NEW",
              "SELLER_REPLIED",
              "BUYER_REPLIED",
              "ALLEGRO_ADVISOR_REPLIED"
            ],
            "example": "NEW",
            "description": "Status of the last message in a dispute or claim:\n  - *NEW* - The seller never sent a message in the chat. Latest message could have been sent by buyer or advisor.\n  - *SELLER_REPLIED* - The last message was written by the seller.\n  - *BUYER_REPLIED - The last message was written by the buyer and the seller has written at least one message previously.\n  - *ALLEGRO_ADVISOR_REPLIED - The last message was written by an advisor and the seller has written at least one message previously."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2025-06-10T14:12:12.019Z"
          }
        }
      },
      "PostPurchaseIssueFirstMessage": {
        "type": "object",
        "description": "Message with text, attachment or both",
        "properties": {
          "id": {
            "type": "string",
            "example": "54b50cb5-2dd3-4ce0-9c41-57ac5981d2ab"
          },
          "text": {
            "type": "string",
            "example": "I have a problem with product"
          },
          "attachments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PostPurchaseIssueAttachment"
            }
          },
          "author": {
            "$ref": "#/components/schemas/PostPurchaseIssueAuthor"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2025-06-10T12:12:12.019Z"
          }
        }
      },
      "PostPurchaseIssueAttachment": {
        "type": "object",
        "properties": {
          "fileName": {
            "type": "string",
            "maxLength": 255,
            "example": "fileName.png"
          },
          "url": {
            "type": "string",
            "description": "Direct link to the attachment",
            "example": "https://api.allegro.pl/sale/issues/attachments/eeed0007-4404-4176-a1eb-11d26f056c0d"
          }
        }
      },
      "PostPurchaseIssueAuthor": {
        "type": "object",
        "properties": {
          "login": {
            "type": "string",
            "description": "Not present if role is ADMIN or FULFILLMENT",
            "example": "userLogin"
          },
          "role": {
            "type": "string",
            "enum": [
              "BUYER",
              "ADMIN"
            ],
            "example": "BUYER"
          }
        }
      },
      "PostPurchaseIssueOffer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The offer that is the subject of this issue.",
            "nullable": true,
            "example": "54b50cb5-2dd3-4ce0-9c41-57ac5981d2ab"
          },
          "quantity": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "description": "How many instances of this offer are subject to this issue.",
            "example": 1
          }
        },
        "nullable": true
      },
      "PostPurchaseIssueProduct": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "c82bbdbd-1587-4d6e-a456-7287ff645093",
            "description": "The offer that is the subject of this issue.",
            "nullable": true
          }
        },
        "nullable": true
      },
      "PostPurchaseIssueExpectation": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "REPAIR",
              "EXCHANGE",
              "REFUND",
              "PARTIAL_REFUND",
              null
            ],
            "nullable": true,
            "example": "REPAIR",
            "description": "Null for disputes, only available for claims."
          },
          "refund": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PostPurchaseIssueRefund"
              }
            ]
          }
        }
      },
      "PostPurchaseIssueRefund": {
        "type": "object",
        "description": "Expected refund",
        "properties": {
          "amount": {
            "type": "string",
            "description": "Expected money amount",
            "example": "2.50"
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217 currency code",
            "example": "PLN"
          }
        },
        "nullable": true
      },
      "PostPurchaseIssueReason": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "NO_PRODUCT_RECEIVED",
              "NO_PRODUCT_IN_PARCEL",
              "NO_PROOF_OF_PURCHASE_MANUAL_OR_WARRANTY",
              "MISSING_PRODUCT_ELEMENT",
              "PRODUCT_AND_PARCEL_DAMAGED_IN_TRANSIT",
              "PRODUCT_DAMAGED_PARCEL_INTACT",
              "DEFECT_FOUND_DURING_USE",
              "NOT_AS_DESCRIBED",
              "SELLER_DOES_NOT_WANT_TO_ACCEPT_RETURN",
              "PROBLEM_WITH_SENDING_PRODUCT_BACK",
              "NO_REFUND_AFTER_RETURNING_PRODUCT",
              "NO_REFUND_AFTER_CANCELING_ORDER",
              "DID_NOT_RECEIVE_GOODS_AFTER_PAYMENT",
              "RECEIVED_ITEMS_NOT_MATCHING_DESCRIPTION",
              "RECEIVED_INCOMPLETE_ORDER",
              "ITEM_IS_DAMAGED",
              "PROBLEM_WITH_WITHDRAWAL_CANCELLATION_OF_PURCHASE",
              "PROBLEM_WITH_GOODS_RETURN_CANCELLATION_OF_PURCHASE"
            ],
            "example": "NO_PRODUCT_IN_PARCEL"
          },
          "description": {
            "type": "string",
            "nullable": true,
            "example": "Missing product in parcel"
          }
        },
        "nullable": true
      },
      "PostPurchaseIssueChatResponse": {
        "type": "object",
        "properties": {
          "chat": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PostPurchaseIssueChatMessage"
            }
          }
        }
      },
      "PostPurchaseIssueChatMessage": {
        "type": "object",
        "description": "Post purchase issue message with text or attachment or both",
        "properties": {
          "id": {
            "type": "string",
            "example": "9f190d67-b1c6-42ca-b1b2-612631a1ee87"
          },
          "text": {
            "type": "string",
            "example": "Issue with product"
          },
          "attachments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PostPurchaseIssueAttachment"
            }
          },
          "author": {
            "$ref": "#/components/schemas/PostPurchaseIssueMessageAuthor"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2025-06-10T12:12:12.019Z"
          }
        }
      },
      "PostPurchaseIssueMessage": {
        "type": "object",
        "description": "Post purchase issue message with text or attachment or both",
        "properties": {
          "id": {
            "type": "string",
            "example": "Issue with product"
          },
          "text": {
            "type": "string",
            "example": "Issue with product"
          },
          "attachments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PostPurchaseIssueAttachment"
            }
          },
          "author": {
            "$ref": "#/components/schemas/PostPurchaseIssueMessageAuthor"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2025-06-10T12:12:12.019Z"
          }
        }
      },
      "PostPurchaseIssueMessageAuthor": {
        "type": "object",
        "description": "Author of the message",
        "properties": {
          "login": {
            "type": "string",
            "description": "Not present if role is ADMIN, SYSTEM or FULFILLMENT"
          },
          "role": {
            "type": "string",
            "enum": [
              "BUYER",
              "SELLER",
              "ADMIN",
              "SYSTEM",
              "FULFILLMENT"
            ],
            "example": "BUYER"
          }
        }
      },
      "CpsConversionResponse": {
        "type": "object",
        "properties": {
          "conversions": {
            "type": "array",
            "description": "CPS conversions list associated with filters and logged-in user.",
            "items": {
              "$ref": "#/components/schemas/CpsConversion"
            }
          }
        }
      },
      "CpsConversion": {
        "type": "object",
        "description": "Represents a CPS conversion.",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier of the conversion.",
            "example": "2991e29e-5fbc-46f5-963a-65c326ba65c2"
          },
          "status": {
            "type": "string",
            "description": "Current status of the conversion.",
            "enum": [
              "CREATED",
              "REJECTED",
              "CONFIRMED"
            ],
            "example": "CONFIRMED"
          },
          "lastModifiedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Date and time when the conversion was last modified.",
            "example": "2021-11-30T15:17:05.130000+00:00"
          },
          "orderCreatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Date and time when the related order was created.",
            "example": "2021-11-25T15:00:05.150000+00:00"
          },
          "quantity": {
            "type": "integer",
            "description": "Number of ordered items associated with the conversion subtracted by number of items returned.",
            "example": 5
          },
          "marketplace": {
            "type": "object",
            "description": "Information about the marketplace.",
            "properties": {
              "id": {
                "$ref": "#/components/schemas/MarketplaceId"
              }
            }
          },
          "offer": {
            "type": "object",
            "description": "Information about the offer.",
            "properties": {
              "id": {
                "type": "string",
                "description": "Identifier of the offer.",
                "example": 11223344556
              },
              "name": {
                "type": "string",
                "description": "Offer name in the offer base language.",
                "example": "Example offer name"
              },
              "category": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "The Category ID.",
                    "example": "257929"
                  }
                }
              },
              "unitPrice": {
                "type": "object",
                "description": "Unit price of the offer.",
                "properties": {
                  "amount": {
                    "type": "string",
                    "description": "Price amount.",
                    "example": "100.00"
                  },
                  "currency": {
                    "type": "string",
                    "description": "Currency code.",
                    "example": "PLN"
                  }
                }
              },
              "seller": {
                "type": "object",
                "description": "Information about the seller.",
                "properties": {
                  "login": {
                    "type": "string",
                    "description": "Login of the seller",
                    "example": "login"
                  }
                }
              }
            }
          },
          "commission": {
            "type": "object",
            "description": "Commission information.",
            "properties": {
              "publisher": {
                "type": "object",
                "description": "Publisher's commission.",
                "properties": {
                  "amount": {
                    "type": "string",
                    "description": "Commission amount.",
                    "example": "1.00"
                  },
                  "currency": {
                    "type": "string",
                    "description": "Currency code.",
                    "example": "PLN"
                  }
                }
              },
              "allegro": {
                "type": "object",
                "description": "Allegro's commission.",
                "properties": {
                  "amount": {
                    "type": "string",
                    "description": "Commission amount.",
                    "example": "10.00"
                  },
                  "currency": {
                    "type": "string",
                    "description": "Currency code.",
                    "example": "PLN"
                  }
                }
              }
            }
          },
          "publisherUrlParameters": {
            "type": "object",
            "description": "Parameters from the publisher's URL.",
            "additionalProperties": {
              "type": "string"
            },
            "example": {
              "param1": "value1",
              "param2": "value2",
              "param3": "value3"
            }
          }
        }
      },
      "DepositTypeResponse": {
        "type": "object",
        "description": "Deposit types available to use during creating an offer",
        "properties": {
          "deposits": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DepositType"
            },
            "description": "List of deposit types"
          }
        }
      },
      "DepositType": {
        "type": "object",
        "description": "Deposit type",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "The deposit ID",
            "example": "5e8a9e73-7e55-4896-bd8a-9c430413e808"
          },
          "name": {
            "type": "string",
            "description": "The deposit description",
            "example": "Reusable glass bottles up to 1.5 liters"
          },
          "marketplaceId": {
            "$ref": "#/components/schemas/MarketplaceId"
          },
          "price": {
            "$ref": "#/components/schemas/Price"
          }
        }
      }
    }
  }
}
