                          },
                          "application": {
                            "type": "ALWAYS"
                          },
                          "visibility": {
                            "type": "WITHIN",
                            "from": "2018-01-01T23:00:00Z",
                            "to": "2020-10-04T23:00:00Z"
                          },
                          "publication": {
                            "type": "UNTIL",
                            "to": "2020-10-03T23:00:00Z"
