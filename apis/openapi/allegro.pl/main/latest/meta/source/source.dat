            "schema": {
              "type": "string",
              "format": "BCP-47 language code",
              "enum": [
                "en-US",
                "pl-PL",
                "uk-UA",
                "sk-SK",
                "cs-CZ",
                "hu-HU"
              ]
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/vnd.allegro.public.v1+json": {
              "schema": {
                "$ref": "#/components/schemas/TaxIdRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
