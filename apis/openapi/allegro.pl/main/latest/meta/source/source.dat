              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorsHolder"
                }
              }
            }
          }
        },
        "tags": [
          "Tax Identification Number"
        ],
        "operationId": "addTaxId",
        "security": [
          {
            "bearer-token-for-user": [
              "allegro:api:fulfillment:write"
            ]
          }
        ]
      },
      "put": {
        "summary": "Update tax identification number",
        "description": "Use this resource to update tax identification number. For international sellers only. Read more: <a href=\"../../news/one-fulfillment-umozliwiamy-zarzadzanie-numerem-identyfikacji-podatkowej-vat-6M2xgdAmGFM\" target=\"_blank\">PL</a> / <a href=\"../../news/one-fulfillment-we-allow-you-to-manage-your-vat-identification-number-Pgj9WXjWwcm\" target=\"_blank\">EN</a>.",
        "parameters": [
