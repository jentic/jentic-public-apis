            "in": "query",
            "description": "Checkout form revision.",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "819b5836"
          },
          {
            "name": "Accept-Language",
            "in": "header",
            "required": false,
            "description": "Expected language of messages.",
            "example": "en-US",
            "schema": {
              "type": "string",
              "format": "BCP-47 language code",
              "enum": [
                "en-US"
              ]
            }
          }
        ],
        "requestBody": {
          "content": {
