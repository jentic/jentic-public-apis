          },
          "status": {
            "type": "string",
            "description": "Desired participation status (ALLOWED or DENIED)",
            "example": "ALLOWED"
          }
        },
        "required": [
          "id",
          "status"
        ]
      },
      "AllegroPricesAccountParticipationRequest": {
        "type": "object",
        "description": "Request to update account participation for one or more marketplaces",
        "properties": {
          "marketplaces": {
            "type": "array",
            "description": "List of marketplaces to update (must not be empty)",
