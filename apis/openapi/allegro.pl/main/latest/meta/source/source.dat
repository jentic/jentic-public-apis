                }
              }
            },
            "headers": {
              "location": {
                "description": "The location of the created withdraw offer command (URI).",
                "schema": {
                  "type": "string"
                },
                "example": "https://api.allegro.pl/sale/alle-discount/withdraw-offer-commands/c1b3f63d-d293-4333-911d-a0c1053e2c81"
