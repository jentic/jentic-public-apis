      },
      "CheckoutFormDeliveryTimeGuaranteed": {
        "deprecated": true,
        "type": "object",
        "description": "Guaranteed date when first delivery attempt takes place. This is always filled for Allegro One Courier delivery method. This field is deprecated in favor of `delivery.time.from` and `delivery.time.to`.",
        "properties": {
          "from": {
            "type": "string",
            "format": "date-time",
            "description": "ISO date when the earliest delivery attempt can take place.",
