                }
              }
            }
          }
        },
        "security": [
          {
            "bearer-token-for-user": [
              "allegro:api:sale:settings:read"
            ]
          }
        ]
      },
      "post": {
        "tags": [
          "Delivery"
        ],
        "summary": "Create a new shipping rates set",
        "description": "Use this resource to create a new seller's shipping rates set. Read more: <a href=\"../../tutorials/jak-zarzadzac-kontem-danymi-uzytkownika-ZM9YAKgPgi2#jak-dodac-cennik-dostaw\" target=\"_blank\">PL</a> / <a href=\"../../tutorials/account-and-user-data-management-jn9vBjqjnsw#how-to-add-shipping-rates\" target=\"_blank\">EN</a>.",
