              }
            }
          }
        },
        "description": "Single opertion data."
      },
      "ProductOfferBase": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "c9e39cae-9cb6-11e9-a2a3-2a2ae2dbcce4",
            "description": "Product id."
          },
          "idType": {
            "type": "string",
            "enum": [
              "GTIN",
              "MPN"
            ],
            "example": "GTIN",
            "description": "Type of id. This field is optional. It helps in finding products more accurately. If an idType is not set, a given id is understood as a product's id.\n - `GTIN` - restricts the search filtering to GTINs (Global Trade Item Number), e.g. EAN, ISBN, UPC.\n - `MPN` - restricts the search filtering to MPNs (Manufacturer Part Number)."
          },
          "parameters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ParameterProductOfferRequest"
            },
            "description": "List of product parameters."
          },
          "images": {
            "type": "array",
            "items": {
              "type": "string",
              "example": "https://a.allegroimg.com/original/12068b/359d04074521b79df1b2807a6727"
            },
            "description": "List of product images."
          }
        }
      },
      "ProductOffer": {
        "allOf": [
          {
            "type": "object",
