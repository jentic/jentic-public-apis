            "type": "string",
            "example": "53703086"
          }
        }
      },
      "SalesQualityHistoryResponse": {
        "type": "object",
        "required": [
          "quality"
        ],
        "properties": {
          "quality": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SalesQualityForDay"
            }
          }
