      "UserRating": {
        "type": "object",
        "required": [
          "buyer",
          "createdAt",
          "id",
          "recommended"
        ],
        "properties": {
          "answer": {
            "$ref": "#/components/schemas/Answer"
          },
          "buyer": {
            "$ref": "#/components/schemas/User"
          },
