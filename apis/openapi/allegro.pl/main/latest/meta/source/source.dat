      "MarketplaceDto": {
        "type": "object",
        "description": "Marketplace identifier",
        "properties": {
          "id": {
            "type": "string",
            "description": "Marketplace identifier (e.g., 'allegro-pl', 'allegro-cz', 'allegro-sk', 'allegro-hu')",
            "example": "allegro-pl"
          }
        },
        "required": [
          "id"
        ]
      },
      "MoneyDto": {
        "type": "object",
        "description": "Monetary value with amount and currency",
        "properties": {
          "amount": {
            "type": "string",
            "description": "Monetary amount as a string with decimal precision (e.g., '100.00')",
            "example": "100.00"
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217 currency code (e.g., 'PLN', 'CZK', 'EUR', 'HUF')",
            "example": "PLN"
          }
        },
        "required": [
          "amount",
          "currency"
        ]
      },
      "DeclaredPriceReductionDto": {
        "type": "object",
        "description": "Information about seller's declared price reduction for Allegro Prices program",
        "properties": {
          "sellerMaxDeclaredPercentage": {
            "type": "string",
            "description": "Maximum percentage of base price that the seller declared to discount (as a string, e.g., '10.0' means 10%)",
            "example": "10.0"
          },
          "sellerMaxDeclaredDiscount": {
            "allOf": [
              {
                "$ref": "#/components/schemas/MoneyDto"
              },
              {
                "description": "Maximum monetary discount amount that the seller declared (calculated from the percentage and base price)"
              }
            ]
          }
        },
        "required": [
          "sellerMaxDeclaredPercentage",
          "sellerMaxDeclaredDiscount"
        ]
      },
      "ActualPriceReductionDto": {
        "type": "object",
        "description": "Information about the actual price reduction currently applied in Allegro Prices program",
        "properties": {
          "sellerMaxDeclaredPercentage": {
            "type": "string",
            "description": "Maximum percentage of base price that the seller declared to discount (as a string, e.g., '10.0' means 10%)",
            "example": "10.0"
          },
          "sellerMaxDeclaredDiscount": {
            "allOf": [
              {
                "$ref": "#/components/schemas/MoneyDto"
              },
              {
                "description": "Maximum monetary discount amount that the seller declared (calculated from the percentage and base price)"
              }
            ]
          },
          "sellerDiscount": {
            "allOf": [
              {
                "$ref": "#/components/schemas/MoneyDto"
              },
              {
                "description": "Actual monetary discount amount calculated for the seller"
              }
            ]
          },
          "allegroDiscount": {
            "allOf": [
              {
                "$ref": "#/components/schemas/MoneyDto"
              },
              {
                "description": "Monetary discount amount co-financed by Allegro"
              }
            ]
          },
          "finalPriceForTheBuyer": {
            "allOf": [
              {
                "$ref": "#/components/schemas/MoneyDto"
              },
              {
                "description": "Final price that the buyer pays after all discounts are applied (base price - seller discount - Allegro discount)"
              }
            ]
          }
        },
        "required": [
          "sellerMaxDeclaredPercentage",
          "sellerMaxDeclaredDiscount",
          "sellerDiscount",
          "allegroDiscount",
          "finalPriceForTheBuyer"
        ]
      },
      "DiscountDto": {
        "type": "object",
        "description": "Discount information for the offer in the Allegro Prices program.",
        "properties": {
          "opportunity": {
            "type": "boolean",
            "description": "Whether this offer has an opportunity to be discounted by Allegro.",
            "example": true
          }
        },
        "required": [
          "opportunity"
        ]
      },
      "RecommendedPriceReductionDto": {
        "type": "object",
        "description": "Recommended price reduction for the offer in the Allegro Prices program.",
        "properties": {
          "sellerMaxDeclaredPercentage": {
            "type": "string",
            "description": "Recommended maximum seller declared discount percentage.",
            "example": "10.0"
          }
        },
        "required": [
          "sellerMaxDeclaredPercentage"
        ]
      },
      "OfferFilterDto": {
        "type": "object",
        "description": "Filter options for offers",
        "properties": {
          "ids": {
            "type": "array",
            "description": "Optional list of offer IDs to filter by. The list must contain between 1 and 1000 items. If not provided, all offers matching other criteria will be returned.",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20
            },
            "minItems": 1,
            "maxItems": 1000
          },
          "scope": {
            "type": "string",
            "description": "Optional scope filter to narrow down offers by their Allegro Prices status. Supported values: 'WITH_DECLARATION' (offers with seller price reduction declaration), 'DISCOUNTED' (offers currently discounted in Allegro Prices program), 'EXCLUDED' (offers excluded from Allegro Prices program). If not provided, all offers regardless of scope will be returned.",
            "enum": [
              "WITH_DECLARATION",
              "DISCOUNTED",
              "EXCLUDED"
            ],
            "example": "WITH_DECLARATION"
          },
          "substatus": {
            "type": "string",
            "description": "Optional substatus filter to narrow down offers. Supported values: 'DISCOUNT_OPPORTUNITY' (offers with discount opportunity), 'DISCOUNT_RECOMMENDATION' (offers with discount recommendation). Can be combined with any scope value.",
            "enum": [
              "DISCOUNT_OPPORTUNITY",
              "DISCOUNT_RECOMMENDATION"
            ],
            "example": "DISCOUNT_OPPORTUNITY"
          }
        }
      },
      "MarketplaceFilterDto": {
        "type": "object",
        "description": "Marketplace identifier filter",
        "properties": {
          "id": {
            "type": "string",
            "description": "Marketplace identifier. Supported values: 'allegro-pl', 'allegro-cz', 'allegro-sk', 'allegro-hu'. Required field.",
            "enum": [
              "allegro-pl",
              "allegro-cz",
              "allegro-sk",
              "allegro-hu"
            ],
            "example": "allegro-pl"
          }
        },
        "required": [
          "id"
        ]
      },
      "OfferStatusItemDto": {
        "type": "object",
        "description": "Detailed information about an offer's Allegro Prices status",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique offer identifier",
            "example": "10000000001"
          },
          "name": {
            "type": "string",
            "description": "Offer title/name",
            "example": "Example Product Title"
          },
          "marketplace": {
            "allOf": [
              {
                "$ref": "#/components/schemas/MarketplaceDto"
              },
              {
                "description": "Marketplace where the offer is listed"
              }
            ]
          },
          "basePrice": {
            "type": "object",
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/MoneyDto"
              }
            ],
            "description": "Base price of the offer before any discounts. May be null if price is not available."
          },
          "discount": {
            "allOf": [
              {
                "$ref": "#/components/schemas/DiscountDto"
              },
              {
                "description": "Discount information for the offer in the Allegro Prices program."
              }
            ]
          },
          "recommendedPriceReduction": {
            "description": "Recommended price reduction for the offer. Contains the recommended seller discount percentage. Null if no recommendation is available.",
            "anyOf": [
              {
                "$ref": "#/components/schemas/RecommendedPriceReductionDto"
              },
              {
                "nullable": true,
                "type": "object"
              }
            ]
          },
          "declaredPriceReduction": {
            "description": "Information about the seller's declared price reduction for Allegro Prices program. Contains the maximum percentage and amount the seller is willing to discount. Null if the seller has not made a declaration.",
            "anyOf": [
              {
                "$ref": "#/components/schemas/DeclaredPriceReductionDto"
              },
              {
                "nullable": true,
                "type": "object"
              }
            ]
          },
          "actualPriceReduction": {
            "description": "Information about the actual price reduction currently applied in the Allegro Prices program. Contains details about seller discount, Allegro co-financing, and final price for the buyer. Null if the offer is not currently discounted.",
            "anyOf": [
              {
                "$ref": "#/components/schemas/ActualPriceReductionDto"
              },
              {
                "nullable": true,
                "type": "object"
              }
            ]
          },
          "discountedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the offer was discounted in the Allegro Prices program. Null if the offer is not discounted.",
            "example": "2024-01-15T10:30:00.000Z",
            "nullable": true
          },
          "excludedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the offer was excluded from the Allegro Prices program. Null if the offer is not excluded.",
            "example": "2024-01-20T14:45:00.000Z",
            "nullable": true
          }
        },
        "required": [
          "id",
          "name",
          "marketplace",
          "discount"
        ]
      },
      "OfferStatusQueryRequestDto": {
        "type": "object",
        "description": "Request parameters for querying Allegro Prices offers status",
        "properties": {
          "offer": {
            "allOf": [
              {
                "$ref": "#/components/schemas/OfferFilterDto"
              },
              {
                "description": "Optional filter for offers by IDs and/or scope. If not provided, all offers for the marketplace will be returned."
              }
            ]
          },
          "marketplace": {
            "allOf": [
              {
                "$ref": "#/components/schemas/MarketplaceFilterDto"
              },
              {
                "description": "Marketplace filter to specify which marketplace to query offers from. Required field."
              }
            ]
          },
          "limit": {
            "type": "integer",
            "format": "int32",
            "description": "Maximum number of offers to return in a single response. Must be between 1 and 1000.",
            "default": 20,
            "minimum": 1,
            "maximum": 1000,
            "example": 20
          },
          "offset": {
            "type": "integer",
            "format": "int32",
            "description": "Number of offers to skip before starting to return results. Used for pagination. Must be at least 0.",
            "default": 0,
            "minimum": 0,
            "example": 0
          }
        },
        "required": [
          "marketplace"
        ]
      },
      "OfferStatusQueryResponseDto": {
        "type": "object",
        "description": "Response containing a list of offers and their status in Allegro Prices program and pagination information",
        "properties": {
          "offers": {
            "type": "array",
            "description": "List of offers matching the query criteria. Each offer contains detailed information about its Allegro Prices status.",
            "items": {
              "$ref": "#/components/schemas/OfferStatusItemDto"
            }
          },
          "totalCount": {
            "type": "integer",
            "format": "int32",
            "description": "Total count of offers matching the query criteria.",
            "example": 150
          },
          "count": {
            "type": "integer",
            "format": "int32",
            "description": "Number of offers returned in this response (may be less than limit if fewer offers are available).",
            "example": 20
          }
        },
        "required": [
          "offers",
          "totalCount",
          "count"
        ]
      },
      "AlleDiscountSubmitCommandRequest": {
        "type": "object",
        "properties": {
          "commandId": {
            "type": "string",
            "description": "The command UUID. If empty, system generates new one.",
            "nullable": true,
            "example": "c1b3f63d-d293-4333-911d-a0c1053e2c81"
          },
          "input": {
            "type": "object",
            "description": "Command input.",
            "properties": {
              "offer": {
                "type": "object",
                "description": "Data of the offer you want to submit to the AlleDiscount campaign.",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "The id of the offer.",
                    "example": "1234548213"
                  }
                }
              },
              "campaign": {
                "type": "object",
                "description": "Data of AlleDiscount campaign you want to submit your offer to.",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "The id of the AlleDiscount campaign.",
                    "example": "ALLEOBNIZKA_20230209"
                  }
                }
              },
              "proposedPrice": {
                "type": "object",
                "description": "The price you agree to lower to for the offer. Must be equal or lower than requiredMerchantPrice returned in `/sale/alle-discount/{campaignId}/eligible-offers` endpoint.",
                "properties": {
                  "amount": {
                    "type": "string",
                    "description": "Amount of the proposed price.",
                    "example": "19.99"
                  },
                  "currency": {
                    "type": "string",
                    "description": "Currency of the proposed price.",
                    "example": "PLN"
                  }
                }
              }
            }
          }
        }
      },
      "AlleDiscountSubmitCommandResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Provided UUID of the submit offer command or generated UUID.",
            "example": "c1b3f63d-d293-4333-911d-a0c1053e2c81"
          },
          "input": {
            "type": "object",
            "description": "Provided submit offer command input data.",
            "properties": {
              "offer": {
                "type": "object",
                "description": "Offer data.",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "The id of the offer.",
                    "example": "10394822344"
                  }
                }
              },
              "campaign": {
                "type": "object",
                "description": "Campaign data.",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "The id of the campaign.",
                    "example": "ALLEOBNIZKA_20230209"
                  }
                }
              },
              "proposedPrice": {
                "type": "object",
                "description": "The price you agreed to lower to for the offer.",
                "properties": {
                  "amount": {
                    "type": "string",
                    "description": "Amount of the price.",
                    "example": "19.99"
                  },
                  "currency": {
                    "type": "string",
                    "description": "Currency of the price.",
                    "example": "PLN"
                  }
                }
              }
            }
          },
          "output": {
            "type": "object",
            "description": "Submit offer command output data.",
            "properties": {
              "status": {
                "type": "string",
                "description": "Execution status of the command.",
                "enum": [
                  "NEW"
                ],
                "example": "NEW"
              },
              "createdAt": {
                "type": "string",
                "description": "Creation date of the command. ISO 8601 format.",
                "format": "date-time",
                "example": "2020-08-26T12:52:04Z"
              },
              "updatedAt": {
                "type": "string",
                "format": "date-time",
                "description": "Update date of the command. ISO 8601 format.",
                "example": "2020-08-26T12:52:04Z"
              }
            }
          }
        }
      },
      "AlleDiscountGetSubmitCommandResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The id of the command.",
            "example": "c1b3f63d-d293-4333-911d-a0c1053e2c81"
          },
          "input": {
            "type": "object",
            "description": "Provided submit offer command input data.",
            "properties": {
              "offer": {
                "type": "object",
                "description": "Offer data.",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "The id of the offer.",
                    "example": "10394822344"
                  }
                }
              },
              "campaign": {
                "type": "object",
                "description": "Campaign data.",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "The id of the campaign.",
                    "example": "ALLEOBNIZKA_20230209"
                  }
                }
              },
              "proposedPrice": {
                "type": "object",
                "description": "The price you agreed to lower to for the offer.",
                "properties": {
                  "amount": {
                    "type": "string",
                    "description": "Amount of the price.",
                    "example": "19.99"
                  },
                  "currency": {
                    "type": "string",
                    "description": "Currency of the price.",
                    "example": "PLN"
                  }
                }
              }
            }
          },
          "output": {
            "type": "object",
            "description": "Submit offer command output data.",
            "properties": {
              "status": {
                "type": "string",
                "description": "Status field possible values:\n  - NEW - command processing has not started.\n  - IN_PROGRESS - command is being processed.\n  - FAILED - processing of the command failed. Offer will not participate in AlleDiscount.\n  - SUCCESSFUL - processing of the command was successful. New participation was created but in some cases it still may be denied.\n    To make sure that the offer is participating in AlleDiscount, check the participation status in\n    'GET /sale/alle-discount/{campaignId}/submitted-offers`.",
                "enum": [
                  "NEW",
                  "IN_PROGRESS",
                  "SUCCESSFUL",
                  "FAILED"
                ],
                "example": "SUCCESSFUL"
              },
              "createdAt": {
                "type": "string",
                "format": "date-time",
                "description": "Command creation date. ISO 8601 format.",
                "example": "2020-08-26T12:52:04Z"
              },
              "updatedAt": {
                "type": "string",
                "format": "date-time",
                "description": "Command update date. ISO 8601 format.",
                "example": "2020-08-26T12:52:04Z"
              },
              "newOfferParticipation": {
                "type": "object",
                "nullable": true,
                "description": "Object containing info about created participation in AlleDiscount, contains the id of the created participation.",
                "properties": {
                  "participationId": {
                    "type": "string",
                    "description": "The id of the participation created by submit offer command.",
                    "example": "f9a4a70c-6db9-4473-976c-90f8df9f74e8"
                  }
                }
              },
              "errors": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ErrorsHolder"
                }
              }
            }
          }
        }
      },
      "AlleDiscountWithdrawCommandRequest": {
        "type": "object",
        "properties": {
          "commandId": {
            "type": "string",
            "description": "The Command UUID. If empty, system generates new one.",
