            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "images",
              "description"
            ]
          }
        },
        "description": "Each path will point to a specific field in object which is co-created by AI."
      },
      "TrustedContent": {
        "type": "object",
        "required": [
          "paths",
          "productPaths"
        ],
        "properties": {
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "images",
              "description",
              "name"
            ],
            "description": "Paths specify which product attributes need to remain consistent between the product and the offer."
          },
          "productPaths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "images",
              "category",
              "description",
              "name"
            ],
            "description": "ProductPaths specify which product elements are considered trusted and are excluded from the product suggestion process."
          }
        }
      },
