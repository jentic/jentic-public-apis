      "ProductParameterDto": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "123456"
          },
          "name": {
            "type": "string",
            "example": "Brand"
          },
          "rangeValue": {
            "$ref": "#/components/schemas/ParameterRangeValue"
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": "[\"4234\"]"
          },
          "valuesIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": "[\"129970_850936\"]"
          },
          "valuesLabels": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": "[\"No information\"]"
          },
          "unit": {
            "type": "string",
            "example": null
          },
          "options": {
            "type": "object",
            "required": [
              "identifiesProduct"
