                  "$ref": "#/components/schemas/CommandTaskWithStockSubject"
                }
              ]
            }
          }
        },
        "description": "Contains list of task results."
      },
      "UUID": {
        "type": "string",
        "format": "uuid",
        "description": "Universally Unique Identifier (UUID) generated by you that can be used to enforce idempotency. UUID specification: http://www.ietf.org/rfc/rfc4122.txt"
      },
      "User": {
        "type": "object",
