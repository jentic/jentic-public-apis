    "/sale/issues/{issueId}/chat": {
      "get": {
        "tags": [
          "Post Purchase Issues"
        ],
        "summary": "Get the messages and state claim changes within a post purchase issue",
        "description": "Use this resource to get the list of messages and state changes within a dispute or claim. Read more: <a href=\"../../tutorials/jak-zarzadzac-dyskusjami-E7Zj6gK7ysE#wiadomosci-z-dyskusji-i-reklamacji\" target=\"_blank\">PL</a> / <a href=\"../../tutorials/how-to-manage-discussions-VL6Yr40e5t5#disputes-and-claims-messages\" target=\"_blank\">EN</a>.",
        "operationId": "getChatFromIssueUsingGET",
        "parameters": [
          {
            "name": "issueId",
            "in": "path",
            "description": "Dispute or claim identifier.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "The maximum number of messages within issue returned in a response.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1,
              "maximum": 100,
              "default": 10
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Index of first returned message within issue.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "Accept-Language",
            "in": "header",
            "required": false,
            "description": "Expected language of messages.",
            "example": "en-US",
            "schema": {
              "type": "string",
              "format": "BCP-47 language code",
              "enum": [
                "en-US",
                "pl-PL",
                "uk-UA",
                "sk-SK",
                "cs-CZ",
                "hu-HU"
              ]
            }
          }
