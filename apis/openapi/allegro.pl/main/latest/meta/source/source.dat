                "description": "Optional seller discount declaration"
              }
            ]
          }
        },
        "required": [
          "id",
          "marketplace"
        ]
      },
      "SubsidySubmitOffersCommand": {
        "type": "object",
        "description": "Command to submit offers to the Allegro Prices program",
        "properties": {
          "commandId": {
            "type": "string",
            "format": "uuid",
            "description": "Optional custom command identifier. If not provided, a UUID will be generated automatically",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "offers": {
            "type": "array",
            "description": "List of offers to submit (1-1000 offers, must not contain duplicates)",
            "items": {
              "$ref": "#/components/schemas/SubsidyOfferToSubmit"
            },
            "minItems": 1,
            "maxItems": 1000
          }
        },
        "required": [
          "offers"
        ]
      },
      "SubsidyManageOffersCommandResult": {
        "type": "object",
        "description": "Result of a subsidy manage offers command",
        "properties": {
          "commandId": {
            "type": "string",
            "description": "Unique identifier of the command",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "status": {
            "type": "string",
            "description": "Current status of the command",
            "enum": [
              "IN_PROGRESS"
            ],
            "example": "IN_PROGRESS"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the command was created",
            "example": "2023-12-11T12:00:00.000Z"
          }
        },
        "required": [
          "commandId",
          "status",
          "createdAt"
        ]
      },
