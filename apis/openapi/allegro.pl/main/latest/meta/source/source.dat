            ]
          },
          "completedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the offer processing completed (successfully or with failure). Null if the offer is still being processed.",
            "example": "2023-12-11T12:05:00.000Z",
            "nullable": true
          },
          "status": {
            "type": "string",
            "description": "Processing status of the offer",
            "enum": [
              "SUCCESS",
              "IN_PROGRESS",
              "FAILED"
            ],
            "example": "SUCCESS"
          },
          "errors": {
            "type": "array",
            "description": "List of errors if processing failed",
            "items": {
              "$ref": "#/components/schemas/OfferError"
            },
            "nullable": true
          }
        },
        "required": [
          "id",
          "marketplace",
          "status"
        ]
      },
