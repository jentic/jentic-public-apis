      "ProductSetElementSafetyInformationRequest": {
        "type": "object",
        "properties": {
          "safetyInformation": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/TextSafetyInformation"
              },
              {
                "$ref": "#/components/schemas/AttachmentsSafetyInformation"
              }
            ],
            "discriminator": {
              "propertyName": "type",
              "mapping": {
                "TEXT": "#/components/schemas/TextSafetyInformation",
                "ATTACHMENTS": "#/components/schemas/AttachmentsSafetyInformation"
              }
            },
            "description": "Product's safety information. You can indicate it as:\n  - `ATTACHMENTS` - if you add attachments.  Reference <a href=\"https://developer.allegro.pl/documentation#operation/createOfferAttachmentUsingPOST\">Docs</a>\n  - `TEXT` - if you provide product safety information in the form of a text description."
          }
        },
        "example": {
          "safetyInformation": {
            "type": "TEXT",
            "description": "string"
          }
        }
      },
      "ProductSetElementSafetyInformationResponse": {
        "type": "object",
        "properties": {
          "safetyInformation": {
            "nullable": true,
            "oneOf": [
              {
                "$ref": "#/components/schemas/TextSafetyInformation"
              },
              {
                "$ref": "#/components/schemas/AttachmentsSafetyInformation"
              },
              {
                "$ref": "#/components/schemas/NoSafetyInformation"
              }
            ],
            "discriminator": {
              "propertyName": "type",
              "mapping": {
                "TEXT": "#/components/schemas/TextSafetyInformation",
                "ATTACHMENTS": "#/components/schemas/AttachmentsSafetyInformation",
                "NO_SAFETY_INFORMATION": "#/components/schemas/NoSafetyInformation"
              }
            },
            "description": "Contains information about product's safety. It can be returned as:\n - `ATTACHMENTS` - when it was provided as attachments.  Reference <a href=\"https://developer.allegro.pl/documentation#operation/createOfferAttachmentUsingPOST\">Docs</a>\n - `TEXT` - when the product's safety information was provided as text description.\n - `NO_SAFETY_INFORMATION` - when no safety information was provided."
          }
        }
      },
      "AttachmentsSafetyInformation": {
        "type": "object",
        "required": [
          "type",
          "attachments"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "ATTACHMENTS"
            ],
            "example": "ATTACHMENTS"
          },
          "attachments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "example": "11a2df7f-8237-4625-baa2-cb7541f39946",
                  "description": "Id of the attachment."
                }
              }
            }
          }
        }
      },
      "TextSafetyInformation": {
        "type": "object",
        "required": [
          "type",
          "description"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "TEXT"
            ],
            "example": "TEXT"
          },
          "description": {
            "type": "string",
            "example": "Contains small parts",
            "description": "Safety warnings and instructions for the product in plain text form, if the information cannot be provided through attachments. Text can't be longer than 5000 characters."
          }
        }
      },
      "NoSafetyInformation": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "NO_SAFETY_INFORMATION"
            ],
            "example": "NO_SAFETY_INFORMATION"
          }
        }
      },
      "MarketedBeforeGPSRObligation": {
        "type": "object",
        "properties": {
