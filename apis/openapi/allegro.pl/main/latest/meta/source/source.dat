    "/affiliate/conversions/cps": {
      "get": {
        "summary": "[BETA] List CPS conversions",
        "description": "Use this resource to find your CPS (Cost Per Sale) conversions for specific filters. The response contains a list of CPS conversions that correspond with the specified parameters. Read more: <a href=\"../../tutorials/afiliacja-0A1bPnwVwUq#jak-pobrac-informacje-o-konwersji-cps\" target=\"_blank\">PL</a> / <a href=\"../../tutorials/affiliation-8do60yLKPIq#how-to-retrieve-cps-conversion-information\" target=\"_blank\">EN</a>.",
        "parameters": [
          {
            "name": "orderCreatedAt.gte",
            "in": "query",
            "description": "The minimum date and time of order creation in ISO 8601 format.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "orderCreatedAt.lte",
            "in": "query",
            "description": "The maximum date and time of order creation in ISO 8601 format.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lastModifiedAt.gte",
            "in": "query",
            "description": "The minimum date and time of the latest conversion modification in ISO 8601 format.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lastModifiedAt.lte",
            "in": "query",
            "description": "The maximum date and time of the latest conversion modification in ISO 8601 format.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Conversion status. The allowed values are:\n  * CREATED\n  * REJECTED\n  * CONFIRMED.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "The offset of elements in the response.",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of elements in response.",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000,
              "default": 1000
            }
          },
          {
            "name": "includePublisherUrlParameters",
            "in": "query",
            "description": "Comma-separated keys of the ‘publisherUrlParameters’ map which will be included in the response. By default the map is empty.",
            "required": false,
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          {
            "name": "Accept-Language",
            "in": "header",
            "required": false,
            "description": "Expected language of messages.",
            "example": "en-US",
            "schema": {
              "type": "string",
              "format": "BCP-47 language code",
              "enum": [
                "en-US"
              ]
            }
          }
        ],
        "operationId": "getCpsConversions",
        "security": [
          {
            "bearer-token-for-user": [
              "allegro:api:affiliate:read"
            ]
          }
        ],
        "tags": [
          "Conversions"
        ],
        "responses": {
          "200": {
            "description": "Returns the list of CPS conversions associated with a logged-in user and matched with query parameters.",
            "content": {
              "application/vnd.allegro.beta.v1+json": {
                "schema": {
                  "$ref": "#/components/schemas/CpsConversionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "422": {
            "description": "Invalid request parameters.",
            "content": {
              "application/vnd.allegro.beta.v1+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorsHolder"
                }
              }
            }
          }
        }
      }
    },
    "/fulfillment/removal/preferences": {
      "get": {
        "summary": "Get current active removal preference",
        "description": "Use this resource to read your current removal preference. Removal preference is associated with system removal order at the moment of removal order is created. It means there can be not yet fulfilled removal orders associated with previously set removal preference. Read more: <a href=\"../../tutorials/one-fulfillment-by-allegro-0ADwgOLqWSw#pobierz-aktualne-ustawienia-sposobu-usuniecia-towaru-z-magazynu\" target=\"_blank\">PL</a> / <a href=\"../../tutorials/one-fulfillment-by-allegro-4R9dXyMPlc9#retrieve-current-settings-for-how-to-remove-goods-from-the-warehouse\" target=\"_blank\">EN</a>.",
        "tags": [
          "Fulfillment Removal"
        ],
        "responses": {
          "200": {
            "description": "Returns the current active Fulfillment Removal Preference",
            "content": {
              "application/vnd.allegro.public.v1+json": {
                "schema": {
                  "$ref": "#/components/schemas/FulfillmentRemovalPreference"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/vnd.allegro.public.v1+json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found (Fulfillment Removal Preferences was never set)"
          }
        },
        "operationId": "getFulfillmentRemovalPreferences",
        "parameters": [
          {
