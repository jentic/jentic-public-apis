  "paths": {
    "/api/v2/oauth/token": {
      "get": {
        "summary": "Obtaining an Access Token",
        "description": "Obtaining an Access Token",
        "operationId": "obtainingAnAccessToken",
        "parameters": [
          {
            "name": "grant_type",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "client_credentials"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "basicAuth": []
          }
        ]
      }
    },
    "/sync/v2/reservations": {
      "get": {
        "summary": "Reservation",
        "description": "Reservation",
        "operationId": "reservation",
        "parameters": [
          {
            "name": "rid",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "36890"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "1"
            }
          },
          {
            "name": "updated_after",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "2024-01-01T00:00:00.Z"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/sync/v2/guests": {
      "get": {
        "summary": "Guests",
        "description": "Guests",
        "operationId": "guests",
        "parameters": [
          {
            "name": "rid",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "36890"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "1"
            }
          },
          {
            "name": "updated_after",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "2024-01-01T00:00:00.Z"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/sync/v2/pos-data": {
      "get": {
        "summary": "pos-data",
        "description": "pos-data",
        "operationId": "posData",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "1"
            }
          },
          {
            "name": "scheduled_time_from",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "2025-08-19"
            }
          },
          {
            "name": "scheduled_time_to",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "2025-08-19"
            }
          },
          {
            "name": "updated_after",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "2024-01-01T00:00:00.Z"
            }
          },
          {
            "name": "rid",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "36890"
