{"openapi":"3.1.0","info":{"title":"MerchantFlow Public API","version":"1.0.0","summary":"Read-only access to a merchant's headline metrics, orders, products, and profitability.","description":"The MerchantFlow Public API lets an authorised third-party application read a\nmerchant's headline metrics, order economics, products, and profit and loss.\n\n**Read-only.** Every endpoint is `GET`. There are no write scopes to request.\n\n**Ask for the narrowest scope that works.** The `metrics:*` scopes each return\nONE figure. If your integration needs MER, request `metrics:mer:read` rather than\n`profitability:read` - the latter returns the entire P&L waterfall including COGS,\nexpenses and net profit, and merchants decline it far more often. MerchantFlow\nprovisions each partner with an allowlist of the scopes it may request at all; a\nscope outside that list is refused at `/authorize`, before any merchant sees a\nconsent screen.\n\n**No customer PII.** Customer names, email addresses, phone numbers and shipping\naddresses are never returned. Orders carry `customer_ref`, a pseudonymous\nidentifier that is stable for your application and for one merchant, and is not\ncorrelatable with any other application's identifiers.\n\n**Two numbers need care.** `ad_spend_allocated` is a blended daily allocation, not\nmeasured per-order ad spend - no ad platform reports spend at order granularity.\nAnd `cogs_coverage_pct` tells you how much of an order actually has cost data;\na high margin on an order with low coverage is missing costs, not profit.","contact":{"name":"MerchantFlow","url":"https://docs.merchantflow.ai/docs/integrations/api"}},"servers":[{"url":"https://merchantflow.ai/api/v1","description":"Production"}],"externalDocs":{"url":"https://docs.merchantflow.ai/docs/integrations/api","description":"Integration guide"},"security":[{"oauth2":[]}],"components":{"securitySchemes":{"oauth2":{"type":"oauth2","description":"OAuth 2.1 authorization code flow with PKCE (S256 required).\n\nSend the RFC 8707 resource indicator `resource=https://merchantflow.ai/api/v1` at both\nthe authorize and token endpoints. If you omit it, MerchantFlow infers it from\nyour requested scopes, but sending it explicitly is strongly preferred.\n\nRequest `offline_access` alongside your data scopes to receive a refresh token;\nwithout it your access token expires after one hour and the merchant has to\nrepeat the browser consent flow.","flows":{"authorizationCode":{"authorizationUrl":"https://merchantflow.ai/api/auth/oauth2/authorize","tokenUrl":"https://merchantflow.ai/api/auth/oauth2/token","refreshUrl":"https://merchantflow.ai/api/auth/oauth2/token","scopes":{"store:read":"Read your store name, currency, timezone, and data freshness","metrics:mer:read":"Read your Marketing Efficiency Ratio (MER) for a date range - the ratio only, not the underlying figures","metrics:revenue:read":"Read the revenue total used to calculate MER (D2C gross revenue) for a date range","metrics:ad_spend:read":"Read the advertising spend total used to calculate MER for a date range","metrics:contribution_profit:read":"Read your contribution profit total for a date range - the single figure, not the cost breakdown behind it","orders:read":"Read your orders and their economics (revenue, COGS, fees, profit). Includes a pseudonymous customer reference so the app can tell repeat buyers from new ones - never names, email addresses, phone numbers, or shipping addresses","products:read":"Read your products, variants, and cost of goods sold","profitability:read":"Read your full profit & loss summary and daily profit history, including COGS, expenses and net profit","offline_access":"Receive a refresh token"}}}}},"parameters":{"limit":{"name":"limit","in":"query","description":"Page size. Defaults to 100.","schema":{"type":"integer","minimum":1,"maximum":250,"default":100}},"cursor":{"name":"cursor","in":"query","description":"Opaque pagination cursor from a previous response's `page.next_cursor`. A cursor is bound to the exact filters it was created with - reusing one with different filters returns `400 CURSOR_FILTER_MISMATCH` rather than silently returning a page computed against the wrong query.","schema":{"type":"string"}},"metricFrom":{"name":"from","in":"query","description":"First day of the window (inclusive), YYYY-MM-DD, resolved in the STORE's timezone rather than UTC. Defaults to 29 days before `to`. Accepts `start_date` as an alias, matching the other endpoints.","schema":{"type":"string","format":"date"}},"metricTo":{"name":"to","in":"query","description":"Last day of the window (inclusive), YYYY-MM-DD, resolved in the STORE's timezone. Defaults to today. Accepts `end_date` as an alias. A window may span at most 400 days.","schema":{"type":"string","format":"date"}},"updatedAfter":{"name":"updated_after","in":"query","description":"Return only records whose data changed at or after this instant (RFC 3339).\nThis is the incremental-sync entry point, and it tracks FINANCIAL changes, not\njust edits: a COGS correction or a 3PL fulfilment cost arriving days after an\norder was placed will bring that order back through this filter.\n\nResume from your last seen `updated_at` minus a few minutes and upsert\nidempotently - the feed is at-least-once, not exactly-once.","schema":{"type":"string","format":"date-time"}}},"schemas":{"Meta":{"type":"object","description":"Provenance attached to every response.","properties":{"store_id":{"type":"string"},"currency":{"type":"string","description":"ISO 4217 for this store."},"timezone":{"type":"string","description":"IANA timezone. All date-only filters resolve in it."},"as_of":{"type":["string","null"],"format":"date-time","description":"When this store last synced. Not the request time."},"stale":{"type":"boolean","description":"True when the last sync is more than 24 hours old."},"history_available_from":{"type":["string","null"],"description":"Earliest date this store's plan includes (YYYY-MM-DD), or null for unlimited history."},"truncated":{"type":"boolean","description":"True when the request reached further back than the plan includes. Everything from history_available_from onwards is present and complete."}}},"Page":{"type":"object","properties":{"has_more":{"type":"boolean"},"next_cursor":{"type":["string","null"]},"limit":{"type":"integer"}}},"MetricPeriod":{"type":"object","description":"The window actually computed. May start later than you asked if the store's plan history window is shorter, in which case `meta.truncated` is true.","properties":{"from":{"type":"string","format":"date"},"to":{"type":"string","format":"date"}}},"MerMetric":{"type":"object","description":"Marketing Efficiency Ratio. `revenue` and `ad_spend` are present only when the token carries their own scopes.","properties":{"currency":{"type":"string","description":"ISO 4217."},"period":{"$ref":"#/components/schemas/MetricPeriod"},"mer":{"type":["number","null"],"description":"D2C gross revenue / deduplicated ad spend, to 2dp. Null when no ad spend is recorded for the window."},"revenue":{"type":"number","description":"The MER numerator: D2C gross revenue. Requires `metrics:revenue:read`."},"ad_spend":{"type":"number","description":"The MER denominator: deduplicated blended ad spend. Requires `metrics:ad_spend:read`."}},"required":["currency","period","mer"]},"RevenueMetric":{"type":"object","properties":{"currency":{"type":"string","description":"ISO 4217."},"period":{"$ref":"#/components/schemas/MetricPeriod"},"revenue":{"type":"number","description":"D2C gross revenue for the window, to 2dp."}},"required":["currency","period","revenue"]},"AdSpendMetric":{"type":"object","properties":{"currency":{"type":"string","description":"ISO 4217."},"period":{"$ref":"#/components/schemas/MetricPeriod"},"ad_spend":{"type":"number","description":"Deduplicated blended advertising spend for the window, to 2dp."}},"required":["currency","period","ad_spend"]},"ContributionProfitMetric":{"type":"object","properties":{"currency":{"type":"string","description":"ISO 4217."},"period":{"$ref":"#/components/schemas/MetricPeriod"},"contribution_profit":{"type":"number","description":"Revenue less COGS, shipping, fulfilment, payment fees and ad spend, to 2dp."}},"required":["currency","period","contribution_profit"]},"Error":{"type":"object","properties":{"success":{"type":"boolean","const":false},"error":{"type":"object","properties":{"code":{"type":"string"},"message":{"type":"string"}}}}},"OrderEconomics":{"type":"object","properties":{"gross_revenue":{"type":"number","description":"Amount in the order currency."},"shipping_revenue":{"type":"number","description":"Amount in the order currency."},"discount":{"type":"number","description":"Amount in the order currency."},"tax":{"type":"number","description":"Amount in the order currency."},"tax_included_in_price":{"type":"boolean"},"refunds":{"type":"number","description":"Amount in the order currency."},"net_revenue":{"type":"number","description":"gross_revenue minus refunds."},"cogs":{"type":"number","description":"Amount in the order currency."},"cogs_source":{"type":"string","description":"`cogs_map` (resolved from the merchant's cost table) or `3pl_actual` (billed by the fulfilment provider)."},"cogs_coverage_pct":{"type":["number","null"],"description":"Percentage of units on this order that have cost data. Below 100 means `cogs` understates true cost and margin is overstated. Null when the order has no line items."},"fulfillment_cost":{"type":["number","null"]},"fulfillment_cost_source":{"type":["string","null"]},"payment_fee":{"type":["number","null"],"description":"Payment processing fee for this order. See payment_fee_source - it may be an estimate from the merchant's payment fee rules rather than a fee the processor reported. Null when no fee is known."},"payment_fee_source":{"type":["string","null"],"enum":["platform","rule","manual",null],"description":"Where payment_fee came from. `platform`: reported by the commerce platform or payment processor. `rule`: estimated from the merchant's payment fee rule for this gateway (percentage plus fixed amount), because the platform reported no fee - label it as an estimate when displayed. `manual`: entered by the merchant on a manual order. Null when payment_fee is null."},"ad_spend_allocated":{"type":"number","description":"This order's share of the day's ad spend. See ad_spend_basis - it is an allocation, not measured spend."},"ad_spend_basis":{"type":"string","const":"blended_daily_allocation","description":"How ad_spend_allocated was derived. A day's total spend is divided across that day's eligible orders; no ad platform reports spend per order. Do not present this as measured per-order or per-funnel ad spend."},"contribution_profit":{"type":"number","description":"net_revenue - cogs - ad_spend_allocated - payment_fee - fulfillment_cost."},"contribution_margin_pct":{"type":"number"},"allocated_overhead":{"type":"number","description":"This order's share of operating expenses not already deducted above."},"net_profit":{"type":"number","description":"contribution_profit - allocated_overhead."},"net_margin_pct":{"type":"number"}}},"OrderAttribution":{"type":"object","properties":{"primary_source":{"type":["string","null"]},"is_paid":{"type":"boolean"},"utm_source":{"type":["string","null"]},"utm_medium":{"type":["string","null"]},"utm_campaign":{"type":["string","null"]},"utm_term":{"type":["string","null"]},"utm_content":{"type":["string","null"]},"landing_page":{"type":["string","null"],"description":"Landing URL with query parameters, fragments, and URL credentials removed."},"referrer":{"type":["string","null"],"description":"Referring hostname only. Paths, query parameters, fragments, and URL credentials are removed."},"device_type":{"type":["string","null"]}}},"OrderLineItem":{"type":"object","properties":{"id":{"type":"string"},"sku":{"type":["string","null"]},"name":{"type":"string"},"product_id":{"type":["string","null"]},"variant_id":{"type":["string","null"]},"quantity":{"type":"integer"},"price":{"type":"number","description":"Unit price before discount."},"total":{"type":"number","description":"Post-discount line revenue. Legitimately 0 for a fully discounted line such as a warranty replacement."},"cogs":{"type":"number","description":"Amount in the order currency."},"fulfillment_cost":{"type":"number","description":"Amount in the order currency."},"refund_amount":{"type":"number","description":"Amount in the order currency."},"refunded_quantity":{"type":"integer"}}},"Order":{"type":"object","properties":{"id":{"type":"string","description":"MerchantFlow order id."},"external_order_id":{"type":"string","description":"The commerce platform's own order id. For Shopify this is the NUMERIC legacy id, e.g. \"5123456789012\"."},"external_order_gid":{"type":["string","null"],"description":"Shopify GraphQL global id, derived from external_order_id. Null for non-Shopify stores."},"order_number":{"type":"string"},"platform":{"type":"string"},"store_id":{"type":"string"},"created_at":{"type":"string","format":"date-time","description":"When the order was placed."},"updated_at":{"type":"string","format":"date-time","description":"The value updated_after compares against. Advances on financial changes, not only edits."},"canceled_at":{"type":["string","null"],"format":"date-time"},"refunded_at":{"type":["string","null"],"format":"date-time"},"currency":{"type":"string"},"financial_status":{"type":"string"},"fulfillment_status":{"type":["string","null"]},"sales_channel":{"type":"string","enum":["d2c","b2b"]},"is_first_order":{"type":"boolean","description":"True when this is the customer's first order with this store."},"customer_order_sequence":{"type":["integer","null"],"description":"1 for a first purchase, 2 for the second, and so on. Distinguishes new from repeat buyers with no identifier at all."},"is_subscription_renewal":{"type":"boolean"},"economics":{"$ref":"#/components/schemas/OrderEconomics"},"attribution":{"$ref":"#/components/schemas/OrderAttribution"},"shipping_country_code":{"type":["string","null"],"description":"ISO 3166-1 alpha-2. The only location data returned."},"customer_ref":{"type":["string","null"],"description":"Pseudonymous customer identifier. Stable for your application and this merchant, so you can group a customer's orders. Deliberately NOT stable across applications, and not reversible to an email address. Null for orders with no customer email.  This is pseudonymous personal data under GDPR, not anonymous data. Handle it accordingly and do not attempt re-identification."},"line_items":{"type":"array","items":{"$ref":"#/components/schemas/OrderLineItem"}}}},"ProductCost":{"type":["object","null"],"description":"Current base cost for this SKU, or null when no cost is recorded. Null and zero mean different things - null is unknown cost.","properties":{"unit_cost":{"type":"number"},"handling_cost":{"type":"number"},"currency":{"type":"string"},"effective_from":{"type":"string","format":"date-time"},"source":{"type":"string"},"cost_is_tiered":{"type":"boolean","description":"True when this SKU also has quantity-tier costs, so unit_cost is only the base tier. The authoritative cost for a given sale is the order line's cogs."},"cost_is_market_specific":{"type":"boolean","description":"True when this SKU also has per-market costs, so unit_cost is only the default market."}}},"ProductVariant":{"type":"object","properties":{"id":{"type":"string"},"external_variant_id":{"type":"string"},"title":{"type":["string","null"]},"sku":{"type":["string","null"]},"price":{"type":["number","null"]},"compare_at_price":{"type":["number","null"]},"position":{"type":"integer"},"barcode":{"type":["string","null"]},"status":{"type":["string","null"]},"updated_at":{"type":"string","format":"date-time"},"cogs":{"$ref":"#/components/schemas/ProductCost"}}},"Product":{"type":"object","properties":{"id":{"type":"string"},"external_product_id":{"type":"string"},"name":{"type":"string"},"url":{"type":"string"},"image_url":{"type":["string","null"]},"sku":{"type":["string","null"]},"price":{"type":["number","null"]},"compare_at_price":{"type":["number","null"]},"status":{"type":["string","null"]},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"},"cogs":{"$ref":"#/components/schemas/ProductCost"},"variants":{"type":"array","items":{"$ref":"#/components/schemas/ProductVariant"}}}},"ProfitabilityDay":{"type":"object","properties":{"date":{"type":"string","description":"YYYY-MM-DD in the store timezone."},"currency":{"type":"string"},"gross_revenue":{"type":"number","description":"Amount in the order currency."},"refunds":{"type":"number","description":"Amount in the order currency."},"net_revenue":{"type":"number","description":"Amount in the order currency."},"shipping_revenue":{"type":"number","description":"Amount in the order currency."},"discounts":{"type":"number","description":"Amount in the order currency."},"cogs":{"type":"number","description":"Amount in the order currency."},"product_cost_only":{"type":"number","description":"COGS excluding handling cost."},"ad_spend":{"type":"number","description":"Amount in the order currency."},"payment_fees":{"type":"number","description":"Includes fees estimated from the merchant's payment fee rules for orders whose platform reported no fee. The per-order split is available as payment_fee_source on /orders."},"shipping_cost":{"type":"number","description":"Amount in the order currency."},"fulfillment_cost":{"type":"number","description":"Amount in the order currency."},"tax":{"type":"number","description":"Amount in the order currency."},"variable_costs":{"type":"number","description":"Amount in the order currency."},"opex":{"type":"number","description":"Amount in the order currency."},"amortised_expenses":{"type":"number","description":"Amount in the order currency."},"interest_expense":{"type":"number","description":"Amount in the order currency."},"product_margin_cm1":{"type":"number","description":"net_revenue - product_cost_only."},"gross_profit_cm2":{"type":"number","description":"net_revenue - cogs."},"contribution_margin_cm3":{"type":"number","description":"gross_profit_cm2 - shipping - fulfilment - payment fees - ad spend."},"ebitda":{"type":"number","description":"Amount in the order currency."},"net_profit":{"type":"number","description":"Amount in the order currency."},"cogs_coverage_pct":{"type":["number","null"]}}},"ProfitabilitySummary":{"type":"object","properties":{"period":{"type":"object","properties":{"start":{"type":["string","null"]},"end":{"type":["string","null"]},"days":{"type":"integer"}}},"currency":{"type":"string"},"cogs_coverage_pct":{"type":["number","null"]},"basis":{"type":"object","description":"How these figures were computed. Compare only against figures on the same basis.","properties":{"refund_recognition":{"type":"string","const":"sale_date","description":"A refunded order's costs are recognised on the date the order was placed, matching its revenue."},"tax_treated_as_cost":{"type":"boolean","description":"Follows the merchant's own setting, so these figures match their dashboard."},"ad_spend":{"type":"string","const":"blended_daily_allocation"}}},"totals":{"type":"object","additionalProperties":{"type":"number"}}}},"Account":{"type":"object","properties":{"store":{"type":"object","properties":{"id":{"type":"string"},"name":{"type":["string","null"]},"platform":{"type":["string","null"]},"shop_domain":{"type":["string","null"]},"currency":{"type":"string"},"timezone":{"type":"string"},"connected_at":{"type":["string","null"],"format":"date-time"}}},"connection":{"type":"object","properties":{"client_id":{"type":"string"},"scopes":{"type":"array","items":{"type":"string"}},"granted_at":{"type":["string","null"],"format":"date-time"}}},"data_availability":{"type":"object","properties":{"history_days":{"type":["integer","null"],"description":"Null means unlimited history on this store's plan."},"available_from":{"type":["string","null"]},"last_sync_at":{"type":["string","null"],"format":"date-time"},"stale":{"type":"boolean"}}},"rate_limits":{"type":"object","properties":{"burst_per_minute":{"type":"integer"},"per_hour":{"type":"integer"},"per_day":{"type":"integer"},"max_concurrent":{"type":"integer"}}}}},"Store":{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"},"platform":{"type":"string"},"currency":{"type":"string"},"timezone":{"type":"string"},"last_sync_at":{"type":["string","null"],"format":"date-time"}}}},"responses":{"Unauthorized":{"description":"Missing, expired, or revoked token. The `WWW-Authenticate` header names the protected-resource metadata document so you can rediscover the authorization server.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"Forbidden":{"description":"The token lacks the scope this endpoint requires.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"NotFound":{"description":"No such record for this store. Returned rather than 403 for a record belonging to another store, so ids cannot be probed.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"RateLimited":{"description":"Budget exhausted. `Retry-After` gives the seconds to wait and `X-RateLimit-Reason` says which limit was hit: `burst`, `hour`, `day`, `concurrency`, or `client_global`.  `concurrency` means too many requests are in flight for one store at once - page cursors sequentially rather than in parallel. `client_global` means your application exceeded its budget across ALL connected stores; stagger scheduled syncs instead of starting every store at the same moment.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}},"paths":{"/account":{"get":{"operationId":"getAccount","summary":"The connected store","description":"Which store this token reads, how fresh its data is, and what the plan includes. Use it as a health check.","tags":["Store"],"security":[{"oauth2":["store:read"]}],"responses":{"200":{"description":"The connected store.","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"data":{"$ref":"#/components/schemas/Account"},"meta":{"$ref":"#/components/schemas/Meta"}}}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"429":{"$ref":"#/components/responses/RateLimited"}}}},"/stores":{"get":{"operationId":"listStores","summary":"Stores this authorization covers","description":"Always exactly one entry today - a merchant authorises one store per application. Returned as an array so multi-store authorization can be added without a breaking change.","tags":["Store"],"security":[{"oauth2":["store:read"]}],"responses":{"200":{"description":"Authorised stores.","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"data":{"type":"array","items":{"$ref":"#/components/schemas/Store"}},"meta":{"$ref":"#/components/schemas/Meta"}}}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"429":{"$ref":"#/components/responses/RateLimited"}}}},"/metrics/mer":{"get":{"operationId":"getMer","summary":"Marketing Efficiency Ratio for a window","description":"MER for a date range, and nothing else. Use this instead of\n`/profitability/summary` when your integration needs the ratio rather than the\nfull P&L - it is the narrowest scope that answers the question, and merchants\napprove it far more readily.\n\n`mer` is D2C gross revenue divided by deduplicated blended ad spend, the same\ndefinition as the merchant's own dashboard. Wholesale (B2B) revenue is excluded\nfrom the numerator: it was not bought with ad spend.\n\n`mer` is `null` when no ad spend is recorded for the window - that is \"no\ncampaigns ran\", not \"campaigns returned nothing\".\n\n`revenue` and `ad_spend` require `metrics:revenue:read` and\n`metrics:ad_spend:read` respectively, independently of `metrics:mer:read`. A\nfield you do not hold the scope for is ABSENT from the payload and named in\n`meta.omitted_fields` - never returned as null.","tags":["Metrics"],"security":[{"oauth2":["metrics:mer:read"]}],"parameters":[{"$ref":"#/components/parameters/metricFrom"},{"$ref":"#/components/parameters/metricTo"}],"responses":{"200":{"description":"MER for the window.","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"data":{"$ref":"#/components/schemas/MerMetric"},"meta":{"$ref":"#/components/schemas/Meta"}}}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"description":"No advertising spend is recorded for the window, and the token carries neither `metrics:revenue:read` nor `metrics:ad_spend:read`, so there is nothing to return."},"429":{"$ref":"#/components/responses/RateLimited"}}}},"/metrics/revenue":{"get":{"operationId":"getRevenueMetric","summary":"D2C gross revenue for a window","description":"Direct-to-consumer gross revenue for a date range, as a single total.\nWholesale (B2B) revenue is excluded, matching the MER numerator.\n\nThe standalone form of the `revenue` field on `/metrics/mer`, for integrations\nthat hold `metrics:revenue:read` without `metrics:mer:read`. Both return the\nsame figure for the same window.","tags":["Metrics"],"security":[{"oauth2":["metrics:revenue:read"]}],"parameters":[{"$ref":"#/components/parameters/metricFrom"},{"$ref":"#/components/parameters/metricTo"}],"responses":{"200":{"description":"Revenue for the window.","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"data":{"$ref":"#/components/schemas/RevenueMetric"},"meta":{"$ref":"#/components/schemas/Meta"}}}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"429":{"$ref":"#/components/responses/RateLimited"}}}},"/metrics/ad-spend":{"get":{"operationId":"getAdSpendMetric","summary":"Advertising spend for a window","description":"Deduplicated blended advertising spend for a date range, as a single total.\nThe same campaign arriving from two connected ad accounts is counted once.\n\nThe standalone form of the `ad_spend` field on `/metrics/mer`, for integrations\nthat hold `metrics:ad_spend:read` without `metrics:mer:read`. Both return the\nsame figure for the same window.","tags":["Metrics"],"security":[{"oauth2":["metrics:ad_spend:read"]}],"parameters":[{"$ref":"#/components/parameters/metricFrom"},{"$ref":"#/components/parameters/metricTo"}],"responses":{"200":{"description":"Advertising spend for the window.","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"data":{"$ref":"#/components/schemas/AdSpendMetric"},"meta":{"$ref":"#/components/schemas/Meta"}}}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"429":{"$ref":"#/components/responses/RateLimited"}}}},"/metrics/contribution-profit":{"get":{"operationId":"getContributionProfit","summary":"Contribution profit for a window","description":"Contribution profit (CM3) for a date range - revenue less COGS, shipping,\nfulfilment, payment fees and ad spend - as a single figure.\n\nThe cost lines behind it are NOT returned. Request `profitability:read` if you\nneed the waterfall; this endpoint exists so that you do not have to.","tags":["Metrics"],"security":[{"oauth2":["metrics:contribution_profit:read"]}],"parameters":[{"$ref":"#/components/parameters/metricFrom"},{"$ref":"#/components/parameters/metricTo"}],"responses":{"200":{"description":"Contribution profit for the window.","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"data":{"$ref":"#/components/schemas/ContributionProfitMetric"},"meta":{"$ref":"#/components/schemas/Meta"}}}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"429":{"$ref":"#/components/responses/RateLimited"}}}},"/orders":{"get":{"operationId":"listOrders","summary":"List orders with their economics","description":"The main endpoint. Pass `updated_after` to receive only what has changed since\nyour last sync, including orders whose COGS, fulfilment cost or attribution were\ncorrected after they were placed.\n\nResults are ordered oldest-change-first, so the `updated_at` of the last record\nyou successfully processed is always a safe watermark to resume from.","tags":["Orders"],"security":[{"oauth2":["orders:read"]}],"parameters":[{"$ref":"#/components/parameters/updatedAfter"},{"name":"created_after","in":"query","description":"Only orders placed on or after this date (YYYY-MM-DD), resolved as start-of-day in the store timezone.","schema":{"type":"string","format":"date"}},{"name":"created_before","in":"query","description":"Only orders placed on or before this date (YYYY-MM-DD), resolved as end-of-day in the store timezone.","schema":{"type":"string","format":"date"}},{"name":"status","in":"query","description":"Defaults to revenue-bearing orders only (paid, completed, processing, partially refunded, refunded; cancelled excluded) - the same definition the merchant's own dashboard totals use. Pass `all` to include cancelled orders for reconciliation.","schema":{"type":"string","enum":["default","all"]}},{"name":"sales_channel","in":"query","description":"`d2c` for storefront orders, `b2b` for wholesale.","schema":{"type":"string","enum":["d2c","b2b"]}},{"$ref":"#/components/parameters/limit"},{"$ref":"#/components/parameters/cursor"}],"responses":{"200":{"description":"A page of orders.","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"data":{"type":"array","items":{"$ref":"#/components/schemas/Order"}},"meta":{"$ref":"#/components/schemas/Meta"},"page":{"$ref":"#/components/schemas/Page"}}}}}},"400":{"description":"Invalid parameter, or a cursor reused with different filters (`CURSOR_FILTER_MISMATCH`).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"429":{"$ref":"#/components/responses/RateLimited"}}}},"/orders/{id}":{"get":{"operationId":"getOrder","summary":"Fetch one order","tags":["Orders"],"security":[{"oauth2":["orders:read"]}],"parameters":[{"name":"id","in":"path","required":true,"description":"A MerchantFlow order id, or `external:<platform order id>` to look up by the commerce platform's id - e.g. `external:5123456789012`.","schema":{"type":"string"}}],"responses":{"200":{"description":"The order.","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"data":{"$ref":"#/components/schemas/Order"},"meta":{"$ref":"#/components/schemas/Meta"}}}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"}}}},"/products":{"get":{"operationId":"listProducts","summary":"List products with current costs","tags":["Products"],"security":[{"oauth2":["products:read"]}],"parameters":[{"$ref":"#/components/parameters/updatedAfter"},{"name":"status","in":"query","description":"Filter by product status, e.g. `active` or `inactive`.","schema":{"type":"string"}},{"$ref":"#/components/parameters/limit"},{"$ref":"#/components/parameters/cursor"}],"responses":{"200":{"description":"A page of products.","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"data":{"type":"array","items":{"$ref":"#/components/schemas/Product"}},"meta":{"$ref":"#/components/schemas/Meta"},"page":{"$ref":"#/components/schemas/Page"}}}}}},"400":{"description":"Invalid parameter or cursor.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"429":{"$ref":"#/components/responses/RateLimited"}}}},"/products/{id}":{"get":{"operationId":"getProduct","summary":"Fetch one product","tags":["Products"],"security":[{"oauth2":["products:read"]}],"parameters":[{"name":"id","in":"path","required":true,"description":"A MerchantFlow product id, or `external:<platform product id>`.","schema":{"type":"string"}}],"responses":{"200":{"description":"The product.","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"data":{"$ref":"#/components/schemas/Product"},"meta":{"$ref":"#/components/schemas/Meta"}}}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"}}}},"/profitability/summary":{"get":{"operationId":"getProfitabilitySummary","summary":"Aggregate profit and loss for a period","description":"The full waterfall from gross revenue to net profit. Read `basis` before comparing these figures with anything computed elsewhere.","tags":["Profitability"],"security":[{"oauth2":["profitability:read"]}],"parameters":[{"name":"start_date","in":"query","description":"YYYY-MM-DD, resolved in the store timezone.","schema":{"type":"string","format":"date"}},{"name":"end_date","in":"query","description":"YYYY-MM-DD, resolved in the store timezone.","schema":{"type":"string","format":"date"}}],"responses":{"200":{"description":"The summary.","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"data":{"$ref":"#/components/schemas/ProfitabilitySummary"},"meta":{"$ref":"#/components/schemas/Meta"}}}}}},"400":{"description":"Invalid date parameter.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"429":{"$ref":"#/components/responses/RateLimited"}}}},"/profitability/daily":{"get":{"operationId":"listDailyProfitability","summary":"Daily profit and loss series","tags":["Profitability"],"security":[{"oauth2":["profitability:read"]}],"parameters":[{"name":"start_date","in":"query","schema":{"type":"string","format":"date"}},{"name":"end_date","in":"query","schema":{"type":"string","format":"date"}},{"name":"limit","in":"query","description":"Page size. Days are small, so this endpoint allows up to 400.","schema":{"type":"integer","minimum":1,"maximum":400,"default":100}},{"$ref":"#/components/parameters/cursor"}],"responses":{"200":{"description":"A page of days, oldest first.","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"data":{"type":"array","items":{"$ref":"#/components/schemas/ProfitabilityDay"}},"meta":{"$ref":"#/components/schemas/Meta"},"page":{"$ref":"#/components/schemas/Page"}}}}}},"400":{"description":"Invalid date parameter or cursor.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"429":{"$ref":"#/components/responses/RateLimited"}}}}},"x-rate-limits":{"description":"Per store per application, except client_global which is per application across every store it is connected to.","burst_per_minute":60,"per_hour":1000,"per_day":10000,"max_concurrent":2,"client_global_per_minute":200}}