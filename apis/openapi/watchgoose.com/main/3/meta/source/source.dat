{"openapi": "3.1.0", "info": {"title": "Watchgoose APIs", "version": "3", "description": "The current Management API v3 for checks and integrations, plus the capability-URL Pinging API used by monitored jobs. Authenticated Management operations use X-Api-Key. Management POST requests may alternatively carry api_key in the JSON body; OpenAPI security requirements cannot represent body credentials, so ApiKeyAuth models the preferred header form."}, "externalDocs": {"description": "Watchgoose Management API documentation", "url": "https://watchgoose.com/docs/api/"}, "servers": [{"url": "https://watchgoose.com", "description": "Configured Management API server"}], "security": [{"ApiKeyAuth": []}], "tags": [{"name": "Management API v3", "description": "Manage checks and inspect their recent activity.", "externalDocs": {"url": "https://watchgoose.com/docs/api/"}}, {"name": "Pinging API", "description": "Submit success, failure, start, log, or exit-status signals.", "externalDocs": {"url": "https://watchgoose.com/docs/http_api/"}}], "paths": {"/api/v3/checks/": {"get": {"tags": ["Management API v3"], "summary": "List checks", "description": "Authentication: provide a project API key in the preferred X-Api-Key header. Read-only and read-write keys are accepted for this operation.", "operationId": "listChecks", "x-api-key-permissions": ["read-only", "read-write"], "x-api-key-locations": ["header"], "responses": {"200": {"description": "Successful response.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CheckList"}}}}, "401": {"description": "Missing or invalid API key.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}}, "parameters": [{"$ref": "#/components/parameters/Tag"}, {"$ref": "#/components/parameters/SlugQuery"}]}, "post": {"tags": ["Management API v3"], "summary": "Create or find a check", "description": "Authentication: provide a read-write project API key in the preferred X-Api-Key header. Read-only keys are not accepted for this operation. As an alternative on this POST request, api_key may be supplied in the JSON body.", "operationId": "createCheck", "x-api-key-permissions": ["read-write"], "x-api-key-locations": ["header", "body"], "responses": {"200": {"description": "Successful response.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Check"}}}}, "401": {"description": "Missing or invalid API key.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}, "201": {"description": "Check created.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Check"}}}}, "400": {"description": "Invalid request.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}, "403": {"description": "The project has reached its check limit.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}}, "requestBody": {"description": "Optional check fields and/or JSON-body API key alternative. Omitted check fields retain their defaults or current values.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CheckWrite"}}}}}}, "/api/v3/checks/{identifier}": {"parameters": [{"$ref": "#/components/parameters/CheckIdentifier"}], "get": {"tags": ["Management API v3"], "summary": "Get a check by UUID or unique key", "description": "Authentication: provide a project API key in the preferred X-Api-Key header. Read-only and read-write keys are accepted for this operation.", "operationId": "getCheckByIdentifier", "x-api-key-permissions": ["read-only", "read-write"], "x-api-key-locations": ["header"], "responses": {"200": {"description": "Successful response.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Check"}}}}, "401": {"description": "Missing or invalid API key.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}, "403": {"description": "The API key cannot access this resource."}, "404": {"description": "Resource not found."}}}, "post": {"tags": ["Management API v3"], "summary": "Update a check by UUID", "description": "Authentication: provide a read-write project API key in the preferred X-Api-Key header. Read-only keys are not accepted for this operation. As an alternative on this POST request, api_key may be supplied in the JSON body.", "operationId": "updateCheck", "x-api-key-permissions": ["read-write"], "x-api-key-locations": ["header", "body"], "responses": {"200": {"description": "Successful response.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Check"}}}}, "401": {"description": "Missing or invalid API key.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}, "400": {"description": "Invalid request.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}, "403": {"description": "The API key cannot access this resource."}, "404": {"description": "Resource not found."}}, "parameters": [{"$ref": "#/components/parameters/UuidIdentifier"}], "requestBody": {"description": "Optional check fields and/or JSON-body API key alternative. Omitted check fields retain their defaults or current values.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CheckWrite"}}}}}, "delete": {"tags": ["Management API v3"], "summary": "Delete a check by UUID", "description": "Authentication: provide a read-write project API key in the preferred X-Api-Key header. Read-only keys are not accepted for this operation.", "operationId": "deleteCheck", "x-api-key-permissions": ["read-write"], "x-api-key-locations": ["header"], "responses": {"200": {"description": "Successful response.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Check"}}}}, "401": {"description": "Missing or invalid API key.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}, "403": {"description": "The API key cannot access this resource."}, "404": {"description": "Resource not found."}}, "parameters": [{"$ref": "#/components/parameters/UuidIdentifier"}]}}, "/api/v3/checks/{uuid}/pause": {"parameters": [{"$ref": "#/components/parameters/CheckUuid"}], "post": {"tags": ["Management API v3"], "summary": "Pause a check", "description": "Authentication: provide a read-write project API key in the preferred X-Api-Key header. Read-only keys are not accepted for this operation. As an alternative on this POST request, api_key may be supplied in the JSON body.", "operationId": "pauseCheck", "x-api-key-permissions": ["read-write"], "x-api-key-locations": ["header", "body"], "responses": {"200": {"description": "Successful response.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Check"}}}}, "401": {"description": "Missing or invalid API key.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}, "403": {"description": "The API key cannot access this resource."}, "404": {"description": "Resource not found."}}, "requestBody": {"description": "Optional JSON-body API key alternative.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ApiKeyBody"}}}}}}, "/api/v3/checks/{uuid}/resume": {"parameters": [{"$ref": "#/components/parameters/CheckUuid"}], "post": {"tags": ["Management API v3"], "summary": "Resume a check", "description": "Authentication: provide a read-write project API key in the preferred X-Api-Key header. Read-only keys are not accepted for this operation. As an alternative on this POST request, api_key may be supplied in the JSON body.", "operationId": "resumeCheck", "x-api-key-permissions": ["read-write"], "x-api-key-locations": ["header", "body"], "responses": {"200": {"description": "Successful response.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Check"}}}}, "401": {"description": "Missing or invalid API key.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}, "403": {"description": "The API key cannot access this resource."}, "404": {"description": "Resource not found."}, "409": {"description": "The check is not paused.", "content": {"text/plain": {"schema": {"type": "string"}}}}}, "requestBody": {"description": "Optional JSON-body API key alternative.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ApiKeyBody"}}}}}}, "/api/v3/checks/{uuid}/pings/": {"parameters": [{"$ref": "#/components/parameters/CheckUuid"}], "get": {"tags": ["Management API v3"], "summary": "List a check's recent pings", "description": "Authentication: provide a read-write project API key in the preferred X-Api-Key header. Read-only keys are not accepted for this operation.", "operationId": "listPings", "x-api-key-permissions": ["read-write"], "x-api-key-locations": ["header"], "responses": {"200": {"description": "Successful response.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PingList"}}}}, "401": {"description": "Missing or invalid API key.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}, "403": {"description": "The API key cannot access this resource."}, "404": {"description": "Resource not found."}}}}, "/api/v3/checks/{uuid}/pings/{n}/body": {"parameters": [{"$ref": "#/components/parameters/CheckUuid"}, {"$ref": "#/components/parameters/PingNumber"}], "get": {"tags": ["Management API v3"], "summary": "Get a stored ping body", "description": "Authentication: provide a read-write project API key in the preferred X-Api-Key header. Read-only keys are not accepted for this operation.", "operationId": "getPingBody", "x-api-key-permissions": ["read-write"], "x-api-key-locations": ["header"], "responses": {"200": {"description": "Successful response.", "content": {"text/plain": {"schema": {"type": "string"}}}}, "401": {"description": "Missing or invalid API key.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}, "403": {"description": "The API key cannot access this resource."}, "404": {"description": "Resource not found."}, "503": {"description": "Body storage is unavailable."}}}}, "/api/v3/checks/{identifier}/flips/": {"parameters": [{"$ref": "#/components/parameters/CheckIdentifier"}], "get": {"tags": ["Management API v3"], "summary": "List status flips by UUID or unique key", "description": "Authentication: provide a project API key in the preferred X-Api-Key header. Read-only and read-write keys are accepted for this operation.", "operationId": "listFlipsByIdentifier", "x-api-key-permissions": ["read-only", "read-write"], "x-api-key-locations": ["header"], "responses": {"200": {"description": "Successful response.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/FlipList"}}}}, "401": {"description": "Missing or invalid API key.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}, "400": {"description": "Invalid time filter."}, "403": {"description": "The API key cannot access this resource."}, "404": {"description": "Resource not found."}}, "parameters": [{"$ref": "#/components/parameters/Start"}, {"$ref": "#/components/parameters/End"}, {"$ref": "#/components/parameters/Seconds"}]}}, "/api/v3/channels/": {"get": {"tags": ["Management API v3"], "summary": "List notification channels", "description": "Authentication: provide a read-write project API key in the preferred X-Api-Key header. Read-only keys are not accepted for this operation.", "operationId": "listChannels", "x-api-key-permissions": ["read-write"], "x-api-key-locations": ["header"], "responses": {"200": {"description": "Successful response.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ChannelList"}}}}, "401": {"description": "Missing or invalid API key.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}}}}, "/api/v3/badges/": {"get": {"tags": ["Management API v3"], "summary": "List badge URLs", "description": "Authentication: provide a project API key in the preferred X-Api-Key header. Read-only and read-write keys are accepted for this operation.", "operationId": "listBadges", "x-api-key-permissions": ["read-only", "read-write"], "x-api-key-locations": ["header"], "responses": {"200": {"description": "Successful response.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/BadgesResponse"}}}}, "401": {"description": "Missing or invalid API key.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}}}}, "/api/v3/status/": {"get": {"tags": ["Management API v3"], "summary": "Check service and database status", "operationId": "getStatus", "security": [], "responses": {"200": {"description": "Service is healthy.", "content": {"text/plain": {"schema": {"type": "string", "example": "OK"}}}}}}}, "/ping/{uuid}": {"parameters": [{"$ref": "#/components/parameters/PingUuid"}], "head": {"tags": ["Pinging API"], "summary": "Submit a ping using HEAD", "description": "The URL identifiers are capability secrets. Anyone who knows this URL can submit a ping, so do not publish or log it unnecessarily.", "operationId": "pingUuidHead", "servers": [{"url": "https://watchgoose.com", "description": "Configured Pinging API host"}], "security": [], "parameters": [{"$ref": "#/components/parameters/Rid"}], "responses": {"200": {"description": "Ping accepted."}, "400": {"description": "Invalid action or run identifier.", "content": {"text/plain": {"schema": {"type": "string"}}}}, "404": {"description": "Check not found.", "content": {"text/plain": {"schema": {"type": "string"}}}}}}, "get": {"tags": ["Pinging API"], "summary": "Submit a ping using GET", "description": "The URL identifiers are capability secrets. Anyone who knows this URL can submit a ping, so do not publish or log it unnecessarily.", "operationId": "pingUuidGet", "servers": [{"url": "https://watchgoose.com", "description": "Configured Pinging API host"}], "security": [], "parameters": [{"$ref": "#/components/parameters/Rid"}], "responses": {"200": {"description": "Ping accepted.", "content": {"text/plain": {"schema": {"type": "string", "example": "OK"}}}}, "400": {"description": "Invalid action or run identifier.", "content": {"text/plain": {"schema": {"type": "string"}}}}, "404": {"description": "Check not found.", "content": {"text/plain": {"schema": {"type": "string"}}}}}}, "post": {"tags": ["Pinging API"], "summary": "Submit a ping using POST", "description": "The URL identifiers are capability secrets. Anyone who knows this URL can submit a ping, so do not publish or log it unnecessarily.", "operationId": "pingUuidPost", "servers": [{"url": "https://watchgoose.com", "description": "Configured Pinging API host"}], "security": [], "parameters": [{"$ref": "#/components/parameters/Rid"}], "responses": {"200": {"description": "Ping accepted.", "content": {"text/plain": {"schema": {"type": "string", "example": "OK"}}}}, "400": {"description": "Invalid action or run identifier.", "content": {"text/plain": {"schema": {"type": "string"}}}}, "404": {"description": "Check not found.", "content": {"text/plain": {"schema": {"type": "string"}}}}}, "requestBody": {"description": "Optional arbitrary ping body, retained up to the configured limit.", "content": {"text/plain": {"schema": {"type": "string", "format": "binary"}}, "application/octet-stream": {"schema": {"type": "string", "format": "binary"}}}}}}, "/ping/{identifier}/{action_or_slug}": {"parameters": [{"$ref": "#/components/parameters/PingIdentifier"}, {"$ref": "#/components/parameters/ActionOrSlug"}], "head": {"tags": ["Pinging API"], "summary": "Submit a ping using HEAD", "description": "The URL identifiers are capability secrets. Anyone who knows this URL can submit a ping, so do not publish or log it unnecessarily. The create=1 option and 201 response apply only to the ping-key/slug form.", "operationId": "pingUuidActionOrSlugHead", "servers": [{"url": "https://watchgoose.com", "description": "Configured Pinging API host"}], "security": [], "parameters": [{"$ref": "#/components/parameters/Rid"}, {"$ref": "#/components/parameters/Create"}], "responses": {"200": {"description": "Ping accepted."}, "400": {"description": "Invalid action or run identifier.", "content": {"text/plain": {"schema": {"type": "string"}}}}, "404": {"description": "Check not found.", "content": {"text/plain": {"schema": {"type": "string"}}}}, "201": {"description": "Check created and ping accepted.", "content": {"text/plain": {"schema": {"type": "string", "example": "Created"}}}}, "403": {"description": "The project has reached its check limit.", "content": {"text/plain": {"schema": {"type": "string"}}}}, "409": {"description": "The slug is ambiguous.", "content": {"text/plain": {"schema": {"type": "string"}}}}}}, "get": {"tags": ["Pinging API"], "summary": "Submit a ping using GET", "description": "The URL identifiers are capability secrets. Anyone who knows this URL can submit a ping, so do not publish or log it unnecessarily. The create=1 option and 201 response apply only to the ping-key/slug form.", "operationId": "pingUuidActionOrSlugGet", "servers": [{"url": "https://watchgoose.com", "description": "Configured Pinging API host"}], "security": [], "parameters": [{"$ref": "#/components/parameters/Rid"}, {"$ref": "#/components/parameters/Create"}], "responses": {"200": {"description": "Ping accepted.", "content": {"text/plain": {"schema": {"type": "string", "example": "OK"}}}}, "400": {"description": "Invalid action or run identifier.", "content": {"text/plain": {"schema": {"type": "string"}}}}, "404": {"description": "Check not found.", "content": {"text/plain": {"schema": {"type": "string"}}}}, "201": {"description": "Check created and ping accepted.", "content": {"text/plain": {"schema": {"type": "string", "example": "Created"}}}}, "403": {"description": "The project has reached its check limit.", "content": {"text/plain": {"schema": {"type": "string"}}}}, "409": {"description": "The slug is ambiguous.", "content": {"text/plain": {"schema": {"type": "string"}}}}}}, "post": {"tags": ["Pinging API"], "summary": "Submit a ping using POST", "description": "The URL identifiers are capability secrets. Anyone who knows this URL can submit a ping, so do not publish or log it unnecessarily. The create=1 option and 201 response apply only to the ping-key/slug form.", "operationId": "pingUuidActionOrSlugPost", "servers": [{"url": "https://watchgoose.com", "description": "Configured Pinging API host"}], "security": [], "parameters": [{"$ref": "#/components/parameters/Rid"}, {"$ref": "#/components/parameters/Create"}], "responses": {"200": {"description": "Ping accepted.", "content": {"text/plain": {"schema": {"type": "string", "example": "OK"}}}}, "400": {"description": "Invalid action or run identifier.", "content": {"text/plain": {"schema": {"type": "string"}}}}, "404": {"description": "Check not found.", "content": {"text/plain": {"schema": {"type": "string"}}}}, "201": {"description": "Check created and ping accepted.", "content": {"text/plain": {"schema": {"type": "string", "example": "Created"}}}}, "403": {"description": "The project has reached its check limit.", "content": {"text/plain": {"schema": {"type": "string"}}}}, "409": {"description": "The slug is ambiguous.", "content": {"text/plain": {"schema": {"type": "string"}}}}}, "requestBody": {"description": "Optional arbitrary ping body, retained up to the configured limit.", "content": {"text/plain": {"schema": {"type": "string", "format": "binary"}}, "application/octet-stream": {"schema": {"type": "string", "format": "binary"}}}}}}, "/ping/{ping_key}/{slug}/{action}": {"parameters": [{"$ref": "#/components/parameters/PingKey"}, {"$ref": "#/components/parameters/PingSlug"}, {"$ref": "#/components/parameters/Action"}], "head": {"tags": ["Pinging API"], "summary": "Submit a ping using HEAD", "description": "The URL identifiers are capability secrets. Anyone who knows this URL can submit a ping, so do not publish or log it unnecessarily. The create=1 option and 201 response apply only to the ping-key/slug form.", "operationId": "pingSlugActionHead", "servers": [{"url": "https://watchgoose.com", "description": "Configured Pinging API host"}], "security": [], "parameters": [{"$ref": "#/components/parameters/Rid"}, {"$ref": "#/components/parameters/Create"}], "responses": {"200": {"description": "Ping accepted."}, "400": {"description": "Invalid action or run identifier.", "content": {"text/plain": {"schema": {"type": "string"}}}}, "404": {"description": "Check not found.", "content": {"text/plain": {"schema": {"type": "string"}}}}, "201": {"description": "Check created and ping accepted.", "content": {"text/plain": {"schema": {"type": "string", "example": "Created"}}}}, "403": {"description": "The project has reached its check limit.", "content": {"text/plain": {"schema": {"type": "string"}}}}, "409": {"description": "The slug is ambiguous.", "content": {"text/plain": {"schema": {"type": "string"}}}}}}, "get": {"tags": ["Pinging API"], "summary": "Submit a ping using GET", "description": "The URL identifiers are capability secrets. Anyone who knows this URL can submit a ping, so do not publish or log it unnecessarily. The create=1 option and 201 response apply only to the ping-key/slug form.", "operationId": "pingSlugActionGet", "servers": [{"url": "https://watchgoose.com", "description": "Configured Pinging API host"}], "security": [], "parameters": [{"$ref": "#/components/parameters/Rid"}, {"$ref": "#/components/parameters/Create"}], "responses": {"200": {"description": "Ping accepted.", "content": {"text/plain": {"schema": {"type": "string", "example": "OK"}}}}, "400": {"description": "Invalid action or run identifier.", "content": {"text/plain": {"schema": {"type": "string"}}}}, "404": {"description": "Check not found.", "content": {"text/plain": {"schema": {"type": "string"}}}}, "201": {"description": "Check created and ping accepted.", "content": {"text/plain": {"schema": {"type": "string", "example": "Created"}}}}, "403": {"description": "The project has reached its check limit.", "content": {"text/plain": {"schema": {"type": "string"}}}}, "409": {"description": "The slug is ambiguous.", "content": {"text/plain": {"schema": {"type": "string"}}}}}}, "post": {"tags": ["Pinging API"], "summary": "Submit a ping using POST", "description": "The URL identifiers are capability secrets. Anyone who knows this URL can submit a ping, so do not publish or log it unnecessarily. The create=1 option and 201 response apply only to the ping-key/slug form.", "operationId": "pingSlugActionPost", "servers": [{"url": "https://watchgoose.com", "description": "Configured Pinging API host"}], "security": [], "parameters": [{"$ref": "#/components/parameters/Rid"}, {"$ref": "#/components/parameters/Create"}], "responses": {"200": {"description": "Ping accepted.", "content": {"text/plain": {"schema": {"type": "string", "example": "OK"}}}}, "400": {"description": "Invalid action or run identifier.", "content": {"text/plain": {"schema": {"type": "string"}}}}, "404": {"description": "Check not found.", "content": {"text/plain": {"schema": {"type": "string"}}}}, "201": {"description": "Check created and ping accepted.", "content": {"text/plain": {"schema": {"type": "string", "example": "Created"}}}}, "403": {"description": "The project has reached its check limit.", "content": {"text/plain": {"schema": {"type": "string"}}}}, "409": {"description": "The slug is ambiguous.", "content": {"text/plain": {"schema": {"type": "string"}}}}}, "requestBody": {"description": "Optional arbitrary ping body, retained up to the configured limit.", "content": {"text/plain": {"schema": {"type": "string", "format": "binary"}}, "application/octet-stream": {"schema": {"type": "string", "format": "binary"}}}}}}}, "components": {"securitySchemes": {"ApiKeyAuth": {"type": "apiKey", "in": "header", "name": "X-Api-Key", "description": "The preferred project API key location. Each operation's x-api-key-permissions declares whether it accepts read-only keys."}}, "parameters": {"CheckUuid": {"name": "uuid", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}, "CheckIdentifier": {"name": "identifier", "in": "path", "required": true, "description": "A check UUID or 40-character lowercase SHA-1 unique key.", "schema": {"oneOf": [{"type": "string", "format": "uuid"}, {"type": "string", "pattern": "^[0-9a-f]{40}$"}]}}, "UuidIdentifier": {"name": "identifier", "in": "path", "required": true, "description": "The check UUID. POST and DELETE do not accept a read-only key here.", "schema": {"type": "string", "format": "uuid"}}, "PingNumber": {"name": "n", "in": "path", "required": true, "schema": {"type": "integer", "minimum": 1}}, "PingUuid": {"name": "uuid", "in": "path", "required": true, "description": "The check UUID; treat it as a capability secret in ping URLs.", "schema": {"type": "string", "format": "uuid"}}, "PingIdentifier": {"name": "identifier", "in": "path", "required": true, "description": "A check UUID when the next segment is an action, or a project ping key when the next segment is a check slug.", "schema": {"anyOf": [{"type": "string", "format": "uuid"}, {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"}]}}, "ActionOrSlug": {"name": "action_or_slug", "in": "path", "required": true, "description": "For a UUID identifier: start, fail, log, or an integer exit status from 0 through 255. For a project ping key: the lowercase check slug.", "schema": {"anyOf": [{"type": "string", "pattern": "^(?:start|fail|log|[0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])$"}, {"type": "string", "pattern": "^[a-z0-9_-]+$"}]}}, "PingKey": {"name": "ping_key", "in": "path", "required": true, "description": "The project ping key; treat it as a capability secret.", "schema": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"}}, "PingSlug": {"name": "slug", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^[a-z0-9_-]+$"}}, "Action": {"name": "action", "in": "path", "required": true, "description": "start, fail, log, or an integer exit status from 0 through 255.", "schema": {"type": "string", "pattern": "^(?:start|fail|log|[0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])$"}}, "Rid": {"name": "rid", "in": "query", "description": "Optional run UUID used to correlate start and completion pings.", "schema": {"type": "string", "format": "uuid"}}, "Create": {"name": "create", "in": "query", "description": "Set to 1 to create a missing check for this slug.", "schema": {"type": "integer", "enum": [1]}}, "Tag": {"name": "tag", "in": "query", "description": "Require a tag. May be repeated.", "schema": {"type": "array", "items": {"type": "string"}}, "style": "form", "explode": true}, "SlugQuery": {"name": "slug", "in": "query", "schema": {"type": "string"}}, "Start": {"name": "start", "in": "query", "description": "Include flips at or after this Unix timestamp.", "schema": {"type": "integer", "minimum": 0}}, "End": {"name": "end", "in": "query", "description": "Include flips before this Unix timestamp.", "schema": {"type": "integer", "minimum": 0}}, "Seconds": {"name": "seconds", "in": "query", "description": "Limit flips to this many recent seconds.", "schema": {"type": "integer", "minimum": 0, "maximum": 31536000}}}, "schemas": {"CheckWrite": {"type": "object", "description": "Writable check fields. Schedule or timeout selects the check type; neither is universally required.", "properties": {"api_key": {"type": "string", "minLength": 32, "maxLength": 32, "writeOnly": true, "description": "Management POST requests may include the project API key here instead of using the preferred X-Api-Key header."}, "name": {"type": "string", "maxLength": 100}, "slug": {"type": "string", "maxLength": 100, "pattern": "^[a-z0-9_-]*$"}, "tags": {"type": "string"}, "desc": {"type": "string"}, "timeout": {"ty