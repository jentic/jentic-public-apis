{
  "openapi": "3.0.3",
  "info": {
    "title": "xAI Grok API",
    "description": "API for xAI's Grok large language models. OpenAI-compatible interface supporting chat completions, responses with persistent storage, deferred completions, and collection-based document search.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://docs.x.ai/api",
    "x-jentic-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://api.x.ai/v1",
      "description": "xAI API"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/chat/completions": {
      "post": {
        "operationId": "createChatCompletion",
        "summary": "Create a chat completion from text/image prompts",
        "tags": ["Chat"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["model", "messages"],
                "properties": {
                  "model": {
                    "type": "string",
                    "description": "Model ID (e.g., 'grok-4.20-0309-reasoning', 'grok-4-1-fast-non-reasoning')"
                  },
                  "messages": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["role", "content"],
                      "properties": {
                        "role": {
                          "type": "string",
                          "enum": ["system", "user", "assistant", "tool"]
                        },
                        "content": {
                          "description": "Message content (string or array of content parts)",
                          "oneOf": [
                            { "type": "string" },
                            {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "type": { "type": "string", "enum": ["text", "image_url"] },
                                  "text": { "type": "string" },
                                  "image_url": {
                                    "type": "object",
                                    "properties": {
                                      "url": { "type": "string" }
                                    }
                                  }
                                }
                              }
                            }
                          ]
                        },
                        "name": { "type": "string" },
                        "tool_call_id": { "type": "string" }
                      }
                    }
                  },
                  "temperature": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 2,
                    "default": 1
                  },
                  "max_tokens": {
                    "type": "integer",
                    "description": "Maximum tokens to generate"
                  },
                  "top_p": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "stream": {
                    "type": "boolean",
                    "default": false,
                    "description": "Stream response"
                  },
                  "stop": {
                    "description": "Stop sequences",
                    "oneOf": [
                      { "type": "string" },
                      { "type": "array", "items": { "type": "string" } }
                    ]
                  },
                  "frequency_penalty": {
                    "type": "number",
                    "minimum": -2,
                    "maximum": 2,
                    "default": 0
                  },
                  "presence_penalty": {
                    "type": "number",
                    "minimum": -2,
                    "maximum": 2,
                    "default": 0
                  },
                  "n": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 1,
                    "description": "Number of completions"
                  },
                  "tools": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "type": { "type": "string", "enum": ["function"] },
                        "function": {
                          "type": "object",
                          "properties": {
                            "name": { "type": "string" },
                            "description": { "type": "string" },
                            "parameters": { "type": "object" }
                          }
                        }
                      }
                    },
                    "description": "Tool definitions (max 128)"
                  },
                  "tool_choice": {
                    "description": "Tool choice strategy",
                    "oneOf": [
                      { "type": "string", "enum": ["none", "auto", "required"] },
                      {
                        "type": "object",
                        "properties": {
                          "type": { "type": "string" },
                          "function": {
                            "type": "object",
                            "properties": {
                              "name": { "type": "string" }
                            }
                          }
                        }
                      }
                    ]
                  },
                  "response_format": {
                    "type": "object",
                    "properties": {
                      "type": { "type": "string", "enum": ["text", "json_object", "json_schema"] },
                      "json_schema": { "type": "object" }
                    }
                  },
                  "search_parameters": {
                    "type": "object",
                    "description": "Web search integration parameters",
                    "properties": {
                      "mode": { "type": "string", "enum": ["auto", "on", "off"] },
                      "return_citations": { "type": "boolean" },
                      "from_date": { "type": "string" },
                      "to_date": { "type": "string" },
                      "max_search_results": { "type": "integer" }
                    }
                  },
                  "seed": {
                    "type": "integer",
                    "description": "Random seed for reproducibility"
                  },
                  "logprobs": {
                    "type": "boolean",
                    "default": false
                  },
                  "top_logprobs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 20
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Chat completion response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ChatCompletionResponse" }
              }
            }
          },
          "401": { "description": "Invalid API key" },
          "429": { "description": "Rate limit exceeded" }
        }
      }
    },
    "/responses": {
      "post": {
        "operationId": "createResponse",
        "summary": "Generate a response with persistent storage (30-day retention)",
        "tags": ["Responses"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["model", "input"],
                "properties": {
                  "model": {
                    "type": "string",
                    "description": "Model ID"
                  },
                  "input": {
                    "description": "Input text or message array",
                    "oneOf": [
                      { "type": "string" },
                      {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "role": { "type": "string" },
                            "content": { "type": "string" }
                          }
                        }
                      }
                    ]
                  },
                  "instructions": {
                    "type": "string",
                    "description": "System instructions"
                  },
                  "reasoning": {
                    "type": "object",
                    "properties": {
                      "effort": {
                        "type": "string",
                        "enum": ["low", "medium", "high"],
                        "description": "Reasoning effort level"
                      }
                    }
                  },
                  "tools": {
                    "type": "array",
                    "items": { "type": "object" },
                    "description": "Tool definitions"
                  },
                  "stream": {
                    "type": "boolean",
                    "default": false
                  },
                  "temperature": {
                    "type": "number"
                  },
                  "max_output_tokens": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Generated response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ResponseObject" }
              }
            }
          }
        }
      }
    },
    "/responses/{response_id}": {
      "get": {
        "operationId": "getResponse",
        "summary": "Retrieve a previously generated response",
        "tags": ["Responses"],
        "parameters": [
          {
            "name": "response_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Response ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Response object",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ResponseObject" }
              }
            }
          },
          "404": { "description": "Response not found" }
        }
      },
      "delete": {
        "operationId": "deleteResponse",
        "summary": "Delete a stored response",
        "tags": ["Responses"],
        "parameters": [
          {
            "name": "response_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Deletion confirmation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "object": { "type": "string" },
                    "deleted": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/chat/deferred-completion/{request_id}": {
      "get": {
        "operationId": "getDeferredCompletion",
        "summary": "Fetch results from a deferred chat completion request",
        "tags": ["Chat"],
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Deferred request ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Completed deferred response",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ChatCompletionResponse" }
              }
            }
          },
          "202": {
            "description": "Request still processing"
          }
        }
      }
    },
    "/models": {
      "get": {
        "operationId": "listModels",
        "summary": "List available models",
        "tags": ["Models"],
        "responses": {
          "200": {
            "description": "List of models",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "object": { "type": "string", "enum": ["list"] },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string" },
                          "object": { "type": "string" },
                          "created": { "type": "integer" },
                          "owned_by": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/embeddings": {
      "post": {
        "operationId": "createEmbedding",
        "summary": "Create embeddings for input text",
        "tags": ["Embeddings"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["model", "input"],
                "properties": {
                  "model": {
                    "type": "string",
                    "description": "Embedding model ID"
                  },
                  "input": {
                    "description": "Input text or array of texts",
                    "oneOf": [
                      { "type": "string" },
                      { "type": "array", "items": { "type": "string" } }
                    ]
                  },
                  "encoding_format": {
                    "type": "string",
                    "enum": ["float", "base64"],
                    "default": "float"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Embedding response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "object": { "type": "string", "enum": ["list"] },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "object": { "type": "string", "enum": ["embedding"] },
                          "embedding": {
                            "type": "array",
                            "items": { "type": "number" }
                          },
                          "index": { "type": "integer" }
                        }
                      }
                    },
                    "model": { "type": "string" },
                    "usage": {
                      "type": "object",
                      "properties": {
                        "prompt_tokens": { "type": "integer" },
                        "total_tokens": { "type": "integer" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "xAI API key as Bearer token"
      }
    },
    "schemas": {
      "ChatCompletionResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "object": { "type": "string", "enum": ["chat.completion"] },
          "created": { "type": "integer" },
          "model": { "type": "string" },
          "choices": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "index": { "type": "integer" },
                "message": {
                  "type": "object",
                  "properties": {
                    "role": { "type": "string" },
                    "content": { "type": "string", "nullable": true },
                    "tool_calls": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string" },
                          "type": { "type": "string" },
                          "function": {
                            "type": "object",
                            "properties": {
                              "name": { "type": "string" },
                              "arguments": { "type": "string" }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "finish_reason": {
                  "type": "string",
                  "enum": ["stop", "length", "tool_calls", "content_filter"]
                },
                "logprobs": {
                  "type": "object",
                  "nullable": true
                }
              }
            }
          },
          "usage": {
            "type": "object",
            "properties": {
              "prompt_tokens": { "type": "integer" },
              "completion_tokens": { "type": "integer" },
              "total_tokens": { "type": "integer" }
            }
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": { "type": "string" },
                "title": { "type": "string" }
              }
            },
            "nullable": true
          },
          "system_fingerprint": { "type": "string" }
        }
      },
      "ResponseObject": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "object": { "type": "string" },
          "created_at": { "type": "integer" },
          "model": { "type": "string" },
          "status": { "type": "string", "enum": ["completed", "failed", "in_progress", "cancelled"] },
          "output": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": { "type": "string" },
                "id": { "type": "string" },
                "role": { "type": "string" },
                "content": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "type": { "type": "string" },
                      "text": { "type": "string" }
                    }
                  }
                }
              }
            }
          },
          "usage": {
            "type": "object",
            "properties": {
              "input_tokens": { "type": "integer" },
              "output_tokens": { "type": "integer" },
              "total_tokens": { "type": "integer" }
            }
          }
        }
      }
    }
  }
}