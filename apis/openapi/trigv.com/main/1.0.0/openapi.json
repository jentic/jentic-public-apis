{
  "openapi": "3.1.0",
  "info": {
    "title": "Trigv API",
    "version": "1.0.0",
    "description": "Developer notification ingest API. Workspaces send JSON events; Trigv queues push delivery.\nNotification title and body are not stored server-side — metadata only.\n",
    "contact": {
      "name": "Trigv",
      "url": "https://trigv.com",
      "email": "privacy@trigv.com"
    },
    "x-jentic-source-url": "https://api.trigv.com/openapi.yaml"
  },
  "servers": [
    {
      "url": "https://api.trigv.com/api",
      "description": "Production"
    }
  ],
  "paths": {
    "/v1/events": {
      "post": {
        "tags": [
          "Ingest"
        ],
        "summary": "Send an event",
        "description": "Accepts a notification event for a workspace channel. Bills one event per accepted ingest.\nDuplicate `idempotency_key` within a workspace returns the existing event (200) without incrementing usage.\n",
        "operationId": "ingestEvent",
        "security": [
          {
            "ingestBearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IngestEventRequest"
              },
              "example": {
                "channel": "general",
                "title": "Deploy finished",
                "description": "Build",
                "level": "success",
                "event_type": "deploy.completed",
                "idempotency_key": "deploy-42"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Duplicate idempotency key — existing event returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestEventResponse"
                }
              }
            }
          },
          "202": {
            "description": "Event accepted and queued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestEventResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "Channel not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/v1/connection": {
      "get": {
        "tags": [
          "Ingest"
        ],
        "summary": "Verify API key and return connection metadata",
        "description": "Read-only integration auth test. Does not create an event, increment usage, or send a push.\nProves the credential is authorized for send-event ingest (same key/workspace checks as POST,\nwithout channel resolution or event quota). Rate-limited separately from POST /events.\n",
        "operationId": "ingestConnection",
        "security": [
          {
            "ingestBearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Credential authorized for ingest",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectionResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/api-keys": {
      "get": {
        "tags": [
          "API Keys"
        ],
        "summary": "List workspace API keys",
        "security": [
          {
            "sanctumBearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "API keys for the authenticated user's workspace",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "api_keys": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ApiKey"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "post": {
        "tags": [
          "API Keys"
        ],
        "summary": "Create API key",
        "description": "Returns the full plaintext key once in the `key` field.",
        "security": [
          {
            "sanctumBearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 120
                  },
                  "expires_at": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Optional expiry (must be in the future)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Key created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "description": "Plaintext key — shown once only"
                    },
                    "api_key": {
                      "$ref": "#/components/schemas/ApiKey"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api-keys/{publicId}/rotate": {
      "post": {
        "tags": [
          "API Keys"
        ],
        "summary": "Rotate API key",
        "description": "Generates a new secret immediately invalidating the previous one. Name and public_id unchanged.",
        "security": [
          {
            "sanctumBearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "publicId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Key rotated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string"
                    },
                    "api_key": {
                      "$ref": "#/components/schemas/ApiKey"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Key not found or revoked"
          }
        }
      }
    },
    "/api-keys/{publicId}": {
      "delete": {
        "tags": [
          "API Keys"
        ],
        "summary": "Revoke API key",
        "security": [
          {
            "sanctumBearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "publicId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Key revoked"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Key not found"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ingestBearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Workspace ingest API key. Format: `trgv_{8 alphanumeric}_{32 alphanumeric}`.\nDo not send in the JSON body — use this header only.\n"
      },
      "sanctumBearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Laravel Sanctum personal access token from login/register."
      }
    },
    "schemas": {
      "IngestEventRequest": {
        "type": "object",
        "required": [
          "channel",
          "title"
        ],
        "properties": {
          "api_key": {
            "type": "string",
            "description": "Prohibited — use Authorization Bearer instead",
            "deprecated": true
          },
          "channel": {
            "type": "string",
            "maxLength": 120
          },
          "title": {
            "type": "string",
            "maxLength": 255
          },
          "description": {
            "type": "string",
            "maxLength": 1000
          },
          "image_url": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048,
            "description": "Optional image URL (HTTPS recommended). Passed through to FCM and fetched by the app.\nNever stored on Trigv servers. May expire or become unavailable after delivery.\n"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048,
            "description": "Optional destination URL (e.g. pull request, deployment, payment, or issue page).\nPassed through in FCM data for the mobile app. Never stored on Trigv servers.\nThe server does not fetch or validate reachability of this URL.\n",
            "example": "https://github.com/acme/app/actions/runs/123456789"
          },
          "level": {
            "type": "string",
            "enum": [
              "info",
              "success",
              "warning",
              "error"
            ],
            "default": "info"
          },
          "delivery_urgency": {
            "type": "string",
            "enum": [
              "standard",
              "time_sensitive"
            ],
            "default": "standard",
            "description": "iOS delivery urgency. `standard` uses normal active notifications.\n`time_sensitive` sets APNs interruption-level to time-sensitive (requires\nTime Sensitive Notifications capability in the iOS app). Does not bypass\nthe mute switch. Reserved for future values (e.g. critical).\n"
          },
          "event_type": {
            "type": "string",
            "maxLength": 120
          },
          "idempotency_key": {
            "type": "string",
            "maxLength": 190
          }
        },
        "additionalProperties": false
      },
      "IngestEventResponse": {
        "type": "object",
        "properties": {
          "event": {
            "type": "object",
            "properties": {
              "public_id": {
                "type": "string"
              },
              "event_uuid": {
                "type": "string",
                "format": "uuid"
              },
              "status": {
                "type": "string"
              },
              "level": {
                "type": "string"
              },
              "event_type": {
                "type": "string",
                "nullable": true
              },
              "target_device_count": {
                "type": "integer"
              },
              "received_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      },
      "ConnectionResponse": {
        "type": "object",
        "required": [
          "workspace",
          "api_key"
        ],
        "properties": {
          "workspace": {
            "type": "object",
            "required": [
              "public_id",
              "name"
            ],
            "properties": {
              "public_id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            }
          },
          "api_key": {
            "type": "object",
            "required": [
              "public_id",
              "name",
              "prefix"
            ],
            "properties": {
              "public_id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "prefix": {
                "type": "string"
              }
            }
          }
        }
      },
      "ApiKey": {
        "type": "object",
        "properties": {
          "public_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "prefix": {
            "type": "string"
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rate_limit_per_minute": {
            "type": "integer",
            "nullable": true
          },
          "last_used_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "last_used_ip": {
            "type": "string",
            "nullable": true
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "revoked_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "MessageResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing or invalid authentication",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/MessageResponse"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Key revoked, expired, or insufficient scope",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/MessageResponse"
            }
          }
        }
      },
      "ValidationError": {
        "description": "Validation failed",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                },
                "errors": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "RateLimited": {
        "description": "Per-key burst limit or monthly workspace cap exceeded",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/MessageResponse"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Ingest",
      "description": "Event ingest (workspace API keys)"
    },
    {
      "name": "API Keys",
      "description": "Dashboard-authenticated key management (Sanctum)"
    }
  ]
}