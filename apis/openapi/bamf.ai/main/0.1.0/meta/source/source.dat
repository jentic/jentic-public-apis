    "/posts/{post_id}/approve": {
      "post": {
        "summary": "Approve a creator-owned draft post",
        "description": "Records the creator owner's approval for an unscheduled, unpublished draft. The transition atomically persists canonical BAMF post review metadata and any matching approval request, uses an Approved label when the workspace has one, and otherwise preserves the unscheduled draft status. It returns a replayable receipt and never schedules, publishes, calls, or mutates a provider. Only the exact creator owner may approve; workspace managers, members, clients, and creator-scoped keys for another creator are denied.",
        "parameters": [
          {
            "name": "post_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 240
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Creator approval receipt; provider_action and provider_mutation are false.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatorPostApprovalResponse"
                }
              }
            }
          },
          "400": {
            "description": "Missing or unbounded Idempotency-Key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Exact creator ownership is required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Post is already approved, scheduled, published, or not a draft.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/posts/{post_id}/preview": {
      "get": {
        "summary": "Get a preview-rich post",
        "parameters": [
