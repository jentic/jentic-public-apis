    "/profile-packages/capture-status": {
      "get": {
        "summary": "Get safe profile capture status",
        "description": "Returns Original/current capture timestamps and verification status for one creator. Never returns capture provenance, browser runs, raw provider payloads, cookies, or secrets. Requires profile_packages:read.",
        "parameters": [
          {
            "name": "creator_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Safe profile capture status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericDataResponse"
                }
              }
            }
          }
        }
      }
    },
    "/profile-packages/snapshots": {
      "post": {
        "summary": "Ingest an immutable Profile Studio capture",
        "description": "Stores a creator-authorized, bounded snapshot handed off by BAMFOS. Requires profile_packages:write and Idempotency-Key. The caller supplies the exact snapshot UUID. A retry with the same UUID and canonical content returns 200 idempotently; a differing payload returns 409. Original is accepted only for a verified pre-BAMF capture. This endpoint stores evidence only and never changes LinkedIn.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 200
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfileSnapshotIngestRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Existing identical snapshot returned idempotently",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileSnapshotIngestResponse"
                }
              }
            }
          },
          "201": {
            "description": "Snapshot ingested",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileSnapshotIngestResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid, unsafe, unbounded, or non-Original-eligible snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "UUID, content hash, creator, supersession, or Original-baseline conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/profile-packages": {
      "get": {
        "summary": "List Profile Studio packages",
        "description": "Lists creator-scoped, versioned BAMF Profile Studio packages. Package output removes private capture/provider provenance. Requires profile_packages:read.",
        "parameters": [
          {
            "name": "creator_id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "include_archived",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Profile packages",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericListResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a Profile Studio package",
        "description": "Creates a versioned BAMF package after exact approval. Requires profile_packages:write and Idempotency-Key. This reversible record write does not apply or publish changes to LinkedIn.",
        "responses": {
          "201": {
            "description": "Profile package created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericDataResponse"
                }
              }
            }
          }
        }
      }
    },
    "/profile-packages/{profile_package_id}": {
      "get": {
        "summary": "Get a Profile Studio package",
        "description": "Returns one creator-authorized package with safe package fields only. Requires profile_packages:read. The response ETag is the exact optimistic-concurrency token required for a subsequent save.",
        "parameters": [
          {
            "name": "profile_package_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Profile package",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericDataResponse"
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Update a Profile Studio package",
        "description": "Updates a versioned BAMF package after exact approval. Requires profile_packages:write, a stable Idempotency-Key, and the exact If-Match ETag returned by GET. The response contains a profile-package-save-receipt/v1 whose package ID, previous ETag, returned ETag, and non-live/reversible flags must be validated before treating the save as complete. It is reversible and never applies changes to LinkedIn.",
        "parameters": [
          {
            "name": "profile_package_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 200
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "description": "Exact ETag returned by GET /profile-packages/{profile_package_id}.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Profile package updated with a validated save receipt",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericDataResponse"
                }
              }
            }
          },
          "412": {
            "description": "The package changed since the supplied ETag; refresh before retrying."
          },
          "428": {
            "description": "The If-Match version token is required."
          }
        }
      }
    },
    "/profile-packages/{profile_package_id}/duplicate": {
      "post": {
        "summary": "Duplicate a Profile Studio package",
        "description": "Creates a draft variation of an authorized package. Requires profile_packages:write and Idempotency-Key. This never applies or publishes to LinkedIn.",
        "parameters": [
          {
            "name": "profile_package_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Profile package duplicated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericDataResponse"
                }
              }
            }
          }
        }
      }
    },
    "/profile-packages/{profile_package_id}/select": {
      "post": {
        "summary": "Select a Profile Studio package",
        "description": "Marks an authorized BAMF package selected after exact approval. Requires profile_packages:write and Idempotency-Key. Selection is reversible package metadata, not live LinkedIn application.",
        "parameters": [
          {
            "name": "profile_package_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Profile package selected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericDataResponse"
                }
              }
            }
          }
        }
      }
    },
    "/profile-packages/{profile_package_id}/archive": {
      "post": {
        "summary": "Archive a Profile Studio package",
        "description": "Archives an authorized package after exact approval. Requires profile_packages:write and Idempotency-Key. Archive is reversible through PATCH and never modifies LinkedIn.",
        "parameters": [
          {
            "name": "profile_package_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Profile package archived",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericDataResponse"
                }
              }
            }
          }
        }
      }
    },
    "/analytics/summary": {
      "get": {
        "summary": "Get analytics summary",
        "description": "Returns LinkedIn analytics by default. Pass platform=x for saved X/Twitter account and post analytics.",
        "parameters": [
          {
