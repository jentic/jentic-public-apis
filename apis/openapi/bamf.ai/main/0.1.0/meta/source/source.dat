    "/agent/creator-context": {
      "get": {
        "summary": "Read versioned creator context",
        "description": "Returns an exact positive projection through server-resolved creator authorization. This additive operation does not change the legacy creator-context route/tool/resource.",
        "parameters": [
          {
            "name": "creator_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          {
            "name": "sections",
            "in": "query",
            "schema": {
              "type": "string",
              "description": "Comma-separated unique subset of profile,context,voice_profile,linkedin_profile,website,brand_kits,media."
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Versioned public creator context",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentCreatorContextOperationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentOperationError"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentOperationError"
                }
              }
            }
          },
          "403": {
            "description": "Creator or scope access denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentOperationError"
                }
              }
            }
          },
          "404": {
            "description": "Creator not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentOperationError"
                }
              }
            }
          },
          "500": {
            "description": "Creator context temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentOperationError"
                }
              }
            }
          }
        }
      }
    },
