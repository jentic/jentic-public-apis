    "/brand-kits": {
      "get": {
        "summary": "List creator brand kits",
        "description": "Returns author brand packs, brand-pack assets, and generated brand kit projects/pages.",
        "parameters": [
          {
            "name": "creator_id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Creator brand kits",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericDataResponse"
                }
              }
            }
          }
        }
      }
    },
    "/brand-kits/references": {
      "post": {
        "summary": "Attach approved creator brand-kit references",
        "description": "Idempotently appends or explicitly replaces HTTPS style references on a creator-scoped brand pack. Pairing or API authentication never grants creator access; the caller must already have media:write for the requested creator.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["creator_id"],
                "properties": {
                  "creator_id": { "type": "string" },
                  "brand_pack_id": { "type": "string" },
                  "pack_type": { "type": "string", "enum": ["personal", "image_quote", "infographic", "carousel"], "default": "image_quote" },
                  "mode": { "type": "string", "enum": ["append", "replace"], "default": "append" },
                  "asset_role": { "type": "string", "enum": ["logo", "style_reference", "template_reference", "texture", "color_reference"], "default": "style_reference" },
                  "reference_urls": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "format": "uri" } },
                  "inline_reference_data_urls": { "type": "array", "maxItems": 4, "items": { "type": "string", "description": "PNG, JPEG, or WebP data URL." } },
                  "name": { "type": "string" },
                  "description": { "type": ["string", "null"] },
                  "tags": { "type": "array", "items": { "type": "string" } },
                  "palette": { "type": "array", "items": { "type": "string" } },
                  "fonts": { "type": "array", "items": { "type": "string" } },
                  "visual_style_prompt": { "type": ["string", "null"] },
                  "brand_rules": { "type": ["string", "null"] },
                  "negative_prompt": { "type": ["string", "null"] },
                  "notes": { "type": ["string", "null"] }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated brand pack and mutation receipt",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GenericDataResponse" }
              }
            }
          }
        }
      }
    },
    "/outreach/discoveries": {
      "post": {
        "summary": "Start outreach discovery",
        "description": "Starts provider-read-only candidate discovery for a server-issued tenant, workspace, agent session, principal context, provider binding, and capability receipt. Requires a signed-in BAMF user session and Idempotency-Key. Never creates or sends a campaign.",
        "parameters": [{ "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "minLength": 8, "maxLength": 240 } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OutreachDiscoveryStartRequest" } } } },
        "responses": { "200": { "description": "Discovery state; providerMutation is always false" }, "403": { "description": "Tenant, principal, capability, or session denied" } }
      }
    },
    "/outreach/discoveries/{discovery_session_id}/resume": {
      "post": {
        "summary": "Resume outreach discovery",
        "description": "Resumes from server-owned coverage; caller-supplied provider cursors and organization IDs are not authority.",
        "parameters": [{ "name": "discovery_session_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "minLength": 8, "maxLength": 240 } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OutreachDiscoveryStartRequest" } } } },
        "responses": { "200": { "description": "Discovery state; providerMutation is always false" }, "403": { "description": "Tenant, principal, capability, or session denied" } }
      }
    },
    "/outreach/discoveries/{discovery_session_id}/status": {
      "post": {
        "summary": "Get outreach discovery status",
        "description": "Reads a tenant- and principal-scoped discovery state without provider mutation.",
        "parameters": [{ "name": "discovery_session_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OutreachDiscoveryScopeRequest" } } } },
        "responses": { "200": { "description": "Discovery state; providerMutation is false" }, "404": { "description": "Scoped session not found" } }
      }
    },
    "/outreach/discoveries/{discovery_session_id}/cancel": {
      "post": {
        "summary": "Cancel outreach discovery",
        "description": "Requests cancellation of discovery only. It does not mutate or cancel any campaign.",
        "parameters": [{ "name": "discovery_session_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "minLength": 8, "maxLength": 240 } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OutreachDiscoveryScopeRequest" } } } },
        "responses": { "200": { "description": "Cancellation state; providerMutation is false" } }
      }
    },
    "/outreach/discoveries/{discovery_session_id}/save": {
      "post": {
        "summary": "Save outreach discovery",
        "description": "Explicitly saves the current non-excluded candidates as a durable list snapshot. It does not create, enroll, or send a campaign.",
        "parameters": [{ "name": "discovery_session_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "minLength": 8, "maxLength": 240 } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OutreachDiscoveryScopeRequest" } } } },
        "responses": { "200": { "description": "Saved snapshot receipt; providerMutation is false" }, "503": { "description": "Session is not saveable or selection is empty" } }
      }
    },
    "/outreach/campaigns": {
      "post": { "summary": "Prepare outreach campaign", "description": "Prepares copy and cadence against an exact current signed list revision and connector account. Requires a signed-in BAMF user session and Idempotency-Key. Never sends.", "parameters": [{ "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "minLength": 8, "maxLength": 240 } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OutreachCampaignPrepareRequest" } } } }, "responses": { "200": { "description": "Redacted prepared receipt; providerMutation is false" }, "403": { "description": "JWT session or principal scope required" } } }
    },
    "/outreach/campaigns/{campaign_id}/approve": {
      "post": { "summary": "Approve outreach campaign", "description": "Approves the exact action fingerprint until the supplied expiry. Approval does not queue or send.", "parameters": [{ "name": "campaign_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "minLength": 8, "maxLength": 240 } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/OutreachCampaignScopeRequest" }, { "type": "object", "required": ["approval_ref", "action_fingerprint", "approval_expires_at"], "properties": { "approval_ref": { "type": "string" }, "action_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "approval_expires_at": { "type": "string", "format": "date-time" } } }] } } } }, "responses": { "200": { "description": "Redacted approval receipt; providerMutation is false" } } }
    },
    "/outreach/campaigns/{campaign_id}/queue": {
      "post": { "summary": "Queue outreach campaign", "description": "Queues the approved exact campaign after freshness checks. Does not send.", "parameters": [{ "name": "campaign_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "minLength": 8, "maxLength": 240 } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OutreachCampaignScopeRequest" } } } }, "responses": { "200": { "description": "Redacted queued receipt; providerMutation is false" } } }
    },
    "/outreach/campaigns/{campaign_id}/cancel": {
      "post": { "summary": "Cancel outreach campaign", "description": "Cancels a prepared, approved, or queued campaign without provider invocation.", "parameters": [{ "name": "campaign_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "minLength": 8, "maxLength": 240 } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OutreachCampaignScopeRequest" } } } }, "responses": { "200": { "description": "Redacted cancellation receipt; providerMutation is false" } } }
    },
    "/outreach/campaigns/{campaign_id}/status": {
      "post": { "summary": "Get outreach campaign status", "description": "Reads tenant- and principal-scoped state and redacted receipts.", "parameters": [{ "name": "campaign_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OutreachCampaignScopeRequest" } } } }, "responses": { "200": { "description": "Redacted status; providerMutation is false" }, "404": { "description": "Scoped campaign not found" } } }
    },
    "/outreach/campaigns/{campaign_id}/admit-execution": {
      "post": { "summary": "Admit outreach campaign execution", "description": "Moves the exact queued campaign to executing after rechecking list, connector, fingerprint, and approval. This is admission only: it never calls a provider and is not proof of send or delivery.", "parameters": [{ "name": "campaign_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "minLength": 8, "maxLength": 240 } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "allOf": [{ "$ref": "#/components/schemas/OutreachCampaignScopeRequest" }, { "type": "object", "required": ["action_fingerprint"], "properties": { "action_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } }] } } } }, "responses": { "200": { "description": "Redacted execution-admission receipt; providerMutation is false and no send is proven" } } }
    },
    "/outreach/exact-thread-replies": {
      "post": { "summary": "Prepare or stop an exact-thread reply", "description": "Evaluates and persists a reply or follow-up against server-owned account, exact provider thread/message receipt, suppression, approval, and identity evidence. Requires a signed-in BAMF user session and Idempotency-Key. It returns prepared or stopped and never invokes or sends through a provider.", "parameters": [{ "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "minLength": 8, "maxLength": 240 } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ExactThreadReplyPrepareRequest" } } } }, "responses": { "200": { "description": "Redacted prepared/stopped decision receipt; providerMutation and sendAvailable are false" }, "403": { "description": "JWT session or workspace scope required" }, "409": { "description": "Idempotency key conflicts with a different request" } } }
    },
    "/outreach/growth-deliveries/prepare": {
      "post": { "summary": "Prepare exact-comment growth delivery", "description": "Persists a preparation-only resource giveaway, newsletter, and booking handoff bound to one exact eligible comment, recipient, account, thread, approval, and artifact revisions. Requires a signed-in BAMF user session and Idempotency-Key. It never calls, sends, or claims delivery through a provider.", "parameters": [{ "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "minLength": 8, "maxLength": 240 } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OutreachGrowthDeliveryPrepareRequest" } } } }, "responses": { "200": { "description": "Prepared receipt with providerMutation and submitted fixed false", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OutreachGrowthDeliveryPrepareResponse" } } } }, "403": { "description": "JWT session required" }, "409": { "description": "Stale, mismatched, opted-out, duplicate, or idempotency-conflicting request" } } }
    },
