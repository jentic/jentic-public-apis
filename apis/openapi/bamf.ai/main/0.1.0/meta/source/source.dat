            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "platform",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "linkedin",
                "x",
                "twitter"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Creator analytics summary",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericDataResponse"
                }
              }
            }
          }
        }
      }
    },
    "/analytics/creator-report": {
      "get": {
        "summary": "Build a portfolio creator analytics report",
        "description": "Returns a bounded, source-attributed LinkedIn analytics report for every creator space the authenticated actor can access. The result is designed for text clients and MCP Apps, includes creator/profile/BAMF deep links, and reports source truncation explicitly. Requires analytics:read.",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 365,
              "default": 90
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Portable creator analytics report",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["schema", "generated_at", "window", "totals", "creators", "coverage", "provenance"],
                  "properties": {
                    "schema": { "const": "bamf.creator-analytics-report/v1" },
                    "generated_at": { "type": "string", "format": "date-time" },
                    "window": { "type": "object" },
                    "totals": { "type": "object" },
                    "creators": { "type": "array", "items": { "type": "object" } },
                    "coverage": { "type": "object" },
                    "provenance": { "type": "object" }
                  }
                }
              }
            }
          },
          "400": { "description": "Invalid analytics window" },
          "401": { "description": "Missing or invalid bearer token" }
        }
      }
    },
    "/analytics/funnel-mix": {
      "get": {
        "summary": "Get funnel mix",
        "description": "TOF/MOF/BOF mix from AI-tagged LinkedIn posts over the window: per-stage counts, performance and best post, per-format stats, the resolved goal target (creator override or goal default), gaps vs target, neglected stages, best formats per stage, and a quotable gap line. Read-only; requires analytics:read.",
        "parameters": [
          {
            "name": "creator_id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "days",
            "in": "query",
            "description": "Lookback window in days.",
            "schema": {
              "type": "integer",
              "default": 90,
              "minimum": 1,
              "maximum": 730
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Creator funnel mix",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericDataResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ads/competitor-ads": {
      "get": {
        "summary": "Find competitor ads",
        "description": "Longest-running competitor ads (Meta, LinkedIn, TikTok) tracked in the creator's workspace, with advertiser, copy, format and days running. Read-only; requires analytics:read.",
        "parameters": [
          {
            "name": "platform",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "meta",
                "linkedin",
                "tiktok"
              ]
            }
          },
          {
            "name": "q",
            "in": "query",
            "description": "Text to match in headline, copy, or advertiser name.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "creator_id",
            "in": "query",
            "description": "Required when the key can access several creators.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 10,
              "minimum": 1,
              "maximum": 25
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Competitor ads, longest running first",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericDataResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ads/keyword-ideas": {
      "get": {
        "summary": "Suggest ad keywords",
        "description": "Related keywords with monthly search volume, CPC and competition for ad targeting. Cached 14 days; a fresh lookup is metered at about one cent and capped per workspace per day. Read-only; requires analytics:read.",
        "parameters": [
          {
            "name": "keyword",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 120
            }
          },
          {
            "name": "country",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "US"
            }
          },
          {
            "name": "creator_id",
            "in": "query",
            "description": "Required when the key can access several creators.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Keyword ideas",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericDataResponse"
                }
              }
            }
          }
        }
      }
    },
    "/analytics/funnel-examples": {
      "get": {
        "summary": "Find funnel examples",
        "description": "Top AI-tagged example posts for a funnel stage and optional format from the inspiration library (by likes), post templates, or the creator's own posts (by impressions). Returns excerpt, stage, format, media type, and metrics. Read-only; requires analytics:read.",
        "parameters": [
          {
            "name": "stage",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "tof",
                "mof",
                "bof"
              ]
            }
          },
          {
            "name": "format",
            "in": "query",
            "description": "Taxonomy format id, e.g. case_study.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "source",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "inspiration",
                "templates",
                "own"
              ],
              "default": "inspiration"
            }
          },
          {
            "name": "creator_id",
            "in": "query",
            "description": "Required for source=own when the key can access several creators.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 10,
              "minimum": 1,
              "maximum": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tagged funnel examples",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericDataResponse"
                }
              }
            }
          }
        }
      }
    },
    "/analytics/audience": {
      "get": {
