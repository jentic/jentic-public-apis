    "/analytics/sync": {
      "post": {
        "summary": "Create analytics sync job",
        "description": "Queues LinkedIn analytics sync by default. Pass platform=x to queue X analytics sync.",
        "responses": {
          "202": {
            "description": "Analytics sync job queued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiJobResponse"
                }
              }
            }
          }
        }
      }
    },
    "/x/analytics/sync": {
      "post": {
        "summary": "Queue X analytics sync",
        "description": "Triggers the X analytics sync function for the current or requested creator space.",
        "responses": {
          "202": {
            "description": "X analytics sync queued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiJobResponse"
                }
              }
            }
          }
        }
      }
    },
    "/generate/posts": {
      "post": {
        "summary": "Create post generation job",
        "description": "For LinkedIn, returns one concise candidate grounded in fetched creator context, plus one focused follow-up question when a material personal detail is missing. Private source context is not returned. Does not create a post. Pass platform=x for X-native concepts, hooks, threads, CTAs, and performance-informed copy.",
        "responses": {
          "202": {
            "description": "Post generation job queued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiJobResponse"
                }
              }
            }
          }
        }
      }
    },
    "/generate/x-posts": {
      "post": {
        "summary": "Create X post generation job",
        "description": "Returns X-native single-post or thread concepts, draft copy, hook/CTA rationale, and platform-specific recommendations. Does not create a post.",
        "responses": {
          "202": {
            "description": "X post generation job queued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiJobResponse"
                }
              }
            }
          }
        }
      }
    },
    "/generate/post-edits": {
      "post": {
        "summary": "Create post edit job",
        "description": "Returns a reviewable edit proposal, quality audit, deterministic quality comparison, and PATCH payload. Does not patch the post. For rough or low-quality drafts, pass current_content/source_material with edit_mode=full_rewrite so BAMF can preserve keeper points and rebuild the post with creator context.",
        "responses": {
          "202": {
            "description": "Post edit job queued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiJobResponse"
                }
              }
            }
          }
        }
      }
    },
    "/generate/images": {
      "post": {
        "summary": "Create image generation job",
        "description": "Generates quote cards, creator portrait images, infographics, and package-bound LinkedIn profile assets. reference_bindings preserves official identity, product, and brand truth separately from inspiration used only for style or layout. profile_banner is generated at 2400x800 then center-cropped/resized to 1584x396; profile_featured is generated at 1536x800 then center-cropped/resized to 1200x628. Profile jobs never attach to posts and return profile_package_asset.generated_asset with a durableRef when the job succeeds.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateImageRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Image generation job queued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiJobResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid reference binding, profile package binding, asset slot, or post attachment"
          },
          "404": {
            "description": "Active profile package not found for this creator"
          }
        }
      }
    },
    "/generate/videos": {
      "post": {
        "summary": "Create Higgsfield Seedance 2.5 video generation job",
        "description": "Queues a paid video request. Supplying image_url or an official likeness reference uses Seedance 2.5 image-to-video to preserve the approved source identity; text-only requests use text-to-video. Successful jobs return a BAMF-hosted MP4 media asset and a provider request ID; failed, cancelled, or moderated requests are not reported as successful.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/GenerateVideoRequest" }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Video generation job queued",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiJobResponse" }
              }
            }
          },
          "400": { "description": "Invalid video generation input" }
        }
      }
    },
    "/generate/music": {
      "post": {
        "summary": "Generate an instrumental music track",
        "description": "Requires images:generate. Generates a 10-30 second instrumental MP3 (default 15 seconds) from a prompt of up to 2000 characters, stores it in the creator media bucket, and returns its URL. Returns 503 music_provider_unavailable when the music provider is not configured.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["prompt"],
                "properties": {
                  "prompt": { "type": "string", "maxLength": 2000 },
                  "duration_seconds": { "type": "integer", "minimum": 10, "maximum": 30, "default": 15 },
                  "creator_id": { "type": "string", "format": "uuid" },
                  "author_id": { "type": "string", "format": "uuid" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Generated track: url, storage_path, duration_seconds, license" },
          "400": { "description": "invalid_prompt" },
          "503": { "description": "Music provider unavailable" }
        }
      }
    },
    "/design-references": {
      "get": {
        "summary": "List curated design references",
        "description": "Requires creator_spaces:read. Lists approved design references, optionally filtered by category or free-text query. limit defaults to 20 and is capped at 50. MCP: bamf.list_design_references.",
        "parameters": [
          { "name": "category", "in": "query", "schema": { "type": "string" } },
          { "name": "query", "in": "query", "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 50, "default": 20 } }
        ],
        "responses": {
          "200": { "description": "Design references with count" }
        }
      }
    },
    "/design-references/instantiate": {
      "get": {
        "summary": "Instantiate a design reference with a brand kit",
        "description": "Requires creator_spaces:read and access to the target creator space. Identify the reference by reference_id or slug; optionally bind a brand_kit_project_id or brand_pack_id and an author_id/creator_id (creator-scoped keys default to their own space). MCP: bamf.instantiate_design_reference.",
        "parameters": [
          { "name": "reference_id", "in": "query", "schema": { "type": "string" } },
          { "name": "slug", "in": "query", "schema": { "type": "string" } },
          { "name": "brand_kit_project_id", "in": "query", "schema": { "type": "string" } },
          { "name": "brand_pack_id", "in": "query", "schema": { "type": "string" } },
          { "name": "author_id", "in": "query", "schema": { "type": "string", "format": "uuid" } },
          { "name": "creator_id", "in": "query", "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "Instantiated design reference" },
          "403": { "description": "creator_access_denied" }
        }
      }
    },
    "/generate/talking-videos": {
      "post": {
        "summary": "Create Higgsfield Speak v2 lip-synced talking video job",
        "description": "Queues a paid lip-sync request that animates a creator image speaking the supplied script. The script must stay within 40 words (about 15 seconds of audio); BAMF picks the smallest 5, 10, or 15 second Speak v2 duration that fits. Successful jobs return a BAMF-hosted MP4 media asset; failed, cancelled, or moderated requests are not reported as successful.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateTalkingVideoRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Talking video generation job queued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiJobResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid talking video input, including script_required or script_too_long"
          }
        }
      }
    },
    "/generate/carousels": {
      "post": {
        "summary": "Create carousel generation job",
        "description": "Generates slide images, packages them into a LinkedIn-ready PDF, and optionally attaches the PDF to a post.",
