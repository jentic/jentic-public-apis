              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentOperationError"
                }
              }
            }
          }
        }
      }
    },
    "/agent/identity": {
      "get": {
        "summary": "Read the authenticated agent identity",
        "description": "Returns the server-resolved BAMF account identity, effective creator-space count, and verified saved default creator space. Email and display name are returned when available. A sole accessible space may be returned separately as a recommendation when no saved default exists. Query, body, identity, scope, and workspace selectors are not accepted.",
        "responses": {
          "200": {
            "description": "Authenticated actor identity positive allowlist",
            "content": {
