    "/interview-links": {
      "post": {
        "summary": "Create a secure creator interview link",
        "description": "Creates a scoped, expiring BAMF.ai voice or content interview invitation for a creator space.",
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["creator_id"],
                "properties": {
                  "creator_id": { "type": "string" },
                  "mode": { "type": "string", "enum": ["content_interview", "sales_discovery"], "default": "content_interview" },
                  "label": { "type": "string" },
                  "expires_days": { "type": "integer", "minimum": 1, "maximum": 90, "default": 14 },
                  "max_uses": { "type": "integer", "minimum": 1, "maximum": 100, "default": 1 },
                  "contact_metadata": { "type": "object" },
                  "offer_facts": { "type": "object" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Secure interview invitation and delivery link",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GenericDataResponse" } } }
          }
        }
      }
    },
    "/interview-links/{id}": {
      "delete": {
        "summary": "Revoke a creator interview link",
        "description": "Revokes the exact creator-scoped interview invitation. This does not send a provider message or delete completed interview content.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "creator_id", "in": "query", "required": true, "schema": { "type": "string" } },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "responses": {
          "200": {
            "description": "Interview invitation revoked",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GenericDataResponse" } } }
          },
          "404": { "description": "Interview invitation not found in the creator scope" }
        }
      }
    },
