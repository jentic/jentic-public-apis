              }
            }
          }
        }
      }
    },
    "/runs/{run_id}/events": {
      "get": {
        "summary": "Get run status events",
        "description": "Returns the live, named status of an agent run or API job: the run, its sub-agents, tool and model calls, each with status, partial result, cost, and timing. Requires agent_sessions:read. Pass after_sequence to fetch only events after a given sequence, or set Accept to text/event-stream for a resumable live stream instead of a single snapshot.",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "A chat turn id or an API job id (returned by POST /jobs)."
          },
          {
            "name": "after_sequence",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": -1
            },
            "description": "Only return events with a sequence greater than this value. Ignored (but still accepted) alongside Last-Event-ID."
          },
          {
            "name": "Last-Event-ID",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "description": "Resumes an SSE stream after the given sequence; takes precedence over after_sequence."
          }
        ],
        "responses": {
          "200": {
            "description": "Run status snapshot and events, or (when Accept is text/event-stream) a live SSE stream of run.node events whose id is the sequence, ending with a run.end event carrying the final snapshot. The SSE stream closes after roughly 55 seconds so clients reconnect with Last-Event-ID.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "run": {
                          "$ref": "#/components/schemas/RunStatusSnapshot"
                        },
                        "events": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/RunNodeEvent"
                          }
                        }
                      }
                    }
                  }
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "SSE stream: repeated run.node events (data is a RunNodeEvent, id is its sequence), followed by a final run.end event whose data is a RunStatusSnapshot."
                }
              }
            }
          },
          "400": {
            "description": "run_id is not a valid run identifier.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "agent_sessions:read scope required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Run not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
