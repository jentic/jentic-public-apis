          "operation",
          "post_id",
          "creator_id",
          "state",
          "approved_at",
          "idempotency_key",
          "provider_action",
          "provider_mutation",
          "replay"
        ],
        "properties": {
          "schema": { "const": "creator-post-approval-receipt/v1" },
          "operation": { "const": "post.approve" },
          "post_id": { "type": "string" },
          "creator_id": { "type": "string" },
          "approval_request_id": { "type": ["string", "null"] },
          "state": { "const": "approved" },
          "previous_state": { "type": "string" },
          "approved_at": { "type": "string", "format": "date-time" },
          "approved_by": { "type": "string" },
          "idempotency_key": { "type": "string", "minLength": 8, "maxLength": 240 },
          "provider_action": { "const": false },
          "provider_mutation": { "const": false },
          "replay": { "type": "boolean" }
        }
      },
      "CreatorPostApprovalResponse": {
        "type": "object",
        "required": ["data", "receipt"],
        "properties": {
          "data": { "$ref": "#/components/schemas/Post" },
          "receipt": { "$ref": "#/components/schemas/CreatorPostApprovalReceipt" }
        }
      },
      "ApiJob": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "job_type": {
            "type": "string",
            "enum": [
              "post.generate",
              "post.edit",
              "image.generate",
              "carousel.generate",
              "carousel.pdf",
              "brand_kit.generate",
              "research.run",
              "knowledge.process",
              "analytics.sync"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "completed",
              "failed",
              "cancelled",
              "canceled"
            ]
          },
          "creator_id": {
            "type": "string"
          },
          "input": {
            "$ref": "#/components/schemas/JSONValue"
          },
          "output": {
            "$ref": "#/components/schemas/JSONValue"
          },
          "error": {
            "$ref": "#/components/schemas/JSONValue"
          },
          "created_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "updated_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "ResolvedMultimodalReferenceV1": {
        "type": "object",
        "additionalProperties": false,
        "required": ["binding", "asset_url"],
        "properties": {
          "binding": { "$ref": "#/components/schemas/MultimodalReferenceBindingV1" },
          "asset_url": {
            "type": "string",
            "format": "uri",
            "description": "HTTP(S) URL for the immutable asset version named by the binding."
          }
        }
      },
      "MultimodalReferenceBindingV1": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schemaVersion", "bindingId", "workspaceId", "subjectId", "subjectType", "assetId", "assetVersion", "authority", "purposes", "required", "consent", "provenance", "createdAt"],
        "properties": {
          "schemaVersion": { "type": "string", "const": "bamf.multimodal-reference-binding/v1" },
          "bindingId": { "type": "string" },
          "workspaceId": { "type": "string" },
          "subjectId": { "type": "string" },
          "subjectType": { "type": "string", "enum": ["person", "product", "logo", "typography", "palette", "icon", "brand_rules", "creator_voice", "brand_voice"] },
          "assetId": { "type": "string" },
          "assetVersion": { "type": "string" },
          "authority": { "type": "string", "enum": ["official", "inspiration"] },
          "purposes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "enum": ["identity", "exact_product", "exact_logo", "typography", "color", "iconography", "brand_rules", "voice_identity", "voice_style", "style", "layout", "pose", "lighting", "scale"] }
          },
          "required": { "type": "boolean" },
          "consent": {
            "type": "object",
            "required": ["status", "scopes"],
            "properties": {
              "status": { "type": "string", "enum": ["granted", "not_required", "unknown", "revoked", "expired"] },
              "receiptRef": { "type": "string" },
              "scopes": { "type": "array", "items": { "type": "string" } },
              "grantedAt": { "type": "string", "format": "date-time" },
              "expiresAt": { "type": "string", "format": "date-time" },
              "revokedAt": { "type": "string", "format": "date-time" }
            }
          },
          "provenance": {
            "type": "object",
            "required": ["sourceKind", "sourceRef", "observedAt"],
            "properties": {
              "sourceKind": { "type": "string", "enum": ["upload", "capture", "provider_import", "generated", "migration"] },
              "sourceRef": { "type": "string" },
              "contentHash": { "type": "string" },
              "observedAt": { "type": "string", "format": "date-time" },
              "actorRef": { "type": "string" }
            }
          },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "GenerateImageRequest": {
        "type": "object",
        "required": [
          "creator_id",
          "prompt"
        ],
        "properties": {
          "creator_id": {
            "type": "string",
            "format": "uuid"
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "visual_type": {
            "type": "string",
            "enum": [
              "image_quote",
              "infographic",
              "personal",
              "profile_banner",
              "profile_featured"
            ]
          },
          "profile_package_id": {
            "type": "string",
            "format": "uuid",
            "description": "Required for profile_banner and profile_featured; must be an active package owned by creator_id."
          },
          "profile_asset_kind": {
            "type": "string",
            "enum": [
              "banner",
              "featured_1",
              "featured_2"
            ],
            "description": "profile_banner accepts banner; profile_featured accepts featured_1 or featured_2."
          },
          "size": {
            "type": "string",
            "description": "Caller-selected size for non-profile images. Profile image source sizes are enforced server-side."
          },
          "quality": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "auto"
            ]
          },
          "n": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4,
            "description": "Profile image jobs always enforce n=1."
          },
          "referenceImageUrls": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "likenessReferenceImageUrls": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "styleReferenceImageUrls": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "reference_bindings": {
            "type": "array",
            "maxItems": 10,
            "description": "Resolved official and inspiration references. Official person identity routes to likeness; other official references preserve exact product or brand truth; inspiration can guide style, layout, pose, or lighting only. The validated snapshot is persisted with the generation job.",
            "items": { "$ref": "#/components/schemas/ResolvedMultimodalReferenceV1" }
          },
          "post_id": {
            "type": "string",
            "format": "uuid",
            "description": "Optional for non-profile images. Forbidden for profile image jobs."
          },
          "alt_text": {
            "type": "string"
          },
          "metadata": {
            "$ref": "#/components/schemas/JSONValue"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "visual_type": {
                  "const": "profile_banner"
                }
              },
              "required": [
                "visual_type"
              ]
            },
            "then": {
              "required": [
                "profile_package_id",
                "profile_asset_kind"
              ],
              "properties": {
                "profile_asset_kind": {
                  "const": "banner"
                },
                "n": {
                  "const": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "visual_type": {
                  "const": "profile_featured"
                }
              },
              "required": [
                "visual_type"
              ]
            },
            "then": {
              "required": [
                "profile_package_id",
                "profile_asset_kind"
              ],
              "properties": {
                "profile_asset_kind": {
                  "enum": [
                    "featured_1",
                    "featured_2"
                  ]
                },
                "n": {
                  "const": 1
                }
              }
            }
          }
        ]
      },
      "GenerateVideoRequest": {
        "type": "object",
        "required": ["creator_id", "prompt"],
        "properties": {
          "creator_id": { "type": "string", "format": "uuid" },
          "prompt": { "type": "string", "minLength": 1 },
          "duration": { "type": "integer", "enum": [5, 10], "default": 5 },
          "resolution": { "type": "string", "enum": ["480p", "720p", "1080p"], "default": "720p" },
          "aspect_ratio": { "type": "string", "enum": ["16:9", "9:16", "1:1"], "default": "16:9" },
          "generate_audio": { "type": "boolean", "default": true },
          "image_url": {
            "type": "string",
            "format": "uri",
            "description": "Optional approved start frame. When supplied, BAMF uses Seedance 2.5 image-to-video."
          },
          "reference_bindings": {
            "type": "array",
            "description": "Optional reference contract. The first official likeness image is used as the image-to-video start frame; inspiration references never establish identity.",
            "items": { "$ref": "#/components/schemas/ReferenceBindingInput" }
          }
        }
      },
      "GenerateTalkingVideoRequest": {
        "type": "object",
        "required": [
          "creator_id",
          "script"
        ],
        "properties": {
          "creator_id": {
            "type": "string",
            "format": "uuid"
          },
          "script": {
            "type": "string",
            "minLength": 1,
            "description": "Words the creator speaks. At most 40 words (about 15 seconds of audio)."
          },
          "image_url": {
            "type": "string",
            "format": "uri",
            "description": "Optional HTTP(S) image of the speaker."
          },
          "quality": {
            "type": "string",
            "enum": [
              "mid",
              "high"
            ],
            "default": "mid"
          },
          "prompt": {
            "type": "string",
            "description": "Optional direction for expression and motion."
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "CreateJobRequest": {
        "type": "object",
        "required": [
          "creator_id",
          "job_type"
        ],
        "properties": {
          "creator_id": {
            "type": "string"
          },
          "job_type": {
            "type": "string",
            "enum": [
              "post.generate",
              "post.edit",
              "image.generate",
              "video.generate",
              "carousel.generate",
              "carousel.pdf",
              "brand_kit.generate",
              "research.run",
              "knowledge.process",
              "analytics.sync"
            ]
          },
          "input": {
            "$ref": "#/components/schemas/JSONValue"
          },
          "cost_class": {
            "type": "string"
          }
        }
      },
      "ApiJobResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ApiJob"
          }
        }
      },
      "ApiJobsResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApiJob"
            }
          }
        }
      },
      "RunNodeEvent": {
        "type": "object",
        "description": "One status transition for a run node (the run itself, a sub-agent, a tool call, a model call, a responder, or a router). The latest event per node_id is that node's current state.",
        "properties": {
          "schema_version": {
            "type": "string",
            "enum": ["bamf.agent-stream/v1"]
          },
          "type": {
            "type": "string",
            "enum": ["run.node"]
          },
          "turn_id": {
            "type": "string"
          },
          "sequence": {
            "type": "integer",
            "minimum": 0
          },
          "run_id": {
            "type": "string"
          },
          "node_id": {
            "type": "string"
          },
          "parent_node_id": {
            "type": ["string", "null"]
          },
          "node_kind": {
            "type": "string",
            "enum": ["run", "subagent", "tool", "model", "responder", "router"]
          },
          "name": {
            "type": "string",
            "description": "User-facing name, e.g. \"Researcher\", \"Analytics\"."
          },
          "role": {
            "type": ["string", "null"]
          },
          "task": {
            "type": ["string", "null"]
          },
          "status": {
            "type": "string",
            "enum": ["queued", "running", "waiting_approval", "succeeded", "failed", "cancelled", "skipped"]
          },
          "partial": {
            "type": ["string", "null"]
          },
          "cost": {
            "type": ["object", "null"],
            "properties": {
              "input_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "output_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "usd": {
                "type": ["number", "null"]
              }
            }
          },
          "timing": {
            "type": "object",
            "properties": {
              "started_at": {
                "type": ["string", "null"],
                "format": "date-time"
              },
              "ended_at": {
                "type": ["string", "null"],
                "format": "date-time"
              },
              "ttft_ms": {
                "type": ["number", "null"]
              }
            }
          },
          "route_decision_id": {
            "type": ["string", "null"]
          }
        }
      },
      "RunNodeState": {
        "type": "object",
        "description": "The folded current state of one run node, with its children nested under it.",
        "properties": {
          "run_id": {
            "type": "string"
          },
          "node_id": {
            "type": "string"
          },
          "parent_node_id": {
            "type": ["string", "null"]
          },
          "node_kind": {
            "type": "string",
            "enum": ["run", "subagent", "tool", "model", "responder", "router"]
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": ["string", "null"]
          },
          "task": {
            "type": ["string", "null"]
          },
          "status": {
            "type": "string",
            "enum": ["queued", "running", "waiting_approval", "succeeded", "failed", "cancelled", "skipped"]
          },
          "partial": {
            "type": ["string", "null"]
          },
          "cost": {
            "type": ["object", "null"],
            "properties": {
              "input_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "output_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "usd": {
                "type": ["number", "null"]
              }
            }
          },
          "timing": {
            "type": "object",
            "properties": {
              "started_at": {
                "type": ["string", "null"],
                "format": "date-time"
              },
              "ended_at": {
                "type": ["string", "null"],
                "format": "date-time"
              },
              "ttft_ms": {
                "type": ["number", "null"]
              }
            }
          },
          "route_decision_id": {
            "type": ["string", "null"]
          },
          "last_sequence": {
            "type": "integer",
            "minimum": 0
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RunNodeState"
            }
          }
        }
      },
      "RunStatusSnapshot": {
        "type": "object",
        "description": "The current folded tree for a run, produced from its run.node events.",
        "properties": {
          "run_id": {
            "type": "string"
          },
          "status": {
            "type": ["string", "null"],
            "enum": ["queued", "running", "waiting_approval", "succeeded", "failed", "cancelled", "skipped", null]
          },
          "last_sequence": {
            "type": "integer"
          },
          "nodes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RunNodeState"
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/onboarding": {
      "get": {
        "summary": "Get BAMF Bot onboarding status",
        "description": "The same onboarding steps, order and progress as bamf.ai, with how an agent runs each step. Creates the caller's creator space on first use. Requires creator_spaces:read.",
        "parameters": [
          {
            "name": "creator_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Defaults to the caller's own creator space."
          }
        ],
        "responses": {
          "200": {
            "description": "Onboarding status: ordered steps (same as bamf.ai), next step, time saved, verified rewards and web links.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericDataResponse"
                }
              }
            }
          }
        }
      }
    },
    "/onboarding/steps/{step}": {
      "post": {
        "summary": "Finish or skip an onboarding step",
        "description": "Saves the step outcome on the same record as the web onboarding, optionally with the person's answer and profile basics, then claims any server-verified activation rewards. Requires creator_spaces:read; profile edits need the creator's own account or creator_spaces:write.",
        "parameters": [
          {
            "name": "step",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Step id from GET /onboarding (legacy aliases accepted)."
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "creator_id": {
                    "type": "string"
                  },
                  "outcome": {
                    "type": "string",
                    "enum": [
                      "completed",
                      "skipped"
                    ],
                    "default": "completed"
                  },
                  "answer": {
                    "type": "object",
                    "description": "Small JSON object (8 KB max), saved under state.answers[step]."
                  },
                  "profile": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "website_url": {
                        "type": "string"
                      },
                      "linkedin_profile_url": {
                        "type": "string"
                      },
                      "industry": {
                        "type": "string"
                      },
                      "job_description": {
                        "type": "string"
                      },
                      "bio": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Onboarding status: ordered steps (same as bamf.ai), next step, time saved, verified rewards and web links.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericDataResponse"
                }
              }
            }
          }
        }
      }
    },
    "/workspaces/{workspace_id}/sites/artifacts/action": { "post": { "operationId": "siteArtifactAction", "summary": "Persist/read exact HTML source artifacts for custom site versions", "description": "User-scoped keys and an existing managed client binding required. Bounded actions: list_client_projects/get_client_project_artifact require sites:read plus work.read/artifacts.read; create_client_project/save_client_project_artifact_version require sites:write plus work.write/artifacts.write. Writes require Idempotency-Key. Save uses artifact_format=html and complete content up to 1MB, project_id,title,params.idempotency_key and provenance {artifact_schema: bamf-visual-artifact/v1, revision: positive integer, optional provider: openai/anthropic/bamf/other, optional credential-free HTTPS source_session_url}. Updates also require real artifact_id and expected_updated_at. Returns canonical artifact_id/version_id/content_sha256. Use exact saved HTML and those IDs in create_visual_artifact_site_version; it validates persisted content/hash/provenance. Library biz_artifacts are not interchangeable. MCP: bamf.list_site_projects/create_site_project/get_site_artifact/save_site_artifact.", "parameters": [{ "name": "workspace_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "name": "Idempotency-Key", "in": "header", "schema": { "type": "string", "minLength": 8, "maxLength": 200 } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["action", "params"], "additionalProperties": false, "properties": { "action": { "type": "string", "enum": ["list_client_projects", "create_client_project", "get_client_project_artifact", "save_client_project_artifact_version"] }, "params": { "type": "object" } } } } } }, "responses": { "200": { "description": "Canonical persisted artifact result and receipt" }, "400": { "description": "Invalid HTML/provenance/idempotency/concurrency parameters" }, "403": { "description": "Scope/tenant/key/capability denied" }, "409": { "description": "Stale update or conflicting idempotency" } } } },
    "/workspaces/{workspace_id}/sites": { "get": { "operationId": "listClientSites", "summary": "List hosted sites for one authorized client workspace", "description": "Requires sites:read, current managed client binding and work.read/artifacts.read capabilities. MCP: bamf.list_sites. Provides exact site IDs for subsequent builder operations.", "parameters": [{ "name": "workspace_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "200": { "description": "Normalized sites, project links, artifacts and pending approvals" }, "403": { "description": "Tenant/capability/scope denied" } } } },
    "/site-workspaces": { "get": { "operationId": "listSiteWorkspaces", "summary": "Discover authorized managed client site workspaces", "description": "Requires sites:read and a user-scoped key. Returns at most 100 current authorized client workspace IDs, names and kinds, derived from canonical membership/capabilities. Empty results do not provision hosting. MCP: bamf.list_site_workspaces.", "responses": { "200": { "description": "Authorized workspaces" }, "403": { "description": "Missing scope or unsupported creator-scoped key" } } } },
    "/workspaces/{workspace_id}/sites/action": {
      "post": {
        "operationId": "clientSiteAction",
        "summary": "Read, create, revise, preview, version or publish a managed client site",
        "description": "Accepts only canonical Site Builder action names and their bounded params. Requires sites:read for reads, sites:write for revisions/session/context/template actions, or sites:publish for approval/access/execute actions, plus current client workspace capabilities. User-scoped keys only; creator-scoped keys are rejected. Requires an existing authorized managed client workspace binding; does not provision universal creator hosting. Writes require Idempotency-Key. Publish executes the existing exact approval/version contract; timeout returns pending, never success. MCP tools: bamf.list_sites, bamf.get_site, bamf.manage_site, bamf.publish_site.",
        "parameters": [
          { "name": "workspace_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "Idempotency-Key", "in": "header", "description": "Required for mutations; preserve this value on retry.", "schema": { "type": "string", "minLength": 8, "maxLength": 240 } }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false, "required": ["action", "params"], "properties": { "action": { "type": "string", "description": "Canonical Site Builder action; discover supported read/write/publish enums from MCP tools/list." }, "params": { "type": "object", "description": "Canonical action parameters; server validates size, identities and approval contract." } } } } } },
        "responses": {
          "200": { "description": "Normalized site result and request audit IDs" },
          "400": { "description": "Invalid action/params or missing mutation idempotency key" },
          "401": { "description": "Authentication required" },
          "403": { "description": "Scope, key type, tenant binding or capability denied" },
          "409": { "description": "Version/approval or idempotency conflict" },
          "504": { "description": "Publish still running; pending=true. Recheck status before another execution." }
        }
      }
    },
    "/workspaces/{workspace_id}/creator-follows": {
      "get": { "summary": "List workspace creator follows", "parameters": [{ "name": "workspace_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "name": "author_id", "in": "query", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "200": { "description": "Followed creator profiles" } } },
      "post": { "summary": "Follow a LinkedIn, X, or Instagram creator profile", "parameters": [{ "name": "workspace_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "minLength": 8 } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false, "required": ["author_id", "profile"], "properties": { "author_id": { "type": "string", "format": "uuid" }, "profile": { "type": "string", "description": "Profile URL or platform-prefixed handle." }, "platform": { "type": "string", "enum": ["linkedin", "x", "instagram"], "description": "Required only when the input is ambiguous." } } } } } }, "responses": { "201": { "description": "Creator followed or already followed" }, "400": { "description": "Invalid or ambiguous profile input" }, "409": { "description": "Per-platform user-added limit reached" } } }
    },
    "/workspaces/{workspace_id}/creator-follows/{creator_profile_id}": {
      "delete": { "summary": "Unfollow a creator profile", "parameters": [{ "name": "workspace_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "name": "creator_profile_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "name": "author_id", "in": "query", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "minLength": 8 } }], "responses": { "200": { "description": "Creator unfollowed" } } }
