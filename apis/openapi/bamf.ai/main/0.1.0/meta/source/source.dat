    "/creator-spaces": {
      "get": {
        "summary": "List creator spaces",
        "description": "Lists only creator spaces authorized through the caller's effective memberships. Use detail=summary for compact discovery. Omitting detail preserves the legacy full public projection.",
        "parameters": [
          {
            "name": "detail",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "summary",
                "full"
              ],
              "default": "full"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 128
            },
            "description": "Opaque next_cursor from the previous page."
          },
          {
            "name": "offset",
            "in": "query",
            "deprecated": true,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000,
              "default": 0
            },
            "description": "Legacy numeric pagination input. Prefer cursor."
          }
        ],
        "responses": {
          "200": {
            "description": "Creator spaces",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatorSpacesResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid cursor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/creator-spaces/{creator_id}/icp-policy": {
      "parameters": [{"name":"creator_id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],
      "get": {
        "summary":"Read creator-owned criteria, separating AI draft and approved policy",
        "description":"Requires creator_spaces:read and effective creator membership. Managed workspaces return their canonical agency policy reference. Source-only addition pending deployment.",
        "security":[{"BearerAuth":[]}],
        "responses":{"200":{"description":"Creator policy envelope with head, draft, active, generation status, or managed reference"},"403":{"description":"Creator access denied"}}
      },
      "post": {
        "summary":"Edit, activate or opt out of creator criteria using a revision guard",
        "description":"Requires knowledge:write and effective owner/manager approval role. Edits append drafts; only explicit activation changes active authority. Managed agency criteria cannot be edited here.",
        "security":[{"BearerAuth":[]}],
        "requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["action","expected_revision"],"properties":{"action":{"type":"string","enum":["edit","activate","opt_out"]},"expected_revision":{"type":"integer","minimum":0},"version_id":{"type":"string","format":"uuid"},"opted_out":{"type":"boolean"},"criteria":{"type":"object","description":"Canonical client-icp-policy/v2: schema plus target_roles, target_company_types, target_industries, target_locations, buyer_problems, required_criteria, positive_signals, disqualifiers, assumptions arrays. Required criteria must be exact positive criteria members."}}}}}},
        "responses":{"200":{"description":"Updated revision-guarded policy head"},"400":{"description":"Invalid criteria/action"},"403":{"description":"Approval permission denied"},"409":{"description":"Stale revision or draft"}}
      }
    },
    "/creator-spaces/{creator_id}/icp-generation-settings": {
      "post": {
        "summary":"Configure a supported model for automatic creator criteria drafts",
        "description":"Requires creator_spaces:write, creator access and exact workspace owner/admin membership. Missing settings leave configuration_required; no paid fallback model is selected. Managed agency workspaces reject native generation settings.",
        "security":[{"BearerAuth":[]}],
        "parameters":[{"name":"creator_id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],
        "requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["provider","model"],"properties":{"provider":{"type":["string","null"],"enum":["openai",null]},"model":{"type":["string","null"],"description":"Canonical server-supported model; clear both fields with null."}}}}}},
        "responses":{"200":{"description":"Saved owned workspace generation setting"},"400":{"description":"Unsupported model or missing workspace"},"403":{"description":"Workspace setting permission denied"},"409":{"description":"Managed policy reference"}}
      }
    },
    "/creator-spaces/{creator_id}/context": {
      "get": {
        "summary": "Get comprehensive creator context",
        "description": "Returns the creator context bundle used by agents: knowledge docs, identity/context, AI analyses, voice profile, integrations, interviews, LinkedIn profile/posts/performance, website, website screenshot, brand kits, and media. Sections are scope-gated and omitted sections are reported.",
        "parameters": [
          {
            "name": "creator_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sections",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated section names, or omit for all readable sections."
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Creator context bundle",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatorContextResponse"
                }
              }
            }
          }
        }
      }
    },
    "/browser-sessions": {
      "get": {
        "summary": "List shared browser sessions",
        "description": "Lists creator spaces with sanitized browser-connection metadata. Requires browser_session:read. The V2 desktop, extension, agent, CLI, and sandbox paths must treat this as metadata only: no cookie, browser profile, or authenticated session material is returned or authorized. Every call is audited.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "List of shared sessions the actor can read",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "creator_space_id": {
                            "type": "string"
                          },
                          "name": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "avatar_url": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "linkedin_url": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "shared_at": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "format": "date-time"
                          },
                          "status": {
                            "type": "string",
                            "example": "connected"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/creator-spaces/{creator_id}/browser-session": {
      "get": {
        "summary": "Get shared browser session",
        "description": "Returns sanitized browser-connection metadata for account state only. V2 must not use this route to obtain, seed, or transfer browser credentials. Requires browser_session:read. Every read is audited.",
        "parameters": [
          {
            "name": "creator_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Shared session found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BrowserSessionResponse"
                }
              }
            }
          },
          "404": {
            "description": "No shared session, or it was revoked",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "no_shared_session"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Revoke shared browser session",
        "description": "Revokes the creator's browser connection server-side. Requires browser_session:read. Every revoke is audited.",
        "parameters": [
          {
            "name": "creator_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Revoked",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "revoked": {
                      "type": "boolean",
                      "example": true
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Already revoked or never shared"
          }
        }
      }
    },
    "/integrations": {
      "get": {
        "summary": "List connected creator integrations",
        "description": "Returns author integration status and settings with tokens, cookies, and secrets redacted.",
