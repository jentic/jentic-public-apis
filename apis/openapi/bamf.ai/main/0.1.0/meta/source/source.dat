    "/posts/{post_id}/publish": {
      "post": {
        "summary": "Publish a post immediately",
        "description": "User-scoped keys only.",
        "parameters": [
          {
            "name": "post_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Post published",
            "content": {
              "application/json": {
                "schema": {
