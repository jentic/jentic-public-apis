    "/ideas/generate": {
      "post": {
        "summary": "Generate ranked, evidence-backed idea candidates",
        "description": "Requires ai:generate. Returns generated candidates; does not create idea records.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "creator_id"
                ],
                "properties": {
                  "creator_id": {
                    "type": "string"
                  },
                  "query": {
                    "type": "string"
                  },
                  "platforms": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "linkedin",
                        "x",
                        "both"
                      ]
                    }
                  },
                  "include_x_bookmarks": {
                    "type": "boolean",
                    "default": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Generated idea candidates",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericDataResponse"
                }
              }
            }
          }
        }
      }
    },
    "/x/bookmarks": {
      "get": {
        "summary": "List private X/Twitter bookmark imports",
        "description": "Requires ideas:read. Private creator inspiration source; opt-in only when passed into idea/post generation. Each bookmark includes folder_memberships (an array of {folder_id, folder_name}); legacy folder_id and folder_name fields remain as a compatibility projection.",
        "parameters": [
          {
            "name": "creator_id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "folder_id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "folder_name",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "since",
            "in": "query",
            "description": "Only return bookmarks imported at or after this timestamp.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Bookmark rows",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "folder_id": { "type": ["string", "null"] },
                          "folder_name": { "type": ["string", "null"] },
                          "folder_memberships": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "folder_id": { "type": "string" },
                                "folder_name": { "type": "string" }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
