                }
              }
            }
          },
          "403": {
            "description": "Creator-scoped key denied"
          }
        }
      }
    },
    "/posts/{post_id}/boost": {
      "post": {
        "summary": "Apply or trigger an engagement boost",
        "description": "Applies an Engagement Boost to a post. If the post is already published it boosts immediately; if scheduled it arms the boost for publish time. Targeting is auto-matched to the creator. Requires the posts:boost scope.",
        "parameters": [
          {
            "name": "post_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "tier": {
                    "type": "string",
                    "enum": [
                      "basic",
                      "power",
                      "mega"
                    ]
                  },
                  "engagement_type": {
                    "type": "string",
                    "enum": [
                      "reactions",
                      "reactions_comments",
                      "any"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Boost applied or armed"
          }
        }
      }
    },
    "/boost/tiers": {
      "get": {
        "summary": "List engagement boost tiers",
        "description": "Lists the available engagement boost tiers (basic, power, mega). Requires the posts:read scope.",
        "responses": {
          "200": {
            "description": "Boost tiers"
          }
        }
      }
    },
    "/boost/estimate": {
      "get": {
        "summary": "Estimate engagement boost reach",
        "description": "Returns provider-confirmed eligible groups and projected reach for a creator at a given tier and engagement type. A recent complete provider roster and exact account-pod membership are required. When matched group member counts are unmeasured, raw_members, unique_reach, reactions, and comments are null with member_data_status=unknown; zero is not substituted for missing audience data. The best-effort audience explanation is directional, not exact targeting. Requires the posts:read scope.",
        "parameters": [
          {
            "name": "author_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tier",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "basic",
                "power",
                "mega"
              ]
            }
          },
          {
            "name": "engagement_type",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "reactions",
                "reactions_comments",
                "any"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Boost reach estimate"
          }
        }
      }
    },
    "/boost/groups": {
      "get": {
        "summary": "List engagement groups",
        "description": "Lists engagement group registry rows for Engagement Boost (LinkedIn only). Registry rows can be historical and do not prove current provider availability; use /boost/estimate for provider-confirmed eligible group counts. Each group includes id, name, category, engagement_type, region, country, language, industry_tags, and member_count. Pass an optional author_id to filter by creator matching criteria. Requires the posts:read scope.",
        "parameters": [
          {
            "name": "author_id",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Optional. Filters to the engagement groups matched to a creator."
          }
        ],
        "responses": {
          "200": {
            "description": "Engagement groups"
          }
        }
      }
    },
    "/post-requests": {
      "get": {
        "summary": "List a client creator's post requests",
        "description": "Client post requests for the client workspace whose identity is creator_id. Requires ideas:read.",
        "parameters": [
          {
            "name": "creator_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Post requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericListResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a client post request",
        "description": "Queues a post request for an agency client creator: bamf.ai drafts it, writes the client's Notion content approval board with the \"Post request\" status, and pings the client's Slack channel per agency rules. Never publishes. Requires ideas:write.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "creator_id",
                  "idea_text"
                ],
                "properties": {
                  "creator_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "idea_text": {
                    "type": "string"
                  },
                  "brief": {
                    "type": "string"
                  },
                  "links": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "source_channel": {
                    "type": "string",
                    "enum": [
                      "app",
                      "mcp"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Post request created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericDataResponse"
                }
              }
            }
          }
        }
      }
    },
