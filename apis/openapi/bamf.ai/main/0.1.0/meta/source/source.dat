{
  "openapi": "3.1.0",
  "info": {
    "title": "BAMF Developer Platform API",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "https://api.bamf.ai/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "OutreachDiscoveryScopeRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["workspace_id", "session_id", "principal_context_ref_id", "gateway_run_id", "provider", "provider_account_id", "capability_receipt_ref"],
        "properties": {
          "workspace_id": { "type": "string", "format": "uuid" },
          "session_id": { "type": "string", "format": "uuid" },
          "principal_context_ref_id": { "type": "string", "format": "uuid" },
          "gateway_run_id": { "type": "string", "format": "uuid" },
          "provider": { "type": "string", "maxLength": 64 },
          "provider_account_id": { "type": "string", "maxLength": 256 },
          "capability_receipt_ref": { "type": "string", "maxLength": 256 }
        }
      },
      "OutreachDiscoveryStartRequest": {
        "allOf": [
          { "$ref": "#/components/schemas/OutreachDiscoveryScopeRequest" },
          {
            "type": "object",
            "required": ["source_mode", "targeting"],
            "properties": {
              "source_mode": { "type": "string", "enum": ["external", "crm", "first_degree"] },
              "targeting": { "type": "string", "minLength": 1, "maxLength": 4000 }
            }
          }
        ]
      },
      "OutreachCampaignScopeRequest": {
        "type": "object", "additionalProperties": false,
        "required": ["workspace_id", "session_id", "principal_context_ref_id"],
        "properties": { "workspace_id": { "type": "string", "format": "uuid" }, "session_id": { "type": "string", "format": "uuid" }, "principal_context_ref_id": { "type": "string", "format": "uuid" } }
      },
      "OutreachCampaignPrepareRequest": {
        "allOf": [
          { "$ref": "#/components/schemas/OutreachCampaignScopeRequest" },
          { "type": "object", "required": ["binding", "plan"], "properties": {
            "binding": { "type": "object", "additionalProperties": false, "required": ["search_list_id", "snapshot_id", "list_version", "connector_provider", "connector_account_id", "channel"], "properties": { "search_list_id": { "type": "string", "format": "uuid" }, "snapshot_id": { "type": "string", "format": "uuid" }, "list_version": { "type": "integer", "minimum": 1 }, "connector_provider": { "type": "string" }, "connector_account_id": { "type": "string" }, "channel": { "type": "string", "enum": ["linkedin", "gmail", "x", "instagram"] } } },
            "plan": { "type": "object", "additionalProperties": false, "required": ["copy", "cadence", "timezone"], "properties": { "copy": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["step", "body"], "properties": { "step": { "type": "integer", "minimum": 1 }, "body": { "type": "string", "minLength": 1 }, "subject": { "type": "string" } } } }, "cadence": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["step", "delayMinutes"], "properties": { "step": { "type": "integer", "minimum": 1 }, "delayMinutes": { "type": "integer", "minimum": 0 } } } }, "timezone": { "type": "string" }, "resource_refs": { "type": "array", "items": { "type": "string" } }, "booking_ref": { "type": ["string", "null"] } } }
          } }
        ]
      },
      "OutreachCampaignResponse": {
        "type": "object", "additionalProperties": false,
        "required": ["version", "operation", "state", "campaignId", "workspaceId", "listVersion", "connectorProvider", "connectorAccountId", "actionFingerprint", "receiptRef", "providerReceiptRef", "providerReceipt", "failureCode", "readiness", "admissionEvidence", "providerMutation"],
        "properties": {
          "version": { "const": "outreach-campaign/v1" }, "operation": { "type": "string", "enum": ["prepare", "approve", "queue", "cancel", "status", "admit_execution"] }, "state": { "type": "string", "enum": ["prepared", "approved", "queued", "executing", "provider_confirmed", "failed", "cancelled"] }, "campaignId": { "type": "string", "format": "uuid" }, "workspaceId": { "type": "string", "format": "uuid" }, "listVersion": { "type": "integer", "minimum": 1 }, "connectorProvider": { "type": "string" }, "connectorAccountId": { "type": "string" }, "actionFingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "receiptRef": { "type": ["string", "null"] }, "providerReceiptRef": { "type": ["string", "null"] }, "failureCode": { "type": ["string", "null"] }, "providerMutation": { "const": false },
          "readiness": { "type": "object", "additionalProperties": false, "required": ["list", "connector", "approval"], "properties": { "list": { "type": "object", "required": ["snapshotId", "listVersion", "exact"], "properties": { "snapshotId": { "type": "string", "format": "uuid" }, "listVersion": { "type": "integer" }, "exact": { "const": true } } }, "connector": { "type": "object", "required": ["provider", "accountId", "exact"], "properties": { "provider": { "type": "string" }, "accountId": { "type": "string" }, "exact": { "const": true } } }, "approval": { "type": "object", "required": ["approvalRef", "actionFingerprint", "expiresAt", "current"], "properties": { "approvalRef": { "type": ["string", "null"] }, "actionFingerprint": { "type": ["string", "null"] }, "expiresAt": { "type": ["string", "null"], "format": "date-time" }, "current": { "type": "boolean" } } } } },
          "admissionEvidence": { "type": "object", "additionalProperties": false, "required": ["admitted", "state", "actionFingerprint", "approvalRef", "receiptRef"], "properties": { "admitted": { "type": "boolean" }, "state": { "type": "string" }, "actionFingerprint": { "type": "string" }, "approvalRef": { "type": ["string", "null"] }, "receiptRef": { "type": ["string", "null"] } } },
          "providerReceipt": { "oneOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["receiptRef", "provider", "connectorAccountId", "confirmedAt"], "properties": { "receiptRef": { "type": "string" }, "provider": { "type": "string" }, "connectorAccountId": { "type": "string" }, "confirmedAt": { "type": "string", "format": "date-time" } } }] }
        }
      },
      "ExactThreadReplyPrepareRequest": {
        "type": "object", "additionalProperties": false, "required": ["workspace_id", "intent"],
        "properties": {
          "workspace_id": { "type": "string", "format": "uuid" },
          "intent": { "type": "object", "additionalProperties": false, "required": ["version", "account_ref", "channel", "action", "draft_id", "draft_revision", "draft_sha256", "approval_id", "thread", "identity"], "properties": {
            "version": { "const": "exact-thread-reply/v1" }, "account_ref": { "type": "string" }, "channel": { "type": "string", "enum": ["linkedin", "gmail", "x", "instagram"] }, "action": { "type": "string", "enum": ["reply", "follow_up"] }, "draft_id": { "type": "string" }, "draft_revision": { "type": "integer", "minimum": 1 }, "draft_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "approval_id": { "type": "string" },
            "thread": { "type": "object", "additionalProperties": false, "required": ["provider_thread_id", "source_message_id", "provider_receipt_id", "observed_at"], "properties": { "provider_thread_id": { "type": "string" }, "source_message_id": { "type": "string" }, "provider_receipt_id": { "type": "string" }, "observed_at": { "type": "string", "format": "date-time" } } },
            "identity": { "type": "object", "additionalProperties": false, "required": ["evidence_id", "subject_id", "linkedin_profile_url", "gmail_address", "observed_at", "expires_at"], "properties": { "evidence_id": { "type": "string" }, "subject_id": { "type": "string" }, "linkedin_profile_url": { "type": ["string", "null"] }, "gmail_address": { "type": ["string", "null"] }, "observed_at": { "type": "string", "format": "date-time" }, "expires_at": { "type": "string", "format": "date-time" } } }
          } }
        }
      },
      "OutreachGrowthDeliveryPrepareRequest": {
        "type": "object", "additionalProperties": false,
        "required": ["schema_version", "tenant_id", "workspace_id", "principal_context_ref_id", "recipient", "eligibility", "artifacts", "approval", "suppression", "delivery"],
        "properties": {
          "schema_version": { "type": "integer", "const": 1 }, "tenant_id": { "type": "string", "format": "uuid" }, "workspace_id": { "type": "string", "format": "uuid" }, "principal_context_ref_id": { "type": "string", "format": "uuid" },
          "recipient": { "type": "object", "additionalProperties": false, "required": ["recipient_id", "account_id", "thread_id"], "properties": { "recipient_id": { "type": "string", "minLength": 1 }, "account_id": { "type": "string", "minLength": 1 }, "thread_id": { "type": "string", "minLength": 1 } } },
          "eligibility": { "type": "object", "additionalProperties": false, "required": ["evidence_id", "tenant_id", "workspace_id", "principal_context_ref_id", "account_id", "thread_id", "recipient_id", "source_receipt_id", "post_id", "comment_id", "comment_text", "keyword", "captured_at", "eligible_until"], "properties": {
            "evidence_id": { "type": "string", "minLength": 1 }, "tenant_id": { "type": "string", "format": "uuid" }, "workspace_id": { "type": "string", "format": "uuid" }, "principal_context_ref_id": { "type": "string", "format": "uuid" }, "account_id": { "type": "string", "minLength": 1 }, "thread_id": { "type": "string", "minLength": 1 }, "recipient_id": { "type": "string", "minLength": 1 }, "source_receipt_id": { "type": "string", "minLength": 1 }, "post_id": { "type": "string", "minLength": 1 }, "comment_id": { "type": "string", "minLength": 1 }, "comment_text": { "type": "string", "minLength": 1 }, "keyword": { "type": "string", "minLength": 1 }, "captured_at": { "type": "string", "format": "date-time" }, "eligible_until": { "type": "string", "format": "date-time" }
          } },
          "artifacts": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "object", "additionalProperties": false, "required": ["kind", "artifact_id", "revision"], "properties": { "kind": { "type": "string", "enum": ["resource", "newsletter", "booking"] }, "artifact_id": { "type": "string", "minLength": 1 }, "revision": { "type": "string", "minLength": 1 } } } },
          "approval": { "type": "object", "additionalProperties": false, "required": ["approval_id", "revision", "binding", "approved_at", "expires_at"], "properties": { "approval_id": { "type": "string", "minLength": 1 }, "revision": { "type": "string", "minLength": 1 }, "binding": { "type": "string", "minLength": 1 }, "approved_at": { "type": "string", "format": "date-time" }, "expires_at": { "type": "string", "format": "date-time" } } },
          "suppression": { "type": "object", "additionalProperties": false, "required": ["opted_out", "checked_at"], "properties": { "opted_out": { "type": "boolean" }, "checked_at": { "type": "string", "format": "date-time" } } },
          "delivery": { "type": "object", "additionalProperties": false, "required": ["delivery_id", "state", "prior_delivery_ids"], "properties": { "delivery_id": { "type": "string", "minLength": 1 }, "state": { "type": "string", "const": "pending" }, "prior_delivery_ids": { "type": "array", "items": { "type": "string" } } } }
        }
      },
      "OutreachGrowthDeliveryPrepareResponse": {
        "type": "object", "additionalProperties": false,
        "required": ["version", "receiptId", "preparedIntentId", "replay", "state", "suppressionOutcome", "providerMutation", "submitted"],
        "properties": { "version": { "const": "outreach-growth-delivery-preparation/v1" }, "receiptId": { "type": "string", "format": "uuid" }, "preparedIntentId": { "type": "string", "format": "uuid" }, "replay": { "type": "boolean" }, "state": { "const": "prepared" }, "suppressionOutcome": { "const": "clear" }, "providerMutation": { "const": false }, "submitted": { "const": false } }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "request_id": {
                "type": "string"
              }
            }
          }
        }
      },
      "BrowserSessionResponse": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "example": "linkedin"
          },
          "linkedin_url": {
            "type": "string",
            "example": "https://www.linkedin.com/in/bamfcreator"
          },
          "shared_at": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "example": "connected"
          },
          "cookies": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                },
                "domain": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "secure": {
                  "type": "boolean"
                },
                "httpOnly": {
                  "type": "boolean"
                },
                "sameSite": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "LinkedInCreatorProfile": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "headline": {
            "type": [
              "string",
              "null"
            ]
          },
          "bio": {
            "type": [
              "string",
              "null"
            ]
          },
          "job_title": {
            "type": [
              "string",
              "null"
            ]
          },
          "company_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "location": {
            "type": [
              "string",
              "null"
            ]
          },
          "profile_image_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "follower_count": {
            "type": [
              "integer",
              "null"
            ]
          },
          "connection_count": {
            "type": [
              "integer",
              "null"
            ]
          },
          "profile_views": {
            "type": [
              "integer",
              "null"
            ]
          },
          "status": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_refreshed": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "updated_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "CreatorSpace": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "creator_id": {
            "type": "string",
            "description": "Alias of id for agent workflows that ask for creator_id."
          },
          "user_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "workspace_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "bio": {
            "type": [
              "string",
              "null"
            ]
          },
          "industry": {
            "type": [
              "string",
              "null"
            ]
          },
          "job_description": {
            "type": [
              "string",
              "null"
            ]
          },
          "avatar_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "linkedin_username": {
            "type": [
              "string",
              "null"
            ]
          },
          "linkedin_headline": {
            "type": [
              "string",
              "null"
            ]
          },
          "linkedin_profile_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "website_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "website_summary": {
            "type": [
              "string",
              "null"
            ]
          },
          "follower_count": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Current LinkedIn follower count from the linked profile metrics row."
          },
          "connection_count": {
            "type": [
              "integer",
              "null"
            ]
          },
          "profile_views": {
            "type": [
              "integer",
              "null"
            ]
          },
          "linkedin_profile": {
            "$ref": "#/components/schemas/LinkedInCreatorProfile"
          },
          "created_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "updated_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "CreatorSpacesResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreatorSpace"
            }
          },
          "pagination": {
            "type": "object",
            "required": [
              "limit",
              "offset",
              "returned",
              "has_more",
              "next_cursor"
            ],
            "properties": {
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "offset": {
                "type": "integer",
                "minimum": 0,
                "description": "Legacy numeric position. New callers should use next_cursor."
              },
              "returned": {
                "type": "integer",
                "minimum": 0
              },
              "has_more": {
                "type": "boolean"
              },
              "next_cursor": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Opaque cursor for the next page, or null on the final page."
              }
            }
          }
        }
      },
      "AuthenticatedActor": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string"
          },
          "key_type": {
            "type": "string"
          },
          "creator_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "creator_space": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CreatorSpace"
              },
              {
                "type": "null"
              }
            ]
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "service": {
            "type": "string"
          }
        },
        "required": [
          "ok",
          "service"
        ]
      },
      "JSONValue": {
        "description": "Any JSON value returned by flexible workflow, analytics, context, or generation payloads."
      },
      "GenericDataResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/JSONValue"
          }
        }
      },
      "ProfileSnapshotAsset": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id",
          "mime_type",
          "size_bytes",
          "sha256",
          "localization_status"
        ],
        "properties": {
          "asset_id": {
            "type": "string",
            "maxLength": 160
          },
          "storage_bucket": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 160,
            "description": "Optional durable bucket identifier. Omit for private cross-system storage."
          },
          "storage_path": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1000,
            "description": "Optional relative object path. Signed URLs and credentials are forbidden."
          },
          "mime_type": {
            "type": "string",
            "enum": [
              "image/png",
              "image/jpeg",
              "image/webp"
            ]
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 52428800
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "source_url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri",
            "description": "Credential-free public HTTPS URL; query and fragment are discarded."
          },
          "captured_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "localization_status": {
            "type": "string",
            "enum": [
              "localized",
              "external",
              "missing"
            ]
          }
        }
      },
      "ProfileSnapshotIngestRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "creator_id",
          "source_profile_url",
          "captured_at",
          "validation_status",
          "is_pre_bamf_capture",
          "is_original_baseline",
          "profile",
          "assets",
          "missing",
          "provenance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Exact immutable source snapshot UUID; also serves as record-level idempotency identity."
          },
          "creator_id": {
            "type": "string",
            "format": "uuid"
          },
          "source_profile_url": {
            "type": "string",
            "format": "uri",
            "description": "HTTPS LinkedIn /in/ profile URL."
          },
          "captured_at": {
            "type": "string",
            "format": "date-time"
          },
          "validation_status": {
            "type": "string",
            "enum": [
              "pending",
              "partial",
              "verified",
              "failed"
            ]
          },
          "is_pre_bamf_capture": {
            "type": "boolean"
          },
          "is_original_baseline": {
            "type": "boolean",
            "description": "Allowed only when validation_status is verified and is_pre_bamf_capture is true."
          },
          "supersedes_snapshot_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "profile": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 240
              },
              "headline": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 500
              },
              "about": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 12000
              },
              "location": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 500
              },
              "profile_url": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uri"
              },
              "featured": {
                "type": "array",
                "maxItems": 6,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "title": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 500
                    },
                    "description": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 2000
                    },
                    "url": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "uri"
                    }
                  }
                }
              }
            }
          },
          "assets": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "full_page_screenshot": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/ProfileSnapshotAsset"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "photo": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/ProfileSnapshotAsset"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "banner": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/ProfileSnapshotAsset"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "featured": {
                "type": "array",
                "maxItems": 6,
                "items": {
                  "$ref": "#/components/schemas/ProfileSnapshotAsset"
                }
              }
            }
          },
          "missing": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "field",
                "reason"
              ],
              "properties": {
                "field": {
                  "type": "string",
                  "maxLength": 80
                },
                "reason": {
                  "type": "string",
                  "maxLength": 500
                }
              }
            }
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "capture_method",
              "source_system",
              "source_record_id"
            ],
            "properties": {
              "capture_method": {
                "type": "string",
                "enum": [
                  "governed_browser",
                  "api",
                  "import"
                ]
              },
              "source_system": {
                "type": "string",
                "maxLength": 120
              },
              "source_record_id": {
                "type": "string",
                "maxLength": 240
              },
              "source_content_hash": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9a-fA-F]{64}$",
                "description": "Source system's immutable custody hash. This is distinct from BAMF.ai's canonical content_hash."
              },
              "source_snapshot_id": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uuid"
              },
              "capture_receipt_id": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uuid"
              },
              "capture_job_id": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uuid"
              },
              "visible_url": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uri"
              },
              "evidence_refs": {
                "type": "array",
                "maxItems": 12,
                "items": {
                  "type": "string",
                  "maxLength": 500
                }
              },
              "notes": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 1000
              }
            }
          },
          "content_hash": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-fA-F]{64}$",
            "description": "Optional expected BAMF.ai canonical hash. Omit on first handoff and persist the returned hash for receipts."
          }
        }
      },
