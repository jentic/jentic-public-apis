    "/agent/route": {
      "post": {
        "summary": "Route an agent workflow request",
        "description": "Deterministically maps a natural-language BAMF request to the recommended workflow, BAMF Stack skill, REST endpoints, MCP tools, scopes, and approval policy. This observational proposal does not execute; server authority resolves identity, workspace, capability health, provider binding, approval, and idempotency under bamf-agent-turn/v2.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentRouteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Non-executing agent workflow route proposal",
