        "parameters": [
          {
            "name": "Authorization",
            "description": "Token gerado pelo OAuth 2",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tenant",
            "description": "Identificador do tenant",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "reportName",
            "description": "Nome do relatório",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "format",
            "description": "Formato de exportação. PDF, XLSX, HTML, CSV, DOCX",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "datasetType",
            "description": "Tipo da fonte do json para o relatório. Somente pode ser url para o get.",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "datasetContent",
            "description": "URL da fonte do json para o relatório.",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "parameters",
            "description": "Parâmetros do relatório em formato json. Exemplo: {\"param1\":\"value1\",\"param2\":\"value2\"}",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sucesso. Retorna o relatório para download."
          },
          "400": {
            "description": "Faltando parâmetros obrigatórios (tenant)."
          },
          "401": {
            "description": "Falha na autenticação."
          },
          "403": {
            "description": "Falha na autorização."
          },
          "500": {
