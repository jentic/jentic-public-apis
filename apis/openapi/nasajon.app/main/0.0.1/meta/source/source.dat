{
  "openapi": "3.0.0",
  "info": {
    "version": "0.0.1",
    "title": "APIs do Web Report",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/Nasajon-Teste/apis-do-web-report/0.0.1"
  },
  "servers": [
    {
      "url": "https://api.nasajon.app/nsj-web-report-api/"
    }
  ],
  "components": {
    "securitySchemes": {
      "OAuth2": {
        "type": "oauth2",
        "flows": {
          "password": {
            "tokenUrl": "https://auth.nasajon.com.br/auth/realms/master/protocol/openid-connect/token",
            "scopes": {
              "offline_access": "Token para acesso offline"
            }
          }
        }
      }
    },
    "schemas": {
      "conexao": {
        "type": "object",
        "required": [
          "nome",
          "engine"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Id da conexão no banco",
            "readOnly": true
          },
          "nome": {
            "type": "string",
            "description": "Nome da conexão"
          },
          "engine": {
            "type": "string",
            "description": "Engine da conexão",
            "enum": [
              "_ns_mb",
              "_ns_web",
              "_ns_ot"
            ]
          },
          "host": {
            "type": "string",
            "description": "Host da conexão, somente usado para engine _ns_ot"
          },
          "port": {
            "type": "integer",
            "description": "Porta da conexão, somente usado para engine _ns_ot"
          },
          "username": {
            "type": "string",
            "description": "Usuário da conexão, somente usado para engine _ns_ot"
          },
          "database": {
            "type": "string",
            "description": "Nome do banco da conexão, somente usado para engine _ns_ot"
          },
          "password": {
            "type": "string",
            "description": "Senha da conexão, somente usado para engine _ns_ot"
          },
          "tenant": {
            "type": "integer",
            "description": "Tenant da conexão, se não informado, a conexão é global"
          }
        }
      },
      "conexoes": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/conexao"
        }
      },
      "consulta": {
        "type": "object",
        "required": [
          "nome",
          "consulta",
          "id_datasource"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Id da consulta",
            "readOnly": true
          },
          "nome": {
            "type": "string",
            "description": "Nome da consulta"
          },
          "consulta": {
            "type": "string",
            "description": "SQL da consulta"
          },
          "id_datasource": {
            "type": "string",
            "format": "uuid",
            "description": "Id do datasource relacionado"
          },
          "parametros": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/parametro"
            }
          }
        }
      },
      "consultas": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/consulta"
        }
      },
      "datasourceJson": {
        "type": "object",
        "required": [
          "nome",
          "json"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Id do datasource",
            "readOnly": true
          },
          "nome": {
            "type": "string",
            "description": "Nome do datasource"
          },
          "json": {
            "type": "object",
            "description": "Conteúdo JSON do datasource. É salvo como string no banco."
          },
          "tenant": {
            "type": "integer",
            "description": "Tenant do datasource, se não informado, é global"
          }
        }
      },
      "datasourcesJson": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/datasourceJson"
        }
      },
      "datasource": {
        "type": "object",
        "required": [
          "nome",
          "id_conexao"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Id do datasource no banco",
            "readOnly": true
          },
          "nome": {
            "type": "string",
            "description": "Nome do datasource"
          },
          "tenant": {
            "type": "integer",
            "description": "Tenant do datasource, se não informado, o datasource é global"
          },
          "id_conexao": {
            "type": "string",
            "format": "uuid",
            "description": "Id da conexão associada"
          },
          "consultas": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/consulta"
            },
            "description": "Consultas associadas ao datasource"
          }
        }
      },
      "datasources": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/datasource"
        }
      },
      "parametro": {
        "type": "object",
        "required": [
          "nome",
          "tipo"
        ],
        "properties": {
          "nome": {
            "type": "string",
            "description": "Nome do parâmetro"
          },
          "tipo": {
            "type": "string",
            "description": "Tipo do parâmetro em C#",
            "enum": [
              "booleano",
              "inteiro",
              "texto",
              "datahora",
              "data",
              "hora",
              "id"
            ]
          },
          "valor": {
            "type": "string",
            "description": "Valor padrão do parâmetro"
          },
          "usa_relatorio_parametro": {
            "type": "boolean",
            "description": "Indica se o parâmetro é vinculado a um parâmetro do relatório. É necessário criar o parâmetro no relatório com o mesmo nome para alterar o valor dele durante os testes."
          }
        }
      },
      "relatorio_parametro": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nome": {
            "type": "string",
            "description": "Nome do parâmetro"
          },
          "tipo": {
            "type": "string",
            "description": "Tipo do parâmetro em C#"
          }
        }
      },
      "layout": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "readOnly": true
          },
          "nome": {
            "type": "string",
            "description": "Nome do relatório"
          },
          "tenant": {
            "type": "integer",
            "description": "Identificador do tenant. Null para relatórios globais."
          },
          "layout": {
            "type": "string",
            "description": "Layout do relatório em string"
          },
          "parametros": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/parametro"
            }
          }
        }
      },
      "layouts": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/layout"
        }
      },
      "layout_post": {
        "type": "object",
        "required": [
          "nome",
          "layout"
        ],
        "properties": {
          "nome": {
            "type": "string",
            "description": "Nome do layout"
          },
          "tenant": {
            "type": "integer",
            "description": "Identificador do tenant. Null para layouts globais."
          },
          "layout": {
            "type": "string",
            "description": "Layout do relatório em string"
          },
          "parametros": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/relatorio_parametro"
            }
          }
        }
      },
      "report_post": {
        "type": "object",
        "required": [
          "tenant",
          "reportName",
          "format"
        ],
        "properties": {
          "reportName": {
            "type": "string",
            "description": "Nome do relatório"
          },
          "tenant": {
            "type": "integer",
            "description": "Identificador do tenant para achar o relatório."
          },
          "format": {
            "type": "string",
            "description": "Formato de exportação.",
            "enum": [
              "PDF",
              "XLSX",
              "HTML",
              "CSV",
              "DOCX"
            ]
          },
          "parameters": {
            "type": "object",
            "description": "Parâmetros do relatório em formato json."
          },
          "async": {
            "type": "boolean",
            "description": "Se true, retorna um jobId para consulta posterior. Se false ou omitido, retorna o relatório diretamente."
          },
          "dataset": {
            "type": "object",
            "description": "Objeto com informações do dataset para o relatório. Somente necessário se o relatório usar json como fonte de dados.",
            "properties": {
              "type": {
                "type": "string",
                "description": "Tipo da fonte do json para o relatório. Pode ser inline ou url.",
                "enum": [
                  "inline",
                  "url"
                ]
              },
              "content": {
                "type": "string",
                "description": "Conteúdo do dataset. Se datasetType for inline, é o json. Se for url, é a URL do json."
              }
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "OAuth2": [
        "offline_access"
      ]
    }
  ],
  "paths": {
    "/conexoes": {
      "get": {
        "tags": [
          "List Conexões"
        ],
        "description": "API para listagem das conexões.",
        "parameters": [
          {
            "name": "Authorization",
            "description": "Token gerado pelo OAuth 2",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tenant",
            "description": "Identificador do tenant",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/conexoes"
                }
              }
            }
          },
          "400": {
            "description": "Requisição inválida. Causa provável: faltando parâmetros obrigatórios (tenant)."
          },
          "401": {
            "description": "Proibido acesso. Causa provável: falha na autenticação."
          },
          "403": {
            "description": "Proibida ação. Causa provável: falha na autorização."
          },
          "500": {
            "description": "Erro interno do servidor. Ver detalhes no corpo da resposta."
          }
        }
      },
      "post": {
        "tags": [
          "Post Conexão"
        ],
        "description": "API para criação de uma conexão.",
        "parameters": [
          {
            "name": "Authorization",
            "description": "Token gerado pelo OAuth 2",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tenant",
            "description": "Identificador do tenant",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/conexao"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Criado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/conexao"
                }
              }
            }
          },
          "400": {
            "description": "Requisição inválida. Causa provável: faltando parâmetros obrigatórios (tenant)."
          },
          "401": {
            "description": "Proibido acesso. Causa provável: falha na autenticação."
          },
          "403": {
            "description": "Proibida ação. Causa provável: falha na autorização."
          },
          "500": {
            "description": "Erro interno do servidor. Ver detalhes no corpo da resposta."
          }
        }
      }
    },
    "/conexoes/{id}": {
      "get": {
        "tags": [
          "Get Conexão"
        ],
        "description": "API para recuperação de uma conexão no banco",
        "parameters": [
          {
            "name": "id",
            "description": "Id da conexão",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Authorization",
            "description": "Token gerado pelo OAuth 2",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tenant",
            "description": "Identificador do tenant",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/conexao"
                }
              }
            }
          },
          "400": {
            "description": "Requisição inválida. Causa provável: faltando parâmetros obrigatórios (tenant)."
          },
          "401": {
            "description": "Proibido acesso. Causa provável: falha na autenticação."
          },
          "403": {
            "description": "Proibida ação. Causa provável: falha na autorização."
          },
          "404": {
            "description": "Não encontrado. Causa provável: identificador não existente no estabelecimento/tenant."
          },
          "500": {
            "description": "Erro interno do servidor. Ver detalhes no corpo da resposta."
          }
        }
      },
      "put": {
        "tags": [
          "Put Conexão"
        ],
        "description": "API para atualização de uma conexão no banco",
        "parameters": [
          {
            "name": "id",
            "description": "Id da conexão",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Authorization",
            "description": "Token gerado pelo OAuth 2",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tenant",
            "description": "Identificador do tenant",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/conexao"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Sucesso. Sem conteúdo"
          },
          "400": {
            "description": "Requisição inválida. Causa provável: faltando parâmetros obrigatórios (tenant)."
          },
          "401": {
            "description": "Proibido acesso. Causa provável: falha na autenticação."
          },
          "403": {
            "description": "Proibida ação. Causa provável: falha na autorização."
          },
          "404": {
            "description": "Não encontrado. Causa provável: identificador não existente no estabelecimento/tenant."
          },
          "500": {
            "description": "Erro interno do servidor. Ver detalhes no corpo da resposta."
          }
        }
      },
      "delete": {
        "tags": [
          "Delete Conexão"
        ],
        "description": "API para remoção de uma conexão no banco",
        "parameters": [
          {
            "name": "id",
            "description": "Id da conexão",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Authorization",
            "description": "Token gerado pelo OAuth 2",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tenant",
            "description": "Identificador do tenant",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Sucesso. Sem conteúdo"
          },
          "400": {
            "description": "Requisição inválida. Causa provável: faltando parâmetros obrigatórios (tenant)."
          },
          "401": {
            "description": "Proibido acesso. Causa provável: falha na autenticação."
          },
          "403": {
            "description": "Proibida ação. Causa provável: falha na autorização."
          },
          "404": {
            "description": "Não encontrado. Causa provável: identificador não existente no estabelecimento/tenant."
          },
          "500": {
            "description": "Erro interno do servidor. Ver detalhes no corpo da resposta."
          }
        }
      }
    },
    "/consultas": {
      "get": {
        "tags": [
          "List Consultas"
        ],
        "description": "Lista todas as consultas, podendo filtrar por id_datasource.",
        "parameters": [
          {
            "name": "Authorization",
            "description": "Token gerado pelo OAuth 2",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id_datasource",
            "description": "Id do datasource para filtrar consultas",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/consultas"
                }
              }
            }
          },
          "401": {
            "description": "Proibido acesso. Falha na autenticação."
          },
          "403": {
            "description": "Proibida ação. Falha na autorização."
          },
          "500": {
            "description": "Erro interno do servidor."
          }
        }
      },
      "post": {
        "tags": [
          "Post Consulta"
        ],
        "description": "Cria uma nova consulta.",
        "parameters": [
          {
            "name": "Authorization",
            "description": "Token gerado pelo OAuth 2",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/consulta"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Criado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/consulta"
                }
              }
            }
          },
          "400": {
            "description": "Requisição inválida."
          },
          "401": {
            "description": "Proibido acesso. Falha na autenticação."
          },
          "403": {
            "description": "Proibida ação. Falha na autorização."
          },
          "500": {
            "description": "Erro interno do servidor."
          }
        }
      }
    },
    "/consultas/{id}": {
      "get": {
        "tags": [
          "Get Consulta"
        ],
        "description": "Recupera uma consulta pelo id.",
        "parameters": [
          {
            "name": "id",
            "description": "Id da consulta",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Authorization",
            "description": "Token gerado pelo OAuth 2",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/consulta"
                }
              }
            }
          },
          "401": {
            "description": "Proibido acesso. Falha na autenticação."
          },
          "403": {
            "description": "Proibida ação. Falha na autorização."
          },
          "404": {
            "description": "Não encontrado."
          },
          "500": {
            "description": "Erro interno do servidor."
          }
        }
      },
      "put": {
        "tags": [
          "Put Consulta"
        ],
        "description": "Atualiza uma consulta existente.",
        "parameters": [
          {
            "name": "id",
            "description": "Id da consulta",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Authorization",
            "description": "Token gerado pelo OAuth 2",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/consulta"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Sucesso. Sem conteúdo"
          },
          "400": {
            "description": "Requisição inválida."
          },
          "401": {
            "description": "Proibido acesso. Falha na autenticação."
          },
          "403": {
            "description": "Proibida ação. Falha na autorização."
          },
          "404": {
            "description": "Não encontrado."
          },
          "500": {
            "description": "Erro interno do servidor."
          }
        }
      },
      "delete": {
        "tags": [
          "Delete Consulta"
        ],
        "description": "Remove uma consulta pelo id.",
        "parameters": [
          {
            "name": "id",
            "description": "Id da consulta",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Authorization",
            "description": "Token gerado pelo OAuth 2",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Sucesso. Sem conteúdo"
          },
          "400": {
            "description": "Requisição inválida."
          },
          "401": {
            "description": "Proibido acesso. Falha na autenticação."
          },
          "403": {
            "description": "Proibida ação. Falha na autorização."
          },
          "404": {
            "description": "Não encontrado."
          },
          "500": {
            "description": "Erro interno do servidor."
          }
        }
      }
    },
    "/datasources-json": {
      "get": {
        "tags": [
          "List Datasources JSON"
        ],
        "description": "API para listagem dos datasources JSON.",
        "parameters": [
          {
            "name": "Authorization",
            "description": "Token gerado pelo OAuth 2",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tenant",
            "description": "Identificador do tenant",
