{
  "openapi": "3.1.0",
  "info": {
    "title": "VoiceFusion Public API",
    "version": "1.0.0",
    "description": "Public API for VoiceFusion integrations (Zapier, automation platforms). Authenticate with an API key generated in Dashboard > Integrations. Keys use the format: vf_live_<32 hex characters>.",
    "x-jentic-source-url": "https://voicefusion.com/api/v1/openapi.json"
  },
  "servers": [
    {
      "url": "https://voicefusion.com"
    }
  ],
  "paths": {
    "/api/v1/me": {
      "get": {
        "operationId": "getMe",
        "summary": "Auth test",
        "description": "Returns user info for the API key owner. Used as Zapier's authentication test endpoint.",
        "responses": {
          "200": {
            "description": "Authenticated user info",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id",
                    "email",
                    "business_name"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid",
                      "description": "User ID"
                    },
                    "email": {
                      "type": "string",
                      "format": "email"
                    },
                    "business_name": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Google Business Profile name, if set"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "User not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "user_not_found"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/hooks/subscribe": {
      "post": {
        "operationId": "subscribeHook",
        "summary": "Subscribe to webhook events",
        "description": "REST Hook subscribe endpoint. Creates a webhook subscription for the given event type. Idempotent: re-subscribing with the same (user, event, hookUrl) returns the existing subscription ID.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubscribeRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Subscription created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid",
                      "description": "Subscription ID (used for unsubscribe)"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/UnsupportedEventError"
                    }
                  ]
                },
                "examples": {
                  "invalid_body": {
                    "summary": "Malformed or missing fields",
                    "value": {
                      "error": "invalid_body"
                    }
                  },
                  "unsupported_event": {
                    "summary": "Event not in allowed list",
                    "value": {
                      "error": "unsupported_event",
                      "supported": [
                        "new_call",
                        "new_appointment",
                        "lead_captured"
                      ]
                    }
                  },
                  "invalid_hook_url": {
                    "summary": "URL is not HTTPS or resolves to private IP",
                    "value": {
                      "error": "invalid_hook_url"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/v1/hooks/{id}": {
      "delete": {
        "operationId": "unsubscribeHook",
        "summary": "Unsubscribe from webhook events",
        "description": "REST Hook unsubscribe endpoint. Deletes the subscription. Returns 404 if the subscription does not exist or belongs to a different user.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Subscription ID returned by subscribe"
          }
        ],
        "responses": {
          "204": {
            "description": "Subscription deleted"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Subscription not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "not_found"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/appointments": {
      "get": {
        "operationId": "listAppointments",
        "summary": "List recent appointments",
        "description": "Returns up to 50 recent appointments from the bookings table, newest first. Used as Zapier's performList for the new_appointment trigger. Returns an empty array if the user has no bookings. Note: the `action` field only returns `new` or `cancel` (derived from booking status); live webhooks may also send `change`.",
        "responses": {
          "200": {
            "description": "List of appointments (top-level array)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AppointmentEvent"
                  },
                  "maxItems": 50
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/v1/leads": {
      "get": {
        "operationId": "listLeads",
        "summary": "List lead samples",
        "description": "Returns hardcoded sample lead data. Used as Zapier's performList for the lead_captured trigger. Will be replaced with real data when a captured_leads table is added.",
        "responses": {
          "200": {
            "description": "List of leads (top-level array)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LeadCapturedEvent"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/v1/calls": {
      "get": {
        "operationId": "listCalls",
        "summary": "List recent calls",
        "description": "Returns up to 50 recent calls, newest first. Used as Zapier's performList for trigger sample data. Returns an empty array if the user has not completed setup.",
        "responses": {
          "200": {
            "description": "List of calls (top-level array)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Call"
                  },
                  "maxItems": 50
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "upstream_not_configured": {
                    "value": {
                      "error": "upstream_not_configured"
                    }
                  },
                  "internal_error": {
                    "value": {
                      "error": "internal_error"
                    }
                  }
                }
              }
            }
          },
          "502": {
            "description": "Upstream API failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "upstream_failure"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {
    "new_call": {
      "post": {
        "operationId": "onNewCall",
        "summary": "New call summary available",
        "description": "Posted to the subscriber's hookUrl when a call's AI-generated summary is ready. Content-Type: application/json. Single delivery, 10 second timeout, no retry.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Call"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Acknowledged"
          }
        }
      }
    },
    "new_appointment": {
      "post": {
        "operationId": "onNewAppointment",
        "summary": "Appointment created or changed",
        "description": "Posted to the subscriber's hookUrl when an appointment is created, changed, or cancelled during a call. Content-Type: application/json. Single delivery, 10 second timeout, no retry.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AppointmentEvent"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Acknowledged"
          }
        }
      }
    },
    "lead_captured": {
      "post": {
        "operationId": "onLeadCaptured",
        "summary": "Lead captured from call",
        "description": "Posted to the subscriber's hookUrl when a lead is captured from a call. Content-Type: application/json. Single delivery, 10 second timeout, no retry.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LeadCapturedEvent"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Acknowledged"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "API key (format: vf_live_<32 hex>). Generate in Dashboard > Integrations."
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing, malformed, or invalid API key",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "unauthorized"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "UnsupportedEventError": {
        "type": "object",
        "required": [
          "error",
          "supported"
        ],
        "properties": {
          "error": {
            "type": "string",
            "const": "unsupported_event"
          },
          "supported": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "SubscribeRequest": {
        "type": "object",
        "required": [
          "event",
          "hookUrl"
        ],
        "properties": {
          "event": {
            "type": "string",
            "enum": [
              "new_call",
              "new_appointment",
              "lead_captured"
            ],
            "description": "Event type to subscribe to"
          },
          "hookUrl": {
            "type": "string",
            "format": "uri",
            "description": "HTTPS URL to receive webhook payloads. Must not resolve to a private IP."
          }
        }
      },
      "Call": {
        "type": "object",
        "description": "Call record. Matches the SlimCall interface in call-transform.ts.",
        "required": [
          "id",
          "from",
          "to",
          "direction",
          "duration",
          "started_at"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "description": "VoiceFusion call ID",
            "example": 684777
          },
          "from": {
            "type": "string",
            "description": "Caller phone number",
            "example": "+14155551234"
          },
          "to": {
            "type": "string",
            "description": "Recipient phone number",
            "example": "+14155555678"
          },
          "direction": {
            "type": "string",
            "description": "Call direction",
            "example": "inbound"
          },
          "duration": {
            "type": "integer",
            "description": "Call duration in seconds. 0 means unanswered.",
            "example": 125
          },
          "started_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Call start time (ISO 8601), null for a call that was never answered and therefore never started",
            "example": "2026-06-08T10:30:00Z"
          },
          "ended_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Call end time, null if still in progress or unknown",
            "example": "2026-06-08T10:32:05Z"
          },
          "end_reason": {
            "type": [
              "string",
              "null"
            ],
            "description": "Reason the call ended",
            "example": "customer_ended_call"
          },
          "call_summary": {
            "type": [
              "string",
              "null"
            ],
            "description": "AI-generated call summary. Null when no summary has been generated yet.",
            "example": "Caller asked about business hours and pricing."
          }
        }
      },
      "AppointmentEvent": {
        "type": "object",
        "description": "Appointment webhook payload. Sent when an appointment is created, changed, or cancelled during a call.",
        "required": [
          "call_id",
          "appointment_datetime",
          "action",
          "updated_at"
        ],
        "properties": {
          "call_id": {
            "type": "string",
            "description": "Associated call ID"
          },
          "customer_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Customer name"
          },
          "customer_phone": {
            "type": [
              "string",
              "null"
            ],
            "description": "Customer phone number"
          },
          "customer_email": {
            "type": [
              "string",
              "null"
            ],
            "description": "Customer email"
          },
          "appointment_datetime": {
            "type": "string",
            "format": "date-time",
            "description": "Scheduled appointment time (ISO 8601)"
          },
          "call_summary": {
            "type": [
              "string",
              "null"
            ],
            "description": "AI-generated call summary"
          },
          "action": {
            "type": "string",
            "enum": [
              "new",
              "change",
              "cancel"
            ],
            "description": "Appointment action"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the appointment was last updated"
          },
          "call_outcome": {
            "type": [
              "string",
              "null"
            ],
            "description": "Reserved field (currently always null)"
          }
        }
      },
      "LeadCapturedEvent": {
        "type": "object",
        "description": "Lead captured webhook payload. Sent when a lead is captured from a completed call.",
        "required": [
          "call_id",
          "call_summary",
          "lead_intent"
        ],
        "properties": {
          "call_id": {
            "type": "string",
            "description": "Associated call ID"
          },
          "customer_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Customer name"
          },
          "customer_phone": {
            "type": [
              "string",
              "null"
            ],
            "description": "Customer phone number"
          },
          "customer_email": {
            "type": [
              "string",
              "null"
            ],
            "description": "Customer email"
          },
          "call_start_time": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Call start time (ISO 8601)"
          },
          "call_summary": {
            "type": "string",
            "description": "AI-generated call summary"
          },
          "call_outcome": {
            "type": [
              "string",
              "null"
            ],
            "description": "Call outcome classification"
          },
          "lead_intent": {
            "type": "string",
            "description": "Comma-separated intent labels from Lead Intent Rules"
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}