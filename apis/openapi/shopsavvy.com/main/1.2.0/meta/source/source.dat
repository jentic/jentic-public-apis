{"openapi":"3.0.3","info":{"title":"ShopSavvy Data API","version":"1.2.0","description":"Product details, real-time pricing, price history, deals, and expert reviews for millions of products across tens of thousands of retailers. Look up by barcode, UPC/EAN, ASIN, model number, MPN, URL, or product name. JSON or CSV responses, with official SDKs in 10 languages.","contact":{"email":"support@shopsavvy.com","url":"https://shopsavvy.com/data"},"termsOfService":"https://shopsavvy.com/terms-of-use"},"servers":[{"url":"https://api.shopsavvy.com/v1","description":"Production"}],"security":[{"BearerAuth":[]}],"components":{"securitySchemes":{"BearerAuth":{"type":"http","scheme":"bearer","description":"API key from shopsavvy.com/data/api-keys"}},"schemas":{"Meta":{"type":"object","properties":{"request_id":{"type":"string"},"credits_used":{"type":"integer"},"credits_remaining":{"type":"integer"},"rate_limit_remaining":{"type":"integer"}}},"ErrorResponse":{"type":"object","properties":{"success":{"type":"boolean","example":false},"error":{"type":"string"},"error_detail":{"type":"object","properties":{"code":{"type":"string"},"message":{"type":"string"},"action":{"type":"string"},"docs_url":{"type":"string"}}},"meta":{"$ref":"#/components/schemas/Meta"}}},"Score":{"type":"object","description":"Expert quality scores on a 0-1 scale. `aspects` is keyed by free-form aspect names drawn from the product's professional reviews (e.g. value, features, reliability, quality) — the set of aspects varies per product. Only populated fields are included.","properties":{"overall":{"type":"number","minimum":0,"maximum":1},"customer":{"type":"number","minimum":0,"maximum":1},"professional":{"type":"number","minimum":0,"maximum":1},"aspects":{"type":"object","additionalProperties":{"type":"number","minimum":0,"maximum":1}}}},"Product":{"type":"object","properties":{"title":{"type":"string"},"shopsavvy":{"type":"string"},"brand":{"type":"string"},"category":{"type":"string"},"images":{"type":"array","items":{"type":"string"}},"barcode":{"type":"string"},"amazon":{"type":"string"},"model":{"type":"string"},"mpn":{"type":"string"},"color":{"type":"string"},"title_short":{"type":"string"},"slug":{"type":"string"},"description":{"type":"string"},"categories":{"type":"array","items":{"type":"string"}},"attributes":{"type":"object","additionalProperties":{"type":"string"}},"rating":{"type":"object","properties":{"value":{"type":"number"},"count":{"type":"integer"}}},"score":{"$ref":"#/components/schemas/Score"},"keywords":{"type":"array","items":{"type":"string"}},"identifiers":{"type":"object","additionalProperties":{}},"match":{"type":"object","description":"How the identifier you sent matched this product. See noun-api-product-match.ts.","properties":{"identifier":{"type":"string","description":"The identifier exactly as sent."},"by":{"type":"string","enum":["barcode","shopsavvy_id","asin","url","model","mpn","name"],"description":"Which field matched. Everything except `name` is an exact match; `name` is a full-text best guess."},"candidates":{"type":"integer","description":"How many products matched on that field. More than 1 means the identifier is shared and the best-evidence product was returned."}}}}},"Offer":{"type":"object","properties":{"id":{"type":"string"},"retailer":{"type":"string"},"price":{"type":"number"},"currency":{"type":"string","description":"ISO currency code. Always 'USD' today — offer endpoints currently serve USD-denominated offers only."},"availability":{"type":"string"},"condition":{"type":"string"},"condition_grade":{"type":"string","nullable":true,"description":"Finer grade alongside condition, e.g. 'open-box', 'refurbished-excellent', 'used-like-new'. null when the source did not grade it."},"URL":{"type":"string"},"seller":{"type":"string"},"is_marketplace":{"type":"boolean","nullable":true,"description":"true = sold by a third-party marketplace seller (see seller), false = sold by the retailer itself, null = the source did not say."},"timestamp":{"type":"string"}}},"Deal":{"type":"object","properties":{"path":{"type":"string"},"title":{"type":"string"},"subtitle":{"type":"string"},"description":{"type":"string"},"emoji":{"type":"string"},"grade":{"type":"object","properties":{"letter":{"type":"string"},"suffix":{"type":"string"},"value":{"type":"number"},"justification":{"type":"string"}}},"pricing":{"type":"object","properties":{"current":{"type":"number"},"original":{"type":"number"},"currency":{"type":"string"}}},"retailer":{"type":"object","properties":{"name":{"type":"string"}}},"url":{"type":"string"},"votes":{"type":"object","properties":{"upvotes":{"type":"integer"},"downvotes":{"type":"integer"},"score":{"type":"integer"}}},"comment_count":{"type":"integer"},"created_at":{"type":"string"}}},"TLDRReview":{"type":"object","properties":{"slug":{"type":"string"},"headline":{"type":"string"},"pros":{"type":"array","items":{"type":"string"}},"cons":{"type":"array","items":{"type":"string"}},"bottom_line":{"type":"string"},"scores":{"$ref":"#/components/schemas/Score"}}},"Webhook":{"type":"object","properties":{"id":{"type":"string"},"url":{"type":"string"},"events":{"type":"array","items":{"type":"string"}},"is_active":{"type":"boolean"},"secret":{"type":"string","description":"Only returned on creation"},"created_at":{"type":"string"}}}}},"paths":{"/products":{"get":{"summary":"Look up product details","description":"Retrieve product details by identifier (barcode, ASIN, URL, model number).","parameters":[{"name":"ids","in":"query","required":true,"schema":{"type":"string"},"description":"Product identifier(s), comma-separated"},{"name":"format","in":"query","schema":{"type":"string","enum":["json","csv"]}}],"responses":{"200":{"description":"Product details","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"data":{"type":"array","items":{"$ref":"#/components/schemas/Product"}},"meta":{"$ref":"#/components/schemas/Meta"}}}}}},"400":{"description":"Invalid parameters","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"404":{"description":"Product not found"}},"tags":["Products"]}},"/products/search":{"get":{"summary":"Search products by keyword","parameters":[{"name":"q","in":"query","required":true,"schema":{"type":"string"}},{"name":"limit","in":"query","schema":{"type":"integer","default":10}},{"name":"offset","in":"query","schema":{"type":"integer","default":0}},{"name":"format","in":"query","schema":{"type":"string","enum":["json","csv"]}}],"responses":{"200":{"description":"Search results"}},"tags":["Products"]}},"/products/offers":{"get":{"summary":"Get current prices from all retailers","description":"Returns USD-denominated offers only. Offers mined in other currencies (GBP, EUR, CAD, AUD and ~40 more) exist but are not served by this endpoint and there is no parameter to request them, so an empty `offers` array can mean either \"no offers on file\" or \"no USD offers on file\". Offers our product-match validation flagged as invalid, and offers from unknown/untrusted-source retailers, are excluded.","parameters":[{"name":"ids","in":"query","required":true,"schema":{"type":"string"}},{"name":"retailer","in":"query","schema":{"type":"string"},"description":"Filter by retailer domain"},{"name":"format","in":"query","schema":{"type":"string","enum":["json","csv"]}}],"responses":{"200":{"description":"Offers from retailers"}},"tags":["Pricing"]}},"/products/offers/history":{"get":{"summary":"Get historical price data","description":"Returns USD-denominated offers and USD history points only; there is no currency parameter (see /products/offers). eBay listings never carry history. Points are quality-filtered to the same series the ShopSavvy price chart renders. The window may span at most 366 days.","parameters":[{"name":"ids","in":"query","required":true,"schema":{"type":"string"}},{"name":"start","in":"query","required":true,"schema":{"type":"string","format":"date"}},{"name":"end","in":"query","required":true,"schema":{"type":"string","format":"date"}},{"name":"retailer","in":"query","schema":{"type":"string"}},{"name":"format","in":"query","schema":{"type":"string","enum":["json","csv"]}}],"responses":{"200":{"description":"Price history data"}},"tags":["Pricing"]}},"/products/reviews":{"get":{"summary":"Get TLDR review for a product","description":"Returns expert review summary with pros, cons, bottom line, and scores.","parameters":[{"name":"id","in":"query","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Review data","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"product":{"type":"object"},"review":{"$ref":"#/components/schemas/TLDRReview"},"meta":{"$ref":"#/components/schemas/Meta"}}}}}}},"tags":["Reviews"]}},"/products/batch":{"post":{"summary":"Batch product lookup","description":"Look up multiple products at once. Sync for <=20, async for >20.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["identifiers"],"properties":{"identifiers":{"type":"array","items":{"type":"string"},"maxItems":100},"include":{"type":"array","items":{"type":"string","enum":["offers","reviews"]}}}}}}},"responses":{"200":{"description":"Batch results (sync)"},"202":{"description":"Batch job created (async)"}},"tags":["Batch"]}},"/batch/{batchId}":{"get":{"summary":"Poll batch job status","parameters":[{"name":"batchId","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Batch status and results"}},"tags":["Batch"]}},"/products/scheduled":{"get":{"summary":"List scheduled products","responses":{"200":{"description":"Scheduled products"}},"tags":["Scheduling"]},"put":{"summary":"Schedule product monitoring","parameters":[{"name":"ids","in":"query","required":true,"schema":{"type":"string"}},{"name":"schedule","in":"query","required":true,"schema":{"type":"string","enum":["hourly","daily","weekly"]}}],"responses":{"200":{"description":"Scheduling confirmation"}},"tags":["Scheduling"]},"delete":{"summary":"Remove product from schedule","parameters":[{"name":"ids","in":"query","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Removal confirmation"}},"tags":["Scheduling"]}},"/deals":{"get":{"summary":"Browse shopping deals","description":"Get curated deals with expert grades, community votes, and filtering.","parameters":[{"name":"sort","in":"query","schema":{"type":"string","enum":["hot","new","top-hour","top-day","top-week"],"default":"hot"}},{"name":"limit","in":"query","schema":{"type":"integer","default":25,"maximum":100}},{"name":"offset","in":"query","schema":{"type":"integer","default":0}},{"name":"category","in":"query","schema":{"type":"string"}},{"name":"retailer","in":"query","schema":{"type":"string"}},{"name":"grade","in":"query","schema":{"type":"string","enum":["A","B","C","D"]}},{"name":"min_price","in":"query","schema":{"type":"number"}},{"name":"max_price","in":"query","schema":{"type":"number"}}],"responses":{"200":{"description":"Deals feed","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"deals":{"type":"array","items":{"$ref":"#/components/schemas/Deal"}},"pagination":{"type":"object"},"meta":{"$ref":"#/components/schemas/Meta"}}}}}}},"tags":["Deals"]}},"/webhooks":{"get":{"summary":"List webhooks","responses":{"200":{"description":"User webhooks"}},"tags":["Webhooks"]},"post":{"summary":"Create a webhook","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["url","events"],"properties":{"url":{"type":"string"},"events":{"type":"array","items":{"type":"string","enum":["price_drop","availability_change","schedule_completion"]}}}}}}},"responses":{"201":{"description":"Webhook created (includes secret)"}},"tags":["Webhooks"]}},"/webhooks/{webhookId}":{"put":{"summary":"Update a webhook","parameters":[{"name":"webhookId","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Updated"}},"tags":["Webhooks"]},"delete":{"summary":"Delete a webhook","parameters":[{"name":"webhookId","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Deleted"}},"tags":["Webhooks"]}},"/webhooks/{webhookId}/test":{"post":{"summary":"Send test webhook","parameters":[{"name":"webhookId","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Test result"}},"tags":["Webhooks"]}},"/usage":{"get":{"summary":"Get API usage statistics","responses":{"200":{"description":"Usage info"}},"tags":["Analytics"]}}},"tags":[{"name":"Products","description":"Product details and search"},{"name":"Pricing","description":"Offers and price history"},{"name":"Deals","description":"Shopping deals feed"},{"name":"Reviews","description":"Expert product reviews"},{"name":"Batch","description":"Batch product lookups"},{"name":"Scheduling","description":"Product monitoring"},{"name":"Webhooks","description":"Event notifications"},{"name":"Analytics","description":"Usage statistics"}]}