{
  "openapi": "3.1.0",
  "info": {
    "title": "AddressIntel Peninsula Entitlement API",
    "description": "Parcel-level entitlement math for the Silicon Valley Peninsula and South Bay: SB 9 status, ADU yield and FAR headroom per lot, each carrying the municipal code section it came from, the date that section was read and a confidence rating, joined to building permits, listings and comparable sales. Coverage is regional by design, not national.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://addressintel.co/api",
      "description": "Production Server"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/v1/sb9-inventory": {
      "get": {
        "summary": "List SB 9 Inventory",
        "description": "Active listings that screen eligible or likely for an SB 9 lot split or duplex, ranked by maximum units then teardown score. Blocked lots are not returned; the screen's reasoning comes back in sb9.blockReasons.",
        "operationId": "listSb9Inventory",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "description": "Filter to 'eligible' or 'likely'. Defaults to 'any', meaning any non-blocked lot.",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "minUnits",
            "in": "query",
            "description": "Only lots whose SB 9 maximum reaches this unit count.",
            "required": false,
            "schema": { "type": "integer" }
          },
          {
            "name": "excludeBlockers",
            "in": "query",
            "description": "'true' drops any lot carrying a known development blocker.",
            "required": false,
            "schema": { "type": "string" }
          },
        {
          "name": "limit",
          "in": "query",
          "description": "Page size. Capped to your plan's maximum (demo 5, free 25, pro 500).",
          "required": false,
          "schema": { "type": "integer" }
        },
        {
          "name": "offset",
          "in": "query",
          "description": "Number of results to skip for pagination.",
          "required": false,
          "schema": { "type": "integer" }
        }
        ],
      "responses": {
        "200": {
          "description": "Successful response containing SB 9-eligible inventory.",
          "headers": {
            "X-RateLimit-Limit": { "$ref": "#/components/headers/X-RateLimit-Limit" },
            "X-RateLimit-Remaining": { "$ref": "#/components/headers/X-RateLimit-Remaining" }
          },
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "success": { "type": "boolean" },
                  "count": { "type": "integer" },
                  "data": { "type": "array", "items": { "$ref": "#/components/schemas/Sb9Lead" } },
                  "pagination": { "$ref": "#/components/schemas/Pagination" },
                  "asOf": { "type": "string", "format": "date-time", "description": "When the returned data was current." }
                }
              }
            }
          }
        },
        "401": { "$ref": "#/components/responses/Unauthorized" },
        "429": { "$ref": "#/components/responses/RateLimited" }
      }
      }
    },
    "/v1/redevelopment-leads": {
      "get": {
        "summary": "List Redevelopment Leads",
        "description": "Underbuilt lots: small, older houses using a low share of the floor area their zoning allows. Each result carries buildableHeadroomSqft plus the code section, as-of date and confidence behind the envelope.",
        "operationId": "listRedevelopmentLeads",
        "parameters": [
          {
            "name": "minScore",
            "in": "query",
            "description": "Minimum redevelopment score, 0 to 100. Defaults to 60.",
            "required": false,
            "schema": { "type": "integer" }
          },
          {
            "name": "class",
            "in": "query",
            "description": "Filter to 'teardown_candidate' or 'expansion'.",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "excludeBlockers",
            "in": "query",
            "description": "'true' drops any lot carrying a known development blocker.",
            "required": false,
            "schema": { "type": "string" }
          },
        {
          "name": "limit",
          "in": "query",
          "description": "Page size. Capped to your plan's maximum (demo 5, free 25, pro 500).",
          "required": false,
          "schema": { "type": "integer" }
        },
        {
          "name": "offset",
          "in": "query",
          "description": "Number of results to skip for pagination.",
          "required": false,
          "schema": { "type": "integer" }
        }
        ],
      "responses": {
        "200": {
          "description": "Successful response containing underbuilt redevelopment leads.",
          "headers": {
            "X-RateLimit-Limit": { "$ref": "#/components/headers/X-RateLimit-Limit" },
            "X-RateLimit-Remaining": { "$ref": "#/components/headers/X-RateLimit-Remaining" }
          },
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "success": { "type": "boolean" },
                  "count": { "type": "integer" },
                  "data": { "type": "array", "items": { "$ref": "#/components/schemas/RedevelopmentLead" } },
                  "pagination": { "$ref": "#/components/schemas/Pagination" },
                  "asOf": { "type": "string", "format": "date-time", "description": "When the returned data was current." }
                }
              }
            }
          }
        },
        "401": { "$ref": "#/components/responses/Unauthorized" },
        "429": { "$ref": "#/components/responses/RateLimited" }
      }
      }
    },
    "/v1/adu-leads": {
      "get": {
        "summary": "List ADU Leads",
        "description": "Lots ranked by ADU feasibility, with estimated unit count, buildable square footage and the lot geometry the estimate rests on.",
        "operationId": "listAduLeads",
        "parameters": [
          {
            "name": "minScore",
            "in": "query",
            "description": "Minimum ADU feasibility score, 0 to 100. Defaults to 60.",
            "required": false,
            "schema": { "type": "integer" }
          },
          {
            "name": "excludeBlockers",
            "in": "query",
            "description": "'true' drops any lot carrying a known development blocker.",
            "required": false,
            "schema": { "type": "string" }
          },
        {
          "name": "limit",
          "in": "query",
          "description": "Page size. Capped to your plan's maximum (demo 5, free 25, pro 500).",
          "required": false,
          "schema": { "type": "integer" }
        },
        {
          "name": "offset",
          "in": "query",
          "description": "Number of results to skip for pagination.",
          "required": false,
          "schema": { "type": "integer" }
        }
        ],
      "responses": {
        "200": {
          "description": "Successful response containing ADU-yield leads.",
          "headers": {
            "X-RateLimit-Limit": { "$ref": "#/components/headers/X-RateLimit-Limit" },
            "X-RateLimit-Remaining": { "$ref": "#/components/headers/X-RateLimit-Remaining" }
          },
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "success": { "type": "boolean" },
                  "count": { "type": "integer" },
                  "data": { "type": "array", "items": { "$ref": "#/components/schemas/AduLead" } },
                  "pagination": { "$ref": "#/components/schemas/Pagination" },
                  "asOf": { "type": "string", "format": "date-time", "description": "When the returned data was current." }
                }
              }
            }
          }
        },
        "401": { "$ref": "#/components/responses/Unauthorized" },
        "429": { "$ref": "#/components/responses/RateLimited" }
      }
      }
    },
    "/v1/market-signals": {
      "get": {
        "summary": "List Market Signals",
        "description": "Retrieves top investment opportunities scored by our proprietary engine. Properties are scored on teardown potential, flippability, and more.",
        "operationId": "listMarketSignals",
        "parameters": [
          {
            "name": "market",
            "in": "query",
            "description": "Filter by market ('sf-peninsula' or 'nantucket'). Defaults to 'sf-peninsula'.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "city",
            "in": "query",
            "description": "Filter by city name (e.g., 'Atherton')",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "address",
            "in": "query",
            "description": "Search for a specific address",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Page size. Capped to your plan's maximum (demo 5, free 25, pro 500).",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Number of results to skip for pagination.",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response containing a list of scored properties.",
            "headers": {
              "X-RateLimit-Limit": { "$ref": "#/components/headers/X-RateLimit-Limit" },
              "X-RateLimit-Remaining": { "$ref": "#/components/headers/X-RateLimit-Remaining" }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "count": { "type": "integer" },
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/PropertySignal" }
                    },
                    "pagination": { "$ref": "#/components/schemas/Pagination" },
                    "asOf": {
                      "type": "string",
                      "format": "date-time",
                      "description": "When the returned data was current."
                    }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/v1/properties/{id}": {
      "get": {
        "summary": "Get Property Intelligence",
        "description": "Retrieves detailed intelligence for a single property, including aggregated comp data and proprietary scores. (Free Tier)",
        "operationId": "getPropertyIntelligence",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The unique identifier of the property",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response containing property details and intelligence.",
            "headers": {
              "X-RateLimit-Limit": { "$ref": "#/components/headers/X-RateLimit-Limit" },
              "X-RateLimit-Remaining": { "$ref": "#/components/headers/X-RateLimit-Remaining" }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "data": { "$ref": "#/components/schemas/PropertyDetail" },
                    "asOf": { "type": "string", "format": "date-time" }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": {
            "description": "Property not found.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/v1/keys": {
      "post": {
        "summary": "Create a Free API Key",
        "description": "Self-serve issuance of a free-tier API key. The key is emailed to the address supplied and is NOT returned in the response body. Limited to 5 keys per day per IP and 3 per day per email address.",
        "operationId": "createKey",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email"],
                "properties": { "email": { "type": "string", "format": "email" } }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A new free-tier key was minted and emailed to the address supplied.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "tier": { "type": "string", "example": "free" },
                    "message": { "type": "string", "example": "Check your email. Your free API key is on its way." }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "502": {
            "description": "The key could not be emailed to that address.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      }
    },
    "/v1/subscribe": {
      "post": {
        "summary": "Subscribe to Market Briefings",
        "description": "Add an email to a market's newsletter list.",
        "operationId": "subscribe",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email"],
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "source": { "type": "string" },
                  "market": { "type": "string", "example": "sf-peninsula" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Subscribed.",
            "content": {
              "application/json": {
                "schema": { "type": "object", "properties": { "success": { "type": "boolean" } } }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/v1/webhooks/register": {
      "post": {
        "summary": "Register a Webhook (Pro)",
        "description": "Register an HTTPS endpoint to receive real-time events. Requires a Pro API key. Returns a per-endpoint signingSecret used to verify the X-AddressIntel-Signature header.",
        "operationId": "registerWebhook",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["url"],
                "properties": {
                  "url": { "type": "string", "format": "uri", "description": "HTTPS endpoint." },
                  "events": {
                    "type": "array",
                    "items": { "type": "string", "enum": ["permit.created", "property.score_updated"] }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Webhook registered.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "registeredUrl": { "type": "string" },
                    "events": { "type": "array", "items": { "type": "string" } },
                    "signingSecret": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": {
            "description": "Webhooks require a Pro plan.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      }
    },
    "headers": {
      "X-RateLimit-Limit": {
        "description": "Requests allowed per minute for your plan.",
        "schema": { "type": "integer" }
      },
      "X-RateLimit-Remaining": {
        "description": "Requests remaining in the current window.",
        "schema": { "type": "integer" }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing or invalid API key.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "BadRequest": {
        "description": "Invalid request.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "RateLimited": {
        "description": "Rate limit exceeded.",
        "headers": {
          "X-RateLimit-Limit": { "$ref": "#/components/headers/X-RateLimit-Limit" },
          "X-RateLimit-Remaining": { "$ref": "#/components/headers/X-RateLimit-Remaining" }
        },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      }
    },
    "schemas": {
      "Sb9Lead": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "address": { "type": "string" },
          "city": { "type": "string" },
          "zip": { "type": "string" },
          "price": { "type": "number" },
          "status": { "type": "string" },
          "teardownScore": { "type": "number" },
          "sb9": {
            "type": "object",
            "properties": {
              "status": { "type": "string", "description": "'eligible' or 'likely'. Blocked and not-applicable lots are not returned." },
              "maxUnits": { "type": "integer", "description": "Maximum units the SB 9 screen allows on the lot." },
              "blockReasons": { "type": "array", "items": { "type": "string" } }
            }
          },
          "lotSqft": { "type": "number" },
          "zoning": { "type": "string" },
          "developmentBlockers": { "type": "array", "items": { "type": "string" } },
          "unlockPathways": { "type": "array", "items": { "type": "string" } },
          "entitlementRiskScore": { "type": "number" }
        }
      },
      "RedevelopmentLead": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "address": { "type": "string" },
          "city": { "type": "string" },
          "zip": { "type": "string" },
          "price": { "type": "number" },
          "status": { "type": "string" },
          "livingSqft": { "type": "number" },
          "yearBuilt": { "type": "integer" },
          "redevelopment": {
            "type": "object",
            "properties": {
              "score": { "type": "number" },
              "class": { "type": "string", "description": "'teardown_candidate' or 'expansion'." },
              "farUtilizationPct": { "type": "number", "description": "Share of the allowable floor area the standing structure uses." },
              "buildableHeadroomSqft": { "type": "number", "description": "Allowable floor area less what is standing today." },
              "allowableFloorAreaSqft": { "type": "number" },
              "ruleSource": { "type": "string", "description": "The municipal code section the envelope was derived from." },
              "ruleAsOf": { "type": "string", "description": "Date that code section was last read." },
              "ruleConfidence": { "type": "string" }
            }
          },
          "lotSqft": { "type": "number" },
          "zoning": { "type": "string" },
          "sb9Status": { "type": "string" },
          "developmentBlockers": { "type": "array", "items": { "type": "string" } },
          "unlockPathways": { "type": "array", "items": { "type": "string" } }
        }
      },
      "AduLead": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "address": { "type": "string" },
          "city": { "type": "string" },
          "zip": { "type": "string" },
          "price": { "type": "number" },
          "status": { "type": "string" },
          "adu": {
            "type": "object",
            "properties": {
              "feasibilityScore": { "type": "number" },
              "maxUnits": { "type": "integer" },
              "estSqft": { "type": "number" },
              "existingCoveragePct": { "type": "number" }
            }
          },
          "lot": {
            "type": "object",
            "properties": {
              "shape": { "type": "string" },
              "frontageFt": { "type": "number" },
              "depthFt": { "type": "number" },
              "aspectRatio": { "type": "number" },
              "cornerLot": { "type": "boolean" },
              "streetFrontages": { "type": "integer" }
            }
          },
          "lotSqft": { "type": "number" },
          "zoning": { "type": "string" },
          "developmentBlockers": { "type": "array", "items": { "type": "string" } },
          "unlockPathways": { "type": "array", "items": { "type": "string" } },
          "entitlementRiskScore": { "type": "number" }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "error": { "type": "string", "description": "Human-readable message." },
          "code": {
            "type": "string",
            "enum": ["unauthorized", "forbidden", "rate_limited", "not_found", "bad_request", "internal_error"]
          }
        }
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "limit": { "type": "integer" },
          "offset": { "type": "integer" },
          "total": { "type": "integer" },
          "returned": { "type": "integer" },
          "nextOffset": { "type": "integer", "nullable": true }
        }
      },
      "PropertySignal": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "zip": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "propertyType": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "teardownScore": {
            "type": "number",
            "description": "0-100 probability that the property is a teardown."
          },
          "flippabilityScore": {
            "type": "number",
            "description": "0-100 score indicating renovation potential."
          },
          "conditionScore": {
            "type": "number",
            "nullable": true,
            "description": "0-100 estimated condition of the existing structure."
          },
          "visionAnalysis": {
            "type": "string",
            "nullable": true,
            "description": "Qualitative briefing on the development play. Never states a return figure; the numbers come from `proforma`."
          },
          "proformaROI": {
            "type": "number",
            "nullable": true,
            "description": "Return on total project cost, as a percentage, for a raze-and-rebuild of this parcel. Replaced `developerROI` on 2026-08-18. Deterministic arithmetic over recent comparable sales, not a model estimate: the same computation the property page shows, so the API and the site cannot disagree. `null` means the deal is not modellable and the reason is in `proforma.unmodellableReason`; it is never a substituted default and must not be read as zero."
          },
          "proforma": {
            "type": "object",
            "nullable": true,
            "description": "The full working behind `proformaROI`, so a caller can reproduce it rather than take it on trust. `null` when the parcel cannot be priced.",
            "properties": {
              "roiPct": {
                "type": "number",
                "description": "Same value as the top-level `proformaROI`."
              },
              "buildSqft": {
                "type": "number",
                "description": "Assumed size of the replacement house."
              },
              "arvPerSqft": {
                "type": "number",
                "description": "After-repair value per square foot, the median of the selected comparable sales."
              },
              "capital": {
                "type": "number",
                "description": "All-in project cost: purchase price + demolition + hard costs + soft costs."
              },
              "resaleNet": {
                "type": "number",
                "description": "Projected resale proceeds, net of the cost of sale."
              },
              "compCount": {
                "type": "integer",
                "description": "How many comparable sales the ARV is drawn from."
              },
              "compsCityMatched": {
                "type": "boolean",
                "description": "Whether the comps came from the same city rather than a wider fallback."
              },
              "compsTypeMatched": {
                "type": "boolean",
                "description": "Whether the comps matched on property type."
              },
              "unmodellableReason": {
                "type": "string",
                "nullable": true,
                "description": "Which input was missing when `roiPct` is null, e.g. no usable build size or too few comps."
              },
              "assumptions": {
                "type": "object",
                "description": "The constants used, published so the arithmetic can be re-run or re-priced at a different cost.",
                "properties": {
                  "costPerSqft": {
                    "type": "number",
                    "description": "Hard cost per square foot. The midpoint of the verified $400-$700 SF Peninsula builder band, not a retail general-contractor quote."
                  },
                  "softCosts": {
                    "type": "number",
                    "description": "Flat soft-cost allowance in dollars."
                  },
                  "demoCost": {
                    "type": "number",
                    "description": "Flat demolition allowance in dollars."
                  },
                  "sellingCostPct": {
                    "type": "number",
                    "description": "Cost of sale, as a percentage of resale."
                  },
                  "buildSizeBasis": {
                    "type": "string",
                    "description": "How buildSqft was derived."
                  }
                }
              }
            }
          },
          "metadata": {
            "type": "object",
            "properties": {
              "bedrooms": {
                "type": "number",
                "nullable": true
              },
              "bathrooms": {
                "type": "number",
                "nullable": true
              },
              "sqft": {
                "type": "number"
              },
              "lotSize": {
                "type": "number"
              },
              "latitude": {
                "type": "number",
                "nullable": true
              },
              "longitude": {
                "type": "number",
                "nullable": true
              },
              "daysOnMarket": {
                "type": "number"
              }
            }
          }
        }
      },
      "PropertyDetail": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "intelligence": {
            "type": "object",
            "properties": {
              "teardownScore": {
                "type": "number"
              },
              "flippabilityScore": {
                "type": "number"
              },
              "marketHeatIndex": {
                "type": "number"
              },
              "biddingWarPredictor": {
                "type": "number"
              }
            }
          },
          "comparables": {
            "type": "object",
            "properties": {
              "recentSalesCount": {
                "type": "integer"
              },
              "avgPricePerSqft": {
                "type": "number"
              }
            }
          }
        }
      }
    }
  }
}
