istic concurrency","security":[{"IntegrationCredential":[]},{"ClerkOAuth":["calls:write"]}],"parameters":[{"$ref":"#/components/parameters/IdempotencyKey"},{"$ref":"#/components/parameters/IfMatch"}],"responses":{"200":{"description":"Cancelled","content":{"application/json":{"schema":{"type":"object","required":["request_id","call","idempotent_replay"],"properties":{"request_id":{"type":"string"},"call":{"$ref":"#/components/schemas/Call"},"idempotent_replay":{"type":"boolean"}}}}}},"default":{"$ref":"#/components/responses/Error"}}}}},"components":{"securitySchemes":{"IntegrationCredential":{"type":"http","scheme":"bearer","bearerFormat":"stcm_test_* or stcm_live_*"},"ClerkOAuth":{"type":"oauth2","flows":{"authorizationCode":{"authorizationUrl":"https://ready-hyena-1542.clerk.accounts.dev/oauth/authorize","tokenUrl":"https://ready-hyena-1542.clerk.accounts.dev/oauth/token","scopes":{"calls:read":"Read masked calls and outcomes","calls:write":"Create, reschedule, and cancel calls","phones:read":"Read masked phones and caller-ID state"}}}}},"parameters":{"IdempotencyKey":{"in":"header","name":"Idempotency-Key","required":true,"schema":{"type":"string","minLength":16,"maxLength":128}},"IfMatch":{"in":"header","name":"If-Match","required":true,"description":"Current integer row_version returned by the API.","schema":{"type":"string","example":"2"}}},"responses":{"Error":{"description":"Stable error envelope","content":{"application/json":{"schema":{"type":"object","required":["error"],"properties":{"error":{"type":"object","required":["code","message","request_id","details"],"properties":{"code":{"type":"string"},"message":{"type":"string"},"request_id":{"type":"string"},"details":{"type":"object","additionalProperties":true}}}}}}}}},"schemas":{"Error":{"type":"object","required":["error"],"properties":{"error":{"type":"object","required":["code","message","request_id","details"],"properties":{"code":{"type":"string"},"message":{"type":"string"},"request_id":{"type":"