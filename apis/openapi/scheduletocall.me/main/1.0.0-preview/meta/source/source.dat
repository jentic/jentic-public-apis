{"openapi":"3.1.0","info":{"title":"Schedule to Call Me Integration API","version":"1.0.0-preview","description":"Tenant-scoped callback scheduling API. Phone values in responses are always masked; internal fields are never exposed."},"servers":[{"url":"https://scheduletocall.me","description":"Canonical application origin"},{"url":"https://schedule-to-call-me-preview.elad-rave-scm.workers.dev","description":"Development preview"}],"security":[{"IntegrationCredential":[]},{"ClerkOAuth":["calls:read"]}],"paths":{"/api/v1/integration/phones":{"get":{"operationId":"listCallbackPhones","summary":"List masked verified callback phones and caller-ID approval state","security":[{"IntegrationCredential":[]},{"ClerkOAuth":["phones:read"]}],"responses":{"200":{"description":"Masked phone inventory","content":{"application/json":{"schema":{"type":"object","properties":{"request_id":{"type":"string"},"phone_identities":{"type":"array","items":{"$ref":"#/components/schemas/PhoneIdentity"}}},"required":["request_id","phone_identities"]}}}},"default":{"$ref":"#/components/responses/Error"}}}},"/api/v1/integration/calls":{"get":{"operationId":"listCalls","summary":"List masked calls","security":[{"IntegrationCredential":[]},{"ClerkOAuth":["calls:read"]}],"parameters":[{"in":"query","name":"limit","schema":{"type":"integer","minimum":1,"maximum":50,"default":25}},{"in":"query","name":"status","schema":{"type":"string"}}],"responses":{"200":{"description":"Bounded call page","content":{"application/json":{"schema":{"type":"object","properties":{"request_id":{"type":"string"},"calls":{"type":"array","items":{"$ref":"#/components/schemas/Call"}},"next_cursor":{"type":["string","null"]}},"required":["request_id","calls","next_cursor"]}}}},"default":{"$ref":"#/components/responses/Error"}}},"post":{"operationId":"createScheduledCall","summary":"Create an idempotent scheduled callback","security":[{"IntegrationCredential":[]},{"ClerkOAuth":["calls:write"]}],"parameters":[{"$ref":"#/compone