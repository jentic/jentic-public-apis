sponses/TooManyRequests"}}}},"/v1/rallies/{id}/custom-fields":{"get":{"summary":"List custom fields","security":[{"apiKeyAuth":[]}],"x-required-scopes":["custom-fields:read"],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Custom fields for this rally, newest first.","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/CustomField"}}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/TooManyRequests"}}},"post":{"summary":"Add a custom field","description":"The rally must be a registration sheet or booking agent, and still open. A Group Poll returns 400; an ended rally returns 409.","security":[{"apiKeyAuth":[]}],"x-required-scopes":["custom-fields:write"],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"Idempotency-Key","in":"header","required":false,"schema":{"type":"string","maxLength":255},"description":"Reuse the same key to safely retry a create request -- replaying it with the same request body returns the original custom field instead of creating a second one; reusing it with a different body is rejected with 422. Retained for 24 hours after first use; reusing a key after that starts a fresh request instead of replaying the original."}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["prompt","fieldType"],"properties":{"prompt":{"type":"string","maxLength":300},"fieldType":{"type":"string","enum":["text","image"]},"isRequired":{"type":"boolean","default":false}}}}}},"responses":{"200":{"description":"Confirmation.","content":{"application/json":{"schema":{"type":"object","required":["customFieldId"],"properties":{"customFieldId":{"type":"string","format":"uuid"}}}}}},"400":{"$ref":"#/c