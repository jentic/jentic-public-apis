ride":null,"addedAt":"2026-09-08T15:22:00Z"}],"nextCursor":null}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"429":{"$ref":"#/components/responses/TooManyRequests"}}}},"/v1/notification-emails":{"get":{"summary":"List verified team notification emails","description":"Only addresses that have completed email verification. Unverified and pending addresses are not included.","security":[{"apiKeyAuth":[]}],"x-required-scopes":["notification-emails:read"],"responses":{"200":{"description":"Verified team notification email addresses, oldest first.","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/NotificationEmail"}}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"429":{"$ref":"#/components/responses/TooManyRequests"}}}},"/v1/calendars":{"get":{"summary":"List connected calendars","description":"Google, Microsoft, and Apple calendars the organizer has connected and selected for sync.","security":[{"apiKeyAuth":[]}],"x-required-scopes":["calendars:read"],"responses":{"200":{"description":"Connected calendars, oldest first.","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/Calendar"}}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/TooManyRequests"}}}},"/v1/rallies/group-polls/{id}/slots":{"post":{"summary":"Add a Group Poll candidate time","security":[{"apiKeyAuth":[]}],"x-required-scopes":["slots:write"],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"Idempotency-Key","in":"header","required":false,"schema":{"type":"string","maxLength":255},"description":"Reuse the same key to safely retry a create request -- replaying it with the same request body returns the original time instead of creating a second one; reusing it with a different body is rejected with 422. Retained for 24 hours after first use; reusing a key after that starts a fresh request instead of replaying the original."}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["startsAt"],"properties":{"startsAt":{"type":"string","format":"date-time","description":"Must be in the future."},"durationMinutes":{"type":"integer","minimum":1,"maximum":1440,"description":"Optional. Group Poll times aren't required to carry a duration, but may -- this is the same duration shown on the visual weekly calendar when placing candidate times."}}},"example":{"startsAt":"2026-09-15T14:00:00Z","durationMinutes":60}}}},"responses":{"200":{"description":"Confirmation.","content":{"application/json":{"schema":{"type":"object","required":["slotId"],"properties":{"slotId":{"type":"string","format":"uuid"}}},"example":{"slotId":"9e2f5a7c-3d8b-4c1e-9a6f-2b7d4e8c1a3f"}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound","description":"Not found, or a rally id that exists but isn't a Group Poll."},"409":{"description":"The rally has ended, it already has a time at this startsAt, or it already has as many times as the organizer's plan allows.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"},"example":{"error":"This rally has ended, so it can't be changed.","requestId":"8b3e6a1c-4f9d-4c7e-9a2f-1d6b8e3a5c9f"}}}},"422":{"description":"Idempotency-Key was already used with a different request body.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"},"example":{"error":"This Idempotency-Key was already used with a different request body.","requestId":"8b3e6a1c-4f9d-4c7e-9a2f-1d6b8e3a5c9f"}}}},"