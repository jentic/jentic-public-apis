 or booking agent, and still open. A Group Poll returns 400; an ended rally returns 409."}},"/v1/rallies/{id}/custom-fields/{fieldId}/images":{"post":{"summary":"Upload an image for a custom field","description":"The custom field must belong to this rally and have fieldType image. Returns customFieldResponse -- an opaque reference to the uploaded image, not the image itself -- paste it as-is into that customFieldId's entry in the answers array of POST /v1/rallies/{id}/bookings or /registrations. Not wrapped by Idempotency-Key: retrying just uploads a second, independently-referenced copy rather than risking a duplicate booking, so there's nothing to replay.","security":[{"apiKeyAuth":[]}],"x-required-scopes":["custom-fields:write"],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"fieldId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"required":true,"content":{"multipart/form-data":{"schema":{"type":"object","required":["file"],"properties":{"file":{"type":"string","format":"binary","description":"A PNG, JPEG, or WebP image, 5 MB or smaller."}}}}}},"responses":{"201":{"description":"The uploaded image's reference.","content":{"application/json":{"schema":{"type":"object","required":["customFieldId","customFieldResponse"],"properties":{"customFieldId":{"type":"string","format":"uuid"},"customFieldResponse":{"type":"string","description":"An opaque reference to the uploaded image -- not the image itself. Pass it as-is as this customFieldId's answer."}}},"example":{"customFieldId":"c5e8b2f7-3a9d-4c1e-8f6b-2d7a4e9c1b5f","customFieldResponse":"a4d7c2e9-1f6b-4d8a-9c3e-7b2a5f8d1c4e/c5e8b2f7-3a9d-4c1e-8f6b-2d7a4e9c1b5f/6f2a8c1e-9d4b-4a7c-8e1f-3b5d7a9c2e4f.png"}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound","description":"Rally not found or not yours, or the field doesn't exist on this rally, or isn't an image field."},"413":{"description":"The image is larger than 5 MB.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"$ref":"#/components/responses/TooManyRequests"}}}},"/v1/bookings":{"get":{"summary":"List bookings","description":"Get booking agent appointments","security":[{"apiKeyAuth":[]}],"x-required-scopes":["bookings:read"],"parameters":[{"name":"rallyId","in":"query","required":false,"schema":{"type":"string","format":"uuid"},"description":"Narrow the list to one rally."},{"$ref":"#/components/parameters/Cursor"}],"responses":{"200":{"description":"Booking Agent appointments across your rallies, newest first.","content":{"application/json":{"schema":{"type":"object","required":["data","nextCursor"],"properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/Booking"}},"nextCursor":{"type":["string","null"],"description":"Pass as ?cursor= to fetch the next page; null when there are no more results."}}},"example":{"data":[{"bookingId":"d3f8a1c7-9e2b-4d6a-8c1f-5e7a3b9d2c4f","rallyId":"a4d7c2e9-1f6b-4d8a-9c3e-7b2a5f8d1c4e","rallyShareCode":"m2K9pQ4xN7vR1zW5yT8gLsHf","rallyTitle":"Office Hours","rallyType":"booking_agent","attendeeName":"Jordan Rivera","attendeeEmail":"jordan.rivera@example.com","slotStartsAt":"2026-09-15T14:00:00Z","slotEndsAt":"2026-09-15T14:30:00Z","sessionName":null,"conferencingJoinUrl":"https://zoom.us/j/9876543210","status":"confirmed","createdAt":"2026-09-08T15:30:00Z"}],"nextCursor":null}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"429":{"$ref":"#/components/responses/TooManyRequests"}}}},"/v1/rallies/{id}/bookings":{"post":{"summary":"Book an appointment","description":"Books a booking agent appointment on behalf of an attendee.","security":[{"apiKeyAuth":[]}],"x-required-scopes":["bo