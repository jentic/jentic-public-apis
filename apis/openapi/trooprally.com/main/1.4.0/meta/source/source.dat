"}}}},"/v1/rallies/booking-agents/{id}":{"get":{"summary":"Get a Booking Agent","security":[{"apiKeyAuth":[]}],"x-required-scopes":["rallies:read"],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"The rally.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/BookingAgentRally"}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"description":"Not found, not yours, or not a Booking Agent.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"$ref":"#/components/responses/TooManyRequests"}}}},"/v1/rallies/{id}":{"delete":{"summary":"Delete a rally","description":"Permanently deletes a rally. The rally must already be closed -- see POST /v1/rallies/{id}/end. Deleting a rally that is still active returns 409.","security":[{"apiKeyAuth":[]}],"x-required-scopes":["rallies:write"],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Confirmation.","content":{"application/json":{"schema":{"type":"object","required":["deleted"],"properties":{"deleted":{"type":"boolean"}}}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"409":{"description":"The rally hasn't ended yet. End it with POST /v1/rallies/{id}/end first -- or, for a Group Poll with a confirmed time, cancel the confirmation or wait for its meeting to end.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"},"example":{"error":"End this rally before deleting it (POST /v1/rallies/{id}/end).","requestId":"8b3e6a1c-4f9d-4c7e-9a2f-1d6b8e3a5c9f"}}}},"429":{"$ref":"#/components/responses/TooManyRequests"}}}},"/v1/rallies/{id}/end":{"post":{"summary":"End a rally","security":[{"apiKeyAuth":[]}],"x-required-scopes":