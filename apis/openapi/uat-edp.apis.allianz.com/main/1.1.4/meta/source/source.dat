          "speeding": {
            "description": "Total amount of speeding tickets received by the main driver over the last three years",
            "minimum": 0,
            "type": "integer"
          },
          "alcohol": {
            "description": "Total amount of DUI fines received by the main driver over the last three years",
            "minimum": 0,
            "type": "integer"
          },
          "others": {
            "description": "Total amount of other fines received by the main driver over the last three years",
            "minimum": 0,
            "type": "integer"
          }
