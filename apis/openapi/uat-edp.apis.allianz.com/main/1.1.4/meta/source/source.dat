          }
        ],
        "title": "QuoteBundleVehicleOwnerMotorbikeES"
      },
      "QuoteBundleMainDriverBaseMotorbikeES_drivingPenaltiesLastThreeYears_trafficFines": {
        "description": "Information about the traffic fines received by the main driver over the last three years",
        "properties": {
          "parking": {
            "description": "Total amount of parking fines received by the main driver over the last three years",
            "minimum": 0,
            "type": "integer"
