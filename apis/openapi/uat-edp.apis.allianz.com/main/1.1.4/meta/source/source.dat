      "ProposalRequestMotorbikeES": {
        "allOf": [
          {
            "$ref": "#/components/schemas/MotorProposalRequest"
          },
          {
            "properties": {
              "customerData": {
                "$ref": "#/components/schemas/ProposalCustomerDataMotorbikeES"
