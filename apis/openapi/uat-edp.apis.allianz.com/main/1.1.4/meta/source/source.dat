  "paths": {
    "/motorbike/es/v1/{partnerId}/quotebundles": {
      "description": "API to retrieve a quote bundle for Spanish aggregators",
      "post": {
        "operationId": "getQuotebundle",
        "parameters": [
          {
            "description": "The partnerId",
            "in": "path",
            "name": "partnerId",
            "required": true,
            "schema": {
              "pattern": "^[a-zA-Z0-9]{6}$",
              "type": "string"
            }
          },
          {
            "description": "Shared identifier of all the requests that take part in a customer transaction, will be generated if not provided",
            "in": "header",
            "name": "session-id",
            "required": false,
            "schema": {
              "pattern": "^[^\\s]+$",
              "type": "string"
            }
          },
          {
            "description": "Unique identifier of a request, will be generated if not provided",
            "in": "header",
            "name": "request-id",
            "required": false,
            "schema": {
              "pattern": "^[^\\s]+$",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuoteBundleRequestMotorbikeES"
              }
            }
          },
          "description": "Minimal data that is required to calculate quotes",
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuoteBundleResponseMotorbikeES"
                }
              }
            },
            "description": "The quote bundle and details based on the request",
            "headers": {
              "sessionId": {
                "$ref": "#/components/headers/SessionId"
              },
              "requestId": {
                "$ref": "#/components/headers/RequestId"
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequestErrorDetails"
                }
              }
            },
            "description": "Bad request: The request contains invalid data or is missing required information. The request should be fixed before trying again."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApigeeErrorDetails"
                }
              }
            },
            "description": "Not authorized: The request is missing the proper credentials to perform the requested operation. The proper credentials (e.g. API key) should be added to the request before trying again."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForbiddenRequestErrorDetails"
                }
              }
            },
            "description": "Forbidden: The request contains valid credentials, but those are not sufficient for the attempted operation. The request credentials (e.g. API key) should be fixed before trying again. The caller should make sure the right endpoint and the right environment are being used."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Rejection"
                }
              }
            },
            "description": "Conflict: The request was rejected. This means Allianz Direct could not answer the request positively given the provided information. The response body contains more detailed information. The request should not be tried again without modification."
          },
          "425": {
            "content": {
              "application/json": {
                "example": {
                  "status": 425,
                  "error": "Too Early",
                  "message": "Offering API is currently disabled"
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetails"
                }
              }
            },
            "description": "Too early: the request implies using a feature which is not yet available in this environment. The caller should make sure the right endpoint and the right environment are being used. The request should not be tried again without modification."
          },
          "500": {
            "content": {
              "application/json": {
                "example": {
                  "status": 500,
                  "error": "Internal Server Error",
                  "message": "An unexpected error occurred, please try again"
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetails"
                }
              }
            },
            "description": "Internal server error: The service encountered an unexpected error while processing the request. The request may be tried again immediately or later without modification. If the error persists, the endpoint maintainer should be contacted for additional support."
          },
          "502": {
            "content": {
              "application/json": {
                "example": {
                  "status": 502,
                  "error": "Bad Gateway",
                  "message": "An internal service returned an invalid answer"
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetails"
                }
              }
            },
            "description": "Bad gateway: An upstream service answered with an invalid response. The request may be tried again immediately or later without modification. If the error persists, the endpoint maintainer should be contacted for additional support."
          },
          "503": {
            "description": "Service unavailable: The requested endpoint or service is temporary unavailable. The request may be tried again later without modification. If the error persists, the endpoint maintainer should be contacted for additional support. Note: You will receive a 503 from the Allianz Direct proxy or load balancer if the service you are trying to reach is down. For this reason, the response body may be non-JSON, typically HTML or XML."
          },
          "504": {
            "content": {
              "application/json": {
                "example": {
                  "status": 504,
                  "error": "Gateway Timeout",
                  "message": "An unexpected error occurred, please try again"
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorDetails"
                }
              }
            },
            "description": "Gateway timeout: An upstream service did not respond in time. The request may be tried again immediately or later without modification. If the error persists, the endpoint maintainer should be contacted for additional support."
          }
        },
        "summary": "Request a new offering which contains a collection of quotes that can be chosen by the customer",
        "tags": [
          "es"
        ]
      }
    },
