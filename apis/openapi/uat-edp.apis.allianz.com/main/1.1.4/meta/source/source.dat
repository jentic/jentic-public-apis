          },
          "grossPrice": {
            "description": "Gross price of the coverage item, adjusted to the payment frequency",
            "minimum": 0,
            "type": "number"
          },
          "netPrice": {
            "description": "Net price of the coverage item, adjusted to the payment frequency",
            "minimum": 0,
