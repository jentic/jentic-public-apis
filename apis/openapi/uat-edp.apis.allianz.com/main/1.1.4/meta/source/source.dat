    "schemas": {
      "QuoteBundleRequestMotorbikeES": {
        "description": "Data needed to create a set of initial quotes",
        "example": {
          "productConfiguration": null,
          "customerData": {
            "additionalDrivers": [
              null,
              null
            ],
            "vehicleOwner": null,
            "mainDriver": null,
            "policyHolder": {
              "previousInsuranceInfo": {
                "claimsLastFiveYears": [
                  {
                    "claimType": "NO_THIRD_PARTY",
                    "claimDate": {
                      "month": 10,
                      "year": 2010
                    }
                  },
                  {
                    "claimType": "NO_THIRD_PARTY",
                    "claimDate": {
                      "month": 10,
                      "year": 2010
                    }
                  }
                ],
                "insurerCompanyCode": "insurerCompanyCode",
                "totalYearsAsPH": 0,
                "yearsInsured": 0
              },
              "identificationData": {
                "identificationNumber": "identificationNumber",
                "birthDate": "2000-01-23"
              },
              "drivingLicenseInfo": null
            }
          },
          "insuredEntity": null
        },
        "properties": {
          "insuredEntity": {
            "$ref": "#/components/schemas/QuoteBundleInsuredEntityMotorbikeES"
          },
          "customerData": {
            "$ref": "#/components/schemas/QuoteBundleCustomerDataMotorbikeES"
          },
          "productConfiguration": {
            "$ref": "#/components/schemas/QuoteBundleProductConfigurationMotorbikeES"
          }
        },
        "required": [
          "customerData",
          "insuredEntity",
          "productConfiguration"
        ],
        "type": "object"
      },
      "QuoteBundleInsuredEntityBaseMotorbikeES": {
        "properties": {
          "details": {
            "$ref": "#/components/schemas/InsuredEntityDetailsMotorbikeES"
          }
        },
        "type": "object"
      },
      "QuoteBundleMopedDetailsMotorbikeEs": {
        "allOf": [
          {
            "$ref": "#/components/schemas/QuoteBundleInsuredEntityBaseMotorbikeES"
          },
          {
            "properties": {
              "type": {
                "description": "Discriminator, must always be set to \"MOPED\"",
                "pattern": "^MOPED$",
                "type": "string"
              },
              "identifier": {
                "$ref": "#/components/schemas/QuoteBundleMopedIdentifierMotorbikeES"
              }
            },
            "required": [
              "identifier",
              "type"
            ],
