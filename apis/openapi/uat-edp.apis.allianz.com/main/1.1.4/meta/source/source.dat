          }
        },
        "title": "InsuredSumsSelectionMotorbikeES",
        "type": "object"
      },
      "QuoteMotorbikeES_coverageItems_inner": {
        "example": {
          "name": "name",
          "netPrice": 0.5637376656633328,
          "grossPrice": 0.5962133916683182,
          "id": "id"
        },
        "properties": {
          "id": {
            "pattern": "^[^\\s]+$",
            "title": "NoSpaceString",
            "type": "string"
          },
          "name": {
            "pattern": "^(?!.*\\s\\s.*)(?!\\s).*[^\\s]$",
            "title": "CleanString",
            "type": "string"
          },
          "grossPrice": {
            "description": "Gross value of the coverage item, adjusted to the payment frequency",
            "minimum": 0,
            "type": "number"
          },
          "netPrice": {
            "description": "Net value of the coverage item, adjusted to the payment frequency",
            "minimum": 0,
            "type": "number"
          }
        },
        "required": [
          "grossPrice",
          "id",
          "name",
          "netPrice"
        ],
        "type": "object"
      },
      "QuoteMotorbikeES_addons_inner": {
        "example": {
          "name": "name",
          "netPrice": 0.7061401241503109,
          "grossPrice": 0.23021358869347652,
          "id": "id"
        },
        "properties": {
          "id": {
            "pattern": "^[^\\s]+$",
            "title": "NoSpaceString",
            "type": "string"
          },
          "name": {
            "pattern": "^(?!.*\\s\\s.*)(?!\\s).*[^\\s]$",
            "title": "CleanString",
