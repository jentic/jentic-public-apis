        "example": {
          "name": "name",
          "value": 0.9301444243932576
        },
        "properties": {
          "name": {
            "pattern": "^(?!.*\\s\\s.*)(?!\\s).*[^\\s]$",
            "title": "CleanString",
            "type": "string"
