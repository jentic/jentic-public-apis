      "FieldErrorDetails": {
        "properties": {
          "field": {
            "description": "The name/path of the offending field",
            "pattern": "^[^\\s]+$",
            "type": "string"
          },
          "message": {
            "description": "A human-readable description of why the field value is invalid",
            "pattern": "^(?!.*\\s\\s.*)(?!\\s).*[^\\s]$",
            "type": "string"
          },
          "value": {
            "description": "The current field value, if any",
            "type": "object"
          }
        },
        "required": [
          "field",
          "message"
        ],
        "title": "FieldErrorDetails",
        "type": "object",
        "example": null
      },
      "ApigeeErrorDetails_fault_detail": {
        "properties": {
          "errorcode": {
            "description": "Specific code of the error",
            "example": "steps.oauth.v2.FailedToResolveAPIKey",
            "pattern": "^[^\\s]+$",
            "type": "string"
          }
        },
        "type": "object"
      },
      "ApigeeErrorDetails_fault": {
        "properties": {
          "faultstring": {
            "description": "Human-readable description of the error",
            "example": "Failed to resolve API Key variable request.header.x-apikey",
            "pattern": "^(?!.*\\s\\s.*)(?!\\s).*[^\\s]$",
            "type": "string"
          },
          "detail": {
            "$ref": "#/components/schemas/ApigeeErrorDetails_fault_detail"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "ApiKeyAuth": {
        "description": "The apikey to authenticate the aggregator",
        "in": "header",
        "name": "x-apikey",
        "type": "apiKey"
      }
    }
