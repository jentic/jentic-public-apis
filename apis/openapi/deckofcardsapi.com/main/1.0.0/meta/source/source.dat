{
  "openapi": "3.0.3",
  "info": {
    "title": "Deck of Cards API",
    "version": "1.0.0",
    "description": "A free, public, no-auth REST API that simulates one or more decks of playing cards. Create and shuffle decks (optionally partial decks, multiple decks, or with Jokers), draw cards, organise drawn cards into named piles, and return cards to the deck. Every endpoint accepts its parameters as either GET query parameters or POST form fields; decks are identified by a deck_id and discarded after two weeks of inactivity.",
    "license": {
      "name": "MIT",
      "url": "https://github.com/crobertsbmw/deckofcards/blob/master/LICENSE.txt"
    },
    "x-jentic-source-url": "https://deckofcardsapi.com/"
  },
  "servers": [
    {
      "url": "https://deckofcardsapi.com/api",
      "description": "Production"
    }
  ],
  "security": [],
  "tags": [
    {
      "name": "Decks",
      "description": "Create, shuffle and inspect decks"
    },
    {
      "name": "Cards",
      "description": "Draw cards and return them to the deck"
    },
    {
      "name": "Piles",
      "description": "Named piles of drawn cards (single-deck only)"
    }
  ],
  "paths": {
    "/deck/new/": {
      "get": {
        "operationId": "createDeck",
        "tags": [
          "Decks"
        ],
        "summary": "Create a new unshuffled deck",
        "description": "Opens a brand-new deck in order (A-spades, 2-spades, ... then diamonds, clubs, hearts). Optionally a partial deck via `cards`, multiple decks via `deck_count`, or Jokers via `jokers_enabled`.",
        "parameters": [
          {
            "name": "deck_count",
            "in": "query",
            "required": false,
            "description": "Number of standard decks to combine (1-20). Blackjack typically uses 6.",
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1,
              "maximum": 20
            }
          },
          {
            "name": "jokers_enabled",
            "in": "query",
            "required": false,
            "description": "Include two Jokers (X1, X2) in each deck.",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "cards",
            "in": "query",
            "required": false,
            "description": "Comma-separated card codes for a partial deck.",
            "style": "form",
            "explode": false,
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/CardCode"
              }
            },
            "example": [
              "AS",
              "2S",
              "KH"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "The new deck",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeckResponse"
                }
              }
            }
          }
        }
      }
    },
    "/deck/new/shuffle/": {
      "get": {
        "operationId": "createShuffledDeck",
        "tags": [
          "Decks"
        ],
        "summary": "Create a new shuffled deck",
        "description": "Creates and shuffles a new deck. Use `cards` to build a partial deck, `deck_count` to combine decks, or `jokers_enabled` to add Jokers.",
        "parameters": [
          {
            "name": "deck_count",
            "in": "query",
            "required": false,
            "description": "Number of standard decks to combine (1-20). Blackjack typically uses 6.",
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1,
              "maximum": 20
            }
          },
          {
            "name": "jokers_enabled",
            "in": "query",
            "required": false,
            "description": "Include two Jokers (X1, X2) in each deck.",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "cards",
            "in": "query",
            "required": false,
            "description": "Comma-separated card codes for a partial deck, e.g. AS,2S,KS.",
            "style": "form",
            "explode": false,
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/CardCode"
              }
            },
            "example": [
              "AS",
              "2S",
              "KH"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "The new shuffled deck",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeckResponse"
                }
              }
            }
          }
        }
      }
    },
    "/deck/new/draw/": {
      "get": {
        "operationId": "createDeckAndDraw",
        "tags": [
          "Cards"
        ],
        "summary": "Create a shuffled deck and draw cards",
        "description": "Creates a new shuffled deck and draws cards from it in a single request.",
        "parameters": [
          {
            "name": "count",
            "in": "query",
            "required": false,
            "description": "Number of cards to draw.",
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          },
          {
            "name": "deck_count",
            "in": "query",
            "required": false,
            "description": "Number of standard decks to combine (1-20). Blackjack typically uses 6.",
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1,
              "maximum": 20
            }
          },
          {
            "name": "jokers_enabled",
            "in": "query",
            "required": false,
            "description": "Include two Jokers (X1, X2) in each deck.",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Drawn cards and the new deck id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DrawResponse"
                }
              }
            }
          }
        }
      }
    },
    "/deck/{deck_id}/": {
      "get": {
        "operationId": "getDeck",
        "tags": [
          "Decks"
        ],
        "summary": "Get deck info",
        "description": "Returns the current state of an existing deck.",
        "parameters": [
          {
            "name": "deck_id",
            "in": "path",
            "required": true,
            "description": "Identifier of an existing deck, as returned by a create/shuffle call. Decks are discarded after two weeks of inactivity.",
            "schema": {
              "type": "string",
              "example": "3p40paa87x90"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deck state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeckResponse"
                }
              }
            }
          },
          "404": {
            "description": "Deck ID or pile does not exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/deck/{deck_id}/shuffle/": {
      "get": {
        "operationId": "shuffleDeck",
        "tags": [
          "Decks"
        ],
        "summary": "Reshuffle a deck",
        "description": "Reshuffles an existing deck. By default all cards (including drawn cards and piles) are returned and the full deck shuffled; with `remaining=true` only the cards still in the main stack are shuffled, leaving piles and drawn cards alone.",
        "parameters": [
          {
            "name": "deck_id",
            "in": "path",
            "required": true,
            "description": "Identifier of an existing deck, as returned by a create/shuffle call. Decks are discarded after two weeks of inactivity.",
            "schema": {
              "type": "string",
              "example": "3p40paa87x90"
            }
          },
          {
            "name": "remaining",
            "in": "query",
            "required": false,
            "description": "Only shuffle the cards remaining in the main stack.",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Shuffled deck state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeckResponse"
                }
              }
            }
          },
          "404": {
            "description": "Deck ID or pile does not exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/deck/{deck_id}/draw/": {
      "get": {
        "operationId": "drawCards",
        "tags": [
          "Cards"
        ],
        "summary": "Draw cards from a deck",
        "description": "Draws `count` cards from the top of the deck. If fewer cards remain than requested, `success` is false and the remaining cards are returned with an `error` message.",
        "parameters": [
          {
            "name": "deck_id",
            "in": "path",
            "required": true,
            "description": "Identifier of an existing deck, as returned by a create/shuffle call. Decks are discarded after two weeks of inactivity.",
            "schema": {
              "type": "string",
              "example": "3p40paa87x90"
            }
          },
          {
            "name": "count",
            "in": "query",
            "required": false,
            "description": "Number of cards to draw.",
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Drawn cards",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DrawResponse"
                }
              }
            }
          },
          "404": {
            "description": "Deck ID or pile does not exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/deck/{deck_id}/return/": {
      "get": {
        "operationId": "returnCardsToDeck",
        "tags": [
          "Cards"
        ],
        "summary": "Return drawn cards to the deck",
        "description": "Returns drawn cards (not in any pile) to the main stack. With `cards`, only the listed cards are returned.",
        "parameters": [
          {
            "name": "deck_id",
            "in": "path",
            "required": true,
            "description": "Identifier of an existing deck, as returned by a create/shuffle call. Decks are discarded after two weeks of inactivity.",
            "schema": {
              "type": "string",
              "example": "3p40paa87x90"
            }
          },
          {
            "name": "cards",
            "in": "query",
            "required": false,
            "description": "Comma-separated card codes to return. Defaults to all drawn cards not in a pile.",
            "style": "form",
            "explode": false,
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/CardCode"
              }
            },
            "example": [
              "AS",
              "2S",
              "KH"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "Updated deck state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeckResponse"
                }
              }
            }
          },
          "404": {
            "description": "Deck ID or pile does not exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/deck/{deck_id}/pile/list/": {
      "get": {
        "operationId": "listAllPiles",
        "tags": [
          "Piles"
        ],
        "summary": "List all piles",
        "description": "Lists every pile on the deck together with its cards.",
        "parameters": [
          {
            "name": "deck_id",
            "in": "path",
            "required": true,
            "description": "Identifier of an existing deck, as returned by a create/shuffle call. Decks are discarded after two weeks of inactivity.",
            "schema": {
              "type": "string",
              "example": "3p40paa87x90"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "All piles with their cards",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PilesResponse"
                }
              }
            }
          },
          "404": {
            "description": "Deck ID or pile does not exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/deck/{deck_id}/pile/{pile_name}/add/": {
      "get": {
        "operationId": "addToPile",
        "tags": [
          "Piles"
        ],
        "summary": "Add cards to a pile",
        "description": "Adds already-drawn cards to the named pile, creating it if needed and moving cards out of any other pile. Does not work with multiple decks.",
        "parameters": [
          {
            "name": "deck_id",
            "in": "path",
            "required": true,
            "description": "Identifier of an existing deck, as returned by a create/shuffle call. Decks are discarded after two weeks of inactivity.",
            "schema": {
              "type": "string",
              "example": "3p40paa87x90"
            }
          },
          {
            "name": "pile_name",
            "in": "path",
            "required": true,
            "description": "Name of the pile. Piles are created on the fly the first time cards are added to them.",
            "schema": {
              "type": "string",
              "example": "discard"
            }
          },
          {
            "name": "cards",
            "in": "query",
            "required": true,
            "description": "Comma-separated card codes to add.",
            "style": "form",
            "explode": false,
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/CardCode"
              }
            },
            "example": [
              "AS",
              "2S",
              "KH"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "Pile counts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PilesResponse"
                }
              }
            }
          },
          "404": {
            "description": "Deck ID or pile does not exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/deck/{deck_id}/pile/{pile_name}/shuffle/": {
      "get": {
        "operationId": "shufflePile",
        "tags": [
          "Piles"
        ],
        "summary": "Shuffle a pile",
        "description": "Shuffles the cards in the named pile. Does not work with multiple decks.",
        "parameters": [
          {
            "name": "deck_id",
            "in": "path",
            "required": true,
            "description": "Identifier of an existing deck, as returned by a create/shuffle call. Decks are discarded after two weeks of inactivity.",
            "schema": {
              "type": "string",
              "example": "3p40paa87x90"
            }
          },
          {
            "name": "pile_name",
            "in": "path",
            "required": true,
            "description": "Name of the pile. Piles are created on the fly the first time cards are added to them.",
            "schema": {
              "type": "string",
              "example": "discard"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Pile counts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PilesResponse"
                }
              }
            }
          },
          "404": {
            "description": "Deck ID or pile does not exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/deck/{deck_id}/pile/{pile_name}/list/": {
      "get": {
        "operationId": "listPile",
        "tags": [
          "Piles"
        ],
        "summary": "List cards in a pile",
        "description": "Lists the cards in the named pile; other piles are returned with counts only. Does not work with multiple decks.",
        "parameters": [
          {
            "name": "deck_id",
            "in": "path",
            "required": true,
            "description": "Identifier of an existing deck, as returned by a create/shuffle call. Decks are discarded after two weeks of inactivity.",
            "schema": {
              "type": "string",
              "example": "3p40paa87x90"
            }
          },
          {
            "name": "pile_name",
            "in": "path",
            "required": true,
            "description": "Name of the pile. Piles are created on the fly the first time cards are added to them.",
            "schema": {
              "type": "string",
              "example": "discard"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Pile contents",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PilesResponse"
                }
              }
            }
          },
          "404": {
            "description": "Deck ID or pile does not exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/deck/{deck_id}/pile/{pile_name}/draw/": {
      "get": {
        "operationId": "drawFromPile",
        "tags": [
          "Piles"
        ],
        "summary": "Draw cards from the top of a pile",
        "description": "Draws specific cards (`cards`) or `count` cards from the top of the named pile.",
        "parameters": [
          {
            "name": "deck_id",
            "in": "path",
            "required": true,
            "description": "Identifier of an existing deck, as returned by a create/shuffle call. Decks are discarded after two weeks of inactivity.",
            "schema": {
              "type": "string",
              "example": "3p40paa87x90"
            }
          },
          {
            "name": "pile_name",
            "in": "path",
            "required": true,
            "description": "Name of the pile. Piles are created on the fly the first time cards are added to them.",
            "schema": {
              "type": "string",
              "example": "discard"
            }
          },
          {
            "name": "cards",
            "in": "query",
            "required": false,
            "description": "Specific card codes to draw from the pile.",
            "style": "form",
            "explode": false,
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/CardCode"
              }
            },
            "example": [
              "AS",
              "2S",
              "KH"
            ]
          },
          {
            "name": "count",
            "in": "query",
            "required": false,
            "description": "Number of cards to draw (ignored when `cards` is given).",
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Drawn cards and pile counts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PileDrawResponse"
                }
              }
            }
          },
          "404": {
            "description": "Deck ID or pile does not exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/deck/{deck_id}/pile/{pile_name}/draw/{location}/": {
      "get": {
        "operationId": "drawFromPileAt",
        "tags": [
          "Piles"
        ],
        "summary": "Draw cards from the bottom or at random from a pile",
        "description": "Draws `count` cards from the bottom of the pile or at random positions.",
        "parameters": [
          {
            "name": "deck_id",
            "in": "path",
            "required": true,
            "description": "Identifier of an existing deck, as returned by a create/shuffle call. Decks are discarded after two weeks of inactivity.",
            "schema": {
              "type": "string",
              "example": "3p40paa87x90"
            }
          },
          {
            "name": "pile_name",
            "in": "path",
            "required": true,
            "description": "Name of the pile. Piles are created on the fly the first time cards are added to them.",
            "schema": {
              "type": "string",
              "example": "discard"
            }
          },
          {
            "name": "location",
            "in": "path",
            "required": true,
            "description": "Where to draw from.",
            "schema": {
              "type": "string",
              "enum": [
                "bottom",
                "random"
              ]
            }
          },
          {
            "name": "count",
            "in": "query",
            "required": false,
            "description": "Number of cards to draw.",
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Drawn cards and pile counts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PileDrawResponse"
                }
              }
            }
          },
          "404": {
            "description": "Deck ID or pile does not exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/deck/{deck_id}/pile/{pile_name}/return/": {
      "get": {
        "operationId": "returnPileToDeck",
        "tags": [
          "Piles"
        ],
        "summary": "Return pile cards to the deck",
        "description": "Returns all cards in the named pile (or only the listed `cards`) to the main stack.",
        "parameters": [
          {
            "name": "deck_id",
            "in": "path",
            "required": true,
            "description": "Identifier of an existing deck, as returned by a create/shuffle call. Decks are discarded after two weeks of inactivity.",
            "schema": {
              "type": "string",
              "example": "3p40paa87x90"
            }
          },
          {
            "name": "pile_name",
            "in": "path",
            "required": true,
            "description": "Name of the pile. Piles are created on the fly the first time cards are added to them.",
            "schema": {
              "type": "string",
              "example": "discard"
            }
          },
          {
            "name": "cards",
            "in": "query",
            "required": false,
            "description": "Comma-separated card codes to return. Defaults to the whole pile.",
            "style": "form",
            "explode": false,
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/CardCode"
              }
            },
            "example": [
              "AS",
              "2S",
              "KH"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "Updated deck and pile counts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PilesResponse"
                }
              }
            }
          },
          "404": {
            "description": "Deck ID or pile does not exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CardCode": {
        "type": "string",
        "pattern": "^([AJQK0-9][SDCH]|X[12])$",
        "description": "Two-character, case-insensitive card code: value (A, 2-9, 0 for ten, J, Q, K) followed by suit (S, D, C, H). Jokers are X1 and X2.",
        "example": "AS"
      },
      "CardImages": {
        "type": "object",
        "properties": {
          "svg": {
            "type": "string",
            "format": "uri"
          },
          "png": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "Card": {
        "type": "object",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/CardCode"
          },
          "image": {
            "type": "string",
            "format": "uri",
            "example": "https://deckofcardsapi.com/static/img/AS.png"
          },
          "images": {
            "$ref": "#/components/schemas/CardImages"
          },
          "value": {
            "type": "string",
            "description": "ACE, 2-10, JACK, QUEEN, KING or JOKER",
            "example": "ACE"
          },
          "suit": {
            "type": "string",
            "enum": [
              "SPADES",
              "DIAMONDS",
              "CLUBS",
              "HEARTS",
              "BLACK",
              "RED"
            ],
            "example": "SPADES"
          }
        }
      },
      "DeckResponse": {
        "type": "object",
        "required": [
          "success"
        ],
        "properties": {
          "success": {
            "type": "boolean"
          },
          "deck_id": {
            "type": "string",
            "example": "3p40paa87x90"
          },
          "shuffled": {
            "type": "boolean"
          },
          "remaining": {
            "type": "integer",
            "description": "Cards left in the main stack"
          },
          "piles": {
            "$ref": "#/components/schemas/PileSummaryMap"
          },
          "error": {
            "type": "string",
            "description": "Present when success is false (e.g. deck_count outside 1-20)"
          }
        }
      },
      "DrawResponse": {
        "type": "object",
        "required": [
          "success"
        ],
        "properties": {
          "success": {
            "type": "boolean"
          },
          "deck_id": {
            "type": "string"
          },
          "cards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Card"
            }
          },
          "remaining": {
            "type": "integer"
          },
          "error": {
            "type": "string",
            "description": "Present when fewer cards remained than requested"
          }
        }
      },
      "Pile": {
        "type": "object",
        "properties": {
          "remaining": {
            "type": "integer"
          },
          "cards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Card"
            }
          }
        }
      },
      "PileSummaryMap": {
        "type": "object",
        "description": "Map of pile name to pile state",
        "additionalProperties": {
          "$ref": "#/components/schemas/Pile"
        }
      },
      "PilesResponse": {
        "type": "object",
        "required": [
          "success"
        ],
        "properties": {
          "success": {
            "type": "boolean"
          },
          "deck_id": {
            "type": "string"
          },
          "remaining": {
            "type": "integer"
          },
          "piles": {
            "$ref": "#/components/schemas/PileSummaryMap"
          }
        }
      },
      "PileDrawResponse": {
        "type": "object",
        "required": [
          "success"
        ],
        "properties": {
          "success": {
            "type": "boolean"
          },
          "deck_id": {
            "type": "string"
          },
          "cards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Card"
            }
          },
          "piles": {
            "$ref": "#/components/schemas/PileSummaryMap"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "error": {
            "type": "string",
            "example": "Deck ID does not exist."
          }
        }
      }
    }
  }
}
