    "schemas": {
      "AdresseRoutageFacture": {
        "description": "",
        "type": "object",
        "required": [
          "codeLigneAdressage",
          "numeroSiren"
        ],
        "properties": {
          "codeLigneAdressage": {
            "description": "Codification du code ligne d'adressage :  - SIREN_SIRET_CODE ROUTAGE - SIREN_Adresse_9999 (Adresse : mail, code interne,…)  \"- Identifiant unique de chaque ligne d'adressage de l'annuaire, elle permet aux entreprises émettrice de connaitre le niveau de maille de réception des factures par leurs clients et d'identifier les informations à mettre dans la facture.  - Ce code pourra être utilisé comme un identifiant (clé unique par ligne) pour synchroniser l'annuaire central de la PFP avec l'annuaire de la PDP et/ou l'annuaire d'un réseau de type Peppol\"  (Source : Annexe 3 - Format sémantique B2B annuaire - V1.2)",
            "maxLength": 125,
            "type": "string"
          },
          "codeRoutage": {
            "description": "Code de routage interne choisi par l'entreprise pour recevoir les factures à une  maille plus fine que celle du SIRET. Le code de routage interne peut prendre l'une des valeurs :  - Code GLN, ODETTE, Code privé,... - Service traitant un type de factures reçues au sein de l'entité légale (SIREN) ou de l'établissement (SIRET) destinataire des factures.\"  - Identifiant permettant la réception des factures à une maille plus fine que celle du SIRET. - Une entité peut déclarer plusieurs codes de routage pour un même SIRET facturable.  (Source : Annexe 3 - Format sémantique B2B annuaire - V1.2)",
            "maxLength": 100,
            "type": "string"
          },
          "numeroSiren": {
            "description": "",
            "maxLength": 9,
            "type": "string"
          },
          "numeroSiret": {
            "description": "Identifiant de l'établissement dans la base SIRENE (Référentiel INSEE entreprises). Chaque entité légale dispose d'au moins un établissement (établissement principal), les grandes entreprises disposent de plusieurs établissements  - Identifiant d'un établissement de l'unité légale choisies pour recevoir les factures (SIRET facturables)  - Ces SIRET facturables peuvent figurer dans l'annuaire si l'entreprise a choisi de recevoir les factures à la maille du SIRET ou du SIRET+CODE ROUTAGE\"  (Source : Annexe 3 - Format sémantique B2B annuaire - V1.2)",
            "maxLength": 14,
            "type": "string"
          },
          "periodeEffet": {
            "$ref": "#/components/schemas/PeriodeEffet"
          },
          "suffixe": {
            "description": "",
            "maxLength": 100,
            "type": "string"
          }
        }
      },
      "EntiteJuridiqueRoutageFacture": {
        "description": "",
        "type": "object",
        "required": [
          "adressesRoutageFacture",
          "numeroSiren",
          "raisonSociale",
          "typeEntite"
        ],
        "properties": {
          "adressesRoutageFacture": {
            "description": "",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdresseRoutageFacture"
            }
          },
          "numeroSiren": {
            "description": "ISO6523 (ICD) DT-3-3",
            "type": "string"
          },
          "raisonSociale": {
            "description": "DT-3-4",
            "maxLength": 150,
            "type": "string"
          },
          "statut": {
            "description": "DT-3-2 Le statut  peut avoir les valeurs possibles :  - \"A\" pour \"Actif\" - \"I\" pour \"Inactif\"",
            "type": "string"
          },
          "typeEntite": {
            "description": "DT-3-5 Le type d'entité peut avoir les  valeurs possibles :  - \"P\" pour \"Publique\" - \"A\" pour \"Privé assujetti\"",
            "maxLength": 20,
            "type": "string"
          }
        }
      },
      "PeriodeEffet": {
        "description": "",
        "type": "object",
        "properties": {
          "dateFinEffective": {
            "description": "",
            "type": "string",
            "format": "date"
          },
          "dateFinEffet": {
            "description": "",
            "type": "string",
            "format": "date"
          },
          "datePriseEffet": {
            "description": "",
            "type": "string",
            "format": "date"
          }
        }
      },
