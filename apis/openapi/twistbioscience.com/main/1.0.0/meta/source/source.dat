    "/v1/fragments/drafts": {
      "post": {
        "tags": [
          "Fragments"
        ],
        "summary": "Create Fragments Draft",
        "description": "Create a draft for gene fragment synthesis products.\nThe `adapters` flag enables universal adapters for all sequences in the\ndraft, affecting pricing, scoring, and validation.\nOrder settings can optionally be provided at draft creation time, or\nset later via the `PUT /v1/users/{email}/fragments/drafts/{draft-id}/order-settings` endpoint.\nValidates the payload and sequences, returning a draft ID.\n",
        "operationId": "createFragmentsDraft",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateFragmentsDraftRequest"
              },
              "example": {
                "email": "user@twistbioscience.com",
                "externalOrderId": "EXT-ORD-003",
                "adapters": true,
                "orderSettings": {
                  "deliveryFormat": "SER_PKG_TUBE",
                  "buffer": "DRIED_DOWN",
                  "normalization": "YES",
                  "capping": "ADO_CAP",
                  "shipment": "MULTIPLE_SHIPMENT"
                },
                "items": [
                  {
                    "externalId": "FRAG-001",
                    "name": "Fragment 1",
                    "sequence": "ATCGATCGATCGATCGATCGATCG"
                  },
                  {
                    "externalId": "FRAG-002",
                    "name": "Fragment 2",
                    "sequence": "TTCCGGAATTCCGGAATTCCGGAA"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Draft created successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DraftCreatedResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/v1/users/{email}/fragments/drafts/{draft-id}": {
      "get": {
        "tags": [
          "Fragments"
        ],
        "summary": "Retrieve Fragments Draft",
        "description": "Retrieve a fragments draft by ID, including item-level validation results,\nadapters flag, and order settings if configured.\n",
        "operationId": "getFragmentsDraft",
        "parameters": [
          {
            "$ref": "#/components/parameters/email"
          },
          {
            "$ref": "#/components/parameters/draftId"
          }
        ],
        "responses": {
          "200": {
            "description": "Draft retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FragmentsDraftResponse"
                },
                "examples": {
                  "draft_no_errors": {
                    "summary": "Draft without errors",
                    "value": {
                      "draftId": "draft-789012",
                      "email": "user@twistbioscience.com",
                      "status": "DRAFT",
                      "externalOrderId": "EXT-ORD-003",
                      "adapters": true,
                      "orderSettings": {
                        "deliveryFormat": "SER_PKG_TUBE",
                        "shipment": "MULTIPLE_SHIPMENT",
                        "buffer": "GEN_FRG_TE",
                        "normalization": "YES",
                        "capping": "ADO_CAP"
                      },
                      "items": [
                        {
                          "id": "item-010",
                          "externalId": "FRAG-001",
                          "name": "Fragment 1",
                          "sequence": "ATCGATCGATCGATCGATCGATCG",
                          "errors": []
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/v1/users/{email}/fragments/drafts/{draft-id}/order-settings": {
      "put": {
        "tags": [
          "Fragments"
        ],
        "summary": "Update Fragment Draft Order Settings",
        "description": "Update the order settings on an existing fragments draft. Use this to\nfix order settings that caused validation errors. The updated draft\nis re-validated and returned with current validation results.\n",
        "operationId": "updateFragmentDraftOrderSettings",
        "parameters": [
          {
            "$ref": "#/components/parameters/email"
          },
          {
            "$ref": "#/components/parameters/draftId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FragmentOrderSettings"
              },
              "examples": {
                "update": {
                  "summary": "Update order settings",
                  "value": {
                    "deliveryFormat": "SER_PKG_96",
                    "shipment": "MULTIPLE_SHIPMENT",
                    "buffer": "GEN_FRG_TE",
                    "normalization": "YES",
                    "capping": "ADO_CAP"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Order settings updated and draft re-validated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FragmentsDraftResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/v1/high-mass-dna/drafts": {
      "post": {
        "tags": [
          "High Mass DNA"
        ],
        "summary": "Create High Mass DNA Draft",
        "description": "Create a draft for High Mass DNA synthesis products.\nValidates the payload and sequences, returning a draft ID.\n",
        "operationId": "createHighMassDnaDraft",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateHighMassDnaDraftRequest"
              },
              "examples": {
                "basic": {
                  "summary": "Basic High Mass DNA draft",
                  "value": {
                    "email": "user@twistbioscience.com",
                    "externalOrderId": "EXT-ORD-001",
                    "items": [
                      {
                        "externalPanelId": "PANEL-001",
                        "externalPartNumber": "PN-12345",
                        "name": "HMD Product 1",
                        "sequences": [
                          "ATCGATCGATCGATCGATCGATCG",
                          "TTCCGGAATTCCGGAATTCCGGAA"
                        ],
                        "qcPrimerF": "ATCGATCGATCGATCGATCG",
                        "qcPrimerR": "CGATTCGACGATTCGACGAT"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Draft created successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DraftCreatedResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/v1/users/{email}/high-mass-dna/drafts/{draft-id}": {
      "get": {
        "tags": [
          "High Mass DNA"
        ],
        "summary": "Retrieve High Mass DNA Draft",
        "description": "Retrieve a High Mass DNA draft by ID, including item-level validation results.\n",
        "operationId": "getHighMassDnaDraft",
        "parameters": [
          {
            "$ref": "#/components/parameters/email"
          },
          {
            "$ref": "#/components/parameters/draftId"
          }
        ],
        "responses": {
          "200": {
            "description": "Draft retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HighMassDnaDraftResponse"
                },
                "examples": {
                  "draft_no_errors": {
                    "summary": "Draft without errors",
                    "value": {
                      "draftId": "draft-123456",
                      "email": "user@twistbioscience.com",
                      "status": "DRAFT",
                      "externalOrderId": "EXT-ORD-001",
                      "items": [
                        {
                          "id": "item-001",
                          "externalPanelId": "PANEL-001",
                          "externalPartNumber": "PN-12345",
                          "name": "HMD Product 1",
                          "sequences": [
                            "ATCGATCGATCGATCGATCGATCG"
                          ],
                          "qcPrimerF": "ATCGATCGATCGATCGATCG",
                          "qcPrimerR": "CGATTCGACGATTCGACGAT",
                          "errors": []
                        }
                      ]
                    }
                  },
                  "draft_with_errors": {
                    "summary": "Draft with validation errors",
                    "value": {
                      "draftId": "draft-123457",
                      "email": "user@twistbioscience.com",
                      "status": "DRAFT",
                      "externalOrderId": "EXT-ORD-002",
                      "items": [
                        {
                          "id": "item-002",
                          "externalPanelId": "PANEL-001",
                          "externalPartNumber": "PN-12345",
                          "name": "HMD Product 1",
                          "sequences": [
                            "ATCGATCGATCGATCGATCGATCG"
                          ],
                          "qcPrimerF": "ATCG",
                          "qcPrimerR": "CGAT",
                          "errors": [
                            "QC Primer F length must be at least 18bp",
                            "QC Primer R length must be at least 18bp"
                          ]
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/v1/quotes/{draft-id}": {
      "post": {
        "tags": [
          "Quotes"
        ],
        "summary": "Request Quote",
        "description": "Generate a quote for a previously created draft.\n",
        "operationId": "requestQuote",
        "parameters": [
          {
            "$ref": "#/components/parameters/draftId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuoteRequest"
              },
              "examples": {
                "quote": {
                  "summary": "Request quote",
                  "value": {
                    "email": "user@twistbioscience.com",
                    "shippingAddressId": "addr_12345"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Quote generated successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuoteResponse"
                },
                "examples": {
                  "quote_response": {
                    "summary": "Quote response",
                    "value": {
                      "draftId": "draft-123456",
                      "totalPrice": 1250.0,
                      "currency": "USD",
                      "items": [
                        {
                          "name": "HMD Product 1",
                          "unitPrice": 625.0,
                          "quantity": 2,
                          "subtotal": 1250.0
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/v1/orders/{draft-id}": {
      "post": {
        "tags": [
          "Orders"
        ],
        "summary": "Place Order",
        "description": "Place an order using a previously created draft.\nThis is a synchronous call that returns the sales order ID directly.\n",
        "operationId": "placeOrder",
        "parameters": [
          {
            "$ref": "#/components/parameters/draftId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlaceOrderRequest"
              },
              "examples": {
                "place_order": {
                  "summary": "Place order",
                  "value": {
                    "email": "user@twistbioscience.com",
                    "shippingAddressId": "addr_12345",
                    "paymentMethodId": "pm_67890"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Order placed successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlaceOrderResponse"
                },
                "examples": {
                  "order_placed": {
                    "summary": "Order placed",
                    "value": {
                      "draftId": "draft-123456",
                      "salesOrderId": "SO-789012"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Bearer token authentication required for all endpoints.\nInclude the token in the Authorization header: `Bearer <your-token>`\n"
      }
    },
    "parameters": {
      "email": {
        "name": "email",
        "in": "path",
        "required": true,
        "description": "User's email address",
        "schema": {
          "type": "string",
          "format": "email",
          "example": "user@twistbioscience.com"
        }
      },
      "draftId": {
        "name": "draft-id",
        "in": "path",
        "required": true,
        "description": "Unique identifier of the draft",
        "schema": {
          "type": "string",
          "example": "draft-123456"
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Bad Request - Invalid input.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "NotFound": {
        "description": "Not Found - Resource does not exist.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "InternalError": {
        "description": "Internal Server Error.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Error message",
            "example": "Invalid request: missing required field"
          }
        },
        "required": [
          "error"
        ]
      },
      "DraftCreatedResponse": {
        "type": "object",
        "properties": {
          "draftId": {
            "type": "string",
            "description": "Unique draft identifier",
            "example": "draft-123456"
          }
        },
        "required": [
          "draftId"
        ]
      },
      "DraftBase": {
        "type": "object",
        "properties": {
          "draftId": {
            "type": "string",
            "example": "draft-123456"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "user@twistbioscience.com"
          },
          "status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "PLACED"
            ],
            "example": "DRAFT"
          },
          "externalOrderId": {
            "type": "string",
            "example": "EXT-ORD-001"
          }
        },
        "required": [
          "draftId",
          "email",
          "status",
          "externalOrderId"
        ]
      },
      "Vector": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Vector identifier",
            "example": 101
          },
          "name": {
            "type": "string",
            "example": "pTwist Amp High Copy"
          },
          "description": {
            "type": "string",
            "example": "High copy number cloning vector"
          },
          "type": {
            "type": "string",
            "enum": [
              "cloning",
              "expression",
              "catalog",
              "custom"
            ],
            "description": "Vector type",
            "example": "catalog"
          },
          "usage": {
            "type": "string",
            "description": "Intended usage of the vector",
            "example": "cloning"
          },
          "targetYieldEligible": {
            "type": "boolean",
            "description": "Whether the vector supports target yield options",
            "example": true
          },
          "polyaQcEligible": {
            "type": "boolean",
            "description": "Whether the vector supports poly-A QC",
            "example": false
          },
          "insertionSites": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InsertionSite"
            }
          }
        },
        "required": [
          "id",
          "name",
          "type",
          "insertionSites"
        ]
      },
      "InsertionSite": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Insertion site identifier",
            "example": 201
          },
          "name": {
            "type": "string",
            "example": "MCS"
          },
          "express": {
            "type": "boolean",
            "description": "Whether this is an expression insertion site",
            "example": false
          }
        },
        "required": [
          "id",
          "name",
          "express"
        ]
      },
      "ClonalGeneItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Item ID (response only)",
            "example": "item-020"
          },
          "externalId": {
            "type": "string",
            "example": "CG-001"
          },
          "name": {
            "type": "string",
            "example": "Clonal Gene 1",
            "minLength": 1
          },
          "sequence": {
            "type": "string",
            "pattern": "^[ATCG]+$",
            "example": "ATGCGATCGATCGATCGATCGATCG"
          },
          "organism": {
            "type": "string",
            "description": "Target organism for clonal expression",
            "example": "E. coli"
          },
          "vectorId": {
            "type": "integer",
            "description": "Vector ID from the vectors endpoint",
            "example": 101
          },
          "insertionSiteId": {
            "type": "integer",
            "description": "Insertion site ID from the chosen vector",
            "example": 201
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Validation errors (response only)"
          }
        },
        "required": [
          "externalId",
          "name",
          "sequence",
          "organism",
          "vectorId",
          "insertionSiteId"
        ]
      },
      "CreateClonalGenesDraftRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "user@twistbioscience.com"
          },
          "externalOrderId": {
            "type": "string",
            "example": "EXT-ORD-004"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ClonalGeneItem"
            },
            "minItems": 1,
            "maxItems": 100
          }
        },
        "required": [
          "email",
          "externalOrderId",
          "items"
        ]
      },
      "ClonalGenesDraftResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/DraftBase"
          },
          {
            "type": "object",
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ClonalGeneItem"
                }
              }
            },
            "required": [
              "items"
            ]
          }
        ]
      },
      "FragmentItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Item ID (response only)",
            "example": "item-010"
          },
          "externalId": {
            "type": "string",
            "example": "FRAG-001"
          },
          "name": {
            "type": "string",
            "example": "Fragment 1",
            "minLength": 1
          },
          "sequence": {
            "type": "string",
            "pattern": "^[ATCG]+$",
            "example": "ATCGATCGATCGATCGATCGATCG"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Validation errors (response only)"
          }
        },
        "required": [
          "externalId",
          "name",
          "sequence"
        ]
      },
      "FragmentOrderSettings": {
        "type": "object",
        "description": "Order-level settings for a fragments draft. These settings apply to the\nentire draft and trigger validation when set or updated.\nUse the order settings catalog endpoint (`GET /v1/users/{email}/fragments/order-settings`)\nto discover available values for each attribute.\n",
        "properties": {
          "deliveryFormat": {
            "type": "string",
            "description": "Delivery format (e.g. SER_PKG_TUBE, SER_PKG_96, SER_PKG_96_PCR, SER_PKG_384_WELL)",
            "example": "SER_PKG_TUBE"
          },
          "buffer": {
            "type": "string",
            "description": "Buffer type (e.g. DRIED_DOWN, GEN_FRG_ELU_BUF, GEN_FRG_TE, GEN_FRG_TE_LOW, GEN_FRG_WAT)",
            "example": "GEN_FRG_TE"
          },
          "normalization": {
            "type": "string",
            "description": "Normalization (YES or NO)",
            "example": "YES"
          },
          "normalizationValue": {
            "type": "integer",
            "description": "Normalization amount in nanograms when normalization is YES",
            "example": 250
          },
          "capping": {
            "type": "string",
            "description": "Capping preference (e.g. ADO_CAP, ADO_SND_EVRYTHNG)",
            "example": "ADO_CAP"
          },
          "shipment": {
            "type": "string",
            "description": "Shipment preference (e.g. MULTIPLE_SHIPMENT, SINGLE_SHIPMENT)",
            "example": "MULTIPLE_SHIPMENT"
          },
          "speed": {
            "type": "string",
            "description": "Production speed (e.g. EXPRESS_SPEED)",
            "example": "EXPRESS_SPEED"
          }
        }
      },
      "OrderSettingsDeliveryFormat": {
        "type": "object",
        "description": "A delivery format option with its associated configuration sections.\nEach delivery format groups related settings into sections\n(e.g. \"Additional Materials\", \"Production\", \"Delivery\").\n",
        "properties": {
          "title": {
            "type": "string",
            "description": "Display name of the delivery format",
            "example": "2 mL tube"
          },
          "info": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Additional information about the delivery format",
            "example": [
              "2 mL tube, screw cap, polypropylene.",
              "Tube label includes fragment name, order number, and mass."
            ]
          },
          "value": {
            "type": "string",
            "description": "Value to use when setting this delivery format on the draft",
            "example": "SER_PKG_TUBE"
          },
          "price": {
            "type": "number",
            "format": "double",
            "description": "Additional price for this delivery format",
            "example": 0
          },
          "attribute": {
            "type": "string",
            "description": "The `orderSettings` attribute this option maps to",
            "example": "deliveryFormat"
          },
          "sections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderSettingsSection"
            }
          }
        },
        "required": [
          "title",
          "value",
          "attribute",
          "sections"
        ]
      },
      "OrderSettingsSection": {
        "type": "object",
        "description": "A group of related order settings components within a delivery format.\nMay be empty when a delivery format has no configurable options for\na given section.\n",
        "properties": {
          "title": {
            "type": "string",
            "description": "Display name of the section",
            "example": "Additional Materials"
          },
          "components": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderSettingsComponent"
            }
          }
        }
      },
      "OrderSettingsComponent": {
        "type": "object",
        "description": "A configurable order setting with selectable options",
        "properties": {
          "title": {
            "type": "string",
            "description": "Display name of the setting",
            "example": "Buffer"
          },
          "options": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderSettingsOption"
            }
          }
        },
        "required": [
          "title",
          "options"
        ]
      },
      "OrderSettingsOption": {
        "type": "object",
        "description": "A selectable option within an order settings component",
        "properties": {
          "title": {
            "type": "string",
            "description": "Display name of the option",
            "example": "Dried Down"
          },
          "description": {
            "type": "string",
            "description": "Additional detail about the option",
            "example": "Delivered dry with no liquid buffer."
          },
          "value": {
            "type": "string",
            "description": "Value to use when setting this option on the draft",
            "example": "DRIED_DOWN"
          },
          "price": {
            "type": "number",
            "format": "double",
            "description": "Additional price for this option (absent when no extra cost)",
            "example": 0
          },
          "attribute": {
            "type": "string",
            "description": "The `orderSettings` attribute this option maps to",
            "example": "buffer"
          }
        },
        "required": [
          "title",
          "value",
          "attribute"
        ]
      },
      "CreateFragmentsDraftRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "user@twistbioscience.com"
          },
          "externalOrderId": {
            "type": "string",
            "example": "EXT-ORD-003"
          },
          "adapters": {
            "type": "boolean",
            "description": "Enable universal adapters for all sequences in the draft.\nAffects pricing, scoring, and validation.\n",
            "default": false,
            "example": true
          },
          "orderSettings": {
            "$ref": "#/components/schemas/FragmentOrderSettings"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FragmentItem"
            },
            "minItems": 1,
            "maxItems": 100
          }
        },
        "required": [
          "email",
          "externalOrderId",
          "items"
        ]
      },
      "FragmentsDraftResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/DraftBase"
          },
          {
            "type": "object",
            "properties": {
              "adapters": {
                "type": "boolean",
                "description": "Whether universal adapters are enabled",
                "example": true
              },
              "orderSettings": {
                "$ref": "#/components/schemas/FragmentOrderSettings"
              },
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/FragmentItem"
                }
              }
            },
            "required": [
              "adapters",
              "items"
            ]
          }
        ]
      },
      "HighMassDnaItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Item ID (response only)",
            "example": "item-001"
          },
          "externalPanelId": {
            "type": "string",
            "example": "PANEL-001"
          },
          "externalPartNumber": {
            "type": "string",
            "example": "PN-12345"
          },
          "name": {
            "type": "string",
            "example": "HMD Product 1",
            "minLength": 1
          },
          "sequences": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[ATCG]+$"
            },
            "minItems": 1,
            "example": [
              "ATCGATCGATCGATCGATCGATCG"
            ]
          },
          "qcPrimerF": {
            "type": "string",
            "pattern": "^[ATCG]+$",
            "example": "ATCGATCGATCGATCGATCG"
          },
          "qcPrimerR": {
            "type": "string",
            "pattern": "^[ATCG]+$",
            "example": "CGATTCGACGATTCGACGAT"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Validation errors (response only)"
          }
        },
        "required": [
          "externalPanelId",
          "externalPartNumber",
          "name",
          "sequences",
          "qcPrimerF",
          "qcPrimerR"
        ]
      },
      "CreateHighMassDnaDraftRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "user@twistbioscience.com"
          },
          "externalOrderId": {
            "type": "string",
            "example": "EXT-ORD-001"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HighMassDnaItem"
            },
            "minItems": 1,
            "maxItems": 100
          }
        },
        "required": [
          "email",
          "externalOrderId",
          "items"
        ]
      },
      "HighMassDnaDraftResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/DraftBase"
          },
          {
            "type": "object",
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/HighMassDnaItem"
                }
              }
            },
            "required": [
              "items"
            ]
          }
        ]
      },
      "QuoteRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "user@twistbioscience.com"
          },
          "shippingAddressId": {
            "type": "string",
            "description": "Pre-configured shipping address ID",
            "example": "addr_12345"
          }
        },
        "required": [
          "email",
          "shippingAddressId"
        ]
      },
      "QuoteLineItem": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "HMD Product 1"
          },
          "unitPrice": {
            "type": "number",
            "format": "double",
            "example": 625.0
          },
          "quantity": {
            "type": "integer",
            "example": 2
          },
          "subtotal": {
            "type": "number",
            "format": "double",
            "example": 1250.0
          }
        }
      },
      "QuoteResponse": {
        "type": "object",
        "properties": {
          "draftId": {
            "type": "string",
            "example": "draft-123456"
          },
          "totalPrice": {
            "type": "number",
            "format": "double",
            "example": 1250.0
          },
          "currency": {
            "type": "string",
            "example": "USD"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuoteLineItem"
            }
          }
        },
        "required": [
          "draftId",
          "totalPrice",
          "currency",
          "items"
        ]
      },
      "PlaceOrderRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "user@twistbioscience.com"
          },
          "shippingAddressId": {
            "type": "string",
            "description": "Pre-configured shipping address ID",
            "example": "addr_12345"
          },
          "paymentMethodId": {
            "type": "string",
            "description": "Pre-configured payment method ID",
            "example": "pm_67890"
          }
        },
        "required": [
          "email",
          "shippingAddressId",
          "paymentMethodId"
        ]
      },
      "PlaceOrderResponse": {
        "type": "object",
        "properties": {
          "draftId": {
            "type": "string",
            "example": "draft-123456"
          },
          "salesOrderId": {
            "type": "string",
            "description": "Sales order ID assigned by Twist's system",
            "example": "SO-789012"
          }
        },
        "required": [
          "draftId",
          "salesOrderId"
        ]
      }
    }
  }
}