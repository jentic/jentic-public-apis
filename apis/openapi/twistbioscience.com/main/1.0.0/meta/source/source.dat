                },
                "examples": {
                  "catalog": {
                    "summary": "Available order settings",
                    "value": [
                      {
                        "title": "2 mL tube",
                        "info": [
                          "2 mL tube, screw cap, polypropylene.",
                          "Tube label includes fragment name, order number, and mass."
                        ],
                        "value": "SER_PKG_TUBE",
                        "price": 0,
                        "attribute": "deliveryFormat",
                        "sections": [
                          {
                            "title": "Delivery",
                            "components": [
                              {
                                "title": "Shipment",
                                "options": [
                                  {
                                    "title": "Multiple shipments are ok",
                                    "description": "Twist attempts to ship all items together. Items requiring multiple production attempts may be delivered in a later shipment. Shipping & Handling is only charged once per order.",
                                    "value": "MULTIPLE_SHIPMENT",
                                    "attribute": "shipment"
                                  },
                                  {
                                    "title": "One shipment only",
                                    "description": "All items ship together when order completes production. Items requiring multiple production attempts may delay the entire order.",
                                    "value": "SINGLE_SHIPMENT",
                                    "attribute": "shipment"
                                  }
                                ]
                              }
                            ]
                          },
                          {
                            "title": "Additional Materials",
                            "components": [
                              {
                                "title": "Buffer",
                                "options": [
                                  {
                                    "title": "Dried Down",
                                    "description": "Delivered dry with no liquid buffer.",
                                    "value": "DRIED_DOWN",
                                    "price": 0,
                                    "attribute": "buffer"
                                  }
                                ]
                              }
                            ]
                          },
                          {
                            "title": "Production",
                            "components": [
                              {
                                "title": "Normalization",
                                "options": [
                                  {
                                    "title": "No",
                                    "description": "Receive fragments as produced.",
                                    "value": "NO",
                                    "attribute": "normalization"
                                  },
                                  {
                                    "title": "Yes",
                                    "description": "250 ng per fragment",
                                    "value": "YES",
                                    "price": 0,
                                    "attribute": "normalization"
                                  }
                                ]
                              },
                              {
                                "title": "Capping",
                                "options": [
                                  {
                                    "title": "Capped at 250 ng per fragment",
                                    "description": "Fixed maximum amount per well or tube.",
                                    "value": "ADO_CAP",
                                    "attribute": "capping"
                                  },
                                  {
                                    "title": "Send Everything",
                                    "description": "More DNA, but different amounts per well or tube.",
                                    "value": "ADO_SND_EVRYTHNG",
                                    "attribute": "capping"
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      },
