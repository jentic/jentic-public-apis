{
  "openapi": "3.1.0",
  "info": {
    "title": "Cobra · API de facturación electrónica SRI",
    "version": "1.0.0",
    "description": "Emite comprobantes electrónicos autorizados por el SRI de Ecuador (factura, nota de crédito, nota de débito, retención) con una API key. Motor propio (firma XAdES + transmisión al SRI); la firma .p12 nunca sale del servidor. Autenticación por header `X-API-Key`; permisos por scope; ambiente sandbox por llave.",
    "contact": {
      "name": "Cobra",
      "url": "https://facturacobra.com"
    },
    "x-jentic-source-url": "https://facturacobra.com/api/v1/openapi.json"
  },
  "servers": [
    {
      "url": "https://facturacobra.com/api/v1",
      "description": "Producción / sandbox (según la llave)"
    }
  ],
  "paths": {
    "/whoami": {
      "get": {
        "summary": "Identidad del tenant y capacidades de la llave",
        "tags": [
          "Cuenta"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "api_version": {
                      "type": "string"
                    },
                    "ruc": {
                      "type": "string",
                      "nullable": true
                    },
                    "razon_social": {
                      "type": "string",
                      "nullable": true
                    },
                    "ambiente": {
                      "type": "integer",
                      "enum": [
                        1,
                        2
                      ]
                    },
                    "sandbox": {
                      "type": "boolean"
                    },
                    "sri_activo": {
                      "type": "boolean"
                    },
                    "scopes": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "API key faltante o inválida",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/sri-lookup/{identificacion}": {
      "get": {
        "summary": "Consultar RUC/cédula en el padrón del SRI",
        "tags": [
          "Consultas"
        ],
        "parameters": [
          {
            "name": "identificacion",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK (found:false si no existe o el SRI no responde; nunca 5xx)"
          },
          "403": {
            "description": "Falta el scope 'read'",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/documents": {
      "get": {
        "summary": "Listar comprobantes",
        "tags": [
          "Comprobantes"
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 50,
              "maximum": 200
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 0
            }
          },
          {
            "name": "tipo",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "01",
                "04",
                "05",
                "06",
                "07",
                "08"
              ]
            }
          },
          {
            "name": "estado",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "desde",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "hasta",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "403": {
            "description": "Falta el scope 'read'",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Emitir un comprobante (factura, NC, ND o retención)",
        "tags": [
          "Comprobantes"
        ],
        "description": "Crea y emite al SRI en una llamada. `idempotency_key` obligatorio. El comprador se DERIVA/valida; los totales se recalculan server-side. Para NC/ND envía `doc_modificado_*`; para retención (06) envía `retention_items` y un sujeto retenido identificado.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "idempotency_key"
                ],
                "properties": {
                  "tipo_comprobante": {
                    "type": "string",
                    "enum": [
                      "01",
                      "04",
                      "05",
                      "06"
                    ],
                    "default": "01"
                  },
                  "idempotency_key": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 64
                  },
                  "fecha_emision": {
                    "type": "string",
                    "format": "date",
                    "description": "Default: hoy (Ecuador)."
                  },
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Comprador"
                    }
                  ],
                  "items": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/Item"
                    },
                    "description": "Factura/NC/ND."
                  },
                  "retention_items": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/RetentionItem"
                    },
                    "description": "Sólo retención (06)."
                  },
                  "doc_modificado_tipo": {
                    "type": "string",
                    "description": "NC/ND: tipo del documento modificado (01)."
                  },
                  "doc_modificado_numero": {
                    "type": "string",
                    "description": "NC/ND: EEE-PPP-SSSSSSSSS (con guiones)."
                  },
                  "doc_modificado_fecha": {
                    "type": "string",
                    "format": "date"
                  },
                  "doc_modificado_razon": {
                    "type": "string"
                  },
                  "periodo_fiscal": {
                    "type": "string",
                    "description": "Retención: MM/YYYY."
                  }
                }
              },
              "examples": {
                "factura": {
                  "summary": "Factura a consumidor final",
                  "value": {
                    "tipo_comprobante": "01",
                    "idempotency_key": "fac-2026-0001",
                    "comprador_tipo_id": "07",
                    "items": [
                      {
                        "descripcion": "Servicio",
                        "cantidad": 1,
                        "precio_unitario": 10,
                        "iva_codigo_porcentaje": "4"
                      }
                    ]
                  }
                },
                "retencion": {
                  "summary": "Retención renta 2% sobre $100",
                  "value": {
                    "tipo_comprobante": "06",
                    "idempotency_key": "ret-2026-0001",
                    "comprador_tipo_id": "04",
                    "comprador_identificacion": "1790016919001",
                    "comprador_razon_social": "PROVEEDOR SA",
                    "periodo_fiscal": "07/2026",
                    "retention_items": [
                      {
                        "codigo_impuesto": "1",
                        "codigo_retencion": "312",
                        "base_imponible": 100,
                        "porcentaje_retener": 2,
                        "tipo_doc_sustento": "01",
                        "numero_doc_sustento": "001-001-000000456",
                        "fecha_emision_sustento": "2026-07-10",
                        "sustento_iva_codigo": "4"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Replay idempotente (documento ya existía)"
          },
          "201": {
            "description": "Emitido (revisa emit.status = authorized)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "tipo_comprobante": {
                      "type": "string"
                    },
                    "numero": {
                      "type": "string",
                      "nullable": true,
                      "example": "001-001-000000010"
                    },
                    "clave_acceso": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "draft",
                        "authorized",
                        "rejected",
                        "error",
                        "queued",
                        "cancelled"
                      ]
                    },
                    "numero_autorizacion": {
                      "type": "string",
                      "nullable": true
                    },
                    "importe_total": {
                      "type": "string"
                    },
                    "emit": {
                      "type": "object",
                      "properties": {
                        "success": {
                          "type": "boolean"
                        },
                        "status": {
                          "type": "string"
                        },
                        "error": {
                          "type": "string",
                          "nullable": true
                        }
                      }
                    },
                    "advertencias": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Avisos NO bloqueantes. Ej.: se usó IVA 8% (feriado turístico) fuera de una fecha decretada cargada en Cobra."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validación (comprador, %, formato, etc.)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "402": {
            "description": "Cuota del plan agotada",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Falta el scope 'emit'",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Firma inactiva, sin punto de emisión, o el SRI devolvió/rechazó",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
