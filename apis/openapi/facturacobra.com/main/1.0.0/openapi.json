    "/documents/{id}/anular": {
      "post": {
        "summary": "Anular un comprobante (reglas SRI 2025-2026)",
        "tags": [
          "Comprobantes"
        ],
        "description": "Evalúa y registra la anulación según las reglas del SRI: bloquea facturas a consumidor final (firmes desde 1-ene-2026), respeta el plazo (hasta el día 7 del mes siguiente a la emisión) y, fuera de plazo, indica emitir una Nota de Crédito. NO envía nada al SRI (no existe API de anulación): el contribuyente la completa en el portal SRI en línea; la respuesta incluye la guía.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "reason"
                ],
                "properties": {
                  "reason": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Anulación registrada (vía portal SRI)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "estado": {
                      "type": "string",
                      "example": "cancelled"
                    },
                    "document_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "numero": {
                      "type": "string",
                      "example": "001-001-000000042"
                    },
                    "via": {
                      "type": "string",
                      "enum": [
                        "portal_sri"
                      ]
                    },
                    "plazo_hasta": {
                      "type": "string",
                      "example": "2026-08-07",
                      "description": "Día 7 del mes siguiente a la emisión"
                    },
                    "portal_url": {
                      "type": "string"
                    },
                    "siguiente_paso": {
                      "type": "string"
                    },
                    "aviso": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Motivo faltante, o el comprobante no está autorizado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Falta el scope 'annul'",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Ya anulado o fuera de plazo (requiere Nota de Crédito)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "motivo": {
                      "type": "string",
                      "enum": [
                        "ya_anulado",
                        "fuera_de_plazo"
                      ]
                    },
                    "via": {
                      "type": "string",
                      "enum": [
                        "nota_credito"
                      ],
                      "nullable": true
                    },
                    "requiere_nota_credito": {
                      "type": "boolean"
                    },
                    "es_consumidor_final": {
                      "type": "boolean"
                    },
                    "plazo_hasta": {
                      "type": "string",
                      "nullable": true
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Factura a consumidor final: firme desde el 1-ene-2026, no se puede anular ni acreditar",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "motivo": {
                      "type": "string",
                      "enum": [
                        "consumidor_final"
                      ]
                    },
                    "es_consumidor_final": {
                      "type": "boolean",
                      "example": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
