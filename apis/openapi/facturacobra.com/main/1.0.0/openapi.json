      "post": {
        "summary": "Registrar un webhook de autorización",
        "tags": [
          "Webhooks"
        ],
        "description": "Cuando un comprobante llega a estado terminal (authorized/rejected) —típicamente por el path asíncrono de contingencia/retry— Cobra hace POST a esta url. El cuerpo va firmado: header `X-Cobra-Signature: sha256=<hex>` = HMAC-SHA256(secret, `${X-Cobra-Timestamp}.${body}`). El `secret` se devuelve UNA sola vez al registrar. Evento: `{ event, document_id, tipo_comprobante, numero, clave_acceso, estado, numero_autorizacion, timestamp }`.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "url"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "description": "https:// (o http://127.0.0.1 para pruebas)."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Creado (incluye el secret una sola vez)"
          },
          "400": {
            "description": "url inválida",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Falta el scope 'webhooks:write'",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
