            "example": 2
          },
          "tipo_doc_sustento": {
            "type": "string",
            "example": "01"
          },
          "numero_doc_sustento": {
            "type": "string",
            "description": "Formato EEE-PPP-SSSSSSSSS (con guiones).",
            "example": "001-001-000000456"
          },
          "fecha_emision_sustento": {
            "type": "string",
            "format": "date",
            "example": "2026-07-10"
          },
          "sustento_iva_codigo": {
