              "0",
              "4",
              "5",
              "6",
              "7",
              "8"
            ],
            "default": "4",
            "description": "4=15% (default), 0=0%, 5=5%, 6=no objeto, 7=exento, 8=8% feriados turísticos (solo en fechas decretadas; responsabilidad del emisor)."
