so by MLS number (mls:<number>).\n\nFull reference: https://help.ruuster.com/api/properties-get (Markdown: https://help.ruuster.com/api/properties-get.md)","tags":["Listings"],"externalDocs":{"url":"https://help.ruuster.com/api/properties-get"},"parameters":[{"name":"propertyId","in":"path","required":true,"description":"The listing's `propertyId` (uuid), or `mls:<number>` to find it by MLS number. See [MLS numbers](https://help.ruuster.com/api/mls-numbers)","schema":{"type":"string","pattern":"^(?:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|mls:[A-Za-z0-9#._ -]{1,40})$"}}],"responses":{"200":{"description":"Success: { ok: true, data, meta }","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Envelope"},"example":{"ok":true,"data":{"property":{"propertyId":"5b7e2d94-1c63-4a8f-b5e0-9d3c7a2f1e86","mlsId":"3f4a7b12-6c85-4d93-a1e0-8b2f5c9d7e31","mlsName":"MLS of Southern Arizona","mlsRecordId":"22418765","mlsRecordIdCore":"22418765","address":"4182 E Saguaro Bloom Dr","city":"Tucson","state":"AZ","postalCode":"85718","price":489000,"status":"active","mlsStatus":"Active","onMarketDate":"2026-08-27","closeDate":null,"listAgentMlsId":"28301","listOfficeMlsId":"333802","matchSource":"agent","photoUrl":"https://cdn.example-mls.com/22418765/1.jpg","mediaCount":38,"url":"https://saguaro.ruuster.com/listings/5b7e2d94-1c63-4a8f-b5e0-9d3c7a2f1e86","previousPropertyIds":[],"firstSeenAt":"2026-08-27T15:02:11Z","lastSeenAt":"2026-10-01T06:12:30Z","mlsModifiedAt":"2026-09-29T19:41:00Z","updatedAt":"2026-10-01T06:12:30Z","ownedByYou":true,"photos":["https://cdn.example-mls.com/22418765/1.jpg","https://cdn.example-mls.com/22418765/2.jpg","https://cdn.example-mls.com/22418765/3.jpg"]}},"meta":{"brokerageId":"4f6c2a9e-8d31-4b57-9a0e-2c7d5e1b8f43","coverage":{"ownershipAsOf":"2026-10-01T06:12:30Z"}}}}}},"400":{"$ref":"#/components/responses/Error"},"401":{"$ref":"#/components/responses/Error"},"403":{"$ref":"#/components/responses/Error"},"404":{"$ref":"#/components/responses/Error"},"429":{"$ref":"#/components/responses/Error"},"503":{"$ref":"#/components/responses/Error"}}}},"/properties/{propertyId}/engagement":{"get":{"operationId":"properties.engagement","summary":"Get listing engagement","description":"How people engaged with one listing across Ruuster sites, by day, week or month: views, visitors, favorites, tour requests, offers, shares, contact requests and push alerts. The seller-report call. With scope=any, your own leads' activity on any one listing.\n\nFull reference: https://help.ruuster.com/api/properties-engagement (Markdown: https://help.ruuster.com/api/properties-engagement.md)","tags":["Listings"],"externalDocs":{"url":"https://help.ruuster.com/api/properties-engagement"},"parameters":[{"name":"propertyId","in":"path","required":true,"description":"The listing's `propertyId` (uuid), or `mls:<number>` to find it by MLS number. See [MLS numbers](https://help.ruuster.com/api/mls-numbers)","schema":{"type":"string","pattern":"^(?:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|mls:[A-Za-z0-9#._ -]{1,40})$"}},{"name":"from","in":"query","required":false,"description":"First day, `YYYY-MM-DD` in America/Chicago, included","schema":{"type":"string","format":"date"}},{"name":"to","in":"query","required":false,"description":"Day after the last day, `YYYY-MM-DD`, excluded","schema":{"type":"string","format":"date"}},{"name":"granularity","in":"query","required":false,"description":"`day`, `week` (Monday start) or `month`","schema":{"type":"string","default":"day"}},{"name":"scope","in":"query","required":false,"description":"`brokerage`: one of your listings, with every figure below. `any`: any single listing, by `propertyId`, with only your own leads' figures (see below)","schema":{"type":"string","default":"brokerage"}}],"responses":{"200":{"description":"Success: { ok: true, data, meta }","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Envelope"},"example":{"ok":true,