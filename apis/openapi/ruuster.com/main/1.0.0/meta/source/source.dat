nts/schemas/Envelope"},"example":{"ok":true,"data":{"events":[{"id":"evt_9a17f2c4b8e05d31","kind":"lead.tour_request","occurredAt":"2026-09-30T02:19:03Z","…":"the full envelope, as in the webhook event catalog"},{"id":"evt_6f3a9d1c0e8b4725","kind":"lead.contact_agent","occurredAt":"2026-09-30T19:07:56Z","…":"the full envelope, as in the webhook event catalog"}]},"meta":{"nextCursor":"cur_ev_B3t8Wn4K","hasMore":false}}}}},"400":{"$ref":"#/components/responses/Error"},"401":{"$ref":"#/components/responses/Error"},"403":{"$ref":"#/components/responses/Error"},"404":{"$ref":"#/components/responses/Error"},"429":{"$ref":"#/components/responses/Error"},"503":{"$ref":"#/components/responses/Error"}}}},"/cma":{"post":{"operationId":"cma.create","summary":"Run a CMA","description":"A comparative market analysis for one home in a market your brokerage is on: subject profile, sold comps with dollar adjustments, active, pending and expired competition, market conditions, a value conclusion and a seller net sheet. Computed from MLS records; no AI text.\n\nFull reference: https://help.ruuster.com/api/cma-create (Markdown: https://help.ruuster.com/api/cma-create.md)","tags":["CMA"],"externalDocs":{"url":"https://help.ruuster.com/api/cma-create"},"parameters":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"properties":{"subject.propertyId":{"type":"string","description":"The listing's id, from any other call or event"},"subject.mlsRecordId":{"type":"string","description":"An MLS number in one of your MLSs; add `subject.mlsId` when the number matches more than one"},"subject.address":{"type":"object","additionalProperties":true,"description":"`line1` (street number first), optional `unit`, `city`, `state`, `postalCode`. Matched against MLS records at that number and postal code"},"overrides":{"type":"object","additionalProperties":true,"description":"Facts you know better than the MLS record: `bedrooms`, `bathr