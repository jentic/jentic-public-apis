{"openapi":"3.1.0","info":{"title":"Ruuster API","version":"1.0.0","description":"Read-only access to engagement on a brokerage's Ruuster-powered sites: listings, leads, agents, the weekly summary, email, traffic and lead-event webhooks. Authenticate with the x-api-key and x-email headers of a brokerage owner or admin, from a server. Documentation: https://help.ruuster.com/api (for AI agents: https://help.ruuster.com/api/llms.txt).","termsOfService":"https://help.ruuster.com/api/terms","contact":{"email":"support@ruuster.com"}},"externalDocs":{"description":"Ruuster API documentation","url":"https://help.ruuster.com/api"},"servers":[{"url":"https://api.ruuster.com/v1"}],"security":[{"apiKey":[],"email":[]}],"tags":[{"name":"Account"},{"name":"Listings"},{"name":"Leads"},{"name":"Agents"},{"name":"Brokerage"},{"name":"CMA"},{"name":"Market"},{"name":"Webhook subscriptions"}],"components":{"securitySchemes":{"apiKey":{"type":"apiKey","in":"header","name":"x-api-key","description":"Your Ruuster API key (owner or admin)"},"email":{"type":"apiKey","in":"header","name":"x-email","description":"The Ruuster login email the key belongs to"}},"schemas":{"Envelope":{"type":"object","properties":{"ok":{"type":"boolean"},"data":{"type":"object"},"meta":{"type":"object"}},"required":["ok"]},"Error":{"type":"object","properties":{"ok":{"const":false},"error":{"type":"object","properties":{"code":{"type":"string"},"message":{"type":"string"}}},"requestId":{"type":"string"}}}},"responses":{"Error":{"description":"Error. Codes: https://help.ruuster.com/api/errors","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}},"paths":{"/status":{"get":{"operationId":"status","summary":"Check API status","description":"Whether the API is up. Needs no authentication; use it for uptime monitors.\n\nFull reference: https://help.ruuster.com/api/status (Markdown: https://help.ruuster.com/api/status.md)","tags":["Account"],"externalDocs":{"url":"https://help.ruuster.com/api/status"},"security":[],"parameters":[],"responses":{"200":{"description":"Success: { ok: true, data, meta }","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Envelope"},"example":{"ok":true,"data":{"status":"operational","version":"1.0.0","time":"2026-10-01T14:02:11Z"}}}}},"400":{"$ref":"#/components/responses/Error"},"401":{"$ref":"#/components/responses/Error"},"403":{"$ref":"#/components/responses/Error"},"404":{"$ref":"#/components/responses/Error"},"429":{"$ref":"#/components/responses/Error"},"503":{"$ref":"#/components/responses/Error"}}}},"/me":{"get":{"operationId":"me","summary":"Get your account","description":"Who the key belongs to, your brokerage, MLSs, hostnames, data coverage and current limits. Call it first to check credentials.\n\nFull reference: https://help.ruuster.com/api/me (Markdown: https://help.ruuster.com/api/me.md)","tags":["Account"],"externalDocs":{"url":"https://help.ruuster.com/api/me"},"parameters":[],"responses":{"200":{"description":"Success: { ok: true, data, meta }","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Envelope"},"example":{"ok":true,"data":{"user":{"id":"7c1e9b42-3d85-4a6f-9e07-1b2c8d4f5a69","email":"jane@saguarorealty.com","name":"Jane Doe","role":"admin"},"brokerage":{"id":"4f6c2a9e-8d31-4b57-9a0e-2c7d5e1b8f43","name":"Saguaro Realty Group"},"leadContactDetails":true,"mlsIds":["3f4a7b12-6c85-4d93-a1e0-8b2f5c9d7e31"],"hostnames":["saguaro.ruuster.com"],"coverage":{"from":"2026-07-03","to":"2026-09-30","asOf":"2026-10-01T13:10:42Z","stableBefore":"2026-09-28","ga":{"from":"2023-06-16","to":"2026-09-30","asOf":"2026-10-01T13:30:05Z"},"ownershipAsOf":"2026-10-01T06:12:30Z"},"limits":{"perMinute":120,"livePerMinute":20,"dailyRows":250000,"dailyLeadRows":50000,"maxLimit":500,"maxLeadLimit":200,"maxRangeDays":{"day":93,"week":400,"month":1096}},"webhooks":{"subscriptions":1,"maxSubscriptions":10}},"meta":{"brokerageId":"4f6c2a9e-8d31-4b57-9a0e-2c7d5e1b8f43"}}}}},"400":{"$ref":"#/components/responses/Error"},"401":{"$ref":"#/components/responses/Error"},"403":{"$ref":"#/components/responses/Error"},"404":{"$ref":"#/components/responses/Error"},"429":{"$ref":"#/components/responses/Error"},"503":{"$ref":"#/components/responses/Error"}}}},"/brand":{"get":{"operationId":"brand","summary":"Get your brand kit","description":"Your brokerage's name, logo, phone, website and the colors and fonts your Ruuster site is styled with, so reports and documents built from the API can carry your brand.\n\nFull reference: https://help.ruuster.com/api/brand (Markdown: https://help.ruuster.com/api/brand.md)","tags":["Account"],"externalDocs":{"url":"https://help.ruuster.com/api/brand"},"parameters":[],"responses":{"200":{"description":"Success: { ok: true, data, meta }","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Envelope"},"example":{"ok":true,"data":{"brokerage":{"name":"Saguaro Realty Group","tagline":"Tucson's neighborhood experts","phone":"+15205550101"},"logo":{"url":"https://cdn.example.com/white-labeling/saguaro/logo.png","source":"whiteLabel","favicon":"https://cdn.example.com/white-labeling/saguaro/favicon.ico","socialImage":"https://cdn.example.com/white-labeling/saguaro/logo.png"},"website":{"primaryUrl":"https://saguaro.ruuster.com","hostnames":["saguaro.ruuster.com"],"appStoreUrl":null,"googlePlayUrl":null},"colors":{"primary":"#0a5cb8","secondary":"#aae6ff","accent":"#ffd24d","background":"#e8f3fc","text":"#13203c","textSecondary":"#5378c8","link":"#00bbff","button":"#ffd24d","buttonText":"#13203c","onPrimary":"#ffffff"},"fonts":{"heading":"Poppins","body":"Roboto"},"source":"uiCustomization","subdomain":"saguaro"},"meta":{"brokerageId":"4f6c2a9e-8d31-4b57-9a0e-2c7d5e1b8f43"}}}}},"400":{"$ref":"#/components/responses/Error"},"401":{"$ref":"#/components/responses/Error"},"403":{"$ref":"#/components/responses/Error"},"404":{"$ref":"#/components/responses/Error"},"429":{"$ref":"#/components/responses/Error"},"503":{"$ref":"#/components/responses/Error"}}}},"/properties":{"get":{"operationId":"properties.list","summary":"List listings","description":"Listings attributed to your brokerage, including listings that left the market in about the last 18 months. Also finds a listing by MLS number.\n\nFull reference: https://help.ruuster.com/api/properties-list (Markdown: https://help.ruuster.com/api/properties-list.md)","tags":["Listings"],"externalDocs":{"url":"https://help.ruuster.com/api/properties-list"},"parameters":[{"name":"status","in":"query","required":false,"description":"`active` (Active, Coming Soon), `pending` (Pending, Under Contract, Contingent), `closed` or `all`","schema":{"type":"string","default":"active"}},{"name":"mlsRecordId","in":"query","required":false,"description":"Find by MLS number, with or without its leading letters. Searches your listings only and adds `ambiguous` to the response. See [MLS numbers](https://help.ruuster.com/api/mls-numbers)","schema":{"type":"string"}},{"name":"mlsId","in":"query","required":false,"description":"Limit to one of your MLSs (see `mlsIds` in `/me`)","schema":{"type":"string"}},{"name":"matchSource","in":"query","required":false,"description":"`agent` (the listing agent's MLS id is on one of your agents' profiles), `office` (an office Ruuster confirmed as yours) or `both`","schema":{"type":"string"}},{"name":"dateField","in":"query","required":false,"description":"Which date `from` and `to` filter on: `updated` (record changed), `onMarket` or `closed`","schema":{"type":"string","default":"updated"}},{"name":"from","in":"query","required":false,"description":"First day, `YYYY-MM-DD`, included. No date filter when omitted","schema":{"type":"string","format":"date"}},{"name":"to","in":"query","required":false,"description":"Day after the last day, `YYYY-MM-DD`, excluded","schema":{"type":"string","format":"date"}},{"name":"cursor","in":"query","required":false,"description":"`meta.nextCursor` from the previous page. Omit for the first page","schema":{"type":"string"}},{"name":"limit","in":"query","required":false,"description":"Rows per page, 1 to 500","schema":{"type":"integer","default":100}},{"name":"countOnly","in":"query","required":false,"description":"`1` returns `{ \"total\": n }` and no rows","schema":{"type":"string","enum":["0","1"],"default":"0"}}],"responses":{"200":{"description":"Success: { ok: true, data, meta }","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Envelope"},"example":{"ok":true,"data":{"properties":[{"propertyId":"5b7e2d94-1c63-4a8f-b5e0-9d3c7a2f1e86","mlsId":"3f4a7b12-6c85-4d93-a1e0-8b2f5c9d7e31","mlsRecordId":"22418765","address":"4182 E Saguaro Bloom Dr","city":"Tucson","state":"AZ","postalCode":"85718","price":489000,"status":"active","mlsStatus":"Active","onMarketDate":"2026-08-27","closeDate":null,"listAgentMlsId":"28301","listOfficeMlsId":"333802","matchSource":"agent","photoUrl":"https://cdn.example-mls.com/22418765/1.jpg","mediaCount":38,"url":"https://saguaro.ruuster.com/listings/5b7e2d94-1c63-4a8f-b5e0-9d3c7a2f1e86","previousPropertyIds":[],"firstSeenAt":"2026-08-27T15:02:11Z","lastSeenAt":"2026-10-01T06:12:30Z","mlsModifiedAt":"2026-09-29T19:41:00Z","updatedAt":"2026-10-01T06:12:30Z"},{"propertyId":"a03c8f61-7e2b-4d95-8a14-6f0b3e9c2d57","mlsId":"3f4a7b12-6c85-4d93-a1e0-8b2f5c9d7e31","mlsRecordId":"22419302","address":"1920 W Mesquite Ridge Ln","city":"Oro Valley","state":"AZ","postalCode":"85737","price":615000,"status":"active","mlsStatus":"Active","onMarketDate":"2026-09-10","closeDate":null,"listAgentMlsId":"31877","listOfficeMlsId":"333802","matchSource":"both","photoUrl":"https://cdn.example-mls.com/22419302/1.jpg","mediaCount":44,"url":"https://saguaro.ruuster.com/listings/a03c8f61-7e2b-4d95-8a14-6f0b3e9c2d57","previousPropertyIds":[],"firstSeenAt":"2026-09-10T14:20:51Z","lastSeenAt":"2026-10-01T06:12:30Z","mlsModifiedAt":"2026-09-30T16:05:12Z","updatedAt":"2026-10-01T06:12:30Z"}]},"meta":{"brokerageId":"4f6c2a9e-8d31-4b57-