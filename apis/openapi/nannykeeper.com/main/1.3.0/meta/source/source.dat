{
  "openapi": "3.1.0",
  "info": {
    "title": "NannyKeeper API",
    "description": "REST API for calculating US household employer (nanny) taxes. All 50 states + DC.",
    "version": "1.3.0",
    "contact": {
      "name": "NannyKeeper",
      "url": "https://www.nannykeeper.com/developers",
      "email": "hello@nannykeeper.com"
    },
    "license": {
      "name": "Proprietary",
      "url": "https://www.nannykeeper.com/terms"
    }
  },
  "servers": [
    {
      "url": "https://www.nannykeeper.com/api/v1",
      "description": "Production"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "API key. Live keys (nk_live_xxx) act on your real households; test keys (nk_test_xxx, Professional only) act only on sandbox households where nothing is emailed, charged, or sent to a bank. Get one at nannykeeper.com/developers/keys"
      }
    },
    "schemas": {
      "ActionRequired": {
        "description": "`true` when the worker's annual wages meet the per-worker FICA (Social Security and Medicare) cash-wage threshold for the year; `null` when we cannot say. Never `false` (since 1.2.0): below the threshold the household can still owe FUTA or state unemployment tax, which these endpoints cannot assess, and above it a family-employee or under-18 exemption could still remove FICA. Treat `null` as \"not determined\", never as \"nothing owed\".",
        "oneOf": [
          {
            "type": "boolean",
            "const": true
          },
          {
            "type": "null"
          }
        ]
      },
      "FutaAssessment": {
        "type": "object",
        "description": "FUTA is not assessed: it turns on the household's cash wages per calendar quarter across all employees, in this year and the preceding year, which these endpoints do not receive.",
        "required": [
          "quarterly_threshold",
          "status",
          "requires_household_quarterly_wages",
          "note"
        ],
        "properties": {
          "quarterly_threshold": {
            "type": "number",
            "description": "The year's FUTA quarterly wage trigger, in dollars."
          },
          "status": {
            "type": "string",
            "const": "unassessed"
          },
          "requires_household_quarterly_wages": {
            "type": "boolean",
            "const": true
          },
          "note": {
            "type": "string"
          }
        }
      },
      "Limitations": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "What this response cannot conclude. Always includes that no employee relationship or age was provided, so neither a family-employee exemption (from Social Security, Medicare and FUTA) nor the under-18 exemption (from Social Security and Medicare only) is applied, and that FUTA and state unemployment are not assessed. Show these to the end user with the result."
      },
      "ThresholdResponse": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "tax_year",
              "state",
              "annual_wages",
              "federal",
              "state_threshold",
              "state_unemployment_threshold",
              "futa",
              "limitations",
              "next_actions"
            ],
            "properties": {
              "tax_year": {
                "type": "integer"
              },
              "state": {
                "type": "string"
              },
              "annual_wages": {
                "type": "number"
              },
              "federal": {
                "type": "object",
                "required": [
                  "fica_threshold",
                  "approaching_threshold",
                  "status",
                  "action_required",
                  "assessment_scope",
                  "explanation"
                ],
                "properties": {
                  "fica_threshold": {
                    "type": "number"
                  },
                  "approaching_threshold": {
                    "type": "number"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "above",
                      "approaching",
                      "below"
                    ]
                  },
                  "action_required": {
                    "$ref": "#/components/schemas/ActionRequired"
                  },
                  "assessment_scope": {
                    "type": "string",
                    "const": "fica_only"
                  },
                  "explanation": {
                    "type": "string"
                  }
                }
              },
              "state_threshold": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "threshold_quarterly": {
                        "type": "number"
                      },
                      "status": {
                        "type": "string",
                        "const": "unassessed"
                      },
                      "explanation": {
                        "type": "string"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "description": "Since 1.3.0: a state whose household test is a calendar YEAR (New Jersey). threshold_quarterly is present and null.",
                    "properties": {
                      "threshold_quarterly": {
                        "type": "null"
                      },
                      "threshold_annual": {
                        "type": "number"
                      },
                      "status": {
                        "type": "string",
                        "const": "unassessed"
                      },
                      "explanation": {
                        "type": "string"
                      }
                    },
                    "required": ["threshold_quarterly", "threshold_annual", "status"]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "state_unemployment_threshold": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "threshold_quarterly": {
                        "type": "number"
                      },
                      "status": {
                        "type": "string",
                        "const": "unassessed"
                      },
                      "explanation": {
                        "type": "string"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "description": "Since 1.3.0: a state whose household test is a calendar YEAR (New Jersey). threshold_quarterly is present and null.",
                    "properties": {
                      "threshold_quarterly": {
                        "type": "null"
                      },
                      "threshold_annual": {
                        "type": "number"
                      },
                      "status": {
                        "type": "string",
                        "const": "unassessed"
                      },
                      "explanation": {
                        "type": "string"
                      }
                    },
                    "required": ["threshold_quarterly", "threshold_annual", "status"]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "futa": {
                "$ref": "#/components/schemas/FutaAssessment"
              },
              "limitations": {
                "$ref": "#/components/schemas/Limitations"
              },
              "next_actions": {
                "type": "object"
              }
            }
          },
          "meta": {
            "type": "object"
          }
        }
      },
      "CalculateResponse": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "tax_year",
              "state",
              "annual_wages",
              "employer_taxes",
              "employee_taxes_estimate",
              "per_paycheck",
              "threshold",
              "limitations",
              "futa"
            ],
            "properties": {
              "tax_year": {
                "type": "integer"
              },
              "state": {
                "type": "string"
              },
              "state_name": {
                "type": "string"
              },
              "annual_wages": {
                "type": "number"
              },
              "pay_frequency": {
                "type": "string"
              },
              "employer_taxes": {
                "type": "object",
                "description": "Employer taxes, computed as if the worker's wages meet the FICA cash-wage threshold, no family-employee or under-18 exemption applies, the household meets FUTA's quarterly test, and the household meets the state's unemployment threshold. See `threshold`, `limitations` and `futa`.",
                "properties": {
                  "social_security": {
                    "type": "number"
                  },
                  "medicare": {
                    "type": "number"
                  },
                  "futa": {
                    "type": "number"
                  },
                  "state_unemployment": {
                    "type": "number"
                  },
                  "state_unemployment_components": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "rate": {
                          "type": "number"
                        },
                        "amount": {
                          "type": "number"
                        },
                        "includes": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  },
                  "state_unemployment_unassessed": {
                    "type": "object"
                  },
                  "total": {
                    "type": "number"
                  },
                  "effective_rate": {
                    "type": "number"
                  }
                }
              },
              "employee_taxes_estimate": {
                "type": "object"
              },
              "per_paycheck": {
                "type": "object"
              },
              "threshold": {
                "type": "object",
                "required": [
                  "fica_threshold",
                  "federal_status",
                  "action_required",
                  "assessment_scope"
                ],
                "properties": {
                  "fica_threshold": {
                    "type": "number"
                  },
                  "federal_status": {
                    "type": "string",
                    "enum": [
                      "above",
                      "approaching",
                      "below"
                    ]
                  },
                  "action_required": {
                    "$ref": "#/components/schemas/ActionRequired"
                  },
                  "assessment_scope": {
                    "type": "string",
                    "const": "fica_only"
                  },
                  "state_suta_status": {
                    "type": "string",
                    "enum": [
                      "above",
                      "below"
                    ]
                  },
                  "state_suta_threshold": {
                    "type": "number"
                  },
                  "state_registration_threshold": {
                    "type": "number"
                  }
                }
              },
              "reciprocity": {
                "type": "object"
              },
              "limitations": {
                "$ref": "#/components/schemas/Limitations"
              },
              "futa": {
                "$ref": "#/components/schemas/FutaAssessment"
              },
              "next_actions": {
                "type": "object"
              },
              "continue_url": {
                "type": "string"
              }
            }
          },
          "meta": {
            "type": "object"
          }
        }
      }
    }
  },
  "paths": {
    "/calculate": {
      "post": {
        "summary": "Calculate taxes",
        "description": "Calculate household employer taxes for a single pay period. All 50 US states + DC.",
        "tags": [
          "Calculator"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "state",
                  "annual_wages"
                ],
                "properties": {
                  "state": {
                    "type": "string",
                    "description": "2-letter US state code",
                    "example": "CA"
                  },
                  "annual_wages": {
                    "type": "number",
                    "description": "Annual wages (0-999,999)",
                    "example": 35000
                  },
                  "pay_frequency": {
                    "type": "string",
                    "enum": [
                      "weekly",
                      "biweekly",
                      "semimonthly",
                      "monthly"
                    ],
                    "default": "biweekly"
                  },
                  "filing_status": {
                    "type": "string",
                    "enum": [
                      "single",
                      "married",
                      "head_of_household"
                    ],
                    "default": "single"
                  },
                  "residence_state": {
                    "type": "string",
                    "description": "Employee's residence state (2-letter code) when it differs from the work state. If the pair has a state income-tax reciprocity agreement, the response includes a `reciprocity` block.",
                    "example": "KY"
                  },
                  "reciprocity_certificate_on_file": {
                    "type": "boolean",
                    "default": false,
                    "description": "Set true when the work state's reciprocity exemption certificate (e.g. Indiana WH-47, Kentucky 42A809, Form VA-4) is on file with the employer. With a reciprocal work/residence pair, this zeroes the work state's income-tax estimate. Local taxes and unemployment insurance are unaffected — reciprocity covers state income tax only. Ignored for non-reciprocal pairs."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tax calculation result. When residence_state was provided and the work/residence pair has a state income-tax reciprocity agreement, includes a `reciprocity` block {applied, work_state, residence_state, suppressed_state_income_tax, certificate_form, note}. Employer state unemployment is reported as a single figure in `employer_taxes.state_unemployment`, and `employer_taxes.state_unemployment_components` names what that figure is made of: an array of {code, name, rate, amount} whose amounts always sum to it exactly. California returns two entries (UI 3.4% and ETT 0.1%) because the EDD assigns one rate covering both. Washington, Arkansas, Wisconsin and Colorado publish a single rate that is already several taxes, so they return ONE entry naming all of them plus an `includes` array of the part names and no separate amounts -- we hold no split for those. Treat a figure as bundled when there is more than one component OR a component carries `includes`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalculateResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error, or `federal_figures_unavailable` when the tax year's federal figures are not loaded. The `federal_figures_unavailable` body carries `error.code`, a plain-language `error.message` and `error.details.tax_year`. It is NOT retryable: it clears only when we publish the year's figures, which normally happens after the IRS does in the autumn. Distinct from the 503 `tax_year_not_supported`, which means the requested year is outside the range this endpoint answers at all."
          },
          "401": {
            "description": "API key required"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
    "/threshold": {
      "get": {
        "summary": "Check threshold",
        "description": "Check whether one worker's annual wages meet the per-worker FICA (Social Security and Medicare) threshold ($3,000 for 2026). FUTA and state unemployment depend on household quarterly wages and are reported as unassessed.",
        "tags": [
          "Calculator"
        ],
        "parameters": [
          {
            "name": "state",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "annual_wages",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "tax_year",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Threshold status for one worker's annual wages. Only the per-worker FICA test is assessed (`federal.assessment_scope: fica_only`); FUTA and state unemployment are reported as `unassessed`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ThresholdResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error, or `federal_figures_unavailable` when the tax year's federal figures are not loaded. The `federal_figures_unavailable` body carries `error.code`, a plain-language `error.message` and `error.details.tax_year`. It is NOT retryable: it clears only when we publish the year's figures, which normally happens after the IRS does in the autumn. Distinct from the 503 `tax_year_not_supported`, which means the requested year is outside the range this endpoint answers at all."
          },
          "401": {
            "description": "API key required"
          }
        }
      }
    },
    "/payroll/preview": {
      "post": {
        "summary": "Preview payroll",
        "description": "Dry-run payroll calculation. Returns the full tax breakdown, net pay, and employer costs WITHOUT creating a payroll record. Same request format as /payroll/run — use this to validate your payload and preview results before committing. Requires Starter+ subscription. State income-tax reciprocity: when the employer has attested the work state's exemption certificate is on file (done in the NannyKeeper app on the employee's profile), the work state's income tax is automatically suppressed here and in /payroll/run — no request field needed.",
        "tags": [
          "Payroll"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "employer_id",
                  "pay_period_start",
                  "pay_period_end",
                  "pay_date",
                  "pay_frequency",
                  "employees"
                ],
                "properties": {
                  "employer_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "pay_period_start": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                    "example": "2026-04-07"
                  },
                  "pay_period_end": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                    "example": "2026-04-13"
                  },
                  "pay_date": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                    "example": "2026-04-15"
                  },
                  "pay_frequency": {
                    "type": "string",
                    "enum": [
                      "weekly",
                      "biweekly",
                      "semimonthly",
                      "monthly"
                    ]
                  },
                  "employees": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "employee_id"
                      ],
                      "properties": {
                        "employee_id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "regular_hours": {
                          "type": "number",
                          "example": 40
                        },
                        "overtime_hours": {
                          "type": "number"
                        },
                        "bonus": {
                          "type": "number"
                        },
                        "other_earnings": {
                          "type": "number"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Payroll preview with full tax breakdown",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "preview": {
                          "type": "boolean",
                          "example": true
                        },
                        "pay_period": {
                          "type": "object"
                        },
                        "employees": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "description": "Per-employee calculation. Includes a `reciprocity` field for cross-state employees whose work/residence pair has a state income-tax reciprocity agreement: applied=true means the work state's income tax was suppressed under the employer's certificate attestation (suppressed_state_income_tax = what would have been withheld); applied=false means the pair qualifies but no attestation is on file (certificate_form names the form to collect). null for same-state / non-reciprocal employees. `employer_taxes.state_unemployment_includes` names the taxes the STATE combines into one unemployment rate (for example Washington returns [\"Unemployment Insurance\", \"Employment Administration Fund\"]), and is empty where the state charges one tax. NAMES ONLY, never amounts, and NOT an assertion that this employer's figure contains each part: this endpoint prices from the rate the employer entered off their own notice, so if they entered only one component the figure reflects that. The split belongs to their notice rather than to us. `local_taxes_not_withheld` lists local taxes we priced and did NOT take out, as `[{ state, jurisdiction, rate, reason }]` (`[]` when none; `rate` is a fraction, e.g. 0.03425 for 3.425%); `local_tax` already excludes them. `reason` is one of: `employee_consent_absent` (Philadelphia's wage tax and Wilmington's earned income tax may be withheld from a household employee only with the employee's agreement, and NannyKeeper does not record that agreement yet, so the employee pays the city directly), or `resident_not_withheld` (the employee's home address is in Philadelphia, which taxes its residents' pay wherever they work, while the job is outside the city; a household employer isn't required to take it out, so the employee pays it to the city directly as the Earnings Tax). An employee can have both, one entry each. More reasons may be added; treat an unknown one as not withheld. `time_off` (added 2026-10-07) carries `sick` and `vacation`, each null when that balance isn't tracked, else `{ hours_earned_this_period, hours_used_this_period, balance }` in hours; `sick` adds `source` (`state_default` or `family`) and `method` (`state_rule`, `accrual`, `frontloaded`), `vacation` adds `method` (`accrual`, `frontloaded`), and a vacation balance can be below zero. `time_off.year` (added 2026-10-09) is `{ starts_on, next_starts_on }` when the paycheck's time-off year is one the family set (for example the employee's work anniversary), else null for a calendar year. `sick_leave` is unchanged."
                          }
                        },
                        "totals": {
                          "type": "object"
                        },
                        "next_step": {
                          "type": "string",
                          "example": "To create this payroll, send the same request to POST /api/v1/payroll/run"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation error (includes example payload for self-correction), or `federal_figures_unavailable` when the pay date's federal figures are not loaded (same body and the same not-retryable meaning as on /calculate), or `state_figures_unavailable` when the work state's figures for the pay date's year are not loaded. The `state_figures_unavailable` body carries `error.code`, a plain-language `error.message` and `error.details.state` and `error.details.tax_year`. It is NOT retryable: it clears when we publish that state's figures for the year."
          },
          "403": {
            "description": "Subscription required"
          }
        }
      }
    },
    "/payroll/run": {
      "post": {
        "summary": "Run payroll",
        "description": "Run payroll for one or more employees. Calculates all federal and state taxes with YTD tracking, creates a payroll record, and returns the payroll ID. Use notes='catch-up' for retroactive payrolls. Tip: use /payroll/preview first to validate your payload. Requires Starter+ subscription. Reciprocity attestations on the employee profile are honored automatically (work-state income tax suppressed; local taxes and SUI unaffected). Each employee carries `local_taxes_not_withheld`, the same list as on /payroll/preview, read from what the paycheck stored (`[]` for paychecks stored before 2026-10-06). Each employee also carries `time_off`, the same shape as on /payroll/preview, read from what the paycheck stored (`sick_leave` is unchanged).",
        "tags": [
          "Payroll"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "employer_id",
                  "pay_period_start",
                  "pay_period_end",
                  "pay_date",
                  "pay_frequency",
                  "employees"
                ],
                "properties": {
                  "employer_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "pay_period_start": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "pay_period_end": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "pay_date": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "pay_frequency": {
                    "type": "string",
                    "enum": [
                      "weekly",
                      "biweekly",
                      "semimonthly",
                      "monthly"
                    ]
                  },
                  "employees": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "employee_id"
                      ],
                      "properties": {
                        "employee_id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "regular_hours": {
                          "type": "number"
                        },
                        "overtime_hours": {
                          "type": "number"
                        },
                        "bonus": {
                          "type": "number"
                        },
                        "other_earnings": {
                          "type": "number"
                        },
                        "payment_method": {
                          "type": "string",
                          "enum": [
                            "direct_deposit",
                            "check",
                            "cash"
                          ]
                        }
                      }
                    }
                  },
                  "notes": {
                    "type": "string",
                    "description": "Use 'catch-up' for retroactive payrolls"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Payroll created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "payroll_id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "draft",
                            "completed"
                          ]
                        },
                        "pay_period": {
                          "type": "object"
                        },
                        "employees": {
                          "type": "array",
                          "items": {
                            "type": "object"
                          }
                        },
                        "totals": {
                          "type": "object"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Subscription required"
          }
        }
      }
    },
    "/employers": {
      "get": {
        "summary": "List employers",
        "description": "List all employer accounts accessible to the API key. Requires Professional tier and multi_employer scope. Mode-scoped: a live key returns real households, a test key returns sandbox households.",
        "tags": [
          "Employers"
        ],
        "responses": {
          "200": {
            "description": "Employer list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "first_name": {
                            "type": "string"
                          },
                          "last_name": {
                            "type": "string"
                          },
                          "email": {
                            "type": "string",
                            "format": "email"
                          },
                          "state": {
                            "type": "string",
                            "description": "2-letter US state code"
                          },
                          "is_primary": {
                            "type": "boolean",
                            "description": "Whether this is the primary employer account"
                          },
                          "ein_status": {
                            "type": "string",
                            "enum": [
                              "none",
                              "pending",
                              "approved"
                            ],
                            "description": "EIN application status"
                          },
                          "created_at": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "sandbox": {
                            "type": "boolean",
                            "description": "True when this is a sandbox household (test mode). Never billed, never sends mail or money."
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "API key required"
          },
          "403": {
            "description": "Professional tier and multi_employer scope required"
          }
        }
      },
      "post": {
        "summary": "Create employer",
        "description": "Create a new employer account under the organization. Requires Professional tier and multi_employer scope. Mode-scoped: called with a test key (nk_test_) this creates a SANDBOX household instead, and `email` becomes optional (nothing is ever sent to it).",
        "tags": [
          "Employers"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "first_name",
                  "last_name",
                  "email",
                  "state"
                ],
                "properties": {
                  "first_name": {
                    "type": "string",
                    "description": "Employer first name",
                    "example": "Jane"
                  },
                  "last_name": {
                    "type": "string",
                    "description": "Employer last name",
                    "example": "Smith"
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "description": "Employer email address",
                    "example": "jane.smith@example.com"
                  },
                  "state": {
                    "type": "string",
                    "description": "2-letter US state code for the employer's primary state",
                    "example": "CA"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Employer created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "first_name": {
                      "type": "string"
                    },
                    "last_name": {
                      "type": "string"
                    },
                    "email": {
                      "type": "string",
                      "format": "email"
                    },
                    "state": {
                      "type": "string"
                    },
                    "is_primary": {
                      "type": "boolean"
                    },
                    "organization_id": {
                      "type": "string",
                      "format": "uuid",
                      "description": "Organization this employer belongs to"
                    },
                    "created_at": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "API key required"
          },
          "403": {
            "description": "Professional tier and multi_employer scope required"
          }
        }
      }
    },
    "/employees": {
      "get": {
        "summary": "List employees",
        "description": "List employees for an employer. Cursor-based pagination.",
        "tags": [
          "Employees"
        ],
        "parameters": [
          {
            "name": "employer_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Employee list"
          }
        }
      },
      "post": {
        "summary": "Create employee",
        "description": "Create a new employee. SSN and bank must be entered via secure portal. Each plan caps active employees per employer (Starter 1, Plus 5, Professional 5 included, expandable to 25 at $6/mo per additional employee). Creating past the limit returns 403 with error code seat_limit_reached; the API never bills implicitly — add employees in the dashboard at Settings → Billing, then retry.",
        "tags": [
          "Employees"
        ],
        "responses": {
          "201": {
            "description": "Employee created"
          },
          "403": {
            "description": "Employee limit reached for the employer's plan. error.code = \"seat_limit_reached\"; error.message explains the resolution; error.docs_url links to the API reference. Add employees at Settings → Billing in the dashboard (Professional: $6/mo each, up to 25 total), then retry the request."
          }
        }
      }
    },
    "/documents/paystub": {
      "post": {
        "summary": "Generate pay stub",
        "tags": [
          "Documents"
        ],
        "description": "Returns the pay stub PDF for every employee on a payroll, base64-encoded in JSON: `data.documents[]` with `employee_id`, `document_id`, `file_name`, `mime_type`, `encoding` (\"base64\") and `data`. It is the same stub the household downloads in the dashboard.",
        "responses": {
          "200": {
            "description": "Pay stubs as base64 PDFs in JSON"
          },
          "404": {
            "description": "No payroll with that id in this household"
          }
        }
      }
    },
    "/documents/w2": {
      "post": {
        "summary": "Generate W-2",
        "tags": [
          "Documents"
        ],
        "description": "Not available through the API yet. After the request is validated, the endpoint answers 501 `not_available_via_api`. A W-2 is downloaded from Documents in the NannyKeeper dashboard.",
        "responses": {
          "501": {
            "description": "not_available_via_api: download it from Documents in the dashboard"
          }
        }
      }
    },
    "/documents/schedule-h": {
      "post": {
        "summary": "Generate Schedule H",
        "tags": [
          "Documents"
        ],
        "description": "Not available through the API yet. After the request is validated, the endpoint answers 501 `not_available_via_api`. Schedule H is downloaded from Documents in the NannyKeeper dashboard.",
        "responses": {
          "501": {
            "description": "not_available_via_api: download it from Documents in the dashboard"
          }
        }
      }
    },
    "/ach/transfer": {
      "post": {
        "summary": "Initiate DD transfer",
        "description": "Initiate direct deposit ACH transfer. DD fee charged per tier.",
        "tags": [
          "ACH"
        ],
        "responses": {
          "201": {
            "description": "Transfer initiated"
          }
        }
      }
    },
    "/employers/{id}": {
      "delete": {
        "summary": "Delete or reset a sandbox household",
        "description": "Delete a sandbox household and everything in it. Requires a test-mode key (nk_test_) — real households can never be deleted through the API. Pass ?reset=true to wipe its employees and payrolls while keeping the household and its id.",
        "tags": [
          "Employers"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Sandbox employer id"
          },
          {
            "name": "reset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "true = wipe contents but keep the household; false = delete it entirely."
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted or reset",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "reset": {
                          "type": "boolean"
                        },
                        "deleted": {
                          "type": "boolean"
                        },
                        "payrolls_deleted": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Not a test-mode key"
          },
          "404": {
            "description": "No sandbox household with that id"
          }
        }
      }
    }
  }
}
