  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "schemas": {
      "pendenciaResponse": {
        "type": "object",
        "properties": {
          "totals": {
            "type": "object",
            "properties": {
              "total": {
                "type": "integer",
                "example": 13
              },
              "latedue": {
                "type": "integer",
                "example": 13
              },
              "duetoday": {
                "type": "integer",
                "example": 0
              }
            }
          },
          "data": {
            "type": "object",
            "properties": {
              "list": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "exec_id": {
                      "type": "string",
                      "example": "TASK-162"
                    },
                    "exec_title": {
