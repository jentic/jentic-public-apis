              "type": "integer",
              "minimum": 0,
              "maximum": 4,
              "example": 1
            }
          },
          {
            "name": "param.title",
            "in": "query",
            "required": false,
            "description": "Filtro por nome da conta (formato INPAAS: $contains|valor)",
            "schema": {
              "type": "string",
              "example": "$contains|clinica"
