  "paths": {
    "/api/bpm-exec-issuedata/v1/pending-issues/data.json": {
      "get": {
        "tags": [
          "pendencias"
        ],
        "summary": "Obter pendências do usuário",
        "description": "Retorna a lista de pendências.",
        "operationId": "getPendencias",
        "parameters": [
          {
            "name": "user",
            "in": "query",
            "description": "Login do Usúario já autenticado pode ser e-mail",
            "required": true,
            "schema": {
              "type": "string",
              "example": "eduardoteste1@plusoft.com"
            }
          },
          {
            "name": "pass",
            "in": "query",
            "description": "Autenticação do Usúario já autenticado",
            "required": true,
            "schema": {
              "type": "string",
              "example": "se@nha2r5"
            }
          },
          {
            "name": "order",
            "in": "query",
            "description": "Ordenação ASC ou DESC",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "ASC",
                "DESC"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Limite de itens retornados por página",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 10
            }
          },
          {
            "name": "assigned_user",
            "in": "query",
            "description": "Y = Atribuídas a mim, N = Todas",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "Y",
                "N"
              ]
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "duetoday = Vencendo Hoje, pending = Pendente, latedue = Em Atraso",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "duetoday",
                "latedue",
                "pending"
              ]
            }
          },
          {
            "name": "workflows",
            "in": "query",
            "description": "Tipos de workflow (7=Conta, 11=Contato, 8=Lead, 1=Oportunidade, 4=Tarefa). Pode receber múltiplos valores.",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "example": [
                4,
                1,
                8
              ]
            },
            "style": "form",
            "explode": false
          },
          {
            "name": "page",
            "in": "query",
            "description": "Página atual",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 1
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Campo de ordenação",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "id",
                "date_created",
                "title",
                "step",
                "assignee",
                "duedate"
              ]
            }
          },
          {
            "name": "search_text",
            "in": "query",
            "description": "Busca por texto (Short Track)",
            "required": false,
            "schema": {
              "type": "string",
              "example": "Validação Short Track"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de pendências",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/pendenciaResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/data-sources/e/HSFA_TAREFA/finders/c84b2597-09da-4c01-b817-1ff7e5c95eb9/results": {
      "get": {
        "tags": [
          "tarefas"
        ],
        "summary": "Listar tarefas",
        "description": "Lista registros de tarefas utilizando os filtros, paginação e ordenações suportados pelo finder.",
        "operationId": "getTarefas",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Quantidade máxima de itens retornados",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 100
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Posição inicial da busca (para paginação)",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 1
            }
          },
          {
            "name": "sdir",
            "in": "query",
            "description": "Direção da ordenação: 1 = crescente, -1 = decrescente",
            "required": true,
            "schema": {
              "type": "integer",
              "enum": [
                1,
                -1
              ]
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Campo usado na ordenação (0 = Status, 1 = Tipo de Tarefa, 2 = Título, 3 = Data prevista, 4 = Data Início, 5 = Data Fim, 6 = Inativo)",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6,
              "example": 0
            }
          },
          {
            "name": "param.title",
            "in": "query",
            "description": "Filtra tarefas cujo título contenha o texto informado. Formato INPAAS: $contains|valor",
            "required": false,
            "schema": {
              "type": "string",
              "example": "$contains|reunião"
            }
          },
          {
            "name": "param.description",
            "in": "query",
            "description": "Filtro de descrição da tarefa. Formato INPAAS: $contains|valor",
            "required": false,
            "schema": {
              "type": "string",
              "example": "$contains|teste"
            }
          },
          {
            "name": "param.duedate",
            "in": "query",
            "description": "Filtra por intervalo de datas previstas. Formato INPAAS: $bt|dataInicial|dataFinal",
            "required": false,
            "schema": {
              "type": "string",
              "example": "$bt|2025-12-11T00:00:00-03:00|2026-01-30T23:59:59-03:00"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de tarefas retornada com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/tarefaResponse"
                }
              }
            }
          },
          "400": {
            "description": "Requisição inválida"
          },
          "500": {
            "description": "Erro interno no servidor"
          }
        }
      },
      "post": {
        "tags": [
          "tarefas"
        ],
        "summary": "Criar tarefa",
        "description": "Executa uma ação de Criar Tarefa",
        "operationId": "createTarefa",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/tarefaResponse"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Tarefa criada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/postResponse"
                }
              }
            }
          }
        }
      }
    },
