  "tags": [
    {
      "name": "pendencias",
      "description": "Operações relacionadas às pendências do usuário"
    },
    {
      "name": "tarefas",
      "description": "Operações para Tarefas (listar, criar, atualizar, obter por id)"
    },
    {
      "name": "leads",
      "description": "Operações para Leads"
    },
    {
