{
  "openapi": "3.1.0",
  "info": {
    "title": "ilook Face Analysis API",
    "version": "1.3.0",
    "description": "Subjective face-shape, face score, approximate Golden Ratio phi score, and focused free-measurement outputs for user-submitted photos. Bearer API requests are processed transiently and are not stored in private history.",
    "x-jentic-source-url": "https://www.ilook.fit/openapi.json"
  },
  "servers": [
    {
      "url": "https://www.ilook.fit"
    }
  ],
  "paths": {
    "/api/v1/score": {
      "post": {
        "operationId": "scoreFace",
        "summary": "Analyze one user-submitted face photo",
        "security": [
          {
            "BearerApiKey": []
          },
          {}
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "image",
                  "adult_and_authorized"
                ],
                "properties": {
                  "image": {
                    "type": "string",
                    "format": "binary"
                  },
                  "adult_and_authorized": {
                    "type": "string",
                    "const": "true"
                  },
                  "measurement_key": {
                    "type": "string",
                    "enum": [
                      "face_shape_detector",
                      "jawline_rating",
                      "canthal_tilt",
                      "eye_shape",
                      "face_age_cues",
                      "facial_symmetry",
                      "golden_ratio_face",
                      "attractiveness_test",
                      "psl_score",
                      "facial_ratios",
                      "color_analysis",
                      "skin_analysis",
                      "hairstyle_finder"
                    ],
                    "description": "Optional. Return only this focused free-tool output instead of the full score report."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Structured subjective appearance report",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ScoreReport"
                    },
                    {
                      "$ref": "#/components/schemas/FocusedMeasurementReport"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "415": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          },
          "504": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/tools/{tool}": {
      "post": {
        "operationId": "analyzeFocusedTool",
        "summary": "Run one focused free-tool analysis",
        "description": "A stable, tool-specific alias for POST /api/v1/score with measurement_key. Use a concrete path such as /api/v1/tools/jawline_rating or /api/v1/tools/golden_ratio_face.",
        "security": [
          {
            "BearerApiKey": []
          },
          {}
        ],
        "parameters": [
          {
            "name": "tool",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "face_shape_detector",
                "jawline_rating",
                "canthal_tilt",
                "eye_shape",
                "face_age_cues",
                "facial_symmetry",
                "golden_ratio_face",
                "attractiveness_test",
                "psl_score",
                "facial_ratios",
                "color_analysis",
                "skin_analysis",
                "hairstyle_finder"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "image",
                  "adult_and_authorized"
                ],
                "properties": {
                  "image": {
                    "type": "string",
                    "format": "binary"
                  },
                  "adult_and_authorized": {
                    "type": "string",
                    "const": "true"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Focused tool report",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FocusedMeasurementReport"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "415": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          },
          "504": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerApiKey": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "FaceShape": {
        "type": "object",
        "required": [
          "category",
          "description"
        ],
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "oval",
              "round",
              "square",
              "oblong",
              "heart",
              "diamond",
              "triangle",
              "unclear"
            ]
          },
          "description": {
            "type": "string"
          }
        }
      },
      "Scores": {
        "type": "object",
        "required": [
          "facial_harmony",
          "symmetry",
          "jawline_structure",
          "skin_appearance",
          "eyes_brows"
        ],
        "properties": {
          "facial_harmony": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          },
          "symmetry": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          },
          "jawline_structure": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          },
          "skin_appearance": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          },
          "eyes_brows": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          }
        }
      },
      "ScoreExplanations": {
        "type": "object",
        "required": [
          "facial_harmony",
          "symmetry",
          "jawline_structure",
          "skin_appearance",
          "eyes_brows"
        ],
        "properties": {
          "facial_harmony": {
            "type": "string",
            "description": "One concise neutral sentence explaining the visible basis for this score."
          },
          "symmetry": {
            "type": "string",
            "description": "One concise neutral sentence explaining the visible basis for this score."
          },
          "jawline_structure": {
            "type": "string",
            "description": "One concise neutral sentence explaining the visible basis for this score."
          },
          "skin_appearance": {
            "type": "string",
            "description": "One concise neutral sentence explaining the visible basis for this score."
          },
          "eyes_brows": {
            "type": "string",
            "description": "One concise neutral sentence explaining the visible basis for this score."
          }
        }
      },
      "PhiScore": {
        "type": "object",
        "required": [
          "score",
          "reference_ratio",
          "explanation"
        ],
        "properties": {
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "description": "Approximate visible Golden Ratio fit score out of 100."
          },
          "reference_ratio": {
            "type": "number",
            "const": 1.618,
            "description": "The Golden Ratio reference value used for interpretation."
          },
          "explanation": {
            "type": "string",
            "description": "One concise neutral sentence explaining the visible basis for the phi score."
          }
        }
      },
      "MeasurementResult": {
        "type": "object",
        "required": [
          "score",
          "label",
          "analysis",
          "details"
        ],
        "properties": {
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "description": "Tool-specific score out of 100."
          },
          "label": {
            "type": "string",
            "description": "Short visible-result label or category for the tool."
          },
          "analysis": {
            "type": "string",
            "description": "One concise neutral sentence explaining the visible basis for the tool result."
          },
          "details": {
            "type": "array",
            "description": "Stable tool-specific report rows mirroring the public analyzer output, such as Left Eye Tilt, Facial Thirds, PSL-Style Range, or Best Overall Direction.",
            "items": {
              "type": "object",
              "required": [
                "name",
                "value",
                "analysis"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                },
                "reference": {
                  "type": "string"
                },
                "analysis": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "Measurements": {
        "type": "object",
        "required": [
          "face_shape_detector",
          "jawline_rating",
          "canthal_tilt",
          "eye_shape",
          "face_age_cues",
          "facial_symmetry",
          "golden_ratio_face",
          "attractiveness_test",
          "psl_score",
          "facial_ratios",
          "color_analysis",
          "skin_analysis",
          "hairstyle_finder"
        ],
        "properties": {
          "face_shape_detector": {
            "$ref": "#/components/schemas/MeasurementResult"
          },
          "jawline_rating": {
            "$ref": "#/components/schemas/MeasurementResult"
          },
          "canthal_tilt": {
            "$ref": "#/components/schemas/MeasurementResult"
          },
          "eye_shape": {
            "$ref": "#/components/schemas/MeasurementResult"
          },
          "face_age_cues": {
            "$ref": "#/components/schemas/MeasurementResult",
            "description": "18+ presentation cues. Not exact age prediction or age verification."
          },
          "facial_symmetry": {
            "$ref": "#/components/schemas/MeasurementResult"
          },
          "golden_ratio_face": {
            "$ref": "#/components/schemas/MeasurementResult"
          },
          "attractiveness_test": {
            "$ref": "#/components/schemas/MeasurementResult",
            "description": "Subjective photo-level appearance feedback."
          },
          "psl_score": {
            "$ref": "#/components/schemas/MeasurementResult",
            "description": "Broad PSL-style range without false precision."
          },
          "facial_ratios": {
            "$ref": "#/components/schemas/MeasurementResult"
          },
          "color_analysis": {
            "$ref": "#/components/schemas/MeasurementResult",
            "description": "Style-oriented lighting and palette cues without protected-trait or health inference."
          },
          "skin_analysis": {
            "$ref": "#/components/schemas/MeasurementResult",
            "description": "Appearance-only skin visibility cues, not medical advice or diagnosis."
          },
          "hairstyle_finder": {
            "$ref": "#/components/schemas/MeasurementResult"
          }
        }
      },
      "ScoreReport": {
        "type": "object",
        "required": [
          "analysis_id",
          "rubric_version",
          "model",
          "overall_score",
          "overall_score_100",
          "scores",
          "score_explanations",
          "face_shape",
          "phi_score",
          "measurements",
          "summary",
          "confidence",
          "disclaimer"
        ],
        "properties": {
          "analysis_id": {
            "type": "string",
            "format": "uuid"
          },
          "rubric_version": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "overall_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          },
          "overall_score_100": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "scores": {
            "$ref": "#/components/schemas/Scores"
          },
          "score_explanations": {
            "$ref": "#/components/schemas/ScoreExplanations"
          },
          "face_shape": {
            "$ref": "#/components/schemas/FaceShape"
          },
          "phi_score": {
            "$ref": "#/components/schemas/PhiScore"
          },
          "measurements": {
            "$ref": "#/components/schemas/Measurements"
          },
          "summary": {
            "type": "string"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "disclaimer": {
            "type": "string"
          }
        }
      },
      "FocusedMeasurementReport": {
        "type": "object",
        "required": [
          "analysis_id",
          "rubric_version",
          "model",
          "tool",
          "measurement",
          "disclaimer"
        ],
        "properties": {
          "analysis_id": {
            "type": "string",
            "format": "uuid"
          },
          "rubric_version": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "tool": {
            "type": "string",
            "enum": [
              "face_shape_detector",
              "jawline_rating",
              "canthal_tilt",
              "eye_shape",
              "face_age_cues",
              "facial_symmetry",
              "golden_ratio_face",
              "attractiveness_test",
              "psl_score",
              "facial_ratios",
              "color_analysis",
              "skin_analysis",
              "hairstyle_finder"
            ]
          },
          "measurement": {
            "$ref": "#/components/schemas/MeasurementResult"
          },
          "face_shape": {
            "$ref": "#/components/schemas/FaceShape",
            "description": "Included for face_shape_detector focused responses."
          },
          "phi_score": {
            "$ref": "#/components/schemas/PhiScore",
            "description": "Included for golden_ratio_face focused responses."
          },
          "disclaimer": {
            "type": "string"
          }
        }
      }
    },
    "responses": {
      "Error": {
        "description": "Stable error response",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "error"
              ],
              "properties": {
                "error": {
                  "type": "object",
                  "required": [
                    "code",
                    "message"
                  ],
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}