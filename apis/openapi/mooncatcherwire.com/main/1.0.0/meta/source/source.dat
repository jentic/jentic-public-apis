{
 "openapi": "3.1.0",
 "info": {
  "title": "Moon Catcher Wire REST API",
  "version": "1.0.0",
  "description": "The crypto news board at https://mooncatcherwire.com, as JSON. The same stories, and the same editorial decisions, as the page, the feeds and the MCP server. Read-only."
 },
 "servers": [
  {
   "url": "https://mooncatcherwire.com/api/v1"
  }
 ],
 "externalDocs": {
  "description": "How to get credentials (auth.md)",
  "url": "https://mooncatcherwire.com/auth.md"
 },
 "paths": {
  "/stories": {
   "get": {
    "operationId": "listStories",
    "summary": "Stories on the current board, strongest market impact first",
    "security": [
     {
      "portalKey": []
     }
    ],
    "parameters": [
     {
      "name": "ticker",
      "in": "query",
      "schema": {
       "type": "string"
      },
      "description": "e.g. BTC"
     },
     {
      "name": "topic",
      "in": "query",
      "schema": {
       "type": "string"
      },
      "description": "A slug from /topics."
     },
     {
      "name": "since_hours",
      "in": "query",
      "schema": {
       "type": "number",
       "minimum": 0
      }
     },
     {
      "name": "breaking_only",
      "in": "query",
      "schema": {
       "type": "string",
       "enum": [
        "true"
       ]
      }
     },
     {
      "name": "limit",
      "in": "query",
      "schema": {
       "type": "integer",
       "minimum": 1,
       "maximum": 60,
       "default": 20
      }
     }
    ],
    "responses": {
     "200": {
      "description": "The matching stories.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "generated_at_unix": {
           "type": [
            "integer",
            "null"
           ]
          },
          "mood": {
           "type": [
            "string",
            "null"
           ]
          },
          "withheld_by_editors": {
           "type": "integer",
           "description": "Stories an editor took off the board; they are not served."
          },
          "matched": {
           "type": "integer"
          },
          "stories": {
           "type": "array",
           "items": {
            "$ref": "#/components/schemas/Story"
           }
          }
         },
         "required": [
          "matched",
          "stories"
         ]
        }
       }
      }
     },
     "400": {
      "description": "Unknown topic.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "401": {
      "description": "Missing, unknown or revoked API key.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "502": {
      "description": "The upstream board could not be read.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  },
  "/topics": {
   "get": {
    "operationId": "listTopics",
    "summary": "The topic rules the stories endpoint filters by",
    "security": [],
    "responses": {
     "200": {
      "description": "Every topic.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "topics": {
           "type": "array",
           "items": {
            "$ref": "#/components/schemas/Topic"
           }
          },
          "note": {
           "type": "string"
          }
         },
         "required": [
          "topics"
         ]
        }
       }
      }
     }
    }
   }
  }
 },
 "components": {
  "securitySchemes": {
   "portalKey": {
    "type": "http",
    "scheme": "bearer",
    "description": "An API key (mcw_…) the account holder makes in https://mooncatcherwire.com/portal. Not an OAuth token: those are for the MCP server, scope news:read. See https://mooncatcherwire.com/auth.md."
   }
  },
  "schemas": {
   "Story": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "headline": {
      "type": "string"
     },
     "headline_drudge": {
      "type": [
       "string",
       "null"
      ],
      "description": "The drudge-style rewrite shown on the board."
     },
     "summary": {
      "type": [
       "string",
       "null"
      ]
     },
     "url": {
      "type": [
       "string",
       "null"
      ],
      "format": "uri"
     },
     "source": {
      "type": [
       "string",
       "null"
      ],
      "description": "Publisher domain."
     },
     "source_title": {
      "type": [
       "string",
       "null"
      ]
     },
     "credibility": {
      "type": [
       "number",
       "null"
      ]
     },
     "tickers": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "asset_primary": {
      "type": [
       "string",
       "null"
      ]
     },
     "sentiment": {
      "type": [
       "number",
       "null"
      ],
      "description": "-1 bearish to +1 bullish, as scored upstream."
     },
     "confidence": {
      "type": [
       "number",
       "null"
      ]
     },
     "impact": {
      "type": [
       "number",
       "null"
      ],
      "description": "0-1, how market-moving the pipeline judged it."
     },
     "is_breaking": {
      "type": "boolean"
     },
     "tsp_review_state": {
      "type": [
       "string",
       "null"
      ],
      "description": "The upstream pipeline's own verdict."
     },
     "published_at": {
      "type": [
       "string",
       "null"
      ],
      "description": "UTC, ISO 8601."
     },
     "fetched_at": {
      "type": [
       "integer",
       "null"
      ],
      "description": "Unix seconds."
     },
     "editor_state": {
      "type": [
       "string",
       "null"
      ],
      "enum": [
       "live",
       null
      ]
     }
    },
    "required": [
     "id",
     "headline",
     "tickers",
     "is_breaking"
    ]
   },
   "Topic": {
    "type": "object",
    "properties": {
     "slug": {
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "tickers": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "pattern": {
      "type": [
       "string",
       "null"
      ],
      "description": "Case-insensitive regex over headline and summary."
     }
    },
    "required": [
     "slug",
     "title",
     "tickers"
    ]
   },
   "Error": {
    "type": "object",
    "properties": {
     "error": {
      "type": "string"
     },
     "detail": {
      "type": "string"
     }
    },
    "required": [
     "error"
    ]
   }
  }
 }
}