    "/mcp/server-card": {
      "get": {
        "tags": [
          "Descoberta"
        ],
        "operationId": "obterServerCard",
        "summary": "Server card MCP (endereço canônico do card).",
        "description": "Mesmo documento de /.well-known/mcp, servido como application/mcp-server-card+json.",
        "security": [],
        "responses": {
          "200": {
            "description": "Server card.",
            "content": {
              "application/mcp-server-card+json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerCard"
                }
              }
            }
          },
          "405": {
            "description": "Método não suportado. A rota responde apenas a GET, HEAD e OPTIONS. O corpo segue o RFC 9457 (application/problem+json) e o header Allow lista o que é aceito.",
            "headers": {
              "Allow": {
                "description": "Métodos que o recurso aceita (sempre \"GET, HEAD, OPTIONS\" aqui).",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "tags": [
          "Descoberta"
        ],
        "operationId": "obterSpecOpenapi",
        "summary": "Este documento (OpenAPI 3.1 da superfície pública).",
        "description": "Servido em application/vnd.oai.openapi+json. Público, sem autenticação, estático e determinístico. O documento é auto-descritivo: lista exatamente o que é contrato público — e o que NÃO é (as APIs internas do aplicativo autenticado ficam de fora de propósito).",
        "security": [],
        "responses": {
          "200": {
            "description": "Este documento.",
            "content": {
              "application/vnd.oai.openapi+json": {
                "schema": {
                  "type": "object",
                  "description": "Documento OpenAPI 3.1 (auto-referente).",
                  "additionalProperties": true
                }
              }
            }
          },
          "405": {
            "description": "Método não suportado. A rota responde apenas a GET, HEAD e OPTIONS. O corpo segue o RFC 9457 (application/problem+json) e o header Allow lista o que é aceito.",
            "headers": {
              "Allow": {
                "description": "Métodos que o recurso aceita (sempre \"GET, HEAD, OPTIONS\" aqui).",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          }
        }
      }
    },
    "/v1/openapi.json": {
