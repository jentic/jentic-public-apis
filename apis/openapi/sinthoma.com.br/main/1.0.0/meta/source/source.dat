  },
  "components": {
    "securitySchemes": {
      "token_pessoal": {
        "type": "http",
        "scheme": "bearer",
        "description": "Token pessoal do Conector (`sinth_…`), criado pela própria profissional em Configurações → Conector dentro do Sinthoma. Não há criação via API: a emissão é self-service dentro do produto, por design (auditoria e revogação)."
      },
      "oauth2": {
        "type": "oauth2",
        "description": "OAuth 2.0 com PKCE (S256) e consentimento do profissional. Registro de cliente em /oauth/register (RFC 7591); metadados completos em /.well-known/oauth-authorization-server.",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://sinthoma.com.br/oauth/authorize",
            "tokenUrl": "https://sinthoma.com.br/oauth/token",
            "refreshUrl": "https://sinthoma.com.br/oauth/token",
            "scopes": {
              "pacientes:ler": "Ver a lista dos seus pacientes — nome, data da última sessão e total de sessões.",
              "sessoes:ler": "Ler trechos literais do que você escreveu nos registros de um paciente específico.",
              "preparo:ler": "Gerar a preparação de sessão de um paciente (usa análise de IA).",
              "offline_access": "Continuar conectado sem você precisar entrar de novo a cada uso."
            }
          }
        }
      }
    },
    "schemas": {
      "RequisicaoJsonRpc": {
        "type": "object",
        "required": [
          "jsonrpc",
          "method"
        ],
        "properties": {
          "jsonrpc": {
            "type": "string",
            "const": "2.0"
          },
          "id": {
            "description": "Id da requisição (número ou string). Ausente em notificações.",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "method": {
            "type": "string",
            "description": "Método do protocolo MCP.",
            "enum": [
              "initialize",
              "notifications/initialized",
              "tools/list",
              "tools/call",
              "ping"
            ]
          },
          "params": {
            "type": "object",
            "description": "Parâmetros do método. Em tools/call: { name, arguments } com os nomes e esquemas em components.schemas.FerramentasMcp.",
            "additionalProperties": true
          }
        }
      },
      "RespostaJsonRpc": {
        "type": "object",
        "required": [
          "jsonrpc",
          "id"
        ],
        "properties": {
          "jsonrpc": {
            "type": "string",
            "const": "2.0"
          },
          "id": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "result": {
            "type": "object",
            "additionalProperties": true
          },
          "error": {
            "$ref": "#/components/schemas/JsonRpcErro"
          }
        }
      },
      "JsonRpcErro": {
        "type": "object",
        "required": [
          "jsonrpc",
          "error"
        ],
        "properties": {
          "jsonrpc": {
            "type": "string",
            "const": "2.0"
          },
          "id": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "integer"
              },
              "message": {
                "type": "string"
              },
              "data": {}
            }
          }
        }
      },
      "ErroOAuth": {
        "type": "object",
        "title": "Erro OAuth (RFC 6750)",
        "description": "Corpo do 401/403 na ENTRADA do endpoint MCP, antes de a requisição chegar ao servidor MCP: o formato é o do OAuth 2.0 Bearer (RFC 6750 §3) — e NÃO o envelope JSON-RPC. O formato é contrato: consumidores OAuth dependem dele para interpretar o desafio junto com o header WWW-Authenticate. Não carrega stack trace, caminho de arquivo ou detalhe de infraestrutura — por design.",
        "required": [
          "error",
          "error_description"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "Código do erro OAuth; `invalid_token` para credencial ausente ou inválida."
          },
          "error_description": {
            "type": "string",
            "description": "Descrição curta e estável do motivo."
          }
        }
      },
      "Problema": {
        "type": "object",
        "title": "Problema HTTP (RFC 9457)",
        "description": "Corpo `application/problem+json` dos erros das rotas de descoberta — hoje, o 405 de método não suportado. Nunca carrega stack trace, caminho de arquivo ou detalhe de infraestrutura.",
        "required": [
          "type",
          "title",
          "status"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri-reference",
            "description": "URI que identifica o tipo do problema; aponta a documentação em /developers."
          },
          "title": {
            "type": "string",
            "description": "Resumo curto e estável do problema."
          },
          "status": {
            "type": "integer",
            "description": "O mesmo código de status HTTP da resposta."
          },
          "detail": {
            "type": "string",
            "description": "Explicação legível específica desta ocorrência."
          },
          "instance": {
            "type": "string",
            "format": "uri-reference",
            "description": "Caminho da requisição que gerou o problema."
          }
        }
      },
      "FerramentasMcp": {
        "type": "object",
        "description": "As três ferramentas MCP (todas somente leitura). O esquema executável é o inputSchema devolvido por tools/list; aqui está o nível já documentado ao usuário. Conteúdo de resposta é texto para o assistente, com o trecho do prontuário da própria profissional.",
        "properties": {
          "listar_pacientes_recentes": {
            "type": "object",
            "description": "Lista os pacientes do profissional ordenados pela sessão mais recente. Devolve apenas nome, data da última sessão e total de sessões — nunca CPF, telefone, e-mail ou dado de cobrança.",
            "properties": {
              "limite": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20,
                "description": "Quantos pacientes trazer (padrão 10)."
              }
            }
          },
          "buscar_registros_do_paciente": {
            "type": "object",
            "description": "Busca um termo nos registros de UM paciente e devolve TRECHOS LITERAIS do que o profissional escreveu, com a sessão e a data de origem. Não resume e não interpreta. Exige consentimento de uso de IA do paciente.",
            "properties": {
              "paciente_id": {
                "type": "string",
                "format": "uuid",
                "description": "Id do paciente. Um paciente por vez."
              },
              "termo": {
                "type": "string",
                "description": "Palavra ou expressão a procurar. Busca literal, sem curingas."
              },
              "limite": {
                "type": "integer",
                "minimum": 1,
                "description": "Quantidade máxima de trechos."
              }
            }
          },
          "preparar_sessao": {
            "type": "object",
            "description": "Monta o briefing de preparação para a próxima sessão de um paciente, usando o mesmo mecanismo que o aplicativo já usa. Exige consentimento de uso de IA.",
            "properties": {
              "paciente_id": {
                "type": "string",
                "format": "uuid",
                "description": "Id do paciente."
              }
            }
          }
        }
      },
      "MetadadosRecursoProtegido": {
        "type": "object",
        "required": [
          "resource",
          "authorization_servers"
        ],
        "properties": {
          "resource": {
            "type": "string",
            "description": "URI do recurso (…/api/mcp)."
          },
          "resource_name": {
            "type": "string"
          },
          "scopes_supported": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "pacientes:ler",
                "sessoes:ler",
                "preparo:ler"
              ]
            }
          },
          "bearer_methods_supported": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Sempre [\"header\"]: token no cabeçalho Authorization."
          },
          "authorization_servers": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "description": "Aponta para a origem, que publica o metadado RFC 8414."
          }
        },
        "additionalProperties": true
      },
      "MetadadosServidorAutorizacao": {
        "type": "object",
        "required": [
          "issuer",
          "response_types_supported",
          "authorization_endpoint",
          "token_endpoint"
        ],
        "properties": {
          "issuer": {
            "type": "string",
            "format": "uri"
          },
          "authorization_endpoint": {
            "type": "string",
            "format": "uri"
          },
          "token_endpoint": {
            "type": "string",
            "format": "uri"
          },
          "registration_endpoint": {
            "type": "string",
            "format": "uri",
            "description": "Registro dinâmico de cliente (RFC 7591)."
          },
          "response_types_supported": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "grant_types_supported": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "code_challenge_methods_supported": {
