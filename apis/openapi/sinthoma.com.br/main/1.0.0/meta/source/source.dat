{
  "openapi": "3.1.0",
  "info": {
    "title": "Sinthoma — superfície pública para agentes (Conector MCP)",
    "version": "1.0.0",
    "x-politica-versao": "https://sinthoma.com.br/developers",
    "summary": "Descoberta, metadados OAuth e transporte MCP somente leitura.",
    "description": "Superfície pública do Sinthoma para agentes de IA. O produto é um prontuário clínico para psicólogos; o acesso de agentes ao dado clínico existe apenas via MCP (Conector), sempre autenticado, somente leitura, com consentimento do paciente e auditoria. Este documento descreve a descoberta e o transporte — e nunca cataloga as APIs internas do aplicativo autenticado. Documentação para humanas: /conector; índice para agentes: /llms.txt.",
    "termsOfService": "https://sinthoma.com.br/termos",
    "contact": {
      "name": "Suporte Sinthoma",
      "url": "https://sinthoma.com.br/contato"
    },
    "license": {
      "name": "Uso do serviço conforme Termos de uso",
      "url": "https://sinthoma.com.br/termos"
    }
  },
  "servers": [
    {
      "url": "https://sinthoma.com.br",
      "description": "Produção"
    }
  ],
  "tags": [
    {
      "name": "MCP",
      "description": "Transporte Streamable HTTP do Conector (autenticado)."
    },
    {
      "name": "Descoberta",
      "description": "Metadados públicos: OAuth e server card MCP."
    }
  ],
  "paths": {
    "/api/mcp": {
      "post": {
        "tags": [
          "MCP"
        ],
        "operationId": "chamarTransporteMcp",
        "summary": "Endpoint MCP (Streamable HTTP, JSON-RPC 2.0) — autenticado.",
        "description": "Transporte Streamable HTTP do servidor MCP do Conector Sinthoma, em modo stateless. Autenticação: token pessoal `sinth_…` (Bearer) ou OAuth 2.0 (fluxo por consentimento; metadados em /.well-known/oauth-authorization-server). A descoberta das ferramentas é feita pelo próprio protocolo: chame `initialize`, depois `tools/list` e `tools/call`. Cada ferramenta exige o escopo indicado em components.schemas.FerramentasMcp e tem quota por token (429 quando esgotada). Toda leitura é auditada; nada escreve no prontuário.",
        "security": [
          {
            "token_pessoal": []
          },
          {
            "oauth2": [
              "pacientes:ler",
              "sessoes:ler",
              "preparo:ler"
            ]
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequisicaoJsonRpc"
              },
              "examples": {
                "initialize": {
                  "summary": "Handshake do protocolo MCP",
                  "value": {
                    "jsonrpc": "2.0",
                    "id": 1,
                    "method": "initialize",
                    "params": {
                      "protocolVersion": "2026-07-28",
                      "capabilities": {},
                      "clientInfo": {
                        "name": "agente-exemplo",
                        "version": "1.0.0"
                      }
                    }
                  }
                },
                "toolsList": {
                  "summary": "Listar as ferramentas disponíveis",
                  "value": {
                    "jsonrpc": "2.0",
                    "id": 2,
                    "method": "tools/list"
                  }
                },
                "toolsCall": {
                  "summary": "Chamar uma ferramenta",
                  "value": {
                    "jsonrpc": "2.0",
                    "id": 3,
                    "method": "tools/call",
                    "params": {
                      "name": "listar_pacientes_recentes",
                      "arguments": {
                        "limite": 5
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resposta JSON-RPC 2.0 (ou stream SSE para respostas longas). O campo `result` segue o protocolo MCP; em `tools/call`, erros de negócio vêm como `isError: true` dentro do resultado, não como status HTTP.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaJsonRpc"
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "Stream SSE do Streamable HTTP."
                }
              }
            }
          },
          "401": {
            "description": "Sem credencial ou credencial inválida. O header WWW-Authenticate aponta os metadados do recurso (RFC 9728) em /.well-known/oauth-protected-resource. O corpo segue o RFC 6750 (formato OAuth), não o envelope JSON-RPC — o erro acontece antes de a requisição chegar ao servidor MCP.",
            "headers": {
              "WWW-Authenticate": {
                "description": "Desafio Bearer com resource_metadata.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroOAuth"
                }
              }
            }
          },
          "403": {
            "description": "Credencial válida sem o escopo exigido pela ferramenta, ou recusa por falta de consentimento do paciente para uso de IA (a recusa é registrada). Mesmo formato OAuth do 401 (RFC 6750).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroOAuth"
                }
              }
            }
          },
          "429": {
            "description": "Limite de chamadas do token atingido (quota e rate limit por token). Aguarde e tente de novo; não é erro.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonRpcErro"
                }
              }
            }
          }
        }
      }
    },
    "/.well-known/oauth-protected-resource": {
      "get": {
        "tags": [
          "Descoberta"
        ],
        "operationId": "obterMetadadosRecursoProtegido",
        "summary": "Metadados do recurso protegido (RFC 9728).",
        "description": "Descreve o recurso /api/mcp: escopos, métodos de bearer suportados e onde está o servidor de autorização. Público, sem autenticação.",
        "security": [],
        "responses": {
          "200": {
            "description": "Documento RFC 9728.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetadadosRecursoProtegido"
                }
              }
            }
          },
          "405": {
            "description": "Método não suportado. A rota responde apenas a GET, HEAD e OPTIONS. O corpo segue o RFC 9457 (application/problem+json) e o header Allow lista o que é aceito.",
            "headers": {
              "Allow": {
                "description": "Métodos que o recurso aceita (sempre \"GET, HEAD, OPTIONS\" aqui).",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          }
        }
      }
    },
    "/.well-known/oauth-protected-resource/api/mcp": {
      "get": {
        "tags": [
          "Descoberta"
        ],
        "operationId": "obterMetadadosRecursoProtegidoApiMcp",
        "summary": "Metadados do recurso protegido com o sufixo do caminho (RFC 9728 §3.1).",
        "description": "Mesmo documento do endereço raiz, no formato derivado que insere o caminho do recurso depois de .well-known. Servimos os dois.",
        "security": [],
        "responses": {
          "200": {
            "description": "Documento RFC 9728.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetadadosRecursoProtegido"
                }
              }
            }
          },
          "405": {
            "description": "Método não suportado. A rota responde apenas a GET, HEAD e OPTIONS. O corpo segue o RFC 9457 (application/problem+json) e o header Allow lista o que é aceito.",
            "headers": {
              "Allow": {
                "description": "Métodos que o recurso aceita (sempre \"GET, HEAD, OPTIONS\" aqui).",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          }
        }
      }
    },
    "/.well-known/oauth-authorization-server": {
      "get": {
        "tags": [
          "Descoberta"
        ],
        "operationId": "obterMetadadosServidorAutorizacao",
        "summary": "Metadados do servidor de autorização (RFC 8414).",
        "description": "Endpoints authorize/token/register, PKCE S256 obrigatório e escopos suportados. Público, sem autenticação.",
        "security": [],
        "responses": {
          "200": {
            "description": "Documento RFC 8414.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetadadosServidorAutorizacao"
                }
              }
            }
          },
          "405": {
            "description": "Método não suportado. A rota responde apenas a GET, HEAD e OPTIONS. O corpo segue o RFC 9457 (application/problem+json) e o header Allow lista o que é aceito.",
            "headers": {
              "Allow": {
                "description": "Métodos que o recurso aceita (sempre \"GET, HEAD, OPTIONS\" aqui).",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          }
        }
      }
    },
    "/.well-known/mcp": {
      "get": {
        "tags": [
          "Descoberta"
        ],
        "operationId": "obterServerCardWellKnown",
        "summary": "Server card MCP por descoberta de domínio.",
        "description": "Card público do servidor MCP do Conector: nome, descrição, versão e endereço remoto. Não exige autenticação.",
        "security": [],
        "responses": {
          "200": {
            "description": "Server card (application/json).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerCard"
                }
              }
            }
          },
          "405": {
            "description": "Método não suportado. A rota responde apenas a GET, HEAD e OPTIONS. O corpo segue o RFC 9457 (application/problem+json) e o header Allow lista o que é aceito.",
            "headers": {
              "Allow": {
                "description": "Métodos que o recurso aceita (sempre \"GET, HEAD, OPTIONS\" aqui).",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            }
          }
        }
      }
