            }
          },
          "application/xml": {
            "schema": {
              "$ref": "#/components/schemas/RelationshipSchemas"
            }
          }
        }
      },
      "RelationshipSchema": {
        "description": "RelationshipSchema",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/RelationshipSchema"
            }
          },
          "application/xml": {
            "schema": {
              "$ref": "#/components/schemas/RelationshipSchema"
            }
          }
        }
      },
      "RecordsRequest": {
        "description": "Records Request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/RecordsRequest"
            }
          },
          "application/xml": {
            "schema": {
              "$ref": "#/components/schemas/RecordsRequest"
            }
          }
        }
      },
      "RecordRequest": {
