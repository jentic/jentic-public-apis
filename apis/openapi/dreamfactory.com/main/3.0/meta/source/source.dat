{
  "openapi": "3.0.0",
  "servers": [
    {
      "url": "https://smartbear.dreamfactory.com/smartbear-sqlserver/api/v2/sqlserver",
      "description": ""
    }
  ],
  "components": {
    "securitySchemes": {
      "BasicAuth": {
        "type": "http",
        "scheme": "basic"
      },
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      },
      "ApiKeyQuery": {
        "type": "apiKey",
        "in": "query",
        "name": "api_key"
      },
      "ApiKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-DreamFactory-API-Key"
      },
      "SessionTokenQuery": {
        "type": "apiKey",
        "in": "query",
        "name": "session_token"
      },
      "SessionTokenHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-DreamFactory-Session-Token"
      }
    },
    "responses": {
      "Success": {
        "description": "Success Response",
