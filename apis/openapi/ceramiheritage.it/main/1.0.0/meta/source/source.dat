{
  "openapi": "3.0.3",
  "info": {
    "title": "Cerami Heritage API",
    "description": "API Backend per il progetto \"Percorso Digitale/Virtuale per la Valorizzazione del Patrimonio Artistico e Culturale\" del Comune di Cerami (EN).\n\n## Funzionalità principali:\n- **Catalogo Digitale**: Gestione POI, opere d'arte, monumenti\n- **Itinerari AI**: Generazione percorsi personalizzati\n- **QR Code**: Scansione e linking contenuti\n- **Multilingua**: Supporto IT, EN, DE, FR, ES\n- **Eventi & News**: Gestione contenuti dinamici\n- **Accessibilità**: Audio descrizioni, impostazioni utente\n",
    "version": "1.0.0",
    "contact": {
      "name": "Comune di Cerami",
      "email": "info@comune.cerami.en.it"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/next-e11/cerami-heritage-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.ceramiheritage.it/v1",
      "description": "Production"
    }
  ],
  "tags": [
    {
      "name": "POI",
      "description": "Punti di interesse (chiese, palazzi, monumenti, piazze)"
    },
    {
      "name": "Artworks",
      "description": "Opere d'arte (dipinti, sculture, affreschi)"
    },
    {
      "name": "Itineraries",
      "description": "Generazione itinerari turistici con AI"
    },
    {
      "name": "QR Codes",
      "description": "Gestione QR code per luoghi e opere"
    },
    {
      "name": "Events",
      "description": "Eventi culturali e manifestazioni"
    },
    {
      "name": "News",
      "description": "Notizie e aggiornamenti"
    },
    {
      "name": "Audio",
      "description": "Audio descrizioni per accessibilità"
    },
    {
      "name": "Languages",
      "description": "Traduzioni e contenuti multilingua"
    },
    {
      "name": "Analytics",
      "description": "Statistiche di fruizione"
    },
    {
      "name": "CMS",
      "description": "Gestione contenuti (admin)"
    }
  ],
  "paths": {
    "/pois": {
      "get": {
        "tags": [
          "POI"
        ],
        "summary": "Lista tutti i POI",
        "description": "Restituisce tutti i punti di interesse con filtri opzionali",
        "parameters": [
          {
            "$ref": "#/components/parameters/LanguageHeader"
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "church",
                "palace",
                "monument",
                "square",
                "fountain",
                "viewpoint",
                "other"
              ]
            },
            "description": "Filtra per tipologia"
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "art",
                "architecture",
                "nature",
                "history",
                "religion"
              ]
            },
            "description": "Filtra per categoria tematica"
          },
          {
            "name": "lat",
            "in": "query",
            "schema": {
              "type": "number"
            },
            "description": "Latitudine per ordinamento per distanza"
          },
          {
            "name": "lon",
            "in": "query",
            "schema": {
              "type": "number"
            },
            "description": "Longitudine per ordinamento per distanza"
          },
          {
            "name": "radius",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 5000
            },
            "description": "Raggio in metri (default 5km)"
          }
        ],
        "responses": {
          "200": {
            "description": "Lista POI",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/POI"
                      }
                    },
                    "total": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/pois/{poiId}": {
      "get": {
        "tags": [
          "POI"
        ],
        "summary": "Dettaglio singolo POI",
        "parameters": [
          {
            "$ref": "#/components/parameters/LanguageHeader"
          },
          {
            "name": "poiId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Dettaglio POI",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/POIDetail"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/pois/{poiId}/artworks": {
      "get": {
        "tags": [
          "POI",
          "Artworks"
        ],
        "summary": "Opere d'arte in un POI",
        "description": "Restituisce tutte le opere d'arte contenute in un POI",
        "parameters": [
          {
            "$ref": "#/components/parameters/LanguageHeader"
          },
          {
            "name": "poiId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista opere",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Artwork"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/artworks": {
      "get": {
        "tags": [
          "Artworks"
        ],
        "summary": "Lista tutte le opere d'arte",
        "parameters": [
          {
            "$ref": "#/components/parameters/LanguageHeader"
          },
          {
            "name": "period",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Filtra per periodo (es: XVI secolo)"
          },
          {
            "name": "author",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Filtra per autore"
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "painting",
                "sculpture",
                "fresco",
                "mosaic",
                "tapestry",
                "other"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista opere",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Artwork"
                      }
                    },
                    "total": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/artworks/{artworkId}": {
      "get": {
        "tags": [
          "Artworks"
        ],
        "summary": "Dettaglio singola opera",
        "parameters": [
          {
            "$ref": "#/components/parameters/LanguageHeader"
          },
          {
            "name": "artworkId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Dettaglio opera",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArtworkDetail"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/itineraries/generate": {
      "post": {
        "tags": [
          "Itineraries"
        ],
        "summary": "Genera itinerario personalizzato con AI",
        "description": "Algoritmo AI che genera percorsi turistici ottimizzati basati su:\n- Tempo a disposizione\n- Preferenze tematiche\n- Posizione corrente\n- Accessibilità richiesta\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ItineraryRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Itinerario generato",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Itinerary"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    },
    "/itineraries/templates": {
      "get": {
        "tags": [
          "Itineraries"
        ],
        "summary": "Itinerari predefiniti",
        "description": "Lista di itinerari curati manualmente",
        "parameters": [
          {
            "$ref": "#/components/parameters/LanguageHeader"
          },
          {
            "name": "duration",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "short",
                "medium",
                "long"
              ]
            },
            "description": "Durata (short: <1h, medium: 1-3h, long: >3h)"
          },
          {
            "name": "theme",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "art",
                "architecture",
                "religion",
                "panoramic",
                "complete"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista itinerari",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ItineraryTemplate"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/itineraries/{itineraryId}": {
      "get": {
        "tags": [
          "Itineraries"
        ],
        "summary": "Dettaglio itinerario",
        "parameters": [
          {
            "$ref": "#/components/parameters/LanguageHeader"
          },
          {
            "name": "itineraryId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Dettaglio itinerario",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Itinerary"
                }
              }
            }
          }
        }
      }
    },
    "/qr/{qrCode}": {
      "get": {
        "tags": [
          "QR Codes"
        ],
        "summary": "Risolvi QR code",
        "description": "Dato un codice QR, restituisce il contenuto associato\n(POI, opera d'arte, o evento)\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/LanguageHeader"
          },
          {
            "name": "qrCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Codice QR scansionato"
          }
        ],
        "responses": {
          "200": {
            "description": "Contenuto associato al QR",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QRContent"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/qr/{qrCode}/scan": {
      "post": {
        "tags": [
          "QR Codes",
          "Analytics"
        ],
        "summary": "Registra scansione QR",
        "description": "Traccia la scansione per analytics (anonimizzato)",
        "parameters": [
          {
            "name": "qrCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "deviceType": {
                    "type": "string",
                    "enum": [
                      "mobile",
                      "totem",
                      "web"
                    ]
                  },
                  "language": {
                    "type": "string"
                  },
                  "timestamp": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Scansione registrata"
          }
        }
      }
    },
    "/events": {
      "get": {
        "tags": [
          "Events"
        ],
        "summary": "Lista eventi",
        "parameters": [
          {
            "$ref": "#/components/parameters/LanguageHeader"
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Data inizio (default oggi)"
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Data fine"
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "festival",
                "exhibition",
                "concert",
                "workshop",
                "tour",
                "other"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista eventi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Event"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/events/{eventId}": {
      "get": {
        "tags": [
          "Events"
        ],
        "summary": "Dettaglio evento",
        "parameters": [
          {
            "$ref": "#/components/parameters/LanguageHeader"
          },
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Dettaglio evento",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventDetail"
                }
              }
            }
          }
        }
      }
    },
    "/news": {
      "get": {
        "tags": [
          "News"
        ],
        "summary": "Lista notizie",
        "parameters": [
          {
            "$ref": "#/components/parameters/LanguageHeader"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 10
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista notizie",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/News"
                      }
                    },
                    "total": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/news/{newsId}": {
      "get": {
        "tags": [
          "News"
        ],
        "summary": "Dettaglio notizia",
        "parameters": [
          {
            "$ref": "#/components/parameters/LanguageHeader"
          },
          {
            "name": "newsId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Dettaglio notizia",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NewsDetail"
                }
              }
            }
          }
        }
      }
    },
    "/audio/{resourceType}/{resourceId}": {
      "get": {
        "tags": [
          "Audio"
        ],
        "summary": "Audio descrizione",
        "description": "Restituisce l'audio descrizione per un POI o opera (accessibilità)",
        "parameters": [
          {
            "$ref": "#/components/parameters/LanguageHeader"
          },
          {
            "name": "resourceType",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "poi",
                "artwork"
              ]
            }
          },
          {
            "name": "resourceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "URL audio",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "audioUrl": {
                      "type": "string",
                      "format": "uri"
                    },
                    "duration": {
                      "type": "integer",
                      "description": "Durata in secondi"
                    },
                    "transcript": {
                      "type": "string",
                      "description": "Trascrizione testuale"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/translations/{language}": {
      "get": {
        "tags": [
          "Languages"
        ],
        "summary": "Bundle traduzioni UI",
        "description": "Restituisce tutte le stringhe dell'interfaccia per una lingua",
        "parameters": [
          {
            "name": "language",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "it",
                "en",
                "de",
                "fr",
                "es"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Bundle traduzioni",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  },
                  "example": {
                    "discover_more": "Scopri di più",
                    "take_me_here": "Portami qui",
                    "filter_all": "Tutti"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/languages": {
      "get": {
        "tags": [
          "Languages"
        ],
        "summary": "Lingue supportate",
        "responses": {
          "200": {
            "description": "Lista lingue",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "code": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "flag": {
                        "type": "string"
                      }
                    }
                  },
                  "example": [
                    {
                      "code": "it",
                      "name": "Italiano",
                      "flag": "🇮🇹"
                    },
                    {
                      "code": "en",
                      "name": "English",
                      "flag": "🇬🇧"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/analytics/visits": {
      "get": {
        "tags": [
          "Analytics"
        ],
        "summary": "Statistiche visite",
        "description": "Statistiche aggregate (solo admin)",
        "security": [
          {
            "AdminAuth": []
          }
        ],
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "groupBy",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "day",
                "week",
                "month"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Statistiche",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalyticsReport"
                }
              }
            }
          }
        }
      }
    },
    "/analytics/popular": {
      "get": {
        "tags": [
          "Analytics"
        ],
        "summary": "Contenuti più visitati",
        "security": [
          {
            "AdminAuth": []
          }
        ],
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "poi",
                "artwork",
                "itinerary"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Classifica popolarità",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "views": {
                        "type": "integer"
                      },
                      "qrScans": {
                        "type": "integer"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/cms/pois": {
      "post": {
        "tags": [
          "CMS"
        ],
        "summary": "Crea nuovo POI",
        "security": [
          {
            "AdminAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/POICreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "POI creato",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/POI"
                }
              }
            }
          }
        }
      }
    },
    "/cms/pois/{poiId}": {
      "put": {
        "tags": [
          "CMS"
        ],
        "summary": "Aggiorna POI",
        "security": [
          {
            "AdminAuth": []
          }
        ],
        "parameters": [
          {
            "name": "poiId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/POICreate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "POI aggiornato"
          }
        }
      },
      "delete": {
        "tags": [
          "CMS"
        ],
        "summary": "Elimina POI",
        "security": [
          {
            "AdminAuth": []
          }
        ],
        "parameters": [
          {
            "name": "poiId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "POI eliminato"
          }
        }
      }
    },
    "/cms/artworks": {
      "post": {
        "tags": [
          "CMS"
        ],
        "summary": "Crea nuova opera",
        "security": [
          {
            "AdminAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ArtworkCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Opera creata"
          }
        }
      }
    },
    "/cms/media/upload": {
      "post": {
        "tags": [
          "CMS"
        ],
        "summary": "Upload immagine",
        "security": [
          {
            "AdminAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "poi",
                      "artwork",
                      "event",
                      "news"
                    ]
                  },
                  "resourceId": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Immagine caricata",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "thumbnailUrl": {
                      "type": "string",
                      "format": "uri"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "LanguageHeader": {
        "name": "Accept-Language",
        "in": "header",
        "schema": {
          "type": "string",
          "default": "it",
          "enum": [
            "it",
            "en",
            "de",
            "fr",
            "es"
          ]
        },
        "description": "Lingua per i contenuti"
      }
    },
    "schemas": {
      "POI": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "shortDescription": {
            "type": "string",
            "maxLength": 150
          },
          "type": {
            "type": "string",
            "enum": [
              "church",
              "palace",
              "monument",
              "square",
              "fountain",
              "viewpoint",
              "other"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "art",
              "architecture",
              "nature",
              "history",
              "religion"
            ]
          },
          "latitude": {
            "type": "number"
          },
          "longitude": {
            "type": "number"
          },
          "imageUrl": {
            "type": "string",
            "format": "uri"
          },
          "thumbnailUrl": {
            "type": "string",
            "format": "uri"
          },
          "artworksCount": {
            "type": "integer"
          },
          "hasAudioDescription": {
            "type": "boolean"
          },
          "qrCode": {
            "type": "string"
          }
        }
      },
      "POIDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/POI"
          },
          {
            "type": "object",
            "properties": {
              "history": {
                "type": "string"
              },
              "openingHours": {
                "type": "string"
              },
              "address": {
                "type": "string"
              },
              "accessibilityInfo": {
                "type": "string"
              },
              "images": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "caption": {
                      "type": "string"
                    }
                  }
                }
              },
              "artworks": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Artwork"
                }
              },
              "relatedPois": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/POI"
                }
              }
            }
          }
        ]
      },
      "POICreate": {
        "type": "object",
        "required": [
          "name",
          "latitude",
          "longitude",
          "type"
        ],
        "properties": {
          "name": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Nome per ogni lingua {it: '', en: '', ...}"
          },
          "description": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "type": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "latitude": {
            "type": "number"
          },
          "longitude": {
            "type": "number"
          }
        }
      },
      "Artwork": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "period": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "imageUrl": {
            "type": "string",
            "format": "uri"
          },
          "thumbnailUrl": {
            "type": "string",
            "format": "uri"
          },
          "poiId": {
            "type": "string"
          },
          "hasAudioDescription": {
            "type": "boolean"
          }
        }
      },
      "ArtworkDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Artwork"
          },
          {
            "type": "object",
            "properties": {
              "technique": {
                "type": "string"
              },
              "dimensions": {
                "type": "string"
              },
              "materials": {
                "type": "string"
              },
              "history": {
                "type": "string"
              },
              "curiosities": {
                "type": "string"
              },
              "bibliography": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "images": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string"
                    },
                    "caption": {
                      "type": "string"
                    }
                  }
                }
              },
              "relatedArtworks": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Artwork"
                }
              }
            }
          }
        ]
      },
      "ArtworkCreate": {
        "type": "object",
        "required": [
          "title",
          "poiId"
        ],
        "properties": {
          "title": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "author": {
            "type": "string"
          },
          "period": {
            "type": "string"
          },
          "description": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "poiId": {
            "type": "string"
          }
        }
      },
      "ItineraryRequest": {
        "type": "object",
        "required": [
          "duration"
        ],
        "properties": {
          "duration": {
            "type": "integer",
            "description": "Durata in minuti",
            "minimum": 30,
            "maximum": 480
          },
          "preferences": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "art",
                "architecture",
                "religion",
                "panoramic",
                "history",
                "nature"
              ]
            },
            "description": "Interessi tematici"
          },
          "startPoint": {
            "type": "object",
            "properties": {
              "latitude": {
                "type": "number"
              },
              "longitude": {
                "type": "number"
              }
            }
          },
          "accessibility": {
            "type": "object",
            "properties": {
              "wheelchairAccessible": {
                "type": "boolean"
              },
              "avoidStairs": {
                "type": "boolean"
              }
            }
          },
          "excludePois": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "POI già visitati da escludere"
          }
        }
      },
      "Itinerary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "totalDuration": {
            "type": "integer",
            "description": "Durata totale in minuti"
          },
          "totalDistance": {
            "type": "number",
            "description": "Distanza totale in metri"
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "easy",
              "medium",
              "hard"
            ]
          },
          "stops": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "order": {
                  "type": "integer"
                },
                "poi": {
                  "$ref": "#/components/schemas/POI"
                },
                "suggestedDuration": {
                  "type": "integer",
                  "description": "Tempo suggerito in minuti"
                },
                "walkingTimeToNext": {
                  "type": "integer",
                  "description": "Tempo a piedi per la prossima tappa"
                },
                "distanceToNext": {
                  "type": "number",
                  "description": "Distanza in metri"
                }
              }
            }
          },
          "routePolyline": {
            "type": "string",
            "description": "Polyline encoded per la mappa"
          }
        }
      },
      "ItineraryTemplate": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "theme": {
            "type": "string"
          },
          "duration": {
            "type": "integer"
          },
          "imageUrl": {
            "type": "string",
            "format": "uri"
          },
          "stopsCount": {
            "type": "integer"
          }
        }
      },
      "QRContent": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "poi",
              "artwork",
              "event",
              "itinerary"
            ]
          },
          "id": {
            "type": "string"
          },
          "data": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/POIDetail"
              },
              {
                "$ref": "#/components/schemas/ArtworkDetail"
              },
              {
                "$ref": "#/components/schemas/EventDetail"
              }
            ]
          }
        }
      },
      "Event": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "startDate": {
            "type": "string",
            "format": "date-time"
          },
          "endDate": {
            "type": "string",
            "format": "date-time"
          },
          "category": {
            "type": "string"
          },
          "imageUrl": {
            "type": "string",
            "format": "uri"
          },
          "location": {
            "type": "string"
          }
        }
      },
      "EventDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Event"
          },
          {
            "type": "object",
            "properties": {
              "fullDescription": {
                "type": "string"
              },
              "organizer": {
                "type": "string"
              },
              "price": {
                "type": "string"
              },
              "registrationUrl": {
                "type": "string",
                "format": "uri"
              },
              "relatedPois": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/POI"
                }
              }
            }
          }
        ]
      },
      "News": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "excerpt": {
            "type": "string"
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time"
          },
          "imageUrl": {
            "type": "string",
            "format": "uri"
          },
          "category": {
            "type": "string"
          }
        }
      },
      "NewsDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/News"
          },
          {
            "type": "object",
            "properties": {
              "content": {
                "type": "string",
                "description": "Contenuto HTML"
              },
              "author": {
                "type": "string"
              },
              "relatedNews": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/News"
                }
              }
            }
          }
        ]
      },
      "AnalyticsReport": {
        "type": "object",
        "properties": {
          "period": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "format": "date"
              },
              "to": {
                "type": "string",
                "format": "date"
              }
            }
          },
          "totalVisits": {
            "type": "integer"
          },
          "qrScans": {
            "type": "integer"
          },
          "appDownloads": {
            "type": "integer"
          },
          "webVisits": {
            "type": "integer"
          },
          "totemInteractions": {
            "type": "integer"
          },
          "topLanguages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "language": {
                  "type": "string"
                },
                "count": {
                  "type": "integer"
                }
              }
            }
          },
          "dailyStats": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "date": {
                  "type": "string",
                  "format": "date"
                },
                "visits": {
                  "type": "integer"
                },
                "qrScans": {
                  "type": "integer"
                }
              }
            }
          }
        }
      }
    },
    "responses": {
      "NotFound": {
        "description": "Risorsa non trovata",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "BadRequest": {
        "description": "Richiesta non valida",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string"
                },
                "details": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "field": {
                        "type": "string"
                      },
                      "message": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "AdminAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token JWT per operazioni CMS/Admin"
      }
    }
  },
  "security": [
    {
      "AdminAuth": []
    }
  ]
}
