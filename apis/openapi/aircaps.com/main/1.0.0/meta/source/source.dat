        "tags": [
          "Speakers"
        ],
        "operationId": "identifySpeaker",
        "x-codeSamples": [
          {
            "lang": "bash",
            "label": "cURL",
            "source": "curl \"https://api.aircaps.com/v1/speakers/identify\" \\\n  -H \"Authorization: Bearer $AIRCAPS_API_KEY\" \\\n  -H \"Content-Type: audio/wav\" \\\n  --data-binary @clip.wav"
          },
          {
            "lang": "python",
            "label": "Python",
            "source": "import os, requests\n\nwith open(\"clip.wav\", \"rb\") as f:\n    r = requests.post(\"https://api.aircaps.com/v1/speakers/identify\",\n                      headers={\"Authorization\": f\"Bearer {os.environ['AIRCAPS_API_KEY']}\", \"Content-Type\": \"audio/wav\"},\n                      data=f)\nprint(r.json()[\"results\"][0])"
          }
        ],
        "parameters": [
          {
            "name": "speaker_ids",
            "in": "query",
            "required": false,
            "description": "Only these speakers: comma-separated, or the parameter repeated. Default: every enrolled speaker of the account. Verification of one person is `speaker_ids=<their id>`.",
            "schema": {
              "type": "string",
              "example": "spk_01k73a9x8w7v6u5t4s3r2q1p0n,spk_01k73a7m6n5b4v3c2x1z0l9k8j"
            }
          },
          {
            "name": "top_k",
            "in": "query",
            "required": false,
            "description": "Return only the best `top_k` results (all speakers are still scored; `margin` and `speakers_compared` are unchanged).",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          },
          {
            "name": "model",
            "in": "query",
            "required": false,
            "description": "Optional: `aircaps-speaker-id-v1`. Any other value returns `400 unsupported_model`.",
            "schema": {
              "type": "string",
              "enum": [
                "aircaps-speaker-id-v1"
              ]
            }
          },
          {
            "name": "Content-Type",
            "in": "header",
            "required": false,
            "description": "The clip's media type, for example `audio/wav`. Informational: the format is detected from the bytes.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "description": "The clip's raw audio bytes (any common audio or video format; channels are mixed down and audio is resampled to 16 kHz). Not multipart form data. The whole clip is used as given: crop it to one person's speech first.",
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "audio/*": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        }
      }
    },
