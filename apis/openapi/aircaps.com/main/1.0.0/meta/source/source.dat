        "operationId": "addEnrollment",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Speaker ID.",
            "schema": {
              "type": "string",
              "example": "spk_01k73a9x8w7v6u5t4s3r2q1p0n"
            }
          },
          {
            "name": "model",
            "in": "query",
            "required": false,
            "description": "Optional: `aircaps-speaker-id-v1`. Any other value returns `400 unsupported_model`.",
            "schema": {
              "type": "string",
              "enum": [
                "aircaps-speaker-id-v1"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "description": "The clip's raw audio bytes (any common audio or video format; channels are mixed down and audio is resampled to 16 kHz). Not multipart form data. The whole clip is used as given: crop it to one person's speech first.",
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "audio/*": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "x-codeSamples": [
          {
            "lang": "bash",
            "label": "cURL",
            "source": "curl \"https://api.aircaps.com/v1/speakers/spk_01k73a9x8w7v6u5t4s3r2q1p0n/enrollments\" \\\n  -H \"Authorization: Bearer $AIRCAPS_API_KEY\" \\\n  -H \"Content-Type: audio/wav\" \\\n  --data-binary @ana_intro.wav"
          },
          {
            "lang": "python",
            "label": "Python",
            "source": "import os, requests\n\nwith open(\"ana_intro.wav\", \"rb\") as f:\n    r = requests.post(\"https://api.aircaps.com/v1/speakers/spk_01k73a9x8w7v6u5t4s3r2q1p0n/enrollments\",\n                      headers={\"Authorization\": f\"Bearer {os.environ['AIRCAPS_API_KEY']}\", \"Content-Type\": \"audio/wav\"},\n                      data=f)\nprint(r.json()[\"consistency\"])"
          }
        ]
      }
    },
