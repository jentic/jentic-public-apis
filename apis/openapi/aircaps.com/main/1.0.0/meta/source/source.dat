    "/v1/speakers/{id}/enrollments": {
      "post": {
        "summary": "Add an enrollment",
        "description": "Add one clip of this speaker. The model turns it into a speaker embedding, which is stored; the audio is not. A speaker's profile combines all of its enrollments, so several clips from different recordings make it sturdier. Synchronous: the response is the new enrollment and the updated speaker.",
        "responses": {
          "201": {
            "description": "Enrolled.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SpeakerEnrollment"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "speaker": {
                          "$ref": "#/components/schemas/EnrolledSpeaker"
                        }
