    "/v1/models": {
      "get": {
        "summary": "List models",
        "description": "The available models. No authentication needed.",
        "responses": {
          "200": {
            "description": "The models.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelList"
                },
                "example": {
                  "object": "list",
                  "data": [
                    {
                      "id": "a5s-async-v1",
                      "object": "model",
                      "name": "A5S Async v1",
                      "type": "async",
                      "languages": [
                        "en"
                      ],
                      "endpoint": "/v1/transcripts"
                    },
                    {
                      "id": "a5s-v2-streaming",
                      "object": "model",
                      "name": "A5S v2 Streaming",
                      "type": "streaming",
                      "languages": [
                        "en"
                      ],
                      "endpoint": "/v1/realtime"
                    },
                    {
                      "id": "aircaps-diarization-v1",
                      "object": "model",
                      "name": "AirCaps Diarization-v1",
                      "type": "async",
                      "task": "diarization",
                      "endpoint": "/v1/diarizations",
                      "access": "by_request"
                    },
                    {
                      "id": "aircaps-speaker-id-v1",
                      "object": "model",
                      "name": "AirCaps Speaker ID-v1",
                      "type": "sync",
                      "task": "speaker_identification",
                      "endpoint": "/v1/speakers",
                      "access": "by_request"
                    }
                  ]
                }
              }
            }
          }
        },
        "tags": [
          "Account"
        ],
        "operationId": "listModels",
        "security": []
      }
    },
    "/v1/account": {
      "get": {
        "summary": "Get account",
        "description": "Your usage limit, per-model access (`enabled`) and limits. For higher limits or model access, [talk to sales](https://research.aircaps.com/contact).",
        "responses": {
          "200": {
            "description": "The account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                },
                "example": {
                  "id": "7f0c2b1e-0000-4000-8000-000000000001",
                  "object": "account",
                  "email": "dev@example.com",
                  "display_name": "Dev Example",
                  "created_at": "2026-09-30T12:00:00Z",
                  "status": "active",
                  "tier": "standard",
                  "usage_limit": {
                    "limit_seconds": 18000,
                    "used_seconds": 2950.4,
                    "reserved_seconds": 0,
                    "remaining_seconds": 15049.6
                  },
                  "models": {
                    "a5s-async-v1": {
                      "name": "A5S Async v1",
                      "type": "async",
                      "enabled": true,
                      "max_concurrent_jobs": 5,
                      "max_queued_jobs": 2000,
                      "max_requests_per_minute": 600,
                      "max_audio_duration_seconds": 36000,
                      "retention_days": 30,
                      "jobs_queued": 0,
                      "jobs_processing": 1
                    },
                    "a5s-v2-streaming": {
                      "name": "A5S v2 Streaming",
                      "type": "streaming",
                      "enabled": true,
                      "max_concurrent_sessions": 5,
                      "max_session_seconds": 300
                    },
                    "aircaps-diarization-v1": {
                      "name": "AirCaps Diarization-v1",
                      "type": "async",
                      "enabled": false,
                      "max_concurrent_jobs": 5,
                      "max_queued_jobs": 2000,
                      "max_requests_per_minute": 600,
                      "max_audio_duration_seconds": 21600,
                      "retention_days": 30
                    },
                    "aircaps-speaker-id-v1": {
                      "name": "AirCaps Speaker ID-v1",
                      "type": "sync",
                      "enabled": false,
                      "max_requests_per_minute": 600,
                      "max_clip_duration_seconds": 120,
                      "max_speakers": 1000,
                      "max_enrollments_per_speaker": 20,
                      "speakers": 0
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key. Codes: `unauthorized`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "type": "authentication_error",
                    "code": "unauthorized",
                    "message": "invalid API key",
                    "param": null,
                    "request_id": "req_01k6z3m4q8w7e5r2t1y0u9i8o7"
                  }
                }
              }
            }
          },
          "403": {
            "description": "The account is disabled. Codes: `account_disabled`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "type": "permission_error",
                    "code": "account_disabled",
                    "message": "this account is disabled",
                    "param": null,
                    "request_id": "req_01k6z3m4q8w7e5r2t1y0u9i8o7"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Server error. Safe to retry (use the same Idempotency-Key). Codes: `internal_error`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "type": "api_error",
                    "code": "internal_error",
                    "message": "internal error",
                    "param": null,
                    "request_id": "req_01k6z3m4q8w7e5r2t1y0u9i8o7"
                  }
                }
              }
            }
          },
          "503": {
            "description": "Temporarily unavailable. Retry after the Retry-After interval. Codes: `service_unavailable`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "type": "api_error",
                    "code": "service_unavailable",
                    "message": "temporarily unavailable; please retry",
                    "param": null,
                    "request_id": "req_01k6z3m4q8w7e5r2t1y0u9i8o7"
                  }
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "tags": [
          "Account"
        ],
        "operationId": "getAccount"
      }
    },
    "/v1/usage": {
      "get": {
        "summary": "Get usage",
        "description": "Daily usage of each model your account can use.",
        "responses": {
          "200": {
            "description": "Usage report.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Usage"
                },
                "example": {
                  "object": "usage",
                  "timezone": "UTC",
                  "start_date": "2026-09-07",
                  "end_date": "2026-10-06",
                  "models": [
                    {
                      "id": "a5s-async-v1",
                      "name": "A5S Async v1"
                    },
                    {
                      "id": "a5s-v2-streaming",
                      "name": "A5S v2 Streaming"
                    }
                  ],
                  "daily": [
                    {
                      "date": "2026-10-06",
                      "model": "a5s-async-v1",
                      "requests": 12,
                      "completed": 12,
                      "failed": 0,
                      "audio_seconds": 5410.2
                    }
                  ],
                  "totals": {
                    "a5s-async-v1": {
                      "requests": 12,
                      "completed": 12,
                      "failed": 0,
                      "audio_seconds": 5410.2
                    }
                  },
                  "by_key": [
                    {
                      "key_id": "0123456789ab",
                      "name": "Production",
                      "model": "a5s-async-v1",
                      "requests": 12,
                      "audio_seconds": 5410.2
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid query parameter (`param` names it). Codes: `invalid_request`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "type": "invalid_request_error",
                    "code": "invalid_request",
                    "message": "Input should be greater than or equal to 10",
                    "param": null,
                    "request_id": "req_01k6z3m4q8w7e5r2t1y0u9i8o7"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key. Codes: `unauthorized`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "type": "authentication_error",
                    "code": "unauthorized",
                    "message": "invalid API key",
                    "param": null,
                    "request_id": "req_01k6z3m4q8w7e5r2t1y0u9i8o7"
                  }
                }
              }
            }
          },
          "403": {
            "description": "The account is disabled. Codes: `account_disabled`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "type": "permission_error",
                    "code": "account_disabled",
                    "message": "this account is disabled",
                    "param": null,
                    "request_id": "req_01k6z3m4q8w7e5r2t1y0u9i8o7"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Server error. Safe to retry (use the same Idempotency-Key). Codes: `internal_error`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "type": "api_error",
                    "code": "internal_error",
                    "message": "internal error",
                    "param": null,
                    "request_id": "req_01k6z3m4q8w7e5r2t1y0u9i8o7"
                  }
                }
              }
            }
          },
          "503": {
            "description": "Temporarily unavailable. Retry after the Retry-After interval. Codes: `service_unavailable`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "type": "api_error",
                    "code": "service_unavailable",
                    "message": "temporarily unavailable; please retry",
                    "param": null,
                    "request_id": "req_01k6z3m4q8w7e5r2t1y0u9i8o7"
                  }
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "tags": [
          "Account"
        ],
        "operationId": "getUsage",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "description": "Calendar days, including today.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90,
              "default": 30
            }
          },
          {
            "name": "timezone",
            "in": "query",
            "description": "IANA time zone for day boundaries.",
            "schema": {
              "type": "string",
              "default": "UTC",
              "example": "America/New_York"
            }
          }
        ]
      }
    }
  },
  "webhooks": {
    "transcript": {
      "post": {
        "summary": "Transcript finished",
        "description": "Sent to `webhook_url` when a transcript completes or fails. Signed per Standard Webhooks (`webhook-id`, `webhook-timestamp`, `webhook-signature`). Reply 2xx within 15 s.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WebhookEvent"
              },
              "example": {
                "event": "transcript.completed",
                "id": "tr_01k6z3m4q8w7e5r2t1y0u9i8o7",
                "status": "completed",
                "metadata": {
                  "meeting_id": 42
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Any 2xx acknowledges the delivery."
          }
        }
      }
    },
    "diarization": {
      "post": {
        "summary": "Diarization finished",
        "description": "Sent to `webhook_url` when a diarization completes or fails. Signed like every webhook. Reply 2xx within 15 s.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WebhookEvent"
              },
              "example": {
                "event": "diarization.completed",
                "id": "dia_01k72p0x9h6t3b8r1n4m7q2w5e",
                "status": "completed",
                "metadata": {
                  "meeting_id": 42
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Any 2xx acknowledges the delivery."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Your API key: `Authorization: Bearer aircaps_sk_...`"
      }
    },
    "schemas": {
      "CreateTranscriptRequest": {
        "type": "object",
        "additionalProperties": false,
        "description": "Provide exactly one of `audio_url` or `file_id`.",
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "a5s-async-v1"
            ],
            "default": "a5s-async-v1",
            "description": "The model. Any other value returns `400 unsupported_model`."
          },
          "audio_url": {
            "type": "string",
            "maxLength": 8192,
            "format": "uri",
            "description": "An http(s) URL to download the audio from (public or presigned), up to 5 GB, resolving to a public address.",
            "example": "https://example.com/meeting.mp3"
          },
          "file_id": {
            "type": "string",
            "maxLength": 64,
            "description": "An uploaded file, usable by any number of transcripts for 24 hours after upload. ID from [Create an upload URL](/api-reference/upload-url) or [Upload a file](/api-reference/upload-file)."
          },
          "language_code": {
            "type": "string",
            "maxLength": 16,
            "default": "en",
            "description": "Language of the audio. English only today: `en`. Any other value returns `400 unsupported_language`. Multilingual support is planned.",
            "example": "en"
          },
          "webhook_url": {
            "type": "string",
            "maxLength": 2048,
            "format": "uri",
            "description": "Called with a [webhook event](/api-reference/objects/webhook-event) when the job finishes."
          },
          "webhook_auth_header_name": {
            "type": "string",
            "maxLength": 256,
            "description": "Name of a header to add to webhook requests. Requires `webhook_url`.",
            "example": "Authorization"
          },
          "webhook_auth_header_value": {
            "type": "string",
            "maxLength": 4096,
            "description": "Value of that header."
          },
          "metadata": {
            "type": "object",
            "description": "Any JSON object up to 16 KB; echoed on the transcript and in webhooks.",
            "example": {
              "meeting_id": 42
            }
          },
          "speaker_identification": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "$ref": "#/components/schemas/SpeakerIdentificationOptions"
              }
            ],
            "description": "Name the transcript's speakers from your [enrolled speakers](/guides/speaker-id) with AirCaps Speaker ID-v1 (enabled per account; `403 model_access_denied` otherwise). `true` uses the defaults; an object sets `threshold` and `speaker_ids`. See [Speaker names](/guides/async-transcription#speaker-names).",
            "example": {
              "threshold": 0.6
            }
          }
        }
      },
      "Transcript": {
        "type": "object",
        "required": [
          "id",
          "object",
          "status",
          "created_at",
          "started_at",
          "completed_at",
          "audio_url",
          "file_id",
          "language_code",
          "model",
          "audio_duration",
          "metadata",
          "webhook_url",
          "webhook_status",
          "webhook_status_code",
          "error"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Transcript ID.",
            "example": "tr_01k6z3m4q8w7e5r2t1y0u9i8o7"
          },
          "object": {
            "type": "string",
            "enum": [
              "transcript"
            ],
            "example": "transcript"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "processing",
              "completed",
              "error"
            ],
            "description": "`queued`: waiting for a processing slot. `processing`: being transcribed. `completed`: result fields present. `error`: see `error`."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the transcript was created (UTC)."
          },
          "started_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When processing started."
          },
          "completed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When the job finished (completed or error)."
          },
          "audio_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "The submitted `audio_url`, if any."
          },
          "file_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "The submitted `file_id`, if any."
          },
          "language_code": {
            "type": "string",
            "enum": [
              "en"
            ],
            "description": "Language of the transcript (normalised)."
          },
          "model": {
            "type": "string",
            "enum": [
              "a5s-async-v1"
            ]
          },
          "audio_duration": {
            "type": [
              "number",
              "null"
            ],
            "description": "Audio duration in seconds, once known.",
            "example": 3600.512
          },
          "metadata": {
            "type": [
              "object",
              "null"
            ],
            "description": "Your `metadata`, echoed back."
          },
          "webhook_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "Webhook target, if any."
          },
          "webhook_status": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "pending",
              "delivered",
              "failed",
              null
            ],
            "description": "Webhook delivery state, if `webhook_url` was set."
          },
          "webhook_status_code": {
            "type": [
              "integer",
              "null"
            ],
            "description": "HTTP status of the last webhook delivery."
          },
          "error": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/JobError"
              },
              {
                "type": "null"
              }
            ],
            "description": "Set when `status` is `error`."
          },
          "text": {
            "type": "string",
            "description": "Completed only. Full transcript: verbatim, lowercase, no punctuation."
          },
          "speakers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TranscriptSpeaker"
            },
            "description": "Completed only. With `speaker_identification`, each speaker also has `speaker_id`, `name`, `score`, `matches` and `compared_duration`."
          },
          "utterances": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Utterance"
            },
            "description": "Completed only. Speaker turns, in time order; overlapping speech overlaps."
          },
          "words": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Word"
            },
            "description": "Completed only. Every word, in time order."
          },
          "speaker_identification": {
            "$ref": "#/components/schemas/TranscriptSpeakerIdentification",
            "description": "Only when the transcript was created with `speaker_identification`: its settings and outcome."
          }
        }
      },
      "TranscriptSummary": {
        "type": "object",
        "required": [
          "id",
          "object",
          "status",
          "created_at",
          "started_at",
          "completed_at",
          "audio_url",
          "file_id",
          "language_code",
          "model",
          "audio_duration",
          "metadata",
          "webhook_url",
          "webhook_status",
          "webhook_status_code",
          "error"
        ],
        "description": "A transcript without its result fields.",
        "properties": {
          "id": {
            "type": "string",
            "description": "Transcript ID.",
            "example": "tr_01k6z3m4q8w7e5r2t1y0u9i8o7"
          },
          "object": {
            "type": "string",
            "enum": [
              "transcript"
            ],
            "example": "transcript"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "processing",
              "completed",
              "error"
            ],
            "description": "`queued`: waiting for a processing slot. `processing`: being transcribed. `completed`: result fields present. `error`: see `error`."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the transcript was created (UTC)."
          },
          "started_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When processing started."
          },
          "completed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When the job finished (completed or error)."
          },
          "audio_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "The submitted `audio_url`, if any."
          },
          "file_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "The submitted `file_id`, if any."
          },
          "language_code": {
            "type": "string",
            "enum": [
              "en"
            ],
            "description": "Language of the transcript (normalised)."
          },
          "model": {
            "type": "string",
            "enum": [
              "a5s-async-v1"
            ]
          },
          "audio_duration": {
            "type": [
              "number",
              "null"
            ],
            "description": "Audio duration in seconds, once known.",
            "example": 3600.512
          },
          "metadata": {
            "type": [
              "object",
              "null"
            ],
            "description": "Your `metadata`, echoed back."
          },
          "webhook_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "Webhook target, if any."
          },
          "webhook_status": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "pending",
              "delivered",
              "failed",
              null
            ],
            "description": "Webhook delivery state, if `webhook_url` was set."
          },
          "webhook_status_code": {
            "type": [
              "integer",
              "null"
            ],
            "description": "HTTP status of the last webhook delivery."
          },
          "error": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/JobError"
              },
              {
                "type": "null"
              }
            ],
            "description": "Set when `status` is `error`."
          }
        }
      },
      "TranscriptList": {
        "type": "object",
        "required": [
          "object",
          "data",
          "has_more",
          "next_before"
        ],
        "properties": {
          "object": {
            "type": "string",
            "enum": [
              "list"
            ]
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TranscriptSummary"
            }
          },
          "has_more": {
            "type": "boolean"
          },
          "next_before": {
            "type": [
              "string",
              "null"
            ],
            "description": "Pass as `before` for the next page."
          }
        }
      },
      "CreateDiarizationRequest": {
        "type": "object",
        "additionalProperties": false,
        "description": "Provide exactly one of `audio_url` or `file_id`.",
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "aircaps-diarization-v1"
            ],
            "default": "aircaps-diarization-v1",
            "description": "The model. Any other value returns `400 unsupported_model`."
          },
          "audio_url": {
            "type": "string",
            "maxLength": 8192,
            "format": "uri",
            "description": "An http(s) URL to download the audio from (public or presigned), up to 5 GB, resolving to a public address.",
            "example": "https://example.com/meeting.mp3"
          },
          "file_id": {
            "type": "string",
            "maxLength": 64,
            "description": "An uploaded file, usable by any number of jobs for 24 hours after upload. ID from [Create an upload URL](/api-reference/upload-url) or [Upload a file](/api-reference/upload-file)."
          },
          "webhook_url": {
            "type": "string",
            "maxLength": 2048,
            "format": "uri",
            "description": "Called with a [webhook event](/api-reference/objects/webhook-event) when the job finishes."
          },
          "webhook_auth_header_name": {
            "type": "string",
            "maxLength": 256,
            "description": "Name of a header to add to webhook requests. Requires `webhook_url`.",
            "example": "Authorization"
          },
          "webhook_auth_header_value": {
            "type": "string",
            "maxLength": 4096,
            "description": "Value of that header."
          },
          "metadata": {
            "type": "object",
            "description": "Any JSON object up to 16 KB; echoed on the diarization and in webhooks.",
            "example": {
              "meeting_id": 42
            }
          }
        }
      },
      "Diarization": {
        "type": "object",
        "required": [
          "id",
          "object",
          "status",
          "created_at",
          "started_at",
          "completed_at",
          "audio_url",
          "file_id",
          "model",
          "audio_duration",
          "metadata",
          "webhook_url",
          "webhook_status",
          "webhook_status_code",
          "error"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Diarization ID.",
            "example": "dia_01k72p0x9h6t3b8r1n4m7q2w5e"
          },
          "object": {
            "type": "string",
            "enum": [
              "diarization"
            ],
            "example": "diarization"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "processing",
              "completed",
              "error"
            ],
            "description": "`queued`: waiting for a processing slot. `processing`: being diarized. `completed`: result fields present. `error`: see `error`."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the diarization was created (UTC)."
          },
          "started_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When processing started."
          },
          "completed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When the job finished (completed or error)."
          },
          "audio_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "The submitted `audio_url`, if any."
          },
          "file_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "The submitted `file_id`, if any."
          },
          "model": {
            "type": "string",
            "enum": [
              "aircaps-diarization-v1"
            ]
          },
          "audio_duration": {
            "type": [
              "number",
              "null"
            ],
            "description": "Audio duration in seconds, once known.",
            "example": 3600.512
          },
          "metadata": {
            "type": [
              "object",
              "null"
            ],
            "description": "Your `metadata`, echoed back."
          },
          "webhook_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "Webhook target, if any."
          },
          "webhook_status": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "pending",
              "delivered",
              "failed",
              null
            ],
            "description": "Webhook delivery state, if `webhook_url` was set."
          },
          "webhook_status_code": {
            "type": [
              "integer",
              "null"
            ],
            "description": "HTTP status of the last webhook delivery."
          },
          "error": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/JobError"
              },
              {
                "type": "null"
              }
            ],
            "description": "Set when `status` is `error`."
          },
          "num_speakers": {
            "type": "integer",
            "description": "Completed only. Number of speakers found.",
            "example": 3
          },
          "speakers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Speaker"
            },
            "description": "Completed only. Every speaker, with their speaking time."
          },
          "segments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Segment"
            },
            "description": "Completed only. Who spoke when, in time order. Overlapping speech appears as overlapping segments of different speakers."
          },
          "speech_duration": {
            "type": "number",
            "description": "Completed only. Seconds in which anyone speaks.",
            "example": 1498.27
          },
          "overlap_duration": {
            "type": "number",
            "description": "Completed only. Seconds in which two or more people speak at once.",
            "example": 61.44
          }
        }
      },
      "DiarizationSummary": {
        "type": "object",
        "required": [
          "id",
          "object",
          "status",
          "created_at",
          "started_at",
          "completed_at",
          "audio_url",
          "file_id",
          "model",
          "audio_duration",
          "metadata",
          "webhook_url",
          "webhook_status",
          "webhook_status_code",
          "error"
        ],
        "description": "A diarization without its result fields.",
        "properties": {
          "id": {
            "type": "string",
            "description": "Diarization ID.",
            "example": "dia_01k72p0x9h6t3b8r1n4m7q2w5e"
          },
          "object": {
            "type": "string",
            "enum": [
              "diarization"
            ],
            "example": "diarization"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "processing",
              "completed",
              "error"
            ],
            "description": "`queued`: waiting for a processing slot. `processing`: being diarized. `completed`: result fields present. `error`: see `error`."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the diarization was created (UTC)."
          },
          "started_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When processing started."
          },
          "completed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When the job finished (completed or error)."
          },
          "audio_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "The submitted `audio_url`, if any."
          },
          "file_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "The submitted `file_id`, if any."
          },
          "model": {
            "type": "string",
            "enum": [
              "aircaps-diarization-v1"
            ]
          },
          "audio_duration": {
            "type": [
              "number",
              "null"
            ],
            "description": "Audio duration in seconds, once known.",
            "example": 3600.512
          },
          "metadata": {
            "type": [
              "object",
              "null"
            ],
            "description": "Your `metadata`, echoed back."
          },
          "webhook_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "Webhook target, if any."
          },
          "webhook_status": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "pending",
              "delivered",
              "failed",
              null
            ],
            "description": "Webhook delivery state, if `webhook_url` was set."
          },
          "webhook_status_code": {
            "type": [
              "integer",
              "null"
            ],
            "description": "HTTP status of the last webhook delivery."
          },
          "error": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/JobError"
              },
              {
                "type": "null"
              }
            ],
            "description": "Set when `status` is `error`."
          }
        }
      },
      "DiarizationList": {
        "type": "object",
        "required": [
          "object",
          "data",
          "has_more",
          "next_before"
        ],
        "properties": {
          "object": {
            "type": "string",
            "enum": [
              "list"
            ]
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DiarizationSummary"
            }
          },
          "has_more": {
            "type": "boolean"
          },
          "next_before": {
            "type": [
              "string",
              "null"
            ],
            "description": "Pass as `before` for the next page."
          }
        }
      },
      "Segment": {
        "type": "object",
        "required": [
          "speaker",
          "start",
          "end"
        ],
        "properties": {
          "speaker": {
            "type": "string",
            "description": "Speaker label (`speaker_0`, `speaker_1`, \u2026 in order of first speech).",
            "example": "speaker_0"
          },
          "start": {
            "type": "number",
            "description": "Start time in seconds.",
            "example": 0.48
          },
          "end": {
            "type": "number",
            "description": "End time in seconds.",
            "example": 6.12
          }
        }
      },
      "CreateSpeakerRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "aircaps-speaker-id-v1"
            ],
            "description": "Optional. Any other value returns `400 unsupported_model`."
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200,
            "description": "Your label for the speaker (whitespace is collapsed). Optional.",
            "example": "Ana Garc\u00eda"
          },
          "metadata": {
            "type": [
              "object",
              "null"
            ],
            "description": "Any JSON object up to 16 KB.",
            "example": {
              "employee_id": "E-1042"
            }
          }
        }
      },
      "UpdateSpeakerRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200
          },
          "metadata": {
            "type": [
              "object",
              "null"
            ],
            "description": "Replaces the metadata (up to 16 KB)."
          }
        }
      },
      "EnrolledSpeaker": {
        "type": "object",
        "required": [
          "id",
          "object",
          "name",
          "metadata",
          "model",
          "num_enrollments",
          "enrolled_duration",
          "enrollments",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Speaker ID.",
            "example": "spk_01k73a9x8w7v6u5t4s3r2q1p0n"
          },
          "object": {
            "type": "string",
            "enum": [
              "speaker"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Your label for the speaker.",
            "example": "Ana Garc\u00eda"
          },
          "metadata": {
            "type": [
              "object",
              "null"
            ],
            "description": "Your `metadata`.",
            "example": {
              "employee_id": "E-1042"
            }
          },
          "model": {
            "type": "string",
            "enum": [
              "aircaps-speaker-id-v1"
            ]
          },
          "num_enrollments": {
            "type": "integer",
            "example": 2
          },
          "enrolled_duration": {
            "type": "number",
            "description": "Seconds of enrollment audio in total.",
            "example": 27.9
          },
          "enrollments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SpeakerEnrollment"
            },
            "description": "Oldest first. Only embeddings are stored, never the audio."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Last change to the name, metadata or enrollments."
          }
        }
      },
      "SpeakerEnrollment": {
        "type": "object",
        "required": [
          "id",
          "object",
          "speaker_id",
          "audio_duration",
          "consistency",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Enrollment ID.",
            "example": "enr_01k73b2c4d5e6f7g8h9j0k1m2n"
          },
          "object": {
            "type": "string",
            "enum": [
              "speaker_enrollment"
            ]
          },
          "speaker_id": {
            "type": "string",
            "example": "spk_01k73a9x8w7v6u5t4s3r2q1p0n"
          },
          "audio_duration": {
            "type": "number",
            "description": "Seconds of audio in the enrollment clip.",
            "example": 12.48
          },
          "consistency": {
            "type": [
              "number",
              "null"
            ],
            "description": "How well this enrollment matches the speaker's other enrollments (-1 to 1). `null` when it is the only one. A value much lower than the speaker's other enrollments suggests a clip of someone else or a poor recording.",
            "example": 0.712
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SpeakerIdentification": {
        "type": "object",
        "required": [
          "id",
          "object",
          "model",
          "created_at",
          "audio_duration",
          "speakers_compared",
          "margin",
          "results"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Identification ID (identifies the request; identifications are not stored).",
            "example": "sid_01k73c0q9w8e7r6t5y4u3i2o1p"
          },
          "object": {
            "type": "string",
            "enum": [
              "speaker_identification"
            ]
          },
          "model": {
            "type": "string",
            "enum": [
              "aircaps-speaker-id-v1"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "audio_duration": {
            "type": "number",
            "description": "Seconds of audio in the clip.",
            "example": 4.21
          },
          "speakers_compared": {
            "type": "integer",
            "description": "Speakers the clip was scored against (before `top_k`).",
            "example": 3
          },
          "margin": {
            "type": [
              "number",
              "null"
            ],
            "description": "Best `score` minus the second best. `null` with one speaker.",
            "example": 0.476
          },
          "results": {
            "type": "array",
            "description": "Best first (ties by speaker ID).",
            "items": {
              "type": "object",
              "required": [
                "speaker_id",
                "name",
                "score",
                "enrollment_scores"
              ],
              "properties": {
                "speaker_id": {
                  "type": "string",
                  "example": "spk_01k73a9x8w7v6u5t4s3r2q1p0n"
                },
                "name": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "example": "Ana Garc\u00eda"
                },
                "score": {
                  "type": "number",
                  "description": "Similarity (-1 to 1) between the clip and the speaker's profile, which combines all of their enrollments. Higher means more alike. Not a probability, and no threshold is applied.",
                  "example": 0.684
                },
                "enrollment_scores": {
                  "type": "array",
                  "description": "The clip against each enrollment on its own, in enrollment order.",
                  "items": {
                    "type": "object",
                    "properties": {
                      "enrollment_id": {
                        "type": "string"
                      },
                      "score": {
                        "type": "number",
                        "example": 0.661
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "EnrolledSpeakerList": {
        "type": "object",
        "required": [
          "object",
          "data",
          "has_more",
          "next_before"
        ],
        "properties": {
          "object": {
            "type": "string",
            "enum": [
              "list"
            ]
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EnrolledSpeaker"
            }
          },
          "has_more": {
            "type": "boolean"
          },
          "next_before": {
            "type": [
              "string",
              "null"
            ],
            "description": "Pass as `before` for the next page."
          }
        }
      },
      "Utterance": {
        "type": "object",
        "required": [
          "speaker",
          "start",
          "end",
          "text",
          "words"
        ],
        "properties": {
          "speaker": {
            "type": "string",
            "description": "Speaker label (`speaker_0`, `speaker_1`, \u2026 in order of first speech).",
            "example": "speaker_0"
          },
          "speaker_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Only with `speaker_identification`: the name of the enrolled speaker this speaker was matched with, or `null`.",
            "example": "Ana Garc\u00eda"
          },
          "start": {
            "type": "number",
            "description": "Start time in seconds.",
            "example": 0.48
          },
          "end": {
            "type": "number",
            "description": "End time in seconds.",
            "example": 6.12
          },
          "text": {
            "type": "string",
            "description": "Text of the utterance.",
            "example": "hey good afternoon everybody"
          },
          "words": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Word"
            },
            "description": "Words of the utterance."
          }
        }
      },
      "Word": {
        "type": "object",
        "required": [
          "text",
          "start",
          "end",
          "speaker"
        ],
        "properties": {
          "text": {
            "type": "string",
            "description": "The word.",
            "example": "hey"
          },
          "start": {
            "type": "number",
            "description": "Start time in seconds.",
            "example": 0.48
          },
          "end": {
            "type": "number",
            "description": "End time in seconds.",
            "example": 0.71
          },
          "speaker": {
            "type": "string",
            "description": "Speaker label.",
            "example": "speaker_0"
          }
        }
      },
      "Speaker": {
        "type": "object",
        "required": [
          "id",
          "speaking_time"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "speaker_0"
          },
          "speaking_time": {
            "type": "number",
            "description": "Seconds this speaker talks.",
            "example": 1402.11
          }
        }
      },
      "TranscriptSpeaker": {
        "type": "object",
        "required": [
          "id",
          "speaking_time"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "speaker_0"
          },
          "speaking_time": {
            "type": "number",
            "description": "Seconds this speaker talks.",
            "example": 1402.11
          },
          "speaker_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Only with `speaker_identification`: the enrolled speaker matched with this speaker (its best score reached `threshold`), or `null`. Two speakers can match the same enrolled speaker when one person was split in two.",
            "example": "spk_01k73a9x8w7v6u5t4s3r2q1p0n"
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Only with `speaker_identification`: the matched enrolled speaker's name.",
            "example": "Ana Garc\u00eda"
          },
          "score": {
            "type": [
              "number",
              "null"
            ],
            "description": "Only with `speaker_identification`: the matched enrolled speaker's score, or `null`.",
            "example": 0.781
          },
          "matches": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SpeakerMatch"
            },
            "description": "Only with `speaker_identification`: the 3 best-scoring enrolled speakers, best first, whether or not they reached `threshold`. Empty when the speaker had too little speech to compare."
          },
          "compared_duration": {
            "type": "number",
            "description": "Only with `speaker_identification`: seconds of this speaker's audio that were compared.",
            "example": 60.0
          }
        }
      },
      "SpeakerMatch": {
        "type": "object",
        "required": [
          "speaker_id",
          "name",
          "score"
        ],
        "properties": {
          "speaker_id": {
            "type": "string",
            "description": "Enrolled speaker ID.",
            "example": "spk_01k73a9x8w7v6u5t4s3r2q1p0n"
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "The enrolled speaker's name.",
            "example": "Ana Garc\u00eda"
          },
          "score": {
            "type": "number",
            "description": "Similarity of this speaker's voice to the enrolled speaker (-1 to 1).",
            "example": 0.781
          }
        }
      },
      "SpeakerIdentificationOptions": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "speaker_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 1000,
            "description": "Compare with these enrolled speakers only, for example the people invited to the meeting. Each must exist and have an enrollment. Default: every enrolled speaker of the account.",
            "example": [
              "spk_01k73a9x8w7v6u5t4s3r2q1p0n",
              "spk_01k73a7m6n5b4v3c2x1z0l9k8j"
            ]
          },
          "threshold": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0.6,
            "description": "A speaker gets an enrolled speaker's name when that is their best match and the score is at least this. 0.5 names a few more speakers when everyone who may speak is enrolled.",
            "example": 0.6
          }
        }
      },
      "TranscriptSpeakerIdentification": {
        "type": "object",
        "required": [
          "model",
          "status",
          "threshold",
          "speaker_ids",
          "speakers_compared",
          "speakers_identified",
          "error"
        ],
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "aircaps-speaker-id-v1"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "completed",
              "failed",
              "skipped"
            ],
            "description": "`pending`: the transcript is not finished. `completed`: matched (possibly nobody). `failed`: speaker identification was unavailable; the transcript is complete without names (see `error`). `skipped`: the transcript failed."
          },
          "threshold": {
            "type": "number",
            "example": 0.6
          },
          "speaker_ids": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "The requested `speaker_ids`, or `null` for every enrolled speaker."
          },
          "speakers_compared": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Enrolled speakers compared (those that existed and had enrollments when the transcript was processed).",
            "example": 12
          },
          "speakers_identified": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Transcript speakers that got a name.",
            "example": 2
          },
          "error": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "speaker_identification_failed"
                ]
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "JobError": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "invalid_audio",
              "audio_too_long",
              "file_too_large",
              "download_failed",
              "file_not_found",
              "usage_limit_reached",
              "internal_error",
              "canceled"
            ],
            "description": "Why the job failed. Failed jobs never count toward usage."
          },
          "message": {
            "type": "string",
            "description": "Human-readable detail."
          }
        }
      },
      "File": {
        "type": "object",
        "required": [
          "id",
          "object",
          "size_bytes",
          "created_at",
          "expires_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "file_01k6z3m4q8w7e5r2t1y0u9i8o7",
            "description": "Use as `file_id`."
          },
          "object": {
            "type": "string",
            "enum": [
              "file"
            ]
          },
          "size_bytes": {
            "type": "integer",
            "example": 115200044
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "Usable until this time (24 hours after upload); the file is deleted within the following 24 hours, or right away when a transcript that used it is deleted."
          }
        }
      },
      "UploadUrl": {
        "type": "object",
        "required": [
          "id",
          "object",
          "upload_url",
          "method",
          "upload_expires_at",
          "expires_at",
          "max_size_bytes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "file_01k6z3m4q8w7e5r2t1y0u9i8o7",
            "description": "Use as `file_id` after the upload."
          },
          "object": {
            "type": "string",
            "enum": [
              "file"
            ]
          },
          "upload_url": {
            "type": "string",
            "description": "Presigned URL: `PUT` the raw file bytes here."
          },
          "method": {
            "type": "string",
            "enum": [
              "PUT"
            ]
          },
          "upload_expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "Upload before this (one hour)."
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "Usable until this time (24 hours after upload); the file is deleted within the following 24 hours, or right away when a transcript that used it is deleted."
          },
          "max_size_bytes": {
            "type": "integer",
            "example": 5368709120
          }
        }
      },
      "Model": {
        "type": "object",
        "required": [
          "id",
          "object",
          "name",
          "type",
          "languages",
          "endpoint"
        ],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "a5s-async-v1",
              "a5s-v2-streaming",
              "aircaps-diarization-v1",
              "aircaps-speaker-id-v1"
            ]
          },
          "object": {
            "type": "string",
            "enum": [
              "model"
            ]
          },
          "name": {
            "type": "string",
            "example": "A5S Async v1"
          },
          "type": {
            "type": "string",
            "enum": [
              "async",
              "streaming",
              "sync"
            ],
            "description": "`sync`: the result is the response (AirCaps Speaker ID-v1)."
          },
          "task": {
            "type": "string",
            "enum": [
              "diarization",
              "speaker_identification"
            ],
            "description": "Models that do not transcribe: speaker diarization (AirCaps Diarization-v1) or speaker identification (AirCaps Speaker ID-v1)."
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "en"
            ],
            "description": "Transcription models only."
          },
          "endpoint": {
            "type": "string",
            "example": "/v1/transcripts"
          },
          "access": {
            "type": "string",
            "enum": [
              "by_request"
            ],
            "description": "Present when the model is enabled per account on request."
          }
        }
      },
      "ModelList": {
        "type": "object",
        "properties": {
          "object": {
            "type": "string",
            "enum": [
              "list"
            ]
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Model"
            }
          }
        }
      },
      "Account": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Account ID."
          },
          "object": {
            "type": "string",
            "enum": [
              "account"
            ]
          },
          "email": {
            "type": "string"
          },
          "display_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "suspended"
            ]
          },
          "tier": {
            "type": "string"
          },
          "usage_limit": {
            "type": "object",
            "description": "One limit shared by all models (5 hours free). To raise it, [talk to sales](https://research.aircaps.com/contact).",
            "properties": {
              "limit_seconds": {
                "type": "number",
                "example": 18000
              },
              "used_seconds": {
                "type": "number"
              },
              "reserved_seconds": {
                "type": "number",
                "description": "Held by running jobs and sessions."
              },
              "remaining_seconds": {
                "type": "number"
              }
            }
          },
          "models": {
            "type": "object",
            "properties": {
              "a5s-async-v1": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "async"
                    ]
                  },
                  "enabled": {
                    "type": "boolean",
                    "description": "Whether this account may use the model."
                  },
                  "max_concurrent_jobs": {
                    "type": "integer"
                  },
                  "max_queued_jobs": {
                    "type": "integer"
                  },
                  "max_requests_per_minute": {
                    "type": "integer"
                  },
                  "max_audio_duration_seconds": {
                    "type": "integer"
                  },
                  "retention_days": {
                    "type": "integer"
                  },
                  "jobs_queued": {
                    "type": "integer"
                  },
                  "jobs_processing": {
                    "type": "integer"
                  }
                }
              },
              "a5s-v2-streaming": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "streaming"
                    ]
                  },
                  "enabled": {
                    "type": "boolean"
                  },
                  "max_concurrent_sessions": {
                    "type": "integer"
                  },
                  "max_session_seconds": {
                    "type": "integer"
                  }
                }
              },
              "aircaps-diarization-v1": {
                "type": "object",
                "description": "Shares the asynchronous job limits with A5S Async v1.",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "async"
                    ]
                  },
                  "enabled": {
                    "type": "boolean",
                    "description": "Whether this account may use the model (enabled on request)."
                  },
                  "max_concurrent_jobs": {
                    "type": "integer"
                  },
                  "max_queued_jobs": {
                    "type": "integer"
                  },
                  "max_requests_per_minute": {
                    "type": "integer"
                  },
                  "max_audio_duration_seconds": {
                    "type": "integer"
                  },
                  "retention_days": {
                    "type": "integer"
                  }
                }
              },
              "aircaps-speaker-id-v1": {
                "type": "object",
                "description": "Synchronous: one clip per request.",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "sync"
                    ]
                  },
                  "enabled": {
                    "type": "boolean",
                    "description": "Whether this account may use the model (enabled on request)."
                  },
                  "max_requests_per_minute": {
                    "type": "integer",
                    "description": "Enrollments and identifications together."
                  },
                  "max_clip_duration_seconds": {
                    "type": "integer",
                    "example": 120
                  },
                  "max_speakers": {
                    "type": "integer",
                    "example": 1000
                  },
                  "max_enrollments_per_speaker": {
                    "type": "integer",
                    "example": 20
                  },
                  "speakers": {
                    "type": "integer",
                    "description": "Speakers the account has now."
                  }
                }
              }
            }
          }
        }
      },
      "Usage": {
        "type": "object",
        "properties": {
          "object": {
            "type": "string",
            "enum": [
              "usage"
            ]
          },
          "timezone": {
            "type": "string"
          },
          "start_date": {
            "type": "string",
            "format": "date"
          },
          "end_date": {
            "type": "string",
            "format": "date"
          },
          "models": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              }
            }
          },
          "daily": {
            "type": "array",
            "items": {
              "allOf": [
                {
                  "type": "object",
                  "properties": {
                    "date": {
                      "type": "string",
                      "format": "date"
                    },
                    "model": {
                      "type": "string"
                    }
                  }
                },
                {
                  "type": "object",
                  "properties": {
                    "requests": {
                      "type": "integer"
                    },
                    "completed": {
                      "type": "integer"
                    },
                    "failed": {
                      "type": "integer"
                    },
                    "audio_seconds": {
                      "type": "number"
                    }
                  }
                }
              ]
            }
          },
          "totals": {
            "type": "object",
            "additionalProperties": {
              "allOf": [
                {
                  "type": "object",
                  "properties": {
                    "requests": {
                      "type": "integer"
                    },
                    "completed": {
                      "type": "integer"
                    },
                    "failed": {
                      "type": "integer"
                    },
                    "audio_seconds": {
                      "type": "number"
                    }
                  }
                },
                {
                  "type": "object",
                  "properties": {
                    "avg_turnaround_seconds": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "description": "A5S Async v1 only."
                    }
                  }
                }
              ]
            },
            "description": "Per model id."
          },
          "by_key": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "name": {
                  "type": "string"
                },
                "model": {
                  "type": "string"
                },
                "requests": {
                  "type": "integer"
                },
                "audio_seconds": {
                  "type": "number"
                }
              }
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "type",
              "code",
              "message",
              "request_id"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "invalid_request_error",
                  "authentication_error",
                  "permission_error",
                  "rate_limit_error",
                  "api_error"
                ]
              },
              "code": {
                "type": "string",
                "description": "Machine-readable code; see [Errors](/errors)."
              },
              "message": {
                "type": "string"
              },
              "param": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The request field at fault, if any."
              },
              "request_id": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Also in the `x-request-id` header. Include it when contacting support. `null` on 502/504 from the edge."
              }
            }
          }
        }
      },
      "WebhookEvent": {
        "type": "object",
        "required": [
          "event",
          "id",
          "status"
        ],
        "properties": {
          "event": {
            "type": "string",
            "enum": [
              "transcript.completed",
              "transcript.failed",
              "diarization.completed",
              "diarization.failed"
            ]
          },
          "id": {
            "type": "string",
            "description": "Transcript or diarization ID."
          },
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "error"
            ]
          },
          "metadata": {
            "type": [
              "object",
              "null"
            ],
            "description": "Your `metadata`."
          }
        }
      }
    }
  }
}
