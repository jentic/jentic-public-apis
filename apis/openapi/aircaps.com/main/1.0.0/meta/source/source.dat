    "/v1/speakers/identify": {
      "post": {
        "summary": "Identify a speaker",
        "description": "Score one clip against your enrolled speakers: every speaker (or the ones in `speaker_ids`), best first, with a similarity score for each speaker's profile and for each enrollment. Synchronous: the result is the response. No threshold is applied; see [Speaker ID](/guides/speaker-id#scores-and-thresholds).",
        "responses": {
          "200": {
            "description": "The scores.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SpeakerIdentification"
                },
                "example": {
                  "id": "sid_01k73c0q9w8e7r6t5y4u3i2o1p",
                  "object": "speaker_identification",
                  "model": "aircaps-speaker-id-v1",
                  "created_at": "2026-10-08T18:06:30.551Z",
                  "audio_duration": 4.21,
                  "speakers_compared": 3,
                  "margin": 0.476,
                  "results": [
                    {
                      "speaker_id": "spk_01k73a9x8w7v6u5t4s3r2q1p0n",
                      "name": "Ana Garc\u00eda",
                      "score": 0.684,
                      "enrollment_scores": [
                        {
                          "enrollment_id": "enr_01k73b2c4d5e6f7g8h9j0k1m2n",
                          "score": 0.661
                        },
                        {
                          "enrollment_id": "enr_01k73b5f1h2j3k4m5n6p7q8r9s",
                          "score": 0.648
                        }
                      ]
                    },
                    {
                      "speaker_id": "spk_01k73a7m6n5b4v3c2x1z0l9k8j",
                      "name": "Ben Ito",
                      "score": 0.208,
                      "enrollment_scores": [
                        {
                          "enrollment_id": "enr_01k73a8h7g6f5d4s3a2p1o0i9u",
                          "score": 0.208
                        }
                      ]
                    },
                    {
                      "speaker_id": "spk_01k73a5q4w3e2r1t0y9u8i7o6p",
                      "name": null,
                      "score": 0.031,
                      "enrollment_scores": [
                        {
                          "enrollment_id": "enr_01k73a6z5x4c3v2b1n0m9l8k7j",
                          "score": 0.031
                        }
                      ]
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "The clip or request is not usable. Codes: `no_enrolled_speakers`, `speaker_not_enrolled`, `invalid_request`, `invalid_audio`, `audio_too_short`, `audio_too_long`, `unsupported_model`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "type": "invalid_request_error",
                    "code": "audio_too_short",
                    "message": "the clip is 0.62 s long; it must be at least 1 s",
                    "param": null,
                    "request_id": "req_01k6z3m4q8w7e5r2t1y0u9i8o7"
                  }
