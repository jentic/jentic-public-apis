      "delete": {
        "summary": "Delete a diarization",
        "description": "Cancels a `queued` or `processing` job (its `error.code` becomes `canceled`), or deletes a finished diarization and its stored data, including the uploaded file it used. Afterwards the ID returns `404`.",
        "responses": {
          "200": {
            "description": "The diarization, with `deleted: true`. Your `metadata`, `audio_url` and webhook settings are already removed.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/DiarizationSummary"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "deleted": {
                          "type": "boolean",
                          "enum": [
                            true
                          ]
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "id": "dia_01k72p0x9h6t3b8r1n4m7q2w5e",
                  "object": "diarization",
                  "status": "completed",
                  "created_at": "2026-10-08T18:01:02.123Z",
                  "started_at": "2026-10-08T18:01:02.456Z",
                  "completed_at": "2026-10-08T18:02:11.789Z",
                  "audio_url": "https://example.com/meeting.mp3",
                  "file_id": null,
                  "model": "aircaps-diarization-v1",
                  "audio_duration": 1834.112,
                  "metadata": {
                    "meeting_id": 42
                  },
                  "webhook_url": "https://example.com/hooks/aircaps",
                  "webhook_status": "delivered",
                  "webhook_status_code": 200,
                  "error": null,
                  "deleted": true
                }
              }
            }
          },
          "401": {
