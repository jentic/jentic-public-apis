                          "name": {
                            "type": "string"
                          },
                          "newsUrl": {
                            "type": "string"
                          },
                          "paidSearchIntelligenceUrl": {
                            "type": "string"
                          },
                          "paidSearchKeywordsIntelligenceUrl": {
                            "type": "string"
                          },
                          "revenueRange": {
