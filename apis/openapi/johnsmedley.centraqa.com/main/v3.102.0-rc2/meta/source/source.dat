          "406": {
            "description": "Invalid fields",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string",
                      "description": "Token for the current session, maintained by sending it as an API-token header or inside the Accept header. Will be `null` if API-token header value is `none`"
                    },
                    "errors": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      },
                      "description": ""
                    },
                    "messages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": ""
                    }
                  },
                  "description": ""
                },
                "examples": {
                  "Terms and conditions not sent": {
                    "value": {
                      "token": "e37b0c13e1gv4bdkceigir9go5",
                      "errors": {
                        "termsAndConditions": "required"
                      }
                    }
                  },
                  "Terms and conditions not approved": {
                    "value": {
                      "token": "e37b0c13e1gv4bdkceigir9go5",
                      "errors": {
                        "termsAndConditions": "must be true"
                      }
                    }
                  },
                  "Payment method not found": {
                    "value": {
                      "token": "e37b0c13e1gv4bdkceigir9go5",
                      "errors": {
                        "paymentMethod": "not found"
                      }
                    }
                  },
                  "Payment method error": {
                    "value": {
                      "token": "e37b0c13e1gv4bdkceigir9go5",
                      "errors": {
                        "paymentMethod": "failed"
                      },
                      "messages": [
                        "PayPal could not be initiated"
                      ]
                    }
                  },
                  "Shipping method not found": {
                    "value": {
                      "token": "e37b0c13e1gv4bdkceigir9go5",
                      "errors": {
                        "shippingMethod": "not found"
                      }
                    }
                  },
                  "Payment method not valid for gift certificates": {
                    "value": {
                      "token": "e37b0c13e1gv4bdkceigir9go5",
                      "errors": {
                        "paymentMethod": "cannot be used for gift certificates"
                      }
                    }
                  },
                  "Invalid VAT number": {
                    "value": {
                      "token": "e37b0c13e1gv4bdkceigir9go5",
                      "errors": {
                        "address.vatNumber": "Incorrect VAT Number"
                      }
                    }
                  },
                  "First name/Email not sent for address": {
                    "value": {
                      "token": "e37b0c13e1gv4bdkceigir9go5",
                      "errors": {
                        "address.email": "required",
                        "address.firstName": "required"
                      }
                    }
                  },
                  "Shipping address sent, but without a country": {
                    "value": {
                      "token": "e37b0c13e1gv4bdkceigir9go5",
                      "errors": {
                        "shippingAddress.country": "required"
                      }
                    }
                  }
                }
              }
            }
          },
