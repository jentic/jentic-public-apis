                }
              }
            }
          },
          "406": {
            "description": "When input value is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string",
                      "description": "Token for the current session, maintained by sending it as an API-token header or inside the Accept header. Will be `null` if API-token header value is `none`"
                    },
                    "errors": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      },
                      "description": ""
                    }
                  },
                  "description": ""
                },
                "examples": {
                  "Gift certificate amount invalid": {
                    "value": {
                      "token": "e37b0c13e1gv4bdkceigir9go5",
                      "errors": {
                        "amount": "expected type number"
                      }
                    }
                  },
                  "Gift certificate not allowing amounts": {
                    "value": {
                      "token": "e37b0c13e1gv4bdkceigir9go5",
                      "errors": {
                        "giftCertificate": "amount cannot be used with predeterminedAmount type gift certificate"
                      }
                    }
                  },
                  "Gift certificate no amount set in current currency": {
                    "value": {
                      "token": "e37b0c13e1gv4bdkceigir9go5",
                      "errors": {
                        "giftCertificate": "amount is not set for the proper currency in the gift certificate"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/items/gift-certificates/{giftCertificate}/amount/{amount}": {
      "post": {
        "summary": "Add a gift certificate to the selection.\n        This will remove all other items or gift certificates from the selection. Needs gift certificate endpoints to be enabled in the plugin",
        "description": "Add a gift certificate to the selection.\n        This will remove all other items or gift certificates from the selection. Needs gift certificate endpoints to be enabled in the plugin",
        "tags": [
          "2. selection handling, cart"
        ],
        "parameters": [
          {
            "name": "giftCertificate",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "string"
          },
          {
            "name": "amount",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "number, minimum 1. Required for anyAmount type gift certificates,\n                        must not be sent for predeterminedAmount type gift certificates"
