      "SelectionModel": {
        "properties": {
          "affiliateHtml": {
            "type": "string",
            "description": "HTML needed to inject into the DOM to trigger affiliate tracking scripts"
          },
          "giftMessage": {
            "type": "string",
            "description": "If order was a gift certificate purchase,\n            this contains the gift message"
          },
          "language": {
            "type": "string",
            "description": "Language ID. Selected language for the current selection"
          },
          "currency": {
            "type": "string",
            "description": "Currency code (ISO 4217). Currency for the selection"
          },
          "paymentMethod": {
            "type": "string",
            "description": "Selected payment method id"
          },
          "paymentMethodName": {
            "type": "string",
            "description": "Selected payment method name"
          },
          "shippingMethod": {
            "type": "string",
            "description": "Selected shipping method id"
          },
          "shippingMethodName": {
            "type": "string",
            "description": "Selected shipping method name"
          },
          "pluginFields": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/AnyValue"
            },
            "description": "Optional. Contains properties added by installed plugins\n                <br /><br />Ex: `paymentHTML`, string, optional.\n                Current checkout script for current order. Used for KCO/Klarna Checkout\n                <br /><br />Ex: `klarnaReplaceSnippet`, boolean, optional. If KCO should be reloaded or not\n                <br /><br />Ex: `shipwallet`, object, optional. Used for Ingrid widget\n                <br /><br />Ex: `shipwallet_reload`, bool, optional. Used for Ingrid widget"
          },
          "centraCheckoutScript": {
            "type": "string",
            "description": "Optional. Is added as soon as any installed plugin wants to load it. \n                Centra Checkout Script for supporting simple JavaScript hooks\n                in checkout process to make sure all payment checkout windows\n                are properly reloaded when selection changes"
          },
          "items": {
            "items": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/SelectionItemModel",
                  "type": "object",
                  "description": "Regular selection items"
                },
                {
                  "$ref": "#/components/schemas/SelectionBundleModel",
                  "type": "object",
                  "description": "Bundle in selection, contains selected items"
                }
              ]
