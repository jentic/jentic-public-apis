    "/items": {
      "put": {
        "summary": "Batch endpoint for selection lines quantity modifications and adding items",
        "description": "Batch endpoint for selection lines quantity modifications and adding items",
        "tags": [
          "4. selection handling, checkout flow"
        ],
        "parameters": [],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "lines": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "line"
                      ],
                      "properties": {
                        "line": {
                          "type": "string",
                          "description": "Unique id for the selection item. Selection line id"
                        },
                        "quantity": {
                          "type": "integer",
                          "description": "integer, minimum 0. Selection line quantity. Line will be completely removed if quantity is set to 0."
                        }
                      }
                    },
                    "description": "Lines and their quantities to be updated in the selection"
                  },
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "item"
                      ],
                      "properties": {
                        "item": {
                          "type": "string",
                          "description": "Product Item ID. Product item ID "
                        },
                        "quantity": {
                          "type": "integer",
                          "description": "integer, minimum 1. Product item quantity. Must be greater than 0."
                        }
                      }
                    },
                    "description": "Items and their quantities to be added to selection"
                  }
                },
                "description": ""
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Selection response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SelectionResponse",
                  "type": "object",
                  "description": ""
                },
                "examples": {
                  "Success response": {
                    "value": {
                      "token": "e37b0c13e1gv4bdkceigir9go5",
                      "selection": {
                        "language": "en",
