            "enum": [
              "DAY",
              "WEEK",
              "MONTH",
              "YEAR"
            ],
            "type": "string",
            "description": "Possible values: 'DAY', 'WEEK', 'MONTH', 'YEAR'. Deprecated. Use `intervalType` instead."
          },
          "intervalType": {
            "enum": [
              "DAY",
              "WEEK",
              "MONTH",
              "YEAR"
