      "post": {
        "summary": "Fetch bundle information about a product",
        "description": "Fetch bundle information about a product",
        "tags": [
          "5. product catalog"
        ],
        "parameters": [
          {
            "name": "product",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "string. Product Item ID"
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "language": {
                    "type": "string",
                    "description": "Language ID, if not provided the current session language is used"
                  },
                  "market": {
                    "oneOf": [
                      {
                        "type": "string",
                        "description": "To list markets for all products"
                      },
                      {
                        "type": "integer",
                        "description": "Integer. Market ID"
                      }
                    ],
                    "description": "Integer or string \"all\". Market ID. Requires shared secret"
                  },
                  "pricelist": {
                    "oneOf": [
                      {
                        "type": "string",
                        "description": "To list prices for all products"
                      },
                      {
                        "type": "integer",
                        "description": "Integer. Pricelist ID"
                      }
                    ],
                    "description": "Integer or string \"all\". Pricelist ID. Requires shared secret"
                  },
                  "includeSectionProducts": {
                    "type": "boolean",
                    "description": ""
                  }
                },
                "description": ""
              },
              "examples": {
                "Fetch bundle in Swedish": {
                  "value": {
                    "language": "sv"
                  }
                },
                "Fetch bundle for specific market/pricelist (Using shared secret)": {
                  "value": {
                    "market": 3,
                    "pricelist": 12
                  }
                },
                "Fetch bundle for all market/pricelists (Using shared secret)": {
                  "value": {
                    "market": "all",
                    "pricelist": "all"
                  }
                },
                "Fetch bundle with language based on current session": {
                  "value": {}
                },
                "Fetch bundle including details for section products": {
                  "value": {
                    "includeSectionProducts": "true"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Fetch bundle information about a product",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string",
                      "description": "Token for the current session, maintained by sending it as an API-token header or inside the Accept header. Will be `null` if API-token header value is `none`"
