    "/campaign-site": {
      "put": {
        "summary": "Use this when a customer visits a campaign site.\n        Send the campaign specific URI part of the URL as the \"uri\". This could modify the current market\n        of the session",
        "description": "Use this when a customer visits a campaign site.\n        Send the campaign specific URI part of the URL as the \"uri\". This could modify the current market\n        of the session",
        "tags": [
          "3. selection handling, modify selection"
        ],
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "uri"
                ],
                "properties": {
                  "uri": {
                    "type": "string",
                    "description": ""
                  }
                },
                "description": ""
              },
              "examples": {
                "Setting a campaign site to the selection": {
                  "value": {
                    "uri": "campaign1"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Modify the campaign site for the current session.",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "campaignSite": {
                      "type": "object",
                      "properties": {
                        "uri": {
                          "type": "string",
                          "description": "URI for the campaign site"
                        },
                        "goTo": {
                          "type": "string",
                          "description": "URL to redirect the customer to"
                        },
                        "name": {
                          "type": "string",
                          "description": "Name of the campaign site"
                        }
                      },
                      "description": ""
                    },
                    "token": {
                      "type": "string",
                      "description": "Token for the current session, maintained by sending it as an API-token header or inside the Accept header. Will be `null` if API-token header value is `none`"
                    },
                    "selection": {
                      "$ref": "#/components/schemas/SelectionModel",
                      "type": "object",
                      "description": ""
                    },
                    "languages": {
                      "items": {
                        "$ref": "#/components/schemas/LanguageModel",
                        "type": "object"
                      },
                      "type": "array",
                      "description": "All available languages"
                    },
                    "paymentMethods": {
                      "items": {
                        "$ref": "#/components/schemas/PaymentMethodModel",
                        "type": "object"
                      },
                      "type": "array",
                      "description": "All available payment methods for current selection"
                    },
                    "paymentFields": {
                      "$ref": "#/components/schemas/PaymentFieldsModel",
                      "type": "object",
                      "description": ""
                    },
                    "shippingMethods": {
                      "items": {
                        "$ref": "#/components/schemas/ShippingMethodModel",
                        "type": "object"
                      },
                      "type": "array",
                      "description": "All available shipping methods for current selection"
                    },
                    "countries": {
                      "items": {
                        "$ref": "#/components/schemas/CountryShippableModel",
                        "type": "object"
                      },
                      "type": "array",
                      "description": "All shippable countries"
                    },
                    "loggedIn": {
                      "$ref": "#/components/schemas/LoggedInModel",
                      "type": "object",
                      "description": "Optional. If the current session contains a logged in customer"
                    },
                    "location": {
                      "$ref": "#/components/schemas/LocationModel",
                      "type": "object",
                      "description": "Current location data for the session"
                    }
                  },
                  "type": "object",
                  "description": ""
                },
