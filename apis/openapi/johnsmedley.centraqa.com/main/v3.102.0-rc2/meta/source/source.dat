    "/countries/auto": {
      "get": {
        "summary": "Find the country code based on the IP of the visitor. Often used when proxies are used inbetween the customer and this API. It supports sending the IP with a `X-Forwarded-For`-header only for this endpoint.\n               The header supports both IPv6 and IPv4. If a token is not provided to this endpoint, it will give you a token back with the \n               country/language already set to the country/language in the response. If shared secret is used you also get market/pricelist information",
        "description": "Find the country code based on the IP of the visitor. Often used when proxies are used inbetween the customer and this API. It supports sending the IP with a `X-Forwarded-For`-header only for this endpoint.\n               The header supports both IPv6 and IPv4. If a token is not provided to this endpoint, it will give you a token back with the \n               country/language already set to the country/language in the response. If shared secret is used you also get market/pricelist information\n\nAccess Right: optional shared secret to retrieve additional properties",
        "tags": [
          "1. general settings"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Find current country based on GeoIP-data.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string",
                      "description": "Token for the current session, maintained by sending it as an API-token header or inside the Accept header. Will be `null` if API-token header value is `none`"
                    },
                    "country": {
                      "$ref": "#/components/schemas/CountryAuthorizedModel",
                      "type": "object",
                      "description": ""
                    }
                  },
                  "description": ""
                },
                "examples": {
                  "Client-side response (when not using shared secret)": {
                    "value": {
                      "token": "e37b0c13e1gv4bdkceigir9go5",
                      "country": [
                        {
                          "country": "AU",
                          "name": "Australia",
                          "eu": false,
                          "shipTo": true,
                          "language": "en",
                          "states": [
                            {
                              "state": "ACT",
                              "name": "Australian Capital Territory"
                            },
                            {
                              "state": "NSW",
                              "name": "New South Wales"
                            }
                          ]
                        },
                        {
                          "country": "JP",
                          "name": "Japan",
                          "eu": false,
                          "shipTo": true,
                          "language": "en",
                          "currency": "JPY"
                        }
                      ]
                    }
                  },
                  "Server-side response (when using shared secret)": {
                    "value": {
                      "token": "e37b0c13e1gv4bdkceigir9go5",
                      "country": [
                        {
                          "country": "AU",
                          "name": "Australia",
                          "eu": false,
                          "shipTo": true,
                          "language": "en",
                          "states": [
                            {
                              "state": "ACT",
                              "name": "Australian Capital Territory",
                              "shipTo": true
                            },
                            {
                              "state": "NSW",
                              "name": "New South Wales",
                              "shipTo": true
                            }
                          ],
                          "pricelist": "19",
                          "market": "1"
                        },
                        {
                          "country": "JP",
                          "name": "Japan",
                          "eu": false,
                          "shipTo": true,
                          "language": "en",
                          "currency": "JPY",
                          "pricelist": "23",
                          "market": "1"
                        },
                        {
                          "country": "AS",
                          "name": "American Samoa",
                          "eu": false,
                          "shipTo": false,
                          "language": "en",
                          "currency": "SEK",
                          "pricelist": "19",
                          "market": "1"
                        }
                      ]
                    }
                  }
                }
              }
            }
