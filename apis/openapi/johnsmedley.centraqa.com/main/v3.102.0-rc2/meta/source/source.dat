                    "type": "string",
                    "description": "string. Formatted price with currency prefix/suffix. Price after subscription discount"
                  },
                  "priceAfterDiscountAsNumber": {
                    "type": "number",
                    "description": "number. Price value as a float, example: 14.11. Price after subscription discount"
                  }
