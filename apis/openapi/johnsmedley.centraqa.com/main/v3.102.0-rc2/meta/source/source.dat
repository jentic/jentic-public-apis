            "type": "string",
            "description": "Possible values: 'FREE', 'DYNAMIC'"
          },
          "id": {
            "type": "integer",
            "description": "Integer. Subscription Plan ID. Deprecated - use `subscriptionPlan` instead"
          },
          "status": {
            "enum": {
              "ACTIVE": "ACTIVE",
              "INACTIVE": "INACTIVE",
              "CANCELLED": "CANCELLED"
