          "406": {
            "description": "When input value is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string",
                      "description": "Token for the current session, maintained by sending it as an API-token header or inside the Accept header. Will be `null` if API-token header value is `none`"
                    },
                    "errors": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      },
                      "description": ""
                    }
                  },
                  "description": ""
                },
                "examples": {
                  "Item ID invalid": {
                    "value": {
                      "token": "e37b0c13e1gv4bdkceigir9go5",
                      "errors": {
                        "item": "expected product item id, got: x-x"
                      }
                    }
                  },
                  "Quantity invalid": {
                    "value": {
                      "token": "e37b0c13e1gv4bdkceigir9go5",
                      "errors": {
                        "quantity": "expected type number"
                      }
                    }
                  },
                  "Category invalid": {
                    "value": {
                      "token": "e37b0c13e1gv4bdkceigir9go5",
                      "errors": {
                        "category": "expected type number"
                      }
                    }
                  },
                  "Product URL invalid": {
                    "value": {
                      "token": "e37b0c13e1gv4bdkceigir9go5",
                      "errors": {
                        "productUrl": "expected string to be an valid url"
                      }
                    }
                  },
                  "Multiple fields invalid": {
                    "value": {
                      "token": "e37b0c13e1gv4bdkceigir9go5",
                      "errors": {
                        "productUrl": "expected string to be an valid url",
                        "category": "expected type number"
                      }
                    }
                  }
                }
              }
            }
          },
