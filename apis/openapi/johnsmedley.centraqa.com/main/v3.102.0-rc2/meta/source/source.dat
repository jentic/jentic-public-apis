        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "amount": {
                    "type": "number",
                    "description": "number, minimum 1. Required for anyAmount type gift certificates,\n                        must not be sent for predeterminedAmount type gift certificates"
                  }
                },
                "description": ""
              },
