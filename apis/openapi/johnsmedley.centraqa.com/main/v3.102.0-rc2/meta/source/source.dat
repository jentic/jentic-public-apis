    "/payment-result": {
      "post": {
        "summary": "Send all variables received to paymentReturnPage\n        to verify if the order was created successfully or not",
        "description": "Send all variables received to paymentReturnPage\n        to verify if the order was created successfully or not",
        "tags": [
          "4. selection handling, checkout flow"
        ],
        "parameters": [],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "paymentMethodFields": {
                    "type": "object",
                    "additionalProperties": {
                      "$ref": "#/components/schemas/AnyValue"
                    },
                    "description": "Every query string parameter combined with \n                            POST-parameters receieved to the paymentReturnPage.\n                            All of these are needed to validate if the\n                            payment was successful or not"
                  }
                },
                "description": ""
              },
              "examples": {
