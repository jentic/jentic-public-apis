    "/fulfillment-check": {
      "post": {
        "summary": "Check which brick and mortars can fulfill the current selection, return sorted by stock level",
        "description": "Check which brick and mortars can fulfill the current selection, return sorted by stock level",
        "tags": [
          "2. selection handling, cart"
        ],
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "brickAndMortars"
                ],
                "properties": {
                  "brickAndMortars": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    },
                    "description": "Integer. List of brick and mortars to check"
                  }
                },
                "description": ""
              },
              "examples": {
                "Fetch brick and mortars": {
                  "value": {
                    "brickAndMortars": [
                      1,
                      3,
                      7
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Fetching Brick and mortars.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string",
                      "description": "Token for the current session, maintained by sending it as an API-token header or inside the Accept header. Will be `null` if API-token header value is `none`"
                    },
                    "brickAndMortars": {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      },
                      "description": "Integer. List of available brick and mortars sorted"
                    }
                  },
                  "description": ""
                },
                "examples": {
                  "Fetching Brick and mortars": {
                    "value": {
                      "token": "e37b0c13e1gv4bdkceigir9go5",
                      "brickAndMortars": [
                        7,
                        1
                      ]
                    }
                  }
                }
              }
            }
          },
          "412": {
            "description": "No items in the current selection",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string",
                      "description": "Token for the current session, maintained by sending it as an API-token header or inside the Accept header. Will be `null` if API-token header value is `none`"
                    },
                    "errors": {
                      "type": "object",
                      "properties": {
                        "selection": {
                          "type": "string",
                          "description": ""
                        }
                      },
                      "description": ""
                    }
                  },
                  "description": ""
                },
                "examples": {
                  "No items in the selection": {
                    "value": {
                      "token": "e37b0c13e1gv4bdkceigir9go5",
                      "errors": {
                        "selection": "no items in selection"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
