    "/uri": {
      "post": {
        "summary": "Use Centra as a routing mechanism to receive category/product data based on request path/URI",
        "description": "Use Centra as a routing mechanism to receive category/product data based on request path/URI",
        "tags": [
          "7. routing mechanism"
        ],
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "uri",
                  "for"
                ],
                "properties": {
                  "uri": {
                    "type": "string",
                    "description": ""
                  },
                  "for": {
                    "enum": [
                      "category",
                      "product"
                    ],
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Possible values: 'category', 'product'. An array of the types of data you support to receive"
                  },
                  "skipFirst": {
                    "type": "integer",
                    "description": "Integer. For type `category`: skip the first number of products"
                  },
                  "limit": {
                    "type": "integer",
                    "description": "Integer. For type `category`: return no more than this number of products"
                  },
                  "language": {
                    "type": "string",
                    "description": "Language ID, if not provided the current session language is used"
                  },
                  "market": {
                    "oneOf": [
                      {
                        "type": "string",
                        "description": "To list markets for all products"
                      },
                      {
                        "type": "integer",
                        "description": "Integer. Market ID"
                      }
                    ],
                    "description": "Integer or string \"all\". Market ID. Requires shared secret"
                  },
                  "pricelist": {
                    "oneOf": [
                      {
                        "type": "string",
                        "description": "To list prices for all products"
                      },
                      {
                        "type": "integer",
                        "description": "Integer. Pricelist ID"
                      }
                    ],
                    "description": "Integer or string \"all\". Pricelist ID. Requires shared secret"
                  },
                  "country": {
                    "type": "string",
                    "description": "Country ISO 3166-1 alpha-2, for example SE. Requires shared secret"
                  }
                },
                "description": ""
              },
              "examples": {
                "Look for URI in products/categories": {
                  "value": {
                    "uri": "blog",
                    "for": [
                      "product",
                      "category"
                    ]
                  }
                },
                "Sending the complete request path from the website": {
                  "value": {
                    "uri": "/shop/women/product1",
                    "for": [
                      "product",
                      "category"
                    ]
                  }
                },
                "Look for URI with specific market (Using shared secret)": {
                  "value": {
                    "uri": "blog",
                    "for": [
                      "product",
                      "category"
                    ],
                    "market": 1,
                    "pricelist": 19
                  }
                },
                "Fetch category and the first 50 products in the category": {
                  "value": {
                    "uri": "shop/women/shirts",
                    "for": [
                      "category"
                    ],
                    "skipFirst": 0,
                    "limit": 50
                  }
                },
                "Look for URI with specific language": {
                  "value": {
                    "uri": "blog",
                    "for": [
                      "product",
                      "category"
                    ],
                    "language": "sv"
                  }
                },
                "Look only for products": {
                  "value": {
                    "uri": "product-1",
                    "for": [
                      "product"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Fetching products/categories based on URI",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string",
                      "description": "Token for the current session, maintained by sending it as an API-token header or inside the Accept header. Will be `null` if API-token header value is `none`"
                    },
                    "found": {
                      "type": "string",
                      "description": "Type found, can only match with the ones sent in `for`"
                    },
                    "category": {
                      "$ref": "#/components/schemas/CategoryModel",
                      "type": "object",
                      "description": ""
                    },
                    "products": {
                      "items": {
                        "$ref": "#/components/schemas/ProductModel",
                        "type": "object"
                      },
                      "type": "array",
                      "description": "Optional. If a category was found, all products in the category"
                    },
                    "product": {
                      "$ref": "#/components/schemas/ProductModel",
                      "type": "object",
                      "description": ""
                    }
                  },
                  "description": "`product` Optional. If a product was found. Contains expanded related products\n                        <br /><br />\n                        `category` Optional. If a category was found, \n                        or if a product was found and it has a canonical category\n                        <br /><br />\n                        `products` Optional. If a category was found, contains the products in the category\n                        "
                },
                "examples": {
                  "Found a match on category": {
                    "value": {
                      "token": "e37b0c13e1gv4bdkceigir9go5",
                      "found": "category",
                      "category": [
                        {
                          "name": [
                            "Shop",
                            "Men",
                            "Linnen"
                          ],
                          "category": "1",
                          "uri": "shop/men/linnen",
                          "attributes": {
                            "va_seasoncode_key": " ",
                            "dis_badges_display": [
                              {
                                "desc": "choice 1",
                                "color": "#2D8FC6"
                              }
                            ],
                            "model_length_text": "sscscscs"
                          },
                          "inCategory": "1",
                          "metaKeywords": "xyz abc linnen",
                          "metaTitle": "Linnen shirts for Men",
                          "metaDescription": "Nice linnen shirts for men"
                        }
                      ],
                      "products": [
                        {
                          "available": true,
                          "relatedProducts": [
                            {
                              "product": "1",
                              "available": true,
                              "media": {
                                "standard": [
                                  "https://example.centracdn.net/client/dynamic/images/1_9adfeff6f2-red.jpg",
