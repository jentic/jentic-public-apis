    "/orders/{order}/items/{item}": {
      "post": {
        "summary": "Add item to the order. Will be released in the feature.",
        "description": "Add item to the order. Will be released in the feature.",
        "tags": [
          "8. Cross-sell handling"
        ],
        "parameters": [
          {
            "name": "order",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "order id"
          },
          {
            "name": "item",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Product Item or Fixed Bundle Product ID. Flexible bundles are not supported by this endpoint"
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "quantity": {
                    "type": "integer",
                    "description": "integer, minimum 1. defaults to 1"
                  },
                  "productUrl": {
                    "type": "string",
                    "description": "The URL to the product added, so the item can be linked back to its origin"
                  },
                  "category": {
                    "type": "string",
                    "description": "The category id of the added product, so the item can be linked back to its origin. The category id of the added product, so the item can be linked back to its origin"
                  },
                  "comment": {
                    "type": "string",
                    "description": "string. Requires shared secret. Comment that will end up on the order line"
                  },
                  "localizedProdSize": {
                    "type": "string",
                    "description": "Localized size (localizedSize) & localization definition name (localizationDefinitionName)"
                  }
                },
                "description": ""
              },
              "examples": {
                "Adding with product URL, comment and category": {
                  "value": {
                    "quantity": 1,
                    "category": 32,
                    "productUrl": "https://example.com/shirts/nice-product",
                    "comment": "my custom engraving"
                  }
                },
                "Adding 1 item": {
                  "value": {}
                },
                "Adding 1 item with a localized size": {
                  "value": {
                    "quantity": 1,
                    "productUrl": "https://example.com/shirts/nice-product",
                    "localizedProdSize": {
                      "localizationDefinitionName": "US",
                      "localizedSize": "39 inches"
                    }
                  }
                }
              }
            }
          }
        },
