    "/items/bundles/{item}": {
      "post": {
        "summary": "add flexible bundle to selection",
        "description": "add flexible bundle to selection",
        "tags": [
          "2. selection handling, cart"
        ],
        "parameters": [
          {
            "name": "item",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Product Item ID. The item of the bundle product"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "sections"
                ],
                "properties": {
                  "quantity": {
                    "type": "number",
                    "description": "number, minimum 1. defaults to 1"
                  },
                  "comment": {
                    "type": "string",
                    "description": "Rarely used comment that will end up on the order line"
                  },
                  "productUrl": {
                    "type": "string",
                    "description": "The URL to the product added, so the item can be linked back to its origin"
                  },
                  "category": {
                    "type": "number",
                    "description": "number, minimum 1. The category id of the added product, so the item can be linked back to its origin"
                  },
                  "localizedProdSize": {
                    "type": "string",
                    "description": "Localized size (localizedSize) & localization definition name (localizationDefinitionName)"
                  },
                  "sections": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "section",
                        "item"
                      ],
                      "properties": {
                        "section": {
                          "type": "string",
                          "description": "Section id"
                        },
                        "item": {
                          "type": "string",
                          "description": "Product Item ID. The selected item for the section"
                        }
                      }
                    },
                    "description": "The product selected for each section of the bundle"
                  },
                  "subscriptionPlan": {
                    "type": "string",
                    "description": "The ID of subscription plan"
                  }
                },
                "description": ""
              },
              "examples": {
                "Adding a flexible bundle": {
                  "value": {
                    "item": "60-29",
                    "sections": [
                      {
                        "section": "435",
                        "item": "60-31"
                      },
                      {
                        "section": "436",
                        "item": "60-30"
                      }
                    ],
                    "localizedProdSize": {
                      "localizationDefinitionName": "US",
                      "localizedSize": "39 inches"
                    }
                  }
                }
              }
            }
          }
        },
