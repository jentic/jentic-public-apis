      "post": {
        "summary": "Details of one product",
        "description": "Details of one product",
        "tags": [
          "5. product catalog"
        ],
        "parameters": [
          {
            "name": "product",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "string. Product Item ID"
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "language": {
                    "type": "string",
                    "description": "Language ID, if not provided the current session language is used"
                  },
                  "market": {
                    "oneOf": [
                      {
                        "type": "string",
                        "description": "To list markets for all products"
                      },
                      {
                        "type": "integer",
                        "description": "Integer. Market ID"
                      }
                    ],
                    "description": "Integer or string \"all\". Market ID. Requires shared secret"
                  },
                  "pricelist": {
                    "oneOf": [
                      {
                        "type": "string",
                        "description": "To list prices for all products"
                      },
                      {
                        "type": "integer",
                        "description": "Integer. Pricelist ID"
                      }
                    ],
                    "description": "Integer or string \"all\". Pricelist ID. Requires shared secret"
                  }
                },
                "description": ""
              },
              "examples": {
                "Fetch product in Swedish": {
                  "value": {
                    "language": "sv"
                  }
                },
                "Fetch product for specific market/pricelist (Using shared secret)": {
                  "value": {
                    "market": 3,
                    "pricelist": 12
                  }
                },
                "Fetch product for all market/pricelists (Using shared secret)": {
                  "value": {
                    "market": "all",
                    "pricelist": "all"
                  }
                },
                "Fetch product with language based on current session": {
                  "value": {}
                }
              }
            }
          }
        },
