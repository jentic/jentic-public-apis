    "/address": {
      "put": {
        "summary": "Change the registered address for the logged in customer",
        "description": "Change the registered address for the logged in customer\n\nAccess Right: logged in users",
        "tags": [
          "6. customer handling"
        ],
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
