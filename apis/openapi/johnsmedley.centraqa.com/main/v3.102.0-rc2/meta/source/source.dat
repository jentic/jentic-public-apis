                          "name": "English",
                          "default": true
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "When user is not logged in",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string",
                      "description": "Token for the current session, maintained by sending it as an API-token header or inside the Accept header. Will be `null` if API-token header value is `none`"
                    },
                    "errors": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      },
                      "description": ""
                    }
                  },
                  "description": ""
                },
                "examples": {
                  "User not logged in": {
                    "value": {
                      "token": "e37b0c13e1gv4bdkceigir9go5",
                      "errors": {
                        "accessRight": "denied"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "token": []
          }
        ]
      }
    },
    "/markets": {
      "get": {
        "summary": "List of available markets. Requires shared secret",
        "description": "List of available markets. Requires shared secret\n\nAccess Right: required shared secret",
        "tags": [
