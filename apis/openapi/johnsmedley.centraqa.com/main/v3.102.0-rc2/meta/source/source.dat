          },
          "states": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "state": {
                  "type": "string",
                  "description": "State ISO code, maxlength 6, Example: CA for California (US) and NSW for New South West (AU). \n        When used as input, the correct description of the state will also be allowed."
                },
                "name": {
                  "type": "string",
                  "description": "Name of state"
                }
              }
            },
            "description": "This property only shows up if the country actually has states."
          },
          "market": {
            "type": "string",
            "description": "Preferred market for this country. Requires shared secret"
          },
          "pricelist": {
            "type": "string",
            "description": "Preferred pricelist for this country. Requires shared secret"
          }
        },
        "type": "object"
      },
