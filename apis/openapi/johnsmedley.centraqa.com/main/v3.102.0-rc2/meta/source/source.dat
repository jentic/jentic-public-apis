                    "type": "string",
                    "description": "`window.origin` where the checkout is located. Used for more modern payment checkout methods where the current origin of the checkout needs to be validated properly."
                  },
                  "paymentMethodSpecificFields": {
                    "type": "object",
                    "additionalProperties": {
                      "$ref": "#/components/schemas/AnyValue"
                    },
                    "description": "Each payment plugin can require specific parameters to be sent. These parameters should be\n                        sent inside this property"
                  },
                  "shippingAddress": {
                    "type": "object",
                    "additionalProperties": {
                      "$ref": "#/components/schemas/AnyValue"
                    },
                    "description": ""
                  }
                },
                "description": ""
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stored payment update initialization response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string",
                      "description": "Token for the current session, maintained by sending it as an API-token header or inside the Accept header. Will be `null` if API-token header value is `none`"
                    },
                    "action": {
                      "enum": [
                        "form",
                        "redirect"
                      ],
                      "type": "string",
                      "description": "Possible values: 'form', 'redirect'. Type of payment action based on payment method"
                    },
                    "formHtml": {
                      "type": "string",
                      "description": "Optional. If action=form, \n                            this field contains the HTML including scripts that will automatically initiate\n                            finalization of the payment. It could either make a form that submits data, or an inline\n                            HTML for launching a checkout from a payment provider"
                    },
                    "url": {
                      "type": "string",
                      "description": "Optional. If action=redirect. The URL to redirect the customer to\n                        for finalization of the payment"
                    }
                  },
                  "description": ""
                },
                "examples": {
                  "Payment method with action=redirect": {
                    "value": {
                      "token": "e37b0c13e1gv4bdkceigir9go5",
                      "action": "redirect",
                      "url": "<form id=\"form-UUID\" action=\"https://example-payment.centra.com/success?centraPaymentMethod=dummy\" accept-charset=\"UTF-8\" method=\"post\"><input type=\"hidden\" name=\"paymentSignature\" value=\"xxxyyyzzz\" />...<noscript><input type=\"submit\" /></noscript><script>document.getElementById('form-UUID').submit();</script></form>"
                    }
                  },
                  "Payment method with action=formHtml": {
                    "value": {
                      "token": "e37b0c13e1gv4bdkceigir9go5",
                      "action": "form",
                      "formHtml": "<script>function loadStripeCheckout(){}...</script>",
                      "formType": "stripe-checkout",
                      "formFields": {
                        "externalScript": "https://js.stripe.com/checkout.1.2.3.js",
                        "publishableKey": "pk_live_xyz",
                        "sessionId": "asdf1234"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "token": []
          }
        ]
      }
    },
