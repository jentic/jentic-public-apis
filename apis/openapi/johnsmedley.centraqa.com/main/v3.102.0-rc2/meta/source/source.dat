                    "description": {
                      "type": "string",
                      "description": "Description of voucher"
                    },
                    "priceOff": {
                      "type": "string",
                      "description": "string. Formatted price with currency prefix/suffix. Amount reduced by this voucher"
                    },
                    "priceOffAsNumber": {
                      "type": "number",
                      "description": "number. Price value as a float, example: 14.11. Amount reduced by this voucher"
                    },
                    "originalPriceOff": {
                      "type": "string",
                      "description": "string. Formatted price with currency prefix/suffix. Formatted value for how much discount was given to the order"
                    },
                    "originalPriceOffAsNumber": {
                      "type": "number",
                      "description": "number. Price value as a float, example: 14.11. Unformatted version of originalPriceOff"
                    },
                    "isCredit": {
                      "type": "boolean",
                      "description": "Is this voucher a credit voucher"
                    },
                    "expiryDate": {
                      "type": "string",
                      "description": "Datetime, \"YYYY-MM-DD HH:ii:ss\" like \"2015-12-24 13:25:01\". Expiration date of the voucher"
                    },
                    "hasAffectedOrder": {
                      "type": "boolean",
                      "description": "Has this discount affected the order"
                    },
                    "attributes": {
                      "type": "object",
