    "/customer/contracts/{contract}/subscription": {
      "post": {
        "summary": "Allows adding a subscription to an existing contract.",
        "description": "Allows adding a subscription to an existing contract.\n\nAccess Right: logged in users",
        "tags": [
          "6. customer handling"
        ],
        "parameters": [
          {
            "name": "contract",
            "in": "path",
            "required": true,
