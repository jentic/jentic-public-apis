            "type": "string",
            "description": "String to separate integers from decimals, default \".\""
          },
          "thousandsSeparator": {
            "type": "string",
            "description": "Groups the digits of the integer part of large numbers into groups of three, default \" \""
          },
          "decimalDigits": {
            "type": "string",
            "description": "amount of decimals to be rendered"
