    "/newsletter-subscription": {
      "post": {
        "summary": "Subscribe to newsletter for the email address provided",
        "description": "Subscribe to newsletter for the email address provided",
        "tags": [
          "6. customer handling"
        ],
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "description": "E-mail address"
                  },
                  "email_field": {
                    "type": "string",
                    "description": ""
                  },
                  "product": {
                    "type": "string",
                    "description": "Product ID. No longer supported, use `POST /back-in-stock-subscription` endpoint instead. See the [documentation](https://centra.dev/docs/crafting-frontends/inventory/back-in-stock).",
                    "deprecated": true
                  },
                  "item": {
                    "type": "string",
                    "description": "Product Item ID. Item id, used to sign up for back in stock emails on size level."
                  },
                  "country": {
                    "type": "string",
                    "description": "Country ISO 3166-1 alpha-2, for example SE"
                  },
                  "language": {
                    "type": "string",
                    "description": "Language ID"
                  },
                  "gender": {
                    "type": "string",
                    "description": "female, male or nothing"
                  }
                },
                "description": ""
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sorry, no response specification."
          },
          "400": {
            "description": "Generic error response. The HTTP status code can be any 400 or 500 code. \n                    The \"errors\" object contains one or more key value pairs to describe the error to developers.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "errors"
                  ],
                  "properties": {
                    "errors": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      },
                      "description": ""
                    }
                  },
                  "description": ""
                },
                "examples": {
                  "Generic Error": {
                    "value": {
                      "errors": {
                        "item": "not found",
                        "address.email": "Expected type e-mail"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
