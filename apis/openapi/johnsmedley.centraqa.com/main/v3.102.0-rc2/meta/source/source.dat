                      "description": "Token for the current session, maintained by sending it as an API-token header or inside the Accept header. Will be `null` if API-token header value is `none`"
                    },
                    "errors": {
                      "type": "object",
                      "properties": {
                        "country": {
                          "type": "string",
                          "description": "If country was not found"
                        },
                        "state": {
                          "type": "string",
                          "description": "If state was not found"
                        },
                        "language": {
                          "type": "string",
                          "description": "If language was not found"
                        },
                        "market": {
                          "type": "string",
                          "description": "If market was not found"
                        },
                        "pricelist": {
                          "type": "string",
                          "description": "If pricelist was not found"
                        }
                      },
                      "description": ""
                    }
                  },
                  "description": ""
                },
                "examples": {
                  "Country not found": {
                    "value": {
                      "token": "e37b0c13e1gv4bdkceigir9go5",
                      "errors": {
                        "country": "not found"
                      }
                    }
                  },
                  "Market not found": {
                    "value": {
                      "token": "e37b0c13e1gv4bdkceigir9go5",
                      "errors": {
                        "market": "market not found"
                      }
                    }
                  },
                  "Market/Pricelist not found": {
                    "value": {
                      "token": "e37b0c13e1gv4bdkceigir9go5",
                      "errors": {
                        "market": "market not found",
                        "pricelist": "pricelist not found"
                      }
                    }
                  }
                }
              }
            }
          },
          "406": {
            "description": "When any of the modification entries were invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string",
                      "description": "Token for the current session, maintained by sending it as an API-token header or inside the Accept header. Will be `null` if API-token header value is `none`"
                    },
                    "errors": {
                      "type": "object",
                      "properties": {
                        "country": {
                          "type": "string",
                          "description": "If country was invalid"
                        },
                        "state": {
                          "type": "string",
                          "description": "If state was invalid"
                        },
                        "language": {
                          "type": "string",
                          "description": "If language was invalid"
                        },
                        "market": {
                          "type": "string",
                          "description": "If market was invalid"
                        },
                        "pricelist": {
                          "type": "string",
                          "description": "If pricelist was invalid"
                        }
                      },
                      "description": ""
                    }
                  },
                  "description": ""
                },
                "examples": {
                  "Invalid country": {
                    "value": {
                      "token": "e37b0c13e1gv4bdkceigir9go5",
                      "errors": {
                        "country": "expected type string"
                      }
                    }
                  },
                  "Invalid market": {
                    "value": {
                      "token": "e37b0c13e1gv4bdkceigir9go5",
                      "errors": {
                        "market": "expected market id"
                      }
                    }
                  }
                }
              }
            }
          }
