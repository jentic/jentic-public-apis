                    "type": "string",
                    "description": ""
                  },
                  "address2": {
                    "type": "string",
                    "description": ""
                  },
                  "zipCode": {
                    "type": "string",
                    "description": ""
                  },
                  "city": {
                    "type": "string",
                    "description": ""
                  },
                  "state": {
                    "type": "string",
                    "description": ""
                  },
                  "country": {
                    "type": "string",
                    "description": "Country ISO 3166-1 alpha-2, for example SE"
                  },
                  "phoneNumber": {
                    "type": "string",
                    "description": ""
                  }
                },
                "description": ""
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sorry, no response specification."
          },
          "400": {
            "description": "Generic error response. The HTTP status code can be any 400 or 500 code. \n                    The \"errors\" object contains one or more key value pairs to describe the error to developers.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "errors"
                  ],
                  "properties": {
                    "errors": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      },
                      "description": ""
                    }
                  },
                  "description": ""
                },
                "examples": {
                  "Generic Error": {
                    "value": {
                      "errors": {
                        "item": "not found",
                        "address.email": "Expected type e-mail"
                      }
                    }
                  }
                }
              }
            }
          }
        },
