    "/pricelists": {
      "get": {
        "summary": "List of available pricelists. Requires shared secret",
        "description": "List of available pricelists. Requires shared secret\n\nAccess Right: required shared secret",
        "tags": [
          "1. general settings"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Fetching all available pricelists.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string",
                      "description": "Token for the current session, maintained by sending it as an API-token header or inside the Accept header. Will be `null` if API-token header value is `none`"
                    },
                    "pricelists": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "pricelist": {
                            "type": "string",
                            "description": "Pricelist id"
                          },
                          "name": {
                            "type": "string",
                            "description": "Name of pricelist"
                          },
                          "default": {
                            "type": "boolean",
                            "description": "If the pricelist is the default fallback one for the store"
                          },
                          "currency": {
                            "$ref": "#/components/schemas/CurrencyModel",
                            "type": "object",
                            "description": ""
                          }
                        }
                      },
                      "description": ""
                    }
                  },
                  "description": ""
                },
                "examples": {
                  "Server-side response (when using shared secret)": {
                    "value": {
                      "token": "e37b0c13e1gv4bdkceigir9go5",
                      "pricelists": [
                        {
                          "pricelist": "1",
                          "name": "USD",
                          "default": true,
                          "currency": {
                            "currency": "USD",
                            "name": "USD",
                            "prefix": "",
                            "suffix": " USD",
                            "decimalPoint": ".",
                            "thousandsSeparator": " ",
                            "decimalDigits": "2",
                            "uri": "usd"
                          }
                        },
                        {
                          "pricelist": "2",
                          "name": "SEK",
                          "default": false,
                          "currency": {
                            "currency": "SEK",
                            "name": "SEK",
                            "prefix": "",
                            "suffix": " SEK",
                            "decimalPoint": ".",
                            "thousandsSeparator": " ",
                            "decimalDigits": "2",
                            "uri": "sek"
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Wrong shared secret.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string",
                      "description": "Token for the current session, maintained by sending it as an API-token header or inside the Accept header. Will be `null` if API-token header value is `none`"
                    },
                    "errors": {
                      "type": "object",
                      "properties": {
                        "accessRight": {
                          "type": "string",
                          "description": ""
                        }
                      },
                      "description": ""
                    }
                  },
                  "description": ""
                },
                "examples": {
                  "Shared secret invalid": {
                    "value": {
                      "token": "e37b0c13e1gv4bdkceigir9go5",
                      "errors": {
                        "accessRight": "denied"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "sharedSecret": []
          }
        ]
      }
    },
    "/products": {
      "post": {
        "summary": "Product list, supports filtering based on criteria, \n        returns filter capabilities for additional filtration",
        "description": "Product list, supports filtering based on criteria, \n        returns filter capabilities for additional filtration",
        "tags": [
          "5. product catalog"
        ],
        "parameters": [],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "skipFirst": {
                    "type": "integer",
                    "description": "Integer. Skip the first number of products, useful together with `limit`"
                  },
                  "limit": {
                    "type": "integer",
                    "description": "Integer. Return no more than this amount of products"
                  },
                  "categories": {
                    "type": "array",
                    "description": "Category ID or array of Category IDs. Filter to products in these categories, including subcategories"
                  },
                  "collections": {
                    "type": "array",
                    "description": "Collection ID or array of Category IDs. Filter to products only in these collections"
                  },
                  "items.name": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Limit to products with specific item names (usually sizes)"
                  },
                  "centraProduct": {
                    "type": "string",
                    "description": "Centra Product ID"
                  },
                  "search": {
                    "type": "string",
                    "description": "Free text search"
                  },
                  "searchFields": {
                    "enum": [
                      "name",
                      "brandName",
                      "collectionName",
                      "sku",
                      "excerpt",
                      "description",
                      "variantName",
                      "items.sku",
                      "items.ean",
                      "items.upc",
                      "categoryName",
                      "fuzzy:name",
                      "fuzzy:variantName"
                    ],
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Possible values: 'name', 'brandName', 'collectionName', 'sku', 'excerpt', 'description', 'variantName', 'items.sku', 'items.ean', 'items.upc', 'categoryName', 'fuzzy:name', 'fuzzy:variantName'. Specify what fields to free text search. When not provided, \n                the default selection will be used. `fuzzy:` mean it will allow certain differences between the search string and the result"
                  },
                  "onlyAvailable": {
                    "type": "boolean",
                    "description": "`true` returns only products available now, `false` returns all"
                  },
                  "showAsNew": {
                    "type": "boolean",
                    "description": "`true` will only return products with showAsNew=true. `false` will return all products"
                  },
                  "showAsOnSale": {
                    "type": "boolean",
                    "description": "`true` will only return products with showAsOnSale=true. `false` will return all products"
                  },
                  "products": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": ""
                  },
                  "measurementCharts": {
                    "type": "boolean",
                    "description": "To show measurement charts. Default is true"
                  },
                  "relatedProducts": {
                    "type": "boolean",
                    "description": "Default is false"
                  },
                  "uri": {
                    "type": "object",
                    "required": [
                      "uri",
                      "for"
                    ],
                    "properties": {
                      "uri": {
                        "type": "string",
                        "description": "find this URI"
                      },
                      "for": {
                        "enum": [
                          "category",
                          "product"
                        ],
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "description": "Possible values: 'category', 'product'. Set if the URI is for a category or a product or both"
                      }
                    },
                    "description": ""
                  },
                  "language": {
                    "type": "string",
                    "description": "Language ID, if not provided the current session language is used"
                  },
                  "market": {
                    "oneOf": [
                      {
                        "type": "string",
                        "description": "To list markets for all products"
                      },
                      {
                        "type": "integer",
                        "description": "Integer. Market ID"
                      }
                    ],
                    "description": "Integer or string \"all\". Market ID. Requires shared secret"
                  },
                  "pricelist": {
                    "oneOf": [
                      {
                        "type": "string",
                        "description": "To list prices for all products"
                      },
                      {
                        "type": "integer",
                        "description": "Integer. Pricelist ID"
                      }
                    ],
                    "description": "Integer or string \"all\". Pricelist ID. Requires shared secret"
                  },
                  "country": {
                    "type": "string",
                    "description": "Country ISO 3166-1 alpha-2, for example SE. Requires shared secret"
                  },
                  "withCategoryCustomAttributes": {
                    "type": "boolean",
                    "description": "`true` returns product categories with custom attributes only if we have `limit`, `false` returns product categories without custom attributes"
                  },
                  "sortOrder": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "field"
                      ],
                      "properties": {
                        "field": {
                          "enum": [
                            "uri",
                            "categoryItemSort",
                            "collectionUri",
                            "priceAsNumber",
                            "createdAt",
                            "modifiedAt"
                          ],
                          "type": "string",
                          "description": "Possible values: 'uri', 'categoryItemSort', 'collectionUri', 'priceAsNumber', 'createdAt', 'modifiedAt'"
                        },
                        "order": {
                          "enum": [
                            "asc",
                            "desc"
                          ],
                          "type": "string",
                          "description": "Possible values: 'asc', 'desc'. default is ascending, from lowest to highest"
                        }
                      }
                    },
                    "description": ""
                  }
                },
                "description": ""
              },
              "examples": {
                "Free text search": {
                  "value": {
                    "limit": 10,
                    "skipFirst": 0,
                    "search": "shirts"
                  }
                },
                "Get all products inside a category": {
                  "value": {
                    "categories": [
                      "15"
                    ]
                  }
                },
                "Get all products inside a category, most expensive first": {
                  "value": {
                    "categories": [
                      "15"
                    ],
                    "sortOrder": [
                      {
                        "field": "priceAsNumber",
                        "order": "desc"
                      }
                    ]
                  }
                },
                "Filter products based on a specific category URI": {
                  "value": {
                    "uri": {
                      "uri": "shirts",
                      "for": [
                        "category"
                      ]
                    }
                  }
                },
                "Fetch page 2 with 100 per page for Swedish": {
                  "value": {
                    "limit": 100,
                    "skipFirst": 100,
                    "language": "sv"
                  }
                },
                "Filter on only available products": {
                  "value": {
                    "onlyAvailable": true
                  }
                },
                "Skip returning measurement charts": {
                  "value": {
                    "measurementCharts": false
                  }
                },
                "Filter on specific sizes (if enabled to filter on in Checkout plugin settings)": {
                  "value": {
                    "items.name": [
                      "S",
                      "XXL"
                    ]
                  }
                },
                "Filter on custom attribute (if enabled to filter on in Checkout plugin settings)": {
                  "value": {
                    "customAttribute.elementName": [
                      "YYY"
                    ]
                  }
                },
                "Filter on one size products (If Sizechart uses empty size for One Size-products)": {
                  "value": {
                    "items.name": [
                      ""
                    ]
                  }
                },
                "Fetch products for specific market/pricelist (Using shared secret)": {
                  "value": {
                    "pricelist": 19,
                    "market": 2
                  }
                },
                "Fetch products with all pricelists and all markets in Swedish (Using shared secret)": {
                  "value": {
                    "limit": 100,
                    "skipFirst": 100,
                    "pricelist": "all",
                    "market": "all",
                    "language": "sv"
                  }
                },
                "Fetch products with all pricelists (Using shared secret)": {
                  "value": {
                    "limit": 100,
                    "skipFirst": 100,
                    "pricelist": "all"
                  }
                },
                "Fetching categories in Swedish (Using Client-side)": {
                  "value": {
                    "language": "sv"
                  }
                },
                "Fetch product categories with custom attributes and using `limit`": {
                  "value": {
                    "limit": 100,
                    "skipFirst": 100,
                    "withCategoryCustomAttributes": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Fetching all products.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string",
                      "description": "Token for the current session, maintained by sending it as an API-token header or inside the Accept header. Will be `null` if API-token header value is `none`"
                    },
                    "products": {
                      "oneOf": [
                        {
                          "$ref": "#/components/schemas/ProductModel",
                          "type": "object",
                          "description": ""
                        },
                        {
                          "$ref": "#/components/schemas/ProductAllModel",
                          "type": "object",
                          "description": ""
                        }
                      ],
                      "description": ""
                    },
                    "productCount": {
                      "type": "number",
                      "description": "Number. Total amount of products filtered, regardless of value of `limit`."
                    },
                    "filter": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "field": {
                            "type": "string",
                            "description": "Name for this filter method"
                          },
                          "values": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "value": {
                                  "type": "string",
                                  "description": "The value that should be used for the filter search"
                                },
                                "count": {
                                  "type": "number",
                                  "description": "Number. Items matching this filter option,\n                                            combined with all filter methods applied"
                                },
                                "filterCount": {
                                  "type": "number",
                                  "description": "Number. Items matching this filter option, \n                                            with all other filter methods included except the filter method it belongs to"
                                },
                                "totalCount": {
                                  "type": "number",
                                  "description": "Number. Items matching this filter option,\n                                            with all filter methods excluded"
                                },
                                "data": {
                                  "oneOf": [
                                    {
                                      "$ref": "#/components/schemas/CollectionModel",
                                      "type": "object",
                                      "description": ""
                                    },
                                    {
                                      "$ref": "#/components/schemas/CategoryModel",
                                      "type": "object",
                                      "description": ""
                                    },
                                    {
                                      "$ref": "#/components/schemas/BrandModel",
                                      "type": "object",
                                      "description": ""
                                    },
                                    {
                                      "type": "string",
                                      "description": "`items.name` will return a string\n                                                    for the size that can be filtered"
                                    },
                                    {
                                      "type": "object",
                                      "additionalProperties": {
                                        "$ref": "#/components/schemas/AnyValue"
                                      },
                                      "description": "Custom attributes will return all properties\n                                                     for the custom attribute"
                                    }
                                  ],
                                  "description": "Different data depending on what field we can filter on"
                                }
                              }
                            },
                            "description": "Each different value that can be filtered on for this filter type"
                          }
                        }
                      },
                      "description": "If Checkout plugin settings has enabled filters, each filter that\n                            can be applied to the current filtration"
                    }
                  },
                  "description": ""
                },
