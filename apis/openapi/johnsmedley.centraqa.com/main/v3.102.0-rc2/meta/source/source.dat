            "description": "All available shipping methods for current selection"
          },
          "countries": {
            "items": {
              "$ref": "#/components/schemas/CountryShippableModel",
              "type": "object"
            },
            "type": "array",
            "description": "All shippable countries"
          },
          "loggedIn": {
            "$ref": "#/components/schemas/LoggedInModel",
            "type": "object",
            "description": "Optional. If the current session contains a logged in customer"
          },
          "location": {
            "$ref": "#/components/schemas/LocationModel",
            "type": "object",
            "description": "Current location data for the session"
          }
        },
        "type": "object"
      },
      "OrderCompleteModel": {
        "properties": {
          "order": {
            "type": "string",
            "description": "Order number"
          },
          "status": {
            "enum": [
              "untouched",
              "progress",
              "ok",
              "archived",
              "failed"
            ],
            "type": "string",
            "description": "Possible values: 'untouched', 'progress', 'ok', 'archived', 'failed'. Status for the order.\n                Differs depending on how far in the order process the order is"
          },
          "statusDescription": {
            "enum": [
              "Pending",
              "Confirmed",
              "Processing",
              "Completed",
              "Archived",
              "Canceled",
              "Incomplete"
            ],
            "type": "string",
            "description": "Possible values: 'Pending', 'Confirmed', 'Processing', 'Completed', 'Archived', 'Canceled', 'Incomplete'. Explanation of the order status"
          },
          "date": {
            "type": "string",
            "description": "Datetime, \"YYYY-MM-DD HH:ii:ss\" like \"2015-12-24 13:25:01\". Order creation date. Timezone is defined by the current Centra instance"
          },
          "giftMessage": {
            "type": "string",
            "description": "If order was a gift certificate purchase,\n            this contains the gift message"
          },
          "language": {
            "type": "string",
            "description": "Language ID. Selected language for the current selection"
          },
          "currency": {
            "type": "string",
            "description": "Currency code (ISO 4217). Currency for the selection"
          },
          "paymentMethod": {
            "type": "string",
            "description": "Selected payment method id"
          },
          "paymentMethodName": {
            "type": "string",
            "description": "Selected payment method name"
          },
          "shippingMethod": {
            "type": "string",
            "description": "Selected shipping method id"
          },
          "shippingMethodName": {
            "type": "string",
            "description": "Selected shipping method name"
          },
          "pluginFields": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/AnyValue"
            },
            "description": "Optional. Contains properties added by installed plugins\n                <br /><br />Ex: `paymentHTML`, string, optional.\n                Current checkout script for current order. Used for KCO/Klarna Checkout\n                <br /><br />Ex: `klarnaReplaceSnippet`, boolean, optional. If KCO should be reloaded or not\n                <br /><br />Ex: `shipwallet`, object, optional. Used for Ingrid widget\n                <br /><br />Ex: `shipwallet_reload`, bool, optional. Used for Ingrid widget"
          },
          "centraCheckoutScript": {
            "type": "string",
            "description": "Optional. Is added as soon as any installed plugin wants to load it. \n                Centra Checkout Script for supporting simple JavaScript hooks\n                in checkout process to make sure all payment checkout windows\n                are properly reloaded when selection changes"
          },
          "items": {
            "items": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/SelectionItemModel",
                  "type": "object",
                  "description": "Regular selection items"
                },
                {
                  "$ref": "#/components/schemas/SelectionBundleModel",
                  "type": "object",
                  "description": "Bundle in selection, contains selected items"
                }
              ]
            },
            "type": "array",
            "description": ""
          },
          "discounts": {
            "type": "object",
            "properties": {
              "anyDiscount": {
                "type": "boolean",
                "description": "If any discount was applied to the order"
              },
              "discount": {
                "type": "string",
                "description": "string. Formatted price with currency prefix/suffix. Total discount amount applied to the order"
              },
              "discountAsNumber": {
                "type": "number",
                "description": "number. Price value as a float, example: 14.11. Total discount amount applied to the order"
              },
              "automaticDiscounts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "automaticDiscount": {
                      "type": "string",
                      "description": "ID of this discount"
                    },
                    "name": {
                      "type": "string",
                      "description": "Name of this discount"
                    },
                    "priceOff": {
                      "type": "string",
                      "description": "string. Formatted price with currency prefix/suffix. Amount reduced by this discount"
                    },
                    "priceOffAsNumber": {
                      "type": "number",
                      "description": "number. Price value as a float, example: 14.11. Amount reduced by this discount"
                    },
                    "originalPriceOff": {
                      "type": "string",
                      "description": "string. Formatted price with currency prefix/suffix. Formatted value for how much discount was given to the order"
                    },
                    "originalPriceOffAsNumber": {
                      "type": "number",
                      "description": "number. Price value as a float, example: 14.11. Unformatted version of originalPriceOff"
                    },
                    "isCredit": {
                      "type": "boolean",
                      "description": "Is this voucher a credit voucher"
                    },
                    "expiryDate": {
                      "type": "string",
                      "description": "Datetime, \"YYYY-MM-DD HH:ii:ss\" like \"2015-12-24 13:25:01\". Expiration date of the voucher"
                    },
                    "hasAffectedOrder": {
                      "type": "boolean",
                      "description": "Has this discount affected the order"
                    },
                    "attributes": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      },
                      "description": ""
                    }
                  }
                },
                "description": ""
              },
              "vouchers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "voucher": {
                      "type": "string",
                      "description": "Voucher code"
                    },
                    "type": {
                      "enum": [
                        "code",
                        "uri",
                        "other"
                      ],
                      "type": "string",
                      "description": "Possible values: 'code', 'uri', 'other'. Type of voucher added"
                    },
                    "description": {
                      "type": "string",
                      "description": "Description of voucher"
                    },
                    "priceOff": {
                      "type": "string",
                      "description": "string. Formatted price with currency prefix/suffix. Amount reduced by this voucher"
                    },
                    "priceOffAsNumber": {
                      "type": "number",
                      "description": "number. Price value as a float, example: 14.11. Amount reduced by this voucher"
                    },
                    "originalPriceOff": {
                      "type": "string",
                      "description": "string. Formatted price with currency prefix/suffix. Formatted value for how much discount was given to the order"
                    },
                    "originalPriceOffAsNumber": {
                      "type": "number",
                      "description": "number. Price value as a float, example: 14.11. Unformatted version of originalPriceOff"
                    },
                    "isCredit": {
                      "type": "boolean",
                      "description": "Is this voucher a credit voucher"
                    },
                    "expiryDate": {
                      "type": "string",
                      "description": "Datetime, \"YYYY-MM-DD HH:ii:ss\" like \"2015-12-24 13:25:01\". Expiration date of the voucher"
                    },
                    "hasAffectedOrder": {
                      "type": "boolean",
                      "description": "Has this discount affected the order"
                    },
                    "attributes": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      },
                      "description": ""
                    },
                    "lines": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "A list of all the line IDs this voucher has affected"
                    },
                    "shippingDiscount": {
                      "type": "string",
                      "description": "string. Formatted price with currency prefix/suffix. Formatted value of how much this discount has reduced the shipping value"
                    },
                    "shippingDiscountAsNumber": {
                      "type": "number",
                      "description": "number. Price value as a float, example: 14.11. Unformatted version of shippingDiscount"
                    },
                    "freeProductAdded": {
                      "type": "object",
                      "properties": {
                        "line": {
                          "type": "string",
                          "description": "line ID of the item that was added for free"
                        },
                        "allowRemove": {
                          "type": "boolean",
                          "description": "is the customer allowed to remove this line"
                        },
                        "allowAddMore": {
                          "type": "boolean",
                          "description": "Is the customer allowed to add more quantity of this product"
                        }
                      },
                      "description": ""
                    },
                    "freeShippingFor": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "List of shipping groups this will give free shipping to"
                    }
                  }
                },
                "description": ""
              }
            },
            "description": ""
          },
          "totals": {
            "type": "object",
            "properties": {
              "itemsTotalPrice": {
                "type": "string",
                "description": "string. Formatted price with currency prefix/suffix. Total price for all items"
              },
              "itemsTotalPriceAsNumber": {
                "type": "number",
                "description": "number. Price value as a float, example: 14.11. Total price for all items"
              },
              "totalDiscountPrice": {
                "oneOf": [
                  {
                    "type": "string",
                    "description": ""
                  },
                  {
                    "type": "boolean",
                    "description": ""
                  }
                ],
                "description": "string or false. Total discount. false if none"
              },
              "totalDiscountPriceAsNumber": {
                "oneOf": [
                  {
                    "type": "integer",
                    "description": "Integer"
                  },
                  {
                    "type": "boolean",
                    "description": ""
                  }
                ],
                "description": "number or false. Total discount as number. false if none"
              },
              "shippingPrice": {
                "type": "string",
                "description": "string. Formatted price with currency prefix/suffix. Shipping cost"
              },
              "shippingPriceAsNumber": {
                "type": "number",
                "description": "number. Price value as a float, example: 14.11. Shipping cost"
              },
              "handlingCostAddedToShippingPrice": {
                "type": "boolean",
                "description": "If handling cost was added to shipping cost"
              },
              "totalQuantity": {
                "type": "number",
                "description": "Number. Total quantity in selection"
              },
              "taxDeducted": {
                "oneOf": [
                  {
                    "type": "string",
                    "description": ""
                  },
                  {
                    "type": "boolean",
                    "description": ""
                  }
                ],
                "description": "string or false. Tax deducted from selection, if applicable. default false"
              },
              "taxDeductedAsNumber": {
                "oneOf": [
                  {
                    "type": "integer",
                    "description": "Integer"
                  },
                  {
                    "type": "boolean",
                    "description": ""
                  }
                ],
                "description": "number or false. Tax deducted from selection, if applicable. default false"
              },
              "taxAdded": {
                "oneOf": [
                  {
                    "type": "integer",
                    "description": "Integer"
                  },
                  {
                    "type": "boolean",
                    "description": ""
                  }
                ],
                "description": "number or false. Tax added on selection, if applicable else false"
              },
              "taxAddedAsNumber": {
                "oneOf": [
                  {
                    "type": "string",
                    "description": ""
                  },
                  {
                    "type": "boolean",
                    "description": ""
                  }
                ],
                "description": "string or false. Tax added from selection, if applicable else false"
              },
              "taxPercent": {
                "type": "number",
                "description": "Number. Percentage of tax on the selection"
              },
              "grandTotalPrice": {
                "type": "string",
                "description": "string. Formatted price with currency prefix/suffix. Grand total for selection"
              },
              "grandTotalPriceAsNumber": {
                "type": "number",
                "description": "number. Price value as a float, example: 14.11. Grand total for selection"
              },
              "grandTotalPriceTax": {
                "type": "string",
                "description": "string. Formatted price with currency prefix/suffix. Grand total tax for selection"
              },
              "grandTotalPriceTaxAsNumber": {
                "type": "number",
                "description": "number. Price value as a float, example: 14.11. Grand total tax for selection"
              },
              "itemTotalPriceAfterCampaign": {
                "type": "string",
                "description": "string. Formatted price with currency prefix/suffix. Total price after campaign"
              },
              "itemTotalPriceAfterCampaignAsNumber": {
                "type": "number",
                "description": "number. Price value as a float, example: 14.11. Total price after campaign as a number"
              },
              "itemTotalPriceAfterDiscount": {
                "type": "string",
                "description": "string. Formatted price with currency prefix/suffix. Total price after discount"
              },
              "itemTotalPriceAfterDiscountAsNumber": {
                "type": "number",
                "description": "number. Price value as a float, example: 14.11. Total price after discount as a number"
              }
            },
            "description": ""
          },
          "vatExempt": {
            "type": "boolean",
            "description": "If selection qualifies for VAT exemption"
