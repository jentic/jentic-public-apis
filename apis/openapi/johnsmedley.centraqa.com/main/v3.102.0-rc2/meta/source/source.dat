                      },
                      "state": {
                        "type": "string",
                        "description": "State ISO code, maxlength 6, Example: CA for California (US) and NSW for New South West (AU). \n        When used as input, the correct description of the state will also be allowed.. Required only for countries with states if allocation rule requires a state"
                      }
                    },
                    "description": ""
                  },
                  "item": {
                    "type": "string",
                    "description": "Product Item ID"
                  },
                  "language": {
                    "type": "string",
