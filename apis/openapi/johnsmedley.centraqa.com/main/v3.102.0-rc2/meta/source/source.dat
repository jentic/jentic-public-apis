    "/lines/{line}": {
      "post": {
        "summary": "Increase quantity of an item in the current selection using the line ID",
        "description": "Increase quantity of an item in the current selection using the line ID",
        "tags": [
          "4. selection handling, checkout flow"
        ],
        "parameters": [
          {
            "name": "line",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Unique id for the selection item"
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "quantity": {
                    "type": "number",
                    "description": "number, minimum 1. defaults to 1"
                  }
                },
                "description": ""
              },
              "examples": {
                "Adding specific quantity to a current line ID": {
                  "value": {
                    "quantity": 1
                  }
                },
                "Adding quantity 1 to existing line ID": {
                  "value": {}
                }
              }
            }
          }
        },
