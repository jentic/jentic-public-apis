          "403": {
            "description": "When gift certificates are not enabled in Checkout API",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string",
                      "description": "Token for the current session, maintained by sending it as an API-token header or inside the Accept header. Will be `null` if API-token header value is `none`"
                    },
                    "errors": {
                      "type": "object",
                      "properties": {
                        "feature": {
                          "type": "string",
                          "description": ""
                        }
                      },
                      "description": ""
                    }
                  },
                  "description": ""
                },
                "examples": {
                  "Gift certificates not enabled": {
                    "value": {
                      "token": "e37b0c13e1gv4bdkceigir9go5",
                      "errors": {
                        "feature": "not enabled"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "When gift certificate is not found.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string",
                      "description": "Token for the current session, maintained by sending it as an API-token header or inside the Accept header. Will be `null` if API-token header value is `none`"
                    },
                    "errors": {
                      "type": "object",
                      "properties": {
                        "giftCertificate": {
                          "type": "string",
                          "description": ""
                        }
                      },
                      "description": ""
                    }
                  },
                  "description": ""
                },
                "examples": {
                  "Gift certificate not found": {
                    "value": {
                      "token": "e37b0c13e1gv4bdkceigir9go5",
                      "errors": {
                        "giftCertificate": "not found"
                      }
                    }
                  }
                }
              }
            }
          },
          "406": {
            "description": "When input value is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string",
                      "description": "Token for the current session, maintained by sending it as an API-token header or inside the Accept header. Will be `null` if API-token header value is `none`"
                    },
                    "errors": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      },
                      "description": ""
                    }
                  },
                  "description": ""
                },
                "examples": {
                  "Gift certificate amount invalid": {
                    "value": {
                      "token": "e37b0c13e1gv4bdkceigir9go5",
                      "errors": {
                        "amount": "expected type number"
                      }
                    }
                  },
                  "Gift certificate not allowing amounts": {
                    "value": {
                      "token": "e37b0c13e1gv4bdkceigir9go5",
                      "errors": {
                        "giftCertificate": "amount cannot be used with predeterminedAmount type gift certificate"
                      }
                    }
                  },
                  "Gift certificate no amount set in current currency": {
                    "value": {
                      "token": "e37b0c13e1gv4bdkceigir9go5",
                      "errors": {
                        "giftCertificate": "amount is not set for the proper currency in the gift certificate"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/items/{item}": {
      "post": {
        "summary": "Add item to the selection",
        "description": "Add item to the selection",
        "tags": [
          "2. selection handling, cart"
        ],
        "parameters": [
          {
            "name": "item",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Product Item ID"
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "quantity": {
                    "type": "number",
                    "description": "number, minimum 1. defaults to 1"
                  },
                  "productUrl": {
                    "type": "string",
                    "description": "The URL to the product added, so the item can be linked back to its origin"
                  },
                  "category": {
                    "type": "number",
                    "description": "number, minimum 1. The category id of the added product, so the item can be linked back to its origin"
                  },
                  "comment": {
                    "type": "string",
                    "description": "string. Requires shared secret. Comment that will end up on the order line"
                  },
                  "localizedProdSize": {
                    "type": "string",
                    "description": "Localized size (localizedSize) & localization definition name (localizationDefinitionName)"
                  },
                  "subscriptionPlan": {
                    "type": "string",
                    "description": "The ID of subscription plan"
                  }
                },
                "description": ""
              },
              "examples": {
                "Adding with product URL, comment and category": {
                  "value": {
                    "quantity": 1,
                    "category": 32,
                    "productUrl": "https://example.com/shirts/nice-product",
                    "comment": "my custom engraving"
                  }
                },
                "Adding 1 item": {
                  "value": {}
                },
                "Adding 1 item with a localized size": {
                  "value": {
                    "quantity": 1,
                    "productUrl": "https://example.com/shirts/nice-product",
                    "localizedProdSize": {
                      "localizationDefinitionName": "US",
                      "localizedSize": "39 inches"
                    }
                  }
                },
                "Adding with subscription": {
                  "value": {
                    "subscriptionPlan": 45
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Adding an item to the selection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SelectionResponse",
