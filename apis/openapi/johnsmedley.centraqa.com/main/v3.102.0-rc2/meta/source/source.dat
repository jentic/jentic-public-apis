                        "shippingMethodName": "Standard",
                        "items": [
                          {
                            "item": "60-29",
                            "productUrl": null,
                            "category": null,
                            "comment": "",
                            "size": "S",
                            "sku": "123Yo",
                            "ean": "1234567899",
                            "upc": "123456",
                            "quantity": 1,
                            "subscriptionPlan": {
                              "name": "Save 5% with monthly subscription",
