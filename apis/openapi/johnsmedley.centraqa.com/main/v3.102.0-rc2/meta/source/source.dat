                    "description": "integer, minimum 1"
                  },
                  "nextOrderDate": {
                    "type": "string",
                    "description": "date YYYY-MM-DD like 2015-12-24 (must be in the future)"
                  }
                },
                "description": ""
              },
              "examples": {
