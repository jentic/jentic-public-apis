                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Payment method action response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string",
                      "description": "Token for the current session, maintained by sending it as an API-token header or inside the Accept header. Will be `null` if API-token header value is `none`"
                    },
                    "action": {
                      "enum": [
                        "form",
                        "redirect",
                        "javascript"
                      ],
                      "type": "string",
                      "description": "Possible values: 'form', 'redirect', 'javascript'. Type of payment action based on payment method"
                    },
                    "formType": {
                      "type": "string",
                      "description": "Optional. When action=form this contains the type of payment method\n                        plugin that is returned, to be able to identify what needs to be done with the response\n                        <br /><br />Ex: `adyen-checkout`, `formFields` now contains the `adyenSession` value if you want\n                        to initiate it differently to the default inside `formHtml`\n                        <br /><br />Ex: `stripe-checkout`, `formFields` now contains\n                        `sessionId`, `publishableKey` and `externalScript`\n                        if you want to initiate the Stripe Checkout differently from the default way in `formHtml`"
                    },
                    "formHtml": {
                      "type": "string",
                      "description": "Optional. If action=form, \n                            this field contains the HTML including scripts that will automatically initiate\n                            finalization of the payment. It could either make a form that submits data, or an inline\n                            HTML for launching a checkout from a payment provider"
                    },
                    "code": {
                      "type": "string",
                      "description": "Optional. If action=javascript,\n                            this field contains the JavaScript that should be evaluated to continue to payment process."
                    },
                    "formFields": {
                      "type": "object",
                      "additionalProperties": {
                        "$ref": "#/components/schemas/AnyValue"
                      },
                      "description": "Optional. If action=form,\n                            list of fields to submit to formUrl as a POST-request, or the \n                            variables needed to initiate the payment method yourself"
                    },
                    "formUrl": {
                      "type": "string",
                      "description": "Optional. If action=form, an URL to POST all formFields to"
                    },
                    "url": {
                      "type": "string",
                      "description": "Optional. If action=redirect. The URL to redirect the customer to\n                        for finalization of the payment"
                    }
                  },
                  "description": ""
                },
                "examples": {
                  "Payment method with action=redirect": {
                    "value": {
                      "token": "e37b0c13e1gv4bdkceigir9go5",
                      "action": "redirect",
                      "url": "<form id=\"form-UUID\" action=\"https://example-payment.centra.com/success?centraPaymentMethod=dummy\" accept-charset=\"UTF-8\" method=\"post\"><input type=\"hidden\" name=\"paymentSignature\" value=\"xxxyyyzzz\" />...<noscript><input type=\"submit\" /></noscript><script>document.getElementById('form-UUID').submit();</script></form>"
                    }
                  },
                  "Payment method with action=formHtml and formType": {
                    "value": {
                      "token": "e37b0c13e1gv4bdkceigir9go5",
                      "action": "form",
                      "formHtml": "<script>function loadStripeCheckout(){}...</script>",
                      "formType": "stripe-checkout",
                      "formFields": {
                        "externalScript": "https://js.stripe.com/checkout.1.2.3.js",
                        "publishableKey": "pk_live_xyz",
                        "sessionId": "fafafa"
                      }
                    }
                  },
                  "Payment method with action=form": {
                    "value": {
                      "token": "e37b0c13e1gv4bdkceigir9go5",
                      "action": "form",
                      "formHtml": "<form id=\"form-UUID\" action=\"https://example-payment.centra.com/success?centraPaymentMethod=dummy\" accept-charset=\"UTF-8\" method=\"post\"><input type=\"hidden\" name=\"paymentSignature\" value=\"xxxyyyzzz\" />...<noscript><input type=\"submit\" /></noscript><script>document.getElementById('form-UUID').submit();</script></form>"
                    }
                  },
                  "Payment method with action=javascript": {
                    "value": {
                      "token": "e37b0c13e1gv4bdkceigir9go5",
                      "action": "javascript",
                      "code": "...; document.dispatchEvent('xxx', ...);"
                    }
                  },
                  "Payment method with action=form including separate formFields": {
                    "value": {
                      "token": "e37b0c13e1gv4bdkceigir9go5",
                      "action": "form",
                      "formHtml": "<form id=\"form-UUID\" action=\"https://example-payment.centra.com/success?centraPaymentMethod=dummy\" accept-charset=\"UTF-8\" method=\"post\"><input type=\"hidden\" name=\"paymentSignature\" value=\"xxxyyyzzz\" />...<noscript><input type=\"submit\" /></noscript><script>document.getElementById('form-UUID').submit();</script></form>",
                      "formFields": {
                        "paymentSignature": "xxxyyyzzz",
                        "amount": "12344",
                        "currency": "USD"
                      },
                      "formUrl": "https://example-payment.centra.com/success?centraPaymentMethod=dummy"
                    }
                  },
                  "Payment initiate only with the express flag": {
                    "value": {
                      "token": "e37b0c13e1gv4bdkceigir9go5",
                      "action": "form",
                      "expressFormHtml": [
                        {
                          "name": "express_checkout_<plugin>_<payment method>",
                          "contents": "<script>// script contents</script>"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "201": {
            "description": "Order was completed directly",
