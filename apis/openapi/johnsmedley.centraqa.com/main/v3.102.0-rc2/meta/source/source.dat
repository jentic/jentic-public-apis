      "delete": {
        "summary": "Reduce quantity of an item in the current selection using the line ID",
        "description": "Reduce quantity of an item in the current selection using the line ID",
        "tags": [
          "4. selection handling, checkout flow"
        ],
        "parameters": [
          {
            "name": "line",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Unique id for the selection item"
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "quantity": {
                    "type": "number",
                    "description": "number, minimum 1. Without quantity, the whole line is removed"
                  }
                },
                "description": ""
              },
              "examples": {
                "Removing specific quantity from a current line ID": {
                  "value": {
                    "quantity": 1
                  }
                },
                "Removing quantity 1 from existing line ID": {
