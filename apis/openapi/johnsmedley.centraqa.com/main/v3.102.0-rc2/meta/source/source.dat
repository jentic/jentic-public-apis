    "/countries/{country}/states/{state}": {
      "put": {
        "summary": "Change country of the current selection",
        "description": "Change country of the current selection",
        "tags": [
          "3. selection handling, modify selection"
        ],
        "parameters": [
          {
            "name": "country",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Country ISO 3166-1 alpha-2, for example SE"
          },
          {
            "name": "state",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "State ISO code, maxlength 6, Example: CA for California (US) and NSW for New South West (AU). \n        When used as input, the correct description of the state will also be allowed.. For countries with states"
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "language": {
                    "type": "string",
                    "description": "Language ID"
                  },
                  "updateSizeLocalizationsInBasket": {
                    "type": "boolean",
                    "description": "Reload localized size items value with new country localized size chart if exists and remove the localized size value from items if not exists"
                  }
                },
                "description": ""
              },
              "examples": {
                "Changing country/state with language": {
                  "value": {
                    "language": "sv"
                  }
                },
                "Changing only the country/state but keeping previous size chart localizations": {
                  "value": {}
                },
                "Changing only the country/state with corresponding size chart localizations": {
                  "value": {
                    "updateSizeLocalizationsInBasket": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Modify the country/language for the current session.",
