      "GiftCertificateModel": {
        "properties": {
          "giftCertificate": {
            "type": "string",
            "description": "Id of gift certificate"
          },
          "name": {
            "type": "string",
            "description": "Name of gift certificate"
          },
          "currencyOfSaleOnly": {
            "type": "boolean",
            "description": "If the gift certificate should\n                generate the discount in multiple currencies or not. Default `false`. Requires shared secret."
          },
          "showGiftAmount": {
            "type": "boolean",
            "description": "If the amount will be shown on the gift certificate.\n                If the amount equals a pack, this could be set as `false` to only show the name of the gift certificate. Requires shared secret."
          },
          "type": {
            "enum": [
              "predeterminedAmount",
              "anyAmount"
            ],
            "type": "string",
            "description": "Possible values: 'predeterminedAmount', 'anyAmount'. `predeterminedAmount` has a defined amount for each currency set.\n                `anyAmount` can be used to decide on a specific amount."
          },
          "amount": {
            "type": "object",
            "properties": {
              "amount": {
                "type": "string",
                "description": "Value in the current currency, formatted"
              },
              "amountAsNumber": {
                "type": "number",
                "description": "Number. Value in the current currency as a number"
              }
            },
            "description": "The amount specified in the current session (When no shared secret is used)"
          },
          "amountByCurrency": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "currency": {
                  "type": "string",
                  "description": "Currency code (ISO 4217)"
                },
                "amount": {
                  "type": "string",
                  "description": "Value in the current currency, formatted"
                },
                "amountAsNumber": {
                  "type": "number",
                  "description": "Number. Value in the current currency as a number"
                }
              }
            },
            "description": "The amount specified for each currency. Requires shared secret"
          }
        },
        "type": "object",
        "description": "Gift Certificate object"
      },
      "CountryShippableAuthorizedModel": {
        "properties": {
          "country": {
            "type": "string",
