    "/items/gift-certificates/{giftCertificate}": {
      "post": {
        "summary": "Add a gift certificate to the selection.\n        This will remove all other items or gift certificates from the selection. Needs gift certificate endpoints to be enabled in the plugin",
        "description": "Add a gift certificate to the selection.\n        This will remove all other items or gift certificates from the selection. Needs gift certificate endpoints to be enabled in the plugin",
        "tags": [
          "2. selection handling, cart"
        ],
        "parameters": [
          {
            "name": "giftCertificate",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "string"
