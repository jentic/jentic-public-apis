    "/lines/{line}/subscription-plan/{subscriptionPlan}": {
      "put": {
        "summary": "Update items's subscription plan.",
        "description": "Update items's subscription plan.",
        "tags": [
          "2. selection handling, cart"
        ],
        "parameters": [
          {
            "name": "line",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Unique id for the selection item"
          },
          {
            "name": "subscriptionPlan",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The ID of subscription plan"
          }
        ],
        "responses": {
          "404": {
            "description": "When item ID is not found.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string",
                      "description": "Token for the current session, maintained by sending it as an API-token header or inside the Accept header. Will be `null` if API-token header value is `none`"
                    },
                    "errors": {
                      "type": "object",
                      "properties": {
                        "item": {
                          "type": "string",
                          "description": ""
                        }
                      },
                      "description": ""
                    }
                  },
                  "description": ""
                },
                "examples": {
                  "Item ID not found": {
                    "value": {
                      "token": "e37b0c13e1gv4bdkceigir9go5",
                      "errors": {
                        "item": "product item not found"
                      }
                    }
                  }
                }
              }
            }
          },
          "406": {
            "description": "When input value is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string",
                      "description": "Token for the current session, maintained by sending it as an API-token header or inside the Accept header. Will be `null` if API-token header value is `none`"
                    },
                    "errors": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      },
                      "description": ""
                    }
                  },
                  "description": ""
                },
                "examples": {
                  "Item ID invalid": {
                    "value": {
                      "token": "e37b0c13e1gv4bdkceigir9go5",
                      "errors": {
                        "item": "expected product item id, got: x-x"
                      }
                    }
                  },
                  "Subscription ID invalid": {
                    "value": {
                      "token": "e37b0c13e1gv4bdkceigir9go5",
                      "errors": []
                    }
                  },
                  "Multiple fields invalid": {
                    "value": {
                      "token": "e37b0c13e1gv4bdkceigir9go5",
                      "errors": {
                        "item": "expected product item id, got: x-x",
                        "subscriptionPlan": "expected subscription plan id"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
