    "/register": {
      "post": {
        "summary": "Register customer. After registration is complete, the session is running as the logged in user",
        "description": "Register customer. After registration is complete, the session is running as the logged in user",
        "tags": [
          "6. customer handling"
        ],
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password",
                  "firstName",
                  "lastName"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "description": "E-mail address"
                  },
                  "password": {
                    "type": "string",
                    "description": ""
                  },
                  "firstName": {
                    "type": "string",
                    "description": ""
                  },
                  "lastName": {
                    "type": "string",
                    "description": ""
                  },
                  "address1": {
                    "type": "string",
                    "description": ""
                  },
                  "address2": {
                    "type": "string",
                    "description": ""
                  },
                  "zipCode": {
                    "type": "string",
                    "description": ""
                  },
                  "city": {
                    "type": "string",
                    "description": ""
                  },
                  "state": {
                    "type": "string",
                    "description": ""
                  },
                  "country": {
                    "type": "string",
                    "description": "Country ISO 3166-1 alpha-2, for example SE"
                  },
                  "phoneNumber": {
                    "type": "string",
                    "description": ""
                  },
                  "newsletter": {
                    "type": "boolean",
                    "description": "When true customer is subscribed to newsletter after registration"
                  },
                  "language": {
                    "type": "string",
                    "description": "Language ID. The language this customer uses"
                  },
                  "customerClubFields": {
                    "type": "object",
                    "description": "anything"
                  },
                  "consents": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "key",
                        "consented"
                      ],
                      "properties": {
                        "key": {
                          "type": "string",
                          "description": "Consent key/type"
                        },
                        "consented": {
                          "type": "boolean",
                          "description": "Did the customer consent to this?"
                        },
                        "name": {
                          "type": "string",
                          "description": "Short name describing the consent"
                        },
                        "text": {
                          "type": "string",
                          "description": "Consent description"
                        },
                        "version": {
                          "type": "string",
                          "description": "Which version of the consent is this"
                        },
                        "language": {
                          "type": "string",
                          "description": "Which language does this consent use"
                        }
                      }
                    },
                    "description": "Optional consents the customer is consenting to"
                  },
                  "customAttributes": {
                    "type": "object",
                    "properties": {
                      "voyado_customer_id": {
                        "type": "object",
                        "description": "anything"
                      },
                      "voyado_exported_historical_data": {
                        "type": "object",
                        "description": "anything"
                      }
                    },
                    "description": "Client specific attributes"
                  }
                },
                "description": ""
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sorry, no response specification."
          },
          "400": {
            "description": "Generic error response. The HTTP status code can be any 400 or 500 code. \n                    The \"errors\" object contains one or more key value pairs to describe the error to developers.",
