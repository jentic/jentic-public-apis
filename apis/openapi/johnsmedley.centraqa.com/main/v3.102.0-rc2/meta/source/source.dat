                  }
                },
                "description": ""
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sorry, no response specification."
          },
          "400": {
            "description": "Generic error response. The HTTP status code can be any 400 or 500 code. \n                    The \"errors\" object contains one or more key value pairs to describe the error to developers.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "errors"
                  ],
                  "properties": {
                    "errors": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      },
                      "description": ""
                    }
                  },
                  "description": ""
                },
                "examples": {
                  "Generic Error": {
                    "value": {
                      "errors": {
                        "item": "not found",
                        "address.email": "Expected type e-mail"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/payment": {
      "post": {
        "summary": "Initiate the payment process for the current selection",
        "description": "Initiate the payment process for the current selection",
        "tags": [
          "4. selection handling, checkout flow"
        ],
        "parameters": [],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "paymentMethod": {
                    "type": "string",
                    "description": "Required unless it has been set previously for the selection"
                  },
                  "paymentMethodSpecificFields": {
                    "type": "object",
                    "additionalProperties": {
                      "$ref": "#/components/schemas/AnyValue"
                    },
                    "description": "Each payment plugin can require specific parameters to be sent. These parameters should be\n                        sent inside this property"
                  },
                  "paymentInitiateOnly": {
                    "type": "boolean",
                    "description": "Used for payment buttons,\n                        only initiate payment without selecting the payment method as current method. It will still \n                        go through stock check, but it will not flip the current payment method of the selection.\n                        Will allow plugins that supports the option to be initiated \n                        without providing address information."
                  },
                  "paymentReturnPage": {
                    "type": "string",
                    "description": "URL to redirect the customer to for validating the payment using POST /payment-result"
                  },
                  "paymentFailedPage": {
                    "type": "string",
                    "description": "URL to redirect the customer to if payment fails"
                  },
                  "paymentCheckoutOrigin": {
                    "type": "string",
                    "description": "`window.origin` where the checkout is located. Used for more modern payment checkout methods where the current origin of the checkout needs to be validated properly."
                  },
                  "shippingMethod": {
                    "type": "string",
                    "description": "If not provided, the previously selected shipping method will be used"
                  },
                  "termsAndConditions": {
                    "type": "boolean",
                    "description": "boolean, must be true. You must have the customer accept the terms and conditions, \n                        to make sure this is in the checkout, this needs to be sent to us as `true`"
                  },
                  "consents": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "key",
                        "consented"
                      ],
                      "properties": {
                        "key": {
                          "type": "string",
                          "description": "Consent key/type"
                        },
                        "consented": {
                          "type": "boolean",
                          "description": "Did the customer consent to this?"
                        },
                        "name": {
                          "type": "string",
                          "description": "Short name describing the consent"
                        },
                        "text": {
                          "type": "string",
                          "description": "Consent description"
                        },
                        "version": {
                          "type": "string",
                          "description": "Which version of the consent is this"
                        },
                        "language": {
                          "type": "string",
                          "description": "Which language does this consent use"
                        }
                      }
                    },
                    "description": "Optional consents the customer is consenting to"
                  },
                  "clientDetails": {
                    "type": "object",
                    "properties": {
                      "browserLang": {
                        "type": "string",
                        "description": "A two-letter code string according to the ISO 639-1 standard representing the primary language, followed by a hyphen and a two-letter code string according to the ISO 3166-1 alpha-2."
                      },
                      "ip": {
                        "type": "string",
                        "description": "Client ip address"
                      },
                      "userAgent": {
                        "type": "string",
                        "description": "Valid browser user-agent"
                      }
                    },
                    "description": "Client Details, such as IP address, User-Agent, browser language, which can be used for working with various PSPs or for Fraud Prevention cases."
                  },
                  "address": {
                    "type": "object",
                    "properties": {
                      "email": {
                        "type": "string",
                        "description": "E-mail address"
                      },
                      "company": {
                        "type": "string",
                        "description": ""
                      },
                      "firstName": {
                        "type": "string",
                        "description": ""
                      },
                      "lastName": {
                        "type": "string",
                        "description": ""
                      },
                      "address1": {
                        "type": "string",
                        "description": ""
                      },
                      "address2": {
                        "type": "string",
                        "description": ""
                      },
                      "zipCode": {
                        "type": "string",
                        "description": ""
                      },
                      "city": {
                        "type": "string",
                        "description": ""
                      },
                      "country": {
                        "type": "string",
                        "description": "Country ISO 3166-1 alpha-2, for example SE"
                      },
                      "state": {
                        "type": "string",
                        "description": "State ISO code, maxlength 6, Example: CA for California (US) and NSW for New South West (AU). \n        When used as input, the correct description of the state will also be allowed."
                      },
                      "phoneNumber": {
                        "type": "string",
                        "description": ""
                      },
                      "identityNumber": {
                        "type": "string",
                        "description": "Personal identification number, required by some payment methods"
                      },
                      "vatNumber": {
                        "type": "string",
                        "description": "Required if the selection was previously set as vatExempt=true"
                      },
                      "newsletter": {
                        "type": "boolean",
                        "description": "Subscribe the address.email to the newsletter"
                      },
                      "gender": {
                        "type": "string",
                        "description": "female, male or nothing"
                      }
                    },
                    "description": "Billing address, used also as shipping address if there is no shippingAddress provided"
                  },
                  "shippingAddress": {
                    "type": "object",
                    "properties": {
                      "email": {
                        "type": "string",
                        "description": "E-mail address. If this is blank, the address.email is used"
                      },
                      "company": {
                        "type": "string",
                        "description": ""
                      },
                      "firstName": {
                        "type": "string",
                        "description": ""
                      },
                      "lastName": {
                        "type": "string",
                        "description": ""
                      },
                      "address1": {
                        "type": "string",
                        "description": ""
                      },
                      "address2": {
                        "type": "string",
                        "description": ""
                      },
                      "zipCode": {
                        "type": "string",
                        "description": ""
                      },
                      "city": {
                        "type": "string",
                        "description": ""
                      },
                      "phoneNumber": {
                        "type": "string",
                        "description": ""
                      },
                      "country": {
                        "type": "string",
                        "description": "Country ISO 3166-1 alpha-2, for example SE"
                      },
                      "state": {
                        "type": "string",
                        "description": "State ISO code, maxlength 6, Example: CA for California (US) and NSW for New South West (AU). \n        When used as input, the correct description of the state will also be allowed."
                      }
                    },
                    "description": ""
                  },
                  "affiliate": {
                    "type": "string",
                    "description": "If an affiliate was used, send the affiliate ID from the cookie here"
                  },
                  "additionalFields": {
                    "type": "object",
                    "additionalProperties": {
                      "$ref": "#/components/schemas/AnyValue"
                    },
                    "description": "Values are passed to installed plugins that supports it"
                  },
                  "additionalNotes": {
                    "type": "string",
                    "description": "This could be used to let the customer leave special instructions"
                  },
                  "customerClubFields": {
                    "type": "object",
                    "additionalProperties": {
                      "$ref": "#/components/schemas/AnyValue"
                    },
                    "description": "Fields to use if there is a customer club integration enabled"
                  },
                  "ipAddress": {
                    "type": "string",
                    "description": "Ip address of the customer, optional. If no ip address is provided, the remote address will be used."
                  },
                  "express": {
                    "type": "boolean",
                    "description": "Optional. If true, the express version of the payment widget will be returned, if the feature flag is enabled. This will only work with paymentInitiateOnly set to \"true\"."
                  }
                },
                "description": ""
              },
              "examples": {
                "Only using one address for both billing and shipping": {
                  "value": {
                    "paymentMethod": "klarna",
                    "paymentReturnPage": "http://example.com/success",
                    "paymentFailedPage": "http://example.com/failure",
                    "termsAndConditions": true,
                    "address": {
                      "newsletter": false,
                      "email": "abc123@example.com",
                      "phoneNumber": "123456789",
                      "firstName": "Test Billing",
                      "lastName": "Testson Billing",
                      "address1": "Address One",
                      "address2": "Address Two",
                      "zipCode": "12345",
                      "city": "Malmö",
                      "country": "SE"
                    }
                  }
                },
                "With clientDetails": {
                  "value": {
                    "paymentReturnPage": "http://example.com/success",
                    "paymentFailedPage": "http://example.com/failure",
                    "clientDetails": {
                      "browserLang": "en-US",
                      "ip": "192.168.0.1",
                      "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/96.0.4664.110 Safari/537.36"
                    },
                    "termsAndConditions": true,
                    "address": {
                      "newsletter": false,
                      "email": "abc123@example.com",
                      "phoneNumber": "123456789",
                      "firstName": "Test Billing",
                      "lastName": "Testson Billing",
                      "address1": "Address One",
                      "address2": "Address Two",
                      "zipCode": "12345",
                      "city": "Malmö",
                      "country": "SE"
                    }
                  }
                },
                "Payment method already set on selection from before, set shipping method": {
                  "value": {
                    "paymentReturnPage": "http://example.com/success",
                    "paymentFailedPage": "http://example.com/failure",
                    "shippingMethod": "express",
                    "termsAndConditions": true,
                    "address": {
                      "newsletter": false,
                      "email": "abc123@example.com",
                      "phoneNumber": "123456789",
                      "firstName": "Test Billing",
                      "lastName": "Testson Billing",
                      "address1": "Address One",
                      "address2": "Address Two",
                      "zipCode": "12345",
                      "city": "Malmö",
                      "country": "SE"
                    }
                  }
                },
                "With constents": {
                  "value": {
                    "paymentReturnPage": "http://example.com/success",
                    "paymentFailedPage": "http://example.com/failure",
                    "termsAndConditions": true,
                    "consents": [
                      {
                        "key": "newsletter",
                        "consented": true,
                        "name": "Constent 1",
                        "text": "I approved X",
                        "version": 1,
                        "language": "sv_SE"
                      }
                    ],
                    "address": {
                      "newsletter": false,
                      "email": "abc123@example.com",
                      "phoneNumber": "123456789",
                      "firstName": "Test Billing",
                      "lastName": "Testson Billing",
                      "address1": "Address One",
                      "address2": "Address Two",
                      "zipCode": "12345",
                      "city": "Malmö",
                      "country": "SE"
                    }
                  }
                },
                "With affiliate + additionalNotes + customerClubFields set": {
                  "value": {
                    "paymentReturnPage": "http://example.com/success",
                    "paymentFailedPage": "http://example.com/failure",
                    "termsAndConditions": true,
                    "affiliate": "campaign1",
                    "address": {
                      "newsletter": false,
                      "email": "abc123@example.com",
                      "phoneNumber": "123456789",
                      "firstName": "Test Billing",
                      "lastName": "Testson Billing",
                      "address1": "Address One",
                      "address2": "Address Two",
                      "zipCode": "12345",
                      "city": "Malmö",
                      "country": "SE"
                    },
                    "additionalNotes": "Message from customer",
                    "customerClubFields": {
                      "accountNumber": "xyz123"
                    }
                  }
                },
                "Separate shipping address": {
                  "value": {
                    "paymentReturnPage": "http://example.com/success",
                    "paymentFailedPage": "http://example.com/failure",
                    "termsAndConditions": true,
                    "address": {
