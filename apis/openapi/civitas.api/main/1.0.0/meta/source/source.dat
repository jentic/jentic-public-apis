{
  "openapi": "3.1.0",
  "info": {
    "title": "Civitas",
    "version": "1.0.0",
    "description": "API specification for Civitas, a blockchain-powered consent management platform leveraging Algorand-based document tokenization and DigiLocker-based verification.\n",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/test-84b/Civitas-Org/1.0.0"
  },
  "servers": [
    {
      "url": "https://civitas.api/docs"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    },
    {
      "OrgApiKey": []
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "OrgApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CIVITAS-ORG-KEY"
      }
    },
    "schemas": {
      "ConsentStatus": {
        "type": "string",
        "enum": [
          "pending",
          "approved",
          "declined",
          "revoked",
          "expired"
        ]
      },
      "ConsentRecord": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "CONSENT-923121"
          },
          "userWallet": {
            "type": "string",
            "example": "ALGO-ADDR-TEST-12345"
          },
          "organisationId": {
            "type": "string",
            "example": "ORG-NEOBANK-9981"
          },
          "documentASA": {
            "type": "string",
            "example": "ASA-113233"
          },
          "reason": {
            "type": "string",
            "example": "KYC compliance and verification"
          },
          "status": {
            "$ref": "#/components/schemas/ConsentStatus"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "example": "2025-01-01T12:45:32Z"
          }
        }
      },
      "ConsentRequest": {
        "type": "object",
        "required": [
          "organisationId",
          "documentASA",
          "reason"
        ],
        "properties": {
          "organisationId": {
            "type": "string",
            "example": "ORG-NEOBANK-9981"
          },
          "documentASA": {
            "type": "string",
            "example": "ASA-113233"
          },
          "reason": {
            "type": "string",
            "example": "Loan processing ID verification"
          }
        }
      },
      "DocumentAsset": {
        "type": "object",
        "properties": {
          "asaId": {
            "type": "string",
            "example": "ASA-113233"
          },
          "type": {
            "type": "string",
            "example": "Aadhaar Card"
          },
          "issuer": {
            "type": "string",
            "example": "Government of India"
          },
          "issuedOn": {
            "type": "string",
            "format": "date",
            "example": "2020-06-18"
          }
        }
      }
    }
  },
  "paths": {
    "/auth/wallet/challenge": {
      "post": {
        "summary": "Generate challenge message for Algorand wallet signature.",
        "responses": {
          "200": {
            "description": "Challenge message created.",
            "content": {
              "application/json": {
                "example": {
                  "challenge": "civitas-login-17491321"
                }
              }
            }
          }
        }
      }
    },
    "/auth/wallet/verify": {
      "post": {
        "summary": "Verify signed challenge and return session token.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "wallet": "ALGO-ADDR-TEST-12345",
                "signature": "BASE64_SIGNATURE_MOCK",
                "challenge": "civitas-login-17491321"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Verified.",
            "content": {
              "application/json": {
                "example": {
                  "token": "JWT-MOCK-TOKEN-EXAMPLE",
                  "wallet": "ALGO-ADDR-TEST-12345"
                }
              }
            }
          }
        }
      }
    },
    "/documents/available": {
      "get": {
        "summary": "List user's DigiLocker-mapped ASA documents (mocked).",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "List returned.",
            "content": {
              "application/json": {
                "example": {
                  "documents": [
                    {
                      "asaId": "ASA-113233",
                      "type": "Aadhaar",
                      "issuer": "UIDAI"
                    },
                    {
                      "asaId": "ASA-982211",
                      "type": "Driving License",
                      "issuer": "Govt Transport Authority"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/consents/request": {
      "post": {
        "summary": "Organisation requests access to a user document.",
        "security": [
          {
            "OrgApiKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConsentRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Consent request created.",
            "content": {
              "application/json": {
                "example": {
                  "requestId": "CONSENT-923121",
                  "status": "pending"
                }
              }
            }
          }
        }
      }
    },
    "/consents/{requestId}": {
      "get": {
        "summary": "Get consent request status.",
        "parameters": [
          {
            "in": "path",
            "name": "requestId",
            "required": true,
            "schema": {
              "type": "string",
              "example": "CONSENT-923121"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Status returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsentRecord"
                }
              }
            }
          }
        }
      }
    },
    "/consents/{requestId}/approve": {
      "post": {
        "summary": "User approves the consent.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "requestId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "requestId": "CONSENT-923121",
                  "status": "approved"
                }
              }
            }
          }
        }
      }
    },
    "/consents/{requestId}/revoke": {
      "post": {
        "summary": "User revokes existing approved consent.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "requestId",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "requestId": "CONSENT-923121",
                  "status": "revoked"
                }
              }
            }
          }
        }
      }
    },
    "/audit/{asaId}": {
      "get": {
        "summary": "Get immutable consent audit log.",
        "parameters": [
          {
            "in": "path",
            "name": "asaId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "history": [
                    {
                      "status": "approved",
                      "timestamp": "2025-01-02T14:11:00Z"
                    },
                    {
                      "status": "revoked",
                      "timestamp": "2025-01-03T19:20:11Z"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
