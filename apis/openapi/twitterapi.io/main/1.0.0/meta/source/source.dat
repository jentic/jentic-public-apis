            "schema": {
              "type": "string",
              "enum": ["Latest", "Top"],
              "default": "Latest"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "The cursor to paginate through the results. First page is \"\".",
            "schema": {
              "type": "string",
              "format": "string"
            }
          }

        ],
        "responses": {
          "200": {
            "description": "Tweets response",
