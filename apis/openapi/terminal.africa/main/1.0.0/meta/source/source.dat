{
  "openapi": "3.0.3",
  "info": {
    "title": "Terminal Africa Shipping API",
    "description": "Terminal Africa provides a unified shipping and logistics API for African businesses. It aggregates multiple carriers for rate comparison, shipment creation, tracking, address management, parcel handling, and packaging operations across domestic and international routes.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://docs.terminal.africa/tship/endpoints",
    "contact": {
      "name": "Terminal Africa Support",
      "url": "https://terminal.africa"
    }
  },
  "servers": [
    {
      "url": "https://api.terminal.africa/v1",
      "description": "Terminal Africa Production API"
    },
    {
      "url": "https://sandbox.terminal.africa/v1",
      "description": "Terminal Africa Sandbox API"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/addresses": {
      "post": {
        "operationId": "createAddress",
        "summary": "Create an address",
        "description": "Create a new address record for use as pickup, delivery, or return address in shipments.",
        "tags": ["Addresses"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["city", "country", "state"],
                "properties": {
                  "city": { "type": "string", "description": "City name.", "example": "Lagos" },
                  "country": { "type": "string", "description": "ISO 2-letter country code.", "example": "NG" },
                  "state": { "type": "string", "description": "State or province code.", "example": "LA" },
                  "email": { "type": "string", "description": "Contact email address.", "example": "john@example.com" },
                  "phone": { "type": "string", "description": "Contact phone number.", "example": "+2348012345678" },
                  "first_name": { "type": "string", "description": "First name.", "example": "John" },
                  "last_name": { "type": "string", "description": "Last name.", "example": "Doe" },
                  "line1": { "type": "string", "description": "Street address line 1.", "example": "10 Allen Avenue" },
                  "line2": { "type": "string", "description": "Street address line 2." },
                  "zip": { "type": "string", "description": "Postal/ZIP code.", "example": "100001" },
                  "is_residential": { "type": "boolean", "description": "Whether the address is residential." },
                  "metadata": { "type": "object", "description": "Additional metadata.", "additionalProperties": true }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Address created successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AddressResponse" }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid parameters",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "401": {
            "description": "Unauthorized - invalid or missing API key",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listAddresses",
        "summary": "List all addresses",
        "description": "Retrieve a paginated list of all addresses.",
        "tags": ["Addresses"],
        "parameters": [
          {
            "name": "perPage",
            "in": "query",
            "description": "Number of records per page. Defaults to 100.",
            "schema": { "type": "integer", "default": 100 }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Page number. Defaults to 1.",
            "schema": { "type": "integer", "default": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "List of addresses",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "boolean" },
                    "message": { "type": "string" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "addresses": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/Address" }
                        },
                        "pagination": { "$ref": "#/components/schemas/Pagination" }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/addresses/{address_id}": {
      "get": {
        "operationId": "getAddress",
        "summary": "Retrieve an address",
        "description": "Retrieve details of a specific address by its unique identifier.",
        "tags": ["Addresses"],
        "parameters": [
          {
            "name": "address_id",
            "in": "path",
            "required": true,
            "description": "Unique identifier of the address.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Address details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AddressResponse" }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "updateAddress",
        "summary": "Update an address",
        "description": "Update an existing address.",
        "tags": ["Addresses"],
        "parameters": [
          {
            "name": "address_id",
            "in": "path",
            "required": true,
            "description": "Unique identifier of the address to update.",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["city", "country", "state"],
                "properties": {
                  "city": { "type": "string" },
                  "country": { "type": "string" },
                  "state": { "type": "string" },
                  "email": { "type": "string" },
                  "phone": { "type": "string" },
                  "first_name": { "type": "string" },
                  "last_name": { "type": "string" },
                  "line1": { "type": "string" },
                  "line2": { "type": "string" },
                  "zip": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Address updated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AddressResponse" }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/addresses/validate": {
      "post": {
        "operationId": "validateAddress",
        "summary": "Validate an address",
        "description": "Validate an address without creating it.",
        "tags": ["Addresses"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["city", "country", "state", "line1", "zip"],
                "properties": {
                  "city": { "type": "string" },
                  "country": { "type": "string" },
                  "state": { "type": "string" },
                  "line1": { "type": "string" },
                  "zip": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validation result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "boolean" },
                    "message": { "type": "string" },
                    "data": { "type": "object" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid address",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/addresses/default/sender": {
      "post": {
        "operationId": "setDefaultSenderAddress",
        "summary": "Set default sender address",
        "description": "Set an address as the default sender address for shipments.",
        "tags": ["Addresses"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["address_id"],
                "properties": {
                  "address_id": { "type": "string", "description": "ID of the address to set as default sender." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default sender set",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AddressResponse" }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "getDefaultSenderAddress",
        "summary": "Get default sender address",
        "description": "Retrieve the current default sender address.",
        "tags": ["Addresses"],
        "responses": {
          "200": {
            "description": "Default sender address",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AddressResponse" }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/carriers": {
      "get": {
        "operationId": "listCarriers",
        "summary": "List all carriers",
        "description": "Retrieve a list of all available shipping carriers with optional filters.",
        "tags": ["Carriers"],
        "parameters": [
          {
            "name": "active",
            "in": "query",
            "description": "Filter by active status.",
            "schema": { "type": "boolean" }
          },
          {
            "name": "type",
            "in": "query",
            "description": "Filter by carrier type.",
            "schema": { "type": "string", "enum": ["domestic", "regional", "international"] }
          },
          {
            "name": "perPage",
            "in": "query",
            "description": "Number of records per page.",
            "schema": { "type": "integer", "default": 100 }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Page number.",
            "schema": { "type": "integer", "default": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "List of carriers",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "boolean" },
                    "message": { "type": "string" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "carriers": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/Carrier" }
                        },
                        "pagination": { "$ref": "#/components/schemas/Pagination" }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/carriers/{carrier_id}": {
      "get": {
        "operationId": "getCarrier",
        "summary": "Retrieve a carrier",
        "description": "Retrieve details of a specific carrier.",
        "tags": ["Carriers"],
        "parameters": [
          {
            "name": "carrier_id",
            "in": "path",
            "required": true,
            "description": "Unique identifier of the carrier.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Carrier details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "boolean" },
                    "message": { "type": "string" },
                    "data": { "$ref": "#/components/schemas/Carrier" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/carriers/enable/{carrier_id}": {
      "post": {
        "operationId": "enableCarrier",
        "summary": "Enable a carrier",
        "description": "Enable a carrier for use in rate calculations and shipments.",
        "tags": ["Carriers"],
        "parameters": [
          {
            "name": "carrier_id",
            "in": "path",
            "required": true,
            "description": "Unique identifier of the carrier to enable.",
            "schema": { "type": "string" }
          },
          {
            "name": "domestic",
            "in": "query",
            "description": "Enable for domestic shipments.",
            "schema": { "type": "boolean" }
          },
          {
            "name": "international",
            "in": "query",
            "description": "Enable for international shipments.",
            "schema": { "type": "boolean" }
          },
          {
            "name": "regional",
            "in": "query",
            "description": "Enable for regional shipments.",
            "schema": { "type": "boolean" }
          }
        ],
        "responses": {
          "200": {
            "description": "Carrier enabled",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "boolean" },
                    "message": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/carriers/disable/{carrier_id}": {
      "post": {
        "operationId": "disableCarrier",
        "summary": "Disable a carrier",
        "description": "Disable a carrier from being used in rate calculations and shipments.",
        "tags": ["Carriers"],
        "parameters": [
          {
            "name": "carrier_id",
            "in": "path",
            "required": true,
            "description": "Unique identifier of the carrier to disable.",
            "schema": { "type": "string" }
          },
          {
            "name": "domestic",
            "in": "query",
            "description": "Disable for domestic shipments.",
            "schema": { "type": "boolean" }
          },
          {
            "name": "international",
            "in": "query",
            "description": "Disable for international shipments.",
            "schema": { "type": "boolean" }
          },
          {
            "name": "regional",
            "in": "query",
            "description": "Disable for regional shipments.",
            "schema": { "type": "boolean" }
          }
        ],
        "responses": {
          "200": {
            "description": "Carrier disabled",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "boolean" },
                    "message": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/rates": {
      "get": {
        "operationId": "listRates",
        "summary": "List all rates",
        "description": "Retrieve a paginated list of all previously calculated shipping rates.",
        "tags": ["Rates"],
        "parameters": [
          {
            "name": "perPage",
            "in": "query",
            "description": "Number of records per page. Defaults to 100.",
            "schema": { "type": "integer", "default": 100 }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Page number. Defaults to 1.",
            "schema": { "type": "integer", "default": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "List of rates",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "boolean" },
                    "message": { "type": "string" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "rates": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/Rate" }
                        },
                        "pagination": { "$ref": "#/components/schemas/Pagination" }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/rates/{rate_id}": {
      "get": {
        "operationId": "getRate",
        "summary": "Retrieve a specific rate",
        "description": "Retrieve details of a specific shipping rate.",
        "tags": ["Rates"],
        "parameters": [
          {
            "name": "rate_id",
            "in": "path",
            "required": true,
            "description": "Unique identifier of the rate.",
            "schema": { "type": "string" }
          },
          {
            "name": "currency",
            "in": "query",
            "description": "Currency for the rate amount. Defaults to NGN.",
            "schema": {
              "type": "string",
              "enum": ["AED", "AUD", "CAD", "CNY", "EUR", "GBP", "GHS", "HKD", "KES", "NGN", "TZS", "UGX", "USD", "ZAR"],
              "default": "NGN"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Rate details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "boolean" },
                    "message": { "type": "string" },
                    "data": { "$ref": "#/components/schemas/Rate" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/shipments": {
      "post": {
        "operationId": "createShipment",
        "summary": "Create a shipment",
        "description": "Create a new shipment with pickup and delivery addresses, parcel details, and optional metadata.",
        "tags": ["Shipments"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["address_from", "address_to"],
                "properties": {
                  "address_from": { "type": "string", "description": "Unique ID of pickup address." },
                  "address_to": { "type": "string", "description": "Unique ID of delivery address." },
                  "address_return": { "type": "string", "description": "Unique ID of return address. Defaults to pickup address." },
                  "parcel": { "type": "string", "description": "Unique ID of the parcel." },
                  "parcels": {
                    "type": "array",
                    "description": "Array of parcel IDs for multi-parcel shipments.",
                    "items": { "type": "string" }
                  },
                  "shipment_purpose": {
                    "type": "string",
                    "description": "Purpose of the shipment.",
                    "enum": ["commercial", "personal", "sample", "return_after_repair", "return_for_repair"]
                  },
                  "shipment_type": {
                    "type": "string",
                    "description": "Type of shipment.",
                    "enum": ["cash-on-delivery"]
                  },
                  "metadata": { "type": "object", "description": "Additional metadata.", "additionalProperties": true }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Shipment created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ShipmentResponse" }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listShipments",
        "summary": "List all shipments",
        "description": "Retrieve a paginated list of all shipments with optional filters.",
        "tags": ["Shipments"],
        "parameters": [
          {
            "name": "perPage",
            "in": "query",
            "description": "Number of records per page. Defaults to 100.",
            "schema": { "type": "integer", "default": 100 }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Page number. Defaults to 1.",
            "schema": { "type": "integer", "default": 1 }
          },
          {
            "name": "populate",
            "in": "query",
            "description": "Populate full details for address, carrier, and parcel fields.",
            "schema": { "type": "boolean" }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Filter by shipment status.",
            "schema": {
              "type": "string",
              "enum": ["cancelled", "confirmed", "delivered", "draft", "in-transit", "pending"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of shipments",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "boolean" },
                    "message": { "type": "string" },
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Shipment" }
                    },
                    "pageData": { "$ref": "#/components/schemas/Pagination" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/shipments/track/{shipment_id}": {
      "get": {
        "operationId": "trackShipment",
        "summary": "Track a shipment",
        "description": "Track a shipment and retrieve its current status, location, and event history.",
        "tags": ["Shipments"],
        "parameters": [
          {
            "name": "shipment_id",
            "in": "path",
            "required": true,
            "description": "Unique shipment reference ID.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Shipment tracking details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ShipmentResponse" }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/shipments/cancel": {
      "post": {
        "operationId": "cancelShipment",
        "summary": "Cancel a shipment",
        "description": "Cancel an existing shipment.",
        "tags": ["Shipments"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["shipment_id"],
                "properties": {
                  "shipment_id": { "type": "string", "description": "Unique shipment reference ID to cancel." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Shipment cancelled",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ShipmentResponse" }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/parcels": {
      "post": {
        "operationId": "createParcel",
        "summary": "Create a parcel",
        "description": "Create a new parcel with item details, packaging, and weight information.",
        "tags": ["Parcels"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["items", "packaging", "weight_unit"],
                "properties": {
                  "description": { "type": "string", "description": "Description of the parcel." },
                  "items": {
                    "type": "array",
                    "description": "List of items in the parcel.",
                    "items": {
                      "type": "object",
                      "required": ["description", "name", "currency", "value", "quantity", "weight"],
                      "properties": {
                        "description": { "type": "string", "description": "Item description." },
                        "name": { "type": "string", "description": "Item name." },
                        "currency": { "type": "string", "description": "Currency code for value.", "example": "NGN" },
                        "value": { "type": "number", "description": "Value per item." },
                        "quantity": { "type": "integer", "description": "Number of items." },
                        "weight": { "type": "number", "description": "Weight per item in kg." },
                        "hs_code": { "type": "string", "description": "Harmonized System code for customs." }
                      }
                    }
                  },
                  "packaging": { "type": "string", "description": "Unique ID of the packaging type." },
                  "weight_unit": { "type": "string", "description": "Weight unit. Currently only kg.", "enum": ["kg"] },
                  "metadata": { "type": "object", "additionalProperties": true },
                  "proof_of_payments": {
                    "type": "array",
                    "description": "URLs to payment documentation.",
                    "items": { "type": "string" }
                  },
                  "rec_docs": {
                    "type": "array",
                    "description": "URLs to images of parcel measurements.",
                    "items": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Parcel created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "boolean" },
                    "message": { "type": "string" },
                    "data": { "$ref": "#/components/schemas/Parcel" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listParcels",
        "summary": "List all parcels",
        "description": "Retrieve a paginated list of all parcels.",
        "tags": ["Parcels"],
        "parameters": [
          {
            "name": "perPage",
            "in": "query",
            "description": "Number of records per page. Defaults to 100.",
            "schema": { "type": "integer", "default": 100 }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Page number. Defaults to 1.",
            "schema": { "type": "integer", "default": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "List of parcels",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "boolean" },
                    "message": { "type": "string" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "parcels": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/Parcel" }
                        },
                        "pagination": { "$ref": "#/components/schemas/Pagination" }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/claims": {
      "get": {
        "operationId": "listClaims",
        "summary": "List all claims",
        "description": "Retrieve a paginated list of all insurance claims.",
        "tags": ["Claims"],
        "parameters": [
          {
            "name": "perPage",
            "in": "query",
            "description": "Number of records per page. Defaults to 100.",
            "schema": { "type": "integer", "default": 100 }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Page number. Defaults to 1.",
            "schema": { "type": "integer", "default": 1 }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Filter claims by status.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "List of claims",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "boolean" },
                    "message": { "type": "string" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "claims": { "type": "array", "items": { "$ref": "#/components/schemas/Claim" } },
                        "pagination": { "$ref": "#/components/schemas/Pagination" }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/claims/{claim_id}": {
      "get": {
        "operationId": "getClaim",
        "summary": "Retrieve a claim",
        "description": "Retrieve details of a specific insurance claim.",
        "tags": ["Claims"],
        "parameters": [
          {
            "name": "claim_id",
            "in": "path",
            "required": true,
            "description": "Unique identifier of the claim or insurance ID.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Claim details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "boolean" },
                    "message": { "type": "string" },
                    "data": { "$ref": "#/components/schemas/Claim" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/carriers/locations/drop-off": {
      "get": {
        "operationId": "listDropOffLocations",
        "summary": "List carrier drop-off locations",
        "description": "Retrieve drop-off locations for a specific carrier in a given country.",
        "tags": ["Carriers"],
        "parameters": [
          {
            "name": "country",
            "in": "query",
            "required": true,
            "description": "ISO 2-letter country code.",
            "schema": { "type": "string" }
          },
          {
            "name": "carrier",
            "in": "query",
            "required": true,
            "description": "Carrier slug.",
            "schema": { "type": "string" }
          },
          {
            "name": "state",
            "in": "query",
            "description": "State or province code.",
            "schema": { "type": "string" }
          },
          {
            "name": "city",
            "in": "query",
            "description": "City name.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "List of drop-off locations",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "boolean" },
                    "message": { "type": "string" },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": { "type": "string" },
                          "address": { "type": "string" },
                          "city": { "type": "string" },
                          "state": { "type": "string" },
                          "country": { "type": "string" },
                          "coordinates": {
                            "type": "object",
                            "properties": {
                              "lat": { "type": "number" },
                              "lng": { "type": "number" }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Bearer token authentication. Pass your Terminal Africa Secret Key as Authorization: Bearer SECRET_KEY."
      }
    },
    "schemas": {
      "Address": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "address_id": { "type": "string" },
          "city": { "type": "string" },
          "country": { "type": "string" },
          "state": { "type": "string" },
          "email": { "type": "string" },
          "phone": { "type": "string" },
          "first_name": { "type": "string" },
          "last_name": { "type": "string" },
          "line1": { "type": "string" },
          "line2": { "type": "string" },
          "zip": { "type": "string" },
          "is_residential": { "type": "boolean" },
          "coordinates": {
            "type": "object",
            "properties": {
              "lat": { "type": "number" },
              "lng": { "type": "number" }
            }
          },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "AddressResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "boolean" },
          "message": { "type": "string" },
          "data": { "$ref": "#/components/schemas/Address" }
        }
      },
      "Carrier": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "carrier_id": { "type": "string" },
          "name": { "type": "string" },
          "slug": { "type": "string" },
          "logo": { "type": "string" },
          "active": { "type": "boolean" },
          "domestic": { "type": "boolean" },
          "regional": { "type": "boolean" },
          "international": { "type": "boolean" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "Rate": {
        "type": "object",
        "properties": {
          "rate_id": { "type": "string" },
          "carrier_name": { "type": "string" },
          "carrier_slug": { "type": "string" },
          "carrier_logo": { "type": "string" },
          "amount": { "type": "number" },
          "currency": { "type": "string" },
          "delivery_date": { "type": "string" },
          "delivery_time": { "type": "string" },
          "delivery_eta": { "type": "integer" },
          "pickup_time": { "type": "string" },
          "pickup_eta": { "type": "integer" },
          "insurance_fee": { "type": "number" },
          "includes_insurance": { "type": "boolean" },
          "insurance_coverage": { "type": "number" },
          "carrier_reference": { "type": "string" },
          "used": { "type": "boolean" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "Shipment": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "shipment_id": { "type": "string", "example": "SH-40208776515" },
          "status": { "type": "string", "enum": ["cancelled", "confirmed", "delivered", "draft", "in-transit", "pending"] },
          "address_from": { "type": "string" },
          "address_to": { "type": "string" },
          "address_return": { "type": "string" },
          "parcel": { "type": "string" },
          "carrier": { "type": "string" },
          "carrier_tracking_number": { "type": "string" },
          "rate": { "type": "string" },
          "pickup_date": { "type": "string" },
          "delivery_date": { "type": "string" },
          "delivery_arranged": { "type": "boolean" },
          "shipment_purpose": { "type": "string" },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "description": { "type": "string" },
                "date": { "type": "string" },
                "location": { "type": "string" }
              }
            }
          },
          "metadata": { "type": "object", "additionalProperties": true },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "ShipmentResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "boolean" },
          "message": { "type": "string" },
          "data": { "$ref": "#/components/schemas/Shipment" }
        }
      },
      "Parcel": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "parcel_id": { "type": "string" },
          "description": { "type": "string" },
          "packaging": { "type": "string" },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "description": { "type": "string" },
                "name": { "type": "string" },
                "currency": { "type": "string" },
                "value": { "type": "number" },
                "quantity": { "type": "integer" },
                "weight": { "type": "number" }
              }
            }
          },
          "total_weight": { "type": "number" },
          "weight_unit": { "type": "string" },
          "used": { "type": "boolean" },
          "proof_of_payments": { "type": "array", "items": { "type": "string" } },
          "rec_docs": { "type": "array", "items": { "type": "string" } },
          "metadata": { "type": "object", "additionalProperties": true },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "Claim": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "claim_id": { "type": "string" },
          "insurance_id": { "type": "string" },
          "shipment_id": { "type": "string" },
          "status": { "type": "string" },
          "amount": { "type": "number" },
          "reason": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "total": { "type": "integer" },
          "perPage": { "type": "integer" },
          "page": { "type": "integer" },
          "pageCount": { "type": "integer" },
          "hasNextPage": { "type": "boolean" }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "status": { "type": "boolean", "example": false },
          "message": { "type": "string", "description": "Error description." }
        }
      }
    }
  }
}