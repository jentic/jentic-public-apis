{
  "openapi": "3.0.0",
  "info": {
    "version": "1.0",
    "title": "Vio Decodificar",
    "description": "O Vio Decodificar permite agilizar e automatizar o processo de autenticação de documentos compatíveis\n\n\nChave do ambiente Trial **Bearer 06aef429-a981-3ec5-a1f8-71d38d86481e**",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/ERICKLCARLI/vio-decodificar/1.0"
  },
  "servers": [
    {
      "url": "https://gateway.apiserpro.serpro.gov.br/viodec-trial",
      "description": "trial"
    }
  ],
  "paths": {
    "/v1/decode": {
      "post": {
        "summary": "Decodificar dados do QR Code Vio",
        "description": "Decodifica uma sequência de bytes que foi extraída de um QR Code Vio e, caso a entidade emissora do documento tenha autorizado e disponibilizado esse serviço, verifica online o status do documento. Se não for possível realizar essa consulta online, o resultado da decodificação é retornado normalmente.",
        "operationId": "decode",
        "requestBody": {
          "content": {
            "application/octet-stream": {
              "schema": {
                "title": "qrCodeBinnary",
                "type": "string"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sucesso. Retorna informações do documento com status, se disponível.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Content"
                }
              }
            }
          },
          "400": {
            "description": "Requisição com erro"
          },
          "422": {
            "description": "Dados do QR Code não puderam ser processados, corpo de retorno contém o motivo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ViolationArray"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Content": {
        "type": "object",
        "properties": {
          "template": {
            "$ref": "#/components/schemas/Template"
          },
          "data": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "image": {
            "$ref": "#/components/schemas/Imagem"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "Template": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "owner": {
            "$ref": "#/components/schemas/Owner"
          }
        }
      },
      "Imagem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "base64": {
            "type": "string"
          }
        }
      },
      "Owner": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "ViolationArray": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Violation"
        }
      },
      "Violation": {
        "type": "object",
        "properties": {
          "property": {
            "type": "string",
            "description": "Atributo que causou a violação"
          },
          "message": {
            "type": "string",
            "description": "Detalhe da violação"
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}
