{
  "openapi": "3.0.3",
  "info": {
    "title": "Football Simulation Platform API",
    "description": "# 🎮 Football Simulation Platform API\n\nAI-powered football tournament and match simulation engine with live commentary, player statistics, and tournament management.\n\n## ✨ Key Features\n- **AI Match Simulation** - Realistic match outcomes powered by machine learning\n- **Live Commentary** - Dynamic play-by-play commentary streaming\n- **Player Statistics** - Detailed performance metrics per match\n- **Tournament Management** - Create competitions with points tables\n- **Match History** - Query past matches and player performance\n- **Real-time Events** - Goals, cards, fouls, substitutions as they happen\n\n## 🔒 Authentication\nAll endpoints require JWT Bearer token (Auth0). Include in request headers:\n```\nAuthorization: Bearer YOUR_TOKEN_HERE\n```\n\n## 📊 Response Format\nList endpoints return paginated responses:\n```json\n{\n  \"data\": [...],\n  \"meta\": {\n    \"offset\": 0,\n    \"limit\": 20,\n    \"total\": 150,\n    \"hasMore\": true\n  }\n}\n```\n",
    "contact": {
      "name": "API Support",
      "url": "https://footballsim.com/support",
      "email": "api-support@footballsim.com"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    },
    "version": "1.0.0",
    "x-logo": {
      "url": "https://footballsim.com/logo.png",
      "altText": "Football Simulation Platform"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/xansrmedia-e14/football-simulation-platform-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.footballsim.com/v1",
      "description": "Production"
    },
    {
      "url": "https://virtserver.swaggerhub.com/xansr-93d/Football_Sim/1.0.0",
      "description": "Mock Server"
    }
  ],
  "security": [
    {
      "Auth0": []
    }
  ],
  "tags": [
    {
      "name": "Teams",
      "description": "Team management and roster operations"
    },
    {
      "name": "Players",
      "description": "Player information and profiles"
    },
    {
      "name": "Matches",
      "description": "Match creation and management"
    },
    {
      "name": "Simulation",
      "description": "Match simulation and event streaming"
    },
    {
      "name": "Competitions",
      "description": "Tournament and competition management"
    },
    {
      "name": "Stats",
      "description": "Match statistics and performance data"
    },
    {
      "name": "History",
      "description": "Historical match and player data"
    },
    {
      "name": "Users",
      "description": "User profile management"
    }
  ],
  "paths": {
    "/simulation/matches": {
      "post": {
        "tags": [
          "Simulation"
        ],
        "summary": "Create and start a simulation match",
        "description": "Creates a new simulation match, builds squads from the existing DB, and starts minute-by-minute simulation. Use `durationSec` to control how long the full match takes in wall-clock time.",
        "operationId": "createSimulationMatch",
        "parameters": [
          {
            "name": "durationSec",
            "in": "query",
            "description": "Total wall-clock duration (seconds) to simulate the full match. Probabilities remain per simulated minute.",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SimulationMatchCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Simulation match created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimulationMatchCreateResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequest"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalServerError"
                }
              }
            }
          }
        }
      }
    },
    "/simulation/matches/{simulationMatchId}": {
      "get": {
        "tags": [
          "Simulation"
        ],
        "summary": "Get simulation match summary",
        "description": "Returns status + final score (when finished).",
        "operationId": "getSimulationMatch",
        "parameters": [
          {
            "name": "simulationMatchId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Simulation match",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimulationMatch"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFound"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalServerError"
                }
              }
            }
          }
        }
      }
    },
    "/simulation/matches/{simulationMatchId}/events": {
      "get": {
        "tags": [
          "Simulation"
        ],
        "summary": "List simulation match events",
        "description": "Returns the persisted event timeline for a simulation match.",
        "operationId": "listSimulationMatchEvents",
        "parameters": [
          {
            "name": "simulationMatchId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Events",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SimulationMatchEvent"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFound"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalServerError"
                }
              }
            }
          }
        }
      }
    },
    "/simulation/matches/{simulationMatchId}/stream": {
      "get": {
        "tags": [
          "Simulation"
        ],
        "summary": "Stream simulation events (SSE)",
        "description": "Server-Sent Events stream of simulation match events as they happen.",
        "operationId": "streamSimulationMatch",
        "parameters": [
          {
            "name": "simulationMatchId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "SSE stream",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/teams": {
      "get": {
        "tags": [
          "Teams"
        ],
        "summary": "List all teams",
        "description": "Get paginated list of all teams with optional filters",
        "operationId": "listTeams",
        "parameters": [
          {
            "name": "offset",
            "in": "query",
            "description": "Result offset",
            "required": false,
            "schema": {
              "minimum": 0,
              "type": "integer",
              "default": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Number of results",
            "required": false,
            "schema": {
              "maximum": 100,
              "minimum": 1,
              "type": "integer",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved teams",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/inline_response_200"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequest"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalServerError"
                }
              }
            }
          }
        }
      }
    },
    "/teams/{teamId}": {
      "get": {
        "tags": [
          "Teams"
        ],
        "summary": "Get team details",
        "description": "Retrieve detailed information about a specific team",
        "operationId": "getTeam",
        "parameters": [
          {
            "name": "teamId",
            "in": "path",
            "description": "Team ID",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Team found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Team"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFound"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalServerError"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Teams"
        ],
        "summary": "Update team",
        "description": "Modify team information (name, abbreviation)",
        "operationId": "updateTeam",
        "parameters": [
          {
            "name": "teamId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/teams_teamId_body"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Team updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Team"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFound"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalServerError"
                }
              }
            }
          }
        }
      }
    },
    "/teams/{teamId}/players": {
      "get": {
        "tags": [
          "Teams"
        ],
        "summary": "Get team roster",
        "description": "List all players in a team with pagination",
        "operationId": "getTeamPlayers",
        "parameters": [
          {
            "name": "teamId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "maximum": 100,
              "type": "integer",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Team roster retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/inline_response_200_1"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFound"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalServerError"
                }
              }
            }
          }
        }
      }
    },
    "/players/{playerId}": {
      "get": {
        "tags": [
          "Players"
        ],
        "summary": "Get player profile",
        "description": "Retrieve detailed player information and statistics",
        "operationId": "getPlayer",
        "parameters": [
          {
            "name": "playerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Player found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Player"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFound"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalServerError"
                }
              }
            }
          }
        }
      }
    },
    "/matches": {
      "post": {
        "tags": [
          "Matches"
        ],
        "summary": "Create match",
        "description": "Create a new match between two teams",
        "operationId": "createMatch",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SimulationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Match created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Match"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequest"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalServerError"
                }
              }
            }
          }
        }
      }
    },
    "/matches/{matchId}": {
      "get": {
        "tags": [
          "Matches"
        ],
        "summary": "Get match details",
        "description": "Retrieve complete match information including scores and timeline",
        "operationId": "getMatch",
        "parameters": [
          {
            "name": "matchId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Match found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Match"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFound"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalServerError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Matches"
        ],
        "summary": "Delete match",
        "description": "Remove a match (cascades to related data)",
        "operationId": "deleteMatch",
        "parameters": [
          {
            "name": "matchId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Match deleted successfully"
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFound"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalServerError"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Matches"
        ],
        "summary": "Update match",
        "description": "Update match status, scores, and results",
        "operationId": "updateMatch",
        "parameters": [
          {
            "name": "matchId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/matches_matchId_body"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Match updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Match"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFound"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalServerError"
                }
              }
            }
          }
        }
      }
    },
    "/simulation/match": {
      "post": {
        "deprecated": true,
        "tags": [
          "Simulation"
        ],
        "summary": "Deprecated: use POST /simulation/matches",
        "description": "Deprecated in favor of POST /simulation/matches.",
        "operationId": "simulateMatchDeprecated",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SimulationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "410": {
            "description": "Gone"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TeamId": {
        "type": "string",
        "description": "Team identifier from insights DB",
        "example": "team_123"
      },
      "PlayerId": {
        "type": "string",
        "description": "Player identifier from insights DB",
        "example": "player_456"
      },
      "SimulationMatchStatus": {
        "type": "string",
        "description": "Current state of the simulation match",
        "enum": [
          "created",
          "running",
          "finished",
          "failed"
        ]
      },
      "SimulationMatchCreateRequest": {
        "type": "object",
        "required": [
          "home_team_id",
          "away_team_id"
        ],
        "properties": {
          "home_team_id": {
            "$ref": "#/components/schemas/TeamId"
          },
          "away_team_id": {
            "$ref": "#/components/schemas/TeamId"
          }
        }
      },
      "SimulationMatchCreateResponse": {
        "type": "object",
        "required": [
          "simulation_match_id",
          "status"
        ],
        "properties": {
          "simulation_match_id": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "$ref": "#/components/schemas/SimulationMatchStatus"
          }
        }
      },
      "SimulationMatch": {
        "type": "object",
        "required": [
          "simulation_match_id",
          "home_team_id",
          "away_team_id",
          "status"
        ],
        "properties": {
          "simulation_match_id": {
            "type": "integer",
            "format": "int64"
          },
          "home_team_id": {
            "$ref": "#/components/schemas/TeamId"
          },
          "away_team_id": {
            "$ref": "#/components/schemas/TeamId"
          },
          "status": {
            "$ref": "#/components/schemas/SimulationMatchStatus"
          },
          "home_score": {
            "type": "integer",
            "nullable": true
          },
          "away_score": {
            "type": "integer",
            "nullable": true
          }
        }
      },
      "SimulationMatchEvent": {
        "type": "object",
        "required": [
          "id",
          "simulation_match_id",
          "minute",
          "event_type"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "simulation_match_id": {
            "type": "integer",
            "format": "int64"
          },
          "minute": {
            "type": "integer"
          },
          "event_type": {
            "type": "string",
            "example": "goal"
          },
          "team": {
            "type": "string",
            "enum": [
              "home",
              "away"
            ],
            "nullable": true
          },
          "player_id": {
            "$ref": "#/components/schemas/PlayerId"
          },
          "player_name": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "raw_data": {
            "type": "object",
            "nullable": true
          }
        }
      },
      "CompetitionStatus": {
        "type": "string",
        "description": "Current state of the competition",
        "example": "ongoing",
        "enum": [
          "not_started",
          "ongoing",
          "finished",
          "cancelled"
        ]
      },
      "MatchStatus": {
        "type": "string",
        "description": "Current state of the match",
        "example": "finished",
        "enum": [
          "scheduled",
          "simulating",
          "finished",
          "cancelled"
        ]
      },
      "Error": {
        "required": [
          "code",
          "message",
          "timestamp"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "description": "HTTP status code"
          },
          "message": {
            "type": "string",
            "description": "Error message"
          },
          "details": {
            "type": "string",
            "description": "Additional error details"
          },
          "timestamp": {
            "type": "string",
            "description": "When error occurred",
            "format": "date-time"
          }
        }
      },
      "BadRequest": {
        "example": {
          "code": 400,
          "message": "Bad Request",
          "details": "Invalid input parameters",
          "timestamp": "2026-03-13T10:00:00Z"
        },
        "allOf": [
          {
            "$ref": "#/components/schemas/Error"
          }
        ]
      },
      "NotFound": {
        "example": {
          "code": 404,
          "message": "Not Found",
          "details": "Resource not found",
          "timestamp": "2026-03-13T10:00:00Z"
        },
        "allOf": [
          {
            "$ref": "#/components/schemas/Error"
          }
        ]
      },
      "InternalServerError": {
        "example": {
          "code": 500,
          "message": "Internal Server Error",
          "details": "An unexpected error occurred",
          "timestamp": "2026-03-13T10:00:00Z"
        },
        "allOf": [
          {
            "$ref": "#/components/schemas/Error"
          }
        ]
      },
      "PaginationMeta": {
        "type": "object",
        "properties": {
          "offset": {
            "minimum": 0,
            "type": "integer",
            "description": "Result offset position"
          },
          "limit": {
            "maximum": 100,
            "minimum": 1,
            "type": "integer",
            "description": "Number of results returned"
          },
          "total": {
            "type": "integer",
            "description": "Total number of results available"
          },
          "hasMore": {
            "type": "boolean",
            "description": "Whether more results exist"
          }
        },
        "description": "Pagination metadata for list responses"
      },
      "Team": {
        "required": [
          "id",
          "tname"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Internal team ID"
          },
          "tid": {
            "type": "integer",
            "description": "External team reference ID"
          },
          "tname": {
            "type": "string",
            "description": "Team name",
            "example": "Manchester United"
          },
          "fullname": {
            "type": "string",
            "description": "Full formal team name",
            "example": "Manchester United Football Club"
          },
          "abbr": {
            "type": "string",
            "description": "Team abbreviation",
            "example": "MUN"
          },
          "iscountry": {
            "type": "boolean",
            "description": "Whether team is a national team"
          },
          "isclub": {
            "type": "boolean",
            "description": "Whether team is a club"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "description": "Football team entity"
      },
      "Player": {
        "required": [
          "fullname",
          "id"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Internal player ID"
          },
          "pid": {
            "type": "integer",
            "description": "External player reference ID"
          },
          "fullname": {
            "type": "string",
            "description": "Player full name",
            "example": "Cristiano Ronaldo"
          },
          "birthdate": {
            "type": "string",
            "description": "Date of birth",
            "format": "date-time"
          },
          "nationality_name": {
            "type": "string",
            "description": "Player nationality",
            "example": "Portugal"
          },
          "nationality_iocid": {
            "type": "string",
            "description": "IOC country code",
            "example": "POR"
          },
          "positionname": {
            "type": "string",
            "description": "Playing position",
            "example": "Forward"
          },
          "height": {
            "type": "string",
            "description": "Player height in cm"
          },
          "weight": {
            "type": "string",
            "description": "Player weight in kg"
          },
          "foot": {
            "type": "string",
            "description": "Preferred foot",
            "enum": [
              "left",
              "right",
              "both"
            ]
          },
          "fantasy_player_rating": {
            "type": "number",
            "description": "Fantasy sports rating score",
            "format": "decimal"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "description": "Football player entity"
      },
      "Match": {
        "required": [
          "away_tid",
          "cid",
          "home_tid"
        ],
        "type": "object",
        "properties": {
          "match_id": {
            "type": "integer",
            "description": "Match identifier"
          },
          "cid": {
            "type": "integer",
            "description": "Competition ID"
          },
          "cname": {
            "type": "string",
            "description": "Competition name"
          },
          "round": {
            "type": "string",
            "description": "Match round/week"
          },
          "match_number": {
            "type": "string",
            "description": "Match number in competition"
          },
          "home_team": {
            "$ref": "#/components/schemas/Team"
          },
          "away_team": {
            "$ref": "#/components/schemas/Team"
          },
          "home_tid": {
            "type": "integer",
            "description": "Home team ID"
          },
          "away_tid": {
            "type": "integer",
            "description": "Away team ID"
          },
          "home_score": {
            "type": "integer",
            "description": "Home team goals"
          },
          "away_score": {
            "type": "integer",
            "description": "Away team goals"
          },
          "datestart": {
            "type": "string",
            "description": "Match start time",
            "format": "date-time"
          },
          "dateend": {
            "type": "string",
            "description": "Match end time",
            "format": "date-time"
          },
          "status": {
            "$ref": "#/components/schemas/MatchStatus"
          },
          "winner": {
            "type": "string",
            "description": "Winning team or draw result"
          },
          "venueid": {
            "type": "integer",
            "description": "Stadium/venue identifier"
          },
          "venue_name": {
            "type": "string",
            "description": "Venue name"
          },
          "venue_location": {
            "type": "string",
            "description": "Venue location"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "description": "Match entity with teams and scores"
      },
      "SimulationRequest": {
        "required": [
          "away_team_id",
          "home_team_id"
        ],
        "type": "object",
        "properties": {
          "home_team_id": {
            "$ref": "#/components/schemas/TeamId"
          },
          "away_team_id": {
            "$ref": "#/components/schemas/TeamId"
          }
        },
        "description": "Request to simulate a match"
      },
      "SimulationResponse": {
        "type": "object",
        "properties": {
          "match_id": {
            "type": "integer",
            "description": "Created match ID"
          },
          "status": {
            "$ref": "#/components/schemas/MatchStatus"
          }
        },
        "description": "Match simulation initiated"
      },
      "inline_response_200": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Team"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/PaginationMeta"
          }
        }
      },
      "teams_teamId_body": {
        "type": "object",
        "properties": {
          "tname": {
            "type": "string"
          },
          "fullname": {
            "type": "string"
          },
          "abbr": {
            "type": "string"
          }
        }
      },
      "inline_response_200_1": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Player"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/PaginationMeta"
          }
        }
      },
      "matches_matchId_body": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/MatchStatus"
          },
          "home_score": {
            "type": "integer"
          },
          "away_score": {
            "type": "integer"
          }
        }
      }
    },
    "securitySchemes": {
      "Auth0": {
        "type": "http",
        "description": "Auth0 JWT token",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
