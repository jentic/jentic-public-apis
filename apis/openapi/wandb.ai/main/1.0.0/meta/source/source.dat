{
  "openapi": "3.0.3",
  "info": {
    "title": "Weights & Biases Weave Service API",
    "description": "Weave is W&B's LLM observability and evaluation platform. The Weave Service API provides REST endpoints for managing calls (traces), objects, tables, feedback, scores, evaluations, annotation queues, and files. The core W&B experiment tracking uses GraphQL (not covered here).",
    "version": "1.0.0",
    "x-jentic-source-url": "https://docs.wandb.ai/weave/reference/service-api",
    "x-jentic-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://trace.wandb.ai",
      "description": "Multi-tenant / Dedicated Cloud"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/call/start": {
      "post": {
        "operationId": "startCall",
        "summary": "Start a new call (trace span)",
        "description": "Starts recording a new call/trace span. Returns a call ID for tracking.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "start": {
                    "type": "object",
                    "properties": {
                      "project_id": { "type": "string", "description": "Format: entity/project" },
                      "op_name": { "type": "string" },
                      "trace_id": { "type": "string" },
                      "parent_id": { "type": "string" },
                      "started_at": { "type": "string", "format": "date-time" },
                      "attributes": { "type": "object" },
                      "inputs": { "type": "object" }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Call started.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "trace_id": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/call/end": {
      "post": {
        "operationId": "endCall",
        "summary": "End a call (trace span)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "end": {
                    "type": "object",
                    "properties": {
                      "id": { "type": "string" },
                      "project_id": { "type": "string" },
                      "ended_at": { "type": "string", "format": "date-time" },
                      "output": { "type": "object" },
                      "summary": { "type": "object" },
                      "exception": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Call ended successfully."
          }
        }
      }
    },
    "/call/read": {
      "post": {
        "operationId": "readCall",
        "summary": "Read a specific call",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "project_id": { "type": "string" },
                  "id": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Call details.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Call" }
              }
            }
          }
        }
      }
    },
    "/calls/query_stream": {
      "post": {
        "operationId": "queryCalls",
        "summary": "Query and stream calls",
        "description": "Query calls with filters and stream results.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "project_id": { "type": "string" },
                  "filter": { "type": "object" },
                  "limit": { "type": "integer" },
                  "offset": { "type": "integer" },
                  "sort_by": { "type": "array", "items": { "type": "object" } }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stream of call objects.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Call" }
                }
              }
            }
          }
        }
      }
    },
    "/call/update": {
      "post": {
        "operationId": "updateCall",
        "summary": "Update a call's display name",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "project_id": { "type": "string" },
                  "call_id": { "type": "string" },
                  "display_name": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Call updated." }
        }
      }
    },
    "/calls/delete": {
      "post": {
        "operationId": "deleteCalls",
        "summary": "Delete calls",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "project_id": { "type": "string" },
                  "call_ids": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Calls deleted." }
        }
      }
    },
    "/obj/create": {
      "post": {
        "operationId": "createObject",
        "summary": "Create a Weave object",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "obj": {
                    "type": "object",
                    "properties": {
                      "project_id": { "type": "string" },
                      "object_id": { "type": "string" },
                      "val": { "type": "object" }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Object created.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "digest": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/obj/read": {
      "post": {
        "operationId": "readObject",
        "summary": "Read a Weave object",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "project_id": { "type": "string" },
                  "object_id": { "type": "string" },
                  "digest": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Object data.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "obj": { "type": "object" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/objs/query": {
      "post": {
        "operationId": "queryObjects",
        "summary": "Query Weave objects",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "project_id": { "type": "string" },
                  "filter": { "type": "object" },
                  "limit": { "type": "integer" },
                  "offset": { "type": "integer" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Query results.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "objs": { "type": "array", "items": { "type": "object" } }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/table/create": {
      "post": {
        "operationId": "createTable",
        "summary": "Create a Weave table",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "table": {
                    "type": "object",
                    "properties": {
                      "project_id": { "type": "string" },
                      "rows": { "type": "array", "items": { "type": "object" } }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Table created.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "digest": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/table/query": {
      "post": {
        "operationId": "queryTable",
        "summary": "Query a Weave table",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "project_id": { "type": "string" },
                  "digest": { "type": "string" },
                  "filter": { "type": "object" },
                  "limit": { "type": "integer" },
                  "offset": { "type": "integer" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Table query results.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "rows": { "type": "array", "items": { "type": "object" } }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/feedback/create": {
      "post": {
        "operationId": "createFeedback",
        "summary": "Create feedback on a call",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "project_id": { "type": "string" },
                  "weave_ref": { "type": "string" },
                  "feedback_type": { "type": "string" },
                  "payload": { "type": "object" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Feedback created.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/feedback/query": {
      "post": {
        "operationId": "queryFeedback",
        "summary": "Query feedback",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "project_id": { "type": "string" },
                  "filter": { "type": "object" },
                  "limit": { "type": "integer" },
                  "offset": { "type": "integer" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Feedback results.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": { "type": "array", "items": { "type": "object" } }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/file/create": {
      "post": {
        "operationId": "createFile",
        "summary": "Create a file",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "project_id": { "type": "string" },
                  "name": { "type": "string" },
                  "content": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "File created.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "digest": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/file/content": {
      "post": {
        "operationId": "getFileContent",
        "summary": "Get file content",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "project_id": { "type": "string" },
                  "digest": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "File content.",
            "content": {
              "application/octet-stream": {
                "schema": { "type": "string", "format": "binary" }
              }
            }
          }
        }
      }
    },
    "/refs/read_batch": {
      "post": {
        "operationId": "readRefsBatch",
        "summary": "Read multiple refs in batch",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "refs": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Batch read results.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "vals": { "type": "array", "items": {} }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "healthCheck",
        "summary": "Health check endpoint",
        "security": [],
        "responses": {
          "200": {
            "description": "Service is healthy."
          }
        }
      }
    },
    "/server_info": {
      "get": {
        "operationId": "getServerInfo",
        "summary": "Get server information",
        "security": [],
        "responses": {
          "200": {
            "description": "Server information.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/cost/create": {
      "post": {
        "operationId": "createCost",
        "summary": "Create a cost record",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "project_id": { "type": "string" },
                  "costs": { "type": "object" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Cost created." }
        }
      }
    },
    "/cost/query": {
      "post": {
        "operationId": "queryCosts",
        "summary": "Query cost records",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "project_id": { "type": "string" },
                  "filter": { "type": "object" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cost query results.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": { "type": "array", "items": { "type": "object" } }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "W&B API key passed as a Bearer token in the Authorization header."
      }
    },
    "schemas": {
      "Call": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "project_id": { "type": "string" },
          "op_name": { "type": "string" },
          "trace_id": { "type": "string" },
          "parent_id": { "type": "string", "nullable": true },
          "started_at": { "type": "string", "format": "date-time" },
          "ended_at": { "type": "string", "format": "date-time", "nullable": true },
          "inputs": { "type": "object" },
          "output": { "type": "object", "nullable": true },
          "summary": { "type": "object", "nullable": true },
          "exception": { "type": "string", "nullable": true },
          "attributes": { "type": "object" },
          "display_name": { "type": "string", "nullable": true }
        }
      }
    }
  }
}
