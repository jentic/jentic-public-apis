ame":"clickfunnels_custom_attribute_value","in":"query","required":false,"description":"ClickFunnels custom attribute value.","schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"*/*":{"schema":{"$ref":"#/components/schemas/annotation"}}}},"201":{"description":"Created","content":{"*/*":{"schema":{"$ref":"#/components/schemas/annotation"}}}},"401":{"description":"Not Authorized"},"404":{"description":"Not Found"},"422":{"description":"Unprocessable Entity"},"500":{"description":"Error"},"503":{"description":"Rate Limit Exceeded"}},"x-codeSamples":[{"lang":"curl","label":"Create button","source":"curl --request POST \\\n  --url https://api.mindstamp.com/api/v1/interactions/create \\\n  --header 'Authorization: Bearer <access_token>' \\\n  --form 'video_id=<video_id_or_token>' \\\n  --form 'type=button' \\\n  --form 'time=10' \\\n  --form 'finish=15' \\\n  --form 'content=Test button' \\\n  --form 'tooltip=Learn more about this button' \\\n  --form 'click_action=link' \\\n  --form 'click_value=https://google.com' \\\n  --form 'left=10' \\\n  --form 'top=10' \\\n  --form 'width=20' \\\n  --form 'height=10'"},{"lang":"curl","label":"Create redirect","source":"curl --request POST \\\n  --url https://api.mindstamp.com/api/v1/interactions/create \\\n  --header 'Authorization: Bearer <access_token>' \\\n  --form 'video_id=<video_id_or_token>' \\\n  --form 'type=redirect' \\\n  --form 'time=12.5' \\\n  --form 'redirect_url=https://example.com/next'"},{"lang":"curl","label":"Create jump","source":"curl --request POST \\\n  --url https://api.mindstamp.com/api/v1/interactions/create \\\n  --header 'Authorization: Bearer <access_token>' \\\n  --form 'video_id=<video_id_or_token>' \\\n  --form 'type=jump' \\\n  --form 'time=20' \\\n  --form 'target_time=45'"},{"lang":"curl","label":"Create required spotlight button","source":"curl --request POST \\\n  --url https://api.mindstamp.com/api/v1/interactions/create \\\n  --header 'Authorization: Bearer <access_token>' \\\n  --form 'video_id=<video_id_or_token>' \\\n  --form 'type=button' \\\n  --form 'time=10' \\\n  --form 'finish=20' \\\n  --form 'content=Schedule a demo' \\\n  --form 'click_action=link' \\\n  --form 'click_value=https://example.com/demo' \\\n  --form 'left=10' \\\n  --form 'top=12' \\\n  --form 'width=28' \\\n  --form 'height=10' \\\n  --form 'must_click=true' \\\n  --form 'do_spotlight=true' \\\n  --form 'force_lead_capture=true' \\\n  --form 'pause=true' \\\n  --form 'timer=-1' \\\n  --form 'transition=fade' \\\n  --form 'post_click_state=color' \\\n  --form 'post_click_color=#103a5c' \\\n  --form 'post_click_text_color=#ffffff' \\\n  --form 'internal_label=Demo CTA'"},{"lang":"curl","label":"Create hotspot in magic menu","source":"curl --request POST \\\n  --url https://api.mindstamp.com/api/v1/interactions/create \\\n  --header 'Authorization: Bearer <access_token>' \\\n  --form 'video_id=<video_id_or_token>' \\\n  --form 'type=hotspot' \\\n  --form 'time=14' \\\n  --form 'finish=30' \\\n  --form 'click_action=copy' \\\n  --form 'click_value=DISCOUNT10' \\\n  --form 'left=45' \\\n  --form 'top=30' \\\n  --form 'width=20' \\\n  --form 'height=18' \\\n  --form 'caption=Copy discount code' \\\n  --form 'show_caption=true' \\\n  --form 'hotspot_show_ring=true' \\\n  --form 'hotspot_ring_width=18' \\\n  --form 'points=[[10,10],[90,10],[90,80],[10,80]]' \\\n  --form 'tray=true' \\\n  --form 'tray_type=magic_menu'"}],"operationId":"post_interactions-create"}},"/interactions/question/create":{"post":{"tags":["Interactions"],"summary":"Create a question","description":"Create a new question for a specified video","parameters":[{"name":"video_id","in":"query","required":true,"description":"The video_id or token of the video you want to add the interaction to","schema":{"type":"string"}},{"name":"type","in":"query","required":true,"description":"The type of question (either 'free', 'multiple', 'all', 'draw', 'number', 'date', 'video', 'voice', 'image', 'rating', 'select', 'likert', 'poll')","schema":{"type":"string"}},{"name":"time","in":"query","required":true,"description":"When the question should appear on the screen","schema":{"type":"number","format":"float"}},{"name":"prompt","in":"query","required":true,"schema":{"type":"string"}},{"name":"answers","in":"query","required":false,"description":"A semi-colon separated list of answer choices","schema":{"type":"string"}},{"name":"actions","in":"query","required":false,"description":"A semi-colon separated list of actions when an answer is clicked (track, reply, message, jump, link, video, back, email, phone, clip, audio, download, article, view, none). Defaults to reply.","schema":{"type":"string","enum":["track","reply","message","jump","link","video","back","email","phone","clip","audio","download","article","view","none"]}},{"name":"values","in":"query","required":false,"description":"A semi-colon separated list of values associated with the actions","schema":{"type":"string"}},{"name":"top","in":"query","required":false,"schema":{"type":"string"}},{"name":"left","in":"query","required":false,"schema":{"type":"string"}},{"name":"height","in":"query","required":false,"schema":{"type":"string"}},{"name":"width","in":"query","required":false,"schema":{"type":"string"}},{"name":"background_color","in":"query","required":false,"schema":{"type":"string"}},{"name":"correct_color","in":"query","required":false,"schema":{"type":"string"}},{"name":"incorrect_color","in":"query","required":false,"schema":{"type":"string"}},{"name":"prompt_color","in":"query","required":false,"schema":{"type":"string"}},{"name":"answer_color","in":"query","required":false,"description":"Alias for answers_color.","schema":{"type":"string"}},{"name":"answer","in":"query","required":false,"schema":{"type":"string"},"description":"Singular alias for answers. Use a semi-colon separated list of answer choices."},{"name":"answers_color","in":"query","required":false,"schema":{"type":"string"},"description":"Text color for answer choices."},{"name":"correct_answer","in":"query","required":false,"schema":{"type":"string"},"description":"The answer value that should be treated as correct. Match the answer text exactly for choice questions."},{"name":"transition","in":"query","required":false,"schema":{"type":"string"},"description":"Question transition style."},{"name":"question_answers","in":"query","required":false,"description":"JSON array of answer objects. Each object can include text, click_action, click_value, click_time, second_action, second_value, second_time, variable, variable_value, and correct.","schema":{"type":"string"}},{"name":"text_color","in":"query","required":false,"description":"Prompt text color alias.","schema":{"type":"string"}},{"name":"question_answers_color","in":"query","required":false,"description":"Answer text color.","schema":{"type":"string"}},{"name":"question_correct_color","in":"query","required":false,"description":"Correct answer color.","schema":{"type":"string"}},{"name":"question_incorrect_color","in":"query","required":false,"description":"Incorrect answer color.","schema":{"type":"string"}},{"name":"question_single_correct","in":"query","required":false,"description":"Single correct answer value.","schema":{"type":"string"}},{"name":"question_multi_correct","in":"query","required":false,"description":"JSON array or semi-colon separated list of correct answer values.","schema":{"type":"string"}},{"name":"question_transition","in":"query","required":false,"description":"Question transition alias.","schema":{"type":"string"}},{"name":"timer","in":"query","required":false,"description":"Question time limit in seconds.","schema":{"type":"integer"}},{"name":"question_use_custom_design","in":"query","required":false,"description":"Use custom design for the question.","schema":{"type":"boolean"}},{"name":"question_use_time_limit","in":"query","required":false,"description":"Use the timer as a question time limit.","schema":{"type":"boolean"}},{"name":"question_skippable","in":"query","required":false,"description":"Allow the viewer to skip the question.","schema":{"type":"boolean"}},{"name":"question_rewindable","in":"query","required":false,"description":"Allow the viewer to rewind from the question.","schema":{"type":"boolean"}},{"name":"question_rewind_time","in":"query","required":false,"description":"Timestamp to rewind to.","schema":{"type":"number","format":"float"}},{"name":"question_use_hint","in":"query","required":false,"description":"Show a question hint.","schema":{"type":"boolean"}},{"name":"question_hint","in":"query","required":false,"description":"Question hint text.","schema":{"type":"string"}},{"name":"question_repeat_until_correct","in":"query","required":false,"description":"Repeat the question until the viewer answers correctly.","schema":{"type":"boolean"}},{"name":"question_case_sensitive","in":"query","required":false,"description":"Free response only. Require an exact case match with a correct answer. Default false (case is ignored).","schema":{"type":"boolean","default":false}},{"name":"question_read_prompt","in":"query","required":false,"description":"Read the prompt aloud.","schema":{"type":"boolean"}},{"name":"question_read_answers","in":"query","required":false,"description":"Read the answer choices aloud.","schema":{"type":"boolean"}},{"name":"question_voice_number","in":"query","required":false,"description":"Voice number for read-aloud question audio.","schema":{"type":"integer"}},{"name":"question_post_message","in":"query","required":false,"description":"Message shown after the question.","schema":{"type":"string"}},{"name":"question_allow_upload","in":"query","required":false,"description":"Allow upload responses where supported.","schema":{"type":"boolean"}},{"name":"question_has_correct_answer","in":"query","required":false,"description":"Whether this question has one or more correct answers.","schema":{"type":"boolean"}},{"name":"question_min_length","in":"query","required":false,"description":"Minimum answer length.","schema":{"type":"integer"}},{"name":"question_max_length","in":"query","required":false,"description":"Maximum answer length.","schema":{"type":"integer"}},{"name":"question_min_value","in":"query","required":false,"description":"Minimum numeric answer value.","schema":{"type":"integer"}},{"name":"question_max_value","in":"query","required":false,"description":"Maximum numeric answer value.","schema":{"type":"integer"}},{"name":"question_correct_action","in":"query","required":false,"description":"Action to run after a correct answer.","schema":{"type":"string","enum":["track","reply","message","jump","link","video","back","email","phone","clip","audio","download","article","view","none"]}},{"name":"question_correct_value","in":"query","required":false,"description":"Action value for a correct answer.","schema":{"type":"string"}},{"name":"question_correct_arg","in":"query","required":false,"description":"Action argument for a correct answer.","schema":{"type":"string"}},{"name":"question_incorrect_action","in":"query","required":false,"description":"Action to run after an incorrect answer.","schema":{"type":"string","enum":["track","reply","message","jump","link","video","back","email","phone","clip","audio","download","article","view","none"]}},{"name":"question_incorrect_value","in":"query","required":false,"description":"Action value for an incorrect answer.","schema":{"type":"string"}},{"name":"question_incorrect_arg","in":"query","required":false,"description":"Action argument for an incorrect answer.","schema":{"type":"string"}},{"name":"internal_label","in":"query","required":false,"description":"Internal label for organization use.","schema":{"type":"string"}},{"name":"hidden","in":"query","required":false,"description":"Hide this question by default.","schema":{"type":"boolean"}},{"name":"hide_mobile","in":"query","required":false,"description":"Hide this question on mobile devices.","schema":{"type":"boolean"}},{"name":"hide_desktop","in":"query","required":false,"description":"Hide this question on desktop devices.","schema":{"type":"boolean"}},{"name":"variable","in":"query","required":false,"description":"Variable name to set from the question.","schema":{"type":"string"}},{"name":"value","in":"query","required":false,"description":"Variable value to set from the question.","schema":{"type":"string"}},{"name":"is_conditional","in":"query","required":false,"description":"Enable conditional display logic.","schema":{"type":"boolean"}},{"name":"conditional_show","in":"query","required":false,"description":"Show the question when the condition matches.","schema":{"type":"boolean"}},{"name":"conditional_variable","in":"query","required":false,"description":"Conditional variable name.","schema":{"type":"string"}},{"name":"conditional_assertion","in":"query","required":false,"description":"Conditional comparison operator.","schema":{"type":"string"}},{"name":"conditional_value","in":"query","required":false,"description":"Conditional comparison value.","schema":{"type":"string"}},{"name":"conditional_operator","in":"query","required":false,"description":"Operator used when combining two conditions.","schema":{"type":"integer"}},{"name":"is_conditional_2","in":"query","required":false,"description":"Enable a second conditional rule.","schema":{"type":"boolean"}},{"name":"conditional_variable_2","in":"query","required":false,"description":"Second conditional variable name.","schema":{"type":"string"}},{"name":"conditional_assertion_2","in":"query","required":false,"description":"Second conditional comparison operator.","schema":{"type":"string"}},{"name":"conditional_value_2","in":"query","required":false,"description":"Second conditional comparison value.","schema":{"type":"string"}},{"name":"question_map_hubspot","in":"query","required":false,"description":"Map question response to HubSpot.","schema":{"type":"boolean"}},{"name":"hubspot_field"