 'prompt=Which plan are you interested in?' \\\n  --form 'question_answers=[{\"text\":\"Starter\",\"click_action\":\"reply\",\"click_value\":\"Starter\",\"variable\":\"plan_interest\",\"variable_value\":\"starter\"},{\"text\":\"Pro\",\"click_action\":\"jump\",\"click_value\":\"60\",\"variable\":\"plan_interest\",\"variable_value\":\"pro\",\"correct\":true},{\"text\":\"Enterprise\",\"click_action\":\"link\",\"click_value\":\"https://example.com/contact\",\"variable\":\"plan_interest\",\"variable_value\":\"enterprise\"}]' \\\n  --form 'question_use_time_limit=true' \\\n  --form 'timer=30' \\\n  --form 'question_repeat_until_correct=true' \\\n  --form 'question_multi_correct=[\"Pro\"]' \\\n  --form 'question_correct_action=jump' \\\n  --form 'question_correct_value=60' \\\n  --form 'question_incorrect_action=message' \\\n  --form 'question_incorrect_value=Try again' \\\n  --form 'question_use_hint=true' \\\n  --form 'question_hint=Look for the plan with automation included' \\\n  --form 'internal_label=Plan qualification question'"}],"operationId":"post_interactions-question-create"}},"/interactions/delete/{id}":{"delete":{"tags":["Interactions"],"summary":"Delete an interaction","description":"Delete an existing API-created annotation except questions. This uses the annotation ID returned by POST /interactions/create.","parameters":[{"name":"id","in":"path","required":true,"description":"The annotation ID for the interaction you want to delete.","schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"*/*":{"schema":{"$ref":"#/components/schemas/interaction_delete_response"}}}},"401":{"description":"Not Authorized"},"404":{"description":"Not Found"},"422":{"description":"Unprocessable Entity"},"500":{"description":"Error"},"503":{"description":"Rate Limit Exceeded"}},"operationId":"delete_interactions-delete-id"}},"/insights":{"get":{"tags":["Insights"],"summary":"Get insights","description":"Return insights for a specified video, series, g