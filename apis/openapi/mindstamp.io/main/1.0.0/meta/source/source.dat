},"description":"Viewer phone."},{"name":"custom_id","in":"query","required":false,"schema":{"type":"string"},"description":"Viewer custom ID."}],"responses":{"201":{"description":"Created","content":{"*/*":{"schema":{"$ref":"#/components/schemas/plink"}}}},"401":{"description":"Not Authorized"},"404":{"description":"Not Found"},"422":{"description":"Unprocessable Entity"},"500":{"description":"Error"},"503":{"description":"Rate Limit Exceeded"}},"operationId":"post_videos-id-personalize"}},"/users/me":{"get":{"tags":["Users"],"summary":"Get current user","description":"Return the authenticated user and organization name.","parameters":[],"responses":{"200":{"description":"Success","content":{"*/*":{"schema":{"$ref":"#/components/schemas/user"}}}},"401":{"description":"Not Authorized"},"404":{"description":"Not Found"},"422":{"description":"Unprocessable Entity"},"500":{"description":"Error"},"503":{"description":"Rate Limit Exceeded"}},"operationId":"get_users-me"}},"/status/me":{"get":{"tags":["Status"],"summary":"Get API status","description":"Return a simple API status message. This endpoint does not require authentication.","parameters":[],"responses":{"200":{"description":"Success","content":{"*/*":{"schema":{"$ref":"#/components/schemas/status"}}}},"401":{"description":"Not Authorized"},"404":{"description":"Not Found"},"422":{"description":"Unprocessable Entity"},"500":{"description":"Error"},"503":{"description":"Rate Limit Exceeded"}},"security":[],"operationId":"get_status-me"}},"/views/summary":{"get":{"tags":["Views"],"summary":"Get view summary","description":"Return aggregate view, interaction, viewer, and watch-time totals.","parameters":[{"name":"id","in":"query","required":false,"schema":{"type":"string"},"description":"Optional share/video ID."},{"name":"started","in":"query","required":false,"schema":{"type":"string"},"description":"Start date, e.g. 2020-11-01."},{"name":"finished","in":"query","required":false,"schema":{"type":"string"},"description":"Finish date, e.g. 2020-11-09."}],"responses":{"200":{"description":"Success","content":{"*/*":{"schema":{"$ref":"#/components/schemas/view_summary"}}}},"401":{"description":"Not Authorized"},"404":{"description":"Not Found"},"422":{"description":"Unprocessable Entity"},"500":{"description":"Error"},"503":{"description":"Rate Limit Exceeded"}},"operationId":"get_views-summary"}},"/views/summary/week":{"get":{"tags":["Views"],"summary":"Get weekly view summary","description":"Return per-video view counts for the current week.","parameters":[{"name":"id","in":"query","required":false,"schema":{"type":"string"},"description":"Optional view ID."}],"responses":{"200":{"description":"Success","content":{"*/*":{"schema":{"$ref":"#/components/schemas/views_monthly_weekly_summary"}}}},"401":{"description":"Not Authorized"},"404":{"description":"Not Found"},"422":{"description":"Unprocessable Entity"},"500":{"description":"Error"},"503":{"description":"Rate Limit Exceeded"}},"operationId":"get_views-summary-week"}},"/views/summary/month":{"get":{"tags":["Views"],"summary":"Get monthly view summary","description":"Return per-video view counts for the current month.","parameters":[{"name":"id","in":"query","required":false,"schema":{"type":"string"},"description":"Optional view ID."}],"responses":{"200":{"description":"Success","content":{"*/*":{"schema":{"$ref":"#/components/schemas/views_monthly_weekly_summary"}}}},"401":{"description":"Not Authorized"},"404":{"description":"Not Found"},"422":{"description":"Unprocessable Entity"},"500":{"description":"Error"},"503":{"description":"Rate Limit Exceeded"}},"operationId":"get_views-summary-month"}},"/interactions/question/{id}":{"patch":{"tags":["Interactions"],"summary":"Update a question","description":"Update an existing question interaction. Use the id returned by the question create endpoint. Legacy API-created question identifiers are also resolved through the annotation record when available.","parameters":[{"name":"id","in":"path","required":true,"description":"The question interaction ID returned from question create.","schema":{"type":"string"}},{"name":"type","in":"query","required":false,"description":"Question type: free, multiple, all, draw, number, date, video, voice, image, rating, select, likert, or poll.","schema":{"type":"string"}},{"name":"time","in":"query","required":false,"description":"When the question should appear on the screen.","schema":{"type":"number","format":"float"}},{"name":"prompt","in":"query","required":false,"description":"Question prompt text.","schema":{"type":"string"}},{"name":"answers","in":"query","required":false,"description":"A semi-colon separated list of answer choices.","schema":{"type":"string"}},{"name":"answer","in":"query","required":false,"description":"Singular alias for answers. Use a semi-colon separated list of answer choices.","schema":{"type":"string"}},{"name":"actions","in":"query","required":false,"description":"A semi-colon separated list of actions when an answer is clicked (track, reply, message, jump, link, video, back, email, phone, clip, audio, download, article, view, none). Defaults to reply.","schema":{"type":"string","enum":["track","reply","message","jump","link","video","back","email","phone","clip","audio","download","article","view","none"]}},{"name":"values","in":"query","required":false,"description":"A semi-colon separated list of values associated with the actions.","schema":{"type":"string"}},{"name":"top","in":"query","required":false,"description":"Question top position as a percentage.","schema":{"type":"string"}},{"name":"left","in":"query","required":false,"description":"Question left position as a percentage.","schema":{"type":"string"}},{"name":"height","in":"query","required":false,"description":"Question height as a percentage.","schema":{"type":"string"}},{"name":"width","in":"query","required":false,"description":"Question width as a percentage.","schema":{"type":"string"}},{"name":"background_color","in":"query","required":false,"description":"Question background color.","schema":{"type":"string"}},{"name":"correct_color","in":"query","required":false,"description":"Correct answer color.","schema":{"type":"string"}},{"name":"incorrect_color","in":"query","required":false,"description":"Incorrect answer color.","schema":{"type":"string"}},{"name":"prompt_color","in":"query","required":false,"description":"Prompt text color.","schema":{"type":"string"}},{"name":"answers_color","in":"query","required":false,"description":"Answer text color.","schema":{"type":"string"}},{"name":"answer_color","in":"query","required":false,"description":"Alias for answers_color.","schema":{"type":"string"}},{"name":"correct_answer","in":"query","required":false,"description":"The answer value that should be treated as correct. Match the answer text exactly for choice questions. Send an empty value to clear.","schema":{"type":"string"}},{"name":"transition","in":"query","required":false,"description":"Question transition style.","schema":{"type":"string"}},{"name":"question_answers","in":"query","required":false,"description":"JSON array of answer objects. Each object can include text, click_action, click_value, click_time, second_action, second_value, second_time, variable, variable_value, and correct.","schema":{"type":"string"}},{"name":"text_color","in":"query","required":false,"description":"Prompt text color alias.","schema":{"type":"string"}},{"name":"question_answers_color","in":"query","required":false,"description":"Answer text color.","schema":{"type":"string"}},{"name":"question_correct_color","in":"query","required":false,"description":"Correct answer color.","schema":{"type":"string"}},{"name":"question_incorrect_color","in":"query","required":false,"description":"Incorrect answer color.","schema":{"type":"string"}},{"name":"question_single_correct","in":"query","required":false,"description":"Single correct answer value.","schema":{"type":"string"}},{"name":"question_multi_correct","in":"query","required":false,"description":"JSON array or semi-colon separated list of correct answer values.","schema":{"type":"string"}},{"name":"question_transition","in":"query","required":false,"description":"Question transition alias.","schema":{"type":"string"}},{"name":"timer","in":"query","required":false,"description":"Question time limit in seconds.","schema":{"type":"integer"}},{"name":"question_use_custom_design","in":"query","required":false,"description":"Use custom design for the question.","schema":{"type":"boolean"}},{"name":"question_use_time_limit","in":"query","required":false,"description":"Use the timer as a question time limit.","schema":{"type":"boolean"}},{"name":"question_skippable","in":"query","required":false,"description":"Allow the viewer to skip the question.","schema":{"type":"boolean"}},{"name":"question_rewindable","in":"query","required":false,"description":"Allow the viewer to rewind from the question.","schema":{"type":"boolean"}},{"name":"question_rewind_time","in":"query","required":false,"description":"Timestamp to rewind to.","schema":{"type":"number","format":"float"}},{"name":"question_use_hint","in":"query","required":false,"description":"Show a question hint.","schema":{"type":"boolean"}},{"name":"question_hint","in":"query","required":false,"description":"Question hint text.","schema":{"type":"string"}},{"name":"question_repeat_until_correct","in":"query","required":false,"description":"Repeat the question until the viewer answers correctly.","schema":{"type":"boolean"}},{"name":"question_case_sensitive","in":"query","required":false,"description":"Free response only. Require an exact case match with a correct answer. Default false (case is ignored).","schema":{"type":"boolean","default":false}},{"name":"question_read_prompt","in":"query","required":false,"description":"Read the prompt aloud.","schema":{"type":"boolean"}},{"name":"question_read_answers","in":"query","required":false,"description":"Read the answer choices aloud.","schema":{"type":"boolean"}},{"name":"question_voice_number","in":"query","required":false,"description":"Voice number for read-aloud question audio.","schema":{"type":"integer"}},{"name":"question_post_message","in":"query","required":false,"description":"Message shown after the question.","schema":{"type":"string"}},{"name":"question_allow_upload","in":"query","required":false,"description":"Allow upload responses where supported.","schema":{"type":"boolean"}},{"name":"question_has_correct_answer","in":"query","required":false,"description":"Whether this question has one or more correct answers.","schema":{"type":"boolean"}},{"name":"question_min_length","in":"query","required":false,"description":"Minimum answer length.","schema":{"type":"integer"}},{"name":"question_max_length","in":"query","required":false,"description":"Maximum answer length.","schema":{"type":"integer"}},{"name":"question_min_value","in":"query","required":false,"description":"Minimum numeric answer value.","schema":{"type":"integer"}},{"name":"question_max_value","in":"query","required":false,"description":"Maximum numeric answer value.","schema":{"type":"integer"}},{"name":"question_correct_action","in":"query","required":false,"description":"Action to run after a correct answer.","schema":{"type":"string","enum":["track","reply","message","jump","link","video","back","email","phone","clip","audio","download","article","view","none"]}},{"name":"question_correct_value","in":"query","required":false,"description":"Action value for a correct answer.","schema":{"type":"string"}},{"name":"question_correct_arg","in":"query","required":false,"description":"Action argument for a correct answer.","schema":{"type":"string"}},{"name":"question_incorrect_action","in":"query","required":false,"description":"Action to run after an incorrect answer.","schema":{"type":"string","enum":["track","reply","message","jump","link","video","back","email","phone","clip","audio","download","article","view","none"]}},{"name":"question_incorrect_value","in":"query","required":false,"description":"Action value for an incorrect answer.","schema":{"type":"string"}},{"name":"question_incorrect_arg","in":"query","required":false,"description":"Action argument for an incorrect answer.","schema":{"type":"string"}},{"name":"internal_label","in":"query","required":false,"description":"Internal label for organization use.","schema":{"type":"string"}},{"name":"hidden","in":"query","required":false,"description":"Hide this question by default.","schema":{"type":"boolean"}},{"name":"hide_mobile","in":"query","required":false,"description":"Hide this question on mobile devices.","schema":{"type":"boolean"}},{"name":"hide_desktop","in":"query","required":false,"description":"Hide this question on desktop devices.","schema":{"type":"boolean"}},{"name":"variable","in":"query","required":false,"description":"Variable name to set from the question.","schema":{"type":"string"}},{"name":"value","in":"query","required":false,"description":"Variable value to set from the question.","schema":{"type":"string"}},{"name":"is_conditional","in":"query","required":false,"description":"Enable conditional display logic.","schema":{"type":"boolean"}},{"name":"conditional_show","in":"query","required":false,"description":"Show the question when the condition matches.","schema":{"type":"boolean"}},{"name":"conditional_variable","in":"query","required":false,"description":"Conditional variable name.","schema":{"type":"string"}},{"name":"conditional_assertion","in":"query","required":false,"description":"Conditional comparison operator.","schema":{"type":"string"}},{"name":"conditional_value","in":"query","required":false,"description":"Conditional comparison value.","schema":{"type":"string"}},{"name":"conditional_operator","in":"query","required":false,"description":"Operator used when combining two conditions.","schema":{"type":"integer"}},{"name":"is_conditional_2","in":"query","required":false,"description":"Enable a second conditional rule.","schema":{"type":"boolean"}},{"name":"conditional_variable_2","in":"query","required":false,"description":"Second conditional variable name.","schema":{"type":"string"}},{"name":"conditional_assertion_2","in":"query","required":false,"description":"Second conditional comparison operator.","schema":{"type":"string"}},{"name":"conditional_value_2","in":"query","required":false,"description":"Second conditional comparison value.","schema":{"type":"string"}},{"name":"question_map_hubspot","in":"query","required":false,"description":"Map question response to HubSpot.","schema":{"type":"boolean"}},{"name":"hubspot_field","in":"query","required":false,"description":"HubSpot field name.","schema":{"type":"string"}},{"name":"hubspot_value","in":"query","required":false,"description":"HubSpot field value.","schema":{"type":"string"}},{"name":"clickfunnels_active","in":"query","required":false,"description":"Enable ClickFunnels integration.","schema":{"type":"boolean"}},{"name":"clickfunnels_tag","in":"query","required":false,"description":"ClickFunnels tag.","schema":{"type":"string"}},{"name":"clickfunnels_custom_attribute_name","in":"query","required":false,"description":"ClickFunnels custom attribute name.","schema":{"type":"string"}},{"name":"clickfunnels_custom_attribute_value","in":"query","required":false,"description":"ClickFunnels custom attribute value.","schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/question"}}}},"401":{"description":"Not Authorized"},"404":{"description":"Not Found"},"422":{"description":"Unprocessable Entity"},"500":{"description":"Error"},"503":{"description":"Rate Limit Exceeded"}},"x-codeSamples":[{"lang":"curl","label":"cURL","source":"curl --request PATCH \\\n  --url https://api.mindstamp.com/api/v1/interactions/question/{id} \\\n  --header 'Authorization: Bearer <access_token>' \\\n  --form 'prompt=Updated question prompt' \\\n  --form 'answers=red;green'"},{"lang":"curl","label":"Update question settings","source":"curl --request PATCH \\\n  --url https://api.mindstamp.com/api/v1/interactions/question/{id} \\\n  --header 'Authorization: Bearer <access_token>' \\\n  --form 'question_use_time_limit=true' \\\n  --form 'timer=20' \\\n  --form 'question_skippable=false' \\\n  --form 'question_repeat_until_correct=true' \\\n  --form 'question_correct_action=jump' \\\n  --form 'question_correct_value=90' \\\n  --form 'question_incorrect_action=message' \\\n  --form 'question_incorrect_value=Please try again'"}],"operationId":"patch_interactions-question-id"},"delete":{"tags":["Interactions"],"summary":"Delete a question","description":"Delete an existing question interaction. Use the id returned by the question create endpoint.","parameters":[{"name":"id","in":"path","required":true,"description":"The question interaction ID returned from question create.","schema":{"type":"string"}}],"responses":{"200":{"description":"Question deleted","content":{"application/json":{"schema":{"$ref":"#/components/schemas/question_delete_response"}}}},"401":{"description":"Not Authorized"},"404":{"description":"Not Found"},"422":{"description":"Unprocessable Entity"},"500":{"description":"Error"},"503":{"description":"Rate Limit Exceeded"}},"x-codeSamples":[{"lang":"curl","label":"cURL","source":"curl --request DELETE \\\n  --url https://api.mindstamp.com/api/v1/interactions/question/{id} \\\n  --header 'Authorization: Bearer <access_token>'"}],"operationId":"delete_interactions-question-id"}},"/designs/account":{"get":{"tags":["Designs"],"summary":"Get account design","description":"Return the organization owner account-level design. API tokens always resolve account design through the organization owner.","parameters":[],"responses":{"200":{"description":"Success","content":{"*/*":{"schema":{"$ref":"#/components/schemas/design"}}}},"401":{"description":"Not 