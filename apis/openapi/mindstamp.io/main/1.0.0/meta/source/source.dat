{"openapi":"3.0.0","info":{"description":"Welcome to the Mindstamp API documentation overview! \n\n As the premium Interactive Video platform, we pride ourselves in providing the best-in-class solution to our customers' needs. In addition to providing a sleek and intuitive interactive video experience, we also provide a comprehensive API that allows our users to retrieve and utilize their Mindstamp data. Mindstamp offers a JSON REST API that provides users the ability to retrieve data for views, viewers, videos, interactions, and users for use in their own applications.","version":"1.0.0","title":"Mindstamp API","termsOfService":"https://mindstamp.com/terms","contact":{"email":"hello@mindstamp.com"}},"tags":[{"name":"Videos","description":"Everything about your videos"},{"name":"Views","description":"Everything about your views"},{"name":"Viewers","description":"Everything about your viewers"},{"name":"Interactions","description":"Everything about your interactions"},{"name":"Groups","description":"Everything about your Groups"},{"name":"Series","description":"Everything about your Series"},{"name":"Personalized Link","description":"Everything about your Personalized Links"},{"name":"Access Lists","description":"Everything about your Access Lists"},{"name":"Users","description":"Users endpoints"},{"name":"Status","description":"Status endpoints"},{"name":"Insights","description":"Everything about your insights"},{"name":"Captions","description":"Everything about your captions"},{"name":"Designs","description":"Everything about your account and video designs"},{"name":"Dubbing","description":"Translate Mindstamp videos, interactions, captions, and transcripts."}],"security":[{"APIKeyHeader":[]},{"bearerAuth":[]},{"oauth2":["public"]}],"paths":{"/views":{"get":{"tags":["Views"],"summary":"Get a list of views","description":"Return details pertaining to all views associated with your account/organization.","parameters":[{"name":"start","in":"query","required":false,"description":"The lower bound of when the views were captured (DD/MM/YYYY).","schema":{"type":"string"}},{"name":"finish","in":"query","required":false,"description":"The upper bound of when the views were captured (DD/MM/YYYY).","schema":{"type":"string"}},{"name":"timezone","in":"query","required":false,"description":"The timezone for the start and finish parameters. Default is UTC. Find more timezones [here](https://help.mindstamp.com/en/article/what-timezones-are-available-on-the-mindstamp-api-r2bwd0/?bust=1698087946225).","schema":{"type":"string"}},{"name":"video_id","in":"query","required":false,"schema":{"type":"string"}},{"name":"group_id","in":"query","required":false,"schema":{"type":"string"}},{"name":"series_id","in":"query","required":false,"schema":{"type":"string"}},{"name":"is_lead","in":"query","required":false,"schema":{"type":"boolean"}},{"name":"viewer_name","in":"query","required":false,"schema":{"type":"string"}},{"name":"viewer_email","in":"query","required":false,"schema":{"type":"string"}},{"name":"viewer_phone","in":"query","required":false,"schema":{"type":"string"}},{"name":"viewer_custom_id","in":"query","required":false,"schema":{"type":"string"}},{"name":"tag1","in":"query","required":false,"schema":{"type":"string"}},{"name":"tag2","in":"query","required":false,"schema":{"type":"string"}},{"name":"tag3","in":"query","required":false,"schema":{"type":"string"}},{"name":"tag4","in":"query","required":false,"schema":{"type":"string"}},{"name":"tag5","in":"query","required":false,"schema":{"type":"string"}},{"name":"tags","in":"query","required":false,"schema":{"type":"string"},"description":"Comma-separated video tags to filter views by."}],"responses":{"200":{"description":"Success","content":{"*/*":{"schema":{"$ref":"#/components/schemas/views"}}}},"401":{"description":"Not Authorized"},"404":{"description":"Not Found"},"422":{"description":"Unprocessable Entity"},"500":{"description":"Error"},"503":{"description":"Rate Limit Exceeded"}},"operationId":"get_views"}},"/views/{id}":{"get":{"tags":["Views"],"summary":"Get a single view","description":"Return details pertaining to a specific view associated with a view ID.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"*/*":{"schema":{"$ref":"#/components/schemas/view"}}}},"401":{"description":"Not Authorized"},"404":{"description":"Not Found"},"422":{"description":"Unprocessable Entity"},"500":{"description":"Error"},"503":{"description":"Rate Limit Exceeded"}},"operationId":"get_views-id"}},"/views/{id}/interactions":{"get":{"tags":["Views"],"summary":"Get interactions for a single view","description":"Return details pertaining to all interactions associated with a view ID.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"*/*":{"schema":{"$ref":"#/components/schemas/interactions"}}}},"401":{"description":"Not Authorized"},"404":{"description":"Not Found"},"422":{"description":"Unprocessable Entity"},"500":{"description":"Error"},"503":{"description":"Rate Limit Exceeded"}},"operationId":"get_views-id-interactions"}},"/interactions":{"get":{"tags":["Interactions"],"summary":"Get all interactions","description":"Return details pertaining to all interactions associated with your account/organization.","parameters":[{"name":"offset","in":"query","required":false,"schema":{"type":"string"}},{"name":"id","in":"query","required":false,"schema":{"type":"string"}},{"name":"type","in":"query","required":false,"schema":{"type":"string"}},{"name":"viewer_name","in":"query","required":false,"schema":{"type":"string"}},{"name":"viewer_email","in":"query","required":false,"schema":{"type":"string"}},{"name":"viewer_phone","in":"query","required":false,"schema":{"type":"string"}},{"name":"viewer_custom_id","in":"query","required":false,"schema":{"type":"string"}},{"name":"is_lead","in":"query","required":false,"schema":{"type":"boolean"}},{"name":"start","in":"query","required":false,"description":"The lower bound of when the interactions were captured (DD/MM/YYYY).","schema":{"type":"string"}},{"name":"finish","in":"query","required":false,"description":"The upper bound of when the interactions were captured (DD/MM/YYYY).","schema":{"type":"string"}},{"name":"timezone","in":"query","required":false,"description":"The timezone for the start and finish parameters. Default is UTC. Find more timezones [here](https://help.mindstamp.com/en/article/what-timezones-are-available-on-the-mindstamp-api-r2bwd0/?bust=1698087946225).","schema":{"type":"string"}},{"name":"video_id","in":"query","required":false,"schema":{"type":"string"},"description":"Filter interactions by video ID."},{"name":"group_id","in":"query","required":false,"schema":{"type":"string"},"description":"Filter interactions by group ID."},{"name":"series_id","in":"query","required":false,"schema":{"type":"string"},"description":"Filter interactions by series ID."},{"name":"tags","in":"query","required":false,"schema":{"type":"string"},"description":"Comma-separated video tags to filter interactions by."}],"responses":{"200":{"description":"Success","content":{"*/*":{"schema":{"$ref":"#/components/schemas/interactions"}}}},"401":{"description":"Not Authorized"},"404":{"description":"Not Found"},"422":{"description":"Unprocessable Entity"},"500":{"description":"Error"},"503":{"description":"Rate Limit Exceeded"}},"operationId":"get_interactions"}},"/interactions/{id}":{"get":{"tags":["Interactions"],"summary":"Get a single interaction","description":"Return details pertaining to a specific interaction associated with an ID.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"*/*":{"schema":{"$ref":"#/components/schemas/interaction"}}}},"401":{"description":"Not Authorized"},"404":{"description":"Not Found"},"422":{"description":"Unprocessable Entity"},"500":{"description":"Error"},"503":{"description":"Rate Limit Exceeded"}},"operationId":"get_interactions-id"},"patch":{"tags":["Interactions"],"summary":"Update an interaction","description":"Update an existing API-created annotation. Supports visible interaction annotations and timed action annotations created by POST /interactions/create. This uses the annotation ID returned by create.","parameters":[{"name":"id","in":"path","required":true,"description":"The annotation ID for the interaction.","schema":{"type":"string"}},{"name":"type","in":"query","required":false,"description":"Annotation type. Visible types require layout and click action fields. Timed action types use their type-specific fields. Supported values: button, image, text, hotspot, redirect, jump, switch, pause, resourceTray, variable, reset_viewer, reset_interactions.","schema":{"type":"string","enum":["button","image","text","hotspot","redirect","jump","switch","pause","resourceTray","variable","reset_viewer","reset_interactions"]}},{"name":"time","in":"query","required":false,"description":"When the interaction should appear on the screen","schema":{"type":"number","format":"float"}},{"name":"finish","in":"query","required":false,"description":"When a visible interaction should leave the screen. Optional for timed action annotations.","schema":{"type":"number","format":"float"}},{"name":"top","in":"query","required":false,"schema":{"type":"number","format":"float"},"description":"Visible interaction layout percentage persisted to pos_top. Required for button, image, text, and hotspot creates."},{"name":"left","in":"query","required":false,"schema":{"type":"number","format":"float"},"description":"Visible interaction layout percentage persisted to pos_left. Required for button, image, text, and hotspot creates."},{"name":"height","in":"query","required":false,"schema":{"type":"number","format":"float"},"description":"Visible interaction layout percentage persisted to pos_height. Required for button, image, text, and hotspot creates."},{"name":"width","in":"query","required":false,"schema":{"type":"number","format":"float"},"description":"Visible interaction layout percentage persisted to pos_width. Required for button, image, text, and hotspot creates."},{"name":"click_action","in":"query","required":false,"description":"Visible interaction click action. Required for button, image, text, and hotspot creates. Supported values: track, link, jump, video, back, message, view, genie, cart, openai, clip, audio, email, phone, modal, collect, download, resourceTray, show_card, get, post, redirect, pause, article, copy, none. Timed action annotations choose the matching action automatically.","schema":{"type":"string","enum":["track","link","jump","video","back","message","view","genie","cart","openai","clip","audio","email","phone","modal","collect","download","resourceTray","show_card","get","post","redirect","pause","article","copy","none"]}},{"name":"click_value","in":"query","required":false,"description":"Action value. For redirect this can be the URL; for jump this can be the target timestamp; for switch this can be `Video Title ---TOKEN`.","schema":{"type":"string"}},{"name":"content","in":"query","required":false,"description":"A button text, text content, image source URL, or empty for hotspot","schema":{"type":"string"}},{"name":"tooltip","in":"query","required":false,"description":"Tooltip text shown when hovering over the interaction.","schema":{"type":"string"}},{"name":"pause_amount","in":"query","required":false,"schema":{"type":"integer"},"description":"Pause duration in seconds for type=pause or visible interactions that pause on click. Use -1 to pause until the viewer resumes."},{"name":"click_required","in":"query","required":false,"schema":{"type":"boolean"}},{"name":"text_color","in":"query","required":false,"schema":{"type":"string"},"description":"Visible interaction text color. Defaults to the video design when omitted."},{"name":"background_color","in":"query","required":false,"schema":{"type":"string"},"description":"Visible interaction background color. Defaults to the video design when omitted."},{"name":"border_color","in":"query","required":false,"description":"Visible interaction border color. Defaults to the video design when omitted.","schema":{"type":"string"}},{"name":"border_radius","in":"query","required":false,"description":"Visible interaction border radius. Defaults to the video design when omitted.","schema":{"type":"string"}},{"name":"font_size","in":"query","required":false,"schema":{"type":"string"},"description":"Visible interaction font size persisted to font_size."},{"name":"redirect_url","in":"query","required":false,"description":"Redirect destination URL for type=redirect. Alias for click_value on redirect annotations.","schema":{"type":"string"}},{"name":"target_time","in":"query","required":false,"description":"Target timestamp in seconds for type=jump. Alias for click_value on jump annotations.","schema":{"type":"number","format":"float"}},{"name":"target_video_id","in":"query","required":false,"description":"Target video ID for type=switch. The API stores it as `Video Title ---TOKEN` in click_value.","schema":{"type":"string"}},{"name":"target_video_token","in":"query","required":false,"description":"Target video token for type=switch. The API stores it as `Video Title ---TOKEN` in click_value.","schema":{"type":"string"}},{"name":"click_time","in":"query","required":false,"description":"Start time in the target video for type=switch.","schema":{"type":"number","format":"float"}},{"name":"timer","in":"query","required":false,"description":"Pause duration in seconds for type=pause. Use -1 to pause until the viewer resumes. Alias for pause_amount.","schema":{"type":"integer"}},{"name":"variable","in":"query","required":false,"description":"Variable name for type=variable.","schema":{"type":"string"}},{"name":"value","in":"query","required":false,"description":"Variable value for type=variable.","schema":{"type":"string"}},{"name":"tooltip_text","in":"query","required":false,"description":"Tooltip text shown when hovering over the interaction.","schema":{"type":"string"}},{"name":"pause","in":"query","required":false,"description":"Whether to pause video playback while this interaction is active.","schema":{"type":"boolean"}},{"name":"must_click","in":"query","required":false,"description":"Alias for click_required. Requires the viewer to click this interaction.","schema":{"type":"boolean"}},{"name":"hidden","in":"query","required":false,"description":"Hide this interaction by default.","schema":{"type":"boolean"}},{"name":"hide_mobile","in":"query","required":false,"description":"Hide this interaction on mobile devices.","schema":{"type":"boolean"}},{"name":"hide_desktop","in":"query","required":false,"description":"Hide this interaction on desktop devices.","schema":{"type":"boolean"}},{"name":"border_width","in":"query","required":false,"description":"Interaction border width.","schema":{"type":"string"}},{"name":"text_align","in":"query","required":false,"description":"Interaction text alignment.","schema":{"type":"string"}},{"name":"transition","in":"query","required":false,"description":"Interaction entrance transition.","schema":{"type":"string"}},{"name":"animation","in":"query","required":false,"description":"Interaction animation.","schema":{"type":"string"}},{"name":"caption","in":"query","required":false,"description":"Caption for image and hotspot interactions.","schema":{"type":"string"}},{"name":"show_caption","in":"query","required":false,"description":"Whether to show the caption for image and hotspot interactions.","schema":{"type":"boolean"}},{"name":"background_image","in":"query","required":false,"description":"Hotspot background image URL.","schema":{"type":"string"}},{"name":"points","in":"query","required":false,"description":"Hotspot polygon points as a JSON string or persisted string value.","schema":{"type":"string"}},{"name":"hotspot_show_ring","in":"query","required":false,"description":"Whether to show the hotspot ring.","schema":{"type":"boolean"}},{"name":"hotspot_ring_width","in":"query","required":false,"description":"Hotspot ring width.","schema":{"type":"integer"}},{"name":"hotspot_alignment","in":"query","required":false,"description":"Hotspot alignment value.","schema":{"type":"integer"}},{"name":"hotspot_radius","in":"query","required":false,"description":"Hotspot radius.","schema":{"type":"integer"}},{"name":"hotspot_hover","in":"query","required":false,"description":"Whether to enable hotspot hover behavior.","schema":{"type":"boolean"}},{"name":"force_lead_capture","in":"query","required":false,"description":"Require lead capture before running the interaction action.","schema":{"type":"boolean"}},{"name":"do_spotlight","in":"query","required":false,"description":"Spotlight the interaction.","schema":{"type":"boolean"}},{"name":"post_click_state","in":"query","required":false,"description":"Post-click state for the interaction.","schema":{"type":"string"}},{"name":"post_click_color","in":"query","required":false,"description":"Post-click background color.","schema":{"type":"string"}},{"name":"post_click_text_color","in":"query","required":false,"description":"Post-click text color.","schema":{"type":"string"}},{"name":"internal_label","in":"query","required":false,"description":"Internal label for organization use.","schema":{"type":"string"}},{"name":"is_conditional","in":"query","required":false,"description":"Enable conditional display logic.","schema":{"type":"boolean"}},{"name":"conditional_show","in":"query","required":false,"description":"Show the interaction when the condition matches.","schema":{"type":"boolean"}},{"name":"conditional_variable","in":"query","required":false,"description":"Conditional variable name.","schema":{"type":"string"}},{"name":"conditional_assertion","in":"query","required":false,"description":"Conditional comparison operator.","schema":{"type":"string"}},{"name":"conditional_value","in":"query","required":false,"description":"Conditional comparison value.","schema":{"type":"string"}},{"name":"conditional_operator","in":"query","required":false,"description":"Operator used when combining two conditions.","schema":{"type":"integer"}},{"name":"is_conditional_2","in":"query","required":false,"description":"Enable a second conditional rule.","schema":{"type":"boolean"}},{"name":"conditional_variable_2","in":"query","required":false,"description":"Second conditional variable name.","schema":{"type":"string"}},{"name":"conditional_assertion_2","in":"query","required":false,"description":"Second conditional comparison operator.","schema":{"type":"string"}},{"name":"conditional_value_2","in":"query","required":false,"description":"Second conditional comparison value.","schema":{"type":"string"}},{"name":"tray","in":"query","required":false,"description":"Include the interaction in a tray.","schema":{"type":"boolean"}},{"name":"tray_type","in":"query","required":false,"description":"Tray type, such as magic_menu or end_menu.","schema":{"type":"string"}},{"name":"hubspot_field","in":"query","required":false,"description":"HubSpot field name.","schema":{"type":"string"}},{"name":"hubspot_value","in":"query","required":false,"description":"HubSpot field value.","schema":{"type":"string"}},{"name":"question_map_hubspot","in":"query","required":false,"description":"Map the interaction value to HubSpot.","schema":{"type":"boolean"}},{"name":"clickfunnels_active","in":"query","required":false,"description":"Enable ClickFunnels integration.","schema":{"type":"boolean"}},{"name":"clickfunnels_tag","in":"query","required":false,"description":"ClickFunnels tag.","schema":{"type":"string"}},{"name":"clickfunnels_custom_attribute_name","in":"query","required":false,"description":"ClickFunnels custom attribute name.","schema":{"type":"string"}},{"name":"clickfunnels_custom_attribute_value","in":"query","required":false,"description":"ClickFunnels custom attribute value.","schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"*/*":{"schema":{"$ref":"#/components/schemas/annotation"}}}},"401":{"description":"Not Authorized"},"404":{"description":"Not Found"},"422":{"description":"Unprocessable Entity","content":{"*/*":{"schema":{"$ref":"#/components/schemas/api_error"}}}},"500":{"description":"Error"},"503":{"description":"Rate Limit Exceeded"}},"x-codeSamples":[{"lang":"curl","label":"Update interaction","source":"curl --request PATCH \\\n  --url https://api.mindstamp.com/api/v1/interactions/{id} \\\n  --header 'Authorization: Bearer <access_token>' \\\n  --form 'time=18' \\\n  --form 'tooltip=Updated hover text' \\\n  --form 'redirect_url=https://example.com/updated'"},{"lang":"curl","label":"Update interaction visibility and logic","source":"curl --request PATCH \\\n  --url https://api.mindstamp.com/api/v1/interactions/{id} \\\n  --header 'Authorization: Bearer <access_token>' \\\n  --form 'hidden=false' \\\n  --form 'hide_mobile=true' \\\n  --form 'must_click=true' \\\n  --form 'do_spotlight=true' \\\n  --form 'is_conditional=true' \\\n  --form 'conditional_variable=plan' \\\n  --form 'conditional_assertion=equals' \\\n  --form 'conditional_value=pro'"}],"operationId":"patch_interactions-id"}},"/interactions/{id}/responses":{"get":{"tags":["Interactions"],"summary":"Get the responses to a single interaction","description":"Return response details pertaining to a specific interaction associated with an ID.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"*/*":{"schema":{"$ref":"#/components/schemas/interactions"}}}},"401":{"description":"Not Authorized"},"404":{"description":"Not Found"},"422":{"description":"Unprocessable Entity"},"500":{"description":"Error"},"503":{"description":"Rate Limit Exceeded"}},"operationId":"get_interactions-id-responses"}},"/interactions/create":{"post":{"tags":["Interactions"],"summary":"Create an interaction","description":"Create a new annotation for a specified video. Supports visible interaction annotations (button, image, text, hotspot) and timed action annotations (redirect, jump, switch, pause, resourceTray, variable, reset_viewer, reset_interactions).","parameters":[{"name":"video_id","in":"query","required":true,"description":"The video_id or token of the video you want to add the interaction to.","schema":{"type":"string"}},{"name":"type","in":"query","required":true,"description":"Annotation type. Visible types require layout and click action fields. Timed action types use their type-specific fields. Supported values: button, image, text, hotspot, redirect, jump, switch, pause, resourceTray, variable, reset_viewer, reset_interactions.","schema":{"type":"string","enum":["button","image","text","hotspot","redirect","jump","switch","pause","resourceTray","variable","reset_viewer","reset_interactions"]}},{"name":"time","in":"query","required":true,"description":"When the interaction should appear on the screen","schema":{"type":"number","format":"float"}},{"name":"finish","in":"query","required":false,"description":"When a visible interaction should leave the screen. Optional for timed action annotations.","schema":{"type":"number","format":"float"}},{"name":"top","in":"query","required":false,"schema":{"type":"number","format":"float"},"description":"Visible interaction layout percentage persisted to pos_top. Required for button, image, text, and hotspot creates."},{"name":"left","in":"query","required":false,"schema":{"type":"number","format":"float"},"description":"Visible interaction layout percentage persisted to pos_left. Required for button, image, text, and hotspot creates."},{"name":"height","in":"query","required":false,"schema":{"type":"number","format":"float"},"description":"Visible interaction layout percentage persisted to pos_height. Required for button, image, text, and hotspot creates."},{"name":"width","in":"query","required":false,"schema":{"type":"number","format":"float"},"description":"Visible interaction layout percentage persisted to pos_width. Required for button, image, text, and hotspot creates."},{"name":"click_action","in":"query","required":false,"description":"Visible interaction click action. Required for button, image, text, and hotspot creates. Supported values: track, link, jump, video, back, message, view, genie, cart, openai, clip, audio, email, phone, modal, collect, download, resourceTray, show_card, get, post, redirect, pause, article, copy, none. Timed action annotations choose the matching action automatically.","schema":{"type":"string","enum":["track","link","jump","video","back","message","view","genie","cart","openai","clip","audio","email","phone","modal","collect","download","resourceTray","show_card","get","post","redirect","pause","article","copy","none"]}},{"name":"click_value","in":"query","required":false,"description":"Action value. For redirect this can be the URL; for jump this can be the target timestamp; for switch this can be `Video Title ---TOKEN`.","schema":{"type":"string"}},{"name":"content","in":"query","required":false,"description":"A button's text, a text's content, an image source URL, or empty for hotspot","schema":{"type":"string"}},{"name":"tooltip","in":"query","required":false,"description":"Tooltip text shown when hovering over the interaction.","schema":{"type":"string"}},{"name":"pause_amount","in":"query","required":false,"schema":{"type":"integer"},"description":"Pause duration in seconds for type=pause or visible interactions that pause on click. Use -1 to pause until the viewer resumes."},{"name":"click_required","in":"query","required":false,"schema":{"type":"boolean"}},{"name":"text_color","in":"query","required":false,"schema":{"type":"string"},"description":"Visible interaction text color. Defaults to the video design when omitted."},{"name":"background_color","in":"query","required":false,"schema":{"type":"string"},"description":"Visible interaction background color. Defaults to the video design when omitted."},{"name":"border_color","in":"query","required":false,"description":"Visible interaction border color. Defaults to the video design when omitted.","schema":{"type":"string"}},{"name":"border_radius","in":"query","required":false,"description":"Visible interaction border radius. Defaults to the video design when omitted.","schema":{"type":"string"}},{"name":"font_size","in":"query","required":false,"schema":{"type":"string"},"description":"Visible interaction font size persisted to font_size."},{"name":"redirect_url","in":"query","required":false,"description":"Redirect destination URL for type=redirect. Alias for click_value on redirect annotations.","schema":{"type":"string"}},{"name":"target_time","in":"query","required":false,"description":"Target timestamp in seconds for type=jump. Alias for click_value on jump annotations.","schema":{"type":"number","format":"float"}},{"name":"target_video_id","in":"query","required":false,"description":"Target video ID for type=switch. The API stores it as `Video Title ---TOKEN` in click_value.","schema":{"type":"string"}},{"name":"target_video_token","in":"query","required":false,"description":"Target video token for type=switch. The API stores it as `Video Title ---TOKEN` in click_value.","schema":{"type":"string"}},{"name":"click_time","in":"query","required":false,"description":"Start time in the target video for type=switch.","schema":{"type":"number","format":"float"}},{"name":"timer","in":"query","required":false,"description":"Pause duration in seconds for type=pause. Use -1 to pause until the viewer resumes. Alias for pause_amount.","schema":{"type":"integer"}},{"name":"variable","in":"query","required":false,"description":"Variable name for type=variable.","schema":{"type":"string"}},{"name":"value","in":"query","required":false,"description":"Variable value for type=variable.","schema":{"type":"string"}},{"name":"tooltip_text","in":"query","required":false,"description":"Tooltip text shown when hovering over the interaction.","schema":{"type":"string"}},{"name":"pause","in":"query","required":false,"description":"Whether to pause video playback while this interaction is active.","schema":{"type":"boolean"}},{"name":"must_click","in":"query","required":false,"description":"Alias for click_required. Requires the viewer to click this interaction.","schema":{"type":"boolean"}},{"name":"hidden","in":"query","required":false,"description":"Hide this interaction by default.","schema":{"type":"boolean"}},{"name":"hide_mobile","in":"query","required":false,"description":"Hide this interaction on mobile devices.","schema":{"type":"boolean"}},{"name":"hide_desktop","in":"query","required":false,"description":"Hide this interaction on desktop devices.","schema":{"type":"boolean"}},{"name":"border_width","in":"query","required":false,"description":"Interaction border width.","schema":{"type":"string"}},{"name":"text_align","in":"query","required":false,"description":"Interaction text alignment.","schema":{"type":"string"}},{"name":"transition","in":"query","required":false,"description":"Interaction entrance transition.","schema":{"type":"string"}},{"name":"animation","in":"query","required":false,"description":"Interaction animation.","schema":{"type":"string"}},{"name":"caption","in":"query","required":false,"description":"Caption for image and hotspot interactions.","schema":{"type":"string"}},{"name":"show_caption","in":"query","required":false,"description":"Whether to show the caption for image and hotspot interactions.","schema":{"type":"boolean"}},{"name":"background_image","in":"query","required":false,"description":"Hotspot background image URL.","schema":{"type":"string"}},{"name":"points","in":"query","required":false,"description":"Hotspot polygon points as a 