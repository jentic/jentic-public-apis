            "type": "string",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "nullable": true,
            "description": "Creation timestamp. Null when the source response does not include it."
          },
          "comment_url": {
            "type": "string",
            "nullable": true,
            "format": "uri",
            "description": "Direct comment URL. Null when the source response does not include it."
          },
          "like_count": {
            "type": "number",
