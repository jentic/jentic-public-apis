      "post": {
        "summary": "Create share link",
        "description": "Publish a mosaic behind a link anyone can open. With duplicate set to true the mosaic is copied first, including its renders and media, and the copy is published so the original stays private.",
        "operationId": "createAgentShareLink",
        "tags": [
          "Agents"
        ],
        "parameters": [
          {
            "name": "agent_id",
            "in": "path",
