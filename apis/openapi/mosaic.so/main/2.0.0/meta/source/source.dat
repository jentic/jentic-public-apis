              }
            },
            "required": [
              "connected"
            ]
          }
        ]
      },
      "SocialConnectionDeleteResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "platform": {
            "type": "string",
            "enum": [
              "x",
              "linkedin",
              "instagram",
              "facebook",
              "tiktok",
              "youtube"
            ]
          },
          "social_connection_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
