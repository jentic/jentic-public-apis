    "/agent/{agent_id}/delete": {
      "post": {
        "summary": "Delete an agent",
        "description": "Soft-delete an agent and detach template nodes/connections.",
        "operationId": "deleteAgent",
        "tags": [
          "Agents"
        ],
        "parameters": [
          {
            "name": "agent_id",
            "in": "path",
