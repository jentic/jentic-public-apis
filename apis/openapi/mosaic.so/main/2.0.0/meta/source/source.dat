{
  "openapi": "3.0.3",
  "info": {
    "title": "Mosaic AI API",
    "description": "Professional-grade video editing workflows powered by AI agents",
    "version": "2.0.0",
    "license": {
      "name": "Proprietary",
      "url": "https://mosaic.so"
    },
    "contact": {
      "email": "adish@mosaic.so"
    }
  },
  "servers": [
    {
      "url": "https://api.mosaic.so"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    },
    {
      "apiKeyAuth": []
    }
  ],
  "paths": {
    "/shared-stores": {
      "get": {
        "summary": "List shared stores",
        "description": "List shared stores belonging to the API key's organization.",
        "operationId": "listSharedStores",
        "tags": ["Shared Stores"],
        "security": [{"bearerAuth": []}],
        "responses": {
          "200": {
            "description": "Shared stores",
            "content": {"application/json": {"schema": {"type": "object", "properties": {"stores": {"type": "array", "maxItems": 10, "items": {"$ref": "#/components/schemas/SharedStore"}, "description": "Stores sorted by name ascending."}}, "required": ["stores"], "additionalProperties": false}}}
          },
          "401": {"$ref": "#/components/responses/SharedStoreUnauthorizedError"},
          "403": {"$ref": "#/components/responses/SharedStoreForbiddenError"},
          "500": {"description": "Stores could not be read", "content": {"application/json": {"schema": {"type": "object", "properties": {"error": {"type": "string", "enum": ["Failed to list shared stores"]}}, "required": ["error"], "additionalProperties": false}}}}
        }
      },
      "post": {
        "summary": "Create a shared store",
        "description": "Create an organization-scoped shared store. An organization may have at most 10 shared stores.",
        "operationId": "createSharedStore",
        "tags": ["Shared Stores"],
        "security": [{"bearerAuth": []}],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"type": "object", "properties": {"name": {"type": "string", "minLength": 1, "description": "Store display name."}, "source_type": {"type": "string", "default": "manual", "description": "Caller-defined source label. This is not an enum."}}, "required": ["name"], "additionalProperties": false}}}
        },
        "responses": {
          "200": {"description": "Store created", "content": {"application/json": {"schema": {"type": "object", "properties": {"store": {"$ref": "#/components/schemas/SharedStore"}}, "required": ["store"]}}}},
          "400": {"description": "Store name is missing", "content": {"application/json": {"schema": {"type": "object", "properties": {"error": {"type": "string", "enum": ["name is required"]}}, "required": ["error"], "additionalProperties": false}}}},
          "401": {"$ref": "#/components/responses/SharedStoreUnauthorizedError"},
          "403": {"$ref": "#/components/responses/SharedStoreForbiddenError"},
          "409": {"$ref": "#/components/responses/SharedStoreLimitError"},
          "500": {"description": "Store could not be created", "content": {"application/json": {"schema": {"type": "object", "properties": {"error": {"type": "string", "enum": ["Failed to create shared store"]}}, "required": ["error"], "additionalProperties": false}}}}
        }
      }
    },
    "/shared-stores/{store_id}": {
      "parameters": [{"$ref": "#/components/parameters/SharedStoreId"}],
      "patch": {
        "summary": "Rename a shared store",
        "operationId": "updateSharedStore",
        "tags": ["Shared Stores"],
        "security": [{"bearerAuth": []}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "properties": {"name": {"type": "string", "minLength": 1, "description": "Store display name."}}, "required": ["name"], "additionalProperties": false}}}},
        "responses": {
          "200": {"description": "Store updated", "content": {"application/json": {"schema": {"type": "object", "properties": {"store": {"$ref": "#/components/schemas/SharedStore"}}, "required": ["store"]}}}},
          "400": {"description": "Store name is missing", "content": {"application/json": {"schema": {"type": "object", "properties": {"error": {"type": "string", "enum": ["name is required"]}}, "required": ["error"], "additionalProperties": false}}}},
          "401": {"$ref": "#/components/responses/SharedStoreUnauthorizedError"},
          "403": {"$ref": "#/components/responses/SharedStoreForbiddenError"},
          "404": {"$ref": "#/components/responses/SharedStoreNotFoundError"},
          "500": {"description": "Store could not be updated", "content": {"application/json": {"schema": {"type": "object", "properties": {"error": {"type": "string", "enum": ["Failed to rename shared store"]}}, "required": ["error"], "additionalProperties": false}}}}
        }
      },
      "delete": {
        "summary": "Delete a shared store",
        "description": "Delete a store and all of its entries.",
        "operationId": "deleteSharedStore",
        "tags": ["Shared Stores"],
        "security": [{"bearerAuth": []}],
        "responses": {
          "200": {"description": "Store deleted", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SuccessResponse"}}}},
          "401": {"$ref": "#/components/responses/SharedStoreUnauthorizedError"},
          "403": {"$ref": "#/components/responses/SharedStoreForbiddenError"},
          "404": {"$ref": "#/components/responses/SharedStoreNotFoundError"},
          "500": {"description": "Store could not be deleted", "content": {"application/json": {"schema": {"type": "object", "properties": {"error": {"type": "string", "enum": ["Failed to delete shared store"]}}, "required": ["error"], "additionalProperties": false}}}}
        }
      }
    },
    "/shared-stores/{store_id}/entries": {
      "parameters": [{"$ref": "#/components/parameters/SharedStoreId"}],
      "get": {
        "summary": "List shared store entries",
        "description": "List up to 10,000 entries including JSON metadata.",
        "operationId": "listSharedStoreEntries",
        "tags": ["Shared Stores"],
        "security": [{"bearerAuth": []}],
        "responses": {
          "200": {"description": "Store entries", "content": {"application/json": {"schema": {"type": "object", "properties": {"entries": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/components/schemas/SharedStoreEntry"}, "description": "Entries sorted by display_name ascending."}}, "required": ["entries"], "additionalProperties": false}}}},
          "401": {"$ref": "#/components/responses/SharedStoreUnauthorizedError"},
          "403": {"$ref": "#/components/responses/SharedStoreForbiddenError"},
          "404": {"$ref": "#/components/responses/SharedStoreNotFoundError"},
          "500": {"description": "Entries could not be read", "content": {"application/json": {"schema": {"type": "object", "properties": {"error": {"type": "string", "enum": ["Failed to list shared store entries"]}}, "required": ["error"], "additionalProperties": false}}}}
        }
      }
    },
    "/shared-stores/{store_id}/entries/{entry_id}": {
      "parameters": [
        {"$ref": "#/components/parameters/SharedStoreId"},
        {"$ref": "#/components/parameters/SharedStoreEntryId"}
      ],
      "get": {
        "summary": "Get a shared store entry",
        "operationId": "getSharedStoreEntry",
        "tags": ["Shared Stores"],
        "security": [{"bearerAuth": []}],
        "responses": {
          "200": {"description": "Store entry", "content": {"application/json": {"schema": {"type": "object", "properties": {"entry": {"$ref": "#/components/schemas/SharedStoreEntry"}}, "required": ["entry"]}}}},
          "401": {"$ref": "#/components/responses/SharedStoreUnauthorizedError"},
          "403": {"$ref": "#/components/responses/SharedStoreForbiddenError"},
          "404": {"description": "Store or entry not found", "content": {"application/json": {"schema": {"type": "object", "properties": {"error": {"type": "string", "enum": ["Shared store not found", "Shared store entry not found"]}}, "required": ["error"], "additionalProperties": false}}}},
          "500": {"description": "Entry could not be read", "content": {"application/json": {"schema": {"type": "object", "properties": {"error": {"type": "string", "enum": ["Failed to get shared store entry"]}}, "required": ["error"], "additionalProperties": false}}}}
        }
      },
      "put": {
        "summary": "Create or replace a shared store entry",
        "description": "Idempotently create or replace an entry's display name and metadata. A store may have at most 10,000 entries. Metadata must be a JSON object no larger than 256 KB.",
        "operationId": "putSharedStoreEntry",
        "tags": ["Shared Stores"],
        "security": [{"bearerAuth": []}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SharedStoreEntryWrite"}}}},
        "responses": {
          "200": {"description": "Entry written", "content": {"application/json": {"schema": {"type": "object", "properties": {"entry": {"$ref": "#/components/schemas/SharedStoreEntry"}}, "required": ["entry"]}}}},
          "400": {"description": "Entry fields or metadata are invalid", "content": {"application/json": {"schema": {"oneOf": [{"type": "object", "properties": {"error": {"type": "string", "enum": ["entryId and display_name are required"]}}, "required": ["error"], "additionalProperties": false}, {"type": "object", "properties": {"detail": {"type": "string", "enum": ["metadata must be a JSON object"]}}, "required": ["detail"], "additionalProperties": false}]}}}},
          "401": {"$ref": "#/components/responses/SharedStoreUnauthorizedError"},
          "403": {"$ref": "#/components/responses/SharedStoreForbiddenError"},
          "404": {"$ref": "#/components/responses/SharedStoreNotFoundError"},
          "409": {"$ref": "#/components/responses/SharedStoreEntryLimitError"},
          "413": {"$ref": "#/components/responses/SharedStoreMetadataTooLargeError"},
          "500": {"description": "Entry could not be written", "content": {"application/json": {"schema": {"type": "object", "properties": {"error": {"type": "string", "enum": ["Failed to put shared store entry"]}}, "required": ["error"], "additionalProperties": false}}}}
        }
      },
      "patch": {
        "summary": "Update a shared store entry",
        "description": "Rename an entry and optionally replace its metadata.",
        "operationId": "updateSharedStoreEntry",
        "tags": ["Shared Stores"],
        "security": [{"bearerAuth": []}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "properties": {"entry_id": {"type": "string", "minLength": 1, "description": "New store-scoped entry ID."}, "display_name": {"type": "string", "minLength": 1}, "metadata": {"type": "object", "nullable": true, "additionalProperties": true, "description": "Omit to preserve the current object; null replaces it with an empty object."}}, "required": ["entry_id", "display_name"], "additionalProperties": false}}}},
        "responses": {
          "200": {"description": "Entry updated", "content": {"application/json": {"schema": {"type": "object", "properties": {"entry": {"$ref": "#/components/schemas/SharedStoreEntry"}}, "required": ["entry"]}}}},
          "400": {"description": "Entry fields or metadata are invalid", "content": {"application/json": {"schema": {"oneOf": [{"type": "object", "properties": {"error": {"type": "string", "enum": ["entry_id and display_name are required"]}}, "required": ["error"], "additionalProperties": false}, {"type": "object", "properties": {"detail": {"type": "string", "enum": ["metadata must be a JSON object"]}}, "required": ["detail"], "additionalProperties": false}]}}}},
          "401": {"$ref": "#/components/responses/SharedStoreUnauthorizedError"},
          "403": {"$ref": "#/components/responses/SharedStoreForbiddenError"},
          "404": {"description": "Store or entry not found", "content": {"application/json": {"schema": {"type": "object", "properties": {"error": {"type": "string", "enum": ["Shared store not found", "Shared store entry not found"]}}, "required": ["error"], "additionalProperties": false}}}},
          "409": {"description": "Entry ID is already in use", "content": {"application/json": {"schema": {"type": "object", "properties": {"error": {"type": "string", "enum": ["Entry ID already exists in this shared store"]}}, "required": ["error"], "additionalProperties": false}}}},
          "413": {"$ref": "#/components/responses/SharedStoreMetadataTooLargeError"},
          "500": {"description": "Entry could not be updated", "content": {"application/json": {"schema": {"type": "object", "properties": {"error": {"type": "string", "enum": ["Failed to rename shared store entry"]}}, "required": ["error"], "additionalProperties": false}}}}
        }
      },
      "delete": {
        "summary": "Delete a shared store entry",
        "operationId": "deleteSharedStoreEntry",
        "tags": ["Shared Stores"],
        "security": [{"bearerAuth": []}],
        "responses": {
          "200": {"description": "Entry deleted", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SuccessResponse"}}}},
          "401": {"$ref": "#/components/responses/SharedStoreUnauthorizedError"},
          "403": {"$ref": "#/components/responses/SharedStoreForbiddenError"},
          "404": {"description": "Store or entry not found", "content": {"application/json": {"schema": {"type": "object", "properties": {"error": {"type": "string", "enum": ["Shared store not found", "Shared store entry not found"]}}, "required": ["error"], "additionalProperties": false}}}},
          "500": {"description": "Entry could not be deleted", "content": {"application/json": {"schema": {"type": "object", "properties": {"error": {"type": "string", "enum": ["Failed to delete shared store entry"]}}, "required": ["error"], "additionalProperties": false}}}}
        }
      }
    },
    "/shared-stores/{store_id}/entries/bulk": {
      "parameters": [{"$ref": "#/components/parameters/SharedStoreId"}],
      "post": {
        "summary": "Bulk upsert shared store entries",
        "description": "Upsert between 1 and 5,000 entries without taking the store beyond 10,000 total entries. If an entry ID occurs more than once, its last occurrence wins.",
        "operationId": "bulkUpsertSharedStoreEntries",
        "tags": ["Shared Stores"],
        "security": [{"bearerAuth": []}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "properties": {"entries": {"type": "array", "minItems": 1, "maxItems": 5000, "items": {"allOf": [{"$ref": "#/components/schemas/SharedStoreEntryWrite"}, {"type": "object", "properties": {"entry_id": {"type": "string", "minLength": 1}}, "required": ["entry_id"]}]}}}, "required": ["entries"]}}}},
        "responses": {
          "200": {"description": "Entries written", "content": {"application/json": {"schema": {"type": "object", "properties": {"success": {"type": "boolean", "enum": [true]}, "count": {"type": "integer", "minimum": 1, "maximum": 5000, "description": "Number of unique entry IDs written."}, "entries": {"type": "array", "minItems": 1, "maxItems": 5000, "items": {"$ref": "#/components/schemas/SharedStoreEntry"}, "description": "Written entries. Array ordering is not an API contract."}}, "required": ["success", "count", "entries"], "additionalProperties": false}}}},
          "400": {"description": "Entry list or metadata is invalid", "content": {"application/json": {"schema": {"oneOf": [{"type": "object", "properties": {"error": {"type": "string", "enum": ["entries is required", "entries must include entry_id and display_name"]}}, "required": ["error"], "additionalProperties": false}, {"type": "object", "properties": {"detail": {"type": "string", "enum": ["metadata must be a JSON object"]}}, "required": ["detail"], "additionalProperties": false}]}}}},
          "401": {"$ref": "#/components/responses/SharedStoreUnauthorizedError"},
          "403": {"$ref": "#/components/responses/SharedStoreForbiddenError"},
          "404": {"$ref": "#/components/responses/SharedStoreNotFoundError"},
          "409": {"$ref": "#/components/responses/SharedStoreEntryLimitError"},
          "413": {"description": "Bulk request or metadata is too large", "content": {"application/json": {"schema": {"oneOf": [{"type": "object", "properties": {"error": {"type": "string", "enum": ["A bulk request may contain at most 5000 entries"]}}, "required": ["error"], "additionalProperties": false}, {"type": "object", "properties": {"detail": {"type": "string", "enum": ["metadata must be 256 KB or smaller"]}}, "required": ["detail"], "additionalProperties": false}]}}}},
          "500": {"description": "Entries could not be written", "content": {"application/json": {"schema": {"type": "object", "properties": {"error": {"type": "string", "enum": ["Failed to upsert shared store entries"]}}, "required": ["error"], "additionalProperties": false}}}}
        }
      }
    },
    "/whoami": {
      "get": {
        "summary": "Get current user info",
        "description": "Get information about the current user based on the API key.",
        "operationId": "whoAmI",
        "tags": [
          "Auth"
        ],
        "responses": {
          "200": {
            "description": "User information retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/agents": {
      "get": {
        "summary": "List agents",
        "description": "List agents in the API key's organization with optional workspace and case-insensitive name filtering.",
        "operationId": "listAgents",
        "tags": [
          "Agents"
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Number of agents to return.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Pagination cursor returned as next_cursor by the previous response. Keep the same filters when requesting the next page.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "workspace_id",
            "in": "query",
            "required": false,
            "description": "Return agents from this workspace. The workspace must belong to the API key's organization.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "name",
            "in": "query",
            "required": false,
            "description": "Case-insensitive substring search on agent names. Percent and underscore characters are treated literally.",
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Agents retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentListResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          }
        }
      }
    },
    "/agent/create": {
      "post": {
        "summary": "Create an agent",
        "description": "Create an agent template (metadata only). Graph mutations are handled via /agent/{agent_id}/update.",
        "operationId": "createAgent",
        "tags": [
          "Agents"
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 5000
                  },
                  "visibility": {
                    "type": "string",
                    "enum": [
                      "public",
                      "private"
                    ]
                  },
                  "workspace_id": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Agent created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentMutationResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          }
        }
      }
    },
    "/avatar-profiles": {
      "get": {
        "summary": "Get avatars",
        "description": "List reusable AI Avatars from the organization's primary workspace.",
        "operationId": "listAvatarProfiles",
        "tags": [
          "Avatar Profiles"
        ],
        "responses": {
          "200": {
            "description": "Avatar profiles",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "avatar_profiles": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/AvatarProfile"
                      }
                    }
                  },
                  "required": [
                    "avatar_profiles"
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          }
        }
      }
    },
    "/avatar-profiles/create": {
      "post": {
        "summary": "Create avatar",
        "description": "Create a reusable AI Avatar in the organization's primary workspace. Provide either a video source or an image plus audio source. Sources should represent one person only, with clean single-speaker audio from that person. URL sources are stored as Mosaic asset records.",
        "operationId": "createAvatarProfile",
        "tags": [
          "Avatar Profiles"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "sources": {
                    "type": "object",
                    "description": "Avatar source media. Required: either video_url/video_id, or image_url/image_id plus audio_url/audio_id. Use one visible person and clean single-speaker audio from that same person.",
                    "properties": {
                      "video_url": {
                        "type": "string",
                        "format": "uri",
                        "nullable": true,
                        "description": "4-15 second source video URL. Should show one person and contain clean single-speaker audio from that person."
                      },
                      "audio_url": {
                        "type": "string",
                        "format": "uri",
                        "nullable": true,
                        "description": "4-15 second voice reference audio URL. Should contain clean single-speaker speech from the same person shown in the image."
                      },
                      "image_url": {
                        "type": "string",
                        "format": "uri",
                        "nullable": true,
                        "description": "Character image URL. Should show one person only."
                      },
                      "video_id": {
                        "type": "string",
                        "format": "uuid",
                        "nullable": true,
                        "description": "Existing video asset ID. Should follow the same one-person, clear-audio guidance."
                      },
                      "audio_id": {
                        "type": "string",
                        "format": "uuid",
                        "nullable": true,
                        "description": "Existing audio asset ID. Should contain clean single-speaker speech."
                      },
                      "image_id": {
                        "type": "string",
                        "format": "uuid",
                        "nullable": true,
                        "description": "Existing image asset ID. Should show one person only."
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "required": [
                  "name",
                  "sources"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Avatar profile created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid",
                      "description": "Avatar profile ID. Pass this as avatar_profile_id in an AI Avatar tile."
                    },
                    "video_preview_url": {
                      "type": "string",
                      "format": "uri",
                      "nullable": true,
                      "description": "Signed video preview URL. Null until a preview/reference video is available."
                    },
                    "name": {
                      "type": "string",
                      "description": "Avatar display name."
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "pending",
                        "processing",
                        "ready",
                        "failed"
                      ],
                      "description": "Avatar processing state. Ready means fully prepared; pending/processing can be used while the run waits; failed cannot be used."
                    },
                    "status_message": {
                      "type": "string",
                      "nullable": true,
                      "description": "Error message when status is failed; otherwise null."
                    }
                  },
                  "required": [
                    "id",
                    "video_preview_url",
                    "name",
                    "status",
                    "status_message"
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "409": {
            "$ref": "#/components/responses/ConflictError"
          }
        }
      }
    },
    "/avatar-profiles/{id}": {
      "get": {
        "summary": "Get avatar",
        "description": "Return one AI Avatar, including processing status and reference URLs when available.",
        "operationId": "getAvatarProfile",
        "tags": [
          "Avatar Profiles"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Avatar profile",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid",
                      "description": "Avatar profile ID. Pass this as avatar_profile_id in an AI Avatar tile."
                    },
                    "video_preview_url": {
                      "type": "string",
                      "format": "uri",
                      "nullable": true,
                      "description": "Signed video preview URL. Null until a preview/reference video is available."
                    },
                    "name": {
                      "type": "string",
                      "description": "Avatar display name."
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "pending",
                        "processing",
                        "ready",
                        "failed"
                      ],
                      "description": "Avatar processing state. Ready means fully prepared; pending/processing can be used while the run waits; failed cannot be used."
                    },
                    "status_message": {
                      "type": "string",
                      "nullable": true,
                      "description": "Error message when status is failed; otherwise null."
                    }
                  },
                  "required": [
                    "id",
                    "video_preview_url",
                    "name",
                    "status",
                    "status_message"
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          }
        }
      }
    },
    "/agent/{agent_id}/update": {
      "post": {
        "summary": "Update an agent",
        "description": "Update agent metadata and/or apply ordered graph operations.",
        "operationId": "updateAgent",
        "tags": [
          "Agents"
        ],
        "parameters": [
          {
            "name": "agent_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 5000
                  },
                  "visibility": {
                    "type": "string",
                    "enum": [
                      "public",
                      "private"
                    ]
                  },
                  "operations": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "op": {
                              "type": "string",
                              "enum": [
                                "create_node"
                              ]
                            },
                            "temp_ref_id": {
                              "type": "string",
                              "description": "Temporary request-scoped node reference for linking operations in the same payload. Not persisted."
                            },
                            "node_type_id": {
                              "type": "string",
                              "format": "uuid"
                            },
                            "params_used": {
                              "type": "object",
                              "additionalProperties": true
                            }
                          },
                          "required": [
                            "op",
                            "node_type_id"
                          ]
                        },
                        {
                          "type": "object",
                          "properties": {
                            "op": {
                              "type": "string",
                              "enum": [
                                "update_node"
                              ]
                            },
                            "agent_node_id": {
                              "type": "string",
                              "format": "uuid"
                            },
                            "params_used": {
                              "type": "object",
                              "additionalProperties": true
                            }
                          },
                          "required": [
                            "op",
                            "agent_node_id",
                            "params_used"
                          ]
                        },
                        {
                          "type": "object",
                          "properties": {
                            "op": {
                              "type": "string",
                              "enum": [
                                "delete_node"
                              ]
                            },
                            "agent_node_id": {
                              "type": "string",
                              "format": "uuid"
                            }
                          },
                          "required": [
                            "op",
                            "agent_node_id"
                          ]
                        },
                        {
                          "type": "object",
                          "description": "Provide exactly one source reference and exactly one target reference.",
                          "properties": {
                            "op": {
                              "type": "string",
                              "enum": [
                                "create_connection"
                              ]
                            },
                            "source_agent_node_id": {
                              "type": "string",
                              "format": "uuid",
                              "description": "Source existing node identifier."
                            },
                            "source_temp_ref_id": {
                              "type": "string",
                              "description": "Source temp reference from an earlier create_node operation in the same request; must already exist."
                            },
                            "target_agent_node_id": {
                              "type": "string",
                              "format": "uuid",
                              "description": "Target existing node identifier."
                            },
                            "target_temp_ref_id": {
                              "type": "string",
                              "description": "Target temp reference from an earlier create_node operation in the same request; must already exist."
                            }
                          },
                          "required": [
                            "op"
                          ]
                        },
                        {
                          "type": "object",
                          "description": "Provide exactly one source reference and exactly one target reference.",
                          "properties": {
                            "op": {
                              "type": "string",
                              "enum": [
                                "delete_connection"
                              ]
                            },
                            "source_agent_node_id": {
                              "type": "string",
                              "format": "uuid",
                              "description": "Source existing node identifier."
                            },
                            "source_temp_ref_id": {
                              "type": "string",
                              "description": "Source temp reference from an earlier create_node operation in the same request; must already exist."
                            },
                            "target_agent_node_id": {
                              "type": "string",
                              "format": "uuid",
                              "description": "Target existing node identifier."
                            },
                            "target_temp_ref_id": {
                              "type": "string",
                              "description": "Target temp reference from an earlier create_node operation in the same request; must already exist."
                            }
                          },
                          "required": [
                            "op"
                          ]
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Agent updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentMutationResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          }
        }
      },
