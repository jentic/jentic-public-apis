      "AgentDuplicateRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "maxLength": 5000
          },
          "visibility": {
            "type": "string",
            "enum": [
              "public",
              "private"
            ]
          },
          "include_renders": {
            "type": "boolean",
            "default": false,
            "description": "Copy completed renders and the media they reference onto the duplicate."
          }
        },
        "additionalProperties": false
      },
      "AgentShareRequest": {
        "type": "object",
        "properties": {
          "duplicate": {
            "type": "boolean",
            "default": false,
            "description": "Share a copy of the mosaic instead of the mosaic itself, leaving the original private."
          },
          "include_assets": {
            "type": "boolean",
            "default": true,
            "description": "When duplicating, copy completed renders and the media they reference."
          },
          "run_id": {
            "type": "string",
            "format": "uuid",
            "description": "Finished run (completed or partial_complete) whose renders should be copied. Requires duplicate=true and include_assets=true."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "maxLength": 5000
          }
        },
        "additionalProperties": false
      },
      "AgentShareResponse": {
        "type": "object",
        "properties": {
          "agent_id": {
            "type": "string",
            "description": "The shared mosaic. When duplicate is true this is the new copy."
          },
          "name": {
            "type": "string"
          },
          "visibility": {
            "type": "string",
            "enum": [
              "public",
              "private"
            ]
          },
          "share_url": {
            "type": "string",
            "nullable": true,
            "description": "Link anyone can open, or null when the mosaic is private."
          },
          "source_agent_id": {
            "type": "string",
            "description": "Mosaic the copy was made from. Only present when duplicate is true."
          },
          "source_run_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "description": "Completed run used as the render source, or null when template-node renders were copied."
          },
          "duplicated": {
            "type": "boolean"
          },
          "stats": {
            "$ref": "#/components/schemas/AgentDuplicateStats"
          }
        }
      },
