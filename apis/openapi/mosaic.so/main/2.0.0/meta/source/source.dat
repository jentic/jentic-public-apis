            "type": "string",
            "nullable": true
          },
          "profile_url": {
            "type": "string",
            "nullable": true
          },
          "username": {
            "type": "string",
            "nullable": true,
            "description": "Backward-compatible account username field."
          },
          "display_name": {
            "type": "string",
            "nullable": true,
            "description": "Backward-compatible account display name field."
          },
          "user_image": {
