          "likes": {
            "type": "number",
            "nullable": true
          },
          "comments": {
            "type": "number",
            "nullable": true
          },
          "shares": {
            "type": "number",
            "nullable": true
          },
          "impressions": {
            "type": "number",
            "nullable": true
          },
          "views": {
            "type": "number",
            "nullable": true
          },
          "video_views": {
            "type": "number",
            "nullable": true
          },
