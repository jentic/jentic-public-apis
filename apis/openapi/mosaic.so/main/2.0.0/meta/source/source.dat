      "SocialConnectionCreateRequest": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string",
            "enum": [
              "x",
              "linkedin",
              "instagram",
              "facebook",
              "tiktok",
              "youtube"
            ]
          },
          "connection_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "Name displayed on the hosted connection page for a new profile. Leading and trailing whitespace is trimmed. Duplicate names are allowed; use social_profile_id to identify distinct profiles. Omit to use a generated name. Does not rename an existing profile or social account."
          },
          "social_profile_id": {
            "type": "string",
            "format": "uuid",
            "description": "Reuse an existing social profile without creating another profile slot. connection_name does not rename the existing profile."
          },
          "redirect_url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "platform"
        ],
        "additionalProperties": false
      },
      "SocialConnectUrlResponse": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string",
            "enum": [
              "x",
              "linkedin",
              "instagram",
              "facebook",
              "tiktok",
              "youtube"
            ]
          },
          "social_profile_id": {
            "type": "string",
            "format": "uuid",
            "description": "ID of the new or reused social profile. Distinct profiles may share the same connection_name."
          },
          "connect_url": {
            "type": "string",
            "format": "uri",
            "description": "Short-lived Mosaic URL that opens the social account setup flow."
          }
        },
        "required": [
          "platform",
          "connect_url"
        ]
      },
