    "/social/profiles/{social_profile_id}": {
      "patch": {
        "summary": "Update social profile",
        "description": "Change the display name of an existing social profile. Duplicate names are allowed. Connected accounts and profile slot usage are preserved.",
        "operationId": "updateSocialProfile",
        "tags": [
          "Social"
        ],
        "parameters": [
          {
            "name": "social_profile_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "connection_name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120,
                    "description": "New display name. Leading and trailing whitespace is trimmed. Duplicate names are allowed."
                  }
                },
                "required": [
                  "connection_name"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated profile name",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "social_profile_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "connection_name": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "social_profile_id",
                    "connection_name"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          }
        }
      }
    },
