{
  "openapi": "3.0.0",
  "info": {
    "title": "Exact Online REST API",
    "description": "The Exact Online REST API provides access to Exact Online data and functionality. \n        \n## Authentication\nThis API uses OAuth 2.0 for authentication. You will need to authenticate using your Exact Online credentials.\n\n## Division Parameter\nAlmost all REST API resources require a Division parameter to identify the division being accessed. \nYou can get your current division using `/api/v1/current/Me?$select=CurrentDivision`.\n\n## Pagination\nMost endpoints have a page size of 60 results per request. Use the $top and $skip parameters for pagination.\nBulk and sync endpoints have a page size of 1000.",
    "version": "1",
    "contact": {
      "name": "Exact Online Support",
      "url": "https://support.exactonline.com"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/Rinse_Lemstra/exactrest/1"
  },
  "servers": [
    {
      "url": "https://start.exactonline.nl",
      "description": "Production server"
    }
  ],
  "components": {
    "securitySchemes": {
      "oauth2": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://start.exactonline.nl/api/oauth2/auth",
            "tokenUrl": "https://start.exactonline.nl/api/oauth2/token",
            "scopes": {
              "read": "Read access to resources",
              "write": "Write access to resources"
            }
          }
        }
      }
    },
    "parameters": {
      "division": {
        "name": "division",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "Division number"
      },
      "skip": {
        "name": "$skip",
        "in": "query",
        "schema": {
          "type": "integer",
          "default": 0
        },
        "description": "Number of records to skip"
      },
      "top": {
        "name": "$top",
        "in": "query",
        "schema": {
          "type": "integer",
          "default": 60
        },
        "description": "Number of records to return (max 60 for regular endpoints)"
      },
      "select": {
        "name": "$select",
        "in": "query",
        "schema": {
          "type": "string"
        },
        "description": "Comma-separated list of fields to return"
      },
      "filter": {
        "name": "$filter",
        "in": "query",
        "schema": {
          "type": "string"
        },
        "description": "OData filter expression"
      },
      "orderby": {
        "name": "$orderby",
        "in": "query",
        "schema": {
          "type": "string"
        },
        "description": "Field name to order by"
      },
      "expand": {
        "name": "$expand",
        "in": "query",
        "schema": {
          "type": "string"
        },
        "description": "Related entities to expand"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "object"
              }
            }
          }
        }
      },
      "ODataResponse": {
        "type": "object",
        "properties": {
          "d": {
            "type": "object",
            "properties": {
              "results": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "__count": {
                "type": "integer"
              }
            }
          }
        }
      },
      "GenericResource": {
        "type": "object",
        "properties": {
          "__metadata": {
            "type": "object",
            "properties": {
              "uri": {
                "type": "string"
              },
              "type": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "oauth2": [
        "read",
        "write"
      ]
    }
  ],
