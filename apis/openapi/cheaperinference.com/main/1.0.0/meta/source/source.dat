            "type": [
              "string",
              "null"
            ],
            "description": "Null for a personal account."
          },
          "role": {
            "type": [
              "string",
              "null"
            ]
          },
          "funded_by_owner": {
            "type": "boolean",
            "description": "True when this member's usage is paid from the workspace owner's wallet."
          },
          "active_key_count": {
            "type": "integer"
          },
          "last_key_use_at": {
            "type": [
              "string",
              "null"
            ],
