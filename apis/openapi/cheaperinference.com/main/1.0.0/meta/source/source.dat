      "put": {
        "tags": [
          "Account"
        ],
        "summary": "Replace the workspace admin policy",
        "operationId": "setWorkspaceAdminPolicy",
        "description": "Replace the whole policy of the calling key's workspace; the workspace is always the key's own. Send `expected_version` as read: a policy saved in between is 409 with the current one. Lowering `task_limit_max_usd` lowers every open task budget above it in the same transaction (`clamped_task_budget_count`); raising or clearing it changes no budget. Every save is audited. Requires `account:write` and a workspace owner or admin.",
        "security": [
          {
            "BearerAuth": []
          },
          {
            "AnthropicApiKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WorkspaceAdminPolicyInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceAdminPolicySaved"
                }
              }
            }
          },
          "400": {
            "description": "`code: invalid_request`, with `param` naming the field: not a JSON object, an unknown or missing field, `expected_version` not a whole number, a money field not null or a decimal string above 0 and at most 10000 with at most 6 places, the default above the maximum, `task_budget_required` not a boolean, `techniques_locked_off` not a list of at most 32 distinct catalog technique ids, or `prompt_cache_rule` not null, on, off or passthrough.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing API key (`type: authentication_error`, `code: invalid_api_key`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "402": {
            "description": "Insufficient wallet balance (`type: invalid_request_error`, `code: insufficient_balance`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "403": {
            "description": "`code: insufficient_scope` when the key lacks `account:write` (`param` is the scope); a temporary Prompt Studio key carries only `inference`. `code: workspace_manager_required` unless the key's creator is a workspace owner or admin.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "404": {
            "description": "`code: workspace_not_found`: the key is a personal key, which no workspace policy covers.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "408": {
            "description": "Request timed out (`type: invalid_request_error`, `code: request_failed`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "409": {
            "description": "`code: workspace_admin_policy_conflict`: the policy was saved since `expected_version` was read. The current policy is in `error.current`; nothing was changed.",
            "content": {
              "application/json": {
