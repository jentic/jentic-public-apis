    "/v1/uploads": {
      "post": {
        "tags": [
          "Uploads"
        ],
        "summary": "Upload a temporary image",
        "operationId": "createUpload",
        "description": "Store an image for a short time and receive a `file_id`. Send that id in a chat message and it is swapped for a signed URL on the way to the provider. At most 4 MB per image; the whole request body may not exceed 4.5 MB. Rejected for an account with zero data retention.",
        "security": [
          {
            "BearerAuth": []
          },
          {
            "AnthropicApiKey": []
