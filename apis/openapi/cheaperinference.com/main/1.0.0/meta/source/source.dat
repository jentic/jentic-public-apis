      "post": {
        "tags": [
          "Keak Code"
        ],
        "summary": "Open a task budget on the calling key",
        "operationId": "openTaskBudget",
        "description": "Open the key's task budget for one client task, with a limit and a lease. Until it is closed or the lease expires, each request on the key holds its worst-case charge against the limit and settles to what it was billed; a request that does not fit is refused before anything is held. At expiry enforcement ends and the key falls back to its normal limits, so renew the lease with PATCH while the task runs. One open budget per key: repeating the same task and limit replays it (200, `replayed: true`); the same task with another limit is 409 `task_budget_exists` (raise it with PATCH instead); another task's open budget is 409 `task_budget_conflict` with that budget in `error.active`. On a workspace key, a limit above the workspace admin policy's maximum is clamped to it, never refused: `limit_usd` is the maximum and `clamped_to_max` is true. A replay compares the clamped limit.",
        "security": [
          {
            "BearerAuth": []
          },
          {
            "AnthropicApiKey": []
          }
        ],
        "parameters": [
          {
            "name": "key_id",
            "in": "path",
            "required": true,
            "description": "`self`: the API key making the request. Any other value is a 404 in this release.",
            "schema": {
              "type": "string",
              "enum": [
                "self"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TaskBudgetOpenRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Already open for this task with this limit (`replayed: true`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskBudget"
                }
              }
            }
          },
          "201": {
            "description": "Opened (`replayed: false`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskBudget"
                }
              }
            }
          },
          "400": {
            "description": "Malformed body (`code: invalid_request`), with `param` naming the field: not a JSON object, an unknown field, `task_id` not a UUID, `limit_usd` not a decimal string with at most 6 places above 0 and at most 10000 (an exponent or a JSON number is refused), `expires_in_s` not a whole number from 60 to 86400, or `force` not a boolean.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing API key (`type: authentication_error`, `code: invalid_api_key`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "402": {
            "description": "Insufficient wallet balance (`type: invalid_request_error`, `code: insufficient_balance`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "403": {
            "description": "`code: insufficient_scope` when the key lacks `inference` (`param` is the scope). `code: api_key_required` for a caller with no API key behind it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "404": {
            "description": "`code: api_key_not_found`: `key_id` is not `self`, or the key was revoked or expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "408": {
            "description": "Request timed out (`type: invalid_request_error`, `code: request_failed`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "409": {
            "description": "`code: delegated_api_key`: a temporary Prompt Studio key authenticates as its parent, so `self` would describe another key. `code: task_budget_conflict`: another task's budget is open on this key, in `error.active`. `code: task_budget_exists`: this task's budget is open with another limit, in `error.active`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskBudgetError"
                }
              }
            }
          },
          "413": {
            "description": "Request too large (`type: invalid_request_error`, `code: request_too_large`)",
            "content": {
