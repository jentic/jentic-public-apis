    "/v1/usage/team-savings": {
      "get": {
        "tags": [
          "Usage"
        ],
        "summary": "Team Savings",
        "operationId": "getUsageTeamSavings",
        "description": "What the calling key's workspace spent, against the list price of the same model (`baseline.id: same_model_list_price_v1`), in total and by member, project or model, over inclusive UTC days (at most 92). Requires `usage:read`; `scope=team` also requires `account:read`. Includes every key in the workspace, not only Keak Code; requests without a Keak Code project tag are Unattributed. Spend: a settled request at its charge, a failed request that was charged at its charge, a cache hit at $0; in-flight requests are counted as pending with no amount. Requests with no known list price are left out of the baseline and of the comparable spend, and `coverage` says how much. Savings may be negative. Amounts are 6-decimal strings rounded half-even one by one, so a figure derived from two others can differ by $0.000001; groups sum to the totals exactly before rounding. At most 500 groups are returned (`groups_truncated`); totals are always complete. A member is the owner of the key that sent the request.",
        "security": [
          {
            "BearerAuth": []
          },
          {
            "AnthropicApiKey": []
          }
        ],
        "parameters": [
          {
            "name": "scope",
            "in": "query",
            "required": false,
            "description": "`self` (default): the caller's own requests in the key's workspace. `team`: the workspace's members the caller may see, which needs the `account:read` scope as well as a workspace role that includes team reports (owner, admin, or a member granted Team reports). The workspace is always the calling key's; it cannot be named.",
            "schema": {
              "type": "string",
              "enum": [
                "self",
                "team"
              ],
              "default": "self"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "description": "First UTC day, inclusive. Defaults to 29 days before `to`. The period may cover at most 92 days (`code: range_too_large`).",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "description": "Last UTC day, inclusive. Defaults to today (UTC).",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "group_by",
            "in": "query",
            "required": false,
            "description": "How `groups` is split. Ignored by the requests listing.",
            "schema": {
              "type": "string",
              "enum": [
                "member",
                "project",
                "model"
              ],
              "default": "member"
            }
          },
          {
            "name": "member",
            "in": "query",
            "required": false,
            "description": "Comma-separated: `me` or up to 50 member user ids. Anyone other than the caller needs `scope=team` (`code: member_requires_team_scope`).",
            "style": "form",
            "explode": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "maxItems": 50
            }
          },
          {
            "name": "project",
            "in": "query",
            "required": false,
            "description": "Comma-separated: up to 50 opaque project ids from Keak Code's attribution, or `unattributed` for requests with no project tag.",
            "style": "form",
            "explode": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(unattributed|[A-Za-z0-9_-]{16,64})$"
              },
              "minItems": 1,
              "maxItems": 50
            }
          },
          {
            "name": "model",
            "in": "query",
            "required": false,
            "description": "Comma-separated: up to 20 model ids, matched exactly.",
            "style": "form",
            "explode": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._:/-]{1,256}$"
              },
              "minItems": 1,
              "maxItems": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TeamSavings"
                }
              }
            }
          },
          "400": {
            "description": "`param` names the parameter. `code: invalid_request` for a malformed, repeated or unknown parameter; `code: range_too_large` (`param: from`) for more than 92 days; `code: member_requires_team_scope` (`param: member`) for another member with `scope=self`; `code: invalid_cursor` for a cursor this service did not issue.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing API key (`type: authentication_error`, `code: invalid_api_key`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "402": {
            "description": "Insufficient wallet balance (`type: invalid_request_error`, `code: insufficient_balance`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "403": {
            "description": "`code: insufficient_scope` when the key lacks `usage:read`, or `account:read` for `scope=team` (`param` is the scope). `code: team_reports_forbidden` (`param: scope`) when the caller's role does not include team reports, or the key is a personal key. `code: member_not_visible` (`param: member`) for a member not shared with the caller. `code: organization_membership_required` when the key's workspace membership was removed.",
            "content": {
              "application/json": {
                "schema": {
