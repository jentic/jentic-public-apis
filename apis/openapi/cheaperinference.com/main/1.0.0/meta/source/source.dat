      "DetailError": {
        "type": "object",
        "description": "The error body the /public routes answer with.",
        "properties": {
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "detail"
        ]
      },
      "UsageRequestList": {
        "type": "object",
        "properties": {
          "object": {
            "type": "string",
            "enum": [
              "list"
            ]
          },
          "scope": {
            "type": "string",
            "enum": [
              "workspace"
            ]
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UsageRequest"
            }
          },
          "has_more": {
            "type": "boolean"
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Opaque. Pass back as `cursor`; do not parse."
          },
          "missing_request_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Present only when the request named `request_ids`: the requested ids, lower-cased, that are not in `data` because they do not exist, are not the caller's, or have passed the per-request retention window. The three are deliberately indistinguishable; use `retention_days` to tell which absences your own records explain."
          },
          "retention_days": {
            "type": "integer",
            "description": "Present alongside `missing_request_ids`: how many days per-request detail is kept. Ids are never individually marked as expired, because that would reveal whether an id exists. You know when you made each request, so compare its age against this: an id older than the window is missing because the detail is no longer kept, not because the request was never served. Daily and day-by-model totals for that period remain available."
          }
        },
        "required": [
          "object",
          "scope",
          "data",
          "has_more"
        ]
      },
      "UsageRequest": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "api_key_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "api_key_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "model": {
            "type": "string"
          },
          "endpoint": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "validating",
              "forwarding",
              "settled",
              "cached",
              "failed"
            ]
          },
          "prompt_tokens": {
            "type": "integer"
          },
          "completion_tokens": {
            "type": "integer"
          },
          "total_tokens": {
            "type": "integer"
          },
          "billed_cost_usd": {
            "type": [
              "string",
              "null"
            ],
            "description": "Null unless the request settled."
          },
          "provider_list_price_usd": {
            "type": [
              "string",
              "null"
            ],
            "description": "Request-time maker/provider list-price comparison amount."
          },
          "paid_amount_usd": {
            "type": [
              "string",
              "null"
            ],
            "description": "Customer amount paid; null unless the request settled."
          },
          "savings_usd": {
            "type": [
              "string",
              "null"
            ],
            "description": "Customer-visible savings, always non-negative when present."
          },
          "route": {
            "type": [
              "string",
              "null"
            ],
            "deprecated": true,
            "description": "Always null. Identified the supply route that served the request; withdrawn because it names our supplier. The key remains so existing clients keep a stable shape."
          },
          "serving_provider": {
            "type": [
              "string",
              "null"
            ],
            "deprecated": true,
            "description": "Always null. Identified the serving provider; withdrawn for the same reason as `route`."
          },
          "retention": {
            "type": "string",
            "enum": [
              "zdr",
              "standard",
              "unknown"
            ],
            "description": "Recorded request-time retention policy; unknown for historical requests without evidence."
          },
          "effective_discount_percent": {
            "type": [
              "number",
              "null"
            ],
            "description": "Effective discount against request-time list cost, including optimizations; null without comparable settled costs."
          },
          "pricing_basis": {
            "type": [
              "string",
              "null"
            ]
          },
          "pricing_snapshot": {
            "type": [
              "object",
              "null"
            ],
            "description": "Immutable customer and maker-list rates resolved at admission.",
            "additionalProperties": true
          },
          "pricing_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "customer_price_ceiling_usd": {
            "type": [
              "string",
              "null"
            ]
          },
          "maker_list_ceiling_usd": {
            "type": [
              "string",
              "null"
            ]
          },
          "requested_reasoning_effort": {
            "type": [
              "string",
              "null"
            ]
          },
          "effective_reasoning_effort": {
            "type": [
              "string",
              "null"
            ]
          },
          "time_to_response_headers_ms": {
            "type": [
              "integer",
              "null"
            ],
            "description": "From our API receiving the request to the serving supplier's response headers."
          },
          "model_time_to_response_headers_ms": {
            "type": [
              "integer",
              "null"
            ],
            "description": "From dispatch to the serving supplier to its response headers."
          },
          "time_to_first_visible_output_ms": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Like time_to_first_token_ms, but excludes reasoning-only output. Streamed requests only."
          },
          "model_time_to_first_visible_output_ms": {
            "type": [
              "integer",
              "null"
            ],
            "description": "From dispatch to the first visible output. Streamed requests only."
          },
          "routing_overhead_ms": {
            "type": [
              "integer",
              "null"
            ],
            "description": "From our API receiving the request to dispatch to the serving supplier, earlier failed attempts included."
          },
          "provider_attempt_count": {
            "type": [
              "integer",
              "null"
            ]
          },
          "cache_reporting_state": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "hit",
              "zero",
              "unknown",
              "not_applicable",
              null
            ]
          },
          "currency": {
            "type": "string",
            "enum": [
              "USD"
            ]
          },
          "total_latency_ms": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Latency: from our API receiving the request to the last byte of the response."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "cache_read_input_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Not recorded yet."
          },
          "cache_write_input_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Not recorded yet."
          },
          "image_output_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Not recorded yet."
          },
          "time_to_first_token_ms": {
            "type": [
              "integer",
              "null"
            ],
            "description": "TTFT: from our API receiving the request to the first output token, reasoning included. Streamed requests only; null when not streamed."
          },
          "model_latency_ms": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Not recorded yet."
          },
          "model_time_to_first_token_ms": {
            "type": [
              "integer",
              "null"
            ],
            "description": "From dispatch to the serving supplier to the first output token, reasoning included. routing_overhead_ms + model_time_to_first_token_ms = time_to_first_token_ms. Streamed requests only."
          },
          "generation_duration_ms": {
            "type": [
              "integer",
              "null"
            ],
            "description": "From the first output token to the end of the response. Streamed requests only."
          },
          "output_tokens_per_second": {
            "type": [
              "string",
              "null"
            ],
            "description": "Tokens per second: completion_tokens * 1000 / generation_duration_ms. Streamed requests only."
          },
          "completed_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "When the request settled or failed."
          },
          "billing": {
            "$ref": "#/components/schemas/UsageRequestBilling"
          },
          "techniques": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UsageRequestTechnique"
            },
            "description": "Cheaper Inference techniques recorded for this request. Entries recorded before outcomes were stored only ever listed applied work, so they read as `applied`. Notes, release ids and evidence are not exposed."
          },
          "attribution": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/UsageRequestAttribution"
              },
              {
                "type": "null"
              }
            ],
            "description": "The tag written by `POST /v1/usage/attributions`, or null when the request was never attributed (also null on a deployment that has not applied the request_tags migration)."
          }
        },
        "required": [
          "request_id",
          "model",
          "endpoint",
          "status",
          "currency",
          "created_at",
          "billing",
          "techniques",
          "attribution"
        ]
      },
      "UsageRequestBilling": {
        "type": "object",
        "description": "The request's billing state for a client reconciling its own ledger. Derived from `status`: settled carries the settled charge; an incomplete request whose delivered partial stream was billed is also settled, with that charge, matching the stream receipt; cached, and failed with no charge, say `0.000000`; validating and forwarding (in flight, or a settlement that has not landed) are `pending` with a null amount, because the amount is not known.",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "settled",
              "cached",
              "failed",
              "pending"
            ]
          },
          "billed_cost_usd": {
            "type": [
              "string",
              "null"
            ],
            "description": "Fixed 6 decimal places, as a string. Null only while pending.",
            "examples": [
              "0.004213"
            ]
          }
        },
        "required": [
          "status",
          "billed_cost_usd"
        ]
      },
      "UsageRequestTechnique": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "applied",
              "skipped",
              "error"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "tokens_saved": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "slug",
          "outcome",
          "reason",
          "tokens_saved"
        ]
      },
      "UsageRequestAttribution": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "format": "uuid"
          },
          "project_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Za-z0-9_-]{16,64}$"
          },
          "client": {
            "type": "string"
          }
        },
        "required": [
          "task_id",
          "project_id",
          "client"
        ]
      },
      "UsageAttributionRequest": {
        "type": "object",
        "description": "Strict: any other field is refused with 400.",
        "properties": {
          "task_id": {
            "type": "string",
            "format": "uuid",
            "description": "The client's task id."
          },
          "project_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Za-z0-9_-]{16,64}$",
            "description": "An opaque client-side hash identifying the project, never a readable path or URL. Optional; null when the client has none."
          },
          "client": {
            "type": "string",
            "enum": [
              "keak-code"
            ]
          },
          "request_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "minItems": 1,
            "maxItems": 100,
            "description": "Request ids from the receipts. Deduplicated and lower-cased."
          }
        },
        "required": [
          "task_id",
          "client",
          "request_ids"
        ],
        "additionalProperties": false
      },
      "UsageAttribution": {
        "type": "object",
        "properties": {
          "object": {
            "type": "string",
            "enum": [
              "usage.attribution"
            ]
          },
          "task_id": {
            "type": "string",
            "format": "uuid"
          },
          "project_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "client": {
            "type": "string"
          },
          "request_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "created": {
            "type": "integer",
            "minimum": 0,
            "description": "Tags written by this call."
          },
          "unchanged": {
            "type": "integer",
            "minimum": 0,
            "description": "Ids that already carried exactly this tag."
          }
        },
        "required": [
          "object",
          "task_id",
          "project_id",
          "client",
          "request_ids",
          "created",
          "unchanged"
        ]
      },
      "UsageAttributionError": {
        "type": "object",
        "description": "The OpenAI error envelope with the ids the caller must act on inside `error`, never at the top level.",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "param": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "request_ids"
                ]
              },
              "code": {
                "type": "string",
                "enum": [
                  "request_not_found",
                  "attribution_conflict"
                ]
              },
              "missing_request_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "On 404 `request_not_found` only."
              },
              "conflicting_request_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "On 409 `attribution_conflict` only."
              }
            },
            "required": [
              "message",
              "type",
              "code"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "UsageTaskOutcomeRequest": {
        "type": "object",
        "description": "Strict: any other field is refused with 400.",
        "properties": {
          "task_id": {
            "type": "string",
            "format": "uuid",
            "description": "The task id used in the attribution."
          },
          "outcome": {
            "type": "string",
            "enum": [
              "completed"
            ]
          },
          "client": {
            "type": "string",
            "enum": [
              "keak-code"
            ]
          }
        },
        "required": [
          "task_id",
          "outcome",
          "client"
        ],
        "additionalProperties": false
      },
      "UsageTaskOutcome": {
        "type": "object",
        "properties": {
          "object": {
            "type": "string",
            "enum": [
              "usage.task_outcome"
            ]
          },
          "task_id": {
            "type": "string",
            "format": "uuid"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "completed"
            ]
          },
          "created": {
            "type": "boolean",
            "description": "False when the task was already recorded as completed."
          }
        },
        "required": [
          "object",
          "task_id",
          "outcome",
          "created"
        ]
      },
      "TeamSavingsSummary": {
        "type": "object",
        "description": "Amounts are USD strings with 6 decimal places, rounded half-even, and may be negative. Rates are fractions with 6 decimal places, or null when there is nothing to divide by.",
        "properties": {
          "requests": {
            "type": "integer",
            "minimum": 0,
            "description": "Charged requests: settled, cache hits and charged failures."
          },
          "actual_usd": {
            "type": "string",
            "description": "What those requests were billed. Cache hits count $0."
          },
          "comparable_requests": {
            "type": "integer",
            "minimum": 0,
            "description": "Charged requests with a known list price."
          },
          "comparable_actual_usd": {
            "type": "string"
          },
          "baseline_usd": {
            "type": "string",
            "description": "List price of the comparable requests."
          },
          "savings_usd": {
            "type": "string",
            "description": "`baseline_usd - comparable_actual_usd`. May be negative."
          },
          "savings_rate": {
            "type": [
              "string",
              "null"
            ],
            "description": "`savings_usd / baseline_usd`; null when the baseline is 0."
          },
          "savings_breakdown": {
            "type": "object",
            "properties": {
              "same_model_price_usd": {
                "type": "string",
                "description": "Savings on requests that ran."
              },
              "response_cache_usd": {
                "type": "string",
                "description": "List price of cache hits, which cost $0."
              }
            },
            "required": [
              "same_model_price_usd",
              "response_cache_usd"
            ]
          },
          "coverage": {
            "type": "object",
            "description": "How much of the spend the savings figure covers.",
            "properties": {
              "requests_rate": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "`comparable_requests / requests`."
              },
              "spend_rate": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "`comparable_actual_usd / actual_usd`."
              }
            },
            "required": [
              "requests_rate",
              "spend_rate"
            ]
          },
          "not_comparable": {
            "type": "object",
            "description": "Charged requests left out of the savings because their list price is unknown.",
            "properties": {
              "requests": {
                "type": "integer",
                "minimum": 0
              },
              "actual_usd": {
                "type": "string"
              }
            },
            "required": [
              "requests",
              "actual_usd"
            ]
          },
          "attribution": {
            "type": "object",
            "description": "Charged requests with and without a Keak Code attribution tag.",
            "properties": {
              "attributed_requests": {
                "type": "integer",
                "minimum": 0
              },
              "attributed_actual_usd": {
                "type": "string"
              },
              "unattributed_requests": {
                "type": "integer",
                "minimum": 0
              },
              "unattributed_actual_usd": {
                "type": "string"
              }
            },
            "required": [
              "attributed_requests",
              "attributed_actual_usd",
              "unattributed_requests",
              "unattributed_actual_usd"
            ]
          },
          "pending_requests": {
            "type": "integer",
            "minimum": 0,
            "description": "In flight, or not yet settled. No amount."
          },
          "failed_unbilled_requests": {
            "type": "integer",
            "minimum": 0,
            "description": "Failed and not charged."
          },
          "tasks": {
            "type": "object",
            "description": "Keak Code tasks with charged requests in this period. Completed tasks are as reported by Keak Code, and their spend is only what fell inside the period.",
            "properties": {
              "attributed": {
                "type": "integer",
                "minimum": 0
              },
              "reported_completed": {
                "type": "integer",
                "minimum": 0
              },
              "reported_completed_actual_usd": {
                "type": "string"
              },
              "cost_per_reported_completed_task_usd": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Null when no task was reported completed, and on `group_by=model` groups, where one task spans several models."
              }
            },
            "required": [
              "attributed",
              "reported_completed",
              "reported_completed_actual_usd",
              "cost_per_reported_completed_task_usd"
            ]
          }
        },
        "required": [
          "requests",
          "actual_usd",
          "comparable_requests",
          "comparable_actual_usd",
          "baseline_usd",
          "savings_usd",
          "savings_rate",
          "savings_breakdown",
          "coverage",
          "not_comparable",
          "attribution",
          "pending_requests",
          "failed_unbilled_requests",
          "tasks"
        ]
      },
      "TeamSavingsGroup": {
        "type": "object",
        "description": "A summary for one member, project or model.",
