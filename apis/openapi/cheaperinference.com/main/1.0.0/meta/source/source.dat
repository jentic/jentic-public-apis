  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API key"
      },
      "AnthropicApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      }
    },
    "schemas": {
      "OpenAIError": {
        "type": "object",
        "description": "Every `/v1/*` path except `/v1/messages*`.",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "param": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "code": {
                "type": "string",
                "description": "Stable machine-readable code. Gemini 3 thinking cannot be disabled, so `reasoning_effort: none` returns `unsupported_reasoning_effort`."
              }
            },
            "required": [
              "message",
              "type",
              "code"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "AnthropicError": {
        "type": "object",
        "description": "`/v1/messages` and `/v1/messages/count_tokens`. No `code`, no `param`.",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "error"
            ]
          },
          "error": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "message"
            ]
          }
        },
        "required": [
          "type",
          "error"
        ]
      },
      "ChatCompletionRequest": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string"
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "stream": {
            "type": "boolean"
          },
          "max_tokens": {
            "type": "integer"
          },
          "max_completion_tokens": {
            "type": "integer",
            "description": "Alternative output-token limit. If both limits are supplied, they must match."
          },
          "min_discount_percent": {
            "type": "number",
            "minimum": 0,
            "maximum": 99.99,
            "description": "Price ceiling for this request as a minimum discount off the model's list price (see GET /v1/models pricing.list_*). Only supply priced under list × (1 − d) serves the request, and the bill is capped at that rate. With no qualifying supply the request fails with 503 `min_discount_unavailable` instead of falling back. Stripped before forwarding."
          },
          "zdr": {
            "type": "boolean",
            "description": "Route this request only through providers that support a zero-data-retention policy. A zero-data-retention provider does not keep your prompts or responses and does not train on them. The marketplace and every unverified provider are excluded, so the price is the ZDR price shown by `GET /v1/models?zdr=true`. Adds to the account's Data Protection setting; it cannot lift it. With no qualifying supply the request fails before it is sent upstream with 503 `zdr_capacity_unavailable`. Stripped before forwarding."
          },
          "ranking": {
            "type": "string",
            "enum": [
              "speed",
              "discount",
              "balance"
            ],
            "default": "balance",
            "description": "How the gateway orders the discounted sources that can serve this request. `discount`: cheapest first. `speed`: highest recent speed first, measured on this model from the gateway's own traffic (time to first visible output and output tokens per second, weighted towards the last hour); cost breaks ties. `balance` (default): speed score × discount. Speed and discount are NOT a trade-off: the fastest source is often also a cheap one, so `speed` can return the same route as `discount`. Fallback routes are not ranked. They are tried only when no discounted source can serve the request in time. The mode changes the order only, never which sources are eligible. Stripped before forwarding."
          },
          "temperature": {
            "type": "number",
            "description": "Model-specific sampling control. Omit on models that do not support sampling. Claude Chat-to-native translation caps values above 1 at 1."
          },
          "top_p": {
            "type": "number",
            "description": "Model-specific sampling control. Omit on models that do not support it."
          },
          "n": {
            "type": "integer",
            "description": "Number of completions. Claude supports only 1."
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "tool_choice": {},
          "reasoning_effort": {
            "type": "string",
            "enum": [
              "none",
              "minimal",
              "low",
              "medium",
              "high",
              "xhigh",
              "max"
            ],
            "description": "Alias for reasoning.effort, including Claude. Conflicting values return 400. Supported levels depend on the model; Gemini 3 accepts minimal, low, medium, and high only. Claude native bridges translate effort into adaptive thinking or a manual budget within max_tokens. A manual budget must be an integer of at least 1024, strictly below the output limit. Thinking summaries, when returned, appear in message.reasoning_content or delta.reasoning_content. Native thinking and output_config settings take precedence."
          },
          "reasoning": {
            "type": [
              "object",
              "boolean",
              "null"
            ],
            "description": "Portable reasoning controls, including Claude. false disables thinking where supported. Use /v1/responses for Pro. Chat Completions returns HTTP 400 for reasoning.mode: pro or an OpenAI Pro model ID such as gpt-5.5-pro.",
            "properties": {
              "effort": {
                "type": "string",
                "enum": [
                  "none",
                  "minimal",
                  "low",
                  "medium",
                  "high",
                  "xhigh",
                  "max"
                ]
              },
              "enabled": {
                "type": "boolean"
              },
              "exclude": {
                "type": "boolean",
                "description": "For Claude Chat, true hides returned thinking summaries without disabling thinking."
              },
              "max_tokens": {
                "type": "integer",
                "description": "Manual reasoning budget where supported. Claude requires at least 1024 and strictly less than the request output limit. Adaptive-only Claude models reject this portable budget."
              }
            },
            "additionalProperties": true
          },
          "thinking": {
            "type": "object",
            "description": "Native Claude thinking configuration. Takes precedence over portable effort. Active thinking supports auto or none tool_choice, not required or a forced named tool.",
            "additionalProperties": true
          },
          "output_config": {
            "type": "object",
            "description": "Native Claude output configuration, including effort for adaptive thinking. Preserved by the native Chat bridges.",
            "additionalProperties": true
          },
          "include_reasoning": {
            "type": "boolean",
            "description": "Claude Chat thinking summaries are hidden by default. Set true (or reasoning.exclude: false) to include them. False or reasoning.exclude: true always hides them without disabling thinking or changing token billing."
          },
          "cache_control": {
            "type": "object",
            "description": "Request-level Claude cache control. Supported controls on tools, messages and content blocks are also preserved by native bridges. An opt-in does not guarantee a cache hit; off or ZDR removes explicit controls.",
            "additionalProperties": true
          }
        },
        "required": [
          "model",
          "messages"
        ],
        "additionalProperties": true
      },
      "ChatCompletionResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "object": {
            "type": "string"
          },
          "created": {
            "type": "integer"
          },
          "model": {
            "type": "string"
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "usage": {
            "type": "object"
          },
          "request_id": {
            "type": "string",
            "format": "uuid",
            "description": "The id to quote when contacting support about this request."
          },
          "billing": {
            "type": "object",
            "description": "What this request was billed. Present on every successful response.",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "settled",
                  "cached",
                  "failed",
                  "pending"
                ],
                "description": "Customer billing settlement status. pending means the final charge is unknown; inference may have completed successfully."
              },
              "billed_cost_usd": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Fixed 6 decimal places, as a string. Null when the request failed or customer settlement is pending; a settled zero charge is 0.000000.",
                "examples": [
                  "0.000123"
                ]
              },
              "zero_data_retention": {
                "type": "boolean",
                "description": "Request-time zero data retention policy."
              },
              "effective_discount_percent": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Effective discount vs request-time list cost including optimizations; null without a known comparison."
              },
              "currency": {
                "type": "string",
                "enum": [
                  "USD"
                ]
              }
            },
            "required": [
              "status",
              "currency"
            ]
          }
        },
        "required": [
          "id",
          "choices"
        ],
        "additionalProperties": true
      },
      "CompletionRequest": {
        "type": "object",
        "properties": {
          "min_discount_percent": {
            "type": "number",
            "minimum": 0,
            "maximum": 99.99,
            "description": "Price ceiling for this request as a minimum discount off the model's list price (see GET /v1/models pricing.list_*). Only supply priced under list × (1 − d) serves the request, and the bill is capped at that rate. With no qualifying supply the request fails with 503 `min_discount_unavailable` instead of falling back. Stripped before forwarding."
          },
          "zdr": {
            "type": "boolean",
            "description": "Route this request only through providers that support a zero-data-retention policy. A zero-data-retention provider does not keep your prompts or responses and does not train on them. The marketplace and every unverified provider are excluded, so the price is the ZDR price shown by `GET /v1/models?zdr=true`. Adds to the account's Data Protection setting; it cannot lift it. With no qualifying supply the request fails before it is sent upstream with 503 `zdr_capacity_unavailable`. Stripped before forwarding."
          },
          "ranking": {
            "type": "string",
            "enum": [
              "speed",
              "discount",
              "balance"
            ],
            "default": "balance",
            "description": "How the gateway orders the discounted sources that can serve this request. `discount`: cheapest first. `speed`: highest recent speed first, measured on this model from the gateway's own traffic (time to first visible output and output tokens per second, weighted towards the last hour); cost breaks ties. `balance` (default): speed score × discount. Speed and discount are NOT a trade-off: the fastest source is often also a cheap one, so `speed` can return the same route as `discount`. Fallback routes are not ranked. They are tried only when no discounted source can serve the request in time. The mode changes the order only, never which sources are eligible. Stripped before forwarding."
          },
          "model": {
            "type": "string"
          },
          "prompt": {
            "type": [
              "string",
              "array"
            ]
          },
          "stream": {
            "type": "boolean"
          },
          "max_tokens": {
            "type": "integer"
          }
        },
        "required": [
          "model",
          "prompt"
        ],
        "additionalProperties": true
      },
      "CompletionResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "usage": {
            "type": "object"
          },
          "request_id": {
            "type": "string",
            "format": "uuid",
            "description": "The id to quote when contacting support about this request."
          },
          "billing": {
            "type": "object",
            "description": "What this request was billed. Present on every successful response.",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "settled",
                  "cached",
                  "failed",
                  "pending"
                ],
                "description": "Customer billing settlement status. pending means the final charge is unknown; inference may have completed successfully."
              },
              "billed_cost_usd": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Fixed 6 decimal places, as a string. Null when the request failed or customer settlement is pending; a settled zero charge is 0.000000.",
                "examples": [
                  "0.000123"
                ]
              },
              "zero_data_retention": {
                "type": "boolean",
                "description": "Request-time zero data retention policy."
              },
              "effective_discount_percent": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Effective discount vs request-time list cost including optimizations; null without a known comparison."
              },
              "currency": {
                "type": "string",
                "enum": [
                  "USD"
                ]
              }
            },
            "required": [
              "status",
              "currency"
            ]
          }
        },
        "required": [
          "id",
          "choices"
        ],
        "additionalProperties": true
      },
      "VideoGenerationRequest": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "examples": [
              "seedance-2.0"
            ]
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "duration_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "duration": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Alias for duration_seconds."
          },
          "resolution": {
            "type": "string"
          },
          "aspect_ratio": {
            "type": "string"
          },
          "audio": {
            "type": "boolean"
          },
          "image_url": {
            "type": "string"
          },
          "input_references": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "n": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "stream": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "zdr": {
            "type": "boolean",
            "description": "Route this request only through providers that support a zero-data-retention policy. A zero-data-retention provider does not keep your prompts or responses and does not train on them. The marketplace and every unverified provider are excluded, so the price is the ZDR price shown by `GET /v1/models?zdr=true`. Adds to the account's Data Protection setting; it cannot lift it. With no qualifying supply the request fails before it is sent upstream with 503 `zdr_capacity_unavailable`. Stripped before forwarding."
          },
          "min_discount_percent": {
            "type": "number",
            "minimum": 0,
            "maximum": 99.99,
            "description": "Price ceiling for this request as a minimum discount off the model's list price (see GET /v1/models pricing.list_*). Only supply priced under list × (1 − d) serves the request, and the bill is capped at that rate. With no qualifying supply the request fails with 503 `min_discount_unavailable` instead of falling back. Stripped before forwarding."
          }
        },
        "required": [
          "model",
          "prompt"
        ],
        "anyOf": [
          {
            "required": [
              "duration_seconds"
            ]
          },
          {
            "required": [
              "duration"
            ]
          }
        ],
        "additionalProperties": true
      },
