    "/v1/responses": {
      "post": {
        "tags": [
          "Responses"
        ],
        "summary": "Create a response",
        "operationId": "createResponse",
        "description": "OpenAI Responses, the surface Codex uses. Stateless: `store` must be `false`, and `previous_response_id` and `conversation` are refused. Replay prior output items in `input` instead. Namespace tools may mix function and custom/freeform entries, including inside `input[].additional_tools`; namespace and call metadata are preserved in buffered and streamed output. Gemini 3 requests using `reasoning_effort: none` fail with code `unsupported_reasoning_effort`. To use Pro, send a POST request to /v1/responses with store: false and reasoning.mode: \"pro\". Set reasoning.effort separately to control how much reasoning the model does. Pro requires the Responses endpoint. Chat Completions returns HTTP 400 for Pro requests. The models gpt-5.6-luna, gpt-5.6-terra, gpt-5.6-sol and gpt-6-astra support Pro mode. Set stream: true to receive output as it arrives, or stream: false to receive one complete response. These models use standard mode when reasoning.mode is omitted. For gpt-5.5-pro, the model ID already selects Pro. Omit reasoning.mode and set stream: false. This model does not support streaming. Your price, provider, region and data-retention settings still apply. The provider must also support the features in your request. If no compatible Pro provider is available, the API returns HTTP 503 without charging you. A provider response that does not confirm Pro is rejected without a charge. Other OpenAI Pro model IDs, model IDs with a date suffix, and Pro reasoning replay are not yet supported. This includes requesting reasoning.encrypted_content. Pro can take longer and use more tokens than standard mode. Billing includes the total input and output tokens used across its model work, so input_tokens can exceed your original prompt's token count. The gpt-5.5-pro model has its own pricing. For streaming requests, read the final event as well as the HTTP status. A stream can start with HTTP 200 and later report an error. Pro streams are charged only when a valid final response confirms Pro and includes token usage.",
        "security": [
          {
            "BearerAuth": []
          },
          {
            "AnthropicApiKey": []
          }
        ],
        "parameters": [
          {
            "name": "x-ci-techniques",
            "in": "header",
            "required": false,
            "description": "Set to off to disable optional workspace techniques for a controlled benchmark. Preserves workspace defaults and billing policy; takes precedence over technique opt-in headers.",
            "schema": {
              "type": "string",
              "enum": [
                "off"
              ]
            }
          },
          {
            "name": "x-ci-prompt-cache",
            "in": "header",
            "required": false,
            "description": "Prompt-cache knob. `passthrough` (default, or the API key's `prompt_cache_mode`) forwards the request unchanged; `on` additionally adds provider cache breakpoints for supported models. For Claude, unmarked requests cache the shared system/tools prefix and growing conversation; caller-supplied cache controls and lifetimes are preserved. `off` removes explicit cache controls, disables sticky affinity for this request and, for models that read a cache marker, prefers routes that forward the body as sent over the marketplace; it does not disable a provider's implicit caching.",
            "schema": {
              "type": "string",
              "enum": [
                "on",
                "off",
                "passthrough"
              ]
            }
          },
          {
            "name": "x-ci-prompt-cache-scope",
            "in": "header",
            "required": false,
            "description": "Sticky-affinity scope: `session` (default), `user`, or `org`. Scopes the affinity key that keeps a repeated prompt prefix on the same upstream provider so its cache stays warm.",
            "schema": {
              "type": "string",
              "enum": [
                "session",
                "user",
                "org"
              ]
            }
          },
          {
            "name": "x-ci-prompt-cache-session",
            "in": "header",
            "required": false,
            "description": "Session id read when the scope is `session`. Send one stable value per conversation or agent run. When absent, a string prompt_cache_key in the request body is used. Without either identifier, the tools, opening system instructions and first conversation message identify the session. Affinity remains isolated to the API key.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-ci-model-lock",
            "in": "header",
            "required": false,
            "description": "Model Lock. Serve exactly the model named in the body: no model-routing technique, no experiment variant and no admission canary may substitute it. Combined with `X-CI-Experiment` (or a forced experiment variant) it is refused with 400 `model_lock_conflict` before anything is read or reserved. If any stage would still change the model, the request is refused with 500 `model_lock_violation` before reaching a model and nothing is billed. Model routing is held off even when the key, the workspace or `x-ci-route` turns it on. `1` or `true` (any case) turns it on; absent or empty leaves it off. Any other value, including `0` and `false`, is refused with 400 `invalid_contract_header` naming the header in `param`, so a typo never silently means off.",
            "schema": {
              "type": "string",
              "enum": [
                "1",
                "true"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResponsesRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "headers": {
              "x-ci-zdr": {
                "description": "Whether zero data retention applied to this request. Absent when no policy was recorded.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "true",
                    "false"
                  ]
                }
              },
              "x-ci-discount-percent": {
                "description": "Quoted customer rate discount versus list, not the final effective savings after usage and optimizations. See usage history for the settled effective discount.",
                "schema": {
                  "type": "string"
                }
              },
              "X-Cheaper-Inference-Request-Id": {
                "description": "Request identifier. Legacy name, still emitted; identical to x-ci-request-id.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "x-ci-request-id": {
                "description": "Request identifier. Canonical going forward.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "x-ci-tokens-saved": {
                "description": "Input tokens removed by the optimizer.",
                "schema": {
                  "type": "string"
                }
              },
              "x-ci-saved-usd": {
                "description": "Total saved against the provider's list price, in USD.",
                "schema": {
                  "type": "string"
                }
              },
              "x-ci-techniques": {
                "description": "Comma-separated ids of the optimization techniques applied. Empty when none were.",
                "schema": {
                  "type": "string"
                }
              },
              "x-ci-cache": {
                "description": "`hit` or `miss` for the exact-match cache.",
                "schema": {
                  "type": "string"
                }
              },
              "x-ci-prompt-cache-affinity": {
                "description": "Sticky prompt-cache outcome (KEA-5164). One of `hit`, `moved`, `new`, `stale`. `hit` means the request was served on the route its conversation was warm on; `moved` means a warm route was remembered but another route served this turn, so its cache was not reused. Present only when the request carried a cacheable prefix and the affinity mode was not off; the exact-match `cache` header covers the separate response cache.",
                "schema": {
                  "type": "string"
                }
              },
              "x-ci-experiment-variant": {
                "description": "Name of the assigned experiment variant. Present only when the request included X-CI-Experiment and matched a running experiment.",
                "schema": {
                  "type": "string"
                }
              },
              "x-ci-routing-overhead-ms": {
                "description": "Elapsed milliseconds from proxy request start to dispatch of the successful provider attempt, including routing and prior attempts. On an exact-match cache hit, measures elapsed proxy processing time before returning the cached response. Present on successful buffered, streaming, and cached responses.",
                "schema": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "x-ci-model-response-ms": {
                "description": "Elapsed milliseconds from dispatch of the successful provider attempt to its complete response body. Present on successful non-streaming responses; absent on streaming responses and when no provider was called.",
                "schema": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "x-ci-warning": {
                "description": "Present when the request was served with a parameter value other than the one sent, because the model does not accept the value sent. Names the parameter, the value sent and the value used. Example: GPT-6 reasoning_effort \"minimal\" is served as \"low\". A request pinned to a provider is refused with 400 unsupported_parameter instead.",
                "schema": {
                  "type": "string"
                }
              },
              "x-ci-stage-timing": {
                "description": "Optional diagnostic timing breakdown, emitted when PROXY_STAGE_TIMING=1 and a request timer is active. Comma-separated stage=milliseconds entries with total first; zero-duration stages are omitted. Stage names depend on the request path.",
                "schema": {
                  "type": "string",
                  "example": "total=1534,auth=258,wallet_hold=128"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponsesResponse"
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "Server-sent events. Set `stream: true` on the request to select this."
                }
              }
            }
          },
          "400": {
            "description": "Malformed request (`type: invalid_request_error`, `code: invalid_request`) Under the client contract also `code: invalid_contract_header` (a bad `x-ci-model-lock` or `x-ci-stream-receipt` value) and `code: model_lock_conflict` (Model Lock combined with an experiment). While the key has an open task budget (`/v1/keys/self/task-budgets`), also `code: task_budget_exhausted` (`param: task_budget`): the request's worst-case charge does not fit what the budget has left, so it was refused before anything was held and nothing was charged. Only with a contract header, when the workspace policy requires a task budget and the key has none open, also `code: task_budget_required` (`param: task_budget`); nothing was held or charged. Only with a contract header, every 402, 403 and 429 refusal on the inference path is answered as this 400 instead, with one of these codes: `code: workspace_monthly_cap_hit` (`param: workspace_monthly_cap`), `code: member_monthly_cap_hit` (`param: member_monthly_cap`), `code: wallet_too_low` (`param: wallet`), `code: wallet_top_up_failed` (`param: wallet`), `code: key_monthly_cap_hit` (`param: key_monthly_cap`), `code: contract_funding_refused`, `code: workspace_membership_ended` (`param: workspace_membership`), `code: key_scope_missing` (`param`: the missing scope), `code: key_network_refused` (`param: key_network`), `code: key_allowlist_refused` (`param: key_allowlist`), `code: key_policy_refused` (`param: key_policy`), `code: provider_policy_block` (`param: end_user`), `code: contract_access_refused`, `code: key_minute_cap_hit` (`param: key_minute_cap`), `code: key_daily_cap_hit` (`param: key_daily_cap`), `code: key_parallel_cap_hit` (`param: key_parallel_cap`), `code: contract_pacing_refused`. Each message starts with a distinct phrase and nothing was charged unless it says otherwise. Without a contract header these refusals keep their usual status and code.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing API key (`type: authentication_error`, `code: invalid_api_key`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "402": {
            "description": "Insufficient wallet balance (`type: invalid_request_error`, `code: insufficient_balance`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "403": {
            "description": "The API key lacks the scope this endpoint requires (`type: permission_denied_error`, `code: permission_denied`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "404": {
            "description": "Not found (`type: invalid_request_error`, `code: not_found`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "408": {
            "description": "Request timed out (`type: invalid_request_error`, `code: request_failed`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "409": {
            "description": "Conflict (`type: invalid_request_error`, `code: conflict`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "413": {
            "description": "Request too large (`type: invalid_request_error`, `code: request_too_large`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "422": {
            "description": "A parameter failed validation (`type: invalid_request_error`, `code: invalid_request`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "425": {
            "description": "Too early (`type: invalid_request_error`, `code: request_failed`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited (`type: rate_limit_error`, `code: rate_limit_exceeded`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "500": {
            "description": "Server error (`type: api_error`, `code: server_error`) Under Model Lock also `code: model_lock_violation`: a stage would have served another model, so the request was refused before reaching any model and nothing was billed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "502": {
            "description": "The upstream provider returned an unusable response (`type: api_error`, `code: upstream_error`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "503": {
            "description": "Service unavailable (`type: api_error`, `code: service_unavailable`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "504": {
            "description": "Upstream timeout (`type: api_error`, `code: upstream_timeout`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/models": {
      "get": {
        "tags": [
          "Models"
        ],
        "summary": "List models",
        "operationId": "listModels",
        "description": "Every model this platform serves, with capabilities and prices. `pricing_version` is a SHA-256 over the list that was returned, so a filtered response validates its own cache and not the unfiltered one.",
        "security": [
          {
            "BearerAuth": []
          },
          {
            "AnthropicApiKey": []
          }
        ],
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "`text` for chat models, `image` for image generation, `video` for video generation, `decision` for decision models served on /v1/decisions.",
            "schema": {
              "type": "string",
              "enum": [
                "text",
                "image",
                "video",
                "decision"
              ]
            }
          },
          {
            "name": "vision",
            "in": "query",
            "required": false,
            "description": "Select models that do or do not accept image input. Accepts 1/true/t/yes/y/on and 0/false/f/no/n/off.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "video",
            "in": "query",
            "required": false,
            "description": "Select models that do or do not accept video input. Accepts 1/true/t/yes/y/on and 0/false/f/no/n/off.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "reasoning",
            "in": "query",
            "required": false,
            "description": "Select models that do or do not reason. Accepts 1/true/t/yes/y/on and 0/false/f/no/n/off.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "streaming",
            "in": "query",
            "required": false,
            "description": "Select models that do or do not stream. Accepts 1/true/t/yes/y/on and 0/false/f/no/n/off.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "zdr",
            "in": "query",
            "required": false,
            "description": "`true` switches to the zero-data-retention view: only models a `zdr: true` request can be served for, priced at what that request pays. `false` (the default) is the standard view, not a filter for models without ZDR supply.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "provider",
            "in": "query",
            "required": false,
            "description": "Exact provider name, compared trimmed and case-insensitively. A prefix does not match.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelList"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request (`type: invalid_request_error`, `code: invalid_request`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing API key (`type: authentication_error`, `code: invalid_api_key`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "402": {
            "description": "Insufficient wallet balance (`type: invalid_request_error`, `code: insufficient_balance`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "403": {
