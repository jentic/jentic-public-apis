            "type": "object",
            "properties": {
              "currency": {
                "type": "string",
                "enum": [
                  "USD"
                ]
              },
              "input_per_million": {
                "type": "string",
                "examples": [
                  "0.700000"
                ]
              },
              "cache_read_input_per_million": {
                "type": "string",
                "description": "Price per million prompt tokens read from the provider cache."
              },
              "cache_write_input_per_million": {
                "type": "string"
              },
              "output_per_million": {
                "type": "string"
              },
              "image_output_per_million": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "media_input_unit_price": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "media_unit_price": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "media_unit": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "resolution_prices": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "reference_resolution_prices": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "image_pricing_unit": {
                "type": "string"
              },
              "discount_percent": {
                "type": "string",
                "examples": [
                  "30.00"
                ]
              },
              "input_token_price_threshold": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "above_threshold": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "Conditional rates for the whole request when total prompt tokens, including cached tokens, exceed the threshold. applies_when states whether the serving supplier must also charge a long-context premium. Customer price caps still apply.",
                "properties": {
                  "input_token_price_threshold": {
                    "type": "integer"
                  },
                  "applies_when": {
                    "type": "string",
                    "enum": [
                      "prompt_tokens_above_threshold",
                      "prompt_tokens_above_threshold_and_supplier_charges_long_context_premium"
                    ]
                  },
                  "input_per_million": {
                    "type": "string"
                  },
                  "cache_read_input_per_million": {
                    "type": "string"
                  },
                  "cache_write_input_per_million": {
                    "type": "string"
                  },
                  "output_per_million": {
                    "type": "string"
                  },
                  "list_input_per_million": {
                    "type": "string"
                  },
                  "list_cache_read_input_per_million": {
                    "type": "string"
                  },
                  "list_cache_write_input_per_million": {
                    "type": "string"
                  },
                  "list_output_per_million": {
                    "type": "string"
                  }
                }
              },
              "source": {
                "type": "string",
                "enum": [
                  "catalog",
                  "marketplace"
                ],
                "description": "Not on the legacy service."
              },
              "list_input_per_million": {
                "type": "string",
                "description": "What the provider charges direct. Not on the legacy service."
              },
              "list_output_per_million": {
                "type": "string"
              },
              "zero_data_retention": {
                "type": "boolean",
                "description": "True in the `?zdr=true` view: the rates are what a request carrying `zdr: true` pays, and only models a zero-data-retention supplier can serve are listed."
              },
              "zero_data_retention_route": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "discounted",
                  "rail_only",
                  "none",
                  null
                ],
                "description": "The model's zero-data-retention tier, in every view: `discounted` (ZDR served from discounted supply), `rail_only` (ZDR served only through a gateway route) or `none` (a `zdr: true` request is refused with 503 `zdr_capacity_unavailable`). Null only when the tier could not be read."
              }
            },
            "required": [
              "currency",
              "input_per_million",
              "output_per_million",
              "discount_percent"
            ]
          }
        },
        "required": [
          "id",
          "object",
          "type",
          "endpoint",
          "supported_endpoints",
          "capabilities",
          "pricing"
        ]
      },
