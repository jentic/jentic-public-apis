    "/v1/uploads/{upload_id}": {
      "delete": {
        "tags": [
          "Uploads"
        ],
        "summary": "Delete a temporary image",
        "operationId": "deleteUpload",
        "description": "Remove an upload before it expires. An id belonging to another account answers 404, exactly as an unknown one does.",
