              },
              "effort": {
                "type": "string",
                "enum": [
                  "none",
                  "minimal",
                  "low",
                  "medium",
                  "high"
                ]
              }
            },
            "additionalProperties": true
          },
          "text": {
            "type": "object"
          }
        },
        "required": [
          "model",
          "store",
          "input"
        ],
        "additionalProperties": true
      },
