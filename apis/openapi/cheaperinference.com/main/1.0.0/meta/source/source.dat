      "DecisionRequest": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "description": "A decision model, such as jev-1.13."
          },
          "input": {
            "description": "The text every question is asked against: a string, or an array of user messages whose content is a string or a list of input_text parts.",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "role": {
                      "type": "string",
                      "enum": [
                        "user"
                      ]
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "message"
                      ],
                      "description": "Optional discriminator; the only accepted value is message."
                    },
                    "content": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "type": "object",
                            "properties": {
                              "type": {
                                "type": "string",
                                "enum": [
                                  "input_text"
                                ]
                              },
                              "text": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "type",
                              "text"
                            ],
                            "additionalProperties": true
                          }
                        }
                      ]
                    }
                  },
                  "required": [
                    "role",
                    "content"
                  ],
                  "additionalProperties": true
                }
              }
            ]
          },
          "questions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "description": "Each question needs a type and instructions. A choice question lists 2 to 255 choices; a score question lists 2 to 10 levels. Names are optional and must be unique.",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/DecisionPredicateQuestion"
                },
                {
                  "$ref": "#/components/schemas/DecisionChoiceQuestion"
                },
                {
                  "$ref": "#/components/schemas/DecisionScoreQuestion"
                }
              ],
              "discriminator": {
                "propertyName": "type",
                "mapping": {
                  "predicate": "#/components/schemas/DecisionPredicateQuestion",
                  "choice": "#/components/schemas/DecisionChoiceQuestion",
                  "score": "#/components/schemas/DecisionScoreQuestion"
                }
              }
            }
          },
          "safety_identifier": {
            "type": [
              "string",
              "null"
            ],
            "description": "Your own id for the end user behind this request. Folded into the upstream safety identity, so a policy block on one end user does not affect your account; the raw value is never forwarded."
          },
          "stream": {
            "type": "boolean",
            "enum": [
              false
            ],
            "description": "Decisions are never streamed; only false or absent is accepted."
          },
          "zdr": {
            "type": "boolean",
            "description": "Require a zero data retention route."
          },
          "min_discount_percent": {
            "type": "number",
            "minimum": 0,
            "maximum": 99.99,
            "description": "Price ceiling for this request as a minimum discount off the model's list price (see GET /v1/models pricing.list_*). Only supply priced under list × (1 − d) serves the request, and the bill is capped at that rate. With no qualifying supply the request fails with 503 `min_discount_unavailable` instead of falling back. Stripped before forwarding."
          }
        },
        "required": [
          "model",
          "input",
          "questions"
        ],
        "additionalProperties": true
      },
      "DecisionPredicateQuestion": {
        "type": "object",
        "description": "A yes or no question, answered with the probability of yes.",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "predicate"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Optional; unique within the request."
          },
          "instructions": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "type",
          "instructions"
        ],
        "additionalProperties": true
      },
      "DecisionChoiceQuestion": {
        "type": "object",
        "description": "A pick from the listed choices, answered with the chosen value and a probability per choice.",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "choice"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Optional; unique within the request."
          },
          "instructions": {
            "type": "string",
            "minLength": 1
          },
          "choices": {
            "type": "array",
            "minItems": 2,
            "maxItems": 255,
            "description": "Distinct values. Values are typed: a string and a boolean with the same text are two choices.",
            "items": {
              "type": "object",
              "properties": {
                "value": {
                  "type": [
                    "string",
                    "boolean"
                  ]
                },
                "description": {
                  "type": "string"
                }
              },
              "required": [
                "value"
              ]
            }
          }
        },
        "required": [
          "type",
          "instructions",
          "choices"
        ],
        "additionalProperties": true
      },
      "DecisionScoreQuestion": {
        "type": "object",
        "description": "A rating on the listed levels, answered with a probability-weighted level index and a probability per level.",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "score"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Optional; unique within the request."
          },
          "instructions": {
            "type": "string",
            "minLength": 1
          },
          "levels": {
            "type": "array",
            "minItems": 2,
            "maxItems": 10,
            "description": "Ordered from lowest to highest.",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              },
              "required": [
                "label"
              ]
            }
          }
        },
        "required": [
          "type",
          "instructions",
          "levels"
        ],
        "additionalProperties": true
      },
      "DecisionResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "answers": {
            "type": "array",
            "description": "One answer per question, in request order. A predicate carries the probability of yes; a choice carries the chosen value, a confidence and a probability per choice; a score carries the probability-weighted level index, a confidence and a probability per level. A question the model declines comes back as type refusal.",
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/DecisionPredicateAnswer"
                },
                {
                  "$ref": "#/components/schemas/DecisionChoiceAnswer"
                },
                {
                  "$ref": "#/components/schemas/DecisionScoreAnswer"
                },
                {
                  "$ref": "#/components/schemas/DecisionRefusalAnswer"
                }
              ],
              "discriminator": {
                "propertyName": "type",
                "mapping": {
                  "predicate": "#/components/schemas/DecisionPredicateAnswer",
                  "choice": "#/components/schemas/DecisionChoiceAnswer",
                  "score": "#/components/schemas/DecisionScoreAnswer",
                  "refusal": "#/components/schemas/DecisionRefusalAnswer"
                }
              }
            }
          },
          "usage": {
            "$ref": "#/components/schemas/DecisionUsage"
          }
        },
        "required": [
          "id",
          "model",
          "answers",
          "usage"
        ],
        "additionalProperties": true
      },
      "DecisionPredicateAnswer": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "predicate"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "The question's name, null for an unnamed question."
          },
          "probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "The probability that the statement holds."
          }
        },
        "required": [
          "type",
          "name",
          "probability"
        ],
        "additionalProperties": true
      },
      "DecisionChoiceAnswer": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "choice"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "The question's name, null for an unnamed question."
          },
          "choice": {
            "type": [
              "string",
              "boolean"
            ],
            "description": "The chosen value, typed as the question offered it."
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "probabilities": {
            "type": "array",
            "description": "One entry per offered choice.",
            "items": {
              "type": "object",
              "properties": {
                "value": {
                  "type": [
                    "string",
                    "boolean"
                  ]
                },
                "probability": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "value",
                "probability"
              ],
              "additionalProperties": true
            }
          }
        },
        "required": [
          "type",
          "name",
          "choice",
          "confidence",
          "probabilities"
        ],
        "additionalProperties": true
      },
      "DecisionScoreAnswer": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "score"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "The question's name, null for an unnamed question."
          },
          "score": {
            "type": "number",
            "description": "The probability-weighted level index, from 0 to the number of levels minus one."
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "probabilities": {
            "type": "array",
            "description": "One entry per level when the model reports them; may be empty.",
            "items": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "integer"
                },
                "label": {
                  "type": "string"
                },
                "probability": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "value",
                "label",
                "probability"
              ],
              "additionalProperties": true
            }
          }
        },
        "required": [
          "type",
          "name",
          "score",
          "confidence",
          "probabilities"
        ],
        "additionalProperties": true
      },
      "DecisionRefusalAnswer": {
        "type": "object",
        "description": "The model declined to answer this question. Other questions in the same request can still receive answers.",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "refusal"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "The question's name, null for an unnamed question."
          }
        },
        "required": [
          "type",
          "name"
        ],
        "additionalProperties": true
      },
      "DecisionUsage": {
        "type": "object",
        "description": "Billed on input tokens; a decision has no cache or reasoning tokens, so the detail counters are zero.",
