        ]
      },
      "WorkspaceAdminPolicyInput": {
        "type": "object",
        "description": "The whole policy, every field present (null for a setting that is not set). Strict: any other field is refused with 400.",
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 0,
            "description": "The `version` that was read. A policy saved since then answers 409."
          },
          "task_limit_default_usd": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{1,5}(\\.\\d{1,6})?$",
            "description": "USD as a string, above 0 and at most 10000, at most 6 decimal places; not above the maximum."
          },
          "task_limit_max_usd": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{1,5}(\\.\\d{1,6})?$",
            "description": "USD as a string, above 0 and at most 10000, at most 6 decimal places."
          },
          "task_budget_required": {
            "type": "boolean"
          },
          "techniques_locked_off": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            },
            "description": "Distinct technique ids from the catalog."
          },
          "prompt_cache_rule": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "on",
              "off",
              "passthrough",
              null
            ]
          }
        },
        "required": [
          "expected_version",
          "task_limit_default_usd",
          "task_limit_max_usd",
          "task_budget_required",
          "techniques_locked_off",
          "prompt_cache_rule"
        ],
        "additionalProperties": false
      },
      "WorkspaceAdminPolicyConflict": {
        "type": "object",
        "description": "The OpenAI error envelope, with the policy as it is now inside `error`.",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "param": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "code": {
                "type": "string",
                "enum": [
                  "workspace_admin_policy_conflict"
                ]
              },
              "current": {
                "$ref": "#/components/schemas/WorkspaceAdminPolicy"
              }
            },
            "required": [
              "message",
              "type",
              "code",
              "current"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "AdminTaskBudget": {
        "type": "object",
        "description": "A task budget in the workspace, as an owner or admin sees it: the member's own view plus whose it is, on which key, and who closed it.",
        "properties": {
          "object": {
            "type": "string",
            "enum": [
              "api_key.task_budget"
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "api_key_id": {
            "type": "string",
            "format": "uuid"
          },
          "task_id": {
            "type": "string",
            "format": "uuid"
          },
          "client": {
            "type": "string",
            "enum": [
              "keak-code"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "closed",
              "expired"
            ],
            "description": "Effective: an open budget past its lease reads `expired`."
          },
          "limit_usd": {
            "type": "string",
            "pattern": "^\\d+\\.\\d{6}$",
            "description": "At most the workspace maximum, when the workspace admin policy sets one."
          },
          "reserved_usd": {
            "type": "string",
            "pattern": "^\\d+\\.\\d{6}$",
            "description": "Held by requests that have not settled."
          },
          "settled_usd": {
            "type": "string",
            "pattern": "^\\d+\\.\\d{6}$",
            "description": "Billed to requests that settled."
          },
          "remaining_usd": {
            "type": "string",
            "pattern": "^\\d+\\.\\d{6}$"
          },
          "reserved_count": {
            "type": "integer",
            "minimum": 0,
            "description": "Requests held, settled or not."
          },
          "settled_count": {
            "type": "integer",
            "minimum": 0
          },
          "opened_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "End of the lease. Renew it with PATCH."
          },
          "closed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "close_reason": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "client",
              "forced",
              "expired",
              "admin",
              null
            ],
            "description": "`forced`: closed by another task with `force: true`. `admin`: closed by a workspace owner or admin."
          },
          "limit_clamped_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "The last time the workspace maximum lowered this budget's limit: at an open, raise or renewal above it, or when the maximum was lowered. Null when it never was. A later raise that fits does not clear it, so it can describe an earlier limit; whether an open or update was clamped is `clamped_to_max` on that answer."
          },
          "read_at": {
            "type": "string",
            "format": "date-time",
            "description": "The server's clock when this was read."
          },
          "requests": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TaskBudgetHold"
            },
            "description": "With `include=requests` only: up to 500 held requests, oldest first."
          },
          "requests_truncated": {
            "type": "boolean",
            "description": "With `include=requests` only."
          },
          "user_id": {
            "type": "string",
            "format": "uuid",
            "description": "The member who opened it."
          },
          "member_email": {
            "type": [
              "string",
              "null"
            ]
          },
          "member_role": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "owner",
              "admin",
              "member",
              "viewer",
              null
            ],
            "description": "Null once the member has left the workspace."
          },
          "api_key_prefix": {
            "type": [
              "string",
              "null"
            ]
          },
          "api_key_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "closed_by_user_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "The owner or admin who closed it (`close_reason: admin`), else null."
          }
        },
        "required": [
          "object",
          "id",
          "api_key_id",
          "task_id",
          "client",
          "status",
          "limit_usd",
          "reserved_usd",
          "settled_usd",
          "remaining_usd",
          "reserved_count",
          "settled_count",
          "opened_at",
          "expires_at",
          "closed_at",
          "close_reason",
          "limit_clamped_at",
          "read_at",
          "user_id",
          "member_email",
          "member_role",
          "api_key_prefix",
          "api_key_name",
          "closed_by_user_id"
        ]
      },
      "AdminTaskBudgetList": {
        "type": "object",
        "properties": {
          "object": {
            "type": "string",
            "enum": [
              "list"
            ]
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminTaskBudget"
            },
            "description": "Newest first."
          },
          "has_more": {
            "type": "boolean",
            "description": "More budgets match than `limit` returned."
          }
        },
        "required": [
          "object",
          "data",
          "has_more"
        ]
      }
    }
  }
}