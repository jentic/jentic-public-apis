    "/v1/keys/{key_id}/task-budgets": {
      "get": {
        "tags": [
          "Keak Code"
        ],
        "summary": "List the calling key's task budgets",
        "operationId": "listTaskBudgets",
        "description": "The key's open task budget (null when none is open and unexpired) and its 20 newest budgets, newest first. A task budget is a spending cap Cheaper Inference enforces on this key while it is open: every inference request the key admits holds its worst-case charge against the budget before any wallet hold, and one that does not fit is refused with 400 `code: task_budget_exhausted`. Enforcement is per key, not per task: every request on the key counts, whichever client sent it, and only requests that reach Cheaper Inference are held. Also the workspace admin policy (`admin_policy`). Requires the `inference` scope; only `self` is accepted as `key_id`. Free: runs no inference.",
        "security": [
          {
            "BearerAuth": []
          },
          {
            "AnthropicApiKey": []
          }
        ],
        "parameters": [
          {
            "name": "key_id",
            "in": "path",
            "required": true,
            "description": "`self`: the API key making the request. Any other value is a 404 in this release.",
            "schema": {
              "type": "string",
              "enum": [
                "self"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskBudgetList"
                }
              }
            }
          },
          "400": {
            "description": "`code: invalid_request` (`param: include`) for an `include` other than `requests`.",
