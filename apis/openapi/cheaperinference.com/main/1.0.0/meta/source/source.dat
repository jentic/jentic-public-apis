                  "failed",
                  "pending"
                ],
                "description": "Customer billing settlement status. pending means the final charge is unknown; inference may have completed successfully."
              },
              "billed_cost_usd": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Fixed 6 decimal places, as a string. Null when the request failed or customer settlement is pending; a settled zero charge is 0.000000.",
                "examples": [
                  "0.000123"
                ]
              },
              "zero_data_retention": {
                "type": "boolean",
                "description": "Request-time zero data retention policy."
              },
              "effective_discount_percent": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "Effective discount vs request-time list cost including optimizations; null without a known comparison."
              },
              "currency": {
                "type": "string",
