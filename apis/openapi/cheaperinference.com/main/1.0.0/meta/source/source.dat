    "/v1/billing/topup": {
      "post": {
        "tags": [
          "Account"
        ],
        "summary": "Start a wallet top-up",
        "operationId": "startTopup",
        "description": "Requires account:write. Creates a Stripe Checkout session and returns its link. Nothing is charged here. The customer completes the payment on Stripe's own page, with the amount in front of them.",
        "security": [
          {
            "BearerAuth": []
          },
          {
