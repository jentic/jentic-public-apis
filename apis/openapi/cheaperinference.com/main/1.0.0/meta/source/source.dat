        ]
      },
      "WorkspaceAdminPolicy": {
        "type": "object",
        "description": "Five settings on a workspace that its owners and admins edit and that bind everyone in it, owners and admins included. Personal keys are outside it.",
        "properties": {
          "object": {
            "type": "string",
            "enum": [
              "workspace.admin_policy"
            ]
          },
          "organization_id": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "minimum": 0,
            "description": "Goes up by one on every save. Send it back as `expected_version` to change the policy."
          },
          "task_limit": {
            "type": "object",
            "properties": {
              "default_usd": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^\\d+\\.\\d{6}$",
                "description": "The task limit Keak Code starts a task with. Advisory: the server does not enforce it."
              },
              "max_usd": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^\\d+\\.\\d{6}$",
                "description": "Every task budget opened, raised or renewed on a workspace key is clamped to this, never refused; lowering it lowers every open budget above it."
              },
              "required": {
                "type": "boolean",
                "description": "Keak Code contract requests (with `x-ci-model-lock` or `x-ci-stream-receipt`) are refused with 400 `code: task_budget_required` while their key has no open task budget. Other traffic on the same key is never refused for this. The shipped Keak Code beta (0.1.0) opens no budget in its `local` task-limit mode, so every request it sends from that mode is refused: have members update Keak Code before turning this on."
              }
            },
            "required": [
              "default_usd",
              "max_usd",
              "required"
            ]
          },
          "techniques_locked_off": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Technique ids that never run on this workspace's traffic, whatever a key, the workspace setting, a header or an experiment asks; a receipt lists them as `skipped` with reason `workspace_policy`. Sorted and distinct."
          },
          "prompt_cache_rule": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "on",
              "off",
              "passthrough",
              null
            ],
            "description": "Overrides the `x-ci-prompt-cache` header and every key's default. Zero data retention still forces `off`. Null: no rule."
          },
          "updated_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Null until the policy is first saved."
          }
        },
        "required": [
          "object",
          "organization_id",
          "version",
          "task_limit",
          "techniques_locked_off",
          "prompt_cache_rule",
          "updated_at"
        ]
      },
      "WorkspaceAdminPolicyView": {
        "type": "object",
        "description": "The workspace admin policy, and whether the caller may change it.",
        "properties": {
          "object": {
            "type": "string",
            "enum": [
              "workspace.admin_policy"
            ]
          },
