              "null"
            ]
          },
          "tools": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ResponsesTool"
            }
          },
          "tool_choice": {},
          "parallel_tool_calls": {
            "type": "boolean"
          },
          "reasoning_effort": {
            "type": "string",
            "enum": [
              "none",
              "minimal",
              "low",
              "medium",
              "high"
            ],
            "description": "Alias for reasoning.effort. Supplying conflicting values is a 400. Gemini 3 does not support `none` and returns `unsupported_reasoning_effort`."
          },
          "reasoning": {
            "type": [
              "object",
              "null"
            ],
            "description": "Set mode and effort separately. For gpt-5.5-pro, the model ID selects Pro, so omit mode.",
            "properties": {
              "mode": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "standard",
                  "pro",
                  null
                ],
