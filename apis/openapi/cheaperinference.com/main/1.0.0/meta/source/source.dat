    "/v1/usage/daily": {
      "get": {
        "tags": [
          "Usage"
        ],
        "summary": "Daily spend",
        "operationId": "getDailyUsage",
        "description": "Daily spend for the calling workspace, defaulting to the last 30 days and zero-filled across the range so a chart does not close gaps. Requires the `usage:read` scope. Only settled requests contribute to spend.",
        "security": [
          {
            "BearerAuth": []
