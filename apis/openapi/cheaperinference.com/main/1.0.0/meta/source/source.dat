                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "503": {
            "description": "`code: task_budget_unavailable`: the budget could not be read or changed, including on a deployment whose database does not have the task budget migration yet. Safe to retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "504": {
            "description": "Upstream timeout (`type: api_error`, `code: upstream_timeout`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/keys/{key_id}/task-budgets/{budget_id}/close": {
      "post": {
        "tags": [
          "Keak Code"
        ],
        "summary": "Close a task budget",
        "operationId": "closeTaskBudget",
        "description": "Close the budget now; requests on the key are no longer held by it. Requests it already held stay counted and settle into it later. Idempotent: a closed or expired budget is answered as it is. Closing another task's budget needs `force: true`.",
        "security": [
          {
            "BearerAuth": []
          },
          {
            "AnthropicApiKey": []
          }
        ],
        "parameters": [
          {
            "name": "key_id",
            "in": "path",
            "required": true,
            "description": "`self`: the API key making the request. Any other value is a 404 in this release.",
            "schema": {
              "type": "string",
              "enum": [
                "self"
              ]
            }
          },
          {
            "name": "budget_id",
            "in": "path",
            "required": true,
            "description": "A budget of the calling key. Another key's budget id answers 404, like one that does not exist.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TaskBudgetCloseRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskBudget"
                }
              }
            }
          },
          "400": {
            "description": "Malformed body (`code: invalid_request`), with `param` naming the field: not a JSON object, an unknown field, `task_id` not a UUID, `limit_usd` not a decimal string with at most 6 places above 0 and at most 10000 (an exponent or a JSON number is refused), `expires_in_s` not a whole number from 60 to 86400, or `force` not a boolean.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing API key (`type: authentication_error`, `code: invalid_api_key`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "402": {
            "description": "Insufficient wallet balance (`type: invalid_request_error`, `code: insufficient_balance`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "403": {
            "description": "`code: insufficient_scope` when the key lacks `inference` (`param` is the scope). `code: api_key_required` for a caller with no API key behind it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "404": {
            "description": "`code: api_key_not_found`: `key_id` is not `self`, or the key was revoked or expired. `code: task_budget_not_found` (`param: budget_id`): no such budget on this key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "408": {
            "description": "Request timed out (`type: invalid_request_error`, `code: request_failed`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "409": {
            "description": "`code: delegated_api_key`: a temporary Prompt Studio key authenticates as its parent, so `self` would describe another key. `code: task_budget_task_mismatch`: another task's budget and no `force`, in `error.active`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskBudgetError"
                }
              }
            }
          },
          "413": {
            "description": "Request too large (`type: invalid_request_error`, `code: request_too_large`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "422": {
            "description": "A parameter failed validation (`type: invalid_request_error`, `code: invalid_request`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "425": {
            "description": "Too early (`type: invalid_request_error`, `code: request_failed`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited (`type: rate_limit_error`, `code: rate_limit_exceeded`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "500": {
            "description": "Server error (`type: api_error`, `code: server_error`)",
