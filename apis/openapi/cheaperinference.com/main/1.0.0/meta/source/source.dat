    "/v1/usage/attributions": {
      "post": {
        "tags": [
          "Keak Code"
        ],
        "summary": "Attribute your requests to a task",
        "operationId": "createUsageAttribution",
        "description": "Tag requests made with the calling key with a client task, an opaque project id and the client name. Requires the `inference` scope (describing your own traffic is part of sending it); only an API key authenticates here. All or nothing: every listed request must belong to the calling key and its actor, otherwise nothing is written. A tag never changes once written: a different task, project or client for an already tagged request is a 409, and repeating an identical post is a no-op that counts the ids as `unchanged`. The tag is read back as `attribution` on `GET /v1/usage/requests`.",
        "security": [
          {
            "BearerAuth": []
          },
          {
            "AnthropicApiKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UsageAttributionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsageAttribution"
                }
              }
            }
          },
          "400": {
            "description": "Malformed body (`code: invalid_request`), with `param` naming the field: not JSON, an unknown field, `task_id` not a UUID, `project_id` not null or 16 to 64 characters of A-Z, a-z, 0-9, `_` or `-`, `client` other than `keak-code`, or `request_ids` not 1 to 100 UUIDs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing API key (`type: authentication_error`, `code: invalid_api_key`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "402": {
            "description": "Insufficient wallet balance (`type: invalid_request_error`, `code: insufficient_balance`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "403": {
            "description": "`code: insufficient_scope` when the key lacks `inference` (`param` is the scope).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "404": {
            "description": "`code: request_not_found`: some listed requests were not made with the calling key, do not exist, or are older than the 45-day per-request retention window; the three are indistinguishable. They are listed in `error.missing_request_ids`, inside the `error` object. Nothing was written.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsageAttributionError"
                }
              }
            }
          },
          "408": {
            "description": "Request timed out (`type: invalid_request_error`, `code: request_failed`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "409": {
            "description": "`code: attribution_conflict`: some listed requests already carry a different task, project or client, listed in `error.conflicting_request_ids`. Nothing was written for them; a tag never changes once written.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsageAttributionError"
                }
              }
            }
          },
          "413": {
            "description": "Request too large (`type: invalid_request_error`, `code: request_too_large`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "422": {
            "description": "A parameter failed validation (`type: invalid_request_error`, `code: invalid_request`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "425": {
            "description": "Too early (`type: invalid_request_error`, `code: request_failed`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited (`type: rate_limit_error`, `code: rate_limit_exceeded`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "500": {
            "description": "Server error (`type: api_error`, `code: server_error`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "502": {
            "description": "The upstream provider returned an unusable response (`type: api_error`, `code: upstream_error`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "503": {
            "description": "`code: attribution_unavailable`: the attribution could not be read or recorded, including before the request_tags migration is applied. Safe to retry: the post is idempotent.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "504": {
            "description": "Upstream timeout (`type: api_error`, `code: upstream_timeout`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/usage/task-outcomes": {
      "post": {
        "tags": [
          "Keak Code"
        ],
        "summary": "Report a completed task",
        "operationId": "createUsageTaskOutcome",
        "description": "Record that a task the calling key already attributed (`POST /v1/usage/attributions`) was completed. Requires the `inference` scope; only an API key authenticates here. `completed` is the only outcome recorded: a Keak Code task can be resumed after it failed or was cancelled, so those are not final. Idempotent: repeating it answers 200 with `created: false`. The workspace is copied from the task's tags and the member from the key. Team Savings reads it as \"completed tasks, as reported by Keak Code\".",
        "security": [
          {
            "BearerAuth": []
          },
          {
            "AnthropicApiKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UsageTaskOutcomeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsageTaskOutcome"
                }
              }
            }
          },
          "400": {
            "description": "Malformed body (`code: invalid_request`), with `param` naming the field: not JSON, an unknown field, `task_id` not a UUID, `outcome` other than `completed`, or `client` other than `keak-code`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing API key (`type: authentication_error`, `code: invalid_api_key`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "402": {
            "description": "Insufficient wallet balance (`type: invalid_request_error`, `code: insufficient_balance`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "403": {
            "description": "`code: insufficient_scope` when the key lacks `inference` (`param` is the scope).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "404": {
            "description": "`code: task_not_found` (`param: task_id`): no request made with the calling key is tagged with this task. Attribute the requests first (`POST /v1/usage/attributions`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "408": {
            "description": "Request timed out (`type: invalid_request_error`, `code: request_failed`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "409": {
            "description": "`code: task_spans_workspaces` (`param: task_id`): the task's requests are tagged in more than one workspace, so the outcome is not recorded.",
            "content": {
