    "/public/models": {
      "get": {
        "tags": [
          "Models"
        ],
        "summary": "List models (public)",
        "operationId": "listPublicModels",
        "description": "The advertised catalog, with live prices, and NO API KEY. This is what the marketing pages and any other surface that cannot hold a key read. Prices are resolved by the same rule that bills a request, so a quote here and the charge cannot disagree. `/v1/models` covers the same catalog for authenticated clients and adds marketplace-only models.",
        "security": [],
        "responses": {
          "200": {
            "description": "The catalog.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicModelCatalog"
                }
              }
            }
          },
          "503": {
            "description": "The catalog could not be read. No prices are served rather than stale ones.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DetailError"
                }
              }
            }
          }
        }
      }
    },
    "/public/models/{model_id}": {
      "get": {
        "tags": [
          "Models"
        ],
        "summary": "Get one model (public)",
        "operationId": "getPublicModel",
        "description": "One catalog entry. The id may contain slashes (`google/gemini-3.5-flash-lite`) and is matched exactly, including case.",
        "security": [],
        "parameters": [
          {
            "name": "model_id",
            "in": "path",
            "required": true,
            "description": "Model id. May contain `/`.",
            "schema": {
              "type": "string"
            },
            "examples": {
              "simple": {
                "value": "claude-opus-5"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The model.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicModel"
                }
              }
            }
          },
          "404": {
            "description": "No such model, or it is not currently advertised.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DetailError"
                }
              }
            }
          },
          "503": {
            "description": "The catalog could not be read. No prices are served rather than stale ones.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DetailError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/usage/requests": {
      "get": {
        "tags": [
          "Usage"
        ],
        "summary": "List requests",
        "operationId": "listUsageRequests",
        "description": "Per-request history for the calling workspace, newest first. Requires the `usage:read` scope. `cursor` is opaque and comes from the previous page's `next_cursor`; do not parse it. With `request_ids`, the named requests are returned instead of a page: `has_more` is false, `next_cursor` is null and `missing_request_ids` lists the ids that did not come back.",
        "security": [
          {
            "BearerAuth": []
          },
          {
            "AnthropicApiKey": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 100
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Opaque cursor from the previous page.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "request_ids",
            "in": "query",
            "required": false,
            "description": "Comma-separated request ids (1 to 100 UUIDs) to look up directly, for a client reconciling its own receipts. Deduplicated and compared case-insensitively. A malformed list or more than 100 entries is a 422 naming the parameter; combining it with `cursor` is a 400. The other filters still apply. Ids that do not exist, ids that are not the caller's, and ids whose detail has passed the 45-day per-request retention window are all reported in `missing_request_ids`, deliberately indistinguishable. A client reconciling receipts older than that window should expect them here rather than treat their absence as a request we never served.",
            "style": "form",
            "explode": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              },
              "minItems": 1,
              "maxItems": 100
            }
          },
          {
            "name": "start_at",
            "in": "query",
            "required": false,
            "description": "Inclusive lower bound. A value with no offset is read as UTC.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "end_at",
            "in": "query",
            "required": false,
            "description": "Exclusive upper bound.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "api_key_id",
            "in": "query",
            "required": false,
            "description": "Limit to one key in the calling workspace. A key outside it is a 404, not an empty list.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsageRequestList"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request (`type: invalid_request_error`, `code: invalid_request`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing API key (`type: authentication_error`, `code: invalid_api_key`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "402": {
            "description": "Insufficient wallet balance (`type: invalid_request_error`, `code: insufficient_balance`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "403": {
            "description": "The API key lacks the scope this endpoint requires (`type: permission_denied_error`, `code: permission_denied`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "404": {
            "description": "Not found (`type: invalid_request_error`, `code: not_found`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "408": {
            "description": "Request timed out (`type: invalid_request_error`, `code: request_failed`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "409": {
            "description": "Conflict (`type: invalid_request_error`, `code: conflict`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "413": {
            "description": "Request too large (`type: invalid_request_error`, `code: request_too_large`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "422": {
            "description": "A parameter failed validation (`type: invalid_request_error`, `code: invalid_request`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "425": {
            "description": "Too early (`type: invalid_request_error`, `code: request_failed`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
