    "/v1/embeddings": {
      "post": {
        "tags": [
          "Embeddings"
        ],
        "summary": "Create embeddings",
        "operationId": "createEmbedding",
        "description": "Turn text, or token ids, into vectors. OpenAI Embeddings API shape; the OpenAI SDKs work with only a base URL change. Billed on the input tokens the model counts. Streaming is not supported. Embedding models have type embedding in GET /v1/models.",
        "security": [
          {
            "BearerAuth": []
          },
          {
            "AnthropicApiKey": []
          }
        ],
