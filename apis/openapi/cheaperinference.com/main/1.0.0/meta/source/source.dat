    "/v1/docs": {
      "get": {
        "tags": [
          "Docs"
        ],
        "summary": "Search the documentation",
        "operationId": "searchDocs",
        "description": "With `q`, the matching sections in full, best match first. Without it, the table of contents includes every section's id, title, category and link without bodies. A client can see what exists before choosing what to read. Needs a valid key and no scope: this is the same text served at /docs.",
        "security": [
          {
            "BearerAuth": []
          },
          {
            "AnthropicApiKey": []
          }
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "What to look up. Keywords beat sentences: the corpus is a couple of dozen sections and matching is on titles, keywords and body text.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum sections to return. Ignored without `q`.",
