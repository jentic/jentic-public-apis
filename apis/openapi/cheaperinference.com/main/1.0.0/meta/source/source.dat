    "/v1/account/workspace-policy": {
      "get": {
        "tags": [
          "Account"
        ],
        "summary": "Read the workspace admin policy",
        "operationId": "getWorkspaceAdminPolicy",
        "description": "The admin policy of the calling key's workspace, and `can_edit` (owner or admin). Five settings bind every member, owners and admins included: a maximum task limit that clamps every task budget, an advisory default task limit, whether Keak Code contract requests need an open task budget, techniques locked off, and a prompt-cache rule. Requires `account:read`; any member may read it. Free: runs no inference.",
        "security": [
          {
            "BearerAuth": []
          },
          {
            "AnthropicApiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceAdminPolicyView"
                }
              }
            }
          },
          "400": {
