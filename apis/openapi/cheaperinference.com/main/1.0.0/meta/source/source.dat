          "enabled_technique_count"
        ]
      },
      "SecurityStrikeRequest": {
        "type": "object",
        "required": [
          "tool",
          "kind",
          "detail"
        ],
        "properties": {
          "tool": {
            "type": "string",
            "maxLength": 80,
            "description": "The MCP tool that was called.",
            "examples": [
              "search_docs"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "injection",
              "escalation",
              "policy",
              "unauthorized",
              "forbidden"
            ],
            "description": "What was refused. `injection`, `escalation` and `policy` are refusals the MCP server issued itself and each count as a strike; `unauthorized` (401) and `forbidden` (403) are API denials and count once per distinct `detail`."
          },
          "detail": {
            "type": "string",
            "maxLength": 200,
            "description": "A short stable code for the reason. Never the offending text.",
            "examples": [
              "search_docs:query:injection",
              "403:insufficient_scope:API key scope required: account:read."
            ]
          }
        }
      },
      "SecurityStanding": {
        "type": "object",
        "properties": {
          "object": {
            "type": "string",
            "enum": [
              "security.standing"
            ]
          },
          "tier": {
            "type": "string",
            "enum": [
              "clear",
              "warn",
              "blocked"
            ]
          },
          "strikes": {
            "type": "integer",
            "description": "Distinct strikes in the current window. This is what the tiers compare against."
          },
          "attempts": {
            "type": "integer",
            "description": "Every denied call in the window, duplicates included."
          },
          "remaining": {
            "type": "integer",
            "description": "Strikes left before the block. 0 while blocked."
          },
          "warn_after": {
            "type": "integer"
          },
          "block_after": {
            "type": "integer",
            "description": "The daily limit."
          },
          "window_hours": {
            "type": "integer"
          },
          "blocked_until": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When a timed block lifts. Null when not blocked, and null when the block is permanent. See `permanent`."
          },
          "permanent": {
            "type": "boolean",
            "description": "True for a block with no expiry: the daily limit was reached again within the repeat window of an earlier block. Only an admin lifts it."
          },
          "prior_blocks": {
            "type": "integer",
            "description": "Earlier blocks on record that ran their course. One or more means the next block is permanent. A block an admin lifted does not count."
          },
          "ban_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "suspension_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "report_url": {
            "type": "string",
            "format": "uri",
            "description": "Where to appeal."
          },
          "reported": {
            "type": "boolean",
            "description": "True when this call filed the automatic support report for the account."
          }
        },
        "required": [
          "object",
          "tier",
          "strikes",
          "attempts",
          "remaining",
          "warn_after",
          "block_after",
          "window_hours",
          "blocked_until",
          "permanent",
          "prior_blocks",
          "ban_id",
          "suspension_id",
          "report_url",
          "reported"
        ]
      },
