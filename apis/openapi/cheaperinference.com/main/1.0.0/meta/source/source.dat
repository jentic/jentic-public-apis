    "/v1/security/strikes": {
      "post": {
        "tags": [
          "Account"
        ],
        "summary": "Record a refused request against the calling account",
        "operationId": "recordSecurityStrike",
        "description": "Reported by the MCP server when it refuses a call. `injection`, `escalation` and `policy` describe hostile arguments and trigger a permanent ban on the first occurrence, across every surface, not only the account API. `unauthorized` and `forbidden` describe a credential rather than an intent (a rotated key, a missing scope), so they are accepted and have no consequence. There is no rolling window, no warning tier and no escalation ladder. No scope is required. Returns the account's standing, and files a support ticket on the account's behalf so a block has somewhere to be contested.",
        "security": [
          {
            "BearerAuth": []
          },
          {
            "AnthropicApiKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
