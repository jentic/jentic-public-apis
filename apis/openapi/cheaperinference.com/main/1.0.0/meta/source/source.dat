          "label",
          "unattributed",
          "current_member"
        ]
      },
      "TeamSavings": {
        "type": "object",
        "properties": {
          "object": {
            "type": "string",
            "enum": [
              "usage.team_savings"
            ]
          },
          "version": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "generated_at": {
            "type": "string",
            "format": "date-time"
          },
          "currency": {
            "type": "string",
            "enum": [
              "USD"
            ]
          },
          "viewer": {
            "type": "object",
            "properties": {
              "user_id": {
                "type": "string",
                "format": "uuid"
              },
              "role": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The caller's workspace role; null for a personal key."
              },
              "can_view_team": {
                "type": "boolean",
                "description": "Whether `scope=team` is open to the caller's role."
              }
            },
            "required": [
              "user_id",
              "role",
              "can_view_team"
            ]
          },
          "scope": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "self",
                  "team",
                  "team_partial",
                  "personal"
                ],
                "description": "`team_partial`: the caller's grant shares only some members, so the report covers those members and the caller. `personal`: a key with no workspace."
              },
              "organization_id": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uuid"
              }
            },
            "required": [
              "kind",
              "organization_id"
            ]
          },
          "period": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "format": "date"
              },
              "to": {
                "type": "string",
                "format": "date"
              },
              "start_at": {
                "type": "string",
                "format": "date-time",
                "description": "Inclusive."
              },
              "end_at": {
                "type": "string",
                "format": "date-time",
                "description": "Exclusive: the day after `to`."
              },
              "time_zone": {
                "type": "string",
                "enum": [
                  "UTC"
                ]
              }
            },
            "required": [
              "from",
              "to",
              "start_at",
              "end_at",
              "time_zone"
            ]
          },
          "filters": {
            "type": "object",
            "properties": {
              "member_ids": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "project_ids": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                }
              },
              "models": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "member_ids",
              "project_ids",
              "models"
            ]
          },
          "group_by": {
            "type": "string",
            "enum": [
              "member",
              "project",
              "model"
            ]
          },
          "baseline": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "enum": [
                  "same_model_list_price_v1"
                ]
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "description"
            ]
          },
          "totals": {
            "$ref": "#/components/schemas/TeamSavingsSummary"
          },
          "groups": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TeamSavingsGroup"
            },
            "description": "Highest spend first."
          },
          "group_count": {
            "type": "integer",
            "minimum": 0,
            "description": "How many groups exist."
          },
          "groups_truncated": {
            "type": "boolean",
            "description": "True when more than 500 groups exist."
          }
        },
        "required": [
          "object",
          "version",
          "generated_at",
          "currency",
          "viewer",
          "scope",
          "period",
          "filters",
          "group_by",
          "baseline",
          "totals",
          "groups",
          "group_count",
          "groups_truncated"
        ]
      },
      "TeamSavingsRequest": {
        "type": "object",
        "description": "A request record. No prompt, response or request body.",
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "member_id": {
            "type": "string",
            "format": "uuid",
            "description": "The owner of the key that sent it."
          },
          "member_label": {
            "type": [
              "string",
              "null"
            ],
            "description": "Their email while they are a member of the workspace."
          },
          "model": {
            "type": "string"
          },
          "billing_status": {
            "type": "string",
            "enum": [
              "settled",
              "cached",
              "failed",
              "pending"
            ],
            "description": "As on `GET /v1/usage/requests`: a charged failure is `settled`."
          },
          "actual_usd": {
            "type": [
              "string",
              "null"
            ],
            "description": "Null only while pending."
          },
          "baseline_usd": {
            "type": [
              "string",
              "null"
            ],
            "description": "Null when the list price is unknown or nothing was charged."
          },
          "savings_usd": {
            "type": [
              "string",
              "null"
            ],
            "description": "Null when not comparable. May be negative."
          },
          "comparable": {
            "type": "boolean"
          },
          "attribution": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/UsageRequestAttribution"
              },
              {
                "type": "null"
              }
            ]
          },
          "task_outcome": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "completed",
              null
            ]
          }
        },
        "required": [
          "request_id",
          "created_at",
          "member_id",
          "member_label",
          "model",
          "billing_status",
          "actual_usd",
          "baseline_usd",
          "savings_usd",
          "comparable",
          "attribution",
          "task_outcome"
        ]
      },
      "TeamSavingsRequestList": {
        "type": "object",
        "properties": {
          "object": {
            "type": "string",
            "enum": [
              "list"
            ]
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TeamSavingsRequest"
            }
          },
          "has_more": {
            "type": "boolean"
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "object",
          "data",
          "has_more",
          "next_cursor"
        ]
      },
      "KeyTechniqueProfile": {
        "type": "object",
        "properties": {
          "object": {
            "type": "string",
            "enum": [
              "api_key.technique_profile"
            ]
          },
          "api_key_id": {
            "type": "string",
            "format": "uuid"
          },
          "api_key_prefix": {
            "type": "string"
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "monthly_spend_limit_usd": {
            "type": [
              "string",
              "null"
            ],
            "description": "Fixed 6 decimal places, as a string. Null when the key has no limit."
          },
          "prompt_cache_mode": {
            "type": "string",
            "enum": [
              "on",
              "off",
              "passthrough"
            ],
            "description": "The key's stored default; a workspace `prompt_cache_rule` overrides it. A request's `x-ci-prompt-cache` header overrides it too, and zero data retention forces `off`; the receipt reports the mode that applied."
          },
          "prompt_cache_mode_effective": {
            "type": "string",
            "enum": [
              "on",
              "off",
              "passthrough"
            ],
            "description": "The mode a request without a cache header runs under: `off` when the account has zero data retention or a pinned region, else the workspace's `prompt_cache_rule`, else `prompt_cache_mode`. A request's own `zdr` field can still force `off`; the receipt reports what applied."
          },
          "admin_policy": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/WorkspaceAdminPolicy"
              },
              {
                "type": "null"
              }
            ],
            "description": "The workspace admin policy: the object for a workspace key, null for a personal key (no policy applies), and absent when this deployment's database does not have the policy yet."
          },
          "workspace_policy": {
            "type": "object",
            "description": "Deprecated, always false; see `admin_policy`.",
            "properties": {
              "enforced": {
                "type": "boolean",
                "enum": [
                  false
                ]
              },
              "supported": {
                "type": "boolean",
                "enum": [
                  false
                ]
              }
            },
            "required": [
              "enforced",
              "supported"
            ]
          },
          "profile_match": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "coding-safe-v1",
              null
            ],
            "description": "`coding-safe-v1` when every implemented technique has a current explicit off override on this key, otherwise null."
          },
          "techniques": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/KeyTechniqueProfileEntry"
            }
          },
          "contract": {
            "type": "object",
            "properties": {
              "receipt_version": {
                "type": "integer",
                "enum": [
                  1
                ]
              }
            },
            "required": [
              "receipt_version"
            ]
          },
          "read_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "object",
          "api_key_id",
          "api_key_prefix",
          "scopes",
          "monthly_spend_limit_usd",
          "prompt_cache_mode",
          "prompt_cache_mode_effective",
          "workspace_policy",
          "profile_match",
          "techniques",
          "contract",
          "read_at"
        ]
      },
      "KeyTechniqueProfileEntry": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The technique slug."
          },
          "name": {
            "type": "string"
          },
          "available": {
            "type": "boolean"
          },
          "unavailable_reason": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "not_in_catalog",
              "not_released",
              null
            ]
          },
          "key_override": {
            "type": "string",
            "enum": [
              "on",
              "off",
              "inherit"
            ]
          },
          "key_override_current": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Null when the key has no override. False when a technique release demanded re-confirmation after the override was written, so it no longer counts."
          },
          "workspace": {
            "type": "string",
            "enum": [
              "on",
              "off"
            ]
          },
          "workspace_explicit": {
            "type": "boolean"
          },
          "effective": {
            "type": "boolean",
            "description": "What a request with this key gets."
          },
          "source": {
            "type": "string",
            "enum": [
              "key",
              "workspace",
              "default",
              "unavailable"
            ]
          },
          "request_header_can_force_on": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Request headers that can turn this technique on for one request."
          },
          "disabled_by_model_lock": {
            "type": "boolean",
            "description": "True for `model-routing`, which `x-ci-model-lock` always holds off."
          },
          "layer": {
            "type": "string",
            "enum": [
              "cheaper_inference"
            ]
          },
          "locked_by_workspace": {
            "type": "boolean",
            "description": "The workspace admin policy locks this technique off: it never runs on this key's requests, so `effective` is false and no header can force it on. `available`, `source` and `key_override` are unchanged."
          }
        },
        "required": [
          "id",
          "name",
          "available",
          "unavailable_reason",
          "key_override",
          "key_override_current",
          "workspace",
          "workspace_explicit",
          "effective",
          "source",
          "request_header_can_force_on",
          "disabled_by_model_lock",
          "layer",
          "locked_by_workspace"
        ]
      },
      "KeyTechniqueProfileUpdate": {
        "type": "object",
        "description": "Strict and non-empty: send at least one field; any other field is refused.",
        "properties": {
          "profile": {
            "type": "string",
            "enum": [
              "coding-safe-v1"
            ],
            "description": "An explicit off override for every implemented technique."
          },
          "techniques": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "enum": [
                "off",
                "inherit",
                "on"
              ]
            },
            "description": "Technique id to state, applied on top of `profile`. `on` is always refused with 403, and `inherit` while the workspace has the technique on."
          },
          "prompt_cache_mode": {
            "type": "string",
            "enum": [
              "on",
              "off",
              "passthrough"
            ]
          }
        },
        "additionalProperties": false,
        "minProperties": 1
      },
      "TaskBudget": {
        "type": "object",
        "description": "A task budget on one API key. Money is USD as strings with exactly 6 decimal places. `limit_usd - reserved_usd - settled_usd` is what is left (`remaining_usd`, never below 0). A held request counts its worst-case charge in `reserved_usd` until it settles, then its billed amount in `settled_usd`; a request that was not billed (a failure, or no usage reported) settles at 0. On a workspace key the workspace admin policy's maximum caps `limit_usd`: an open, raise or renewal above it lands at it, and lowering the maximum lowers every open budget above it (`limit_clamped_at`).",
        "properties": {
          "object": {
            "type": "string",
            "enum": [
              "api_key.task_budget"
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "api_key_id": {
            "type": "string",
            "format": "uuid"
          },
          "task_id": {
            "type": "string",
            "format": "uuid"
          },
          "client": {
            "type": "string",
            "enum": [
              "keak-code"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "closed",
              "expired"
            ],
            "description": "Effective: an open budget past its lease reads `expired`."
          },
          "limit_usd": {
            "type": "string",
            "pattern": "^\\d+\\.\\d{6}$",
            "description": "At most the workspace maximum, when the workspace admin policy sets one."
          },
          "reserved_usd": {
            "type": "string",
            "pattern": "^\\d+\\.\\d{6}$",
            "description": "Held by requests that have not settled."
          },
          "settled_usd": {
            "type": "string",
            "pattern": "^\\d+\\.\\d{6}$",
            "description": "Billed to requests that settled."
          },
          "remaining_usd": {
            "type": "string",
            "pattern": "^\\d+\\.\\d{6}$"
          },
          "reserved_count": {
            "type": "integer",
            "minimum": 0,
            "description": "Requests held, settled or not."
          },
          "settled_count": {
            "type": "integer",
            "minimum": 0
          },
          "opened_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "End of the lease. Renew it with PATCH."
          },
          "closed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "close_reason": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "client",
              "forced",
              "expired",
              "admin",
              null
            ],
            "description": "`forced`: closed by another task with `force: true`. `admin`: closed by a workspace owner or admin."
          },
          "limit_clamped_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "The last time the workspace maximum lowered this budget's limit: at an open, raise or renewal above it, or when the maximum was lowered. Null when it never was. A later raise that fits does not clear it, so it can describe an earlier limit; whether an open or update was clamped is `clamped_to_max` on that answer."
          },
          "read_at": {
            "type": "string",
            "format": "date-time",
            "description": "The server's clock when this was read."
          },
          "replayed": {
            "type": "boolean",
            "description": "On the open only: true when this task's budget with this limit (after the clamp) was already open."
          },
          "clamped_to_max": {
            "type": "boolean",
            "description": "On the open and the update only: true when the limit asked for was above the workspace maximum, so `limit_usd` is the maximum instead. Never a refusal."
          },
          "requests": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TaskBudgetHold"
            },
            "description": "With `include=requests` only: up to 500 held requests, oldest first."
          },
          "requests_truncated": {
            "type": "boolean",
            "description": "With `include=requests` only."
          }
        },
        "required": [
          "object",
          "id",
          "api_key_id",
          "task_id",
          "client",
          "status",
          "limit_usd",
          "reserved_usd",
          "settled_usd",
          "remaining_usd",
          "reserved_count",
          "settled_count",
          "opened_at",
          "expires_at",
          "closed_at",
          "close_reason",
          "limit_clamped_at",
          "read_at"
        ]
      },
      "TaskBudgetHold": {
        "type": "object",
        "description": "One request held by the budget. Every request on the key counts, whichever client sent it; compare the ids with your own to find requests you did not send.",
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "reserved_usd": {
            "type": "string",
            "pattern": "^\\d+\\.\\d{6}$",
            "description": "The request's worst-case charge."
          },
          "settled_usd": {
            "type": [
              "string",
              "null"
            ],
            "description": "What it was billed, once settled."
          },
          "status": {
            "type": "string",
            "enum": [
              "reserved",
              "settled"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "settled_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "required": [
          "request_id",
          "reserved_usd",
          "settled_usd",
          "status",
          "created_at",
          "settled_at"
        ]
      },
      "TaskBudgetList": {
        "type": "object",
        "properties": {
          "object": {
            "type": "string",
            "enum": [
              "list"
            ]
          },
          "open": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/TaskBudget"
              },
              {
                "type": "null"
              }
            ],
            "description": "The open, unexpired budget, or null."
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TaskBudget"
            },
            "description": "The 20 newest budgets, newest first, the open one included."
          },
          "admin_policy": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/WorkspaceAdminPolicy"
              },
              {
                "type": "null"
              }
            ],
            "description": "The workspace admin policy: the object for a workspace key, null for a personal key (no policy applies), and absent when this deployment's database does not have the policy yet."
          }
        },
        "required": [
          "object",
          "open",
          "data"
        ]
      },
      "TaskBudgetOpenRequest": {
        "type": "object",
        "description": "Strict: any other field is refused with 400.",
        "properties": {
          "task_id": {
            "type": "string",
            "format": "uuid",
            "description": "The client's task id."
          },
          "limit_usd": {
            "type": "string",
            "pattern": "^\\d{1,5}(\\.\\d{1,6})?$",
            "description": "USD, above 0 and at most 10000, at most 6 decimal places. A string, not a number."
          },
          "expires_in_s": {
            "type": "integer",
            "minimum": 60,
            "maximum": 86400,
            "description": "The lease, in seconds from now."
          },
          "client": {
            "type": "string",
            "enum": [
              "keak-code"
            ],
            "default": "keak-code"
          }
        },
        "required": [
          "task_id",
          "limit_usd",
          "expires_in_s"
        ],
        "additionalProperties": false
      },
      "TaskBudgetUpdateRequest": {
        "type": "object",
        "description": "Strict: any other field is refused with 400. Send `limit_usd`, `expires_in_s` or both.",
        "properties": {
          "task_id": {
            "type": "string",
            "format": "uuid",
            "description": "Must be the budget's task."
          },
          "limit_usd": {
            "type": "string",
            "pattern": "^\\d{1,5}(\\.\\d{1,6})?$",
            "description": "The new limit; not below the current one."
          },
          "expires_in_s": {
            "type": "integer",
            "minimum": 60,
            "maximum": 86400,
            "description": "Renew the lease to this many seconds from now."
          }
        },
        "required": [
          "task_id"
        ],
        "additionalProperties": false
      },
      "TaskBudgetCloseRequest": {
        "type": "object",
        "description": "Strict: any other field is refused with 400.",
        "properties": {
          "task_id": {
            "type": "string",
            "format": "uuid"
          },
          "force": {
            "type": "boolean",
            "default": false,
            "description": "Close the budget even when it belongs to another task. Send only on a user's request."
          }
        },
        "required": [
          "task_id"
        ],
        "additionalProperties": false
      },
      "TaskBudgetError": {
        "type": "object",
        "description": "The OpenAI error envelope, with what the client must act on inside `error`: the open budget in the way (`active`) or the budget as it is now (`budget`).",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "param": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "code": {
                "type": "string",
                "enum": [
                  "delegated_api_key",
                  "task_budget_conflict",
                  "task_budget_exists",
                  "task_budget_task_mismatch",
                  "task_budget_not_open",
                  "task_budget_limit_decrease"
                ]
              },
              "active": {
                "type": "object",
                "description": "On `task_budget_conflict`, `task_budget_exists` and `task_budget_task_mismatch`.",
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "task_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "expires_at": {
                    "type": "string",
                    "format": "date-time"
                  }
                },
                "required": [
                  "id",
                  "task_id",
                  "expires_at"
                ]
              },
              "budget": {
                "$ref": "#/components/schemas/TaskBudget",
                "description": "On `task_budget_not_open` and `task_budget_limit_decrease`."
              }
            },
            "required": [
              "message",
              "type",
              "code"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "ReceiptTechnique": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "applied",
              "skipped"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "description": "Null when applied. `model_lock` when Model Lock held the technique off."
          },
          "tokens_saved": {
            "type": "integer",
            "minimum": 0
          },
          "version": {
            "type": [
              "integer",
              "null"
            ],
            "description": "The technique release's version when a release governed it, otherwise null."
          },
          "layer": {
            "type": "string",
            "enum": [
              "cheaper_inference"
            ]
          }
        },
        "required": [
          "slug",
          "outcome",
          "reason",
          "tokens_saved",
          "version",
          "layer"
        ],
        "additionalProperties": false
      },
      "ReceiptModelLock": {
        "type": "object",
        "properties": {
          "requested": {
            "type": "boolean",
            "description": "The request carried `x-ci-model-lock`."
          },
          "enforced": {
            "type": "boolean",
            "description": "The lock held for this request. Never true unless requested."
          }
        },
        "required": [
          "requested",
          "enforced"
        ],
        "additionalProperties": false
      },
      "ReceiptOpening": {
        "type": "object",
        "properties": {
          "receipt_version": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "phase": {
            "type": "string",
            "enum": [
              "opening"
            ]
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "api_key_id": {
            "type": "string",
            "format": "uuid"
          },
          "requested_model": {
            "type": "string",
            "description": "The catalog model the caller named."
          },
          "model_lock": {
            "$ref": "#/components/schemas/ReceiptModelLock"
          }
        },
        "required": [
          "receipt_version",
          "phase",
          "request_id",
          "api_key_id",
          "requested_model",
          "model_lock"
        ],
        "additionalProperties": false
      },
      "ReceiptOpeningFrame": {
        "type": "object",
        "description": "One `data:` line of compact JSON. These are the only top-level keys.",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "response.cheaper_inference.request"
            ]
          },
          "object": {
            "type": "string",
            "enum": [
              "cheaper_inference.request"
            ]
          },
          "cheaper_inference": {
            "$ref": "#/components/schemas/ReceiptOpening"
          }
        },
        "required": [
          "type",
          "object",
          "cheaper_inference"
        ],
        "additionalProperties": false
      },
      "ReceiptFinal": {
        "type": "object",
        "description": "Never contains a key named `model` or `usage`.",
        "properties": {
          "receipt_version": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "phase": {
            "type": "string",
            "enum": [
              "final"
            ]
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "api_key_id": {
            "type": "string",
            "format": "uuid"
          },
          "requested_model": {
            "type": "string"
          },
          "served_model": {
            "type": "string",
            "description": "Present only when `model_lock.enforced` is true, and then equal to `requested_model`. Omitted, with the lock still enforced, when a supplier answered with another model mid-stream: that stream is cut unbilled and no served model is stated. CI states its routing guarantee, not proof of the supplier's identity."
          },
          "model_lock": {
            "$ref": "#/components/schemas/ReceiptModelLock"
          },
          "complete": {
            "type": "boolean",
            "description": "The request completed; false when the stream ended incomplete."
          },
          "billing": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "settled",
                  "cached",
                  "failed",
                  "pending"
                ],
                "description": "settled: complete, or a partial charge above zero. failed: incomplete with a zero charge. cached: served from cache. pending: settlement did not finish, the charge is not known yet; reconcile through the usage API."
              },
              "billed_cost_usd": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Fixed 6 decimal places, as a string. Null only while pending. A request whose usage was not reported settles at `0.000000` with `usage_known: false`."
              },
              "currency": {
                "type": "string",
                "enum": [
                  "USD"
                ]
              },
              "usage_known": {
                "type": "boolean",
                "description": "False when no usage was reported. Missing usage is unknown, never zero."
              },
              "basis": {
                "type": "string",
                "enum": [
                  "ledger",
                  "computed"
                ]
              },
              "zero_data_retention": {
                "type": "boolean"
              }
            },
            "required": [
              "status",
              "billed_cost_usd",
              "currency",
              "usage_known",
              "basis",
              "zero_data_retention"
            ],
            "additionalProperties": false
          },
          "tokens": {
            "oneOf": [
              {
                "type": "object",
                "description": "Disjoint billed units, as the ledger counts them: `input` excludes cache reads and writes, `cache_write` sums the 5-minute and 1-hour writes, and `reasoning` is non-zero only when the tariff bills it apart from `output`.",
                "properties": {
                  "input": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "output": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "cache_read": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "cache_write": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "reasoning": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "input",
                  "output",
                  "cache_read",
                  "cache_write",
                  "reasoning"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ],
            "description": "Null when usage is unknown (or a count is not a safe non-negative integer)."
          },
          "prompt_cache_mode": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "on",
              "off",
              "passthrough",
              null
            ],
            "description": "The prompt-cache mode that applied: the request header, else the key's default; zero data retention forces `off`."
          },
          "techniques": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReceiptTechnique"
            },
            "description": "Each Cheaper Inference technique applied to this request, plus a `model-routing` entry skipped with reason `model_lock` only when something (the key, the workspace, `x-ci-route`, a trial or a private release) had routing on. With routing off there is no skipped entry, so a client must not require one."
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "receipt_version",
          "phase",
          "request_id",
          "api_key_id",
          "requested_model",
          "model_lock",
          "complete",
          "billing",
          "tokens",
          "prompt_cache_mode",
          "techniques",
          "warnings"
        ],
        "additionalProperties": false
      },
      "ReceiptFinalFrame": {
        "type": "object",
        "description": "One `data:` line of compact JSON. These are the only top-level keys.",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "response.cheaper_inference.receipt"
            ]
          },
          "object": {
            "type": "string",
            "enum": [
              "cheaper_inference.receipt"
            ]
          },
          "cheaper_inference": {
            "$ref": "#/components/schemas/ReceiptFinal"
          }
        },
        "required": [
          "type",
          "object",
          "cheaper_inference"
        ],
        "additionalProperties": false
      },
      "DocSectionList": {
        "type": "object",
        "properties": {
          "object": {
            "type": "string",
            "enum": [
              "list"
            ]
          },
          "query": {
            "type": "string",
            "nullable": true
          },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Stable section id, e.g. `api-keys`."
                },
                "title": {
                  "type": "string"
                },
                "category": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "description": "Absolute link to the section."
                },
                "body": {
                  "type": "string",
                  "description": "The section's full text. Present only on a search (`q`)."
                }
              },
              "required": [
                "id",
                "title",
                "category",
                "url"
              ]
            }
          }
        },
        "required": [
          "object",
          "query",
          "data"
        ]
      },
      "PricingChangeList": {
        "type": "object",
        "properties": {
          "object": {
            "type": "string",
            "enum": [
              "list"
            ]
          },
          "pricing_version": {
            "type": "string"
          },
          "pricing_checked_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "pricing_updated_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "model_id": {
                  "type": "string"
                },
                "change_type": {
                  "type": "string",
                  "enum": [
                    "updated",
                    "removed"
                  ]
                },
                "changed_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "model": {
                  "$ref": "#/components/schemas/Model",
                  "nullable": true
                },
                "previous_pricing": {
                  "$ref": "#/components/schemas/PricingChangeRates"
                },
                "current_pricing": {
                  "$ref": "#/components/schemas/PricingChangeRates"
                }
              },
              "required": [
                "model_id",
                "change_type",
                "changed_at",
                "model",
                "previous_pricing",
                "current_pricing"
              ]
            }
          },
          "has_more": {
            "type": "boolean"
          },
          "next_cursor": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "object",
          "data",
          "has_more",
          "pricing_version"
        ]
      },
      "PricingChangeRates": {
        "type": "object",
        "description": "Customer-facing rates on one side of a change. Null means the rate was not quoted at that point, which is different from zero.",
        "properties": {
          "input_per_million": {
            "type": [
              "number",
              "string",
              "null"
            ]
          },
          "output_per_million": {
            "type": [
              "number",
              "string",
              "null"
            ]
          },
          "media_unit_price": {
            "type": [
              "number",
              "string",
              "null"
            ]
          },
          "cache_read_per_million": {
            "type": [
              "number",
              "string",
              "null"
            ]
          },
          "cache_write_per_million": {
            "type": [
              "number",
              "string",
              "null"
            ]
          }
        }
      },
      "UsageDaily": {
        "type": "object",
        "properties": {
          "object": {
            "type": "string",
            "enum": [
              "usage.daily"
            ]
          },
          "scope": {
            "type": "string",
            "enum": [
              "workspace"
            ]
          },
          "currency": {
            "type": "string",
            "enum": [
              "USD"
            ]
          },
          "start_at": {
            "type": "string",
