    "/v1/usage/team-savings/requests": {
      "get": {
        "tags": [
          "Usage"
        ],
        "summary": "Team Savings request records",
        "operationId": "listUsageTeamSavingsRequests",
        "description": "The request records behind a Team Savings figure, newest first, with the same scope, filters and permissions as `GET /v1/usage/team-savings`. Records only: no prompt, response or request body. The charged pages of a period sum to the report's `actual_usd`. `cursor` is opaque and comes from the previous page's `next_cursor`.",
        "security": [
          {
            "BearerAuth": []
          },
          {
            "AnthropicApiKey": []
          }
        ],
        "parameters": [
          {
            "name": "scope",
            "in": "query",
            "required": false,
            "description": "`self` (default): the caller's own requests in the key's workspace. `team`: the workspace's members the caller may see, which needs the `account:read` scope as well as a workspace role that includes team reports (owner, admin, or a member granted Team reports). The workspace is always the calling key's; it cannot be named.",
            "schema": {
              "type": "string",
              "enum": [
                "self",
                "team"
              ],
              "default": "self"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "description": "First UTC day, inclusive. Defaults to 29 days before `to`. The period may cover at most 92 days (`code: range_too_large`).",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "description": "Last UTC day, inclusive. Defaults to today (UTC).",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "group_by",
            "in": "query",
            "required": false,
            "description": "How `groups` is split. Ignored by the requests listing.",
            "schema": {
              "type": "string",
              "enum": [
                "member",
                "project",
                "model"
              ],
              "default": "member"
            }
          },
          {
            "name": "member",
            "in": "query",
            "required": false,
            "description": "Comma-separated: `me` or up to 50 member user ids. Anyone other than the caller needs `scope=team` (`code: member_requires_team_scope`).",
            "style": "form",
            "explode": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "maxItems": 50
            }
          },
          {
            "name": "project",
            "in": "query",
            "required": false,
            "description": "Comma-separated: up to 50 opaque project ids from Keak Code's attribution, or `unattributed` for requests with no project tag.",
            "style": "form",
            "explode": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(unattributed|[A-Za-z0-9_-]{16,64})$"
              },
              "minItems": 1,
              "maxItems": 50
            }
          },
          {
            "name": "model",
            "in": "query",
            "required": false,
            "description": "Comma-separated: up to 20 model ids, matched exactly.",
            "style": "form",
            "explode": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._:/-]{1,256}$"
              },
              "minItems": 1,
              "maxItems": 20
            }
          },
          {
            "name": "bucket",
            "in": "query",
            "required": false,
            "description": "`charged` (default): settled, cached and charged failures, the requests the report's spend is made of. `pending`: in flight. `failed_unbilled`: failed with no charge. `all`: every one.",
            "schema": {
              "type": "string",
              "enum": [
                "charged",
                "pending",
                "failed_unbilled",
                "all"
              ],
              "default": "charged"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Opaque cursor from the previous page.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TeamSavingsRequestList"
                }
              }
            }
          },
          "400": {
            "description": "`param` names the parameter. `code: invalid_request` for a malformed, repeated or unknown parameter; `code: range_too_large` (`param: from`) for more than 92 days; `code: member_requires_team_scope` (`param: member`) for another member with `scope=self`; `code: invalid_cursor` for a cursor this service did not issue.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing API key (`type: authentication_error`, `code: invalid_api_key`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "402": {
            "description": "Insufficient wallet balance (`type: invalid_request_error`, `code: insufficient_balance`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "403": {
            "description": "`code: insufficient_scope` when the key lacks `usage:read`, or `account:read` for `scope=team` (`param` is the scope). `code: team_reports_forbidden` (`param: scope`) when the caller's role does not include team reports, or the key is a personal key. `code: member_not_visible` (`param: member`) for a member not shared with the caller. `code: organization_membership_required` when the key's workspace membership was removed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "404": {
            "description": "Not found (`type: invalid_request_error`, `code: not_found`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "408": {
            "description": "Request timed out (`type: invalid_request_error`, `code: request_failed`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "409": {
            "description": "Conflict (`type: invalid_request_error`, `code: conflict`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "413": {
            "description": "Request too large (`type: invalid_request_error`, `code: request_too_large`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "422": {
            "description": "A parameter failed validation (`type: invalid_request_error`, `code: invalid_request`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "425": {
            "description": "Too early (`type: invalid_request_error`, `code: request_failed`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited (`type: rate_limit_error`, `code: rate_limit_exceeded`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "500": {
            "description": "Server error (`type: api_error`, `code: server_error`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "502": {
            "description": "The upstream provider returned an unusable response (`type: api_error`, `code: upstream_error`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "503": {
            "description": "`code: team_savings_unavailable` before the deployment's database has the report, or `code: report_timeout` when the report took too long; try a shorter period.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          },
          "504": {
            "description": "Upstream timeout (`type: api_error`, `code: upstream_timeout`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenAIError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/pricing/changes": {
      "get": {
        "tags": [
          "Models"
        ],
        "summary": "Price changes",
        "operationId": "listPricingChanges",
        "description": "Price moves at or after `since`, oldest first, so a client can detect changes without re-diffing the catalogue. Store the `changed_at` of the last change you processed and pass it as `since` on the next poll, then follow `next_cursor` to the end. Requires the `usage:read` scope.",
        "security": [
          {
            "BearerAuth": []
          },
          {
            "AnthropicApiKey": []
          }
        ],
        "parameters": [
          {
            "name": "since",
            "in": "query",
            "required": true,
            "description": "Return changes at or after this time. Required: there is no default window, and an unbounded feed would return the whole price history.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum changes to return.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 100
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Opaque cursor from the previous page's `next_cursor`.",
            "schema": {
              "type": "string"
