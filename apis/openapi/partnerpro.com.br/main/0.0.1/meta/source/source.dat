            "type": "number",
            "description": "Valor de desconto rr."
          },
          "vlrTotalRr": {
            "type": "number",
            "description": "Valor total rr."
          },
          "aprovacoesMinPs": {
            "type": "integer",
            "description": "Número mínimo de aprovações necessárias para o preço sugerido do item."
          },
          "aprovacoesMinRr": {
            "type": "integer",
            "description": "Número mínimo de aprovações necessárias para rr."
          },
          "aprovacoesPs": {
            "type": "integer",
            "description": "Número de aprovações já recebidas para o preço sugerido do item."
          },
          "aprovacoesRr": {
            "type": "integer",
            "description": "Número de aprovações já recebidas para rr."
          }
