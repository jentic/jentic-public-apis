          },
          {
            "in": "query",
            "name": "sku",
            "schema": {
              "type": "string"
            },
            "description": "Filtro por SKU (busca parcial)"
          },
          {
            "in": "query",
            "name": "status",
            "schema": {
              "type": "string",
              "enum": [
                "A",
                "I"
              ]
            },
            "description": "Filtro por status (A - Ativo, I - Inativo)"
          },
          {
            "in": "query",
            "name": "categoriaId",
