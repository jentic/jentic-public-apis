  },
  "servers": [
    {
      "url": "https://api.partnerpro.com.br"
    }
  ],
  "tags": [
    {
      "name": "Cliente"
    },
    {
      "name": "Parceiro"
    },
    {
      "name": "Afiliado"
    },
    {
      "name": "Oportunidade"
    },
    {
      "name": "Pipeline Oportunidade"
    },
    {
      "name": "Usuarios"
    },
    {
      "name": "Contas a Receber"
    },
    {
      "name": "Produto"
    },
    {
      "name": "Categoria"
    },
    {
      "name": "Marca Produto"
    }
  ],
  "paths": {
    "/api/cliente": {
      "post": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Inserir cliente",
        "tags": [
          "Cliente"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InserirClienteRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Cliente criado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClienteResponse"
                }
              }
            }
          },
          "400": {
            "description": "Erro na requisição",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiStatus"
                }
              }
            }
          }
        }
      },
      "get": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Listar clientes",
        "tags": [
          "Cliente"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "filter",
            "schema": {
              "type": "string"
            },
            "description": "Filtro de busca"
          },
          {
            "in": "query",
            "name": "size",
            "schema": {
              "type": "integer",
              "default": 10
            },
            "description": "Quantidade por página"
          },
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer",
              "default": 1
            },
            "description": "Página que deseja buscar"
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de clientes obtida com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "description": "Dados",
                      "properties": {
                        "hasNext": {
                          "type": "boolean",
                          "description": "Informa se existe próxima página"
                        },
                        "hasPrevious": {
                          "type": "boolean",
                          "description": "Informa se existe página anterior"
                        },
                        "pageNumber": {
                          "type": "integer",
                          "description": "Informa a página que está atualmente"
                        },
                        "pageSize": {
                          "type": "integer",
                          "description": "Informa a quantidade de registro que vai existir na página"
                        },
                        "items": {
                          "$ref": "#/components/schemas/ClienteResponseLista"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Erro na requisição",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiStatus"
                }
              }
            }
          }
        }
      },
      "patch": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Atualizar cliente",
        "tags": [
          "Cliente"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AtualizarClienteRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Cliente atualizado com sucesso"
          },
          "400": {
            "description": "Erro na requisição",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiStatus"
                }
              }
            }
          }
        }
      }
    },
