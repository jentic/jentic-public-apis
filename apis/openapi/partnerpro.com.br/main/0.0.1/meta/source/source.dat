                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "description": "Dados",
                      "properties": {
                        "hasNext": {
                          "type": "boolean",
                          "description": "Informa se existe próxima página"
                        },
                        "hasPrevious": {
                          "type": "boolean",
                          "description": "Informa se existe página anterior"
                        },
