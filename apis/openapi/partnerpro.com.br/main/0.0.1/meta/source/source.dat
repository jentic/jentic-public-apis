          "status": {
            "type": "string",
            "description": "Status da regra de comissão (A - Ativa / I - Inativa)."
          },
          "dataIni": {
            "type": "string",
            "example": "yyyy-MM-dd'T'HH:mm:ss.SSS'Z'",
            "description": "Data de início da validade da regra de comissão, no formato ISO 8601."
          },
          "dataFim": {
            "type": "string",
            "example": "yyyy-MM-dd'T'HH:mm:ss.SSS'Z'",
            "description": "Data de término da validade da regra de comissão, no formato ISO 8601."
          },
          "perComissaoPs": {
            "type": "number",
            "description": "Percentual de comissão aplicado sobre o valor da conta a receber no cenário de preço sugerido (preço de tabela)."
          },
          "perComissaoRr": {
            "type": "number",
            "description": "Percentual de comissão aplicado sobre o valor da conta a receber no cenário de preço reajustado."
          },
          "parcelas": {
            "type": "integer",
            "description": "Número de parcelas em que o valor da comissão será dividido ou pago."
          },
          "tipoComissionamento": {
            "type": "string",
            "description": "Tipo de comissionamento da regra (F - Fixo / V - Variável por faixa de parcelas)."
          }
        }
      },
      "ContaReceberResponse": {
        "type": "object",
        "description": "Representa uma conta a receber, incluindo informações sobre o cliente, produto, valores, comissões, taxas e status da conta.",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Identificador único da conta a receber no sistema."
          },
          "idExterno": {
            "type": "string",
            "description": "Identificador externo da conta a receber, utilizado para integração com outros sistemas."
          },
          "cliente": {
            "$ref": "#/components/schemas/ContaReceberClienteResponse"
          },
          "produto": {
            "$ref": "#/components/schemas/ContaReceberProdutoResponse"
          },
          "vlrRr": {
            "type": "number",
            "description": "Valor da conta a receber no cenário de preço reajustado."
          },
          "vlrPs": {
            "type": "number",
            "description": "Valor da conta a receber no cenário de preço sugerido."
          },
          "dataEmissao": {
            "type": "string",
            "example": "yyyy-MM-dd",
            "description": "Data de emissão da conta a receber, geralmente no formato ISO 8601."
          },
          "dataVencimento": {
            "type": "string",
            "example": "yyyy-MM-dd",
            "description": "Data de vencimento da conta a receber, quando o pagamento deve ser efetuado."
          },
          "dataLiquidacao": {
            "type": "string",
            "example": "yyyy-MM-dd",
            "description": "Data em que a conta foi liquidada (paga)."
          },
          "vlrPago": {
            "type": "number",
            "description": "Valor total pago até o momento, referente à conta a receber."
          },
          "perComissaoRr": {
            "type": "number",
            "description": "Percentual de comissão aplicado sobre o valor da conta no cenário de preço reajustado (Rr)."
          },
          "vlrComissaoRr": {
            "type": "number",
            "description": "Valor total de comissão calculado com base no percentual aplicado no valor reajustado (Rr)."
          },
          "perComissaoPs": {
            "type": "number",
            "description": "Percentual de comissão aplicado sobre o valor da conta no cenário de preço sugerido (Ps)."
          },
          "vlrComissaoPs": {
            "type": "number",
            "description": "Valor total de comissão calculado com base no percentual aplicado no valor sugerido (Ps)."
          },
          "perTaxaImposto": {
            "type": "number",
            "description": "Percentual de imposto aplicado sobre o valor da conta a receber."
          },
          "perTaxaAdm": {
            "type": "number",
            "description": "Percentual de taxa administrativa aplicada sobre o valor da conta a receber."
          },
          "vlrImpostoRr": {
            "type": "number",
            "description": "Valor total de imposto aplicado sobre o valor reajustado da conta (Rr)."
          },
          "vlrTaxaAdmRr": {
            "type": "number",
            "description": "Valor total da taxa administrativa aplicada sobre o valor reajustado da conta (Rr)."
          },
          "vlrTaxaAdmPs": {
            "type": "number",
            "description": "Valor total da taxa administrativa aplicada sobre o valor sugerido da conta (Ps)."
          },
          "status": {
            "type": "string",
            "description": "Status atual da conta a receber (A - Abeerto / B - Baixado)."
          },
          "origem": {
            "type": "string",
            "description": "Origem da conta a receber (M - Manual / P - Planilha / A - API)."
          },
          "numeroParcela": {
            "type": "integer",
            "description": "Número da parcela do contrato. Utilizado para identificar qual faixa de comissão variável foi aplicada."
          },
          "regraComissao": {
            "$ref": "#/components/schemas/ContaReceberRegraComissaoResponse"
          }
        }
      },
      "ContaReceberLista": {
        "type": "array",
        "description": "Dados contas a receber.",
        "items": {
          "$ref": "#/components/schemas/ContaReceberResponse"
        }
      },
      "InserirContaReceberRequest": {
        "type": "object",
        "description": "Representa a solicitação para inserir uma nova conta a receber.",
        "required": [
          "usuarioId",
          "idExterno",
          "cnpjCpf",
          "dataEmissao",
          "dataVencimento",
          "status"
        ],
        "properties": {
          "usuarioId": {
            "type": "string",
            "description": "Código usuário."
          },
          "idExterno": {
            "type": "integer",
            "description": "Identificador externo da conta a receber."
          },
          "cnpjCpf": {
            "type": "string",
            "description": "Número do CNPJ ou CPF associado ao cliente da conta a receber."
          },
          "dataEmissao": {
            "type": "string",
            "example": "yyyy-MM-dd",
            "description": "Data de emissão da conta a receber, no formato ISO 8601."
          },
          "dataVencimento": {
            "type": "string",
            "example": "yyyy-MM-dd",
            "description": "Data de vencimento da conta a receber, no formato ISO 8601."
          },
          "codProduto": {
            "type": "integer",
            "description": "(Opcional) Código do produto ou serviço associado à conta a receber."
          },
          "vlrMrr": {
            "type": "number",
            "description": "(Opcional) Valor MRR da conta a receber. Caso não seja informado, será inserido o valor padrão 0.0."
          },
          "vlrPs": {
            "type": "number",
            "description": "(Opcional) Valor PS da conta a receber. Caso não seja informado, será inserido o valor padrão 0.0."
          },
          "status": {
            "type": "string",
            "description": "Status inicial da conta a receber (A - Aberto / B - Baixado)."
          },
          "dataLiquidacao": {
            "type": "string",
            "example": "yyyy-MM-dd",
            "description": "Data de liquidação da conta, ou seja, quando o pagamento foi realizado, no formato ISO 8601."
          },
          "vlrLiquidacao": {
            "type": "number",
            "description": "Valor pago no momento da liquidação da conta a receber."
          },
          "numeroParcela": {
            "type": "integer",
            "description": "(Opcional) Número da parcela do contrato. Utilizado para calcular comissão variável por faixa de parcelas. Caso não seja informado, será considerado como parcela 1."
          }
        }
      },
      "InserirOportunidadeRequest": {
        "type": "object",
        "description": "Representa a solicitação para inserir uma nova oportunidade de vendas.",
        "required": [
          "usuarioId",
          "isClienteInternacional"
        ],
        "properties": {
          "usuarioId": {
            "type": "string",
            "description": "Código usuário."
          },
          "isClienteInternacional": {
            "type": "boolean",
            "description": "Indica se o cliente é internacional (true) ou nacional (false)."
          },
          "idResponsavelPelaOportunidade": {
            "type": "integer",
            "description": "Identificador do usuário responsável pela oportunidade."
          },
          "cnpjCpf": {
            "type": "string",
            "description": "Número do CNPJ (para pessoa jurídica) do cliente associado à oportunidade. Obrigatório quando isClienteInternacional = false."
          },
          "identificadorInternacional": {
            "type": "string",
            "description": "Identificador internacional do cliente associado à oportunidade. Obrigatório quando isClienteInternacional = true."
          },
          "email": {
            "type": "string",
            "description": "Endereço de e-mail de contato do cliente da oportunidade."
          },
          "telefone": {
            "type": "string",
            "description": "Número de telefone de contato do cliente da oportunidade."
          },
          "justificativaDesconto": {
            "type": "string",
            "description": "Justificativa fornecida pelo cliente ou vendedor para a concessão de desconto na oportunidade."
          },
          "justificativaPerda": {
            "type": "string",
            "description": "Justificativa fornecida para oportunidade com status Perdido"
          },
          "dataPerda": {
            "type": "string",
            "example": "yyyy-MM-dd HH:mm:ss",
            "description": "Data de perda da oportunidade."
          },
          "dataFechamento": {
            "type": "string",
            "example": "yyyy-MM-dd HH:mm:ss",
            "description": "Data de fechamento de negócio, quando oportunidade é dada como Ganho."
          },
          "dataUltimaMovimentacao": {
            "type": "string",
            "example": "yyyy-MM-dd HH:mm:ss",
            "description": "Data em que ocorreu a última movimentação da oportunidade."
          },
          "faturamento": {
            "$ref": "#/components/schemas/OportunidadeFaturamentoRequest"
          },
          "produtos": {
            "$ref": "#/components/schemas/OportunidadeProdutoRequest"
          },
          "camposAd": {
            "$ref": "#/components/schemas/OportunidadeCampoRequest"
          }
        }
      },
      "AtualizarOportunidadeRequest": {
        "type": "object",
