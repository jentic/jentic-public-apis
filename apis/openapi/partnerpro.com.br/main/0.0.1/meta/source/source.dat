            "name": "size",
            "schema": {
              "type": "integer",
              "default": 10
            },
            "description": "Quantidade por página"
          },
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer",
              "default": 1
            },
            "description": "Página que deseja buscar"
          }
        ],
        "responses": {
