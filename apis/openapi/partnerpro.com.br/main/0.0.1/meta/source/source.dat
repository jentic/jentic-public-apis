  "components": {
    "schemas": {
      "BearerToken": {
        "type": "object",
        "description": "Representação de um token Bearer utilizado para autenticação em APIs.",
        "properties": {
          "token_type": {
            "type": "string",
            "description": "Tipo do token, geralmente \"Bearer\", indicando o método de autenticação."
          },
          "access_token": {
            "type": "string",
            "description": "O token de acesso utilizado para autenticar as requisições à API. Deve ser enviado no cabeçalho Authorization."
          },
          "created_in": {
            "type": "string",
            "description": "Data e hora (em formato UTC) em que o token foi gerado. Pode estar no formato de timestamp ou ISO 8601."
          },
          "expires_in": {
            "type": "string",
            "description": "Tempo de validade do token em segundos, após o qual o token expira e não pode mais ser utilizado."
          }
        }
      },
      "OportunidadeResponse": {
        "type": "object",
        "description": "Detalhes de uma oportunidade de negócio.",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Identificador único da oportunidade."
          },
          "cliente": {
            "$ref": "#/components/schemas/OportunidadeClienteResponse"
          },
          "parceiro": {
            "$ref": "#/components/schemas/OportunidadeParceiroResponse"
          },
          "email": {
            "type": "string",
            "description": "Endereço de e-mail do cliente."
          },
          "telefone": {
            "type": "string",
            "description": "Número de telefone do cliente."
          },
          "dataEstimada": {
            "type": "string",
            "example": "yyyy-MM-dd",
            "description": "Data estimada para a conclusão da oportunidade."
          },
          "contato": {
            "type": "string",
            "description": "Nome do contato principal na oportunidade."
          },
          "escopo": {
            "type": "string",
            "description": "Descrição do escopo da oportunidade."
          },
          "status": {
            "type": "string",
            "description": "Status atual da oportunidade (A - Aberto / G - Ganho / P - Perdido)"
          },
          "funil": {
            "$ref": "#/components/schemas/OportunidadeFunilResponse"
          },
          "etapa": {
            "$ref": "#/components/schemas/OportunidadeFunilEtapaResponse"
          },
          "dataCadastro": {
            "type": "string",
            "example": "yyyy-MM-dd",
            "description": "Data e hora em que a oportunidade foi cadastrada."
          },
          "usuarioCadastro": {
            "$ref": "#/components/schemas/OportunidadeUsuarioResponse"
          },
          "dataAlteracao": {
            "type": "string",
            "example": "yyyy-MM-dd",
            "description": "Data e hora da última alteração na oportunidade."
          },
          "usuarioAlteracao": {
            "$ref": "#/components/schemas/OportunidadeUsuarioResponse"
          },
          "dataEtapa": {
            "type": "string",
            "example": "yyyy-MM-dd",
            "description": "Data da última alteração de etapa da oportunidade."
          },
          "usuarioEtapa": {
            "$ref": "#/components/schemas/OportunidadeUsuarioResponse"
          },
          "vlrTotalPs": {
            "type": "number",
            "description": "Valor total de serviços (Ps) associados à oportunidade."
          },
          "vlrTotalRr": {
            "type": "number",
            "description": "Valor total de recursos (Rr) associados à oportunidade."
          },
          "vlrDescontoPs": {
            "type": "number",
            "description": "Desconto aplicado sobre o valor de serviços (Ps)."
          },
          "vlrDescontoRr": {
            "type": "number",
            "description": "Desconto aplicado sobre o valor de recursos (Rr)."
          },
          "parcelas": {
            "type": "integer",
            "description": "Número de parcelas da oportunidade."
          },
          "intervaloParcela": {
            "type": "integer",
            "description": "Intervalo entre as parcelas"
          },
          "dataCobrancaPs": {
            "type": "string",
            "example": "yyyy-MM-dd",
            "description": "Data de cobrança para serviços (Ps)."
          },
          "dataCobrancaRr": {
            "type": "string",
            "example": "yyyy-MM-dd",
            "description": "Data de cobrança para recursos (Rr)."
          },
          "pagador": {
            "$ref": "#/components/schemas/OportunidadeClienteResponse"
          },
          "justificativaDesconto": {
            "type": "string",
            "description": "Justificativa para a concessão de descontos na oportunidade."
          },
          "observacao": {
            "type": "string",
            "description": "Observações adicionais sobre a oportunidade."
