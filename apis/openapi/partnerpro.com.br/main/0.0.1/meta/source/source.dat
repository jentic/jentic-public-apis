          }
        }
      },
      "OportunidadeFaturamentoRequest": {
        "type": "object",
        "description": "Representa a solicitação de faturamento para uma oportunidade de vendas.",
        "properties": {
          "qtdParcelas": {
            "type": "integer",
            "description": "Número total de parcelas em que o valor da oportunidade será dividido."
          },
          "intervaloParcela": {
            "type": "integer",
            "description": "Intervalo de tempo entre as parcelas, podendo ser especificado em dias, meses ou outra unidade de tempo."
          }
        }
      },
      "OportunidadeProdutoRequest": {
        "type": "object",
        "description": "Representa as informações de um produto dentro de uma oportunidade de vendas.",
        "required": [
          "codProduto",
          "qtdTotal"
        ],
        "properties": {
          "codProduto": {
            "type": "string",
            "description": "Código identificador único do produto dentro do sistema."
          },
          "qtdTotal": {
            "type": "string",
            "description": "Quantidade total do produto solicitado na oportunidade."
          },
          "vlrDescontoPs": {
            "type": "string",
            "description": "Valor de desconto aplicado sobre o produto, considerando o preço sugerido ou de tabela (Ps)."
          },
          "vlrDescontoRr": {
            "type": "string",
            "description": "Valor de desconto aplicado sobre o produto, considerando o preço reajustado ou final (Rr)."
          }
        }
      },
      "OportunidadeCampoRequest": {
        "type": "object",
        "description": "Representa as informações de um campo adicional dentro de uma oportunidade de vendas.",
        "required": [
          "chave"
        ],
        "properties": {
          "chave": {
            "type": "string",
            "description": "Chave do campo adicional a receber o novo valor.",
            "example": "segmento_principal"
          },
          "nomeArquivoComExtensao": {
            "type": "string",
            "description": "Nome original do arquivo com extensão.\n**Obrigatório quando o campo adicional for do tipo arquivo (base64).**\nExtensões aceitas: `.pdf`, `.doc`, `.docx`, `.xls`, `.xlsx`, `.ppt`, `.pptx`, `.png`, `.jpg`, `.jpeg`\n",
            "example": "contrato.pdf"
          },
          "valor": {
            "type": "string",
            "description": "Valor do campo adicional. O formato varia conforme o tipo do campo:\n- **Combobox**: valor exato de uma das opções. Ex: `Varejo`\n- **Combobox Múltiplo**: valores separados por vírgula. Ex: `Varejo,Indústria,Serviços`\n- **Moeda (BRL)**: formato `R$ 1.250,00`. Apenas Real Brasileiro é suportado.\n- **Porcentagem**: com ou sem símbolo. Ex: `25` ou `25.5%`\n- **Texto/TextArea**: valor livre\n- **Número**: valor inteiro. Ex: `10`\n- **Decimal**: valor decimal. Ex: `10.5`\n- **Data**: formato `yyyy-MM-dd`. Ex: `2026-01-31`\n- **Data/Hora**: formato `yyyy-MM-dd HH:mm:ss`. Ex: `2026-01-31 10:00:00`\n- **Arquivo**: conteúdo do arquivo codificado em Base64. O campo `nomeArquivoComExtensao` é obrigatório neste caso.\n",
            "example": "Varejo"
          }
        }
      },
      "AtualizarPipelineOportunidadeRequest": {
        "type": "object",
        "description": "Representa as informações de um produto dentro de uma oportunidade de vendas.",
        "required": [
          "oportunidadeId",
          "etapaId",
          "usuarioId"
        ],
        "properties": {
          "oportunidadeId": {
            "type": "integer",
            "description": "Código da oportunidade."
          },
          "etapaId": {
            "type": "integer",
            "description": "Código da etapa."
          },
          "usuarioId": {
            "type": "integer",
            "description": "Código do usuário."
          }
        }
      },
      "AtualizarStatusOportunidadeRequest": {
        "type": "object",
        "description": "Objeto para atualizar status de oportunidade",
        "required": [
          "oportunidadeId",
          "status",
          "usuarioId"
        ],
        "properties": {
