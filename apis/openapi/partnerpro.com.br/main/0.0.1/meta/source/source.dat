          },
          "idResponsavelPelaOportunidade": {
            "type": "integer",
            "description": "Identificador do usuário responsável pela oportunidade."
          },
          "cnpjCpf": {
            "type": "string",
            "description": "Número do CNPJ (para pessoa jurídica) do cliente associado à oportunidade. Obrigatório quando isClienteInternacional = false."
          },
          "identificadorInternacional": {
            "type": "string",
            "description": "Identificador internacional do cliente associado à oportunidade. Obrigatório quando isClienteInternacional = true."
          },
          "email": {
            "type": "string",
            "description": "Endereço de e-mail de contato do cliente da oportunidade."
          },
          "telefone": {
            "type": "string",
            "description": "Número de telefone de contato do cliente da oportunidade."
          },
          "justificativaDesconto": {
            "type": "string",
            "description": "Justificativa fornecida pelo cliente ou vendedor para a concessão de desconto na oportunidade."
          },
          "justificativaPerda": {
            "type": "string",
            "description": "Justificativa fornecida para oportunidade com status Perdido"
          },
          "dataPerda": {
            "type": "string",
            "example": "yyyy-MM-dd HH:mm:ss",
            "description": "Data de perda da oportunidade."
          },
          "dataFechamento": {
            "type": "string",
            "example": "yyyy-MM-dd HH:mm:ss",
            "description": "Data de fechamento de negócio, quando oportunidade é dada como Ganho."
          },
          "dataUltimaMovimentacao": {
            "type": "string",
            "example": "yyyy-MM-dd HH:mm:ss",
            "description": "Data em que ocorreu a última movimentação da oportunidade."
          },
          "faturamento": {
            "$ref": "#/components/schemas/OportunidadeFaturamentoRequest"
          },
          "produtos": {
