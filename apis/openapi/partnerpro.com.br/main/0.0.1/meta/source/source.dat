      "OportunidadePropostaResponse": {
        "type": "object",
        "description": "Representa uma proposta de oportunidade.",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Identificador único da proposta."
          },
          "urlProposta": {
            "type": "string",
            "description": "URL da proposta."
          },
          "indLeitura": {
            "type": "string",
            "description": "Indicador de leitura da proposta (S - Sim / N - Não)."
          },
          "dataEnvio": {
            "type": "string",
            "example": "yyyy-MM-dd'T'HH:mm:ss.SSS'Z'",
            "description": "Data e hora em que a proposta foi enviada, no formato ISO 8601."
          },
          "dataLeitura": {
            "type": "string",
            "example": "yyyy-MM-dd'T'HH:mm:ss.SSS'Z'",
            "description": "Data e hora em que a proposta foi lida, no formato ISO 8601."
          },
          "dataRecusa": {
            "type": "string",
            "example": "yyyy-MM-dd'T'HH:mm:ss.SSS'Z'",
            "description": "Data e hora em que a proposta foi recusada, se aplicável, no formato ISO 8601."
          },
          "emailAlteracaoStatus": {
            "type": "string",
            "description": "Endereço de e-mail mudanças de status da proposta."
          },
          "status": {
            "type": "string",
            "description": "Status atual da proposta (P - Pendente / R - Recusado / C - Cancelado / A - Aceito)."
          }
        }
      },
