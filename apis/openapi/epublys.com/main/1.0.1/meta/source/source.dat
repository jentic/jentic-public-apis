{"openapi":"3.1.0","info":{"title":"Epublys API","version":"1.0.1","description":"EPUB/PDF ebook manipulation API. Merge, split, compress, convert, validate, and edit metadata. All file data is base64-encoded JSON. Get a free API key at https://epublys.com/account. Pro ($9/mo) for higher limits: https://epublys.com/pricing","contact":{"url":"https://epublys.com"}},"servers":[{"url":"https://epublys.com/v1"}],"security":[{"bearerAuth":[]}],"components":{"securitySchemes":{"bearerAuth":{"type":"http","scheme":"bearer","description":"API key (epl_xxx). Get one at https://epublys.com/account"}},"schemas":{"FileResult":{"type":"object","properties":{"success":{"type":"boolean"},"file":{"type":"string","description":"Base64-encoded output file"},"filename":{"type":"string"},"contentType":{"type":"string"},"message":{"type":"string"},"pro_tip":{"type":"string","description":"Present on free-tier responses only"}}},"Error":{"type":"object","properties":{"success":{"type":"boolean","enum":[false]},"error":{"type":"string","description":"Human-readable message"},"code":{"type":"string","description":"Machine-readable failure category","enum":["validation","total_too_large","rate_limited","daily_limited","pro_required","customer_id_collision","unauthorized","unauthenticated","unavailable","timeout","internal","csrf","upload_interrupted","not_found","unsupported_cjk","unsupported_arabic","unsupported_hebrew","unsupported_thai","unsupported_devanagari","unsupported_cyrillic","unsupported_greek","unsupported_other"]}}}}},"paths":{"/merge":{"post":{"summary":"Merge multiple EPUBs","operationId":"mergeEpub","requestBody":{"content":{"application/json":{"schema":{"type":"object","required":["files"],"properties":{"files":{"type":"array","items":{"type":"string"},"minItems":2,"description":"Base64-encoded EPUB files"},"names":{"type":"array","items":{"type":"string"},"description":"Original filenames, in the same order as files — the output is named after them (\"A + B.epub\", or \"A + N more.epub\" past two); without them it is merged.epub"},"title":{"type":"string","maxLength":300},"author":{"type":"string","maxLength":300},"dividers":{"type":"boolean","default":true}}}}}},"responses":{"200":{"description":"Success — JSON envelope with the base64-encoded output file","content":{"application/json":{"schema":{"$ref":"#/components/schemas/FileResult"}}}},"400":{"description":"Invalid input — human message in `error`, machine category in `code`","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"413":{"description":"Upload exceeds the per-request total cap","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limited","headers":{"Retry-After":{"description":"Seconds until the limit window resets","schema":{"type":"integer"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"500":{"description":"Processing failure","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/split":{"post":{"summary":"Split EPUB into chapters, or pull a chapter range out as one EPUB","description":"With chapterStart and/or chapterEnd the result is ONE EPUB (contentType application/epub+zip) of exactly those chapters, in order, with the book’s metadata, a table of contents limited to them and the fonts and images they use. Without a range the result is a ZIP (application/zip) holding one EPUB per chapter.","operationId":"splitEpub","requestBody":{"content":{"application/json":{"schema":{"type":"object","required":["file"],"properties":{"file":{"type":"string","description":"Base64-encoded EPUB"},"name":{"type":"string","description":"Original filename — the output is named after its stem (e.g. \"Book.epub\" gives \"Book (compressed).epub\"); without it the output keeps a fixed name"},"chapterStart":{"type":"integer","minimum":1,"description":"First chapter to include (1-indexed). Giving either bound returns one EPUB of the range instead of a ZIP"},"chapterEnd":{"type":"integer","minimum":1,"description":"Last chapter to include (inclusive)"},"keepMetadata":{"type":"boolean","default":true,"description":"Preserve the original author, publisher and description in the output"}}}}}},"responses":{"200":{"description":"Success — JSON envelope with the base64-encoded output file","content":{"application/json":{"schema":{"$ref":"#/components/schemas/FileResult"}}}},"400":{"description":"Invalid input — human message in `error`, machine category in `code`","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"413":{"description":"Upload exceeds the per-request total cap","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limited","headers":{"Retry-After":{"description":"Seconds until the limit window resets","schema":{"type":"integer"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"500":{"description":"Processing failure","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/compress":{"post":{"summary":"Compress EPUB","operationId":"compressEpub","requestBody":{"content":{"application/json":{"schema":{"type":"object","required":["file"],"properties":{"file":{"type":"string","description":"Base64-encoded EPUB"},"name":{"type":"string","description":"Original filename — the output is named after its stem (e.g. \"Book.epub\" gives \"Book (compressed).epub\"); without it the output keeps a fixed name"},"level":{"type":"integer","minimum":1,"maximum":9,"default":6},"stripUnused":{"type":"boolean","default":false}}}}}},"responses":{"200":{"description":"Success — JSON envelope with the base64-encoded output file","content":{"application/json":{"schema":{"$ref":"#/components/schemas/FileResult"}}}},"400":{"description":"Invalid input — human message in `error`, machine category in `code`","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"413":{"description":"Upload exceeds the per-request total cap","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limited","headers":{"Retry-After":{"description":"Seconds until the limit window resets","schema":{"type":"integer"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"500":{"description":"Processing failure","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/metadata":{"post":{"summary":"Read EPUB metadata","operationId":"readMetadata","requestBody":{"content":{"application/json":{"schema":{"type":"object","required":["file"],"properties":{"file":{"type":"string","description":"Base64-encoded EPUB"}}}}}},"responses":{"200":{"description":"Metadata fields (title, author, language, publisher, description, series, subjects, isbn, ...)","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"}},"additionalProperties":true}}}},"400":{"description":"Invalid input — human message in `error`, machine category in `code`","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"413":{"description":"Upload exceeds the per-request total cap","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limited","headers":{"Retry-After":{"description":"Seconds until the limit window resets","schema":{"type":"integer"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"500":{"description":"Processing failure","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/metadata/edit":{"post":{"summary":"Edit EPUB metadata","description":"Absent fields are left untouched; an explicit empty string clears a field.","operationId":"editMetadata","requestBody":{"content":{"application/json":{"schema":{"type":"object","required":["file"],"properties":{"file":{"type":"string","description":"Base64-encoded EPUB"},"name":{"type":"string","description":"Original filename — the output is named after its stem (e.g. \"Book.epub\" gives \"Book (compressed).epub\"); without it the output keeps a fixed name"},"title":{"type":"string"},"author":{"type":"string"},"authors":{"type":"string","description":"Comma-separated contributor list"},"language":{"type":"string"},"publisher":{"type":"string"},"description":{"type":"string"},"series":{"type":"string"},"seriesPosition":{"type":"string","description":"Position within the series (e.g. \"2\")"},"subjects":{"type":"string","description":"Comma-separated subject/genre tags"},"date":{"type":"string","description":"Publication date (ISO 8601)"},"isbn":{"type":"string"},"cover":{"type":"string","description":"Base64-encoded cover image — JPEG or PNG, 5MB max decoded"}}}}}},"responses":{"200":{"description":"Success — JSON envelope with the base64-encoded output file","content":{"application/json":{"schema":{"$ref":"#/components/schemas/FileResult"}}}},"400":{"description":"Invalid input — human message in `error`, machine category in `code`","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"413":{"description":"Upload exceeds the per-request total cap","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limited","headers":{"Retry-After":{"description":"Seconds until the limit window resets","schema":{"type":"integer"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"500":{"description":"Processing failure","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/epub-to-pdf":{"post":{"summary":"Convert EPUB to PDF","operationId":"epubToPdf","requestBody":{"content":{"application/json":{"schema":{"type":"object","required":["file"],"properties":{"file":{"type":"string","description":"Base64-encoded EPUB"},"name":{"type":"string","description":"Original filename — the output is named after its stem (e.g. \"Book.epub\" gives \"Book (compressed).epub\"); without it the output keeps a fixed name"},"pageSize":{"type":"string","enum":["a4","letter"],"default":"a4"},"margins":{"type":"integer","default":60,"description":"Page margin in points; out-of-range values fall back to 60"},"fontFamily":{"type":"string","enum":["serif","sans"],"default":"serif"},"fontSize":{"type":"integer","minimum":6,"maximum":48,"default":11},"pageNumbers":{"type":"boolean","default":true}}}}}},"responses":{"200":{"description":"Success — JSON envelope with the base64-encoded output file","content":{"application/json":{"schema":{"$ref":"#/components/schemas/FileResult"}}}},"400":{"description":"Invalid input — human message in `error`, machine category in `code`","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"413":{"description":"Upload exceeds the per-request total cap","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limited","headers":{"Retry-After":{"description":"Seconds until the limit window resets","schema":{"type":"integer"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"500":{"description":"Processing failure","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/pdf-to-epub":{"post":{"summary":"Convert PDF to EPUB","operationId":"pdfToEpub","requestBody":{"content":{"application/json":{"schema":{"type":"object","required":["file"],"properties":{"file":{"type":"string","description":"Base64-encoded PDF"},"name":{"type":"string","description":"Original filename — the output is named after its stem (e.g. \"Book.epub\" gives \"Book (compressed).epub\"); without it the output keeps a fixed name"},"language":{"type":"string","default":"en","description":"dc:language of the generated EPUB (BCP 47)"},"chapterMode":{"type":"string","enum":["auto","every-n","single"],"default":"auto"},"pagesPerChapter":{"type":"integer","default":10,"description":"Pages per chapter when chapterMode is 'every-n'"},"extractImages":{"type":"boolean","default":true,"description":"Pro only — ignored on free tier"}}}}}},"responses":{"200":{"description":"Success — JSON envelope with the base64-encoded output file","content":{"application/json":{"schema":{"$ref":"#/components/schemas/FileResult"}}}},"400":{"description":"Invalid input — human message in `error`, machine category in `code`","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"413":{"description":"Upload exceeds the per-request total cap","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limited","headers":{"Retry-After":{"description":"Seconds until the limit window resets","schema":{"type":"integer"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"500":{"description":"Processing failure","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/docx-to-epub":{"post":{"summary":"Convert a Word document (DOCX) to EPUB","description":"Chapters split on the document’s top heading level by default. Bold/italic, lists, tables, inline images, hyperlinks and footnotes are kept; the title and author come from the document properties unless given here.","operationId":"docxToEpub","requestBody":{"content":{"application/json":{"schema":{"type":"object","required":["file"],"properties":{"file":{"type":"string","description":"Base64-encoded .docx"},"name":{"type":"string","description":"Original filename — used as the title fallback; the output is named after its stem"},"title":{"type":"string","maxLength":300},"author":{"type":"string","maxLength":300},"language":{"type":"string","default":"en","description":"dc:language of the generated EPUB (BCP 47)"},"chapterMode":{"type":"string","enum":["headings","page-breaks","single"],"default":"headings","description":"Where chapters start"}}}}}},"responses":{"200":{"description":"Success — JSON envelope with the base64-encoded output file","content":{"application/json":{"schema":{"$ref":"#/components/schemas/FileResult"}}}},"400":{"description":"Invalid input — human message in `error`, machine category in `code`","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"413":{"description":"Upload exceeds the per-request total cap","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limited","headers":{"Retry-After":{"description":"Seconds until the limit window resets","schema":{"type":"integer"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"500":{"description":"Processing failure","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/markdown-to-epub":{"post":{"summary":"Build an EPUB from Markdown files","description":"One Markdown file per chapter, in array order. Chapter titles come from each file’s first heading, falling back to its name.","operationId":"markdownToEpub","requestBody":{"content":{"application/json":{"schema":{"type":"object","required":["files"],"properties":{"files":{"type":"array","minItems":1,"description":"Markdown files, one per chapter, in reading order","items":{"type":"object","required":["content"],"properties":{"name":{"type":"string","description":"Filename (e.g. \"01-opening.md\") — used as the chapter title fallback; the first one names the output"},"content":{"type":"string","description":"Base64-encoded Markdown"}}}},"title":{"type":"string","maxLength":300},"author":{"type":"string","maxLength":300},"language":{"type":"string","default":"en","description":"dc:language of the generated EPUB (BCP 47)"}}}}}},"responses":{"200":{"description":"Success — JSON envelope with the base64-encoded output file","content":{"application/json":{"schema":{"$ref":"#/components/schemas/FileResult"}}}},"400":{"description":"Invalid input — human message in `error`, machine category in `code`","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"413":{"description":"Upload exceeds the per-request total cap","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limited","headers":{"Retry-After":{"description":"Seconds until the limit window resets","schema":{"type":"integer"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"500":{"description":"Processing failure","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/epub-to-markdown":{"post":{"summary":"Convert EPUB to Markdown","description":"Returns a ZIP containing one Markdown file per chapter plus frontmatter, and the extracted images unless includeImages is false.","operationId":"epubToMarkdown","requestBody":{"content":{"application/json":{"schema":{"type":"object","required":["file"],"properties":{"file":{"type":"string","description":"Base64-encoded EPUB"},"name":{"type":"string","description":"Original filename — the output is named after its stem (e.g. \"Book.epub\" gives \"Book (compressed).epub\"); without it the output keeps a fixed name"},"includeImages":{"type":"boolean","default":true,"description":"Include extracted images in the ZIP"}}}}}},"responses":{"200":{"description":"Success — JSON envelope with the base64-encoded output file","content":{"application/json":{"schema":{"$ref":"#/components/schemas/FileResult"}}}},"400":{"description":"Invalid input — human message in `error`, machine category in `code`","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"413":{"description":"Upload exceeds the per-request total cap","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limited","headers":{"Retry-After":{"description":"Seconds until the limit window resets","schema":{"type":"integer"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"500":{"description":"Processing failure","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/validate":{"post":{"summary":"Validate EPUB","operationId":"validateEpub","requestBody":{"content":{"application/json":{"schema":{"type":"object","required":["file"],"properties":{"file":{"type":"string","description":"Base64-encoded EPUB"},"deepScan":{"type":"boolean","default":true},"autoFix":{"type":"boolean","default":false}}}}}},"responses":{"200":{"description":"Validation report (valid, errors, warnings, ...); with autoFix, a FileResult carrying the repaired EPUB","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"}},"additionalProperties":true}}}},"400":{"description":"Invalid input — human message in `error`, machine category in `code`","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"413":{"description":"Upload exceeds the per-request total cap","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limited","headers":{"Retry-After":{"description":"Seconds until the limit window resets","schema":{"type":"integer"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"500":{"description":"Processing failure","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/generate-cover":{"post":{"summary":"Generate AI book cover (Pro only)","description":"Generates a book cover image using FLUX from a description or a title (either is sufficient). Pro tier required — free-tier keys receive 403. Returns a base64-encoded JPEG.","operationId":"generateCover","requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"description":{"type":"string","maxLength":2000,"description":"Visual description of the cover (subject, mood, style)"},"title":{"type":"string","maxLength":200},"author":{"type":"string","maxLength":200},"genre":{"type":"string","enum":["fantasy","romance","thriller","sci-fi","literary","non-fiction","horror","children","poetry","minimalist"],"default":"literary","description":"Book genre — affects style and composition"},"seed":{"type":"integer","description":"Optional seed for reproducible output"}}}}}},"responses":{"200":{"description":"Generated cover + monthly quota state","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"image":{"type":"string","description":"Base64-encoded JPEG"},"contentType":{"type":"string"},"used":{"type":"integer"},"cap":{"type":"integer"},"remaining":{"type":"integer"}}}}}},"400":{"description":"Invalid input — human message in `error`, machine category in `code`","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Pro tier required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"413":{"description":"Upload exceeds the per-request total cap","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limited","headers":{"Retry-After":{"description":"Seconds until the limit window resets","schema":{"type":"integer"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"500":{"description":"Processing failure","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/upgrade":{"post":{"summary":"Get a Pro checkout link for this account","description":"Returns a Stripe checkout URL for the account that owns the API key, so a programmatic caller refused with `daily_limited` can resolve it rather than only report a pricing URL. The email is taken from the authenticated key and never from the body — this cannot be used to pay for another account. Creates no charge by itself, and is not counted against the free daily allowance. Mirrors the `upgrade_to_pro` MCP tool.","operationId":"upgradeToPro","requestBody":{"required":false,"content":{"application/json":{"schema":{"type":"object","properties":{"plan":{"type":"string","enum":["monthly","yearly"],"default":"monthly","description":"monthly is $9/month; yearly is $72/year"}}}}}},"responses":{"200":{"description":"Checkout link, or alreadyPro when the account is already on Pro","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"checkoutUrl":{"type":"string"},"plan":{"type":"string"},"price":{"type":"string"},"account":{"type":"string"},"alreadyPro":{"type":"boolean"}}}}}},"400":{"description":"Invalid input — human message in `error`, machine category in `code`","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"The Stripe billing record for this email belongs to another Epublys account (`code` customer_id_collision) — no session is created; write to hello@epublys.com","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"413":{"description":"Upload exceeds the per-request total cap","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limited","headers":{"Retry-After":{"description":"Seconds until the limit window resets","schema":{"type":"integer"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"500":{"description":"Processing failure","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"503":{"description":"Checkout unavailable on this deployment","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/usage":{"get":{"summary":"Read this account's remaining allowance","operationId":"readUsage","description":"Daily operations and AI-cover quota for the account that owns the API key. Not metered and never counted against the daily allowance, so a caller can check before spending. The daily allowance is per ACCOUNT and shared by every key and by both REST and MCP.","responses":{"200":{"description":"Current allowance","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"plan":{"type":"string"},"account":{"type":"string"},"dailyOps":{"type":"object"},"cover":{"type":"object"}}}}}},"400":{"description":"Invalid input — human message in `error`, machine category in `code`","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"413":{"description":"Upload exceeds the per-request total cap","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limited","headers":{"Retry-After":{"description":"Seconds until the limit window resets","schema":{"type":"integer"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"500":{"description":"Processing failure","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}}}}