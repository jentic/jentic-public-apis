    "/v1/tags/{id}/lead-stages": {
      "post": {
        "tags": [
          "Lead stages"
        ],
        "summary": "Create Lead stage",
        "description": "Adds a custom lead stage between Qualified and Converted. Stage names must be unique. Default stages cannot be renamed, reordered, or deleted.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "0YFe6H1"
            },
            "description": "The ID of the tag"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Display name for the new stage",
                    "example": "Negotiation"
                  }
                }
              }
            }
          },
          "description": "Adds a custom lead stage between Qualified and Converted. Stage names must be unique. Default stages cannot be renamed, reordered, or deleted."
