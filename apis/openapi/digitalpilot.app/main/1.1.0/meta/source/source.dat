{
  "openapi": "3.0.0",
  "servers": [
    {
      "url": "https://api.digitalpilot.app",
      "description": "Production server"
    }
  ],
  "info": {
    "title": "DigitalPilot API",
    "description": "Using the REST API allows you to programmatically execute a wide range of code operations which are also available through the user interface.",
    "version": "1.1.0"
  },
  "paths": {
    "/v1/tags/{id}/contacts/domain-search": {
      "post": {
        "tags": [
          "Contacts"
        ],
        "summary": "Search contacts by domain",
        "description": "Returns personal contacts for a company at no credit cost. Each request returns at most 10 contacts; use offset to load the next page. Name, title, LinkedIn, and other contact fields are always included. Only the email address (email / value) is null until unlocked.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "0YFe6H1"
            },
            "description": "The workspace (tag) ID"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "domain": {
                    "type": "string",
                    "description": "Company domain",
                    "example": "stripe.com"
                  },
                  "company": {
                    "type": "string",
                    "description": "Company name if domain is unknown",
                    "example": "Stripe"
                  },
                  "offset": {
                    "type": "number",
                    "description": "Result offset. Page size is always 10.",
                    "example": "0"
                  },
                  "seniority": {
                    "type": "string",
                    "description": "Optional seniority filter",
                    "example": "executive"
                  },
                  "department": {
                    "type": "string",
                    "description": "Optional department filter",
                    "example": "management"
                  },
                  "decision_maker": {
                    "type": "boolean",
                    "description": "Optional decision-maker filter",
                    "example": "true"
                  }
                }
              }
            }
          },
          "description": "Returns personal contacts for a company at no credit cost. Each request returns at most 10 contacts; use offset to load the next page. Name, title, LinkedIn, and other contact fields are always included. Only the email address (email / value) is null until unlocked."
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "example": {
                  "data": {
                    "domain": "stripe.com",
                    "organization": "Stripe",
                    "contacts": [
                      {
                        "id": "a1b2c3",
                        "value": null,
                        "type": "personal",
                        "confidence": 94,
                        "first_name": "Jane",
                        "last_name": "Doe",
                        "position": "CEO",
                        "seniority": "executive",
                        "department": "executive",
                        "decision_maker": true,
                        "linkedin": "https://www.linkedin.com/in/jane",
                        "phone_number": "+1 555 0100",
                        "email_revealed": false,
                        "reveal_credits": 2
                      }
                    ]
                  },
                  "meta": {
                    "results": 42,
                    "limit": 10,
                    "offset": 0,
                    "credits_used": 0,
                    "credits_remaining": 500
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "example": {
                  "error": "Invalid request"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "example": {
                  "error": "Unauthorized"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "example": {
                  "error": "Not Found"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "example": {
                  "error": "Too Many Requests"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "example": {
                  "error": "Internal server error"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/v1/tags/{id}/contacts/email-validator": {
      "post": {
        "tags": [
          "Contacts"
        ],
        "summary": "Validate an email address",
        "description": "Checks format, typos, disposable domains, and MX records without an SMTP mailbox probe. When those checks pass, verifies the mailbox. Costs 1 credit for each completed validation. Returns 402 when the workspace balance is below 1.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "0YFe6H1"
            },
            "description": "The workspace (tag) ID"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "description": "Email address to validate",
                    "example": "jane@stripe.com"
                  },
                  "ip_address": {
                    "type": "string",
                    "description": "Optional IP the address signed up from",
                    "example": "156.124.12.145"
                  }
                }
              }
            }
          },
          "description": "Checks format, typos, disposable domains, and MX records without an SMTP mailbox probe. When those checks pass, verifies the mailbox. Costs 1 credit for each completed validation. Returns 402 when the workspace balance is below 1."
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "example": {
                  "data": {
                    "email": "jane@stripe.com",
                    "valid": true,
                    "status": "valid",
                    "checks": {
                      "valid": true,
                      "validators": {
                        "regex": {
                          "valid": true
                        },
                        "typo": {
                          "valid": true
                        },
                        "disposable": {
                          "valid": true
                        },
                        "mx": {
                          "valid": true
                        }
                      }
                    },
                    "mailbox": {
                      "address": "jane@stripe.com",
                      "status": "valid",
                      "sub_status": "",
                      "free_email": false,
                      "mx_found": "true"
                    }
                  },
                  "meta": {
                    "credits_used": 1,
                    "credits_remaining": 499
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "example": {
                  "error": "Invalid request"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "example": {
                  "error": "Unauthorized"
                }
              }
            }
          },
          "402": {
            "description": "Insufficient credits",
            "content": {
              "application/json": {
                "example": {
                  "error": "Insufficient credits"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "example": {
                  "error": "Not Found"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "example": {
                  "error": "Too Many Requests"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "example": {
                  "error": "Internal server error"
                }
              }
            }
          },
          "502": {
            "description": "Email provider unavailable",
            "content": {
              "application/json": {
                "example": {
                  "error": "Email provider unavailable"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/v1/tags/{id}/contacts/reveal-email": {
      "post": {
        "tags": [
          "Contacts"
        ],
        "summary": "Reveal a contact email",
        "description": "Unlocks one cached personal email and adds the contact to Lead Center with name, title, LinkedIn, phone, and other Hunter fields. Decision makers cost 2 credits; everyone else costs 1 credit. Returns 402 and does not unlock when the workspace has too few credits. Already unlocked emails are returned from cache at no credit cost.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "0YFe6H1"
            },
            "description": "The workspace (tag) ID"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "domain": {
                    "type": "string",
                    "description": "Company domain",
                    "example": "stripe.com"
                  },
                  "contact_id": {
                    "type": "string",
                    "description": "Contact ID from domain search",
                    "example": "2c26b46b68ffc68ff99b453c1d30413413422d706483bfa0f98a5e886266e7ae"
                  }
                }
              }
            }
          },
          "description": "Unlocks one cached personal email and adds the contact to Lead Center with name, title, LinkedIn, phone, and other Hunter fields. Decision makers cost 2 credits; everyone else costs 1 credit. Returns 402 and does not unlock when the workspace has too few credits. Already unlocked emails are returned from cache at no credit cost."
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "example": {
                  "data": {
                    "domain": "stripe.com",
                    "contact": {
                      "id": "a1b2c3",
                      "value": "jane@stripe.com",
                      "type": "personal",
                      "first_name": "Jane",
                      "last_name": "Doe",
                      "position": "CEO",
                      "decision_maker": true,
                      "email_revealed": true,
                      "reveal_credits": 2
                    }
                  },
                  "meta": {
                    "credits_used": 2,
                    "credits_remaining": 498,
                    "already_revealed": false
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "example": {
                  "error": "Invalid request"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "example": {
                  "error": "Unauthorized"
                }
              }
            }
          },
          "402": {
            "description": "Insufficient credits",
            "content": {
              "application/json": {
                "example": {
                  "error": "Insufficient credits"
                }
              }
            }
          },
          "404": {
            "description": "Contact not found",
            "content": {
              "application/json": {
                "example": {
                  "error": "Contact not found"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "example": {
                  "error": "Too Many Requests"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "example": {
                  "error": "Internal server error"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/v1/tags/{id}/activities/{domain}": {
      "get": {
        "tags": [
          "Reports"
        ],
        "summary": "Get Domain Activities",
        "description": "Returns paginated raw activities for a single domain within a tag. Supports optional date filtering in workspace timezone. Requires x-api-key and tag access.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "0YFe6H1"
            },
            "description": "The ID of the tag"
          },
          {
            "name": "domain",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "example.com"
            },
            "description": "Domain to fetch activities for"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "example": "1"
            },
            "description": "Page number for pagination (default: 1)"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "example": "10"
            },
            "description": "Number of activities per page (default: 10)"
          },
          {
            "name": "start_date",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "example": "2024-01-01"
            },
            "description": "Start date in YYYY-MM-DD format"
          },
          {
            "name": "end_date",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "example": "2024-01-29"
            },
            "description": "End date in YYYY-MM-DD format"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {}
              }
            }
          },
          "description": "Returns paginated raw activities for a single domain within a tag. Supports optional date filtering in workspace timezone. Requires x-api-key and tag access."
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "example": {
                  "activities": [
                    {
                      "_id": "65a7a4...",
                      "tag_id": "0YFe6H1",
                      "domain": "example.com",
                      "visitor_id": "v_123",
                      "session_id": "s_456",
                      "time": "2024-01-25T14:12:00.000Z",
                      "params": {
                        "channel": "Google Ads",
                        "high_intent": true
                      }
                    }
                  ],
                  "pagination": {
                    "totalItems": 32,
                    "totalPages": 4,
                    "currentPage": 1,
                    "hasNextPage": true,
                    "hasPrevPage": false
                  },
                  "metadata": {
                    "timezone": "America/New_York"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing required parameters or invalid date format/range",
            "content": {
              "application/json": {
                "example": {
                  "error": "Missing required parameters or invalid date format/range"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "example": {
                  "error": "Unauthorized"
                }
              }
            }
          },
          "404": {
            "description": "No matching activities found",
            "content": {
              "application/json": {
                "example": {
                  "error": "No matching activities found"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "example": {
                  "error": "Too Many Requests"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "example": {
                  "error": "Internal server error"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/v1/tags/{id}/reports/channel": {
      "get": {
        "tags": [
          "Reports"
        ],
        "summary": "Get Channel Report",
        "description": "Returns performance metrics grouped by traffic channel. Supports pagination, channel filtering, and CSV export. Requires x-api-key and tag access.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "0YFe6H1"
            },
            "description": "The ID of the tag"
          },
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "example": "7"
            },
            "description": "Number of days to look back (default: 7)"
          },
          {
            "name": "start_date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "example": "2024-01-01"
            },
            "description": "Start date in YYYY-MM-DD format"
          },
          {
            "name": "end_date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "example": "2024-01-29"
            },
            "description": "End date in YYYY-MM-DD format"
          },
          {
            "name": "download",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "example": "csv"
            },
            "description": "Download format: 'csv' or 'xlsx' to download as CSV or Excel file"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "example": "1"
            },
            "description": "Page number for pagination (default: 1)"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "example": "20"
            },
            "description": "Number of items per page (default: 20)"
          },
          {
            "name": "channel",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "example": "Google Ads"
            },
            "description": "Filter by channel"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {}
              }
            }
          },
          "description": "Returns performance metrics grouped by traffic channel. Supports pagination, channel filtering, and CSV export. Requires x-api-key and tag access."
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "example": {
                  "tag_id": "0YFe6H1",
                  "report_period": "7 days",
                  "date_range": {
                    "start": "2024-01-01T00:00:00.000Z",
                    "end": "2024-01-29T23:59:59.999Z"
                  },
                  "summary": {
                    "total_channels": 8,
                    "total_unique_visitors": 120,
                    "total_sessions": 180,
                    "total_high_intent_sessions": 25
                  },
                  "channel_data": [
                    {
                      "channel": "Google Ads",
                      "unique_visitors": 45,
                      "unique_sessions": 65,
                      "high_intent_sessions": 8,
                      "total_activities": 120
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Missing required parameter or invalid date range",
            "content": {
              "application/json": {
                "example": {
                  "error": "Missing required parameter or invalid date range"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "example": {
                  "error": "Unauthorized"
                }
              }
            }
          },
          "404": {
            "description": "Tag not found",
            "content": {
              "application/json": {
                "example": {
                  "error": "Tag not found"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "example": {
                  "error": "Too Many Requests"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "example": {
                  "error": "Internal server error"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/v1/tags/{id}/reports/dashboard": {
      "get": {
        "tags": [
          "Reports"
        ],
        "summary": "Get Dashboard Report",
        "description": "Returns time-series metrics and totals for accounts, visitors, sessions, high-intent sessions, leads, and assisted attribution for the selected date range. Requires x-api-key and tag access.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "0YFe6H1"
            },
            "description": "The ID of the tag"
          },
          {
            "name": "start_date",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "example": "2024-01-01"
            },
            "description": "Start date in YYYY-MM-DD format"
          },
          {
            "name": "end_date",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "example": "2024-01-29"
            },
            "description": "End date in YYYY-MM-DD format"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {}
              }
            }
          },
          "description": "Returns time-series metrics and totals for accounts, visitors, sessions, high-intent sessions, leads, and assisted attribution for the selected date range. Requires x-api-key and tag access."
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "example": {
                  "time_series": [
                    {
                      "date": "2024-01-22",
                      "total_accounts": 18,
                      "unique_visitors": 55,
                      "unique_sessions": 72,
                      "high_intent_sessions": 9,
                      "leads": 3,
                      "assisted_leads": 1,
                      "assisted_high_intent_sessions": 2
                    }
                  ],
                  "timestamp": "2024-01-29T12:00:00.000Z",
                  "date_range": {
                    "start_date": "2024-01-22T05:00:00.000Z",
                    "end_date": "2024-01-29T04:59:59.999Z"
                  },
                  "metadata": {
                    "tag_id": "0YFe6H1",
                    "timezone": "America/New_York",
                    "total_points": 7,
                    "totals": {
                      "total_accounts": 62,
                      "total_unique_visitors": 210,
                      "total_sessions": 305,
                      "total_high_intent_sessions": 48,
                      "total_leads": 14,
                      "total_assisted_leads": 6,
                      "total_assisted_high_intent_sessions": 11
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing required parameter or invalid date format/range",
            "content": {
              "application/json": {
                "example": {
                  "error": "Missing required parameter or invalid date format/range"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "example": {
                  "error": "Unauthorized"
                }
              }
            }
          },
          "404": {
            "description": "Tag not found",
            "content": {
              "application/json": {
                "example": {
                  "error": "Tag not found"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "example": {
                  "error": "Too Many Requests"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "example": {
                  "error": "Internal server error"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/v1/tags/{id}/leads": {
      "get": {
        "tags": [
          "Leads"
        ],
        "summary": "Get Leads",
