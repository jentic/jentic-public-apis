      "put": {
        "tags": [
          "Leads"
        ],
        "summary": "Update Lead",
        "description": "Updates a captured lead stage. Sends a Meta Conversions API lead-stage event when the lead has a Facebook lead id or fbclid.",
        "parameters": [
          {
            "name": "id",
