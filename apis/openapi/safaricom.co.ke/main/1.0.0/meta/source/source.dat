{
  "openapi": "3.0.3",
  "info": {
    "title": "Safaricom M-Pesa Daraja API",
    "description": "The Daraja API is a set of REST APIs enabling integration with M-Pesa, Kenya's leading mobile money platform by Safaricom. It supports STK Push (Lipa Na M-Pesa Online), C2B, B2C, B2B payments, transaction status queries, account balance checks, and reversal operations.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://developer.safaricom.co.ke/APIs",
    "contact": {
      "name": "Safaricom Developer Support",
      "url": "https://developer.safaricom.co.ke/"
    }
  },
  "servers": [
    {
      "url": "https://api.safaricom.co.ke",
      "description": "M-Pesa Daraja Production API"
    },
    {
      "url": "https://sandbox.safaricom.co.ke",
      "description": "M-Pesa Daraja Sandbox API"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/oauth/v1/generate": {
      "get": {
        "operationId": "generateAccessToken",
        "summary": "Generate OAuth access token",
        "description": "Generate an OAuth access token using consumer key and secret via Basic Auth. The token is used to authenticate all subsequent API calls and expires after 3600 seconds.",
        "tags": ["Authentication"],
        "security": [
          {
            "basicAuth": []
          }
        ],
        "parameters": [
          {
            "name": "grant_type",
            "in": "query",
            "required": true,
            "description": "OAuth grant type. Must be client_credentials.",
            "schema": {
              "type": "string",
              "enum": ["client_credentials"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Access token generated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "access_token": {
                      "type": "string",
                      "description": "The OAuth access token to use for API authentication.",
                      "example": "0A0v8OgxqqoocblflR72RfMFOcAj"
                    },
                    "expires_in": {
                      "type": "string",
                      "description": "Token expiry time in seconds.",
                      "example": "3599"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid grant type",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "401": {
            "description": "Unauthorized - invalid consumer key or secret",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/mpesa/stkpush/v1/processrequest": {
      "post": {
        "operationId": "inititateStkPush",
        "summary": "Initiate M-Pesa Express (STK Push) payment",
        "description": "Initiate a Lipa Na M-Pesa Online (STK Push) payment request. This triggers a USSD prompt on the customer's phone to authorize the payment.",
        "tags": ["M-Pesa Express"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "BusinessShortCode",
                  "Password",
                  "Timestamp",
                  "TransactionType",
                  "Amount",
                  "PartyA",
                  "PartyB",
                  "PhoneNumber",
                  "CallBackURL",
                  "AccountReference",
                  "TransactionDesc"
                ],
                "properties": {
                  "BusinessShortCode": {
                    "type": "string",
                    "description": "The organization shortcode used to receive the transaction.",
                    "example": "174379"
                  },
                  "Password": {
                    "type": "string",
                    "description": "Base64-encoded string of BusinessShortCode + Passkey + Timestamp.",
                    "example": "MTc0Mzc5YmZiMjc5..."
                  },
                  "Timestamp": {
                    "type": "string",
                    "description": "Timestamp in the format YYYYMMDDHHmmss.",
                    "example": "20260410120000"
                  },
                  "TransactionType": {
                    "type": "string",
                    "description": "Transaction type identifier.",
                    "enum": ["CustomerPayBillOnline", "CustomerBuyGoodsOnline"],
                    "example": "CustomerPayBillOnline"
                  },
                  "Amount": {
                    "type": "string",
                    "description": "Amount to be transacted.",
                    "example": "1"
                  },
                  "PartyA": {
                    "type": "string",
                    "description": "Phone number sending money (MSISDN format 2547XXXXXXXX).",
                    "example": "254712345678"
                  },
                  "PartyB": {
                    "type": "string",
                    "description": "Organization shortcode receiving the funds.",
                    "example": "174379"
                  },
                  "PhoneNumber": {
                    "type": "string",
                    "description": "Phone number to receive the STK push prompt.",
                    "example": "254712345678"
                  },
                  "CallBackURL": {
                    "type": "string",
                    "description": "URL to receive payment result notification.",
                    "example": "https://example.com/callback"
                  },
                  "AccountReference": {
                    "type": "string",
                    "description": "Account reference for the transaction, max 12 characters.",
                    "example": "INV001"
                  },
                  "TransactionDesc": {
                    "type": "string",
                    "description": "Description of the transaction, max 13 characters.",
                    "example": "Payment"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "STK Push request accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "MerchantRequestID": {
                      "type": "string",
                      "description": "Unique request ID for tracking.",
                      "example": "29115-34620561-1"
                    },
                    "CheckoutRequestID": {
                      "type": "string",
                      "description": "Unique checkout request ID.",
                      "example": "ws_CO_191220191020363925"
                    },
                    "ResponseCode": {
                      "type": "string",
                      "description": "Response code. 0 means success.",
                      "example": "0"
                    },
                    "ResponseDescription": {
                      "type": "string",
                      "example": "Success. Request accepted for processing"
                    },
                    "CustomerMessage": {
                      "type": "string",
                      "example": "Success. Request accepted for processing"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid parameters",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "401": {
            "description": "Unauthorized - invalid or expired access token",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/mpesa/stkpushquery/v1/query": {
      "post": {
        "operationId": "queryStkPushStatus",
        "summary": "Query M-Pesa Express (STK Push) transaction status",
        "description": "Check the status of a previously initiated STK Push payment request.",
        "tags": ["M-Pesa Express"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["BusinessShortCode", "Password", "Timestamp", "CheckoutRequestID"],
                "properties": {
                  "BusinessShortCode": {
                    "type": "string",
                    "description": "The organization shortcode.",
                    "example": "174379"
                  },
                  "Password": {
                    "type": "string",
                    "description": "Base64-encoded string of BusinessShortCode + Passkey + Timestamp."
                  },
                  "Timestamp": {
                    "type": "string",
                    "description": "Timestamp in the format YYYYMMDDHHmmss."
                  },
                  "CheckoutRequestID": {
                    "type": "string",
                    "description": "Checkout request ID from the STK Push response.",
                    "example": "ws_CO_191220191020363925"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Query result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ResponseCode": { "type": "string", "example": "0" },
                    "ResponseDescription": { "type": "string" },
                    "MerchantRequestID": { "type": "string" },
                    "CheckoutRequestID": { "type": "string" },
                    "ResultCode": { "type": "string", "description": "0 for success, other codes indicate failure." },
                    "ResultDesc": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/mpesa/c2b/v1/registerurl": {
      "post": {
        "operationId": "registerC2bUrl",
        "summary": "Register C2B validation and confirmation URLs",
        "description": "Register the validation and confirmation URLs for Customer-to-Business (C2B) transactions. These URLs receive notifications when customers make payments to the business shortcode.",
        "tags": ["C2B"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["ShortCode", "ResponseType", "ConfirmationURL", "ValidationURL"],
                "properties": {
                  "ShortCode": {
                    "type": "string",
                    "description": "The shortcode of the organization.",
                    "example": "600000"
                  },
                  "ResponseType": {
                    "type": "string",
                    "description": "Default response type for timeout. Completed or Cancelled.",
                    "enum": ["Completed", "Cancelled"]
                  },
                  "ConfirmationURL": {
                    "type": "string",
                    "description": "URL to receive payment confirmation notifications.",
                    "example": "https://example.com/confirmation"
                  },
                  "ValidationURL": {
                    "type": "string",
                    "description": "URL to receive validation requests before payment completion.",
                    "example": "https://example.com/validation"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "URLs registered successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "OriginatorCoversationID": { "type": "string" },
                    "ResponseCode": { "type": "string", "example": "0" },
                    "ResponseDescription": { "type": "string", "example": "Success" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/mpesa/c2b/v1/simulate": {
      "post": {
        "operationId": "simulateC2bTransaction",
        "summary": "Simulate a C2B transaction (sandbox only)",
        "description": "Simulate a Customer-to-Business payment for testing purposes. This endpoint is only available in the sandbox environment.",
        "tags": ["C2B"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["ShortCode", "CommandID", "Amount", "Msisdn", "BillRefNumber"],
                "properties": {
                  "ShortCode": {
                    "type": "string",
                    "description": "Organization shortcode.",
                    "example": "600000"
                  },
                  "CommandID": {
                    "type": "string",
                    "description": "Unique command for the transaction type.",
                    "enum": ["CustomerPayBillOnline", "CustomerBuyGoodsOnline"]
                  },
                  "Amount": {
                    "type": "string",
                    "description": "Amount to transact.",
                    "example": "100"
                  },
                  "Msisdn": {
                    "type": "string",
                    "description": "Phone number initiating the transaction.",
                    "example": "254712345678"
                  },
                  "BillRefNumber": {
                    "type": "string",
                    "description": "Account number for PayBill transactions.",
                    "example": "INV001"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Simulation accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "OriginatorCoversationID": { "type": "string" },
                    "ResponseCode": { "type": "string", "example": "0" },
                    "ResponseDescription": { "type": "string", "example": "Accept the service request successfully." }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/mpesa/b2c/v1/paymentrequest": {
      "post": {
        "operationId": "initiateB2cPayment",
        "summary": "Initiate B2C payment",
        "description": "Initiate a Business-to-Customer payment. Used for salary payments, promotions, or refunds from business to customer M-Pesa accounts.",
        "tags": ["B2C"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "InitiatorName",
                  "SecurityCredential",
                  "CommandID",
                  "Amount",
                  "PartyA",
                  "PartyB",
                  "Remarks",
                  "QueueTimeOutURL",
                  "ResultURL"
                ],
                "properties": {
                  "InitiatorName": {
                    "type": "string",
                    "description": "The username of the API operator as set on the portal.",
                    "example": "testapi"
                  },
                  "SecurityCredential": {
                    "type": "string",
                    "description": "Base64-encoded encrypted initiator password using the M-Pesa public key."
                  },
                  "CommandID": {
                    "type": "string",
                    "description": "Type of B2C transaction.",
                    "enum": ["SalaryPayment", "BusinessPayment", "PromotionPayment"]
                  },
                  "Amount": {
                    "type": "string",
                    "description": "Amount to be sent to the customer.",
                    "example": "100"
                  },
                  "PartyA": {
                    "type": "string",
                    "description": "Organization shortcode sending the money.",
                    "example": "600000"
                  },
                  "PartyB": {
                    "type": "string",
                    "description": "Customer phone number receiving the money.",
                    "example": "254712345678"
                  },
                  "Remarks": {
                    "type": "string",
                    "description": "Comments about the transaction.",
                    "example": "Salary payment"
                  },
                  "QueueTimeOutURL": {
                    "type": "string",
                    "description": "URL to receive notification if the request times out.",
                    "example": "https://example.com/timeout"
                  },
                  "ResultURL": {
                    "type": "string",
                    "description": "URL to receive the transaction result.",
                    "example": "https://example.com/result"
                  },
                  "Occasion": {
                    "type": "string",
                    "description": "Optional description."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "B2C request accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ConversationID": { "type": "string", "example": "AG_20191219_00004492b1b6f0af19f9" },
                    "OriginatorConversationID": { "type": "string" },
                    "ResponseCode": { "type": "string", "example": "0" },
                    "ResponseDescription": { "type": "string", "example": "Accept the service request successfully." }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/mpesa/b2b/v1/paymentrequest": {
      "post": {
        "operationId": "initiateB2bPayment",
        "summary": "Initiate B2B payment",
        "description": "Initiate a Business-to-Business payment between two organizations via M-Pesa.",
        "tags": ["B2B"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "Initiator",
                  "SecurityCredential",
                  "CommandID",
                  "SenderIdentifierType",
                  "RecieverIdentifierType",
                  "Amount",
                  "PartyA",
                  "PartyB",
                  "Remarks",
                  "QueueTimeOutURL",
                  "ResultURL",
                  "AccountReference"
                ],
                "properties": {
                  "Initiator": {
                    "type": "string",
                    "description": "The username of the API operator."
                  },
                  "SecurityCredential": {
                    "type": "string",
                    "description": "Base64-encoded encrypted initiator password."
                  },
                  "CommandID": {
                    "type": "string",
                    "description": "Type of B2B transaction.",
                    "enum": ["BusinessPayBill", "MerchantToMerchantTransfer", "MerchantTransferFromMerchantToWorking", "MerchantServicesMMFAccountTransfer", "AgencyFloatAdvance"]
                  },
                  "SenderIdentifierType": {
                    "type": "string",
                    "description": "Type of organization sending. 4 for Paybill.",
                    "enum": ["1", "2", "4"]
                  },
                  "RecieverIdentifierType": {
                    "type": "string",
                    "description": "Type of organization receiving. 4 for Paybill.",
                    "enum": ["1", "2", "4"]
                  },
                  "Amount": {
                    "type": "string",
                    "description": "Transaction amount.",
                    "example": "100"
                  },
                  "PartyA": {
                    "type": "string",
                    "description": "Sending organization shortcode.",
                    "example": "600000"
                  },
                  "PartyB": {
                    "type": "string",
                    "description": "Receiving organization shortcode.",
                    "example": "600001"
                  },
                  "Remarks": {
                    "type": "string",
                    "description": "Comments about the transaction."
                  },
                  "QueueTimeOutURL": {
                    "type": "string",
                    "description": "URL for timeout notifications."
                  },
                  "ResultURL": {
                    "type": "string",
                    "description": "URL for result notifications."
                  },
                  "AccountReference": {
                    "type": "string",
                    "description": "Account reference for the transaction."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "B2B request accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ConversationID": { "type": "string" },
                    "OriginatorConversationID": { "type": "string" },
                    "ResponseCode": { "type": "string", "example": "0" },
                    "ResponseDescription": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/mpesa/transactionstatus/v1/query": {
      "post": {
        "operationId": "queryTransactionStatus",
        "summary": "Query transaction status",
        "description": "Check the status of an M-Pesa transaction using the transaction ID.",
        "tags": ["Transaction Status"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "Initiator",
                  "SecurityCredential",
                  "CommandID",
                  "TransactionID",
                  "PartyA",
                  "IdentifierType",
                  "ResultURL",
                  "QueueTimeOutURL",
                  "Remarks"
                ],
                "properties": {
                  "Initiator": {
                    "type": "string",
                    "description": "The username of the API operator."
                  },
                  "SecurityCredential": {
                    "type": "string",
                    "description": "Base64-encoded encrypted initiator password."
                  },
                  "CommandID": {
                    "type": "string",
                    "description": "Must be TransactionStatusQuery.",
                    "enum": ["TransactionStatusQuery"]
                  },
                  "TransactionID": {
                    "type": "string",
                    "description": "The M-Pesa transaction ID to query.",
                    "example": "OEI2AK4Q16"
                  },
                  "PartyA": {
                    "type": "string",
                    "description": "Organization shortcode.",
                    "example": "600000"
                  },
                  "IdentifierType": {
                    "type": "string",
                    "description": "Type of organization. 1=MSISDN, 2=Till, 4=Paybill.",
                    "enum": ["1", "2", "4"]
                  },
                  "ResultURL": {
                    "type": "string",
                    "description": "URL to receive the query result."
                  },
                  "QueueTimeOutURL": {
                    "type": "string",
                    "description": "URL for timeout notifications."
                  },
                  "Remarks": {
                    "type": "string",
                    "description": "Comments about the query."
                  },
                  "Occasion": {
                    "type": "string",
                    "description": "Optional description."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Query accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ConversationID": { "type": "string" },
                    "OriginatorConversationID": { "type": "string" },
                    "ResponseCode": { "type": "string", "example": "0" },
                    "ResponseDescription": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/mpesa/accountbalance/v1/query": {
      "post": {
        "operationId": "queryAccountBalance",
        "summary": "Query account balance",
        "description": "Query the balance of an M-Pesa business account (Paybill or Till).",
        "tags": ["Account Balance"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "Initiator",
                  "SecurityCredential",
                  "CommandID",
                  "PartyA",
                  "IdentifierType",
                  "Remarks",
                  "QueueTimeOutURL",
                  "ResultURL"
                ],
                "properties": {
                  "Initiator": {
                    "type": "string",
                    "description": "The username of the API operator."
                  },
                  "SecurityCredential": {
                    "type": "string",
                    "description": "Base64-encoded encrypted initiator password."
                  },
                  "CommandID": {
                    "type": "string",
                    "description": "Must be AccountBalance.",
                    "enum": ["AccountBalance"]
                  },
                  "PartyA": {
                    "type": "string",
                    "description": "Organization shortcode to query.",
                    "example": "600000"
                  },
                  "IdentifierType": {
                    "type": "string",
                    "description": "Type of organization. 4 for Paybill.",
                    "enum": ["1", "2", "4"]
                  },
                  "Remarks": {
                    "type": "string",
                    "description": "Comments about the query."
                  },
                  "QueueTimeOutURL": {
                    "type": "string",
                    "description": "URL for timeout notifications."
                  },
                  "ResultURL": {
                    "type": "string",
                    "description": "URL to receive the balance result."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Balance query accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ConversationID": { "type": "string" },
                    "OriginatorConversationID": { "type": "string" },
                    "ResponseCode": { "type": "string", "example": "0" },
                    "ResponseDescription": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/mpesa/reversal/v1/request": {
      "post": {
        "operationId": "reverseTransaction",
        "summary": "Reverse an M-Pesa transaction",
        "description": "Reverse a completed M-Pesa transaction. Used to refund payments made in error.",
        "tags": ["Reversal"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "Initiator",
                  "SecurityCredential",
                  "CommandID",
                  "TransactionID",
                  "Amount",
                  "ReceiverParty",
                  "RecieverIdentifierType",
                  "ResultURL",
                  "QueueTimeOutURL",
                  "Remarks"
                ],
                "properties": {
                  "Initiator": {
                    "type": "string",
                    "description": "The username of the API operator."
                  },
                  "SecurityCredential": {
                    "type": "string",
                    "description": "Base64-encoded encrypted initiator password."
                  },
                  "CommandID": {
                    "type": "string",
                    "description": "Must be TransactionReversal.",
                    "enum": ["TransactionReversal"]
                  },
                  "TransactionID": {
                    "type": "string",
                    "description": "The M-Pesa transaction ID to reverse.",
                    "example": "OEI2AK4Q16"
                  },
                  "Amount": {
                    "type": "string",
                    "description": "Amount to reverse.",
                    "example": "100"
                  },
                  "ReceiverParty": {
                    "type": "string",
                    "description": "Organization shortcode that received the original payment.",
                    "example": "600000"
                  },
                  "RecieverIdentifierType": {
                    "type": "string",
                    "description": "Type of organization. 4 for Paybill, 2 for Till.",
                    "enum": ["2", "4", "11"]
                  },
                  "ResultURL": {
                    "type": "string",
                    "description": "URL to receive the reversal result."
                  },
                  "QueueTimeOutURL": {
                    "type": "string",
                    "description": "URL for timeout notifications."
                  },
                  "Remarks": {
                    "type": "string",
                    "description": "Comments about the reversal."
                  },
                  "Occasion": {
                    "type": "string",
                    "description": "Optional description."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reversal request accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ConversationID": { "type": "string" },
                    "OriginatorConversationID": { "type": "string" },
                    "ResponseCode": { "type": "string", "example": "0" },
                    "ResponseDescription": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Bearer token obtained from the OAuth token generation endpoint. Pass as Authorization: Bearer {access_token}."
      },
      "basicAuth": {
        "type": "http",
        "scheme": "basic",
        "description": "HTTP Basic Auth using Consumer Key as username and Consumer Secret as password. Used only for the OAuth token generation endpoint."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "description": "Unique request identifier."
          },
          "errorCode": {
            "type": "string",
            "description": "Error code.",
            "example": "400.002.02"
          },
          "errorMessage": {
            "type": "string",
            "description": "Human-readable error description.",
            "example": "Bad Request - Invalid Amount"
          }
        }
      }
    }
  }
}