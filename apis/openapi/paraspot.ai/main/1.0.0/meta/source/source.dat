{
  "openapi": "3.0.0",
  "info": {
    "title": "Paraspot API",
    "version": "1.0.0",
    "description": "API for managing units, tenancies, inspections, and AI-generated reports.\n",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/paraspotai/paraspot-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://www.paraspot.ai/api",
      "description": "Production API"
    }
  ],
  "tags": [
    {
      "name": "Properties",
      "description": "Manage properties and properties metadata."
    },
    {
      "name": "Units",
      "description": "Manage units and unit metadata."
    },
    {
      "name": "Tenancies",
      "description": "Manage tenancies, leases, and occupants."
    },
    {
      "name": "Reports",
      "description": "Retrieve and manage inspection reports and deposit summaries."
    },
    {
      "name": "Scan",
      "description": "Trigger and manage AI-powered inspections and scans."
    },
    {
      "name": "Media",
      "description": "Manage video inspections uploads"
    }
  ],
  "paths": {
    "/units/list": {
      "get": {
        "tags": [
          "Units"
        ],
        "summary": "List units",
        "description": "Returns a list of all units.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "description": "Optional text search across units",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnitsListResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/units/remove": {
      "post": {
        "tags": [
          "Units"
        ],
        "summary": "Remove unit",
        "description": "Removes a unit identified by its pid.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "pid": {
                    "type": "string",
                    "description": "Internal identifier of the unit to remove.",
                    "example": "unit_123"
                  }
                },
                "required": [
                  "pid"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Unit removed successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnitsRemoveResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/units/new": {
      "post": {
        "tags": [
          "Units"
        ],
        "summary": "Create a new unit",
        "description": "Creates a new unit for the authenticated client.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewUnitRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Unit created successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NewUnitResponse"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/QuotaExceeded"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/units/update": {
      "post": {
        "tags": [
          "Units"
        ],
        "summary": "Update unit",
        "description": "Updates a unit's external reference and/or address.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUnitRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Unit updated successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericOkResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/units/generate_scan_link": {
      "post": {
        "tags": [
          "Scan"
        ],
        "summary": "Generate scan link",
        "description": "Generates (or regenerates if it already exists) an inspection submission link for a unit.\n",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateScanLinkRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Scan link generated successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerateScanLinkResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/ResourceNotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/units/get_inspection_link": {
      "get": {
        "tags": [
          "Scan"
        ],
        "summary": "Get inspection submission link",
        "description": "Retrieves an inspection submission link for a unit, with options for inspection type, permanent link, team inspection, and Voice AI behavior.\n",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "pid",
            "in": "query",
            "description": "Internal identifier of the unit.",
            "required": true,
            "schema": {
              "type": "string",
              "example": "unit_123"
            }
          },
          {
            "name": "inspectionType",
            "in": "query",
            "description": "Type of inspection for which the link is generated.",
            "required": true,
            "schema": {
              "type": "string",
              "example": "move_out"
            }
          },
          {
            "name": "permanentLink",
            "in": "query",
            "description": "If true, generates or returns a permanent inspection link instead of a one-time link.\n",
            "required": false,
            "schema": {
              "type": "boolean",
              "example": true
            }
          },
          {
            "name": "teamInspection",
            "in": "query",
            "description": "If true, marks the inspection as a team/staff inspection rather than a resident-led scan.\n",
            "required": false,
            "schema": {
              "type": "boolean",
              "example": false
            }
          },
          {
            "name": "voiceAI",
            "in": "query",
            "description": "If true, enables Voice AI assistance during the inspection.\n",
            "required": false,
            "schema": {
              "type": "boolean",
              "example": true
            }
          },
          {
            "name": "OnlyVoiceAI",
            "in": "query",
            "description": "If true, enables a Voice-AI-only flow (no standard guidance UI).\n",
            "required": false,
            "schema": {
              "type": "boolean",
              "example": false
            }
          },
          {
            "name": "autoApprove",
            "in": "query",
            "description": "If true, the inspection will be auto-approved on completion.\n",
            "required": false,
            "schema": {
              "type": "boolean",
              "example": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Inspection link retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InspectionLinkResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/ResourceNotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/reports/get_all": {
      "get": {
        "tags": [
          "Reports"
        ],
        "summary": "List all reports for a unit",
        "description": "Returns all reports associated with a given unit.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "pid",
            "in": "query",
            "description": "Internal identifier of the unit whose reports should be returned.",
            "required": true,
            "schema": {
              "type": "string",
              "example": "unit_123"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Reports retrieved successfully.",
