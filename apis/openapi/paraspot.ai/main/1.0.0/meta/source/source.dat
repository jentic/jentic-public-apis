            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/scan/status": {
      "get": {
        "tags": [
          "Scan"
        ],
        "summary": "Get scan status",
        "description": "Retrieves the current status of a scan by the upload ID used to upload the video",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "pid",
            "in": "query",
            "required": true,
            "description": "Internal identifier of the unit",
            "schema": {
              "type": "string",
              "example": "unit_123"
            }
          },
          {
            "name": "upload_id",
            "in": "query",
            "required": true,
            "description": "Upload session identifier",
            "schema": {
              "type": "string",
              "example": "upload_123"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Scan status retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanStatusResponse"
