          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/reports/get": {
      "get": {
        "tags": [
          "Reports"
        ],
        "summary": "Get report main details",
        "description": "Fetches the main details and AI analysis data for a specific report.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "report_id",
            "in": "query",
            "description": "Identifier of the report to fetch.",
            "required": true,
            "schema": {
              "type": "string",
              "example": "rep_123"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Report details fetched successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportMainDetailsResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/reports/get_past_scans": {
      "get": {
        "tags": [
          "Reports"
        ],
        "summary": "List past scans for a report",
        "description": "Returns a list of past report and baseline scans associated with a given report.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "report_id",
            "in": "query",
            "description": "Identifier of the report whose past scans should be returned.",
            "required": true,
            "schema": {
              "type": "string",
              "example": "rep_123"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Past scans fetched successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PastScansResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/reports/update_inspection_type": {
      "post": {
        "tags": [
          "Reports"
