              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/scan/getStatus": {
      "get": {
        "tags": [
          "Scan"
        ],
        "summary": "Get detailed scan status",
        "description": "Retrieves the exact internal status of a scan by its identifier. For ordinary use /scan/status endpoint should be sufficient.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "sid",
            "in": "query",
            "description": "Internal scan session identifier whose status should be retrieved.",
            "required": true,
            "schema": {
              "type": "string",
              "example": "scan_abc123"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Scan status retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DetailedScanStatusResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
