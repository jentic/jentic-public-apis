    "/media/inspection/generate_presigned_url": {
      "post": {
        "tags": [
          "Media"
        ],
        "summary": "Generate presigned URLs for chunked upload",
        "description": "Generates presigned URLs for uploading a video scan in chunks for a given unit property and returns an upload identifier.\n",
        "externalDocs": {
          "description": "🚀 Try it in Google Colab",
          "url": "https://colab.research.google.com/drive/1QDojP2nWYJHHnM1o5M1LH2ZOZVlN4Tlh?usp=sharing"
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GeneratePresignedUrlRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Presigned URLs generated successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeneratePresignedUrlResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/media/upload_video": {
      "post": {
        "tags": [
          "Media"
        ],
        "summary": "Upload scan video",
        "description": "Uploads a video file for a scan or unit. The backend validates the expected size of the uploaded file.\n",
        "externalDocs": {
          "description": "🚀 Try it in Google Colab",
          "url": "https://colab.research.google.com/drive/1QDojP2nWYJHHnM1o5M1LH2ZOZVlN4Tlh?usp=sharing"
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UploadVideoRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Upload completed successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericOkResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/webhooks/report-generated": {
      "post": {
        "tags": [
          "Webhooks"
        ],
        "x-paraspot-webhook": true,
        "summary": "Webhook fired when a new report is generated",
        "description": "Paraspot sends this webhook to your configured endpoint whenever\na new inspection report is generated.\n\nYour endpoint must respond with a 2xx status code to acknowledge\nsuccessful receipt.\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReportGeneratedWebhookPayload",
                "example": {
                  "report_id": "rpt_1234567890abcdef",
                  "pid": "prop_98765",
                  "inspection_type": "move_in"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Webhook received successfully"
          },
          "400": {
            "description": "Invalid payload"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key"
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid request parameters.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Authentication failed or missing token.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "Forbidden": {
        "description": "The request is authenticated but not allowed.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "InternalServerError": {
        "description": "Unexpected server error.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "QuotaExceeded": {
        "description": "You have reached a quota limit.",
        "content": {
          "application/json": {
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/ApiError"
                }
              ],
              "example": {
                "status": 403,
                "msg": "You have reached the maximum number of X allowed.",
                "result": null
              }
            }
          }
        }
      },
      "ResourceNotFound": {
        "description": "Resource not found.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            },
            "example": {
              "status": 404,
              "msg": "Resource was not found.",
              "result": null
            }
          }
        }
      }
    },
    "schemas": {
      "UnitsListResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "example": 200
          },
          "msg": {
            "type": "string",
            "example": "Success"
          },
          "result": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UnitListItem"
            }
          }
        },
        "required": [
          "status",
          "msg",
          "result"
        ]
      },
      "UnitListItem": {
        "type": "object",
        "properties": {
          "pid": {
            "type": "string",
            "example": "unit_123"
          },
          "ext_ref": {
            "type": "string",
            "nullable": true,
            "example": "A-101"
          },
          "subject": {
            "type": "string",
            "example": "Apartment 101"
          },
          "group": {
            "type": "string",
            "nullable": true,
            "example": "Building A"
          }
        },
        "required": [
          "pid",
          "subject"
        ]
      },
      "UnitsRemoveResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "example": 200
          },
          "msg": {
            "type": "string",
            "example": "OK"
          }
        },
        "required": [
          "status",
          "msg"
        ]
      },
      "NewUnitRequest": {
        "type": "object",
        "properties": {
          "unit": {
            "type": "string",
            "description": "Unit name or identifier.",
            "example": "Apartment 101"
          },
          "extRef": {
            "type": "string",
            "nullable": true,
            "description": "Optional external reference used in the client system.",
            "example": "A-101"
          },
          "group": {
            "type": "string",
            "nullable": true,
            "description": "Optional property you want to associate the unit with",
            "example": "P-101"
          }
        },
        "required": [
          "unit"
        ]
      },
      "NewUnitResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "example": 200
          },
          "msg": {
            "type": "string",
            "example": "OK"
          },
          "result": {
            "type": "object",
            "properties": {
              "pid": {
                "type": "string",
                "description": "Internal identifier of the newly created unit.",
                "example": "unit_123"
              }
            },
            "required": [
              "pid"
            ]
          }
        },
        "required": [
          "status",
          "msg",
          "result"
        ]
      },
      "UpdateUnitRequest": {
        "type": "object",
        "properties": {
          "pid": {
            "type": "string",
            "description": "Internal identifier of the unit.",
            "example": "unit_123"
          },
          "extRef": {
            "type": "string",
            "nullable": true,
            "description": "External reference for the unit.",
            "example": "A-101"
          },
          "address": {
            "type": "string",
            "nullable": true,
            "description": "Full address of the unit.",
            "example": "123 Main St, Miami, FL"
          },
          "group": {
            "type": "string",
            "nullable": true,
            "description": "Optional property you want to associate the unit with",
            "example": "P-101"
          }
        },
        "required": [
          "pid"
        ],
        "anyOf": [
          {
            "required": [
              "extRef"
            ]
          },
          {
            "required": [
              "address"
            ]
          }
        ]
      },
      "GenerateScanLinkRequest": {
        "type": "object",
        "properties": {
          "pid": {
            "type": "string",
            "description": "Internal identifier of the unit.",
            "example": "unit_123"
          }
        },
        "required": [
          "pid"
        ]
      },
      "GenerateScanLinkResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "example": 200
          },
          "msg": {
            "type": "string",
            "example": "OK"
          },
          "result": {
            "type": "string",
            "description": "PART of the Inspection submission link",
            "example": "/client/inspectionID"
          }
        },
        "required": [
          "status",
          "msg",
          "result"
        ]
      },
      "InspectionLinkResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "example": 200
          },
          "msg": {
            "type": "string",
            "example": "OK"
          },
          "result": {
            "type": "string",
            "description": "Inspection submission link for this unit.",
            "example": "https://paraspot.ai/client/inspection_type/abc123"
          }
        },
        "required": [
          "status",
          "msg",
          "result"
        ]
      },
      "UnitReportsListResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "example": 200
          },
          "msg": {
            "type": "string",
            "example": "OK"
          },
          "result": {
            "type": "array",
            "description": "List of reports for the requested unit.\n",
            "items": {
              "$ref": "#/components/schemas/ReportRow"
            }
          }
        },
        "required": [
          "status",
          "msg",
          "result"
        ]
      },
      "ReportRow": {
        "type": "object",
        "description": "Summary of a single report for a unit.\n",
        "properties": {
          "pid": {
            "type": "string",
            "description": "Internal identifier of the report (or unit-report mapping).",
            "example": "rep_123"
          },
          "ext_ref": {
            "type": "string",
            "nullable": true,
            "description": "Optional external reference used in the client system.",
            "example": "MOVEOUT-2025-01"
          },
          "subject": {
            "type": "string",
            "description": "Human-readable title or subject of the report.",
            "example": "Move-out inspection – Unit 101"
          },
          "group": {
            "type": "string",
            "nullable": true,
            "description": "Group or category the report belongs to.",
            "example": "Move-Out"
          },
          "scores": {
            "$ref": "#/components/schemas/ReportScores"
          }
        },
        "required": [
          "pid",
          "subject",
          "scores"
        ]
      },
      "ReportScores": {
        "type": "object",
        "description": "Score summary for this report.",
        "properties": {
          "inventory": {
            "type": "integer",
            "example": 0
          },
          "structural_defects": {
            "type": "integer",
            "example": 0
          },
          "inventory_defects": {
            "type": "integer",
            "example": 0
          },
          "organization": {
            "type": "integer",
            "example": 0
          }
        },
        "required": [
          "inventory",
          "structural_defects",
          "inventory_defects",
          "organization"
        ]
      },
      "ReportMainDetailsResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "example": 200
          },
          "msg": {
            "type": "string",
            "example": "OK"
          },
          "result": {
            "$ref": "#/components/schemas/ReportMainDetails"
          }
        },
        "required": [
          "status",
          "msg",
          "result"
        ]
      },
      "ReportMainDetails": {
        "type": "object",
        "description": "Main details, metadata, detections, and Voice AI data for a single inspection report.",
        "properties": {
          "pid": {
            "type": "string",
            "description": "Internal unit identifier associated with this report.",
            "example": "unit_123"
          },
          "unit": {
            "type": "string",
            "description": "Human-readable unit name/subject.",
            "example": "Apartment 101"
          },
          "date": {
            "type": "string",
            "description": "Inspection datetime in formatted form.",
            "example": "24/12/25 10:15 UTC"
          },
          "type": {
            "type": "string",
            "description": "Inspection type for this report.",
            "example": "checkout"
          },
          "video": {
            "type": "string",
            "description": "URL to the inspection video (MP4).",
            "example": "https://ws.paraspot.ai/inspection/scan/media/20250101123045.mp4"
          },
          "is_standalone_report": {
            "type": "boolean",
            "description": "True if the report is not matched to any previous scan/baseline.",
            "example": false
          },
          "audio_only_report": {
            "type": "boolean",
            "description": "True if this report was created from an audio-only inspection.",
            "example": false
          },
          "inspection_metadata": {
            "$ref": "#/components/schemas/InspectionMetadata"
          },
          "previous_inspection_metadata": {
            "$ref": "#/components/schemas/PreviousInspectionMetadata"
          },
          "resident_data": {
            "type": "object",
            "description": "Guest/resident data associated with the report.",
            "additionalProperties": true,
            "example": {
              "guest_name": "John Doe",
              "email": "john.doe@example.com"
            }
          },
          "experience_rating": {
            "$ref": "#/components/schemas/ExperienceRating"
          },
          "data": {
            "$ref": "#/components/schemas/ReportDataByCategory"
          },
          "voice_ai_data": {
            "type": "array",
            "description": "Voice-AI notes and detections associated with the inspection.",
            "items": {
              "$ref": "#/components/schemas/AudioNote"
            }
          },
          "additional_views": {
            "$ref": "#/components/schemas/AdditionalViews"
          },
          "roomsData": {
            "type": "array",
            "description": "Time-segmented room mapping for the inspection video.",
            "items": {
              "$ref": "#/components/schemas/RoomSegment"
            }
          },
          "all_categories": {
            "type": "array",
            "description": "List of all categories referenced in this report.",
            "items": {
              "type": "string"
            },
            "example": [
              "Inventory",
              "Structural defects",
              "Organization"
            ]
          },
          "categories_data": {
            "type": "object",
            "description": "Aggregated/rollup data per category.",
            "additionalProperties": true
          }
        },
        "required": [
          "pid",
          "unit",
          "date",
          "type",
          "video",
          "is_standalone_report",
          "audio_only_report",
          "inspection_metadata",
          "data",
          "all_categories",
          "categories_data"
        ]
      },
      "InspectionMetadata": {
        "type": "object",
        "description": "Metadata about the current inspection's unique frames.",
        "properties": {
          "ts": {
            "type": "string",
            "description": "Timestamp identifier of the scan session.",
            "example": "20250101123045"
          },
          "frame_numbers": {
            "type": "array",
            "description": "List of frame numbers considered unique for this inspection.",
            "items": {
              "type": "integer"
            },
            "example": [
              0,
              15,
              30,
              45
            ]
          },
          "available_frames": {
            "type": "integer",
            "description": "Total number of unique frames available for this inspection.",
            "example": 200
          }
        },
        "required": [
          "ts",
          "frame_numbers",
          "available_frames"
        ]
      },
      "PreviousInspectionMetadata": {
        "type": "object",
        "description": "Metadata about the previous inspection or baseline used for comparison.",
        "properties": {
          "ts": {
            "type": "string",
            "description": "Timestamp of the previous scan or baseline.",
            "example": "20241220100000"
          },
          "available_frames": {
            "type": "integer",
            "description": "Number of unique frames available in the previous scan.",
            "example": 150
          }
        },
        "required": [
          "ts",
          "available_frames"
        ]
      },
      "ExperienceRating": {
        "type": "array",
        "description": "Rating data associated with this scan. Currently returned as an array in the form [scan_rating, stay_rating, device_details].\n",
        "items": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "object"
            }
          ]
        },
        "example": [
          4.5,
          4.8,
          {
            "device": "iPhone 15",
            "os": "iOS 18"
          }
        ]
      },
      "ReportDataByCategory": {
        "type": "object",
        "description": "Detection data grouped by category.",
        "additionalProperties": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/ReportIssue"
          }
        },
        "example": {
          "inventory": [
            {
              "subject": "Missing Dining Chair",
              "label": "dining_chair",
              "issue_type": "Missing Item",
              "media": "https://aiv2.paraspot.ai/cva/v2/getObjectFromScan?src_id=unit_123&uid=42",
              "before_media": "https://aiv2.paraspot.ai/cva/v2/getImgPrevView?pid=unit_123&rid=rep_123&uid=42&from=prev",
              "before_date": "20-12-2024",
              "object_id": "42",
              "category": "Living Room",
              "room": "Living Room"
            }
          ],
          "structural_defects": [
            {
              "subject": "Wall damage was found",
              "label": "wall_damage",
              "issue_type": "Defect",
              "media": "https://...",
              "before_media": "https://...",
              "before_date": "20-12-2024",
              "object_id": "99",
              "category": "Bedroom"
            }
          ]
        }
      },
      "ReportIssue": {
        "type": "object",
        "description": "Single detected issue or inventory item in the report.",
        "properties": {
          "subject": {
            "type": "string",
            "description": "Human-readable subject describing the issue."
          },
          "label": {
            "type": "string",
            "description": "Normalized label of the detected object/issue."
          },
          "issue_type": {
            "type": "string",
            "description": "Type of issue (Missing item, Defect, Organization, etc.).",
            "example": "Missing Item"
          },
          "media": {
            "type": "string",
            "description": "URL to the media showing this issue."
          },
          "before_media": {
            "type": "string",
            "nullable": true,
            "description": "URL to the previous/baseline media for comparison, if available."
          },
          "before_date": {
            "type": "string",
            "nullable": true,
            "description": "Date of the previous/baseline media, if available.",
            "example": "20-12-2024"
          },
          "object_id": {
            "type": "string",
            "description": "Internal identifier for this detected object.",
            "example": "42"
          },
          "category": {
            "type": "string",
            "nullable": true,
            "description": "Inventory category assigned to this object (e.g. room/category name).",
            "example": "Kitchen"
          },
          "room": {
            "type": "string",
            "nullable": true,
            "description": "Room inferred from frame-to-room mapping, if available.",
            "example": "Living Room"
          }
        },
        "additionalProperties": true
      },
      "RoomSegment": {
        "type": "object",
        "description": "Mapping between a time range in the video and a room.",
        "properties": {
          "start": {
            "type": "string",
            "description": "Start time of the segment in HH:MM:SS.",
            "example": "00:10:05"
          },
          "end": {
            "type": "string",
            "description": "End time of the segment in HH:MM:SS.",
            "example": "00:12:30"
          },
          "title": {
            "type": "string",
            "description": "Room name/title.",
            "example": "Kitchen"
          },
          "start_frame": {
            "type": "integer",
            "description": "Frame index at which this room segment starts.",
            "example": 12000
          },
          "end_frame": {
            "type": "integer",
            "description": "Frame index at which this room segment ends.",
            "example": 15000
          }
        },
        "required": [
          "start",
          "end",
          "title",
          "start_frame",
          "end_frame"
        ]
      },
      "AdditionalViews": {
        "type": "object",
        "description": "Additional view data such as kitchenware and meter views.",
        "properties": {
          "kitchen_view": {
            "$ref": "#/components/schemas/ViewData"
          },
          "meter_view": {
            "$ref": "#/components/schemas/ViewData"
          }
        },
        "required": [
          "kitchen_view",
          "meter_view"
        ]
      },
      "ViewData": {
        "type": "object",
        "description": "Before/after view metadata for a specific viewpoint (e.g. kitchen, meter).",
        "properties": {
          "before": {
            "type": "string",
            "description": "Baseline scan timestamp or identifier.",
            "example": "20241220100000"
          },
          "after": {
            "type": "string",
            "description": "Current scan timestamp or identifier.",
            "example": "20250101123045"
          },
          "before_date": {
            "type": "string",
            "nullable": true,
            "description": "Human-readable date of the baseline view.",
            "example": "20-12-2024"
          },
          "indexes": {
            "type": "array",
            "description": "Frame indexes used as view references.",
            "items": {
              "type": "integer"
            },
            "example": [
              10,
              25,
              40
            ]
          }
        },
        "required": [
          "after",
          "indexes"
        ]
      },
      "AudioNote": {
        "type": "object",
        "description": "Voice-AI audio note mapped to frames and rooms.",
        "properties": {
          "room": {
            "type": "string",
            "nullable": true,
            "description": "Room name associated with this note, if detected.",
            "example": "Living Room"
          },
          "media": {
            "type": "array",
            "description": "URLs of still frames associated with the audio note.",
            "items": {
              "type": "string",
              "example": "https://aiv2.paraspot.ai/cva/presentImage/UniqueFrames_20250101123045?idx=NOTE_0_1_orig_size&lt=1"
            }
          },
          "object_id": {
            "type": "string",
            "description": "Internal identifier for this note.",
            "example": "NOTE_0"
          },
          "issue_type": {
            "type": "string",
            "description": "Type of the note or issue.",
            "example": "comment"
          },
          "text": {
            "type": "string",
            "description": "Transcribed text of the audio note.",
            "example": "Window blinds in the living room are damaged."
          },
          "additional_properties": {
            "type": "object",
            "description": "Additional metadata associated with this note.",
            "additionalProperties": true
          }
        },
        "required": [
          "object_id",
          "issue_type",
          "text",
          "media"
        ]
      },
      "PastScansResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "example": 200
          },
          "msg": {
            "type": "string",
            "example": "OK"
          },
          "result": {
            "type": "array",
            "description": "Sorted list of past scans (report and baseline) for the report.",
            "items": {
              "$ref": "#/components/schemas/PastScanItem"
            }
          }
        },
        "required": [
          "status",
          "msg",
          "result"
        ]
      },
      "PastScanItem": {
        "type": "object",
        "description": "A single past scan entry.",
        "properties": {
          "scan_link": {
            "type": "string",
            "description": "URL to the MP4 scan media.",
            "example": "https://aiv2.paraspot.ai/inspection/scan/media/20250101123045.mp4"
          },
          "date": {
            "type": "string",
            "description": "Date of the scan in DD/MM/YYYY format.",
            "example": "01/01/2025"
          },
          "scan_type": {
            "type": "string",
            "description": "Type of scan.",
            "enum": [
              "baseline",
              "checkout"
            ],
            "example": "checkout"
          }
        },
        "required": [
          "scan_link",
          "date",
          "scan_type"
        ]
      },
      "UpdateInspectionTypeRequest": {
        "type": "object",
        "properties": {
          "report_id": {
            "type": "string",
            "description": "Identifier of the report whose inspection type should be updated.",
            "example": "rep_123"
          },
          "inspection_type": {
            "type": "string",
            "description": "New inspection type value.",
            "example": "checkout"
          }
        },
        "required": [
          "report_id",
          "inspection_type"
        ]
      },
      "UpdateResidentDataRequest": {
        "type": "object",
        "properties": {
          "report_id": {
            "type": "string",
            "description": "Identifier of the report whose guest data should be updated.",
            "example": "rep_123"
          },
          "guest_data": {
            "type": "object",
            "description": "Guest/resident data payload to associate with the report.",
            "additionalProperties": true,
            "example": {
              "guest_name": "John Doe",
              "email": "john.doe@example.com",
              "phone": "+1-555-123-4567",
              "booking_id": "BK-2025-00123"
            }
          }
        },
        "required": [
          "report_id",
          "guest_data"
        ]
      },
      "ScanStatusResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "example": 200
          },
          "msg": {
            "type": "string",
            "example": "OK"
          },
          "result": {
            "type": "array",
            "description": "List of matching scan status records.",
            "items": {
              "$ref": "#/components/schemas/ScanStatusItem"
            }
          }
        },
        "required": [
          "status",
          "msg",
          "result"
        ]
      },
      "ScanStatusItem": {
        "type": "object",
        "properties": {
          "sid": {
            "type": "string",
            "description": "Internal scan session identifier.",
            "example": "sess_456"
          },
          "status": {
            "type": "string",
            "description": "Current status of the scan.",
            "example": "completed"
          },
          "datetime": {
            "type": "string",
            "format": "date-time",
            "description": "Datetime when the scan record was created or completed.",
            "example": "2026-03-13T14:25:00Z"
          }
        },
        "required": [
          "sid",
          "status",
          "datetime"
        ]
      },
      "DetailedScanStatusResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "example": 200
          },
          "msg": {
            "type": "string",
            "example": "OK"
          },
          "result": {
            "$ref": "#/components/schemas/ScanStatusResult"
          }
        },
        "required": [
          "status",
          "msg",
          "result"
        ]
      },
      "ScanStatusResult": {
        "type": "object",
        "description": "Status information for a scan.",
        "properties": {
          "status": {
            "type": "string",
            "description": "Current scan processing status.",
            "example": "processing"
          },
          "type": {
            "type": "string",
            "description": "Message type for the status response.",
            "example": "info"
          }
        },
        "required": [
          "status",
          "type"
        ]
      },
      "TenancyCreateRequest": {
        "type": "object",
        "properties": {
          "pid": {
            "type": "string",
            "nullable": true,
            "description": "Optional unit identifier. If omitted, the tenancy may be created without binding to a specific unit.",
            "example": "unit_123"
          },
          "renters": {
            "type": "array",
            "description": "List of renter names associated with this tenancy.",
            "items": {
              "type": "string"
            },
            "example": [
              "John Doe",
              "Jane Smith"
            ]
          },
          "check_in": {
            "type": "string",
            "description": "Check-in date for the tenancy in ISO or YYYY-MM-DD format.",
            "example": "2025-01-01"
          },
          "check_out": {
            "type": "string",
            "nullable": true,
            "description": "Optional check-out date for the tenancy in ISO or YYYY-MM-DD format.",
            "example": "2025-01-31"
          },
          "currency": {
            "type": "string",
            "description": "ISO currency code for rate and deposit.",
            "example": "USD"
          },
          "deposit": {
            "type": "number",
            "format": "float",
            "description": "Security deposit amount in the specified currency.",
            "example": 1500
          },
          "rate": {
            "type": "number",
            "format": "float",
            "description": "Recurring rent rate (for example, monthly) in the specified currency.",
            "example": 2500
          },
          "email": {
            "type": "string",
            "nullable": true,
            "format": "email",
            "description": "Contact email address for the primary renter.",
            "example": "john.doe@example.com"
          },
          "mobile": {
            "type": "string",
            "nullable": true,
            "description": "Contact mobile phone number for the primary renter.",
            "example": "+1-555-123-4567"
          }
        },
        "required": [
          "renters",
          "check_in",
          "currency",
          "deposit",
          "rate"
        ]
      },
      "TenancyUpdateRequest": {
        "type": "object",
        "description": "Payload for updating an existing tenancy. Only fields that should be updated need to be included.\n",
        "properties": {
          "tid": {
            "type": "string",
            "description": "Identifier of the tenancy to update.",
            "example": "ten_123"
          },
          "pid": {
            "type": "string",
            "nullable": true,
            "description": "Optional unit identifier to associate with this tenancy.",
            "example": "unit_123"
          },
          "renters": {
            "type": "array",
            "nullable": true,
            "description": "Updated list of renter names.",
            "items": {
              "type": "string"
            },
            "example": [
              "John Doe",
              "Jane Smith"
            ]
          },
          "check_in": {
            "type": "string",
            "nullable": true,
            "description": "Updated check-in date (ISO or YYYY-MM-DD format).",
            "example": "2025-01-05"
          },
          "check_out": {
            "type": "string",
            "nullable": true,
            "description": "Updated check-out date (ISO or YYYY-MM-DD format).",
            "example": "2025-02-01"
          },
          "currency": {
            "type": "string",
            "nullable": true,
            "description": "Updated ISO currency code for rate and deposit.",
            "example": "USD"
          },
          "deposit": {
            "type": "number",
            "format": "float",
            "nullable": true,
            "description": "Updated security deposit amount.",
            "example": 1800
          },
          "rate": {
            "type": "number",
            "format": "float",
            "nullable": true,
            "description": "Updated rent rate.",
            "example": 2600
          },
          "email": {
            "type": "string",
            "nullable": true,
            "format": "email",
            "description": "Updated contact email for the primary renter.",
            "example": "john.doe@example.com"
          },
          "mobile": {
            "type": "string",
            "nullable": true,
            "description": "Updated contact mobile phone number.",
            "example": "+1-555-123-4567"
          }
        },
        "required": [
          "tid"
        ]
      },
      "PropertiesListResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "example": 200
          },
          "msg": {
            "type": "string",
            "example": "Success"
          },
          "result": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PropertyListItem"
            }
          }
        },
        "required": [
          "status",
          "msg",
          "result"
        ]
      },
      "PropertyListItem": {
        "type": "object",
        "properties": {
          "pid": {
            "type": "string",
            "example": "property_123"
          },
          "name": {
            "type": "string",
            "example": "Property 101"
          },
          "ext_ref": {
            "type": "string",
            "nullable": true,
            "example": "P-101"
          }
        },
        "required": [
          "pid",
          "name"
        ]
      },
      "PropertyCreateRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the property.",
            "example": "Sunset Villas"
          },
          "extRef": {
            "type": "string",
            "nullable": true,
            "description": "Optional external reference used in the client system.",
            "example": "PROP-001"
          },
          "associated_units": {
            "type": "array",
            "nullable": true,
            "description": "Optional list of units to associate with this property. Each entry must contain an external reference and subject/title.\n",
            "items": {
              "$ref": "#/components/schemas/AssociatedUnit"
            }
          }
        },
        "required": [
          "name"
        ]
      },
      "AssociatedUnit": {
        "type": "object",
        "properties": {
          "ext_ref": {
            "type": "string",
            "description": "External reference for the unit in the client system.",
            "example": "A-101"
          },
          "subject": {
            "type": "string",
            "description": "Human-readable unit name or title.",
            "example": "Apartment 101"
          }
        },
        "required": [
          "ext_ref",
          "subject"
        ]
      },
      "PropertyCreateResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "example": 200
          },
          "msg": {
            "type": "string",
            "example": "OK"
          },
          "result": {
            "type": "object",
            "properties": {
              "pid": {
                "type": "string",
                "description": "Internal identifier of the created property.",
                "example": "prop_123"
              }
            },
            "required": [
              "pid"
            ]
          }
        },
        "required": [
          "status",
          "msg",
          "result"
        ]
      },
      "PropertyUpdateRequest": {
        "type": "object",
        "properties": {
          "pid": {
            "type": "string",
            "description": "Internal identifier of the property to update.",
            "example": "prop_123"
          },
          "name": {
            "type": "string",
            "description": "New name for the property.",
            "example": "Sunset Villas - Phase II"
          }
        },
        "required": [
          "pid",
          "name"
        ]
      },
      "PropertyRemoveRequest": {
        "type": "object",
        "properties": {
          "pid": {
            "type": "string",
            "description": "Internal identifier of the property to remove.",
            "example": "prop_123"
          }
        },
        "required": [
          "pid"
        ]
      },
      "GeneratePresignedUrlRequest": {
        "type": "object",
        "description": "Request payload for generating presigned URLs for a scan upload.",
        "properties": {
          "pid": {
            "type": "string",
            "description": "Unit property identifier.",
            "example": "unit_123"
          },
          "scan_id": {
            "type": "string",
            "description": "Identifier of the scan/upload session.",
            "example": "scan_abc123"
          },
          "inspection_type": {
            "type": "string",
            "description": "Type of inspection associated with this scan.",
            "example": "checkout"
          },
          "total_parts": {
            "type": "integer",
            "description": "Total number of parts/chunks that the scan will be uploaded in.",
            "example": 5
          },
          "filename": {
            "type": "string",
            "description": "Original filename of the scan being uploaded.",
            "example": "move_out_inspection_101.webm"
          },
          "filetype": {
            "type": "string",
            "description": "MIME type or file type of the scan.",
            "example": "video/webm"
          },
          "voice_ai": {
            "type": "boolean",
            "nullable": true,
            "description": "If true, enables Voice AI assistance for this scan.",
            "example": true
          },
          "voice_ai_only": {
            "type": "boolean",
            "nullable": true,
            "description": "If true, indicates a Voice-AI-only flow for this scan.",
            "example": false
          }
        },
        "required": [
          "pid",
          "scan_id",
          "inspection_type",
          "total_parts",
          "filename",
          "filetype"
        ]
      },
      "GeneratePresignedUrlResponse": {
        "type": "object",
        "description": "Response containing presigned URLs and the associated identifier.",
        "properties": {
          "status": {
            "type": "integer",
            "example": 200
          },
          "result": {
            "type": "object",
            "properties": {
              "presign_urls": {
                "type": "array",
                "description": "List of presigned URLs for uploading one or more chunks.",
                "items": {
                  "type": "string",
                  "example": "https://bucket.s3.amazonaws.com/..."
                }
              },
              "id": {
                "type": "string",
                "description": "Identifier associated with this upload.",
                "example": "upload_id_123"
              }
            },
            "required": [
              "presign_urls",
              "id"
            ]
          }
        },
        "required": [
          "status",
          "result"
        ]
      },
      "UploadVideoRequest": {
        "type": "object",
        "description": "Request payload for uploading a scan video.",
        "properties": {
          "id": {
            "type": "string",
            "description": "Upload identifier associated with this video upload.",
            "example": "upload_id_123"
          },
          "filename": {
            "type": "string",
            "description": "Name of the video file being uploaded.",
            "example": "move_out_inspection_101.webm"
          },
          "expectedSize": {
            "type": "integer",
            "description": "Total number of parts/chunks that the scan will be uploaded in.",
            "example": 5
          }
        },
        "required": [
          "id",
          "filename",
          "expectedSize"
        ]
      },
      "ReportGeneratedWebhookPayload": {
        "type": "object",
        "required": [
          "report_id",
          "pid",
          "inspection_type"
        ],
        "properties": {
          "report_id": {
            "type": "string",
            "description": "Unique identifier of the generated report",
            "example": "rpt_1234567890abcdef"
          },
          "pid": {
            "type": "string",
            "description": "Property or portfolio identifier in your system",
            "example": "prop_98765"
          },
          "inspection_type": {
            "type": "string",
            "description": "Type of inspection that generated this report",
            "example": "move_in"
          }
        }
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "example": 400
          },
          "msg": {
            "type": "string",
            "example": "Authentication Failed"
          },
          "result": {
            "nullable": true
          }
        },
        "required": [
          "status",
          "msg"
        ]
      },
      "GenericOkResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "example": 200
          },
          "msg": {
            "type": "string",
            "example": "OK"
          }
        },
        "required": [
          "status",
          "msg"
        ]
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ]
}
