                      "type": "boolean"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "booking": {
                          "$ref": "#/components/schemas/Booking"
                        },
                        "refundAmount": {
                          "type": "number"
                        },
                        "refundPercentage": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Cannot cancel booking",
