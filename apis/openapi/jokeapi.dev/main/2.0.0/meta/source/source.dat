{
  "openapi": "3.0.3",
  "info": {
    "title": "JokeAPI",
    "description": "A free, open-source joke API with no authentication required. Supports multiple categories, languages, and response formats.",
    "version": "2.0.0",
    "x-jentic-source-url": "https://v2.jokeapi.dev/",
    "x-jentic-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://v2.jokeapi.dev"
    }
  ],
  "paths": {
    "/joke/{categories}": {
      "get": {
        "operationId": "getJoke",
        "summary": "Get one or more jokes from specified categories",
        "parameters": [
          {
            "name": "categories",
            "in": "path",
            "required": true,
            "description": "Joke category or comma-separated list. Use 'Any' for all categories.",
            "schema": {
              "type": "string",
              "example": "Programming,Misc"
            }
          },
          {
            "name": "format",
            "in": "query",
            "description": "Response format",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "xml",
                "yaml",
                "txt"
              ],
              "default": "json"
            }
          },
          {
            "name": "blacklistFlags",
            "in": "query",
            "description": "Comma-separated flags to exclude (nsfw, religious, political, racist, sexist, explicit)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lang",
            "in": "query",
            "description": "ISO 639-1 language code",
            "schema": {
              "type": "string",
              "default": "en"
            }
          },
          {
            "name": "type",
            "in": "query",
            "description": "Joke type filter",
            "schema": {
              "type": "string",
              "enum": [
                "single",
                "twopart"
              ]
            }
          },
          {
            "name": "contains",
            "in": "query",
            "description": "Search string to filter jokes",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "idRange",
            "in": "query",
            "description": "ID range filter (e.g. 0-100, 33)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "amount",
            "in": "query",
            "description": "Number of jokes to return (1-10)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10,
              "default": 1
            }
          },
          {
            "name": "safe-mode",
            "in": "query",
            "description": "Enable safe mode (no value needed)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful joke response",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "error": {
                          "type": "boolean"
                        },
                        "category": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string",
                          "enum": [
                            "single"
                          ]
                        },
                        "joke": {
                          "type": "string"
                        },
                        "flags": {
                          "type": "object",
                          "properties": {
                            "nsfw": {
                              "type": "boolean"
                            },
                            "religious": {
                              "type": "boolean"
                            },
                            "political": {
                              "type": "boolean"
                            },
                            "racist": {
                              "type": "boolean"
                            },
                            "sexist": {
                              "type": "boolean"
                            },
                            "explicit": {
                              "type": "boolean"
                            }
                          }
                        },
                        "id": {
                          "type": "integer"
                        },
                        "safe": {
                          "type": "boolean"
                        },
                        "lang": {
                          "type": "string"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "properties": {
                        "error": {
                          "type": "boolean"
                        },
                        "category": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string",
                          "enum": [
                            "twopart"
                          ]
                        },
                        "setup": {
                          "type": "string"
                        },
                        "delivery": {
                          "type": "string"
                        },
                        "flags": {
                          "type": "object",
                          "properties": {
                            "nsfw": {
                              "type": "boolean"
                            },
                            "religious": {
                              "type": "boolean"
                            },
                            "political": {
                              "type": "boolean"
                            },
                            "racist": {
                              "type": "boolean"
                            },
                            "sexist": {
                              "type": "boolean"
                            },
                            "explicit": {
                              "type": "boolean"
                            }
                          }
                        },
                        "id": {
                          "type": "integer"
                        },
                        "safe": {
                          "type": "boolean"
                        },
                        "lang": {
                          "type": "string"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
    "/info": {
      "get": {
        "operationId": "getInfo",
        "summary": "Get API information including version, joke count, and available categories",
        "parameters": [
          {
            "name": "format",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "xml",
                "yaml",
                "txt"
              ]
            }
          },
          {
            "name": "lang",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "API info response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "boolean"
                    },
                    "version": {
                      "type": "string"
                    },
                    "jokes": {
                      "type": "object",
                      "properties": {
                        "totalCount": {
                          "type": "integer"
                        },
                        "categories": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "flags": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "types": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "formats": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "language": {
                      "type": "string"
                    },
                    "timestamp": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/categories": {
      "get": {
        "operationId": "getCategories",
        "summary": "Get all available joke categories",
        "parameters": [
          {
            "name": "format",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "xml",
                "yaml",
                "txt"
              ]
            }
          },
          {
            "name": "lang",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Categories list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "boolean"
                    },
                    "categories": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "categoryAliases": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "timestamp": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/langcode/{language}": {
      "get": {
        "operationId": "getLanguageCode",
        "summary": "Fuzzy search for an ISO 639-1 language code by language name",
        "parameters": [
          {
            "name": "language",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "format",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "xml",
                "yaml",
                "txt"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Language code result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "boolean"
                    },
                    "code": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/languages": {
      "get": {
        "operationId": "getLanguages",
        "summary": "Get all supported languages",
        "parameters": [
          {
            "name": "format",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "xml",
                "yaml",
                "txt"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Supported languages",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "defaultLanguage": {
                      "type": "string"
                    },
                    "jokeLanguages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "systemLanguages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "possibleLanguages": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "code": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "timestamp": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/flags": {
      "get": {
        "operationId": "getFlags",
        "summary": "Get all available blacklist flags",
        "parameters": [
          {
            "name": "format",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "xml",
                "yaml",
                "txt"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Available flags",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "boolean"
                    },
                    "flags": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "timestamp": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/formats": {
      "get": {
        "operationId": "getFormats",
        "summary": "Get all available response formats",
        "parameters": [
          {
            "name": "format",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "xml",
                "yaml",
                "txt"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Available formats",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "boolean"
                    },
                    "formats": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "timestamp": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ping": {
      "get": {
        "operationId": "ping",
        "summary": "Ping the API to check availability",
        "parameters": [
          {
            "name": "format",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "xml",
                "yaml",
                "txt"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Pong response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ping": {
                      "type": "string"
                    },
                    "timestamp": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/endpoints": {
      "get": {
        "operationId": "getEndpoints",
        "summary": "Get all available API endpoints",
        "parameters": [
          {
            "name": "format",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "xml",
                "yaml",
                "txt"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of endpoints",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "boolean"
                    },
                    "endpoints": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "timestamp": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/submit": {
      "post": {
        "operationId": "submitJoke",
        "summary": "Submit a new joke for review",
        "parameters": [
          {
            "name": "dry-run",
            "in": "query",
            "description": "Validate without saving",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "formatVersion",
                  "category",
                  "type",
                  "flags",
                  "lang"
                ],
                "properties": {
                  "formatVersion": {
                    "type": "integer",
                    "example": 3
                  },
                  "category": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "single",
                      "twopart"
                    ]
                  },
                  "joke": {
                    "type": "string"
                  },
                  "setup": {
                    "type": "string"
                  },
                  "delivery": {
                    "type": "string"
                  },
                  "flags": {
                    "type": "object",
                    "properties": {
                      "nsfw": {
                        "type": "boolean"
                      },
                      "religious": {
                        "type": "boolean"
                      },
                      "political": {
                        "type": "boolean"
                      },
                      "racist": {
                        "type": "boolean"
                      },
                      "sexist": {
                        "type": "boolean"
                      },
                      "explicit": {
                        "type": "boolean"
                      }
                    }
                  },
                  "lang": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Joke submitted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    },
                    "submission": {
                      "type": "object"
                    },
                    "timestamp": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    }
  },
  "security": []
}
