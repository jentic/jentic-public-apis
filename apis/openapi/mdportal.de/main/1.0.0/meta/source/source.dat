                "type": "string",
                "description": "Quittierungsdokument, base64-kodiert",
                "examples": [
                  "y0piAGcFr3BQb2x5Zm9uIHp3aXRzY2hlcm5kIGHDn2VuIE3DpHhjaGVucyBWw7Zn"
                ]
              },
              "name": {
                "type": "string",
                "maxLength": 255,
                "description": "Name des Dokumentes",
                "examples": [
                  "1234abcd-1234-1234-9876-9876abcd1234_quittung.pdf"
                ]
              },
              "dokumentArt": {
                "type": "string",
                "enum": [
                  "QUITTIERUNG"
                ],
                "description": "Art des Dokuments, fest belegt mit dem Wert 'Quittierung'",
                "examples": [
                  "QUITTIERUNG"
                ]
              },
              "hash": {
                "type": "string",
                "description": "Hash-Wert des Dokuments",
                "examples": [
                  "5c6031fecbd567fe65508e20d8249462"
                ]
              }
            }
          }
        },
        "required": [
          "quittierung"
        ]
      },
      "Versicherter": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 50,
            "description": "Nachname des Versicherten",
            "examples": [
              "Musterfrau"
            ]
          },
          "vorname": {
            "type": "string",
            "maxLength": 50,
            "description": "Vorname des Versicherten",
            "examples": [
              "Maria"
            ]
          },
          "geburtsdatum": {
            "type": "string",
            "format": "date-time",
            "description": "Geburtsdatum des Versicherten",
            "examples": [
              "2025-08-10T10:55:00+02:00"
            ]
          },
          "kvnr": {
            "type": "string",
            "maxLength": 12,
            "minLength": 1,
            "description": "Krankenversichertennummer des Patienten gem. \u00a7 301 SGB V",
            "examples": [
              "A123456789"
            ]
          },
          "ort": {
            "type": "string",
            "maxLength": 40,
            "description": "Wohnort des Versicherten",
            "examples": [
              "444-555"
            ]
          },
          "plz": {
            "type": "string",
            "maxLength": 10,
            "description": "Postleitzahl des Versicherten",
            "examples": [
              "81667"
            ]
          }
        },
        "required": [
          "kvnr"
        ]
      },
      "VersionResponse": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "description": "Die Version des MD-X Portals",
            "examples": [
              "1.2.0"
            ]
          }
        }
      },
      "VorgangUpdate": {
        "type": "object",
        "properties": {
          "processId": {
            "type": "string",
            "description": "Technische ID (UUID), die von MD-X einem Prozess zugewiesen wird",
            "examples": [
              "1234abcd-1234-1234-9876-9876abcd1234"
            ]
          }
        },
        "required": [
          "processId"
        ]
      }
    }
  }
}