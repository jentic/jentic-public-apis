                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResponse500"
                }
              }
            }
          }
        }
      }
    },
    "/v1/ev/anforderung": {
      "post": {
        "tags": [
          "Er\u00f6rterungsverfahren"
        ],
        "summary": "Erstellen eines Er\u00f6rterungsverfahrens",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
