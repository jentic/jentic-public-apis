{
  "openapi": "3.1.0",
  "info": {
    "title": "MD-X Portal - API Dokumentation f\u00fcr Krankenkassen",
    "description": "Spezifikation der Endpunkte f\u00fcr Krankenkassen. Mit dieser Spezifikation k\u00f6nnen Systeme der Krankenkassen an das MD-X Portal angebunden werden.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/MD-IT/mdx_api_kk/1.0.0"
  },
  "servers": [
    {
      "description": "QS-Umgebung MD-X Portal",
      "url": "https://qs-mdx.mdportal.de/api/kk"
    },
    {
      "description": "Produktivumgebung MD-X Portal",
      "url": "https://mdx.mdportal.de/api/kk"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Allgemeine Listen",
      "description": "Endpunkte zum Abruf hinterlegter Datenlisten"
    },
    {
      "name": "Dokument",
      "description": "Endpunkte f\u00fcr Dokumentenaktionen"
    },
    {
      "name": "Dokumentenklassifikation",
      "description": "Endpunkt zum Abruf der Dokumentenklassifikation"
    },
    {
      "name": "Er\u00f6rterungsverfahren",
      "description": "Endpunkte zur Anforderung eines Er\u00f6rterungsverfahrens"
    },
    {
      "name": "Quittierung",
      "description": "Endpunkte zum Erzeugen/Herunterladen der Versandbest\u00e4tigungen"
    },
    {
      "name": "System",
      "description": "Allgemeine Systemendpunkte"
    },
    {
      "name": "Systemnachrichten",
      "description": "Endpunkte zum Abruf von Systembenachrichtigungen"
    },
    {
      "name": "Vorgang",
      "description": "Endpunkte f\u00fcr allgemeine Vorgangsaktionen"
    }
  ],
  "paths": {
    "/v1/system/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Healthcheck f\u00fcr das MD-X Portal",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthcheckResponse"
                }
              }
            }
          },
          "401": {
            "description": "Es liegt keine Authentifizierung vor"
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResponse500"
                }
              }
            }
          }
        }
      }
    },
    "/v1/system/version": {
      "get": {
        "summary": "Gibt die aktuelle Version des Portals zur\u00fcck",
        "tags": [
          "System"
        ],
        "responses": {
          "200": {
            "description": "Erfolgreiche Antwort mit der aktuellen Versionsnummer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionResponse"
                }
              }
            }
          },
          "401": {
            "description": "Es liegt keine Authentifizierung vor"
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResponse500"
                }
              }
            }
          }
        }
      }
    },
    "/v1/evv/klassifikation": {
      "get": {
        "tags": [
          "Dokumentenklassifikation"
        ],
        "summary": "Endpunkt zum Abruf der Dokumentenklassifikation gem\u00e4\u00df eVV",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EvvKlassifikation"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Es liegen Validierungsfehler vor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResponse400"
                }
              }
            }
          },
          "401": {
            "description": "Es liegt keine Authentifizierung vor"
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResponse500"
                }
              }
            }
          }
        }
      }
    },
    "/v1/vorgang/search": {
      "get": {
        "tags": [
          "Vorgang"
        ],
        "summary": "Suche von Vorg\u00e4ngen",
        "parameters": [
          {
            "name": "typisierung",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "EV_ANFORDERUNG"
              ]
            },
            "description": "Typ des Vorgangs",
            "examples": {
              "Er\u00f6rterungsverfahren": {
                "value": "EV_ANFORDERUNG"
              }
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "CREATED",
                "SENT",
                "PROCESSING",
                "ANSWERED",
                "REJECTED",
                "FINISHED",
                "CANCELED"
              ]
            },
            "description": "Status des Vorgangs",
            "examples": {
              "Erstellt": {
                "value": "CREATED"
              },
              "Gesendet": {
                "value": "SENT"
              },
              "Beantwortet": {
                "value": "ANSWERED"
              },
              "Abgeschlossen": {
                "value": "FINISHED"
              },
              "Storniert": {
                "value": "CANCELLED"
              }
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Die Anzahl der Entit\u00e4ten, die \u00fcbersprungen werden.",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "examples": {
              "Ersten 10 Eintr\u00e4ge \u00fcberspringen": {
                "value": 10
              },
              "Ersten 15 Eintr\u00e4ge \u00fcberspringen": {
                "value": 15
              }
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Die Anzahl der Entit\u00e4ten, die zur\u00fcckgegeben werden.",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "examples": {
              "Maximal 25 Ergebnisse": {
                "value": 25
              },
              "Maximal 100 Ergebnisse": {
                "value": 100
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProcessListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Es liegen Validierungsfehler vor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResponse400"
                }
              }
            }
          },
          "401": {
            "description": "Es liegt keine Authentifizierung vor"
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResponse500"
                }
              }
            }
          }
        }
      }
    },
    "/v1/vorgang/todo": {
      "get": {
        "tags": [
          "Vorgang"
        ],
        "summary": "Abfragen von Vorg\u00e4ngen, die zur Bearbeitung bereit liegen",
        "parameters": [
          {
            "name": "kontext",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "EV_DOWNLOAD",
                "EV_ABLEHNUNG",
                "EV_OHNE_BEARBEITUNG"
              ]
            },
            "description": "Kontext, in dem die Suchabfrage stattfindet"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Die Anzahl der Entit\u00e4ten, die \u00fcbersprungen werden.",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Die Anzahl der Entit\u00e4ten, die zur\u00fcckgegeben werden.",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TodoResponse"
                }
              }
            }
          },
          "400": {
            "description": "Es liegen Validierungsfehler vor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResponse400"
                }
              }
            }
          },
          "401": {
            "description": "Es liegt keine Authentifizierung vor"
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResponse500"
                }
              }
            }
          }
        }
      }
    },
    "/v1/vorgang/acknowledge": {
      "post": {
        "tags": [
          "Vorgang"
        ],
        "summary": "Best\u00e4tigen des Abrufs von einem Vorgang",
        "parameters": [
          {
            "name": "processId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Eindeutige technische ID, die bei Erstellung in MD-X einem Prozess zugewiesen wird"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VorgangStatusChangeResponse"
                }
              }
            }
          },
          "400": {
            "description": "Es liegen Validierungsfehler vor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResponse400"
                }
              }
            }
          },
          "401": {
            "description": "Es liegt keine Authentifizierung vor"
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResponse500"
                }
              }
            }
          }
        }
      }
    },
    "/v1/vorgang/send": {
      "post": {
        "tags": [
          "Vorgang"
        ],
        "summary": "Senden eines Vorgangs",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "processId": {
                    "type": "string",
                    "description": "Technische ID (UUID), die von MD-X einem Prozess zugewiesen wird",
                    "examples": [
                      "0192b385-45f6-7116-8eb8-e7f94104ba7a"
                    ]
                  }
                },
                "required": [
                  "processId"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Die Beauftragung wurde erfolgreich gesendet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VorgangExchangeResponse"
                }
              }
            }
          },
          "400": {
            "description": "Es liegen Validierungsfehler vor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResponse400"
                }
              }
            }
          },
          "401": {
            "description": "Es liegt keine Authentifizierung vor"
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResponse500"
                }
              }
            }
          }
        }
      }
    },
    "/v1/vorgang/delete": {
      "delete": {
        "tags": [
          "Vorgang"
        ],
        "summary": "L\u00f6schen eines Vorgangs",
        "parameters": [
          {
            "name": "processId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Technische ID (UUID), die von MD-X einem Prozess zugewiesen wird",
            "examples": {
              "Beispiel-processId": {
                "value": "1234abcd-1234-1234-9876-9876abcd1234"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Der Vorgang wurde erfolgreich gel\u00f6scht"
          },
          "400": {
            "description": "Es liegen Validierungsfehler vor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResponse400"
                }
              }
            }
          },
          "401": {
            "description": "Es liegt keine Authentifizierung vor"
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResponse500"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tenant/list": {
      "get": {
        "tags": [
          "Allgemeine Listen"
        ],
        "summary": "Mandantendaten abrufen",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TenantListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/evv/dokument": {
      "post": {
        "tags": [
          "Dokument"
        ],
        "summary": "Hochladen eines neuen EVV Dokuments an einen bestehenden Vorgang",
        "parameters": [
          {
            "name": "processId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "example": "1234abcd-1234-1234-9876-9876abcd1234",
            "description": "Technische ID (UUID), die von MD-X einem Prozess zugewiesen wird"
          },
          {
            "name": "documentTitle",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "Sonstiges ZUS",
            "description": "Der Dokumententitel gem\u00e4\u00df EVV"
          },
          {
            "name": "beschreibung",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "Eine zus\u00e4tzliche Beschreibung zu einem Sonstigen Dokument",
            "description": "Eine bedingt verpflichtende Beschreibung des Dokumentes bei Auswahl einer ZUS-Kategorie im documentTitle"
          },
          {
            "name": "erlaeuterung",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "Dies ist eine Erl\u00e4uterung zur Befundunterlage",
            "description": "Eine optionale weitere Erl\u00e4uterung zur Befundunterlage"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "dokument": {
                    "description": "Das Dokument zum Upload",
                    "type": "string",
                    "format": "binary",
                    "examples": [
                      "dokument.pdf"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Das Dokument wurde erfolgreich hochgeladen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvvDokument"
                }
              }
            }
          },
          "400": {
            "description": "Es liegen Validierungsfehler vor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResponse400"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResponse500"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Dokument"
        ],
        "summary": "Herunterladen eines Dokuments",
        "parameters": [
          {
            "name": "processId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "example": "1234abcd-1234-1234-9876-9876abcd1234",
            "description": "Technische ID (UUID), die von MD-X einem Prozess zugewiesen wird"
          },
          {
            "name": "dokumentId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "c3da17a8-b53a-4cf6-bdee-f24e605ae9e6",
            "description": "Eindeutige technische ID des Dokumentes. Vergeben durch MD-X."
          }
        ],
        "responses": {
          "200": {
            "description": "Das Dokument wurde erfolgreich heruntergeladen",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "Es liegen Validierungsfehler vor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResponse400"
                }
              }
            }
          },
          "401": {
            "description": "Es liegt keine Authentifizierung vor"
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResponse500"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Dokument"
        ],
        "summary": "L\u00f6schen eines Dokuments",
        "parameters": [
          {
            "name": "processId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "example": "1234abcd-1234-1234-9876-9876abcd1234",
            "description": "Technische ID (UUID), die von MD-X einem Prozess zugewiesen wird"
          },
          {
            "name": "dokumentId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "c3da17a8-b53a-4cf6-bdee-f24e605ae9e6",
            "description": "Eindeutige technische ID des Dokumentes. Vergeben durch MD-X."
          }
        ],
        "responses": {
          "200": {
            "description": "Das Dokument wurde erfolgreich gel\u00f6scht"
          },
          "400": {
            "description": "Es liegen Validierungsfehler vor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResponse400"
                }
              }
            }
          },
          "401": {
            "description": "Es liegt keine Authentifizierung vor"
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResponse500"
                }
              }
            }
          }
        }
      }
    },
    "/v1/evv/dokumente/zip": {
      "get": {
        "tags": [
          "Dokument"
        ],
        "summary": "Herunterladen mehrerer Dokumente",
        "parameters": [
          {
            "name": "processId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "example": "1234abcd-1234-1234-9876-9876abcd1234",
            "description": "Technische ID, die von MD-X einem Prozess zugewiesen wurde"
          },
          {
            "name": "dokumentenIds",
            "in": "query",
            "required": true,
            "style": "form",
            "explode": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              }
            },
            "example": "c3da17a8-b53a-4cf6-bdee-f24e605ae9e6,fc02add3-464b-4a91-bda0-620fbd2b91f0",
            "description": "Eindeutige technischee IDs der Dokumente. Vergeben durch MD-X."
          }
        ],
        "responses": {
          "200": {
            "description": "Die Dokumente wurden erfolgreich heruntergeladen",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "Es liegen Validierungsfehler vor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResponse400"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResponse500"
                }
              }
            }
          }
        }
      }
    },
    "/v1/quittierung": {
      "get": {
        "tags": [
          "Quittierung"
        ],
        "summary": "Herunterladen der aktuellsten Quittierung zum Vorgang",
        "parameters": [
          {
            "name": "processId",
            "in": "query",
            "required": true,
            "schema": {
