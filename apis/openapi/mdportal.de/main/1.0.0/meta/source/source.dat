    "/v1/systemnachricht": {
      "get": {
        "tags": [
          "Systemnachrichten"
        ],
        "summary": "Suche von Systembenachrichtigungen",
        "parameters": [
          {
            "name": "kategorie",
            "in": "query",
            "description": "Die Kategorie der Systemnachricht",
            "schema": {
              "type": "string",
              "enum": [
                "GENERAL",
                "MAINTENANCE"
              ]
            }
          },
          {
            "name": "relevantFrom",
            "in": "query",
            "description": "Das Datum ab dem die Benachrichtigung relevant ist (heute wenn nicht angegeben)",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Die Anzahl der Entit\u00e4ten, die \u00fcbersprungen werden.",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Die Anzahl der Entit\u00e4ten, die zur\u00fcckgegeben werden.",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemnachrichtListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Es liegen Validierungsfehler vor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResponse400"
                }
              }
            }
          },
          "401": {
            "description": "Es liegt keine Authentifizierung vor"
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorResponse500"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Aufenthalt": {
        "type": "object",
        "properties": {
          "khFallNr": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "description": "Internes Kennzeichen des Krankenhauses gem \u00a7301 SGB V",
            "examples": [
              "20230810-20230820"
            ]
          },
          "aufenthaltVon": {
            "type": "string",
            "format": "date-time",
            "description": "Beginn des Behandlungsaufenthalts",
            "examples": [
              "2025-08-10T10:55:00+02:00"
            ]
          },
          "aufenthaltBis": {
            "type": "string",
            "format": "date-time",
            "description": "Ende des Behandlungsaufenthalts",
            "examples": [
              "2025-08-10T10:55:00+02:00"
            ]
          }
        },
        "required": [
          "khFallNr"
        ]
      },
      "Auftraggeber": {
        "type": "object",
        "properties": {
          "organisationsId": {
            "type": "string",
            "format": "uuid",
            "description": "Eindeutige technische ID der Organisation in MD-X. Wird durch das System vergeben.",
            "examples": [
              "1235abcd-1234-1234-9875-9875abcd1235"
            ]
          },
          "kasseIk": {
            "type": "string",
            "format": "string",
            "description": "Institutionskennzeichen der Krankenkasse",
            "examples": [
              "108018007"
            ]
          },
          "kasseName": {
            "type": "string",
            "format": "string",
            "description": "Name der Krankenkasse",
            "examples": [
              "AOK Baden-W\u00fcrttemberg"
            ]
          }
        },
        "required": [
          "organisationsId"
        ]
      },
      "Bearbeiter": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 50,
            "description": "Nachname des Bearbeiters",
            "examples": [
              "Musterfrau"
            ]
          },
          "vorname": {
            "type": "string",
            "maxLength": 50,
            "description": "Vorname des Bearbeiters",
            "examples": [
              "Maria"
            ]
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 100,
            "description": "E-Mail Adresse des Bearbeiters",
            "examples": [
              "m.musterfrau@mail.de"
            ]
          },
          "loginname": {
            "type": "string",
            "maxLength": 50,
            "description": "Loginname des Bearbeiters",
            "examples": [
              "Maria123"
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "ID des Bearbeiters",
            "examples": [
              "123e4567-e89b-12d3-a456-426614174000"
            ]
          }
        },
        "required": [
          "id",
          "loginname",
          "email"
        ]
      },
      "EvvDokument": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255,
            "description": "Name des Dokumentes",
            "examples": [
              "Operationsberichte_KH073457.pdf"
            ]
          },
          "documentTitle": {
            "type": "string",
            "description": "MD Dokumententyp/Beschreibung. Der Wert MUSS einem Code aus Tabelle 2 Spalte 1 des Anhang 1 zur Anlage 1 zur eVV entsprechen.",
            "examples": [
              "Operationsbericht(e)"
            ]
          },
          "documentType": {
            "type": "string",
            "description": "MD Dokumententyp (Legacy)",
            "examples": [
              "KHB"
            ]
          },
          "classCode": {
            "type": "string",
            "description": "Klassifizierung des Dokuments gem\u00e4\u00df Value Set DocumentEntry.classCode",
            "maxLength": 5,
            "examples": [
              "DUR"
            ]
          },
          "typeCode": {
            "type": "string",
            "description": "Art des Dokuments gem\u00e4\u00df Value Setm DocumentEntry.typeCode",
            "maxLength": 5,
            "examples": [
              "OPDK"
            ]
          },
          "eventCodeList": {
            "type": "string",
            "description": "Codebezeichnung des Dokuments gem\u00e4\u00df DocumentEntry.eventCodeList",
            "maxLength": 255,
            "examples": [
              "OP150103"
            ]
          },
          "eventCodeListText": {
            "type": "string",
            "description": "Text zur Codebezeichnung des Dokuments gem\u00e4\u00df DocumentEntry.eventCodeList",
            "maxLength": 255,
            "examples": [
              "OP-Bericht"
            ]
          },
          "beschreibung": {
            "type": "string",
            "description": "Zus\u00e4tzliche Beschreibung zum Dokument. Bei Auswahl einer der ZUS-Klassifizierungen verpflichtend.",
            "maxLength": 255,
            "examples": [
              "Dies ist eine zus\u00e4tzliche Beschreibung zum Dokument."
            ]
          },
          "erlaeuterung": {
            "type": "string",
            "description": "Zus\u00e4tzliche Erl\u00e4uterungen zum Dokument.",
            "maxLength": 255,
            "examples": [
              "Dies ist eine zus\u00e4tzliche Beschreibung zum Dokument."
            ]
          },
          "hash": {
            "type": "string",
            "maxLength": 255,
            "description": "MD5-Hash",
            "examples": [
              "938c2cc0dcc05f2b68c4287040cfcf71"
            ]
          },
          "mimetype": {
            "type": "string",
            "maxLength": 255,
            "description": "MIME-Type des Dokumentes",
            "examples": [
              "application/pdf"
            ]
          },
          "size": {
            "type": "integer",
            "format": "int64",
            "description": "Die Dateigr\u00f6\u00dfe in bytes",
            "examples": [
              2345
            ]
          },
          "uploadDatum": {
            "type": "string",
            "format": "date-time",
            "description": "Upload-Datum",
            "examples": [
              "2025-08-10T10:55:00+02:00"
            ]
          },
          "exportDatum": {
            "type": "string",
            "format": "date-time",
            "description": "Legacy Export-Datum des Dokumentes",
            "examples": [
              "2025-08-10T10:55:00+02:00"
            ]
          },
          "exportDatumMandant": {
            "type": "string",
            "format": "date-time",
            "examples": [
              "2025-08-10T10:55:00+02:00"
            ],
            "description": "Export-Datum des Dokumentes vom Mandanten"
          },
          "exportDatumOrganisation": {
            "type": "string",
            "format": "date-time",
            "examples": [
              "2025-08-10T10:55:00+02:00"
            ],
            "description": "Export-Datum des Dokumentes vom Teilnehmer"
          },
          "fristgerecht": {
            "type": "boolean",
            "description": "Angabe, ob das Dokument fristgerecht hochgeladen wurde. Wird durch das System vergeben."
          },
          "dokumentId": {
            "type": "string",
            "format": "uuid",
            "description": "Eindeutige technische ID des Dokumentes. Vergeben durch MD-X.",
            "examples": [
              "c3da17a8-b53a-4cf6-bdee-f24e605ae9e6"
            ]
          },
          "dokumentArt": {
            "type": "string",
            "description": "Der Typ des Dokumentes, z.B. Quittierung",
            "enum": [
              "ANLAGE",
              "QUITTIERUNG",
              "GUTACHTEN"
            ],
            "examples": [
              "ANLAGE"
            ]
          },
          "origin": {
            "type": "string",
            "description": "Die Origin des Dokuments",
            "enum": [
              "TENANT",
              "ORGANIZATION",
              "SYSTEM"
            ],
            "examples": [
              "ORGANIZATION"
            ]
          }
        },
        "required": [
          "name",
          "hash",
          "mimetype",
          "uploadDatum",
          "dokumentId",
          "dokumentArt",
          "origin"
        ]
      },
      "EvAnforderungCreateRequest": {
        "type": "object",
        "properties": {
          "md": {
            "$ref": "#/components/schemas/MDCreate"
          },
          "ansprechpartner": {
            "$ref": "#/components/schemas/EvAnsprechpartner"
          },
          "auftrag": {
            "$ref": "#/components/schemas/EvAuftrag"
          },
          "krankenhaus": {
            "$ref": "#/components/schemas/EvKrankenhaus"
          },
          "versicherter": {
            "$ref": "#/components/schemas/Versicherter"
          },
          "aufenthalt": {
            "$ref": "#/components/schemas/Aufenthalt"
          }
        },
        "required": [
          "krankenhaus",
          "auftrag",
          "versicherter",
          "aufenthalt"
        ]
      },
      "EvAnforderungUpdateRequest": {
        "type": "object",
        "properties": {
          "vorgang": {
            "$ref": "#/components/schemas/VorgangUpdate"
          },
          "md": {
            "$ref": "#/components/schemas/MDUpdate"
          },
          "ansprechpartner": {
            "$ref": "#/components/schemas/EvAnsprechpartner"
          },
          "auftrag": {
            "$ref": "#/components/schemas/EvAuftrag"
          },
          "krankenhaus": {
            "$ref": "#/components/schemas/KrankenhausUpdate"
          },
          "versicherter": {
            "$ref": "#/components/schemas/Versicherter"
          },
          "aufenthalt": {
            "$ref": "#/components/schemas/Aufenthalt"
          }
        },
        "required": [
          "vorgang"
        ]
      },
      "EvAnforderungResponse": {
        "type": "object",
        "properties": {
          "vorgang": {
            "$ref": "#/components/schemas/Vorgang"
          },
          "auftraggeber": {
            "$ref": "#/components/schemas/Auftraggeber"
          },
          "md": {
            "$ref": "#/components/schemas/MD"
          },
          "ansprechpartner": {
            "$ref": "#/components/schemas/EvAnsprechpartner"
          },
          "auftrag": {
            "$ref": "#/components/schemas/EvAuftrag"
          },
          "krankenhaus": {
            "$ref": "#/components/schemas/EvKrankenhaus"
          },
          "versicherter": {
            "$ref": "#/components/schemas/Versicherter"
          },
          "aufenthalt": {
            "$ref": "#/components/schemas/Aufenthalt"
          },
          "stornierung": {
            "$ref": "#/components/schemas/EvStornierung"
          },
          "ablehnung": {
            "$ref": "#/components/schemas/EvAblehnung"
          },
          "bearbeiter": {
            "$ref": "#/components/schemas/Bearbeiter"
          },
          "dokumente": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EvvDokument"
            }
          }
        }
      },
      "EvStornierungRequest": {
        "type": "object",
        "properties": {
          "processId": {
            "type": "string",
            "format": "uuid",
            "description": "Technische ID des zugeh\u00f6rigen Vorgutachtenvorgangs (EV_ANFORDERUNG)",
            "examples": [
              "1234abcd-1234-1234-9876-9876abcd1234"
            ]
          },
          "stornierungsMeldung": {
            "description": "Begr\u00fcndung zur Stornierung durch die Krankenkasse",
            "type": "string",
            "maxLength": 1000,
            "examples": [
              "Kl\u00e4rung mit dem Leistungserbringer erfolgt."
            ]
          }
        },
        "required": [
          "processId",
          "stornierungsMeldung"
        ]
      },
      "EvStornierung": {
        "type": "object",
        "properties": {
          "stornierungsMeldung": {
            "description": "Begr\u00fcndung zur Stornierung durch die Krankenkasse",
            "type": "string",
            "maxLength": 1000,
            "examples": [
              "Kl\u00e4rung mit dem Leistungserbringer erfolgt."
            ]
          },
          "stornierungsZeitpunkt": {
            "description": "Zeitpunkt der Stornierung durch die Krankenkasse",
            "format": "date-time",
            "type": "string",
            "examples": [
              "2025-08-10T10:55:00+02:00"
            ]
          }
        },
        "required": [
          "stornierungsMeldung"
        ]
      },
      "EvAblehnung": {
