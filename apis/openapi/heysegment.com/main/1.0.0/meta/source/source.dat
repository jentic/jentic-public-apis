:"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"},"clientId":{"type":"string"}},"required":["kind","source","credentialId"],"additionalProperties":false}]},"createdAt":{"type":"string"},"eventType":{"type":"string","enum":["item_updated"]},"itemId":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"},"details":{"type":"object","properties":{"before":{"anyOf":[{"type":"object","properties":{"mutationType":{"type":"string","enum":["business_create"]},"schemaVersion":{"type":"number","enum":[2]},"input":{"type":"object","properties":{"name":{"type":"string","pattern":"\\S","description":"Business display name. Two new businesses in one group cannot share a name."},"nickname":{"type":"string","pattern":"\\S","description":"Short name, shown where space is tight. Defaults to the name."},"organizationId":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid","description":"Organization in the account to place the new business in, as organizations list returns it. Leave out to leave it ungrouped."},"reputationManagement":{"type":"boolean","description":"Whether the business gets Reputation Management (review requests, review replies and its reputation pages), billed per business on the account's subscription."},"website":{"type":"string","enum":["none","new","existing"],"description":"The business's website, billed as one hosted site: none; new, a draft site named after the business, made with it; or existing, one of the account's sites that no business has yet. A website needs the account's Websites subscription. At least one product: Reputation Management, a website, or both."},"siteId":{"type":"string","pattern":"^[0-9A-HJKMNP-TV-Z]{12}$","description":"The site to give the business, with an existing website: one of the account's sites that no business has yet, by its id. Only with an existing website."}},"required":["name","reputationManagement","website"],"additionalProperties":false},"id":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"},"groupId":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"},"selection":{"type":"string","enum":["included","withdrawn","rejected"]}},"required":["mutationType","schemaVersion","input","id","groupId","selection"],"additionalProperties":false},{"type":"object","properties":{"mutationType":{"type":"string","enum":["business_review_request_config"]},"schemaVersion":{"type":"number","enum":[1]},"input":{"type":"object","properties":{"businessId":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid","description":"Business to change, in the authenticated account, as businesses list returns it. A saved proposal's business cannot change."},"timezone":{"type":"string","allOf":[{"description":"IANA timezone the sending hours and daily limits follow, such as America/Chicago."}]},"sendWindowStart":{"type":"string","allOf":[{"description":"Start of sending hours, HH:MM (24-hour) in the business's timezone: 08:00 at the earliest, and before the end."}]},"sendWindowEnd":{"type":"string","allOf":[{"description":"End of sending hours, HH:MM (24-hour) in the business's timezone: 20:00 at the latest, and after the start. A request due outside the hours waits for them to open."}]},"realtimeDelay":{"type":"string","enum":["immediately","few-hours","1d","2d","3d","4d"],"description":"How long after a new contact's visit or event the first review request goes out: immediately, few-hours (6 hours), 1d, 2d, 3d or 4d (the longest). Sending hours still apply. Live settings report it in seconds (4d is 345600)."},"minMessageGapDays":{"type":"integer","minimum":1,"maximum":2,"description":"Days between two messages to the same person, follow-ups included: 1 or 2. Does not turn follow-ups on or off."},"maxReactivationPerDay":{"type":"integer","minimum":0,"maximum":100,"description":"Daily limit for returning contacts (older contacts being asked again, such as an imported customer list), 0 to 100. Counted apart from new contacts, so a backlog never uses their allowance."},"maxRealtimePerDay":{"type":"integer","minimum":0,"maximum":50,"description":"Daily limit for new contacts (arriving through new visits or events), 0 to 50. Counted apart from returning contacts."},"resendEnabled":{"type":"boolean","description":"Whether a contact who was already messaged can be asked again. It takes a new visit or event arriving after the resend window; time alone never sends another request. Off: nobody is asked twice."},"resendWindowDays":{"type":"integer","minimum":30,"maximum":365,"description":"Days since the last message before a new visit or event can make a contact eligible again, 30 to 365. Only applies while resend is on, and setting it does not turn resend on."},"sendToReviewedContacts":{"type":"boolean","description":"Whether contacts who already left a review can be asked again."},"defaultPhoneRegion":{"type":"string","pattern":"^[A-Za-z]{2}$"},"personalizedImageEnabled":{"type":"boolean","description":"Whether the first request includes a personalized image, when one is available."},"phoneChannelEnabled":{"type":"boolean","description":"Whether review requests go out by text message. Text and email cannot both be off. Turn it off when the business has no phone provider, so the missing provider does not hold back its email requests."},"emailChannelEnabled":{"type":"boolean","description":"Whether review requests go out by email. Text and email cannot both be off. Turn it off when the business has no email provider, so the missing provider does not hold back its text requests."},"messages":{"type":"string","enum":["smart","own"],"description":"Which messages review requests use: smart (the platform's own) or own (the sequences written for this business, its organization or the account). With own, a channel none of those sequences covers still sends smart messages."},"phoneSender":{"anyOf":[{"type":"string","enum":["rotate"]},{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"}],"description":"Which phone sender review requests by text message go out from: rotate, to rotate between every phone sender the business can use, or one sender's id, as the business's messaging read lists it, to always use that one."},"emailSender":{"anyOf":[{"type":"string","enum":["rotate"]},{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"}],"description":"Which email sender review requests by email go out from: rotate, to rotate between every email sender the business can use, or one sender's id, as the business's messaging read lists it, to always use that one."},"emailTemplate":{"type":"string","enum":["plain","clean-card","bold-header","minimal-mono","friendly-rounded"],"description":"The email design review requests use: plain, clean-card, bold-header, minimal-mono or friendly-rounded (the app's Email template gallery), with that design's default colors."},"autoReplyEnabled":{"type":"boolean","description":"Whether a contact who replies asking for service (to book an appointment, say) gets an automatic answer: that this channel only sends review requests, and to contact the business directly."},"followUpsEnabled":{"type":"boolean","description":"Whether follow-up reminders go out after the first review request."}},"required":["businessId"],"additionalProperties":false},"id":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"},"groupId":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"},"selection":{"type":"string","enum":["included","withdrawn","rejected"]}},"required":["mutationType","schemaVersion","input","id","groupId","selection"],"additionalProperties":false},{"type":"object","properties":{"mutationType":{"type":"string","enum":["business_review_request_destination"]},"schemaVersion":{"type":"number","enum":[1]},"input":{"type":"object","properties":{"businessId":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid","description":"Business whose review requests to route, in the authenticated account, as businesses list returns it. A saved proposal's business cannot change."},"destination":{"type":"string","enum":["google_place","google_rotation","custom_url"],"description":"Where review requests send people: google_place (one Google place the business uses, given as the place id), google_rotation (rotate evenly between every active place it uses; needs two or more, and each person always lands on the same one), or custom_url (a web address you give)."},"placeId":{"type":"string","pattern":"^[A-Za-z0-9_-]+$","description":"The Google place to send everyone to, with the google_place destination: one of the active places the destination read lists for this business. Only with google_place."},"customUrl":{"type":"string","allOf":[{"description":"The web address to send everyone to, with the custom_url destination: http or https, such as a Yelp or Facebook page or the business's own site. Only with custom_url."}]},"flow":{"type":"string","enum":["direct","feedback"],"description":"What a tap does first: direct (straight to the destination) or feedback (ask how it went; the highest ratings go on to the destination, anything lower opens a private comment box instead of a public review)."},"handoffMinRating":{"type":"number","enum":[4,5],"description":"With the feedback flow, the lowest rating that goes on to the destination: 5 (only five stars) or 4 (four and five stars). Anything lower opens the private comment box. With the direct flow it is kept and has no effect until the flow is feedback again."}},"required":["businessId"],"additionalProperties":false},"id":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"},"groupId":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"},"selection":{"type":"string","enum":["included","withdrawn","rejected"]}},"required":["mutationType","schemaVersion","input","id","groupId","selection"],"additionalProperties":false},{"type":"object","properties":{"mutationType":{"type":"string","enum":["business_review_automation"]},"schemaVersion":{"type":"number","enum":[1]},"