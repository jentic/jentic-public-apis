"type":"string","enum":["SiteSecretInUse"]},"message":{"type":"string"},"siteId":{"type":"string"},"name":{"type":"string"},"usedBy":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"},"status":{"type":"string"}},"required":["id","name","status"],"additionalProperties":false}}},"required":["_tag","message","siteId","name","usedBy"],"additionalProperties":false},"SiteSecretRequestNotFoundEncoded":{"type":"object","properties":{"_tag":{"type":"string","enum":["SiteSecretRequestNotFound"]},"message":{"type":"string"},"siteId":{"type":"string"},"requestId":{"type":"string"}},"required":["_tag","message","siteId","requestId"],"additionalProperties":false},"SiteSecretRequestNotOpenEncoded":{"type":"object","properties":{"_tag":{"type":"string","enum":["SiteSecretRequestNotOpen"]},"message":{"type":"string"},"siteId":{"type":"string"},"requestId":{"type":"string"},"state":{"anyOf":[{"type":"string","enum":["open","completed","expired","revoked"]},{"type":"string"}]}},"required":["_tag","message","siteId","requestId","state"],"additionalProperties":false}},"securitySchemes":{"bearerAuth":{"type":"http","scheme":"Bearer"}}},"security":[],"tags":[{"name":"CLI access","description":"First-party browser authentication for the Heysegment CLI."},{"name":"Credential validation","description":"Pre-save inspection for bearer credentials."},{"name":"Ping","description":"Liveness and credential-scope probe."},{"name":"Account","description":"The account your credential belongs to: the top of the tenancy hierarchy, addressed without an id."},{"name":"Mutations","description":"Drafts of proposed changes to the account, staged for review. Nothing here approves or applies a change."},{"name":"Organizations","description":"Organization-tier operations. An organization belongs to exactly one account."},{"name":"Businesses","description":"Stored business configuration and access. Available to credentials scoped at the owning account, organization, or business."},{"name":"Business reputation","description":"Check reputation setup and review how messages, reviews and feedback are performing."},{"name":"Reputation messaging","description":"Read delivery settings, sending identities, sequences and email templates for this business."},{"name":"Reviews and private feedback","description":"Read the review automation and its voice, Google reviews, the review request destination and private feedback."},{"name":"Destinations and personalized images","description":"Read Link domain, Link theme and Personalized image settings for this business."},{"name":"GoHighLevel contacts","description":"Read GoHighLevel contact sync rules and the history of bulk imports."},{"name":"CSV uploads","description":"Read CSV Upload history and processing outcomes without uploaded contact records."},{"name":"Account sites","description":"The account's websites and the templates a new one starts from. Every operation needs the account to have Websites; without it, each answers 402 (`WebsitesSubscriptionRequired`)."},{"name":"Function call history","description":"How the account's site backend functions are doing, and the calls that failed, across every site or narrowed to one site or one function."},{"name":"Site errors","description":"Every kind of error on the account's sites, through one door: counted per site, and each kind's failures to fix."},{"name":"Site domains","description":"Any domain, planned for one of the account's websites, before it is connected."},{"name":"Sites","description":"One website of the account, named by id, and its pushes. The account's list of sites is under Account."},{"name":"Site assets","description":"The images, videos and audio files a site uses: create one, upload it straight to storage, complete it."},{"name":"Site submissions","description":"The kinds of data a site takes in, such as a contact form: each a name, a description and a schema. List them, read one, create one, delete one."},{"name":"Site submission emails","description":"Each entry of a submission, emailed: turn it on or off, and manage the addresses it goes to."},{"name":"Site submission texts","description":"The numbers each entry of a submission is texted to: add one, take one off."},{"name":"Feedback"},{"name":"Site functions","description":"The server code a site runs: create a function with the project it starts from, read its contract, upload its code, run it once, change it while it is a draft, publish it, read its source, delete it."},{"name":"Site secrets","description":"The secret values a site's backend functions are given: ask for them through a link, and list the names that have one."},{"name":"Site SDK","description":"The generated code a site's pages use to send its submissions and call its functions."},{"name":"Site rules","description":"The platform's rules for sites, which `heysegment-beta sites validate` follows."},{"name":"CLI","description":"Which version of the Heysegment CLI to run: what an installed CLI asks to know it is current."}],"servers":[{"url":"https://api.heysegment.com","description":"Production"},{"url":"https://api-lab.heysegment.com","description":"Lab"}]}