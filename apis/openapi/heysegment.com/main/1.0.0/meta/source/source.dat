-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"},"groupId":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"},"selection":{"type":"string","enum":["included","withdrawn","rejected"]}},"required":["mutationType","schemaVersion","input","id","groupId","selection"],"additionalProperties":false},{"type":"object","properties":{"mutationType":{"type":"string","enum":["business_review_automation"]},"schemaVersion":{"type":"number","enum":[1]},"input":{"type":"object","properties":{"businessId":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid","description":"Business whose review automation to change, in the authenticated account, as businesses list returns it. A saved proposal's business cannot change."},"publishFiveStarReplies":{"type":"boolean","description":"Whether replies to five-star reviews publish to Google without a person approving each one; off, each waits as a draft for a person. Every star rating has its own switch, and this one changes no other."},"publishFourStarReplies":{"type":"boolean","description":"Whether replies to four-star reviews publish to Google without a person approving each one; off, each waits as a draft for a person. Every star rating has its own switch, and this one changes no other."},"publishThreeStarReplies":{"type":"boolean","description":"Whether replies to three-star reviews publish to Google without a person approving each one; off, each waits as a draft for a person. Every star rating has its own switch, and this one changes no other."},"publishTwoStarReplies":{"type":"boolean","description":"Whether replies to two-star reviews publish to Google without a person approving each one; off, each waits as a draft for a person. Every star rating has its own switch, and this one changes no other."},"publishOneStarReplies":{"type":"boolean","description":"Whether replies to one-star reviews publish to Google without a person approving each one; off, each waits as a draft for a person. Every star rating has its own switch, and this one changes no other."},"linkLikelyMatches":{"type":"boolean","description":"Whether a likely match between a review and a contact is linked automatically; off, it waits as a suggestion to confirm. Sets it for this business, over what it inherits from its organization or the account."}},"required":["businessId"],"additionalProperties":false},"id":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"},"groupId":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"},"selection":{"type":"string","enum":["included","withdrawn","rejected"]}},"required":["mutationType","schemaVersion","input","id","groupId","selection"],"additionalProperties":false},{"type":"object","properties":{"mutationType":{"type":"string","enum":["business_review_voice"]},"schemaVersion":{"type":"number","enum":[1]},"input":{"type":"object","properties":{"businessId":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid","description":"Business whose voice to change, in the authenticated account, as businesses list returns it. A saved proposal's business cannot change."},"reviewId":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid","description":"Review whose reply to add or take out, as the business's reviews list returns it: a review on a Google place the business uses. A saved proposal's review cannot change."},"example":{"type":"string","enum":["add","remove"],"description":"add: copy the review and the reply Google shows now into the business's voice (the review needs a reply on Google, and the voice holds 10 at most); remove: take it out. Removals apply before additions, so a group can swap one for another."}},"required":["businessId","reviewId","example"],"additionalProperties":false},"id":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"},"groupId":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"},"selection":{"type":"string","enum":["included","withdrawn","rejected"]}},"required":["mutationType","schemaVersion","input","id","groupId","selection"],"additionalProperties":false},{"type":"object","properties":{"mutationType":{"type":"string","enum":["site_domain"]},"schemaVersion":{"type":"number","enum":[1]},"input":{"type":"object","properties":{"siteId":{"type":"string","pattern":"^[0-9A-HJKMNP-TV-Z]{12}$","description":"Site the domain is for, in the authenticated account, as sites list returns it. A saved proposal's site cannot change."},"domain":{"type":"string","minLength":1,"description":"The domain to connect, as the plan names its root (example.com). It replaces whatever domain the site has. Leave out with remove."},"setup":{"type":"string","enum":["root_primary_cname","www_primary_cname","www_primary_redirect_ip"],"description":"The setup, as the plan lists it: root_primary_cname (the root shows the site, www forwards by CNAME), www_primary_cname (www shows the site, the root forwards by CNAME), www_primary_redirect_ip (www shows the site, the root forwards by A record: the only setup where the DNS company cannot point a root at a hostname). Leave out with remove."},"provider":{"type":"string","enum":["cloudflare","godaddy","namecheap","squarespace","porkbun","hostinger","ionos","wix","route53","digitalocean","vercel","netlify","wordpress","bluehost","hostgator","siteground","namecom","spaceship","networksolutions","namesilo","dynadot","hover","azure","gandi","ovh","dreamhost","inmotion","dnsimple","dnsmadeeasy"],"description":"The company managing the domain's DNS, as the plan's provider.id names it. Leave out when the plan could not name one: the root is then set up as unable to point at a hostname (www_primary_redirect_ip)."},"forwardOther":{"type":"boolean","description":"Whether the other name forwards to the main address (true unless said): everyone who types it then lands on the site. False leaves the other name as it is, with nothing of the site on it."},"remove":{"type":"boolean","description":"True to take the site's domain off: every name of it stops reaching the site. Names nothing else."}},"required":["siteId"],"additionalProperties":false},"id":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"},"groupId":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"},"selection":{"type":"string","enum":["included","withdrawn","rejected"]}},"required":["mutationType","schemaVersion","input","id","groupId","selection"],"additionalProperties":false},{"type":"object","properties":{"mutationType":{"type":"string","enum":["site_text_sender"]},"schemaVersion":{"type":"number","enum":[1]},"input":{"type":"object","properties":{"siteId":{"type":"string","pattern":"^[0-9A-HJKMNP-TV-Z]{12}$","description":"Site whose texting this is, in the authenticated account, as sites list returns it. A saved proposal's site cannot change."},"senderId":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid","description":"The phone sender the site texts from: the id of one of the eligible senders the site's texting read lists for it (the business's own, its organization's shared, or the account's shared). Choosing one turns texting on. Leave out with remove."},"remove":{"type":"boolean","description":"True to turn the site's texting off: no form is texted until a number is chosen again. Every form keeps its numbers. Names nothing else."}},"required":["siteId"],"additionalProperties":false},"id":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"},"groupId":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"},"selection":{"type":"string","enum":["included","withdrawn","rejected"]}},"required":["mutationType","schemaVersion","input","id","groupId","selection"],"additionalProperties":false}]},"approval":{"type":"string","enum":["human_required","agent_allowed"],"description":"Approval requirement of the included items. Submission must recheck it."},"names":{"type":"object","properties":{"businesses":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"},"name":{"type":"string"}},"required":["id","name"],"additionalProperties":false}},"organizations":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"},"name":{"type":"string"}},"required":["id","name"],"additionalProperties":false}},"places":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"name":{"anyOf":[{"type":"string"},{"type":"null"}]},"address":{"anyOf":[{"type":"string"},{"type":"null"}]}},"required":["id","name","address"],"additionalProperties":false}},"reviews":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"},"rating":{"anyOf":[{"type":"integer"},{"type":"null"}]},"reviewText":{"anyOf":[{"type":"string"},{"type":"null"}]},"replyText":{"anyOf":[{"type":"string"},{"type":"null"}]}},"required":["id","rating","reviewText","replyText"],"additionalProperties":false}},"senders":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"},"channel":{"type":"string"},"address":{"type":"string"},"label":{"anyOf":[{"type":"string"},{"type":"null"}]},"provider":{"type":"string"}},"required":["id","channel","address","label","provider"],"additionalProperties":false}},"sites":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"},"assigned":{"type":"boolean"},"previewUrl":{"anyOf":[{"type":"string"},{"type":"null"}]},"domain":{"anyOf":[{"type":"string"},{"type":"null"}]},"textSender":{"anyOf":[{"type":"object","properties":{"id":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"},"address":{"type":"string"},"label":{"anyOf":[{"type":"string"},{"type":"null"}]}},"required":["id","address","label"],"additionalProperties":false},{"type":"null"}]}},"required":["id","name","assigned","previewUrl","domain","textSender"],"additionalProperties":false}}},"required":["businesses","organizations","places","reviews","senders","sites"],"additionalProperties":false}},"required":["object","group","item","approval","names"],"additionalProperties":false}}}},"400":{"description":"The body has a field this endpoint does not take.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MutationInvalidEncoded"}}}},"401":{"description":"The bearer credential is missing or not usable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UnauthorizedEncoded"}}}},"403":{"description":"The credential is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ForbiddenEncoded"}}}},"404":{"description":"A mutation group, proposal, business or organization the account does not have, or a Google place, review or sender the business does not use. | The requested tenant does not exist.","content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/MutationNotFoundEncoded"},{"$ref":"#/components/schemas/NotFoundEncoded"}]}}}},"409":{"description":"The mutation draft cannot take this change as sent.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MutationConflictEncoded"}}}}},"description":"Replaces a proposal whole, and restores it if it was withdrawn or rejected. Its type cannot change (a 409 `item_mismatch`). The body is the whole proposal: `mutationType` and that type's fields. `business_create` takes a name, its products (`reputationManagement`, and a `website` of `none`, `new` or `existing` with the `siteId` of one of the account's sites that no business has, as `GET /v1/account/business-options` lists them) and optionally a nickname and an organization in the account; `business_review_request_config` takes a business in the account and at least one setting, and a group holds one such proposal per business (a second is a 409 `duplicate` naming the existing item). Nothing live changes.","summary":"Replace a proposal","requestBody":{"content":{"application/json":{"schema":{"anyOf":[{"type":"object","properties":{"mutationType":{"type":"string","enum":["business_create"]},"name":{"type":"string","pattern":"\\S","description":"Business display name. Two new businesses in one group cannot share a name."},"nickname":{"type":"string","pattern":"\\S","description":"Short name, shown where space is tight. Defaults to the name."},"organizationId":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid","description":"Organization in the account to place the new business in, as organizations list returns it. Leave out to leave it ungrouped."},"reputationManagement":{"type":"boolean","description":"Whether the business gets Reputation Management (review requests, review replies and its reputation pages), billed per business on the account's subscription."},"website":{"type":"string","enum":["none","new","existing"],"description":"The business's website, billed as one hosted site: none; new, a draft site named after the business, made with it; or existing, one of the account's sites that no business has yet. A website needs the account's Websites subscription. At least one product: Reputation Management, a website, or both."},"siteId":{"type":"string","pattern":"^[0-9A-HJKMNP-TV-Z]{12}$","description":"The site to give the business, with an existing website: one of the account's sites that no business has yet, by its id. Only with an existing website."}},"required":["mutationType","name","reputationManagement","website"],"additionalProperties":false,"title":"Create a business","description":"Propose a new business with its products: Reputation Management, a website (a new site, or one of the account's sites that no business has yet), or both. Optionally placed in one of the account's organizations. Requires a person's approval, because it is charged.","examples":[{"mutationType":"business_create","name":"Aqua Pro Plumbing","nickname":"Aqua Pro","reputationManagement":true,"website":"new"}]},{"type":"object","properties":{"mutationType":{"type":"string","enum":["business_review_request_config"]},"businessId":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid","description":"Business to change, in the authenticated account, as businesses list returns it. A saved proposal's business cannot change."},"timezone":{"type":"string","allOf":[{"description":"IANA timezone the sending hours and daily limits follow, such as America/Chicago."}]},"sendWindowStart":{"type":"string","allOf":[{"description":"Start of sending hours, HH:MM (24-hour) in the business's timezone: 08:00 at the earliest, and before the end."}]},"sendWindowEnd":{"type":"string","allOf":[{"description":"End of sending hours, HH:MM (24-hour) in the business's timezone: 20:00 at the latest, and after the start. A request due outside the hours waits for them to open."}]},"realtimeDelay":{"type":"string","enum":["immediately","few-hours","1d","2d","3d","4d"],"description":"How long after a new contact's visit or event the first review request goes out: immediately, few-hours (6 hours), 1d, 2d, 3d or 4d (the longest). Sending hours still apply. Live settings report it in seconds (4d is 345600)."},"minMessageGapDays":{"type":"integer","minimum":1,"maximum":2,"description":"Days between two messages to the same person, follow-ups included: 1 or 2. Does not turn follow-ups on or off."},"maxReactivationPerDay":{"type":"integer","minimum":0,"maximum":100,"description":"Daily limit for returning contacts (older contacts being asked again, such as an imported customer list), 0 to 100. Counted apart from new contacts, so a backlog never uses their allowance."},"maxRealtimePerDay":{"type":"integer","minimum":0,"maximum":50,"description":"Daily limit for new contacts (arriving through new visits or events), 0 to 50. Counted apart from returning contacts."},"resendEnabled":{"type":"boolean","description":"Whether a contact who was already messaged can be asked again. It takes a new visit or event arriving after the resend window; time alone never sends another request. Off: nobody is asked twice."},"resendWindowDays":{"type":"integer","minimum":30,"maximum":365,"description":"Days since the last message before a new visit or event can make a contact eligible again, 30 to 365. Only applies while resend is on, and setting it does not turn resend on."},"sendToReviewedContacts":{"type":"boolean","description":"Whether contacts who already left a review can be asked again."},"defaultPhoneRegion":{"type":"string","pattern":"^[A-Za-z]{2}$","allOf":[{"description":"Country for imported phone numbers written without an international prefix, as a two-letter region code: US, CA, GB, AU, NZ, IE, and so on. A code phone numbers cannot be read in is refused. Numbers already stored do not change."}]},"personalizedImageEnabled":{"type":"boolean","description":"Whether the first request includes a personalized image, when one is available."},"phoneChannelEnabled":{"type":"boolean","description":"Whether review requests go out by text message. Text and email cannot both be off. Turn it off when the business has no phone provider, so the missing provider does not hold back its email requests."},"emailChannelEnabled":{"type":"boolean","description":"Whether review requests go out by email. Text and email cannot both be off. Turn it off when the business has no email provider, so the missing provider does not hold back its text requests."},"messages":{"type":"string","enum":["smart","own"],"description":"Which messages review requests use: smart (the platform's own) or own (the sequences written for this business, its organization or the account). With own, a channel none of those sequences covers still sends smart messages."},"phoneSender":{"anyOf":[{"type":"string","enum":["rotate"]},{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"}],"description":"Which phone sender review requests by text message go out from: rotate, to rotate between every phone sender the business can use, or one sender's id, as the business's messaging read lists it, to always use that one."},"emailSender":{"anyOf":[{"type":"string","enum":["rotate"]},{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"}],"description":"Which email sender review requests by email go out from: rotate, to rotate between every email sender the business can use, or one sender's id, as the business's messaging read lists it, to always use that one."},"emailTemplate":{"type":"string","enum":["plain","clean-card","bold-header","minimal-mono","friendly-rounded"],"description":"The email design review requests use: plain, clean-card, bold-header, minimal-mono or friendly-rounded (the app's Email template gallery), with that design's default colors."},"autoReplyEnabled":{"type":"boolean","description":"Whether a contact who replies asking for service (to book an appointment, say) gets an automatic answer: that this channel only sends review requests, and to contact the business directly."},"followUpsEnabled":{"type":"boolean","description":"Whether follow-up reminders go out after the first review request."}},"required":["mutationType","businessId"],"additionalProperties":false,"title":"Configure review requests for a business","description":"Propose review-request settings for an existing business: the business id and at least one setting. One such proposal per business in a group. Settings left out keep their live values when applied.","examples":[{"mutationType":"business_review_request_config","businessId":"3b0f5a3e-8f7c-4d7e-9a53-0d1f0f3c9b21","realtimeDelay":"few-hours","minMessageGapDays":2,"followUpsEnabled":true}]},{"type":"object","properties":{"mutationType":{"type":"string","enum":["business_review_request_destination"]},"businessId":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid","description":"Business whose review requests to route, in the authenticated account, as businesses list returns it. A saved proposal's business cannot change."},"destination":{"type":"string","enum":["google_place","google_rotation","custom_url"],"description":"Where review requests send people: google_place (one Google place the business uses, given as the place id), google_rotation (rotate evenly between every active place it uses; needs two or more, and each person always lands on the same one), or custom_url (a web address you give)."},"placeId":{"type":"string","pattern":"^[A-Za-z0-9_-]+$","description":"The Google place to send everyone to, with the google_place destination: one of the active places the destination read lists for this business. Only with google_place."},"customUrl":{"type":"string","allOf":[{"description":"The web address to send everyone to, with the custom_url destination: http or https, such as a Yelp or Facebook page or the business's own site. Only with custom_url."}]},"flow":{"type":"string","enum":["direct","feedback"],"description":"What a tap does first: direct (straight to the destination) or feedback (ask how it went; the highest ratings go on to the destination, anything lower opens a private comment box instead of a public review)."},"handoffMinRating":{"type":"number","enum":[4,5],"description":"With the feedback flow, the lowest rating that goes on to the destination: 5 (only five stars) or 4 (four and five stars). Anything lower opens the private comment box. With the direct flow it is kept and has no effect until the flow is feedback again."}},"required":["mutationType","businessId"],"additionalProperties":false,"title":"Choose where a business's review requests send people","description":"Propose a business's review request destination (a Google place, a rotation between its Google places, or a web address), what a tap does first, which ratings its feedback page sends on, or any of them. What is left out stays as it is.","examples":[{"mutationType":"business_review_request_destination","businessId":"3b0f5a3e-8f7c-4d7e-9a53-0d1f0f3c9b21","destination":"google_rotation","flow":"feedback","handoffMinRating":4}]},{"type":"object","properties":{"mutationType":{"type":"string","enum":["business_review_automation"]},"businessId":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid","description":"Business whose review automation to change, in the authenticated account, as businesses list returns it. A saved proposal's business cannot change."},"publishFiveStarReplies":{"type":"boolean","description":"Whether replies to five-star reviews publish to Google without a person approving each one; off, each waits as a draft for a person. Every star rating has its own switch, and this one changes no other."},"publishFourStarReplies":{"type":"boolean","description":"Whether replies to four-star reviews publish to Google without a person approving each one; off, each waits as a draft for a person. Every star rating has its own switch, and this one changes no other."},"publishThreeStarReplies":{"type":"boolean","description":"Whether replies to three-star reviews publish to Google without a person approving each one; off, each waits as a draft for a person. Every star rating has its own switch, and this one changes no other."},"publishTwoStarReplies":{"type":"boolean","description":"Whether replies to two-star reviews publish to Google without a person approving each one; off, each waits as a draft for a person. Every star rating has its own switch, and this one changes no other."},"publishOneStarReplies":{"type":"boolean","description":"Whether replies to one-star reviews publish to Google without a person approving each one; off, each waits as a draft for a person. Every star rating has its own switch, and this one changes no other."},"linkLikelyMatches":{"type":"boolean","description":"Whether a likely match between a review and a contact is linked automatically; off, it waits as a suggestion to confirm. Sets it for this business, over what it inherits from its organization or the account."}},"required":["mutationType","businessId"],"additionalProperties":false,"title":"Change a business's review automation","description":"Propose what happens on its own when a business gets a Google review: for each star rating, whether replies to reviews of that rating publish without approval, and whether likely contacts are linked automatically. What is left out stays as it is.","examples":[{"mutationType":"business_review_automation","businessId":"3b0f5a3e-8f7c-4d7e-9a53-0d1f0f3c9b21","publishFiveStarReplies":true,"publishFourStarReplies":true}]},{"type":"object","properties":{"mutationType":{"type":"string","enum":["business_review_voice"]},"businessId":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid","description":"Business whose voice to change, in the authenticated account, as businesses list returns it. A saved proposal's business cannot change."},"reviewId":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid","description":"Review whose reply to add or take out, as the business's reviews list returns it: a review on a Google place the business uses. A saved proposal's review cannot change."},"example":{"type":"string","enum":["add","remove"],"description":"add: copy the review and the reply Google shows now into the business's voice (the review needs a reply on Google, and the voice holds 10 at most); remove: take it out. Removals apply before additions, so a group can swap one for another."}},"required":["mutationType","businessId","reviewId","example"],"additionalProperties":false,"title":"Add a reply to a business's voice, or take one out","description":"Propose one review's reply as a voice example for the business, so the replies drafted for it follow that tone, or propose taking one out. One proposal per review in a group.","examples":[{"mutationType":"business_review_voice","businessId":"3b0f5a3e-8f7c-4d7e-9a53-0d1f0f3c9b21","reviewId":"5c1d8e2a-7b4f-4c3e-9d6a-2e8f1b0c7a94","example":"add"}]},{"type":"object","properties":{"mutationType":{"type":"string","enum":["site_domain"]},"siteId":{"type":"string","pattern":"^[0-9A-HJKMNP-TV-Z]{12}$","description":"Site the domain is for, in the authenticated account, as sites list returns it. A saved proposal's site cannot change."},"domain":{"type":"string","minLength":1,"description":"The domain to connect, as the plan names its root (example.com). It replaces whatever domain the site has. Leave out with remove."},"setup":{"type":"string","enum":["root_primary_cname","www_primary_cname","www_primary_redirect_ip"],"description":"The setup, as the plan lists it: root_primary_cname (the root shows the site, www forwards by CNAME), www_primary_cname (www shows the site, the root forwards by CNAME), www_primary_redirect_ip (www shows the site, the root forwards by A record: the only setup where the DNS company cannot point a root at a hostname). Leave out with remove."},"provider":{"type":"string","enum":["cloudflare","godaddy","namecheap","squarespace","porkbun","hostinger","ionos","wix","route53","digitalocean","vercel","netlify","wordpress","bluehost","hostgator","siteground","namecom","spaceship","networksolutions","namesilo","dynadot","hover","azure","gandi","ovh","dreamhost","inmotion","dnsimple","dnsmadeeasy"],"description":"The company managing the domain's DNS, as the plan's provider.id names it. Leave out when the plan could not name one: the root is then set up as unable to point at a hostname (www_primary_redirect_ip)."},"forwardOther":{"type":"boolean","description":"Whether the other name forwards to the main address (true unless said): everyone who types it then lands on the site. False leaves the other name as it is, with nothing of the site on it."},"remove":{"type":"boolean","description":"True to take the site's domain off: every name of it stops reaching the site. Names nothing else."}},"required":["mutationType","siteId"],"additionalProperties":false,"title":"Connect or remove a site's domain","description":"Propose a domain for one of the account's websites, with the setup the plan lists for it (it replaces whatever domain the site has), or propose taking the site's domain off. One proposal per site in a group. Requires a person's approval.","examples":[{"mutationType":"site_domain","siteId":"5R5Q9YZNNQ6Y","domain":"example.com","setup":"www_primary_redirect_ip","provider":"godaddy"}]},{"type":"object","properties":{"mutationType":{"type":"string","enum":["site_text_sender"]},"siteId":{"type":"string","pattern":"^[0-9A-HJKMNP-TV-Z]{12}$","description":"Site whose texting this is, in the authenticated account, as sites list returns it. A saved proposal's site cannot change."},"senderId":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid","description":"The phone sender the site texts from: the id of one of the eligible senders the site's texting read lists for it (the business's own, its organization's shared, or the account's shared). Choosing one turns texting on. Leave out with remove."},"remove":{"type":"boolean","description":"True to turn the site's texting off: no form is texted until a number is chosen again. Every form keeps its numbers. Names nothing else."}},"required":["mutationType","siteId"],"additionalProperties":false,"title":"Choose the number a site texts from","description":"Propose the phone sender one of the account's websites texts its forms' recipients from (one of the senders the site may use: its business's own, its organization's shared, or the account's shared), which turns texting on; or propose turning the site's texting off. One proposal per site in a group. An agent can approve it.","examples":[{"mutationType":"site_text_sender","siteId":"5R5Q9YZNNQ6Y","senderId":"7f20c1b2-3d4e-4f50-a6b7-c8d9e0f1a2b3"}]}],"title":"Proposal","description":"One proposal, of any supported type. `mutationType` says which, and the other fields are that type's."}}},"required":true}},"delete":{"tags":["Mutations"],"operationId":"mutations.withdrawItem","parameters":[{"name":"groupId","in":"path","schema":{"type":"string"},"required":true},{"name":"itemId","in":"path","schema":{"type":"string"},"required":true}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"type":"string","enum":["agent_mutation_save"]},"group":{"type":"object","properties":{"id":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"},"title":{"type":"string"},"status":{"type":"string","enum":["draft","approved","rejected"]},"revision":{"type":"integer","exclusiveMinimum":0},"includedItems":{"type":"integer","minimum":0}},"required":["id","title","status","revision","includedItems"],"additionalProperties":false},"item":{"anyOf":[{"type":"object","properties":{"mutationType":{"type":"string","enum":["business_create"]},"schemaVersion":{"type":"number","enum":[2]},"input":{"type":"object","properties":{"name":{"type":"string","pattern":"\\S","description":"Business display name. Two new businesses in one group cannot share a name."},"nickname":{"type":"string","pattern":"\\S","description":"Short name, shown where space is tight. Defaults to the name."},"organizationId":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid","description":"Organization in the account to place the new business in, as organizations list returns it. Leave out to leave it ungrouped."},"reputationManagement":{"type":"boolean","description":"Whether the business gets Reputation Management (review requests, review replies and its reputation pages), billed per business on the account's subscription."},"website":{"type":"string","enum":["none","new","existing"],"description":"The business's website, billed as one hosted site: none; new, a draft site named after the business, made with it; or existing, one of the account's sites that no business has yet. A website needs the account's Websites subscription. At least one product: Reputation Management, a website, or both."},"siteId":{"type":"string","pattern":"^[0-9A-HJKMNP-TV-Z]{12}$","description":"The site to give the business, with an existing website: one of the account's sites that no business has yet, by its id. Only with an existing website."}},"required":["name","reputationManagement","website"],"additionalProperties":false},"id":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"},"groupId":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"},"selection":{"type":"string","enum":["included","withdrawn","rejected"]}},"required":["mutationType","schemaVersion","input","id","groupId","selection"],"additionalProperties":false},{"type":"object","properties":{"mutationType":{"type":"string","enum":["business_review_request_config"]},"schemaVersion":{"type":"number","enum":[1]},"input":{"type":"object","properties":{"businessId":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid","description":"Business to change, in the authenticated account, as businesses list returns it. A saved proposal's business cannot change."},"timezone":{"type":"string","allOf":[{"description":"IANA timezone the sending hours and daily limits follow, such as America/Chicago."}]},"sendWindowStart":{"type":"string","allOf":[{"description":"Start of sending hours, HH:MM (24-hour) in the business's timezone: 08:00 at the earliest, and before the end."}]},"sendWindowEnd":{"type":"string","allOf":[{"description":"End of sending hours, HH:MM (24-hour) in the business's timezone: 20:00 at the latest, and after the start. A request due outside the hours waits for them to open."}]},"realtimeDelay":{"type":"string","enum":["immediately","few-hours","1d","2d","3d","4d"],"description":"How long after a new contact's visit or event the first review request goes out: immediately, few-hours (6 hours), 1d, 2d, 3d or 4d (the longest). Sending hours still apply. Live settings report it in seconds (4d is 345600)."},"minMessageGapDays":{"type":"integer","minimum":1,"maximum":2,"description":"Days between two messages to the same person, follow-ups included: 1 or 2. Does not turn follow-ups on or off."},"maxReactivationPerDay":{"type":"integer","minimum":0,"maximum":100,"description":"Daily limit for returning contacts (older contacts being asked again, such as an imported customer list), 0 to 100. Counted apart from new contacts, so a backlog never uses their allowance."},"maxRealtimePerDay":{"type":"integer","minimum":0,"maximum":50,"description":"Daily limit for new contacts (arriving through new visits or events), 0 to 50. Counted apart from returning contacts."},"resendEnabled":{"type":"boolean","description":"Whether a contact who was already messaged can be asked again. It takes a new visit or event arriving after the resend window; time alone never sends another request. Off: nobody is asked twice."},"resendWindowDays":{"type":"integer","minimum":30,"maximum":365,"description":"Days since the last message before a new visit or event can make a contact eligible again, 30 to 365. Only applies while resend is on, and setting it does not turn resend on."},"sendToReviewedContacts":{"type":"boolean","description":"Whether contacts who already left a review can be asked again."},"defaultPhoneRegion":{"type":"string","pattern":"^[A-Za-z]{2}$"},"personalizedImageEnabled":{"type":"boolean","description":"Whether the first request includes a personalized image, when one is available."},"phoneChannelEnabled":{"type":"boolean","description":"Whether review requests go out by text message. Text and email cannot both be off. Turn it off when the business has no phone provider, so the missing provider does not hold back its email requests."},"emailChannelEnabled":{"type":"boolean","description":"Whether review requests go out by email. Text and email cannot both be off. Turn it off when the business has no email provider, so the missing provider does not hold back its text requests."},"messages":{"type":"string","enum":["smart","own"],"description":"Which messages review requests use: smart (the platform's own) or own (the sequences written for this business, its organization or the account). With own, a channel none of those sequences covers still sends smart messages."},"phoneSender":{"anyOf":[{"type":"string","enum":["rotate"]},{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"}],"description":"Which phone sender review requests by text message go out from: rotate, to rotate between every phone sender the business can use, or one sender's id, as the business's messaging read lists it, to always use that one."},"emailSender":{"anyOf":[{"type":"string","enum":["rotate"]},{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"}],"description":"Which email sender review requests by email go out from: rotate, to rotate between every email sender the business can use, or one sender's id, as the business's messaging read lists it, to always use that one."},"emailTemplate":{"type":"string","enum":["plain","clean-card","bold-header","minimal-mono","friendly-rounded"],"description":"The email design review requests use: plain, clean-card, bold-header, minimal-mono or friendly-rounded (the app's Email template gallery), with that design's default colors."},"autoReplyEnabled":{"type":"boolean","description":"Whether a contact who replies asking for service (to book an appointment, say) gets an automatic answer: that this channel only sends review requests, and to contact the business directly."},"followUpsEnabled":{"type":"boolean","description":"Whether follow-up reminders go out after the first review request."}},"required":["businessId"],"additionalProperties":false},"id":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"},"groupId":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"},"selection":{"type":"string","enum":["included","withdrawn","rejected"]}},"required":["mutationType","schemaVersion","input","id","groupId","selection"],"additionalProperties":false},{"type":"object","properties":{"mutationType":{"type":"string","enum":["business_review_request_destination"]},"schemaVersion":{"type":"number","enum":[1]},"input":{"type":"object","properties":{"businessId":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid","description":"Business whose review requests to route, in the authenticated account, as businesses list returns it. A saved proposal's business cannot change."},"destination":{"type":"string","enum":["google_place","google_rotation","custom_url"],"description":"Where review requests send people: google_place (one Google place the business uses, given as the place id), google_rotation (rotate evenly between every active place it uses; needs two or more, and each person always lands on the same one), or custom_url (a web address you give)."},"placeId":{"type":"string","pattern":"^[A-Za-z0-9_-]+$","description":"The Google place to send everyone to, with the google_place destination: one of the active places the destination read lists for this business. Only with google_place."},"customUrl":{"type":"string","allOf":[{"description":"The web address to send everyone to, with the custom_url destination: http or https, such as a Yelp or Facebook page or the business's own site. Only with custom_url."}]},"flow":{"type":"string","enum":["direct","feedback"],"description":"What a tap does first: direct (straight to the destination) or feedback (ask how it went; the highest ratings go on to the destination, anything lower opens a private comment box instead of a public review)."},"handoffMinRating":{"type":"number","enum":[4,5],"description":"With the feedback flow, the lowest rating that goes on to the destination: 5 (only five stars) or 4 (four and five stars). Anything lower opens the private comment box. With the direct flow it is kept and has no effect until the flow is feedback again."}},"required":["businessId"],"additionalProperties":false},"id":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"},"groupId":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F