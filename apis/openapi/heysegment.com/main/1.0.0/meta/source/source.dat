pe":"boolean","description":"Whether the business gets Reputation Management (review requests, review replies and its reputation pages), billed per business on the account's subscription."},"website":{"type":"string","enum":["none","new","existing"],"description":"The business's website, billed as one hosted site: none; new, a draft site named after the business, made with it; or existing, one of the account's sites that no business has yet. A website needs the account's Websites subscription. At least one product: Reputation Management, a website, or both."},"siteId":{"type":"string","pattern":"^[0-9A-HJKMNP-TV-Z]{12}$","description":"The site to give the business, with an existing website: one of the account's sites that no business has yet, by its id. Only with an existing website."}},"required":["name","reputationManagement","website"],"additionalProperties":false},"id":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"},"groupId":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"},"selection":{"type":"string","enum":["included","withdrawn","rejected"]},"applyStatus":{"type":"string","enum":["not_started","running","applied","failed"]},"attempts":{"type":"integer","minimum":0},"result":{"anyOf":[{"anyOf":[{"type":"object","properties":{"businessId":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"},"site":{"anyOf":[{"type":"object","properties":{"id":{"type":"string"},"created":{"type":"boolean"}},"required":["id","created"],"additionalProperties":false},{"type":"null"}]}},"r