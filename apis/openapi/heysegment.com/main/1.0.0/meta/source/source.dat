bject","properties":{"name":{"type":"string"},"message":{"type":"string"},"stack":{"anyOf":[{"type":"string"},{"type":"null"}]}},"required":["name","message","stack"],"additionalProperties":false},{"type":"null"}]},"detail":{"anyOf":[{"type":"string"},{"type":"null"}]},"codeSha256":{"anyOf":[{"type":"string"},{"type":"null"}]},"currentCode":{"type":"boolean"},"sourceMapUrl":{"anyOf":[{"type":"string"},{"type":"null"}]}},"required":["object","invocationId","functionId","functionName","functionStatus","siteId","siteName","caller","at","durationMs","runMs","inputBytes","stage","reason","fault","error","detail","codeSha256","currentCode","sourceMapUrl"],"additionalProperties":false}},"hasMore":{"type":"boolean"},"nextCursor":{"anyOf":[{"type":"string"},{"type":"null"}]}},"required":["object","days","since","until","retentionDays","site","function","caller","stage","invocation","total","functions","data","hasMore","nextCursor"],"additionalProperties":false}}}},"400":{"description":"The cursor is not one this endpoint issued.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/InvalidCursorEncoded"}}}},"401":{"description":"The bearer credential is missing or not usable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UnauthorizedEncoded"}}}},"402":{"description":"The account does not have Websites.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WebsitesSubscriptionRequiredEncoded"}}}},"403":{"description":"The credential is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ForbiddenEncoded"}}}},"404":{"description":"The requested tenant does not exist.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NotFoundEncoded"}}}}},"description":"The calls to the account's backend functions that failed over the last `days`. `functions` names each function that failed with how many calls failed, when the last was, how many calls ANSWERED since (`answeredSince`: zero means it has not worked since) and its `kinds` of failure (the `stage` it stopped at, the `reason` within it, the error's name, how many, the first and the last). `data` is the failed calls themselves, newest first, 10 a page unless `limit` says (at most 50): each with its invocation id, the handler's own `error` (name, message, stack) or one line of `detail`, whose `fault` it is (`function` or `platform`), the upload that failed and whether the function still holds it (`currentCode`). A stack's positions are in the function's built bundle (`bundle.js:1:113`), not its source: `sourceMapUrl` is where the bundle's source map downloads from, to turn one into a line of the source (null once the function has replaced that upload). `total` counts every failed call in scope. Same filters as the overview, plus `stage` and `invocation` (one call). Page with `cursor`. Never what a call was sent, what it answered, or a secret's value.","summary":"Function call failures"}},"/v1/account/site-errors":{"get":{"tags":["Site errors"],"operationId":"accountSiteErrors.siteErrors","parameters":[{"name":"site","in":"query","schema":{"type":"string","minLength":1,"description":"Only this site's errors, by the site's id. Left out: every site of the account."},"required":false},{"name":"days","in":"query","schema":{"type":"string","pattern":"^[+-]?\\d*\\.?\\d+(?:[Ee][+-]?\\d+)?$"},"required":false}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"type":"string","enum":["site_error_overview"]},"days":{"anyOf":[{"type":"number"},{"type":"string","enum":["Infinity","-Infinity","NaN"]}]},"since":{"type":"string"},"until":{"type":"string"},"site":{"anyOf":[{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"}},"required":["id","name"],"additionalProperties":false},{"type":"null"}]},"totals":{"type":"object","properties":{"function