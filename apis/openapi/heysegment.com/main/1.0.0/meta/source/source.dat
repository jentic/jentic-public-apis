"}}}},"403":{"description":"The credential is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ForbiddenEncoded"}}}},"404":{"description":"The requested tenant does not exist.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NotFoundEncoded"}}}}},"description":"Returns the site's texting: whether it has anything to text from (`available`), the phone sender every form's texts come from (`sender`, with `eligible` and, when the site may no longer use it, `problem`), every sender it may choose from (`eligible`: its business's own, then its organization's shared, then the account's shared; a number reserved for another business is never listed), and each form by name with the numbers texted about its entries. Stored facts only; nothing changes.","summary":"Get the site's texting"}},"/v1/sites/{siteId}/status":{"get":{"tags":["Sites"],"operationId":"sites.status","parameters":[{"name":"siteId","in":"path","schema":{"type":"string"},"required":true}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"type":"string","enum":["site_status"]},"siteId":{"type":"string"},"deploy":{"anyOf":[{"type":"object","properties":{"object":{"type":"string","enum":["site_deploy"]},"id":{"type":"string"},"snapshot":{"type":"object","properties":{"object":{"type":"string","enum":["site_snapshot"]},"id":{"type":"string"},"sequence":{"type":"integer"},"summary":{"type":"string"},"deployState":{"anyOf":[{"anyOf":[{"type":"string","enum":["deploying","deployed","failed","retired"]},{"type":"string"}]},{"type":"null"}]},"url":{"anyOf":[{"type":"string"},{"type":"null"}]},"storedAt":{"type":"string"}},"required":["object","id","sequence","summary","deployState","url","storedAt"],"additionalProperties":false},"state":{"anyOf":[{"type":"string","enum":["running","succeeded","failed"]},{"type":"string"}]},"failure":{"anyOf":[{"type":"object","properties":{"reason":{"anyOf":[{"type":"string","enum":["site_error","platform_error","superseded","timed_out","cancelled"]},{"type":"string"}]},"detail":{"type":"string"}},"required":["reason","detail"],"additionalProperties":false},{"type":"null"}]},"startedAt":{"type":"string"},"progress":{"anyOf":[{"type":"object","properties":{"handedOff":{"type":"boolean"},"lastStep":{"anyOf":[{"type":"object","properties":{"step":{"anyOf":[{"type":"string","enum":["connect","pull","disconnect","validate","prepare","install","build","package","deploy"]},{"type":"string"}]},"state":{"anyOf":[{"type":"string","enum":["succeeded","failed"]},{"type":"string"}]},"at":{"type":"string"}},"required":["step","state","at"],"additionalProperties":false},{"type":"null"}]}},"required":["handedOff","lastStep"],"additionalProperties":false},{"type":"null"}]},"clock":{"anyOf":[{"type":"object","properties":{"runningSeconds":{"type":"integer"},"seemsStuck":{"type":"boolean"},"limitSeconds":{"type":"integer"}},"required":["runningSeconds","seemsStuck","limitSeconds"],"additionalProperties":false},{"type":"null"}]}},"required":["object","id","snapshot","state","failure","startedAt","progress","clock"],"additionalProperties":false},{"type":"null"}]},"previewUrl":{"anyOf":[{"type":"string"},{"type":"null"}]}},"required":["object","siteId","deploy","previewUrl"],"additionalProperties":false}}}},"401":{"description":"The bearer credential is missing or not usable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UnauthorizedEncoded"}}}},"402":{"description":"The account does not have Websites.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WebsitesSubscriptionRequiredEncoded"}}}},"403":{"description":"The credential is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ForbiddenEncoded"}}}},"404":{"description":"The requested tenant does not exist.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NotFoundEncoded"}}}}},"description":"Returns the site's latest deploy (every push starts one), or `null` before any: its id, the push it deploys, and its state. While it runs, whether the build container has it and the last step it reported. A failed deploy says why (`site_error`: fix the site and push again; `platform_error`, `timed_out`: push again with `force`, which deploys the same push again; `superseded`: a newer push deploys instead; `cancelled`) and what the failing step said, with the end of its log. Nothing changes.","summary":"Get the site's deploy status"}},"/v1/sites/{siteId}/logs":{"get":{"tags":["Sites"],"operationId":"sites.logs","parameters":[{"name":"siteId","in":"path","schema":{"type":"string"},"required":true},{"name":"deploy","in":"query","schema":{"type":"string","description":"The deploy's id, as `sites status` shows it. Leave it out for the site's newest deploy."},"required":false},{"name":"step","in":"query","schema":{"type":"string","enum":["connect","pull","disconnect","validate","prepare","install","build","package","deploy"],"description":"Which step's log. Leave it out for the last step the deploy logged: for a failed deploy, the step that failed."},"required":false}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"type":"string","enum":["site_deploy_log"]},"siteId":{"type":"string"},"deployId":{"type":"string"},"state":{"anyOf":[{"type":"string","enum":["running","succeeded","failed"]},{"type":"string"}]},"step":{"anyOf":[{"type":"string","enum":["connect","pull","disconnect","validate","prepare","install","build","package","deploy"]},{"type":"string"}]},"steps":{"type":"array","items":{"anyOf":[{"type":"string","enum":["connect","pull","disconnect","validate","prepare","install","build","package","deploy"]},{"type":"string"}]}},"text":{"type":"string"}},"required":["object","siteId","deployId","state","step","steps","text"],"additionalProperties":false}}}},"401":{"description":"The bearer credential is missing or not usable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UnauthorizedEncoded"}}}},"402":{"description":"The account does not have Websites.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WebsitesSubscriptionRequiredEncoded"}}}},"403":{"description":"The credential is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ForbiddenEncoded"}}}},"404":{"description":"No such deploy log. | The requested tenant does not exist.","content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/SiteDeployLogMissingEncoded"},{"$ref":"#/components/schemas/NotFoundEncoded"}]}}}}},"description":"Returns one step's whole log of one of the site's deploys: every command the step ran and all they printed. By default the newest deploy (`deploy` names another) and the last step it logged (`step` names another): for a failed deploy, the step that failed. `steps` lists every step the deploy logged. A log longer than about 2 MB keeps its beginning and its end. 404 `SiteDeployLogMissing` says why there is none: no deploy, no such deploy, no step logged yet, not that step, or the deploy's logs were deleted (they are kept for three days). Nothing changes.","summary":"Get a deploy step's log"}},"/v1/sites/{siteId}/archive":{"get":{"tags":["Sites"],"operationId":"sites.archive","parameters":[{"name":"siteId","in":"path","schema":{"type":"string"},"required":true}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"type":"string","enum":["site_archive"]},"siteId":{"type":"string"},"siteName":{"type":"string"},"businessId":{"anyOf":[{"type":"string"},{"type":"null"}]},"snapshot":{"type":"object","properties":{"object":{"type":"string","enum":["site_snapshot"]},"id":{"type":"string"},"sequence":{"type":"integer"},"summary":{"type":"string"},"deployState":{"anyOf":[{"anyOf":[{"type":"string","enum":["deploying","deployed","failed","retired"]},{"type":"string"}]},{"type":"null"}]},"url":{"anyOf":[{"type":"string"},{"type":"null"}]},"storedAt":{"type":"string"}},"required":["object","id","sequence","summary","deployState","url","storedAt"],"additionalProperties":false},"newest":{"type":"boolean"},"url":{"type":"string"},"expiresAt":{"type":"string"},"sha256":{"type":"string"},"bytes":{"type":"integer"}},"required":["object","siteId","siteName","businessId","snapshot","newest","url","expiresAt","sha256","bytes"],"additionalProperties":false}}}},"401":{"description":"The bearer credential is missing or not usable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UnauthorizedEncoded"}}}},"402":{"description":"The account does not have Websites.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WebsitesSubscriptionRequiredEncoded"}}}},"403":{"description":"The credential is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ForbiddenEncoded"}}}},"404":{"description":"The requested tenant does not exist.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NotFoundEncoded"}}}},"409":{"description":"The site has no pushes to pull.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SiteNothingToPullEncoded"}}}}},"description":"Names the site's newest push and where to download it as one archive: a link signed for that one archive for a few minutes, and the SHA-256 and size to check it against. That push is the base the next push from those files builds on. Answers 409 `SiteNothingToPull` when the site has no pushes yet (its first version comes from a folder linked to it). Nothing changes.","summary":"Get the site's newest push"}},"/v1/sites/{siteId}/snapshots/{snapshotId}/archive":{"get":{"tags":["Sites"],"operationId":"sites.snapshotArchive","parameters":[{"name":"siteId","in":"path","schema":{"type":"string"},"required":true},{"name":"snapshotId","in":"path","schema":{"type":"string"},"required":true}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"type":"string","enum":["site_archive"]},"siteId":{"type":"string"},"siteName":{"type":"string"},"businessId":{"anyOf":[{"type":"string"},{"type":"null"}]},"snapshot":{"type":"object","properties":{"object":{"type":"string","enum":["site_snapshot"]},"id":{"type":"string"},"sequence":{"type":"integer"},"summary":{"type":"string"},"deployState":{"anyOf":[{"anyOf":[{"type":"string","enum":["deploying","deployed","failed","retired"]},{"type":"string"}]},{"type":"null"}]},"url":{"anyOf":[{"type":"string"},{"type":"null"}]},"storedAt":{"type":"string"}},"required":["object","id","sequence","summary","deployState","url","storedAt"],"additionalProperties":false},"newest":{"type":"boolean"},"url":{"type":"string"},"expiresAt":{"type":"string"},"sha256":{"type":"string"},"bytes":{"type":"integer"}},"required":["object","siteId","siteName","businessId","snapshot","newest","url","expiresAt","sha256","bytes"],"additionalProperties":false}}}},"401":{"description":"The bearer credential is missing or not usable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UnauthorizedEncoded"}}}},"402":{"description":"The account does not have Websites.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WebsitesSubscriptionRequiredEncoded"}}}},"403":{"description":"The credential is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ForbiddenEncoded"}}}},"404":{"description":"The requested tenant does not exist.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NotFoundEncoded"}}}},"410":{"description":"The push's files were deleted.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SiteArchiveDeletedEncoded"}}}}},"description":"Names one stored push of the site, by its snapshot id, and where to download it as one archive: a link signed for that one archive for a few minutes, and the SHA-256 and size to check it against. `newest` says whether it is the site's newest push (a push built on an older one is refused as behind). A push that is still uploading or never landed, and another site's, are the same 404. 410 `SiteArchiveDeleted`: the push is kept as a record but its files were deleted (a site keeps the files of its five newest pushes and of the pushes it serves). Nothing changes.","summary":"Get one push of the site"}},"/v1/sites/{siteId}/pushes":{"post":{"tags":["Sites"],"operationId":"sites.reservePush","parameters":[{"name":"siteId","in":"path","schema":{"type":"string"},"required":true}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"type":"string","enum":["site_push"]},"siteId":{"type":"string"},"snapshotId":{"type":"string"},"base":{"anyOf":[{"type":"string"},{"type":"null"}]},"resumed":{"type":"boolean"},"expiresAt":{"type":"string"},"upload":{"type":"object","properties":{"method":{"type":"string","enum":["PUT"]},"url":{"type":"string"},"headers":{"type":"object","additionalProperties":{"type":"string"}}},"required":["method","url","headers"],"additionalProperties":false},"stops":{"anyOf":[{"type":"object","properties":{"object":{"type":"string","enum":["site_deploy"]},"id":{"type":"string"},"snapshot":{"type":"object","properties":{"object":{"type":"string","enum":["site_snapshot"]},"id":{"type":"string"},"sequence":{"type":"integer"},"summary":{"type":"string"},"deployState":{"anyOf":[{"anyOf":[{"type":"string","enum":["deploying","deployed","failed","retired"]},{"type":"string"}]},{"type":"null"}]},"url":{"anyOf":[{"type":"string"},{"type":"null"}]},"storedAt":{"type":"string"}},"required":["object","id","sequence","summary","deployState","url","storedAt"],"additionalProperties":false},"state":{"anyOf":[{"type":"string","enum":["running","succeeded","failed"]},{"type":"string"}]},"failure":{"anyOf":[{"type":"object","properties":{"reason":{"anyOf":[{"type":"string","enum":["site_error","platform_error","superseded","timed_out","cancelled"]},{"type":"string"}]},"detail":{"type":"string"}},"required":["reason","detail"],"additionalProperties":false},{"type":"null"}]},"startedAt":{"type":"string"},"progress":{"anyOf":[{"type":"object","properties":{"handedOff":{"type":"boolean"},"lastStep":{"anyOf":[{"type":"object","properties":{"step":{"anyOf":[{"type":"string","enum":["connect","pull","disconnect","validate","prepare","install","build","package","deploy"]},{"type":"string"}]},"state":{"anyOf":[{"type":"string","enum":["succeeded","failed"]},{"type":"string"}]},"at":{"type":"string"}},"required":["step","state","at"],"additionalProperties":false},{"type":"null"}]}},"required":["handedOff","lastStep"],"additionalProperties":false},{"type":"null"}]},"clock":{"anyOf":[{"type":"object","properties":{"runningSeconds":{"type":"integer"},"seemsStuck":{"type":"boolean"},"limitSeconds":{"type":"integer"}},"required":["runningSeconds","seemsStuck","limitSeconds"],"additionalProperties":false},{"type":"null"}]}},"required":["object","id","snapshot","state","failure","startedAt","progress","clock"],"additionalProperties":false},{"type":"null"}]}},"required":["object","siteId","snapshotId","base","resumed","expiresAt","upload","stops"],"additionalProperties":false}}}},"401":{"description":"The bearer credential is missing or not usable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UnauthorizedEncoded"}}}},"402":{"description":"The account does not have Websites.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WebsitesSubscriptionRequiredEncoded"}}}},"403":{"description":"The credential is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ForbiddenEncoded"}}}},"404":{"description":"The requested tenant does not exist.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NotFoundEncoded"}}}},"409":{"description":"The site has unpublished functions; publish or delete each one, then push. | The files are already the site's newest push. | The push does not build on the site's newest push. | Another push is in flight on this site. | The site is deploying; push with force to stop that deploy and deploy this push.","content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/SitePushUnpublishedFunctionsEncoded"},{"$ref":"#/components/schemas/SitePushNoChangesEncoded"},{"$ref":"#/components/schemas/SitePushStaleEncoded"},{"$ref":"#/components/schemas/SitePushInFlightEncoded"},{"$ref":"#/components/schemas/SitePushDeployingEncoded"}]}}}}},"description":"Declares a push: the push its files were pulled at (`base`), what changed, and the archive's SHA-256 and size. Nothing is uploaded yet. The push is refused with 409 when the site has backend functions that are not published (`SitePushUnpublishedFunctions`, naming every draft: publish or delete each one first; `force` does not change it), when there is nothing to push (`SitePushNoChanges`: the archive is the head's), when it does not build on the site's newest push (`SitePushStale`, whose `reason` says why and whose `since` lists the pushes the files are missing), while another push is in flight (`SitePushInFlight`), or while the site is deploying (`SitePushDeploying`: the deploy, how long it has run, whether it looks stuck). With `force`, a push goes on while the site deploys (`stops` names the deploy its commit stops), and a push of files that are already the newest push deploys that push again (`SitePushNoChanges` with `redeploying`). Otherwise it is reserved: the answer names the push's snapshot id and a presigned URL to PUT the archive to, with the headers that must go with it. Upload and commit before `expiresAt`. Declaring the same push again (the same base and archive) while it is in flight resumes it: the same snapshot id, a fresh URL.","summary":"Start a push","requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"base":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"The id of the push the files were pulled at: the site's head when they were pulled. null only for the site's first push. A push whose base is not the site's head is refused."},"summary":{"type":"string","minLength":1,"pattern":"^\\S[\\s\\S]*\\S$|^\\S$|^$","maxLength":200,"allOf":[{"pattern":"^[^\\r\\n]*$","description":"What changed, in one line of 1 to 200 characters. Whoever pushes next is shown it."}]},"archiveSha256":{"type":"string","pattern":"^[0-9a-f]{64}$","description":"The SHA-256 of the archive, as 64 lowercase hex characters. The upload is refused unless it is exactly these bytes."},"archiveBytes":{"type":"integer","minimum":1,"maximum":52428800,"description":"The size of the archive in bytes, 1 to 52428800 (50 MB)."},"force":{"type":"boolean","description":"true to push while the site is deploying: landing this push stops that deploy and deploys this one. With files that are already the site's newest push, true deploys that push again (stopping any deploy running). Without it, a push is refused while the site is deploying."}},"required":["base","summary","archiveSha256","archiveBytes"],"additionalProperties":false}}},"required":true}}},"/v1/sites/{siteId}/pushes/{snapshotId}/commit":{"post":{"tags":["Sites"],"operationId":"sites.commitPush","parameters":[{"name":"siteId","in":"path","schema":{"type":"string"},"required":true},{"name":"snapshotId","in":"path","schema":{"type":"string"},"required":true}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"type":"string","enum":["site_push_commit"]},"siteId":{"type":"string"},"snapshot":{"type":"object","properties":{"object":{"type":"string","enum":["site_snapshot"]},"id":{"type":"string"},"sequence":{"type":"integer"},"summary":{"type":"string"},"deployState":{"anyOf":[{"anyOf":[{"type":"string","enum":["deploying","deployed","failed","retired"]},{"type":"string"}]},{"type":"null"}]},"url":{"anyOf":[{"type":"string"},{"type":"null"}]},"storedAt":{"type":"string"}},"required":["object","id","sequence","summary","deployState","url","storedAt"],"additionalProperties":false},"alreadyCommitted":{"type":"boolean"}},"required":["object","siteId","snapshot","alreadyCommitted"],"additionalProperties":false}}}},"401":{"description":"The bearer credential is missing or not usable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UnauthorizedEncoded"}}}},"402":{"description":"The account does not have Websites.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WebsitesSubscriptionRequiredEncoded"}}}},"403":{"description":"The credential is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ForbiddenEncoded"}}}},"404":{"description":"The requested tenant does not exist.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NotFoundEncoded"}}}},"409":{"description":"The push's archive is not in storage as declared. | The push expired or was abandoned before it was committed. | The push does not build on the site's newest push.","content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/SitePushIncompleteEncoded"},{"$ref":"#/components/schemas/SitePushDiscardedEncoded"},{"$ref":"#/components/schemas/SitePushStaleEncoded"}]}}}}},"description":"Lands a reserved push once its archive is uploaded: the archive in storage must be the one the push declared (size and SHA-256), and the site's newest push must still be the push's base. Then the push becomes the site's newest push, the head, and is sent to be deployed. Refused with 409 when the archive is not in storage as declared (`SitePushIncomplete`, whose `problem` says missing, wrong size or other bytes; the push is still in flight, so upload again and commit again), when the push expired or was abandoned (`SitePushDiscarded`; push again), or, as a backstop, when the site moved on (`SitePushStale`). Committing a push that already landed answers the same snapshot with `alreadyCommitted: true`, so a retry is safe.","summary":"Commit a push"}},"/v1/sites/{siteId}/pushes/{snapshotId}":{"delete":{"tags":["Sites"],"operationId":"sites.abandonPush","parameters":[{"name":"siteId","in":"path","schema":{"type":"string"},"required":true},{"name":"snapshotId","in":"path","schema":{"type":"string"},"required":true}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"type":"string","enum":["site_push_abandoned"]},"siteId":{"type":"string"},"snapshotId":{"type":"string"},"summary":{"type":"string"}},"required":["object","siteId","snapshotId","summary"],"additionalProperties":false}}}},"401":{"description":"The bearer credential is missing or not usable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UnauthorizedEncoded"}}}},"402":{"description":"The account does not have Websites.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WebsitesSubscriptionRequiredEncoded"}}}},"403":{"description":"The credential is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ForbiddenEncoded"}}}},"404":{"description":"The requested tenant does not exist.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NotFoundEncoded"}}}},"409":{"description":"The push was already committed.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SitePushAlreadyCommittedEncoded"}}}}},"description":"Gives up a push that is in flight, so the site takes the next push at once instead of when the push's window closes. Anyone who may push to the site may abandon its push in flight. A push that is already over answers the same way, so abandoning twice is safe. A push that was committed is part of the site's history and cannot be abandoned (409 `SitePushAlreadyCommitted`).","summary":"Abandon a push"}},"/v1/sites/{siteId}/assets":{"get":{"tags":["Site assets"],"operationId":"siteAssets.listAssets","parameters":[{"name":"siteId","in":"path","schema":{"type":"string"},"required":true},{"name":"category","in":"query","schema":{"type":"string","enum":["image","video","audio","document"],"description":"Only assets of this kind: image, video, audio or document."},"required":false},{"name":"fileType","in":"query","schema":{"type":"string","enum":["png","jpeg","webp","avif","gif","svg","mp4","webm","mp3","m4a","wav","ogg","pdf","docx","xlsx","pptx","doc","xls","ppt","odt","ods","odp","rtf","txt","csv","md"],"description":"Only assets of this file type: one of png, jpeg, webp, avif, gif, svg, mp4, webm, mp3, m4a, wav, ogg, pdf, docx, xlsx, pptx, doc, xls, ppt, odt, ods, odp, rtf, txt, csv, md."},"required":false},{"name":"limit","in":"query","schema":{"type":"string","pattern":"^[+-]?\\d*\\.?\\d+(?:[Ee][+-]?\\d+)?$"},"required":false},{"name":"cursor","in":"query","schema":{"type":"string","description":"The nextCursor of the previous page. Leave it out for the first page."},"required":false}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"type":"string","enum":["site_asset_list"]},"siteId":{"type":"string"},"category":{"anyOf":[{"anyOf":[{"type":"string","enum":["image","video","audio","document"]},{"type":"string"}]},{"type":"null"}]},"fileType":{"anyOf":[{"anyOf":[{"type":"string","enum":["png","jpeg","webp","avif","gif","svg","mp4","webm","mp3","m4a","wav","ogg","pdf","docx","xlsx","pptx","doc","xls","ppt","odt","ods","odp","rtf","txt","csv","md"]},{"type":"string"}]},{"type":"null"}]},"counts":{"type":"object","properties":{"image":{"type":"integer"},"video":{"type":"integer"},"audio":{"type":"integer"},"document":{"type":"integer"}},"required":["image","video","audio","document"],"additionalProperties":false},"data":{"type":"array","items":{"type":"object","properties":{"object":{"type":"string","enum":["site_asset"]},"id":{"type":"string"},"siteId":{"type":"string"},"category":{"anyOf":[{"type":"string","enum":["image","video","audio","document"]},{"type":"string"}]},"fileType":{"anyOf":[{"type":"string","enum":["png","jpeg","webp","avif","gif","svg","mp4","webm","mp3","m4a","wav","ogg","pdf","docx","xlsx","pptx","doc","xls","ppt","odt","ods","odp","rtf","txt","csv","md"]},{"type":"string"}]},"name":{"type":"string"},"description":{"anyOf":[{"type":"string"},{"type":"null"}]},"byteSize":{"type":"integer"},"sha256":{"type":"string"},"status":{"anyOf":[{"type":"string","enum":["uploading","complete"]},{"type":"string"}]},"url":{"type":"string"},"createdAt":{"type":"string"},"completedAt":{"anyOf":[{"type":"string"},{"type":"null"}]}},"required":["object","id","siteId","category","fileType","name","description","byteSize","sha256","status","url","createdAt","completedAt"],"additionalProperties":false}},"hasMore":{"type":"boolean"},"nextCursor":{"anyOf":[{"type":"string"},{"type":"null"}]}},"required":["object","siteId","category","fileType","counts","data","hasMore","nextCursor"],"additionalProperties":false}}}},"400":{"description":"The cursor is not one this endpoint issued.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/InvalidCursorEncoded"}}}},"401":{"description":"The bearer credential is missing or not usable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UnauthorizedEncoded"}}}},"402":{"description":"The account does not have Websites.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WebsitesSubscriptionRequiredEncoded"}}}},"403":{"description":"The credential is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ForbiddenEncoded"}}}},"404":{"description":"The requested tenant does not exist.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NotFoundEncoded"}}}}},"description":"The site's complete assets, each with the public `url` its pages use: images, then videos, then audio, then documents, the newest first within each. Filter by `category` or by `fileType` (a file type and a category that disagree are refused with 400). 50 to a page by default; `counts` says how many match in each category. An asset still uploading is never listed. A cursor this endpoint did not issue is refused with 400 (`InvalidCursor`).","summary":"List a site's assets"},"post":{"tags":["Site assets"],"operationId":"siteAssets.createAsset","parameters":[{"name":"siteId","in":"path","schema":{"type":"string"},"required":true}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"type":"string","enum":["site_asset_created"]},"asset":{"type":"object","properties":{"object":{"type":"string","enum":["site_asset"]},"id":{"type":"string"},"siteId":{"type":"string"},"category":{"anyOf":[{"type":"string","enum":["image","video","audio","document"]},{"type":"string"}]},"fileType":{"anyOf":[{"type":"string","enum":["png","jpeg","webp","avif","gif","svg","mp4","webm","mp3","m4a","wav","ogg","pdf","docx","xlsx","pptx","doc","xls","ppt","odt","ods","odp","rtf","txt","csv","md"]},{"type":"string"}]},"name":{"type":"string"},"description":{"anyOf":[{"type":"string"},{"type":"null"}]},"byteSize":{"type":"integer"},"sha256":{"type":"string"},"status":{"anyOf":[{"type":"string","enum":["uploading","complete"]},{"type":"string"}]},"url":{"type":"string"},"createdAt":{"type":"string"},"completedAt":{"anyOf":[{"type":"string"},{"type":"null"}]}},"required":["object","id","siteId","category","fileType","name","description","byteSize","sha256","status","url","createdAt","completedAt"],"additionalProperties":false},"expiresAt":{"type":"string"},"upload":{"type":"object","properties":{"method":{"type":"string","enum":["PUT"]},"url":{"type":"string"},"headers":{"type":"object","additionalProperties":{"type":"string"}}},"required":["method","url","headers"],"additionalProperties":false}},"required":["object","asset","expiresAt","upload"],"additionalProperties":false}}}},"401":{"description":"The bearer credential is missing or not usable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UnauthorizedEncoded"}}}},"402":{"description":"The account does not have Websites.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WebsitesSubscriptionRequiredEncoded"}}}},"403":{"description":"The credential is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ForbiddenEncoded"}}}},"404":{"description":"The requested tenant does not exist.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NotFoundEncoded"}}}},"413":{"description":"The declared file is larger than its category allows.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SiteAssetTooLargeEncoded"}}}}},"description":"Declares a file the site will use (an image, a video, an audio file or a document: its type, name, size and SHA-256, and optionally a description of what it shows or holds) before anything is uploaded, and records it as `uploading`. The answer is the asset, with the public `url` it will be served at, and a presigned URL to PUT the file to, with the headers that must go with it: the upload is refused unless it is exactly the declared bytes. Upload, then complete, before `expiresAt`. A file larger than its category allows is refused with 413 (`SiteAssetTooLarge`) and nothing is recorded.","summary":"Create an asset","requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"fileType":{"type":"string","enum":["png","jpeg","webp","avif","gif","svg","mp4","webm","mp3","m4a","wav","ogg","pdf","docx","xlsx","pptx","doc","xls","ppt","odt","ods","odp","rtf","txt","csv","md"],"description":"The file's type: one of png, jpeg, webp, avif, gif, svg, mp4, webm, mp3, m4a, wav, ogg, pdf, docx, xlsx, pptx, doc, xls, ppt, odt, ods, odp, rtf, txt, csv, md. It decides the asset's category (image, video, audio or document) and the Content-Type the file is served with."},"name":{"type":"string","minLength":1,"pattern":"^\\S[\\s\\S]*\\S$|^\\S$|^$","maxLength":200,"allOf":[{"pattern":"^[^\\r\\n]*$","description":"What the file is called (\"hero.jpg\"), 1 to 200 characters on one line. It tells the site's assets apart; it is not part of the asset's URL."}]},"description":{"type":"string","minLength":1,"pattern":"^\\S[\\s\\S]*\\S$|^\\S$|^$","maxLength":1000,"description":"What the file shows or holds, in 1 to 1000 characters: for an image, what is in it (\"The front desk, two staff smiling\"). Read when choosing an asset for a page, and a start on an image's alt text. Leave it out when there is nothing to say."},"byteSize":{"type":"integer","minimum":1,"maximum":209715200,"description":"The file's size in bytes: at most 10 MB for an image, 200 MB for a video, 50 MB for audio and 50 MB for a document. The upload is refused unless it is exactly this size."},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$","description":"The SHA-256 of the file, as 64 lowercase hex characters. The upload is refused unless it is exactly these bytes."}},"required":["fileType","name","byteSize","sha256"],"additionalProperties":false}}},"required":true}}},"/v1/sites/{siteId}/assets/{assetId}/complete":{"post":{"tags":["Site assets"],"operationId":"siteAssets.completeAsset","parameters":[{"name":"siteId","in":"path","schema":{"type":"string"},"required":true},{"name":"assetId","in":"path","schema":{"type":"string"},"required":true}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"type":"string","enum":["site_asset_completed"]},"asset":{"type":"object","properties":{"object":{"type":"string","enum":["site_asset"]},"id":{"type":"string"},"siteId":{"type":"string"},"category":{"anyOf":[{"type":"string","enum":["image","video","audio","document"]},{"type":"string"}]},"fileType":{"anyOf":[{"type":"string","enum":["png","jpeg","webp","avif","gif","svg","mp4","webm","mp3","m4a","wav","ogg","pdf","docx","xlsx","pptx","doc","xls","ppt","odt","ods","odp","rtf","txt","csv","md"]},{"type":"string"}]},"name":{"type":"string"},"description":{"anyOf":[{"type":"string"},{"type":"null"}]},"byteSize":{"type":"integer"},"sha256":{"type":"string"},"status":{"anyOf":[{"type":"string","enum":["uploading","complete"]},{"type":"string"}]},"url":{"type":"string"},"createdAt":{"type":"string"},"completedAt":{"anyOf":[{"type":"string"},{"type":"null"}]}},"required":["object","id","siteId","category","fileType","name","description","byteSize","sha256","status","url","createdAt","completedAt"],"additionalProperties":false},"alreadyCompleted":{"type":"boolean"}},"required":["object","asset","alreadyCompleted"],"additionalProperties":false}}}},"401":{"description":"The bearer credential is missing or not usable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UnauthorizedEncoded"}}}},"402":{"description":"The account does not have Websites.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WebsitesSubscriptionRequiredEncoded"}}}},"403":{"description":"The credential is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ForbiddenEncoded"}}}},"404":{"description":"The requested tenant does not exist.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NotFoundEncoded"}}}},"409":{"description":"The asset's file is not in storage as declared. | The asset's upload window closed before it was completed.","content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/SiteAssetIncompleteEncoded"},{"$ref":"#/components/schemas/SiteAssetExpiredEncoded"}]}}}}},"description":"Confirms an asset's upload: the file in storage must be the one the asset declared (size and SHA-256). Then the asset is `complete`. Refused with 409 when the file is not in storage as declared (`SiteAssetIncomplete`, whose `problem` says missing, wrong size or other bytes; the asset is still uploading, so upload again and complete again), or when the upload window closed first (`SiteAssetExpired`; create the asset again). Completing an asset that is already complete answers the same asset with `alreadyCompleted: true`, so a retry is safe.","summary":"Complete an asset"}},"/v1/sites/{siteId}/submissions":{"get":{"tags":["Site submissions"],"operationId":"siteSubmissions.listSubmissions","parameters":[{"name":"siteId","in":"path","schema":{"type":"string"},"required":true}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"type":"string","enum":["site_submission_list"]},"siteId":{"type":"string"},"data":{"type":"array","items":{"type":"object","properties":{"object":{"type":"string","enum":["site_submission"]},"id":{"type":"string"},"siteId":{"type":"string"},"name":{"type":"string"},"description":{"type":"string"},"schema":{},"createdAt":{"type":"string"},"updatedAt":{"type":"string"}},"required":["object","id","siteId","name","description","schema","createdAt","updatedAt"],"additionalProperties":false}}},"required":["object","siteId","data"],"additionalProperties":false}}}},"401":{"description":"The bearer credential is missing or not usable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UnauthorizedEncoded"}}}},"402":{"description":"The account does not have Websites.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WebsitesSubscriptionRequiredEncoded"}}}},"403":{"description":"The credential is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ForbiddenEncoded"}}}},"404":{"description":"The requested tenant does not exist.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NotFoundEncoded"}}}}},"description":"Every submission of the site, by name, each whole: its id, name, description, when it was created and last changed, and its schema in canonical form. Not paged: a site has a handful. A site with none answers an empty list.","summary":"List a site's submissions"},"post":{"tags":["Site submissions"],"operationId":"siteSubmissions.createSubmission","parameters":[{"name":"siteId","in":"path","schema":{"type":"string"},"required":true}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"type":"string","enum":["site_submission"]},"id":{"type":"string"},"siteId":{"type":"string"},"name":{"type":"string"},"description":{"type":"string"},"schema":{},"createdAt":{"type":"string"},"updatedAt":{"type":"string"}},"required":["object","id","siteId","name","description","schema","createdAt","updatedAt"],"additionalProperties":false}}}},"401":{"description":"The bearer credential is missing or not usable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UnauthorizedEncoded"}}}},"402":{"description":"The account does not have Websites.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WebsitesSubscriptionRequiredEncoded"}}}},"403":{"description":"The credential is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ForbiddenEncoded"}}}},"404":{"description":"The requested tenant does not exist.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NotFoundEncoded"}}}},"409":{"description":"The site already has a submission or a function by that name.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SiteSubmissionNameTakenEncoded"}}}},"422":{"description":"The submission's name, description or schema cannot be saved.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SiteSubmissionInvalidEncoded"}}}}},"description":"Defines a kind of data the site sends in: a `name` (the camelCase identifier the site's generated code exports it as), a `description` of what it is for, and a `schema` (`{ \"fields\": [...] }`, each field a name, a kind and that kind's options). The schema is checked before anything is saved and stored in its canonical form, which the answer returns. A name, a description or a schema that cannot be saved is refused with 422 (`SiteSubmissionInvalid`), whose `issues` name every problem and where it is. A name one of the site's submissions or functions already has is refused with 409 (`SiteSubmissionNameTaken`): the two share one set of names. A submission takes data as soon as it is created.","summary":"Create a submission","requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"name":{"type":"string","description":"The submission's name: the camelCase identifier the site's generated code exports it as (contactForm, quoteRequest). A lowercase letter, then letters or digits. Unique on the site among its submissions and its functions."},"description":{"type":"string","description":"What the submission is for, in a sentence (\"A contact request from the contact page\"). It is the comment on the generated export, and what tells one submission from another."},"schema":{}},"required":["name","description","schema"],"additionalProperties":false}}},"required":true}}},"/v1/sites/{siteId}/submissions/{name}":{"get":{"tags":["Site submissions"],"operationId":"siteSubmissions.getSubmission","parameters":[{"name":"siteId","in":"path","schema":{"type":"string"},"required":true},{"name":"name","in":"path","schema":{"type":"string"},"required":true}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"type":"string","enum":["site_submission"]},"id":{"type":"string"},"siteId":{"type":"string"},"name":{"type":"string"},"description":{"type":"string"},"schema":{},"createdAt":{"type":"string"},"updatedAt":{"type":"string"}},"required":["object","id","siteId","name","description","schema","createdAt","updatedAt"],"additionalProperties":false}}}},"401":{"description":"The bearer credential is missing or not usable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UnauthorizedEncoded"}}}},"402":{"description":"The account does not have Websites.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WebsitesSubscriptionRequiredEncoded"}}}},"403":{"description":"The credential is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ForbiddenEncoded"}}}},"404":{"description":"The site has no submission by that name. | The requested tenant does not exist.","content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/SiteSubmissionNotFoundEncoded"},{"$ref":"#/components/schemas/NotFoundEncoded"}]}}}}},"description":"The site's submission of that name: its id, name, description, when it was created and last changed, and its schema in canonical form, which may differ in form from the document it was created with. A name the site does not have is refused with 404 (`SiteSubmissionNotFound`); names are exact.","summary":"Get a submission"},"patch":{"tags":["Site submissions"],"operationId":"siteSubmissions.updateSubmission","parameters":[{"name":"siteId","in":"path","schema":{"type":"string"},"required":true},{"name":"name","in":"path","schema":{"type":"string"},"required":true}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"type":"string","enum":["site_submission_update"]},"changed":{"type":"boolean"},"submission":{"type":"object","properties":{"object":{"type":"string","enum":["site_submission"]},"id":{"type":"string"},"siteId":{"type":"string"},"name":{"type":"string"},"description":{"type":"string"},"schema":{},"createdAt":{"type":"string"},"updatedAt":{"type":"string"}},"required":["object","id","siteId","name","description","schema","createdAt","updatedAt"],"additionalProperties":false}},"required":["object","changed","submission"],"additionalProperties":false}}}},"401":{"description":"The bearer credential is missing or not usable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UnauthorizedEncoded"}}}},"402":{"description":"The account does not have Websites.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WebsitesSubscriptionRequiredEncoded"}}}},"403":{"description":"The credential is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ForbiddenEncoded"}}}},"404":{"description":"The site has no submission by that name. | The requested tenant does not exist.","content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/SiteSubmissionNotFoundEncoded"},{"$ref":"#/components/schemas/NotFoundEncoded"}]}}}},"422":{"description":"The submission's name, description or schema cannot be saved.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SiteSubmissionInvalidEncoded"}}}}},"description":"Gives the site's submission of that name a new `description` (what it is for: the site's generated code carries it as the submission's comment). Its name and schema never change: the site's generated code and its entries are built on them. `changed` is false when it already said that, and nothing was written. A description that cannot be saved is refused with 422 (`SiteSubmissionInvalid`, its issue at `description`); a name the site does not have with 404 (`SiteSubmissionNotFound`).","summary":"Update a submission's description","requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"description":{"type":"string","description":"What the submission is for, in a sentence (\"A contact request from the contact page\"). It is the comment on the generated export, and what tells one submission from another."}},"required":["description"],"additionalProperties":false}}},"required":true}},"delete":{"tags":["Site submissions"],"operationId":"siteSubmissions.deleteSubmission","parameters":[{"name":"siteId","in":"path","schema":{"type":"string"},"required":true},{"name":"name","in":"path","schema":{"type":"string"},"required":true},{"name":"force","in":"query","schema":{"type":"string","enum":["true","false"]},"required":false}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"type":"string","enum":["site_submission_deleted"]},"id":{"type":"string"},"siteId":{"type":"string"},"name":{"type":"string"},"entriesDeleted":{"type":"integer"}},"required":["object","id","siteId","name","entriesDeleted"],"additionalProperties":false}}}},"401":{"description":"The bearer credential is missing or not usable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UnauthorizedEncoded"}}}},"402":{"description":"The account does not have Websites.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WebsitesSubscriptionRequiredEncoded"}}}},"403":{"description":"The credential is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ForbiddenEncoded"}}}},"404":{"description":"The site has no submission by that name. | The requested tenant does not exist.","content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/SiteSubmissionNotFoundEncoded"},{"$ref":"#/components/schemas/NotFoundEncoded"}]}}}},"409":{"description":"The submission has entries; deleting it needs force.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SiteSubmissionHasEntriesEncoded"}}}}},"description":"Deletes the site's submission of that name. A submission that has entries is refused with 409 (`SiteSubmissionHasEntries`, with how many there are and when the newest arrived): entries mean the site may still be using it, and deleting it deletes them. Send `force=true` to delete the submission and its entries; `entriesDeleted` in the answer says how many went. Nothing deleted can be brought back. A name the site does not have is refused with 404 (`SiteSubmissionNotFound`). Once deleted, the name can be used again.","summary":"Delete a submission"}},"/v1/sites/{siteId}/submissions/{name}/email":{"get":{"tags":["Site submission emails"],"operationId":"siteSubmissionEmails.getSubmissionEmail","parameters":[{"name":"siteId","in":"path","schema":{"type":"string"},"required":true},{"name":"name","in":"path","schema":{"type":"string"},"required":true}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"type":"string","enum":["site_submission_email"]},"siteId":{"type":"string"},"submission":{"type":"string"},"enabled":{"type":"boolean"},"subject":{"anyOf":[{"type":"string"},{"type":"null"}]},"template":{"anyOf":[{"type":"string","enum":["default","custom"]},{"type":"string"}]},"recipients":{"type":"array","items":{"type":"object","properties":{"email":{"type":"string"},"status":{"anyOf":[{"type":"string","enum":["receiving","opted_out"]},{"type":"string"}]},"optedOutAt":{"anyOf":[{"type":"string"},{"type":"null"}]},"addedAt":{"type":"string"}},"required":["email","status","optedOutAt","addedAt"],"additionalProperties":false}},"suggestions":{"type":"array","items":{"type":"object","properties":{"name":{"anyOf":[{"type":"string"},{"type":"null"}]},"email":{"type":"string"}},"required":["name","email"],"additionalProperties":false}}},"required":["object","siteId","submission","enabled","subject","template","recipients","suggestions"],"additionalProperties":false}}}},"401":{"description":"The bearer credential is missing or not usable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UnauthorizedEncoded"}}}},"402":{"description":"The account does not have Websites.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WebsitesSubscriptionRequiredEncoded"}}}},"403":{"description":"The credential is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ForbiddenEncoded"}}}},"404":{"description":"The site has no submission by that name. | The requested tenant does not exist.","content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/SiteSubmissionNotFoundEncoded"},{"$ref":"#/components/schemas/NotFoundEncoded"}]}}}}},"description":"Whether each entry of the submission is emailed, its subject and layout, every address on its list (each `receiving`, or `opted_out` with when), and the people of the site's business who are not on it (`suggestions`). A submission whose email was never set up answers `enabled: false` with nobody on it. A name the site does not have is refused with 404 (`SiteSubmissionNotFound`).","summary":"Get a submission's email"},"patch":{"tags":["Site submission emails"],"operationId":"siteSubmissionEmails.updateSubmissionEmail","parameters":[{"name":"siteId","in":"path","schema":{"type":"string"},"required":true},{"name":"name","in":"path","schema":{"type":"string"},"required":true}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"type":"string","enum":["site_submission_email"]},"siteId":{"type":"string"},"submission":{"type":"string"},"enabled":{"type":"boolean"},"subject":{"anyOf":[{"type":"string"},{"type":"null"}]},"template":{"anyOf":[{"type":"string","enum":["default","custom"]},{"type":"string"}]},"recipients":{"type":"array","items":{"type":"object","properties":{"email":{"type":"string"},"status":{"anyOf":[{"type":"string","enum":["receiving","opted_out"]},{"type":"string"}]},"optedOutAt":{"anyOf":[{"type":"string"},{"type":"null"}]},"addedAt":{"type":"string"}},"required":["email","status","optedOutAt","addedAt"],"additionalProperties":false}},"suggestions":{"type":"array","items":{"type":"object","properties":{"name":{"anyOf":[{"type":"string"},{"type":"null"}]},"email":{"type":"string"}},"required":["name","email"],"additionalProperties":false}}},"required":["object","siteId","submission","enabled","subject","template","recipients","suggestions"],"additionalProperties":false}}}},"401":{"description":"The bearer credential is missing or not usable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UnauthorizedEncoded"}}}},"402":{"description":"The account does not have Websites.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WebsitesSubscriptionRequiredEncoded"}}}},"403":{"description":"The credential is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ForbiddenEncoded"}}}},"404":{"description":"The site has no submission by that name. | The requested tenant does not exist.","content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/SiteSubmissionNotFoundEncoded"},{"$ref":"#/components/schemas/NotFoundEncoded"}]}}}}},"description":"`enabled: true` emails every new entry to each address on the list that still receives it; `false` stops it and keeps the list. The first call sets the email up; the same value again changes nothing. Answers the email as it now is.","summary":"Turn a submission's email on or off","requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"enabled":{"type":"boolean","description":"true to email each entry to the list, false to stop."}},"required":["enabled"],"additionalProperties":false}}},"required":true}}},"/v1/sites/{siteId}/submissions/{name}/email/recipients":{"post":{"tags":["Site submission emails"],"operationId":"siteSubmissionEmails.addSubmissionEmailRecipient","parameters":[{"name":"siteId","in":"path","schema":{"type":"string"},"required":true},{"name":"name","in":"path","schema":{"type":"string"},"required":true}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"type":"string","enum":["site_submission_email"]},"siteId":{"type":"string"},"submission":{"type":"string"},"enabled":{"type":"boolean"},"subject":{"anyOf":[{"type":"string"},{"type":"null"}]},"template":{"anyOf":[{"type":"string","enum":["default","custom"]},{"type":"string"}]},"recipients":{"type":"array","items":{"type":"object","properties":{"email":{"type":"string"},"status":{"anyOf":[{"type":"string","enum":["receiving","opted_out"]},{"type":"string"}]},"optedOutAt":{"anyOf":[{"type":"string"},{"type":"null"}]},"addedAt":{"type":"string"}},"required":["email","status","optedOutAt","addedAt"],"additionalProperties":false}},"suggestions":{"type":"array","items":{"type":"object","properties":{"name":{"anyOf":[{"type":"string"},{"type":"null"}]},"email":{"type":"string"}},"required":["name","email"],"additionalProperties":false}}},"required":["object","siteId","submission","enabled","subject","template","recipients","suggestions"],"additionalProperties":false}}}},"401":{"description":"The bearer credential is missing or not usable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UnauthorizedEncoded"}}}},"402":{"description":"The account does not have Websites.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WebsitesSubscriptionRequiredEncoded"}}}},"403":{"description":"The credential is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ForbiddenEncoded"}}}},"404":{"description":"The site has no submission by that name. | The requested tenant does not exist.","content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/SiteSubmissionNotFoundEncoded"},{"$ref":"#/components/schemas/NotFoundEncoded"}]}}}},"409":{"description":"The address opted out of this submission's email; only they can opt back in.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SiteSubmissionRecipientOptedOutEncoded"}}}}},"description":"Puts one address on the list, saved in lowercase. An address already on it changes nothing. One that opted out of this submission's email is refused with 409 (`SiteSubmissionRecipientOptedOut`): only they can opt back in, and nothing changes, the email's switch least of all. Adding does not turn the email on unless `enable` is true, which turns it on in the same step. Answers the email as it now is.","summary":"Add an address to a submission's email","requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"email":{"type":"string","pattern":"^[^\\s@/]+@[^\\s@/]+\\.[^\\s@/]+$","maxLength":254,"description":"The email address, as name@example.com. Saved in lowercase."},"enable":{"type":"boolean","description":"Also turn the email on, in the same step. Without it, adding an address leaves the email as it is."}},"required":["email"],"additionalProperties":false}}},"required":true}}},"/v1/sites/{siteId}/submissions/{name}/email/recipients/{email}":{"delete":{"tags":["Site submission emails"],"operationId":"siteSubmissionEmails.removeSubmissionEmailRecipient","parameters":[{"name":"siteId","in":"path","schema":{"type":"string"},"required":true},{"name":"name","in":"path","schema":{"type":"string"},"required":true},{"name":"email","in":"path","schema":{"type":"string"},"required":true}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"type":"string","enum":["site_submission_email"]},"siteId":{"type":"string"},"submission":{"type":"string"},"enabled":{"type":"boolean"},"subject":{"anyOf":[{"type":"string"},{"type":"null"}]},"template":{"anyOf":[{"type":"string","enum":["default","custom"]},{"type":"string"}]},"recipients":{"type":"array","items":{"type":"object","properties":{"email":{"type":"string"},"status":{"anyOf":[{"type":"string","enum":["receiving","opted_out"]},{"type":"string"}]},"optedOutAt":{"anyOf":[{"type":"string"},{"type":"null"}]},"addedAt":{"type":"string"}},"required":["email","status","optedOutAt","addedAt"],"additionalProperties":false}},"suggestions":{"type":"array","items":{"type":"object","properties":{"name":{"anyOf":[{"type":"string"},{"type":"null"}]},"email":{"type":"string"}},"required":["name","email"],"additionalProperties":false}}},"required":["object","siteId","submission","enabled","subject","template","recipients","suggestions"],"additionalProperties":false}}}},"401":{"description":"The bearer credential is missing or not usable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UnauthorizedEncoded"}}}},"402":{"description":"The account does not have Websites.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WebsitesSubscriptionRequiredEncoded"}}}},"403":{"description":"The credential is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ForbiddenEncoded"}}}},"404":{"description":"The site has no submission by that name. | The address is not on the list of this submission's email. | The requested tenant does not exist.","content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/SiteSubmissionNotFoundEncoded"},{"$ref":"#/components/schemas/SiteSubmissionRecipientNotFoundEncoded"},{"$ref":"#/components/schemas/NotFoundEncoded"}]}}}},"409":{"description":"The address opted out of this submission's email; only they can opt back in.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SiteSubmissionRecipientOptedOutEncoded"}}}}},"description":"Takes one address off the list (percent-encoded in the path; matched in lowercase). One not on the list is refused with 404 (`SiteSubmissionRecipientNotFound`). One that opted out is refused with 409 (`SiteSubmissionRecipientOptedOut`): it stays listed as opted out, so it can never be added back over the person's choice. Answers the email as it now is.","summary":"Remove an address from a submission's email"}},"/v1/sites/{siteId}/submissions/{name}/email/template":{"get":{"tags":["Site submission emails"],"operationId":"siteSubmissionEmails.getSubmissionEmailTemplate","parameters":[{"name":"siteId","in":"path","schema":{"type":"string"},"required":true},{"name":"name","in":"path","schema":{"type":"string"},"required":true}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"type":"string","enum":["site_submission_email_template"]},"siteId":{"type":"string"},"submission":{"type":"string"},"source":{"anyOf":[{"type":"string","enum":["default","custom"]},{"type":"string"}]},"body":{"type":"string"},"subject":{"type":"string"},"sha256":{"anyOf":[{"type":"string"},{"type":"null"}]},"fields":{"type":"array","items":{"type":"object","properties":{"path":{"type":"string"},"kind":{"anyOf":[{"type":"string","enum":["text","email","phone","object","list"]},{"type":"string"}]},"optional":{"type":"boolean"},"label":{"anyOf":[{"type":"string"},{"type":"null"}]},"multiline":{"type":"boolean"},"list":{"anyOf":[{"type":"object","properties":{"min":{"type":"integer"},"max":{"type":"integer"},"of":{"type":"string"}},"required":["min","max","of"],"additionalProperties":false},{"type":"null"}]}},"required":["path","kind","optional","label","multiline","list"],"additionalProperties":false}},"allowed":{"type":"object","properties":{"tags":{"type":"array","items":{"type":"string"}},"filters":{"type":"array","items":{"type":"string"}}},"required":["tags","filters"],"additionalProperties":false},"timeZone":{"type":"string"}},"required":["object","siteId","submission","source","body","subject","sha256","fields","allowed","timeZone"],"additionalProperties":false}}}},"401":{"description":"The bearer credential is missing or not usable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UnauthorizedEncoded"}}}},"402":{"description":"The account does not have Websites.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WebsitesSubscriptionRequiredEncoded"}}}},"403":{"description":"The credential is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ForbiddenEncoded"}}}},"404":{"description":"The site has no submission by that name. | The requested tenant does not exist.","content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/SiteSubmissionNotFoundEncoded"},{"$ref":"#/components/schemas/NotFoundEncoded"}]}}}}},"description":"The template its emails use, as Liquid source (`body`, `subject`): the one pushed for it (`source: custom`), or ours, generated from the submission's schema (`source: default`). `fields` lists every field a template can use, which are optional, and every list's bounds.","summary":"Get a submission's email template"},"put":{"tags":["Site submission emails"],"operationId":"siteSubmissionEmails.putSubmissionEmailTemplate","parameters":[{"name":"siteId","in":"path","schema":{"type":"string"},"required":true},{"name":"name","in":"path","schema":{"type":"string"},"required":true}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"type":"string","enum":["site_submission_email"]},"siteId":{"type":"string"},"submission":{"type":"string"},"enabled":{"type":"boolean"},"subject":{"anyOf":[{"type":"string"},{"type":"null"}]},"template":{"anyOf":[{"type":"string","enum":["default","custom"]},{"type":"string"}]},"recipients":{"type":"array","items":{"type":"object","properties":{"email":{"type":"string"},"status":{"anyOf":[{"type":"string","enum":["receiving","opted_out"]},{"type":"string"}]},"optedOutAt":{"anyOf":[{"type":"string"},{"type":"null"}]},"addedAt":{"type":"string"}},"required":["email","status","optedOutAt","addedAt"],"additionalProperties":false}},"suggestions":{"type":"array","items":{"type":"object","properties":{"name":{"anyOf":[{"type":"string"},{"type":"null"}]},"email":{"type":"string"}},"required":["name","email"],"additionalProperties":false}}},"required":["object","siteId","submission","enabled","subject","template","recipients","suggestions"],"additionalProperties":false}}}},"401":{"description":"The bearer credential is missing or not usable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UnauthorizedEncoded"}}}},"402":{"description":"The account does not have Websites.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WebsitesSubscriptionRequiredEncoded"}}}},"403":{"description":"The credential is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ForbiddenEncoded"}}}},"404":{"description":"The site has no submission by that name. | The requested tenant does not exist.","content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/SiteSubmissionNotFoundEncoded"},{"$ref":"#/components/schemas/NotFoundEncoded"}]}}}},"422":{"description":"The template cannot be saved; every problem is listed.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SiteSubmissionEmailTemplateInvalidEncoded"}}}}},"description":"Checks the template exactly as a preview does, then saves it: every email of the submission uses it from then on. A template with any problem is refused with 422 (`SiteSubmissionEmailTemplateInvalid`, every problem listed) and nothing is saved. Saving does not turn the email on. Answers the email as it now is.","summary":"Save a submission's email template","requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"body":{"type":"string","description":"The body, as Liquid source."},"subject":{"type":"string","description":"The subject, as Liquid source: one line of text."}},"required":["body","subject"],"additionalProperties":false}}},"required":true}},"delete":{"tags":["Site submission emails"],"operationId":"siteSubmissionEmails.resetSubmissionEmailTemplate","parameters":[{"name":"siteId","in":"path","schema":{"type":"string"},"required":true},{"name":"name","in":"path","schema":{"type":"string"},"required":true}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"type":"string","enum":["site_submission_email"]},"siteId":{"type":"string"},"submission":{"type":"string"},"enabled":{"type":"boolean"},"subject":{"anyOf":[{"type":"string"},{"type":"null"}]},"template":{"anyOf":[{"type":"string","enum":["default","custom"]},{"type":"string"}]},"recipients":{"type":"array","items":{"type":"object","properties":{"email":{"type":"string"},"status":{"anyOf":[{"type":"string","enum":["receiving","opted_out"]},{"type":"string"}]},"optedOutAt":{"anyOf":[{"type":"string"},{"type":"null"}]},"addedAt":{"type":"string"}},"required":["email","status","optedOutAt","addedAt"],"additionalProperties":false}},"suggestions":{"type":"array","items":{"type":"object","properties":{"name":{"anyOf":[{"type":"string"},{"type":"null"}]},"email":{"type":"string"}},"required":["name","email"],"additionalProperties":false}}},"required":["object","siteId","submission","enabled","subject","template","recipients","suggestions"],"additionalProperties":false}}}},"401":{"description":"The bearer credential is missing or not usable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UnauthorizedEncoded"}}}},"402":{"description":"The account does not have Websites.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WebsitesSubscriptionRequiredEncoded"}}}},"403":{"description":"The credential is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ForbiddenEncoded"}}}},"404":{"description":"The site has no submission by that name. | The requested tenant does not exist.","content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/SiteSubmissionNotFoundEncoded"},{"$ref":"#/components/schemas/NotFoundEncoded"}]}}}}},"description":"Back to our template and subject, generated from the submission's schema. Answers the email as it now is.","summary":"Reset a submission's email template"}},"/v1/sites/{siteId}/submissions/{name}/email/template/preview":{"post":{"tags":["Site submission emails"],"operationId":"siteSubmissionEmails.previewSubmissionEmailTemplate","parameters":[{"name":"siteId","in":"path","schema":{"type":"string"},"required":true},{"name":"name","in":"path","schema":{"type":"string"},"required":true}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"anyOf":[{"type":"object","properties":{"object":{"type":"string","enum":["site_submission_email_template_preview"]},"ok":{"type":"boolean","enum":[true]},"html":{"type":"string"},"subject":{"type":"string"},"sample":{}},"required":["object","ok","html","subject","sample"],"additionalProperties":false},{"type":"object","properties":{"object":{"type":"string","enum":["site_submission_email_template_preview"]},"ok":{"type":"boolean","enum":[false]},"issues":{"type":"array","items":{"type":"object","properties":{"part":{"anyOf":[{"type":"string","enum":["body","subject","sample"]},{"type":"string"}]},"line":{"type":"integer"},"column":{"type":"integer"},"message":{"type":"string"}},"required":["part","line","column","message"],"additionalProperties":false}}},"required":["object","ok","issues"],"additionalProperties":false}]}}}},"401":{"description":"The bearer credential is missing or not usable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UnauthorizedEncoded"}}}},"402":{"description":"The account does not have Websites.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WebsitesSubscriptionRequiredEncoded"}}}},"403":{"description":"The credential is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ForbiddenEncoded"}}}},"404":{"description":"The site has no submission by that name. | The requested tenant does not exist.","content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/SiteSubmissionNotFoundEncoded"},{"$ref":"#/components/schemas/NotFoundEncoded"}]}}}}},"description":"Checks a template against the submission's schema and renders it, with `sample` (checked against the schema first) or a generated entry, and once more with only the required fields. Always 200: `ok: true` with the email as it is sent (`html`, opt-out footer to a stand-in address, and `subject`), or `ok: false` with every problem's part, line and column. Nothing is saved.","summary":"Preview a submission's email template","requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"body":{"type":"string","description":"The body, as Liquid source."},"subject":{"type":"string","description":"The subject, as Liquid source: one line of text."},"sample":{}},"required":["body","subject"],"additionalProperties":false}}},"required":true}}},"/v1/sites/{siteId}/submissions/{name}/text/recipients":{"post":{"tags":["Site submission texts"],"operationId":"siteSubmissionTexts.addSubmissionTextRecipient","parameters":[{"name":"siteId","in":"path","schema":{"type":"string"},"required":true},{"name":"name","in":"path","schema":{"type":"string"},"required":true}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"type":"string","enum":["site_submission_text"]},"siteId":{"type":"string"},"submission":{"type":"string"},"sender":{"anyOf":[{"type":"object","properties":{"object":{"type":"string","enum":["site_text_sender"]},"id":{"type":"string"},"number":{"type":"string"},"label":{"anyOf":[{"type":"string"},{"type":"null"}]},"provider":{"type":"string"},"health":{"type":"string"},"reach":{"anyOf":[{"type":"string","enum":["business","organization","account"]},{"type":"string"}]},"reachName":{"anyOf":[{"type":"string"},{"type":"null"}]},"eligible":{"type":"boolean"},"problem":{"anyOf":[{"anyOf":[{"type":"string","enum":["no_such_sender","not_a_phone","not_active","outside_scope","another_business"]},{"type":"string"}]},{"type":"null"}]}},"required":["object","id","number","label","provider","health","reach","reachName","eligible","problem"],"additionalProperties":false},{"type":"null"}]},"recipients":{"type":"array","items":{"type":"object","properties":{"phone":{"type":"string"},"addedAt":{"type":"string"}},"required":["phone","addedAt"],"additionalProperties":false}}},"required":["object","siteId","submission","sender","recipients"],"additionalProperties":false}}}},"401":{"description":"The bearer credential is missing or not usable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UnauthorizedEncoded"}}}},"402":{"description":"The account does not have Websites.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WebsitesSubscriptionRequiredEncoded"}}}},"403":{"description":"The credential is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ForbiddenEncoded"}}}},"404":{"description":"The site has no submission by that name. | The requested tenant does not exist.","content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/SiteSubmissionNotFoundEncoded"},{"$ref":"#/components/schemas/NotFoundEncoded"}]}}}},"422":{"description":"The number cannot be read as a phone number.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SiteSubmissionTextRecipientInvalidEncoded"}}}}},"description":"Puts one number on the list, saved in E.164 (a number given with its country code, or as a US number). A number already on it changes nothing. One that cannot be read as a phone number is refused with 422 (`SiteSubmissionTextRecipientInvalid`) and nothing is added. Texts go out only while the site has a number to text from (`sender` in the answer); the list is kept either way. Answers the submission's texts as they now are.","summary":"Text a number about a submission's entries","requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"phone":{"type":"string","minLength":1,"description":"The phone number, with its country code as +18015550123; a US number may be given as (801) 555-0123. Saved in E.164."}},"required":["phone"],"additionalProperties":false}}},"required":true}}},"/v1/sites/{siteId}/submissions/{name}/text/recipients/{phone}":{"delete":{"tags":["Site submission texts"],"operationId":"siteSubmissionTexts.removeSubmissionTextRecipient","parameters":[{"name":"siteId","in":"path","schema":{"type":"string"},"required":true},{"name":"name","in":"path","schema":{"type":"string"},"required":true},{"name":"phone","in":"path","schema":{"type":"string"},"required":true}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"type":"string","enum":["site_submission_text"]},"siteId":{"type":"string"},"submission":{"type":"string"},"sender":{"anyOf":[{"type":"object","properties":{"object":{"type":"string","enum":["site_text_sender"]},"id":{"type":"string"},"number":{"type":"string"},"label":{"anyOf":[{"type":"string"},{"type":"null"}]},"provider":{"type":"string"},"health":{"type":"string"},"reach":{"anyOf":[{"type":"string","enum":["business","organization","account"]},{"type":"string"}]},"reachName":{"anyOf":[{"type":"string"},{"type":"null"}]},"eligible":{"type":"boolean"},"problem":{"anyOf":[{"anyOf":[{"type":"string","enum":["no_such_sender","not_a_phone","not_active","outside_scope","another_business"]},{"type":"string"}]},{"type":"null"}]}},"required":["object","id","number","label","provider","health","reach","reachName","eligible","problem"],"additionalProperties":false},{"type":"null"}]},"recipients":{"type":"array","items":{"type":"object","properties":{"phone":{"type":"string"},"addedAt":{"type":"string"}},"required":["phone","addedAt"],"additionalProperties":false}}},"required":["object","siteId","submission","sender","recipients"],"additionalProperties":false}}}},"401":{"description":"The bearer credential is missing or not usable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UnauthorizedEncoded"}}}},"402":{"description":"The account does not have Websites.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WebsitesSubscriptionRequiredEncoded"}}}},"403":{"description":"The credential is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ForbiddenEncoded"}}}},"404":{"description":"The site has no submission by that name. | The number is not on the list of this submission's texts. | The requested tenant does not exist.","content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/SiteSubmissionNotFoundEncoded"},{"$ref":"#/components/schemas/SiteSubmissionTextRecipientNotFoundEncoded"},{"$ref":"#/components/schemas/NotFoundEncoded"}]}}}}},"description":"Takes one number off the list (percent-encoded in the path; matched in E.164 when it can be read). One not on the list is refused with 404 (`SiteSubmissionTextRecipientNotFound`). Answers the submission's texts as they now are.","summary":"Stop texting a number about a submission's entries"}},"/v1/account/feedback":{"post":{"tags":["Feedback"],"operationId":"feedback.createFeedback","parameters":[],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"type":"string","enum":["agent_feedback"]},"id":{"type":"string"},"category":{"anyOf":[{"type":"string","enum":["bug","confusing","missing","other"]},{"type":"string"}]},"capability":{"anyOf":[{"type":"string"},{"type":"null"}]},"message":{"type":"string"},"status":{"anyOf":[{"type":"string","enum":["new","reviewed","addressed","ignored"]},{"type":"string"}]},"createdAt":{"type":"string"}},"required":["object","id","category","capability","message","status","createdAt"],"additionalProperties":false}}}},"401":{"description":"The bearer credential is missing or not usable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UnauthorizedEncoded"}}}},"403":{"description":"The credential is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ForbiddenEncoded"}}}},"404":{"description":"The requested tenant does not exist.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NotFoundEncoded"}}}}},"description":"Records what an agent ran into while using the CLI or the MCP server: a category, a message, and the tool or command it is about when there is one. The feedback goes to the people building Heysegment; it changes nothing in the account and is not shown to it. A `capability` that names nothing we offer is kept as none.","summary":"Record feedback on the agent experience","requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"category":{"type":"string","enum":["bug","confusing","missing","other"],"description":"What kind of thing it was: `bug` (it did not do what it said), `confusing` (it did, but the words, the answer or the flow made that hard to tell), `missing` (something you needed and there was no way to do), `other`."},"message":{"type":"string","minLength":1,"maxLength":4000,"description":"What happened, in your words, up to 4000 characters: what you were trying to do, the call you made, what came back, and what would have helped. Specific beats short."},"capability":{"type":"string","maxLength":120,"description":"The tool or command it is about, by its name as the tools list or `--help` shows it (`sites_push`, `mutation_groups_approve`). Leave it out when it is about the experience as a whole."}},"required":["category","message"],"additionalProperties":false}}},"required":true}}},"/v1/sites/{siteId}/functions":{"post":{"tags":["Site functions"],"operationId":"siteFunctions.createFunction","parameters":[{"name":"siteId","in":"path","schema":{"type":"string"},"required":true}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"type":"string","enum":["site_function_created"]},"function":{"type":"object","properties":{"object":{"type":"string","enum":["site_function"]},"id":{"type":"string"},"siteId":{"type":"string"},"name":{"type":"string"},"description":{"type":"string"},"input":{},"output":{},"status":{"anyOf":[{"type":"string","enum":["draft","live"]},{"type":"string"}]},"upload":{"anyOf":[{"type":"object","properties":{"codeSha256":{"type":"string"},"codeBytes":{"type":"integer"},"sourceSha256":{"type":"string"},"sourceBytes":{"type":"integer"},"uploadedAt":{"type":"string"}},"required":["codeSha256","codeBytes","sourceSha256","sourceBytes","uploadedAt"],"additionalProperties":false},{"type":"null"}]},"secrets":{"type":"array","items":{"type":"string"}},"lastCalledAt":{"anyOf":[{"type":"string"},{"type":"null"}]},"createdAt":{"type":"string"},"updatedAt":{"type":"string"}},"required":["object","id","siteId","name","description","input","output","status","upload","secrets","lastCalledAt","createdAt","updatedAt"],"additionalProperties":false},"project":{"type":"object","properties":{"packageJson":{"type":"string"},"tsconfig":{"type":"string"},"contract":{"type":"string"},"handler":{"type":"string"}},"required":["packageJson","tsconfig","contract","handler"],"additionalProperties":false}},"required":["object","function","project"],"additionalProperties":false}}}},"401":{"description":"The bearer credential is missing or not usable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UnauthorizedEncoded"}}}},"402":{"description":"The account does not have Websites.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WebsitesSubscriptionRequiredEncoded"}}}},"403":{"description":"The credential is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ForbiddenEncoded"}}}},"404":{"description":"The requested tenant does not exist.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NotFoundEncoded"}}}},"409":{"description":"The site already has a function or a submission by that name. | The site has no secret by one of the names the function was to be given.","content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/SiteFunctionNameTakenEncoded"},{"$ref":"#/components/schemas/SiteFunctionUnknownSecretsEncoded"}]}}}},"422":{"description":"The function's name, description or a schema cannot be saved.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SiteFunctionInvalidEncoded"}}}}},"description":"Defines a backend function of the site: a `name` (the camelCase identifier the site's generated code exports it as), a `description` of what it does, and two schemas (`{ \"fields\": [...] }`): `input`, what the handler is given, and `output`, what it must answer. Both are checked before anything is saved and stored in their canonical form, which the answer returns. A name, a description or a schema that cannot be saved is refused with 422 (`SiteFunctionInvalid`), whose `issues` name every problem and where it is. A name one of the site's functions or submissions already has is refused with 409 (`SiteFunctionNameTaken`): the two share one set of names. `secrets` names the site's secrets the function is given (its handler's `Env`); one the site has no value for is refused with 409 (`SiteFunctionUnknownSecrets`). The function is created as a `draft` with no code. `project` is what its handler project starts from, as source text: `contract` (generated from the two schemas; regenerate it rather than edit it), `handler`, `packageJson` and `tsconfig`.","summary":"Create a function","requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"name":{"type":"string","description":"The function's name: the camelCase identifier the site's generated code exports it as (checkAvailability, requestQuote). A lowercase letter, then letters or digits. Unique on the site among its submissions and its functions."},"description":{"type":"string","description":"What the function does, in a sentence (\"Says which appointment times are free on a day\"). It is the comment on the generated export, and what tells one function from another."},"input":{},"output":{},"secrets":{"type":"array","items":{"type":"string"},"description":"The names of the site's secrets the function is given: the properties of its handler's `Env`. Each must be a secret the site already has a value for. The whole set: a name left out is no longer given."}},"required":["name","description","input","output"],"additionalProperties":false}}},"required":true}},"get":{"tags":["Site functions"],"operationId":"siteFunctions.listFunctions","parameters":[{"name":"siteId","in":"path","schema":{"type":"string"},"required":true}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"type":"string","enum":["site_function_list"]},"siteId":{"type":"string"},"data":{"type":"array","items":{"type":"object","properties":{"object":{"type":"string","enum":["site_function"]},"id":{"type":"string"},"siteId":{"type":"string"},"name":{"type":"string"},"description":{"type":"string"},"input":{},"output":{},"status":{"anyOf":[{"type":"string","enum":["draft","live"]},{"type":"string"}]},"upload":{"anyOf":[{"type":"object","properties":{"codeSha256":{"type":"string"},"codeBytes":{"type":"integer"},"sourceSha256":{"type":"string"},"sourceBytes":{"type":"integer"},"uploadedAt":{"type":"string"}},"required":["codeSha256","codeBytes","sourceSha256","sourceBytes","uploadedAt"],"additionalProperties":false},{"type":"null"}]},"secrets":{"type":"array","items":{"type":"string"}},"lastCalledAt":{"anyOf":[{"type":"string"},{"type":"null"}]},"createdAt":{"type":"string"},"updatedAt":{"type":"string"}},"required":["object","id","siteId","name","description","input","output","status","upload","secrets","lastCalledAt","createdAt","updatedAt"],"additionalProperties":false}}},"required":["object","siteId","data"],"additionalProperties":false}}}},"401":{"description":"The bearer credential is missing or not usable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UnauthorizedEncoded"}}}},"402":{"description":"The account does not have Websites.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WebsitesSubscriptionRequiredEncoded"}}}},"403":{"description":"The credential is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ForbiddenEncoded"}}}},"404":{"description":"The requested tenant does not exist.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NotFoundEncoded"}}}}},"description":"Every backend function of the site, by name, each whole: its two schemas, its `status` (`draft` or `live`), the `upload` it holds (null when it holds no code) and `lastCalledAt`, the last time the site itself called it. A site has few, so the list is whole, never paged. A site with a `draft` cannot be pushed.","summary":"List a site's functions"}},"/v1/sites/{siteId}/functions/{functionId}":{"patch":{"tags":["Site functions"],"operationId":"siteFunctions.updateFunction","parameters":[{"name":"siteId","in":"path","schema":{"type":"string"},"required":true},{"name":"functionId","in":"path","schema":{"type":"string"},"required":true}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"type":"string","enum":["site_function_updated"]},"function":{"type":"object","properties":{"object":{"type":"string","enum":["site_function"]},"id":{"type":"string"},"siteId":{"type":"string"},"name":{"type":"string"},"description":{"type":"string"},"input":{},"output":{},"status":{"anyOf":[{"type":"string","enum":["draft","live"]},{"type":"string"}]},"upload":{"anyOf":[{"type":"object","properties":{"codeSha256":{"type":"string"},"codeBytes":{"type":"integer"},"sourceSha256":{"type":"string"},"sourceBytes":{"type":"integer"},"uploadedAt":{"type":"string"}},"required":["codeSha256","codeBytes","sourceSha256","sourceBytes","uploadedAt"],"additionalProperties":false},{"type":"null"}]},"secrets":{"type":"array","items":{"type":"string"}},"lastCalledAt":{"anyOf":[{"type":"string"},{"type":"null"}]},"createdAt":{"type":"string"},"updatedAt":{"type":"string"}},"required":["object","id","siteId","name","description","input","output","status","upload","secrets","lastCalledAt","createdAt","updatedAt"],"additionalProperties":false},"uploadRemoved":{"type":"boolean"},"contract":{"type":"string"}},"required":["object","function","uploadRemoved","contract"],"additionalProperties":false}}}},"401":{"description":"The bearer credential is missing or not usable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UnauthorizedEncoded"}}}},"402":{"description":"The account does not have Websites.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WebsitesSubscriptionRequiredEncoded"}}}},"403":{"description":"The credential is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ForbiddenEncoded"}}}},"404":{"description":"The site has no function by that id. | The requested tenant does not exist.","content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/SiteFunctionNotFoundEncoded"},{"$ref":"#/components/schemas/NotFoundEncoded"}]}}}},"409":{"description":"The site already has a function or a submission by that name. | The function is not a draft; its code cannot be replaced. | The function changed while this was going on; nothing was changed. | The site has no secret by one of the names the function was to be given.","content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/SiteFunctionNameTakenEncoded"},{"$ref":"#/components/schemas/SiteFunctionNotDraftEncoded"},{"$ref":"#/components/schemas/SiteFunctionChangedEncoded"},{"$ref":"#/components/schemas/SiteFunctionUnknownSecretsEncoded"}]}}}},"422":{"description":"The function's name, description or a schema cannot be saved.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SiteFunctionInvalidEncoded"}}}}},"description":"Changes a draft's definition: any of `name`, `description`, `input`, `output` and `secrets` (the names of the site's secrets it is given, the whole set); a member left out stays as it is, and a body that names none changes nothing. What is given is checked as a create checks it (422 `SiteFunctionInvalid`, every problem named; 409 `SiteFunctionNameTaken`; 409 `SiteFunctionUnknownSecrets` for a secret the site has no value for). When a schema or the set of secrets CHANGES, the function's upload is removed with its stored objects, and `uploadRemoved` says so: that code was checked against the old contract (`Input`, `Output`, `Env`). A schema or a set sent as it already is changes nothing and keeps the upload, as a change of name or description does. The answer is the function as it is now and its `contract` as it is now. A published function is refused with 409 (`SiteFunctionNotDraft`): nothing about it changes. A function another request changed while this one was being carried out is refused with 409 (`SiteFunctionChanged`): send it again.","summary":"Update a draft function","requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"name":{"type":"string","description":"The function's name: the camelCase identifier the site's generated code exports it as (checkAvailability, requestQuote). A lowercase letter, then letters or digits. Unique on the site among its submissions and its functions."},"description":{"type":"string","description":"What the function does, in a sentence (\"Says which appointment times are free on a day\"). It is the comment on the generated export, and what tells one function from another."},"input":{},"output":{},"secrets":{"type":"array","items":{"type":"string"},"description":"The names of the site's secrets the function is given: the properties of its handler's `Env`. Each must be a secret the site already has a value for. The whole set: a name left out is no longer given."}},"additionalProperties":false}}},"required":true}},"delete":{"tags":["Site functions"],"operationId":"siteFunctions.deleteFunction","parameters":[{"name":"siteId","in":"path","schema":{"type":"string"},"required":true},{"name":"functionId","in":"path","schema":{"type":"string"},"required":true},{"name":"force","in":"query","schema":{"type":"string","enum":["true","false"]},"required":false}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"type":"string","enum":["site_function_deleted"]},"id":{"type":"string"},"siteId":{"type":"string"},"name":{"type":"string"},"status":{"anyOf":[{"type":"string","enum":["draft","live"]},{"type":"string"}]}},"required":["object","id","siteId","name","status"],"additionalProperties":false}}}},"401":{"description":"The bearer credential is missing or not usable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UnauthorizedEncoded"}}}},"402":{"description":"The account does not have Websites.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WebsitesSubscriptionRequiredEncoded"}}}},"403":{"description":"The credential is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ForbiddenEncoded"}}}},"404":{"description":"The site has no function by that id. | The requested tenant does not exist.","content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/SiteFunctionNotFoundEncoded"},{"$ref":"#/components/schemas/NotFoundEncoded"}]}}}},"409":{"description":"The function is published; delete with force to delete it anyway.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SiteFunctionLiveEncoded"}}}}},"description":"Deletes the function: its definition, its upload and the three stored objects. Its name can be used again. Nothing deleted can be brought back. A draft is deleted as asked. A `live` function is refused with 409 (`SiteFunctionLive`, with `lastCalledAt`: the last time the site called it), because the site may still be calling it and every call to a deleted function fails; send `force=true` to delete it anyway. The answer says what the function was.","summary":"Delete a function"}},"/v1/sites/{siteId}/functions/{functionId}/publish":{"post":{"tags":["Site functions"],"operationId":"siteFunctions.publishFunction","parameters":[{"name":"siteId","in":"path","schema":{"type":"string"},"required":true},{"name":"functionId","in":"path","schema":{"type":"string"},"required":true}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"type":"string","enum":["site_function_published"]},"function":{"type":"object","properties":{"object":{"type":"string","enum":["site_function"]},"id":{"type":"string"},"siteId":{"type":"string"},"name":{"type":"string"},"description":{"type":"string"},"input":{},"output":{},"status":{"anyOf":[{"type":"string","enum":["draft","live"]},{"type":"string"}]},"upload":{"anyOf":[{"type":"object","properties":{"codeSha256":{"type":"string"},"codeBytes":{"type":"integer"},"sourceSha256":{"type":"string"},"sourceBytes":{"type":"integer"},"uploadedAt":{"type":"string"}},"required":["codeSha256","codeBytes","sourceSha256","sourceBytes","uploadedAt"],"additionalProperties":false},{"type":"null"}]},"secrets":{"type":"array","items":{"type":"string"}},"lastCalledAt":{"anyOf":[{"type":"string"},{"type":"null"}]},"createdAt":{"type":"string"},"updatedAt":{"type":"string"}},"required":["object","id","siteId","name","description","input","output","status","upload","secrets","lastCalledAt","createdAt","updatedAt"],"additionalProperties":false},"alreadyPublished":{"type":"boolean"}},"required":["object","function","alreadyPublished"],"additionalProperties":false}}}},"401":{"description":"The bearer credential is missing or not usable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UnauthorizedEncoded"}}}},"402":{"description":"The account does not have Websites.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WebsitesSubscriptionRequiredEncoded"}}}},"403":{"description":"The credential is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ForbiddenEncoded"}}}},"404":{"description":"The site has no function by that id. | The requested tenant does not exist.","content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/SiteFunctionNotFoundEncoded"},{"$ref":"#/components/schemas/NotFoundEncoded"}]}}}},"409":{"description":"The function has no code yet: it has never been pushed. | The declared upload is not in storage. | The function changed while this was going on; nothing was changed.","content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/SiteFunctionNotPushedEncoded"},{"$ref":"#/components/schemas/SiteFunctionUploadIncompleteEncoded"},{"$ref":"#/components/schemas/SiteFunctionChangedEncoded"}]}}}}},"description":"Makes a draft `live`, with exactly the upload it holds. It is FINAL: a live function's definition and code never change, and it cannot be made a draft again. The function must hold an upload (409 `SiteFunctionNotPushed` otherwise); it need not have been invoked. Its bundle is looked at in storage first, and a function whose stored bundle is not the one recorded is not published (409 `SiteFunctionUploadIncomplete`): upload it again. Publishing a function that is already live answers 200 with `alreadyPublished: true`, and changes nothing. A function another request changed while this one was being carried out is refused with 409 (`SiteFunctionChanged`).","summary":"Publish a function"}},"/v1/sites/{siteId}/functions/{functionId}/source":{"get":{"tags":["Site functions"],"operationId":"siteFunctions.getFunctionSource","parameters":[{"name":"siteId","in":"path","schema":{"type":"string"},"required":true},{"name":"functionId","in":"path","schema":{"type":"string"},"required":true}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"type":"string","enum":["site_function_source"]},"function":{"type":"object","properties":{"object":{"type":"string","enum":["site_function"]},"id":{"type":"string"},"siteId":{"type":"string"},"name":{"type":"string"},"description":{"type":"string"},"input":{},"output":{},"status":{"anyOf":[{"type":"string","enum":["draft","live"]},{"type":"string"}]},"upload":{"anyOf":[{"type":"object","properties":{"codeSha256":{"type":"string"},"codeBytes":{"type":"integer"},"sourceSha256":{"type":"string"},"sourceBytes":{"type":"integer"},"uploadedAt":{"type":"string"}},"required":["codeSha256","codeBytes","sourceSha256","sourceBytes","uploadedAt"],"additionalProperties":false},{"type":"null"}]},"secrets":{"type":"array","items":{"type":"string"}},"lastCalledAt":{"anyOf":[{"type":"string"},{"type":"null"}]},"createdAt":{"type":"string"},"updatedAt":{"type":"string"}},"required":["object","id","siteId","name","description","input","output","status","upload","secrets","lastCalledAt","createdAt","updatedAt"],"additionalProperties":false},"archive":{"anyOf":[{"type":"object","properties":{"url":{"type":"string"},"sha256":{"type":"string"},"bytes":{"type":"integer"},"expiresAt":{"type":"string"}},"required":["url","sha256","bytes","expiresAt"],"additionalProperties":false},{"type":"null"}]},"starter":{"anyOf":[{"type":"object","properties":{"packageJson":{"type":"string"},"tsconfig":{"type":"string"},"contract":{"type":"string"},"handler":{"type":"string"}},"required":["packageJson","tsconfig","contract","handler"],"additionalProperties":false},{"type":"null"}]},"contract":{"type":"string"}},"required":["object","function","archive","starter","contract"],"additionalProperties":false}}}},"401":{"description":"The bearer credential is missing or not usable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UnauthorizedEncoded"}}}},"402":{"description":"The account does not have Websites.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WebsitesSubscriptionRequiredEncoded"}}}},"403":{"description":"The credential is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ForbiddenEncoded"}}}},"404":{"description":"The site has no function by that id. | The requested tenant does not exist.","content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/SiteFunctionNotFoundEncoded"},{"$ref":"#/components/schemas/NotFoundEncoded"}]}}}}},"description":"Where the function's source is, as the platform holds it. For a function that holds an upload, `archive` is a link to the source archive of that upload (a `.tar.gz` of the handler project), signed for that one object for a few minutes, with its `sha256` and `bytes` to check the download against; `starter` is null. For a function that holds none, `starter` is the project it starts from, generated now, and `archive` is null. `function` is the function, whole, and `contract` is `src/contract.ts` as its definition is NOW, which may be newer than the one in the archive.","summary":"Get a function's source"}},"/v1/sites/{siteId}/functions/{functionId}/contract":{"get":{"tags":["Site functions"],"operationId":"siteFunctions.getFunctionContract","parameters":[{"name":"siteId","in":"path","schema":{"type":"string"},"required":true},{"name":"functionId","in":"path","schema":{"type":"string"},"required":true}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"type":"string","enum":["site_function_contract"]},"siteId":{"type":"string"},"functionId":{"type":"string"},"name":{"type":"string"},"status":{"anyOf":[{"type":"string","enum":["draft","live"]},{"type":"string"}]},"contract":{"type":"string"}},"required":["object","siteId","functionId","name","status","contract"],"additionalProperties":false}}}},"401":{"description":"The bearer credential is missing or not usable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UnauthorizedEncoded"}}}},"402":{"description":"The account does not have Websites.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WebsitesSubscriptionRequiredEncoded"}}}},"403":{"description":"The credential is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ForbiddenEncoded"}}}},"404":{"description":"The site has no function by that id. | The requested tenant does not exist.","content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/SiteFunctionNotFoundEncoded"},{"$ref":"#/components/schemas/NotFoundEncoded"}]}}}}},"description":"The function's contract as it is now: the source of `src/contract.ts`, generated from the stored input and output schemas at the moment of the request, and stored nowhere. It declares the two validators, the `Input` and `Output` types they check, and the handler's `Env`. A function the site does not have is refused with 404 (`SiteFunctionNotFound`).","summary":"Get a function's contract"}},"/v1/sites/{siteId}/functions/{functionId}/upload":{"post":{"tags":["Site functions"],"operationId":"siteFunctions.startFunctionUpload","parameters":[{"name":"siteId","in":"path","schema":{"type":"string"},"required":true},{"name":"functionId","in":"path","schema":{"type":"string"},"required":true}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"type":"string","enum":["site_function_upload"]},"siteId":{"type":"string"},"functionId":{"type":"string"},"expiresAt":{"type":"string"},"bundle":{"type":"object","properties":{"method":{"type":"string","enum":["PUT"]},"url":{"type":"string"},"headers":{"type":"object","additionalProperties":{"type":"string"}}},"required":["method","url","headers"],"additionalProperties":false},"sourceMap":{"type":"object","properties":{"method":{"type":"string","enum":["PUT"]},"url":{"type":"string"},"headers":{"type":"object","additionalProperties":{"type":"string"}}},"required":["method","url","headers"],"additionalProperties":false},"source":{"type":"object","properties":{"method":{"type":"string","enum":["PUT"]},"url":{"type":"string"},"headers":{"type":"object","additionalProperties":{"type":"string"}}},"required":["method","url","headers"],"additionalProperties":false}},"required":["object","siteId","functionId","expiresAt","bundle","sourceMap","source"],"additionalProperties":false}}}},"401":{"description":"The bearer credential is missing or not usable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UnauthorizedEncoded"}}}},"402":{"description":"The account does not have Websites.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WebsitesSubscriptionRequiredEncoded"}}}},"403":{"description":"The credential is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ForbiddenEncoded"}}}},"404":{"description":"The site has no function by that id. | The requested tenant does not exist.","content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/SiteFunctionNotFoundEncoded"},{"$ref":"#/components/schemas/NotFoundEncoded"}]}}}},"409":{"description":"The function is not a draft; its code cannot be replaced. | The upload was built against a contract that is no longer the function's.","content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/SiteFunctionNotDraftEncoded"},{"$ref":"#/components/schemas/SiteFunctionContractChangedEncoded"}]}}}},"413":{"description":"A declared object is larger than a function's upload may hold.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SiteFunctionUploadTooLargeEncoded"}}}}},"description":"Declares the three objects of a draft's upload before anything is sent: `bundle` (the one ES module that runs), `sourceMap` (its source map) and `source` (the handler project as a `.tar.gz`), each by its size and SHA-256. The answer has a presigned URL to PUT each one to, with the headers that must go with it: an upload is refused unless it is exactly the declared bytes. Upload the three, then complete, before `expiresAt`. Nothing is recorded here: the function holds its previous upload until the new one is completed. `contractSha256` is the SHA-256 of the contract the bundle was built against: when it is not the function's contract as it is now, the definition changed since the build and the upload is refused with 409 (`SiteFunctionContractChanged`). An object over its limit is refused with 413 (`SiteFunctionUploadTooLarge`); a function that is published with 409 (`SiteFunctionNotDraft`).","summary":"Start a function's upload","requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"bundle":{"type":"object","properties":{"bytes":{"type":"integer","minimum":1,"description":"The object's size in bytes. The upload is refused unless it is exactly this size."},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$","description":"The object's SHA-256, as 64 lowercase hex characters. The upload is refused unless it is exactly these bytes."}},"required":["bytes","sha256"],"additionalProperties":false},"sourceMap":{"type":"object","properties":{"bytes":{"type":"integer","minimum":1,"description":"The object's size in bytes. The upload is refused unless it is exactly this size."},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$","description":"The object's SHA-256, as 64 lowercase hex characters. The upload is refused unless it is exactly these bytes."}},"required":["bytes","sha256"],"additionalProperties":false},"source":{"type":"object","properties":{"bytes":{"type":"integer","minimum":1,"description":"The object's size in bytes. The upload is refused unless it is exactly this size."},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$","description":"The object's SHA-256, as 64 lowercase hex characters. The upload is refused unless it is exactly these bytes."}},"required":["bytes","sha256"],"additionalProperties":false},"contractSha256":{"type":"string","pattern":"^[0-9a-f]{64}$","description":"The SHA-256 of the contract (src/contract.ts) the bundle was built against, as 64 lowercase hex characters. An upload built against a contract that is no longer the function's is refused: its definition changed."}},"required":["bundle","sourceMap","source","contractSha256"],"additionalProperties":false}}},"required":true}}},"/v1/sites/{siteId}/functions/{functionId}/upload/complete":{"post":{"tags":["Site functions"],"operationId":"siteFunctions.completeFunctionUpload","parameters":[{"name":"siteId","in":"path","schema":{"type":"string"},"required":true},{"name":"functionId","in":"path","schema":{"type":"string"},"required":true}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"type":"string","enum":["site_function"]},"id":{"type":"string"},"siteId":{"type":"string"},"name":{"type":"string"},"description":{"type":"string"},"input":{},"output":{},"status":{"anyOf":[{"type":"string","enum":["draft","live"]},{"type":"string"}]},"upload":{"anyOf":[{"type":"object","properties":{"codeSha256":{"type":"string"},"codeBytes":{"type":"integer"},"sourceSha256":{"type":"string"},"sourceBytes":{"type":"integer"},"uploadedAt":{"type":"string"}},"required":["codeSha256","codeBytes","sourceSha256","sourceBytes","uploadedAt"],"additionalProperties":false},{"type":"null"}]},"secrets":{"type":"array","items":{"type":"string"}},"lastCalledAt":{"anyOf":[{"type":"string"},{"type":"null"}]},"createdAt":{"type":"string"},"updatedAt":{"type":"string"}},"required":["object","id","siteId","name","description","input","output","status","upload","secrets","lastCalledAt","createdAt","updatedAt"],"additionalProperties":false}}}},"401":{"description":"The bearer credential is missing or not usable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UnauthorizedEncoded"}}}},"402":{"description":"The account does not have Websites.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WebsitesSubscriptionRequiredEncoded"}}}},"403":{"description":"The credential is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ForbiddenEncoded"}}}},"404":{"description":"The site has no function by that id. | The requested tenant does not exist.","content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/SiteFunctionNotFoundEncoded"},{"$ref":"#/components/schemas/NotFoundEncoded"}]}}}},"409":{"description":"The function is not a draft; its code cannot be replaced. | The declared upload is not in storage. | The upload was built against a contract that is no longer the function's. | The function changed while this was going on; nothing was changed.","content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/SiteFunctionNotDraftEncoded"},{"$ref":"#/components/schemas/SiteFunctionUploadIncompleteEncoded"},{"$ref":"#/components/schemas/SiteFunctionContractChangedEncoded"},{"$ref":"#/components/schemas/SiteFunctionChangedEncoded"}]}}}},"413":{"description":"A declared object is larger than a function's upload may hold.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SiteFunctionUploadTooLargeEncoded"}}}}},"description":"Confirms an upload: sent the same three declarations, it checks that each object in storage is the one declared (size and SHA-256), then records the bundle and the source as the function's current upload, replacing the one before. The answer is the function, with its `upload`. Refused with 409 (`SiteFunctionUploadIncomplete`, naming the first object that is not as declared and how it differs) and nothing is recorded: upload again, then complete again. Completing the same upload twice records the same bytes, so a retry is safe. An upload built against a contract that is no longer the function's is refused with 409 (`SiteFunctionContractChanged`), and one that another request overtook (an update, another upload) with 409 (`SiteFunctionChanged`): nothing is recorded.","summary":"Complete a function's upload","requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"bundle":{"type":"object","properties":{"bytes":{"type":"integer","minimum":1,"description":"The object's size in bytes. The upload is refused unless it is exactly this size."},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$","description":"The object's SHA-256, as 64 lowercase hex characters. The upload is refused unless it is exactly these bytes."}},"required":["bytes","sha256"],"additionalProperties":false},"sourceMap":{"type":"object","properties":{"bytes":{"type":"integer","minimum":1,"description":"The object's size in bytes. The upload is refused unless it is exactly this size."},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$","description":"The object's SHA-256, as 64 lowercase hex characters. The upload is refused unless it is exactly these bytes."}},"required":["bytes","sha256"],"additionalProperties":false},"source":{"type":"object","properties":{"bytes":{"type":"integer","minimum":1,"description":"The object's size in bytes. The upload is refused unless it is exactly this size."},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$","description":"The object's SHA-256, as 64 lowercase hex characters. The upload is refused unless it is exactly these bytes."}},"required":["bytes","sha256"],"additionalProperties":false},"contractSha256":{"type":"string","pattern":"^[0-9a-f]{64}$","description":"The SHA-256 of the contract (src/contract.ts) the bundle was built against, as 64 lowercase hex characters. An upload built against a contract that is no longer the function's is refused: its definition changed."}},"required":["bundle","sourceMap","source","contractSha256"],"additionalProperties":false}}},"required":true}}},"/v1/sites/{siteId}/functions/{functionId}/invoke":{"post":{"tags":["Site functions"],"operationId":"siteFunctions.invokeFunction","parameters":[{"name":"siteId","in":"path","schema":{"type":"string"},"required":true},{"name":"functionId","in":"path","schema":{"type":"string"},"required":true}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"type":"string","enum":["site_function_invocation"]},"invocationId":{"type":"string"},"siteId":{"type":"string"},"functionId":{"type":"string"},"name":{"type":"string"},"status":{"anyOf":[{"type":"string","enum":["draft","live"]},{"type":"string"}]},"codeSha256":{"type":"string"},"outcome":{"anyOf":[{"type":"string","enum":["answered","invalid_input","failed"]},{"type":"string"}]},"durationMs":{"type":"integer"},"output":{"anyOf":[{},{"type":"null"}]},"issues":{"type":"array","items":{"type":"object","properties":{"path":{"type":"string"},"message":{"type":"string"}},"required":["path","message"],"additionalProperties":false}},"failure":{"anyOf":[{"type":"object","properties":{"stage":{"anyOf":[{"type":"string","enum":["environment","code","runtime","timeout","answer","handler","output","platform"]},{"type":"string"}]},"error":{"anyOf":[{"type":"object","properties":{"name":{"type":"string"},"message":{"type":"string"},"stack":{"anyOf":[{"type":"string"},{"type":"null"}]}},"required":["name","message","stack"],"additionalProperties":false},{"type":"null"}]},"detail":{"anyOf":[{"type":"string"},{"type":"null"}]}},"required":["stage","error","detail"],"additionalProperties":false},{"type":"null"}]}},"required":["object","invocationId","siteId","functionId","name","status","codeSha256","outcome","durationMs","output","issues","failure"],"additionalProperties":false}}}},"401":{"description":"The bearer credential is missing or not usable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UnauthorizedEncoded"}}}},"402":{"description":"The account does not have Websites.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WebsitesSubscriptionRequiredEncoded"}}}},"403":{"description":"The credential is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ForbiddenEncoded"}}}},"404":{"description":"The site has no function by that id. | The requested tenant does not exist.","content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/SiteFunctionNotFoundEncoded"},{"$ref":"#/components/schemas/NotFoundEncoded"}]}}}},"409":{"description":"The function has no code yet: it has never been pushed.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SiteFunctionNotPushedEncoded"}}}},"413":{"description":"The input is larger than a function takes.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SiteFunctionInputTooLargeEncoded"}}}},"503":{"description":"The functions runtime did not answer.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SiteFunctionRunUnavailableEncoded"}}}}},"description":"Runs the function once, with `input`, on the platform: the code it holds now, in the same isolate and under the same limits a call from the site gets. It is how a function's author tries it. The answer is 200 however the RUN went, and its `outcome` says how: `answered` (with the `output`, checked against the output schema), `invalid_input` (the input schema's `issues`; the handler did not run), or `failed` (`failure.stage` says where it stopped: `handler` with the handler's own `error` and stack, `output` with the output schema's `issues`, `runtime`, `timeout`, `code`, `answer`, `environment` or `platform`, each with a `detail` line when there is one). Every run has an `invocationId`. A run is never retried, and does not count as the site using the function. Refused, with nothing run: a function the site does not have (404, `SiteFunctionNotFound`), one that has never been pushed (409, `SiteFunctionNotPushed`), an input over 1 MiB as JSON (413, `SiteFunctionInputTooLarge`). A runtime that did not answer is 503 (`SiteFunctionRunUnavailable`): the handler may or may not have run.","summary":"Invoke a function","requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"input":{}},"required":["input"],"additionalProperties":false}}},"required":true}}},"/v1/sites/{siteId}/secrets":{"get":{"tags":["Site secrets"],"operationId":"siteSecrets.listSecrets","parameters":[{"name":"siteId","in":"path","schema":{"type":"string"},"required":true}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"type":"string","enum":["site_secret_list"]},"siteId":{"type":"string"},"data":{"type":"array","items":{"type":"object","properties":{"object":{"type":"string","enum":["site_secret"]},"name":{"type":"string"},"usedBy":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"},"status":{"type":"string"}},"required":["id","name","status"],"additionalProperties":false}},"createdAt":{"type":"string"},"updatedAt":{"type":"string"}},"required":["object","name","usedBy","createdAt","updatedAt"],"additionalProperties":false}},"requests":{"type":"array","items":{"type":"object","properties":{"object":{"type":"string","enum":["site_secret_request"]},"id":{"type":"string"},"siteId":{"type":"string"},"url":{"type":"string"},"note":{"anyOf":[{"type":"string"},{"type":"null"}]},"state":{"anyOf":[{"type":"string","enum":["open","completed","expired","revoked"]},{"type":"string"}]},"keys":{"type":"array","items":{"type":"object","properties":{"name":{"type":"string"},"description":{"anyOf":[{"type":"string"},{"type":"null"}]},"filledAt":{"anyOf":[{"type":"string"},{"type":"null"}]}},"required":["name","description","filledAt"],"additionalProperties":false}},"expiresAt":{"type":"string"},"completedAt":{"anyOf":[{"type":"string"},{"type":"null"}]},"createdAt":{"type":"string"}},"required":["object","id","siteId","url","note","state","keys","expiresAt","completedAt","createdAt"],"additionalProperties":false}}},"required":["object","siteId","data","requests"],"additionalProperties":false}}}},"401":{"description":"The bearer credential is missing or not usable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UnauthorizedEncoded"}}}},"402":{"description":"The account does not have Websites.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WebsitesSubscriptionRequiredEncoded"}}}},"403":{"description":"The credential is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ForbiddenEncoded"}}}},"404":{"description":"The requested tenant does not exist.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NotFoundEncoded"}}}}},"description":"The site's secrets by name: `data` holds each one that has a value, with when it was first saved and last replaced and the functions that are given it (`usedBy`), and `requests` the secret requests that are still open, the newest first, each with its `url`, its keys and when each was entered (`filledAt`). A key appears in `data` as soon as someone enters it through a request, which is how to tell a request was used. Never a value: nothing reads one back. Not paged.","summary":"List a site's secrets"}},"/v1/sites/{siteId}/secret-requests":{"post":{"tags":["Site secrets"],"operationId":"siteSecrets.requestSecrets","parameters":[{"name":"siteId","in":"path","schema":{"type":"string"},"required":true}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"type":"string","enum":["site_secret_request"]},"id":{"type":"string"},"siteId":{"type":"string"},"url":{"type":"string"},"note":{"anyOf":[{"type":"string"},{"type":"null"}]},"state":{"anyOf":[{"type":"string","enum":["open","completed","expired","revoked"]},{"type":"string"}]},"keys":{"type":"array","items":{"type":"object","properties":{"name":{"type":"string"},"description":{"anyOf":[{"type":"string"},{"type":"null"}]},"filledAt":{"anyOf":[{"type":"string"},{"type":"null"}]}},"required":["name","description","filledAt"],"additionalProperties":false}},"expiresAt":{"type":"string"},"completedAt":{"anyOf":[{"type":"string"},{"type":"null"}]},"createdAt":{"type":"string"}},"required":["object","id","siteId","url","note","state","keys","expiresAt","completedAt","createdAt"],"additionalProperties":false}}}},"401":{"description":"The bearer credential is missing or not usable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UnauthorizedEncoded"}}}},"402":{"description":"The account does not have Websites.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WebsitesSubscriptionRequiredEncoded"}}}},"403":{"description":"The credential is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ForbiddenEncoded"}}}},"404":{"description":"The requested tenant does not exist.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NotFoundEncoded"}}}},"422":{"description":"The keys, the note or the expiry of the request cannot be used.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SiteSecretRequestInvalidEncoded"}}}}},"description":"Makes a secret request: a link (`url`) that names the `keys` wanted, each a `name` (uppercase letters, digits and underscores, starting with a letter) and an optional `description` for the person who will enter it, with an optional `note` shown above them. Whoever opens the link enters the values on a page with NO sign-in; the link lets them do that and nothing else. A value entered is stored sealed as the site's secret of that name (one that exists is replaced) and is never answered by any route. The keys can be entered a few at a time; once every key has a value the request is `completed` and takes no more. It expires after `expiresInDays` (1 to 30, default 7). A request that cannot be made is refused with 422 (`SiteSecretRequestInvalid`), whose `issues` name every problem and where it is; nothing is created.","summary":"Request secrets for a site","requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"keys":{"type":"array","items":{"type":"object","properties":{"name":{"type":"string"},"description":{"type":"string"}},"required":["name"],"additionalProperties":false},"description":"The keys to ask for, in the order the page shows them: each a `name` (uppercase letters, digits and underscores, starting with a letter: CALCOM_API_KEY) and an optional `description` of what it is and where to find it."},"note":{"type":"string","description":"What the keys are for, shown above them on the page."},"expiresInDays":{"anyOf":[{"type":"number"},{"type":"string","enum":["Infinity","-Infinity","NaN"]}]}},"required":["keys"],"additionalProperties":false}}},"required":true}}},"/v1/sites/{siteId}/secrets/{name}":{"delete":{"tags":["Site secrets"],"operationId":"siteSecrets.deleteSecret","parameters":[{"name":"siteId","in":"path","schema":{"type":"string"},"required":true},{"name":"name","in":"path","schema":{"type":"string"},"required":true}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"type":"string","enum":["site_secret_deleted"]},"siteId":{"type":"string"},"name":{"type":"string"}},"required":["object","siteId","name"],"additionalProperties":false}}}},"401":{"description":"The bearer credential is missing or not usable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UnauthorizedEncoded"}}}},"402":{"description":"The account does not have Websites.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WebsitesSubscriptionRequiredEncoded"}}}},"403":{"description":"The credential is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ForbiddenEncoded"}}}},"404":{"description":"The site has no secret by that name. | The requested tenant does not exist.","content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/SiteSecretNotFoundEncoded"},{"$ref":"#/components/schemas/NotFoundEncoded"}]}}}},"409":{"description":"Functions of the site are given the secret; it cannot be deleted while they are.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SiteSecretInUseEncoded"}}}}},"description":"Deletes the site's secret of that name: its value is gone and cannot be brought back, and the name can be asked for again. A secret that one of the site's functions is given is refused with 409 (`SiteSecretInUse`, whose `usedBy` names every such function): a function would run without a value it was written to have. Change each function so it is no longer given it, or delete the function, then delete the secret. A name the site does not have is 404 (`SiteSecretNotFound`).","summary":"Delete a secret"}},"/v1/sites/{siteId}/secret-requests/{requestId}":{"delete":{"tags":["Site secrets"],"operationId":"siteSecrets.revokeSecretRequest","parameters":[{"name":"siteId","in":"path","schema":{"type":"string"},"required":true},{"name":"requestId","in":"path","schema":{"type":"string"},"required":true}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"type":"string","enum":["site_secret_request"]},"id":{"type":"string"},"siteId":{"type":"string"},"url":{"type":"string"},"note":{"anyOf":[{"type":"string"},{"type":"null"}]},"state":{"anyOf":[{"type":"string","enum":["open","completed","expired","revoked"]},{"type":"string"}]},"keys":{"type":"array","items":{"type":"object","properties":{"name":{"type":"string"},"description":{"anyOf":[{"type":"string"},{"type":"null"}]},"filledAt":{"anyOf":[{"type":"string"},{"type":"null"}]}},"required":["name","description","filledAt"],"additionalProperties":false}},"expiresAt":{"type":"string"},"completedAt":{"anyOf":[{"type":"string"},{"type":"null"}]},"createdAt":{"type":"string"}},"required":["object","id","siteId","url","note","state","keys","expiresAt","completedAt","createdAt"],"additionalProperties":false}}}},"401":{"description":"The bearer credential is missing or not usable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UnauthorizedEncoded"}}}},"402":{"description":"The account does not have Websites.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WebsitesSubscriptionRequiredEncoded"}}}},"403":{"description":"The credential is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ForbiddenEncoded"}}}},"404":{"description":"The site has no secret request by that id. | The requested tenant does not exist.","content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/SiteSecretRequestNotFoundEncoded"},{"$ref":"#/components/schemas/NotFoundEncoded"}]}}}},"409":{"description":"The secret request is already over.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SiteSecretRequestNotOpenEncoded"}}}}},"description":"Ends an open secret request before it expires: its link takes no more values, and whoever opens it is told it no longer works. The values it had already taken stay saved. The answer is the request, `revoked`. One that is already over is refused with 409 (`SiteSecretRequestNotOpen`, with its `state`); an id the site does not have is 404 (`SiteSecretRequestNotFound`).","summary":"Revoke a secret request"}},"/v1/sites/{siteId}/sdk":{"get":{"tags":["Site SDK"],"operationId":"siteSdk.generate","parameters":[{"name":"siteId","in":"path","schema":{"type":"string"},"required":true}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"type":"string","enum":["site_sdk"]},"siteId":{"type":"string"},"submissions":{"type":"integer"},"functions":{"type":"integer"},"code":{"anyOf":[{"type":"object","properties":{"schemas":{"type":"string"},"client":{"type":"string"}},"required":["schemas","client"],"additionalProperties":false},{"type":"null"}]}},"required":["object","siteId","submissions","functions","code"],"additionalProperties":false}}}},"401":{"description":"The bearer credential is missing or not usable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UnauthorizedEncoded"}}}},"402":{"description":"The account does not have Websites.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WebsitesSubscriptionRequiredEncoded"}}}},"403":{"description":"The credential is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ForbiddenEncoded"}}}},"404":{"description":"The requested tenant does not exist.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NotFoundEncoded"}}}}},"description":"The two source files a site keeps in `src/heysegment/`, generated from its submissions and functions as they are now: `schemas` (one validator each) and `client` (the site, and one export per submission and function; what a page imports). They import `@heysegment/sdk` and name the site by its id only. `code` is null when the site has no submissions and no functions: there is nothing to generate, and a site that had the files should remove them. Generated for each request and stored nowhere, so the same site state always answers the same bytes.","summary":"Generate a site's SDK code"}},"/v1/site-rules":{"get":{"tags":["Site rules"],"operationId":"siteRules.list","parameters":[],"security":[],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"packages":{"type":"array","items":{"type":"object","properties":{"package":{"type":"string"},"constraint":{"anyOf":[{"type":"string","enum":["exact","at-least","at-most"]},{"type":"string"}]},"version":{"type":"string"},"context":{"type":"string"}},"required":["package","constraint","version"],"additionalProperties":false}},"guide":{"type":"string","description":"How sites build and check on the platform today, and the common problems with their fixes: plain text, one point per line. Shown to whoever runs the checks when a site is not accepted. May be empty."}},"required":["packages"],"additionalProperties":false}}}}},"description":"What every site must satisfy: which versions of which packages it may depend on, and why, and a short guide to how sites build and check today. Public.","summary":"Site rules"}},"/v1/cli":{"get":{"tags":["CLI"],"operationId":"cli.versions","parameters":[],"security":[],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"type":"string","enum":["cli_versions"]},"package":{"type":"string"},"command":{"type":"string"},"recommended":{"anyOf":[{"type":"string"},{"type":"null"}]},"minimum":{"type":"string"},"install":{"type":"string"}},"required":["object","package","command","recommended","minimum","install"],"additionalProperties":false}}}}},"description":"The Heysegment CLI release to run, the oldest one the platform still serves, and the command that installs it. Public.","summary":"CLI versions"}}},"components":{"schemas":{"CliAccessCodeInvalidEncoded":{"type":"object","properties":{"_tag":{"type":"string","enum":["CliAccessCodeInvalid"]}},"required":["_tag"],"additionalProperties":false},"CredentialInvalidEncoded":{"type":"object","properties":{"_tag":{"type":"string","enum":["CredentialInvalid"]}},"required":["_tag"],"additionalProperties":false},"UnauthorizedEncoded":{"type":"object","properties":{"_tag":{"type":"string","enum":["Unauthorized"]}},"required":["_tag"],"additionalProperties":false},"ForbiddenEncoded":{"type":"object","properties":{"_tag":{"type":"string","enum":["Forbidden"]},"message":{"type":"string"}},"required":["_tag","message"],"additionalProperties":false},"NotFoundEncoded":{"type":"object","properties":{"_tag":{"type":"string","enum":["NotFound"]}},"required":["_tag"],"additionalProperties":false},"InvalidCursorEncoded":{"type":"object","properties":{"_tag":{"type":"string","enum":["InvalidCursor"]},"message":{"type":"string"}},"required":["_tag","message"],"additionalProperties":false},"MutationInvalidEncoded":{"type":"object","properties":{"_tag":{"type":"string","enum":["MutationInvalid"]},"message":{"type":"string"}},"required":["_tag","message"],"additionalProperties":false},"MutationNotFoundEncoded":{"type":"object","properties":{"_tag":{"type":"string","enum":["MutationNotFound"]},"message":{"type":"string"},"resource":{"anyOf":[{"type":"string","enum":["group","item","business","organization","place","review","sender"]},{"type":"string"}]}},"required":["_tag","message"],"additionalProperties":false},"MutationConflictEncoded":{"type":"object","properties":{"_tag":{"type":"string","enum":["MutationConflict"]},"reason":{"anyOf":[{"type":"string","enum":["not_editable","not_included","item_mismatch","duplicate","empty","not_approvable","not_usable"]},{"type":"string"}]},"message":{"type":"string"},"itemId":{"type":"string"}},"required":["_tag","reason","message"],"additionalProperties":false},"MutationHumanApprovalRequiredEncoded":{"type":"object","properties":{"_tag":{"type":"string","en