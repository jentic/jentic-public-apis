A-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid","description":"Business whose voice to change, in the authenticated account, as businesses list returns it. A saved proposal's business cannot change."},"reviewId":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid","description":"Review whose reply to add or take out, as the business's reviews list returns it: a review on a Google place the business uses. A saved proposal's review cannot change."},"example":{"type":"string","enum":["add","remove"],"description":"add: copy the review and the reply Google shows now into the business's voice (the review needs a reply on Google, and the voice holds 10 at most); remove: take it out. Removals apply before additions, so a group can swap one for another."}},"required":["businessId","reviewId","example"],"additionalProperties":false},"id":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"},"groupId":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"},"selection":{"type":"string","enum":["included","withdrawn","rejected"]}},"required":["mutationType","schemaVersion","input","id","groupId","selection"],"additionalProperties":false},{"type":"object","properties":{"mutationType":{"type":"string","enum":["site_domain"]},"schemaVersion":{"type":"number","enum":[1]},"input":{"type":"object","properties":{"siteId":{"type":"string","pattern":"^[0-9A-HJKMNP-TV-Z]{12}$","description":"Site the domain is for, in the authenticated account, as sites list returns it. A saved proposal's site cannot change."},"domain":{"type":"string","minLength":1,"description":"The domain to connect, as the plan names its root (example.com). It replaces whatever domain the site has. Leave out with remove."},"setup":{"type":"string","enum":["root_primary_cname","www_primary_cname","www_primary_redirect_ip"],"description":"The setup, as the plan lists it: root_primary_cname (the root shows the site, www forwards by CNAME), www_primary_cname (www shows the site, the root forwards by CNAME), www_primary_redirect_ip (www shows the site, the root forwards by A record: the only setup where the DNS company cannot point a root at a hostname). Leave out with remove."},"provider":{"type":"string","enum":["cloudflare","godaddy","namecheap","squarespace","porkbun","hostinger","ionos","wix","route53","digitalocean","vercel","netlify","wordpress","bluehost","hostgator","siteground","namecom","spaceship","networksolutions","namesilo","dynadot","hover","azure","gandi","ovh","dreamhost","inmotion","dnsimple","dnsmadeeasy"],"description":"The company managing the domain's DNS, as the plan's provider.id names it. Leave out when the plan could not name one: the root is then set up as unable to point at a hostname (www_primary_redirect_ip)."},"forwardOther":{"type":"boolean","description":"Whether the other name forwards to the main address (true unless said): everyone who types it then lands on the site. False leaves the other name as it is, with nothing of the site on it."},"remove":{"type":"boolean","description":"True to take the site's domain off: every name of it stops reaching the site. Names nothing else."}},"required":["siteId"],"additionalProperties":false},"id":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"},"groupId":{"type":"string","pattern":"^([0-9a-fA-F