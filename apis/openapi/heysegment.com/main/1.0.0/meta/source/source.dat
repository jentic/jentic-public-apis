 by the account or one of its organizations — found by the same id: hostname, kind, owner, Cloudflare status and certificate status, our canonical health verdict with the recorded fault and its evidence, the DNS records the domain requires, and the timestamps. The records are a requirement and the evidence is one recorded fault, not an inventory of what DNS answers today; no check is run.","summary":"Retrieve a domain"}},"/v1/account/business-options":{"get":{"tags":["Account"],"operationId":"accounts.getBusinessOptions","parameters":[],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"type":"string","enum":["business_options"]},"subscription":{"type":"object","properties":{"effect":{"anyOf":[{"type":"string","enum":["starts_subscription","adds_to_subscription"]},{"type":"string"}]},"blocked":{"anyOf":[{"anyOf":[{"type":"string","enum":["subscription_ending","no_payment_method"]},{"type":"string"}]},{"type":"null"}]},"endsAt":{"anyOf":[{"type":"string"},{"type":"null"}]}},"required":["effect","blocked","endsAt"],"additionalProperties":false},"websites":{"type":"object","properties":{"state":{"anyOf":[{"type":"string","enum":["subscribed","never_subscribed","ended"]},{"type":"string"}]},"endedAt":{"anyOf":[{"type":"string"},{"type":"null"}]},"draftLimit":{"type":"integer"},"sites":{"type":"array","items":{"type":"object","properties":{"object":{"type":"string","enum":["site"]},"id":{"type":"string"},"name":{"type":"string"},"previewUrl":{"anyOf":[{"type":"string"},{"type":"null"}]},"createdAt":{"type":"string"}},"required":["object","id","name","previewUrl","createdAt"],"additionalProperties":false}}},"required":["state","endedAt","draftLimit","sites"],"additionalProperties":false}},"required":["object","subscription","websites"],"additionalProperties":false}}}},"401":{"description":"The bearer credential is missing or not usable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UnauthorizedEncoded"}}}},"403":{"description":"The credential is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ForbiddenEncoded"}}}},"404":{"description":"The requested tenant does not exist.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NotFoundEncoded"}}}}},"description":"Returns what a new business proposed in a mutation group can be created with: what approving new businesses does to the account's subscription (starts it, or adds to it) and what stops it now (a subscription set to end, no card on file for a first one); whether the account has Websites, which every website needs; and the account's sites that no business has yet, the ones an existing website can be, with how many such sites the account may hold. From the account's stored billing record, never the payment provider: the price is shown on the review page, where a person approves it.","summary":"Retrieve what a new business can be created with"}},"/v1/account/branding":{"get":{"tags":["Account"],"operationId":"accounts.getBranding","parameters":[],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"type":"string","enum":["account_branding"]},"id":{"type":"string"},"name":{"type":"string"},"slug":{"type":"string"},"displayName":{"type":"object","properties":{"value":{"type":"string"},"source":{"anyOf":[{"type":"string","enum":["configured","default"]},{"type":"string"}]}},"required":["value","source"],"additionalProperties":false},"brandColor":{"type":"object","properties":{"value":{"type":"string"},"source":{"anyOf":[{"type":"string","enum":["configured","default"]},{"type":"string"}]}},"required":["value","source"],"additionalProperties":false},"assets":{"type":"object","properties":{"icon":{"anyOf":[{"type":"object","properties":{"width":{"type":"integer"},"height":{"type":"integer"}},"required":["width","height"],"additionalProperties":false},{"type":"null"}]},"poweredBy":{"anyOf":[{"type":"object","properties":{"width":{"type":"integer"},"height":{"type":"integer"}},"required":["width","height"],"additionalProperties":false},{"type":"null"}]}},"required":["icon","poweredBy"],"additionalProperties":false},"notificationSender":{"type":"object","properties":{"name":{"type":"string"},"address":{"anyOf":[{"type":"string"},{"type":"null"}]},"source":{"anyOf":[{"type":"string","enum":["custom","platform"]},{"type":"string"}]},"configured":{"anyOf":[{"type":"object","properties":{"address":{"type":"string"},"connectionId":{"type":"string"},"usable":{"type":"boolean"}},"required":["address","connectionId","usable"],"additionalProperties":false},{"type":"null"}]}},"required":["name","address","source","configured"],"additionalProperties":false}},"required":["object","id","name","slug","displayName","brandColor","assets","notificationSender"],"additionalProperties":false}}}},"401":{"description":"The bearer credential is missing or not usable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UnauthorizedEncoded"}}}},"403":{"description":"The credential is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ForbiddenEncoded"}}}},"404":{"description":"The requested tenant does not exist.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NotFoundEncoded"}}}}},"description":"Returns the account's effective display name and brand colour with where each came from, whether an icon and a powered-by overlay are uploaded (presence and pixel dimensions only, never the files or the private keys that name them), and the sender notifications go out under — distinguishing the configured custom sender from the one actually in effect. Stored facts only.","summary":"Retrieve account branding"}},"/v1/account/notifications/settings":{"get":{"tags":["Account"],"operationId":"accounts.getNotificationSettings","parameters":[],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"type":"string","enum":["notification_settings"]},"data":{"type":"array","items":{"type":"object","properties":{"object":{"type":"string","enum":["notification_setting"]},"group":{"type":"string"},"label":{"type":"string"},"description":{"type":"string"},"enabled":{"type":"boolean"},"origin":{"anyOf":[{"type":"string","enum":["account","default"]},{"type":"string"}]},"configurability":{"anyOf":[{"type":"string","enum":["toggleable","locked","producer_controlled"]},{"type":"string"}]}},"required":["object","group","label","description","enabled","origin","configurability"],"additionalProperties":false}}},"required":["object","data"],"additionalProperties":false}}}},"401":{"description":"The bearer credential is missing or not usable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UnauthorizedEncoded"}}}},"403":{"description":"The credential is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ForbiddenEncoded"}}}},"404":{"description":"The requested tenant does not exist.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NotFoundEncoded"}}}}},"description":"Returns every notification group at account scope with its label, its effective value, whether that value was stored here or is the catalog default, and whether it can be changed at all. An enabled group means the account allows it; individual users can still mute it and recipient eligibility is separate.","summary":"Retrieve notification settings"}},"/v1/account/notifications/history":{"get":{"tags":["Account"],"operationId":"accounts.listNotificationHistory","parameters":[{"name":"limit","in":"query","schema":{"type":"string","pattern":"^[+-]?\\d*\\.?\\d+(?:[Ee][+-]?\\d+)?$"},"required":false},{"name":"search","in":"query","schema":{"type":"string","description":"Case-insensitive text to look for in the recipient, the title, the body, the code or the tenant's name. The body is searched but never returned."},"required":false},{"name":"code","in":"query","schema":{"type":"string","description":"Only this exact notification code, e.g. `campaign.blocked`. Free text, so a code retired since it was sent is still selectable."},"required":false},{"name":"status","in":"query","schema":{"type":"string","enum":["pending","sent","failed","skipped"],"description":"Only deliveries that ended this way. Ignored when undeliveredOnly is set."},"required":false},{"name":"severity","in":"query","schema":{"type":"string","enum":["info","warning","critical"],"description":"Only occurrences of this severity."},"required":false},{"name":"undeliveredOnly","in":"query","schema":{"type":"string","enum":["true","false"]},"required":false},{"name":"sinceDays","in":"query","schema":{"type":"string","pattern":"^[+-]?\\d*\\.?\\d+(?:[Ee][+-]?\\d+)?$"},"required":false}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"array","items":{"type":"object","properties":{"object":{"type":"string","enum":["notification_delivery"]},"notificationId":{"type":"string"},"deliveryId":{"anyOf":[{"type":"string"},{"type":"null"}]},"code":{"type":"string"},"group":{"type":"string"},"severity":{"anyOf":[{"type":"string","enum":["info","warning","critical"]},{"type":"string"}]},"occurredAt":{"type":"string"},"scope":{"type":"object","properties":{"kind":{"anyOf":[{"type":"string","enum":["account","organization","business","user"]},{"type":"string"}]},"id":{"type":"string"},"name":{"anyOf":[{"type":"string"},{"type":"null"}]}},"required":["kind","id","name"],"additionalProperties":false},"recipient":{"anyOf":[{"type":"object","properties":{"email":{"type":"string"},"name":{"anyOf":[{"type":"string"},{"type":"null"}]},"userId":{"anyOf":[{"type":"string"},{"type":"null"}]}},"required":["email","name","userId"],"additionalProperties":false},{"type":"null"}]},"channel":{"anyOf":[{"anyOf":[{"type":"string","enum":["email","in_app"]},{"type":"string"}]},{"type":"null"}]},"status":{"anyOf":[{"anyOf":[{"type":"string","enum":["pending","sent","failed","skipped"]},{"type":"string"}]},{"type":"null"}]},"sentAt":{"anyOf":[{"type":"string"},{"type":"null"}]},"error":{"anyOf":[{"type":"string"},{"type":"null"}]},"deliveries":{"type":"integer"}},"required":["object","notificationId","deliveryId","code","group","severity","occurredAt","scope","recipient","channel","status","sentAt","error","deliveries"],"additionalProperties":false}},"hasMore":{"type":"boolean"},"nextCursor":{"anyOf":[{"type":"string"},{"type":"null"}]},"matched":{"type":"integer"}},"required":["data","hasMore","nextCursor","matched"],"additionalProperties":false}}}},"401":{"description":"The bearer credential is missing or not usable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UnauthorizedEncoded"}}}},"403":{"description":"The credential is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ForbiddenEncoded"}}}},"404":{"description":"The requested tenant does not exist.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NotFoundEncoded"}}}}},"description":"Lists the account's notification deliveries, newest first: code, group, severity, when the occurrence was recorded, the tenant it was about, the recipient, the channel, the delivery status and a short preview, with the matched total. One occurrence sent to three people is three rows. An occurrence that a switch turned off or a throttle swallowed never appears, so an empty result proves nothing. Narrow with `search`, `code`, `status`, `severity`, `undeliveredOnly` and `sinceDays`. Never returns the rendered body or its context.","summary":"List notification history"}},"/v1/account/mutation-groups":{"post":{"tags":["Mutations"],"operationId":"mutations.createGroup","parameters":[],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"type":"string","enum":["agent_mutation_group"]},"id":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"},"title":{"type":"string"},"objective":{"type":"string"},"status":{"type":"string","enum":["draft","approved","rejected"]},"revision":{"type":"integer","exclusiveMinimum":0},"approval":{"type":"string","enum":["human_required","agent_allowed"],"description":"Approval requirement of the included items. Submission must recheck it."},"createdAt":{"type":"string"},"updatedAt":{"type":"string"},"decidedAt":{"anyOf":[{"type":"string"},{"type":"null"}]},"items":{"type":"array","items":{"anyOf":[{"type":"object","properties":{"mutationType":{"type":"string","enum":["business_create"]},"schemaVersion":{"type":"number","enum":[2]},"input":{"type":"object","properties":{"name":{"type":"string","pattern":"\\S","description":"Business display name. Two new businesses in one group cannot share a name."},"nickname":{"type":"string","pattern":"\\S","description":"Short name, shown where space is tight. Defaults to the name."},"organizationId":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid","description":"Organization in the account to place the new business in, as organizations list returns it. Leave out to leave it ungrouped."},"reputationManagement":{"type":"boolean","description":"Whether the business gets Reputation Management (review requests, review replies and its reputation pages), billed per business on the account's subscription."},"website":{"type":"string","enum":["none","new","existing"],"description":"The business's website, billed as one hosted site: none; new, a draft site named after the business, made with it; or existing, one of the account's sites that no business has yet. A website needs the account's Websites subscription. At least one product: Reputation Management, a website, or both."},"siteId":{"type":"string","pattern":"^[0-9A-HJKMNP-TV-Z]{12}$","description":"The site to give the business, with an existing website: one of the account's sites that no business has yet, by its id. Only with an existing website."}},"required":["name","reputationManagement","website"],"additionalProperties":false},"id":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"},"groupId":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"},"selection":{"type":"string","enum":["included","withdrawn","rejected"]},"applyStatus":{"type":"string","enum":["not_started","running","applied","failed"]},"attempts":{"type":"integer","minimum":0},"result":{"anyOf":[{"anyOf":[{"type":"object","properties":{"businessId":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"},"site":{"anyOf":[{"type":"object","properties":{"id":{"type":"string"},"created":{"type":"boolean"}},"required":["id","created"],"additionalProperties":false},{"type":"null"}]}},"required":["businessId","site"],"additionalProperties":false},{"type":"object","properties":{"businessId":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"}},"required":["businessId"],"additionalProperties":false},{"type":"object","properties":{"businessId":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"}},"required":["businessId"],"additionalProperties":false},{"type":"object","properties":{"businessId":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"}},"required":["businessId"],"additionalProperties":false},{"type":"object","properties":{"businessId":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"}},"required":["businessId"],"additionalProperties":false},{"type":"object","properties":{"siteId":{"type":"string","pattern":"^[0-9A-HJKMNP-TV-Z]{12}$"},"domain":{"anyOf":[{"type":"string"},{"type":"null"}]},"replaced":{"anyOf":[{"type":"string"},{"type":"null"}]}},"required":["siteId","domain","replaced"],"additionalProperties":false},{"type":"object","properties":{"siteId":{"type":"string","pattern":"^[0-9A-HJKMNP-TV-Z]{12}$"},"senderId":{"anyOf":[{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"},{"type":"null"}]}},"required":["siteId","senderId"],"additionalProperties":false}]},{"type":"null"}]},"error":{"anyOf":[{"type":"object","properties":{"reason":{"type":"string","enum":["not_implemented","refused","unexpected"]},"message":{"type":"string"}},"required":["reason","message"],"additionalProperties":false},{"type":"null"}]},"approval":{"type":"string","enum":["human_required","agent_allowed"],"description":"Approval requirement of the included items. Submission must recheck it."}},"required":["mutationType","schemaVersion","input","id","groupId","selection","applyStatus","attempts","result","error","approval"],"additionalProperties":false},{"type":"object","properties":{"mutationType":{"type":"string","enum":["business_review_request_config"]},"schemaVersion":{"type":"number","enum":[1]},"input":{"type":"object","properties":{"businessId":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid","description":"Business to change, in the authenticated account, as businesses list returns it. A saved proposal's business cannot change."},"timezone":{"type":"string","allOf":[{"description":"IANA timezone the sending hours and daily limits follow, such as America/Chicago."}]},"sendWindowStart":{"type":"string","allOf":[{"description":"Start of sending hours, HH:MM (24-hour) in the business's timezone: 08:00 at the earliest, and before the end."}]},"sendWindowEnd":{"type":"string","allOf":[{"description":"End of sending hours, HH:MM (24-hour) in the business's timezone: 20:00 at the latest, and after the start. A request due outside the hours waits for them to open."}]},"realtimeDelay":{"type":"string","enum":["immediately","few-hours","1d","2d","3d","4d"],"description":"How long after a new contact's visit or event the first review request goes out: immediately, few-hours (6 hours), 1d, 2d, 3d or 4d (the longest). Sending hours still apply. Live settings report it in seconds (4d is 345600)."},"minMessageGapDays":{"type":"integer","minimum":1,"maximum":2,"description":"Days between two messages to the same person, follow-ups included: 1 or 2. Does not turn follow-ups on or off."},"maxReactivationPerDay":{"type":"integer","minimum":0,"maximum":100,"description":"Daily limit for returning contacts (older contacts being asked again, such as an imported customer list), 0 to 100. Counted apart from new contacts, so a backlog never uses their allowance."},"maxRealtimePerDay":{"type":"integer","minimum":0,"maximum":50,"description":"Daily limit for new contacts (arriving through new visits or events), 0 to 50. Counted apart from returning contacts."},"resendEnabled":{"type":"boolean","description":"Whether a contact who was already messaged can be asked again. It takes a new visit or event arriving after the resend window; time alone never sends another request. Off: nobody is asked twice."},"resendWindowDays":{"type":"integer","minimum":30,"maximum":365,"description":"Days since the last message before a new visit or event can make a contact eligible again, 30 to 365. Only applies while resend is on, and setting it does not turn resend on."},"sendToReviewedContacts":{"type":"boolean","description":"Whether contacts who already left a review can be asked again."},"defaultPhoneRegion":{"type":"string","pattern":"^[A-Za-z]{2}$"},"personalizedImageEnabled":{"type":"boolean","description":"Whether the first request includes a personalized image, when one is available."},"phoneChannelEnabled":{"type":"boolean","description":"Whether review requests go out by text message. Text and email cannot both be off. Turn it off when the business has no phone provider, so the missing provider does not hold back its email requests."},"emailChannelEnabled":{"type":"boolean","description":"Whether review requests go out by email. Text and email cannot both be off. Turn it off when the business has no email provider, so the missing provider does not hold back its text requests."},"messages":{"type":"string","enum":["smart","own"],"description":"Which messages review requests use: smart (the platform's own) or own (the sequences written for this business, its organization or the account). With own, a channel none of those sequences covers still sends smart messages."},"phoneSender":{"anyOf":[{"type":"string","enum":["rotate"]},{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"}],"description":"Which phone sender review requests by text message go out from: rotate, to rotate between every phone sender the business can use, or one sender's id, as the business's messaging read lists it, to always use that one."},"emailSender":{"anyOf":[{"type":"string","enum":["rotate"]},{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"}],"description":"Which email sender review requests by email go out from: rotate, to rotate between every email sender the business can use, or one sender's id, as the business's messaging read lists it, to always use that one."},"emailTemplate":{"type":"string","enum":["plain","clean-card","bold-header","minimal-mono","friendly-rounded"],"description":"The email design review requests use: plain, clean-card, bold-header, minimal-mono or friendly-rounded (the app's Email template gallery), with that design's default colors."},"autoReplyEnabled":{"type":"boolean","description":"Whether a contact who replies asking for service (to book an appointment, say) gets an automatic answer: that this channel only sends review requests, and to contact the business directly."},"followUpsEnabled":{"type":"boolean","description":"Whether follow-up reminders go out after the first review request."}},"required":["businessId"],"additionalProperties":false},"id":{"type":"string","pattern":"^