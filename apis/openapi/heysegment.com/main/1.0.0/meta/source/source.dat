ough this provider."},"required":false},{"name":"status","in":"query","schema":{"type":"string","enum":["pending","active","phasing_out","disabled"],"description":"Only senders in this lifecycle status — what the owner asked of them, not whether they work. Disabled and phasing-out senders are listed unless you filter them out."},"required":false},{"name":"health","in":"query","schema":{"type":"string","enum":["healthy","not_found","unable_to_send"],"description":"Only senders in this stored health — whether they work, as last observed. `healthy` is also what a sender nobody has checked reads as."},"required":false},{"name":"owner","in":"query","schema":{"type":"string","enum":["account","organization","business"],"description":"Only senders managed at this tier: by the account itself, by one of its organizations, or by one of its businesses. Leave it out for the whole tree."},"required":false},{"name":"business","in":"query","schema":{"type":"string","description":"Only senders reserved for this one business, by its id. Dedication is not ownership: a sender an organization manages can be reserved for one of its businesses."},"required":false}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"array","items":{"type":"object","properties":{"object":{"type":"string","enum":["sender"]},"id":{"type":"string"},"kind":{"anyOf":[{"type":"string","enum":["email","phone"]},{"type":"string"}]},"value":{"type":"string"},"label":{"anyOf":[{"type":"string"},{"type":"null"}]},"provider":{"anyOf":[{"type":"string","enum":["ghl","twilio","sendgrid","mailgun","signalhouse"]},{"type":"string"}]},"owner":{"type":"object","properties":{"scope":{"anyOf":[{"type":"string","enum":["account","organization","business"]},{"type":"string"}]},"id":{"type":"string"},"name":{"type":"string"}},"required":["scope","id","name"],"additionalProperties":false},"connectionId":{"anyOf":[{"type"