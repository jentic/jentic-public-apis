{"openapi":"3.1.0","info":{"title":"Segment API","version":"1.0.0","description":"The Segment public API. Resource operations are authenticated with a bearer credential: `/account` is the credential's own account, and an organization or business beneath it is named by id in the path. Credential validation is an explicit pre-authentication POST whose candidate is carried in its body."},"paths":{"/v1/cli-access/start":{"post":{"tags":["CLI access"],"operationId":"cliAccess.start","parameters":[],"security":[],"responses":{"200":{"description":"Success","headers":{"cache-control":{"schema":{"type":"string","enum":["no-store"]},"required":true},"pragma":{"schema":{"type":"string","enum":["no-cache"]},"required":true}},"content":{"application/json":{"schema":{"type":"object","properties":{"accessCode":{"type":"string"},"authorizeUrl":{"type":"string"},"expiresAt":{"type":"string"},"pollAfterSeconds":{"anyOf":[{"type":"number"},{"type":"string","enum":["Infinity","-Infinity","NaN"]}]}},"required":["accessCode","authorizeUrl","expiresAt","pollAfterSeconds"],"additionalProperties":false}}}}},"description":"Creates a short-lived browser authorization attempt. The access code remains private to the CLI; only the separate browser request capability appears in authorizeUrl.","summary":"Begin CLI sign-in","requestBody":{"content":{"application/json":{"schema":{"not":{"type":"null"}}}},"required":true}}},"/v1/cli-access/redeem":{"post":{"tags":["CLI access"],"operationId":"cliAccess.redeem","parameters":[],"security":[],"responses":{"200":{"description":"Success","headers":{"cache-control":{"schema":{"type":"string","enum":["no-store"]},"required":true},"pragma":{"schema":{"type":"string","enum":["no-cache"]},"required":true}},"content":{"application/json":{"schema":{"anyOf":[{"type":"object","properties":{"_tag":{"type":"string","enum":["Pending"]},"expiresAt":{"type":"string"},"pollAfterSeconds":{"anyOf":[{"type":"number"},{"type":"string","enum":["Infinity","-Infinity","NaN"]}]}},"required":["_tag","expiresAt","pollAfterSeconds"],"additionalProperties":false},{"type":"object","properties":{"_tag":{"type":"string","enum":["Denied"]}},"required":["_tag"],"additionalProperties":false},{"type":"object","properties":{"_tag":{"type":"string","enum":["Issued"]},"token":{"type":"string"},"expiresAt":{"type":"string"}},"required":["_tag","token","expiresAt"],"additionalProperties":false}]}}}},"401":{"description":"The CLI access code is not usable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CliAccessCodeInvalidEncoded"}}}}},"description":"Returns Pending while browser approval is incomplete, Denied after cancellation, or one CLI bearer credential after approval. A successful issuance consumes the access code atomically.","summary":"Poll or redeem CLI access","requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"accessCode":{"type":"string"}},"required":["accessCode"],"additionalProperties":false}}},"required":true}}},"/v1/credentials/validate":{"post":{"tags":["Credential validation"],"operationId":"credentialValidation.validate","parameters":[],"security":[],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"valid":{"type":"boolean","enum":[true]},"kind":{"type":"string","enum":["api_key","cli_session"]},"createdAt":{"type":"string"},"expiresAt":{"anyOf":[{"type":"string"},{"type":"null"}]}},"required":["valid","kind","createdAt","expiresAt"],"additionalProperties":false}}}},"401":{"description":"The credential is not usable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CredentialInvalidEncoded"}}}}},"description":"Checks a candidate API or CLI credential before it is stored. Returns its kind and lifetime when it is live. The candidate is not supplied through the API authentication middleware.","summary":"Validate a credential","requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"token":{"type":"string"}},"required":["token"],"additionalProperties":false}}},"required":true}}},"/v1/ping":{"get":{"tags":["Ping"],"operationId":"ping.check","parameters":[],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"status":{"type":"string","enum":["ok"]},"environment":{"type":"string"},"version":{"type":"string"},"tier":{"anyOf":[{"type":"string","enum":["account","organization","business"]},{"type":"string"}]},"scopeId":{"type":"string"},"observedAt":{"type":"string"}},"required":["status","environment","version","tier","scopeId","observedAt"],"additionalProperties":false}}}},"401":{"description":"The bearer credential is missing or not usable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UnauthorizedEncoded"}}}},"403":{"description":"The credential is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ForbiddenEncoded"}}}}},"description":"Confirms the API is reachable and echoes back the tier and tenant your credential is scoped to. Costs no quota and reads no tenant data.","summary":"Ping"}},"/v1/account":{"get":{"tags":["Account"],"operationId":"accounts.retrieve","parameters":[],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"type":"string","enum":["account"]},"id":{"type":"string"},"name":{"type":"string"},"person":{"anyOf":[{"type":"object","properties":{"name":{"anyOf":[{"type":"string"},{"type":"null"}]},"email":{"type":"string"}},"required":["name","email"],"additionalProperties":false},{"type":"null"}]},"observedAt":{"type":"string"}},"required":["object","id","name","person","observedAt"],"additionalProperties":false}}}},"401":{"description":"The bearer credential is missing or not usable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UnauthorizedEncoded"}}}},"403":{"description":"The credential is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ForbiddenEncoded"}}}},"404":{"description":"The requested tenant does not exist.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NotFoundEncoded"}}}}},"description":"Returns the account your credential belongs to. Requires a credential scoped at the account tier.","summary":"Retrieve the account"}},"/v1/account/businesses":{"get":{"tags":["Account"],"operationId":"accounts.listBusinesses","parameters":[{"name":"limit","in":"query","schema":{"type":"string","pattern":"^[+-]?\\d*\\.?\\d+(?:[Ee][+-]?\\d+)?$"},"required":false},{"name":"cursor","in":"query","schema":{"type":"string","description":"The nextCursor of the previous page. Leave it out for the first page."},"required":false},{"name":"organizationId","in":"query","schema":{"type":"string","description":"Only businesses grouped under this organization. Ungrouped businesses belong to no organization and never match."},"required":false},{"name":"issuesOnly","in":"query","schema":{"type":"string","enum":["true","false"]},"required":false}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"array","items":{"type":"object","properties":{"object":{"type":"string","enum":["business"]},"id":{"type":"string"},"name":{"type":"string"},"slug":{"type":"string"},"organization":{"anyOf":[{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"}},"required":["id","name"],"additionalProperties":false},{"type":"null"}]},"owner":{"anyOf":[{"type":"object","properties":{"email":{"type":"string"},"name":{"anyOf":[{"type":"string"},{"type":"null"}]}},"required":["email","name"],"additionalProperties":false},{"type":"null"}]},"reputationManagement":{"anyOf":[{"type":"string","enum":["active","cancelling","inactive"]},{"type":"string"}]},"issues":{"type":"array","items":{"anyOf":[{"type":"string","enum":["no_destination","no_phone_sender","no_email_sender","provider_dead","no_google","no_image"]},{"type":"string"}]}},"campaignsStarted30d":{"type":"integer"},"contactsAdded30d":{"type":"integer"},"googleReviewsSinceCreation":{"type":"integer"},"createdAt":{"type":"string"}},"required":["object","id","name","slug","organization","owner","reputationManagement","issues","campaignsStarted30d","contactsAdded30d","googleReviewsSinceCreation","createdAt"],"additionalProperties":false}},"hasMore":{"type":"boolean"},"nextCursor":{"anyOf":[{"type":"string"},{"type":"null"}]}},"required":["data","hasMore","nextCursor"],"additionalProperties":false}}}},"400":{"description":"The cursor is not one this endpoint issued.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/InvalidCursorEncoded"}}}},"401":{"description":"The bearer credential is missing or not usable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UnauthorizedEncoded"}}}},"403":{"description":"The credential is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ForbiddenEncoded"}}}},"404":{"description":"The requested tenant does not exist.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NotFoundEncoded"}}}}},"description":"Lists the businesses in the account, newest onboarded first, with each one's organization, owner, reputation-management selection, 30-day activity, reviews received and outstanding issues. Page with `cursor`; filter with `organizationId` and `issuesOnly`. Stored facts only.","summary":"List businesses"}},"/v1/account/organizations":{"get":{"tags":["Account"],"operationId":"accounts.listOrganizations","parameters":[{"name":"limit","in":"query","schema":{"type":"string","pattern":"^[+-]?\\d*\\.?\\d+(?:[Ee][+-]?\\d+)?$"},"required":false},{"name":"cursor","in":"query","schema":{"type":"string","description":"The nextCursor of the previous page. Leave it out for the first page."},"required":false}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"array","items":{"type":"object","properties":{"object":{"type":"string","enum":["organization"]},"id":{"type":"string"},"name":{"type":"string"},"businesses":{"type":"integer"}},"required":["object","id","name","businesses"],"additionalProperties":false}},"hasMore":{"type":"boolean"},"nextCursor":{"anyOf":[{"type":"string"},{"type":"null"}]}},"required":["data","hasMore","nextCursor"],"additionalProperties":false}}}},"400":{"description":"The cursor is not one this endpoint issued.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/InvalidCursorEncoded"}}}},"401":{"description":"The bearer credential is missing or not usable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UnauthorizedEncoded"}}}},"403":{"description":"The credential is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ForbiddenEncoded"}}}},"404":{"description":"The requested tenant does not exist.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NotFoundEncoded"}}}}},"description":"Lists the account's named organizations, by name A→Z, each with its business count. Empty organizations are included. Page with `cursor`. The hidden default organization is excluded, so these counts do not add up to the account's business total — ungrouped businesses appear in `/v1/account/businesses` with a null organization. Stored facts only.","summary":"List organizations"}},"/v1/account/features":{"get":{"tags":["Account"],"operationId":"accounts.listFeatures","parameters":[{"name":"feature","in":"query","schema":{"anyOf":[{"type":"string","enum":["reputation_management"]}],"description":"Only this feature. Leave it out for every feature."},"required":false}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"array","items":{"type":"object","properties":{"object":{"type":"string","enum":["feature"]},"key":{"anyOf":[{"anyOf":[{"type":"string","enum":["reputation_management"]}]},{"type":"string"}]},"quantity":{"type":"integer"},"counts":{"type":"object","properties":{"enabled":{"type":"integer"},"scheduledCancel":{"type":"integer"},"elapsed":{"type":"integer"},"absent":{"type":"integer"}},"required":["enabled","scheduledCancel","elapsed","absent"],"additionalProperties":false},"businesses":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"},"state":{"anyOf":[{"type":"string","enum":["enabled","scheduled_cancel","elapsed","absent"]},{"type":"string"}]},"until":{"anyOf":[{"type":"string"},{"type":"null"}]}},"required":["id","name","state","until"],"additionalProperties":false}},"truncated":{"type":"boolean"}},"required":["object","key","quantity","counts","businesses","truncated"],"additionalProperties":false}}},"required":["data"],"additionalProperties":false}}}},"401":{"description":"The bearer credential is missing or not usable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UnauthorizedEncoded"}}}},"403":{"description":"The credential is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ForbiddenEncoded"}}}},"404":{"description":"The requested tenant does not exist.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NotFoundEncoded"}}}}},"description":"Reports each billable feature's quantity (a cancellation scheduled ahead still counts; an elapsed one does not) and, per feature, every business in the account with its row state: enabled, scheduled_cancel, elapsed or absent. Filter with `feature`. Not paged; the businesses named per feature are capped while the counts cover them all. This is the feature-state mirror, not entitlement and not billing status. Stored facts only.","summary":"List features"}},"/v1/account/onboarding":{"get":{"tags":["Account"],"operationId":"accounts.listOnboarding","parameters":[{"name":"limit","in":"query","schema":{"type":"string","pattern":"^[+-]?\\d*\\.?\\d+(?:[Ee][+-]?\\d+)?$"},"required":false},{"name":"cursor","in":"query","schema":{"type":"string","description":"The nextCursor of the previous page. Leave it out for the first page."},"required":false},{"name":"status","in":"query","schema":{"type":"string","enum":["pending","completed","finalizing","finalized"],"description":"Only invites in this lifecycle state. `completed` means the invitee finished, not that the business was provisioned. Expired invites are listed whatever their state; they are marked, not filtered."},"required":false},{"name":"kind","in":"query","schema":{"type":"string","enum":["full","google_connect"],"description":"Only invites of this kind: `full` for the guided setup, `google_connect` for the Google-only link."},"required":false}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"array","items":{"type":"object","properties":{"object":{"type":"string","enum":["onboarding_invite"]},"id":{"type":"string"},"link":{"type":"string"},"kind":{"anyOf":[{"type":"string","enum":["full","google_connect"]},{"type":"string"}]},"features":{"type":"array","items":{"type":"object","properties":{"feature":{"anyOf":[{"anyOf":[{"type":"string","enum":["reputation_management"]}]},{"type":"string"}]}},"required":["feature"],"additionalProperties":false}},"status":{"anyOf":[{"type":"string","enum":["pending","completed","finalizing","finalized"]},{"type":"string"}]},"expired":{"type":"boolean"},"progress":{"type":"object","properties":{"googleConnected":{"type":"boolean"},"placeSelected":{"type":"boolean"},"imageResolved":{"type":"boolean"},"nameConfirmed":{"type":"boolean"}},"required":["googleConnected","placeSelected","imageResolved","nameConfirmed"],"additionalProperties":false},"candidateImages":{"type":"integer"},"recipient":{"anyOf":[{"type":"object","properties":{"name":{"anyOf":[{"type":"string"},{"type":"null"}]},"email":{"anyOf":[{"type":"string"},{"type":"null"}]},"phone":{"anyOf":[{"type":"string"},{"type":"null"}]}},"required":["name","email","phone"],"additionalProperties":false},{"type":"null"}]},"attachedBusiness":{"anyOf":[{"type":"object","properties":{"id":{"type":"string"},"name":{"anyOf":[{"type":"string"},{"type":"null"}]}},"required":["id","name"],"additionalProperties":false},{"type":"null"}]},"createdBusiness":{"anyOf":[{"type":"object","properties":{"id":{"type":"string"},"name":{"anyOf":[{"type":"string"},{"type":"null"}]}},"required":["id","name"],"additionalProperties":false},{"type":"null"}]},"expiresAt":{"type":"string"},"createdAt":{"type":"string"},"completedAt":{"anyOf":[{"type":"string"},{"type":"null"}]}},"required":["object","id","link","kind","features","status","expired","progress","candidateImages","recipient","attachedBusiness","createdBusiness","expiresAt","createdAt","completedAt"],"additionalProperties":false}},"hasMore":{"type":"boolean"},"nextCursor":{"anyOf":[{"type":"string"},{"type":"null"}]}},"required":["data","hasMore","nextCursor"],"additionalProperties":false}}}},"400":{"description":"The cursor is not one this endpoint issued.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/InvalidCursorEncoded"}}}},"401":{"description":"The bearer credential is missing or not usable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UnauthorizedEncoded"}}}},"403":{"description":"The credential is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ForbiddenEncoded"}}}},"404":{"description":"The requested tenant does not exist.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NotFoundEncoded"}}}}},"description":"Lists the account's business onboarding invites, newest first, with each one's link, kind, the features it sets up, lifecycle state, whether it has expired, how far the invitee got, its candidate photo count and the business it configures or created. `completed` means the invitee finished, not that the agency provisioned. Page with `cursor`; filter with `status` and `kind`. Never returns image data.","summary":"List onboarding invites"},"post":{"tags":["Account"],"operationId":"accounts.createOnboarding","parameters":[],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"type":"string","enum":["onboarding_invite"]},"id":{"type":"string"},"link":{"type":"string"},"kind":{"anyOf":[{"type":"string","enum":["full","google_connect"]},{"type":"string"}]},"features":{"type":"array","items":{"type":"object","properties":{"feature":{"anyOf":[{"anyOf":[{"type":"string","enum":["reputation_management"]}]},{"type":"string"}]}},"required":["feature"],"additionalProperties":false}},"status":{"anyOf":[{"type":"string","enum":["pending","completed","finalizing","finalized"]},{"type":"string"}]},"expired":{"type":"boolean"},"progress":{"type":"object","properties":{"googleConnected":{"type":"boolean"},"placeSelected":{"type":"boolean"},"imageResolved":{"type":"boolean"},"nameConfirmed":{"type":"boolean"}},"required":["googleConnected","placeSelected","imageResolved","nameConfirmed"],"additionalProperties":false},"candidateImages":{"type":"integer"},"recipient":{"anyOf":[{"type":"object","properties":{"name":{"anyOf":[{"type":"string"},{"type":"null"}]},"email":{"anyOf":[{"type":"string"},{"type":"null"}]},"phone":{"anyOf":[{"type":"string"},{"type":"null"}]}},"required":["name","email","phone"],"additionalProperties":false},{"type":"null"}]},"attachedBusiness":{"anyOf":[{"type":"object","properties":{"id":{"type":"string"},"name":{"anyOf":[{"type":"string"},{"type":"null"}]}},"required":["id","name"],"additionalProperties":false},{"type":"null"}]},"createdBusiness":{"anyOf":[{"type":"object","properties":{"id":{"type":"string"},"name":{"anyOf":[{"type":"string"},{"type":"null"}]}},"required":["id","name"],"additionalProperties":false},{"type":"null"}]},"expiresAt":{"type":"string"},"createdAt":{"type":"string"},"completedAt":{"anyOf":[{"type":"string"},{"type":"null"}]},"friendlyName":{"anyOf":[{"type":"string"},{"type":"null"}]},"selectedPlace":{"anyOf":[{"type":"object","properties":{"accountName":{"anyOf":[{"type":"string"},{"type":"null"}]},"locationName":{"anyOf":[{"type":"string"},{"type":"null"}]},"placeId":{"anyOf":[{"type":"string"},{"type":"null"}]},"title":{"anyOf":[{"type":"string"},{"type":"null"}]},"address":{"anyOf":[{"type":"string"},{"type":"null"}]}},"required":["accountName","locationName","placeId","title","address"],"additionalProperties":false},{"type":"null"}]},"finalizationStartedAt":{"anyOf":[{"type":"string"},{"type":"null"}]},"billingSettledAt":{"anyOf":[{"type":"string"},{"type":"null"}]},"finalizedAt":{"anyOf":[{"type":"string"},{"type":"null"}]},"finalizationWarnings":{"type":"array","items":{"type":"string"}}},"required":["object","id","link","kind","features","status","expired","progress","candidateImages","recipient","attachedBusiness","createdBusiness","expiresAt","createdAt","completedAt","friendlyName","selectedPlace","finalizationStartedAt","billingSettledAt","finalizedAt","finalizationWarnings"],"additionalProperties":false}}}},"401":{"description":"The bearer credential is missing or not usable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UnauthorizedEncoded"}}}},"403":{"description":"The credential is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ForbiddenEncoded"}}}},"404":{"description":"The requested tenant does not exist.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NotFoundEncoded"}}}}},"description":"Makes a business onboarding invite for a NEW business and returns it with its `link`, the page the business owner opens to connect their Google Business Profile, confirm their place, pick a photo and confirm the business name. Nothing is sent: give the link to the business owner yourself. `features` names what the invite sets up (today `reputation_management`, the one there is); `recipient.email` is the owner's address, who is given access to the business once it is created from the finished invite. The link is on the account's white-label domain when it has a usable one, and stops working 14 days after it was made. Whoever holds it can complete the invite, so send it only to the business owner. The business itself is created, and billed, from the finished invite in the account app.","summary":"Create an onboarding invite","requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"features":{"type":"array","items":{"type":"object","properties":{"feature":{"anyOf":[{"type":"string","enum":["reputation_management"]}],"description":"What to set up: reputation_management."}},"required":["feature"],"additionalProperties":false}},"recipient":{"type":"object","properties":{"email":{"type":"string","pattern":"^[^\\s@/]+@[^\\s@/]+\\.[^\\s@/]+$","maxLength":254,"description":"The business owner's email address. Saved in lowercase. When the business is created from the invite, this person is given access to it with this address. Nothing is emailed to it now."},"name":{"type":"string","description":"The business owner's name, as the invite greets them."},"phone":{"type":"string","pattern":"^\\+[1-9]\\d{6,14}$","description":"The business owner's phone number, in the international format (+15125550100)."}},"required":["email"],"additionalProperties":false,"description":"Who the invite is for: the person who will own the business."},"businessName":{"type":"string","maxLength":80,"description":"The business's name, at most 80 characters. The business owner sees it filled in and confirms or changes it."}},"required":["features","recipient"],"additionalProperties":false}}},"required":true}}},"/v1/account/onboarding/{onboardingId}":{"get":{"tags":["Account"],"operationId":"accounts.getOnboarding","parameters":[{"name":"onboardingId","in":"path","schema":{"type":"string"},"required":true}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"type":"string","enum":["onboarding_invite"]},"id":{"type":"string"},"link":{"type":"string"},"kind":{"anyOf":[{"type":"string","enum":["full","google_connect"]},{"type":"string"}]},"features":{"type":"array","items":{"type":"object","properties":{"feature":{"anyOf":[{"anyOf":[{"type":"string","enum":["reputation_management"]}]},{"type":"string"}]}},"required":["feature"],"additionalProperties":false}},"status":{"anyOf":[{"type":"string","enum":["pending","completed","finalizing","finalized"]},{"type":"string"}]},"expired":{"type":"boolean"},"progress":{"type":"object","properties":{"googleConnected":{"type":"boolean"},"placeSelected":{"type":"boolean"},"imageResolved":{"type":"boolean"},"nameConfirmed":{"type":"boolean"}},"required":["googleConnected","placeSelected","imageResolved","nameConfirmed"],"additionalProperties":false},"candidateImages":{"type":"integer"},"recipient":{"anyOf":[{"type":"object","properties":{"name":{"anyOf":[{"type":"string"},{"type":"null"}]},"email":{"anyOf":[{"type":"string"},{"type":"null"}]},"phone":{"anyOf":[{"type":"string"},{"type":"null"}]}},"required":["name","email","phone"],"additionalProperties":false},{"type":"null"}]},"attachedBusiness":{"anyOf":[{"type":"object","properties":{"id":{"type":"string"},"name":{"anyOf":[{"type":"string"},{"type":"null"}]}},"required":["id","name"],"additionalProperties":false},{"type":"null"}]},"createdBusiness":{"anyOf":[{"type":"object","properties":{"id":{"type":"string"},"name":{"anyOf":[{"type":"string"},{"type":"null"}]}},"required":["id","name"],"additionalProperties":false},{"type":"null"}]},"expiresAt":{"type":"string"},"createdAt":{"type":"string"},"completedAt":{"anyOf":[{"type":"string"},{"type":"null"}]},"friendlyName":{"anyOf":[{"type":"string"},{"type":"null"}]},"selectedPlace":{"anyOf":[{"type":"object","properties":{"accountName":{"anyOf":[{"type":"string"},{"type":"null"}]},"locationName":{"anyOf":[{"type":"string"},{"type":"null"}]},"placeId":{"anyOf":[{"type":"string"},{"type":"null"}]},"title":{"anyOf":[{"type":"string"},{"type":"null"}]},"address":{"anyOf":[{"type":"string"},{"type":"null"}]}},"required":["accountName","locationName","placeId","title","address"],"additionalProperties":false},{"type":"null"}]},"finalizationStartedAt":{"anyOf":[{"type":"string"},{"type":"null"}]},"billingSettledAt":{"anyOf":[{"type":"string"},{"type":"null"}]},"finalizedAt":{"anyOf":[{"type":"string"},{"type":"null"}]},"finalizationWarnings":{"type":"array","items":{"type":"string"}}},"required":["object","id","link","kind","features","status","expired","progress","candidateImages","recipient","attachedBusiness","createdBusiness","expiresAt","createdAt","completedAt","friendlyName","selectedPlace","finalizationStartedAt","billingSettledAt","finalizedAt","finalizationWarnings"],"additionalProperties":false}}}},"401":{"description":"The bearer credential is missing or not usable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UnauthorizedEncoded"}}}},"403":{"description":"The credential is not permitted to perform this operation.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ForbiddenEncoded"}}}},"404":{"description":"The requested tenant does not exist.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NotFoundEncoded"}}}}},"description":"Returns one onboarding invite the account owns: the list's facts (its link among them) plus the confirmed name, the Google location the invitee chose, the candidate photo count and the finalization timestamps and warnings. An invite outside the account is reported as not found. Never returns image data or any Google credential.","summary":"Retrieve an onboarding invite"}},"/v1/account/providers":{"get":{"tags":["Account"],"operationId":"accounts.listProviderConnections","parameters":[{"name":"limit","in":"query","schema":{"type":"string","pattern":"^[+-]?\\d*\\.?\\d+(?:[Ee][+-]?\\d+)?$"},"required":false},{"name":"cursor","in":"query","schema":{"type":"string","description":"The nextCursor of the previous page. Leave it out for the first page."},"required":false},{"name":"provider","in":"query","schema":{"type":"string","enum":["ghl","twilio","sendgrid","mailgun","signalhouse"],"description":"Only connections to this provider."},"required":false},{"name":"status","in":"query","schema":{"type":"string","enum":["pending","active","error","disabled"],"description":"Only connections in this status. Disabled connections are listed unless you filter them out."},"required":false},{"name":"owner","in":"query","schema":{"type":"string","enum":["account","organization","business"],"description":"Only connections owned at this tier: the account itself, an organization, or a business."},"required":false}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"array","items":{"type":"object","properties":{"object":{"type":"string","enum":["provider_connection"]},"id":{"type":"string"},"provider":{"anyOf":[{"type":"string","enum":["ghl","twilio","sendgrid","mailgun","signalhouse"]},{"type":"string"}]},"label":{"anyOf":[{"type":"string"},{"type":"null"}]},"status":{"anyOf":[{"type":"string","enum":["pending","active","error","disabled"]},{"type":"string