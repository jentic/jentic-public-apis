. Only sites with an error appear, the most recent first; `totals` counts each kind in scope. Every site of the account unless `site` names one (404 when it is not the account's). Read each kind's failures at `/v1/account/site-functions/failures` and `/v1/account/site-errors/email`.","summary":"Site errors overview"}},"/v1/account/site-errors/email":{"get":{"tags":["Site errors"],"operationId":"accountSiteErrors.emailFailures","parameters":[{"name":"site","in":"query","schema":{"type":"string","minLength":1,"description":"Only this site's email failures, by the site's id. Left out: every site of the account."},"required":false},{"name":"submission","in":"query","schema":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9]{0,63}$","description":"Only this submission's email failures, by the submission's name (unique on its site; name the site too when two sites share it)."},"required":false},{"name":"failure","in":"query","schema":{"type":"string","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$","description":"Only this one email failure, by its id: shown whole."},"required":false},{"name":"days","in":"query","schema":{"type":"string","pattern":"^[+-]?\\d*\\.?\\d+(?:[Ee][+-]?\\d+)?$"},"required":false},{"name":"limit","in":"query","schema":{"type":"string","pattern":"^[+-]?\\d*\\.?\\d+(?:[Ee][+-]?\\d+)?$"},"required":false},{"name":"cursor","in":"query","schema":{"type":"string","description":"Where the page before ended (nextCursor), to list the failures after it."},"required":false}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"type":"string","enum":["site_email_failure_list"]},"days":{"anyOf":[{"type":"number"},{"type":"string","enum":["Infinity","-Infinity","NaN"]}]},"since":{"type":"string"},"until":{"type":"string"},"site":{"anyOf":[{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"}},"required":["id","