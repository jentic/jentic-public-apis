"},"senderId":{"anyOf":[{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"},{"type":"null"}]}},"required":["siteId","senderId"],"additionalProperties":false}]},{"type":"null"}]},"error":{"anyOf":[{"type":"object","properties":{"reason":{"type":"string","enum":["not_implemented","refused","unexpected"]},"message":{"type":"string"}},"required":["reason","message"],"additionalProperties":false},{"type":"null"}]},"approval":{"type":"string","enum":["human_required","agent_allowed"],"description":"Approval requirement of the included items. Submission must recheck it."}},"required":["mutationType","schemaVersion","input","id","groupId","selection","applyStatus","attempts","result","error","approval"],"additionalProperties":false},{"type":"object","properties":{"mutationType":{"type":"string","enum":["business_review_request_config"]},"schemaVersion":{"type":"number","enum":[1]},"input":{"type":"object","properties":{"businessId":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid","description":"Business to change, in the authenticated account, as businesses list returns it. A saved proposal's business cannot change."},"timezone":{"type":"string","allOf":[{"description":"IANA timezone the sending hours and daily limits follow, such as America/Chicago."}]},"sendWindowStart":{"type":"string","allOf":[{"description":"Start of sending hours, HH:MM (24-hour) in the business's timezone: 08:00 at the earliest, and before the end."}]},"sendWindowEnd":{"type":"string","allOf":[{"description":"End of sending hours, HH:MM (24-hour) in the business's timezone: 20:00 at the latest, and after the start. A request due outside the hours waits for them to open."}]},"realtimeDelay":{"type":"string","enum":["immediately","few-hours","1d","2d","3d","4d"],"description":"How long after a new contact's visit or event the first review request goes out: immediately, few-hours (6 hours), 1d, 2d, 3d or 4d (the longest). Sending hours still apply. Live settings report it in seconds (4d is 345600)."},"minMessageGapDays":{"type":"integer","minimum":1,"maximum":2,"description":"Days between two messages to the same person, follow-ups included: 1 or 2. Does not turn follow-ups on or off."},"maxReactivationPerDay":{"type":"integer","minimum":0,"maximum":100,"description":"Daily limit for returning contacts (older contacts being asked again, such as an imported customer list), 0 to 100. Counted apart from new contacts, so a backlog never uses their allowance."},"maxRealtimePerDay":{"type":"integer","minimum":0,"maximum":50,"description":"Daily limit for new contacts (arriving through new visits or events), 0 to 50. Counted apart from returning contacts."},"resendEnabled":{"type":"boolean","description":"Whether a contact who was already messaged can be asked again. It takes a new visit or event arriving after the resend window; time alone never sends another request. Off: nobody is asked twice."},"resendWindowDays":{"type":"integer","minimum":30,"maximum":365,"description":"Days since the last message before a new visit or event can make a contact eligible again, 30 to 365. Only applies while resend is on, and setting it does not turn resend on."},"sendToReviewedContacts":{"type":"boolean","description":"Whether contacts who already left a review can be asked again."},"defaultPhoneRegion":{"type":"string","pattern":"^[A-Za-z]{2}$"},"personalizedImageEnabled":{"type":"boolean","description":"Whether the first request includes a personalized image, when one is available."},"phoneChannelEnabled":{"type":"boolean","description":"Whether review requests go out by text message. Text and email cannot both be off. Turn it off when the business has no phone provider, so the missing provider does not hold back its email requests."},"emailChannelEnabled":{"type":"boolean","description":"Whether review requests go out by email. Text and email cannot both be off. Turn it off when the business has no email provider, so the missing provider does not hold back its text requests."},"messages":{"type":"string","enum":["smart","own"],"description":"Which messages review requests use: smart (the platform's own) or own (the sequences written for this business, its organization or the account). With own, a channel none of those sequences covers still sends smart messages."},"phoneSender":{"anyOf":[{"type":"string","enum":["rotate"]},{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"}],"description":"Which phone sender review requests by text message go out from: rotate, to rotate between every phone sender the business can use, or one sender's id, as the business's messaging read lists it, to always use that one."},"emailSender":{"anyOf":[{"type":"string","enum":["rotate"]},{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"}],"description":"Which email sender review requests by email go out from: rotate, to rotate between every email sender the business can use, or one sender's id, as the business's messaging read lists it, to always use that one."},"emailTemplate":{"type":"string","enum":["plain","clean-card","bold-header","minimal-mono","friendly-rounded"],"description":"The email design review requests use: plain, clean-card, bold-header, minimal-mono or friendly-rounded (the app's Email template gallery), with that design's default colors."},"autoReplyEnabled":{"type":"boolean","description":"Whether a contact who replies asking for service (to book an appointment, say) gets an automatic answer: that this channel only sends review requests, and to contact the business directly."},"followUpsEnabled":{"type":"boolean","description":"Whether follow-up reminders go out after the first review request."}},"required":["businessId"],"additionalProperties":false},"id":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"},"groupId":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"},"selection":{"type":"string","enum":["included","withdrawn","rejected"]},"applyStatus":{"type":"string","enum":["not_started","running","applied","failed"]},"attempts":{"type":"integer","minimum":0},"result":{"anyOf":[{"anyOf":[{"type":"object","properties":{"businessId":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"},"site":{"anyOf":[{"type":"object","properties":{"id":{"type":"string"},"created":{"type":"boolean"}},"required":["id","created"],"additionalProperties":false},{"type":"null"}]}},"required":["businessId","site"],"additionalProperties":false},{"type":"object","properties":{"businessId":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|[fF]{8}-[fF]{4}-[fF]{4}-[fF]{4}-[fF]{12})$","format":"uuid"}},"required":["businessId"],"additionalProperties":false},{"type":"object","properties":{"businessId":{"type":"string","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-f