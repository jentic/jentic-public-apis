not exist.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NotFoundEncoded"}}}}},"description":"Lists the account's custom domains of both kinds, newest first: client portal domains (the account's own) and review-link domains (the account's or one of its organizations'), each with its owner, Cloudflare's stored hostname and certificate status, our health verdict and the recorded fault's tag, plus totals per kind, per health state and per owner tier over the filtered population. Healthy domains are included. Page with `cursor`; filter with `kind`, `status`, `health` and `owner`. Use a row's id with `GET /v1/account/domains/{domainId}` for the DNS records the domain requires and the fault's evidence. Stored status only; no DNS lookup is performed.","summary":"List domains"}},"/v1/account/domains/{domainId}":{"get":{"tags":["Account"],"operationId":"accounts.getDomain","parameters":[{"name":"domainId","in":"path","schema":{"type":"string"},"required":true}],"security":[{"bearerAuth":[]}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"object","properties":{"object":{"type":"string","enum":["domain"]},"id":{"type":"string"},"hostname":{"type":"string"},"kind":{"anyOf":[{"type":"string","enum":["client","destination"]},{"type":"string"}]},"owner":{"type":"object","properties":{"scope":{"anyOf":[{"type":"string","enum":["account","organization","business"]},{"type":"string"}]},"id":{"type":"string"},"name":{"type":"string"}},"required":["scope","id","name"],"additionalProperties":false},"status":{"anyOf":[{"type":"string","enum":["pending","verifying","active","failed","moved"]},{"type":"string"}]},"sslStatus":{"anyOf":[{"type":"string"},{"type":"null"}]},"health":{"type":"object","properties":{"state":{"anyOf":[{"type":"string","enum":["checking","healthy","waiting","needs_you","needs_us"]},{"type":"string"}]},"fault":{"anyOf":[{"type":"object","properties":{"code":{"type":"string"},"evidence":{"anyOf":[