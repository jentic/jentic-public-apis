e_balance","trade_weighted_index","unemployment","wages"],"PEN":["foreign_reserves","gov_bond_10y","trade_weighted_index"],"SEK":["employment","gdp","gov_bond_10y","gov_bond_2y","gov_bond_5y","gov_bond_7y","inflation","participation_rate","policy_rate","risk_free_rate","trade_balance","trade_weighted_index","unemployment"],"THB":["core_inflation","current_account_balance","employment","gdp","gov_bond_10y","gov_bond_2y","gov_bond_3y","gov_bond_5y","inflation","m1","m2","participation_rate","policy_rate","ppi","trade_balance","unemployment"],"TWD":["employment","foreign_reserves","participation_rate","risk_free_rate","trade_weighted_index","unemployment"],"USD":["afe_dollar_index","average_hourly_earnings","average_hourly_earnings_mom","bgcr","breakeven_inflation_rate","broad_dollar_index","building_permits","business_confidence","cb_assets","consumer_confidence","core_inflation","core_inflation_mom","core_pce","core_pce_mom","crude_oil_inventories","current_account_balance","durable_goods_orders","effr","eme_dollar_index","employment","foreign_reserves","full_time_employment","gdp","gdp_growth_q4_yoy","gold_reserves","gov_bond_10y","gov_bond_1_5m","gov_bond_1m","gov_bond_1y","gov_bond_20y","gov_bond_2m","gov_bond_2y","gov_bond_30y","gov_bond_3m","gov_bond_3y","gov_bond_4m","gov_bond_5y","gov_bond_6m","gov_bond_7y","government_debt","house_price_index","housing_starts","import_prices","industrial_production","inflation","inflation_linked_bond","inflation_mom","initial_jobless_claims","job_openings","m1","m2","nairu","natural_gas_storage","non_farm_payrolls","non_farm_payrolls_change","obfr","part_time_employment","participation_rate","pce","pce_mom","policy_rate","policy_rate_midpoint","policy_rate_target_lower","ppi","productivity","real_yield_20y","real_yield_30y","real_yield_5y","real_yield_7y","retail_sales","retail_sales_control_group","retail_sales_ex_autos","retail_sales_ex_autos_and_gas","risk_free_rate","sofr_average_180d","sofr_average_30d","sofr_average_90d","sofr_index","tgcr","trade_balance","trade_weighted_index","unemployment","wages"]}}}},"/v1/announcements/{currency}/{indicator}":{"get":{"tags":["announcements"],"summary":"Get macroeconomic indicator data","description":"Fetches historical data for a given macroeconomic indicator of a currency.\n\n**Authentication & limits:**\n- USD data is publicly accessible without an API key, but anonymous callers are limited to the most recent 90 days. Requests for an earlier `start_date` are clamped to that 90-day window, and the response then carries a `freemium_window` object naming the cutoff so a shortened history is distinguishable from a short series.\n- Anonymous USD data is also delayed by 15 minutes. A release is served once it is 15 minutes old; until then it is withheld, and `latest_available_date` reports the newest observation the caller can actually read. Every anonymous response carries a `freemium_delay` object naming the cutoff, the number of withheld releases and when the next one becomes available. An API key removes the delay.\n- All other currencies require an Individual or Business API key supplied via `?api_key=<key>` or the `X-API-Key` header.\n- Authenticated callers (any valid API key) receive the full requested history for every supported currency, including USD.\n\n**Path Parameters:**\n- `currency`: The 3-letter currency code (USD, AUD, EUR, GBP, CHF).\n- `indicator`: The indicator name (e.g., inflation, unemployment).\n\n**Query Parameters:**\n- `start_date`: Optional. Start date in YYYY-MM-DD format. When omitted by authenticated callers, the endpoint pages through the full available history. Anonymous USD requests are capped to the freemium window.\n- `end_date`: Optional. End date in YYYY-MM-DD format. Defaults to today.\n\n- `limit`: Optional page size. Defaults to 20.\n- `page`: Optional one-based page number. When provided, it takes precedence over `offset`.\n- `offset`: Optional zero-based row offset for offset-based pagination.\n\n- `series_mode`: Optional. `raw` (default) selects the direct underlying indicator series; `canonical` applies configured remaps.\n- `value_mode`: `normalized` (default) returns presentation-ready values. `source` requires `series_mode=raw` and returns values and revision values as published by the source, without normalization, derived changes, companion fills or carry-forward. Use source mode for historical research. The response declares `value_mode` and `value_metadata.source_unit`; an unknown source unit is null.\n\n**Empty windows:**\n- A valid series with no observations inside the requested window returns `200` with `data: []`, `requested_window_has_data: false`, and a `no_data` object carrying `error_code`, `latest_available_date`, `recommended_start_date` and `available_observation_count`. This is a successful query, not an error, and should not be retried; widen the window instead.\n- Anonymous USD callers see this whenever a quarterly or annual series' latest observation predates the 90-day freemium window; `no_data.freemium_clamped` marks that case.\n- `404` on this endpoint means the currency or indicator slug is not published. Use `/v1/data_catalogue/{currency}` to list valid slugs.\n\n**Response fields:**\n- `remap`: Metadata about the canonical remap rule application (`applied`, `rule_id`, segments, and transform mode).\n- `has_official_forecast`: Whether the relevant central bank or statistics agency publishes a preliminary, flash, or advance estimate of this indicator before the main/final data release.\n- `earliest_available_date` / `latest_available_date`: The full coverage span available in the response window before any pagination is applied.\n- `pagination`: Page metadata for the returned `data[]` slice (`limit`, `offset`, `returned_count`, `total_count`, `has_more`, `next_offset`).\n- `data[].announcement_id`: Stable identifier for this unique announcement, in the form `{currency}_{indicator}_{date}` (lowercase, e.g. `usd_inflation_2026-01-31`). Use this to join predictions from `/v1/predictions/{currency}/{indicator}` and revision history back to the underlying observation.\n- `data[].announcement_datetime`: Release timestamp as Unix epoch seconds (UTC).\n- `data[].announcement_datetime_local`: ISO 8601 release time with offset, rendered in the source agency's local timezone (e.g. USD → America/New_York, AUD → Australia/Sydney).\n- `data[].official_planned_release_datetime`: Official planned release timestamp from the publisher's release calendar, as Unix epoch seconds (UTC). Present when the release was captured against a pre-announced official release time.\n- `data[].official_actual_release_datetime`: Official release timestamp on the source row, as Unix epoch seconds (UTC). This is normally the same as `announcement_datetime` unless the source exposes a separate publication timestamp.\n- `data[].collected_at_ns` / `data[].collected_at_iso`: Exact time FXMacroData first captured this row from the official source.\n- `data[].release_timing`: On rows captured at release time, the three times for that release: `scheduled_at` (official schedule), `published_at` (when the official source actually published it) and `available_at` (when it was readable through the API), with `latency_ms` from publication to `available_at` and `publication_delay_ms` from the schedule to publication. Latency is measured from publication, never from the schedule. Also the government publication window `published_after` / `published_by` bounded by reads of the official source (null when it could not be bounded; not a publisher-supplied timestamp), and `collected_at` (when FXMacroData captured the value). Rows that record it also carry `available_at` (when the value was readable through the API) with `pickup_ms_min` / `pickup_ms_max`, the milliseconds from the publication window to `available_at`; these are null when not recorded. Null here means the measurement was not taken for that capture (the window bounds and `available_at` are recorded only for releases captured after those measurements were introduced), never that the release was late or the value is in doubt.\n- `data[].publication_time_status`: what `announcement_datetime` is evidence of - `confirmed` (the publisher's own timestamp), `unverified` (a real timestamp whose origin the row does not prove; with `publication_time_basis=official_schedule` it is the publisher's scheduled release instant that the value was captured against), `assumed_historical` (derived from measured lag, pre-launch rows only) or `unknown` (no time; the row is served on its period date). A schedule instant is never promoted to `confirmed`.\n- `fields=compact`: trims each row to `date`, `val`, `previous_value`, `change_from_previous`, `announcement_datetime`, `announcement_datetime_local` and `publication_time_status`, with `revisions[]` folded into `revisions_summary`. The envelope, pagination and `dataset_version` are the same as the full view.\n- `source_series_name`: The actual underlying source series used for this standardized indicator.\n- `value_name`: The actual series name used for the returned `val`. For `policy_rate`, this is the canonical policy-series label chosen by the platform (for example, ECB Deposit Facility Rate or Federal Funds Target Range Upper Bound).\n- `source_local_name`: Official local-language series label when available.\n- `is_proxy`: True when the standardized indicator is populated using a documented proxy rather than a directly named national headline series.\n- `proxy_note`: Short explanation of the proxy choice when `is_proxy=true`.\n- `policy_role`: For `policy_rate`, the role of the canonical rate inside its official rate family (for example `primary` or `target_upper`).\n- `policy_structure`: For `policy_rate`, the policy-regime structure such as `single_primary`, `target_range`, `primary_plus_corridor`, or `non_rate_regime`.\n- `comparison_compatible`: For `policy_rate`, whether the returned `val` can be honestly used in cross-country policy-rate comparisons.\n- `policy_family`: Optional top-level metadata listing sibling policy-rate indicators in the same official family.\n- `data[].predicted_value` *(deprecated — use `/v1/predictions/{currency}/{indicator}` instead)*: Market or professional-forecaster expectation for this indicator reading, in the same units as `val`. Present only where a prediction source is available.\n- `data[].prediction_type` *(deprecated — use `/v1/predictions/{currency}/{indicator}` instead)*: Legacy per-source category. See `prediction_class` on `/v1/predictions` for the consolidated axis: `market_consensus` covers both compiled consensus and forecaster surveys, and `market_prediction` is market-implied, not a survey.\n- `data[].prediction_source` *(deprecated — use `/v1/predictions/{currency}/{indicator}` instead)*: Stable identifier for the prediction source (e.g. `ecb_spf` for the ECB Survey of Professional Forecasters). Null when `predicted_value` is absent.","operationId":"get_indicator_data_v1_announcements__currency___indicator__get","parameters":[{"name":"currency","in":"path","required":true,"schema":{"type":"string","title":"Currency","enum":["AUD","BRL","CAD","CHF","CNH","CNY","DKK","EUR","GBP","HUF","ILS","JPY","KRW","MYR","NGN","NOK","NZD","PEN","SEK","THB","TWD","USD"],"example":"AUD"},"description":"Required path parameter. Allowed values: AUD, BRL, CAD, CHF, CNH, CNY, DKK, EUR, GBP, HUF, ILS, JPY, KRW, MYR, NGN, NOK, NZD, PEN, SEK, THB, TWD, USD."},{"name":"indicator","in":"path","required":true,"schema":{"type":"string","title":"Indicator","enum":["afe_dollar_index","average_hourly_earnings","average_hourly_earnings_mom","balance_on_goods","balance_on_services","bgcr","breakeven_inflation_rate","broad_dollar_index","broad_money","building_approvals","building_permits","business_confidence","capital_account_balance","cb_assets","commodity_price_energy","commodity_price_ex_energy","commodity_price_index","commodity_prices","consumer_confidence","core_inflation","core_inflation_median","core_inflation_mom","core_inflation_trim","core_pce","core_pce_mom","credit_growth","crude_oil_inventories","current_account_balance","dairy_exports","deposit_rates","durable_goods_orders","effr","eme_dollar_index","employment","exports","financial_account_balance","foreign_reserves","full_time_employment","fx_reserves","gdp","gdp_growth_q4_yoy","gold_reserves","gov_bond_10y","gov_bond_15y","gov_bond_1_5m","gov_bond_1m","gov_bond_1y","gov_bond_20y","gov_bond_25y","gov_bond_2m","gov_bond_2y","gov_bond_30y","gov_bond_3m","gov_bond_3y","gov_bond_40y","gov_bond_4m","gov_bond_4y","gov_bond_5y","gov_bond_6m","gov_bond_6y","gov_bond_7y","gov_bond_8y","gov_bond_9y","government_debt","house_price_index","house_prices","household_credit","household_spending","housing_starts","import_prices","imports","industrial_production","inflation","inflation_linked_bond","inflation_mom","initial_jobless_claims","international_assets","international_liabilities","job_openings","m1","m2","m3","nairu","natural_gas_storage","net_foreign_asset_position","non_farm_payrolls","non_farm_payrolls_change","obfr","part_time_employment","participation_rate","pce","pce_mom","policy_rate","policy_rate_midpoint","policy_rate_mlf","policy_rate_mro","policy_rate_target_lower","ppi","primary_income_balance","productivity","real_yield_20y","real_yield_30y","real_yield_5y","real_yield_7y","retail_sales","retail_sales_control_group","retail_sales_ex_autos","retail_sales_ex_autos_and_gas","risk_free_rate","secondary_income_balance","sight_deposits","snb_balance_sheet","sofr_average_180d","sofr_average_30d","sofr_average_90d","sofr_index","terms_of_trade","tgcr","trade_balance","trade_weighted_index","trimmed_mean_inflation","unemployment","wage_price_index","wages"],"example":"afe_dollar_index"},"description":"Required path parameter. Allowed values: afe_dollar_index, average_hourly_earnings, average_hourly_earnings_mom, balance_on_goods, balance_on_services, bgcr, breakeven_inflation_rate, broad_dollar_index, broad_money, building_approvals, building_permits, business_confidence, capital_account_balance, cb_assets, commodity_price_energy, commodity_price_ex_energy, commodity_price_index, commodity_prices, consumer_confidence, core_inflation, core_inflation_median, core_inflation_mom, core_inflation_trim, core_pce, core_pce_mom, credit_growth, crude_oil_inventories, current_account_balance, dairy_exports, deposit_rates, durable_goods_orders, effr, eme_dollar_index, employment, exports, financial_account_balance, foreign_reserves, full_time_employment, fx_reserves, gdp, gdp_growth_q4_yoy, gold_reserves, gov_bond_10y, gov_bond_15y, gov_bond_1_5m, gov_bond_1m, gov_bond_1y, gov_bond_20y, gov_bond_25y, gov_bond_2m, gov_bond_2y, gov_bond_30y, gov_bond_3m, gov_bond_3y, gov_bond_40y, gov_bond_4m, gov_bond_4y, gov_bond_5y, gov_bond_6m, gov_bond_6y, gov_bond_7y, gov_bond_8y, gov_bond_9y, government_debt, house_price_index, house_prices, household_credit, household_spending, housing_starts, import_prices, imports, industrial_production, inflation, inflation_linked_bond, inflation_mom, initial_jobless_claims, international_assets, international_liabilities, job_openings, m1, m2, m3, nairu, natural_gas_storage, net_foreign_asset_position, non_farm_payrolls, non_farm_payrolls_change, obfr, part_time_employment, participation_rate, pce, pce_mom, policy_rate, policy_rate_midpoint, policy_rate_mlf, policy_rate_mro, policy_rate_target_lower, ppi, primary_income_balance, productivity, real_yield_20y, real_yield_30y, real_yield_5y, real_yield_7y, retail_sales, retail_sales_control_group, retail_sales_ex_autos, retail_sales_ex_autos_and_gas, risk_free_rate, secondary_income_balance, sight_deposits, snb_balance_sheet, sofr_average_180d, sofr_average_30d, sofr_average_90d, sofr_index, terms_of_trade, tgcr, trade_balance, trade_weighted_index, trimmed_mean_inflation, unemployment, wage_price_index, wages."},{"name":"start_date","in":"query","required":false,"schema":{"type":"string","description":"Start date YYYY-MM-DD","examples":["2025-01-01"],"title":"Start Date"},"description":"Optional query parameter. Start date YYYY-MM-DD"},{"name":"end_date","in":"query","required":false,"schema":{"type":"string","description":"End date YYYY-MM-DD","examples":["2026-03-01"],"title":"End Date"},"description":"Optional query parameter. End date YYYY-MM-DD"},{"name":"series_mode","in":"query","required":false,"schema":{"type":"string","pattern":"^(raw|canonical)$","description":"Optional series rendering mode. `canonical` applies configured remap rules (for continuity across methodology transitions). `raw` returns the direct indicator series without remapping.","examples":["raw"],"default":"raw","title":"Series Mode"},"description":"Optional query parameter. Optional series rendering mode. `canonical` applies configured remap rules (for continuity across methodology transitions). `raw` returns the direct indicator series without remapping."},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","maximum":100,"minimum":1,"description":"Maximum number of rows to return in `data[]`. Rows are ordered most-recent-first, so `limit=10` returns the 10 most recent observations within the requested window. Use together with `offset` to page through long histories. Defaults to 20. Maximum 100.","examples":[20],"default":20,"title":"Limit"},"description":"Optional query parameter. Maximum number of rows to return in `data[]`. Rows are ordered most-recent-first, so `limit=10` returns the 10 most recent observations within the requested window. Use together with `offset` to page through long histories. Defaults to 20. Maximum 100."},{"name":"offset","in":"query","required":false,"schema":{"type":"integer","minimum":0,"description":"Number of rows to skip from the start of `data[]` (after most-recent-first ordering). Use with `limit` for pagination. Defaults to 0.","examples":[0],"default":0,"title":"Offset"},"description":"Optional query parameter. Number of rows to skip from the start of `data[]` (after most-recent-first ordering). Use with `limit` for pagination. Defaults to 0."},{"name":"page","in":"query","required":false,"schema":{"anyOf":[{"type":"integer","minimum":1},{"type":"null"}],"description":"One-based page number for callers that prefer page-based pagination. When supplied, `offset` is derived as `(page - 1) * limit`.","examples":[1],"title":"Page"},"description":"Optional query parameter. One-based page number for callers that prefer page-based pagination. When supplied, `offset` is derived as `(page - 1) * limit`."},{"name":"seasonality","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Optional seasonal adjustment selector. Supported public values are `sa` and `nsa`; check `supported_options.seasonality` in the response/catalogue for values available on this endpoint.","examples":["sa"],"title":"Seasonality","enum":["sa","nsa"],"example":"sa"},"description":"Optional query parameter. Optional seasonal adjustment selector. Supported public values are `sa` and `nsa`; check `supported_options.seasonality` in the response/catalogue for values available on this endpoint. Allowed values: sa, nsa."},{"name":"frequency","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Optional returned change basis. Supported public values are `level`, `yoy`, `qoq`, and `mom`; check `supported_options.frequency` for values available on this endpoint.","examples":["yoy"],"title":"Frequency","enum":["level","yoy","qoq","mom"],"example":"level"},"description":"Optional query parameter. Optional returned change basis. Supported public values are `level`, `yoy`, `qoq`, and `mom`; check `supported_options.frequency` for values available on this endpoint. Allowed values: level, yoy, qoq, mom."},{"name":"annualization","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Optional annualization selector. Supported public values are `not_annualized` and `saar`; check `supported_options.annualization` for values available on this endpoint.","examples":["saar"],"title":"Annualization","enum":["not_annualized","saar"],"example":"not_annualized"},"description":"Optional query parameter. Optional annualization selector. Supported public values are `not_annualized` and `saar`; check `supported_options.annualization` for values available on this endpoint. Allowed values: not_annualized, saar."},{"name":"period_aggregation","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Optional period-aggregation selector. Supported public values are `monthly` and `quarterly_average`; check `supported_options.period_aggregation` for values available on this endpoint.","examples":["quarterly_average"],"title":"Period Aggregation","enum":["monthly","quarterly_average"],"example":"monthly"},"description":"Optional query parameter. Optional period-aggregation selector. Supported public values are `monthly` and `quarterly_average`; check `supported_options.period_aggregation` for values available on this endpoint. Allowed values: monthly, quarterly_average."},{"name":"revisions","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Optional revision view. Supported public values are `latest`, `first`, `final`, and `all`; unsupported views return `unsupported_series_option` with supported values.","examples":["latest"],"default":"latest","title":"Revisions","enum":["latest","first","final","all"],"example":"latest"},"description":"Optional query parameter. Optional revision view. Supported public values are `latest`, `first`, `final`, and `all`; unsupported views return `unsupported_series_option` with supported values. Allowed values: latest, first, final, all."},{"name":"basis","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Optional real/nominal selector. Supported public values are `real` and `nominal`; only endpoints with known basis metadata accept it.","examples":["real"],"title":"Basis","enum":["real","nominal"],"example":"real"},"description":"Optional query parameter. Optional real/nominal selector. Supported public values are `real` and `nominal`; only endpoints with known basis metadata accept it. Allowed values: real, nominal."},{"name":"official_only","in":"query","required":false,"schema":{"type":"boolean","description":"When true, return only official-source rows and remove explicit fallback observations. Prohibited private aggregator rows are always removed regardless of this setting.","examples":[true],"default":true,"title":"Official Only"},"description":"Optional query parameter. When true, return only official-source rows and remove explicit fallback observations. Prohibited private aggregator rows are always removed regardless of this setting."},{"name":"fields","in":"query","required":false,"schema":{"anyOf":[{"type":"string","pattern":"^(full|compact)$"},{"type":"null"}],"description":"Row field set. Omitted or `full` returns every documented row field. `compact` returns only `date`, `val`, `previous_value`, `change_from_previous`, `announcement_datetime`, `announcement_datetime_local` and `publication_time_status` per row, with the revision ledger folded into `revisions_summary` (`count`, `first`, `latest`, `revised`). The envelope, pagination and `dataset_version` are unchanged.","examples":["compact"],"title":"Fields"},"description":"Optional query parameter. Row field set. Omitted or `full` returns every documented row field. `compact` returns only `date`, `val`, `previous_value`, `change_from_previous`, `announcement_datetime`, `announcement_datetime_local` and `publication_time_status` per row, with the revision ledger folded into `revisions_summary` (`count`, `first`, `latest`, `revised`). The envelope, pagination and `dataset_version` are unchanged."},{"name":"as_of","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"As Of"},"description":"Optional query parameter."},{"name":"availability","in":"query","required":false,"schema":{"enum":["public","captured"],"type":"string","default":"public","title":"Availability"},"description":"Optional query parameter."},{"name":"dataset_version","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Dataset Version"},"description":"Optional query parameter."},{"name":"value_mode","in":"query","required":false,"schema":{"enum":["normalized","source"],"type":"string","default":"normalized","title":"Value Mode"},"description":"Optional query parameter."},{"name":"api_key","in":"query","required":false,"schema":{"type":"string","description":"Your Individual or Business API key","title":"Api Key"},"description":"Deprecated: legacy query-string API key. Still accepted so existing integrations keep working, but new integrations must send the key in the X-API-Key header (or Authorization: Bearer). A key is required for non-USD, paid-only, or full-history requests. Responses to requests authenticated this way carry a Deprecation header.","deprecated":true}],"responses":{"200":{"description":"Normalized macro series for one currency and indicator.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AnnouncementResponse"},"example":{"currency":"USD","indicator":"inflation","name":"Inflation (CPI)","source":"BLS","source_url":"https://www.bls.gov/","source_series_id":"BLS:CUUR0000SA0","source_series_name":"Consumer Price Index for All Urban Consumers: All Items","seasonal_adjustment":"NSA","is_proxy":false,"provenance":{"storage":"FXMacroData","is_proxy":false,"publisher":"BLS","served_by":"/v1/announcements/{currency}/{indicator}","publisher_url":"https://www.bls.gov/","value_field":"val","timestamp_field":"announcement_datetime","source_series_id":"BLS:CUUR0000SA0","source_series_name":"Consumer Price Index for All Urban Consumers: All Items","seasonal_adjustment":"NSA"},"has_official_forecast":true,"requested_start_date":"2026-07-08","requested_end_date":"2026-10-06","requested_window_has_data":true,"page_includes_latest_available":true,"start_date":"2026-07-31","end_date":"2026-10-06","earliest_available_date":"2026-07-31","latest_available_date":"2026-08-31","cb_target":{"description":"Federal Reserve inflation objective (2% goal is defined on PCE, not CPI)","source":"Federal Reserve Statement on Longer-Run Goals and Monetary Policy Strategy","current":{"effective_from":"2020-08-27","target":2.0,"notes":"Flexible Average Inflation Targeting (FAIT) adopted; 2% remains the long-run goal (defined on PCE)"},"history":[{"effective_from":"2012-01-25","target":2.0,"notes":"First explicit 2% inflation goal announced by FOMC (defined on the PCE price index)"},{"effective_from":"2020-08-27","target":2.0,"notes":"Flexible Average Inflation Targeting (FAIT) adopted; 2% remains the long-run goal (defined on PCE)"}]},"remap":{"applied":false,"transform":"raw","canonical_indicator":"inflation"},"filters":{"revisions":"latest"},"selected_series_id":"usd_inflation_canonical_yoy_nsa_not_annualized_monthly","selected_series":{"label":"Inflation, YOY, NSA","frequency":"yoy","revisions":"latest","series_id":"usd_inflation_canonical_yoy_nsa_not_annualized_monthly","seasonality":"nsa","annualization":"not_annualized","source_series_id":"BLS:CUUR0000SA0","period_aggregation":"monthly"},"supported_options":{"basis":[],"frequency":["yoy","mom","qoq"],"revisions":["latest","first","final","all"],"seasonality":["nsa","sa"],"annualization":["not_annualized","saar"],"period_aggregation":["monthly","quarterly_average"]},"data_quality":{"is_official":true,"is_proxy":false,"is_fallback":false,"is_stale":false,"has_announcement_datetime":true,"point_in_time_safe":false,"unverified_vintage_count":2,"unknown_publication_time_count":0,"latest_available