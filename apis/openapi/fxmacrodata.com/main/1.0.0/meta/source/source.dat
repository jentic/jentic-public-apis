ney, building_approvals, building_permits, business_confidence, capital_account_balance, cb_assets, commodity_price_energy, commodity_price_ex_energy, commodity_price_index, commodity_prices, consumer_confidence, core_inflation, core_inflation_median, core_inflation_mom, core_inflation_trim, core_pce, core_pce_mom, credit_growth, crude_oil_inventories, current_account_balance, dairy_exports, deposit_rates, durable_goods_orders, effr, eme_dollar_index, employment, exports, financial_account_balance, foreign_reserves, full_time_employment, fx_reserves, gdp, gdp_growth_q4_yoy, gold_reserves, gov_bond_10y, gov_bond_15y, gov_bond_1_5m, gov_bond_1m, gov_bond_1y, gov_bond_20y, gov_bond_25y, gov_bond_2m, gov_bond_2y, gov_bond_30y, gov_bond_3m, gov_bond_3y, gov_bond_40y, gov_bond_4m, gov_bond_4y, gov_bond_5y, gov_bond_6m, gov_bond_6y, gov_bond_7y, gov_bond_8y, gov_bond_9y, government_debt, house_price_index, house_prices, household_credit, household_spending, housing_starts, import_prices, imports, industrial_production, inflation, inflation_linked_bond, inflation_mom, initial_jobless_claims, international_assets, international_liabilities, job_openings, m1, m2, m3, nairu, natural_gas_storage, net_foreign_asset_position, non_farm_payrolls, non_farm_payrolls_change, obfr, part_time_employment, participation_rate, pce, pce_mom, policy_rate, policy_rate_midpoint, policy_rate_mlf, policy_rate_mro, policy_rate_target_lower, ppi, primary_income_balance, productivity, real_yield_20y, real_yield_30y, real_yield_5y, real_yield_7y, retail_sales, retail_sales_control_group, retail_sales_ex_autos, retail_sales_ex_autos_and_gas, risk_free_rate, secondary_income_balance, sight_deposits, snb_balance_sheet, sofr_average_180d, sofr_average_30d, sofr_average_90d, sofr_index, terms_of_trade, tgcr, trade_balance, trade_weighted_index, trimmed_mean_inflation, unemployment, wage_price_index, wages."},{"name":"since","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Cursor returned as `next_cursor` by the previous response. ISO 8601 timestamps and Unix epoch seconds are also accepted.","title":"Since"},"description":"Optional query parameter. Cursor returned as `next_cursor` by the previous response. ISO 8601 timestamps and Unix epoch seconds are also accepted."},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","maximum":500,"minimum":1,"description":"Maximum number of matching change events to return.","default":100,"title":"Limit"},"description":"Optional query parameter. Maximum number of matching change events to return."},{"name":"payload","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Use `compact` for trigger payloads or `full` for row fields.","default":"compact","title":"Payload","enum":["compact","full"],"example":"compact"},"description":"Optional query parameter. Use `compact` for trigger payloads or `full` for row fields. Allowed values: compact, full."},{"name":"api_key","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Api Key"},"deprecated":true,"description":"Deprecated: legacy query-string API key. Still accepted so existing integrations keep working, but new integrations must send the key in the X-API-Key header (or Authorization: Bearer). A key is required for non-USD, paid-only, or full-history requests. Responses to requests authenticated this way carry a Deprecation header."}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AnnouncementChangesResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}},"x-parameter-availability":{"currency":["AUD","BRL","CAD","CHF","CNH","CNY","DKK","EUR","GBP","HUF","ILS","JPY","KRW","MYR","NGN","NOK","NZD","PEN","SEK","THB","TWD","USD"],"indicator":["afe_dollar_index","average_hourly_earnings","average_hourly_earnings_mom","balance_on_goods","balance_on_services","bgcr","breakeven_inflation_rate","broad_dollar_index","broad_money","building_approvals","building_permits","business_confidence","capital_account_balance","cb_assets","commodity_price_energy","commodity_price_ex_energy","commodity_price_index","commodity_prices","consumer_confidence","core_inflation","core_inflation_median","core_inflation_mom","core_inflation_trim","core_pce","core_pce_mom","credit_growth","crude_oil_inventories","current_account_balance","dairy_exports","deposit_rates","durable_goods_orders","effr","eme_dollar_index","employment","exports","financial_account_balance","foreign_reserves","full_time_employment","fx_reserves","gdp","gdp_growth_q4_yoy","gold_reserves","gov_bond_10y","gov_bond_15y","gov_bond_1_5m","gov_bond_1m","gov_bond_1y","gov_bond_20y","gov_bond_25y","gov_bond_2m","gov_bond_2y","gov_bond_30y","gov_bond_3m","gov_bond_3y","gov_bond_40y","gov_bond_4m","gov_bond_4y","gov_bond_5y","gov_bond_6m","gov_bond_6y","gov_bond_7y","gov_bond_8y","gov_bond_9y","government_debt","house_price_index","house_prices","household_credit","household_spending","housing_starts","import_prices","imports","industrial_production","inflation","inflation_linked_bond","inflation_mom","initial_jobless_claims","international_assets","international_liabilities","job_openings","m1","m2","m3","nairu","natural_gas_storage","net_foreign_asset_position","non_farm_payrolls","non_farm_payrolls_change","obfr","part_time_employment","participation_rate","pce","pce_mom","policy_rate","policy_rate_midpoint","policy_rate_mlf","policy_rate_mro","policy_rate_target_lower","ppi","primary_income_balance","productivity","real_yield_20y","real_yield_30y","real_yield_5y","real_yield_7y","retail_sales","retail_sales_control_group","retail_sales_ex_autos","retail_sales_ex_autos_and_gas","risk_free_rate","secondary_income_balance","sight_deposits","snb_balance_sheet","sofr_average_180d","sofr_average_30d","sofr_average_90d","sofr_index","terms_of_trade","tgcr","trade_balance","trade_weighted_index","trimmed_mean_inflation","unemployment","wage_price_index","wages"],"payload":["compact","full"]}}},"/v1/stream/events":{"get":{"tags":["announcements"],"summary":"Subscribe to real-time announcement events (SSE)","description":"Opens a long-lived Server-Sent Events (SSE) stream.  A new event is pushed to all connected clients whenever FXMacroData captures a new economic data release.\n\nThe stream payload contains event metadata and a single `latest_announcement` datapoint (`date`, `val`, `announcement_datetime`) when available.  It does not include the full time-series; fetch complete history from the matching announcements endpoint after receiving an event.\n\n**Authentication:** Live SSE delivery requires an active FXMacroData trial or subscription API key supplied via the ``api_key`` query parameter or the ``X-API-Key`` header.\n\n**Reconnection:** Pass the ``Last-Event-ID`` header (the ``event_id`` of the last received event) to replay buffered events on reconnect.\n\n**Filtering:** Use ``currencies`` and ``indicators`` to narrow the stream.  Omit either parameter to receive all live events included in your subscription.\n\n**Payloads:** ``payload=compact`` is the default.  ``payload=full`` adds the latest announcement row fields directly to each event.","operationId":"stream_events_v1_stream_events_get","parameters":[{"name":"currencies","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Comma-separated currency codes to subscribe to, e.g. ``usd,eur``. Omit to receive all live events included in your subscription.","title":"Currencies"},"description":"Optional query parameter. Comma-separated currency codes to subscribe to, e.g. ``usd,eur``. Omit to receive all live events included in your subscription."},{"name":"indicators","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Comma-separated indicator slugs, e.g. ``inflation,gdp``. Omit to receive all indicators.","title":"Indicators","enum":["afe_dollar_index","average_hourly_earnings","average_hourly_earnings_mom","balance_on_goods","balance_on_services","bgcr","breakeven_inflation_rate","broad_dollar_index","broad_money","building_approvals","building_permits","business_confidence","capital_account_balance","cb_assets","commodity_price_energy","commodity_price_ex_energy","commodity_price_index","commodity_prices","consumer_confidence","core_inflation","core_inflation_median","core_inflation_mom","core_inflation_trim","core_pce","core_pce_mom","credit_growth","crude_oil_inventories","current_account_balance","dairy_exports","deposit_rates","durable_goods_orders","effr","eme_dollar_index","employment","exports","financial_account_balance","foreign_reserves","full_time_employment","fx_reserves","gdp","gdp_growth_q4_yoy","gold_reserves","gov_bond_10y","gov_bond_15y","gov_bond_1_5m","gov_bond_1m","gov_bond_1y","gov_bond_20y","gov_bond_25y","gov_bond_2m","gov_bond_2y","gov_bond_30y","gov_bond_3m","gov_bond_3y","gov_bond_40y","gov_bond_4m","gov_bond_4y","gov_bond_5y","gov_bond_6m","gov_bond_6y","gov_bond_7y","gov_bond_8y","gov_bond_9y","government_debt","house_price_index","house_prices","household_credit","household_spending","housing_starts","import_prices","imports","industrial_production","inflation","inflation_linked_bond","inflation_mom","initial_jobless_claims","international_assets","international_liabilities","job_openings","m1","m2","m3","nairu","natural_gas_storage","net_foreign_asset_position","non_farm_payrolls","non_farm_payrolls_change","obfr","part_time_employment","participation_rate","pce","pce_mom","policy_rate","policy_rate_midpoint","policy_rate_mlf","policy_rate_mro","policy_rate_target_lower","ppi","primary_income_balance","productivity","real_yield_20y","real_yield_30y","real_yield_5y","real_yield_7y","retail_sales","retail_sales_control_group","retail_sales_ex_autos","retail_sales_ex_autos_and_gas","risk_free_rate","secondary_income_balance","sight_deposits","snb_balance_sheet","sofr_average_180d","sofr_average_30d","sofr_average_90d","sofr_index","terms_of_trade","tgcr","trade_balance","trade_weighted_index","trimmed_mean_inflation","unemployment","wage_price_index","wages"],"example":"afe_dollar_index"},"description":"Optional query parameter. Comma-separated indicator slugs, e.g. ``inflation,gdp``. Omit to receive all indicators. Allowed values: afe_dollar_index, average_hourly_earnings, average_hourly_earnings_mom, balance_on_goods, balance_on_services, bgcr, breakeven_inflation_rate, broad_dollar_index, broad_money, building_approvals, building_permits, business_confidence, capital_account_balance, cb_assets, commodity_price_energy, commodity_price_ex_energy, commodity_price_index, commodity_prices, consumer_confidence, core_inflation, core_inflation_median, core_inflation_mom, core_inflation_trim, core_pce, core_pce_mom, credit_growth, crude_oil_inventories, current_account_balance, dairy_exports, deposit_rates, durable_goods_orders, effr, eme_dollar_index, employment, exports, financial_account_balance, foreign_reserves, full_time_employment, fx_reserves, gdp, gdp_growth_q4_yoy, gold_reserves, gov_bond_10y, gov_bond_15y, gov_bond_1_5m, gov_bond_1m, gov_bond_1y, gov_bond_20y, gov_bond_25y, gov_bond_2m, gov_bond_2y, gov_bond_30y, gov_bond_3m, gov_bond_3y, gov_bond_40y, gov_bond_4m, gov_bond_4y, gov_bond_5y, gov_bond_6m, gov_bond_6y, gov_bond_7y, gov_bond_8y, gov_bond_9y, government_debt, house_price_index, house_prices, household_credit, household_spending, housing_starts, import_prices, imports, industrial_production, inflation, inflation_linked_bond, inflation_mom, initial_jobless_claims, international_assets, international_liabilities, job_openings, m1, m2, m3, nairu, natural_gas_storage, net_foreign_asset_position, non_farm_payrolls, non_farm_payrolls_change, obfr, part_time_employment, participation_rate, pce, pce_mom, policy_rate, policy_rate_midpoint, policy_rate_mlf, policy_rate_mro, policy_rate_target_lower, ppi, primary_income_balance, productivity, real_yield_20y, real_yield_30y, real_yield_5y, real_yield_7y, retail_sales, retail_sales_control_group, retail_sales_ex_autos, retail_sales_ex_autos_and_gas, risk_free_rate, secondary_income_balance, sight_deposits, snb_balance_sheet, sofr_average_180d, sofr_average_30d, sofr_average_90d, sofr_index, terms_of_trade, tgcr, trade_balance, trade_weighted_index, trimmed_mean_inflation, unemployment, wage_price_index, wages."},{"name":"api_key","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Your active FXMacroData trial or subscription API key.","title":"Api Key"},"description":"Active FXMacroData trial or subscription API key required for live delivery. Use the query parameter for browser or EventSource clients; server-side clients may use the X-API-Key header."},{"name":"payload","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Event payload shape. Use `compact` for the stable trigger payload or `full` to flatten the latest announcement row into each event.","default":"compact","title":"Payload","enum":["compact","full"],"example":"compact"},"description":"Optional query parameter. Event payload shape. Use `compact` for the stable trigger payload or `full` to flatten the latest announcement row into each event. Allowed values: compact, full."},{"name":"live_only","in":"query","required":false,"schema":{"type":"boolean","default":false,"title":"Live Only"},"description":"Optional query parameter."},{"name":"max_age_ms","in":"query","required":false,"schema":{"anyOf":[{"type":"integer"},{"type":"null"}],"title":"Max Age Ms"},"description":"Optional query parameter."},{"name":"Last-Event-ID","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Last-Event-Id"}}],"responses":{"200":{"description":"Streaming SSE response. Each `data:` line is one JSON release-delivery event; see `/v1/announcements/changes` for the field-by-field contract.","content":{"text/event-stream":{"schema":{"type":"string","description":"W3C EventSource frames. Each frame carries `id`, `event` and a `data` line holding one JSON release-delivery event. That event has the same shape as a `data[]` item of `/v1/announcements/changes`, which documents every field."}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}},"x-parameter-availability":{"currency":["AUD","BRL","CAD","CHF","CNH","CNY","DKK","EUR","GBP","HUF","ILS","JPY","KRW","MYR","NGN","NOK","NZD","PEN","SEK","THB","TWD","USD"],"indicator":["afe_dollar_index","average_hourly_earnings","average_hourly_earnings_mom","balance_on_goods","balance_on_services","bgcr","breakeven_inflation_rate","broad_dollar_index","broad_money","building_approvals","building_permits","business_confidence","capital_account_balance","cb_assets","commodity_price_energy","commodity_price_ex_energy","commodity_price_index","commodity_prices","consumer_confidence","core_inflation","core_inflation_median","core_inflation_mom","core_inflation_trim","core_pce","core_pce_mom","credit_growth","crude_oil_inventories","current_account_balance","dairy_exports","deposit_rates","durable_goods_orders","effr","eme_dollar_index","employment","exports","financial_account_balance","foreign_reserves","full_time_employment","fx_reserves","gdp","gdp_growth_q4_yoy","gold_reserves","gov_bond_10y","gov_bond_15y","gov_bond_1_5m","gov_bond_1m","gov_bond_1y","gov_bond_20y","gov_bond_25y","gov_bond_2m","gov_bond_2y","gov_bond_30y","gov_bond_3m","gov_bond_3y","gov_bond_40y","gov_bond_4m","gov_bond_4y","gov_bond_5y","gov_bond_6m","gov_bond_6y","gov_bond_7y","gov_bond_8y","gov_bond_9y","government_debt","house_price_index","house_prices","household_credit","household_spending","housing_starts","import_prices","imports","industrial_production","inflation","inflation_linked_bond","inflation_mom","initial_jobless_claims","international_assets","international_liabilities","job_openings","m1","m2","m3","nairu","natural_gas_storage","net_foreign_asset_position","non_farm_payrolls","non_farm_payrolls_change","obfr","part_time_employment","participation_rate","pce","pce_mom","policy_rate","policy_rate_midpoint","policy_rate_mlf","policy_rate_mro","policy_rate_target_lower","ppi","primary_income_balance","productivity","real_yield_20y","real_yield_30y","real_yield_5y","real_yield_7y","retail_sales","retail_sales_control_group","retail_sales_ex_autos","retail_sales_ex_autos_and_gas","risk_free_rate","secondary_income_balance","sight_deposits","snb_balance_sheet","sofr_average_180d","sofr_average_30d","sofr_average_90d","sofr_index","terms_of_trade","tgcr","trade_balance","trade_weighted_index","trimmed_mean_inflation","unemployment","wage_price_index","wages"],"payload":["compact","full"]}}}},"components":{"schemas":{"AnnouncementChangeEvent":{"properties":{"event_id":{"type":"string","title":"Event Id"},"currency":{"type":"string","title":"Currency"},"indicator":{"type":"string","title":"Indicator"},"records_written":{"anyOf":[{"type":"integer"},{"type":"null"}],"title":"Records Written"},"timestamp":{"anyOf":[{"type":"integer"},{"type":"number"},{"type":"null"}],"title":"Timestamp"},"release_timestamp":{"anyOf":[{"type":"integer"},{"type":"number"},{"type":"null"}],"title":"Release Timestamp"},"latest_announcement":{"anyOf":[{"$ref":"#/components/schemas/ReleaseDeliveryAnnouncement"},{"type":"null"}]},"delivery_mode":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Delivery Mode"},"origin_delivery_mode":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Origin Delivery Mode"},"source_fresh_at_ns":{"anyOf":[{"type":"integer"},{"type":"number"},{"type":"null"}],"title":"Source Fresh At Ns"},"stream_ready_at_ns":{"anyOf":[{"type":"integer"},{"type":"number"},{"type":"null"}],"title":"Stream Ready At Ns"},"server_sent_at_ns":{"anyOf":[{"type":"integer"},{"type":"number"},{"type":"null"}],"title":"Server Sent At Ns","description":"Time FXMacroData sent this event, as Unix epoch nanoseconds (UTC)."},"acknowledgement_endpoint":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Acknowledgement Endpoint","description":"Endpoint for acknowledging receipt of a streamed event. Present only on `/v1/stream/events` deliveries; never set on `/v1/announcements/changes`."},"age_ms":{"anyOf":[{"type":"integer"},{"type":"number"},{"type":"null"}],"title":"Age Ms","description":"Event age in milliseconds when it was sent. Present only on `/v1/stream/events` deliveries; never set on `/v1/announcements/changes`."},"stale_after_ms":{"anyOf":[{"type":"integer"},{"type":"number"},{"type":"null"}],"title":"Stale After Ms","description":"Age in milliseconds after which a streamed event is considered stale. Present only on `/v1/stream/events` deliveries; never set on `/v1/announcements/changes`."},"stale":{"anyOf":[{"type":"boolean"},{"type":"null"}],"title":"Stale","description":"True when the event was older than `stale_after_ms` when sent. Present only on `/v1/stream/events` deliveries; never set on `/v1/announcements/changes`."},"late_delivery":{"anyOf":[{"type":"boolean"},{"type":"null"}],"title":"Late Delivery","description":"True when the event was sent after its staleness threshold. Present only on `/v1/stream/events` deliveries; never set on `/v1/announcements/changes`."},"late_events_are_delivered":{"anyOf":[{"type":"boolean"},{"type":"null"}],"title":"Late Events Are Delivered"},"scheduled_release_at_ns":{"anyOf":[{"type":"integer"},{"type":"number"},{"type":"null"}],"title":"Scheduled Release At Ns"},"scheduled_to_server_send_ms":{"anyOf":[{"type":"integer"},{"type":"number"},{"type":"null"}],"title":"Scheduled To Server Send Ms","description":"Milliseconds from the scheduled release time to the time FXMacroData sent this event."},"source_late":{"anyOf":[{"type":"boolean"},{"type":"null"}],"title":"Source Late"},"source_late_by_ms":{"anyOf":[{"type":"integer"},{"type":"number"},{"type":"null"}],"title":"Source Late By Ms"},"source_delay_proven":{"anyOf":[{"type":"boolean"},{"type":"null"}],"title":"Source Delay Proven"},"platform_delivery_after_source_ms":{"anyOf":[{"type":"integer"},{"type":"number"},{"type":"null"}],"title":"Platform Delivery After Source Ms"},"polling_started_at_ns":{"anyOf":[{"type":"integer"},{"type":"number"},{"type":"null"}],"title":"Polling Started At Ns"},"polling_started_lag_ms":{"anyOf":[{"type":"integer"},{"type":"number"},{"type":"null"}],"title":"Polling Started Lag Ms"},"polling_started_before_scheduled_release":{"anyOf":[{"type":"boolean"},{"type":"null"}],"title":"Polling Started Before Scheduled Release"},"pre_fresh_stale_poll_count":{"anyOf":[{"type":"integer"},{"type":"number"},{"type":"null"}],"title":"Pre Fresh Stale Poll Count"},"last_stale_fetch_completed_at_ns":{"anyOf":[{"type":"integer"},{"type":"number"},{"type":"null"}],"title":"Last Stale Fetch Completed At Ns"},"first_fresh_response_completed_at_ns":{"anyOf":[{"type":"integer"},{"type":"number"},{"type":"null"}],"title":"First Fresh Response Completed At Ns"},"official_source_stale_after_scheduled_release":{"anyOf":[{"type":"boolean"},{"type":"null"}],"title":"Official Source Stale After Scheduled Release"},"scheduled_to_first_fresh_response_ms":{"anyOf":[{"type":"integer"},{"type":"number"},{"type":"null"}],"title":"Scheduled To First Fresh Response Ms"},"source_freshness_observation_window_start_at_ns":{"anyOf":[{"type":"integer"},{"type":"number"},{"type":"null"}],"title":"Source Freshness Observation Window Start At Ns"},"source_freshness_observation_window_end_at_ns":{"anyOf":[{"type":"integer"},{"type":"number"},{"type":"null"}],"title":"Source Freshness Observation Window End At Ns"},"source_freshness_observation_window_ms":{"anyOf":[{"type":"integer"},{"type":"number"},{"type":"null"}],"title":"Source Freshness Observation Window Ms"},"source_freshness_observation_basis":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Source Freshness Observation Basis"},"source_delay_attribution":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Source Delay Attribution"},"fxmd_delivery_attribution":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Fxmd Delivery Attribution"},"fxmd_after_source_ms":{"anyOf":[{"type":"integer"},{"type":"number"},{"type":"null"}],"title":"Fxmd After Source Ms"},"fxmd_after_source_slo_met":{"anyOf":[{"type":"boolean"},{"type":"null"}],"title":"Fxmd After Source Slo Met"},"catchup_source":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Catchup Source"},"catchup_delay_ms":{"anyOf":[{"type":"integer"},{"type":"number"},{"type":"null"}],"title":"Catchup Delay Ms"},"recovery_class":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Recovery Class"},"subsecond_status":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Subsecond Status"},"subsecond_operational_status":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Subsecond Operational Status"},"subsecond_guarantee_active":{"anyOf":[{"type":"boolean"},{"type":"null"}],"title":"Subsecond Guarantee Active"},"subsecond_contract_outcome":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Subsecond Contract Outcome"},"subsecond_contract_breached":{"anyOf":[{"type":"boolean"},{"type":"null"}],"title":"Subsecond Contract Breached"}},"additionalProperties":true,"type":"object","required":["event_id","currency","indicator"],"title":"AnnouncementChangeEvent","description":"A release event returned by ``/v1/announcements/changes``.\n\nEvents share the shape emitted by ``/v1/stream/events``. Fields that do not\napply to an event are omitted rather than returned as null."},"AnnouncementChangesResponse":{"properties":{"data":{"items":{"$ref":"#/components/schemas/AnnouncementChangeEvent"},"type":"array","title":"Data"},"count":{"type":"integer","title":"Count"},"next_cursor":{"type":"string","title":"Next Cursor"},"has_more":{"type":"boolean","title":"Has More"},"retention_seconds":{"type":"integer","title":"Retention Seconds"},"scope":{"$ref":"#/components/schemas/AnnouncementChangesScope"},"freemium_delay":{"anyOf":[{"$ref":"#/components/schemas/FreemiumDelayNotice"},{"type":"null"}]}},"type":"object","required":["data","count","next_cursor","has_more","retention_seconds","scope"],"title":"AnnouncementChangesResponse"},"AnnouncementChangesScope":{"properties":{"currencies":{"anyOf":[{"items":{"type":"string"},"type":"array"},{"type":"null"}],"title":"Currencies"},"indicators":{"anyOf":[{"items":{"type":"string"},"type":"array"},{"type":"null"}],"title":"Indicators"},"payload":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Payload"}},"type":"object","title":"AnnouncementChangesScope","description":"The filter set the response was produced under.\n\n``currencies`` and ``indicators`` are null when no filter was applied."},"AnnouncementDataPoint":{"properties":{"source_validity_status":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Source Validity Status","description":"`invalid_source_capture` marks a proven source/parser mistake retained only in the raw source/all audit view. It is excluded from economic revision selection and point-in-time replay. Absence is not source verification."},"source_correction":{"anyOf":[{"additionalProperties":true,"type":"object"},{"type":"null"}],"title":"Source Correction","description":"Audit evidence for an incorrect source capture, including the observed and expected series identities and any official correction citation. Original values and capture clocks remain unchanged."},"announcement_id":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Announcement Id"},"date":{"type":"string","title":"Date"},"val":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Val"},"source":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Source"},"source_url":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Source Url"},"source_url_scope":{"anyOf":[{"type":"string","enum":["release","dataset","series"]},{"type":"null"}],"title":"Source Url Scope"},"previous_value":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Previous Value"},"previous_date":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Previous Date"},"previous_announcement_datetime":{"anyOf":[{"type":"integer"},{"type":"null"}],"title":"Previous Announcement Datetime"},"change":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Change"},"change_from_previous":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Change From Previous"},"pct_change_from_previous":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Pct Change From Previous"},"original_val":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Original Val"},"original_unit":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Original Unit"},"val_mom":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Val Mom"},"observation_id":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Observation Id"},"announcement_datetime":{"anyOf":[{"type":"integer"},{"type":"null"}],"title":"Announcement Datetime"},"announcement_datetime_local":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Announcement Datetime Local"},"release_time_assumed":{"anyOf":[{"type":"boolean"},{"type":"null"}],"title":"Release Time Assumed","description":"Present and true when announcement_datetime was derived from the publication lag measured on this series' confirmed releases, because no official release calendar reaches the period. Omitted on rows whose publication time was captured from the release."},"release_time_upper_bound":{"anyOf":[{"type":"boolean"},{"type":"null"}],"title":"Release Time Upper Bound","description":"Legacy estimate flag; does not establish point-in-time safety."},"publication_time_status":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Publication Time Status","description":"What `announcement_datetime` on this row actually is. Present on every row that carries a value.\n\n- `confirmed`: read from the publisher's own release - an embargo instant printed on the document, or a publication timestamp the source served with the data.\n- `unverified`: a real timestamp that this row does not evidence the origin of. Most historical rows are in this state. It is not an estimate, and it is not proof.\n- `assumed_historical`: derived by this service from the lag its own confirmed releases show. Only permitted where both the period and the estimated publication precede 2025-11-06; see `release_time_assumed`.\n- `unknown`: no publication time. `announcement_datetime` is null and the observation is served on its period date alone.\n\nOnly `confirmed` is evidence of when the value became public. Gate point-in-time work on this field per row, never on a series-level claim.","examples":["confirmed"]},"publication_time_precision":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Publication Time Precision","description":"Resolution of `announcement_datetime`: `minute` when the publisher gave a clock time, `day` when only the release date was sourced, `unknown` otherwise.","examples":["minute"]},"publication_time_basis":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Publication Time Basis","description":"Where an `unverified` time came from: `official_schedule` means the publisher's own release calendar listed this release at this time (a planned time, equal to `official_planned_release_datetime`). Absent for `confirmed` rows, which carry the publisher's own timestamp for the release.","examples":["official_schedule"]},"vintage_status":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Vintage Status"},"is_first_release":{"anyOf":[{"type":"boolean"},{"type":"null"}],"title":"Is First Release"},"observed_at_ns":{"anyOf":[{"type":"integer"},{"type":"null"}],"title":"Observed At Ns"},"observed_at_ns_string":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Observed At Ns String"},"collected_at_ns_string":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Collected At Ns String"},"publication_at_ns":{"anyOf":[{"type":"integer"},{"type":"null"}],"title":"Publication At Ns","description":"Publisher-sourced publication instant, Unix epoch nanoseconds (UTC). Present only when the source states one; omitted otherwise."},"publication_at_ns_string":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Publication At Ns String","description":"`publication_at_ns` as a decimal string; present only alongside it."},"announcement_source_url":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Announcement Source Url","description":"The specific release this value was read from - for USD CPI, the BLS archive page for that month's news release. Present only when a release-scoped citation is available; a dataset or landing-page URL is reported as `source_url` instead and is never promoted to this field.","examples":["https://www.bls.gov/news.release/archives/cpi_08122026.htm"]},"source_artifact_sha256":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Source Artifact Sha256"},"capture_time_basis":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Capture Time Basis"},"geography":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Geography"},"period_basis":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Period Basis"},"methodology_id":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Methodology Id"},"source_period_label_conflict":{"anyOf":[{"type":"boolean"},{"type":"null"}],"title":"Source Period Label Conflict"},"source_methodology_status":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Source Methodology Status"},"selected_vintage_known_at_ns":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Selected Vintage Known At Ns"},"replay_vintage_verified":{"anyOf":[{"type":"boolean"},{"type":"null"}],"title":"Replay Vintage Verified"},"official_planned_release_datetime":{"anyOf":[{"type":"integer"},{"type":"null"}],"title":"Official Planned Release Datetime"},"official_planned_release_datetime_local":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Official Planned Release Datetime Local"},"official_actual_release_datetime":{"anyOf":[{"type":"integer"},{"type":"null"}],"title":"Official Actual Release Datetime"},"official_actual_release_datetime_local":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Official Actual Release Datetime Local"},"collected_at_ns":{"anyOf":[{"type":"integer"},{"type":"null"}],"title":"Collected At Ns"},"collected_at_iso":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Collected At Iso"},"release_timing":{"properties":{"scheduled_at":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Scheduled At","description":"Official scheduled release time (ISO 8601, UTC), or null when no exact time was scheduled. Latency is never measured from this time."},"published_at":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Published At","description":"The first observed read showing this period (ISO 8601, UTC, microsecond precision). This is an upper bound on publication, not an exact publisher timestamp. Same instant as `published_by`. Null when the capture did not record it."},"available_at":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Available At","description":"When this value was committed to the FXMacroData API data store (ISO 8601, UTC, microsecond precision). This clock does not measure client receipt. Null when the commit time was not recorded."},"latency_ms":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Latency Ms","description":"Milliseconds from publication to `available_at`, measured from `published_after` (the last read still showing the previous period), so it is the longest the gap can have been. Never measured from the scheduled time. Null when publication was not bounded or `available_at` is missing."},"latency_reference":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Latency Reference","description":"Reference for `latency_ms`: `publication_to_store_commit_upper_bound`. This legacy metric ends at the store commit; source capture is measured separately by `source_pickup_latency_min_ms` and `source_pickup_latency_max_ms`."},"publication_delay_ms":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Publication Delay Ms","description":"Milliseconds from `scheduled_at` to the observed upper publication bound `published_by`. This is a schedule diagnostic, not the actual publisher delay or pickup latency. Null when either timestamp is missing."},"published_after":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Published After","description":"The official source still showed the previous period after this instant (ISO 8601, UTC), or its `Last-Modified` header placed the update after it. Null when no such read was made."},"published_by":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Published By","description":"The first read of the official source that showed this period completed at this instant (ISO 8601, UTC), so the release was public by then. Null when the window could not be bounded."},"publication_window_basis":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Publication Window Basis","description":"How the window was bounded: `poll_bracket` (a read showing the previous period, then a read showing this one), `last_modified` (the source's `Last-Modified` header sets the lower bound), or `first_new_period_read_only` (only the upper bound is known)."},"collected_at":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Collected At","description":"When FXMacroData first captured this value from the official source (ISO 8601, UTC). Same instant as `collected_at_iso`."},"pickup_ms_min":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Pickup Ms Min","description":"Milliseconds from `published_by` to `available_at`: the shortest time the value can have taken to become available after publication. Null when either time is missing or `available_at` precedes `published_by`."},"pickup_ms_max":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Pickup Ms Max","description":"Milliseconds from `published_after` to `available_at`: the value was available through the API within this long of publication (same figure as `latency_ms`). Null when no read showed the previous period still in place, or when `available_at` is missing."},"picked_up_at":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Picked Up At","description":"When FXMacroData accepted this value from the official source (ISO 8601, UTC, microsecond precision). This is separate from the store commit and from a source observation that could not be accepted. Null when the capture clock is unavailable."},"source_pickup_latency_min_ms":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Source Pickup Latency Min Ms","description":"Minimum milliseconds from actual source publication to accepted pickup: `picked_up_at` minus `published_by`. Null when the required observation clocks are unavailable or inconsistent."},"source_pickup_latency_max_ms":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Source Pickup Latency Max Ms","description":"Maximum milliseconds from actual source publication to accepted pickup: `picked_up_at` minus the proven lower publication bound. Null when that bound or a valid pickup clock is unavailable."},"source_pickup_latency_ms":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Source Pickup Latency Ms","description":"Exact milliseconds from actual publication to accepted pickup. Null for observed publication windows because their bounds do not establish an exact publisher availability timestamp."},"source_pickup_outcome":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Source Pickup Outcome","description":"`met` when the upper latency bound is below `source_pickup_slo_ms`; `breached` when the lower bound is at or above it; `unverified` when the evidence cannot decide; `not_observed` when no accepted pickup clock is recorded."},"source_pickup_reference":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Source Pickup Reference","description":"Evidence for pickup latency: `observed_publication_bracket`, `first_new_period_response_only`, `unverified_publication_clock`, or `source_pickup_not_observed`. A scheduled time is never used as the publication reference."},"source_pickup_slo_ms":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Source Pickup Slo Ms","description":"The strict latency threshold, in milliseconds, used to classify source pickup. The default is 1000 milliseconds."}},"type":"object","title":"ReleaseTiming","description":"Scheduled, observed publication, capture and commit times for a release.\n\nPresent on rows captured at release time from the official source. The\npublication window is bounded by FXMacroData's own reads of the official\nsource; it is not a timestamp supplied by the publisher. Bounds that\ncould not be established are null. Source pickup stops at accepted capture;\nlegacy `latency_ms` and `pickup_ms_*` stop at the store commit. A null\nmeasurement does not establish whether a release was late."},"pct_change":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Pct Change"},"pct_change_yoy":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Pct Change Yoy"},"pct_change_qoq":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Pct Change Qoq"},"pct_change_mom":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Pct Change Mom"},"pct_change_12m":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Pct Change 12M"},"revisions":{"anyOf":[{"items":{"$ref":"#/components/schemas/RevisionEntry"},"type":"array"},{"type":"null"}],"title":"Revisions"},"revisions_summary":{"anyOf":[{"$ref":"#/components/schemas/RevisionsSummary"},{"type":"null"}],"description":"Compact view only (`fields=compact`): how many distinct published values this period has had, with the first and latest. Replaces the full `revisions[]` ledger in that view."},"outside_requested_window":{"anyOf":[{"type":"boolean"},{"type":"null"}],"title":"Outside Requested Window"},"requested_start_date":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Requested Start Date"},"requested_end_date":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Requested End Date"},"returned_reason":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Returned Reason"},"staleness_days":{"anyOf":[{"type":"integer"},{"type":"null"}],"title":"Staleness Days"},"canonical_indicator":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Canonical Indicator"},"raw_indicator":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Raw Indicator"},"remap_applied":{"anyOf":[{"type":"boolean"},{"type":"null"}],"title":"Remap Applied"},"remap_rule_id":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Remap Rule Id"},"remap_segment_id":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Remap Segment Id"}},"type":"object","required":["date"],"title":"AnnouncementDataPoint"},"AnnouncementPredictions":{"properties":{"announcement_id":{"type":"string","title":"Announcement Id","description":"Stable identifier of the announcement these predictions target, in the form ``{currency}_{indicator}_{date}``.","examples":["usd_inflation_2026-01-31"]},"observation_id":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Observation Id","description":"Variant-safe identifier for the selected series observation. Use this with `selected_series_id` when query selectors choose a non-default series."},"selected_series_id":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Selected Series Id","description":"Stable identifier of the selected announcement series."},"currency":{"type":"string","title":"Currency"},"indicator":{"type":"string","title":"Indicator"},"date":{"type":"string","title":"Date","description":"Reference period date of the forecast, ``YYYY-MM-DD``."},"announcement_datetime":{"type":"integer","title":"Announcement Datetime","description":"Release timestamp of the forecasted announcement, Unix epoch seconds (UTC)."},"announcement_datetime_local":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Announcement Datetime Local","description":"ISO 8601 release time with timezone offset, rendered in the currency's market timezone."},"announcement_timing":{"anyOf":[{"type":"string","enum":["past","future"]},{"type":"null"}],"title":"Announcement Timing","description":"Whether the forecasted announcement is still upcoming (`future`) or already released (`past`)."},"predictions":{"items":{"$ref":"#/components/schemas/PredictionItem"},"type":"array","title":"Predictions","description":"List of forecasts for this announcement, one entry per prediction source.  Sorted by ``prediction_source`` for deterministic output."}},"type":"object","required":["announcement_id","currency","indicator","date","announcement_datetime"],"title":"AnnouncementPredictions","description":"All available forecasts targeting a single announcement.\n\n``announcement_id`` matches the value surfaced on the corresponding\nrow in ``/v1/announcements/{currency}/{indicator}``, allowing clients\nto join predictions with realised observations.  ``predictions``\ncontains one sub-entry per source (e.g. central-bank projection,\nIMF WEO, market consensus survey, FXMacroData prediction)."},"AnnouncementResponse":{"properties":{"currency":{"type":"string","title":"Currency"},"indicator":{"type":"string","title":"Indicator"},"name":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Name"},"value_name":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Value Name"},"source":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Source"},"source_url":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Source Url"},"source_series_id":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Source Series Id"},"source_series_name":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Source Series Name"},"source_local_name":{"anyOf":[{"type":"string"},{"ty