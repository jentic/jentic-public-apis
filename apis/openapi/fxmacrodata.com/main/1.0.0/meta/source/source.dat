":0},"point_in_time_safe":{"type":"boolean","title":"Point In Time Safe"}},"type":"object","required":["row_count","announcement_datetime_count","missing_announcement_datetime_count","point_in_time_safe"],"title":"PointInTimeCompleteness","description":"Coverage of source-confirmed publication timestamps for a dataset."},"PolicyFamilyEntry":{"properties":{"indicator":{"type":"string","title":"Indicator"},"value_name":{"type":"string","title":"Value Name"},"role":{"type":"string","title":"Role"}},"type":"object","required":["indicator","value_name","role"],"title":"PolicyFamilyEntry"},"PredictionItem":{"properties":{"predicted_value":{"type":"number","title":"Predicted Value"},"event_compatible":{"type":"boolean","title":"Event Compatible","default":false},"event_compatibility_reason":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Event Compatibility Reason"},"source_url":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Source Url"},"target_period":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Target Period"},"period_basis":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Period Basis"},"unit":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Unit"},"statistic":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Statistic"},"publication_date":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Publication Date"},"publication_datetime":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Publication Datetime"},"publication_precision":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Publication Precision"},"forecast_observation_id":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Forecast Observation Id"},"seasonal_adjustment":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Seasonal Adjustment"},"geography":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Geography"},"announcement_mapping_verified":{"type":"boolean","title":"Announcement Mapping Verified","default":false},"prediction_class":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Prediction Class","description":"How the forecast was produced, and the field to filter on. One of ``compiled_consensus`` (a publisher's compilation of independent forecasters), ``forecaster_survey`` (an official survey of forecasters or market participants), ``market_implied`` (derived from traded prices), ``model_nowcast`` (a published statistical model), ``central_bank_projection`` (the central bank's own projection), ``institutional_projection`` (IMF, OECD), or ``fxmacrodata`` (an FXMacroData estimate, never a market consensus)."},"prediction_class_label":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Prediction Class Label","description":"Human-readable name for ``prediction_class``, for display. Filter on ``prediction_class``, not on this."},"prediction_type":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Prediction Type","description":"Original per-source category, retained unchanged for backward compatibility: ``market_consensus``, ``market_prediction``, ``model_nowcast``, ``survey``, ``central_bank_forecast``, ``central_bank_projection``, ``imf_weo``, ``oecd_eo`` or ``fxmacrodata``. These slugs split identical instruments (the ECB and Philadelphia Fed Surveys of Professional Forecasters landed in different values) and two of them name a publisher rather than a category. Prefer ``prediction_class``."},"prediction_source":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Prediction Source","description":"Stable source identifier slug (e.g. ``philly_fed_spf``, ``cleveland_fed_nowcast``, ``fomc_sep``, ``atlanta_fed_gdpnow``, ``ny_fed_sme``, ``ecb_spf``, ``imf_weo``, ``rbnz_mps``, ``fxmacrodata_blended``). Use this value when filtering via the ``prediction_source`` query parameter."},"prediction_source_label":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Prediction Source Label","description":"Human-readable name for ``prediction_source`` (e.g. \"RBA Statement on Monetary Policy (Table J1)\", \"Philadelphia Fed Survey of Professional Forecasters\", \"IMF World Economic Outlook\"). Suitable for display in UI surfaces; use ``prediction_source`` for filtering and joins."},"generated_at":{"anyOf":[{"type":"integer"},{"type":"null"}],"title":"Generated At","description":"Unix epoch seconds (UTC) for the prediction's known-at marker. Inspect `provenance.generated_at_basis` and `provenance.generated_at_precision`: publisher archives may provide a date that FXMacroData normalizes to a documented source-local publication time rather than an original intraday timestamp."},"provenance":{"anyOf":[{"$ref":"#/components/schemas/PredictionProvenance"},{"type":"null"}],"description":"Documented origin, capture, timestamp, reconstruction, and vintage semantics for this source. Omitted for sources whose provenance is not yet documented."},"is_pre_release":{"anyOf":[{"type":"boolean"},{"type":"null"}],"title":"Is Pre Release","description":"Whether `generated_at` is strictly earlier than the linked `announcement_datetime`. Null when the source did not provide a generation timestamp."},"confidence":{"anyOf":[{"type":"number","maximum":1.0,"minimum":0.0},{"type":"null"}],"title":"Confidence","description":"Confidence score in ``[0.0, 1.0]`` indicating how strong this prediction is. ``1.0`` is maximally confident, ``0.0`` is no confidence. When the source did not record an explicit value, a per-source default is returned (central-bank publications and official surveys score higher than the FXMacroData blended forecast). Use this to weight or filter predictions in client applications."},"prediction_reason":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Prediction Reason","description":"Short human-readable explanation of how this prediction was derived. Currently populated for FXMacroData-generated predictions (``prediction_source=fxmacrodata_blended``); it summarises the persistence anchor, momentum/trend extrapolation, cross-indicator pressure, and any external forecast that was blended in. Other prediction sources may omit this field."}},"type":"object","required":["predicted_value"],"title":"PredictionItem","description":"A single per-source forecast inside an announcement group."},"PredictionProvenance":{"properties":{"value_origin":{"type":"string","title":"Value Origin","description":"Whether the value is a publisher historical vintage or an FXMacroData model output."},"capture_mode":{"type":"string","title":"Capture Mode","description":"Whether FXMacroData recorded the value when it was published or later imported it from the publisher's official archive."},"archived_in_real_time_by_fxmacrodata":{"type":"boolean","title":"Archived In Real Time By Fxmacrodata","description":"True only when FXMacroData captured the prediction at the time it was generated or published."},"generated_at_basis":{"type":"string","title":"Generated At Basis","description":"The source fact used to construct `generated_at`."},"generated_at_precision":{"type":"string","title":"Generated At Precision","description":"Precision of the underlying source timestamp. `date` means an official source date was normalized to a documented source-local time."},"reconstructed_with_later_data":{"type":"boolean","title":"Reconstructed With Later Data","description":"Whether the prediction value was recomputed using later data or a newer model version."},"vintage_selection":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Vintage Selection","description":"Which publisher or model vintages are retained in this feed."}},"type":"object","required":["value_origin","capture_mode","archived_in_real_time_by_fxmacrodata","generated_at_basis","generated_at_precision","reconstructed_with_later_data"],"title":"PredictionProvenance","description":"Documented origin and timestamp semantics for a forecast value."},"PredictionsResponse":{"properties":{"as_of":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"As Of"},"event_compatible_only":{"type":"boolean","title":"Event Compatible Only","default":false},"currency":{"type":"string","title":"Currency"},"indicator":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Indicator"},"filters":{"properties":{"seasonality":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Seasonality"},"basis":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Basis"},"annualization":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Annualization"},"period_aggregation":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Period Aggregation"},"frequency":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Frequency"},"revisions":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Revisions"}},"type":"object","title":"SeriesFilters","description":"The series-variant filters this request was resolved with.\n\nA null means the caller did not constrain that dimension."},"selected_series_id":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Selected Series Id"},"selected_series":{"properties":{"series_id":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Series Id"},"label":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Label"},"source_series_id":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Source Series Id"},"seasonality":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Seasonality"},"basis":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Basis"},"annualization":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Annualization"},"period_aggregation":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Period Aggregation"},"frequency":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Frequency"},"revisions":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Revisions"}},"type":"object","title":"SelectedSeries","description":"The concrete series variant chosen for this response."},"supported_options":{"anyOf":[{"additionalProperties":{"items":{"type":"string"},"type":"array"},"type":"object"},{"type":"null"}],"title":"Supported Options"},"prediction_type":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Prediction Type"},"prediction_class":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Prediction Class"},"prediction_source":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Prediction Source"},"pre_release_only":{"type":"boolean","title":"Pre Release Only","default":true},"start_date":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Start Date"},"end_date":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"End Date"},"next_cursor":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Next Cursor","description":"Exclusive `before_date` cursor for the next page. Prefer this over deep offset pagination to keep reads bounded."},"has_more":{"type":"boolean","title":"Has More","default":false},"count":{"type":"integer","title":"Count","description":"Number of announcement groups returned in ``data``.","default":0},"prediction_count":{"type":"integer","title":"Prediction Count","description":"Total number of per-source predictions across all groups.","default":0},"data_quality":{"$ref":"#/components/schemas/DataQuality"},"availability":{"anyOf":[{"additionalProperties":true,"type":"object"},{"type":"null"}],"title":"Availability","description":"Why a filter returned what it returned. ``classes_with_sources`` and ``types_with_sources`` list what any caller could ever get for this pair; ``reason`` explains a requested filter that came back empty. ``no_source_for_pair`` means no publisher provides it and no plan adds it."},"official_forecasts":{"items":{"additionalProperties":true,"type":"object"},"type":"array","title":"Official Forecasts","description":"Official forecasts and surveys for this indicator in the publisher's own period and unit (quarterly averages, annual rates, survey horizons), newest publication first, every vintage. Not merged into ``data`` because their period basis differs from the monthly announcement; ``target_period``, ``period_basis`` and ``unit`` say exactly what each number is. Same ``prediction_class`` vocabulary as ``data``; filtered by ``prediction_class``, ``prediction_source``, ``start_date`` and ``end_date`` (on the publication date)."},"official_forecast_count":{"type":"integer","title":"Official Forecast Count","description":"Number of rows in ``official_forecasts``.","default":0},"official_forecast_calendar":{"items":{"additionalProperties":true,"type":"object"},"type":"array","title":"Official Forecast Calendar","description":"Confirmed official forecast publication times for this currency over the next 366 days. These are publisher releases, separate from the indicator's announcement times."},"official_forecasts_truncated":{"type":"boolean","title":"Official Forecasts Truncated","description":"True when more official forecast vintages exist than the ``official_limit`` returned; narrow ``start_date``/``end_date`` or ``prediction_source`` to see the rest.","default":false},"data":{"items":{"$ref":"#/components/schemas/AnnouncementPredictions"},"type":"array","title":"Data"}},"type":"object","required":["currency","data_quality","data"],"title":"PredictionsResponse"},"PressRelease":{"properties":{"url":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Url"},"date":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Date"},"title":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Title"},"topics":{"anyOf":[{"items":{"type":"string"},"type":"array"},{"type":"null"}],"title":"Topics"},"summary":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Summary"},"category":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Category"},"rate_path":{"anyOf":[{"$ref":"#/components/schemas/PressReleaseRatePath"},{"type":"null"}]},"relevance":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Relevance"},"sentiment":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Sentiment"},"ai_summary":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Ai Summary","description":"Model-generated one-to-two sentence FX/macro takeaway. Not an official statement."},"ai_stance":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Ai Stance","description":"Model-assessed stance: `hawkish`, `dovish` or `neutral`."},"ai_stance_score":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Ai Stance Score","description":"Model-assessed stance in [-1, 1]; positive is hawkish."},"ai_next_meeting_action":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Ai Next Meeting Action","description":"Model-assessed next policy action: `hike`, `cut` or `hold`."},"ai_next_meeting_probability":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Ai Next Meeting Probability","description":"Model-assessed probability in [0, 1] of `ai_next_meeting_action` at the next meeting."},"ai_rationale":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Ai Rationale","description":"Model-generated one-sentence justification for the stance."}},"type":"object","title":"PressRelease"},"PressReleaseRatePath":{"properties":{"label":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Label"},"score":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Score"},"matches":{"anyOf":[{"items":{"$ref":"#/components/schemas/RatePathMatch"},"type":"array"},{"type":"null"}],"title":"Matches"},"raw_score":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Raw Score"},"confidence":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Confidence"},"bias_action":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Bias Action"}},"type":"object","title":"PressReleaseRatePath","description":"Rate-path bias inferred from the release text."},"PressReleasesResponse":{"properties":{"currency":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Currency"},"source":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Source"},"source_url":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Source Url"},"limit":{"anyOf":[{"type":"integer"},{"type":"null"}],"title":"Limit"},"offset":{"anyOf":[{"type":"integer"},{"type":"null"}],"title":"Offset"},"count"