ting integrations keep working, but new integrations must send the key in the X-API-Key header (or Authorization: Bearer). A key is required for non-USD, paid-only, or full-history requests. Responses to requests authenticated this way carry a Deprecation header.","deprecated":true}],"responses":{"200":{"description":"Upcoming release dates for the selected currency and optional indicator filter.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CalendarResponse"},"example":{"currency":"USD","timezone":"America/New_York","indicator":"inflation","data":[{"announcement_datetime":1773077400,"announcement_datetime_local":"2026-03-11T08:30:00-04:00","release":"inflation","calendar_event_id":"usd_inflation_1773077400"},{"announcement_datetime":1773682200,"announcement_datetime_local":"2026-03-18T08:30:00-04:00","release":"non_farm_payrolls","calendar_event_id":"usd_non_farm_payrolls_1773682200"}]}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}},"x-parameter-availability":{"currency":["AUD","BRL","CAD","CHF","CNH","CNY","COMM","DKK","EUR","GBP","HUF","ILS","JPY","KRW","MYR","NGN","NOK","NZD","PEN","SEK","THB","TWD","USD"],"indicator":["afe_dollar_index","average_hourly_earnings","average_hourly_earnings_mom","balance_on_goods","balance_on_services","bgcr","breakeven_inflation_rate","broad_dollar_index","broad_money","building_approvals","building_permits","business_confidence","capital_account_balance","cb_assets","commodity_price_energy","commodity_price_ex_energy","commodity_price_index","commodity_prices","consumer_confidence","core_inflation","core_inflation_median","core_inflation_mom","core_inflation_trim","core_pce","core_pce_mom","credit_growth","crude_oil_inventories","current_account_balance","dairy_exports","deposit_rates","durable_goods_orders","effr","eme_dollar_index","employment","exports","financial_account_balance","foreign_reserves","full_time_employment","fx_reserves","gdp","gdp_growth_q4_yoy","gold_reserves","gov_bond_10y","gov_bond_15y","gov_bond_1_5m","gov_bond_1m","gov_bond_1y","gov_bond_20y","gov_bond_25y","gov_bond_2m","gov_bond_2y","gov_bond_30y","gov_bond_3m","gov_bond_3y","gov_bond_40y","gov_bond_4m","gov_bond_4y","gov_bond_5y","gov_bond_6m","gov_bond_6y","gov_bond_7y","gov_bond_8y","gov_bond_9y","government_debt","house_price_index","house_prices","household_credit","household_spending","housing_starts","import_prices","imports","industrial_production","inflation","inflation_linked_bond","inflation_mom","initial_jobless_claims","international_assets","international_liabilities","job_openings","m1","m2","m3","nairu","natural_gas_storage","net_foreign_asset_position","non_farm_payrolls","non_farm_payrolls_change","obfr","part_time_employment","participation_rate","pce","pce_mom","policy_rate","policy_rate_midpoint","policy_rate_mlf","policy_rate_mro","policy_rate_target_lower","ppi","primary_income_balance","productivity","real_yield_20y","real_yield_30y","real_yield_5y","real_yield_7y","retail_sales","retail_sales_control_group","retail_sales_ex_autos","retail_sales_ex_autos_and_gas","risk_free_rate","secondary_income_balance","sight_deposits","snb_balance_sheet","sofr_average_180d","sofr_average_30d","sofr_average_90d","sofr_index","terms_of_trade","tgcr","trade_balance","trade_weighted_index","trimmed_mean_inflation","unemployment","wage_price_index","wages"]}}},"/v1/market_sessions":{"get":{"tags":["fx_markets"],"summary":"FX market session timetable","description":"Returns a real-time snapshot of the four major FX trading sessions (Sydney, Tokyo, London, New York) and their overlap windows.\n\nEach session entry shows today's open and close times in UTC, whether the session is currently open, and seconds until it opens or closes.\n\nOverlap windows highlight the highest-liquidity trading periods — in particular the **London / New York** overlap (~13:00–17:00 UTC in winter), which sees the largest volume and tightest spreads on major USD pairs.\n\n**Query Parameters:**\n- `at`: Optional ISO-8601 UTC timestamp (e.g. `2026-03-05T12:00:00Z`). Defaults to the current server time. Useful for scheduling or back-testing decisions.\n\n**No authentication required.**","operationId":"get_market_sessions_v1_market_sessions_get","parameters":[{"name":"at","in":"query","required":false,"schema":{"type":"string","description":"Optional ISO-8601 UTC timestamp (e.g. 2026-03-05T12:00:00Z)","examples":["2026-03-05T12:00:00Z"],"title":"At"},"description":"Optional query parameter. Optional ISO-8601 UTC timestamp (e.g. 2026-03-05T12:00:00Z)"}],"responses":{"200":{"description":"Session snapshot including open/close state and overlap windows.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MarketSessionsResponse"},"example":{"now_utc":"2026-03-05T12:00:00Z","now_unix":1741176000,"is_market_day":true,"sessions":[{"name":"Sydney","display_name":"Sydney (Australia / New Zealand)","description":"First major session to open after the weekend.","currencies":["AUD","NZD"],"timezone":"Australia/Sydney","open_utc":"2026-03-04T23:00:00Z","close_utc":"2026-03-05T08:00:00Z","open_unix":1741129200,"close_unix":1741161600,"is_open":false},{"name":"London","display_name":"London (United Kingdom / Europe)","description":"Largest FX session by volume.","currencies":["GBP","EUR","CHF"],"timezone":"Europe/London","open_utc":"2026-03-05T08:00:00Z","close_utc":"2026-03-05T17:00:00Z","open_unix":1741161600,"close_unix":1741194000,"is_open":true,"seconds_to_close":18000}],"overlaps":[{"name":"London / New York","sessions":["London","New York"],"description":"Most active window of the trading day.","priority":"high","notable_pairs":["EUR/USD","GBP/USD","USD/CHF","USD/CAD"],"start_utc":"2026-03-05T13:00:00Z","end_utc":"2026-03-05T17:00:00Z","start_unix":1741179600,"end_unix":1741194000,"is_active":false,"seconds_to_start":3600,"duration_hours":4.0}]}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/v1/rate_differentials/{base}/{quote}":{"get":{"tags":["fx_markets"],"summary":"Get pair rate differentials","description":"Returns a historical differential between the base and quote currency using a shared rate measure. The endpoint aligns the two legs by date intersection and reports the spread in both percentage points and basis points.\n\n**Measures:**\n- Supported values: `auto`, `risk_free_rate`, `gov_bond_2y`, `gov_bond_10y`, `policy_rate`.\n- `auto` prefers `risk_free_rate`, then `gov_bond_2y`, then `policy_rate`.\n\n**Rate Types:**\n- Supported values: `spot`, `forward`.\n- `spot` compares the selected shared rate measure.\n- `forward` derives each leg from government bond curve nodes, then aligns dates.\n\n**Authentication:**\n- Requires an Individual or Business API key via `?api_key=<key>` or `X-API-Key`.","operationId":"get_rate_differentials_v1_rate_differentials__base___quote__get","parameters":[{"name":"base","in":"path","required":true,"schema":{"type":"string","description":"Base currency code","examples":["AUD"],"title":"Base","enum":["AUD","BRL","CAD","CHF","CNH","CNY","DKK","EUR","GBP","HUF","ILS","JPY","KRW","MYR","NGN","NOK","NZD","PEN","SEK","THB","TWD","USD"],"example":"AUD"},"description":"Required path parameter. Base currency code Allowed values: AUD, BRL, CAD, CHF, CNH, CNY, DKK, EUR, GBP, HUF, ILS, JPY, KRW, MYR, NGN, NOK, NZD, PEN, SEK, THB, TWD, USD."},{"name":"quote","in":"path","required":true,"schema":{"type":"string","description":"Quote currency code","examples":["USD"],"title":"Quote","enum":["AUD","BRL","CAD","CHF","CNH","CNY","DKK","EUR","GBP","HUF","ILS","JPY","KRW","MYR","NGN","NOK","NZD","PEN","SEK","THB","TWD","USD"],"example":"AUD"},"description":"Required path parameter. Quote currency code Allowed values: AUD, BRL, CAD, CHF, CNH, CNY, DKK, EUR, GBP, HUF, ILS, JPY, KRW, MYR, NGN, NOK, NZD, PEN, SEK, THB, TWD, USD."},{"name":"measure","in":"query","required":false,"schema":{"type":"string","description":"Shared rate measure to compare across the pair.","examples":["auto","risk_free_rate","gov_bond_2y"],"default":"auto","title":"Measure","enum":["auto","risk_free_rate","gov_bond_2y","gov_bond_10y","policy_rate"],"example":"auto"},"description":"Optional query parameter. Shared rate measure to compare across the pair. Allowed values: auto, risk_free_rate, gov_bond_2y, gov_bond_10y, policy_rate."},{"name":"rate_type","in":"query","required":false,"schema":{"type":"string","description":"Differential type: spot for shared rate measures, forward for derived curve segments.","examples":["spot","forward"],"default":"spot","title":"Rate Type","enum":["spot","forward"],"example":"spot"},"description":"Optional query parameter. Differential type: spot for shared rate measures, forward for derived curve segments. Allowed values: spot, forward."},{"name":"curve_family","in":"query","required":false,"schema":{"type":"string","description":"Curve family used when rate_type=forward.","examples":["government_nominal"],"default":"government_nominal","title":"Curve Family","enum":["government_nominal"],"example":"government_nominal"},"description":"Optional query parameter. Curve family used when rate_type=forward. Allowed values: government_nominal."},{"name":"start_tenor_years","in":"query","required":false,"schema":{"type":"number","description":"Start tenor in years when rate_type=forward.","examples":[2.0],"default":2.0,"title":"Start Tenor Years"},"description":"Optional query parameter. Start tenor in years when rate_type=forward."},{"name":"end_tenor_years","in":"query","required":false,"schema":{"type":"number","description":"End tenor in years when rate_type=forward.","examples":[5.0],"default":5.0,"title":"End Tenor Years"},"description":"Optional query parameter. End tenor in years when rate_type=forward."},{"name":"start_date","in":"query","required":false,"schema":{"type":"string","description":"Inclusive start date YYYY-MM-DD. Defaults to 365 days ago.","examples":["2026-01-01"],"title":"Start Date"},"description":"Optional query parameter. Inclusive start date YYYY-MM-DD. Defaults to 365 days ago."},{"name":"end_date","in":"query","required":false,"schema":{"type":"string","description":"Inclusive end date YYYY-MM-DD. Defaults to today.","examples":["2026-06-01"],"title":"End Date"},"description":"Optional query parameter. Inclusive end date YYYY-MM-DD. Defaults to today."},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","maximum":100,"minimum":1,"description":"Maximum rows to return. Defaults to 20. Maximum 100.","default":20,"title":"Limit"},"description":"Optional query parameter. Maximum rows to return. Defaults to 20. Maximum 100."},{"name":"offset","in":"query","required":false,"schema":{"type":"integer","minimum":0,"description":"Number of rows to skip after most-recent-first ordering.","default":0,"title":"Offset"},"description":"Optional query parameter. Number of rows to skip after most-recent-first ordering."},{"name":"as_of","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Explicit UTC information cutoff for verified vintage replay; date means start of day.","title":"As Of"},"description":"Optional query parameter. Explicit UTC information cutoff for verified vintage replay; date means start of day."},{"name":"availability","in":"query","required":false,"schema":{"type":"string","pattern":"^(public|captured)$","description":"Source-public or captured-value availability clock.","default":"public","title":"Availability"},"description":"Optional query parameter. Source-public or captured-value availability clock."},{"name":"api_key","in":"query","required":false,"schema":{"type":"string","description":"Your Individual or Business API key","title":"Api Key"},"description":"Deprecated: legacy query-string API key. Still accepted so existing integrations keep working, but new integrations must send the key in the X-API-Key header (or Authorization: Bearer). A key is required for non-USD, paid-only, or full-history requests. Responses to requests authenticated this way carry a Deprecation header.","deprecated":true}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RateDifferentialResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}},"x-parameter-availability":{"base":["AUD","BRL","CAD","CHF","CNH","CNY","DKK","EUR","GBP","HUF","ILS","JPY","KRW","MYR","NGN","NOK","NZD","PEN","SEK","THB","TWD","USD"],"quote":["AUD","BRL","CAD","CHF","CNH","CNY","DKK","EUR","GBP","HUF","ILS","JPY","KRW","MYR","NGN","NOK","NZD","PEN","SEK","THB","TWD","USD"],"measure":["auto","risk_free_rate","gov_bond_2y","gov_bond_10y","policy_rate"],"rate_type":["spot","forward"],"curve_family":["government_nominal"]}}},"/v1/curves/{currency}":{"get":{"tags":["fx_markets"],"summary":"Get curve analytics by currency","description":"Returns a currency-level curve view from official-source government bond tenor nodes. Use `view=nodes` for raw node snapshots, `view=slopes` for curve-slope and inversion analytics, or `view=forwards` for derived forward-rate segments.\n\n**Curve Families:**\n- Supported values: `government_nominal`.\n\n**Metrics:**\n- Supported values: `spot`.\n\n**Views:**\n- Supported values: `nodes`, `slopes`, `forwards`.\n\n**Authentication:**\n- Requires an Individual or Business API key via `?api_key=<key>` or `X-API-Key`.","operationId":"get_curve_snapshot_v1_curves__currency__get","parameters":[{"name":"currency","in":"path","required":true,"schema":{"type":"string","description":"Currency code","examples":["GBP"],"title":"Currency","enum":["AUD","CAD","CHF","CNH","CNY","DKK","EUR","GBP","ILS","JPY","KRW","MYR","NOK","NZD","PEN","SEK","THB","USD"],"example":"AUD"},"description":"Required path parameter. Currency code Allowed values: AUD, CAD, CHF, CNH, CNY, DKK, EUR, GBP, ILS, JPY, KRW, MYR, NOK, NZD, PEN, SEK, THB, USD."},{"name":"curve_family","in":"query","required":false,"schema":{"type":"string","description":"Official curve family to return.","examples":["government_nominal"],"default":"government_nominal","title":"Curve Family","enum":["government_nominal"],"example":"government_nominal"},"description":"Optional query parameter. Official curve family to return. Allowed values: government_nominal."},{"name":"metric","in":"query","required":false,"schema":{"type":"string","description":"Curve metric to return.","examples":["spot"],"default":"spot","title":"Metric","enum":["spot"],"example":"spot"},"description":"Optional query parameter. Curve metric to return. Allowed values: spot."},{"name":"view","in":"query","required":false,"schema":{"type":"string","description":"Curve view to return: nodes, slopes, or forwards.","examples":["nodes","slopes","forwards"],"default":"nodes","title":"View","enum":["nodes","slopes","forwards"],"example":"nodes"},"description":"Optional query parameter. Curve view to return: nodes, slopes, or forwards. Allowed values: nodes, slopes, forwards."},{"name":"method","in":"query","required":false,"schema":{"type":"string","description":"Forward derivation method used when view=forwards.","examples":["derived_from_spot_nodes"],"default":"derived_from_spot_nodes","title":"Method","enum":["derived_from_spot_nodes"],"example":"derived_from_spot_nodes"},"description":"Optional query parameter. Forward derivation method used when view=forwards. Allowed values: derived_from_spot_nodes."},{"name":"date","in":"query","required":false,"schema":{"type":"string","description":"Optional target date YYYY-MM-DD. The endpoint returns the latest available node per maturity up to this date, using a recent lookback window.","examples":["2026-06-01"],"title":"Date"},"description":"Optional query parameter. Optional target date YYYY-MM-DD. The endpoint returns the latest available node per maturity up to this date, using a recent lookback window."},{"name":"as_of","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Explicit UTC information cutoff for verified vintage replay; date means start of day.","title":"As Of"},"description":"Optional query parameter. Explicit UTC information cutoff for verified vintage replay; date means start of day."},{"name":"availability","in":"query","required":false,"schema":{"type":"string","pattern":"^(public|captured)$","description":"Source-public or captured-value availability clock.","default":"public","title":"Availability"},"description":"Optional query parameter. Source-public or captured-value availability clock."},{"name":"max_staleness_days","in":"query","required":false,"schema":{"anyOf":[{"type":"integer","maximum":366,"minimum":0},{"type":"null"}],"description":"Maximum reference-date age; defaults to 7 with as_of, otherwise 60.","title":"Max Staleness Days"},"description":"Optional query parameter. Maximum reference-date age; defaults to 7 with as_of, otherwise 60."},{"name":"require_common_date","in":"query","required":false,"schema":{"anyOf":[{"type":"boolean"},{"type":"null"}],"description":"Require all populated curve nodes to share a reference date; defaults true with as_of.","title":"Require Common Date"},"description":"Optional query parameter. Require all populated curve nodes to share a reference date; defaults true with as_of."},{"name":"api_key","in":"query","required":false,"schema":{"type":"string","description":"Your Individual or Business API key","title":"Api Key"},"description":"Deprecated: legacy query-string API key. Still accepted so existing integrations keep working, but new integrations must send the key in the X-API-Key header (or Authorization: Bearer). A key is required for non-USD, paid-only, or full-history requests. Responses to requests authenticated this way carry a Deprecation header.","deprecated":true}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CurveAnalyticsResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}},"x-parameter-availability":{"currency":["AUD","CAD","CHF","CNH","CNY","DKK","EUR","GBP","ILS","JPY","KRW","MYR","NOK","NZD","PEN","SEK","THB","USD"],"curve_family":["government_nominal"],"metric":["spot"],"view":["nodes","slopes","forwards"],"method":["derived_from_spot_nodes"]}}},"/v1/financial_prices/{currency}":{"get":{"tags":["monetary_policy"],"summary":"Official financial prices and yield curves","description":"Official government and central-bank observations. Filter by source, issuer, instrument or measure. Separate nominal, real, par, zero, security quotes and auction observations by their dimensions. Source attribution and licence conditions accompany the data. Empty coverage means no observations are available yet.","operationId":"get_financial_prices_v1_financial_prices__currency__get","parameters":[{"name":"currency","in":"path","required":true,"schema":{"type":"string","title":"Currency"},"description":"Required path parameter."},{"name":"source","in":"query","required":false,"schema":{"anyOf":[{"type":"string","maxLength":80},{"type":"null"}],"title":"Source"},"description":"Optional query parameter."},{"name":"start_date","in":"query","required":false,"schema":{"anyOf":[{"type":"string","format":"date"},{"type":"null"}],"title":"Start Date"},"description":"Optional query parameter."},{"name":"end_date","in":"query","required":false,"schema":{"anyOf":[{"type":"string","format":"date"},{"type":"null"}],"title":"End Date"},"description":"Optional query parameter."},{"name":"measure","in":"query","required":false,"schema":{"anyOf":[{"type":"string","maxLength":60},{"type":"null"}],"title":"Measure"},"description":"Optional query parameter."},{"name":"instrument_id","in":"query","required":false,"schema":{"anyOf":[{"type":"string","maxLength":240},{"type":"null"}],"title":"Instrument Id"},"description":"Optional query parameter."},{"name":"issuer","in":"query","required":false,"schema":{"anyOf":[{"type":"string","maxLength":240},{"type":"null"}],"title":"Issuer"},"description":"Optional query parameter."},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","maximum":100,"minimum":1,"default":100,"title":"Limit"},"description":"Optional query parameter."},{"name":"offset","in":"query","required":false,"schema":{"type":"integer","minimum":0,"default":0,"title":"Offset"},"description":"Optional query parameter."},{"name":"api_key","in":"query","required":false,"schema":{"type":"string","description":"Your Individual or Business API key","title":"Api Key"},"description":"Deprecated: legacy query-string API key. Still accepted so existing integrations keep working, but new integrations must send the key in the X-API-Key header (or Authorization: Bearer). A key is required for non-USD, paid-only, or full-history requests. Responses to requests authenticated this way carry a Deprecation header.","deprecated":true}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/FinancialPriceResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/v1/press-releases/{currency}":{"get":{"tags":["press_releases"],"summary":"Recent central bank press releases","description":"Returns recent press releases from official central bank websites for the requested currency.\n\n**Supported currencies:** AUD, BRL, CAD, CHF, CNY, DKK, EUR, GBP, ILS, JPY, KRW, NGN, NOK, NZD, PEN, SEK, THB, USD\n\n**Path Parameters:**\n- `currency`: 3-letter ISO currency code (e.g., USD, EUR, GBP).\n\n**Query Parameters:**\n- `limit`: Maximum number of press releases to return per page (1–50, default 20).\n- `offset`: Zero-based pagination offset (default: 0).\n\n**Authentication:** USD press releases are publicly available without an API key. All other currencies require a professional API key supplied via `?api_key=<key>` or the `X-API-Key` header.\n\n**Data sources:** Official central bank RSS feeds and websites only.","operationId":"get_press_releases_v1_press_releases__currency__get","parameters":[{"name":"currency","in":"path","required":true,"schema":{"type":"string","title":"Currency","enum":["AUD","BRL","CAD","CHF","DKK","EUR","GBP","ILS","JPY","NGN","NOK","NZD","PEN","SEK","USD"],"example":"AUD"},"description":"Required path parameter. Allowed values: AUD, BRL, CAD, CHF, DKK, EUR, GBP, ILS, JPY, NGN, NOK, NZD, PEN, SEK, USD."},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","maximum":50,"minimum":1,"description":"Maximum number of press releases to return","examples":[10],"default":20,"title":"Limit"},"description":"Optional query parameter. Maximum number of press releases to return"},{"name":"offset","in":"query","required":false,"schema":{"type":"integer","minimum":0,"description":"Zero-based offset into the full press-release feed before pagination.","default":0,"title":"Offset"},"description":"Optional query parameter. Zero-based offset into the full press-release feed before pagination."},{"name":"api_key","in":"query","required":false,"schema":{"type":"string","description":"Your Individual or Business API key","title":"Api Key"},"description":"Deprecated: legacy query-string API key. Still accepted so existing integrations keep working, but new integrations must send the key in the X-API-Key header (or Authorization: Bearer). A key is required for non-USD, paid-only, or full-history requests. Responses to requests authenticated this way carry a Deprecation header.","deprecated":true}],"responses":{"200":{"description":"Recent press releases for the selected central bank.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PressReleasesResponse"},"example":{"currency":"USD","source":"Federal Reserve","source_url":"https://www.federalreserve.gov","count":2,"data":[{"title":"Federal Reserve issues FOMC statement","url":"https://www.federalreserve.gov/newsevents/pressreleases/monetary20260319a.htm","date":"2026-03-19","summary":"The Committee decided to maintain the target range for the federal funds rate...","category":"monetary_policy","relevance":0.95,"ai_summary":"FOMC held rates and stressed inflation persistence, signalling a longer plateau than markets had priced.","ai_stance":"hawkish","ai_stance_score":0.45,"ai_next_meeting_action":"hold","ai_next_meeting_probability":0.7,"ai_rationale":"Statement cited 'elevated' inflation and the need to keep policy 'sufficiently restrictive'.","rate_path":{"score":0.42,"label":"Moderately Hawkish","bias_action":"hike","confidence":"medium","raw_score":1.1,"matches":[{"phrase":"elevated inflation","weight":0.7},{"phrase":"restrictive stance","weight":0.7}]}}]}}}},"404":{"description":"Currency not supported for press releases."},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}},"x-parameter-availability":{"currency":["AUD","BRL","CAD","CHF","DKK","EUR","GBP","ILS","JPY","NGN","NOK","NZD","PEN","SEK","USD"]}}},"/v1/risk_sentiment/changes":{"get":{"tags":["fx_markets"],"summary":"Recorded risk-sentiment changes","description":"Returns retained additions, score revisions and input-metadata changes in increasing change_sequence order. Pass pagination.next_after_sequence as after_sequence on the next page or poll. The sequence remains stable when changes share a recording timestamp. recorded_at is the FXMacroData recording clock; earlier untracked revisions and publisher publication times are unavailable. An undated legacy baseline is retained but is not emitted as a newly recorded change.","operationId":"get_risk_sentiment_changes_v1_risk_sentiment_changes_get","parameters":[{"name":"after_sequence","in":"query","required":false,"schema":{"type":"integer","minimum":0,"description":"Return changes after this sequence (exclusive).","default":0,"title":"After Sequence"},"description":"Optional query parameter. Return changes after this sequence (exclusive)."},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","maximum":100,"minimum":1,"description":"Maximum retained changes per page.","default":20,"title":"Limit"},"description":"Optional query parameter. Maximum retained changes per page."}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RiskSentimentChangesResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/v1/risk_sentiment":{"get":{"tags":["fx_markets"],"summary":"Global risk-on / risk-off indicator","description":"Returns a composite daily risk-sentiment score indicating whether global financial conditions favour risk-on currencies (AUD, NZD, CAD) or risk-off safe havens (JPY, CHF, USD).\n\nThe score is derived from four publicly available sources:\n- **OFR FSI** (U.S. Treasury Office of Financial Research Financial Stress Index) — primary stress gauge, *inverted*\n- **Gold** (National Bank of Ukraine official gold price, USD per troy ounce; Narodowy Bank Polski where the NBU did not publish) — safe-haven demand proxy, *inverted*\n- **AUD/USD** (central-bank reference rates delivered via Frankfurter) — risk-sensitive currency pair\n- **USD/JPY** (central-bank reference rates delivered via Frankfurter) — safe-haven flow proxy\n\nEach component is normalised to a 252-day rolling z-score, weighted, and compressed through tanh to produce a final score in **[-1.0, +1.0]**.\n\n**Weights:** OFR FSI 40%, Gold 20%, AUD/USD 20%, USD/JPY 20%.\n\nWeights are renormalised over available components and reported as effective_weights. input_dates and input_status describe component observation dates and carry-forward. provisional marks lagged, missing or unknown inputs; complete inputs may also be revised. Recorded changes are available at `/v1/risk_sentiment/changes`; recording clocks are distinct from publisher publication times.\n\n**Query Parameters:**\n- `start_date`: Start date YYYY-MM-DD (default: 365 days ago).\n- `end_date`: End date YYYY-MM-DD (default: today).\n\n**Each data record contains:**\n- `date`: Observation date (YYYY-MM-DD).\n- `val`: Composite score -1.0 (extreme risk-off) ... +1.0 (extreme risk-on).\n- `regime`: `risk_on` (>= 0.25) | `neutral` | `risk_off` (<= -0.25).\n- `components.ofr_fsi`: Normalised (inverted) OFR FSI contribution.\n- `components.gold`: Normalised (inverted) gold price contribution.\n- `components.aud_usd`: Normalised AUD/USD contribution.\n- `components.usd_jpy`: Normalised USD/JPY contribution.","operationId":"get_risk_sentiment_v1_risk_sentiment_get","parameters":[{"name":"start_date","in":"query","required":false,"schema":{"type":"string","description":"Start date YYYY-MM-DD","examples":["2025-12-01"],"title":"Start Date"},"description":"Optional query parameter. Start date YYYY-MM-DD"},{"name":"end_date","in":"query","required":false,"schema":{"type":"string","description":"End date YYYY-MM-DD","examples":["2026-03-01"],"title":"End Date"},"description":"Optional query parameter. End date YYYY-MM-DD"},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","maximum":100,"minimum":1,"description":"Maximum rows to return. Defaults to 20. Maximum 100.","default":20,"title":"Limit"},"description":"Optional query parameter. Maximum rows to return. Defaults to 20. Maximum 100."},{"name":"offset","in":"query","required":false,"schema":{"type":"integer","minimum":0,"description":"Number of rows to skip after most-recent-first ordering.","default":0,"title":"Offset"},"description":"Optional query parameter. Number of rows to skip after most-recent-first ordering."}],"responses":{"200":{"description":"Risk sentiment time series and component-level contributions.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RiskSentimentResponse"},"example":{"start_date":"2025-12-01","end_date":"2026-03-01","data":[{"date":"2026-02-28","val":0.31,"regime":"risk_on","components":{"ofr_fsi":0.18,"gold":-0.07,"aud_usd":0.09,"usd_jpy":0.04}}]}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/v1/factors/{currency}/{factor}":{"get":{"tags":["factors"],"summary":"Get a precomputed FX factor for one currency","description":"Returns a factor series for one explicit currency and one explicit factor. Factor values are precomputed snapshots; component macro indicators are not recalculated per request.\n\n**Path Parameters:**\n- `currency`: Three-letter currency code, for example `EUR` or `USD`.\n- `factor`: Factor slug. Currently supported: `monetary_stance`.\n\n**Query Parameters:**\n- `start_date` / `end_date`: Optional date window. With no dates, the latest snapshot is returned.\n- `include_components`: Include component scores and input values.\n- `include_sources`: Include FXMacroData source endpoint URLs.\n\nUse `/v1/data_catalogue/{currency}?include_capabilities=true` for factor discovery metadata.\n\n**Authentication:** USD factor data is public without an API key. Anonymous requests are subject to a 100 requests/day per-IP fair-use limit. Other currencies require an Individual or Business API key sent in the `X-API-Key` header.","operationId":"get_currency_factor_v1_factors__currency___factor__get","parameters":[{"name":"currency","in":"path","required":true,"schema":{"type":"string","title":"Currency","enum":["AUD","CAD","CHF","EUR","GBP","JPY","NZD","USD"],"example":"AUD"},"description":"Required path parameter. Allowed values: AUD, CAD, CHF, EUR, GBP, JPY, NZD, USD."},{"name":"factor","in":"path","required":true,"schema":{"type":"string","description":"Factor slug, for example monetary_stance.","examples":["monetary_stance"],"title":"Factor","enum":["monetary_stance"],"example":"monetary_stance"},"description":"Required path parameter. Factor slug, for example monetary_stance. Allowed values: monetary_stance."},{"name":"start_date","in":"query","required":false,"schema":{"type":"string","description":"Inclusive start date YYYY-MM-DD. With no dates, returns latest only.","examples":["2026-01-01"],"title":"Start Date"},"description":"Optional query parameter. Inclusive start date YYYY-MM-DD. With no dates, returns latest only."},{"name":"end_date","in":"query","required":false,"schema":{"type":"string","description":"Inclusive end date YYYY-MM-DD. Defaults to today when start_date is supplied.","examples":["2026-07-19"],"title":"End Date"},"description":"Optional query parameter. Inclusive end date YYYY-MM-DD. Defaults to today when start_date is supplied."},{"name":"include_components","in":"query","required":false,"schema":{"type":"boolean","description":"Include component scores and source observations.","default":false,"title":"Include Components"},"description":"Optional query parameter. Include component scores and source observations."},{"name":"include_sources","in":"query","required":false,"schema":{"type":"boolean","description":"Include FXMacroData source endpoint URLs.","default":false,"title":"Include Sources"},"description":"Optional query parameter. Include FXMacroData source endpoint URLs."},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","maximum":100,"minimum":1,"description":"Maximum rows to return. Defaults to 20. Maximum 100.","default":20,"title":"Limit"},"description":"Optional query parameter. Maximum rows to return. Defaults to 20. Maximum 100."},{"name":"offset","in":"query","required":false,"schema":{"type":"integer","minimum":0,"description":"Number of rows to skip after most-recent-first ordering.","default":0,"title":"Offset"},"description":"Optional query parameter. Number of rows to skip after most-recent-first ordering."},{"name":"api_key","in":"query","required":false,"schema":{"type":"string","description":"Your Individual or Business API key","title":"Api Key"},"description":"Deprecated: legacy query-string API key. Still accepted so existing integrations keep working, but new integrations must send the key in the X-API-Key header (or Authorization: Bearer). A key is required for non-USD, paid-only, or full-history requests. Responses to requests authenticated this way carry a Deprecation header.","deprecated":true}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/FactorResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}},"x-parameter-availability":{"currency":["AUD","CAD","CHF","EUR","GBP","JPY","NZD","USD"],"factor":["monetary_stance"]}}},"/v1/predictions/coverage":{"get":{"tags":["predictions"],"summary":"Which forecast publishers cover which currency (no API key)","description":"Free, key-free catalogue of forecast coverage across every served currency: which publishers we carry, what class of forecast each produces, and which currencies carry a genuine consensus source. Returns no forecast values -- those require a plan. Use ``/v1/predictions/coverage/{currency}`` for per-indicator detail.","operationId":"get_prediction_coverage_index_v1_predictions_coverage_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/v1/predictions/coverage/{currency}":{"get":{"tags":["predictions"],"summary":"Per-indicator forecast coverage for one currency (no API key)","description":"Free, key-free per-indicator catalogue for one currency: the publishers covering each indicator, the ``prediction_class`` each produces, whether any of them is a genuine consensus, and the verified archive depth where it has been confirmed. Returns no forecast values -- those require a plan.","operationId":"get_prediction_coverage_for_currency_v1_predictions_coverage__currency__get","parameters":[{"name":"currency","in":"path","required":true,"schema":{"type":"string","minLength":2,"maxLength":8,"title":"Currency"},"description":"Required path parameter."}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/v1/predictions/{currency}":{"get":{"tags":["predictions"],"summary":"Page official forecast vintages from one publisher","description":"Read one explicitly named source; bare currency listings stay disabled.\n\nThis path never fans out to announcement indicators. Native variables,\npublication precision and horizons remain those of the publisher.","operationId":"get_predictions_missing_indicator_v1_predictions__currency__get","parameters":[{"name":"currency","in":"path","required":true,"schema":{"type":"string","title":"Currency"},"description":"Required path parameter."},{"name":"prediction_source","in":"query","required":false,"schema":{"anyOf":[{"type":"string","maxLength":160},{"type":"null"}],"description":"Required publisher identifier for source-scoped native forecast history.","title":"Prediction Source"},"description":"Optional query parameter. Required publisher identifier for source-scoped native forecast history."},{"name":"variable","in":"query","required":false,"schema":{"anyOf":[{"type":"string","maxLength":250},{"type":"null"}],"title":"Variable"},"description":"Optional query parameter."},{"name":"target_period","in":"query","required":false,"schema":{"anyOf":[{"type":"string","maxLength":160},{"type":"null"}],"title":"Target Period"},"description":"Optional query parameter."},{"name":"publication_precision","in":"query","required":false,"schema":{"anyOf":[{"enum":["exact","date","unknown"],"type":"string"},{"type":"null"}],"title":"Publication Precision"},"description":"Optional query parameter."},{"name":"before_id","in":"query","required":false,"schema":{"anyOf":[{"type":"string","maxLength":256},{"type":"null"}],"title":"Before Id"},"description":"Optional query parameter."},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","maximum":1000,"minimum":1,"default":100,"title":"Limit"},"description":"Optional query parameter."}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/v1/predictions/{currency}/{indicator}":{"get":{"tags":["predictions"],"summary":"List predictions for one indicator of a currency","description":"Returns every available prediction for the requested ``currency``/``indicator`` pair. Each row is stamped with its original ``generated_at`` and full source provenance (real archived vintage vs FXMacroData's own live-generated forecast, never reconstructed with later data). Per-source archive start dates and market-consensus coverage vary by indicator: see https://fxmacrodata.com/documentation/point-in-time-backtesting for the exact earliest date per source and indicator before assuming multi-year depth exists for every series.\n\n**Authentication:** this endpoint requires an API key on every currency, including USD. Anonymous callers receive 401 `api_key_required`. A 14-day free trial at https://fxmacrodata.com/subscribe opens the full history on every supported currency.","operationId":"get_indicator_predictions_v1_predictions__currency___indicator__get","parameters":[{"name":"currency","in":"path","required":true,"schema":{"type":"string","title":"Currency","enum":["AUD","BRL","CAD","CHF","CNH","CNY","DKK","EUR","GBP","HUF","ILS","JPY","KRW","MYR","NGN","NOK","NZD","PEN","SEK","THB","TWD","USD"],"example":"AUD"},"description":"Required path parameter. Allowed values: AUD, BRL, CAD, CHF, CNH, CNY, DKK, EUR, GBP, HUF, ILS, JPY, KRW, MYR, NGN, NOK, NZD, PEN, SEK, THB, TWD, USD."},{"name":"indicator","in":"path","required":true,"schema":{"type":"string","description":"Indicator slug","examples":["inflation"],"title":"Indicator","enum":["afe_dollar_index","average_hourly_earnings","average_hourly_earnings_mom","balance_on_goods","balance_on_services","bgcr","breakeven_inflation_rate","broad_dollar_index","broad_money","building_approvals","building_permits","business_confidence","capital_account_balance","cb_assets","commodity_price_energy","commodity_price_ex_energy","commodity_price_index","commodity_prices","consumer_confidence","core_inflation","core_inflation_median","core_inflation_mom","core_inflation_trim","core_pce","core_pce_mom","credit_growth","crude_oil_inventories","current_account_balance","dairy_exports","deposit_rates","durable_goods_orders","effr","eme_dollar_index","employment","exports","financial_account_balance","foreign_reserves","full_time_employment","fx_reserves","gdp","gdp_growth_q4_yoy","gold_reserves","gov_bond_10y","gov_bond_15y","gov_bond_1_5m","gov_bond_1m","gov_bond_1y","gov_bond_20y","gov_bond_25y","gov_bond_2m","gov_bond_2y","gov_bond_30y","gov_bond_3m","gov_bond_3y","gov_bond_40y","gov_bond_4m","gov_bond_4y","gov_bond_5y","gov_bond_6m","gov_bond_6y","gov_bond_7y","gov_bond_8y","gov_bond_9y","government_debt","house_price_index","house_prices","household_credit","household_spending","housing_starts","import_prices","imports","industrial_production","inflation","inflation_linked_bond","inflation_mom","initial_jobless_claims","international_assets","international_liabilities","job_openings","m1","m2","m3","nairu","natural_gas_storage","net_foreign_asset_position","non_farm_payrolls","non_farm_payrolls_change","obfr","part_time_employment","participation_rate","pce","pce_mom","policy_rate","policy_rate_midpoint","policy_rate_mlf","policy_rate_mro","policy_rate_target_lower","ppi","primary_income_balance","productivity","real_yield_20y","real_yield_30y","real_yield_5y","real_yield_7y","retail_sales","retail_sales_control_group","retail_sales_ex_autos","retail_sales_ex_autos_and_gas","risk_free_rate","secondary_income_balance","sight_deposits","snb_balance_sheet","sofr_average_180d","sofr_average_30d","sofr_average_90d","sofr_index","terms_of_trade","tgcr","trade_balance","trade_weighted_index","trimmed_mean_inflation","unemployment","wage_price_index","wages"],"example":"afe_dollar_index"},"description":"Required path parameter. Indicator slug Allowed values: afe_dollar_index, average_hourly_earnings, average_hourly_earnings_mom, balance_on_goods, balance_on_services, bgcr, breakeven_inflation_rate, broad_dollar_index, broad_money, building_approvals, building_permits, business_confidence, capital_account_balance, cb_assets, commodity_price_energy, commodity_price_ex_energy, commodity_price_index, commodity_prices, consumer_confidence, core_inflation, core_inflation_median, core_inflation_mom, core_inflation_trim, core_pce, core_pce_mom, credit_growth, crude_oil_inventories, current_account_balance, dairy_exports, deposit_rates, durable_goods_orders, effr, eme_dollar_index, employment, exports, financial_account_balance, foreign_reserves, full_time_employment, fx_reserves, gdp, gdp_growth_q4_yoy, gold_reserves, gov_bond_10y, gov_bond_15y, gov_bond_1_5m, gov_bond_1m, gov_bond_1y, gov_bond_20y, gov_bond_25y, gov_bond_2m, gov_bond_2y, gov_bond_30y, gov_bond_3m, gov_bond_3y, gov_bond_40y, gov_bond_4m, gov_bond_4y, gov_bond_5y, gov_bond_6m, gov_bond_6y, gov_bond_7y, gov_bond_8y, gov_bond_9y, government_debt, house_price_index, house_prices, household_credit, household_spending, housing_starts, import_prices, imports, industrial_production, inflation, inflation_linked_bond, inflation_mom, initial_jobless_claims, international_assets, international_liabilities, job_openings, m1, m2, m3, nairu, natural_gas_storage, net_foreign_asset_position, non_farm_payrolls, non_farm_payrolls_change, obfr, part_time_employment, participation_rate, pce, pce_mom, policy_rate, policy_rate_midpoint, policy_rate_mlf, policy_rate_mro, policy_rate_target_lower, ppi, primary_income_balance, productivity, real_yield_20y, real_yield_30y, real_yield_5y, real_yield_7y, retail_sales, retail_sales_control_group, retail_sales_ex_autos, retail_sales_ex_autos_and_gas, risk_free_rate, secondary_income_balance, sight_deposits, snb_balance_sheet, sofr_average_180d, sofr_average_30d, sofr_average_90d, sofr_index, terms_of_trade, tgcr, trade_balance, trade_weighted_index, trimmed_mean_inflation, unemployment, wage_price_index, wages."},{"name":"prediction_class","in":"query","required":false,"schema":{"anyOf":[{"enum":["compiled_consensus","forecaster_survey","market_implied","model_nowcast","central_bank_projection","institutional_projection","fxmacrodata"],"type":"string"},{"type":"null"}],"description":"Filter by how the forecast was produced. Prefer this over `prediction_type`: one class can span several legacy types, which is how `forecaster_survey` returns both the ECB and Philadelphia Fed Surveys of Professional Forecasters.","title":"Prediction Class"},"description":"Optional query parameter. Filter by how the forecast was produced. Prefer this over `prediction_type`: one class can span several legacy types, which is how `forecaster_survey` returns both the ECB and Philadelphia Fed Surveys of Professional Forecasters."},{"name":"prediction_type","in":"query","required":false,"schema":{"anyOf":[{"enum":["market_consensus","market_prediction","model_nowcast","survey","central_bank_forecast","central_bank_projection","imf_weo","oecd_eo","fxmacrodata"],"type":"string"},{"type":"null"}],"description":"Optional legacy prediction-type filter, retained unchanged for existing clients. Superseded by `prediction_class`.","title":"Prediction Type"},"description":"Optional query parameter. Optional legacy prediction-type filter, retained unchanged for existing clients. Superseded by `prediction_class`."},{"name":"prediction_source","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Optional source identifier filter.","title":"Prediction Source"},"description":"Optional query parameter. Optional source identifier filter."},{"name":"official_limit","in":"query","required":false,"schema":{"type":"integer","maximum":2000,"minimum":0,"description":"Maximum rows in ``official_forecasts`` (native-period official forecasts and surveys). 0 omits them.","default":500,"title":"Official Limit"},"description":"Optional query parameter. Maximum rows in ``official_forecasts`` (native-period official forecasts and surveys). 0 omits them."},{"name":"pre_release_only","in":"query","required":false,"schema":{"type":"boolean","description":"Return only forecasts with `generated_at` strictly before the linked `announcement_datetime` (default: true). FXMacroData only publishes forecasts generated before the announcement, so this flag is informational: setting it to false does not return additional rows.","default":true,"title":"Pre Release Only"},"description":"Optional query parameter. Return only forecasts with `generated_at` strictly before the linked `announcement_datetime` (default: true). FXMacroData only publishes forecasts generated before the announcement, so this flag is informational: setting it to false does not return additional rows."},{"name":"seasonality","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Optional seasonal adjustment selector, matching /v1/announcements.","title":"Seasonality","enum":["sa","nsa"],"example":"sa"},"description":"Optional query parameter. Optional seasonal adjustment selector, matching /v1/announcements. Allowed values: sa, nsa."},{"name":"frequency","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Optional returned change basis selector, matching /v1/announcements.","title":"Frequency","enum":["level","yoy","qoq","mom"],"example":"level"},"description":"Optional query parameter. Optional returned change basis selector, matching /v1/announcements. Allowed values: level, yoy, qoq, mom."},{"name":"annualization","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Optional annualization selector, matching /v1/announcements.","title":"Annualization","enum":["not_annualized","saar"],"example":"not_annualized"},"description":"Optional query parameter. Optional annualization selector, matching /v1/announcements. Allowed values: not_annualized, saar."},{"name":"period_aggregation","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Optional period aggregation selector, matching /v1/announcements.","title":"Period Aggregation","enum":["monthly","quarterly_average"],"example":"monthly"},"description":"Optional query parameter. Optional period aggregation selector, matching /v1/announcements. Allowed values: monthly, quarterly_average."},{"name":"basis","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Optional real/nominal selector, matching /v1/announcements.","title":"Basis","enum":["real","nominal"],"example":"real"},"description":"Optional query parameter. Optional real/nominal selector, matching /v1/announcements. Allowed values: real, nominal."},{"name":"start_date","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Start date YYYY-MM-DD (period date). Defaults to 180 days before today when omitted.","title":"Start Date"},"description":"Optional query parameter. Start date YYYY-MM-DD (period date). Defaults to 180 days before today when omitted."},{"name":"end_date","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"End date YYYY-MM-DD (period date). Defaults to 90 days ahead when omitted.","title":"End Date"},"description":"Optional query parameter. End date YYYY-MM-DD (period date). Defaults to 90 days ahead when omitted."},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","maximum":100,"minimum":1,"description":"Maximum number of prediction groups to return in `data[]`. Use with `offset` to page through long histories. Defaults to 20. Maximum 100.","examples":[20],"default":20,"title":"Limit"},"description":"Optional query parameter. Maximum number of prediction groups to return in `data[]`. Use with `offset` to page through long histories. Defaults to 20. Maximum 100."},{"name":"offset","in":"query","required":false,"schema":{"type":"integer","minimum":0,"description":"Number of prediction groups to skip from the start of `data[]`. Use with `limit` for pagination. Defaults to 0.","examples":[0],"default":0,"title":"Offset"},"description":"Optional query parameter. Number of prediction groups to skip from the start of `data[]`. Use with `limit` for pagination. Defaults to 0."},{"name":"page","in":"query","required":false,"schema":{"anyOf":[{"type":"integer","minimum":1},{"type":"null"}],"description":"One-based page number. When supplied, it takes precedence over offset.","examples":[1],"title":"Page"},"description":"Optional query parameter. One-based page number. When supplied, it takes precedence over offset."},{"name":"before_date","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Return groups strictly before this YYYY-MM-DD period date. Use the previous response's `next_cursor` for bounded pagination.","title":"Before Date"},"description":"Optional query parameter. Return groups strictly before this YYYY-MM-DD period date. Use the previous response's `next_cursor` for bounded pagination."},{"name":"as_of","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"As Of"},"description":"Optional query parameter."},{"name":"event_compatible_only","in":"query","required":false,"schema":{"type":"boolean","default":false,"title":"Event Compatible Only"},"description":"Optional query parameter."},{"name":"api_key","in":"query","required":false,"schema":{"type":"string","description":"Your Individual or Business API key","title":"Api Key"},"description":"Deprecated: legacy query-string API key. Still accepted so existing integrations keep working, but new integrations must send the key in the X-API-Key header (or Authorization: Bearer). A key is required for non-USD, paid-only, or full-history requests. Responses to requests authenticated this way carry a Deprecation header.","deprecated":true}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PredictionsResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}},"x-parameter-availability":{"currency":["AUD","BRL","CAD","CHF","CNH","CNY","DKK","EUR","GBP","HUF","ILS","JPY","KRW","MYR","NGN","NOK","NZD","PEN","SEK","THB","TWD","USD"],"indicator":["afe_dollar_index","average_hourly_earnings","average_hourly_earnings_mom","balance_on_goods","balance_on_services","bgcr","breakeven_inflation_rate","broad_dollar_index","broad_money","building_approvals","building_permits","business_confidence","capital_account_balance","cb_assets","commodity_price_energy","commodity_price_ex_energy","commodity_price_index","commodity_prices","consumer_confidence","core_inflation","core_inflation_median","core_inflation_mom","core_inflation_trim","core_pce","core_pce_mom","credit_growth","crude_oil_inventories","current_account_balance","dairy_exports","deposit_rates","durable_goods_orders","effr","eme_dollar_index","employme