          },
          "f_18_59": {
            "type": "integer"
          },
          "f_60": {
            "type": "integer"
          },
          "f_other": {
            "type": "integer"
          },
          "m_0_4": {
            "type": "integer"
          },
          "m_5_11": {
            "type": "integer"
          },
          "m_12_17": {
            "type": "integer"
          },
          "m_18_59": {
            "type": "integer"
          },
          "m_60": {
            "type": "integer"
          },
          "m_other": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          }
        }
      },
      "AsylumDecision": {
        "type": "object",
        "properties": {
          "year": {
            "type": "integer"
          },
          "coo_id": {
            "type": "integer"
          },
          "coo_name": {
            "type": "string"
          },
          "coo": {
            "type": "string"
          },
          "coo_iso": {
            "type": "string"
          },
          "coa_id": {
            "type": "integer"
          },
          "coa_name": {
            "type": "string"
          },
          "coa": {
            "type": "string"
          },
          "coa_iso": {
            "type": "string"
          },
          "procedure_type": {
            "type": "string"
          },
          "dec_level": {
            "type": "string"
          },
          "dec_recognized": {
            "type": "integer"
          },
          "dec_other": {
            "type": "integer"
          },
          "dec_rejected": {
            "type": "integer"
