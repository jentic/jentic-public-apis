{
  "openapi": "3.0.3",
  "info": {
    "title": "UNHCR Refugee Data API",
    "description": "The UNHCR Population Statistics API provides access to data on refugees, asylum seekers, internally displaced persons, and other populations of concern. Includes demographic breakdowns, asylum decisions, and country-level statistics.",
    "version": "1.0.0",
    "contact": {
      "name": "UNHCR",
      "url": "https://www.unhcr.org"
    },
    "x-jentic-source-url": "https://api.unhcr.org/docs/",
    "x-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://api.unhcr.org/population/v1",
      "description": "UNHCR Population Statistics API"
    }
  ],
  "paths": {
    "/countries/": {
      "get": {
        "operationId": "getCountries",
        "summary": "List all countries and territories",
        "description": "Returns a paginated list of countries and territories with codes, names, and regional classifications used across the UNHCR data.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Page number",
            "schema": {
              "type": "integer",
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of countries",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "page": {
                      "type": "integer"
                    },
                    "maxPages": {
                      "type": "integer"
                    },
                    "total": {
                      "type": "array",
                      "items": {}
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Country"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/demographics/": {
      "get": {
        "operationId": "getDemographics",
        "summary": "Get demographic data for populations of concern",
        "description": "Returns demographic breakdowns by age group and gender for refugee and displaced populations, filterable by year, country of origin, and country of asylum.",
        "parameters": [
          {
            "name": "year",
            "in": "query",
            "description": "Filter by year",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "coo",
            "in": "query",
            "description": "Country of origin ISO3 code",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "coa",
            "in": "query",
            "description": "Country of asylum ISO3 code",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Results per page",
            "schema": {
              "type": "integer",
              "default": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Demographic data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "page": {
                      "type": "integer"
                    },
                    "maxPages": {
                      "type": "integer"
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/DemographicRecord"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/asylum-decisions/": {
      "get": {
        "operationId": "getAsylumDecisions",
        "summary": "Get asylum decision statistics",
        "description": "Returns asylum decision data including recognized, rejected, closed, and other outcomes, filterable by year, country, procedure type, and decision level.",
        "parameters": [
          {
            "name": "year",
            "in": "query",
            "description": "Filter by year",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "coo",
            "in": "query",
            "description": "Country of origin ISO3 code",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "coa",
            "in": "query",
            "description": "Country of asylum ISO3 code",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Asylum decision data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "page": {
                      "type": "integer"
                    },
                    "maxPages": {
                      "type": "integer"
                    },
                    "total": {
                      "type": "object",
                      "properties": {
                        "dec_recognized": {
                          "type": "integer"
                        },
                        "dec_other": {
                          "type": "integer"
                        },
                        "dec_rejected": {
                          "type": "integer"
                        },
                        "dec_closed": {
                          "type": "integer"
                        },
                        "dec_total": {
                          "type": "integer"
                        }
                      }
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/AsylumDecision"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/unrwa/": {
      "get": {
        "operationId": "getUnrwaData",
        "summary": "Get UNRWA population data",
        "description": "Returns population data from UNRWA (United Nations Relief and Works Agency for Palestine Refugees).",
        "parameters": [
          {
            "name": "year",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "coa",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "UNRWA population data"
          }
        }
      }
    },
    "/population/": {
      "get": {
        "operationId": "getPopulationData",
        "summary": "Get population figures for persons of concern",
        "description": "Returns aggregated population figures including refugees, asylum seekers, IDPs, stateless persons, and others of concern.",
        "parameters": [
          {
            "name": "year",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "coo",
            "in": "query",
            "description": "Country of origin ISO3 code",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "coa",
            "in": "query",
            "description": "Country of asylum ISO3 code",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Population data"
          }
        }
      }
    },
    "/solutions/": {
      "get": {
        "operationId": "getSolutionsData",
        "summary": "Get durable solutions data",
        "description": "Returns data on durable solutions for displaced populations including voluntary repatriation, resettlement, and naturalization.",
        "parameters": [
          {
            "name": "year",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "coo",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "coa",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Solutions data"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Country": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "iso": {
            "type": "string"
          },
          "iso2": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "nameOrigin": {
            "type": "string"
          },
          "nameLong": {
            "type": "string"
          },
          "nameShort": {
            "type": "string"
          },
          "nameFormal": {
            "type": "string"
          },
          "nameFr": {
            "type": "string"
          },
          "majorArea": {
            "type": "string"
          },
          "region": {
            "type": "string"
          },
          "nationality": {
            "type": "string"
          }
        }
      },
      "DemographicRecord": {
        "type": "object",
        "properties": {
          "year": {
            "type": "integer"
          },
          "coo_id": {
            "type": "integer"
          },
          "coo_name": {
            "type": "string"
          },
          "coo": {
            "type": "string"
          },
          "coo_iso": {
            "type": "string"
          },
          "coa_id": {
            "type": "integer"
          },
          "coa_name": {
            "type": "string"
          },
          "coa": {
            "type": "string"
          },
          "coa_iso": {
            "type": "string"
          },
          "f_0_4": {
            "type": "integer"
          },
          "f_5_11": {
            "type": "integer"
