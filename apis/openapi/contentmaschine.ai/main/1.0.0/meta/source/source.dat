        "/v1/videos/generate": {
            "post": {
                "summary": "Generate a video (async)",
                "description": "Queue a text-to-video generation job (optionally seeded by a library image as the start frame).\nReturns immediately with a `job_id` - poll `GET /v1/jobs/{id}` until `status` is `completed`.\nAllowed `duration` and `resolution` values depend on the chosen model.",
                "operationId": "generateVideo",
                "tags": [
                    "Videos"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "prompt"
                                ],
                                "properties": {
                                    "prompt": {
                                        "type": "string",
                                        "description": "Description of the video to generate.",
                                        "example": "A timelapse of clouds rolling over a mountain range at dawn"
                                    },
                                    "model": {
                                        "type": "string",
                                        "description": "Video model to use. omni is Gemini Omni Flash. The retired id veo3 is still accepted and runs on omni.",
                                        "enum": [
                                            "omni",
                                            "grok",
                                            "kling",
                                            "seedance"
                                        ],
                                        "default": "omni"
                                    },
                                    "aspect_ratio": {
                                        "type": "string",
                                        "description": "Aspect ratio of the video. Defaults to the start image's shape when image_file_uuid is given, else 16:9. omni renders 16:9 or 9:16 only: portrait ratios become 9:16, square and landscape ratios 16:9.",
                                        "enum": [
                                            "1:1",
                                            "16:9",
                                            "9:16",
                                            "4:3",
                                            "3:4",
                                            "3:2",
                                            "2:3"
                                        ]
                                    },
                                    "duration": {
                                        "type": "integer",
                                        "description": "Length in seconds. omni: 3 to 10 (values outside are clamped). grok: 5, 8, 10 or 15. kling: 3, 5, 8, 10 or 15. seedance: 4, 6, 8, 10, 15, 20 or 30. For grok, kling and seedance other values snap down to the nearest of these (below the first, the first), so the generated length is the billed length; the 202 response reports the duration used.",
                                        "default": 8
                                    },
                                    "resolution": {
                                        "type": "string",
                                        "enum": [
                                            "720p",
                                            "480p",
                                            "standard",
                                            "pro"
                                        ],
                                        "description": "Per model: omni 720p; grok 480p or 720p; kling standard or pro; seedance 480p or 720p. Omit it for the model's default (omni 720p, grok 480p, kling standard, seedance 480p); a value the model does not support also falls back to that default."
                                    },
                                    "negative_prompt": {
                                        "type": "string",
                                        "description": "What the video should avoid. omni has no negative prompt parameter, so it is appended to the prompt text."
                                    },
                                    "image_file_uuid": {
                                        "type": "string",
                                        "description": "Optional uuid of an image already in your library to use as the start frame (no upload needed)."
                                    },
                                    "options": {
                                        "type": "object",
                                        "description": "Model-specific options."
                                    }
                                }
                            },
                            "examples": {
                                "text_to_video": {
                                    "summary": "Text to video",
                                    "value": {
                                        "prompt": "A neon city street in the rain, cinematic",
                                        "model": "omni",
                                        "aspect_ratio": "16:9",
                                        "duration": 8
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "202": {
                        "description": "Job queued. `data` also carries `model`, `duration`, `resolution` and `aspect_ratio`: the values that will be generated and billed, after defaults and snapping.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/JobQueued"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Missing prompt",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Missing or invalid API key",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    },
                    "402": {
                        "description": "Insufficient credits",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "image_file_uuid not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    },
                    "default": {
                        "description": "Any other error. Every failure this API emits uses the same envelope; branch on `error.type`, never on `error.message`, and quote `error.correlation_id` to support.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    }
                },
                "x-required-scope": "videos:write"
            }
        },
        "/v1/jobs/{id}": {
