        "/files/download/{uuid}": {
            "get": {
                "summary": "Download a file (legacy path)",
                "description": "The OLDER download path, kept because existing callers and the product's own file\nflows use it. It accepts the same Bearer token.\n\n**It does NOT authorize the same way as `GET /v1/files/{uuid}/download`, and the\ndifference is stated here rather than left to be discovered.** This route is\nowner-checked but carries NO SCOPE CHECK AT ALL: any valid token belonging to the\nowner is served the file, including one holding neither `files:read` nor the\nfile's container read scope. The `/v1/` route requires both. Prefer the `/v1/`\nroute; this one is documented for accuracy, not recommended.\n\nThis is the only non-`/v1/` path in this document.",
                "operationId": "downloadFile",
                "tags": [
                    "Files"
                ],
                "parameters": [
                    {
                        "name": "uuid",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Binary image file",
                        "content": {
                            "image/png": [],
                            "image/jpeg": [],
                            "image/webp": []
                        }
                    },
                    "401": {
                        "description": "Missing or invalid API key",
                        "content": {
                            "application/json": {
                                "schema": {
