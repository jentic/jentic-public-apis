        "/v1/images/mockup": {
            "post": {
                "summary": "Start a product-mockup generation (async)",
                "description": "Places one or more product images into a generated scene.\n\nASYNCHRONOUS, and NOT through the normal job endpoint: it returns a `job_id`\nthat is polled with `GET /v1/images/mockup-status`, not with `GET /v1/jobs/{id}`.\nGive the product image as a library file uuid (`file_uuid`), or INLINE as base64\n(`images`, or the single-image `imageData` + `mimeType` pair).",
                "operationId": "startMockupGeneration",
                "tags": [
                    "Images"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "prompt": {
                                        "type": "string",
                                        "description": "What the mockup scene should show."
                                    },
                                    "file_uuid": {
                                        "type": "string",
                                        "description": "Uuid of a library image to place in the scene. Use this or the inline `images` / `imageData`.",
                                        "format": "uuid"
                                    },
                                    "images": {
                                        "type": "array",
                                        "description": "Product images. Each entry is {data, mimeType}. Alternatively send the single-image `imageData` + `mimeType` pair.",
                                        "items": {
                                            "type": "object",
                                            "properties": {
                                                "data": {
                                                    "type": "string"
                                                },
                                                "mimeType": {
                                                    "type": "string"
                                                }
                                            }
                                        }
                                    },
                                    "imageData": {
                                        "type": "string",
                                        "description": "Single-image alternative to `images`: a base64 payload. Requires `mimeType`."
                                    },
                                    "mimeType": {
                                        "type": "string",
                                        "description": "Mime type of `imageData`."
                                    },
                                    "variability": {
                                        "type": "integer",
                                        "description": "How many variations to produce. Defaults to 1."
                                    },
                                    "modelVariant": {
                                        "type": "string",
                                        "description": "Model variant. Defaults to `standard`."
                                    },
                                    "modelOptions": {
                                        "type": "object",
                                        "additionalProperties": true,
                                        "description": "Per-model options; see GET /v1/models."
                                    }
                                },
                                "required": [
                                    "prompt"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Queued. Poll GET /v1/images/mockup-status with the returned job_id.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "data": {
                                            "type": "object",
                                            "additionalProperties": true
                                        },
                                        "timestamp": {
                                            "type": "string",
                                            "format": "date-time"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "No image (`file_uuid`, `images` or `imageData`/`mimeType`), or file_uuid together with inline data.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "file_uuid belongs to another user.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "file_uuid was not found.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Missing or invalid API key.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    },
                    "402": {
                        "description": "Insufficient credits.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    },
                    "default": {
                        "description": "Any other error. Every failure this API emits uses the same envelope; branch on `error.type`, never on `error.message`, and quote `error.correlation_id` to support.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    }
                },
                "x-required-scope": "images:write"
            }
        },
        "/v1/images/mockup-status": {
            "get": {
                "summary": "Poll a mockup generation",
                "description": "Returns the status of a mockup job started by POST /v1/images/mockup. Note this is a SEPARATE poller from GET /v1/jobs/{id} - a mockup job id is not a jobs-endpoint id.",
                "operationId": "getMockupStatus",
                "tags": [
                    "Images"
                ],
                "parameters": [
                    {
                        "name": "job_id",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string"
                        },
                        "description": "The job_id returned by POST /v1/images/mockup."
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Mockup job status.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "data": {
                                            "type": "object",
                                            "additionalProperties": true
                                        },
                                        "timestamp": {
                                            "type": "string",
                                            "format": "date-time"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "job_id parameter is required.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Missing or invalid API key.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "No such job, or it does not belong to you.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    },
                    "default": {
                        "description": "Any other error. Every failure this API emits uses the same envelope; branch on `error.type`, never on `error.message`, and quote `error.correlation_id` to support.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    }
                },
                "x-required-scope": "images:read"
            }
        },
        "/v1/images/instagram-enhance": {
            "post": {
                "summary": "Generate a social caption from images you own",
                "description": "Produces a platform-shaped caption - and on headline platforms a headline and a\ndescription - from 1 to 10 images already in your library.\n\n**SCOPES: this route needs `images:write` to CALL, but its OUTPUT reads as `text`**\n(D-15-23). The result is stored as a `caption_generation`, which classifies into the\n`text` container, so finding it later through /v1/gallery, /v1/library or\n/v1/jobs/{id} needs `text:read`. A token holding only `images:write` can run this\nand be charged for it, and then not be able to read the result back. The response\nbody returns the caption directly, so a single call still works.\n\nThe bytes are NOT accepted inline: upload with POST /v1/files/upload and pass the\nuuids. Limits: 10485760 bytes per image, 26214400 bytes across the call,\n`context` at most 2000 characters.\n\nThe prompt is built SERVER-SIDE. There is deliberately no raw `prompt` field: it\nwould turn the caption credit path into a general-purpose vision prompt. `context`\nand the blueprint fields are untrusted text spliced into a model instruction and the\nbuilder emits a guard sentence about them - a mitigation, not a guarantee.",
                "operationId": "instagramEnhance",
                "tags": [
                    "Images"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "file_uuids": {
                                        "type": "array",
                                        "minItems": 1,
                                        "maxItems": 10,
                                        "items": {
                                            "type": "string",
                                            "format": "uuid"
                                        },
                                        "description": "Uuids of images you own. Must be a real JSON array."
                                    },
                                    "platform": {
                                        "type": "string",
                                        "description": "Target platform, e.g. \"Instagram\" or \"TikTok\"."
                                    },
                                    "length": {
                                        "type": "string",
                                        "enum": [
                                            "Short",
                                            "Medium",
                                            "Long",
                                            "Very Long"
                                        ],
                                        "description": "Caption length."
                                    },
                                    "tone": {
                                        "type": "string",
                                        "description": "Tone, e.g. \"Friendly\"."
                                    },
                                    "language": {
                                        "type": "string",
                                        "description": "Output language, e.g. \"English\"."
                                    },
                                    "context": {
                                        "type": "string",
                                        "description": "Extra brief for the model. At most 2000 characters."
                                    },
                                    "blueprint": {
                                        "type": "object",
                                        "description": "Optional StoryBrand fields: title, businessName, hero, problem, guide, plan, callToAction, avoidFailure, success.",
                                        "additionalProperties": true
                                    },
                                    "additional_hashtags": {
                                        "description": "Your own hashtags as a string, or their count as an integer. On TikTok the model is asked for the remainder of five.",
                                        "oneOf": [
                                            {
                                                "type": "string"
                                            },
                                            {
                                                "type": "integer"
                                            }
                                        ]
                                    }
                                },
                                "required": [
                                    "file_uuids",
                                    "platform",
                                    "length",
                                    "tone",
                                    "language"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "The generated caption.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "headline": {
                                                    "type": "string",
                                                    "nullable": true,
                                                    "description": "Headline platforms only."
                                                },
                                                "description": {
                                                    "type": "string",
                                                    "nullable": true
                                                },
                                                "caption": {
                                                    "type": "string"
                                                },
                                                "hashtags": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "string"
                                                    }
                                                },
                                                "credits_used": {
                                                    "type": "number",
                                                    "format": "float",
                                                    "description": "Credits actually charged."
                                                },
                                                "generation_id": {
                                                    "type": "integer",
                                                    "description": "The stored generation, readable with text:read."
                                                },
                                                "processing_time_ms": {
                                                    "type": "integer",
                                                    "description": "Wall clock inside the handler."
                                                }
                                            }
                                        },
                                        "timestamp": {
                                            "type": "string",
                                            "format": "date-time"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad input: a missing field, an over-long value, more than 10 images, or a JSON object where an array was required.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Missing or invalid API key.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    },
                    "402": {
                        "description": "Insufficient credits.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "A file_uuid is unknown or not yours.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    },
                    "413": {
                        "description": "The images exceed the per-image or total byte limit.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    },
                    "415": {
                        "description": "One of the files is not an image.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    },
                    "503": {
                        "description": "The captioning provider is unavailable or rate limited.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    },
                    "default": {
                        "description": "Any other error. Every failure this API emits uses the same envelope; branch on `error.type`, never on `error.message`, and quote `error.correlation_id` to support.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    }
                },
                "x-required-scope": "images:write"
            }
        },
        "/v1/videos/merge": {
            "post": {
                "summary": "Concatenate two videos you own",
                "description": "Joins exactly two videos already in your library, in the order given, into one new\nvideo. Input is FILE REFERENCES, never a multi-file upload. There is no N-way merge.\n\n**SYNCHRONOUS. There is no job to poll, and there is a hard latency ceiling.**\nThe merge runs inside this request via ffmpeg. Which path runs decides everything:\ntwo clips that already share codec, resolution, frame rate and pixel format are\nstream-copied (`merge_method: lossless`); anything else is fully re-encoded\n(`reencode`), roughly an order of magnitude slower. Clips from two different\ngeneration models routinely differ, so the slow path is not an edge case.\n\nMEASURED on the deployed stack (2026-08-31):\n```\nlossless  2 x  30 s in ->  60 s out :   4.2 s   200\nlossless  2 x 180 s in -> 360 s out :   7.0 s   200\nreencode  2 x  30 s in ->  60 s out :  32.7 s   200\nreencode  2 x 180 s in              : 120.2 s   504\n```\nThe ceiling is the gateway read timeout of 120 seconds, not a limit this API can\nraise from PHP. The re-encode path costs about 0.55 s per second of OUTPUT, so treat\n**about 3 minutes of COMBINED input as the practical limit for mismatched clips**.\nPast it you receive a bare gateway 504 with NO JSON body - the only response on this\nAPI that is not the standard envelope - the work is discarded, and no output file is\nregistered. The stream-copy path is unconstrained at any length this API can ingest,\nbecause the 48 MB per-file upload cap binds first.\n\n`credits_used` is always 0 today. Merging is not currently billed; the field is\nreturned explicitly rather than left to be inferred.",
                "operationId": "mergeVideos",
                "tags": [
                    "Videos"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "file_uuids": {
                                        "type": "array",
                                        "minItems": 2,
                                        "maxItems": 2,
                                        "items": {
                                            "type": "string",
                                            "format": "uuid"
                                        },
                                        "description": "Exactly two uuids of videos you own, in join order."
                                    }
                                },
                                "required": [
                                    "file_uuids"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "The merged video.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "file_uuid": {
                                                    "type": "string",
                                                    "format": "uuid"
                                                },
                                                "download_url": {
                                                    "type": "string",
                                                    "description": "Authenticated download path for the merged file."
                                                },
                                                "merge_method": {
                                                    "type": "string",
                                                    "enum": [
                                                        "lossless",
                                                        "reencode"
                                                    ],
                                                    "description": "Which ffmpeg path ran."
                                                },
                                                "credits_used": {
                                                    "type": "number",
                                                    "format": "float",
                                                    "description": "Always 0 today."
                                                }
                                            }
                                        },
                                        "timestamp": {
                                            "type": "string",
                                            "format": "date-time"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Not exactly two file_uuids, or a malformed body.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Missing or invalid API key.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "A file_uuid is unknown or not yours.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    },
                    "415": {
                        "description": "One of the files is not a video.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    },
                    "504": {
                        "description": "Gateway timeout at 120 s. NOT a JSON envelope - this response comes from the gateway, not from the application. The merge was discarded and no file was created. Retry with shorter inputs, or with clips that share codec/resolution/frame rate so the stream-copy path runs."
                    },
                    "default": {
                        "description": "Any other error. Every failure this API emits uses the same envelope; branch on `error.type`, never on `error.message`, and quote `error.correlation_id` to support.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    }
                },
                "x-required-scope": "videos:write"
            }
        },
        "/v1/files/{uuid}": {
            "delete": {
                "summary": "Delete a file you own",
                "description": "Soft-deletes the file. The stored object is reclaimed by a background cleanup job, not synchronously here. A uuid belonging to another account answers 404, identical to an unknown one.",
                "operationId": "deleteFile",
