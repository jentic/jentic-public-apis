        "/v1/library": {
            "get": {
                "summary": "List library items (transcriptions, uploads, documents)",
                "description": "The Library view: the things the gallery does not cover. Items are filtered to the\ncontainers your token can read. A token holding no readable container gets an empty\nlist with a 200, never a 403 - the route gate already ran and this is a view filter,\nnot an access denial.\n\n`counts` holds the real totals of your library per item type, independent of `limit`,\n`offset` and `type`. It only counts items in containers your token can read, so it cannot\nleak the existence of the others. `pagination.has_more` tells whether more items follow\nthis page, measured BEFORE container filtering. With `type=all` the three item types are\nmerged, newest change first, and paged as one list.\n\nThe route-level scope is an any-of list (`text:read`, `audio:read`, `files:read`) and\nis a coarse pre-filter, not the boundary. The per-item container check is.",
                "operationId": "listLibrary",
                "tags": [
                    "Library"
                ],
                "parameters": [
                    {
                        "name": "type",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "all",
                                "transcription",
                                "upload",
                                "document"
                            ],
                            "default": "all"
                        },
                        "description": "Anything else is a 400."
                    },
                    {
                        "name": "limit",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 100,
                            "default": 50
                        },
                        "description": "Clamped, not rejected."
                    },
                    {
                        "name": "offset",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "minimum": 0,
                            "default": 0
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "The filtered page.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "items": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "object",
                                                        "additionalProperties": true
                                                    }
                                                },
                                                "counts": {
                                                    "type": "object",
                                                    "additionalProperties": true,
                                                    "description": "Real totals per item type (total, transcriptions, uploads, documents), limited to the containers the token can read."
                                                },
                                                "pagination": {
                                                    "type": "object",
                                                    "properties": {
                                                        "limit": {
                                                            "type": "integer"
                                                        },
                                                        "offset": {
                                                            "type": "integer"
                                                        },
                                                        "has_more": {
                                                            "type": "boolean"
                                                        }
                                                    }
                                                }
                                            }
                                        },
                                        "timestamp": {
                                            "type": "string",
                                            "format": "date-time"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid `type`. The message lists the valid values.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Missing or invalid API key.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "The token holds none of text:read, audio:read, files:read.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    },
                    "default": {
                        "description": "Any other error. Every failure this API emits uses the same envelope; branch on `error.type`, never on `error.message`, and quote `error.correlation_id` to support.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    }
                },
                "x-required-scope": [
                    "text:read",
                    "audio:read",
                    "files:read"
                ]
            }
        },
        "/v1/account/credits": {
            "get": {
                "summary": "Get your credit balance and recent credit activity",
                "description": "Built for the MCP `show_credits` tool. This call is free and read only: it never charges,\nreserves or initializes credits. It carries no links, so unlike the gallery and video\nroutes nothing in it expires after 15 minutes.\n\n- `balance` holds available, reserved, lifetime purchased and lifetime used credits. An\n  account with no credit record yet reads as all zeros.\n- `transactions` lists the newest `limit` ledger entries. Usage amounts are negative.\n  Each entry carries only uuid, type, amount, balance_after, description and created_at;\n  adjustment and referral entries carry a fixed label instead of their stored text.\n\nCredits belong to no content container, so any one read scope (`images:read`,\n`videos:read`, `audio:read`, `text:read` or `files:read`) admits this route.",
                "operationId": "accountCredits",
                "tags": [
                    "Account"
                ],
                "parameters": [
                    {
                        "name": "limit",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 25,
                            "default": 10
                        },
                        "description": "Recent ledger entries to return. Larger values are clamped; a non-integer is a 400."
                    }
                ],
                "responses": {
                    "200": {
                        "description": "The balance and the newest ledger entries.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "balance": {
                                                    "type": "object",
                                                    "properties": {
                                                        "available": {
                                                            "type": "number"
                                                        },
                                                        "reserved": {
                                                            "type": "number"
                                                        },
                                                        "lifetime_purchased": {
                                                            "type": "number"
                                                        },
                                                        "lifetime_used": {
                                                            "type": "number"
                                                        }
                                                    }
                                                },
                                                "transactions": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "object",
                                                        "properties": {
                                                            "uuid": {
                                                                "type": "string"
                                                            },
                                                            "type": {
                                                                "type": "string"
                                                            },
                                                            "amount": {
                                                                "type": "number"
                                                            },
                                                            "balance_after": {
                                                                "type": "number"
                                                            },
                                                            "description": {
                                                                "type": "string",
                                                                "nullable": true
                                                            },
                                                            "created_at": {
                                                                "type": "string"
                                                            }
                                                        }
                                                    }
                                                },
                                                "limit": {
                                                    "type": "integer"
                                                }
                                            }
                                        },
                                        "timestamp": {
                                            "type": "string",
                                            "format": "date-time"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "`limit` is not an integer from 1 to 25.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Missing or invalid API key.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "The token holds none of images:read, videos:read, audio:read, text:read, files:read.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    },
                    "default": {
                        "description": "Any other error. Every failure this API emits uses the same envelope; branch on `error.type`, never on `error.message`, and quote `error.correlation_id` to support.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    }
                },
                "x-required-scope": [
                    "images:read",
                    "videos:read",
                    "audio:read",
                    "text:read",
                    "files:read"
                ]
            }
        },
