        "/v1/images/expand": {
            "post": {
                "summary": "Expand an image to a new aspect ratio (outpainting)",
                "description": "Generates the missing area around an image so it fills a different aspect ratio.\n\nGive the image either as a library file uuid (`file_uuid`) or INLINE as a base64\ndata URL (`imageData`), not both. `targetAspectRatio` must be one of the ratios\nGET /v1/models reports for this tool.",
                "operationId": "expandImage",
                "tags": [
                    "Images"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "file_uuid": {
                                        "type": "string",
                                        "description": "Uuid of a library image to expand. Use this or `imageData`.",
                                        "format": "uuid"
                                    },
                                    "imageData": {
                                        "type": "string",
                                        "description": "Base64 data URL of the image to expand. Use this or `file_uuid`."
                                    },
                                    "targetAspectRatio": {
                                        "type": "string",
                                        "description": "Target ratio, e.g. \"16:9\"."
                                    },
                                    "contextPrompt": {
                                        "type": "string",
                                        "description": "Optional hint describing what should fill the new area."
                                    },
                                    "modelVariant": {
                                        "type": "string",
                                        "description": "Model variant. Defaults to `standard`."
                                    },
                                    "modelOptions": {
                                        "type": "object",
                                        "additionalProperties": true,
                                        "description": "Per-model options; see GET /v1/models."
                                    }
                                },
                                "required": [
                                    "targetAspectRatio"
