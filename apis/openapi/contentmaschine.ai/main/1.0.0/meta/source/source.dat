            }
        },
        "/v1/files/{uuid}/visibility": {
            "put": {
                "summary": "Set a file public or private",
                "description": "An idempotent SET, not a toggle. `public` is REQUIRED and must be a real JSON\nboolean: a missing key, the string \"yes\", the integer 1 and null are all 400s. An\nidempotent set has no defensible default, and guessing one is how a caller publishes\na file it did not mean to publish.\n\nRepeating the call is safe: `changed` reports whether this call was an actual\ntransition, and side effects (the social preview image, the `made_public_at` stamp)\nrun only on a real transition.\n\n**Setting a file public publishes it at a permanent, unauthenticated URL** - see\nGET /v1/files/{uuid}/share.\n\n**Setting a file private is NOT an access control, and must not be described as one.**\nIt removes the public file page. It does NOT revoke access to the bytes: the legacy\n`GET /api/files/serve/{uuid}` and `GET /api/files/thumbnail/{uuid}?original=true`\nroutes serve the same bytes to a caller with NO credentials at all, by deliberate\ndesign - those routes exist so browser <img> tags can load without credentials, and\nthey treat the uuid itself as the capability. Anyone who kept the uuid keeps the\nbytes. Nothing already fetched or cached is retroactively unpublished either. Treat\na file uuid you have ever made public as public forever.",
                "operationId": "setFileVisibility",
                "tags": [
                    "Files"
                ],
                "parameters": [
                    {
                        "name": "uuid",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        },
                        "description": "The file uuid of an item in your library (from the gallery or library list, or a finished job)."
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "public": {
                                        "type": "boolean",
                                        "description": "true publishes the file, false unpublishes the page. Must be a real boolean."
                                    }
                                },
                                "required": [
                                    "public"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "The resulting state.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "file_uuid": {
                                                    "type": "string",
                                                    "format": "uuid"
                                                },
                                                "public": {
                                                    "type": "boolean",
                                                    "description": "The state after this call."
                                                },
                                                "made_public_at": {
                                                    "type": "string",
                                                    "format": "date-time",
                                                    "nullable": true,
                                                    "description": "Stamped on the FIRST transition to public only, so a repeat call leaves it unchanged."
                                                },
                                                "changed": {
                                                    "type": "boolean",
                                                    "description": "false when the file was already in the requested state."
                                                }
                                            }
                                        },
                                        "timestamp": {
                                            "type": "string",
                                            "format": "date-time"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "`public` missing, or not a real boolean.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Missing or invalid API key.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Unknown file, or not yours.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    },
                    "default": {
                        "description": "Any other error. Every failure this API emits uses the same envelope; branch on `error.type`, never on `error.message`, and quote `error.correlation_id` to support.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    }
                },
                "x-required-scope": "files:write"
            }
        },
        "/v1/files/{uuid}/share": {
            "get": {
                "summary": "Read the public share URL of a file",
                "description": "A READ. It returns the URL of an already-public file; it does not publish anything.\nMake the file public first with PUT /v1/files/{uuid}/visibility, or this answers 409.\n\n**The returned URL is PERMANENT, UNAUTHENTICATED and has NO EXPIRY.** It is not a\nsigned link and it carries no token. Anyone who receives it - forwarded, scraped,\nlogged, pasted into a chat - can fetch the file, with no credentials, indefinitely.\n**Handing this URL to anyone is publishing the file.**\n\nDo not confuse it with the presigned URL that GET /v1/files/{uuid}/download returns.\nThose two look superficially similar and are opposites: one expires in an hour, this\none never does.\n\nSetting the file private again removes the public file page but does NOT retroactively\nunpublish bytes already fetched or cached, and does not stop the legacy serve and\nthumbnail routes. The same three facts are returned as DATA below - `is_permanent`,\n`requires_authentication`, `expires_at` - so a caller that never reads prose still\ngets them.\n\nThe share-count beacon that the web app posts is deliberately NOT exposed on this\nAPI: it is unauthenticated product analytics and exposing it would hand a token\nholder a counter to inflate.",
                "operationId": "getFileShareUrl",
                "tags": [
                    "Files"
                ],
                "parameters": [
                    {
                        "name": "uuid",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        },
                        "description": "The file uuid of an item in your library (from the gallery or library list, or a finished job)."
                    }
                ],
                "responses": {
                    "200": {
                        "description": "The share URL, with its properties stated as data.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "share_url": {
                                                    "type": "string",
                                                    "description": "Permanent, unauthenticated URL."
                                                },
                                                "is_permanent": {
                                                    "type": "boolean",
                                                    "enum": [
                                                        true
                                                    ],
                                                    "description": "Always true."
                                                },
                                                "requires_authentication": {
                                                    "type": "boolean",
                                                    "enum": [
                                                        false
                                                    ],
                                                    "description": "Always false."
                                                },
                                                "expires_at": {
                                                    "type": "string",
                                                    "format": "date-time",
                                                    "nullable": true,
                                                    "description": "Always null. There is no expiry."
                                                },
                                                "warning": {
                                                    "type": "string",
                                                    "description": "The same warning in one sentence."
                                                },
                                                "affiliate_code": {
                                                    "type": "string",
                                                    "nullable": true,
                                                    "description": "Appended to the URL as ?ref= when present."
                                                }
                                            }
                                        },
                                        "timestamp": {
                                            "type": "string",
                                            "format": "date-time"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Missing or invalid API key.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Unknown file, or not yours.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "The file is private and therefore has no share URL. The message names the exact call that fixes it.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    },
                    "default": {
                        "description": "Any other error. Every failure this API emits uses the same envelope; branch on `error.type`, never on `error.message`, and quote `error.correlation_id` to support.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    }
                },
                "x-required-scope": "files:read"
            }
        },
        "/v1/audio/transcribe": {
            "post": {
                "summary": "Transcribe an audio file you own (async)",
                "description": "Starts an asynchronous transcription of audio already stored in your library.\nUpload the audio first with POST /v1/files/upload (audio/mpeg or audio/wav, up to\n48 MB) and pass the `file_uuid` it returns. The browser chunked-upload protocol does\nNOT apply to this API.\n\n**TWO DIFFERENT SCOPES ARE INVOLVED, and this is deliberate (D-15-07).**\nSubmitting needs `audio:write`. READING THE RESULT NEEDS `text:read`, because a\ntranscript is text: both GET /v1/transcriptions/{uuid} and GET /v1/jobs/{id}\nclassify this work into the `text` container.\n\n**A token holding only `audio:write` can start this job, be charged for it, and then\nnever be able to read the transcript** - the status poll and the transcript read both\nanswer 404. Mint a token holding `audio:write` AND `text:read` for a complete\nworkflow. The 202 body repeats this warning.",
                "operationId": "transcribeAudio",
                "tags": [
                    "Audio"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "file_uuid": {
                                        "type": "string",
                                        "format": "uuid",
                                        "description": "An audio file you own."
                                    },
                                    "language": {
                                        "type": "string",
                                        "description": "Optional language hint, e.g. \"de\" or \"en-US\"."
                                    },
                                    "diarize": {
                                        "type": "boolean",
                                        "description": "Speaker separation. Must be a real boolean. Default false."
                                    },
                                    "refinement_type": {
                                        "type": "string",
                                        "enum": [
                                            "raw",
                                            "refined",
                                            "summary",
                                            "conclusions",
                                            "devils_advocate",
                                            "action_points"
                                        ],
                                        "default": "raw",
                                        "description": "What to produce beyond the raw transcript."
                                    }
                                },
                                "required": [
                                    "file_uuid"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "202": {
                        "description": "Queued.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "transcription_uuid": {
                                                    "type": "string",
                                                    "format": "uuid",
                                                    "description": "Read it with GET /v1/transcriptions/{uuid} - which needs text:read."
                                                },
                                                "job_id": {
                                                    "type": "integer",
                                                    "description": "Poll with GET /v1/jobs/{id} - which also needs text:read for this job."
                                                },
                                                "estimated_cost": {
                                                    "type": "number",
                                                    "format": "float",
                                                    "description": "Estimated credits."
                                                },
                                                "status": {
                                                    "type": "string",
                                                    "example": "pending"
                                                },
                                                "note": {
                                                    "type": "string",
                                                    "description": "Restates the two-scope split in the body itself."
                                                }
                                            }
                                        },
                                        "timestamp": {
                                            "type": "string",
                                            "format": "date-time"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Missing file_uuid, an invalid refinement_type or language, or a non-boolean diarize.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Missing or invalid API key.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    },
                    "402": {
                        "description": "Insufficient credits.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Unknown file_uuid, or not yours.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    },
                    "415": {
                        "description": "The file is not audio. The message names the accepted types.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "The audio could not be processed.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    },
                    "default": {
                        "description": "Any other error. Every failure this API emits uses the same envelope; branch on `error.type`, never on `error.message`, and quote `error.correlation_id` to support.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    }
                },
                "x-required-scope": "audio:write"
            }
        },
        "/v1/transcriptions/{uuid}": {
            "get": {
                "summary": "Read a transcript",
                "description": "**Requires `text:read`, NOT `audio:read`** (D-15-07 / D-08). A transcript is text, so\nit lives in the `text` container even though it was produced from audio. The route\nthat CREATED it requires `audio:write`. This asymmetry is intentional and must not be\n\"fixed\": a complete transcription workflow legitimately needs both scopes.\n\n`transcript` is null until `status` is `completed`. A uuid belonging to another\naccount answers 404, identical to an unknown uuid - there is no source-based\nexemption on this route.",
                "operationId": "getTranscription",
                "tags": [
                    "Audio"
                ],
                "parameters": [
                    {
                        "name": "uuid",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        },
                        "description": "The transcription_uuid returned when the transcription was started (POST /v1/audio/transcribe). Not the audio file uuid."
                    }
                ],
                "responses": {
                    "200": {
                        "description": "The transcription record.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "uuid": {
                                                    "type": "string",
                                                    "format": "uuid"
                                                },
                                                "title": {
                                                    "type": "string",
                                                    "nullable": true
                                                },
                                                "status": {
                                                    "type": "string",
                                                    "description": "completed | processing | failed | pending"
                                                },
                                                "source": {
                                                    "type": "string",
                                                    "nullable": true
                                                },
                                                "original_filename": {
                                                    "type": "string",
                                                    "nullable": true
                                                },
                                                "refinement_type": {
                                                    "type": "string",
                                                    "nullable": true,
                                                    "enum": [
                                                        "raw",
                                                        "refined",
                                                        "summary",
                                                        "conclusions",
                                                        "devils_advocate",
                                                        "action_points"
                                                    ]
                                                },
                                                "transcript": {
                                                    "type": "string",
                                                    "nullable": true,
                                                    "description": "null until status is completed."
                                                },
                                                "refined_content": {
                                                    "type": "string",
                                                    "nullable": true
                                                },
                                                "audio_duration_seconds": {
                                                    "type": "integer",
                                                    "nullable": true
                                                },
                                                "file_size_bytes": {
                                                    "type": "integer",
                                                    "nullable": true
                                                },
                                                "credits_charged": {
                                                    "type": "number",
                                                    "format": "float",
                                                    "nullable": true
                                                },
                                                "created_at": {
                                                    "type": "string",
                                                    "format": "date-time",
                                                    "nullable": true
                                                },
                                                "updated_at": {
                                                    "type": "string",
                                                    "format": "date-time",
                                                    "nullable": true
                                                }
                                            }
                                        },
                                        "timestamp": {
                                            "type": "string",
                                            "format": "date-time"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Missing or invalid API key.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "The token does not hold text:read.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Unknown transcription, or not yours.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    },
                    "default": {
                        "description": "Any other error. Every failure this API emits uses the same envelope; branch on `error.type`, never on `error.message`, and quote `error.correlation_id` to support.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    }
                },
                "x-required-scope": "text:read"
            }
        },
        "/v1/text/generate": {
            "post": {
                "summary": "Run a text tool",
                "description": "Runs one of the tools listed by GET /v1/text/tools against your input text. One\nstateless call; billing is metered on ACTUAL token usage, not a flat rate, and the\nresponse returns the token counts and the cost breakdown it charged on.\n\nThere is deliberately no free-form prompt escape hatch and no prompt-preview route:\nboth would publish internal prompt engineering to any token holder.",
                "operationId": "generateText",
                "tags": [
                    "Text"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "tool_key": {
                                        "type": "string",
                                        "description": "A `key` from GET /v1/text/tools."
                                    },
                                    "input_text": {
                                        "type": "string",
                                        "description": "The text the tool operates on."
                                    },
                                    "options": {
                                        "type": "object",
                                        "additionalProperties": true,
                                        "description": "Per-tool options."
                                    },
                                    "framework_id": {
                                        "type": "integer",
                                        "description": "Optional StoryBrand framework (integer id) to condition the output on. Must be one you own."
                                    },
                                    "source_type": {
                                        "type": "string",
                                        "description": "Provenance label. Defaults to \"direct\"."
                                    },
                                    "source_id": {
                                        "type": "integer",
                                        "description": "Optional integer id of the source record."
                                    },
                                    "source_uuid": {
                                        "type": "string",
                                        "description": "Optional uuid of the source record."
                                    }
                                },
                                "required": [
                                    "tool_key",
                                    "input_text"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "The tool output.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "operation_uuid": {
                                                    "type": "string",
                                                    "format": "uuid"
                                                },
                                                "tool": {
                                                    "type": "object",
                                                    "properties": {
                                                        "key": {
                                                            "type": "string"
                                                        },
                                                        "name": {
                                                            "type": "string"
                                                        },
                                                        "category": {
                                                            "type": "string"
                                                        },
                                                        "icon": {
                                                            "type": "string"
                                                        },
                                                        "color": {
                                                            "type": "string"
                                                        }
                                                    }
                                                },
                                                "input": {
                                                    "type": "string"
                                                },
                                                "output": {
                                                    "type": "string"
                                                },
                                                "used_blueprint": {
                                                    "type": "boolean"
                                                },
                                                "credits_used": {
                                                    "type": "number",
                                                    "format": "float"
                                                },
                                                "processing_time_ms": {
                                                    "type": "integer"
                                                },
                                                "tokens": {
                                                    "type": "object",
                                                    "properties": {
                                                        "input": {
                                                            "type": "integer"
                                                        },
                                                        "output": {
                                                            "type": "integer"
                                                        },
                                                        "total": {
                                                            "type": "integer"
                                                        }
                                                    }
                                                },
                                                "cost_breakdown": {
                                                    "type": "object",
                                                    "properties": {
                                                        "actual_cost_usd": {
                                                            "type": "number"
                                                        },
                                                        "credit_cost": {
                                                            "type": "number"
                                                        },
                                                        "markup_multiplier": {
                                                            "type": "number"
                                                        }
                                                    }
                                                }
                                            }
                                        },
                                        "timestamp": {
                                            "type": "string",
                                            "format": "date-time"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Missing tool_key or input_text, or malformed JSON.",
                        "content": {
                            "application/json": {
                                "schema": {
