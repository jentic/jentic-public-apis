    "x-breaking-changes": [
        {
            "id": "gallery-item-identity",
            "decision": "D-07",
            "shipped_in": "Phase 14",
            "summary": "GalleryItem.uuid is the FILE uuid, not the generation uuid.",
            "detail": "The `uuid` field of every gallery item used to be the generation uuid. It is now the uuid of the FILE the generation produced - the identifier the download and file routes actually take. The generation uuid is still returned, under the new `generation_uuid` field, so nothing was removed.",
            "migration": "If you stored gallery `uuid` values to correlate with generations, read `generation_uuid` instead. If you used them to download, no change is needed - that now works, and previously did not.",
            "aliased": false
        },
        {
            "id": "gallery-category-vocabulary",
            "decision": "D-07b / D-15-28",
            "shipped_in": "Phase 14, alias added in Phase 15",
            "summary": "The `category` vocabulary moved from singular to the plural container names.",
            "detail": "Item payloads report images|videos|audio|text|files - the same vocabulary as the read scopes - where they used to report image|video|text|other. For one release the `?category=` FILTER also accepts the deprecated singular image|video, answering with a `Deprecation: true` response header. Responses always carry the plural. `text` is spelled identically in both vocabularies and is not a deprecation.",
            "migration": "Send the plural. The singular aliases are removed in a later release with a changelog note; the `Deprecation` header tells you if you are still relying on them.",
            "aliased": true,
            "aliases": {
                "image": "images",
                "video": "videos",
                "text": "text"
            }
        },
        {
            "id": "error-code-is-an-integer",
            "decision": "15-16 / TOKEN-08",
            "shipped_in": "Phase 15",
            "summary": "`error.code` is always the integer HTTP status; the machine-readable string moved to `error.type`.",
            "detail": "Three 401 bodies used to put a STRING in `error.code`: `token_expired`, `token_revoked`, `token_invalid`. Every other error put the integer status there, which left `code` a field no client could type. All three identifiers are preserved byte-identically and now live in the new, always-present `error.type`; `error.code` is the integer 401.",
            "migration": "Rename the key: branch on `error.type` instead of `error.code`. A client that still compares `error.code` to one of the three strings gets false - a wrong branch, not an exception.",
            "aliased": false
        }
    ],
    "x-curl-examples": {
        "generate": "curl -X POST https://contentmaschine.ai/api/v1/images/generate \\\n  -H \"Authorization: Bearer sk-cm-YOUR_KEY\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\"prompt\":\"A serene mountain lake\",\"model\":\"standard\",\"aspect_ratio\":\"16:9\"}'",
        "poll": "curl https://contentmaschine.ai/api/v1/jobs/123 \\\n  -H \"Authorization: Bearer sk-cm-YOUR_KEY\"",
        "transcribe": "curl -X POST https://contentmaschine.ai/api/v1/audio/transcribe \\\n  -H \"Authorization: Bearer sk-cm-YOUR_KEY\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\"file_uuid\":\"UUID\",\"language\":\"de\"}'\n# the token needs audio:write to submit AND text:read to read the transcript back",
        "discover": "curl https://contentmaschine.ai/api/v1/openapi.json\n# no Authorization header: this route and /api/v1/models are public",
        "download": "curl -o image.png \"https://contentmaschine.ai/api/files/download/UUID\" \\\n  -H \"Authorization: Bearer sk-cm-YOUR_KEY\""
    }
