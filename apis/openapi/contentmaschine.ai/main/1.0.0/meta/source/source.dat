        "/v1/images/style-transfer": {
            "post": {
                "summary": "Apply the style of one image to another",
                "description": "Re-renders the content image in the visual style of the style image.\n\nGive each image either as a library file uuid (`file_uuid` for the content image,\n`style_file_uuid` for the style reference) or INLINE as a base64 data URL\n(`contentImage`, `styleImage`). One of each pair is required; sending both of a pair\nis a 400. Returns when the image is ready; there is no job to poll.",
                "operationId": "styleTransferImage",
                "tags": [
                    "Images"
                ],
                "requestBody": {
                    "required": false,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "file_uuid": {
                                        "type": "string",
                                        "description": "Uuid of a library image to restyle (the content image). Use this or `contentImage`.",
                                        "format": "uuid"
                                    },
                                    "style_file_uuid": {
                                        "type": "string",
                                        "description": "Uuid of a library image whose style is applied. Use this or `styleImage`.",
                                        "format": "uuid"
                                    },
                                    "contentImage": {
                                        "type": "string",
                                        "description": "Base64 data URL of the image to restyle. Use this or `file_uuid`."
                                    },
                                    "styleImage": {
                                        "type": "string",
                                        "description": "Base64 data URL of the style reference. Use this or `style_file_uuid`."
                                    },
                                    "styleStrength": {
                                        "type": "number",
                                        "format": "float",
                                        "default": 0.7,
                                        "description": "How strongly the style is applied."
                                    },
                                    "modelVariant": {
                                        "type": "string",
                                        "description": "Model variant. Defaults to `standard`."
                                    },
                                    "modelOptions": {
                                        "type": "object",
                                        "additionalProperties": true,
                                        "description": "Per-model options; see GET /v1/models."
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "The restyled image.",
