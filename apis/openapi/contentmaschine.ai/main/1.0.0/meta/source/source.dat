                "x-required-scope": "files:write"
            }
        },
        "/v1/files/{uuid}/download": {
            "get": {
                "summary": "Download a file you own",
                "description": "Returns the bytes, NOT a JSON envelope. Files in object storage answer 302 with a\npresigned URL valid for one hour; locally stored files are streamed directly.\n\n**The redirect target is a credential.** Anyone holding that presigned URL can read\nthe object until it expires. Do not log it, cache it in a shared cache, or pass it on.\n\n**Authorization here is two-layer, and `files:read` is only the outer one.** The\nroute gate checks `files:read`; the handler then checks that your token can read the\nfile's own container. A token holding `files:read` but not `images:read` gets 404 for\nan image - a 404 rather than a 403, so a denial cannot be told apart from a\nnonexistent file.\n\nContrast `GET /api/files/download/{uuid}`, which is also documented here: it is\nowner-checked but has NO scope check at all.",
                "operationId": "downloadFileV1",
                "tags": [
                    "Files"
                ],
                "parameters": [
                    {
                        "name": "uuid",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        },
                        "description": "The file uuid of an item in your library (from the gallery or library list, or a finished job)."
                    }
                ],
                "responses": {
                    "200": {
                        "description": "The file bytes (locally stored files).",
                        "content": {
                            "application/octet-stream": []
                        }
                    },
                    "302": {
                        "description": "Redirect to a presigned URL valid for one hour. The Location header is a credential."
                    },
                    "401": {
                        "description": "Missing or invalid API key.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "The token does not hold files:read.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Unknown file, not yours, OR readable only by a container scope your token lacks.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    },
                    "default": {
                        "description": "Any other error. Every failure this API emits uses the same envelope; branch on `error.type`, never on `error.message`, and quote `error.correlation_id` to support.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    }
                },
                "x-required-scope": "files:read"
            }
        },
        "/v1/files/{uuid}/download-link": {
            "get": {
                "summary": "Get a short-lived download link and a preview for a file you own",
                "description": "The JSON form of `GET /v1/files/{uuid}/download`, built for agent callers that cannot\nfollow an authenticated URL or show a binary body. No credits are charged and the file\nstays private: its visibility is not changed.\n\n- `download_url` is a presigned, unauthenticated URL for the ORIGINAL file, valid for 15\n  minutes (`expires_at`). **It is a credential for that time**: anyone holding it can\n  read the file. Do not log it or pass it on. It is `null` for a file stored only on the\n  server disk (no expiring link can be issued); `link_unavailable_reason` then says why.\n- `preview` is set for raster images only: a reduced JPEG (at most 1024 px on the long\n  edge and about 350 KB), base64-encoded. It is never the original bytes. `null` for\n  other files, SVG, or an image that cannot be decoded.\n\nAuthorization is the same two-layer check as the download route: `files:read` at the\ngate, then the read scope of the file's own container. A denial is a 404, never a 403.",
                "operationId": "getFileDownloadLinkV1",
                "tags": [
                    "Files"
                ],
                "parameters": [
                    {
                        "name": "uuid",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        },
                        "description": "The file uuid of an item in your library (from the gallery or library list, or a finished job)."
                    }
                ],
                "responses": {
                    "200": {
                        "description": "File metadata, a 15-minute download link and, for images, a preview.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "success": {
                                            "type": "boolean"
                                        },
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "uuid": {
                                                    "type": "string",
                                                    "format": "uuid"
                                                },
                                                "file_name": {
                                                    "type": "string"
                                                },
                                                "mime_type": {
                                                    "type": "string"
                                                },
                                                "size_bytes": {
                                                    "type": "integer"
                                                },
                                                "download_url": {
                                                    "type": "string",
                                                    "nullable": true,
                                                    "description": "Presigned URL for the original file, valid 15 minutes. A credential."
                                                },
                                                "view_url": {
                                                    "type": "string",
                                                    "nullable": true,
                                                    "description": "Presigned URL that opens the original in the browser instead of downloading it, valid 15 minutes. Raster images only. A credential."
                                                },
                                                "expires_at": {
                                                    "type": "string",
                                                    "format": "date-time",
                                                    "nullable": true
                                                },
                                                "expires_in_seconds": {
                                                    "type": "integer",
                                                    "nullable": true
                                                },
                                                "link_unavailable_reason": {
                                                    "type": "string",
                                                    "nullable": true
                                                },
                                                "preview": {
                                                    "type": "object",
                                                    "nullable": true,
                                                    "properties": {
                                                        "mime_type": {
                                                            "type": "string",
                                                            "enum": [
                                                                "image/jpeg"
                                                            ]
                                                        },
                                                        "base64": {
                                                            "type": "string",
                                                            "description": "Reduced JPEG, base64. Never the original bytes."
                                                        },
                                                        "width": {
                                                            "type": "integer"
                                                        },
                                                        "height": {
                                                            "type": "integer"
                                                        }
                                                    }
                                                }
                                            }
                                        },
                                        "timestamp": {
                                            "type": "string",
                                            "format": "date-time"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Missing or invalid API key.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "The token does not hold files:read.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Unknown file, not yours, OR readable only by a container scope your token lacks.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    },
                    "default": {
                        "description": "Any other error. Every failure this API emits uses the same envelope; branch on `error.type`, never on `error.message`, and quote `error.correlation_id` to support.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    }
                },
                "x-required-scope": "files:read"
            }
        },
        "/v1/files/view-links": {
            "get": {
                "summary": "Get short-lived view links for up to 20 of your images",
                "description": "The batch, view-only form of `GET /v1/files/{uuid}/download-link`, built for image\nviewers such as the MCP `show_images` tool. No credits are charged, no image is decoded\nand no bytes are returned: every entry carries presigned URLs valid for 15 minutes.\n\n- `thumbnail_url` opens a small stored thumbnail inline when one exists, otherwise the\n  same image as `view_url`.\n- `view_url` opens the original inline in the browser; `download_url` saves it.\n- **Every URL is a credential for 15 minutes**: anyone holding it can read the file. Do\n  not log it or pass it on.\n\nOnly raster images (JPEG, PNG, WebP, GIF, AVIF) stored in object storage get links. Any\nuuid that is unknown, not yours, readable only by a container scope your token lacks,\nnot a raster image (SVG, PDF and others never get inline links), stored only on the\nserver disk, or not presignable right now is listed in `not_found` instead. One list for\nall of these, so it reveals nothing about files you cannot read.\n\nAuthorization per uuid is the same two-layer check as the download route: `files:read`\nat the gate, then the read scope of the file's own container.",
                "operationId": "getFileViewLinksV1",
                "tags": [
                    "Files"
                ],
                "parameters": [
                    {
                        "name": "uuids",
                        "in": "query",
                        "required": true,
                        "style": "form",
                        "explode": false,
                        "schema": {
                            "type": "array",
                            "items": {
                                "type": "string",
                                "format": "uuid"
                            },
                            "minItems": 1,
                            "maxItems": 20
                        },
                        "description": "1 to 20 file uuids, comma-separated in the query string. Duplicates are ignored."
                    }
                ],
                "responses": {
                    "200": {
                        "description": "View links for the images that can be shown, and the uuids that cannot.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "success": {
                                            "type": "boolean"
                                        },
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "images": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "object",
                                                        "properties": {
                                                            "uuid": {
                                                                "type": "string",
                                                                "format": "uuid"
                                                            },
                                                            "file_name": {
                                                                "type": "string"
                                                            },
                                                            "mime_type": {
                                                                "type": "string"
                                                            },
                                                            "width": {
                                                                "type": "integer",
                                                                "nullable": true
                                                            },
                                                            "height": {
                                                                "type": "integer",
                                                                "nullable": true
                                                            },
                                                            "thumbnail_url": {
                                                                "type": "string",
                                                                "description": "Presigned inline URL for a small version. A credential."
                                                            },
                                                            "view_url": {
                                                                "type": "string",
                                                                "description": "Presigned inline URL for the original. A credential."
                                                            },
                                                            "download_url": {
                                                                "type": "string",
                                                                "description": "Presigned download URL for the original. A credential."
                                                            },
                                                            "expires_at": {
                                                                "type": "string",
                                                                "format": "date-time"
                                                            }
                                                        }
                                                    }
                                                },
                                                "not_found": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "string",
                                                        "format": "uuid"
                                                    }
                                                },
                                                "expires_at": {
                                                    "type": "string",
                                                    "format": "date-time"
                                                },
                                                "expires_in_seconds": {
                                                    "type": "integer"
                                                }
                                            }
                                        },
                                        "timestamp": {
                                            "type": "string",
                                            "format": "date-time"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "`uuids` is missing, holds something that is not a uuid, or names more than 20 files.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Missing or invalid API key.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "The token does not hold files:read.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    },
                    "default": {
                        "description": "Any other error. Every failure this API emits uses the same envelope; branch on `error.type`, never on `error.message`, and quote `error.correlation_id` to support.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    }
                },
                "x-required-scope": "files:read"
            }
        },
        "/v1/files/{uuid}/video-link": {
            "get": {
                "summary": "Get short-lived playback and download links for one of your videos",
                "description": "Built for video players such as the MCP `show_video` tool. This call is free: no credits\nare charged, no model is called and no bytes are returned. The links expire after 15\nminutes.\n\n- `video_url` plays the video inline with its real content type; `download_url` saves it.\n- `poster_url` is the stored thumbnail when there is one, otherwise `null`.\n- **Every URL is a credential for 15 minutes**: anyone holding it can read the file. Do\n  not log it or pass it on.\n- A video stored only on the server disk, or one that cannot be presigned right now,\n  answers 200 with `available: false`, every URL `null` and `reason` saying why.\n\nOnly MP4, WebM and QuickTime videos are served. A file that is unknown, not yours, not\none of those video types, or readable only by a container scope your token lacks is a\n404, the same 404 for all of them. Authorization is the same two-layer check as the\ndownload route: `files:read` at the gate, then the read scope of the file's own container.",
                "operationId": "filesVideoLink",
                "tags": [
                    "Files"
                ],
                "parameters": [
                    {
                        "name": "uuid",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid"
                        },
                        "description": "The file uuid of a video in your library (from the gallery list or a finished video job)."
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Playback, download and poster links valid for 15 minutes.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "uuid": {
                                                    "type": "string",
                                                    "format": "uuid"
                                                },
                                                "file_name": {
                                                    "type": "string"
                                                },
                                                "mime_type": {
                                                    "type": "string",
                                                    "enum": [
                                                        "video/mp4",
                                                        "video/webm",
                                                        "video/quicktime"
                                                    ]
                                                },
                                                "width": {
                                                    "type": "integer",
                                                    "nullable": true
                                                },
                                                "height": {
                                                    "type": "integer",
                                                    "nullable": true
                                                },
                                                "poster_url": {
                                                    "type": "string",
                                                    "nullable": true,
                                                    "description": "Presigned inline URL for the stored thumbnail. A credential."
                                                },
                                                "video_url": {
                                                    "type": "string",
                                                    "nullable": true,
                                                    "description": "Presigned inline URL that plays the video. A credential."
                                                },
                                                "download_url": {
                                                    "type": "string",
                                                    "nullable": true,
                                                    "description": "Presigned download URL for the original. A credential."
                                                },
                                                "expires_at": {
                                                    "type": "string",
                                                    "format": "date-time",
                                                    "nullable": true
                                                },
                                                "expires_in_seconds": {
                                                    "type": "integer",
                                                    "nullable": true
                                                },
                                                "available": {
                                                    "type": "boolean"
                                                },
                                                "reason": {
                                                    "type": "string",
                                                    "nullable": true,
                                                    "enum": [
                                                        "local_only",
                                                        "link_unavailable",
                                                        null
                                                    ]
                                                }
                                            }
                                        },
                                        "timestamp": {
                                            "type": "string",
                                            "format": "date-time"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Missing or invalid API key.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "The token does not hold files:read.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Unknown file, not yours, not a playable video, OR readable only by a container scope your token lacks.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorEnvelope"
                                }
                            }
                        }
                    },
                    "default": {
                        "description": "Any other error. Every failure this API emits uses the same envelope; branch on `error.type`, never on `error.message`, and quote `error.correlation_id` to support.",
                        "content": {
                            "application/json": {
                                "schema": {
