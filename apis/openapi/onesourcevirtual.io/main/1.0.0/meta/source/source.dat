{
  "openapi": "3.0.3",
  "info": {
    "title": "OSV Customer Payroll Portal API",
    "description": "API for the OSV Customer Payroll Portal providing endpoints for payroll management,\ncompany information, statistics, settlement requests, and banking information.\n",
    "version": "1.0.0",
    "contact": {
      "name": "OSV Development Team"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/onesourcevirtual/osv-payroll-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://apidev.onesourcevirtual.io/payroll",
      "description": "Development Environment"
    },
    {
      "url": "https://apiqa.onesourcevirtual.io/payroll",
      "description": "QA Environment"
    },
    {
      "url": "https://apiuat.onesourcevirtual.io/payroll",
      "description": "UAT Environment"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    },
    {
      "encryptedRequestKey": []
    }
  ],
  "paths": {
    "/api/v1/about": {
      "get": {
        "tags": [
          "About"
        ],
        "summary": "About",
        "description": "About",
        "operationId": "about",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "example": "API Version: v1 - Application: PayrollApi - Version: 1.0.0.0"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/companies": {
      "get": {
        "tags": [
          "Company"
        ],
        "summary": "Retrieve companies",
        "description": "Get companies by account ID and optional country codes",
        "operationId": "GetCompanies",
        "parameters": [
          {
            "name": "X-Encrypted-Request-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Encrypted request key for additional security"
          },
          {
            "name": "accountId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Account identifier"
          },
          {
            "name": "countryCodes",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated list of country codes to filter companies"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompaniesResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                }
              }
            }
          }
        }
      }
    },
