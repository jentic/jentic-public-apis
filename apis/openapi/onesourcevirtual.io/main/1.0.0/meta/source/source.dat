          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/getAvailableOptionsforCustomer": {
      "get": {
        "tags": [
          "CustomerOptions"
        ],
        "summary": "Retrieve customer options for settlement and expense requests",
