    "/api/v1/settlements/{settlementId}/distribution/shipping": {
      "get": {
        "tags": [
          "Settlements"
        ],
        "summary": "Retrieve settlement distribution shipping details",
        "description": "Get shipping details for settlement distribution including distribution in progress information with pagination support",
        "operationId": "GetSettlementDistributionShippingDetails",
        "parameters": [
          {
            "name": "X-Encrypted-Request-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Encrypted request key for additional security"
          },
          {
            "name": "settlementId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Settlement identifier"
          },
          {
            "name": "accountId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Account identifier for validation"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            },
            "description": "Page number for pagination"
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 50,
              "minimum": 1,
              "maximum": 100
            },
            "description": "Number of records per page (max 100)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettlementDistributionDetailWrapperResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                }
              }
            }
          },
          "404": {
            "description": "Settlement not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                }
              }
            }
          }
        }
      }
    }
