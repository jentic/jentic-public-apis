              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/settlements": {
      "get": {
        "tags": [
          "Settlements"
        ],
        "summary": "Retrieve currency-filtered settlements",
        "description": "Get settlements by accountId with required currency code and optional filters (search, type, company, date range). Returns settlements matching the exact CurrencyIsoCode along with child payment groups and money transactions.",
        "operationId": "getSettlements",
        "parameters": [
          {
            "name": "X-Encrypted-Request-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Encrypted request key for additional security"
          },
          {
            "name": "accountId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Account identifier"
          },
          {
            "name": "currencyCode",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Currency code to filter settlements"
          },
          {
            "name": "pageNumber",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            },
            "description": "Page number for pagination"
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 25
            },
            "description": "Number of records per page"
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Search term"
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Settlement type filter"
          },
          {
            "name": "company",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Company filter"
          },
          {
            "name": "createdFrom",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Created date range start"
          },
          {
            "name": "createdTo",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Created date range end"
          },
          {
            "name": "settlementId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Specific settlement ID to retrieve"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettlementDetailsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/settlements/search": {
      "post": {
        "tags": [
          "Settlements"
        ],
        "summary": "Search settlements with filters and pagination",
        "description": "Search settlements with advanced filters, pagination, and tab-specific results. Supports multi-select company filtering, tab-based filtering (all, in-progress, closed), and returns status counts for all tabs.",
        "operationId": "searchSettlements",
        "parameters": [
          {
            "name": "X-Encrypted-Request-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Encrypted request key for additional security"
          },
          {
            "name": "accountId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Account identifier"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SettlementSearchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettlementSearchResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
