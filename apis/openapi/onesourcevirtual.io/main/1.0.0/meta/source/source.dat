            },
            "description": "Encrypted request key for additional security"
          },
          {
            "name": "accountId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Account identifier"
          },
          {
            "name": "payPeriodId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Pay Period ID (optional)"
          },
          {
            "name": "payrollGroupDetailsId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Payroll Group Details ID (optional)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
