              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/payroll/stats": {
      "get": {
        "tags": [
          "Payroll Statistics"
        ],
        "summary": "Retrieve payroll statistics",
        "description": "Get payroll statistics including scheduled and completed payroll counts by account ID and country",
        "operationId": "GetPayrollStats",
        "parameters": [
          {
            "name": "X-Encrypted-Request-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Encrypted request key for additional security"
          },
          {
            "name": "accountId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Account identifier"
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "ALL"
            },
            "description": "Country to filter payroll statistics (optional, defaults to ALL)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PayrollStatsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
