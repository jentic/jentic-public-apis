            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/settlements/request": {
      "post": {
        "tags": [
          "RequestSettlement"
        ],
        "summary": "Request payroll settlement",
        "description": "Create a new case and customer information record for payroll settlement request",
