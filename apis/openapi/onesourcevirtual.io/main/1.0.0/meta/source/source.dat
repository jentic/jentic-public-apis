          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/customMetadata": {
      "get": {
        "tags": [
          "CustomMetadata"
        ],
        "summary": "Retrieve custom metadata configuration values",
        "description": "Get custom metadata value by metadata name and label name. Used to retrieve configuration values stored in Salesforce Custom Metadata Types.",
        "operationId": "getCustomMetadata",
        "parameters": [
          {
            "name": "X-Encrypted-Request-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Encrypted request key for additional security"
          },
          {
            "name": "accountId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Account identifier"
          },
          {
            "name": "metadataName",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The name of the custom metadata type (e.g., OSVCommunitySetting__mdt)"
          },
          {
            "name": "labelName",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The label name to retrieve (e.g., OSVSupportBaseUrl)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomMetadataResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/payroll/search": {
      "post": {
        "tags": [
          "Payroll"
        ],
        "summary": "Retrieve paginated payroll records",
        "description": "Search payroll records by account ID, search type filter, country, companies, processing date range, period payment date range with pagination support",
        "operationId": "SearchPayrolls",
        "parameters": [
          {
            "name": "X-Encrypted-Request-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Encrypted request key for additional security"
          },
          {
            "name": "accountId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Account identifier"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PayrollSearchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PayrollSearchResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/payrollgroupdetails/available": {
      "get": {
        "tags": [
          "Payroll"
        ],
        "summary": "Get available payroll group details",
        "description": "Retrieve available payroll group details for processing filtered by account ID, currency ISO code, and company",
        "operationId": "getAvailablePayrollGroupDetails",
        "parameters": [
          {
            "name": "X-Encrypted-Request-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Encrypted request key for additional security"
          },
          {
            "name": "accountId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Account identifier"
          },
          {
            "name": "currencyIsoCode",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Optional ISO currency code to filter payroll records"
          },
          {
            "name": "company",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Optional company name to filter payroll records"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AvailablePayrollGroupDetailsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/payroll/details": {
      "get": {
        "tags": [
          "Payroll"
        ],
        "summary": "Retrieve detailed payroll information",
        "description": "Get payroll details including pay period and pay period with paygroup detail information",
        "operationId": "GetPayrollDetails",
        "parameters": [
          {
            "name": "X-Encrypted-Request-Key",
            "in": "header",
            "required": true,
            "schema": {
