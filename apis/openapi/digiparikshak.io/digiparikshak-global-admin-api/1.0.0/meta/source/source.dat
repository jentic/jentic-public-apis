{
  "openapi": "3.0.4",
  "info": {
    "title": "Digiparikshak Global Admin API",
    "version": "1.0.0",
    "description": "Core authentication and session management for the Super Admin (Root) level.",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/techxploreio/Global-Admin-API-Digiparikshak-1.0.0/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.digiparikshak.io/v1",
      "description": "Production Server"
    }
  ],
  "paths": {
    "/global/auth/login": {
      "post": {
        "summary": "Root Admin Login",
        "tags": [
          "Authentication"
        ],
        "operationId": "loginRootAdmin",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials or account locked"
          },
          "429": {
            "description": "Too many requests (Rate limit exceeded)"
          }
        }
      }
    },
    "/global/auth/logout": {
      "post": {
        "summary": "Terminate Global Session",
        "tags": [
          "Authentication"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Token blacklisted successfully. Redis session cleared."
          },
          "401": {
            "description": "Unauthorized / Token invalid or already expired."
          }
        }
      }
    },
    "/global/auth/change-password": {
      "patch": {
        "summary": "Secure password update",
        "tags": [
          "Authentication"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password updated successfully"
          },
          "400": {
            "description": "New password does not meet complexity requirements"
          },
          "401": {
            "description": "Old password verification failed"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "example": "admin@digiparikshak.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "SecureP@ss1234"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          },
          "refreshToken": {
            "type": "string",
            "example": "dGhpcy1pcy1hLXJlZnJlc2gtdG9rZW4="
          },
          "password_reset_required": {
            "type": "boolean",
            "example": true
          },
          "user": {
            "type": "object",
            "properties": {
              "admin_id": {
                "type": "string",
                "format": "uuid"
              },
              "username": {
                "type": "string"
              }
            }
          }
        }
      },
      "PasswordUpdateRequest": {
        "type": "object",
        "required": [
          "oldPassword",
          "newPassword"
        ],
        "properties": {
          "oldPassword": {
            "type": "string",
            "format": "password"
          },
          "newPassword": {
            "type": "string",
            "format": "password",
            "description": "Must be 12+ chars with 1 upper and 1 special."
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}
