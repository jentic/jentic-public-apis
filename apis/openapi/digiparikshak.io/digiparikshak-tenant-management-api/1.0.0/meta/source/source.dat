{
  "openapi": "3.0.4",
  "info": {
    "title": "Digiparikshak Tenant Management API",
    "version": "1.0.0",
    "description": "APIs for managing exam tenants and automated database schema provisioning.",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/techxploreio/Global-Admin-API-Digiparikshak-1.1/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.digiparikshak.io/v1",
      "description": "Production Server"
    }
  ],
  "paths": {
    "/global/exams": {
      "post": {
        "summary": "Create New Exam Tenant",
        "description": "Initiates physical database schema creation and table seeding.",
        "tags": [
          "Exam Management"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExamCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Tenant created and schema provisioned successfully."
          },
          "409": {
            "description": "Conflict - Exam Code already exists."
          },
          "500": {
            "description": "Internal Server Error during Schema DDL execution."
          }
        }
      },
      "get": {
        "summary": "List all Exam Tenants",
        "tags": [
          "Exam Management"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "A list of all exam tenants across the system.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ExamResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/global/exams/{id}": {
      "patch": {
        "summary": "Update Exam Details",
        "tags": [
          "Exam Management"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Updated Exam Name 2026"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Exam metadata updated."
          }
        }
      }
    },
    "/global/exams/{id}/status": {
      "put": {
        "summary": "Toggle Exam Status",
        "tags": [
          "Exam Management"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "active",
                      "inactive",
                      "archived"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Status successfully updated."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ExamCreateRequest": {
        "type": "object",
        "required": [
          "name",
          "code"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "Staff Selection Commission 2026"
          },
          "code": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+$",
            "description": "Alphanumeric code used for DB schema naming.",
            "example": "SSC_2026"
          }
        }
      },
      "ExamResponse": {
        "type": "object",
        "properties": {
          "tenant_id": {
            "type": "string",
            "format": "uuid"
          },
          "exam_name": {
            "type": "string"
          },
          "exam_code": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "schema_name": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
