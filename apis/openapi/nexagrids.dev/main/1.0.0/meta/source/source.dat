    "/auth0/pre_registration_trigger": {
      "post": {
        "tags": [
          "Auth0"
        ],
        "summary": "App 使用者註冊前觸發",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "meta",
                  "user"
                ],
                "properties": {
                  "meta": {
                    "type": "object",
                    "properties": {
                      "client_id": {
                        "type": "string"
                      },
                      "client_name": {
                        "type": "string"
                      },
                      "connection": {
                        "type": "string"
                      },
                      "request_hostname": {
                        "type": "string"
                      },
                      "request_ip": {
                        "type": "string"
                      },
                      "tenant_id": {
                        "type": "string"
                      }
                    }
                  },
                  "user": {
                    "type": "object",
                    "properties": {
                      "email": {
                        "type": "string"
                      },
                      "app_metadata": {
                        "type": "object"
                      },
                      "user_metadata": {
                        "type": "object"
                      },
                      "username": {
                        "type": "string"
                      },
                      "family_name": {
                        "type": "string"
                      },
                      "given_name": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                }
              }
            }
          },
          "400": {
            "description": "註冊參數無效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "email_not_found": {
                    "summary": "Email 不存在",
                    "value": {
                      "meta": {
                        "code": 100101,
                        "message": "email does not exist"
                      },
                      "data": null
                    }
                  },
                  "missing_invite_token": {
                    "summary": "缺少邀請 Token",
                    "value": {
                      "meta": {
                        "code": 100102,
                        "message": "missing invite token"
                      },
                      "data": null
                    }
                  },
                  "invitation_expired": {
                    "summary": "邀請已過期",
                    "value": {
                      "meta": {
                        "code": 100106,
                        "message": "invitation expired"
                      },
                      "data": null
                    }
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
