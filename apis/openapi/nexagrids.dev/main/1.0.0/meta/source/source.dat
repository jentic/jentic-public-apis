{
  "openapi": "3.0.3",
  "info": {
    "title": "User Manager API",
    "description": "使用者與角色管理服務\n\n## Response Envelope\n所有 API 回應皆使用統一格式：\n```json\n{\n  \"meta\": { \"code\": 0, \"message\": \"success\" },\n  \"data\": { ... }\n}\n```\n錯誤時 `data` 為 `null`，`meta.code` 為錯誤代碼。\n",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/nexagrids/user-manager-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.nexagrids.dev/user-mgr",
      "description": "Production"
    }
  ],
  "tags": [
    {
      "name": "External - Web",
      "description": "外部 API（需 JWT 認證）"
    },
    {
      "name": "External - Public",
      "description": "外部 API（無需認證）"
    },
    {
      "name": "Internal",
      "description": "內部服務間 API"
    },
    {
      "name": "Auth0",
      "description": "Auth0 Webhook"
    }
  ],
  "paths": {
    "/web/info": {
      "get": {
        "tags": [
          "External - Web"
        ],
        "summary": "取得 App 使用者資訊",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ResponseEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/WebAppUserInfoResponse"
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "meta": {
                    "code": 0,
                    "message": "success"
                  },
                  "data": {
                    "user": {
                      "id": "test-id",
                      "email": "test-email@test.com",
                      "first_name": "test-first-name",
                      "last_name": "test-last-name",
                      "phone_number": "+886 987654321",
                      "birthday": "2000-01-01",
                      "gender": "male",
                      "address": "test-address",
                      "country": "CT",
                      "region": "01-02-03",
                      "car_brand": "TEST-BRAND",
                      "car_number": "TEST-123"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "使用者不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "meta": {
                    "code": 100004,
                    "message": "user not found"
                  },
                  "data": null
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "patch": {
        "tags": [
          "External - Web"
        ],
        "summary": "更新 App 使用者資訊",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WebUpdateAppUserInfoRequest"
              },
              "example": {
                "first_name": "test-first-name",
                "last_name": "test-last-name",
                "phone_number": "+886 987654321",
                "birthday": "2000-01-01",
                "gender": "male",
                "address": "test-address",
                "country": "COUNTRY",
                "region": "01-02-03",
                "car_brand": "TESTBRAND",
                "car_number": "TEST-123"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "description": "車牌號碼已存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "meta": {
                    "code": 100007,
                    "message": "car plate number already exists"
                  },
                  "data": null
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/web/change_password": {
      "patch": {
        "tags": [
          "External - Web"
        ],
        "summary": "變更密碼",
        "description": "密碼規則：8-16 字元，需含大寫、小寫、數字，不可超過 3 個連續重複字元，不可含連續數字（如 0123）",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WebChangeAppUserPasswordRequest"
              },
              "example": {
                "password": "asdfAB123"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                }
              }
            }
          },
          "400": {
            "description": "驗證失敗或不允許變更密碼的連線方式",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "validation_failed": {
                    "summary": "密碼格式錯誤",
                    "value": {
                      "meta": {
                        "code": 100002,
                        "message": "missing required letter: uppercase, lowercase, digit"
                      },
                      "data": null
                    }
                  },
                  "invalid_connection": {
                    "summary": "非密碼連線方式",
                    "value": {
                      "meta": {
                        "code": 100015,
                        "message": "invalid connection to change password"
                      },
                      "data": null
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/web/deletion_check": {
      "get": {
        "tags": [
          "External - Web"
        ],
        "summary": "檢查帳號是否可刪除",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ResponseEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/WebAppUserDeletionCheckResponse"
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "meta": {
                    "code": 0,
                    "message": "success"
                  },
                  "data": {
                    "result": {
                      "can_delete": true,
                      "code": 0
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/web/self": {
      "delete": {
        "tags": [
          "External - Web"
        ],
        "summary": "刪除自己的帳號",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ResponseEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/WebAppUserDeleteSelfResponse"
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "meta": {
                    "code": 0,
                    "message": "success"
                  },
                  "data": {
                    "delete_flow": {
                      "id": 1,
                      "app_user_id": "test-app-user-id",
                      "status": "initial"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "使用者無法刪除",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "owns_charge_point": {
                    "summary": "擁有充電樁",
                    "value": {
                      "meta": {
                        "code": 100200,
                        "message": "user cannot be deleted because he owns a charge point"
                      },
                      "data": null
                    }
                  },
                  "in_transaction": {
                    "summary": "正在充電中",
                    "value": {
                      "meta": {
                        "code": 100201,
                        "message": "user cannot be deleted because he is in a transaction"
                      },
                      "data": null
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/web/roles": {
      "get": {
        "tags": [
          "External - Web"
        ],
        "summary": "取得角色與權限列表",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ResponseEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/GetRolesPermissionsResponse"
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "meta": {
                    "code": 0,
                    "message": "success"
                  },
                  "data": {
                    "roles": [
                      {
                        "id": 1,
                        "name": "Admin",
                        "platform": "admin_backend",
                        "permissions": [
                          "site:read",
                          "site:write",
                          "user:read"
                        ]
                      },
                      {
                        "id": 2,
                        "name": "Viewer",
                        "platform": "admin_backend",
                        "permissions": [
                          "site:read",
                          "user:read"
                        ]
                      }
                    ]
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/web/admin/info": {
      "get": {
        "tags": [
          "External - Web"
        ],
        "summary": "取得管理員自身資訊",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ResponseEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/WebGetAdminUserSelfInfoResponse"
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "meta": {
                    "code": 0,
                    "message": "success"
                  },
                  "data": {
                    "admin_user": {
                      "id": "admin-123",
                      "email": "test-email@example.com",
                      "first_name": "test-first",
                      "last_name": "test-last",
                      "phone_number": null,
                      "is_administrator": true,
                      "is_operator": false,
                      "created_at": "2021-01-02T03:00:00Z"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Inactive"
          },
          "404": {
            "description": "管理員不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "meta": {
                    "code": 100004,
                    "message": "admin user not found"
                  },
                  "data": null
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "patch": {
        "tags": [
          "External - Web"
        ],
        "summary": "更新管理員自身資訊",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WebUpdateAdminUserSelfInfoRequest"
              },
              "example": {
                "first_name": "test-first",
                "last_name": "test-last",
                "phone_number": "+886 987654321"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ResponseEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/WebUpdateAdminUserSelfInfoResponse"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Inactive"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/web/admin/settings": {
      "get": {
        "tags": [
          "External - Web"
        ],
        "summary": "取得管理員設定",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "version",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ResponseEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/WebGetAdminUserSettingsResponse"
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "meta": {
                    "code": 0,
                    "message": "success"
                  },
                  "data": {
                    "admin_user_settings": [
                      {
                        "version": "v2",
                        "category": "test-category",
                        "name": "test-name",
                        "data": "{\"name\": \"hi\"}",
                        "updated_at": "2022-03-04T05:00:00Z"
                      }
                    ]
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Inactive"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "put": {
        "tags": [
          "External - Web"
        ],
        "summary": "更新管理員設定",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WebUpdateAdminUserSettingRequest"
              },
              "example": {
                "version": "v2",
                "category": "test-category",
                "name": "test-name",
                "data": "{\"name\": \"new-name\"}"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ResponseEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/WebUpdateAdminUserSettingResponse"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Inactive"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/web/operator_panel/info": {
      "get": {
        "tags": [
          "External - Web"
        ],
        "summary": "取得營運商自身資訊",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ResponseEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/WebGetOperatorSelfInfoResponse"
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "meta": {
                    "code": 0,
                    "message": "success"
                  },
                  "data": {
                    "operator": {
                      "id": "operator-123",
                      "role_id": 1,
                      "role_name": "Technician",
                      "operator_company_id": 1,
                      "operator_company_name": "Test Company",
                      "created_at": "2021-01-02T03:00:00Z"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "非營運商身份",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "meta": {
                    "code": 100010,
                    "message": "the user is not an operator"
                  },
                  "data": null
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Inactive"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/web/operator_panel/user/{user_id}": {
      "get": {
        "tags": [
          "External - Web"
        ],
        "summary": "營運商取得使用者資訊",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/UserIdPath"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ResponseEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/WebOperatorPanelInfoResponse"
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "meta": {
                    "code": 0,
                    "message": "success"
                  },
                  "data": {
                    "user": {
                      "id": "user-123",
                      "email": "user@example.com",
                      "first_name": "John",
                      "last_name": "Doe"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Inactive"
          },
          "404": {
            "description": "App 使用者不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "meta": {
                    "code": 100012,
                    "message": "app user not found"
                  },
                  "data": null
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/web/operator_panel/operators": {
      "get": {
        "tags": [
          "External - Web"
        ],
        "summary": "取得營運商列表",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "role_id_in",
            "in": "query",
            "description": "篩選角色 ID（3=Maintainer, 4=Technician）",
            "schema": {
              "type": "array",
              "items": {
                "type": "integer",
                "enum": [
                  3,
                  4
                ]
              }
            }
          },
          {
            "name": "site_id_in",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            }
          },
          {
            "name": "display_status_in",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "INVITED",
                  "EXPIRED",
                  "ACTIVE"
                ]
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ResponseEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/WebListOperatorsResponse"
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "meta": {
                    "code": 0,
                    "message": "success"
                  },
                  "data": {
                    "operators": [
                      {
                        "id": "op-123",
                        "email": "operator@example.com",
                        "first_name": "John",
                        "last_name": "Doe",
                        "role_id": 3,
                        "role_name": "Maintainer",
                        "display_status": "ACTIVE",
                        "invited_at": "2024-01-15T10:00:00Z",
                        "last_logged_in_at": "2024-06-20T14:30:00Z",
                        "sites": [
