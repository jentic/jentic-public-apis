  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "IdPath": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "SiteIdPath": {
        "name": "site_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "UserIdPath": {
        "name": "user_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "OperatorIdPath": {
        "name": "operator_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "ValidationError": {
        "description": "請求驗證失敗",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "examples": {
              "invalid_body": {
                "summary": "Request body 格式錯誤",
                "value": {
                  "meta": {
                    "code": 100000,
                    "message": "invalid request body"
                  },
                  "data": null
                }
              },
              "validation_failed": {
                "summary": "欄位驗證失敗",
                "value": {
                  "meta": {
                    "code": 100002,
                    "message": "first_name: the length must be between 1 and 50"
                  },
                  "data": null
                }
              }
            }
          }
        }
      },
      "Unauthorized": {
        "description": "未認證（缺少或無效的 JWT）",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "meta": {
                "code": 100001,
                "message": "missing user id"
              },
              "data": null
            }
          }
        }
      },
      "Inactive": {
        "description": "管理員帳號已停用",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "meta": {
                "code": 100098,
                "message": "admin is inactive"
              },
              "data": null
            }
          }
        }
      },
      "PermissionDenied": {
        "description": "權限不足",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "examples": {
              "permission_denied": {
                "summary": "無管理員權限",
                "value": {
                  "meta": {
                    "code": 100099,
                    "message": "permission denied"
                  },
                  "data": null
                }
              },
              "invalid_user_type": {
                "summary": "無效的使用者類型",
                "value": {
                  "meta": {
                    "code": 100009,
                    "message": "invalid user type"
                  },
                  "data": null
                }
              }
            }
          }
        }
      },
      "NotFound": {
        "description": "資源不存在",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "meta": {
                "code": 100004,
                "message": "user not found"
              },
              "data": null
            }
          }
        }
      },
      "InternalError": {
        "description": "伺服器內部錯誤",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "meta": {
                "code": -1,
                "message": "internal error"
              },
              "data": null
            }
          }
        }
      }
    },
    "schemas": {
      "ResponseMeta": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "description": "0=成功，正數=業務錯誤，負數=系統錯誤"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ResponseEnvelope": {
        "type": "object",
        "required": [
          "meta",
          "data"
        ],
        "properties": {
          "meta": {
            "$ref": "#/components/schemas/ResponseMeta"
          },
          "data": {
            "description": "回應資料（錯誤時為 null）"
          }
        }
      },
      "SuccessResponse": {
        "type": "object",
        "properties": {
          "meta": {
            "$ref": "#/components/schemas/ResponseMeta"
          },
          "data": {
            "nullable": true
          }
        },
        "example": {
          "meta": {
            "code": 0,
            "message": "success"
          },
          "data": null
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "meta": {
            "$ref": "#/components/schemas/ResponseMeta"
          },
          "data": {
            "nullable": true
          }
        },
        "example": {
          "meta": {
            "code": 100002,
            "message": "validation failed"
          },
          "data": null
        }
      },
