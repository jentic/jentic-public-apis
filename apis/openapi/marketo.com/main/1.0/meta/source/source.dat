{
  "openapi": "3.0.3",
  "info": {
    "title": "Marketo REST API",
    "version": "1.0",
    "description": "Adobe Marketo Engage REST API for marketing automation. Covers lead management, activities, assets (programs, emails, landing pages, forms), bulk import/export, smart campaigns, and custom objects.",
    "x-jentic-source-url": "https://experienceleague.adobe.com/en/docs/marketo-developer/marketo/rest/rest-api",
    "contact": {
      "name": "Adobe",
      "url": "https://www.adobe.com"
    }
  },
  "servers": [
    {
      "url": "https://{munchkin-id}.mktorest.com",
      "description": "Marketo REST API",
      "variables": {
        "munchkin-id": {
          "default": "123-ABC-456",
          "description": "Your Marketo Munchkin Account ID"
        }
      }
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Identity",
      "description": "OAuth authentication"
    },
    {
      "name": "Leads",
      "description": "Lead database operations"
    },
    {
      "name": "Activities",
      "description": "Lead activity data"
    },
    {
      "name": "Lists",
      "description": "Static list management"
    },
    {
      "name": "Companies",
      "description": "Company records"
    },
    {
      "name": "Opportunities",
      "description": "Opportunity records"
    },
    {
      "name": "Programs",
      "description": "Marketing program assets"
    },
    {
      "name": "Emails",
      "description": "Email assets"
    },
    {
      "name": "Landing Pages",
      "description": "Landing page assets"
    },
    {
      "name": "Forms",
      "description": "Form assets"
    },
    {
      "name": "Folders",
      "description": "Asset folder management"
    },
    {
      "name": "Tokens",
      "description": "My Tokens (folder/program tokens)"
    },
    {
      "name": "Tags",
      "description": "Tag and channel management"
    },
    {
      "name": "Snippets",
      "description": "Snippet assets"
    },
    {
      "name": "Files",
      "description": "File/image assets"
    },
    {
      "name": "Smart Campaigns",
      "description": "Smart campaign management"
    },
    {
      "name": "Custom Objects",
      "description": "Custom object records"
    },
    {
      "name": "Bulk Import",
      "description": "Bulk lead/object import"
    },
    {
      "name": "Bulk Export",
      "description": "Bulk lead/activity export"
    },
    {
      "name": "Usage",
      "description": "API usage statistics"
    }
  ],
  "paths": {
    "/identity/oauth/token": {
      "get": {
        "operationId": "getAccessToken",
        "summary": "Get OAuth access token",
        "tags": [
          "Identity"
        ],
        "responses": {
          "200": {
            "description": "Access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
