{"openapi":"3.1.0","info":{"title":"Business Box API","version":"1.0.0","description":"Bookings, event types, availability and webhooks for a Business Box account. Authenticate with a personal API key as a bearer token. All times are ISO 8601 UTC; money is an integer in the currency’s minor units, and JPY is zero-decimal, so 5000 is ¥5,000.","contact":{"name":"Business Box support","email":"support@marubox.jp"},"termsOfService":"https://marubox.jp/terms"},"components":{"securitySchemes":{"bearerAuth":{"type":"http","scheme":"bearer","description":"A personal API key, created under Settings → Integrations → API keys."}},"schemas":{"apiBooking":{"type":"object","properties":{"id":{"type":"string"},"status":{"type":"string","enum":["held","awaiting_payment","confirmed","cancelled","completed","no_show"]},"start":{"type":"string"},"end":{"type":"string"},"hostTimezone":{"type":"string"},"eventType":{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"},"nameI18n":{"type":"object","properties":{"en":{"type":"string","maxLength":2000},"ja":{"type":"string","maxLength":2000}},"additionalProperties":false},"slug":{"type":"string"}},"required":["id","name","nameI18n","slug"],"additionalProperties":false},"booker":{"type":"object","properties":{"name":{"type":"string"},"email":{"type":"string"},"phone":{"type":["string","null"]},"locale":{"type":"string","enum":["en","ja"]},"timezone":{"type":"string"}},"required":["name","email","phone","locale","timezone"],"additionalProperties":false},"answers":{"type":"array","items":{"type":"object","properties":{"questionId":{"type":"string"},"label":{"type":"string"},"labelI18n":{"type":"object","properties":{"en":{"type":"string","maxLength":2000},"ja":{"type":"string","maxLength":2000}},"additionalProperties":false},"value":{"type":["string","boolean"]}},"required":["questionId","label","labelI18n","value"],"additionalProperties":false}},"bookerNotes":{"type":["string","null"]},"location":{"oneOf":[{"type":"object","properties":{"kind":{"type":"string","enum":["google_meet"]}},"required":["kind"],"additionalProperties":false},{"type":"object","properties":{"kind":{"type":"string","enum":["teams"]}},"required":["kind"],"additionalProperties":false},{"type":"object","properties":{"kind":{"type":"string","enum":["zoom"]}},"required":["kind"],"additionalProperties":false},{"type":"object","properties":{"kind":{"type":"string","enum":["phone"]},"direction":{"type":"string","enum":["host_calls","booker_calls"]},"hostPhone":{"type":"string","maxLength":40}},"required":["kind","direction"],"additionalProperties":false},{"type":"object","properties":{"kind":{"type":"string","enum":["in_person"]},"address":{"type":"string","minLength":1,"maxLength":500}},"required":["kind","address"],"additionalProperties":false},{"type":"object","properties":{"kind":{"type":"string","enum":["custom"]},"text":{"type":"object","properties":{"en":{"type":"string","maxLength":2000},"ja":{"type":"string","maxLength":2000}},"additionalProperties":false}},"required":["kind","text"],"additionalProperties":false}]},"joinUrl":{"type":["string","null"]},"source":{"type":"string","enum":["public","manual","reschedule"]},"payment":{"anyOf":[{"type":"object","properties":{"amount":{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991},"currency":{"type":"string"},"status":{"type":"string","enum":["unpaid","paid","refunded","partially_refunded","failed"]},"refundedAmount":{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991},"receiptUrl":{"type":["string","null"]}},"required":["amount","currency","status","refundedAmount","receiptUrl"],"additionalProperties":false},{"type":"null"}]},"cancellation":{"anyOf":[{"type":"object","properties":{"by":{"type":"string","enum":["booker","host","system"]},"reason":{"type":["string","null"]},"at":{"type":"string"}},"required":["by","reason","at"],"additionalProperties":false},{"type":"null"}]},"manageUrl":{"type":"string"},"createdAt":