{
  "openapi": "3.1.0",
  "info": {
    "title": "You.com Extract API",
    "description": "Returns a web page or PDF as clean Markdown or HTML",
    "version": "0.0.1",
    "x-jentic-source-url": "https://you.com/specs/openapi_extract.yaml"
  },
  "servers": [
    {
      "url": "https://ydc-index.io"
    }
  ],
  "paths": {
    "/v1/extract": {
      "post": {
        "summary": "Returns a web page or PDF as clean Markdown or HTML",
        "description": "The Extract API fetches a web page or PDF and returns it as clean Markdown, HTML, or both. Use it after a Web Search API call, when your agent needs the full document, such as a filing, a contract, or a research paper, instead of a highlight.\n\nPDF tables come back as Markdown or HTML tables with rows and columns intact. Set `parse_effort=standard` to also send complex PDF pages, such as charts and images, through an advanced model for the most complete output.",
        "operationId": "extract",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExtractRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A JSON object containing the extracted content from the URL",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtractResult"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized. Problems with API key.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "detail": {
                      "type": "string",
                      "description": "Error detail message."
                    }
                  }
                },
                "examples": {
                  "missingApiKey": {
                    "summary": "Missing API key",
                    "value": {
                      "detail": "API key is required"
                    }
                  },
                  "invalidOrExpired": {
                    "summary": "Invalid/expired API key",
                    "value": {
                      "detail": "Invalid or expired API key"
                    }
                  },
                  "otherAuthParsing": {
                    "summary": "Other auth parsing errors",
                    "value": {
                      "detail": "<error message>"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden. API key lacks scope for this path.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "detail": {
                      "type": "string"
                    }
                  }
                },
                "examples": {
                  "missingScopes": {
                    "summary": "Missing required scopes",
                    "value": {
                      "detail": "Missing required scopes"
                    }
                  }
                }
              }
            }
          },
          "402": {
            "description": "Payment Required. The prepaid credit balance is depleted. Retrying fails until credits are added at `details.upgrade_url`. The API gateway can also answer with its own body, so branch on the 402 status rather than the body.",
            "headers": {
              "X-YDC-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtractErrorResponse"
                },
                "examples": {
                  "paymentRequired": {
                    "summary": "Credits depleted",
                    "value": {
                      "error": {
                        "code": "payment_required",
                        "message": "Your prepaid credit balance has been depleted. Please add credits to continue using the API.",
                        "retryable": false,
                        "request_id": "3f2b8c1e-7a4d-4e0b-9c6a-1d2e3f4a5b6c",
                        "details": {
                          "upgrade_url": "https://you.com/platform"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity. The request can't succeed as sent. `code` is `invalid_request` when the body failed validation, with one entry per problem in `details.fields`. Unknown fields, including the removed `crawl_timeout`, are rejected. `invalid_url` means the URL can never be fetched (malformed, not http or https, a private address, or a hostname that doesn't exist), with the cause in `details.reason`. `pdf_too_large` means the PDF needs more time than `timeout` allows, so a higher `timeout` can let it through.",
            "headers": {
              "X-YDC-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtractErrorResponse"
                },
                "examples": {
                  "invalidRequest": {
                    "summary": "Invalid request body",
                    "value": {
                      "error": {
                        "code": "invalid_request",
                        "message": "The request body is invalid. See details.fields.",
                        "retryable": false,
                        "request_id": "3f2b8c1e-7a4d-4e0b-9c6a-1d2e3f4a5b6c",
                        "details": {
                          "fields": [
                            {
                              "field": "full_page.extraction_formats.0",
                              "message": "Input should be 'html' or 'markdown'"
                            },
                            {
                              "field": "timeout",
                              "message": "Input should be less than or equal to 100"
                            }
                          ]
                        }
                      }
                    }
                  },
                  "invalidUrl": {
                    "summary": "Invalid URL",
                    "value": {
                      "error": {
                        "code": "invalid_url",
                        "message": "The url is not a valid public http or https URL.",
                        "retryable": false,
                        "request_id": "3f2b8c1e-7a4d-4e0b-9c6a-1d2e3f4a5b6c",
                        "details": {
                          "reason": "private_address"
                        }
                      }
                    }
                  },
                  "pdfTooLarge": {
                    "summary": "PDF too large",
                    "value": {
                      "error": {
                        "code": "pdf_too_large",
                        "message": "This PDF has 1,200 pages and cannot be processed within the request time limit. Try increasing the timeout (max 100).",
                        "retryable": false,
                        "request_id": "3f2b8c1e-7a4d-4e0b-9c6a-1d2e3f4a5b6c",
                        "details": {
                          "timeout_s": 30,
                          "page_count": 1200
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error. `code` is `internal_error`. Retry only when `retryable` is `true`, and honor the `Retry-After` header when it is present. If the error persists, contact support with the `request_id`.",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying. Sent on some retryable errors.",
                "schema": {
                  "type": "integer",
                  "example": 5
                }
              },
              "X-YDC-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtractErrorResponse"
                },
                "examples": {
                  "retryable": {
                    "summary": "Retryable internal error",
                    "value": {
                      "error": {
                        "code": "internal_error",
                        "message": "An internal error occurred. Please retry. If it persists, contact support with the request_id.",
                        "retryable": true,
                        "request_id": "3f2b8c1e-7a4d-4e0b-9c6a-1d2e3f4a5b6c"
                      }
                    }
                  },
                  "notRetryable": {
                    "summary": "Non-retryable internal error",
                    "value": {
                      "error": {
                        "code": "internal_error",
                        "message": "An internal error occurred. Contact support with the request_id.",
                        "retryable": false,
                        "request_id": "3f2b8c1e-7a4d-4e0b-9c6a-1d2e3f4a5b6c"
                      }
                    }
                  }
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway. The page itself can't be extracted, and retrying fails until the page changes. `code` is `site_blocked`, `site_unreachable`, or `unsupported_content`, with the cause in `details.reason`. `unsupported_content` can also include `details.content_type`.",
            "headers": {
              "X-YDC-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtractErrorResponse"
                },
                "examples": {
                  "siteBlocked": {
                    "summary": "Site blocked",
                    "value": {
                      "error": {
                        "code": "site_blocked",
                        "message": "This site does not allow its content to be extracted.",
                        "retryable": false,
                        "request_id": "3f2b8c1e-7a4d-4e0b-9c6a-1d2e3f4a5b6c",
                        "details": {
                          "reason": "login_required"
                        }
                      }
                    }
                  },
                  "siteUnreachable": {
                    "summary": "Site unreachable",
                    "value": {
                      "error": {
                        "code": "site_unreachable",
                        "message": "The site could not be reached or loaded. Check the URL.",
                        "retryable": false,
                        "request_id": "3f2b8c1e-7a4d-4e0b-9c6a-1d2e3f4a5b6c",
                        "details": {
                          "reason": "not_found"
                        }
                      }
                    }
                  },
                  "unsupportedContent": {
                    "summary": "Unsupported content",
                    "value": {
                      "error": {
                        "code": "unsupported_content",
                        "message": "The content at this URL cannot be extracted.",
                        "retryable": false,
                        "request_id": "3f2b8c1e-7a4d-4e0b-9c6a-1d2e3f4a5b6c",
                        "details": {
                          "reason": "unsupported_type",
                          "content_type": "application/zip"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable. A dependency, including DNS, was down or rate limited. Retry after the number of seconds in the `Retry-After` header.",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying.",
                "schema": {
                  "type": "integer",
                  "example": 30
                }
              },
              "X-YDC-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtractErrorResponse"
                },
                "examples": {
                  "unavailable": {
                    "summary": "Service unavailable",
                    "value": {
                      "error": {
                        "code": "service_unavailable",
                        "message": "A service we depend on is temporarily unavailable. Please retry.",
                        "retryable": true,
                        "request_id": "3f2b8c1e-7a4d-4e0b-9c6a-1d2e3f4a5b6c"
                      }
                    }
                  }
                }
              }
            }
          },
          "504": {
            "description": "Gateway Timeout. The request didn't finish within `timeout`. `details.timeout_s` is the timeout that applied. Below the 100-second maximum, retry with a higher `timeout`.",
            "headers": {
              "X-YDC-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtractErrorResponse"
                },
                "examples": {
                  "belowMax": {
                    "summary": "Timeout below the maximum",
                    "value": {
                      "error": {
                        "code": "timeout",
                        "message": "The request did not finish within its timeout of 30 seconds. Retry with a higher timeout (max 100).",
                        "retryable": true,
                        "request_id": "3f2b8c1e-7a4d-4e0b-9c6a-1d2e3f4a5b6c",
                        "details": {
                          "timeout_s": 30
                        }
                      }
                    }
                  },
                  "atMax": {
                    "summary": "Timeout at the maximum",
                    "value": {
                      "error": {
                        "code": "timeout",
                        "message": "The request did not finish within the maximum timeout of 100 seconds. Please retry later.",
                        "retryable": true,
                        "request_id": "3f2b8c1e-7a4d-4e0b-9c6a-1d2e3f4a5b6c",
                        "details": {
                          "timeout_s": 100
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "headers": {
      "RequestId": {
        "description": "The You.com ID for this request, the same value as `error.request_id`. Include it when you contact support.",
        "schema": {
          "type": "string",
          "example": "3f2b8c1e-7a4d-4e0b-9c6a-1d2e3f4a5b6c"
        }
      }
    },
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "A unique API Key is required to authorize API access. [Get your API Key with free credits](https://you.com/platform)."
      }
    },
    "schemas": {
      "ExtractRequest": {
        "type": "object",
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "description": "The URL to extract content from.",
            "type": "string",
            "format": "uri",
            "example": "https://en.wikipedia.org/wiki/Retrieval-augmented_generation"
          },
          "full_page": {
            "$ref": "#/components/schemas/FullPageConfig"
          },
          "extraction_source": {
            "type": "string",
            "enum": [
              "blend",
              "cache",
              "fetch"
            ],
            "default": "blend",
            "description": "Indicates where `full_page` content comes from.\n\n`blend` serves cached content when it is available and crawls the page live when it is not. This is the default.\n\n`cache` returns cached content only. It is the fastest option, and `contents` is omitted for results that have no cached content.\n\n`fetch` always crawls the page live, which returns the freshest content at the cost of higher latency.",
            "example": "blend"
          },
          "timeout": {
            "description": "Seconds the request may take end to end, including the cache lookup and the crawl. Must be between 2 and 100. Default is 30. Past it the request returns a 504.",
            "type": "integer",
            "minimum": 2,
            "maximum": 100,
            "example": 30,
            "default": 30
          },
          "parse_effort": {
            "description": "How much effort to spend parsing PDF pages. Has no effect on web pages.\n\n`lite` extracts the content embedded in each page. Use it for digitally created PDFs when you want the lowest cost.\n\n`standard` also sends complex pages, such as charts and images, through an advanced model, and is billed per page. Use it when you want the most complete output.\n\nFor example, `lite` works well on a text-based contract, while an earnings report with revenue charts returns more complete content under `standard`.",
            "type": "string",
            "enum": [
              "lite",
              "standard"
            ],
            "default": "standard",
            "example": "standard"
          }
        }
      },
      "FullPageConfig": {
        "type": "object",
        "description": "Options for the returned page content. When omitted, the page is returned as Markdown.",
        "properties": {
          "extraction_formats": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "markdown",
                "html"
              ]
            },
            "default": [
              "markdown"
            ],
            "description": "Content formats to return, one or both of `markdown` and `html`. An empty array is treated as `[\"markdown\"]`.",
            "example": [
              "markdown"
            ]
          }
        }
      },
      "ExtractResult": {
        "type": "object",
        "description": "The extracted page. Every field is omitted, and the object is empty, when nothing was extracted.",
        "properties": {
          "url": {
            "description": "The URL whose content was extracted.",
            "type": "string",
            "format": "uri",
            "example": "https://en.wikipedia.org/wiki/Retrieval-augmented_generation"
          },
          "extraction_source": {
            "type": "string",
            "description": "Where the request allowed content to come from. `blend` serves cached content when it is available and crawls the page live when it is not.",
            "example": "blend"
          },
          "title": {
            "type": "string",
            "description": "The title of the web page.",
            "example": "Retrieval-augmented generation - Wikipedia"
          },
          "contents": {
            "$ref": "#/components/schemas/ExtractContents"
          },
          "metadata": {
            "$ref": "#/components/schemas/ExtractMetadata"
          }
        }
      },
      "ExtractContents": {
        "type": "object",
        "description": "The extracted content from the URL.",
        "properties": {
          "full_page": {
            "type": "object",
            "description": "The page content in each format requested in `full_page.extraction_formats`.",
            "properties": {
              "markdown": {
                "type": "string",
                "description": "The Markdown content of the page."
              },
              "html": {
                "type": "string",
                "description": "The HTML content of the page."
              }
            }
          }
        }
      },
      "ExtractMetadata": {
        "type": "object",
        "description": "Metadata about the web page.",
        "properties": {
          "site_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "The OpenGraph site name of the web page.",
            "example": "Wikipedia"
          },
          "favicon_url": {
            "type": "string",
            "description": "The URL of the favicon of the web page's domain.",
            "example": "https://api.ydc-index.io/favicon?domain=en.wikipedia.org&size=128"
          }
        }
      },
      "ExtractErrorResponse": {
        "type": "object",
        "description": "The body of every 402, 422, 500, 502, 503, and 504 response.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ExtractErrorDetail"
          }
        }
      },
      "ExtractErrorDetail": {
        "type": "object",
        "required": [
          "code",
          "message",
          "retryable",
          "request_id"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable error code to branch on. New codes may be added, but existing codes are never renamed or removed.",
            "enum": [
              "invalid_request",
              "invalid_url",
              "payment_required",
              "pdf_too_large",
              "site_blocked",
              "site_unreachable",
              "unsupported_content",
              "timeout",
              "service_unavailable",
              "internal_error"
            ]
          },
          "message": {
            "type": "string",
            "description": "Human-readable explanation. The wording can change, so don't parse it."
          },
          "retryable": {
            "type": "boolean",
            "description": "Whether sending the same request again can succeed."
          },
          "request_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "The You.com ID for this request. Include it when you contact support."
          },
          "details": {
            "$ref": "#/components/schemas/ExtractErrorDetails"
          }
        }
      },
      "ExtractErrorDetails": {
        "type": "object",
        "description": "Extra context for some codes. Omitted when there is none.",
        "properties": {
          "fields": {
            "type": "array",
            "description": "`invalid_request` only. One entry per validation problem.",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "description": "Dotted path to the invalid field, such as `full_page.extraction_formats.0`, or `body` when the body itself can't be parsed."
                },
                "message": {
                  "type": "string",
                  "description": "What is wrong with the field."
                }
              }
            }
          },
          "reason": {
            "type": "string",
            "description": "Cause of the error. For `invalid_url`: `malformed`, `unsupported_scheme`, `private_address`, or `unresolvable`. For `site_blocked`: `unsupported_site`, `anti_bot`, or `login_required`. For `site_unreachable`: `tls_error`, `connection_failed`, `load_failed`, or `not_found`. For `unsupported_content`: `unsupported_type`, `too_large`, `not_a_pdf`, `unparseable`, `no_text`, or `unreadable_text`."
          },
          "content_type": {
            "type": "string",
            "description": "`unsupported_content` only, when known. The content type of the page."
          },
          "timeout_s": {
            "type": "integer",
            "description": "`timeout` and `pdf_too_large` only. The timeout, in seconds, that applied to the request."
          },
          "page_count": {
            "type": "integer",
            "description": "`pdf_too_large` only, when known. The number of pages in the PDF."
          },
          "upgrade_url": {
            "type": "string",
            "format": "uri",
            "description": "`payment_required` only. Where to add credits."
          }
        }
      }
    }
  },
  "security": [
    {
      "ApiKeyAuth": []
    }
  ]
}