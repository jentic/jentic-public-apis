    "/patients": {
      "get": {
        "tags": [
          "patient"
        ],
        "summary": "Get all patients",
        "description": "Retrieves a paginated list of patients with optional filtering and sorting.",
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "description": "Page number (0-based)."
          },
          {
            "in": "query",
            "name": "size",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "description": "Page size (number of items per page)."
          },
          {
            "in": "query",
            "name": "sort",
            "schema": {
              "type": "string",
              "example": "fullName,asc"
            },
            "description": "Sorting criteria, e.g. 'fullName,asc'."
          },
          {
            "in": "query",
            "name": "gender",
            "schema": {
              "type": "string",
              "example": "female"
            },
            "description": "Filter patients by gender."
          },
          {
            "in": "query",
            "name": "birthDateFrom",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Filter patients born on or after this date."
          },
          {
            "in": "query",
            "name": "birthDateTo",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Filter patients born on or before this date."
          }
        ],
        "responses": {
          "200": {
            "description": "List of patients.",
