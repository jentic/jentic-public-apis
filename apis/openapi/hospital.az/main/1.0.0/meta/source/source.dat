    "/appointments": {
      "get": {
        "tags": [
          "appointment"
        ],
        "summary": "Get all appointments",
        "description": "Retrieves a paginated list of appointments with filtering and sorting options.",
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "description": "Page number (0-based)."
          },
          {
            "in": "query",
            "name": "size",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "description": "Page size (number of items per page)."
          },
          {
            "in": "query",
            "name": "sort",
            "schema": {
              "type": "string",
              "example": "appointmentDate,desc"
            },
            "description": "Sorting criteria, e.g. 'appointmentDate,asc'."
          },
          {
            "in": "query",
            "name": "doctorId",
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "description": "Filter appointments by doctor ID."
          },
          {
            "in": "query",
            "name": "patientId",
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "description": "Filter appointments by patient ID."
          },
          {
            "in": "query",
            "name": "status",
            "schema": {
              "type": "string",
              "enum": [
                "pending",
                "approved",
                "rejected"
              ]
            },
            "description": "Filter appointments by status."
          },
          {
            "in": "query",
            "name": "dateFrom",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Filter appointments on or after this date."
          },
          {
            "in": "query",
            "name": "dateTo",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Filter appointments on or before this date."
          }
        ],
        "responses": {
          "200": {
            "description": "List of appointments.",
            "content": {
