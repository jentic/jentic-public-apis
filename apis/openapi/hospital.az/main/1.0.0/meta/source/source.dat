  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Department": {
        "type": "object",
        "properties": {
          "departmentId": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "Doctor": {
        "type": "object",
        "properties": {
          "doctorId": {
            "type": "integer",
            "format": "int32"
          },
          "fullName": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phone": {
            "type": "string"
          },
          "gender": {
            "type": "string"
          },
          "birthDate": {
            "type": "string",
            "format": "date"
          },
          "specialization": {
            "type": "string"
          },
          "departmentId": {
            "type": "integer",
            "format": "int32"
          },
          "experienceYears": {
            "type": "integer",
            "format": "int32"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "DoctorSchedule": {
        "type": "object",
        "properties": {
          "scheduleId": {
            "type": "integer",
            "format": "int32"
          },
          "doctorId": {
            "type": "integer",
            "format": "int32"
          },
          "dayOfWeek": {
            "type": "string",
            "description": "Day of the week, e.g. Monday, Tuesday, etc."
          },
          "startTime": {
            "type": "string",
            "description": "Start time in HH:mm format.",
            "example": "09:00"
          },
          "endTime": {
            "type": "string",
            "description": "End time in HH:mm format.",
            "example": "17:00"
          }
        }
      },
      "Patient": {
        "type": "object",
        "properties": {
          "patientId": {
            "type": "integer",
            "format": "int32"
          },
          "fullName": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phone": {
            "type": "string"
          },
          "gender": {
            "type": "string"
          },
          "birthDate": {
            "type": "string",
            "format": "date"
          },
          "address": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Appointment": {
        "type": "object",
        "properties": {
          "appointmentId": {
            "type": "integer",
            "format": "int32"
          },
          "patientId": {
            "type": "integer",
            "format": "int32"
          },
          "doctorId": {
            "type": "integer",
            "format": "int32"
          },
          "appointmentDate": {
            "type": "string",
            "format": "date"
          },
          "appointmentTime": {
            "type": "string",
            "description": "Time of the appointment in HH:mm format.",
            "example": "14:30"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "rejected"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "MedicalRecord": {
        "type": "object",
        "properties": {
          "medicalRecordId": {
            "type": "integer",
            "format": "int32"
          },
          "appointmentId": {
            "type": "integer",
            "format": "int32"
          },
          "diagnosis": {
            "type": "string"
          },
          "recommendations": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Prescription": {
        "type": "object",
        "properties": {
          "prescriptionId": {
            "type": "integer",
            "format": "int32"
          },
          "medicalRecordId": {
            "type": "integer",
            "format": "int32"
          },
          "medicationName": {
            "type": "string"
          },
          "dosage": {
            "type": "string"
          },
          "instructions": {
            "type": "string"
          }
        }
      }
    }
  }
}
