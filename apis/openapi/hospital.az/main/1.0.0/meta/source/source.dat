{
  "openapi": "3.0.0",
  "info": {
    "title": "Hospital Appointment Management System API",
    "version": "1.0.0",
    "description": "API documentation for managing hospital appointments, including departments, doctors, doctor schedules, patients, appointments, medical records, and prescriptions.\n",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/idtech-4bb/HAMS-Hospital-Appointment-Management-System/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.hospital.az/v1",
      "description": "Main API server"
    }
  ],
  "tags": [
    {
      "name": "department",
      "description": "Operations related to departments"
    },
    {
      "name": "doctor",
      "description": "Operations related to doctors"
    },
    {
      "name": "doctorSchedule",
      "description": "Operations related to doctor schedules"
    },
    {
      "name": "patient",
      "description": "Operations related to patients"
    },
    {
      "name": "appointment",
      "description": "Operations related to appointments"
    },
    {
      "name": "medicalRecord",
      "description": "Operations related to medical records"
    },
    {
      "name": "prescription",
      "description": "Operations related to prescriptions"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/departments": {
      "get": {
        "tags": [
          "department"
        ],
        "summary": "Get all departments",
        "description": "Retrieves a paginated list of departments with optional filtering and sorting.",
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "description": "Page number (0-based)."
          },
          {
            "in": "query",
            "name": "size",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "description": "Page size (number of items per page)."
          },
          {
            "in": "query",
            "name": "sort",
            "schema": {
              "type": "string",
              "example": "name,asc"
            },
            "description": "Sorting criteria in the format 'field,direction', e.g. 'name,asc' or 'departmentId,desc'.\n"
          },
          {
            "in": "query",
            "name": "name",
            "schema": {
              "type": "string"
            },
            "description": "Filter departments by name (contains)."
          }
        ],
        "responses": {
          "200": {
            "description": "List of departments.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Department"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized. Valid token required."
          },
          "500": {
            "description": "Server error."
          }
        }
      },
      "post": {
        "tags": [
          "department"
        ],
        "summary": "Create department",
        "description": "Creates a new department.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Department"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Department created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Department"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input."
          },
          "401": {
            "description": "Unauthorized."
          },
          "500": {
            "description": "Server error."
          }
        }
      }
    },
    "/departments/{departmentId}": {
      "get": {
        "tags": [
