    OverlayConfirmRequest:
      additionalProperties: false
      description: Payload for confirming an overlay.
      examples:
      - &id208
        execution_id: exec_6968b3982706c619fe73f0cf
      properties:
        execution_id:
          anyOf:
          - type: string
          - type: 'null'
          description: ID of the execution that verified the overlay, recorded as `confirmed_by_execution_id`.
          examples:
          - exec_6968b3982706c619fe73f0cf
          title: Execution Id
      title: OverlayConfirmRequest
      type: object
    OverlayLinksResponse:
      description: |-
        Hypermedia links for an overlay resource.

        Links are advertised based on the overlay's *state validity* (mirroring the
        revisions resource's promote/archive links), so a surface renders an action only
        when it is applicable to the current status. They are not permission-scoped — the
        ``overlays:confirm`` gate on confirm/rollback is still enforced server-side (403).
      examples:
      - &id106
        api: https://jentic.example.com/apis/stripe.com/stripe/2024-04-10
        confirm: https://jentic.example.com/apis/stripe.com/stripe/2024-04-10/overlays/ovr_6968b398ae1c9a6e2fe6520a:confirm
        deprecate: https://jentic.example.com/apis/stripe.com/stripe/2024-04-10/overlays/ovr_6968b398ae1c9a6e2fe6520a
        rollback: https://jentic.example.com/apis/stripe.com/stripe/2024-04-10/overlays/ovr_6968b398ae1c9a6e2fe6520a:rollback
        self: https://jentic.example.com/apis/stripe.com/stripe/2024-04-10/overlays/ovr_6968b398ae1c9a6e2fe6520a
      properties:
        api:
          description: URL of the API the overlay applies to.
          examples:
          - https://jentic.example.com/apis/stripe.com/stripe/2024-04-10
          title: Api
          type: string
        confirm:
          anyOf:
          - type: string
          - type: 'null'
          description: URL to confirm the overlay; null unless it is `pending`.
          examples:
          - https://jentic.example.com/apis/stripe.com/stripe/2024-04-10/overlays/ovr_6968b398ae1c9a6e2fe6520a:confirm
          title: Confirm
        deprecate:
          anyOf:
          - type: string
          - type: 'null'
          description: URL to deprecate the overlay (via `DELETE`); null once it is `deprecated`.
          examples:
          - https://jentic.example.com/apis/stripe.com/stripe/2024-04-10/overlays/ovr_6968b398ae1c9a6e2fe6520a
          title: Deprecate
        rollback:
          anyOf:
          - type: string
          - type: 'null'
          description: URL to roll back the overlay; null unless it is `confirmed` and its revision has been produced.
          examples:
          - https://jentic.example.com/apis/stripe.com/stripe/2024-04-10/overlays/ovr_6968b398ae1c9a6e2fe6520a:rollback
          title: Rollback
        self:
          description: URL of this overlay.
          examples:
          - https://jentic.example.com/apis/stripe.com/stripe/2024-04-10/overlays/ovr_6968b398ae1c9a6e2fe6520a
          title: Self
          type: string
      required:
      - self
      - api
      title: OverlayLinksResponse
      type: object
    OverlayListResponse:
      description: Cursor-paginated list of overlays.
      examples:
      - &id204
        data: &id107
        - _links: *id106
          api_id: debfc9ff-7c37-4a09-801a-575bd4963ddd
          confirmed_at: '2026-01-15T10:05:00Z'
          confirmed_by_execution_id: exec_6968b3982706c619fe73f0cf
          confirmed_revision_id: 6992059c-0abd-4d22-bd07-5287e1bf5e6a
          contributed_by: docs-review-agent
          created_at: '2026-01-15T09:30:00Z'
          created_by: agnt_6968b3984d1c238dbe7e2e29
          deprecated_at: '2026-01-17T16:45:00Z'
          deprecated_reason: rollback
          document: &id108
            actions:
            - target: $.paths['/v1/charges'].get
              update:
                summary: List all charges, newest first
            info:
              title: Clarify charges listing
              version: 1.0.0
            overlay: 1.0.0
          id: ovr_6968b398ae1c9a6e2fe6520a
          status: deprecated
          superseded_revision_id: 3f2b8c1e-7d4a-4e9b-a6c5-1d2e3f4a5b6c
          target_revision_id: 3f2b8c1e-7d4a-4e9b-a6c5-1d2e3f4a5b6c
          updated_at: '2026-01-17T16:45:00Z'
        has_more: true
        next_cursor: eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
      properties:
        data:
          description: The page of overlays.
          examples:
          - *id107
          items:
            $ref: '#/components/schemas/OverlayResponse'
          title: Data
          type: array
        has_more:
          description: Whether more results exist after this page.
          examples:
          - true
          title: Has More
          type: boolean
        next_cursor:
          anyOf:
          - type: string
          - type: 'null'
          description: Cursor for the next page; null when there are no more results.
          examples:
          - eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
          title: Next Cursor
      required:
      - data
      - has_more
      title: OverlayListResponse
      type: object
    OverlayResponse:
      description: Full overlay resource response.
      examples:
      - &id206
        _links: *id106
        api_id: debfc9ff-7c37-4a09-801a-575bd4963ddd
        confirmed_at: '2026-01-15T10:05:00Z'
        confirmed_by_execution_id: exec_6968b3982706c619fe73f0cf
        confirmed_revision_id: 6992059c-0abd-4d22-bd07-5287e1bf5e6a
        contributed_by: docs-review-agent
        created_at: '2026-01-15T09:30:00Z'
        created_by: agnt_6968b3984d1c238dbe7e2e29
        deprecated_at: '2026-01-17T16:45:00Z'
        deprecated_reason: rollback
        document: *id108
        id: ovr_6968b398ae1c9a6e2fe6520a
        status: deprecated
        superseded_revision_id: 3f2b8c1e-7d4a-4e9b-a6c5-1d2e3f4a5b6c
        target_revision_id: 3f2b8c1e-7d4a-4e9b-a6c5-1d2e3f4a5b6c
        updated_at: '2026-01-17T16:45:00Z'
      properties:
        _links:
          $ref: '#/components/schemas/OverlayLinksResponse'
          examples:
          - *id106
        api_id:
          description: ID of the API the overlay applies to.
          examples:
          - debfc9ff-7c37-4a09-801a-575bd4963ddd
          title: Api Id
          type: string
        confirmed_at:
          anyOf:
          - format: date-time
            type: string
          - type: 'null'
          description: When the overlay was confirmed (RFC 3339); null if not confirmed.
          examples:
          - '2026-01-15T10:05:00Z'
          title: Confirmed At
        confirmed_by_execution_id:
          anyOf:
          - type: string
          - type: 'null'
          description: ID of the execution supplied when the overlay was confirmed; null if none.
          examples:
          - exec_6968b3982706c619fe73f0cf
          title: Confirmed By Execution Id
        confirmed_revision_id:
          anyOf:
          - type: string
          - type: 'null'
          description: ID of the revision produced by applying the overlay; null until confirmation completes.
          examples:
          - 6992059c-0abd-4d22-bd07-5287e1bf5e6a
          title: Confirmed Revision Id
        contributed_by:
          anyOf:
          - type: string
          - type: 'null'
          description: Free-text attribution label supplied at submission; null if none.
          examples:
          - docs-review-agent
          title: Contributed By
        created_at:
          description: When the overlay was created (RFC 3339).
          examples:
          - '2026-01-15T09:30:00Z'
          format: date-time
          title: Created At
          type: string
        created_by:
          anyOf:
          - type: string
          - type: 'null'
          description: ID of the actor that created the overlay.
          examples:
          - agnt_6968b3984d1c238dbe7e2e29
          title: Created By
        deprecated_at:
          anyOf:
          - format: date-time
            type: string
          - type: 'null'
          description: When the overlay was deprecated (RFC 3339); null if not deprecated.
          examples:
          - '2026-01-17T16:45:00Z'
          title: Deprecated At
        deprecated_reason:
          anyOf:
          - type: string
          - type: 'null'
          description: 'Why the overlay was deprecated: `manual`, `rollback` or `superseded_by_reimport`; null when not deprecated or not recorded.'
          examples:
          - rollback
          title: Deprecated Reason
        document:
          additionalProperties: true
          description: The OpenAPI Overlay document.
          examples:
          - *id108
          title: Document
          type: object
        id:
          description: Unique ID of the overlay.
          examples:
          - ovr_6968b398ae1c9a6e2fe6520a
          title: Id
          type: string
        status:
          description: 'Lifecycle status of the overlay: `pending`, `confirmed` or `deprecated`.'
          examples:
          - deprecated
          title: Status
          type: string
        superseded_revision_id:
          anyOf:
          - type: string
          - type: 'null'
          description: ID of the revision the overlay replaced when applied, restored by a rollback; null if none.
          examples:
          - 3f2b8c1e-7d4a-4e9b-a6c5-1d2e3f4a5b6c
          title: Superseded Revision Id
        target_revision_id:
          anyOf:
          - type: string
          - type: 'null'
          description: ID of the revision the overlay was written against; null if unpinned.
          examples:
          - 3f2b8c1e-7d4a-4e9b-a6c5-1d2e3f4a5b6c
          title: Target Revision Id
        updated_at:
          anyOf:
          - format: date-time
            type: string
          - type: 'null'
          description: When the overlay was last updated (RFC 3339); null if never updated.
          examples:
          - '2026-01-17T16:45:00Z'
          title: Updated At
      required:
      - id
      - api_id
      - status
      - document
      - target_revision_id
      - contributed_by
      - confirmed_by_execution_id
      - created_at
      - updated_at
      - confirmed_at
      - deprecated_at
      - _links
      title: OverlayResponse
      type: object
    OverlaySubmitRequest:
      additionalProperties: false
      description: Payload for submitting a new overlay.
      examples:
      - &id205
        contributed_by: docs-review-agent
        document: &id109
          actions:
          - target: $.paths['/v1/charges'].get
            update:
              summary: List all charges, newest first
          info:
            title: Clarify charges listing
            version: 1.0.0
          overlay: 1.0.0
        target_revision_id: 3f2b8c1e-7d4a-4e9b-a6c5-1d2e3f4a5b6c
      properties:
        contributed_by:
          anyOf:
          - type: string
          - type: 'null'
          description: Free-text attribution label for who contributed the overlay.
          examples:
          - docs-review-agent
          title: Contributed By
        document:
          additionalProperties: true
          description: OpenAPI Overlay document; must be a JSON object with an `actions` array.
          examples:
          - *id109
          title: Document
          type: object
        target_revision_id:
          anyOf:
          - type: string
          - type: 'null'
          description: ID of the revision the overlay was written against; null to leave unpinned.
          examples:
          - 3f2b8c1e-7d4a-4e9b-a6c5-1d2e3f4a5b6c
          title: Target Revision Id
      required:
      - document
      title: OverlaySubmitRequest
      type: object
    OverlayUpdateRequest:
      additionalProperties: false
      description: Payload for updating an existing overlay.
      examples:
      - &id207
        document: &id110
          actions:
          - target: $.paths['/v1/charges'].get
            update:
              summary: List all charges, newest first
          info:
            title: Clarify charges listing
            version: 1.0.0
          overlay: 1.0.0
        target_revision_id: 3f2b8c1e-7d4a-4e9b-a6c5-1d2e3f4a5b6c
      properties:
        document:
          anyOf:
          - additionalProperties: true
            type: object
          - type: 'null'
          description: Replacement OpenAPI Overlay document; omit to keep the current one.
          examples:
          - *id110
          title: Document
        target_revision_id:
          anyOf:
          - type: string
          - type: 'null'
          description: ID of the revision the overlay was written against.
          examples:
          - 3f2b8c1e-7d4a-4e9b-a6c5-1d2e3f4a5b6c
          title: Target Revision Id
      title: OverlayUpdateRequest
      type: object
    OwnOAuthClientConfirmSessionRequest:
      additionalProperties: false
      description: |-
        Resolve an ``awaiting_app`` session with the approver's own OAuth client.

        The client is stored on the session's credential (the same shape as a
        ``direct_oauth2`` credential) and the session continues as an
        authorization-code connect. Both endpoints are required: the API's
        declared OAuth endpoints are never used for the approver's client, since
        the spec may be agent-submitted and the token endpoint receives the
        client secret.
      examples:
      - agent_id: agnt_6968b3984d1c238dbe7e2e29
        authorize_url: https://github.com/login/oauth/authorize
        client_id: Iv1.a1b2c3d4
        client_secret: example-secret
        confirmed_scopes: &id111
        - repo
        - read:user
        digest: 2c26b46b68ffc68ff99b453c1d30413413422d706483bfa0f98a5e886266e7ae
        expected_agent_id: agnt_6968b3984d1c238dbe7e2e29
        kind: own_oauth_client
        permission_rules: &id112
        - effect: allow
          match_mode: prefix
          methods: *id029
          operations: *id030
          path: /v1/charges
        token_url: https://github.com/login/oauth/access_token
      properties:
        agent_id:
          anyOf:
          - type: string
          - type: 'null'
          description: Agent to bind when the session has none; ignored if the session already has one.
          examples:
          - agnt_6968b3984d1c238dbe7e2e29
          title: Agent Id
        authorize_url:
          description: Authorization endpoint URL of the OAuth app.
          examples:
          - https://github.com/login/oauth/authorize
          maxLength: 2048
          minLength: 1
          title: Authorize Url
          type: string
        client_id:
          description: Client ID of the approver's OAuth app.
          examples:
          - Iv1.a1b2c3d4
          maxLength: 255
          minLength: 1
          title: Client Id
          type: string
        client_secret:
          description: Client secret of the approver's OAuth app; write-only.
          examples:
          - example-secret
          format: password
          maxLength: 8192
          minLength: 1
          title: Client Secret
          type: string
          writeOnly: true
          x-sensitive: true
        confirmed_scopes:
          description: Upstream scopes to request (at most 100).
          examples:
          - *id111
          items:
            type: string
          maxItems: 100
          title: Confirmed Scopes
          type: array
        digest:
          description: Review digest echoed from the review data; a mismatch is 409 review_stale.
          examples:
          - 2c26b46b68ffc68ff99b453c1d30413413422d706483bfa0f98a5e886266e7ae
          maxLength: 64
          minLength: 1
          title: Digest
          type: string
        expected_agent_id:
          anyOf:
          - type: string
          - type: 'null'
          description: Agent ID from the review the approver saw; a mismatch is 409 review_stale.
          examples:
          - agnt_6968b3984d1c238dbe7e2e29
          title: Expected Agent Id
        kind:
          const: own_oauth_client
          description: Confirm variant; always `own_oauth_client`.
          examples:
          - own_oauth_client
          title: Kind
          type: string
        permission_rules:
          description: Permission rules to bind for the agent (at most 100).
          examples:
          - *id112
          items:
            $ref: '#/components/schemas/PermissionRuleSchema'
          maxItems: 100
          title: Permission Rules
          type: array
        token_url:
          description: Token endpoint URL of the OAuth app.
          examples:
          - https://github.com/login/oauth/access_token
          maxLength: 2048
          minLength: 1
          title: Token Url
          type: string
      required:
      - permission_rules
      - digest
      - kind
      - client_id
      - client_secret
      - authorize_url
      - token_url
      title: OwnOAuthClientConfirmSessionRequest
      type: object
    PermissionListResponse:
      description: List of available permissions.
      examples:
      - &id269
        data: &id113
        - description: Create, update, and disable users
          grantable_by_caller: true
          implies: &id114
          - users:read
          name: users:write
      properties:
        data:
          description: The permissions in the catalogue.
          examples:
          - *id113
          items:
            $ref: '#/components/schemas/PermissionResponse'
          title: Data
          type: array
      required:
      - data
      title: PermissionListResponse
      type: object
    PermissionResponse:
      description: A single permission entry from the catalogue.
      examples:
      - description: Create, update, and disable users
        grantable_by_caller: true
        implies: *id114
        name: users:write
      properties:
        description:
          description: Human-readable description of what the permission allows.
          examples:
          - Create, update, and disable users
          title: Description
          type: string
        grantable_by_caller:
          description: Whether the caller may grant this scope to an agent. `org:admin` callers may grant any scope; anyone else only scopes they hold or the default agent scopes, and never `org:admin` or `agents:write`.
          examples:
          - true
          title: Grantable By Caller
          type: boolean
        implies:
          description: Permissions this one implies when granted.
          examples:
          - *id114
          items:
            type: string
          title: Implies
          type: array
        name:
          description: Permission name, e.g. `users:read`.
          examples:
          - users:write
          title: Name
          type: string
      required:
      - name
      - description
      - implies
      - grantable_by_caller
      title: PermissionResponse
      type: object
    PermissionRuleListResponse:
      description: List of permission rules.
      examples:
      - &id225
        data: &id115
        - _comment: Read-only access to charges.
          _system: false
          effect: allow
          match_mode: prefix
          methods: &id116
          - GET
          operations: &id117
          - listCharges
          path: /v1/charges
      properties:
        data:
          description: The binding's permission rules, in evaluation order.
          examples:
          - *id115
          items:
            $ref: '#/components/schemas/PermissionRuleReadSchema'
          title: Data
          type: array
      required:
      - data
      title: PermissionRuleListResponse
      type: object
    PermissionRuleReadSchema:
      description: Permission rule response (includes system fields).
      examples:
      - &id140
        _comment: Read-only access to charges.
        _system: false
        effect: allow
        match_mode: prefix
        methods: *id116
        operations: *id117
        path: /v1/charges
      properties:
        _comment:
          anyOf:
          - type: string
          - type: 'null'
          description: Optional note attached to the rule.
          examples:
          - Read-only access to charges.
          title: Comment
        _system:
          default: false
          description: True when the rule is platform-managed rather than user-authored.
          examples:
          - false
          title: System
          type: boolean
        effect:
          description: Whether this rule allows or denies the matched request.
          enum:
          - allow
          - deny
          examples:
          - allow
          title: Effect
          type: string
        match_mode:
          default: regex
          description: 'How `path` is interpreted: `regex` (full-match), `prefix` or `exact`.'
          enum:
          - regex
          - prefix
          - exact
          examples:
          - prefix
          title: Match Mode
          type: string
        methods:
          anyOf:
          - items:
              type: string
            type: array
          - type: 'null'
          description: HTTP methods the rule matches; null matches all.
          examples:
          - *id116
          title: Methods
        operations:
          anyOf:
          - items:
              type: string
            type: array
          - type: 'null'
          description: OpenAPI operation IDs the rule matches; null matches all.
          examples:
          - *id117
          title: Operations
        path:
          anyOf:
          - type: string
          - type: 'null'
          description: Path pattern relative to the API's server URL, interpreted per `match_mode`; null matches all paths.
          examples:
          - /v1/charges
          title: Path
      required:
      - effect
      title: PermissionRuleReadSchema
      type: object
    PermissionRuleSchema:
      additionalProperties: false
      description: |-
        Permission rule for an agent↔credential binding.

        Rules are evaluated first-match-wins. If no rule matches, the request is
        denied (default-deny). A binding with zero rules therefore blocks all
        operations — users must explicitly add at least one allow rule.
      examples:
      - &id121
        effect: allow
        match_mode: prefix
        methods: *id029
        operations: *id030
        path: /v1/charges
      properties:
        effect:
          description: Whether this rule allows or denies the matched request.
          enum:
          - allow
          - deny
          examples:
          - allow
          title: Effect
          type: string
        match_mode:
          default: regex
          description: 'How `path` is interpreted: `regex` (full-match), `prefix` (string prefix), or `exact` (equality). Defaults to `regex` for backwards compatibility.'
          enum:
          - regex
          - prefix
          - exact
          examples:
          - prefix
          title: Match Mode
          type: string
        methods:
          anyOf:
          - items:
              type: string
            type: array
          - type: 'null'
          description: HTTP methods to match (case-insensitive). None matches all.
          examples:
          - *id029
          title: Methods
        operations:
          anyOf:
          - items:
              type: string
            type: array
          - type: 'null'
          description: OpenAPI operation IDs to match. None matches all operations.
          examples:
          - *id030
          title: Operations
        path:
          anyOf:
          - type: string
          - type: 'null'
          description: 'Path pattern to match, relative to the API''s server URL — the spec''s path (`/widgets`), never the full upstream path with the server''s base path (`/eu/widgets` for a server `https://host/{region}`). Interpreted per `match_mode`: `regex` uses full-match semantics (the pattern must describe the whole path); `prefix` and `exact` are literal. None matches all paths.'
          examples:
          - /v1/charges
          title: Path
      required:
      - effect
      title: PermissionRuleSchema
      type: object
    PermissionTestRequest:
      additionalProperties: false
      description: Request body for :test — dry-run a request shape against the binding's rules.
      examples:
      - &id227
        method: GET
        operation_id: listCharges
        path: /v1/charges
      properties:
        method:
          description: HTTP method of the hypothetical request (case-insensitive).
          examples:
          - GET
          title: Method
          type: string
        operation_id:
          anyOf:
          - type: string
          - type: 'null'
          description: Optional OpenAPI operation id resolved from the request URL.
          examples:
          - listCharges
          title: Operation Id
        path:
          description: Path of the hypothetical request relative to the API's server URL (the spec's path, e.g. `/widgets/42`) — the path the broker evaluates rules on.
          examples:
          - /v1/charges
          title: Path
          type: string
      required:
      - method
      - path
      title: PermissionTestRequest
      type: object
    PermissionTestResponse:
      description: Dry-run result matching :class:`PermissionTestResult`.
      examples:
      - &id228
        allowed: true
        credential_id: cred_6968b39855d91a3561684b32
        effect: allow
        is_system: false
        matched: true
        rule_index: 0
      properties:
        allowed:
          description: Whether the broker would allow this request under the binding's rules.
          examples:
          - true
          title: Allowed
          type: boolean
        credential_id:
          anyOf:
          - type: string
          - type: 'null'
          description: The binding whose rule list contributed the matching rule.
          examples:
          - cred_6968b39855d91a3561684b32
          title: Credential Id
        effect:
          anyOf:
          - type: string
          - type: 'null'
          description: Effect of the matching rule (`allow`/`deny`); null when no match.
          examples:
          - allow
          title: Effect
        is_system:
          anyOf:
          - type: boolean
          - type: 'null'
          description: True when the matching rule was written by the system; null when no match.
          examples:
          - false
          title: Is System
        matched:
          description: Whether any rule matched; when false, the outcome is default-deny.
          examples:
          - true
          title: Matched
          type: boolean
        rule_index:
          anyOf:
          - type: integer
          - type: 'null'
          description: Zero-based index in the binding's ordered rule list; null when no match.
          examples:
          - 0
          title: Rule Index
      required:
      - allowed
      - matched
      title: PermissionTestResponse
      type: object
    Permissions:
      description: 'Structured permissions view: assigned + effective.'
      examples:
      - &id160
        assigned: &id119
        - users:write
        - agents:read
        effective: &id120
        - *id118
      properties:
        assigned:
          description: Permissions assigned directly to the user.
          examples:
          - *id119
          items:
            type: string
          title: Assigned
          type: array
        effective:
          description: All permissions the user holds, including those implied by assigned ones.
          examples:
          - *id120
          items:
            $ref: '#/components/schemas/EffectivePermission'
          title: Effective
          type: array
      required:
      - assigned
      - effective
      title: Permissions
      type: object
    PermissionsPatchRequest:
      description: Patch permission rules — add and/or remove.
      examples:
      - &id226
        add: &id122
        - *id121
        remove: &id123
        - 0
        - 2
      properties:
        add:
          anyOf:
          - items:
              $ref: '#/components/schemas/PermissionRuleSchema'
            type: array
          - type: 'null'
          description: Rules to append after the existing user rules.
          examples:
          - *id122
          title: Add
        remove:
          anyOf:
          - items:
              type: integer
            type: array
          - type: 'null'
          description: Zero-based indexes of user rules (excluding system rules) to delete; applied before `add`.
          examples:
          - *id123
          title: Remove
      title: PermissionsPatchRequest
      type: object
    PreviewInfoResponse:
      description: The `info` block fields surfaced in a preview.
      examples:
      - *id124
      properties:
        description:
          anyOf:
          - type: string
          - type: 'null'
          description: Spec description.
          examples:
          - Payments.
          title: Description
        title:
          anyOf:
          - type: string
          - type: 'null'
          description: Spec title.
          examples:
          - Stripe
          title: Title
        version:
          anyOf:
          - type: string
          - type: 'null'
          description: Spec version.
          examples:
          - '2024-04-10'
          title: Version
      required:
      - title
      - version
      - description
      title: PreviewInfoResponse
      type: object
    PreviewOperationResponse:
      description: A slimmed operation in a catalog spec preview.
      examples:
      - *id125
      properties:
        description:
          description: Operation description (empty string when absent).
          examples:
          - Returns a list of charges you've previously created, newest first.
          title: Description
          type: string
        method:
          description: Upper-case HTTP method.
          examples:
          - GET
          title: Method
          type: string
        operation_id:
          anyOf:
          - type: string
          - type: 'null'
          description: OpenAPI operationId, when declared.
          examples:
          - listCharges
          title: Operation Id
        parameters:
          description: Merged path- and operation-level parameters.
          examples:
          - - &id126
              description: Page size.
              in: query
              name: limit
              required: false
          items:
            $ref: '#/components/schemas/PreviewParameterResponse'
          title: Parameters
          type: array
        path:
          description: Operation path template.
          examples:
          - /v1/charges
          title: Path
          type: string
        security:
          description: Flattened names of the security schemes that apply.
          examples:
          - - BearerAuth
          items:
            type: string
          title: Security
          type: array
        summary:
          description: Operation summary (empty string when absent).
          examples:
          - List charges
          title: Summary
          type: string
        tags:
          description: Operation tags.
          examples:
          - - charges
          items:
            type: string
          title: Tags
          type: array
      required:
      - method
      - path
      - summary
      - description
      - operation_id
      - parameters
      - security
      - tags
      title: PreviewOperationResponse
      type: object
    PreviewParameterResponse:
      description: A slimmed parameter in an operation preview.
      example: *id126
      properties:
        description:
          description: Parameter description (empty string when absent).
          examples:
          - Page size.
          title: Description
          type: string
        in:
          description: OpenAPI parameter location.
          examples:
          - query
          title: In
          type: string
        name:
          description: Parameter name.
          examples:
          - limit
          title: Name
          type: string
        required:
          description: Whether the parameter is required.
          examples:
          - false
          title: Required
          type: boolean
      required:
      - name
      - in
      - required
      - description
      title: PreviewParameterResponse
      type: object
    ProblemDetail:
      description: |-
        RFC 9457 Problem Details for HTTP APIs.

        This is the standard error response format for all Jentic APIs.
        Content-Type: application/problem+json

        See: https://www.rfc-editor.org/rfc/rfc9457.html
      examples:
      - detail: The request body is missing one or more required fields.
        errors:
        - detail: Field 'name' is required.
          pointer: '#/name'
        instance: /v2/capability-sets
        status: 400
        title: Bad Request
        type: about:blank
      properties:
        code:
          anyOf:
          - maxLength: 50
            type: string
          - type: 'null'
          description: An optional provider-specific code for internal error taxonomy and observability correlation.
          examples:
          - JENTIC-4001
          title: Code
        detail:
          description: A human-readable explanation specific to this occurrence of the problem. MUST be present. Provide actionable information where possible.
          examples:
          - The request body is missing required field 'name'.
          maxLength: 4096
          title: Detail
          type: string
        errors:
          anyOf:
          - items:
              $ref: '#/components/schemas/ErrorItem'
            maxItems: 1000
            type: array
          - type: 'null'
          description: An array of granular error details. Use when multiple validation errors or field-level problems need to be surfaced in a single response.
          examples:
          - - *id127
          title: Errors
        instance:
          anyOf:
          - maxLength: 1024
            type: string
          - type: 'null'
          description: A URI reference identifying the specific occurrence of the problem. Typically the request path.
          examples:
          - /v2/capability-sets
          title: Instance
        status:
          anyOf:
          - maximum: 599.0
            minimum: 100.0
            type: integer
          - type: 'null'
          description: The HTTP status code for this occurrence of the problem.
          examples:
          - 400
          title: Status
        title:
          anyOf:
          - maxLength: 1024
            type: string
          - type: 'null'
          description: A short, human-readable summary of the problem type. Should not change between occurrences except for localisation purposes.
          examples:
          - Bad Request
          title: Title
        type:
          default: about:blank
          description: A URI reference identifying the problem type. When set to 'about:blank', the title SHOULD be the standard HTTP status phrase. Use an IANA-registered type URI where one applies.
          examples:
          - about:blank
          maxLength: 1024
          title: Type
          type: string
      required:
      - detail
      title: ProblemDetail
      type: object
    ProviderConfigListResponse:
      description: A list of stored provider configs (secrets redacted).
      examples:
      - &id174
        data: &id128
        - &id129
          config:
            client_id: client_abc123
            client_secret: '***'
            environment: production
            kind: pipedream
            project_id: proj_abc123
          created_at: '2026-06-29T12:00:00Z'
          name: pipedream
          updated_at: '2026-06-29T12:00:00Z'
      properties:
        data:
          description: The stored provider configs.
          examples:
          - *id128
          items:
            $ref: '#/components/schemas/ProviderConfigResponse'
          title: Data
          type: array
      required:
      - data
      title: ProviderConfigListResponse
      type: object
    ProviderConfigResponse:
      description: A stored provider config with secret fields redacted.
      examples:
      - *id129
      properties:
        config:
          additionalProperties: true
          description: Stored config with secret fields redacted.
          examples:
          - client_id: client_abc123
            client_secret: '***'
            environment: production
            kind: pipedream
            project_id: proj_abc123
          title: Config
          type: object
        created_at:
          description: When the provider config was created (RFC 3339).
          examples:
          - '2026-01-15T09:30:00Z'
          format: date-time
          title: Created At
          type: string
        name:
          description: Provider name (e.g. 'pipedream').
          examples:
          - pipedream
          title: Name
          type: string
        updated_at:
          anyOf:
          - format: date-time
            type: string
          - type: 'null'
          description: When the provider config was last updated (RFC 3339); null if never updated.
          examples:
          - '2026-01-20T14:05:00Z'
          title: Updated At
      required:
      - name
      - config
      - created_at
      title: ProviderConfigResponse
      type: object
    ProviderConfigSetRequest:
      description: |-
        Request body for setting a provider config.

        Fields are provider-specific and validated server-side by provider name.
        For ``pipedream`` the recognised fields are ``project_id``, ``client_id``,
        ``client_secret`` (write-only), and optional ``environment``,
        ``connect_base_url``, ``expiry_skew_seconds``.
      examples:
      - &id175
        config:
          client_id: client_abc123
          client_secret: <redacted>
          environment: production
          project_id: proj_abc123
      properties:
        config:
          additionalProperties: true
          description: Provider-specific configuration fields, validated by provider name.
          examples:
          - client_id: client_abc123
            client_secret: example-secret
            environment: production
            project_id: proj_abc123
          title: Config
          type: object
      required:
      - config
      title: ProviderConfigSetRequest
      type: object
    ProviderDiscoveryEntryResponse:
      description: Discovery metadata for a single credential provider.
      examples:
      - &id131
        callback_url: https://jentic.example.com/api/v1/credentials/oauth/callback
        configured: true
        id: pipedream
        label: Pipedream
        managed: true
        types: &id130
        - oauth2
        - api_key
      properties:
        callback_url:
          anyOf:
          - type: string
          - type: 'null'
          description: OAuth2 redirect URI for providers that require it. When no explicit redirect_uri is configured, this is derived from the deployment's public origin (server.public_base_url or the request origin), so it reflects the exact callback the connect flow will register with the IdP. Add this URL to your OAuth app's allowed redirect URIs.
          examples:
          - https://jentic.example.com/api/v1/credentials/oauth/callback
          title: Callback Url
        configured:
          description: Whether the provider is fully configured and operational.
          examples:
          - true
          title: Configured
          type: boolean
        id:
          description: Provider identifier (registry key).
          examples:
          - pipedream
          title: Id
          type: string
        label:
          description: Human-readable provider name.
          examples:
          - Pipedream
          title: Label
          type: string
        managed:
          description: Whether the provider handles vendor sign-in on behalf of the user.
          examples:
          - true
          title: Managed
          type: boolean
        types:
          description: Wire-level credential types this provider supports.
          examples:
          - *id130
          items:
            $ref: '#/components/schemas/CredentialType'
          title: Types
          type: array
      required:
      - id
      - label
      - managed
      - types
      - configured
      title: ProviderDiscoveryEntryResponse
      type: object
    ProviderDiscoveryResponse:
      description: Discovery response listing all available credential providers.
      examples:
      - &id223
        providers: &id132
        - *id131
      properties:
        providers:
          description: The available credential providers.
          examples:
          - *id132
          items:
            $ref: '#/components/schemas/ProviderDiscoveryEntryResponse'
          title: Providers
          type: array
      required:
      - providers
      title: ProviderDiscoveryResponse
      type: object
    ReauthorizeConfirmSessionRequest:
      additionalProperties: false
      description: |-
        Bind the approver's OAuth credential and re-consent it with the requested scopes.

        Refused when another agent is bound to the credential.
      examples:
      - agent_id: agnt_6968b3984d1c238dbe7e2e29
        credential_id: cred_6968b39855d91a3561684b32
        digest: 2c26b46b68ffc68ff99b453c1d30413413422d706483bfa0f98a5e886266e7ae
        expected_agent_id: agnt_6968b3984d1c238dbe7e2e29
        kind: reauthorize
        permission_rules: &id133
        - *id121
      properties:
        agent_id:
          anyOf:
          - type: string
          - type: 'null'
          description: Agent to bind when the session has none; ignored if the session already has one.
          examples:
          - agnt_6968b3984d1c238dbe7e2e29
          title: Agent Id
        credential_id:
          description: ID of the approver's OAuth credential to bind and re-consent.
          examples:
          - cred_6968b39855d91a3561684b32
          maxLength: 30
          minLength: 1
          title: Credential Id
          type: string
        digest:
          description: Review digest echoed from the review data; a mismatch is 409 review_stale.
          examples:
          - 2c26b46b68ffc68ff99b453c1d30413413422d706483bfa0f98a5e886266e7ae
          maxLength: 64
          minLength: 1
          title: Digest
          type: string
        expected_agent_id:
          anyOf:
          - type: string
          - type: 'null'
          description: Agent ID from the review the approver saw; a mismatch is 409 review_stale.
          examples:
          - agnt_6968b3984d1c238dbe7e2e29
          title: Expected Agent Id
        kind:
          const: reauthorize
          description: Confirm variant; always `reauthorize`.
          examples:
          - reauthorize
          title: Kind
          type: string
        permission_rules:
          description: Permission rules to bind for the agent (at most 100).
          examples:
          - *id133
          items:
            $ref: '#/components/schemas/PermissionRuleSchema'
          maxItems: 100
          title: Permission Rules
          type: array
      required:
      - permission_rules
      - digest
      - kind
      - credential_id
      title: ReauthorizeConfirmSessionRequest
      type: object
    RedeemInviteRequest:
      description: Payload for redeeming an invite token.
      examples:
      - &id286
        invite_token: dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk
        password: example-password
      properties:
        invite_token:
          description: The invite token issued when the user was created or re-invited.
          examples:
          - dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk
          maxLength: 512
          minLength: 1
          title: Invite Token
          type: string
          x-sensitive: true
        password:
          description: Password to set for the invited user.
          examples:
          - example-password
          maxLength: 128
          minLength: 12
          title: Password
          type: string
          x-sensitive: true
      required:
      - invite_token
      - password
      title: RedeemInviteRequest
      type: object
    RegisterRequest:
      description: POST /register request body.
      examples:
      - &id270
        client_name: invoice-reconciler
        grant_types: &id134
        - urn:ietf:params:oauth:grant-type:jwt-bearer
        jwks: &id135
          keys:
          - crv: Ed25519
            kid: agent-key-1
            kty: OKP
            x: 11qYAYKxCrfVS_7TyWQHOg7hcvPapiMlrwIaaPcHURo
        scope: apis:read capabilities:execute
        token_endpoint_auth_method: private_key_jwt
      properties:
        client_name:
          description: Name for the new agent.
          examples:
          - invoice-reconciler
          maxLength: 255
          minLength: 1
          title: Client Name
          type: string
        grant_types:
          anyOf:
          - items:
              type: string
            type: array
          - type: 'null'
          description: Accepted for RFC 7591 compatibility and ignored; the agent uses the JWT-bearer grant.
          examples:
          - *id134
          title: Grant Types
        jwks:
          additionalProperties: true
          description: A JSON Web Key Set containing at least one Ed25519 public key (kty=OKP, crv=Ed25519). RSA and other key types are not accepted.
          example: *id135
          title: Jwks
          type: object
        scope:
          anyOf:
          - maxLength: 6500
            type: string
          - type: 'null'
          description: Space-separated permissions requested for the agent (at most 100 tokens).
          examples:
          - apis:read capabilities:execute
          title: Scope
        token_endpoint_auth_method:
          anyOf:
          - type: string
          - type: 'null'
          description: Accepted for RFC 7591 compatibility and ignored; the agent uses `private_key_jwt`.
          examples:
          - private_key_jwt
          title: Token Endpoint Auth Method
      required:
      - client_name
      - jwks
      title: RegisterRequest
      type: object
    RegisterResponse:
      description: POST /register 201 response.
      examples:
      - &id271
        claim_token: dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk
        client_id: agnt_6968b3984d1c238dbe7e2e29
        grant_types: &id136
        - urn:ietf:params:oauth:grant-type:jwt-bearer
        registration_access_token: rat_example-secret
        registration_client_uri: https://jentic.example.com/register/agnt_6968b3984d1c238dbe7e2e29
        status: pending
        token_endpoint_auth_method: private_key_jwt
      properties:
        claim_token:
          anyOf:
          - type: string
          - type: 'null'
          description: Single-use token a human presents to `POST /agents/{agent_id}:claim` to take ownership; omitted when the deployment does not issue claim tokens.
          examples:
          - dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk
          title: Claim Token
          x-sensitive: true
        client_id:
          description: ID of the new agent, used as its OAuth client_id.
          examples:
          - agnt_6968b3984d1c238dbe7e2e29
          title: Client Id
          type: string
        grant_types:
          default:
          - urn:ietf:params:oauth:grant-type:jwt-bearer
          description: Grant types the agent may use; always the JWT-bearer grant.
          examples:
          - *id136
          items:
            type: string
          title: Grant Types
          type: array
        registration_access_token:
          description: Bearer token for polling `registration_client_uri`; shown once and expires after a configured time.
          examples:
          - rat_example-secret
          title: Registration Access Token
          type: string
          x-sensitive: true
        registration_client_uri:
          description: URL to poll for the registration status.
          examples:
          - https://jentic.example.com/register/agnt_6968b3984d1c238dbe7e2e29
          title: Registration Client Uri
          type: string
        status:
          description: Lifecycle status of the new agent; `pending` until an operator approves it.
          examples:
          - pending
          title: Status
          type: string
        token_endpoint_auth_method:
          default: private_key_jwt
          description: How the agent authenticates at the token endpoint; always `private_key_jwt`.
          examples:
          - private_key_jwt
          title: Token Endpoint Auth Method
          type: string
      required:
      - client_id
      - registration_access_token
      - registration_client_uri
      - status
      title: RegisterResponse
      type: object
    RegistrationStatusResponse:
      description: GET /register/{agent_id} response.
      examples:
      - &id272
        client_id: agnt_6968b3984d1c238dbe7e2e29
        grant_types: &id137
        - urn:ietf:params:oauth:grant-type:jwt-bearer
        status: active
        token_endpoint_auth_method: private_key_jwt
      properties:
        client_id:
          description: ID of the agent, used as its OAuth client_id.
          examples:
          - agnt_6968b3984d1c238dbe7e2e29
          title: Client Id
          type: string
        grant_types:
          default:
          - urn:ietf:params:oauth:grant-type:jwt-bearer
          description: Grant types the agent may use; always the JWT-bearer grant.
          examples:
          - *id137
          items:
            type: string
          title: Grant Types
          type: array
        status:
          description: 'Lifecycle status of the agent: `pending`, `active`, `rejected`, `disabled` or `archived`.'
          examples:
          - active
          title: Status
          type: string
        token_endpoint_auth_method:
          default: private_key_jwt
          description: How the agent authenticates at the token endpoint; always `private_key_jwt`.
          examples:
          - private_key_jwt
          title: Token Endpoint Auth Method
          type: string
      required:
      - client_id
      - status
      title: RegistrationStatusResponse
      type: object
    RevokeRequest:
      description: |-
        Revocation endpoint request (RFC 7009) — JSON or form-encoded.

        ``token`` is required either way. ``token_type_hint``
        (``access_token``/``refresh_token``) is a lookup-order optimization only —
        the server falls through both types regardless (RFC 7009 §2.1).
        ``client_id`` belongs to the form-encoded public-client arm (G11): the
        secret-less client's lineage binding; ignored on the bearer-authenticated
        JSON arm, where the platform identity scopes the revocation instead.
      examples:
      - &id263
        client_id: oc_Xk3vQ9mT2pLw8RzN5bYc1HdF7gJs4AeU
        token: rt_example-refresh-token
        token_type_hint: refresh_token
      properties:
        client_id:
          anyOf:
          - type: string
          - type: 'null'
          description: Public client's client_id, used on form-encoded requests; ignored on bearer-authenticated JSON requests.
          examples:
          - oc_Xk3vQ9mT2pLw8RzN5bYc1HdF7gJs4AeU
          title: Client Id
        token:
          description: The token to revoke.
          examples:
          - rt_example-refresh-token
          title: Token
          type: string
          x-sensitive: true
        token_type_hint:
          anyOf:
          - type: string
          - type: 'null'
          description: Optional hint, `access_token` or `refresh_token`; both types are checked regardless.
          examples:
          - refresh_token
          title: Token Type Hint
      required:
      - token
      title: RevokeRequest
      type: object
    RootHealthResponse:
      description: Liveness body of the canonical root ``GET /health`` probe.
      examples:
      - &id241
        status: ok
        version: 1.0.0
      properties:
        reason:
          anyOf:
          - type: string
          - type: 'null'
          description: Why the deployment is not entitled. Present only on the `not_entitled` body.
          examples:
          - AWS Marketplace subscription is not active for this deployment; renew the subscription to restore service
          title: Reason
        status:
          description: '`ok` while the process is serving requests. A metered marketplace deployment whose entitlement lapsed answers `not_entitled` (still HTTP 200, so orchestrators don''t restart it).'
          examples:
          - ok
          title: Status
          type: string
        version:
          anyOf:
          - type: string
          - type: 'null'
          description: Running Jentic One release. Absent on the `not_entitled` body.
          examples:
          - 1.0.0
          title: Version
      required:
      - status
      title: RootHealthResponse
      type: object
    RouteNotFoundResponse:
      description: |-
        The framework's plain route-not-found body.

        Config-gated routes answer this exact body when their gate is closed, so the
        gate state is indistinguishable from a route that does not exist.
      examples:
      - detail: Not Found
      properties:
        detail:
          description: Always `Not Found`.
          examples:
          - Not Found
          title: Detail
          type: string
      required:
      - detail
      title: RouteNotFoundResponse
      type: object
    RuleSetAttachRequest:
      description: Point a direct agent↔credential binding at a shared rule set.
      examples:
      - &id229
        rule_set_id: prs_6968b3987c22b63e87e79f05
      properties:
        rule_set_id:
          description: Id (`prs_…`) of the rule set to attach.
          examples:
          - prs_6968b3987c22b63e87e79f05
          title: Rule Set Id
          type: string
      required:
      - rule_set_id
      title: RuleSetAttachRequest
      type: object
    RuleSetCreateRequest:
      description: Create a shared permission rule set (theme 5 phase 1, Q-04).
      examples:
      - &id266
        description: Allows GET requests to the Stripe API; denies everything else.
        name: Stripe read-only
        rules: &id138
        - *id121
      properties:
        description:
          anyOf:
          - maxLength: 1000
            type: string
          - type: 'null'
          description: Optional free-text description of the set.
          examples:
          - Allows GET requests to the Stripe API; denies everything else.
          title: Description
        name:
          description: Unique human-readable name.
          examples:
          - Stripe read-only
          maxLength: 255
          title: Name
          type: string
        rules:
          description: Initial ordered rule list (first-match-wins, default-deny).
          examples:
          - *id138
          items:
            $ref: '#/components/schemas/PermissionRuleSchema'
          maxItems: 100
          title: Rules
          type: array
      required:
      - name
      title: RuleSetCreateRequest
      type: object
    RuleSetListResponse:
      description: Paginated list of rule sets.
      examples:
      - &id265
        data: &id139
        - created_at: '2026-01-15T09:30:00Z'
          created_by: usr_6968b3987ee4c3ec0b4ee3b9
          curated: true
          description: Allows GET requests to the Stripe API; denies everything else.
          name: Stripe read-only
          rule_count: 2
          rule_set_id: prs_6968b3987c22b63e87e79f05
        has_more: true
        next_cursor: eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
      properties:
        data:
          description: The page of rule sets.
          examples:
          - *id139
          items:
            $ref: '#/components/schemas/RuleSetSummaryResponse'
          title: Data
          type: array
        has_more:
          description: Whether more results exist after this page.
          examples:
          - true
          title: Has More
          type: boolean
        next_cursor:
          anyOf:
          - type: string
          - type: 'null'
          description: Cursor for the next page; null when there are no more results.
          examples:
          - eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
          title: Next Cursor
      required:
      - data
      - has_more
      title: RuleSetListResponse
      type: object
    RuleSetResponse:
      description: Rule set detail — the ordered rules plus its referencing-binding count.
      examples:
      - &id267
        binding_count: 3
        created_at: '2026-01-15T09:30:00Z'
        created_by: usr_6968b3987ee4c3ec0b4ee3b9
        curated: true
        description: Allows GET requests to the Stripe API; denies everything else.
        name: Stripe read-only
        rule_set_id: prs_6968b3987c22b63e87e79f05
        rules: &id141
        - *id140
      properties:
        binding_count:
          description: How many agent-credential bindings currently point at this set.
          examples:
          - 3
          title: Binding Count
          type: integer
        created_at:
          description: When the rule set was created (RFC 3339).
          examples:
          - '2026-01-15T09:30:00Z'
          format: date-time
          title: Created At
          type: string
        created_by:
          anyOf:
          - type: string
          - type: 'null'
          description: ID of the actor that created the rule set.
          examples:
          - usr_6968b3987ee4c3ec0b4ee3b9
          title: Created By
        curated:
          description: True when an org admin created the set. A curated set can be attached by any caller allowed to write a binding's rules and edited only by an org admin; any other set is attachable and editable by its creator or an org admin.
          examples:
          - true
          title: Curated
          type: boolean
        description:
          anyOf:
          - type: string
          - type: 'null'
          description: Free-text description of the rule set; null if unset.
          examples:
          - Allows GET requests to the Stripe API; denies everything else.
          title: Description
        name:
          description: Unique human-readable name of the rule set.
          examples:
          - Stripe read-only
          title: Name
          type: string
        rule_set_id:
          description: Unique ID of the rule set (`prs_…`).
          examples:
          - prs_6968b3987c22b63e87e79f05
          title: Rule Set Id
          type: string
        rules:
          description: Ordered rule list (first-match-wins, default-deny).
          examples:
          - *id141
          items:
            $ref: '#/components/schemas/PermissionRuleReadSchema'
          title: Rules
          type: array
      required:
      - rule_set_id
      - name
      - rules
      - binding_count
      - curated
      - created_at
      title: RuleSetResponse
      type: object
    RuleSetSummaryResponse:
      description: Rule set list entry.
      examples:
      - created_at: '2026-01-15T09:30:00Z'
        created_by: usr_6968b3987ee4c3ec0b4ee3b9
        curated: true
        description: Allows GET requests to the Stripe API; denies everything else.
        name: Stripe read-only
        rule_count: 2
        rule_set_id: prs_6968b3987c22b63e87e79f05
      properties:
        created_at:
          description: When the rule set was created (RFC 3339).
          examples:
          - '2026-01-15T09:30:00Z'
          format: date-time
          title: Created At
          type: string
        created_by:
          anyOf:
          - type: string
          - type: 'null'
          description: ID of the actor that created the rule set.
          examples:
          - usr_6968b3987ee4c3ec0b4ee3b9
          title: Created By
        curated:
          description: True when an org admin created the set. A curated set can be attached by any caller allowed to write a binding's rules and edited only by an org admin; any other set is attachable and editable by its creator or an org admin.
          examples:
          - true
          title: Curated
          type: boolean
        description:
          anyOf:
          - type: string
          - type: 'null'
          description: Free-text description of the rule set; null if unset.
          examples:
          - Allows GET requests to the Stripe API; denies everything else.
          title: Description
        name:
          description: Unique human-readable name of the rule set.
          examples:
          - Stripe read-only
          title: Name
          type: string
        rule_count:
          description: Number of rules in the set.
          examples:
          - 2
          title: Rule Count
          type: integer
        rule_set_id:
          description: Unique ID of the rule set (`prs_…`).
          examples:
          - prs_6968b3987c22b63e87e79f05
          title: Rule Set Id
          type: string
      required:
      - rule_set_id
      - name
      - rule_count
      - curated
      - created_at
      title: RuleSetSummaryResponse
      type: object
    RuleSetUpdateRequest:
      description: Rename or re-describe a rule set.
      examples:
      - &id268
        description: Allows GET requests to the Stripe API; denies everything else.
        name: Stripe read-only
      properties:
        description:
          anyOf:
          - maxLength: 1000
            type: string
          - type: 'null'
          description: New description; omit to leave unchanged.
          examples:
          - Allows GET requests to the Stripe API; denies everything else.
          title: Description
        name:
          anyOf:
          - maxLength: 255
            type: string
          - type: 'null'
          description: New unique name; omit to leave unchanged.
          examples:
          - Stripe read-only
          title: Name
      title: RuleSetUpdateRequest
      type: object
    RuntimeConfig:
      description: Optional per-upstream-call overrides.
      examples:
      - &id151
        headers: *id013
        query_params: *id014
      properties:
        headers:
          anyOf:
          - additionalProperties:
              type: string
            type: object
          - type: 'null'
          description: Header overrides for upstream calls.
          examples:
          - *id013
          title: Headers
        query_params:
          anyOf:
          - additionalProperties:
              type: string
            type: object
          - type: 'null'
          description: Query-parameter overrides for upstream calls.
          examples:
          - *id014
          title: Query Params
      title: RuntimeConfig
      type: object
    SearchLinksResponse:
      description: Hypermedia links for a search result row.
      examples:
      - inspect: https://jentic.example.com/inspect?id=GET%20https%3A%2F%2Fapi.stripe.com%2Fv1%2Fcharges
      properties:
        inspect:
          description: URL of the operation's full detail via `GET /inspect`.
          examples:
          - https://jentic.example.com/inspect?id=GET%20https%3A%2F%2Fapi.stripe.com%2Fv1%2Fcharges
          title: Inspect
          type: string
      required:
      - inspect
      title: SearchLinksResponse
      type: object
    SearchRequest:
      additionalProperties: false
      description: POST /search request body.
      examples:
      - &id273
        apis: &id142
        - stripe.com/stripe
        cursor: eyJkIjogMC4yODE2LCAiaWQiOiAib3BfZjkyZDY5ZjE2MjFmMzgxYmNlOGFhZmY0NzA1M2M2MWIwNjlmZmUzNCJ9
        limit: 10
        query: list recent charges
        revision_pins: &id143
          stripe.com/stripe/2024-04-10: 3f2b8c1e-7d4a-4e9b-a6c5-1d2e3f4a5b6c
      properties:
        apis:
          anyOf:
          - items:
              type: string
            type: array
          - type: 'null'
          description: Restrict results to these APIs. Each entry is a 'vendor[/name[/version]]' identifier of an imported API (e.g. 'github-com/api-github-com/1.1.4'); vendor and name are normalized like ingest, so raw spellings such as 'stripe.com/api' also resolve. The legacy colon-separated form 'vendor[:name[:version]]' is also accepted.
          examples:
          - *id142
          title: Apis
        cursor:
          anyOf:
          - type: string
          - type: 'null'
          description: Opaque cursor from a previous page's `next_cursor`; omit for the first page.
          examples:
          - eyJkIjogMC4yODE2LCAiaWQiOiAib3BfZjkyZDY5ZjE2MjFmMzgxYmNlOGFhZmY0NzA1M2M2MWIwNjlmZmUzNCJ9
          title: Cursor
        limit:
          default: 10
          description: Maximum number of results to return (1-100).
          examples:
          - 10
          maximum: 100.0
          minimum: 1.0
          title: Limit
          type: integer
        query:
          description: Free-text search query; must not be empty.
          examples:
          - list recent charges
          minLength: 1
          title: Query
          type: string
        revision_pins:
          anyOf:
          - additionalProperties:
              type: string
            type: object
          - type: 'null'
          description: Pin specific APIs to a revision for this search. Keys are full 'vendor/name/version' identifiers (colon-separated also accepted); values are revision UUIDs.
          examples:
          - *id143
          title: Revision Pins
      required:
      - query
      title: SearchRequest
      type: object
    SearchResponse:
      description: Cursor-paginated search results page.
      examples:
      - &id274
        data: &id145
        - *id144
        has_more: true
        next_cursor: eyJkIjogMC4yODE2LCAiaWQiOiAib3BfZjkyZDY5ZjE2MjFmMzgxYmNlOGFhZmY0NzA1M2M2MWIwNjlmZmUzNCJ9
      properties:
        data:
          description: The page of matching operations.
          examples:
          - *id145
          items:
            $ref: '#/components/schemas/OperationResultResponse'
          title: Data
          type: array
        has_more:
          description: Whether more results exist after this page.
          examples:
          - true
          title: Has More
          type: boolean
        next_cursor:
          anyOf:
          - type: string
          - type: 'null'
          description: Cursor for the next page; null when there are no more results.
          examples:
          - eyJkIjogMC4yODE2LCAiaWQiOiAib3BfZjkyZDY5ZjE2MjFmMzgxYmNlOGFhZmY0NzA1M2M2MWIwNjlmZmUzNCJ9
          title: Next Cursor
      required:
      - data
      - has_more
      title: SearchResponse
      type: object
    SecuritySchemeFlowResponse:
      description: A single OAuth2 flow within a security scheme.
      examples:
      - &id147
        authorization_url: https://connect.stripe.com/oauth/authorize
        flow_type: authorizationCode
        refresh_url: https://connect.stripe.com/oauth/token
        scopes: &id146
          read_only: Read-only access
          read_write: Read and write access
        token_url: https://connect.stripe.com/oauth/token
      properties:
        authorization_url:
          anyOf:
          - type: string
          - type: 'null'
          description: Authorization endpoint URL; null if the flow has none.
          examples:
          - https://connect.stripe.com/oauth/authorize
          title: Authorization Url
        flow_type:
          description: OAuth2 flow type (for example `authorizationCode` or `clientCredentials`).
          examples:
          - authorizationCode
          title: Flow Type
          type: string
        refresh_url:
          anyOf:
          - type: string
          - type: 'null'
          description: Token refresh URL; null if the flow has none.
          examples:
          - https://connect.stripe.com/oauth/token
          title: Refresh Url
        scopes:
          anyOf:
          - additionalProperties:
              type: string
            type: object
          - type: 'null'
          description: Available scopes mapped to their descriptions.
          examples:
          - *id146
          title: Scopes
        token_url:
          anyOf:
          - type: string
          - type: 'null'
          description: Token endpoint URL; null if the flow has none.
          examples:
          - https://connect.stripe.com/oauth/token
          title: Token Url
      required:
      - flow_type
      title: SecuritySchemeFlowResponse
      type: object
    SecuritySchemeListResponse:
      description: List of security schemes for an API's current revision.
      examples:
      - &id210
        data: &id148
        - bearer_format: JWT
          description: Use your secret API key as the bearer token.
          flows:
          - *id147
          in_location: header
          name: bearerAuth
          open_id_connect_url: https://accounts.example.com/.well-known/openid-configuration
          param_name: X-API-Key
          scheme: bearer
          type: http
      properties:
        data:
          description: Security schemes declared by the API's current revision.
          examples:
          - *id148
          items:
            $ref: '#/components/schemas/SecuritySchemeResponse'
          title: Data
          type: array
      required:
      - data
      title: SecuritySchemeListResponse
      type: object
    SecuritySchemeResponse:
      description: Full security scheme detail for a revision.
      examples:
      - bearer_format: JWT
        description: Use your secret API key as the bearer token.
        flows: &id149
        - *id147
        in_location: header
        name: bearerAuth
        open_id_connect_url: https://accounts.example.com/.well-known/openid-configuration
        param_name: X-API-Key
        scheme: bearer
        type: http
      properties:
        bearer_format:
          anyOf:
          - type: string
          - type: 'null'
          description: Hint for the bearer token format; null if not declared.
          examples:
          - JWT
          title: Bearer Format
        description:
          anyOf:
          - type: string
          - type: 'null'
          description: Description of the scheme from the spec; null if none.
          examples:
          - Use your secret API key as the bearer token.
          title: Description
        flows:
          description: OAuth2 flows declared by the scheme; empty for other types.
          examples:
          - *id149
          items:
            $ref: '#/components/schemas/SecuritySchemeFlowResponse'
          title: Flows
          type: array
        in_location:
          anyOf:
          - type: string
          - type: 'null'
          description: Where an API key is sent (`header`, `query` or `cookie`); null for other types.
          examples:
          - header
          title: In Location
        name:
          description: Name of the security scheme as declared in the spec.
          examples:
          - bearerAuth
          title: Name
          type: string
        open_id_connect_url:
          anyOf:
          - type: string
          - type: 'null'
          description: OpenID Connect discovery URL; null unless `type` is `openIdConnect`.
          examples:
          - https://accounts.example.com/.well-known/openid-configuration
          title: Open Id Connect Url
        param_name:
          anyOf:
          - type: string
          - type: 'null'
          description: Name of the header, query or cookie parameter carrying the API key.
          examples:
          - X-API-Key
          title: Param Name
        scheme:
          anyOf:
          - type: string
          - type: 'null'
          description: HTTP authentication scheme (for example `bearer`); null unless `type` is `http`.
          examples:
          - bearer
          title: Scheme
        type:
          description: Security scheme type (for example `apiKey`, `http`, `oauth2` or `openIdConnect`).
          examples:
          - http
          title: Type
          type: string
      required:
      - name
      - type
      title: SecuritySchemeResponse
      type: object
    ServedApiRef:
      description: |-
        An API served by an agent's bound credential, keyed by its stored identity.

        Distinct from ``APIReference`` on purpose: this carries the *stored* credential
        identity, where ``api_name``/``api_version`` may be NULL (the "covers all
        names/versions" wildcard, #775) — so they're optional here, unlike the strict
        all-required ``APIReference``. Shared so the auth service schema and the
        ``/me`` web schema use ONE model instead of two identical copies.
      examples:
      - api_name: stripe
        api_vendor: stripe.com
        api_version: '2024-04-10'
      properties:
        api_name:
          anyOf:
          - type: string
          - type: 'null'
          description: Name of the served API; null means every API of the vendor.
          examples:
          - stripe
          title: Api Name
        api_vendor:
          description: Vendor of the served API.
          examples:
          - stripe.com
          title: Api Vendor
          type: string
        api_version:
          anyOf:
          - type: string
          - type: 'null'
          description: Version of the served API; null means every version.
          examples:
          - '2024-04-10'
          title: Api Version
      required:
      - api_vendor
      title: ServedApiRef
      type: object
    SetPermissionsRequest:
      description: Request body for setting user permissions.
      examples:
      - &id283
        permissions: &id150
        - users:write
        - agents:read
      properties:
        permissions:
          description: Permissions to assign to the user; replaces the current assigned set.
          examples:
          - *id150
          items:
            type: string
          maxItems: 50
          title: Permissions
          type: array
      required:
      - permissions
      title: SetPermissionsRequest
      type: object
    Sigv4CreateRequest:
      description: Create request for sigv4 (AWS Signature V4) credentials.
      examples:
      - access_key_id: AKIAIOSFODNN7EXAMPLE
        api: *id010
        aws_region: us-east-1
        aws_service: execute-api
        name: Stripe live key
        provider: static
        runtime_config: *id151
        secret_access_key: example-secret
        server_variables: &id152
          region: eu
        session_token: example-secret
        type: sigv4
      properties:
        access_key_id:
          description: AWS access key id (public identifier).
          examples:
          - AKIAIOSFODNN7EXAMPLE
          title: Access Key Id
          type: string
        api:
          $ref: '#/components/schemas/APIReferenceRequest'
          description: Loose (vendor, name, version) API identity tuple.
          examples:
          - *id010
        aws_region:
          description: Signing region, e.g. 'us-east-1'.
          examples:
          - us-east-1
          title: Aws Region
          type: string
        aws_service:
          description: Signing service, e.g. 'aoss', 'execute-api', 's3'.
          examples:
          - execute-api
          title: Aws Service
          type: string
        name:
          description: Human-readable label for the credential.
          examples:
          - Stripe live key
          title: Name
          type: string
        provider:
          default: static
          description: Credential provider; 'static' for stored secrets.
          examples:
          - static
          title: Provider
          type: string
        runtime_config:
          anyOf:
          - $ref: '#/components/schemas/RuntimeConfig'
          - type: 'null'
          description: Per-upstream-call overrides; reserved and not currently applied.
          examples:
          - *id151
        secret_access_key:
          description: AWS secret access key. Stored encrypted; never returned after create.
          examples:
          - example-secret
          title: Secret Access Key
          type: string
          x-sensitive: true
        server_variables:
          anyOf:
          - additionalProperties:
              type: string
            type: object
          - type: 'null'
          description: OpenAPI server-variable values for URL template substitution (at most 20).
          examples:
          - *id152
          title: Server Variables
        session_token:
          anyOf:
          - type: string
          - type: 'null'
          description: Optional temporary-credential session token (STS). Expires; re-save when it does.
          examples:
          - example-secret
          title: Session Token
          x-sensitive: true
        type:
          const: sigv4
          description: Credential type; always `sigv4`.
          examples:
          - sigv4
          title: Type
          type: string
      required:
      - type
      - name
      - api
      - access_key_id
      - secret_access_key
      - aws_region
      - aws_service
      title: Sigv4CreateRequest
      type: object
    Sigv4UpdateRequest:
      description: Update request for sigv4 credentials (key rotation / scope edit).
      examples:
      - access_key_id: AKIAIOSFODNN7EXAMPLE
        active: true
        aws_region: us-east-1
        aws_service: execute-api
        clear_session_token: false
        name: Stripe live key
        runtime_config: *id151
        secret_access_key: example-secret
        server_variables: &id153
          region: eu
        session_token: example-secret
        type: sigv4
      properties:
        access_key_id:
          anyOf:
          - type: string
          - type: 'null'
          description: Replacement AWS access key ID; must be sent with secret_access_key.
          examples:
          - AKIAIOSFODNN7EXAMPLE
          title: Access Key Id
        active:
          anyOf:
          - type: boolean
          - type: 'null'
          description: Enable or disable the credential for injection; omit to leave unchanged.
          examples:
          - true
          title: Active
        aws_region:
          anyOf:
          - type: string
          - type: 'null'
          description: Replacement signing region; omit to leave unchanged.
          examples:
          - us-east-1
          title: Aws Region
        aws_service:
          anyOf:
          - type: string
          - type: 'null'
          description: Replacement signing service; omit to leave unchanged.
          examples:
          - execute-api
          title: Aws Service
        clear_session_token:
          default: false
          description: Remove the stored session token; takes precedence over session_token.
          examples:
          - false
          title: Clear Session Token
          type: boolean
        name:
          anyOf:
          - type: string
          - type: 'null'
          description: New label for the credential; omit to leave unchanged.
          examples:
          - Stripe live key
          title: Name
        runtime_config:
          anyOf:
          - $ref: '#/components/schemas/RuntimeConfig'
          - type: 'null'
          description: Per-upstream-call overrides; reserved and not currently applied.
          examples:
          - *id151
        secret_access_key:
          anyOf:
          - type: string
          - type: 'null'
          description: Replacement AWS secret access key; must be sent with access_key_id.
          examples:
          - example-secret
          title: Secret Access Key
          x-sensitive: true
        server_variables:
          anyOf:
          - additionalProperties:
              type: string
            type: object
          - type: 'null'
          description: Replacement OpenAPI server-variable values; omit to leave unchanged.
          examples:
          - *id153
          title: Server Variables
        session_token:
          anyOf:
          - type: string
          - type: 'null'
          description: Replacement STS session token; omit to leave unchanged.
          examples:
          - example-secret
          title: Session Token
          x-sensitive: true
        type:
          const: sigv4
          description: Credential type; always `sigv4`.
          examples:
          - sigv4
          title: Type
          type: string
      required:
      - type
      title: Sigv4UpdateRequest
      type: object
    TokenResponse:
      description: Token endpoint success response.
      examples:
      - &id264
        access_token: at_example-access-token
        expires_in: 3600
        id_token: example-id-token
        refresh_token: rt_example-refresh-token
        scope: apis:read capabilities:execute
        token_type: bearer
      properties:
        access_token:
          description: The access token to send as a bearer token.
          examples:
          - at_example-access-token
          title: Access Token
          type: string
          x-sensitive: true
        expires_in:
          description: Lifetime of the access token, in seconds.
          examples:
          - 3600
          title: Expires In
          type: integer
        id_token:
          anyOf:
          - type: string
          - type: 'null'
          description: OpenID Connect ID token; omitted when none was issued.
          examples:
          - example-id-token
          title: Id Token
          x-sensitive: true
        refresh_token:
          anyOf:
          - type: string
          - type: 'null'
          description: Refresh token for obtaining new tokens; omitted when none was issued.
          examples:
          - rt_example-refresh-token
          title: Refresh Token
          x-sensitive: true
        scope:
          anyOf:
          - type: string
          - type: 'null'
          description: Space-delimited effective scopes of the minted access token (RFC 6749 §3.3), computed the way the platform's resolvers enforce them (live scope grants ∩ client ceiling ∩ consent-grant scopes for agent tokens), so the granted set may be narrower than requested and clients must not assume they got what they asked for. Present on every response whose token carries at least one scope; OMITTED (never the ABNF-invalid empty string) only when the effective set is empty — reachable solely on legs where the client requested no scopes at the token endpoint (the token request carries no scope parameter, and consent fails closed on an empty intersection).
          examples:
          - apis:read capabilities:execute
          title: Scope
        token_type:
          default: bearer
          description: Token type; always `bearer`.
          examples:
          - bearer
          title: Token Type
          type: string
      required:
      - access_token
      - expires_in
      title: TokenResponse
      type: object
    TopOperation:
      description: Aggregated execution counts for a single operation.
      examples:
      - api_name: stripe
        api_vendor: stripe.com
        failed: 12
        operation_id: listCharges
        total: 342
      properties:
        api_name:
          description: Name of the API the operation belongs to.
          examples:
          - stripe
          title: Api Name
          type: string
        api_vendor:
          description: Vendor of the API the operation belongs to.
          examples:
          - stripe.com
          title: Api Vendor
          type: string
        failed:
          description: Number of those executions that failed.
          examples:
          - 12
          title: Failed
          type: integer
        operation_id:
          description: Identifier of the operation.
          examples:
          - listCharges
          title: Operation Id
          type: string
        total:
          description: Number of executions of the operation in the window.
          examples:
          - 342
          title: Total
          type: integer
      required:
      - api_vendor
      - api_name
      - operation_id
      - total
      - failed
      title: TopOperation
      type: object
    UsageBucket:
      description: Execution counts for a single time bucket.
      examples:
      - &id154
        avg_ms: 231.4
        failed: 2
        success: 40
        total: 42
        ts: 1767225600
      properties:
        avg_ms:
          description: Mean execution duration in the bucket, in milliseconds.
          examples:
          - 231.4
          title: Avg Ms
          type: number
        failed:
          description: Number of those executions that failed.
          examples:
          - 2
          title: Failed
          type: integer
        success:
          description: Number of those executions that completed.
          examples:
          - 40
          title: Success
          type: integer
        total:
          description: Number of executions started in the bucket.
          examples:
          - 42
          title: Total
          type: integer
        ts:
          description: Start of the bucket, in Unix epoch seconds.
          examples:
          - 1767225600
          title: Ts
          type: integer
      required:
      - ts
      - total
      - success
      - failed
      - avg_ms
      title: UsageBucket
      type: object
    UsageResponse:
      description: Full usage statistics response.
      examples:
      - &id250
        bucket_seconds: 86400
        buckets: &id155
        - *id154
        group_by: api
        since: 1767225600
        stats: &id156
          active_now: 0
          avg_ms: 245.6
          failed: 80
          p50_ms: 180.0
          p95_ms: 720.0
          pending: 0
          success: 1200
          total: 1280
        top: &id157
        - avg_ms: 212.8
          failed: 12
          key: stripe.com/stripe
          label: Stripe
          success: 330
          total: 342
          trend: &id158
          - 40
          - 52
          - 47
          - 61
          - 58
          - 84
        until: 1769903999
      properties:
        bucket_seconds:
          description: Width of each entry in `buckets`, in seconds; chosen from the window length.
          examples:
          - 86400
          title: Bucket Seconds
          type: integer
        buckets:
          description: Execution counts per time bucket, oldest first; empty buckets are omitted.
          examples:
          - *id155
          items:
            $ref: '#/components/schemas/UsageBucket'
          title: Buckets
          type: array
        group_by:
          description: Dimension the `top` rows are grouped by.
          examples:
          - api
          title: Group By
          type: string
        since:
          description: Start of the window, in Unix epoch seconds (inclusive).
          examples:
          - 1767225600
          title: Since
          type: integer
        stats:
          $ref: '#/components/schemas/UsageStatsBlock'
          examples:
          - *id156
        top:
          description: The entities with the most executions in the window, most first.
          examples:
          - *id157
          items:
            $ref: '#/components/schemas/UsageTopRow'
          title: Top
          type: array
        until:
          description: End of the window, in Unix epoch seconds (exclusive).
          examples:
          - 1769903999
          title: Until
          type: integer
      required:
      - since
      - until
      - bucket_seconds
      - group_by
      - stats
      - buckets
      - top
      title: UsageResponse
      type: object
    UsageStatsBlock:
      description: Overall usage statistics for a time window.
      examples:
      - active_now: 0
        avg_ms: 245.6
        failed: 80
        p50_ms: 180.0
        p95_ms: 720.0
        pending: 0
        success: 1200
        total: 1280
      properties:
        active_now:
          description: Reserved count of in-flight executions; currently always 0.
          examples:
          - 0
          title: Active Now
          type: integer
        avg_ms:
          description: Mean execution duration in milliseconds; 0 when there were no executions.
          examples:
          - 245.6
          title: Avg Ms
          type: number
        failed:
          description: Number of those executions that failed.
          examples:
          - 80
          title: Failed
          type: integer
        p50_ms:
          anyOf:
          - type: number
          - type: 'null'
          description: Median execution duration in milliseconds; null when not available.
          examples:
          - 180.0
          title: P50 Ms
        p95_ms:
          anyOf:
          - type: number
          - type: 'null'
          description: 95th-percentile execution duration in milliseconds; null when not available.
          examples:
          - 720.0
          title: P95 Ms
        pending:
          description: Reserved count of pending executions; currently always 0.
          examples:
          - 0
          title: Pending
          type: integer
        success:
          description: Number of those executions that completed.
          examples:
          - 1200
          title: Success
          type: integer
        total:
          description: Number of executions started in the window.
          examples:
          - 1280
          title: Total
          type: integer
      required:
      - total
      - success
      - failed
      - pending
      - avg_ms
      - p50_ms
      - p95_ms
      - active_now
      title: UsageStatsBlock
      type: object
    UsageTopRow:
      description: Top entity row with sparkline trend.
      examples:
      - avg_ms: 212.8
        failed: 12
        key: stripe.com/stripe
        label: Stripe
        success: 330
        total: 342
        trend: *id158
      properties:
        avg_ms:
          description: Mean execution duration for this entity, in milliseconds.
          examples:
          - 212.8
          title: Avg Ms
          type: number
        failed:
          description: Number of those executions that failed.
          examples:
          - 12
          title: Failed
          type: integer
        key:
          description: 'Grouping key for the row: `vendor/name` for `api`, the toolkit or credential ID, or `actor_type/actor_id` for `agent`; `unknown` when the value is missing.'
          examples:
          - stripe.com/stripe
          title: Key
          type: string
        label:
          description: Display label for the row.
          examples:
          - Stripe
          title: Label
          type: string
        success:
          description: Number of those executions that completed.
          examples:
          - 330
          title: Success
          type: integer
        total:
          description: Number of executions for this entity in the window.
          examples:
          - 342
          title: Total
          type: integer
        trend:
          description: Execution counts for this entity across equal segments of the window, oldest first.
          examples:
          - *id158
          items:
            type: integer
          title: Trend
          type: array
      required:
      - key
      - label
      - total
      - success
      - failed
      - avg_ms
      - trend
      title: UsageTopRow
      type: object
    UserCreateRequest:
      description: Request body for creating a new user.
      examples:
      - &id277
        email: ada@example.com
        first_name: Ada
        last_name: Lovelace
        permissions: &id159
        - users:read
        - agents:read
      properties:
        email:
          description: Email address of the new user; must be unique.
          examples:
          - ada@example.com
          maxLength: 320
          minLength: 1
          title: Email
          type: string
        first_name:
          description: First name of the new user.
          examples:
          - Ada
          maxLength: 255
          minLength: 1
          title: First Name
          type: string
        last_name:
          description: Last name of the new user.
          examples:
          - Lovelace
          maxLength: 255
          minLength: 1
          title: Last Name
          type: string
        permissions:
          default: []
          description: Permissions to assign to the new user; the caller may only grant permissions they hold. Defaults to none.
          examples:
          - *id159
          items:
            type: string
          title: Permissions
          type: array
      required:
      - email
      - first_name
      - last_name
      title: UserCreateRequest
      type: object
    UserCreatedResponse:
      description: Response after user creation including invite token.
      examples:
      - &id278
        invite_expires_at: '2026-01-22T09:30:00Z'
        invite_token: dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk
        user: &id161
          active: true
          auth_provider: external
          created_at: '2026-01-15T09:30:00Z'
          email: ada@example.com
          external_subject_id: auth0|6568b3984d1c238dbe7e2e29
          first_name: Ada
          id: usr_6968b3987ee4c3ec0b4ee3b9
          invite_state: accepted
          last_name: Lovelace
          must_change_password: false
          name: Ada Lovelace
          permissions: *id160
          updated_at: '2026-01-20T14:05:00Z'
      properties:
        invite_expires_at:
          description: When the invite token expires (RFC 3339).
          examples:
          - '2026-01-22T09:30:00Z'
          format: date-time
          title: Invite Expires At
          type: string
        invite_token:
          description: One-time invite token the user redeems to set a password.
          examples:
          - dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk
          title: Invite Token
          type: string
          x-sensitive: true
        user:
          $ref: '#/components/schemas/UserResponse'
          examples:
          - *id161
      required:
      - user
      - invite_token
      - invite_expires_at
      title: UserCreatedResponse
      type: object
    UserListResponse:
      description: Paginated list of users.
      examples:
      - &id276
        data: &id162
        - active: true
          auth_provider: external
          created_at: '2026-01-15T09:30:00Z'
          email: ada@example.com
          external_subject_id: auth0|6568b3984d1c238dbe7e2e29
          first_name: Ada
          id: usr_6968b3987ee4c3ec0b4ee3b9
          invite_state: accepted
          last_name: Lovelace
          must_change_password: false
          name: Ada Lovelace
          permissions: *id160
          updated_at: '2026-01-20T14:05:00Z'
        has_more: true
        next_cursor: eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
      properties:
        data:
          description: The page of users.
          examples:
          - *id162
          items:
            $ref: '#/components/schemas/UserResponse'
          title: Data
          type: array
        has_more:
          description: Whether more results exist after this page.
          examples:
          - true
          title: Has More
          type: boolean
        next_cursor:
          anyOf:
          - type: string
          - type: 'null'
          description: Cursor for the next page; null when there are no more results.
          examples:
          - eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
          title: Next Cursor
      required:
      - data
      - has_more
      title: UserListResponse
      type: object
    UserResponse:
      description: User representation in API responses.
      examples:
      - &id281
        active: true
        auth_provider: external
        created_at: '2026-01-15T09:30:00Z'
        email: ada@example.com
        external_subject_id: auth0|6568b3984d1c238dbe7e2e29
        first_name: Ada
        id: usr_6968b3987ee4c3ec0b4ee3b9
        invite_state: accepted
        last_name: Lovelace
        must_change_password: false
        name: Ada Lovelace
        permissions: *id160
        updated_at: '2026-01-20T14:05:00Z'
      properties:
        active:
          description: Whether the user account is enabled.
          examples:
          - true
          title: Active
          type: boolean
        auth_provider:
          description: 'How the user authenticates: `local` (password) or `external`.'
          examples:
          - external
          title: Auth Provider
          type: string
        created_at:
          description: When the user was created (RFC 3339).
          examples:
          - '2026-01-15T09:30:00Z'
          format: date-time
          title: Created At
          type: string
        email:
          description: Email address of the user.
          examples:
          - ada@example.com
          title: Email
          type: string
        external_subject_id:
          anyOf:
          - type: string
          - type: 'null'
          description: Subject ID from the external identity provider; null for local users.
          examples:
          - auth0|6568b3984d1c238dbe7e2e29
          title: External Subject Id
        first_name:
          description: First name of the user.
          examples:
          - Ada
          title: First Name
          type: string
        id:
          description: Unique ID of the user.
          examples:
          - usr_6968b3987ee4c3ec0b4ee3b9
          title: Id
          type: string
        invite_state:
          description: 'Invitation state: `pending`, `redeemed`, `accepted` or `expired`. `expired` means a pending invite whose token has lapsed and should be reissued.'
          examples:
          - accepted
          title: Invite State
          type: string
        last_name:
          description: Last name of the user.
          examples:
          - Lovelace
          title: Last Name
          type: string
        must_change_password:
          description: Whether the user must change their password at next use.
          examples:
          - false
          title: Must Change Password
          type: boolean
        name:
          description: 'Full display name: first name and last name.'
          examples:
          - Ada Lovelace
          title: Name
          type: string
        permissions:
          $ref: '#/components/schemas/Permissions'
          examples:
          - *id160
        updated_at:
          anyOf:
          - format: date-time
            type: string
          - type: 'null'
          description: When the user was last updated (RFC 3339); null if never updated.
          examples:
          - '2026-01-20T14:05:00Z'
          title: Updated At
      required:
      - id
      - email
      - first_name
      - last_name
      - name
      - active
      - auth_provider
      - invite_state
      - must_change_password
      - permissions
      - created_at
      title: UserResponse
      type: object
    UserUpdateRequest:
      description: Request body for updating a user.
      examples:
      - &id282
        email: ada.lovelace@example.com
        first_name: Ada
        last_name: Lovelace
      properties:
        email:
          anyOf:
          - maxLength: 320
            minLength: 1
            type: string
          - type: 'null'
          description: New email address; must be unique. Null means no change.
          examples:
          - ada.lovelace@example.com
          title: Email
        first_name:
          anyOf:
          - maxLength: 255
            minLength: 1
            type: string
          - type: 'null'
          description: New first name; null means no change.
          examples:
          - Ada
          title: First Name
        last_name:
          anyOf:
          - maxLength: 255
            minLength: 1
            type: string
          - type: 'null'
          description: New last name; null means no change.
          examples:
          - Lovelace
          title: Last Name
      title: UserUpdateRequest
      type: object
    VendorListResponse:
      description: The vendors the caller can connect a credential for.
      examples:
      - &id287
        data: &id163
        - catalog_api_id: github.com/api.github.com
          display_name: GitHub
          entry_id: oar_6968b39821e5f89a6975f501
          flow_kinds: &id164
          - authorization_code
          key: github
          name: MyOrg GitHub
          registration_id: oar_6968b39821e5f89a6975f501
          source: db
          vendor: github.com/api.github.com
      properties:
        data:
          description: The connectable vendors.
          examples:
          - *id163
          items:
            $ref: '#/components/schemas/VendorSummaryResponse'
          title: Data
          type: array
      required:
      - data
      title: VendorListResponse
      type: object
    VendorSummaryResponse:
      description: A vendor, or one admin registration for it, that the caller can connect to.
      examples:
      - catalog_api_id: github.com/api.github.com
        display_name: GitHub
        entry_id: oar_6968b39821e5f89a6975f501
        flow_kinds: *id164
        key: github
        name: MyOrg GitHub
        registration_id: oar_6968b39821e5f89a6975f501
        source: db
        vendor: github.com/api.github.com
      properties:
        catalog_api_id:
          anyOf:
          - type: string
          - type: 'null'
          description: Catalog API (`<domain>/<sub>`) the registration signs in to; null for platform-shipped vendors.
          examples:
          - github.com/api.github.com
          title: Catalog Api Id
        display_name:
          description: Vendor's display name (e.g. 'Gmail').
          examples:
          - GitHub
          title: Display Name
          type: string
        entry_id:
          description: 'Stable per-row key: the registration ID for admin registrations, else the vendor key.'
          examples:
          - oar_6968b39821e5f89a6975f501
          title: Entry Id
          type: string
        flow_kinds:
          description: OAuth flow kinds this row supports (`authorization_code`, `device_authorization`).
          examples:
          - *id164
          items:
            type: string
          title: Flow Kinds
          type: array
        key:
          description: Vendor registry key shared by every registration for the vendor.
          examples:
          - github
          title: Key
          type: string
        name:
          description: 'Label for this row: the registration name for admin registrations, else the display name.'
          examples:
          - MyOrg GitHub
          title: Name
          type: string
        registration_id:
          anyOf:
          - type: string
          - type: 'null'
          description: ID of the admin OAuth app registration behind this row; null for platform-shipped vendors.
          examples:
          - oar_6968b39821e5f89a6975f501
          title: Registration Id
        source:
          description: 'Where the row came from: `db` for an admin registration, `config` for a platform-shipped vendor.'
          enum:
          - db
          - config
          examples:
          - db
          title: Source
          type: string
        vendor:
          description: Fully-qualified vendor ID (`<host>/<api-id>`) when known; otherwise the vendor key.
          examples:
          - github.com/api.github.com
          title: Vendor
          type: string
      required:
      - entry_id
      - key
      - vendor
      - display_name
      - name
      - source
      - flow_kinds
      title: VendorSummaryResponse
      type: object
    VersionResponse:
      description: The running app version and the latest release known to this backend.
      examples:
      - &id275
        current: 0.42.2
        latest: 0.43.0
        update_available: true
      properties:
        current:
          description: The version of jentic-one currently running on this backend.
          examples:
          - 0.42.2
          title: Current
          type: string
        latest:
          anyOf:
          - type: string
          - type: 'null'
          description: The latest published release of jentic-one, without a leading 'v'. Null when the backend can't determine it (update check disabled, air-gapped, a remote backend, or GitHub was unreachable).
          examples:
          - 0.43.0
          title: Latest
        update_available:
          description: True when `latest` is a newer release than `current`. Matches the verdict `jenticctl update` would print.
          examples:
          - true
          title: Update Available
          type: boolean
      required:
      - current
      - update_available
      title: VersionResponse
      type: object
  securitySchemes:
    BearerAuth:
      description: |-
        Opaque bearer access token (prefixed `at_`), sent as `Authorization: Bearer <token>`. It is **not** a JWT — it is a random string validated server-side by lookup, so it cannot be decoded by the client.

        Obtain one from `POST /oauth/token` using the grant for your actor type:
        - **Agents** — `grant_type=urn:ietf:params:oauth:grant-type:jwt-bearer` with a JWT assertion signed by the key registered via `POST /register` (the JWT is the *assertion*, not the resulting access token).
        - **Users** — `grant_type=authorization_code` (interactive) or `grant_type=password`; refresh either with `grant_type=refresh_token`.

        Per-endpoint permission and actor-type requirements are not modelled in this document (OpenAPI cannot faithfully express the OR-of-permissions / `org:admin` bypass / service-layer enforcement); see `GET /reference/endpoints.json` for the authoritative authorization reference.
      scheme: bearer
      type: http
    OAuth2:
      description: |-
        OAuth 2.0 authorization code flow with PKCE (`S256` only), run by this deployment's authorization server. The resulting access token is the same opaque bearer token `BearerAuth` describes, sent as `Authorization: Bearer <token>`.

        Scopes are permission names, plus the OpenID Connect identity scopes. A request for scopes beyond the client's allowed scopes is rejected with `invalid_scope`, and a token is never enforced beyond its client's allowed scopes or the consent grant. Agents normally authenticate with the JWT-bearer grant instead — see `BearerAuth`.
      flows:
        authorizationCode:
          authorizationUrl: /authorize
          refreshUrl: /oauth/token
          scopes:
            agents:read: Read agent configuration and status.
            agents:write: Create, update, and delete agents.
            apis:read: Read API definitions and metadata.
            apis:write: Import, update, and delete API definitions and their revisions.
            audit:read: Read audit log entries.
            capabilities:execute: Execute capabilities via the broker.
            capabilities:read: Read capability metadata.
            catalog:import: Import an API from the public catalog into the local registry.
            config:read: Read runtime platform configuration.
            config:write: Create and update runtime platform configuration.
            credentials:connect: Start and poll an integration connect session (agent-driven SSO). Cannot read tokens or manage other credentials.
            credentials:read: Read credential metadata.
            credentials:write: Create, update, and delete credentials.
            email: Include the user's email address in the ID token.
            events:read: Read platform events.
            events:write: Manage platform events.
            executions:read: Read execution records.
            jobs:read: Read job status and results.
            jobs:write: Cancel and manage async jobs.
            oauth-clients:read: Read OAuth client registrations.
            oauth-clients:write: Create, update, disable, and rotate secrets of OAuth clients.
            openid: Issue an OpenID Connect ID token identifying the user.
            org:admin: Full organisation administrator access.
            overlays:confirm: Confirm a pending overlay, rewriting the API's served spec (operator action; not granted to agents by default).
            owner:agents:read: Read agents owned by the agent's creator.
            owner:credentials:read: Read credentials owned by the agent's creator.
            owner:resources:read: Read resources owned by the agent's creator (umbrella).
            profile: Include the user's display name in the ID token.
            users:read: Read user profiles and permissions.
            users:write: Create, update, and disable users.
          tokenUrl: /oauth/token
      type: oauth2
info:
  contact:
    email: support@jentic.com
    name: Jentic Platform Team
    url: https://jentic.com/
  description: |
    ## Overview ##
    The **Jentic Control Plane API** is the unified HTTP surface of the
    Jentic platform's control plane — every administrative and
    metadata-facing endpoint outside the Broker data plane.

    The control plane is the administrative counterpart to the
    [Broker](../broker/swagger) data plane: where the Broker executes
    upstream API calls on behalf of agents, the control plane is where
    humans, operators, and agents configure *what* the Broker is
    allowed to do, *for whom*, *with which credentials*, *against
    which registered APIs*, and *with what telemetry retained*.

    ## Components ##
    High-level components for the control plane API.
    - **[Core / Access](#tag/Credentials)** — credentials, direct
      agent↔credential bindings, and PBAC grants and runtime params. Owns *who can
      call what, with which secret*.
    - **[Registry](#tag/APIs)** — registered APIs, immutable
      revisions, operations, search, lookup. Owns *what APIs are
      registered for this deployment and what they look like at any
      given revision*.
    - **[Admin / Audit](#tag/Users)** — users, permissions,
      execution telemetry, async-job tracker, and dashboard event
      stream. Owns *who can sign in with what permissions* together
      with *what actually happened* — the human roster, the
      append-only records of brokered executions, the unified
      `Job` resource that both Registry imports and Broker
      async-execution calls feed into, and a curated `/events`
      surface for dashboards and operators.

    ## Authentication ##

    Today the platform ships a local username + password identity
    provider for human users, alongside agent identity (Dynamic Client
    Registration + RFC 7523 JWT-bearer assertions) — every authenticated operation expects
    `Authorization: Bearer <token>` (`BearerAuth`, an opaque `at_`
    token) except `GET /health`, `POST /auth/login`,
    `POST /users:create-admin`, and `POST /users:redeem-invite`.
    Human tokens are issued by `POST /auth/login` with a fixed 1-hour
    TTL and can be re-minted before expiry via `POST /auth/refresh`
    (sliding session, bounded by an absolute window —
    `admin.auth.session_ttl_seconds`, 12 hours by default); agents
    obtain tokens from `POST /oauth/token` (see
    `BearerAuth`). The `permissions` claim on a token is a snapshot at
    issue time; permission changes take effect at the next re-issue —
    the next refresh or re-login (≤ 1 hour with the default TTL).

    The platform ships **no default credentials**. On a fresh
    install the users table is empty, so `GET /health` returns
    `setup_required: true` with `next_step: create_admin`. The
    operator creates the first administrator with `POST
    /users:create-admin {email, password}` — a one-time,
    unauthenticated, self-closing endpoint: it succeeds only while
    the users table is empty and returns `410 setup_already_complete`
    once any user exists (a single-row setup sentinel is the
    concurrency backstop, so two racing callers — even with different
    emails — cannot both bootstrap). It grants `org:admin`, sets the operator's chosen
    password (so `must_change_password` is **false** — no forced
    rotation), and returns a ready-to-use `LoginResponse`
    (auto-login). After the first user exists `setup_required` flips
    to `false`. See the **Users** tag for the full onboarding
    walkthrough.

    External SSO providers (Okta, AWS Cognito, Auth0, Azure AD)
    plug in via the `User.auth_provider: external` hook plus an
    `external_subject_id` mapping; no concrete provider ships in
    this revision. Agent identity (separate from human users) uses
    Dynamic Client Registration (`POST /register`) with the agent's
    JWKS, then RFC 7523 JWT-bearer assertions exchanged at
    `POST /oauth/token` for an opaque access token.

    ## Cross-cutting conventions

    - Every API reference uses the loose
      `APIReference(vendor, name, version)` data structure. There is no
      foreign key between Core, Registry, and Admin / Audit — the
      tuple is the only join.
    - **Error shape.** Every error response is RFC 9457 Problem
      Details (`application/problem+json`) using the shared
      `ProblemDetails` schema from
      [jentic/api-problem-details](https://github.com/jentic/api-problem-details).
      Field-level validation failures (`422`) populate `errors[]`;
      transport-level conditions reuse the same shape with status-
      and `type`-specific payloads.
    - **JSON casing.** Field names in request and response bodies are
      `snake_case` throughout, including discriminator values
      (`type: api_key`, `type: bearer_token`, …). The one historical
      camelCase exception is the OpenAPI keyword `apiKey` itself when
      it appears in re-exported `securitySchemes.type` values; that's
      an OpenAPI artefact, not platform style.
    - **Pagination.** List endpoints are cursor-paginated with opaque
      `next_cursor` round-trips. `has_more=false` means done. List
      envelopes are intentionally slim — `{data, has_more,
      next_cursor}` — and **do not** carry HAL-style `_links` (no
      `self`, `next`, or `prev`); cursors are forward-only and
      `next_cursor` already encodes the next page. Individual resource
      responses still use `_links` where it carries non-trivial
      information (e.g. `Job._links.result`, `AsyncQueuedResponse._links.self`,
      `Event._links`).
    - **Authentication.** All operations require `Authorization:
      Bearer <token>` — an opaque access token (prefixed `at_`, not a
      JWT), obtained from `POST /oauth/token` (see `BearerAuth` for the
      per-actor grants) — except the unauthenticated
      `GET /health`, `POST /auth/login`, `POST /users:create-admin`,
      and `POST /users:redeem-invite`. See the `Users` tag for the
      first-run setup and invite-redemption flows.
    - **Header namespace.** All Jentic-specific HTTP headers — request
      and response, broker and control-plane — live under the
      `Jentic-*` namespace **without** the legacy `X-` prefix
      (RFC 6648 deprecates `X-` for new protocols). `Jentic-*` is
      unambiguously a platform header; anything else on a brokered
      response belongs to the upstream API. Standard headers
      (`Authorization`, `Prefer`, `Idempotency-Key`, `Accept`,
      `traceparent`, `tracestate`) keep their RFC names.
    - **Append-only audit.** Admin / Audit records are never mutated
      after the fact; retention is enforced via purge policy, not
      edit.
    - **Trace correlation.** Every Broker call records a W3C
      `trace_id` on its `ExecutionRecord` and on any `Event` derived
      from it. To walk the executions you can see under one logical request, use
      `GET /executions?trace_id=…`.
    - **Event stream.** The dashboard / operator UI consumes the
      `/events` resource (paginated list + SSE stream). Some events
      are informational, some require action — see the `Events` tag.
    - **Revision pinning.** Every `Api` carries one `published`
      revision (`current_revision_id`) plus zero or more `draft` and
      `archived` siblings. The Broker's hot path resolves against
      `current_revision_id` by default; agents can target a specific
      `draft` revision per call via the Broker's `Jentic-Revision`
      header. Control-plane reads (`Search`, `Inspect`,
      `Lookup`) accept matching `revision_id` / `revision_pins`
      parameters so dashboards can preview an unpromoted revision
      before flipping `:promote`.
    - **ID prefixes.** Resource identifiers use a stable short prefix.
      Treat the prefix as part of the ID — never strip it. The
      complete table:

      | Prefix | Resource | Notes |
      |---|---|---|
      | `tk_` | Toolkit ID | Retired (theme-5): the toolkit surface and its tables are gone (Phase 6b). Ids still appear in historical records (execution attribution, audit). |
      | `ck_` | Toolkit-key record | Retired (theme-5): key records are gone with the toolkit tables (Phase 6b). Ids survive only in audit history. |
      | `cred_` | Credential ID | |
      | `exec_` | Execution record | Returned in the `Jentic-Execution-Id` response header on every brokered call. |
      | `job_` | Async job | UUIDs also accepted on inputs for backward compatibility. |
      | `evt_` | Event | ULID-shaped. |
      | `op_` | Registered operation | |
      | `rev_` | API revision | ULID-shaped. |
      | `usr_` | User | Org member. Resolves via `GET /users/{user_id}`. Used in `decided_by` and similar audit references. |
      | `inv_` | Invite token | One-time token issued at user creation. Plaintext value shown **once** at issue / re-issue; `:redeem-invite` consumes it. |
      | `areq_` | Access request (retired) | Retired (theme 7): the access-request flow is gone. Ids still appear in stored audit/event records. |
      | `note_` | Note | ULID-shaped. Free-form annotation attached to a registry resource — see the `Notes` tag. |
      | `ovr_` | Overlay | ULID-shaped. OpenAPI Overlay 1.0 document attached to an `Api` aggregate — see the `Overlays` tag. |
      | `jntc_live_` | Plaintext toolkit API key value (retired) | Never issued anymore. A value migrated before Phase 6b keeps authenticating — as its successor agent — until the deprecation window closes (no earlier than 2026-12-01); rotate holders to the successor agent's `jak_` key. |
      | `sak_` | Plaintext service-account API key value (retired) | Retired in 0.41: refused with `401` (the detail names the retirement). Each service account was migrated to an agent; mint a `jak_` key for that agent. |

      Surfaces still being designed (agent identity, OAuth brokers)
      will add their own prefixes when they land.
  license:
    identifier: Apache-2.0
    name: Apache-2.0
  summary: HTTP surface of the Jentic platform's control plane — Core / Access (credentials, direct agent bindings), Registry (registered APIs, operations, search), and Admin / Audit (execution telemetry, async jobs).
  title: Jentic Control Plane API
  version: 0.43.0
openapi: 3.1.0
paths:
  /actors:
    description: '`GET`: List users and agents.'
    get:
      description: |-
        List users and agents with the minimal fields needed to label them.

        Each entry gives `id`, `actor_type` (`user` or `agent`), display `name`
        and `active`. Requires `users:read`. Results are scoped to the caller:
        `org:admin` lists everyone; anyone else lists only themselves and the
        agents they may see (their own, or with `owner:agents:read` their owner's
        agents). Cursor-paginated (`cursor`, `limit`). To label specific ids you
        already hold, use `GET /actors/lookup`.
      operationId: listActors
      parameters:
      - description: Opaque cursor from a previous page's `next_cursor`; omit for the first page.
        examples:
          example:
            summary: Opaque cursor from a previous page
            value: eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
        in: query
        name: cursor
        required: false
        schema:
          anyOf:
          - examples:
            - eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
            type: string
          - type: 'null'
          description: Opaque cursor from a previous page's `next_cursor`; omit for the first page.
          examples:
          - eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
          title: Cursor
      - description: Maximum number of actors to return (1-5000, default 1000).
        examples:
          example:
            summary: Example query value for `limit`
            value: 25
        in: query
        name: limit
        required: false
        schema:
          default: 1000
          description: Maximum number of actors to return (1-5000, default 1000).
          examples:
          - 25
          maximum: 5000
          minimum: 1
          title: Limit
          type: integer
      responses:
        '200':
          content:
            application/json:
              example: *id165
              schema:
                $ref: '#/components/schemas/ActorListResponse'
          description: Successful Response
        '400':
          content:
            application/problem+json:
              example: &id169
                detail: The request was malformed or failed a precondition.
                instance: /example/path
                status: 400
                title: Bad Request
                type: bad_request
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Bad Request
        '401':
          content:
            application/problem+json:
              example: &id170
                detail: Authentication is required or the bearer token is invalid.
                instance: /example/path
                status: 401
                title: Unauthorized
                type: unauthorized
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unauthorized
        '403':
          content:
            application/problem+json:
              example: &id171
                detail: The authenticated principal lacks the required permission.
                instance: /example/path
                status: 403
                title: Forbidden
                type: forbidden
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Forbidden
        '422':
          content:
            application/problem+json:
              example: &id172
                detail: Request validation failed; see errors[] for details.
                errors:
                - detail: Field 'name' must not be blank.
                  pointer: '#/name'
                instance: /example/path
                status: 422
                title: Unprocessable Entity
                type: validation_error
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unprocessable Entity
        '500':
          content:
            application/problem+json:
              example: &id166
                detail: An unexpected error occurred.
                instance: /example/path
                status: 500
                title: Internal Server Error
                type: server_error
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Internal Server Error
        '503':
          content:
            application/problem+json:
              example: &id173
                detail: The database is temporarily unavailable; please retry.
                instance: /example/path
                status: 503
                title: Service Unavailable
                type: database_unavailable
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Service Unavailable
        default:
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unexpected error, as RFC 9457 Problem Details.
      security:
      - BearerAuth: []
      - OAuth2: []
      summary: List users and agents
      tags:
      - Actors
    summary: List users and agents
  /actors/lookup:
    description: '`GET`: Resolve actor names by id.'
    get:
      description: |-
        Resolve user and agent ids to display names.

        Pass each id as a repeated `id` parameter. Returns `id`, `actor_type`,
        `name` and `active` for each id the caller may see. Any signed-in caller
        may call it, so a UI can label the owners, approvers and actors it
        already holds by id without `users:read`.

        Users resolve for every caller. Agents resolve only when visible to the
        caller: itself, its own agents, its owner's agents with
        `owner:agents:read`, or every agent for `org:admin`. Ids that match no
        visible actor are silently left out rather than reported as errors.
        Listing the whole directory needs `users:read` on `GET /actors`.
      operationId: lookupActors
      parameters:
      - description: Actor id to resolve; repeat the parameter for several ids (at most 100 per call, each at most 64 characters).
        examples:
          example:
            summary: Example query value for `id`
            value: &id167
            - agnt_6968b3984d1c238dbe7e2e29
            - usr_6968b3987ee4c3ec0b4ee3b9
        in: query
        name: id
        required: true
        schema:
          description: Actor id to resolve; repeat the parameter for several ids (at most 100 per call, each at most 64 characters).
          examples:
          - *id167
          items:
            examples:
            - agnt_6968b3984d1c238dbe7e2e29
            maxLength: 64
            type: string
          maxItems: 100
          minItems: 1
          title: Id
          type: array
      responses:
        '200':
          content:
            application/json:
              example: *id168
              schema:
                $ref: '#/components/schemas/ActorLookupResponse'
          description: Successful Response
        '400':
          content:
            application/problem+json:
              example: *id169
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Bad Request
        '401':
          content:
            application/problem+json:
              example: *id170
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unauthorized
        '403':
          content:
            application/problem+json:
              example: *id171
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Forbidden
        '422':
          content:
            application/problem+json:
              example: *id172
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unprocessable Entity
        '500':
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Internal Server Error
        '503':
          content:
            application/problem+json:
              example: *id173
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Service Unavailable
        default:
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unexpected error, as RFC 9457 Problem Details.
      security:
      - BearerAuth: []
      - OAuth2: []
      summary: Resolve actor names by id
      tags:
      - Actors
    summary: Resolve actor names by id
  /admin/config/providers:
    description: '`GET`: List credential provider configs.'
    get:
      description: List all stored provider configs, with secret fields redacted.
      operationId: listProviderConfigs
      responses:
        '200':
          content:
            application/json:
              example: *id174
              schema:
                $ref: '#/components/schemas/ProviderConfigListResponse'
          description: Successful Response
        '400':
          content:
            application/problem+json:
              example: *id169
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Bad Request
        '401':
          content:
            application/problem+json:
              example: *id170
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unauthorized
        '403':
          content:
            application/problem+json:
              example: *id171
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Forbidden
        '422':
          content:
            application/problem+json:
              example: *id172
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unprocessable Entity
        '500':
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Internal Server Error
        '503':
          content:
