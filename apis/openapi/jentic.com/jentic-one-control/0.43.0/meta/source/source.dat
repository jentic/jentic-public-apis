  /audit:
    description: '`GET`: List Audit Entries.'
    get:
      description: |-
        List audit entries with optional filters.

        Scoped to the caller: their own entries plus those made by agents they own.
        Org admins see every entry.
      operationId: listAuditEntries
      parameters:
      - description: Only return entries for this target type; must be sent together with `target_id`.
        examples:
          example:
            summary: Example query value for `target_type`
            value: agent
        in: query
        name: target_type
        required: false
        schema:
          anyOf:
          - $ref: '#/components/schemas/AuditTargetType'
          - type: 'null'
          description: Only return entries for this target type; must be sent together with `target_id`.
          examples:
          - agent
          title: Target Type
      - description: Only return entries for this target ID; must be sent together with `target_type`.
        examples:
          example:
            summary: Agent ID
            value: agnt_6968b3984d1c238dbe7e2e29
        in: query
        name: target_id
        required: false
        schema:
          anyOf:
          - examples:
            - agnt_6968b3984d1c238dbe7e2e29
            type: string
          - type: 'null'
          description: Only return entries for this target ID; must be sent together with `target_type`.
          examples:
          - agnt_6968b3984d1c238dbe7e2e29
          title: Target Id
      - description: Only return entries made by this actor.
        examples:
          example:
            summary: Agent ID
            value: agnt_6968b3984d1c238dbe7e2e29
        in: query
        name: actor_id
        required: false
        schema:
          anyOf:
          - examples:
            - agnt_6968b3984d1c238dbe7e2e29
            type: string
          - type: 'null'
          description: Only return entries made by this actor.
          examples:
          - agnt_6968b3984d1c238dbe7e2e29
          title: Actor Id
      - description: Only return entries initiated from this surface, e.g. `dashboard` or `cli`.
        examples:
          example:
            summary: Example query value for `origin`
            value: dashboard
        in: query
        name: origin
        required: false
        schema:
          anyOf:
          - examples:
            - dashboard
            type: string
          - type: 'null'
          description: Only return entries initiated from this surface, e.g. `dashboard` or `cli`.
          examples:
          - dashboard
          title: Origin
      - description: Only return entries that occurred at or after this time (RFC 3339).
        examples:
          example:
            summary: Start of a time window (RFC 3339)
            value: '2026-01-01T00:00:00Z'
        in: query
        name: since
        required: false
        schema:
          anyOf:
          - examples:
            - '2026-01-01T00:00:00Z'
            format: date-time
            type: string
          - type: 'null'
          description: Only return entries that occurred at or after this time (RFC 3339).
          examples:
          - '2026-01-01T00:00:00Z'
          title: Since
      - description: Only return entries that occurred at or before this time (RFC 3339).
        examples:
          example:
            summary: End of a time window (RFC 3339)
            value: '2026-01-31T23:59:59Z'
        in: query
        name: until
        required: false
        schema:
          anyOf:
          - examples:
            - '2026-01-31T23:59:59Z'
            format: date-time
            type: string
          - type: 'null'
          description: Only return entries that occurred at or before this time (RFC 3339).
          examples:
          - '2026-01-31T23:59:59Z'
          title: Until
      - description: Opaque cursor from a previous page's `next_cursor`; omit for the first page.
        examples:
          example:
            summary: Opaque cursor from a previous page
            value: eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
        in: query
        name: cursor
        required: false
        schema:
          anyOf:
          - examples:
            - eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
            type: string
          - type: 'null'
          description: Opaque cursor from a previous page's `next_cursor`; omit for the first page.
          examples:
          - eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
          title: Cursor
      - description: Maximum number of entries to return (1-200, default 50).
        examples:
          example:
            summary: Example query value for `limit`
            value: 25
        in: query
        name: limit
        required: false
        schema:
          default: 50
          description: Maximum number of entries to return (1-200, default 50).
          examples:
          - 25
          maximum: 200
          minimum: 1
          title: Limit
          type: integer
