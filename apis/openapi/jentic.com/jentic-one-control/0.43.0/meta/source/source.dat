    ApiKeyUpdateRequest:
      description: Update request for api_key credentials.
      examples:
      - active: true
        field_name: Authorization
        key: example-secret
        location: header
        name: Stripe live key
        runtime_config: &id015
          headers: *id013
          query_params: *id014
        server_variables: &id016
          region: eu
        type: api_key
      properties:
        active:
          anyOf:
          - type: boolean
          - type: 'null'
          description: Enable or disable the credential for injection; omit to leave unchanged.
          examples:
          - true
          title: Active
        field_name:
          anyOf:
          - type: string
          - type: 'null'
          description: Immutable after create. Accepted for backward compatibility; if provided it must equal the stored value, otherwise the request is rejected. Recreate the credential to change the parameter name.
          examples:
          - Authorization
          title: Field Name
        key:
          anyOf:
          - type: string
          - type: 'null'
          description: Replacement API key; omit to leave unchanged.
          examples:
          - example-secret
          title: Key
          x-sensitive: true
        location:
          anyOf:
          - $ref: '#/components/schemas/CredentialLocation'
          - type: 'null'
          description: Immutable after create. Accepted for backward compatibility; if provided it must equal the stored value, otherwise the request is rejected. Recreate the credential to change the injection binding.
          examples:
          - header
        name:
          anyOf:
          - type: string
          - type: 'null'
          description: New label for the credential; omit to leave unchanged.
          examples:
          - Stripe live key
          title: Name
        runtime_config:
          anyOf:
          - $ref: '#/components/schemas/RuntimeConfig'
          - type: 'null'
          description: Per-upstream-call overrides; reserved and not currently applied.
          examples:
          - *id015
        server_variables:
          anyOf:
          - additionalProperties:
              type: string
            type: object
          - type: 'null'
          description: Replacement OpenAPI server-variable values; omit to leave unchanged.
          examples:
          - *id016
          title: Server Variables
        type:
          const: api_key
          description: Credential type; always `api_key`.
          examples:
          - api_key
          title: Type
          type: string
      required:
      - type
      title: ApiKeyUpdateRequest
      type: object
