    description: '`GET`: Get an API revision. `DELETE`: Delete an archived API revision.'
    get:
      description: |-
        Get one revision's metadata and lifecycle state.

        Returns the same fields as an entry in the revision list: `state`,
        `is_current`, source, spec digest, operation count, timestamps, and links
        to the actions valid in its state. This is metadata only — download the
        spec itself from `.../revisions/{revision_id}/openapi`. 404 if the API or
        revision does not exist.
      operationId: getApiRevision
      parameters:
      - description: Vendor of the API.
        examples:
          example:
            summary: API vendor domain
            value: stripe.com
        in: path
        name: vendor
        required: true
        schema:
          description: Vendor of the API.
          examples:
          - stripe.com
          title: Vendor
          type: string
      - description: Name of the API.
        examples:
          example:
            summary: API name
            value: stripe
        in: path
        name: name
        required: true
        schema:
          description: Name of the API.
          examples:
          - stripe
          title: Name
          type: string
      - description: Version of the API.
        examples:
          example:
            summary: API version
            value: '2024-04-10'
        in: path
        name: version
        required: true
        schema:
          description: Version of the API.
          examples:
          - '2024-04-10'
          title: Version
          type: string
      - description: ID of the API revision.
        examples:
          example:
            summary: Revision ID (UUID)
            value: 3f2b8c1e-7d4a-4e9b-a6c5-1d2e3f4a5b6c
        in: path
        name: revision_id
        required: true
        schema:
          description: ID of the API revision.
          examples:
          - 3f2b8c1e-7d4a-4e9b-a6c5-1d2e3f4a5b6c
          title: Revision Id
          type: string
      responses:
        '200':
          content:
            application/json:
              schema: {}
          description: Successful Response
        '400':
          content:
            application/problem+json:
              example: *id169
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Bad Request
        '401':
