  /connect-sessions:
    description: '`GET`: List connect sessions.'
    get:
      description: |-
        List connect sessions with cursor-based pagination.

        Rows are slim summaries scoped to the caller (initiator-owned;
        ``org:admin`` sees all; a delegated agent holding
        ``owner:credentials:read`` also sees its owner's sessions). The
        ``poll_token`` capability is never included.
      operationId: listConnectSessions
      parameters:
      - description: Filter by session state
        examples:
          example:
            summary: Example query value for `state`
            value: polling
        in: query
        name: state
        required: false
        schema:
          anyOf:
          - enum:
            - created
            - awaiting_app
            - polling
            - connected
            examples:
            - polling
            type: string
          - type: 'null'
          description: Filter by session state
          examples:
          - polling
          title: State
      - description: Filter by vendor registry key
        examples:
          example:
            summary: Vendor registry key
            value: github
        in: query
        name: vendor
        required: false
        schema:
          anyOf:
          - examples:
            - github
            type: string
          - type: 'null'
          description: Filter by vendor registry key
          examples:
          - github
          title: Vendor
      - description: Opaque cursor from a previous page's next_cursor; omit for the first page.
        examples:
          example:
            summary: Opaque cursor from a previous page
            value: eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
        in: query
        name: cursor
        required: false
        schema:
          anyOf:
          - examples:
            - eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
            type: string
          - type: 'null'
          description: Opaque cursor from a previous page's next_cursor; omit for the first page.
          examples:
          - eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
          title: Cursor
      - description: Maximum number of sessions to return (1-200, default 50).
        examples:
          example:
            summary: Example query value for `limit`
            value: 25
        in: query
        name: limit
        required: false
        schema:
          default: 50
          description: Maximum number of sessions to return (1-200, default 50).
          examples:
          - 25
          maximum: 200
          minimum: 1
          title: Limit
          type: integer
      responses:
        '200':
          content:
            application/json:
              example: *id220
              schema:
                $ref: '#/components/schemas/ConnectSessionListResponse'
          description: Successful Response
        '400':
          content:
            application/problem+json:
              example: *id169
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Bad Request
        '401':
          content:
            application/problem+json:
              example: *id170
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unauthorized
        '403':
          content:
            application/problem+json:
              example: *id171
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Forbidden
        '422':
          content:
            application/problem+json:
              example: *id172
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unprocessable Entity
        '500':
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Internal Server Error
        '503':
          content:
            application/problem+json:
              example: *id173
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Service Unavailable
        default:
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unexpected error, as RFC 9457 Problem Details.
      security:
      - BearerAuth: []
      - OAuth2: []
      summary: List connect sessions
      tags:
      - Integrations
    summary: List connect sessions
  /connect-sessions/{session_id}:
    description: '`GET`: Get review data for a connect session.'
    get:
      description: |-
        Data the review page needs: vendor display name, resolved flow, the
        scope catalog flagged with default/requested, current state, reason.

        Gated by the session's ``poll_token`` capability (rides the approval
        URL / the ``:connect`` response), or by being the target agent's owner
        or ``org:admin`` — ``credentials:write`` alone must not read arbitrary
        sessions' review data. Missing session, token mismatch and a caller who
        is neither all surface as 403, matching ``/status`` (no session-id
        enumeration oracle).
      operationId: getConnectSession
      parameters:
      - description: ID of the connect session.
        examples:
          example:
            summary: Connect session ID
            value: cs_6968b3983b8b91c75627bee5
        in: path
        name: session_id
        required: true
        schema:
          description: ID of the connect session.
          examples:
          - cs_6968b3983b8b91c75627bee5
          title: Session Id
          type: string
      - description: 'Opaque poll capability returned by :connect. Optional for the target agent''s owner (with credentials:write and agents:write) and org:admin. Deliberately a query parameter: it rides the approval URL a human opens in a browser, where a header cannot be set. It is a short-lived, single-session capability, not a reusable credential, and it only scopes reads/actions on that one connect session.'
        examples:
          example:
            summary: Opaque flow handle
            value: dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk
        in: query
        name: poll_token
        required: false
        schema:
          anyOf:
          - examples:
            - dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk
            type: string
          - type: 'null'
          description: 'Opaque poll capability returned by :connect. Optional for the target agent''s owner (with credentials:write and agents:write) and org:admin. Deliberately a query parameter: it rides the approval URL a human opens in a browser, where a header cannot be set. It is a short-lived, single-session capability, not a reusable credential, and it only scopes reads/actions on that one connect session.'
          examples:
          - dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk
          title: Poll Token
      responses:
        '200':
          content:
            application/json:
              schema: {}
          description: Successful Response
        '400':
          content:
            application/problem+json:
              example: *id169
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Bad Request
        '401':
          content:
            application/problem+json:
              example: *id170
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unauthorized
        '403':
          content:
            application/problem+json:
              example: *id171
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Forbidden
        '409':
          content:
            application/problem+json:
              example: *id218
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: The session's OAuth app changed; start a new session
        '422':
          content:
            application/problem+json:
              example: *id172
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unprocessable Entity
        '500':
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Internal Server Error
        '503':
          content:
            application/problem+json:
              example: *id173
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Service Unavailable
        default:
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unexpected error, as RFC 9457 Problem Details.
      security:
      - BearerAuth: []
      - OAuth2: []
      summary: Get review data for a connect session
      tags:
      - Integrations
    summary: Get review data for a connect session
  /connect-sessions/{session_id}/status:
    description: '`GET`: Poll a connect session''s status.'
    get:
      description: |-
        Poll the lifecycle status of a connect session.

        Returns the session's current ``status`` and, once it has connected, the
        resulting ``credential_id``, the account it ``connected_as``, and the
        ``bound_scopes``; a failed session carries an ``error_code``. Agents and the
        SPA poll this after ``:connect`` until the status is terminal.

        Auth is intentionally lightweight: the caller must be authenticated with
        ``credentials:connect`` or ``credentials:write``, but the real capability
        that scopes the response is the session's ``poll_token`` (or being the
        target agent's owner / ``org:admin``). An agent handed the token by
        ``:connect`` can poll without full session-read rights. A missing session,
        a ``poll_token`` mismatch, and a caller who is neither all answer a uniform
        403, so the endpoint is not a session-id enumeration oracle.
      operationId: pollConnectSessionStatus
      parameters:
      - description: ID of the connect session.
        examples:
          example:
            summary: Connect session ID
            value: cs_6968b3983b8b91c75627bee5
        in: path
        name: session_id
        required: true
        schema:
          description: ID of the connect session.
          examples:
          - cs_6968b3983b8b91c75627bee5
          title: Session Id
          type: string
      - description: 'Opaque poll capability returned by :connect. Optional for the target agent''s owner (with credentials:write and agents:write) and org:admin. Deliberately a query parameter: it rides the approval URL a human opens in a browser, where a header cannot be set. It is a short-lived, single-session capability, not a reusable credential, and it only scopes reads/actions on that one connect session.'
        examples:
          example:
            summary: Opaque flow handle
            value: dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk
        in: query
        name: poll_token
        required: false
        schema:
          anyOf:
          - examples:
            - dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk
            type: string
          - type: 'null'
          description: 'Opaque poll capability returned by :connect. Optional for the target agent''s owner (with credentials:write and agents:write) and org:admin. Deliberately a query parameter: it rides the approval URL a human opens in a browser, where a header cannot be set. It is a short-lived, single-session capability, not a reusable credential, and it only scopes reads/actions on that one connect session.'
          examples:
          - dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk
          title: Poll Token
      responses:
        '200':
          content:
            application/json:
              schema: {}
          description: Successful Response
        '400':
          content:
            application/problem+json:
              example: *id169
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Bad Request
        '401':
          content:
            application/problem+json:
              example: *id170
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unauthorized
        '403':
          content:
            application/problem+json:
              example: *id171
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Forbidden
        '422':
          content:
            application/problem+json:
              example: *id172
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unprocessable Entity
        '500':
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Internal Server Error
        '503':
          content:
            application/problem+json:
              example: *id173
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Service Unavailable
        default:
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unexpected error, as RFC 9457 Problem Details.
      security:
      - BearerAuth: []
      - OAuth2: []
      summary: Poll a connect session's status
      tags:
      - Integrations
    summary: Poll a connect session's status
  /connect-sessions/{session_id}:cancel:
    description: '`POST`: Cancel an in-flight connect session.'
    post:
      description: |-
        Terminate a still-active session at the user's request.

        Gated like ``/status`` — the ``poll_token`` the SPA already holds, or
        the target agent's owner / ``org:admin`` without it.

        A still-existing but already-terminal session is a 204 no-op — a
        "Cancel" click racing the poll scanner doesn't error. A session
        that has already been cascade-deleted (unhappy-terminal path in
        ``_mark_terminal``) surfaces as 403, matching ``/status`` — the
        caller can't distinguish "gone" from "your poll_token is wrong",
        which is the enumeration-oracle guard. The SPA's cancel-on-unmount
        is fire-and-forget and ``.catch``es the 403, so this doesn't leak
        into the UX.
      operationId: cancelConnectSession
      parameters:
      - description: ID of the connect session.
        examples:
          example:
            summary: Connect session ID
            value: cs_6968b3983b8b91c75627bee5
        in: path
        name: session_id
        required: true
        schema:
          description: ID of the connect session.
          examples:
          - cs_6968b3983b8b91c75627bee5
          title: Session Id
          type: string
      - description: 'Opaque poll capability returned by :connect. Optional for the target agent''s owner (with credentials:write and agents:write) and org:admin. Deliberately a query parameter: it rides the approval URL a human opens in a browser, where a header cannot be set. It is a short-lived, single-session capability, not a reusable credential, and it only scopes reads/actions on that one connect session.'
        examples:
          example:
            summary: Opaque flow handle
            value: dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk
        in: query
        name: poll_token
        required: false
        schema:
          anyOf:
          - examples:
            - dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk
            type: string
          - type: 'null'
          description: 'Opaque poll capability returned by :connect. Optional for the target agent''s owner (with credentials:write and agents:write) and org:admin. Deliberately a query parameter: it rides the approval URL a human opens in a browser, where a header cannot be set. It is a short-lived, single-session capability, not a reusable credential, and it only scopes reads/actions on that one connect session.'
          examples:
          - dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk
          title: Poll Token
      responses:
        '204':
          description: Successful Response
        '400':
          content:
            application/problem+json:
              example: *id169
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Bad Request
        '401':
          content:
            application/problem+json:
              example: *id170
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unauthorized
        '403':
          content:
            application/problem+json:
              example: *id171
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Forbidden
        '422':
          content:
            application/problem+json:
              example: *id172
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unprocessable Entity
        '500':
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Internal Server Error
        '503':
          content:
            application/problem+json:
              example: *id173
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Service Unavailable
        default:
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unexpected error, as RFC 9457 Problem Details.
      security:
      - BearerAuth: []
      - OAuth2: []
      summary: Cancel an in-flight connect session
      tags:
      - Integrations
    summary: Cancel an in-flight connect session
  /connect-sessions/{session_id}:confirm:
    description: '`POST`: Confirm a connect session.'
    post:
      description: |-
        Called by the review page after the human confirms selections.

        The body's ``kind`` picks the variant (no ``kind`` is the OAuth
        variant): OAuth scopes, a secret for a ``manual_*`` session
        (``api_key`` / ``bearer`` / ``basic``), the approver's own OAuth client
        for an ``awaiting_app`` session, or a credential the approver already
        holds (``existing_credential``, ``reauthorize``). Secrets are write-only:
        they never appear in a response, audit entry or log.

        Shares the ``:connect`` per-actor rate bucket — this is the endpoint
        that actually fires the vendor's device-authorization call, and a
        failed ``begin`` leaves the session retryable, so it must not be
        free to hammer during a vendor incident. Gated like the review read
        (``poll_token`` or owner / ``org:admin``; 403 otherwise).
      operationId: confirmConnectSession
      parameters:
      - description: ID of the connect session.
        examples:
          example:
            summary: Connect session ID
            value: cs_6968b3983b8b91c75627bee5
        in: path
        name: session_id
        required: true
        schema:
          description: ID of the connect session.
          examples:
          - cs_6968b3983b8b91c75627bee5
          title: Session Id
          type: string
      - description: 'Opaque poll capability returned by :connect. Optional for the target agent''s owner (with credentials:write and agents:write) and org:admin. Deliberately a query parameter: it rides the approval URL a human opens in a browser, where a header cannot be set. It is a short-lived, single-session capability, not a reusable credential, and it only scopes reads/actions on that one connect session.'
        examples:
          example:
            summary: Opaque flow handle
            value: dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk
        in: query
        name: poll_token
        required: false
        schema:
          anyOf:
          - examples:
            - dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk
            type: string
          - type: 'null'
          description: 'Opaque poll capability returned by :connect. Optional for the target agent''s owner (with credentials:write and agents:write) and org:admin. Deliberately a query parameter: it rides the approval URL a human opens in a browser, where a header cannot be set. It is a short-lived, single-session capability, not a reusable credential, and it only scopes reads/actions on that one connect session.'
          examples:
          - dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk
          title: Poll Token
      requestBody:
        content:
          application/json:
            schema:
              description: How to complete the session, selected by `kind`. A body without `kind` is the `oauth` variant.
              discriminator:
                mapping:
                  api_key: '#/components/schemas/ApiKeyConfirmSessionRequest'
                  basic: '#/components/schemas/BasicConfirmSessionRequest'
                  bearer: '#/components/schemas/BearerConfirmSessionRequest'
                  existing_credential: '#/components/schemas/ExistingCredentialConfirmSessionRequest'
                  oauth: '#/components/schemas/OAuthConfirmSessionRequest'
                  own_oauth_client: '#/components/schemas/OwnOAuthClientConfirmSessionRequest'
                  reauthorize: '#/components/schemas/ReauthorizeConfirmSessionRequest'
                propertyName: kind
              oneOf:
              - $ref: '#/components/schemas/OAuthConfirmSessionRequest'
              - $ref: '#/components/schemas/ApiKeyConfirmSessionRequest'
              - $ref: '#/components/schemas/BearerConfirmSessionRequest'
              - $ref: '#/components/schemas/BasicConfirmSessionRequest'
              - $ref: '#/components/schemas/OwnOAuthClientConfirmSessionRequest'
              - $ref: '#/components/schemas/ExistingCredentialConfirmSessionRequest'
              - $ref: '#/components/schemas/ReauthorizeConfirmSessionRequest'
              title: Body
        description: How to complete the session, selected by `kind`. A body without `kind` is the `oauth` variant.
        required: true
      responses:
        '200':
          content:
            application/json:
              schema: {}
          description: Successful Response
        '400':
          content:
            application/problem+json:
              example: *id169
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Bad Request
        '401':
          content:
            application/problem+json:
              example: *id170
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unauthorized
        '403':
          content:
            application/problem+json:
              example: *id171
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Forbidden
        '404':
          content:
            application/problem+json:
              example: *id180
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Not Found
        '409':
          content:
            application/problem+json:
              example: *id218
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Session not awaiting confirmation, its OAuth app, scheme or hosts changed, or the review is stale
        '422':
          content:
            application/problem+json:
              example: *id172
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unprocessable Entity
        '500':
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Internal Server Error
        '503':
          content:
            application/problem+json:
              example: *id173
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Service Unavailable
        default:
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unexpected error, as RFC 9457 Problem Details.
      security:
      - BearerAuth: []
      - OAuth2: []
      summary: Confirm a connect session
      tags:
      - Integrations
    summary: Confirm a connect session
  /connect-sessions/{session_id}:reject:
    description: '`POST`: Reject an agent''s connect request.'
    post:
      description: |-
        End the session as rejected — the approve dialog's explicit Reject.

        Only the target agent's owner (holding ``credentials:write`` and
        ``agents:write``) or ``org:admin``; there is no poll-token path and an
        agent can never reject. Everyone else gets the uniform 403. The agent's
        ``/status`` then reports ``failed`` with ``error_code: rejected``, and
        its repeat ``:connect`` for the same target answers 429
        ``recently_rejected`` for the rejection cooldown. Closing the dialog
        without rejecting makes no call; an unmount cancel stays ``cancelled``.
      operationId: rejectConnectSession
      parameters:
      - description: ID of the connect session.
        examples:
          example:
            summary: Connect session ID
            value: cs_6968b3983b8b91c75627bee5
        in: path
        name: session_id
        required: true
        schema:
          description: ID of the connect session.
          examples:
          - cs_6968b3983b8b91c75627bee5
          title: Session Id
          type: string
      responses:
        '204':
          description: Successful Response
        '400':
          content:
            application/problem+json:
              example: *id169
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Bad Request
        '401':
          content:
            application/problem+json:
              example: *id170
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unauthorized
        '403':
          content:
            application/problem+json:
              example: *id171
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Forbidden
        '422':
          content:
            application/problem+json:
              example: *id172
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unprocessable Entity
        '500':
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Internal Server Error
        '503':
          content:
            application/problem+json:
              example: *id173
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Service Unavailable
        default:
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unexpected error, as RFC 9457 Problem Details.
      security:
      - BearerAuth: []
      - OAuth2: []
      summary: Reject an agent's connect request
      tags:
      - Integrations
    summary: Reject an agent's connect request
  /credentials:
