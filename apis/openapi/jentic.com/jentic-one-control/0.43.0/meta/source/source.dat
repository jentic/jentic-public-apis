        examples:
          example:
            summary: Agent ID
            value: agnt_6968b3984d1c238dbe7e2e29
        in: query
        name: actor_id
        required: false
        schema:
          anyOf:
          - examples:
            - agnt_6968b3984d1c238dbe7e2e29
            type: string
          - type: 'null'
