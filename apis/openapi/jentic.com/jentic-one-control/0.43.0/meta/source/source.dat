  /monitoring/usage:
    description: '`GET`: Get Usage Stats.'
    get:
      description: Return detailed usage statistics for the monitoring overview.
      operationId: getUsageStats
      parameters:
      - description: Start of the window in Unix epoch seconds (inclusive); defaults to 24 hours before `until`.
        examples:
          example:
            summary: Example query value for `since`
            value: 1767225600
        in: query
        name: since
        required: false
        schema:
          anyOf:
          - examples:
            - 1767225600
            type: integer
          - type: 'null'
          description: Start of the window in Unix epoch seconds (inclusive); defaults to 24 hours before `until`.
          examples:
          - 1767225600
          title: Since
      - description: End of the window in Unix epoch seconds (exclusive); defaults to the next minute boundary after now.
        examples:
          example:
            summary: Example query value for `until`
            value: 1769903999
        in: query
        name: until
        required: false
        schema:
          anyOf:
          - examples:
            - 1769903999
            type: integer
          - type: 'null'
          description: End of the window in Unix epoch seconds (exclusive); defaults to the next minute boundary after now.
          examples:
          - 1769903999
          title: Until
      - description: Dimension to group the `top` rows by; defaults to `api`.
        examples:
          example:
            summary: Example query value for `group_by`
            value: api
        in: query
        name: group_by
        required: false
        schema:
          anyOf:
          - $ref: '#/components/schemas/GroupBy'
          - type: 'null'
          description: Dimension to group the `top` rows by; defaults to `api`.
          examples:
          - api
          title: Group By
      - description: Maximum number of `top` rows to return (1-50, default 10).
        examples:
          example:
            summary: Example query value for `top_limit`
            value: 10
        in: query
        name: top_limit
        required: false
        schema:
          default: 10
          description: Maximum number of `top` rows to return (1-50, default 10).
          examples:
          - 10
          maximum: 50
          minimum: 1
          title: Top Limit
          type: integer
      - description: 'Legacy: only count executions mediated by this toolkit.'
        examples:
          example:
            summary: Toolkit ID
            value: tk_6968b3981ec22d56dbbc91e8
        in: query
        name: toolkit_id
        required: false
        schema:
          anyOf:
          - examples:
            - tk_6968b3981ec22d56dbbc91e8
            type: string
          - type: 'null'
          description: 'Legacy: only count executions mediated by this toolkit.'
          examples:
          - tk_6968b3981ec22d56dbbc91e8
          title: Toolkit Id
      - description: Only count executions of this API, given as `vendor/name`.
        examples:
          example:
            summary: API vendor and name (vendor/name)
            value: stripe.com/stripe
        in: query
        name: api_id
        required: false
        schema:
          anyOf:
          - examples:
            - stripe.com/stripe
            type: string
          - type: 'null'
          description: Only count executions of this API, given as `vendor/name`.
          examples:
          - stripe.com/stripe
          title: Api Id
      - description: Only count executions run by this actor ID.
        examples:
          example:
            summary: Agent ID
            value: agnt_6968b3984d1c238dbe7e2e29
        in: query
        name: agent_id
        required: false
        schema:
          anyOf:
          - examples:
            - agnt_6968b3984d1c238dbe7e2e29
            type: string
          - type: 'null'
          description: Only count executions run by this actor ID.
          examples:
          - agnt_6968b3984d1c238dbe7e2e29
          title: Agent Id
      - description: Only count executions with this status, e.g. `completed` or `failed`.
        examples:
          example:
            summary: Example query value for `status`
            value: completed
        in: query
        name: status
        required: false
        schema:
          anyOf:
          - examples:
            - completed
            type: string
          - type: 'null'
          description: Only count executions with this status, e.g. `completed` or `failed`.
