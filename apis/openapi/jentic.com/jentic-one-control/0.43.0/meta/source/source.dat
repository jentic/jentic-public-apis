  /catalog/{api_id}:snooze:
    description: '`POST`: Snooze Catalog Entry.'
    post:
      description: |-
        Snooze the outstanding update notification for a catalog entry (C1, #925).

        Operator action (``events:write``): quiet the "update available" badge for a
        known-and-accepted upstream change without adopting it. Body is optional — omit or send
        ``{"snoozed_until": null}`` to mute until a newer upstream digest lands (the primary
        per-API affordance); send an ISO-8601 ``snoozed_until`` for a time-boxed snooze. A
        genuinely newer upstream change re-lights the badge automatically.
      operationId: snoozeCatalogEntry
      parameters:
      - description: Catalog identity of the API (`domain[/sub-api]`); send any `/` unencoded.
        examples:
          example:
            summary: API vendor domain
            value: stripe.com
        in: path
        name: api_id
        required: true
        schema:
          description: Catalog identity of the API (`domain[/sub-api]`); send any `/` unencoded.
          examples:
          - stripe.com
          title: Api Id
          type: string
      requestBody:
        content:
          application/json:
            schema:
              anyOf:
              - $ref: '#/components/schemas/CatalogSnoozeRequest'
              - type: 'null'
              title: Body
        description: Request payload for the `snoozeCatalogEntry` operation.
      responses:
        '204':
          description: Successful Response
        '400':
          content:
            application/problem+json:
              example: *id169
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Bad Request
        '401':
          content:
            application/problem+json:
              example: *id170
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unauthorized
        '403':
          content:
            application/problem+json:
              example: *id171
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Forbidden
        '409':
          content:
            application/problem+json:
              example: *id218
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: The catalog entry has no outstanding update to snooze.
        '422':
          content:
            application/problem+json:
              example: *id172
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unprocessable Entity
        '500':
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Internal Server Error
        '503':
          content:
            application/problem+json:
              example: *id173
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Service Unavailable
        default:
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unexpected error, as RFC 9457 Problem Details.
      security:
      - BearerAuth: []
      - OAuth2: []
      summary: Snooze Catalog Entry
      tags:
      - Catalog
    summary: Snooze Catalog Entry
  /catalog/{api_id}:unsnooze:
    description: '`POST`: Unsnooze Catalog Entry.'
    post:
      description: Clear a snooze for a catalog entry (C1). Operator action (``events:write``).
