  /admin/oauth-grants:
    description: '`GET`: List OAuth grants.'
    get:
      description: |-
        List consent→agent grants across all clients and agents.

        The admin cross-view over the grant registry: filter by client, agent,
        consenting user, or status. Each item carries the client's display name
        and redirect-URI origin plus the consenting ``user_id`` — after an agent
        ownership transfer the grant stays with the original consenter, so this
        column is how an admin spots stranded grants.

        Scoped to the caller: org admins see every grant. Anyone else sees grants
        they consented to and grants bound to agents they own.
      operationId: listOauthGrants
      parameters:
      - description: Filter by the client's public client_id.
        examples:
          example:
            summary: Public OAuth client_id
            value: oc_Xk3vQ9mT2pLw8RzN5bYc1HdF7gJs4AeU
        in: query
        name: client_id
        required: false
        schema:
          anyOf:
          - examples:
            - oc_Xk3vQ9mT2pLw8RzN5bYc1HdF7gJs4AeU
            type: string
          - type: 'null'
          description: Filter by the client's public client_id.
          examples:
          - oc_Xk3vQ9mT2pLw8RzN5bYc1HdF7gJs4AeU
          title: Client Id
      - description: Filter by bound agent.
        examples:
          example:
            summary: Agent ID
            value: agnt_6968b3984d1c238dbe7e2e29
        in: query
        name: agent_id
        required: false
        schema:
          anyOf:
          - examples:
            - agnt_6968b3984d1c238dbe7e2e29
            type: string
          - type: 'null'
          description: Filter by bound agent.
          examples:
          - agnt_6968b3984d1c238dbe7e2e29
          title: Agent Id
      - description: Filter by consenting user.
        examples:
          example:
            summary: User ID
            value: usr_6968b3987ee4c3ec0b4ee3b9
        in: query
        name: user_id
        required: false
        schema:
          anyOf:
          - examples:
            - usr_6968b3987ee4c3ec0b4ee3b9
            type: string
          - type: 'null'
          description: Filter by consenting user.
          examples:
          - usr_6968b3987ee4c3ec0b4ee3b9
          title: User Id
      - description: Filter by grant lifecycle state.
        examples:
          example:
            summary: Example query value for `status`
            value: active
        in: query
        name: status
        required: false
        schema:
          anyOf:
          - enum:
            - active
            - revoked
            examples:
            - active
            type: string
          - type: 'null'
          description: Filter by grant lifecycle state.
          examples:
          - active
          title: Status
      - description: Maximum number of grants to return (1-200, default 50).
        examples:
          example:
            summary: Example query value for `limit`
            value: 25
        in: query
        name: limit
        required: false
        schema:
          default: 50
          description: Maximum number of grants to return (1-200, default 50).
          examples:
          - 25
          maximum: 200
          minimum: 1
          title: Limit
          type: integer
      - description: Opaque cursor from a previous page's `next_cursor`; omit for the first page.
        examples:
          example:
            summary: Opaque cursor from a previous page
            value: eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
        in: query
        name: cursor
        required: false
        schema:
          anyOf:
          - examples:
            - eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
            type: string
          - type: 'null'
          description: Opaque cursor from a previous page's `next_cursor`; omit for the first page.
          examples:
          - eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
          title: Cursor
      responses:
        '200':
          content:
            application/json:
              example: *id183
              schema:
                $ref: '#/components/schemas/OAuthGrantAdminListResponse'
          description: Successful Response
        '400':
          content:
            application/problem+json:
              example: *id169
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Bad Request
        '401':
          content:
            application/problem+json:
              example: *id170
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unauthorized
        '403':
          content:
            application/problem+json:
              example: *id171
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Forbidden
        '422':
          content:
            application/problem+json:
              example: *id172
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unprocessable Entity
        '500':
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Internal Server Error
        '503':
          content:
            application/problem+json:
              example: *id173
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Service Unavailable
        default:
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unexpected error, as RFC 9457 Problem Details.
      security:
      - BearerAuth: []
      - OAuth2: []
      summary: List OAuth grants
      tags:
      - OAuth
    summary: List OAuth grants
  /agents:
    description: '`POST`: Create an agent. `GET`: List visible agents.'
    get:
      description: |-
        List the agents the caller can see, newest first.

        Visibility is scoped to the caller: `org:admin` sees every agent; anyone
        else sees the agents they own. An agent caller also sees itself, and with
        `owner:agents:read` its owner's agents. Filter by lifecycle `status`
        (`pending`, `active`, `rejected`, `disabled`, `archived`). Results are
        cursor-paginated: pass `next_cursor` from the previous page as `cursor`
        while `has_more` is true.
      operationId: listAgents
      parameters:
      - description: Cursor from a previous page's `next_cursor`; omit for the first page.
        examples:
          example:
            summary: Opaque cursor from a previous page
            value: eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
        in: query
        name: cursor
        required: false
        schema:
          anyOf:
          - examples:
            - eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
            type: string
          - type: 'null'
          description: Cursor from a previous page's `next_cursor`; omit for the first page.
          examples:
          - eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
          title: Cursor
      - description: Maximum number of agents to return (1-200, default 50).
        examples:
          example:
            summary: Example query value for `limit`
            value: 25
        in: query
        name: limit
        required: false
        schema:
          default: 50
          description: Maximum number of agents to return (1-200, default 50).
          examples:
          - 25
          maximum: 200
          minimum: 1
          title: Limit
          type: integer
      - description: 'Only return agents in this lifecycle status: `pending`, `active`, `rejected`, `disabled` or `archived`.'
        examples:
          example:
            summary: Example query value for `status`
            value: active
        in: query
        name: status
        required: false
        schema:
          anyOf:
          - examples:
            - active
            type: string
          - type: 'null'
          description: 'Only return agents in this lifecycle status: `pending`, `active`, `rejected`, `disabled` or `archived`.'
          examples:
          - active
          title: Status
      responses:
        '200':
          content:
            application/json:
              example: *id184
              schema:
                $ref: '#/components/schemas/AgentListResponse'
          description: Successful Response
        '400':
          content:
            application/problem+json:
              example: *id169
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Bad Request
        '401':
          content:
            application/problem+json:
              example: *id170
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unauthorized
        '403':
          content:
            application/problem+json:
              example: *id171
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Forbidden
        '422':
          content:
            application/problem+json:
              example: *id172
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unprocessable Entity
        '500':
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Internal Server Error
        '503':
          content:
            application/problem+json:
              example: *id173
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Service Unavailable
        default:
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unexpected error, as RFC 9457 Problem Details.
      security:
      - BearerAuth: []
      - OAuth2: []
      summary: List visible agents
      tags:
      - Agents
    post:
      description: |-
        Create an agent owned by the caller.

        The agent is `active` immediately and owned by the caller. Supply `name`
        (required), an optional `description`, and optional `permissions`. When
        `permissions` is omitted the agent gets the default agent permission set.
        When supplied, every permission must be one the caller may grant (see
        `grantable_by_caller` on `GET /permissions`); otherwise the request fails
        with 403 (`agent_permission_not_grantable`). Returns the created agent.

        The agent has no way to authenticate yet. Follow up with
        `POST /agents/{agent_id}:generate-api-key` (or `PUT /agents/{agent_id}/jwks`
        for JWT-bearer), and bind credentials with `POST /agents/{agent_id}/credentials`.
      operationId: createAgent
      requestBody:
        content:
          application/json:
            example: *id185
            schema:
              $ref: '#/components/schemas/AgentCreateRequest'
        description: Request body for creating an agent manually.
        required: true
      responses:
        '201':
          content:
            application/json:
              example: *id186
              schema:
                $ref: '#/components/schemas/AgentResponse'
          description: Successful Response
        '400':
          content:
            application/problem+json:
              example: *id169
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Bad Request
        '401':
          content:
            application/problem+json:
              example: *id170
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unauthorized
        '403':
          content:
            application/problem+json:
              example: *id171
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Forbidden
        '422':
          content:
            application/problem+json:
              example: *id172
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unprocessable Entity
        '500':
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Internal Server Error
        '503':
          content:
            application/problem+json:
              example: *id173
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Service Unavailable
        default:
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unexpected error, as RFC 9457 Problem Details.
      security:
      - BearerAuth: []
      - OAuth2: []
      summary: Create an agent
      tags:
      - Agents
    summary: Create an agent; List visible agents
  /agents/{agent_id}:
    delete:
      description: |-
        Archive an agent — or, with ``purge=true``, hard-delete it.

        Archive keeps the row for history, but the action is not reversible and
        the agent's authority is swept: permission grants, credential bindings, and
        OAuth consent grants are revoked. For the reversible kill switch use
        ``:disable`` / ``:enable`` instead.

        Purge removes the agent and its authority and session rows; it archives
        first if needed, so the agent's authority is gone before any cleanup runs,
        and a failed purge leaves the agent archived and can be retried. Archive
        returns 409 for an already-archived agent; purge accepts any status.
      operationId: archiveAgent
      parameters:
      - description: ID of the agent.
        examples:
          example:
            summary: Agent ID
            value: agnt_6968b3984d1c238dbe7e2e29
        in: path
        name: agent_id
        required: true
        schema:
          description: ID of the agent.
          examples:
          - agnt_6968b3984d1c238dbe7e2e29
          title: Agent Id
          type: string
      - description: 'Default false: the agent is archived (terminal-but-kept; its row stays for history). true hard-deletes the agent from any status, together with its tokens, consent grants, permission grants and rules, bindings and connect sessions, and cancels its queued and running jobs. History (audit entries, events, execution records, finished jobs, notes) and the credentials it created are kept; once the agent is gone that history is visible to org:admin only.'
        examples:
          example:
            summary: Example query value for `purge`
            value: true
        in: query
        name: purge
        required: false
        schema:
          default: false
          description: 'Default false: the agent is archived (terminal-but-kept; its row stays for history). true hard-deletes the agent from any status, together with its tokens, consent grants, permission grants and rules, bindings and connect sessions, and cancels its queued and running jobs. History (audit entries, events, execution records, finished jobs, notes) and the credentials it created are kept; once the agent is gone that history is visible to org:admin only.'
          examples:
          - true
          title: Purge
          type: boolean
      responses:
        '204':
          description: Successful Response
        '400':
          content:
            application/problem+json:
              example: *id169
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Bad Request
        '401':
          content:
            application/problem+json:
              example: *id170
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unauthorized
        '403':
          content:
            application/problem+json:
              example: *id171
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Forbidden
        '422':
          content:
            application/problem+json:
              example: *id172
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unprocessable Entity
        '500':
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Internal Server Error
        '503':
          content:
            application/problem+json:
              example: *id173
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Service Unavailable
        default:
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unexpected error, as RFC 9457 Problem Details.
      security:
      - BearerAuth: []
      - OAuth2: []
      summary: Archive Agent
      tags:
      - Agents
    description: '`GET`: Get an agent. `PATCH`: Update an agent. `DELETE`: Archive Agent.'
    get:
      description: |-
        Get one agent's profile and lifecycle state.

        Returns the agent's name, description, owner, `status`, approval or
        denial details, and whether it currently has an API key (`has_api_key`).
        Readable by the agent itself, its owner, and `org:admin`; an agent outside
        the caller's visibility answers 404.
      operationId: getAgent
      parameters:
      - description: ID of the agent.
        examples:
          example:
            summary: Agent ID
            value: agnt_6968b3984d1c238dbe7e2e29
        in: path
        name: agent_id
        required: true
        schema:
          description: ID of the agent.
          examples:
          - agnt_6968b3984d1c238dbe7e2e29
          title: Agent Id
          type: string
      responses:
        '200':
          content:
            application/json:
              example: *id186
              schema:
                $ref: '#/components/schemas/AgentResponse'
          description: Successful Response
        '400':
          content:
            application/problem+json:
              example: *id169
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Bad Request
        '401':
          content:
            application/problem+json:
              example: *id170
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unauthorized
        '403':
          content:
            application/problem+json:
              example: *id171
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Forbidden
        '422':
          content:
            application/problem+json:
              example: *id172
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unprocessable Entity
        '500':
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Internal Server Error
        '503':
          content:
            application/problem+json:
              example: *id173
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Service Unavailable
        default:
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unexpected error, as RFC 9457 Problem Details.
      security:
      - BearerAuth: []
      - OAuth2: []
      summary: Get an agent
      tags:
      - Agents
    patch:
      description: |-
        Partially update an agent's `name`, `description` or `owner_id`.

        Only the fields present in the body change; an empty body returns the
        agent unchanged. Allowed for the agent's owner or an `org:admin` (anyone
        else gets 404). Changing `owner_id` transfers ownership, is
        `org:admin`-only, and revokes every active OAuth client grant bound to
        the agent, so the new owner must re-consent any connected client. The
        agent's API key, permissions and credential bindings are unaffected. An
        archived agent cannot be updated (409). Returns the updated agent.
      operationId: updateAgent
      parameters:
      - description: ID of the agent.
        examples:
          example:
            summary: Agent ID
            value: agnt_6968b3984d1c238dbe7e2e29
        in: path
        name: agent_id
        required: true
        schema:
          description: ID of the agent.
          examples:
          - agnt_6968b3984d1c238dbe7e2e29
          title: Agent Id
          type: string
      requestBody:
        content:
          application/json:
            example: *id187
            schema:
              $ref: '#/components/schemas/AgentPatchRequest'
        description: Request body for partially updating an agent.
        required: true
      responses:
        '200':
          content:
            application/json:
              example: *id186
              schema:
                $ref: '#/components/schemas/AgentResponse'
          description: Successful Response
        '400':
          content:
            application/problem+json:
              example: *id169
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Bad Request
        '401':
          content:
            application/problem+json:
              example: *id170
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unauthorized
        '403':
          content:
            application/problem+json:
              example: *id171
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Forbidden
        '422':
          content:
            application/problem+json:
              example: *id172
              schema:
                $ref: '#/components/schemas/ProblemDetail'
