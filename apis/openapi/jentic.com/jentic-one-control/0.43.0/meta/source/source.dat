  /apis:
    description: '`GET`: List Apis. `POST`: Import Apis.'
    get:
      description: |-
        List locally registered APIs with optional vendor filter and pagination.

        This is the **imported** registry — APIs present in this deployment. The
        public catalog of importable-but-not-yet-imported APIs is a separate surface
        (``GET /catalog``); the two are not blended.
      operationId: listApis
      parameters:
      - description: Only return APIs from this vendor.
        examples:
          example:
            summary: API vendor domain
            value: stripe.com
        in: query
        name: vendor
        required: false
        schema:
          anyOf:
          - examples:
            - stripe.com
            type: string
          - type: 'null'
          description: Only return APIs from this vendor.
          examples:
          - stripe.com
          title: Vendor
      - description: Opaque cursor from a previous page's `next_cursor`; omit for the first page.
        examples:
          example:
            summary: Opaque cursor from a previous page
            value: eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
        in: query
        name: cursor
        required: false
        schema:
          anyOf:
          - examples:
            - eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
            type: string
          - type: 'null'
          description: Opaque cursor from a previous page's `next_cursor`; omit for the first page.
          examples:
          - eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
          title: Cursor
      - description: Maximum number of APIs to return (1-200).
        examples:
          example:
            summary: Example query value for `limit`
            value: 25
        in: query
        name: limit
        required: false
        schema:
          default: 50
          description: Maximum number of APIs to return (1-200).
          examples:
          - 25
          maximum: 200
          minimum: 1
          title: Limit
          type: integer
      responses:
        '200':
          content:
            application/json:
              example: *id199
              schema:
                $ref: '#/components/schemas/ApiListResponse'
          description: Successful Response
        '400':
          content:
            application/problem+json:
              example: *id169
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Bad Request
        '401':
          content:
            application/problem+json:
              example: *id170
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unauthorized
        '403':
          content:
            application/problem+json:
              example: *id171
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Forbidden
        '422':
          content:
            application/problem+json:
              example: *id172
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unprocessable Entity
        '500':
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Internal Server Error
        '503':
          content:
            application/problem+json:
              example: *id173
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Service Unavailable
        default:
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unexpected error, as RFC 9457 Problem Details.
      security:
      - BearerAuth: []
      - OAuth2: []
      summary: List Apis
      tags:
      - APIs
    post:
      description: Import OpenAPI/Arazzo content as new API revisions (async).
      operationId: importApis
      requestBody:
        content:
          application/json:
            example: *id200
            schema:
              $ref: '#/components/schemas/ApiImportRequest'
        description: Wrapper for a batch of import sources.
        required: true
      responses:
        '202':
          content:
            application/json:
              schema: {}
          description: Successful Response
