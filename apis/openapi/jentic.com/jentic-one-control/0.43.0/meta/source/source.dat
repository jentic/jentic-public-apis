components:
  schemas:
    APIReference:
      description: |-
        Identifies a target API — the strict (all-required) variant.

        Used in responses and as the canonical identity tuple.
      examples:
      - &id048
        name: stripe
        vendor: stripe.com
        version: '2024-04-10'
      properties:
        name:
          description: Name of the API within the vendor.
          examples:
          - stripe
          title: Name
          type: string
        vendor:
          description: Vendor of the API (for example `stripe.com`).
          examples:
          - stripe.com
          title: Vendor
          type: string
        version:
          description: Version of the API.
          examples:
          - '2024-04-10'
          title: Version
          type: string
      required:
      - vendor
      - name
      - version
      title: APIReference
      type: object
    APIReferenceRequest:
      description: Relaxed variant for request bodies where partial identification is allowed.
      examples:
      - &id010
        catalog_api_id: stripe.com
        name: stripe
        vendor: stripe.com
        version: '2024-04-10'
      properties:
        catalog_api_id:
          anyOf:
          - maxLength: 255
            type: string
          - type: 'null'
          description: Catalog identity of the API (`domain[/sub-api]`, for example `nytimes.com/article_search`), when known; used for display only, not for matching.
          examples:
          - stripe.com
          title: Catalog Api Id
        name:
          default: ''
          description: Name of the API within the vendor; empty to cover every API of the vendor.
          examples:
          - stripe
          title: Name
          type: string
        vendor:
          description: Vendor of the API (for example `stripe.com`).
          examples:
          - stripe.com
          title: Vendor
          type: string
        version:
          default: ''
          description: Version of the API; empty to cover every version.
          examples:
          - '2024-04-10'
          title: Version
          type: string
      required:
      - vendor
      title: APIReferenceRequest
      type: object
    ActorListResponse:
      description: Paginated list of actors.
      examples:
      - &id165
        data: &id001
        - active: true
          actor_type: user
          created_at: '2026-01-15T09:30:00Z'
          id: usr_6968b3987ee4c3ec0b4ee3b9
          name: Ada Lovelace
        has_more: true
        next_cursor: eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
      properties:
        data:
          description: The page of actors.
          examples:
          - *id001
          items:
            $ref: '#/components/schemas/ActorSummaryResponse'
          title: Data
          type: array
        has_more:
          description: Whether more results exist after this page.
          examples:
          - true
          title: Has More
          type: boolean
        next_cursor:
          anyOf:
          - type: string
          - type: 'null'
          description: Cursor for the next page; null when there are no more results.
          examples:
          - eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
          title: Next Cursor
      required:
      - data
      - has_more
      title: ActorListResponse
      type: object
    ActorLookupEntryResponse:
      description: Display fields of one actor resolved by id.
      examples:
      - &id002
        active: true
        actor_type: user
        id: usr_6968b3987ee4c3ec0b4ee3b9
        name: Ada Lovelace
      properties:
        active:
          description: False for a disabled user or a non-active agent.
          examples:
          - true
          title: Active
          type: boolean
        actor_type:
          $ref: '#/components/schemas/ActorType'
          description: Whether the actor is a user or an agent.
          examples:
          - user
        id:
          description: Actor id (`usr_…` or `agnt_…`).
          examples:
          - usr_6968b3987ee4c3ec0b4ee3b9
          title: Id
          type: string
        name:
          description: 'Display name: a user''s full name or an agent''s name.'
          examples:
          - Ada Lovelace
          title: Name
          type: string
      required:
      - id
      - actor_type
      - name
      - active
      title: ActorLookupEntryResponse
      type: object
    ActorLookupResponse:
      description: Actors resolved by id; ids that match no actor are omitted.
      examples:
      - &id168
        data:
        - active: true
          actor_type: user
          id: usr_2abc
          name: Ada Lovelace
      properties:
        data:
          description: The resolved actors; ids that match no visible actor are omitted.
          examples:
          - - *id002
          items:
            $ref: '#/components/schemas/ActorLookupEntryResponse'
          title: Data
          type: array
      required:
      - data
      title: ActorLookupResponse
      type: object
    ActorSummaryResponse:
      description: Single actor entry in the actors list.
      examples:
      - active: true
        actor_type: user
        created_at: '2026-01-15T09:30:00Z'
        id: usr_6968b3987ee4c3ec0b4ee3b9
        name: Ada Lovelace
      properties:
        active:
          description: False for a disabled user or a non-active agent.
          examples:
          - true
          title: Active
          type: boolean
        actor_type:
          $ref: '#/components/schemas/ActorType'
          examples:
          - user
        created_at:
          description: When the actor was created (RFC 3339).
          examples:
          - '2026-01-15T09:30:00Z'
          format: date-time
          title: Created At
          type: string
        id:
          description: Actor id (`usr_…` or `agnt_…`).
          examples:
          - usr_6968b3987ee4c3ec0b4ee3b9
          title: Id
          type: string
        name:
          description: 'Display name: a user''s full name or an agent''s name.'
          examples:
          - Ada Lovelace
          title: Name
          type: string
      required:
      - id
      - actor_type
      - name
      - active
      - created_at
      title: ActorSummaryResponse
      type: object
    ActorType:
      description: |-
        Type of authenticated actor: a human user or an agent.

        Historical records may carry older actor-type values that are no longer
        issued; treat unrecognised values as opaque labels.
      enum:
      - user
      - agent
      title: ActorType
      type: string
    AgentCreateRequest:
      additionalProperties: false
      description: Request body for creating an agent manually.
      examples:
      - &id185
        description: Reconciles Stripe invoices against the ledger every night.
        name: invoice-reconciler
        permissions: &id003
        - apis:read
        - capabilities:execute
      properties:
        description:
          anyOf:
          - maxLength: 1024
            type: string
          - type: 'null'
          description: Optional free-text description of the agent.
          examples:
          - Reconciles Stripe invoices against the ledger every night.
          title: Description
        name:
          description: Human-readable name of the agent.
          examples:
          - invoice-reconciler
          maxLength: 255
          minLength: 1
          title: Name
          type: string
        permissions:
          anyOf:
          - items:
              maxLength: 64
              minLength: 1
              pattern: ^[a-zA-Z0-9_:./-]+$
              type: string
            maxItems: 100
            type: array
          - type: 'null'
          description: Permissions to grant the agent; each must be grantable by the caller. Omit to grant the default agent permission set.
          examples:
          - *id003
          title: Permissions
      required:
      - name
      title: AgentCreateRequest
      type: object
    AgentListResponse:
      description: List of agents.
      examples:
      - &id184
        data: &id004
        - approved_at: '2026-01-15T09:45:00Z'
          approved_by: usr_6968b3987ee4c3ec0b4ee3b9
          created_at: '2026-01-15T09:30:00Z'
          denial_reason: Requested permissions exceed the agent's stated purpose.
          denied_by: usr_6968b3987ee4c3ec0b4ee3b9
          description: Reconciles Stripe invoices against the ledger every night.
          has_api_key: true
          id: agnt_6968b3984d1c238dbe7e2e29
          name: invoice-reconciler
          owner_id: usr_6968b3987ee4c3ec0b4ee3b9
          parent_agent_id: agnt_6968b3984d1c238dbe7e2e29
          registered_by: usr_6968b3987ee4c3ec0b4ee3b9
          status: active
        has_more: true
        next_cursor: eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
      properties:
        data:
          description: The page of agents.
          examples:
          - *id004
          items:
            $ref: '#/components/schemas/AgentResponse'
          title: Data
          type: array
        has_more:
          description: Whether more results exist after this page.
          examples:
          - true
          title: Has More
          type: boolean
        next_cursor:
          anyOf:
          - type: string
          - type: 'null'
          description: Cursor for the next page; null when there are no more results.
          examples:
          - eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
          title: Next Cursor
      required:
      - data
      - has_more
      title: AgentListResponse
      type: object
    AgentPatchRequest:
      description: Request body for partially updating an agent.
      examples:
      - &id187
        description: Reconciles Stripe invoices against the ledger every night.
        name: invoice-reconciler
        owner_id: usr_6968b3987ee4c3ec0b4ee3b9
      properties:
        description:
          anyOf:
          - maxLength: 1024
            type: string
          - type: 'null'
          description: New description for the agent.
          examples:
          - Reconciles Stripe invoices against the ledger every night.
          title: Description
        name:
          anyOf:
          - maxLength: 255
            minLength: 1
            type: string
          - type: 'null'
          description: New name for the agent.
          examples:
          - invoice-reconciler
          title: Name
        owner_id:
          anyOf:
          - maxLength: 255
            minLength: 1
            type: string
          - type: 'null'
          description: ID of the user to transfer ownership to; `org:admin` only.
          examples:
          - usr_6968b3987ee4c3ec0b4ee3b9
          title: Owner Id
      title: AgentPatchRequest
      type: object
    AgentPermissionsRequest:
      additionalProperties: false
      description: Request body for replacing an agent's permissions.
      examples:
      - &id195
        permissions: &id005
        - apis:read
        - capabilities:execute
      properties:
        permissions:
          description: The full set of permissions the agent should hold.
          examples:
          - *id005
          items:
            maxLength: 64
            minLength: 1
            pattern: ^[a-zA-Z0-9_:./-]+$
            type: string
          maxItems: 100
          title: Permissions
          type: array
      required:
      - permissions
      title: AgentPermissionsRequest
      type: object
    AgentPermissionsResponse:
      description: Response containing an agent's current permissions.
      examples:
      - &id194
        permissions: &id006
        - apis:read
        - capabilities:execute
      properties:
        permissions:
          description: Permissions currently granted to the agent.
          examples:
          - *id006
          items:
            type: string
          title: Permissions
          type: array
      required:
      - permissions
      title: AgentPermissionsResponse
      type: object
    AgentResponse:
      description: Agent representation in API responses.
      examples:
      - &id186
        approved_at: '2026-01-15T09:45:00Z'
        approved_by: usr_6968b3987ee4c3ec0b4ee3b9
        created_at: '2026-01-15T09:30:00Z'
        denial_reason: Requested permissions exceed the agent's stated purpose.
        denied_by: usr_6968b3987ee4c3ec0b4ee3b9
        description: Reconciles Stripe invoices against the ledger every night.
        has_api_key: true
        id: agnt_6968b3984d1c238dbe7e2e29
        name: invoice-reconciler
        owner_id: usr_6968b3987ee4c3ec0b4ee3b9
        parent_agent_id: agnt_6968b3984d1c238dbe7e2e29
        registered_by: usr_6968b3987ee4c3ec0b4ee3b9
        status: active
      properties:
        approved_at:
          anyOf:
          - format: date-time
            type: string
          - type: 'null'
          description: When the agent was approved (RFC 3339); null if not approved.
          examples:
          - '2026-01-15T09:45:00Z'
          title: Approved At
        approved_by:
          anyOf:
          - type: string
          - type: 'null'
          description: ID of the user who approved the agent; null if not approved.
          examples:
          - usr_6968b3987ee4c3ec0b4ee3b9
          title: Approved By
        created_at:
          description: When the agent was created (RFC 3339).
          examples:
          - '2026-01-15T09:30:00Z'
          format: date-time
          title: Created At
          type: string
        denial_reason:
          anyOf:
          - type: string
          - type: 'null'
          description: Reason given when the agent was denied; null if not denied.
          examples:
          - Requested permissions exceed the agent's stated purpose.
          title: Denial Reason
        denied_by:
          anyOf:
          - type: string
          - type: 'null'
          description: ID of the actor that denied the agent; null if not denied.
          examples:
          - usr_6968b3987ee4c3ec0b4ee3b9
          title: Denied By
        description:
          anyOf:
          - type: string
          - type: 'null'
          description: Free-text description of the agent; null if not set.
          examples:
          - Reconciles Stripe invoices against the ledger every night.
          title: Description
        has_api_key:
          default: false
          description: Whether the agent currently has an active API key; only populated by `GET /agents/{agent_id}`, and false in other responses.
          examples:
          - true
          title: Has Api Key
          type: boolean
        id:
          description: Unique ID of the agent.
          examples:
          - agnt_6968b3984d1c238dbe7e2e29
          title: Id
          type: string
        name:
          description: Human-readable name of the agent.
          examples:
          - invoice-reconciler
          title: Name
          type: string
        owner_id:
          anyOf:
          - type: string
          - type: 'null'
          description: ID of the user who owns the agent; null for an unclaimed self-registration.
          examples:
          - usr_6968b3987ee4c3ec0b4ee3b9
          title: Owner Id
        parent_agent_id:
          anyOf:
          - type: string
          - type: 'null'
          description: ID of the parent agent; null when the agent has no parent.
          examples:
          - agnt_6968b3984d1c238dbe7e2e29
          title: Parent Agent Id
        registered_by:
          description: ID of the actor that registered the agent, or `self` for a self-registration.
          examples:
          - usr_6968b3987ee4c3ec0b4ee3b9
          title: Registered By
          type: string
        status:
          description: 'Lifecycle status of the agent: `pending`, `active`, `rejected`, `disabled` or `archived`.'
          examples:
          - active
          title: Status
          type: string
      required:
      - id
      - name
      - registered_by
      - status
      - created_at
      title: AgentResponse
      type: object
    ApiImportLinksResponse:
      description: Hypermedia links for an import response.
      examples:
      - &id008
        self: https://jentic.example.com/jobs/job_6968b3985e8c9902207afaeb
      properties:
        self:
          description: URL of the import job to poll for progress.
          examples:
          - https://jentic.example.com/jobs/job_6968b3985e8c9902207afaeb
          title: Self
          type: string
      required:
      - self
      title: ApiImportLinksResponse
      type: object
    ApiImportRequest:
      description: Wrapper for a batch of import sources.
      examples:
      - &id200
        sources: &id007
        - api_name: stripe
          submitted_by: usr_6968b3987ee4c3ec0b4ee3b9
          type: url
          url: https://raw.githubusercontent.com/jentic/jentic-public-apis/main/apis/openapi/stripe.com/main/2024-04-10/openapi.json
          vendor: stripe.com
          version: '2024-04-10'
      properties:
        sources:
          description: Documents to import, between 1 and 100 per request.
          examples:
          - *id007
          items:
            discriminator:
              mapping:
                inline: '#/components/schemas/ApiSourceInline'
                url: '#/components/schemas/ApiSourceUrl'
              propertyName: type
            oneOf:
            - $ref: '#/components/schemas/ApiSourceUrl'
            - $ref: '#/components/schemas/ApiSourceInline'
          maxItems: 100
          minItems: 1
          title: Sources
          type: array
      required:
      - sources
      title: ApiImportRequest
      type: object
    ApiImportResponse:
      description: Acknowledgement payload for an asynchronous import job.
      examples:
      - &id217
        _links: *id008
        job_id: job_6968b3985e8c9902207afaeb
        status: queued
      properties:
        _links:
          $ref: '#/components/schemas/ApiImportLinksResponse'
          examples:
          - *id008
        job_id:
          description: ID of the import job.
          examples:
          - job_6968b3985e8c9902207afaeb
          title: Job Id
          type: string
        status:
          description: Status of the job when accepted; `queued`.
          examples:
          - queued
          title: Status
          type: string
      required:
      - job_id
      - status
      - _links
      title: ApiImportResponse
      type: object
    ApiInfoResponse:
      description: API identification information.
      examples:
      - &id053
        host: api.stripe.com
        name: stripe
        vendor: stripe.com
        version: '2024-04-10'
      properties:
        host:
          anyOf:
          - type: string
          - type: 'null'
          description: Upstream host called; null if unknown.
          examples:
          - api.stripe.com
          title: Host
        name:
          description: Name of the API that was called.
          examples:
          - stripe
          title: Name
          type: string
        vendor:
          description: Vendor of the API that was called.
          examples:
          - stripe.com
          title: Vendor
          type: string
        version:
          description: Version of the API that was called.
          examples:
          - '2024-04-10'
          title: Version
          type: string
      required:
      - vendor
      - name
      - version
      title: ApiInfoResponse
      type: object
    ApiKeyConfirmSessionRequest:
      additionalProperties: false
      description: Confirm a ``manual_api_key`` session with the API key to store.
      examples:
      - agent_id: agnt_6968b3984d1c238dbe7e2e29
        digest: 2c26b46b68ffc68ff99b453c1d30413413422d706483bfa0f98a5e886266e7ae
        expected_agent_id: agnt_6968b3984d1c238dbe7e2e29
        key: example-secret
        kind: api_key
        permission_rules: &id009
        - effect: allow
          match_mode: prefix
          methods: &id029
          - GET
          operations: &id030
          - listCharges
          path: /v1/charges
      properties:
        agent_id:
          anyOf:
          - type: string
          - type: 'null'
          description: Agent to bind when the session has none; ignored if the session already has one.
          examples:
          - agnt_6968b3984d1c238dbe7e2e29
          title: Agent Id
        digest:
          description: Review digest echoed from the review data; a mismatch is 409 review_stale.
          examples:
          - 2c26b46b68ffc68ff99b453c1d30413413422d706483bfa0f98a5e886266e7ae
          maxLength: 64
          minLength: 1
          title: Digest
          type: string
        expected_agent_id:
          anyOf:
          - type: string
          - type: 'null'
          description: Agent ID from the review the approver saw; a mismatch is 409 review_stale.
          examples:
          - agnt_6968b3984d1c238dbe7e2e29
          title: Expected Agent Id
        key:
          description: API key to store; write-only.
          examples:
          - example-secret
          format: password
          maxLength: 8192
          minLength: 1
          title: Key
          type: string
          writeOnly: true
          x-sensitive: true
        kind:
          const: api_key
          description: Confirm variant; always `api_key`.
          examples:
          - api_key
          title: Kind
          type: string
        permission_rules:
          description: Permission rules to bind for the agent (at most 100).
          examples:
          - *id009
          items:
            $ref: '#/components/schemas/PermissionRuleSchema'
          maxItems: 100
          title: Permission Rules
          type: array
      required:
      - permission_rules
      - digest
      - kind
      - key
      title: ApiKeyConfirmSessionRequest
      type: object
    ApiKeyCreateRequest:
      description: Create request for api_key credentials.
      examples:
      - api:
          name: stripe
          vendor: stripe.com
          version: '2024-04-10'
        field_name: Authorization
        key: sk_live_…
        location: header
        name: Stripe live key
        provider: static
        type: api_key
      properties:
        api:
          $ref: '#/components/schemas/APIReferenceRequest'
          description: Loose (vendor, name, version) API identity tuple.
          examples:
          - *id010
        field_name:
          description: Header or query-parameter name carrying the key.
          examples:
          - Authorization
          title: Field Name
          type: string
        key:
          description: The API key secret. Stored encrypted; never returned after create.
          examples:
          - example-secret
          title: Key
          type: string
          x-sensitive: true
        location:
          $ref: '#/components/schemas/CredentialLocation'
          description: Where to inject the key on upstream calls.
          examples:
          - header
        name:
          description: Human-readable label for the credential.
          examples:
          - Stripe live key
          title: Name
          type: string
        provider:
          default: static
          description: Credential provider; 'static' for stored secrets.
          examples:
          - static
          title: Provider
          type: string
        runtime_config:
          anyOf:
          - $ref: '#/components/schemas/RuntimeConfig'
          - type: 'null'
          description: Per-upstream-call overrides; reserved and not currently applied.
          examples:
          - headers: &id013
              Stripe-Version: '2024-04-10'
            query_params: &id014
              locale: en-GB
        server_variables:
          anyOf:
          - additionalProperties:
              type: string
            type: object
          - type: 'null'
          description: OpenAPI server-variable values for URL template substitution (at most 20).
          examples:
          - region: eu
          title: Server Variables
        type:
          const: api_key
          description: Credential type; always `api_key`.
          examples:
          - api_key
          title: Type
          type: string
      required:
      - type
      - name
      - api
      - key
      - location
      - field_name
      title: ApiKeyCreateRequest
      type: object
    ApiKeyHistoryEntryResponse:
      description: A single event in the API key audit trail.
      examples:
      - &id011
        action: rotate
        actor_id: usr_6968b3987ee4c3ec0b4ee3b9
        id: aud_6968b3984275d71e90f7f09f
        occurred_at: '2026-01-20T14:00:00Z'
        reason: api_key_rotated
      properties:
        action:
          description: Audited action, for example `rotate` or `revoke`.
          examples:
          - rotate
          title: Action
          type: string
        actor_id:
          anyOf:
          - type: string
          - type: 'null'
          description: ID of the actor that performed the action.
          examples:
          - usr_6968b3987ee4c3ec0b4ee3b9
          title: Actor Id
        id:
          description: Unique ID of the audit entry.
          examples:
          - aud_6968b3984275d71e90f7f09f
          title: Id
          type: string
        occurred_at:
          description: When the action occurred (RFC 3339).
          examples:
          - '2026-01-20T14:00:00Z'
          format: date-time
          title: Occurred At
          type: string
        reason:
          anyOf:
          - type: string
          - type: 'null'
          description: 'Structured reason: `api_key_rotated` or `api_key_revoked`.'
          examples:
          - api_key_rotated
          title: Reason
      required:
