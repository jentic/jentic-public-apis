      tags:
      - Executions
    summary: Get Execution
  /governed-hosts:
    description: '`GET`: Get Governed Hosts.'
    get:
      description: |-
        The caller's governed host set (credential-bound hosts) with an ETag digest.

        **Always self-scoped** — derived from the authenticated identity's own
        credential bindings; there is no cross-actor or admin variant. Credentials
        bind to agents, so agent-scoped tokens (the OAuth agent-consent flow's
        output) and agent API keys are the callers this endpoint serves — a plain
        user token yields an empty set. Suspended bindings and inactive
        credentials still contribute their hosts: keep diverting that
        traffic, so the broker can refuse it — dropping it from the list would
        send it direct to the upstream, unbrokered. The ``digest`` covers exactly
        the ``data`` list and is also emitted as a strong ``ETag``, so integrators
        poll with ``If-None-Match: "<digest>"`` and get an empty ``304`` until
        their host set actually changes (the change-poll seam that replaces
        ``GET /apis`` enumeration for interception scoping). Poll at most once per
        minute; on any ``5xx`` retain the last known set — never fall back to an
        empty (intercept-nothing) list.

        Responses are identity-scoped and marked ``Cache-Control: private,
        no-store`` — a shared cache must never serve one actor's host set to
        another.
      operationId: getGovernedHosts
      parameters:
      - description: 'Change-poll precondition: the `ETag` from a previous response (quoted, `"<digest>"`; the bare digest is accepted as a compatibility form). When it still matches, the response is an empty `304`.'
        examples:
          example:
            summary: Governed-hosts ETag
            value: '"9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08"'
        in: header
        name: if-none-match
        required: false
        schema:
          anyOf:
          - examples:
            - '"9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08"'
            type: string
          - type: 'null'
          description: 'Change-poll precondition: the `ETag` from a previous response (quoted, `"<digest>"`; the bare digest is accepted as a compatibility form). When it still matches, the response is an empty `304`.'
          examples:
          - '"9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08"'
          title: If-None-Match
      responses:
        '200':
          content:
            application/json:
              example: *id240
              schema:
                $ref: '#/components/schemas/GovernedHostsResponse'
          description: Successful Response
          headers:
            ETag:
              description: 'Strong entity tag: the quoted `digest` (`"<hex>"`). Echo it in `If-None-Match` to change-poll.'
              schema:
                type: string
        '304':
          description: The host set still matches the presented `If-None-Match` — empty body, `ETag` echoed.
          headers:
            ETag:
              description: 'Strong entity tag: the quoted `digest` (`"<hex>"`). Echo it in `If-None-Match` to change-poll.'
              schema:
                type: string
        '400':
          content:
            application/problem+json:
              example: *id169
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Bad Request
        '401':
          content:
            application/problem+json:
              example: *id170
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unauthorized
        '403':
          content:
            application/problem+json:
              example: *id171
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Forbidden
        '422':
          content:
            application/problem+json:
              example: *id172
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unprocessable Entity
        '500':
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Internal Server Error
        '503':
          content:
            application/problem+json:
              example: *id173
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Service Unavailable
        default:
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unexpected error, as RFC 9457 Problem Details.
      security:
      - BearerAuth: []
      - OAuth2: []
      summary: Get Governed Hosts
      tags:
      - Governed Hosts
    summary: Get Governed Hosts
  /health:
    description: '`GET`: Health.'
    get:
      description: |-
        Liveness probe for the combined control-plane app.

        Unauthenticated and dependency-free so orchestrators and load balancers
        have a stable target. Returns ``{"status": "ok"}`` when the process is up.
      operationId: getHealth
      responses:
        '200':
          content:
            application/json:
              example: *id241
              schema:
                $ref: '#/components/schemas/RootHealthResponse'
          description: Successful Response
        default:
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unexpected error, as RFC 9457 Problem Details.
      security: []
      summary: Health
      tags:
      - System
    summary: Health
  /inspect:
    description: '`GET`: Inspect operation.'
    get:
      description: |-
        Inspect an operation — resolve to full structural detail.

        `api.vendor`/`api.name`/`api.version` in the result is the canonical API
        reference: the identity to use in credential scopes, revision pins and
        other API references. `api.display_name` (optional) is a human-readable
        label only.
      operationId: inspectOperation
      parameters:
      - description: METHOD URL identifier
        examples:
          example:
            summary: Upstream operation (method and URL)
            value: GET https://api.stripe.com/v1/charges
        in: query
        name: id
        required: false
        schema:
          anyOf:
          - examples:
            - GET https://api.stripe.com/v1/charges
            type: string
          - type: 'null'
          description: METHOD URL identifier
          examples:
          - GET https://api.stripe.com/v1/charges
          title: Id
      - description: Operation ID
        examples:
          example:
            summary: Upstream operationId
            value: listCharges
        in: query
        name: operation_id
        required: false
        schema:
          anyOf:
          - examples:
            - listCharges
            type: string
          - type: 'null'
          description: Operation ID
          examples:
          - listCharges
          title: Operation Id
      - description: Pin to specific revision
        examples:
          example:
            summary: Revision ID (UUID)
            value: 3f2b8c1e-7d4a-4e9b-a6c5-1d2e3f4a5b6c
        in: query
        name: revision_id
        required: false
        schema:
          anyOf:
          - examples:
            - 3f2b8c1e-7d4a-4e9b-a6c5-1d2e3f4a5b6c
            type: string
          - type: 'null'
          description: Pin to specific revision
          examples:
          - 3f2b8c1e-7d4a-4e9b-a6c5-1d2e3f4a5b6c
          title: Revision Id
      - description: Level of detail to return; only `summary` is currently supported.
        examples:
          example:
            summary: Example query value for `detail`
            value: summary
        in: query
        name: detail
        required: false
        schema:
          default: summary
          description: Level of detail to return; only `summary` is currently supported.
          enum:
          - summary
          - full
          examples:
          - summary
          title: Detail
          type: string
      responses:
        '200':
          content:
            application/json:
              schema: {}
          description: Successful Response
        '400':
          content:
            application/problem+json:
              example: *id169
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Bad Request
        '401':
          content:
            application/problem+json:
              example: *id170
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unauthorized
        '403':
          content:
            application/problem+json:
              example: *id171
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Forbidden
        '422':
          content:
            application/problem+json:
              example: *id172
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unprocessable Entity
        '500':
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Internal Server Error
        '503':
          content:
            application/problem+json:
              example: *id173
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Service Unavailable
        default:
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unexpected error, as RFC 9457 Problem Details.
      security:
      - BearerAuth: []
      - OAuth2: []
      summary: Inspect operation
      tags:
      - Inspect
    summary: Inspect operation
  /instance:
    description: '`GET`: Backend identity.'
    get:
      description: |-
        Return this backend's self-describing identity.

        Unauthenticated and dependency-free so any client (an MCP server, the
        CLI, an agent) can read which backend it is bound to — local vs. a
        remote install — and label its responses accordingly.
      operationId: getInstance
