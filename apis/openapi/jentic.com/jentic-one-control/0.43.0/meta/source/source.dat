    ApiResponse:
      description: |-
        Full API aggregate response.

        ``GET /apis`` is the local registry — every item is an API imported into
        this deployment. The public catalog of importable-but-not-yet-imported APIs
        is a separate surface (``GET /catalog``); the two are not blended.
      examples:
      - &id201
        _links: *id017
        api: *id019
        catalog_api_id: stripe.com
        created_at: '2026-01-10T08:00:00Z'
        current_revision_id: 3f2b8c1e-7d4a-4e9b-a6c5-1d2e3f4a5b6c
        description: 'Online payments platform: charges, customers, subscriptions and payouts.'
        display_name: Stripe
        icon_url: https://stripe.com/favicon.ico
        operation_count: 412
        origin: catalog
        revision_count: 2
        security_schemes: *id020
        source_url: https://raw.githubusercontent.com/jentic/jentic-public-apis/main/apis/openapi/stripe.com/main/2024-04-10/openapi.json
        update_available: false
        updated_at: '2026-01-15T09:30:00Z'
      properties:
        _links:
          $ref: '#/components/schemas/ApiLinksResponse'
          examples:
          - *id017
        api:
          $ref: '#/components/schemas/ApiReferenceResponse'
          examples:
          - *id019
        catalog_api_id:
          anyOf:
          - type: string
          - type: 'null'
          description: Catalog identity the API was imported from (`domain[/sub-api]`, for example `nytimes.com/article_search`); null for manual imports.
          examples:
          - stripe.com
          title: Catalog Api Id
        created_at:
          description: When the API was created (RFC 3339).
          examples:
          - '2026-01-10T08:00:00Z'
          format: date-time
          title: Created At
          type: string
        current_revision_id:
          anyOf:
          - type: string
          - type: 'null'
          description: ID of the revision the API currently serves; null when it has no live revision.
          examples:
          - 3f2b8c1e-7d4a-4e9b-a6c5-1d2e3f4a5b6c
          title: Current Revision Id
        description:
          anyOf:
          - type: string
          - type: 'null'
          description: Free-text description of the API; null if not set.
          examples:
          - 'Online payments platform: charges, customers, subscriptions and payouts.'
          title: Description
        display_name:
          anyOf:
          - type: string
          - type: 'null'
          description: Human-readable name to show for the API; null if not set.
          examples:
          - Stripe
          title: Display Name
        icon_url:
          anyOf:
          - type: string
          - type: 'null'
          description: URL of an icon image for the API; null if not set.
          examples:
          - https://stripe.com/favicon.ico
          title: Icon Url
        operation_count:
          description: Number of operations the API exposes.
          examples:
          - 412
          title: Operation Count
          type: integer
        origin:
          anyOf:
          - type: string
          - type: 'null'
          description: 'Provenance of the current revision: `catalog` (imported from the public catalog), `overlay` (materialized from a confirmed overlay), or null (manual import).'
          examples:
          - catalog
          title: Origin
        revision_count:
          description: Number of revisions recorded for the API.
          examples:
          - 2
          title: Revision Count
          type: integer
        security_schemes:
          description: Distinct security scheme types declared by the current revision.
          examples:
          - *id020
          items:
            type: string
          title: Security Schemes
          type: array
        source_url:
          anyOf:
          - type: string
          - type: 'null'
          description: Upstream spec URL backing the current revision, when known (catalog linkage).
          examples:
          - https://raw.githubusercontent.com/jentic/jentic-public-apis/main/apis/openapi/stripe.com/main/2024-04-10/openapi.json
          title: Source Url
        update_available:
          default: false
          description: Whether the upstream spec at `source_url` has a notified update this API hasn't adopted yet (Flow-3). Re-importing clears it.
          examples:
          - false
          title: Update Available
          type: boolean
        updated_at:
          description: When the API was last updated (RFC 3339); equals `created_at` if never updated.
          examples:
          - '2026-01-15T09:30:00Z'
          format: date-time
          title: Updated At
          type: string
      required:
      - api
      - catalog_api_id
      - display_name
      - description
      - icon_url
      - current_revision_id
      - revision_count
      - operation_count
      - security_schemes
      - created_at
      - updated_at
      - _links
      title: ApiResponse
      type: object
