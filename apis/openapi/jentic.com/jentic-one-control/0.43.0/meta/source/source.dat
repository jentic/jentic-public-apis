  /agents/{agent_id}/credentials:
    description: '`GET`: List an agent''s credential bindings. `POST`: Bind a credential to an agent.'
    get:
      description: |-
        List the credentials bound directly to an agent.

        Each binding names the credential, the API it serves, when it was bound,
        whether it is `suspended` (and why), and any attached permission
        `rule_set_id`. Credential secrets are never returned. Readable by the
        agent itself, its owner, and `org:admin` (404 otherwise). The list is not
        paginated.
      operationId: listAgentCredentials
      parameters:
      - description: ID of the agent.
        examples:
          example:
            summary: Agent ID
            value: agnt_6968b3984d1c238dbe7e2e29
        in: path
        name: agent_id
        required: true
        schema:
          description: ID of the agent.
          examples:
          - agnt_6968b3984d1c238dbe7e2e29
          title: Agent Id
          type: string
      responses:
        '200':
          content:
            application/json:
              example: *id189
              schema:
                $ref: '#/components/schemas/CredentialBindingListResponse'
          description: Successful Response
        '400':
          content:
            application/problem+json:
              example: *id169
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Bad Request
        '401':
          content:
            application/problem+json:
              example: *id170
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unauthorized
        '403':
          content:
            application/problem+json:
              example: *id171
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Forbidden
        '422':
          content:
            application/problem+json:
              example: *id172
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unprocessable Entity
        '500':
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Internal Server Error
        '503':
          content:
            application/problem+json:
              example: *id173
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Service Unavailable
        default:
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unexpected error, as RFC 9457 Problem Details.
      security:
      - BearerAuth: []
      - OAuth2: []
      summary: List an agent's credential bindings
      tags:
      - Agents
    post:
      description: |-
        Let an agent use a credential by binding it directly.

        A new binding starts with no permission rules, so the agent can make no
        calls with it until rules are set or a rule set is attached. The caller
        must be able to see the agent and must own the credential (or hold
        `org:admin`). A credential that does not exist or that the caller does
        not own returns 404; binding the same credential twice returns 409
        (`credential_binding_conflict`).
        Returns the new binding.
      operationId: bindAgentCredential
      parameters:
      - description: ID of the agent.
        examples:
          example:
            summary: Agent ID
            value: agnt_6968b3984d1c238dbe7e2e29
        in: path
        name: agent_id
        required: true
        schema:
          description: ID of the agent.
          examples:
          - agnt_6968b3984d1c238dbe7e2e29
          title: Agent Id
          type: string
      requestBody:
        content:
          application/json:
            example: *id190
            schema:
              $ref: '#/components/schemas/CredentialBindRequest'
        description: Request body for directly binding a credential to an agent.
        required: true
      responses:
        '201':
          content:
            application/json:
              example: *id191
              schema:
                $ref: '#/components/schemas/CredentialBindingResponse'
          description: Successful Response
        '400':
          content:
            application/problem+json:
              example: *id169
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Bad Request
        '401':
          content:
            application/problem+json:
              example: *id170
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unauthorized
        '403':
          content:
            application/problem+json:
              example: *id171
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Forbidden
        '422':
          content:
            application/problem+json:
              example: *id172
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unprocessable Entity
        '500':
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Internal Server Error
        '503':
          content:
            application/problem+json:
              example: *id173
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Service Unavailable
        default:
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unexpected error, as RFC 9457 Problem Details.
      security:
      - BearerAuth: []
      - OAuth2: []
      summary: Bind a credential to an agent
      tags:
      - Agents
    summary: List an agent's credential bindings; Bind a credential to an agent
  /agents/{agent_id}/credentials/{credential_id}:
    delete:
      description: |-
        Stop an agent using a credential: suspend the binding, or purge it.

        By default the binding is **suspended**: the agent loses access at once,
        but the binding and its permission rules are kept, and
        `POST /agents/{agent_id}/credentials/{credential_id}:resume` restores it.
        With `purge=true` the binding and its inline permission rules are deleted
        outright, so a later re-bind starts from deny-all. An agent may suspend
        its own binding but not purge it. Both modes are audited. Returns 204; a
        missing binding returns 404.
      operationId: unbindAgentCredential
      parameters:
      - description: ID of the agent.
        examples:
          example:
            summary: Agent ID
            value: agnt_6968b3984d1c238dbe7e2e29
        in: path
        name: agent_id
        required: true
        schema:
          description: ID of the agent.
          examples:
          - agnt_6968b3984d1c238dbe7e2e29
          title: Agent Id
          type: string
      - description: ID of the credential bound to the agent.
        examples:
          example:
            summary: Credential ID
            value: cred_6968b39855d91a3561684b32
        in: path
        name: credential_id
        required: true
        schema:
          description: ID of the credential bound to the agent.
          examples:
          - cred_6968b39855d91a3561684b32
          title: Credential Id
          type: string
      - description: 'Default false: the binding is suspended (reversible; its permission rules survive and :resume restores access). true deletes the binding row outright, together with its inline permission rules.'
        examples:
          example:
            summary: Example query value for `purge`
            value: true
        in: query
        name: purge
        required: false
        schema:
          default: false
          description: 'Default false: the binding is suspended (reversible; its permission rules survive and :resume restores access). true deletes the binding row outright, together with its inline permission rules.'
          examples:
          - true
          title: Purge
          type: boolean
      responses:
        '204':
          description: Successful Response
        '400':
          content:
            application/problem+json:
              example: *id169
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Bad Request
        '401':
          content:
            application/problem+json:
              example: *id170
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unauthorized
        '403':
          content:
            application/problem+json:
              example: *id171
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Forbidden
        '422':
          content:
            application/problem+json:
              example: *id172
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unprocessable Entity
        '500':
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Internal Server Error
        '503':
          content:
            application/problem+json:
              example: *id173
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Service Unavailable
        default:
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unexpected error, as RFC 9457 Problem Details.
      security:
      - BearerAuth: []
      - OAuth2: []
      summary: Suspend or remove a credential binding
      tags:
      - Agents
    description: '`DELETE`: Suspend or remove a credential binding.'
    summary: Suspend or remove a credential binding
  /agents/{agent_id}/credentials/{credential_id}:resume:
    description: '`POST`: Resume a suspended credential binding.'
    post:
      description: |-
        Restore an agent's access to a credential whose binding was suspended.

        Reverses the default (non-purge) unbind; a purged binding is gone and must
        be bound again instead. Because resuming re-grants the credential, the
        caller must own the credential (or hold `org:admin`) as well as see the
        agent, and an agent cannot resume its own binding. Returns the binding;
        404 when no binding exists.
      operationId: resumeAgentCredentialBinding
      parameters:
      - description: ID of the agent.
        examples:
          example:
            summary: Agent ID
            value: agnt_6968b3984d1c238dbe7e2e29
        in: path
        name: agent_id
        required: true
        schema:
          description: ID of the agent.
          examples:
          - agnt_6968b3984d1c238dbe7e2e29
          title: Agent Id
          type: string
      - description: ID of the credential bound to the agent.
        examples:
          example:
            summary: Credential ID
            value: cred_6968b39855d91a3561684b32
        in: path
        name: credential_id
        required: true
        schema:
          description: ID of the credential bound to the agent.
          examples:
          - cred_6968b39855d91a3561684b32
          title: Credential Id
          type: string
      responses:
        '200':
          content:
            application/json:
              example: *id191
              schema:
                $ref: '#/components/schemas/CredentialBindingResponse'
          description: Successful Response
        '400':
          content:
            application/problem+json:
              example: *id169
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Bad Request
        '401':
          content:
            application/problem+json:
              example: *id170
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unauthorized
        '403':
          content:
            application/problem+json:
              example: *id171
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Forbidden
        '422':
          content:
            application/problem+json:
              example: *id172
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unprocessable Entity
        '500':
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Internal Server Error
        '503':
          content:
            application/problem+json:
              example: *id173
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Service Unavailable
        default:
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unexpected error, as RFC 9457 Problem Details.
      security:
      - BearerAuth: []
      - OAuth2: []
      summary: Resume a suspended credential binding
      tags:
      - Agents
    summary: Resume a suspended credential binding
  /agents/{agent_id}/jwks:
    description: '`PUT`: Update Agent Jwks.'
    put:
      description: |-
        Update an agent's JWKS (public keys for JWT-bearer authentication).

        The JWKS must contain at least one Ed25519 public key and must not contain
        any private key material. This enables the agent to authenticate via
        JWT-bearer assertions signed with the corresponding private key.
      operationId: updateAgentJwks
      parameters:
      - description: ID of the agent.
        examples:
          example:
            summary: Agent ID
            value: agnt_6968b3984d1c238dbe7e2e29
        in: path
        name: agent_id
        required: true
        schema:
          description: ID of the agent.
          examples:
          - agnt_6968b3984d1c238dbe7e2e29
          title: Agent Id
          type: string
      requestBody:
        content:
          application/json:
            example: *id192
            schema:
              $ref: '#/components/schemas/JwksUpdateRequest'
        description: |-
          Request body for updating an agent's JWKS (public keys).

          The JWKS must contain at least one Ed25519 public key and must not
          contain any private key material.
        required: true
      responses:
        '200':
          content:
            application/json:
              example: *id186
              schema:
                $ref: '#/components/schemas/AgentResponse'
          description: Successful Response
        '400':
          content:
            application/problem+json:
              example: *id169
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Bad Request
        '401':
          content:
            application/problem+json:
              example: *id170
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unauthorized
        '403':
          content:
            application/problem+json:
              example: *id171
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Forbidden
        '422':
          content:
            application/problem+json:
              example: *id172
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unprocessable Entity
        '500':
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Internal Server Error
        '503':
          content:
            application/problem+json:
              example: *id173
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Service Unavailable
        default:
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unexpected error, as RFC 9457 Problem Details.
      security:
      - BearerAuth: []
      - OAuth2: []
      summary: Update Agent Jwks
      tags:
      - Agents
    summary: Update Agent Jwks
  /agents/{agent_id}/oauth-grants:
    description: '`GET`: List an agent''s connected OAuth clients.'
    get:
      description: |-
        List the OAuth clients a user has consented to act as this agent.

        Each grant gives the client's display name and redirect-URI origin, the
        granted scopes, the consenting user, its `status`, created and last-used
        timestamps, and `can_revoke` for the caller. Filter by `status`
        (`active` or `revoked`); results are cursor-paginated. Allowed for the
        agent's owner or an admin. An agent the caller cannot see answers 404,
        the same as one that does not exist. Revoke a grant with
        `POST /oauth-grants/{grant_id}:revoke`.
      operationId: listAgentOauthGrants
      parameters:
      - description: ID of the agent.
        examples:
          example:
            summary: Agent ID
            value: agnt_6968b3984d1c238dbe7e2e29
        in: path
        name: agent_id
        required: true
        schema:
          description: ID of the agent.
          examples:
          - agnt_6968b3984d1c238dbe7e2e29
          title: Agent Id
          type: string
      - description: Filter by grant lifecycle state.
        examples:
          example:
            summary: Example query value for `status`
            value: active
        in: query
        name: status
        required: false
        schema:
          anyOf:
          - enum:
            - active
            - revoked
            examples:
            - active
            type: string
          - type: 'null'
          description: Filter by grant lifecycle state.
          examples:
          - active
          title: Status
      - description: Maximum number of grants to return (1-200, default 50).
        examples:
          example:
            summary: Example query value for `limit`
            value: 25
        in: query
        name: limit
        required: false
        schema:
          default: 50
          description: Maximum number of grants to return (1-200, default 50).
          examples:
          - 25
          maximum: 200
          minimum: 1
          title: Limit
          type: integer
      - description: Cursor from a previous page's `next_cursor`; omit for the first page.
        examples:
          example:
            summary: Opaque cursor from a previous page
            value: eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
        in: query
        name: cursor
        required: false
        schema:
          anyOf:
          - examples:
            - eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
            type: string
          - type: 'null'
          description: Cursor from a previous page's `next_cursor`; omit for the first page.
          examples:
          - eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
          title: Cursor
      responses:
        '200':
          content:
            application/json:
              example: *id193
              schema:
                $ref: '#/components/schemas/OAuthGrantListResponse'
          description: Successful Response
        '400':
          content:
            application/problem+json:
              example: *id169
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Bad Request
        '401':
          content:
            application/problem+json:
              example: *id170
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unauthorized
        '403':
          content:
            application/problem+json:
              example: *id171
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Forbidden
        '404':
          content:
            application/problem+json:
              example: *id180
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Not Found
        '422':
          content:
            application/problem+json:
              example: *id172
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unprocessable Entity
        '500':
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Internal Server Error
        '503':
          content:
            application/problem+json:
              example: *id173
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Service Unavailable
        default:
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unexpected error, as RFC 9457 Problem Details.
      security:
      - BearerAuth: []
      - OAuth2: []
      summary: List an agent's connected OAuth clients
      tags:
      - Agents
