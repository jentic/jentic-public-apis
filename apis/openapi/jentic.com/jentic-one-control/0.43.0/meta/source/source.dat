  /events:
    description: '`GET`: List Events.'
    get:
      description: List events with optional filters.
      operationId: listEvents
      parameters:
      - description: Only return events of one of these types; repeat the parameter for several.
        examples:
          example:
            summary: Example query value for `event_type`
            value: &id231
            - import.completed
        in: query
        name: event_type
        required: false
        schema:
          anyOf:
          - examples:
            - *id231
            items:
              examples:
              - import.completed
              type: string
            type: array
          - type: 'null'
          description: Only return events of one of these types; repeat the parameter for several.
          examples:
          - *id231
          title: Event Type
      - description: Only return events with one of these severities; repeat the parameter for several.
        examples:
          example:
