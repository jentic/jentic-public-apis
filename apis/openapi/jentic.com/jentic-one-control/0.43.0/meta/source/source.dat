  /auth/refresh:
    description: '`POST`: Refresh session token.'
    post:
      description: |-
        Re-mint the caller's login JWT before it expires (sliding session).

        Only user login JWTs are refreshable; permissions and the
        ``must_change_password`` gate are re-read from the database at re-mint.
        Refusal modes: 401 ``session_expired`` once the original authentication is
        older than the absolute window (``admin.auth.session_ttl_seconds``), 401
        ``invalid_credentials`` for deactivated users, non-user tokens, or opaque
        (non-JWT) credentials. Clients should then send the user back to login.
      operationId: refreshSession
      responses:
        '200':
          content:
            application/json:
              example: *id214
              schema:
                $ref: '#/components/schemas/LoginResponse'
          description: Successful Response
        '400':
          content:
            application/problem+json:
              example: *id169
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Bad Request
        '401':
          content:
            application/problem+json:
              example: *id170
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unauthorized
        '403':
          content:
            application/problem+json:
              example: *id171
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Forbidden
        '422':
          content:
            application/problem+json:
              example: *id172
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unprocessable Entity
        '500':
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Internal Server Error
        '503':
          content:
            application/problem+json:
              example: *id173
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Service Unavailable
        default:
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unexpected error, as RFC 9457 Problem Details.
      security:
      - BearerAuth: []
      - OAuth2: []
      summary: Refresh session token
      tags:
      - Users
    summary: Refresh session token
  /catalog:
    description: '`GET`: List Catalog.'
    get:
      description: |-
        List a keyset page of browsable catalog entries (search/filter aware).

        The catalog holds thousands of entries, so this is cursor-paginated like
        ``GET /apis``: follow ``next_cursor`` until ``has_more`` is false.
        ``catalog_total``/``registered_count``/``outdated_count`` count the whole
        manifest, not the page, so the Discover status row stays stable while scrolling.
      operationId: listCatalog
      parameters:
      - description: Search text matched against entry IDs; results are ranked by match quality.
        examples:
          example:
            summary: Example query value for `q`
            value: charges
        in: query
        name: q
        required: false
        schema:
          anyOf:
          - examples:
            - charges
            maxLength: 500
            type: string
          - type: 'null'
          description: Search text matched against entry IDs; results are ranked by match quality.
          examples:
          - charges
          title: Q
      - description: Only return entries already imported into the registry.
        examples:
          example:
            summary: Example query value for `registered_only`
            value: true
        in: query
        name: registered_only
        required: false
        schema:
          default: false
          description: Only return entries already imported into the registry.
          examples:
          - true
          title: Registered Only
          type: boolean
      - description: Only return entries not yet imported; cannot be combined with `registered_only` or `outdated_only`.
        examples:
          example:
            summary: Example query value for `unregistered_only`
            value: false
        in: query
        name: unregistered_only
        required: false
        schema:
          default: false
          description: Only return entries not yet imported; cannot be combined with `registered_only` or `outdated_only`.
          examples:
          - false
          title: Unregistered Only
          type: boolean
      - description: Only return imported entries with an upstream update available.
        examples:
          example:
            summary: Example query value for `outdated_only`
            value: true
        in: query
        name: outdated_only
        required: false
        schema:
          default: false
          description: Only return imported entries with an upstream update available.
          examples:
          - true
          title: Outdated Only
          type: boolean
      - description: Treat entries whose update notification is snoozed as outdated.
        examples:
          example:
            summary: Example query value for `include_snoozed`
            value: true
        in: query
        name: include_snoozed
        required: false
        schema:
          default: false
          description: Treat entries whose update notification is snoozed as outdated.
          examples:
          - true
          title: Include Snoozed
          type: boolean
      - description: Opaque cursor from a previous page's `next_cursor`; keep the other filters unchanged while paging.
        examples:
          example:
            summary: Opaque cursor from a previous page
            value: eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
        in: query
        name: cursor
        required: false
        schema:
          anyOf:
          - examples:
            - eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
            type: string
          - type: 'null'
          description: Opaque cursor from a previous page's `next_cursor`; keep the other filters unchanged while paging.
          examples:
          - eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
          title: Cursor
      - description: Maximum number of entries to return (1-200).
        examples:
          example:
            summary: Example query value for `limit`
            value: 25
        in: query
        name: limit
        required: false
        schema:
          default: 50
          description: Maximum number of entries to return (1-200).
          examples:
          - 25
          maximum: 200
          minimum: 1
          title: Limit
          type: integer
      responses:
        '200':
          content:
            application/json:
              example: *id215
              schema:
                $ref: '#/components/schemas/CatalogListResponse'
          description: Successful Response
        '400':
          content:
            application/problem+json:
              example: *id169
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Bad Request
        '401':
          content:
            application/problem+json:
              example: *id170
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unauthorized
        '403':
          content:
            application/problem+json:
              example: *id171
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Forbidden
        '422':
          content:
            application/problem+json:
              example: *id172
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unprocessable Entity
        '500':
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Internal Server Error
        '503':
          content:
            application/problem+json:
              example: *id173
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Service Unavailable
        default:
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unexpected error, as RFC 9457 Problem Details.
      security:
      - BearerAuth: []
      - OAuth2: []
      summary: List Catalog
      tags:
      - Catalog
    summary: List Catalog
  /catalog/{api_id}:
    description: '`GET`: Get Catalog Entry.'
    get:
