          title: Name
          type: string
      - description: Version of the API.
        examples:
          example:
            summary: API version
            value: '2024-04-10'
        in: path
        name: version
        required: true
        schema:
          description: Version of the API.
          examples:
          - '2024-04-10'
          title: Version
          type: string
      - description: ID of the API revision.
        examples:
          example:
            summary: Revision ID (UUID)
