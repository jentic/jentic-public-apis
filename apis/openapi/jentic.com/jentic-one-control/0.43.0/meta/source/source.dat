          - additionalProperties: true
            type: object
          - type: 'null'
          description: Changes between `before` and `after`, keyed `added`, `removed` and `modified` (each modified key maps to `old`/`new`); null when nothing changed.
          examples:
          - *id024
          title: Diff
        id:
          description: Unique ID of the audit entry.
          examples:
          - aud_6968b3984275d71e90f7f09f
          title: Id
          type: string
        ip_address:
          anyOf:
          - type: string
          - type: 'null'
          description: Client IP address of the triggering request, if recorded.
          examples:
          - 203.0.113.42
          title: Ip Address
        job_id:
          anyOf:
          - type: string
          - type: 'null'
          description: ID of the job the action ran under, if any.
          examples:
          - job_6968b3985e8c9902207afaeb
          title: Job Id
        occurred_at:
          description: When the audited action happened (RFC 3339).
          examples:
          - '2026-01-15T09:30:00Z'
          format: date-time
          title: Occurred At
          type: string
        origin:
          anyOf:
          - type: string
          - type: 'null'
          description: Surface the action was initiated from, e.g. `dashboard`, `cli`, `api`, `agent`, `mcp` or `system`; null if not recorded.
          examples:
          - dashboard
          title: Origin
        reason:
          anyOf:
          - type: string
          - type: 'null'
          description: Reason recorded for the action; null if none was given.
          examples:
          - Rotated to the production key
          title: Reason
        request_id:
          anyOf:
          - type: string
          - type: 'null'
          description: ID of the request that triggered the action, if recorded.
          examples:
          - req_6968b3984d1c238d
          title: Request Id
        target_id:
          description: ID of the entity the action was performed on.
          examples:
          - cred_6968b39855d91a3561684b32
          title: Target Id
          type: string
        target_parent_id:
          anyOf:
          - type: string
          - type: 'null'
          description: ID of the target's parent entity; null when not applicable.
          examples:
          - agnt_6968b3984d1c238dbe7e2e29
          title: Target Parent Id
        target_type:
          description: Type of the entity the action was performed on.
          examples:
          - credential
          title: Target Type
          type: string
        trace_id:
          anyOf:
          - type: string
          - type: 'null'
          description: Trace ID of the triggering request, if recorded.
          examples:
          - 4bf92f3577b34da6a3ce929d0e0e4736
          title: Trace Id
        user_agent:
          anyOf:
          - type: string
          - type: 'null'
          description: User-Agent of the triggering request, if recorded.
          examples:
          - Mozilla/5.0 (Macintosh; Intel Mac OS X 14_5) AppleWebKit/605.1.15
          title: User Agent
      required:
      - id
      - occurred_at
      - action
      - target_type
      - target_id
      - actor_type
      title: AuditResponse
      type: object
    AuditTargetType:
      description: Entity types that can be the target of an audited action.
      enum:
      - revision
      - permission
      - user
      - credential
      - toolkit
      - agent
      - job
      - organisation
      - invite_token
      - event
      - execution_record
      - service_account
      - token
      - overlay
      - note
      - api
      - access_request
      - toolkit_key
      - credential_binding
      - permission_rule_set
      - session
      - provider_config
      - oauth_client
      - oauth_grant
      - oauth_app_registration
      title: AuditTargetType
      type: string
    AuthorizationCodeRegistrationCreateRequest:
      additionalProperties: false
      description: Create request for an authorization-code registration.
      examples:
      - api_vendor: github
        authorize_url: https://github.com/login/oauth/authorize
        catalog_api_id: github.com/api.github.com
        client_id: Iv1.a1b2c3d4
        client_secret: <paste-client-secret-from-vendor-console>
        default_scopes:
        - repo
        - read:user
        display_name: GitHub
        flow_kind: authorization_code
        name: MyOrg GitHub
        token_url: https://github.com/login/oauth/access_token
      properties:
        api_vendor:
          description: Vendor registry key the registration connects.
          examples:
          - github
          maxLength: 100
          minLength: 1
          title: Api Vendor
          type: string
        authorize_url:
          description: Authorization endpoint URL.
          examples:
          - https://github.com/login/oauth/authorize
          maxLength: 2048
          minLength: 1
          title: Authorize Url
          type: string
        catalog_api_id:
          description: Catalog API slug this OAuth app targets (e.g. 'github.com/api.github.com'). The credential minted through this registration carries the same slug so its operations preview resolves against a real registered API.
          examples:
          - github.com/api.github.com
          maxLength: 255
          minLength: 1
          pattern: ^[^/].*/.*[^/]$
          title: Catalog Api Id
          type: string
        client_id:
          description: OAuth client ID of the app.
          examples:
          - Iv1.a1b2c3d4
          maxLength: 255
          minLength: 1
          title: Client Id
          type: string
        client_secret:
          description: OAuth client secret of the app; stored encrypted and never returned.
          examples:
          - example-secret
          maxLength: 4096
          minLength: 1
          title: Client Secret
          type: string
          x-sensitive: true
        default_scopes:
          anyOf:
          - items:
              maxLength: 255
              minLength: 1
              pattern: ^\S+$
              type: string
            type: array
          - type: 'null'
          description: Scopes requested by default.
          examples:
          - - repo
            - read:user
          title: Default Scopes
        display_name:
          description: Vendor family label ('GitHub'), shown on picker cards.
          examples:
          - GitHub
          maxLength: 255
          minLength: 1
          title: Display Name
          type: string
        flow_kind:
          const: authorization_code
          description: OAuth flow the registration uses; always `authorization_code`.
          examples:
          - authorization_code
          title: Flow Kind
          type: string
        name:
          description: Admin-chosen name of the registration.
          examples:
          - MyOrg GitHub
          maxLength: 255
          minLength: 1
          title: Name
          type: string
        token_url:
          description: Token endpoint URL.
          examples:
          - https://github.com/login/oauth/access_token
          maxLength: 2048
          minLength: 1
          title: Token Url
          type: string
      required:
      - name
      - api_vendor
      - catalog_api_id
      - display_name
      - flow_kind
      - client_id
      - client_secret
      - authorize_url
      - token_url
      title: AuthorizationCodeRegistrationCreateRequest
      type: object
    BasicAuthCreateRequest:
      description: Create request for basic credentials.
      examples:
      - api: *id010
        name: Stripe live key
        password: example-secret
        provider: static
        runtime_config: &id025
          headers: *id013
          query_params: *id014
        server_variables: &id026
          region: eu
        type: basic
        username: svc-reporting
      properties:
        api:
          $ref: '#/components/schemas/APIReferenceRequest'
          examples:
          - *id010
        name:
          description: Human-readable label for the credential.
          examples:
          - Stripe live key
          title: Name
          type: string
        password:
          description: Password for HTTP Basic auth. Stored encrypted; never returned after create.
          examples:
          - example-secret
          title: Password
          type: string
          x-sensitive: true
        provider:
          default: static
          description: Credential provider; 'static' for stored secrets.
          examples:
          - static
          title: Provider
          type: string
        runtime_config:
          anyOf:
          - $ref: '#/components/schemas/RuntimeConfig'
          - type: 'null'
          description: Per-upstream-call overrides; reserved and not currently applied.
          examples:
          - *id025
        server_variables:
          anyOf:
          - additionalProperties:
              type: string
            type: object
          - type: 'null'
          description: OpenAPI server-variable values for URL template substitution (at most 20).
          examples:
          - *id026
          title: Server Variables
        type:
          const: basic
          description: Credential type; always `basic`.
          examples:
          - basic
          title: Type
          type: string
        username:
          description: Username sent with HTTP Basic auth.
          examples:
          - svc-reporting
          title: Username
          type: string
      required:
      - type
      - name
      - api
      - username
      - password
      title: BasicAuthCreateRequest
      type: object
    BasicAuthUpdateRequest:
      description: Update request for basic credentials.
      examples:
      - active: true
        name: Stripe live key
        password: example-secret
        runtime_config: &id027
          headers: *id013
          query_params: *id014
        server_variables: &id028
          region: eu
        type: basic
        username: svc-reporting
      properties:
        active:
          anyOf:
          - type: boolean
          - type: 'null'
          description: Enable or disable the credential for injection; omit to leave unchanged.
          examples:
          - true
          title: Active
        name:
          anyOf:
          - type: string
          - type: 'null'
          description: New label for the credential; omit to leave unchanged.
          examples:
          - Stripe live key
          title: Name
        password:
          anyOf:
          - type: string
          - type: 'null'
          description: Replacement password; omit to leave unchanged.
          examples:
          - example-secret
          title: Password
          x-sensitive: true
        runtime_config:
          anyOf:
          - $ref: '#/components/schemas/RuntimeConfig'
          - type: 'null'
          description: Per-upstream-call overrides; reserved and not currently applied.
          examples:
          - *id027
        server_variables:
          anyOf:
          - additionalProperties:
              type: string
            type: object
          - type: 'null'
          description: Replacement OpenAPI server-variable values; omit to leave unchanged.
          examples:
          - *id028
          title: Server Variables
        type:
          const: basic
          description: Credential type; always `basic`.
          examples:
          - basic
          title: Type
          type: string
        username:
          anyOf:
          - type: string
          - type: 'null'
          description: Replacement username; omit to leave unchanged.
          examples:
          - svc-reporting
          title: Username
      required:
      - type
      title: BasicAuthUpdateRequest
      type: object
    BasicConfirmSessionRequest:
      additionalProperties: false
      description: Confirm a ``manual_basic`` session with the username and password to store.
      examples:
      - agent_id: agnt_6968b3984d1c238dbe7e2e29
        digest: 2c26b46b68ffc68ff99b453c1d30413413422d706483bfa0f98a5e886266e7ae
        expected_agent_id: agnt_6968b3984d1c238dbe7e2e29
        kind: basic
        password: example-secret
        permission_rules: &id031
        - effect: allow
          match_mode: prefix
          methods: *id029
          operations: *id030
          path: /v1/charges
        username: svc-reporting
      properties:
        agent_id:
          anyOf:
          - type: string
          - type: 'null'
          description: Agent to bind when the session has none; ignored if the session already has one.
          examples:
          - agnt_6968b3984d1c238dbe7e2e29
          title: Agent Id
        digest:
          description: Review digest echoed from the review data; a mismatch is 409 review_stale.
          examples:
          - 2c26b46b68ffc68ff99b453c1d30413413422d706483bfa0f98a5e886266e7ae
          maxLength: 64
          minLength: 1
          title: Digest
          type: string
        expected_agent_id:
          anyOf:
          - type: string
          - type: 'null'
          description: Agent ID from the review the approver saw; a mismatch is 409 review_stale.
          examples:
          - agnt_6968b3984d1c238dbe7e2e29
          title: Expected Agent Id
        kind:
          const: basic
          description: Confirm variant; always `basic`.
          examples:
          - basic
          title: Kind
          type: string
        password:
          description: Password to store; write-only.
          examples:
          - example-secret
          format: password
          maxLength: 8192
          minLength: 1
          title: Password
          type: string
          writeOnly: true
          x-sensitive: true
        permission_rules:
          description: Permission rules to bind for the agent (at most 100).
          examples:
          - *id031
          items:
            $ref: '#/components/schemas/PermissionRuleSchema'
          maxItems: 100
          title: Permission Rules
          type: array
        username:
          description: Username to store.
          examples:
          - svc-reporting
          maxLength: 255
          minLength: 1
          title: Username
          type: string
      required:
      - permission_rules
      - digest
      - kind
      - username
      - password
      title: BasicConfirmSessionRequest
      type: object
    BearerConfirmSessionRequest:
      additionalProperties: false
      description: Confirm a ``manual_bearer`` session with the bearer token to store.
      examples:
      - agent_id: agnt_6968b3984d1c238dbe7e2e29
        digest: 2c26b46b68ffc68ff99b453c1d30413413422d706483bfa0f98a5e886266e7ae
        expected_agent_id: agnt_6968b3984d1c238dbe7e2e29
        kind: bearer
        permission_rules: &id032
        - effect: allow
          match_mode: prefix
          methods: *id029
          operations: *id030
          path: /v1/charges
        token: example-secret
      properties:
        agent_id:
          anyOf:
          - type: string
          - type: 'null'
          description: Agent to bind when the session has none; ignored if the session already has one.
          examples:
          - agnt_6968b3984d1c238dbe7e2e29
          title: Agent Id
        digest:
          description: Review digest echoed from the review data; a mismatch is 409 review_stale.
          examples:
          - 2c26b46b68ffc68ff99b453c1d30413413422d706483bfa0f98a5e886266e7ae
          maxLength: 64
          minLength: 1
          title: Digest
          type: string
        expected_agent_id:
          anyOf:
          - type: string
          - type: 'null'
          description: Agent ID from the review the approver saw; a mismatch is 409 review_stale.
          examples:
          - agnt_6968b3984d1c238dbe7e2e29
          title: Expected Agent Id
        kind:
          const: bearer
          description: Confirm variant; always `bearer`.
          examples:
          - bearer
          title: Kind
          type: string
        permission_rules:
          description: Permission rules to bind for the agent (at most 100).
          examples:
          - *id032
          items:
            $ref: '#/components/schemas/PermissionRuleSchema'
          maxItems: 100
          title: Permission Rules
          type: array
        token:
          description: Bearer token to store; write-only.
          examples:
          - example-secret
          format: password
          maxLength: 8192
          minLength: 1
          title: Token
          type: string
          writeOnly: true
          x-sensitive: true
      required:
      - permission_rules
      - digest
      - kind
      - token
      title: BearerConfirmSessionRequest
      type: object
    BearerTokenCreateRequest:
