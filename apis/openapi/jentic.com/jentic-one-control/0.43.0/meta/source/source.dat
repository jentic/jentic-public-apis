  /apis/{vendor}/{name}/{version}/revisions/{revision_id}:archive:
    description: '`POST`: Archive an API revision.'
    post:
      description: |-
        Retire a `draft` or `imported` revision without deleting it.

        The revision moves to `archived` and is kept for reference; it can then
        be deleted. If it was the API's current revision, the API is left with
        no live revision until another is promoted. A revision in any other
        state is refused with 409 (`revision_state_conflict`). Requires
        `apis:write`. Returns the archived revision.
      operationId: archiveRevision
      parameters:
      - description: Vendor of the API.
        examples:
          example:
            summary: API vendor domain
            value: stripe.com
        in: path
        name: vendor
        required: true
        schema:
          description: Vendor of the API.
          examples:
          - stripe.com
          title: Vendor
          type: string
      - description: Name of the API.
        examples:
          example:
            summary: API name
            value: stripe
        in: path
        name: name
        required: true
        schema:
          description: Name of the API.
          examples:
          - stripe
          title: Name
          type: string
      - description: Version of the API.
        examples:
          example:
            summary: API version
            value: '2024-04-10'
        in: path
        name: version
        required: true
        schema:
          description: Version of the API.
          examples:
          - '2024-04-10'
          title: Version
          type: string
      - description: ID of the API revision.
        examples:
          example:
            summary: Revision ID (UUID)
            value: 3f2b8c1e-7d4a-4e9b-a6c5-1d2e3f4a5b6c
        in: path
        name: revision_id
        required: true
        schema:
          description: ID of the API revision.
          examples:
          - 3f2b8c1e-7d4a-4e9b-a6c5-1d2e3f4a5b6c
          title: Revision Id
          type: string
      responses:
        '200':
          content:
            application/json:
              schema: {}
          description: Successful Response
        '400':
          content:
            application/problem+json:
              example: *id169
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Bad Request
        '401':
          content:
            application/problem+json:
              example: *id170
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unauthorized
        '403':
          content:
            application/problem+json:
              example: *id171
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Forbidden
        '422':
          content:
            application/problem+json:
              example: *id172
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unprocessable Entity
        '500':
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Internal Server Error
        '503':
          content:
            application/problem+json:
              example: *id173
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Service Unavailable
        default:
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unexpected error, as RFC 9457 Problem Details.
      security:
      - BearerAuth: []
      - OAuth2: []
      summary: Archive an API revision
      tags:
      - APIs
    summary: Archive an API revision
  /apis/{vendor}/{name}/{version}/revisions/{revision_id}:promote:
    description: '`POST`: Promote Revision.'
    post:
      description: |-
        Promote a draft revision to published, archiving the current one.

        If the draft declares different server hosts than the API's current (or last
        live) revision, or serves a host over plaintext http that was https-only, and
        the API has credentials bound to agents, the caller also needs
        ``credentials:write``; otherwise the promote is refused with 403
        ``host_change_requires_operator``.
      operationId: promoteRevision
      parameters:
      - description: Vendor of the API.
        examples:
          example:
            summary: API vendor domain
            value: stripe.com
        in: path
        name: vendor
        required: true
        schema:
          description: Vendor of the API.
          examples:
          - stripe.com
