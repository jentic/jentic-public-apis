    Body_consentAgentCreate:
      examples:
      - agent_name: invoice-reconciler
        consent_token: dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk
        create_state: eyJfcHVycG9zZSI6ICJleGFtcGxlIn0=.5d41402abc4b2a76b9719d911017c592
      properties:
        agent_name:
          description: Name for the new agent; surrounding whitespace is trimmed.
          examples:
          - invoice-reconciler
          title: Agent Name
          type: string
        consent_token:
          description: Single-use consent handle embedded in the consent page.
          examples:
          - dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk
          title: Consent Token
          type: string
          x-sensitive: true
        create_state:
          description: Signed single-use agent-creation token embedded in the consent page.
          examples:
          - eyJfcHVycG9zZSI6ICJleGFtcGxlIn0=.5d41402abc4b2a76b9719d911017c592
          title: Create State
          type: string
          x-sensitive: true
      required:
      - consent_token
      - create_state
      - agent_name
      title: Body_consentAgentCreate
      type: object
    CatalogEntryLinksResponse:
      description: Hypermedia links for a catalog entry.
      examples:
      - &id037
        github: https://github.com/jentic/jentic-public-apis/tree/main/apis/openapi/stripe.com
        import: /catalog/stripe.com:import
        operations: /catalog/stripe.com/operations
        self: /catalog/stripe.com
      properties:
        github:
          anyOf:
          - type: string
          - type: 'null'
          description: Human-facing GitHub tree URL for the entry, when known.
          examples:
          - https://github.com/jentic/jentic-public-apis/tree/main/apis/openapi/stripe.com
          title: Github
        import:
          description: URL of the catalog import action (`POST /catalog/{api_id}:import`).
          examples:
          - https://jentic.example.com/catalog/stripe.com:import
          title: Import
          type: string
        operations:
          description: URL of the entry's operation preview.
          examples:
          - https://jentic.example.com/catalog/stripe.com/operations
          title: Operations
          type: string
        self:
          description: Canonical URL of this catalog entry.
          examples:
          - https://jentic.example.com/catalog/stripe.com
          title: Self
          type: string
      required:
      - self
      - operations
      - import
      title: CatalogEntryLinksResponse
      type: object
    CatalogEntryResponse:
      description: A single browsable catalog entry.
      examples:
      - &id038
        _links:
          import: /catalog/stripe.com:import
          operations: /catalog/stripe.com/operations
          self: /catalog/stripe.com
        api_id: stripe.com
        path: apis/openapi/stripe.com
        registered: false
        spec_url: https://raw.githubusercontent.com/jentic/jentic-public-apis/main/apis/openapi/stripe.com/main/2024-01-01/openapi.json
        vendor: stripe.com
      properties:
        _links:
          $ref: '#/components/schemas/CatalogEntryLinksResponse'
          examples:
          - *id037
        api_id:
          description: Catalog identity of the API (manifest domain, e.g. `stripe.com`).
          examples:
          - stripe.com
          title: Api Id
          type: string
        path:
          anyOf:
          - type: string
          - type: 'null'
          description: Manifest path of the entry within the public-APIs repo.
          examples:
          - apis/openapi/stripe.com
          title: Path
        registered:
          description: Whether this entry is already imported locally — its `spec_url` backs a non-archived revision in `GET /apis`.
          examples:
          - true
          title: Registered
          type: boolean
        spec_url:
          anyOf:
          - type: string
          - type: 'null'
          description: Fetchable OpenAPI spec URL the entry resolves to (used for import + coverage).
          examples:
          - https://raw.githubusercontent.com/jentic/jentic-public-apis/main/apis/openapi/stripe.com/main/2024-04-10/openapi.json
          title: Spec Url
        update_available:
          default: false
          description: Whether this (registered) entry has an upstream spec update the local revision hasn't adopted yet. Always false for unregistered entries.
          examples:
          - false
          title: Update Available
          type: boolean
        vendor:
          anyOf:
          - type: string
          - type: 'null'
          description: Registrable-domain vendor derived from `api_id` (e.g. `stripe.com`).
          examples:
          - stripe.com
          title: Vendor
      required:
      - api_id
      - vendor
      - path
      - spec_url
      - registered
      - _links
      title: CatalogEntryResponse
      type: object
    CatalogListResponse:
      description: List of catalog entries plus status fields for the Discover status row.
      examples:
      - &id215
        catalog_total: 5231
        data: []
        has_more: true
        manifest_age_seconds: 3600
        next_cursor: eyJpZCI6ICJzdHJpcGUuY29tIn0=
        registered_count: 12
      properties:
        catalog_total:
          description: Total entries in the whole manifest (pre-filter, pre-page).
          examples:
          - 5231
          title: Catalog Total
          type: integer
        data:
          description: The page of catalog entries.
          examples:
          - - *id038
          items:
            $ref: '#/components/schemas/CatalogEntryResponse'
          title: Data
          type: array
        has_more:
          default: false
          description: Whether another page follows.
          examples:
          - true
          title: Has More
          type: boolean
        manifest_age_seconds:
          anyOf:
          - type: integer
          - type: 'null'
          description: Age of the cached manifest in seconds, or null when the cache is empty.
          examples:
          - 3600
          title: Manifest Age Seconds
        next_cursor:
          anyOf:
          - type: string
          - type: 'null'
          description: Opaque keyset cursor for the next page (null when done).
          examples:
          - eyJpZCI6ICJzdHJpcGUuY29tIn0=
          title: Next Cursor
        outdated_count:
          default: 0
          description: Count of whole-manifest registered entries with an upstream update available.
          examples:
          - 1
          title: Outdated Count
          type: integer
        registered_count:
          description: Count of whole-manifest entries already imported locally.
          examples:
          - 12
          title: Registered Count
          type: integer
      required:
      - data
      - catalog_total
      - registered_count
      title: CatalogListResponse
      type: object
    CatalogRefreshResponse:
      description: Acknowledgement of a manifest refresh.
      examples:
      - &id219
        count: 5231
        status: refreshed
      properties:
        count:
          description: Number of entries in the freshly fetched manifest.
          examples:
          - 5231
          title: Count
          type: integer
        status:
          default: refreshed
          description: Refresh outcome marker.
          examples:
          - refreshed
          title: Status
          type: string
      required:
      - count
      title: CatalogRefreshResponse
      type: object
    CatalogSnoozeRequest:
      description: |-
        Body for ``POST /catalog/{api_id}:snooze`` (C1, #925).

        ``snoozed_until`` is optional: omit or send ``null`` to mute-until-newer (the primary
        per-API affordance — the badge re-lights only when a *newer* upstream digest lands);
        provide an ISO-8601 timestamp for a time-boxed snooze that lapses at that instant.
      examples:
      - snoozed_until: '2026-02-01T00:00:00Z'
      properties:
        snoozed_until:
          anyOf:
          - format: date-time
            type: string
          - type: 'null'
          description: Optional expiry for the snooze (ISO-8601). Null = mute until a newer upstream digest is observed.
          examples:
          - '2026-02-01T00:00:00Z'
          title: Snoozed Until
      title: CatalogSnoozeRequest
      type: object
    ChangePasswordRequest:
      description: Payload for changing own password.
      examples:
      - &id280
        current_password: example-password
        new_password: example-new-password
      properties:
        current_password:
          description: The caller's current password.
          examples:
          - example-password
          maxLength: 128
          minLength: 1
          title: Current Password
          type: string
          x-sensitive: true
        new_password:
          description: The new password to set.
          examples:
          - example-new-password
          maxLength: 128
          minLength: 12
          title: New Password
          type: string
          x-sensitive: true
      required:
      - current_password
      - new_password
      title: ChangePasswordRequest
      type: object
    ClaimRequest:
      description: Request body for claiming ownership of a self-registered agent.
      examples:
      - &id196
        token: dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk
      properties:
        token:
          description: Single-use claim token returned when the agent self-registered.
          examples:
          - dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk
          maxLength: 512
          minLength: 1
          title: Token
          type: string
          x-sensitive: true
      required:
      - token
      title: ClaimRequest
      type: object
    ConnectRequestBody:
      description: Request body for initiating a credential connect flow.
      examples:
      - &id230
        extra: &id039
          prompt: consent
        scopes: &id040
        - read_write
      properties:
        extra:
          additionalProperties:
            type: string
          description: Additional provider-specific connect parameters.
          examples:
          - *id039
          title: Extra
          type: object
        scopes:
          description: OAuth scopes to request.
          examples:
          - *id040
          items:
            type: string
          title: Scopes
          type: array
      title: ConnectRequestBody
      type: object
    ConnectSessionListResponse:
      description: Cursor-paginated envelope of connect-session summaries.
      examples:
      - &id220
        data: &id041
        - agent_id: agnt_6968b3984d1c238dbe7e2e29
          connected_as: octocat
          created_at: '2026-01-15T09:30:00Z'
          credential_id: cred_6968b39855d91a3561684b32
          error_code: access_denied
          reason: Needs read access to triage issues in the platform repo.
          requested_by_actor_id: agnt_6968b3984d1c238dbe7e2e29
          session_id: cs_6968b3983b8b91c75627bee5
          state: connected
          vendor_display_name: GitHub
          vendor_key: github
        has_more: true
        next_cursor: eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
      properties:
        data:
          description: The page of connect sessions.
          examples:
          - *id041
          items:
            $ref: '#/components/schemas/ConnectSessionSummaryResponse'
          title: Data
          type: array
        has_more:
          description: Whether more results exist after this page.
          examples:
          - true
          title: Has More
          type: boolean
        next_cursor:
          anyOf:
          - type: string
          - type: 'null'
          description: Cursor for the next page; null when there are no more results.
          examples:
          - eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
          title: Next Cursor
      required:
      - data
      - has_more
      title: ConnectSessionListResponse
      type: object
    ConnectSessionSummaryResponse:
      description: Slim list row for the console — deliberately excludes ``poll_token``.
      examples:
      - agent_id: agnt_6968b3984d1c238dbe7e2e29
        connected_as: octocat
        created_at: '2026-01-15T09:30:00Z'
        credential_id: cred_6968b39855d91a3561684b32
        error_code: access_denied
        reason: Needs read access to triage issues in the platform repo.
        requested_by_actor_id: agnt_6968b3984d1c238dbe7e2e29
        session_id: cs_6968b3983b8b91c75627bee5
        state: connected
        vendor_display_name: GitHub
        vendor_key: github
      properties:
        agent_id:
          anyOf:
          - type: string
          - type: 'null'
          description: ID of the agent the credential is bound to on confirm; null when unbound.
          examples:
          - agnt_6968b3984d1c238dbe7e2e29
          title: Agent Id
        connected_as:
          anyOf:
          - type: string
          - type: 'null'
          description: Upstream account the credential connected as; null until known.
          examples:
          - octocat
          title: Connected As
        created_at:
          description: When the session was created (RFC 3339).
          examples:
          - '2026-01-15T09:30:00Z'
          format: date-time
          title: Created At
          type: string
        credential_id:
          description: ID of the session's credential (pending until the session connects).
          examples:
          - cred_6968b39855d91a3561684b32
          title: Credential Id
          type: string
        error_code:
          anyOf:
          - type: string
          - type: 'null'
          description: Reserved for a failure code; always null on listed sessions.
          examples:
          - access_denied
          title: Error Code
        reason:
          anyOf:
          - type: string
          - type: 'null'
          description: Free-text reason given when the session was started.
          examples:
          - Needs read access to triage issues in the platform repo.
          title: Reason
        requested_by_actor_id:
          description: ID of the actor that started the session.
          examples:
          - agnt_6968b3984d1c238dbe7e2e29
          title: Requested By Actor Id
          type: string
        session_id:
          description: Unique ID of the connect session.
          examples:
          - cs_6968b3983b8b91c75627bee5
          title: Session Id
          type: string
        state:
          description: Current lifecycle state of the session.
          enum:
          - created
          - awaiting_app
          - polling
          - connected
          examples:
          - connected
          title: State
          type: string
        vendor_display_name:
          description: Display name of the vendor.
          examples:
          - GitHub
          title: Vendor Display Name
          type: string
        vendor_key:
          description: Vendor registry key the session connects.
          examples:
          - github
          title: Vendor Key
          type: string
      required:
      - session_id
      - state
      - vendor_key
      - vendor_display_name
      - requested_by_actor_id
      - created_at
      - credential_id
      title: ConnectSessionSummaryResponse
      type: object
    ConsentAgentStatusResponse:
      description: |-
        Minimal tri-state for the consent page's pending-agent awaiting page (P4).

        Deliberately carries nothing else — no agent name, owner, or scopes — so
        the anonymous poll endpoint cannot be used to read agent details. The
        poll is keyed by a signed ``agent-status`` blob bound to one agent id,
        never a bare id, and non-terminal lifecycle states (disabled, archived, a
        vanished row) all read as ``pending`` so the endpoint is not a lifecycle
        oracle either.
      examples:
      - &id261
        status: pending
      properties:
        status:
          description: 'Approval state of the agent: `pending`, `approved` or `denied`; any state other than approved or denied reads as `pending`.'
          enum:
          - pending
          - approved
          - denied
          examples:
          - pending
          title: Status
          type: string
      required:
      - status
      title: ConsentAgentStatusResponse
      type: object
    CreateAdminRequest:
      description: Payload for first-run admin creation (one-time setup).
      examples:
      - &id285
        email: admin@example.com
        first_name: Ada
        last_name: Lovelace
        password: example-password
      properties:
        email:
          description: Email address of the first admin.
          examples:
          - admin@example.com
          maxLength: 320
          minLength: 1
          title: Email
          type: string
        first_name:
          default: Admin
          description: First name of the first admin; defaults to `Admin`.
          examples:
          - Ada
          maxLength: 100
          minLength: 1
          title: First Name
          type: string
        last_name:
          default: User
          description: Last name of the first admin; defaults to `User`.
          examples:
          - Lovelace
          maxLength: 100
          minLength: 1
          title: Last Name
          type: string
        password:
          description: Password for the first admin.
          examples:
          - example-password
          maxLength: 128
          minLength: 12
          title: Password
          type: string
          x-sensitive: true
      required:
      - email
      - password
      title: CreateAdminRequest
      type: object
    CredentialAgentListResponse:
      description: Paginated list of agents directly bound to a credential.
      examples:
      - &id224
        data: &id042
        - agent_id: agnt_6968b3984d1c238dbe7e2e29
          agent_name: billing-assistant
          bound_at: '2026-01-15T09:30:00Z'
          rule_set_id: prs_6968b3987c22b63e87e79f05
          status: active
          suspended: false
        has_more: true
        next_cursor: eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
      properties:
        data:
          description: The page of bound agents.
          examples:
          - *id042
          items:
            $ref: '#/components/schemas/CredentialAgentResponse'
          title: Data
          type: array
        has_more:
          description: Whether more results exist after this page.
          examples:
          - true
          title: Has More
          type: boolean
        next_cursor:
          anyOf:
          - type: string
          - type: 'null'
          description: Cursor for the next page; null when there are no more results.
          examples:
          - eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
          title: Next Cursor
      required:
      - data
      - has_more
      title: CredentialAgentListResponse
      type: object
    CredentialAgentResponse:
      description: Agent directly bound to a credential (theme 5 phase 1).
      examples:
      - agent_id: agnt_6968b3984d1c238dbe7e2e29
        agent_name: billing-assistant
        bound_at: '2026-01-15T09:30:00Z'
        rule_set_id: prs_6968b3987c22b63e87e79f05
        status: active
        suspended: false
      properties:
        agent_id:
          description: ID of the bound agent.
          examples:
          - agnt_6968b3984d1c238dbe7e2e29
          title: Agent Id
          type: string
        agent_name:
          description: Name of the bound agent.
          examples:
          - billing-assistant
          title: Agent Name
          type: string
        bound_at:
          description: When the agent was bound to the credential (RFC 3339).
          examples:
          - '2026-01-15T09:30:00Z'
          format: date-time
          title: Bound At
          type: string
        rule_set_id:
          anyOf:
          - type: string
          - type: 'null'
          description: Shared permission rule set this binding points at, if any. While attached, the set's ordered list is the binding's effective policy; null means the binding's inline rules apply.
          examples:
          - prs_6968b3987c22b63e87e79f05
          title: Rule Set Id
        status:
          description: Status of the bound agent.
          examples:
          - active
          title: Status
          type: string
        suspended:
          description: 'True when the binding is soft-suspended (reversible cut-off): the binding and its rules survive, but the agent cannot execute through this credential until resumed.'
          examples:
          - false
          title: Suspended
          type: boolean
      required:
      - agent_id
      - agent_name
      - status
      - bound_at
      - suspended
      title: CredentialAgentResponse
      type: object
    CredentialBindRequest:
      description: Request body for directly binding a credential to an agent.
      examples:
      - &id190
        credential_id: cred_6968b39855d91a3561684b32
      properties:
        credential_id:
          description: ID of the credential to bind to the agent.
          examples:
          - cred_6968b39855d91a3561684b32
          maxLength: 255
          minLength: 1
          title: Credential Id
          type: string
      required:
      - credential_id
      title: CredentialBindRequest
      type: object
    CredentialBindingEntry:
      description: Direct agent↔credential binding summary for the /me response (theme 5 phase 1).
      examples:
      - &id068
        bound_at: '2026-01-15T09:30:00Z'
        credential_id: cred_6968b39855d91a3561684b32
        name: Stripe production key
        rule_set_id: prs_6968b3987c22b63e87e79f05
        serves: &id043
        - api_name: stripe
          api_vendor: stripe.com
          api_version: '2024-04-10'
        suspended: false
        suspended_reason: api_deleted
      properties:
        bound_at:
          description: When the credential was bound (RFC 3339).
          examples:
          - '2026-01-15T09:30:00Z'
          format: date-time
          title: Bound At
          type: string
        credential_id:
          description: ID of the bound credential.
          examples:
          - cred_6968b39855d91a3561684b32
          title: Credential Id
          type: string
        name:
          anyOf:
          - type: string
          - type: 'null'
          description: Name of the bound credential; null if it no longer exists or cannot be resolved.
          examples:
          - Stripe production key
          title: Name
        rule_set_id:
          anyOf:
          - type: string
          - type: 'null'
          description: ID of the shared permission rule set attached; null when inline rules apply.
          examples:
          - prs_6968b3987c22b63e87e79f05
          title: Rule Set Id
        serves:
          default: []
          description: The APIs the bound credential serves; empty if unresolvable.
          examples:
          - *id043
          items:
            $ref: '#/components/schemas/ServedApiRef'
          title: Serves
          type: array
        suspended:
          default: false
          description: Whether the binding is suspended; the agent cannot execute through it until resumed.
          examples:
          - false
          title: Suspended
          type: boolean
        suspended_reason:
          anyOf:
          - type: string
          - type: 'null'
          description: 'Why the binding is suspended: null for a manual suspension, `api_deleted` when the API the credential serves was deleted.'
          examples:
          - api_deleted
          title: Suspended Reason
      required:
      - credential_id
      - bound_at
      title: CredentialBindingEntry
      type: object
    CredentialBindingListResponse:
      description: List of direct credential bindings.
      examples:
      - &id189
        data: &id044
        - agent_id: agnt_6968b3984d1c238dbe7e2e29
          bound_at: '2026-01-15T09:30:00Z'
          credential_id: cred_6968b39855d91a3561684b32
          id: acb_6968b3989a4f1c2e7d3b5a60
          name: Stripe production key
          rule_set_id: prs_6968b3987c22b63e87e79f05
          serves:
          - api_name: stripe
            api_vendor: stripe.com
            api_version: '2024-04-10'
          suspended: false
          suspended_reason: api_deleted
      properties:
        data:
          description: The agent's direct credential bindings.
          examples:
          - *id044
          items:
            $ref: '#/components/schemas/CredentialBindingResponse'
          title: Data
          type: array
      required:
      - data
      title: CredentialBindingListResponse
      type: object
    CredentialBindingResponse:
      description: Direct agent↔credential binding representation in API responses.
      examples:
      - &id191
        agent_id: agnt_6968b3984d1c238dbe7e2e29
        bound_at: '2026-01-15T09:30:00Z'
        credential_id: cred_6968b39855d91a3561684b32
        id: acb_6968b3989a4f1c2e7d3b5a60
        name: Stripe production key
        rule_set_id: prs_6968b3987c22b63e87e79f05
        serves: &id045
        - api_name: stripe
          api_vendor: stripe.com
          api_version: '2024-04-10'
        suspended: false
        suspended_reason: api_deleted
      properties:
        agent_id:
          description: ID of the agent the credential is bound to.
          examples:
          - agnt_6968b3984d1c238dbe7e2e29
          title: Agent Id
          type: string
        bound_at:
          description: When the credential was bound (RFC 3339).
          examples:
          - '2026-01-15T09:30:00Z'
          format: date-time
          title: Bound At
          type: string
        credential_id:
          description: ID of the bound credential.
          examples:
          - cred_6968b39855d91a3561684b32
          title: Credential Id
          type: string
        id:
          description: Unique ID of the binding.
          examples:
          - acb_6968b3989a4f1c2e7d3b5a60
          title: Id
          type: string
        name:
          anyOf:
          - type: string
          - type: 'null'
          description: Name of the bound credential; null if it cannot be resolved.
          examples:
          - Stripe production key
          title: Name
        rule_set_id:
          anyOf:
          - type: string
          - type: 'null'
          description: ID of the shared permission rule set attached; null when inline rules apply.
          examples:
          - prs_6968b3987c22b63e87e79f05
          title: Rule Set Id
        serves:
          default: []
          description: The APIs the bound credential serves; empty if unresolvable.
          examples:
          - *id045
          items:
            $ref: '#/components/schemas/ServedApiRef'
          title: Serves
          type: array
        suspended:
          description: Whether the binding is suspended, cutting off the agent's access to it.
          examples:
          - false
          title: Suspended
          type: boolean
        suspended_reason:
          anyOf:
          - type: string
          - type: 'null'
          description: 'Why the binding is suspended: null for a manual suspension, `api_deleted` when the API the credential serves was deleted; cleared on resume.'
          examples:
          - api_deleted
          title: Suspended Reason
      required:
      - id
      - agent_id
      - credential_id
      - bound_at
      - suspended
      title: CredentialBindingResponse
      type: object
    CredentialCreateResponse:
      description: 'Create response: redacted + secret shown once.'
      examples:
      - &id222
        credential:
          active: true
          api:
            name: stripe
            vendor: stripe-com
            version: '2024-04-10'
          created_at: '2026-01-15T09:30:00Z'
          credential_id: cred_01HZX9...
          name: Stripe live key
          provider: static
          type: api_key
        secret:
          key: sk_live_…
      - credential:
          active: true
          api:
            name: posthog-api
            vendor: posthog-com
            version: '1.0'
          created_at: '2026-01-15T09:31:00Z'
          credential_id: cred_01HZXA...
          name: PostHog personal key
          provider: static
          type: bearer_token
        secret:
          token: phx_…
        warnings:
        - 'API scope ''posthog-com/posthog-api/1.0'' matches no imported API — executions using this credential will fail. Import a matching API, or delete this credential and re-create it scoped to an imported identity; imported APIs for this vendor: posthog-com/posthog-com-posthog-api (1.0)'
      properties:
        credential:
          $ref: '#/components/schemas/CredentialRedactedResponse'
          examples:
          - &id046
            active: true
            api:
              name: stripe
              vendor: stripe.com
              version: '2024-04-10'
            created_at: '2026-01-15T09:30:00Z'
            credential_id: cred_01HZX9...
            details:
              field_name: Authorization
              hint: …live_abcd
              location: header
            name: Stripe live key
            provider: static
            type: api_key
        secret:
          additionalProperties: true
          description: Type-specific secret material, returned only in this create response.
          examples:
          - key: example-secret
          title: Secret
          type: object
          x-sensitive: true
        warnings:
          anyOf:
          - items:
              type: string
            type: array
          - type: 'null'
          description: Advisory warnings from create — e.g. the credential's API scope matches no imported API identity, so execution through it would fail until a matching API is imported. The credential is created regardless; null when there is nothing to flag.
          examples:
          - - API scope 'stripe.com/stripe/2024-04-10' matches no imported API.
          title: Warnings
      required:
      - credential
      - secret
      title: CredentialCreateResponse
      type: object
    CredentialListResponse:
      description: Paginated list of credentials.
      examples:
      - &id221
        data: &id047
        - *id046
        has_more: true
        next_cursor: eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
      properties:
        data:
          description: The page of credentials.
          examples:
          - *id047
          items:
            $ref: '#/components/schemas/CredentialRedactedResponse'
          title: Data
          type: array
        has_more:
          description: Whether more results exist after this page.
          examples:
          - true
          title: Has More
          type: boolean
        next_cursor:
          anyOf:
          - type: string
          - type: 'null'
          description: Cursor for the next page; null when there are no more results.
          examples:
          - eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
          title: Next Cursor
      required:
      - data
      - has_more
      title: CredentialListResponse
      type: object
    CredentialLocation:
      description: Where an API-key credential is injected into a request.
      enum:
      - header
      - query
      - cookie
      title: CredentialLocation
      type: string
    CredentialRedactedResponse:
      description: Redacted credential response (for read/list/patch).
      examples:
      - *id046
      properties:
        active:
          description: Whether the credential is enabled for injection.
          examples:
          - true
          title: Active
          type: boolean
        api:
          $ref: '#/components/schemas/APIReference'
          description: The (vendor, name, version) API this credential targets.
          examples:
          - *id048
        catalog_api_id:
          anyOf:
          - type: string
          - type: 'null'
          description: Catalog identity slug of the target API (`domain[/sub-api]`), when recorded at create time. Display-only; null for older credentials.
          examples:
          - stripe.com
          title: Catalog Api Id
        created_at:
          description: Creation timestamp (UTC).
          examples:
          - '2026-01-15T09:30:00Z'
          format: date-time
          title: Created At
          type: string
        created_by:
          anyOf:
          - type: string
          - type: 'null'
          description: Identity that created the credential (its owner).
          examples:
          - usr_6968b3987ee4c3ec0b4ee3b9
          title: Created By
        credential_id:
          description: Stable credential identifier, prefixed `cred_`.
          examples:
          - cred_6968b39855d91a3561684b32
          title: Credential Id
          type: string
        details:
          anyOf:
          - additionalProperties: true
            type: object
          - type: 'null'
          description: 'Redacted, type-specific projection (hints/last-N chars; never the secret). For oauth2: client_id, token_url, grant_type (authorization_code | client_credentials), scopes, and — for authorization_code only — `connected`, whether the interactive sign-in completed and is still usable (null for other grants).'
          examples:
          - client_id: ca_example123
            connected: true
            grant_type: authorization_code
            scopes:
            - read_write
            token_url: https://connect.stripe.com/oauth/token
          title: Details
        name:
          description: Human-readable label.
          examples:
          - Stripe Connect
          title: Name
          type: string
        oauth_app_registration_id:
          anyOf:
          - type: string
          - type: 'null'
          description: Id of the shared ``oauth_app_registrations`` row this credential was minted through, if any. Null for legacy embedded OAuth credentials and every non-OAuth type.
          examples:
          - oar_6968b39821e5f89a6975f501
          title: Oauth App Registration Id
        oauth_app_registration_name:
          anyOf:
          - type: string
          - type: 'null'
          description: Admin-facing name of the shared OAuth app registration this credential was minted through. Null when the credential is not backed by a shared registration.
          examples:
          - MyOrg Stripe
          title: Oauth App Registration Name
        provider:
          description: Credential provider; 'static' for stored secrets.
          examples:
          - direct_oauth2
          title: Provider
          type: string
        provider_account_ref:
          anyOf:
          - type: string
          - type: 'null'
          description: Opaque reference to the provider account, when applicable.
          examples:
          - acct_1Nv0FGQ9RKHgCVdK
          title: Provider Account Ref
        server_variables:
          anyOf:
          - additionalProperties:
              type: string
            type: object
          - type: 'null'
          description: OpenAPI server-variable values for URL template substitution.
          examples:
          - region: eu
          title: Server Variables
        type:
          $ref: '#/components/schemas/CredentialType'
          description: Credential auth type (api_key, bearer_token, basic, oauth2).
          examples:
          - oauth2
        updated_at:
          anyOf:
          - format: date-time
            type: string
          - type: 'null'
          description: Last update timestamp (UTC).
          examples:
          - '2026-01-20T14:05:00Z'
          title: Updated At
      required:
      - credential_id
      - type
      - name
      - api
      - provider
      - active
      - created_at
      title: CredentialRedactedResponse
      type: object
    CredentialType:
      description: Wire-level credential type used by the provider abstraction.
      enum:
      - bearer_token
      - api_key
      - basic
      - oauth2
      - no_auth
      - sigv4
      title: CredentialType
      type: string
    CurrentUserResponse:
      description: Current user profile.
      examples:
      - &id279
        active: true
        created_at: '2026-01-15T09:30:00Z'
        email: ada@example.com
        first_name: Ada
        id: usr_6968b3987ee4c3ec0b4ee3b9
        last_name: Lovelace
        must_change_password: false
        permissions: &id049
        - users:write
        - users:read
        - agents:read
        updated_at: '2026-01-20T14:05:00Z'
      properties:
        active:
          description: Whether the user account is enabled.
          examples:
          - true
          title: Active
          type: boolean
        created_at:
          description: When the user was created (RFC 3339).
          examples:
          - '2026-01-15T09:30:00Z'
          format: date-time
          title: Created At
          type: string
        email:
          description: Email address of the user.
          examples:
          - ada@example.com
          title: Email
          type: string
        first_name:
          description: First name of the user.
          examples:
          - Ada
          title: First Name
          type: string
        id:
          description: Unique ID of the user.
          examples:
          - usr_6968b3987ee4c3ec0b4ee3b9
          title: Id
          type: string
        last_name:
          description: Last name of the user.
          examples:
          - Lovelace
          title: Last Name
          type: string
        must_change_password:
          description: Whether the user must change their password before using other endpoints.
          examples:
          - false
          title: Must Change Password
          type: boolean
        permissions:
          description: The user's effective permissions, including those implied by assigned ones.
          examples:
          - *id049
          items:
            type: string
          title: Permissions
          type: array
        updated_at:
          anyOf:
          - format: date-time
            type: string
          - type: 'null'
          description: When the user was last updated (RFC 3339); null if never updated.
          examples:
          - '2026-01-20T14:05:00Z'
          title: Updated At
      required:
      - id
      - email
      - first_name
      - last_name
      - active
      - permissions
      - must_change_password
      - created_at
      title: CurrentUserResponse
      type: object
    DailyExecutionBucket:
      description: Execution counts for a single day.
      examples:
      - &id057
        date: '2026-01-15'
        failed: 8
        success: 120
        total: 128
      properties:
        date:
          description: The day the bucket covers, as `YYYY-MM-DD`.
          examples:
          - '2026-01-15'
          title: Date
          type: string
        failed:
          description: Number of those executions that failed.
          examples:
          - 8
          title: Failed
          type: integer
        success:
          description: Number of those executions that completed.
          examples:
          - 120
          title: Success
          type: integer
        total:
          description: Number of executions started that day.
          examples:
          - 128
          title: Total
          type: integer
      required:
      - date
      - total
      - success
      - failed
      title: DailyExecutionBucket
      type: object
    DenyRequest:
      description: Request body for denying an agent.
      examples:
      - &id197
        reason: Requested permissions exceed the agent's stated purpose.
      properties:
        reason:
          description: Why the agent is being denied.
          examples:
          - Requested permissions exceed the agent's stated purpose.
          maxLength: 1024
          minLength: 1
          title: Reason
          type: string
      required:
      - reason
      title: DenyRequest
      type: object
    DeviceAuthorizationRegistrationCreateRequest:
      additionalProperties: false
      description: Create request for a device-authorization registration.
      examples:
      - api_vendor: github
        authorization_endpoint: https://github.com/login/device/code
        catalog_api_id: github.com/api.github.com
        client_id: Iv1.a1b2c3d4
        default_scopes:
        - repo
        display_name: GitHub
        flow_kind: device_authorization
        name: MyOrg GitHub (device flow)
        token_endpoint: https://github.com/login/oauth/access_token
      properties:
        api_vendor:
          description: Vendor registry key the registration connects.
          examples:
          - github
          maxLength: 100
          minLength: 1
          title: Api Vendor
          type: string
        authorization_endpoint:
          description: Device authorization endpoint URL.
          examples:
          - https://github.com/login/device/code
          maxLength: 2048
          minLength: 1
          title: Authorization Endpoint
          type: string
        catalog_api_id:
          description: Catalog API slug this OAuth app targets (e.g. 'github.com/api.github.com').
          examples:
          - github.com/api.github.com
          maxLength: 255
          minLength: 1
          pattern: ^[^/].*/.*[^/]$
          title: Catalog Api Id
          type: string
        client_id:
          description: OAuth client ID of the app.
          examples:
          - Iv1.a1b2c3d4
          maxLength: 255
          minLength: 1
          title: Client Id
          type: string
        default_scopes:
          anyOf:
          - items:
              maxLength: 255
              minLength: 1
              pattern: ^\S+$
              type: string
            type: array
          - type: 'null'
          description: Scopes requested by default.
          examples:
          - - repo
          title: Default Scopes
        display_name:
          description: Vendor family label ('GitHub'), shown on picker cards.
          examples:
          - GitHub
          maxLength: 255
          minLength: 1
          title: Display Name
          type: string
        flow_kind:
          const: device_authorization
          description: OAuth flow the registration uses; always `device_authorization`.
          examples:
          - device_authorization
          title: Flow Kind
          type: string
        name:
          description: Admin-chosen name of the registration.
          examples:
          - MyOrg GitHub
          maxLength: 255
          minLength: 1
          title: Name
          type: string
        token_endpoint:
          description: Token endpoint URL.
          examples:
          - https://github.com/login/oauth/access_token
          maxLength: 2048
          minLength: 1
          title: Token Endpoint
          type: string
      required:
      - name
      - api_vendor
      - catalog_api_id
      - display_name
      - flow_kind
      - client_id
      - authorization_endpoint
      - token_endpoint
      title: DeviceAuthorizationRegistrationCreateRequest
      type: object
    EffectivePermission:
      description: A single effective permission with provenance.
      examples:
      - &id118
        implied_by: users:write
        name: users:read
      properties:
        implied_by:
          anyOf:
          - type: string
          - type: 'null'
          description: Assigned permission that implies this one; null when it is assigned directly.
          examples:
          - users:write
          title: Implied By
        name:
          description: Permission name.
          examples:
          - users:read
          title: Name
          type: string
      required:
      - name
      title: EffectivePermission
      type: object
    ErrorItem:
      description: |-
        A granular error detail entry within the errors[] array of a ProblemDetails response.

        At least one of pointer, parameter, or header SHOULD be present to identify the error source.
      examples:
      - &id127
        code: JENTIC-V-001
        detail: Field 'name' must not be blank.
        header: Authorization
        parameter: limit
        pointer: '#/name'
      properties:
        code:
          anyOf:
          - maxLength: 50
            type: string
          - type: 'null'
          description: An optional provider-specific code identifying this error in internal taxonomy or documentation.
          examples:
          - JENTIC-V-001
          title: Code
        detail:
          description: A human-readable explanation of this specific error. Be precise — name the field, parameter, or header involved.
          examples:
          - Field 'name' must not be blank.
          maxLength: 4096
          title: Detail
          type: string
        header:
          anyOf:
          - maxLength: 1024
            type: string
          - type: 'null'
          description: The name of the request header that is the source of this error.
          examples:
          - Authorization
          title: Header
        parameter:
          anyOf:
          - maxLength: 1024
            type: string
          - type: 'null'
          description: The name of the query or path parameter that is the source of this error.
          examples:
          - limit
          title: Parameter
        pointer:
          anyOf:
          - maxLength: 1024
            type: string
          - type: 'null'
          description: A JSON Pointer (RFC 6901) to the specific request body property that is the source of this error.
          examples:
          - '#/name'
          title: Pointer
      required:
      - detail
      title: ErrorItem
      type: object
    EventLinks:
      description: HAL-style links for an event.
      examples:
      - &id050
        action: https://jentic.example.com/events/evt_6968b398b04f002b6dbff4d1/action
        execution: https://jentic.example.com/executions/exec_6968b3982706c619fe73f0cf
        job: https://jentic.example.com/jobs/job_6968b3985e8c9902207afaeb
        self: https://jentic.example.com/events/evt_6968b398b04f002b6dbff4d1
      properties:
        action:
          anyOf:
          - type: string
          - type: 'null'
          description: Reserved link to a follow-up action; currently always null.
          examples:
          - https://jentic.example.com/events/evt_6968b398b04f002b6dbff4d1/action
          title: Action
        execution:
          anyOf:
          - type: string
          - type: 'null'
          description: URL of the related execution record; null if none.
          examples:
          - https://jentic.example.com/executions/exec_6968b3982706c619fe73f0cf
          title: Execution
        job:
          anyOf:
          - type: string
          - type: 'null'
          description: URL of the related job; null if none.
          examples:
          - https://jentic.example.com/jobs/job_6968b3985e8c9902207afaeb
          title: Job
        self:
          description: URL of this event.
          examples:
          - https://jentic.example.com/events/evt_6968b398b04f002b6dbff4d1
          title: Self
          type: string
      required:
      - self
      title: EventLinks
      type: object
    EventListResponse:
      description: Paginated list of events.
      examples:
      - &id233
        data: &id051
        - _links: *id050
          actor_id: usr_6968b3987ee4c3ec0b4ee3b9
          actor_type: user
          created_at: '2026-01-15T09:30:00Z'
          data: &id052
            job_id: job_6968b3985e8c9902207afaeb
            revision_id: 3f2b8c1e-7d4a-4e9b-a6c5-1d2e3f4a5b6c
          detail: The import produced 1 revision with 142 operations.
          event_id: evt_6968b398b04f002b6dbff4d1
          requires_action: false
          severity: info
          summary: Imported stripe.com/stripe 2024-04-10
          trace_id: 4bf92f3577b34da6a3ce929d0e0e4736
          type: import.completed
        has_more: true
        next_cursor: eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
      properties:
        data:
          description: The page of events.
          examples:
          - *id051
          items:
            $ref: '#/components/schemas/EventResponse'
          title: Data
          type: array
        has_more:
          description: Whether more results exist after this page.
          examples:
          - true
          title: Has More
          type: boolean
        next_cursor:
          anyOf:
          - type: string
          - type: 'null'
          description: Cursor for the next page; null when there are no more results.
          examples:
          - eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
          title: Next Cursor
      required:
      - data
      - has_more
      title: EventListResponse
      type: object
    EventResponse:
      description: Event representation in API responses.
      examples:
      - &id236
        _links: *id050
        actor_id: usr_6968b3987ee4c3ec0b4ee3b9
        actor_type: user
        created_at: '2026-01-15T09:30:00Z'
        data: *id052
        detail: The import produced 1 revision with 142 operations.
        event_id: evt_6968b398b04f002b6dbff4d1
        requires_action: false
        severity: info
        summary: Imported stripe.com/stripe 2024-04-10
        trace_id: 4bf92f3577b34da6a3ce929d0e0e4736
        type: import.completed
      properties:
        _links:
          $ref: '#/components/schemas/EventLinks'
          examples:
          - *id050
        actor_id:
          anyOf:
          - type: string
          - type: 'null'
          description: ID of the actor that caused the event; null if none.
          examples:
          - usr_6968b3987ee4c3ec0b4ee3b9
          title: Actor Id
        actor_type:
          anyOf:
          - type: string
          - type: 'null'
          description: Kind of actor that caused the event, e.g. `user` or `agent`; null if none.
          examples:
          - user
          title: Actor Type
        created_at:
          description: When the event was created (RFC 3339).
          examples:
          - '2026-01-15T09:30:00Z'
          format: date-time
          title: Created At
          type: string
        data:
          additionalProperties: true
          description: Type-specific structured payload; empty object when there is none.
          examples:
          - *id052
          title: Data
          type: object
        detail:
          anyOf:
          - type: string
          - type: 'null'
          description: Longer human-readable detail; null if none.
          examples:
          - The import produced 1 revision with 142 operations.
          title: Detail
        event_id:
          description: Unique ID of the event (`evt_…`).
          examples:
          - evt_6968b398b04f002b6dbff4d1
          title: Event Id
          type: string
        requires_action:
          description: Whether the event needs someone to act on it.
          examples:
          - false
          title: Requires Action
          type: boolean
        severity:
          $ref: '#/components/schemas/EventSeverity'
          examples:
          - info
        summary:
          description: Short human-readable summary of the event.
          examples:
          - Imported stripe.com/stripe 2024-04-10
          title: Summary
          type: string
        trace_id:
          anyOf:
          - type: string
          - type: 'null'
          description: Trace ID of the request that produced the event, if any.
          examples:
          - 4bf92f3577b34da6a3ce929d0e0e4736
          title: Trace Id
        type:
          description: 'Namespaced event type, e.g. `import.completed`. Opaque string: historical events may carry types that are no longer emitted.'
          examples:
          - import.completed
          title: Type
          type: string
      required:
      - event_id
      - type
      - severity
      - summary
      - requires_action
      - created_at
      - _links
      title: EventResponse
      type: object
    EventSeverity:
      description: Severity level for platform events.
      enum:
      - info
      - warning
      - error
      - critical
      title: EventSeverity
      type: string
    ExecutionListResponse:
      description: Paginated list of executions.
      examples:
      - &id238
        data: &id054
        - _links:
            self: https://jentic.example.com/executions/exec_6968b3982706c619fe73f0cf
          actor_id: agnt_6968b3984d1c238dbe7e2e29
          actor_type: agent
          api: *id053
          created_at: '2026-01-15T09:30:00Z'
          credential_id: cred_6968b39855d91a3561684b32
          credential_name: Stripe production key
          duration_ms: 342
          error: Upstream returned HTTP 502 Bad Gateway
          execution_id: exec_6968b3982706c619fe73f0cf
          http_status: 200
          operation_id: listCharges
          operation_method: GET
          operation_path: /v1/charges
          origin: agent
          pinned_revisions: &id056
            stripe.com:stripe:2024-04-10: 3f2b8c1e-7d4a-4e9b-a6c5-1d2e3f4a5b6c
          started_at: '2026-01-15T09:30:00Z'
          status: completed
          toolkit_id: tk_6968b3981ec22d56dbbc91e8
          toolkit_name: billing-toolkit
          trace_id: 4bf92f3577b34da6a3ce929d0e0e4736
        has_more: true
        next_cursor: eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
      properties:
        data:
          description: The page of execution records.
          examples:
          - *id054
          items:
            $ref: '#/components/schemas/ExecutionResponse'
          title: Data
          type: array
        has_more:
          description: Whether more results exist after this page.
          examples:
          - true
          title: Has More
          type: boolean
        next_cursor:
          anyOf:
          - type: string
          - type: 'null'
          description: Cursor for the next page; null when there are no more results.
          examples:
          - eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
          title: Next Cursor
      required:
      - data
      - has_more
      title: ExecutionListResponse
      type: object
    ExecutionRecordLinks:
      description: HATEOAS links for an execution record.
      examples:
      - &id055
        self: https://jentic.example.com/executions/exec_6968b3982706c619fe73f0cf
      properties:
        self:
          description: URL of this execution record.
          examples:
          - https://jentic.example.com/executions/exec_6968b3982706c619fe73f0cf
          title: Self
          type: string
      required:
      - self
      title: ExecutionRecordLinks
      type: object
    ExecutionResponse:
      description: Execution record representation in API responses.
      examples:
      - &id239
        _links: *id055
        actor_id: agnt_6968b3984d1c238dbe7e2e29
        actor_type: agent
        api: *id053
        created_at: '2026-01-15T09:30:00Z'
        credential_id: cred_6968b39855d91a3561684b32
        credential_name: Stripe production key
        duration_ms: 342
        error: Upstream returned HTTP 502 Bad Gateway
        execution_id: exec_6968b3982706c619fe73f0cf
        http_status: 200
        operation_id: listCharges
        operation_method: GET
        operation_path: /v1/charges
        origin: agent
        pinned_revisions: *id056
        started_at: '2026-01-15T09:30:00Z'
        status: completed
        toolkit_id: tk_6968b3981ec22d56dbbc91e8
        toolkit_name: billing-toolkit
        trace_id: 4bf92f3577b34da6a3ce929d0e0e4736
      properties:
        _links:
          $ref: '#/components/schemas/ExecutionRecordLinks'
          examples:
          - *id055
        actor_id:
          description: ID of the actor that ran the execution.
          examples:
          - agnt_6968b3984d1c238dbe7e2e29
          title: Actor Id
          type: string
        actor_type:
          description: 'Kind of actor that ran the execution, e.g. `user` or `agent`. Opaque string: historical rows may carry a retired type.'
          examples:
          - agent
          title: Actor Type
          type: string
        api:
          anyOf:
          - $ref: '#/components/schemas/ApiInfoResponse'
          - type: 'null'
          description: The API that was called; null when it is not recorded.
          examples:
          - *id053
        created_at:
          description: When the execution record was created (RFC 3339).
          examples:
          - '2026-01-15T09:30:00Z'
          format: date-time
          title: Created At
          type: string
        credential_id:
          anyOf:
          - type: string
          - type: 'null'
          description: ID of the credential used. Null for inline auth, credential-less APIs, older records and executions that failed before a credential was chosen.
          examples:
          - cred_6968b39855d91a3561684b32
          title: Credential Id
        credential_name:
          anyOf:
          - type: string
          - type: 'null'
          description: Name of the credential used; null when no credential is recorded.
          examples:
          - Stripe production key
          title: Credential Name
        duration_ms:
          anyOf:
          - type: integer
          - type: 'null'
          description: Duration of the execution in milliseconds; null if unknown.
          examples:
          - 342
          title: Duration Ms
        error:
          anyOf:
          - type: string
          - type: 'null'
          description: Short error message (at most 128 characters) for a failed execution.
          examples:
          - Upstream returned HTTP 502 Bad Gateway
          title: Error
        execution_id:
          description: Unique ID of the execution record.
          examples:
          - exec_6968b3982706c619fe73f0cf
          title: Execution Id
          type: string
        http_status:
          anyOf:
          - type: integer
          - type: 'null'
          description: HTTP status returned by the upstream; null if no upstream response.
          examples:
          - 200
          title: Http Status
        operation_id:
          anyOf:
          - type: string
          - type: 'null'
          description: Machine identifier of the operation called; null when none was resolved.
          examples:
          - listCharges
          title: Operation Id
        operation_method:
          anyOf:
          - type: string
          - type: 'null'
          description: The operation's HTTP method, e.g. GET. Null whenever operation_path is null.
          examples:
          - GET
          title: Operation Method
        operation_path:
          anyOf:
          - type: string
          - type: 'null'
          description: 'The operation''s spec path template, e.g. /repos/{owner}/{repo}. Null when the record carries no human-readable operation identity: records predating the column, executions of a URL that resolved to no registered operation, and async jobs enqueued with only an operation_id. Display surfaces show a placeholder for such rows — the opaque operation_id is a machine key, not a human fallback.'
          examples:
          - /v1/charges
          title: Operation Path
        origin:
          anyOf:
          - type: string
          - type: 'null'
          description: Surface the execution was initiated from, e.g. `api`, `agent` or `mcp`; null if not recorded.
          examples:
          - agent
          title: Origin
        pinned_revisions:
          anyOf:
          - additionalProperties: true
            type: object
          - type: 'null'
          description: Pinned API revisions used, keyed `vendor:name:version` with the revision ID as value; null when no pin applied.
          examples:
          - *id056
          title: Pinned Revisions
        started_at:
          description: When the execution started (RFC 3339).
          examples:
          - '2026-01-15T09:30:00Z'
          format: date-time
          title: Started At
          type: string
        status:
          description: 'Terminal outcome: `completed` or `failed`. An upstream response with HTTP status 400 or above counts as `failed`.'
          examples:
          - completed
          title: Status
          type: string
        toolkit_id:
          anyOf:
          - type: string
          - type: 'null'
          description: 'Legacy: toolkit that mediated the execution. Null for direct-binding executions; attribute those via `credential_id` instead.'
          examples:
          - tk_6968b3981ec22d56dbbc91e8
          title: Toolkit Id
        toolkit_name:
          anyOf:
          - type: string
          - type: 'null'
          description: 'Legacy: name of the toolkit in `toolkit_id`; null when unavailable.'
          examples:
          - billing-toolkit
          title: Toolkit Name
        trace_id:
          description: Trace ID of the execution request.
          examples:
          - 4bf92f3577b34da6a3ce929d0e0e4736
          title: Trace Id
          type: string
      required:
      - execution_id
      - trace_id
      - started_at
      - status
      - created_at
      - actor_id
      - actor_type
      - _links
      title: ExecutionResponse
      type: object
    ExecutionStatsResponse:
      description: Aggregated execution statistics for the dashboard.
      examples:
      - &id249
        daily_buckets: &id058
        - *id057
        success_rate_percent: 93.75
        top_operations: &id059
        - api_name: stripe
          api_vendor: stripe.com
          failed: 12
          operation_id: listCharges
          total: 342
        total_executions: 1280
      properties:
        daily_buckets:
          description: Per-day execution counts, oldest first; days with no executions are omitted.
          examples:
          - *id058
          items:
            $ref: '#/components/schemas/DailyExecutionBucket'
          title: Daily Buckets
          type: array
        success_rate_percent:
          description: Share of executions in the window that completed, as a percentage rounded to two decimals; 0 when there were none.
          examples:
          - 93.75
          title: Success Rate Percent
          type: number
        top_operations:
          description: The most-executed operations in the window, most executions first (up to 10).
          examples:
          - *id059
          items:
            $ref: '#/components/schemas/TopOperation'
          title: Top Operations
          type: array
        total_executions:
          description: Number of executions started in the window.
          examples:
          - 1280
          title: Total Executions
          type: integer
      required:
      - total_executions
      - success_rate_percent
      - daily_buckets
      - top_operations
      title: ExecutionStatsResponse
      type: object
    ExistingCredentialConfirmSessionRequest:
      additionalProperties: false
      description: Bind a credential the approver already holds (OAuth only if its grant covers the ask).
      examples:
      - agent_id: agnt_6968b3984d1c238dbe7e2e29
        credential_id: cred_6968b39855d91a3561684b32
        digest: 2c26b46b68ffc68ff99b453c1d30413413422d706483bfa0f98a5e886266e7ae
        expected_agent_id: agnt_6968b3984d1c238dbe7e2e29
        kind: existing_credential
        permission_rules: &id060
        - effect: allow
          match_mode: prefix
          methods: *id029
          operations: *id030
          path: /v1/charges
      properties:
        agent_id:
          anyOf:
          - type: string
          - type: 'null'
          description: Agent to bind when the session has none; ignored if the session already has one.
          examples:
          - agnt_6968b3984d1c238dbe7e2e29
          title: Agent Id
        credential_id:
          description: ID of the approver's credential to bind.
          examples:
          - cred_6968b39855d91a3561684b32
          maxLength: 30
          minLength: 1
          title: Credential Id
          type: string
        digest:
          description: Review digest echoed from the review data; a mismatch is 409 review_stale.
          examples:
          - 2c26b46b68ffc68ff99b453c1d30413413422d706483bfa0f98a5e886266e7ae
          maxLength: 64
          minLength: 1
          title: Digest
          type: string
        expected_agent_id:
          anyOf:
          - type: string
          - type: 'null'
          description: Agent ID from the review the approver saw; a mismatch is 409 review_stale.
          examples:
          - agnt_6968b3984d1c238dbe7e2e29
          title: Expected Agent Id
        kind:
          const: existing_credential
          description: Confirm variant; always `existing_credential`.
          examples:
          - existing_credential
          title: Kind
          type: string
        permission_rules:
          description: Permission rules to bind for the agent (at most 100).
          examples:
          - *id060
          items:
            $ref: '#/components/schemas/PermissionRuleSchema'
          maxItems: 100
          title: Permission Rules
          type: array
      required:
      - permission_rules
      - digest
      - kind
      - credential_id
      title: ExistingCredentialConfirmSessionRequest
      type: object
    GovernedHostsResponse:
      description: |-
        The caller's governed host set (canonical order) with its change digest.

        **Hosts only, deliberately**: the set exists for interception scoping
        (divert lists, host filters), so it carries the minimum knowledge — API
        detail stays behind the existing authenticated reads (``GET /apis``).

        Deliberately **unpaginated**: the set is bounded by the caller's own
        credential bindings (tens of hosts, not thousands) and the digest must
        cover the whole set atomically — a paginated digest would be meaningless.
        This is a documented deviation from the list-endpoint pagination
        convention.
      examples:
      - &id240
        data: &id061
        - api.github.com
        - api.stripe.com
        - files.stripe.com:8443
        digest: 9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08
      properties:
        data:
          description: Governed host entries, normalised (lowercased, FQDN root dot stripped, internationalised names IDNA/punycode-encoded), deduplicated, and sorted — the literal URL-index hosts the broker's discovery matches for the APIs the caller's bound credentials cover. An entry is a hostname, a bare IP literal, or either followed by a non-default port (`host[:port]` — default ports are already stripped). Compare case-insensitively (lowercase the incoming host before matching); a gate keying on hostname or SNI alone must strip any `:port` suffix from the entry first. Variable-bearing hosts (defaultless `{var}` server variables) are excluded — the broker's discovery never matches them. On a `5xx` retain the last known set; never fall back to an empty (intercept-nothing) list.
          examples:
          - *id061
          items:
            type: string
          title: Data
          type: array
        digest:
          description: 'SHA-256 hex digest over the newline-joined `data` list; also emitted as the response''s strong `ETag`. To change-poll, send it back quoted — `If-None-Match: "<digest>"` (the bare digest is accepted as a compatibility form) — and expect an empty `304` until the host set changes. Poll at most once per minute.'
          examples:
          - 9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08
          title: Digest
          type: string
      required:
      - data
      - digest
      title: GovernedHostsResponse
      type: object
    GroupBy:
      description: |-
        Grouping dimension for usage statistics.

        ``TOOLKIT`` is a legacy axis: it groups over the surviving
        ``execution_records.toolkit_id`` attribution column, which nothing writes
        since the toolkit path was deleted (theme-5 Phase 6b). It stays so
        historical dashboards keep working; ``CREDENTIAL`` is the live
        consumer axis (execution records carry ``credential_id`` since Phase 2).
      enum:
      - api
      - toolkit
      - credential
      - agent
      title: GroupBy
      type: string
    HealthResponse:
      description: Health check response for the admin surface.
      examples:
      - &id176
        next_step: create_admin
        setup_required: true
        status: ok
        surface: admin
      properties:
        next_step:
          anyOf:
          - type: string
          - type: 'null'
          description: Next setup step to perform, e.g. `create_admin`; null when setup is complete.
          examples:
          - create_admin
          title: Next Step
        setup_required:
          description: Whether first-run setup is still needed because no user exists yet.
          examples:
          - true
          title: Setup Required
          type: boolean
        status:
          description: Health status of the surface; `ok` when it is serving.
          examples:
          - ok
          title: Status
          type: string
        surface:
          description: Name of the surface reporting health; always `admin`.
          examples:
          - admin
          title: Surface
          type: string
      required:
      - status
      - surface
      - setup_required
      title: HealthResponse
      type: object
    InstanceIdentityResponse:
      description: |-
        Self-describing identity of the backend serving this request.

        A client can compare ``backend``/``canonical_base_url``/``host`` against where
        it *thinks* it is pointed to confirm it is talking to the intended backend
        (e.g. a local install vs. a remote one) before diagnosing "missing" data.
      examples:
      - &id242
        backend: remote
        broker_url: https://broker.jentic.example.com
        canonical_base_url: https://jentic.example.com
        host: jentic.example.com
        instance_id: 5f2c9e0b7a41d8c3
        mcp_enabled: true
      properties:
        backend:
          description: 'Operator-declared backend locality (server.backend): ''local'' for a self-hosted install on the operator''s own machine/network, ''remote'' for a hosted install run elsewhere. A hint, not an authorization signal; defaults to ''local''.'
          enum:
          - local
          - remote
          examples:
          - remote
          title: Backend
          type: string
        broker_url:
          anyOf:
          - type: string
          - type: 'null'
          description: 'The broker (data plane) base URL a client should send `execute` traffic to, as configured by the operator (server.mcp.broker_url), with any userinfo stripped. Null when the platform cannot honestly advertise one: on a ''remote'' backend a loopback-host value (the config default) describes the control plane''s own machine, not an address any client can dial, so it is withheld rather than published as misleading guidance. Deployment metadata, not a secret — the broker URL is handed to every client expected to call it (issue #1249).'
          examples:
          - https://broker.jentic.example.com
          title: Broker Url
        canonical_base_url:
          description: The instance's own canonical base URL (auth.canonical_base_url, else server.public_base_url, else the serving bind origin), with any userinfo stripped.
          examples:
          - https://jentic.example.com
          title: Canonical Base Url
          type: string
        host:
          description: Host (and port, when the canonical base URL declares one) parsed from canonical_base_url; '' if unset or unparseable.
          examples:
          - jentic.example.com
          title: Host
          type: string
        instance_id:
          anyOf:
          - type: string
          - type: 'null'
          description: Opaque digest derived from the telemetry instance id — stable per install, but not the telemetry id itself. Null when telemetry has not resolved an id (e.g. telemetry disabled).
          examples:
          - 5f2c9e0b7a41d8c3
          title: Instance Id
        mcp_enabled:
          default: false
          description: 'Whether this instance serves the daemon-native Streamable HTTP MCP endpoint at /mcp (server.mcp.enabled). Lets clients (notably the UI''s agent MCP card) advertise the HTTP transport only when it exists. Not sensitive: the endpoint''s enabled state is observable by probing /mcp anyway.'
          examples:
          - true
          title: Mcp Enabled
          type: boolean
      required:
      - backend
      - canonical_base_url
      - host
      title: InstanceIdentityResponse
      type: object
    IntegrationsConnectRequest:
      additionalProperties: false
      description: Start connecting a credential for a vendor or a registry API.
      examples:
      - &id243
        agent_id: agnt_6968b3984d1c238dbe7e2e29
        api: *id062
        auth_type: oauth2
        name: GitHub (work)
        oauth_app_registration_id: oar_6968b39821e5f89a6975f501
        preferred_flow: authorization_code
        reason: Needs read access to triage issues in the platform repo.
        requested_permission_rules: &id063
        - effect: allow
          match_mode: prefix
          methods: *id029
          operations: *id030
          path: /v1/charges
        requested_scopes: &id064
        - repo
        - read:user
        vendor: github
      properties:
        agent_id:
          anyOf:
          - type: string
          - type: 'null'
          description: ID of the agent to bind the credential to on confirm; agent callers must omit it, and when omitted by a user the credential connects unbound.
          examples:
          - agnt_6968b3984d1c238dbe7e2e29
          title: Agent Id
        api:
          anyOf:
          - $ref: '#/components/schemas/ApiTargetRequest'
          - type: 'null'
          description: Registry API to connect a credential for. Exactly one of vendor or api.
          examples:
          - *id062
        auth_type:
          anyOf:
          - maxLength: 255
            type: string
          - type: 'null'
          description: Declared scheme name or kind to use for an api target
          examples:
          - oauth2
          title: Auth Type
        name:
          anyOf:
          - maxLength: 255
            type: string
          - type: 'null'
          description: Label for the resulting credential; defaults to the vendor's display name.
          examples:
          - GitHub (work)
          title: Name
        oauth_app_registration_id:
          anyOf:
          - maxLength: 30
            type: string
          - type: 'null'
          description: ID of the admin OAuth app registration to connect through; required when several active registrations offer the flow.
          examples:
          - oar_6968b39821e5f89a6975f501
          title: Oauth App Registration Id
        preferred_flow:
          anyOf:
          - type: string
          - type: 'null'
          description: Flow kind to use if the source offers it; defaults to the source's first flow.
          examples:
          - authorization_code
          title: Preferred Flow
        reason:
          anyOf:
          - maxLength: 1024
            type: string
          - type: 'null'
          description: Free-text reason for the request, shown to the approver.
          examples:
          - Needs read access to triage issues in the platform repo.
          title: Reason
        requested_permission_rules:
          description: Permission rules proposed for the agent, shown pre-filled on the review page; nothing is bound until confirm.
          examples:
          - *id063
          items:
            $ref: '#/components/schemas/PermissionRuleSchema'
          maxItems: 100
          title: Requested Permission Rules
          type: array
        requested_scopes:
          description: Upstream scopes to request (at most 100).
          examples:
          - *id064
          items:
            type: string
          maxItems: 100
          title: Requested Scopes
          type: array
        vendor:
          anyOf:
          - type: string
          - type: 'null'
          description: Vendor registry key (e.g. 'github'). Exactly one of vendor or api.
          examples:
          - github
          title: Vendor
      title: IntegrationsConnectRequest
      type: object
    IntrospectResponse:
      description: RFC 7662 introspection response.
      examples:
      - &id262
        active: true
        exp: 1769903999
        scope: apis:read capabilities:execute
        sub: agnt_6968b3984d1c238dbe7e2e29
        token_type: access_token
      properties:
        active:
          description: Whether the token is currently valid.
          examples:
          - true
          title: Active
          type: boolean
        exp:
          anyOf:
          - type: integer
          - type: 'null'
          description: Token expiry, in seconds since the Unix epoch; omitted if unknown.
          examples:
          - 1769903999
          title: Exp
        scope:
          anyOf:
          - type: string
          - type: 'null'
          description: Space-separated effective scopes of the token; omitted if unknown.
          examples:
          - apis:read capabilities:execute
          title: Scope
        sub:
          anyOf:
          - type: string
          - type: 'null'
          description: ID of the actor the token was issued to; omitted if unknown.
          examples:
          - agnt_6968b3984d1c238dbe7e2e29
          title: Sub
        token_type:
          anyOf:
          - type: string
          - type: 'null'
          description: 'Kind of token: `access_token` or `refresh_token`; omitted if unknown.'
          examples:
          - access_token
          title: Token Type
      required:
      - active
      title: IntrospectResponse
      type: object
    InviteIssuedResponse:
      description: Response when an invite token is issued.
      examples:
      - &id284
        expires_at: '2026-01-22T09:30:00Z'
        token: dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk
      properties:
        expires_at:
          description: When the invite token expires (RFC 3339).
          examples:
          - '2026-01-22T09:30:00Z'
          format: date-time
          title: Expires At
          type: string
        token:
          description: One-time invite token the user redeems to set a password.
          examples:
          - dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk
          title: Token
          type: string
          x-sensitive: true
      required:
      - token
      - expires_at
      title: InviteIssuedResponse
      type: object
    InviteState:
      description: State of a user invitation.
      enum:
      - pending
      - redeemed
      - expired
      - accepted
      title: InviteState
      type: string
    JobLinksResponse:
      description: Hypermedia links for a job.
      examples:
      - &id065
        execution: https://jentic.example.com/executions/exec_6968b3982706c619fe73f0cf
        result: https://jentic.example.com/jobs/job_6968b3985e8c9902207afaeb/result
        self: https://jentic.example.com/jobs/job_6968b3985e8c9902207afaeb
      properties:
        execution:
          anyOf:
          - type: string
          - type: 'null'
          description: URL of the related execution record; null if none.
          examples:
          - https://jentic.example.com/executions/exec_6968b3982706c619fe73f0cf
          title: Execution
        result:
          anyOf:
          - type: string
          - type: 'null'
          description: URL of the job result; null until the job has completed.
          examples:
          - https://jentic.example.com/jobs/job_6968b3985e8c9902207afaeb/result
          title: Result
        self:
          description: URL of this job.
          examples:
          - https://jentic.example.com/jobs/job_6968b3985e8c9902207afaeb
          title: Self
          type: string
      required:
      - self
      title: JobLinksResponse
      type: object
    JobListResponse:
      description: Paginated list of jobs.
      examples:
      - &id245
        data: &id066
        - _links: *id065
          actor_id: agnt_6968b3984d1c238dbe7e2e29
          actor_type: agent
          created_at: '2026-01-15T09:30:00Z'
          error: Upstream returned HTTP 502 Bad Gateway
          execution_id: exec_6968b3982706c619fe73f0cf
          job_id: job_6968b3985e8c9902207afaeb
          kind: execution
          status: completed
          updated_at: '2026-01-15T09:30:05Z'
        has_more: true
        next_cursor: eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
      properties:
        data:
          description: The page of jobs.
          examples:
          - *id066
          items:
            $ref: '#/components/schemas/JobResponse'
          title: Data
          type: array
        has_more:
          description: Whether more results exist after this page.
          examples:
          - true
          title: Has More
          type: boolean
        next_cursor:
          anyOf:
          - type: string
          - type: 'null'
          description: Cursor for the next page; null when there are no more results.
          examples:
          - eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
          title: Next Cursor
      required:
      - data
      - has_more
      title: JobListResponse
      type: object
    JobResponse:
      description: Job representation in API responses.
      examples:
      - &id246
        _links: *id065
        actor_id: agnt_6968b3984d1c238dbe7e2e29
        actor_type: agent
        created_at: '2026-01-15T09:30:00Z'
        error: Upstream returned HTTP 502 Bad Gateway
        execution_id: exec_6968b3982706c619fe73f0cf
        job_id: job_6968b3985e8c9902207afaeb
        kind: execution
        status: completed
        updated_at: '2026-01-15T09:30:05Z'
      properties:
        _links:
          $ref: '#/components/schemas/JobLinksResponse'
          examples:
          - *id065
        actor_id:
          anyOf:
          - type: string
          - type: 'null'
          description: Subject that enqueued the job. Null only for legacy rows with no actor.
          examples:
          - agnt_6968b3984d1c238dbe7e2e29
          title: Actor Id
        actor_type:
          description: 'Kind of actor that enqueued the job: ''user'' or ''agent''. Opaque string: historical rows may carry a retired type such as ''service_account''.'
          examples:
          - agent
          title: Actor Type
          type: string
        created_at:
          description: When the job was created (RFC 3339).
          examples:
          - '2026-01-15T09:30:00Z'
          format: date-time
          title: Created At
          type: string
        error:
          anyOf:
          - type: string
          - type: 'null'
          description: Error message recorded for the job; null if none.
          examples:
          - Upstream returned HTTP 502 Bad Gateway
          title: Error
        execution_id:
          anyOf:
          - type: string
          - type: 'null'
          description: ID of the execution record linked to the job, if any.
          examples:
          - exec_6968b3982706c619fe73f0cf
          title: Execution Id
        job_id:
          description: Unique ID of the job.
          examples:
          - job_6968b3985e8c9902207afaeb
          title: Job Id
          type: string
        kind:
          description: Kind of job, e.g. `import` or `execution`.
          examples:
          - execution
          title: Kind
          type: string
        status:
          description: 'Lifecycle state: `queued`, `running`, `completed`, `failed`, `cancelled` or `dead_letter`.'
          examples:
          - completed
          title: Status
          type: string
        updated_at:
          anyOf:
          - format: date-time
            type: string
          - type: 'null'
          description: When the job was last updated (RFC 3339); null if never updated.
          examples:
          - '2026-01-15T09:30:05Z'
          title: Updated At
      required:
      - job_id
      - kind
      - status
      - created_at
      - actor_type
      - _links
      title: JobResponse
      type: object
    JwksUpdateRequest:
      description: |-
        Request body for updating an agent's JWKS (public keys).

        The JWKS must contain at least one Ed25519 public key and must not
        contain any private key material.
      examples:
      - &id192
        jwks: &id067
          keys:
          - crv: Ed25519
            kid: agent-key-1
            kty: OKP
            x: 11qYAYKxCrfVS_7TyWQHOg7hcvPapiMlrwIaaPcHURo
      properties:
        jwks:
          additionalProperties: true
          description: JWKS containing public keys
          examples:
          - *id067
          title: Jwks
          type: object
      required:
      - jwks
      title: JwksUpdateRequest
      type: object
    LoginRequest:
      description: Credentials for login.
      examples:
      - &id213
        email: ada@example.com
        password: example-password
      properties:
        email:
          description: Email address of the user.
          examples:
          - ada@example.com
          maxLength: 320
          minLength: 1
          title: Email
          type: string
        password:
          description: The user's password.
          examples:
          - example-password
          maxLength: 128
          minLength: 1
          title: Password
          type: string
          x-sensitive: true
      required:
      - email
      - password
      title: LoginRequest
      type: object
    LoginResponse:
      description: JWT token response after successful authentication.
      examples:
      - &id214
        access_token: example-access-token
        expires_in: 3600
        must_change_password: false
        token_type: bearer
      properties:
        access_token:
          description: Signed JWT to send as a bearer token on subsequent requests.
          examples:
          - example-access-token
          title: Access Token
          type: string
          x-sensitive: true
        expires_in:
          description: Lifetime of the access token in seconds.
          examples:
          - 3600
          title: Expires In
          type: integer
        must_change_password:
          description: Whether the user must change their password before using other endpoints.
          examples:
          - false
          title: Must Change Password
          type: boolean
        token_type:
          description: Token type; always `bearer`.
          examples:
          - bearer
          title: Token Type
          type: string
      required:
      - access_token
      - token_type
      - expires_in
      - must_change_password
      title: LoginResponse
      type: object
    McpConfigRegistrationRequest:
      description: Report that an MCP config entry was written for one agent runtime.
      examples:
      - &id247
        runtime: cursor
      properties:
        runtime:
          $ref: '#/components/schemas/McpConfigRuntime'
          description: The agent runtime whose MCP config entry was written — a closed set; clients map anything unrecognised to `other`.
          examples:
          - cursor
      required:
      - runtime
      title: McpConfigRegistrationRequest
      type: object
    McpConfigRegistrationResponse:
      description: Acknowledgement of a config-registration report.
      examples:
      - &id248
        recorded: true
        runtime: cursor
      properties:
        recorded:
          description: Whether the report was recorded as an event. `false` means it was accepted but throttled (an identical (actor, runtime) report was already recorded within the last 24h).
          examples:
          - true
          title: Recorded
          type: boolean
        runtime:
          $ref: '#/components/schemas/McpConfigRuntime'
          description: The runtime the report was recorded for.
          examples:
          - cursor
      required:
      - runtime
      - recorded
      title: McpConfigRegistrationResponse
      type: object
    McpConfigRuntime:
      description: |-
        Closed-enum tag naming the agent runtime an MCP config entry targets.

        Attached only to ``mcp_config_registered`` — one event per runtime whose
        config file/entry ``jentic setup``/``jentic skill init`` writes. A closed
        set (never the raw runtime string) so the config-written → first-session →
        first-execute funnel stays property-free on the wire.
      enum:
      - claude_desktop
      - claude_code
      - cursor
      - codex
      - other
      title: McpConfigRuntime
      type: string
    MeAgent:
      description: Identity response for an agent actor.
      examples:
      - approved_by: usr_6968b3987ee4c3ec0b4ee3b9
        credential_bindings: &id069
        - *id068
        id: agnt_6968b3984d1c238dbe7e2e29
        name: invoice-reconciler
        parent_agent_id: agnt_6968b3984d1c238dbe7e2e29
        permissions: &id070
        - apis:read
        - capabilities:execute
        status: active
        token_permissions: &id071
        - apis:read
        - capabilities:execute
        type: agent
      properties:
        approved_by:
          anyOf:
          - type: string
          - type: 'null'
          description: ID of the user who approved the agent; null if not approved.
          examples:
          - usr_6968b3987ee4c3ec0b4ee3b9
          title: Approved By
        credential_bindings:
          default: []
          description: Credentials bound directly to the agent.
          examples:
          - *id069
          items:
            $ref: '#/components/schemas/CredentialBindingEntry'
          title: Credential Bindings
          type: array
        id:
          description: Unique ID of the agent.
          examples:
          - agnt_6968b3984d1c238dbe7e2e29
          title: Id
          type: string
        name:
          description: Human-readable name of the agent.
          examples:
          - invoice-reconciler
          title: Name
          type: string
        parent_agent_id:
          anyOf:
          - type: string
          - type: 'null'
          description: ID of the parent agent; null when the agent has no parent.
          examples:
          - agnt_6968b3984d1c238dbe7e2e29
          title: Parent Agent Id
        permissions:
          description: Permissions currently granted to the agent, read live rather than from the token.
          examples:
          - *id070
          items:
            type: string
          title: Permissions
          type: array
        status:
          description: 'Lifecycle status of the agent: `pending`, `active`, `rejected`, `disabled` or `archived`.'
          examples:
          - active
          title: Status
          type: string
        token_permissions:
          description: Permissions in the presented bearer token; if narrower than `permissions`, obtain a new token to pick up newer grants.
          examples:
          - *id071
          items:
            type: string
          title: Token Permissions
          type: array
        type:
          const: agent
          default: agent
          description: Actor type discriminator; always `agent`.
          examples:
          - agent
          title: Type
          type: string
      required:
      - id
      - name
      - status
      - permissions
      - token_permissions
      title: MeAgent
      type: object
    MeUser:
      description: Identity response for a user actor.
      examples:
      - admin: true
        email: ada@example.com
        id: usr_6968b3987ee4c3ec0b4ee3b9
        must_change_password: false
        name: Ada Lovelace
        permissions: &id072
        - org:admin
        - agents:read
        status: active
        type: user
      properties:
        admin:
          description: Whether the caller's token holds `org:admin`.
          examples:
          - true
          title: Admin
          type: boolean
        email:
          description: Email address of the user.
          examples:
          - ada@example.com
          title: Email
          type: string
        id:
          description: Unique ID of the user.
          examples:
          - usr_6968b3987ee4c3ec0b4ee3b9
          title: Id
          type: string
        must_change_password:
          description: Whether the user must change their password; most endpoints return 403 until they do.
          examples:
          - false
          title: Must Change Password
          type: boolean
        name:
          description: Display name of the user.
          examples:
          - Ada Lovelace
          title: Name
          type: string
        permissions:
          description: Permissions carried by the caller's token.
          examples:
          - *id072
          items:
            type: string
          title: Permissions
          type: array
        status:
          description: 'User status: `active` or `disabled`.'
          examples:
          - active
          title: Status
          type: string
        type:
          const: user
          default: user
          description: Actor type discriminator; always `user`.
          examples:
          - user
          title: Type
          type: string
      required:
      - id
      - name
      - email
      - admin
      - status
      - permissions
      - must_change_password
      title: MeUser
      type: object
    NoAuthCreateRequest:
      description: |-
        Create request for no_auth credentials.

        A no-auth credential carries no secret — it represents "this API is called
        without authentication". It still exists as a credential row so an agent
        binding (and its permission rules) can hang off it, and the broker resolves
        it as a no-op auth (see broker credential resolver / injection).
      examples:
      - api: *id010
        name: Stripe live key
        provider: static
        runtime_config: &id073
          headers: *id013
          query_params: *id014
        server_variables: &id074
          region: eu
        type: no_auth
      properties:
        api:
          $ref: '#/components/schemas/APIReferenceRequest'
          examples:
          - *id010
        name:
          description: Human-readable label for the credential.
          examples:
          - Stripe live key
          title: Name
          type: string
        provider:
          default: static
          description: Credential provider; 'static' for stored secrets.
          examples:
          - static
          title: Provider
          type: string
        runtime_config:
          anyOf:
          - $ref: '#/components/schemas/RuntimeConfig'
          - type: 'null'
          description: Per-upstream-call overrides; reserved and not currently applied.
          examples:
          - *id073
        server_variables:
          anyOf:
          - additionalProperties:
              type: string
            type: object
          - type: 'null'
          description: OpenAPI server-variable values for URL template substitution (at most 20).
          examples:
          - *id074
          title: Server Variables
        type:
          const: no_auth
          description: Credential type; always `no_auth`.
          examples:
          - no_auth
          title: Type
          type: string
      required:
      - type
      - name
      - api
      title: NoAuthCreateRequest
      type: object
    NoteApiReference:
      additionalProperties: false
      description: Loose ``(vendor, name, version)`` identity tuple for a registered API.
      examples:
      - &id075
        name: stripe
        vendor: stripe.com
        version: '2024-04-10'
      properties:
        name:
          description: Name of the API within the vendor.
          examples:
          - stripe
          title: Name
          type: string
        vendor:
          description: Vendor of the API.
          examples:
          - stripe.com
          title: Vendor
          type: string
        version:
          description: Version of the API.
          examples:
          - '2024-04-10'
          title: Version
          type: string
      required:
      - vendor
      - name
      - version
      title: NoteApiReference
      type: object
    NoteConfidence:
      description: Author-supplied confidence in a note (matches the spec ``NoteConfidence`` enum).
      enum:
      - observed
      - suspected
      - verified
      title: NoteConfidence
      type: string
    NoteCreateRequest:
      additionalProperties: false
      description: Payload for creating a new note.
      examples:
      - &id251
        body: Stripe returns 401 unless the secret key is sent as a Bearer token; Basic auth with an empty password also works.
        confidence: observed
        related_execution_id: exec_6968b3982706c619fe73f0cf
        resource: &id076
          api: *id075
          credential_id: cred_6968b39855d91a3561684b32
          execution_id: exec_6968b3982706c619fe73f0cf
          operation_id: op_f92d69f1621f381bce8aaff47053c61b069ffe34
        source: agent
        type: auth_quirk
      properties:
        body:
          description: Text of the note, up to 4000 characters.
          examples:
          - Stripe returns 401 unless the secret key is sent as a Bearer token; Basic auth with an empty password also works.
          maxLength: 4000
          title: Body
          type: string
        confidence:
          anyOf:
          - $ref: '#/components/schemas/NoteConfidence'
          - type: 'null'
          description: Author's confidence in the note; null if not stated.
          examples:
          - observed
        related_execution_id:
          anyOf:
          - type: string
          - type: 'null'
          description: ID of an execution the note relates to; null if none.
          examples:
          - exec_6968b3982706c619fe73f0cf
          title: Related Execution Id
        resource:
          $ref: '#/components/schemas/NoteResource'
          examples:
          - *id076
        source:
          anyOf:
          - $ref: '#/components/schemas/NoteSource'
          - type: 'null'
          description: Origin of the note (`agent`, `human` or `platform`); null if not stated.
          examples:
          - agent
        type:
          anyOf:
          - $ref: '#/components/schemas/NoteType'
          - type: 'null'
          description: Category of the note; null if uncategorised.
          examples:
          - auth_quirk
      required:
      - resource
      - body
      title: NoteCreateRequest
      type: object
    NoteResource:
      additionalProperties: false
      description: Exactly-one-of resource identifier for a note (request side).
      examples:
      - api: *id075
        credential_id: cred_6968b39855d91a3561684b32
        execution_id: exec_6968b3982706c619fe73f0cf
        operation_id: op_f92d69f1621f381bce8aaff47053c61b069ffe34
      properties:
        api:
          anyOf:
          - $ref: '#/components/schemas/NoteApiReference'
          - type: 'null'
          description: API to attach the note to; set exactly one resource field.
          examples:
          - *id075
        credential_id:
          anyOf:
          - type: string
          - type: 'null'
          description: ID of the credential to attach the note to; set exactly one resource field.
          examples:
          - cred_6968b39855d91a3561684b32
          title: Credential Id
        execution_id:
          anyOf:
          - type: string
          - type: 'null'
          description: ID of the execution to attach the note to; set exactly one resource field.
          examples:
          - exec_6968b3982706c619fe73f0cf
          title: Execution Id
        operation_id:
          anyOf:
          - type: string
          - type: 'null'
          description: ID of the operation to attach the note to; set exactly one resource field.
          examples:
          - op_f92d69f1621f381bce8aaff47053c61b069ffe34
          title: Operation Id
      title: NoteResource
      type: object
    NoteSource:
      description: Origin tag for a note (matches the spec ``NoteSource`` enum).
      enum:
      - agent
      - human
      - platform
      title: NoteSource
      type: string
    NoteType:
      description: Category of a note (matches the spec ``NoteType`` enum).
      enum:
      - auth_quirk
      - usage_hint
      - execution_feedback
      - correction
      title: NoteType
      type: string
    NoteUpdateRequest:
      additionalProperties: false
      description: Payload for updating an existing note (partial).
      examples:
      - &id252
        body: Stripe returns 401 unless the secret key is sent as a Bearer token; Basic auth with an empty password also works.
        confidence: verified
        related_execution_id: exec_6968b3982706c619fe73f0cf
        source: agent
        type: auth_quirk
      properties:
        body:
          anyOf:
          - maxLength: 4000
            type: string
          - type: 'null'
          description: New text of the note, up to 4000 characters; may be omitted but not null.
          examples:
          - Stripe returns 401 unless the secret key is sent as a Bearer token; Basic auth with an empty password also works.
          title: Body
        confidence:
          anyOf:
          - $ref: '#/components/schemas/NoteConfidence'
          - type: 'null'
          description: New confidence in the note; null clears it.
          examples:
          - verified
        related_execution_id:
          anyOf:
          - type: string
          - type: 'null'
          description: ID of an execution the note relates to; null clears it.
          examples:
          - exec_6968b3982706c619fe73f0cf
          title: Related Execution Id
        source:
          anyOf:
          - $ref: '#/components/schemas/NoteSource'
          - type: 'null'
          description: New origin of the note; null clears it.
          examples:
          - agent
        type:
          anyOf:
          - $ref: '#/components/schemas/NoteType'
          - type: 'null'
          description: New category of the note; null clears it.
          examples:
          - auth_quirk
      title: NoteUpdateRequest
      type: object
    OAuth2CreateRequest:
      description: |-
        Create request for oauth2 credentials.

        For managed providers (e.g. pipedream, direct_oauth2), token_url/client_id/client_secret
        are optional — the connect flow handles authentication without caller-supplied client details.
      examples:
      - api: *id010
        authorize_url: https://connect.stripe.com/oauth/authorize
        client_id: ca_example123
        client_secret: example-secret
        grant_type: client_credentials
        name: Stripe live key
        provider: static
        runtime_config: &id077
          headers: *id013
          query_params: *id014
        scopes: &id078
        - read_write
        server_variables: &id079
          region: eu
        token_url: https://connect.stripe.com/oauth/token
        type: oauth2
      properties:
        api:
          $ref: '#/components/schemas/APIReferenceRequest'
          examples:
          - *id010
        authorize_url:
          anyOf:
          - type: string
          - type: 'null'
          description: Authorization endpoint URL; for the device_code grant, the device authorization endpoint.
          examples:
          - https://connect.stripe.com/oauth/authorize
          title: Authorize Url
        client_id:
          anyOf:
          - type: string
          - type: 'null'
          description: OAuth client ID; required for non-managed providers.
          examples:
          - ca_example123
          title: Client Id
        client_secret:
          anyOf:
          - type: string
          - type: 'null'
          description: OAuth client secret; required for non-managed providers except the device_code grant. Stored encrypted; never returned after create.
          examples:
          - example-secret
          title: Client Secret
          x-sensitive: true
        grant_type:
          default: client_credentials
          description: OAuth2 grant type (e.g. client_credentials, authorization_code, device_code).
          examples:
          - client_credentials
          title: Grant Type
          type: string
        name:
          description: Human-readable label for the credential.
          examples:
          - Stripe live key
          title: Name
          type: string
        provider:
          default: static
          description: Credential provider; 'static' for stored secrets.
          examples:
          - static
          title: Provider
          type: string
        runtime_config:
          anyOf:
          - $ref: '#/components/schemas/RuntimeConfig'
          - type: 'null'
          description: Per-upstream-call overrides; reserved and not currently applied.
          examples:
          - *id077
        scopes:
          anyOf:
          - items:
              type: string
            type: array
          - type: 'null'
          description: OAuth scopes to request.
          examples:
          - *id078
          title: Scopes
        server_variables:
          anyOf:
          - additionalProperties:
              type: string
            type: object
          - type: 'null'
          description: OpenAPI server-variable values for URL template substitution (at most 20).
          examples:
          - *id079
          title: Server Variables
        token_url:
          anyOf:
          - type: string
          - type: 'null'
          description: Token endpoint URL; required for non-managed providers.
          examples:
          - https://connect.stripe.com/oauth/token
          title: Token Url
        type:
          const: oauth2
          description: Credential type; always `oauth2`.
          examples:
          - oauth2
          title: Type
          type: string
      required:
      - type
      - name
      - api
      title: OAuth2CreateRequest
      type: object
    OAuth2UpdateRequest:
      description: Update request for oauth2 credentials.
      examples:
      - active: true
        client_secret: example-secret
        name: Stripe live key
        runtime_config: &id080
          headers: *id013
          query_params: *id014
        scopes: &id081
        - read_write
        server_variables: &id082
          region: eu
        token_url: https://connect.stripe.com/oauth/token
        type: oauth2
      properties:
        active:
          anyOf:
          - type: boolean
          - type: 'null'
          description: Enable or disable the credential for injection; omit to leave unchanged.
          examples:
          - true
          title: Active
        client_secret:
          anyOf:
          - type: string
          - type: 'null'
          description: Replacement client secret; omit to leave unchanged. token_url and scopes are applied only together with it.
          examples:
          - example-secret
          title: Client Secret
          x-sensitive: true
        name:
          anyOf:
          - type: string
          - type: 'null'
          description: New label for the credential; omit to leave unchanged.
          examples:
          - Stripe live key
          title: Name
        runtime_config:
          anyOf:
          - $ref: '#/components/schemas/RuntimeConfig'
          - type: 'null'
          description: Per-upstream-call overrides; reserved and not currently applied.
          examples:
          - *id080
        scopes:
          anyOf:
          - items:
              type: string
            type: array
          - type: 'null'
          description: Replacement OAuth scopes; applied only when client_secret is sent.
          examples:
          - *id081
          title: Scopes
        server_variables:
          anyOf:
          - additionalProperties:
              type: string
            type: object
          - type: 'null'
          description: Replacement OpenAPI server-variable values; omit to leave unchanged.
          examples:
          - *id082
          title: Server Variables
        token_url:
          anyOf:
          - type: string
          - type: 'null'
          description: Replacement token endpoint URL; applied only when client_secret is sent.
          examples:
          - https://connect.stripe.com/oauth/token
          title: Token Url
        type:
          const: oauth2
          description: Credential type; always `oauth2`.
          examples:
          - oauth2
          title: Type
          type: string
      required:
      - type
      title: OAuth2UpdateRequest
      type: object
    OAuthAppRegistrationFlowKind:
      description: Which OAuth flow a registration supports.
      enum:
      - authorization_code
      - device_authorization
      title: OAuthAppRegistrationFlowKind
      type: string
    OAuthAppRegistrationListResponse:
      description: Paginated list of OAuth app registrations.
      examples:
      - &id253
        data: &id083
        - api_vendor: github
          authorization_endpoint: https://github.com/login/device/code
          authorize_url: https://github.com/login/oauth/authorize
          catalog_api_id: github.com/api.github.com
          client_id: Iv1.a1b2c3d4
          created_at: '2026-01-15T09:30:00Z'
          created_by: usr_6968b3987ee4c3ec0b4ee3b9
          default_scopes: &id084
          - repo
          - read:user
          dependent_credential_count: 4
          display_name: GitHub
          flow_kind: authorization_code
          has_client_secret: true
          id: oar_6968b39821e5f89a6975f501
          is_active: true
          name: MyOrg GitHub
          secret_last_rotated_at: '2026-01-20T14:05:00Z'
          token_endpoint: https://github.com/login/oauth/access_token
          token_url: https://github.com/login/oauth/access_token
          updated_at: '2026-01-20T14:05:00Z'
        has_more: true
        next_cursor: eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
      properties:
        data:
          description: The page of OAuth app registrations.
          examples:
          - *id083
          items:
            $ref: '#/components/schemas/OAuthAppRegistrationResponse'
          title: Data
          type: array
        has_more:
          description: Whether more results exist after this page.
          examples:
          - true
          title: Has More
          type: boolean
        next_cursor:
          anyOf:
          - type: string
          - type: 'null'
          description: Cursor for the next page; null when there are no more results.
          examples:
          - eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
          title: Next Cursor
      required:
      - data
      - has_more
      title: OAuthAppRegistrationListResponse
      type: object
    OAuthAppRegistrationResponse:
      description: |-
        Registration as returned to admins.

        Never includes the client secret — only ``has_client_secret`` +
        ``secret_last_rotated_at`` so an admin can see rotation history without
        being able to read the material.
      examples:
      - &id254
        api_vendor: github
        authorization_endpoint: https://github.com/login/device/code
        authorize_url: https://github.com/login/oauth/authorize
        catalog_api_id: github.com/api.github.com
        client_id: Iv1.a1b2c3d4
        created_at: '2026-01-15T09:30:00Z'
        created_by: usr_6968b3987ee4c3ec0b4ee3b9
        default_scopes: *id084
        dependent_credential_count: 4
        display_name: GitHub
        flow_kind: authorization_code
        has_client_secret: true
        id: oar_6968b39821e5f89a6975f501
        is_active: true
        name: MyOrg GitHub
        secret_last_rotated_at: '2026-01-20T14:05:00Z'
        token_endpoint: https://github.com/login/oauth/access_token
        token_url: https://github.com/login/oauth/access_token
        updated_at: '2026-01-20T14:05:00Z'
      properties:
        api_vendor:
          description: Vendor registry key the registration connects.
          examples:
          - github
          title: Api Vendor
          type: string
        authorization_endpoint:
          anyOf:
          - type: string
          - type: 'null'
          description: Device authorization endpoint URL; null for authorization-code registrations.
          examples:
          - https://github.com/login/device/code
          title: Authorization Endpoint
        authorize_url:
          anyOf:
          - type: string
          - type: 'null'
          description: Authorization endpoint URL; null for device-authorization registrations.
          examples:
          - https://github.com/login/oauth/authorize
          title: Authorize Url
        catalog_api_id:
          description: Catalog API slug this OAuth app targets (e.g. 'googleapis-com/gmail'). Feeds credential.catalog_api_id at connect time so the operations preview resolves against a real registered API.
          examples:
          - github.com/api.github.com
          title: Catalog Api Id
          type: string
        client_id:
          description: OAuth client ID of the app.
          examples:
          - Iv1.a1b2c3d4
          title: Client Id
          type: string
        created_at:
          description: When the registration was created (RFC 3339).
          examples:
          - '2026-01-15T09:30:00Z'
          format: date-time
          title: Created At
          type: string
        created_by:
          anyOf:
          - type: string
          - type: 'null'
          description: ID of the actor that created the registration.
          examples:
          - usr_6968b3987ee4c3ec0b4ee3b9
          title: Created By
        default_scopes:
          anyOf:
          - items:
              type: string
            type: array
          - type: 'null'
          description: Scopes requested by default; null if none are set.
          examples:
          - *id084
          title: Default Scopes
        dependent_credential_count:
          description: Number of credentials minted through this registration.
          examples:
          - 4
          title: Dependent Credential Count
          type: integer
        display_name:
          description: Vendor family label ('Gmail'), shown alongside the admin's per-registration 'name' on the picker card.
          examples:
          - GitHub
          title: Display Name
          type: string
        flow_kind:
          $ref: '#/components/schemas/OAuthAppRegistrationFlowKind'
          examples:
          - authorization_code
        has_client_secret:
          description: Whether a client secret is stored.
          examples:
          - true
          title: Has Client Secret
          type: boolean
        id:
          description: Unique ID of the OAuth app registration.
          examples:
          - oar_6968b39821e5f89a6975f501
          title: Id
          type: string
        is_active:
          description: Whether the registration is active.
          examples:
          - true
          title: Is Active
          type: boolean
        name:
          description: Admin-chosen name of the registration.
          examples:
          - MyOrg GitHub
          title: Name
          type: string
        secret_last_rotated_at:
          anyOf:
          - format: date-time
            type: string
          - type: 'null'
          description: When the client secret was last rotated (RFC 3339); null if never rotated.
          examples:
          - '2026-01-20T14:05:00Z'
          title: Secret Last Rotated At
        token_endpoint:
          anyOf:
          - type: string
          - type: 'null'
          description: Token endpoint URL; null for authorization-code registrations.
          examples:
          - https://github.com/login/oauth/access_token
          title: Token Endpoint
        token_url:
          anyOf:
          - type: string
          - type: 'null'
          description: Token endpoint URL; null for device-authorization registrations.
          examples:
          - https://github.com/login/oauth/access_token
          title: Token Url
        updated_at:
          description: When the registration was last updated (RFC 3339).
          examples:
          - '2026-01-20T14:05:00Z'
          format: date-time
          title: Updated At
          type: string
      required:
      - id
      - name
      - api_vendor
      - catalog_api_id
      - display_name
      - flow_kind
      - client_id
      - is_active
      - has_client_secret
      - secret_last_rotated_at
      - created_at
      - updated_at
      - created_by
      - dependent_credential_count
      title: OAuthAppRegistrationResponse
      type: object
    OAuthAppRegistrationRotateSecretRequest:
      additionalProperties: false
      description: Rotate the client secret on an auth-code registration.
      examples:
      - &id256
        client_secret: example-secret
      properties:
        client_secret:
          description: New OAuth client secret; stored encrypted and never returned.
          examples:
          - example-secret
          maxLength: 4096
          minLength: 1
          title: Client Secret
          type: string
          x-sensitive: true
      required:
      - client_secret
      title: OAuthAppRegistrationRotateSecretRequest
      type: object
    OAuthAppRegistrationUpdateRequest:
      additionalProperties: false
      description: Partial update — fields not present are left untouched.
      examples:
      - &id255
        authorization_endpoint: https://github.com/login/device/code
        authorize_url: https://github.com/login/oauth/authorize
        default_scopes: &id085
        - repo
        - read:user
        display_name: GitHub
        is_active: true
        name: MyOrg GitHub
        token_endpoint: https://github.com/login/oauth/access_token
        token_url: https://github.com/login/oauth/access_token
      properties:
        authorization_endpoint:
          anyOf:
          - maxLength: 2048
            minLength: 1
            type: string
          - type: 'null'
          description: New device authorization endpoint URL; device-authorization registrations only.
          examples:
          - https://github.com/login/device/code
          title: Authorization Endpoint
        authorize_url:
          anyOf:
          - maxLength: 2048
            minLength: 1
            type: string
          - type: 'null'
          description: New authorization endpoint URL; authorization-code registrations only.
          examples:
          - https://github.com/login/oauth/authorize
          title: Authorize Url
        default_scopes:
          anyOf:
          - items:
              maxLength: 255
              minLength: 1
              pattern: ^\S+$
              type: string
            type: array
          - type: 'null'
          description: Replacement default scopes; omit to leave unchanged.
          examples:
          - *id085
          title: Default Scopes
        display_name:
          anyOf:
          - maxLength: 255
            minLength: 1
            type: string
          - type: 'null'
          description: New vendor family label; omit to leave unchanged.
          examples:
          - GitHub
          title: Display Name
        is_active:
          anyOf:
          - type: boolean
          - type: 'null'
          description: Activate or deactivate the registration; omit to leave unchanged.
          examples:
          - true
          title: Is Active
        name:
          anyOf:
          - maxLength: 255
            minLength: 1
            type: string
          - type: 'null'
          description: New registration name; omit to leave unchanged.
          examples:
          - MyOrg GitHub
          title: Name
        token_endpoint:
          anyOf:
          - maxLength: 2048
            minLength: 1
            type: string
          - type: 'null'
          description: New token endpoint URL; device-authorization registrations only.
          examples:
          - https://github.com/login/oauth/access_token
          title: Token Endpoint
        token_url:
          anyOf:
          - maxLength: 2048
            minLength: 1
            type: string
          - type: 'null'
          description: New token endpoint URL; authorization-code registrations only.
          examples:
          - https://github.com/login/oauth/access_token
          title: Token Url
      title: OAuthAppRegistrationUpdateRequest
      type: object
    OAuthApprovalDecisionRequest:
      description: |-
        Inline admin approve/deny posted from the approval-pending page.

        ``state`` is the signed approval-state blob minted by ``/authorize`` for
        this exact authorize request — the decision endpoint never accepts a bare
        ``client_id``.

        ``state`` is deliberately NOT marked x-sensitive: the CLI's GEN-21
        redaction backstop unions every sensitive field's BARE name globally, and
        "state" is generic enough to redact unrelated CLI output (e.g. the MCP
        session-diagnosis ``state`` field). The blob is not a lasting bearer
        credential — it is HMAC-signed, purpose-discriminated, TTL'd (600 s), and
        the decision endpoint additionally requires an authenticated admin with
        ``oauth-clients:write`` — so global redaction buys nothing worth that
        collision.
      examples:
      - &id259
        action: approve
        state: eyJfcHVycG9zZSI6ICJleGFtcGxlIn0=.5d41402abc4b2a76b9719d911017c592
      properties:
        action:
          description: 'The decision: `approve` or `deny` the pending client.'
          enum:
          - approve
          - deny
          examples:
          - approve
          title: Action
          type: string
        state:
          description: Signed approval-state token issued by `/authorize` for this request.
          examples:
          - eyJfcHVycG9zZSI6ICJleGFtcGxlIn0=.5d41402abc4b2a76b9719d911017c592
          title: State
          type: string
      required:
      - state
      - action
      title: OAuthApprovalDecisionRequest
      type: object
    OAuthApprovalStatusResponse:
      description: |-
        Minimal tri-state approval status for a pending-client authorize request.

        Deliberately carries nothing else — no client name, redirect URIs, or
        metadata — so the anonymous poll endpoint cannot be used to read client
        details out of the registry.
      examples:
      - &id260
        status: approved
      properties:
        status:
          description: 'Approval state of the client: `pending`, `approved` or `denied`.'
          enum:
          - pending
          - approved
          - denied
          examples:
          - approved
          title: Status
          type: string
      required:
      - status
      title: OAuthApprovalStatusResponse
      type: object
    OAuthClientCreateRequest:
      description: Request body for creating an OAuth client.
      examples:
      - &id178
        description: My application production deployment
        name: my-app-production
        redirect_uris:
        - https://app.example.com/auth/callback
        require_consent: true
      properties:
        allowed_scopes:
          anyOf:
          - items:
              type: string
            type: array
          - type: 'null'
          description: If set, restricts which scopes this client may request. An empty list denies all non-OIDC scopes. Null means unrestricted (all scopes permitted).
          examples:
          - - apis:read
            - capabilities:execute
          title: Allowed Scopes
        consent_model:
          default: user
          description: What a user's consent grants for this client. ``user`` keeps today's act-as-user semantics; ``agent`` marks the client for agent-bound consent (the MCP path).
          enum:
          - user
          - agent
          examples:
          - user
          title: Consent Model
          type: string
        description:
          anyOf:
          - type: string
          - type: 'null'
          description: Optional description of the client.
          examples:
          - Billing assistant production deployment
          title: Description
        name:
          description: Human-readable name for the client.
          examples:
          - billing-assistant-prod
          maxLength: 255
          title: Name
          type: string
        redirect_uris:
          description: Allowed OAuth callback URLs. At least one required.
          examples:
          - - https://client.example.com/oauth/callback
          items:
            maxLength: 2048
            type: string
          maxItems: 20
          minItems: 1
          title: Redirect Uris
          type: array
        require_consent:
          default: true
          description: Whether to show a consent screen during authorization. Set to false for trusted first-party integrations.
          examples:
          - true
          title: Require Consent
          type: boolean
        token_endpoint_auth_method:
          default: client_secret_basic
          description: Client authentication method at the token endpoint. ``client_secret_basic`` creates a confidential client with a generated secret; ``none`` creates a public (secret-less) client that relies on PKCE alone — no secret is generated or returned.
          enum:
          - client_secret_basic
          - none
          examples:
          - client_secret_basic
          title: Token Endpoint Auth Method
          type: string
      required:
      - name
      - redirect_uris
      title: OAuthClientCreateRequest
      type: object
    OAuthClientCreateResponse:
      description: Returned on creation — includes the one-time plaintext client secret.
      examples:
      - &id179
        active: true
        active_grant_count: 0
        allowed_scopes:
        - agents:read
        - credentials:read
        approval_status: approved
        client_id: oc_abc123...
        client_secret: <redacted>
        consent_model: user
        created_at: '2026-08-18T12:00:00Z'
        created_by: usr_abc123
        description: My application production deployment
        id: oac_2NxYz...
        name: my-app-production
        redirect_uris:
        - https://app.example.com/auth/callback
        registration_source: admin
        require_consent: true
        software_id: com.example.my-app
        token_endpoint_auth_method: client_secret_basic
        updated_at: '2026-08-18T12:00:00Z'
      properties:
        active:
          description: Whether the client is enabled; false for disabled, pending or denied clients.
          examples:
          - true
          title: Active
          type: boolean
        active_grant_count:
          default: 0
          description: Number of active consent→agent grants for this client. Computed on the read endpoints (list/get); write-path responses report 0.
          examples:
          - 3
          title: Active Grant Count
          type: integer
        allowed_scopes:
          anyOf:
          - items:
              type: string
            type: array
          - type: 'null'
          description: Scopes this client may request. Null means unrestricted.
          examples:
          - - apis:read
            - capabilities:execute
          title: Allowed Scopes
        approval_status:
          description: 'Admin approval lifecycle: ``pending``, ``approved``, or ``denied``. Only approved clients may enter OAuth flows; ``active`` remains the independent kill switch.'
          examples:
          - approved
          title: Approval Status
          type: string
        client_id:
          description: Public client identifier used in OAuth flows.
          examples:
          - oc_Xk3vQ9mT2pLw8RzN5bYc1HdF7gJs4AeU
          title: Client Id
          type: string
        client_secret:
          anyOf:
          - type: string
          - type: 'null'
          description: The client secret. Shown only once at creation — store it securely. Null for public (secret-less) clients.
          examples:
          - example-client-secret
          title: Client Secret
          x-sensitive: true
        consent_model:
          description: 'What a user''s consent grants for this client: ``user`` or ``agent``.'
          examples:
          - user
          title: Consent Model
          type: string
        created_at:
          description: When the client was created (RFC 3339).
          examples:
          - '2026-01-15T09:30:00Z'
          format: date-time
          title: Created At
          type: string
        created_by:
          anyOf:
          - type: string
          - type: 'null'
          description: ID of the actor that created the client; null if not recorded.
          examples:
          - usr_6968b3987ee4c3ec0b4ee3b9
          title: Created By
        description:
          anyOf:
          - type: string
          - type: 'null'
          description: Description of the client; null if none.
          examples:
          - Billing assistant production deployment
          title: Description
        id:
          description: Record ID of the OAuth client (`oac_…`), not its public `client_id`.
          examples:
          - oac_6968b39840a935d9f7e2714b
          title: Id
          type: string
        name:
          description: Human-readable name for the client.
          examples:
          - billing-assistant-prod
          title: Name
          type: string
        redirect_uris:
          description: Allowed OAuth callback URLs.
          examples:
          - - https://client.example.com/oauth/callback
          items:
            type: string
          title: Redirect Uris
          type: array
        registration_source:
          description: 'How the client entered the registry: ``admin`` or ``dcr``.'
          examples:
          - admin
          title: Registration Source
          type: string
        require_consent:
          description: Whether a consent screen is shown during authorization.
          examples:
          - true
          title: Require Consent
          type: boolean
        software_id:
          anyOf:
          - type: string
          - type: 'null'
          description: RFC 7591 software identifier claimed at registration, if any.
          examples:
          - com.example.billing-assistant
          title: Software Id
        token_endpoint_auth_method:
          description: 'Client authentication method at the token endpoint: ``client_secret_basic`` (confidential) or ``none`` (public, PKCE-only).'
          examples:
          - client_secret_basic
          title: Token Endpoint Auth Method
          type: string
        updated_at:
          anyOf:
          - format: date-time
            type: string
          - type: 'null'
          description: When the client was last updated (RFC 3339); null if never updated.
          examples:
          - '2026-01-20T14:05:00Z'
          title: Updated At
      required:
      - id
      - client_id
      - name
      - description
      - redirect_uris
      - allowed_scopes
      - active
      - require_consent
      - token_endpoint_auth_method
      - consent_model
      - registration_source
      - software_id
      - approval_status
      - created_at
      - updated_at
      - created_by
      - client_secret
      title: OAuthClientCreateResponse
      type: object
    OAuthClientDenyRequest:
      description: Request body for denying an OAuth client.
      examples:
      - reason: Unrecognised publisher; redirect URI not owned by a known vendor.
      properties:
        reason:
          anyOf:
          - maxLength: 1024
            type: string
          - type: 'null'
          description: Optional reason recorded in the audit trail.
          examples:
          - Unrecognised publisher; redirect URI not owned by a known vendor.
          title: Reason
      title: OAuthClientDenyRequest
      type: object
    OAuthClientListResponse:
      description: A list of OAuth clients.
      examples:
      - &id177
        data: &id086
        - &id093
          active: true
          active_grant_count: 0
          allowed_scopes:
          - agents:read
          - credentials:read
          approval_status: approved
          client_id: oc_abc123...
          consent_model: user
          created_at: '2026-08-18T12:00:00Z'
          created_by: usr_abc123
          description: My application production deployment
          id: oac_2NxYz...
          name: my-app-production
          redirect_uris:
          - https://app.example.com/auth/callback
          registration_source: admin
          require_consent: true
          software_id: com.example.my-app
          token_endpoint_auth_method: client_secret_basic
          updated_at: '2026-08-18T12:00:00Z'
      properties:
        data:
          description: The OAuth clients.
          examples:
          - *id086
          items:
            $ref: '#/components/schemas/OAuthClientResponse'
          title: Data
          type: array
      required:
      - data
      title: OAuthClientListResponse
      type: object
    OAuthClientRegistrationRequest:
      description: POST /oauth-clients request body (RFC 7591 client metadata subset).
      examples:
      - &id257
        application_type: native
        client_name: Cursor
        grant_types: &id087
        - authorization_code
        - refresh_token
        redirect_uris: &id088
        - https://client.example.com/oauth/callback
        response_types: &id089
        - code
        scope: apis:read capabilities:execute
        software_id: com.example.mcp-client
        software_version: 1.4.2
        token_endpoint_auth_method: none
      properties:
        application_type:
          anyOf:
          - maxLength: 32
            type: string
          - type: 'null'
          description: Accepted and echoed ('native' for desktop/CLI apps, per the 2026-07-28 MCP spec revision); localhost http redirect URIs are allowed regardless.
          examples:
          - native
          title: Application Type
        client_name:
          description: Human-readable client name; self-asserted and not verified by the server.
          examples:
          - Cursor
          maxLength: 255
          minLength: 1
          title: Client Name
          type: string
        grant_types:
          anyOf:
          - items:
              type: string
            type: array
          - type: 'null'
          description: Subset of ['authorization_code', 'refresh_token'].
          examples:
          - *id087
          title: Grant Types
        redirect_uris:
          description: 1-20 redirect URIs. `https` always; `http` for loopback hosts only; RFC 8252 §7.1 private-use (custom) schemes are accepted for native apps (browser-executable and other dangerous schemes are rejected).
          examples:
          - *id088
          items:
            type: string
          maxItems: 20
          minItems: 1
          title: Redirect Uris
          type: array
        response_types:
          anyOf:
          - items:
              type: string
            type: array
          - type: 'null'
          description: Only ['code'] is supported.
          examples:
          - *id089
          title: Response Types
        scope:
          anyOf:
          - maxLength: 6500
            type: string
          - type: 'null'
          description: Space-separated scopes requested as the client's ceiling (at most 100 tokens); capped to the scopes the server grants OAuth clients, and the full set when omitted.
          examples:
          - apis:read capabilities:execute
          title: Scope
        software_id:
          anyOf:
          - maxLength: 255
            type: string
          - type: 'null'
          description: Stable identifier of the client software; with the redirect URIs it is used to match a repeat registration to the existing client.
          examples:
          - com.example.mcp-client
          title: Software Id
        software_version:
          anyOf:
          - maxLength: 255
            type: string
          - type: 'null'
          description: Version of the client software.
          examples:
          - 1.4.2
          title: Software Version
        token_endpoint_auth_method:
          anyOf:
          - type: string
          - type: 'null'
          description: Must be 'none' if supplied — this endpoint only registers public (secret-less, PKCE-only) clients.
          examples:
          - none
          title: Token Endpoint Auth Method
      required:
      - client_name
      - redirect_uris
      title: OAuthClientRegistrationRequest
      type: object
    OAuthClientRegistrationResponse:
      description: |-
        POST /oauth-clients response (201 created, or 200 on a D8 dedupe hit).

        RFC 7591-compatible: ``client_id`` plus the registered metadata. No
        ``client_secret`` (public clients only) and no
        ``registration_access_token`` (D12 — no RFC 7592 self-management surface;
        clients retry ``/authorize``, they don't poll).
      examples:
      - &id258
        application_type: native
        client_id: oc_Xk3vQ9mT2pLw8RzN5bYc1HdF7gJs4AeU
        client_id_issued_at: 1767225600
        client_name: Cursor
        grant_types: &id090
        - authorization_code
        - refresh_token
        redirect_uris: &id091
        - https://client.example.com/oauth/callback
        response_types: &id092
        - code
        scope: apis:read capabilities:execute
        software_id: com.example.mcp-client
        software_version: 1.4.2
        token_endpoint_auth_method: none
      properties:
        application_type:
          anyOf:
          - type: string
          - type: 'null'
          description: The application type as sent in the request; omitted if not sent.
          examples:
          - native
          title: Application Type
        client_id:
          description: The client identifier to use in OAuth requests.
          examples:
          - oc_Xk3vQ9mT2pLw8RzN5bYc1HdF7gJs4AeU
          title: Client Id
          type: string
        client_id_issued_at:
          description: Seconds since the Unix epoch at which the client_id was issued.
          examples:
          - 1767225600
          title: Client Id Issued At
          type: integer
        client_name:
          description: The client name as sent in the request.
          examples:
          - Cursor
          title: Client Name
          type: string
        grant_types:
          default:
          - authorization_code
          - refresh_token
          description: Grant types the client may use.
          examples:
          - *id090
          items:
            type: string
          title: Grant Types
          type: array
        redirect_uris:
          description: The registered redirect URIs.
          examples:
          - *id091
          items:
            type: string
          title: Redirect Uris
          type: array
        response_types:
          default:
          - code
          description: Response types the client may use; always `code`.
          examples:
          - *id092
          items:
            type: string
          title: Response Types
          type: array
        scope:
          description: Space-separated scope ceiling granted to the client (the request's scope capped to the MCP tool-scope set).
          examples:
          - apis:read capabilities:execute
          title: Scope
          type: string
        software_id:
          anyOf:
          - type: string
          - type: 'null'
          description: The software ID as sent in the request; omitted if not sent.
          examples:
          - com.example.mcp-client
          title: Software Id
        software_version:
          anyOf:
          - type: string
          - type: 'null'
          description: The software version as sent in the request; omitted if not sent.
          examples:
          - 1.4.2
          title: Software Version
        token_endpoint_auth_method:
          default: none
          description: 'Always `none`: the client is public and uses PKCE.'
          examples:
          - none
          title: Token Endpoint Auth Method
          type: string
      required:
      - client_id
      - client_id_issued_at
      - client_name
      - redirect_uris
      - scope
      title: OAuthClientRegistrationResponse
      type: object
    OAuthClientResponse:
      description: An OAuth client in API responses.
      examples:
      - *id093
      properties:
        active:
          description: Whether the client is enabled; false for disabled, pending or denied clients.
          examples:
          - true
          title: Active
          type: boolean
        active_grant_count:
          default: 0
          description: Number of active consent→agent grants for this client. Computed on the read endpoints (list/get); write-path responses report 0.
          examples:
          - 3
          title: Active Grant Count
          type: integer
        allowed_scopes:
          anyOf:
          - items:
              type: string
            type: array
          - type: 'null'
          description: Scopes this client may request. Null means unrestricted.
          examples:
          - - apis:read
            - capabilities:execute
          title: Allowed Scopes
        approval_status:
          description: 'Admin approval lifecycle: ``pending``, ``approved``, or ``denied``. Only approved clients may enter OAuth flows; ``active`` remains the independent kill switch.'
          examples:
          - approved
          title: Approval Status
          type: string
        client_id:
          description: Public client identifier used in OAuth flows.
          examples:
          - oc_Xk3vQ9mT2pLw8RzN5bYc1HdF7gJs4AeU
          title: Client Id
          type: string
        consent_model:
          description: 'What a user''s consent grants for this client: ``user`` or ``agent``.'
          examples:
          - user
          title: Consent Model
          type: string
        created_at:
          description: When the client was created (RFC 3339).
          examples:
          - '2026-01-15T09:30:00Z'
          format: date-time
          title: Created At
          type: string
        created_by:
          anyOf:
          - type: string
          - type: 'null'
          description: ID of the actor that created the client; null if not recorded.
          examples:
          - usr_6968b3987ee4c3ec0b4ee3b9
          title: Created By
        description:
          anyOf:
          - type: string
          - type: 'null'
          description: Description of the client; null if none.
          examples:
          - Billing assistant production deployment
          title: Description
        id:
          description: Record ID of the OAuth client (`oac_…`), not its public `client_id`.
          examples:
          - oac_6968b39840a935d9f7e2714b
          title: Id
          type: string
        name:
          description: Human-readable name for the client.
          examples:
          - billing-assistant-prod
          title: Name
          type: string
        redirect_uris:
          description: Allowed OAuth callback URLs.
          examples:
          - - https://client.example.com/oauth/callback
          items:
            type: string
          title: Redirect Uris
          type: array
        registration_source:
          description: 'How the client entered the registry: ``admin`` or ``dcr``.'
          examples:
          - admin
          title: Registration Source
          type: string
        require_consent:
          description: Whether a consent screen is shown during authorization.
          examples:
          - true
          title: Require Consent
          type: boolean
        software_id:
          anyOf:
          - type: string
          - type: 'null'
          description: RFC 7591 software identifier claimed at registration, if any.
          examples:
          - com.example.billing-assistant
          title: Software Id
        token_endpoint_auth_method:
          description: 'Client authentication method at the token endpoint: ``client_secret_basic`` (confidential) or ``none`` (public, PKCE-only).'
          examples:
          - client_secret_basic
          title: Token Endpoint Auth Method
          type: string
        updated_at:
          anyOf:
          - format: date-time
            type: string
          - type: 'null'
          description: When the client was last updated (RFC 3339); null if never updated.
          examples:
          - '2026-01-20T14:05:00Z'
          title: Updated At
      required:
      - id
      - client_id
      - name
      - description
      - redirect_uris
      - allowed_scopes
      - active
      - require_consent
      - token_endpoint_auth_method
      - consent_model
      - registration_source
      - software_id
      - approval_status
      - created_at
      - updated_at
      - created_by
      title: OAuthClientResponse
      type: object
    OAuthClientRotateSecretResponse:
      description: Returned on secret rotation — the new one-time plaintext secret.
      examples:
      - &id182
        client_secret: example-client-secret
      properties:
        client_secret:
          description: The new client secret. Store it securely; the previous secret is now invalid.
          examples:
          - example-client-secret
          title: Client Secret
          type: string
          x-sensitive: true
      required:
      - client_secret
      title: OAuthClientRotateSecretResponse
      type: object
    OAuthClientUpdateRequest:
      description: Request body for updating an OAuth client.
      examples:
      - &id181
        active: true
        allowed_scopes: &id094
        - apis:read
        - capabilities:execute
        description: Billing assistant production deployment
        name: billing-assistant-prod
        redirect_uris: &id095
        - https://client.example.com/oauth/callback
        require_consent: true
      properties:
        active:
          anyOf:
          - type: boolean
          - type: 'null'
          description: False disables the client and true re-enables it; null means no change.
          examples:
          - true
          title: Active
        allowed_scopes:
          anyOf:
          - items:
              type: string
            type: array
          - type: 'null'
          description: Scope restriction list. Null means no change; an empty list denies all non-OIDC scopes; the wildcard ``["*"]`` resets to unrestricted.
          examples:
          - *id094
          title: Allowed Scopes
        description:
          anyOf:
          - type: string
          - type: 'null'
          description: New description for the client; null means no change.
          examples:
          - Billing assistant production deployment
          title: Description
        name:
          anyOf:
          - maxLength: 255
            type: string
          - type: 'null'
          description: New name for the client; null means no change.
          examples:
          - billing-assistant-prod
          title: Name
        redirect_uris:
          anyOf:
          - items:
              maxLength: 2048
              type: string
            maxItems: 20
            minItems: 1
            type: array
          - type: 'null'
          description: Replacement list of allowed OAuth callback URLs; null means no change.
          examples:
          - *id095
          title: Redirect Uris
        require_consent:
          anyOf:
          - type: boolean
          - type: 'null'
          description: Whether to show a consent screen during authorization; null means no change.
          examples:
          - true
          title: Require Consent
      title: OAuthClientUpdateRequest
      type: object
    OAuthConfirmSessionRequest:
      description: |-
        Confirm an OAuth session: the scopes to request and the agent's rules.

        The default variant — a body without ``kind`` is this one.
      examples:
      - agent_id: agnt_6968b3984d1c238dbe7e2e29
        confirmed_scopes: &id096
        - repo
        - read:user
        digest: 2c26b46b68ffc68ff99b453c1d30413413422d706483bfa0f98a5e886266e7ae
        expected_agent_id: agnt_6968b3984d1c238dbe7e2e29
        kind: oauth
        permission_rules: &id097
        - effect: allow
          match_mode: prefix
          methods: *id029
          operations: *id030
          path: /v1/charges
      properties:
        agent_id:
          anyOf:
          - type: string
          - type: 'null'
          description: Agent to bind when the session has none; ignored if the session already has one.
          examples:
          - agnt_6968b3984d1c238dbe7e2e29
          title: Agent Id
        confirmed_scopes:
          description: Upstream scopes the approver confirmed (at most 100).
          examples:
          - *id096
          items:
            type: string
          maxItems: 100
          title: Confirmed Scopes
          type: array
        digest:
          anyOf:
          - maxLength: 64
            type: string
          - type: 'null'
          description: Review digest echoed from the review data; a mismatch is 409 review_stale. Required for an API target.
          examples:
          - 2c26b46b68ffc68ff99b453c1d30413413422d706483bfa0f98a5e886266e7ae
          title: Digest
        expected_agent_id:
          anyOf:
          - type: string
          - type: 'null'
          description: Agent ID from the review the approver saw; a mismatch is 409 review_stale. Required for an API target.
          examples:
          - agnt_6968b3984d1c238dbe7e2e29
          title: Expected Agent Id
        kind:
          const: oauth
          default: oauth
          description: Confirm variant; `oauth` (the default when omitted).
          examples:
          - oauth
          title: Kind
          type: string
        permission_rules:
          description: Permission rules to bind for the agent (at most 100).
          examples:
          - *id097
          items:
            $ref: '#/components/schemas/PermissionRuleSchema'
          maxItems: 100
          title: Permission Rules
          type: array
      required:
      - confirmed_scopes
      title: OAuthConfirmSessionRequest
      type: object
    OAuthErrorResponse:
      description: |-
        OAuth 2.0 error response (RFC 6749 §5.2 dialect).

        Spec-facing OAuth endpoints (token, RFC 7009 revocation, RFC 7591
        registration) answer errors in this dialect rather than RFC 9457 Problem
        Details, because real OAuth/MCP clients parse it.
      examples:
      - error: invalid_request
        error_description: missing required parameter
      properties:
        error:
          description: ASCII error code, e.g. `invalid_request`, `invalid_grant`, `invalid_client`, `unsupported_grant_type`, `invalid_client_metadata`, `slow_down`.
          examples:
          - invalid_request
          title: Error
          type: string
        error_description:
          anyOf:
          - type: string
          - type: 'null'
          description: Human-readable explanation of the error.
          examples:
          - missing required parameter
          title: Error Description
      required:
      - error
      title: OAuthErrorResponse
      type: object
    OAuthGrantAdminListResponse:
      description: A paginated list of OAuth grants (admin cross-view).
      examples:
      - &id183
        data: &id098
        - agent_id: agnt_6968b3984d1c238dbe7e2e29
          agent_status: active
          can_revoke: true
          client_name: billing-assistant-prod
          client_origin: https://client.example.com
          created_at: '2026-01-15T09:30:00Z'
          id: ocg_6968b3985e21c5fdf643025d
          last_used_at: '2026-01-19T08:12:00Z'
          oauth_client_id: oc_Xk3vQ9mT2pLw8RzN5bYc1HdF7gJs4AeU
          revoked_at: '2026-01-20T14:05:00Z'
          scopes: &id099
          - apis:read
          - capabilities:execute
          status: revoked
          user_id: usr_6968b3987ee4c3ec0b4ee3b9
        has_more: true
        next_cursor: eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
      properties:
        data:
          description: The page of grants.
          examples:
          - *id098
          items:
            $ref: '#/components/schemas/OAuthGrantAdminResponse'
          title: Data
          type: array
        has_more:
          description: Whether more results exist after this page.
          examples:
          - true
          title: Has More
          type: boolean
        next_cursor:
          anyOf:
          - type: string
          - type: 'null'
          description: Cursor for the next page; null when there are no more results.
          examples:
          - eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
          title: Next Cursor
      required:
      - data
      - has_more
      title: OAuthGrantAdminListResponse
      type: object
    OAuthGrantAdminResponse:
      description: One consent→agent grant in the admin cross-view.
      examples:
      - agent_id: agnt_6968b3984d1c238dbe7e2e29
        agent_status: active
        can_revoke: true
        client_name: billing-assistant-prod
        client_origin: https://client.example.com
        created_at: '2026-01-15T09:30:00Z'
        id: ocg_6968b3985e21c5fdf643025d
        last_used_at: '2026-01-19T08:12:00Z'
        oauth_client_id: oc_Xk3vQ9mT2pLw8RzN5bYc1HdF7gJs4AeU
        revoked_at: '2026-01-20T14:05:00Z'
        scopes: *id099
        status: revoked
        user_id: usr_6968b3987ee4c3ec0b4ee3b9
      properties:
        agent_id:
          description: The agent this grant binds the client to.
          examples:
          - agnt_6968b3984d1c238dbe7e2e29
          title: Agent Id
          type: string
        agent_status:
          anyOf:
          - type: string
          - type: 'null'
          description: 'Lifecycle state of the bound agent (`active`, `disabled`, `archived`, …). A grant on a non-active agent is dormant: the row stays `active` (disable is reversible — re-enable restores the standing consent without a new consent round) but no token resolves while the agent is non-active. Lets listings tell a working connection from a dormant one (#1233).'
          examples:
          - active
          title: Agent Status
        can_revoke:
          description: Whether the CALLER may revoke this grant (the consenting user, or an admin holding the revoke permission set). May be false even for callers who can list — e.g. a read-only admin.
          examples:
          - true
          title: Can Revoke
          type: boolean
        client_name:
          anyOf:
          - type: string
          - type: 'null'
          description: Display name of the registered client, if the row still exists.
          examples:
          - billing-assistant-prod
          title: Client Name
        client_origin:
          anyOf:
          - type: string
          - type: 'null'
          description: Origin (scheme://host) of the client's first redirect URI — the 'authorized apps' display pattern.
          examples:
          - https://client.example.com
          title: Client Origin
        created_at:
          description: When the grant was created (RFC 3339).
          examples:
          - '2026-01-15T09:30:00Z'
          format: date-time
          title: Created At
          type: string
        id:
          description: Grant ID (ksuid, `ocg_` prefix).
          examples:
          - ocg_6968b3985e21c5fdf643025d
          title: Id
          type: string
        last_used_at:
          anyOf:
          - format: date-time
            type: string
          - type: 'null'
          description: Last time the client obtained tokens under this grant (stamped at exchange/refresh, not per request).
          examples:
          - '2026-01-19T08:12:00Z'
          title: Last Used At
        oauth_client_id:
          description: The client's public client_id — the same identifier stamped on tokens minted under this grant.
          examples:
          - oc_Xk3vQ9mT2pLw8RzN5bYc1HdF7gJs4AeU
          title: Oauth Client Id
          type: string
        revoked_at:
          anyOf:
          - format: date-time
            type: string
          - type: 'null'
          description: When the grant was revoked (RFC 3339); null while it is active.
          examples:
          - '2026-01-20T14:05:00Z'
          title: Revoked At
        scopes:
          description: Scopes granted at consent (the D2 intersection).
          examples:
          - *id099
          items:
            type: string
          title: Scopes
          type: array
        status:
          description: 'Grant lifecycle state: ``active`` or ``revoked``.'
          examples:
          - revoked
          title: Status
          type: string
        user_id:
          description: 'The consenting user who approved this grant. Shown even after an agent ownership transfer: the grant stays with the original consenter (it is their consent, not the agent''s).'
          examples:
          - usr_6968b3987ee4c3ec0b4ee3b9
          title: User Id
          type: string
      required:
      - id
      - oauth_client_id
      - client_name
      - client_origin
      - user_id
      - agent_id
      - scopes
      - status
      - created_at
      - revoked_at
      - last_used_at
      - can_revoke
      title: OAuthGrantAdminResponse
      type: object
    OAuthGrantListResponse:
      description: A paginated list of OAuth grants.
      examples:
      - &id193
        data: &id100
        - agent_id: agnt_6968b3984d1c238dbe7e2e29
          agent_status: active
          can_revoke: true
          client_name: Cursor
          client_origin: https://client.example.com
          created_at: '2026-01-15T09:30:00Z'
          id: ocg_6968b3985e21c5fdf643025d
          last_used_at: '2026-01-24T08:15:00Z'
