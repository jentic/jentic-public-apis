  /catalog/{api_id}/operations:
    description: '`GET`: Preview Catalog Operations.'
    get:
      description: |-
        Preview the operations of a catalog entry's spec (capped, offset-paginated).

        ``tag`` and ``q`` filter the spec's operations server-side before windowing,
        so the UI's search box covers every operation in the spec and pages the
        filtered set via ``offset``/``limit`` ("Load more").
      operationId: previewCatalogOperations
      parameters:
      - description: Catalog identity of the API (`domain[/sub-api]`); send any `/` unencoded.
        examples:
          example:
            summary: API vendor domain
            value: stripe.com
        in: path
        name: api_id
        required: true
        schema:
          description: Catalog identity of the API (`domain[/sub-api]`); send any `/` unencoded.
          examples:
          - stripe.com
          title: Api Id
          type: string
      - description: Number of matching operations to skip.
        examples:
          example:
            summary: Example query value for `offset`
            value: 0
        in: query
        name: offset
        required: false
        schema:
          default: 0
          description: Number of matching operations to skip.
          examples:
          - 0
          minimum: 0
          title: Offset
          type: integer
      - description: Maximum number of operations to return (0-200).
        examples:
          example:
            summary: Example query value for `limit`
            value: 25
        in: query
        name: limit
        required: false
        schema:
          default: 200
          description: Maximum number of operations to return (0-200).
          examples:
          - 25
          maximum: 200
          minimum: 0
          title: Limit
          type: integer
      - description: Only return operations with a tag containing this text (case-insensitive).
        examples:
          example:
            summary: Example query value for `tag`
            value: Charges
        in: query
        name: tag
        required: false
        schema:
          anyOf:
          - examples:
            - Charges
            type: string
          - type: 'null'
          description: Only return operations with a tag containing this text (case-insensitive).
          examples:
          - Charges
          title: Tag
      - description: Only return operations whose method, path, summary or operation ID contains this text (case-insensitive).
        examples:
          example:
            summary: Example query value for `q`
            value: charges
        in: query
        name: q
        required: false
        schema:
          anyOf:
          - examples:
            - charges
            maxLength: 500
            type: string
          - type: 'null'
          description: Only return operations whose method, path, summary or operation ID contains this text (case-insensitive).
          examples:
          - charges
          title: Q
      responses:
        '200':
          content:
            application/json:
              example: *id216
              schema:
                $ref: '#/components/schemas/OperationPreviewListResponse'
          description: Successful Response
        '400':
          content:
            application/problem+json:
              example: *id169
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Bad Request
        '401':
          content:
            application/problem+json:
              example: *id170
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unauthorized
        '403':
          content:
            application/problem+json:
              example: *id171
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Forbidden
        '422':
          content:
            application/problem+json:
              example: *id172
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unprocessable Entity
        '500':
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Internal Server Error
        '503':
          content:
            application/problem+json:
              example: *id173
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Service Unavailable
        default:
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unexpected error, as RFC 9457 Problem Details.
      security:
      - BearerAuth: []
      - OAuth2: []
      summary: Preview Catalog Operations
      tags:
      - Catalog
    summary: Preview Catalog Operations
  /catalog/{api_id}:import:
    description: '`POST`: Import Catalog Entry.'
    post:
      description: Enqueue an async import of a catalog entry into the local registry.
      operationId: importCatalogEntry
      parameters:
      - description: Catalog identity of the API (`domain[/sub-api]`); send any `/` unencoded.
        examples:
          example:
            summary: API vendor domain
            value: stripe.com
        in: path
        name: api_id
        required: true
        schema:
          description: Catalog identity of the API (`domain[/sub-api]`); send any `/` unencoded.
          examples:
          - stripe.com
          title: Api Id
          type: string
      responses:
        '202':
          content:
            application/json:
              example: *id217
              schema:
                $ref: '#/components/schemas/ApiImportResponse'
          description: Successful Response
        '400':
          content:
            application/problem+json:
              example: *id169
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Bad Request
        '401':
