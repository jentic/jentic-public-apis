  /permission-rule-sets/{rule_set_id}/rules:
    description: '`PUT`: Replace all rules in a permission rule set.'
    put:
      description: |-
        Replace a rule set's entire ordered rule list with the body.

        This is a full replacement, not a merge: user rules missing from the body
        are removed, and an empty list clears them. Platform-managed system rules
        (`_system: true`) are kept. The request is idempotent.
        Every binding attached to the set enforces the new rules immediately.
        Same edit permission as updating the set (403 `rule_set_access_denied`).
        Returns the stored rules in order.
      operationId: replacePermissionRuleSetRules
      parameters:
      - description: ID of the permission rule set.
        examples:
          example:
            summary: Permission rule set ID
            value: prs_6968b3987c22b63e87e79f05
        in: path
        name: rule_set_id
        required: true
        schema:
          description: ID of the permission rule set.
          examples:
          - prs_6968b3987c22b63e87e79f05
          title: Rule Set Id
          type: string
      requestBody:
        content:
          application/json:
            schema:
              items:
                $ref: '#/components/schemas/PermissionRuleSchema'
              maxItems: 100
              title: Body
              type: array
        description: Request payload for the `replacePermissionRuleSetRules` operation.
        required: true
      responses:
        '200':
          content:
            application/json:
              example: *id225
              schema:
                $ref: '#/components/schemas/PermissionRuleListResponse'
          description: Successful Response
        '400':
          content:
            application/problem+json:
              example: *id169
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Bad Request
        '401':
          content:
            application/problem+json:
              example: *id170
              schema:
