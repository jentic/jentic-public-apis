  /agents/{agent_id}:approve:
    description: '`POST`: Approve Agent.'
    post:
      description: |-
        Approve a pending agent.

        Allowed for the agent's owner or an ``org:admin``. An agent with no owner
        (an unclaimed self-registration) can be approved only by an ``org:admin``,
        who becomes its owner. Any other caller gets a 404, whatever the agent's
        status, so the response does not reveal agents outside the caller's
        ownership.
      operationId: approveAgent
      parameters:
      - description: ID of the agent.
        examples:
          example:
            summary: Agent ID
            value: agnt_6968b3984d1c238dbe7e2e29
        in: path
        name: agent_id
        required: true
        schema:
          description: ID of the agent.
          examples:
          - agnt_6968b3984d1c238dbe7e2e29
          title: Agent Id
          type: string
      responses:
