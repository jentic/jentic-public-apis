          description: Service Unavailable
        default:
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unexpected error, as RFC 9457 Problem Details.
      security:
      - BearerAuth: []
      - OAuth2: []
      summary: Change own password
      tags:
      - Users
    summary: Change own password
  /users/{user_id}:
    delete:
      description: |-
        Delete a user account (terminal-but-kept).

        The row is retained — the account is anonymized (tombstone email) and
        deactivated so history and audit references stay resolvable — but the
        action is terminal: there is no re-enable arm. For the reversible kill
        switch use ``:disable`` / ``:enable`` instead.
      operationId: deleteUser
      parameters:
      - description: ID of the user.
        examples:
          example:
            summary: User ID
            value: usr_6968b3987ee4c3ec0b4ee3b9
        in: path
        name: user_id
        required: true
        schema:
          description: ID of the user.
          examples:
          - usr_6968b3987ee4c3ec0b4ee3b9
          title: User Id
          type: string
      responses:
        '204':
          description: Successful Response
        '400':
          content:
            application/problem+json:
              example: *id169
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Bad Request
        '401':
          content:
            application/problem+json:
              example: *id170
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unauthorized
        '403':
          content:
            application/problem+json:
              example: *id171
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Forbidden
        '404':
          content:
            application/problem+json:
              example: *id180
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Not Found
        '409':
          content:
            application/problem+json:
              example: *id218
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: The user is the last active org:admin
        '422':
          content:
            application/problem+json:
              example: *id172
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unprocessable Entity
        '500':
          content:
            application/problem+json:
              example: *id166
