  /apis/{vendor}/{name}/{version}/operations:
    description: '`GET`: List the operations an API currently serves.'
    get:
      description: |-
        List every operation in the API's current (live) revision.

        Each row gives the operation's id, method, path, name, description, tags,
        `deprecated` flag, and an `inspect` link for its full detail. Rows come in
        a stable, unranked order and are cursor-paginated (`cursor`, `limit`).
        Use this to browse an API exhaustively; to find operations by intent,
        use `GET /search` instead. 404 (`no_current_revision`) when the API has no live
        revision.
      operationId: listApiOperations
      parameters:
      - description: Vendor of the API.
        examples:
          example:
            summary: API vendor domain
            value: stripe.com
        in: path
        name: vendor
        required: true
        schema:
          description: Vendor of the API.
          examples:
          - stripe.com
          title: Vendor
          type: string
      - description: Name of the API.
        examples:
          example:
            summary: API name
            value: stripe
        in: path
        name: name
        required: true
        schema:
          description: Name of the API.
          examples:
          - stripe
          title: Name
          type: string
      - description: Version of the API.
        examples:
          example:
            summary: API version
            value: '2024-04-10'
        in: path
        name: version
        required: true
        schema:
          description: Version of the API.
          examples:
          - '2024-04-10'
          title: Version
          type: string
      - description: Opaque cursor from a previous page's `next_cursor`; omit for the first page.
        examples:
          example:
            summary: Opaque cursor from a previous page
            value: eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
        in: query
        name: cursor
        required: false
        schema:
          anyOf:
          - examples:
            - eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
            type: string
          - type: 'null'
          description: Opaque cursor from a previous page's `next_cursor`; omit for the first page.
          examples:
          - eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
          title: Cursor
      - description: Maximum number of operations to return (1-200).
        examples:
          example:
            summary: Example query value for `limit`
            value: 25
        in: query
        name: limit
        required: false
        schema:
          default: 50
          description: Maximum number of operations to return (1-200).
          examples:
          - 25
          maximum: 200
          minimum: 1
          title: Limit
          type: integer
      responses:
        '200':
          content:
            application/json:
              example: *id203
              schema:
                $ref: '#/components/schemas/OperationSummaryListResponse'
          description: Successful Response
        '400':
          content:
            application/problem+json:
              example: *id169
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Bad Request
        '401':
          content:
            application/problem+json:
              example: *id170
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unauthorized
        '403':
          content:
            application/problem+json:
              example: *id171
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Forbidden
        '422':
          content:
            application/problem+json:
              example: *id172
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unprocessable Entity
        '500':
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Internal Server Error
        '503':
          content:
            application/problem+json:
              example: *id173
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Service Unavailable
        default:
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unexpected error, as RFC 9457 Problem Details.
      security:
      - BearerAuth: []
      - OAuth2: []
      summary: List the operations an API currently serves
      tags:
      - API Operations
    summary: List the operations an API currently serves
  /apis/{vendor}/{name}/{version}/overlays:
    description: '`POST`: Submit an OpenAPI overlay. `GET`: List an API''s overlays.'
    get:
      description: |-
        List the overlays submitted against an API, newest first.

        Each overlay gives its `status` — `pending` (awaiting review), `confirmed`
        (applied to the served spec) or `deprecated` (retired) — and links to the
        actions valid in that state. Filter with `status`. Results are
        cursor-paginated: pass `next_cursor` as `cursor` while `has_more` is
        true.
      operationId: listOverlays
      parameters:
      - description: Vendor of the API.
        examples:
          example:
            summary: API vendor domain
            value: stripe.com
        in: path
        name: vendor
        required: true
        schema:
          description: Vendor of the API.
          examples:
          - stripe.com
          title: Vendor
          type: string
      - description: Name of the API.
        examples:
          example:
            summary: API name
            value: stripe
        in: path
        name: name
        required: true
        schema:
          description: Name of the API.
          examples:
          - stripe
          title: Name
          type: string
      - description: Version of the API.
        examples:
          example:
            summary: API version
            value: '2024-04-10'
        in: path
        name: version
        required: true
        schema:
          description: Version of the API.
          examples:
          - '2024-04-10'
          title: Version
          type: string
      - description: Opaque cursor from a previous page's `next_cursor`; omit for the first page.
        examples:
          example:
            summary: Opaque cursor from a previous page
            value: eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
        in: query
        name: cursor
        required: false
        schema:
          anyOf:
          - examples:
            - eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
            type: string
          - type: 'null'
          description: Opaque cursor from a previous page's `next_cursor`; omit for the first page.
          examples:
          - eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
          title: Cursor
      - description: Maximum number of overlays to return (1-200).
        examples:
          example:
            summary: Example query value for `limit`
            value: 25
        in: query
        name: limit
        required: false
        schema:
          default: 50
          description: Maximum number of overlays to return (1-200).
          examples:
          - 25
          maximum: 200
          minimum: 1
          title: Limit
          type: integer
      - description: 'Only return overlays in this status: `pending`, `confirmed` or `deprecated`.'
        examples:
          example:
            summary: Example query value for `status`
            value: confirmed
        in: query
        name: status
        required: false
        schema:
          anyOf:
          - examples:
            - confirmed
            type: string
          - type: 'null'
          description: 'Only return overlays in this status: `pending`, `confirmed` or `deprecated`.'
          examples:
          - confirmed
          title: Status
      responses:
        '200':
          content:
            application/json:
              example: *id204
              schema:
                $ref: '#/components/schemas/OverlayListResponse'
          description: Successful Response
        '400':
          content:
            application/problem+json:
              example: *id169
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Bad Request
        '401':
          content:
            application/problem+json:
              example: *id170
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unauthorized
        '403':
          content:
            application/problem+json:
              example: *id171
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Forbidden
        '422':
          content:
            application/problem+json:
              example: *id172
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unprocessable Entity
        '500':
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Internal Server Error
        '503':
          content:
            application/problem+json:
              example: *id173
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Service Unavailable
        default:
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unexpected error, as RFC 9457 Problem Details.
      security:
      - BearerAuth: []
      - OAuth2: []
      summary: List an API's overlays
      tags:
      - Overlays
    post:
      description: |-
        Propose a change to an API's spec as an OpenAPI Overlay document.

        An overlay is a list of `actions` that patch the API's OpenAPI document —
        for example correcting a description or adding a missing parameter.
        Submitting stores it as `pending`; it changes nothing until an operator
        confirms it (`:confirm`). Optionally pin it to a `target_revision_id` and
        record a `contributed_by` label. The document must be a JSON object with
        an `actions` array (at most 512 actions, 1 MB), else 422
        (`invalid_overlay_document`). Requires `apis:write`. Returns the overlay.
      operationId: submitOverlay
      parameters:
      - description: Vendor of the API.
        examples:
          example:
            summary: API vendor domain
            value: stripe.com
        in: path
        name: vendor
        required: true
        schema:
          description: Vendor of the API.
          examples:
          - stripe.com
          title: Vendor
          type: string
      - description: Name of the API.
        examples:
          example:
            summary: API name
            value: stripe
        in: path
        name: name
        required: true
        schema:
          description: Name of the API.
          examples:
          - stripe
          title: Name
          type: string
      - description: Version of the API.
        examples:
          example:
            summary: API version
            value: '2024-04-10'
        in: path
        name: version
        required: true
        schema:
          description: Version of the API.
          examples:
          - '2024-04-10'
          title: Version
          type: string
      requestBody:
        content:
          application/json:
            example: *id205
            schema:
              $ref: '#/components/schemas/OverlaySubmitRequest'
        description: Payload for submitting a new overlay.
        required: true
      responses:
        '201':
          content:
            application/json:
              example: *id206
              schema:
                $ref: '#/components/schemas/OverlayResponse'
          description: Successful Response
        '400':
          content:
            application/problem+json:
              example: *id169
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Bad Request
        '401':
          content:
            application/problem+json:
              example: *id170
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unauthorized
        '403':
          content:
            application/problem+json:
              example: *id171
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Forbidden
        '422':
          content:
            application/problem+json:
              example: *id172
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unprocessable Entity
        '500':
          content:
            application/problem+json:
              example: *id166
