    OperationPreviewListResponse:
      description: |-
        Capped, offset-paginated operation preview for a catalog entry.

        Unlike list endpoints (cursor-paginated), the preview uses simple
        offset/limit pagination deliberately: it reads a single, already-fetched spec
        document and is hard-capped at ``PREVIEW_MAX_OPERATIONS`` operations, so there
        is no large/mutating result set that would justify keyset cursors.
      examples:
      - &id216
        data: []
        info:
          description: Payments.
          title: Stripe
          version: '2024-01-01'
        offset: 0
        security_schemes: {}
        total: 42
        truncated: true
      properties:
        data:
          description: The page of previewed operations.
          examples:
          - - &id125
              description: ''
              method: GET
              operation_id: listCharges
              parameters: []
              path: /v1/charges
              security:
              - BearerAuth
              summary: List charges
              tags:
              - charges
          items:
            $ref: '#/components/schemas/PreviewOperationResponse'
          title: Data
          type: array
        info:
          $ref: '#/components/schemas/PreviewInfoResponse'
          description: The spec's `info` block.
          examples:
          - &id124
            description: Payments.
            title: Stripe
            version: '2024-01-01'
        offset:
          description: Offset of the returned window.
          examples:
          - 0
          title: Offset
          type: integer
        security_schemes:
          additionalProperties:
            additionalProperties: true
            type: object
          description: Slimmed `components.securitySchemes` projection.
          examples:
          - BearerAuth:
              scheme: bearer
              type: http
          title: Security Schemes
          type: object
        total:
          description: Total operations in the spec (pre-page).
          examples:
          - 42
          title: Total
          type: integer
        truncated:
          description: Whether more operations follow this window.
          examples:
          - true
          title: Truncated
          type: boolean
      required:
      - data
      - total
      - offset
      - truncated
      - info
      - security_schemes
      title: OperationPreviewListResponse
      type: object
    OperationResultResponse:
      description: A single search result matching the OperationResult spec.
      examples:
      - &id144
        _links: &id102
          inspect: https://jentic.example.com/inspect?id=GET%20https%3A%2F%2Fapi.stripe.com%2Fv1%2Fcharges
        api: *id019
        description: Returns a list of charges you've previously created, newest first.
        method: GET
        name: List all charges
        operation_id: op_f92d69f1621f381bce8aaff47053c61b069ffe34
        relevance_score: 0.87
        target: GET:https://api.stripe.com/v1/charges
        type: operation
        url: https://api.stripe.com/v1/charges
      properties:
        _links:
          $ref: '#/components/schemas/SearchLinksResponse'
          examples:
          - *id102
        api:
          $ref: '#/components/schemas/ApiReferenceResponse'
          examples:
          - *id019
        description:
          anyOf:
          - type: string
          - type: 'null'
          description: Description of the operation; null if the spec gives none.
          examples:
          - Returns a list of charges you've previously created, newest first.
          title: Description
        method:
          description: HTTP method of the operation.
          examples:
          - GET
          title: Method
          type: string
        name:
          anyOf:
          - type: string
          - type: 'null'
          description: Summary of the operation from the spec; null if it has none.
          examples:
          - List all charges
          title: Name
        operation_id:
          description: Registry ID of the operation.
          examples:
          - op_f92d69f1621f381bce8aaff47053c61b069ffe34
          title: Operation Id
          type: string
        relevance_score:
          description: Relevance of the result to the query, from 0 to 1; higher is more relevant.
          examples:
          - 0.87
          title: Relevance Score
          type: number
        target:
          description: 'The value to pass as the operation target to inspect/execute (CLI argument; MCP operation_id argument). METHOD:url when url is absolute; the registry operation_id when url is host-relative (the spec declares no servers, or only a relative one) — such a target is inspect-only: with no upstream host there is nothing for the broker to proxy, so execute refuses it.'
          examples:
          - GET:https://api.stripe.com/v1/charges
          title: Target
          type: string
        type:
          const: operation
          default: operation
          description: Result kind; always `operation`.
          examples:
          - operation
          title: Type
          type: string
        url:
          description: URL of the operation, built from the spec's server and path; host-relative when the spec declares no absolute server.
          examples:
          - https://api.stripe.com/v1/charges
          title: Url
          type: string
      required:
      - api
      - operation_id
      - method
      - url
      - target
      - relevance_score
      - _links
      title: OperationResultResponse
      type: object
    OperationSummaryLinksResponse:
