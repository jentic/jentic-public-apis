  /agents/{agent_id}/api-key:
    description: '`GET`: Get an agent''s API key metadata.'
    get:
      description: |-
        Describe an agent's API key without revealing it.

        Returns the key record's `id`, `status` (`active`, or `revoked` once
        revoked), `created_at`, `rotated_at` and `created_by`. The plaintext key
        is never returned — it is shown once, by `:generate-api-key`. Metadata
        stays available after revocation; the body is `null` if the agent never
        had a key. Allowed for the agent's owner or an `org:admin`.
      operationId: getAgentApiKeyInfo
      parameters:
      - description: ID of the agent.
        examples:
          example:
            summary: Agent ID
            value: agnt_6968b3984d1c238dbe7e2e29
        in: path
        name: agent_id
        required: true
        schema:
          description: ID of the agent.
          examples:
          - agnt_6968b3984d1c238dbe7e2e29
          title: Agent Id
          type: string
      responses:
        '200':
          content:
            application/json:
              schema:
                anyOf:
                - $ref: '#/components/schemas/ApiKeyInfoResponse'
                - type: 'null'
                title: Response Getagentapikeyinfo
          description: Successful Response
        '400':
          content:
            application/problem+json:
              example: *id169
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Bad Request
        '401':
          content:
            application/problem+json:
              example: *id170
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unauthorized
        '403':
          content:
            application/problem+json:
              example: *id171
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Forbidden
        '422':
          content:
            application/problem+json:
              example: *id172
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unprocessable Entity
        '500':
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Internal Server Error
        '503':
          content:
            application/problem+json:
              example: *id173
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Service Unavailable
        default:
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unexpected error, as RFC 9457 Problem Details.
      security:
      - BearerAuth: []
      - OAuth2: []
      summary: Get an agent's API key metadata
      tags:
      - Agents
    summary: Get an agent's API key metadata
  /agents/{agent_id}/api-key/history:
    description: '`GET`: Get an agent''s API key history.'
    get:
      description: |-
        List recent API key rotations and revocations for an agent.

        Each entry gives the audit `action`, its `reason` (key rotated or key
        revoked), the acting `actor_id`, and `occurred_at`. Drawn from the agent's
        50 most recent audit entries, newest first, so very old key events may
        not appear; it is not paginated. Allowed for the agent's owner or an
        `org:admin`.
      operationId: getAgentApiKeyHistory
      parameters:
      - description: ID of the agent.
        examples:
          example:
            summary: Agent ID
            value: agnt_6968b3984d1c238dbe7e2e29
        in: path
        name: agent_id
        required: true
        schema:
          description: ID of the agent.
          examples:
          - agnt_6968b3984d1c238dbe7e2e29
          title: Agent Id
          type: string
      responses:
        '200':
          content:
            application/json:
              example: *id188
              schema:
                $ref: '#/components/schemas/ApiKeyHistoryResponse'
