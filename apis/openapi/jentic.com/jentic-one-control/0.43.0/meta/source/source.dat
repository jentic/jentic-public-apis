  /events/stream:
    description: '`GET`: Stream Events.'
    get:
      description: Stream events as Server-Sent Events.
      operationId: streamEvents
      parameters:
      - description: Stream events created after this time (RFC 3339); defaults to now, and a future time is treated as now.
        examples:
          example:
            summary: Start of a time window (RFC 3339)
