  /credentials/{credential_id}/agents/{agent_id}/permissions:test:
    description: '`POST`: Dry-run permission evaluation.'
    post:
      description: |-
        Answer "what would the broker do for this request?" without calling upstream.

        Unlike the toolkit `:test` there is **no vendor pooling**: the direct
        binding's rules are one ordered first-match-wins list, so the result is
        exactly this binding's policy. Default-deny when nothing matches.
      operationId: testAgentCredentialPermissions
      parameters:
      - description: ID of the credential.
        examples:
          example:
            summary: Credential ID
            value: cred_6968b39855d91a3561684b32
        in: path
        name: credential_id
        required: true
        schema:
          description: ID of the credential.
          examples:
          - cred_6968b39855d91a3561684b32
          title: Credential Id
          type: string
      - description: ID of the agent bound to the credential.
        examples:
          example:
            summary: Agent ID
            value: agnt_6968b3984d1c238dbe7e2e29
        in: path
        name: agent_id
        required: true
        schema:
          description: ID of the agent bound to the credential.
          examples:
          - agnt_6968b3984d1c238dbe7e2e29
          title: Agent Id
          type: string
      requestBody:
        content:
          application/json:
            example: *id227
            schema:
              $ref: '#/components/schemas/PermissionTestRequest'
        description: Request body for :test — dry-run a request shape against the binding's rules.
        required: true
      responses:
        '200':
          content:
            application/json:
              example: *id228
              schema:
                $ref: '#/components/schemas/PermissionTestResponse'
          description: Successful Response
        '400':
          content:
            application/problem+json:
              example: *id169
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Bad Request
        '401':
          content:
            application/problem+json:
              example: *id170
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unauthorized
        '403':
          content:
            application/problem+json:
              example: *id171
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Forbidden
        '404':
          content:
            application/problem+json:
              example: *id180
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Not Found
        '422':
          content:
            application/problem+json:
              example: *id172
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unprocessable Entity
        '500':
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Internal Server Error
        '503':
          content:
            application/problem+json:
              example: *id173
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Service Unavailable
        default:
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unexpected error, as RFC 9457 Problem Details.
      security:
      - BearerAuth: []
      - OAuth2: []
      summary: Dry-run permission evaluation
      tags:
      - Credentials
    summary: Dry-run permission evaluation
  /credentials/{credential_id}/agents/{agent_id}/rule-set:
    delete:
      description: |-
        Detach the binding's shared rule set — its inline rules apply again.

        Idempotent: detaching a binding already on inline rules is a no-op 204.
      operationId: detachAgentCredentialRuleSet
      parameters:
      - description: ID of the credential.
        examples:
          example:
            summary: Credential ID
            value: cred_6968b39855d91a3561684b32
        in: path
        name: credential_id
        required: true
        schema:
          description: ID of the credential.
          examples:
          - cred_6968b39855d91a3561684b32
          title: Credential Id
          type: string
      - description: ID of the agent bound to the credential.
        examples:
          example:
            summary: Agent ID
            value: agnt_6968b3984d1c238dbe7e2e29
        in: path
        name: agent_id
        required: true
        schema:
          description: ID of the agent bound to the credential.
          examples:
          - agnt_6968b3984d1c238dbe7e2e29
          title: Agent Id
          type: string
      responses:
        '204':
          description: Successful Response
        '400':
          content:
            application/problem+json:
              example: *id169
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Bad Request
        '401':
          content:
            application/problem+json:
              example: *id170
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unauthorized
        '403':
          content:
            application/problem+json:
              example: *id171
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Forbidden
        '404':
          content:
            application/problem+json:
              example: *id180
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Not Found
        '422':
          content:
            application/problem+json:
              example: *id172
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unprocessable Entity
        '500':
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Internal Server Error
        '503':
          content:
            application/problem+json:
              example: *id173
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Service Unavailable
        default:
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unexpected error, as RFC 9457 Problem Details.
      security:
      - BearerAuth: []
      - OAuth2: []
      summary: Detach rule set from binding
      tags:
      - Credentials
    description: '`PUT`: Attach rule set to binding. `DELETE`: Detach rule set from binding.'
    put:
      description: |-
        Point the binding at a shared rule set (idempotent PUT).

        While attached, the set's ordered list is the binding's effective policy
        and its inline rules are dormant — `permissions:test` evaluates the set.
        The set must exist (404 `rule_set_not_found`). The caller must be the
        set's creator or an org admin, unless the set is curated (created by an
        org admin), which any caller who may write the binding's rules can
        attach; otherwise 403 `rule_set_attach_denied`. Re-attaching the set the
        binding already points at is a no-op.
      operationId: attachAgentCredentialRuleSet
      parameters:
      - description: ID of the credential.
        examples:
          example:
            summary: Credential ID
            value: cred_6968b39855d91a3561684b32
        in: path
        name: credential_id
        required: true
        schema:
          description: ID of the credential.
          examples:
          - cred_6968b39855d91a3561684b32
          title: Credential Id
          type: string
      - description: ID of the agent bound to the credential.
        examples:
          example:
            summary: Agent ID
            value: agnt_6968b3984d1c238dbe7e2e29
        in: path
        name: agent_id
        required: true
        schema:
          description: ID of the agent bound to the credential.
          examples:
          - agnt_6968b3984d1c238dbe7e2e29
          title: Agent Id
          type: string
      requestBody:
        content:
          application/json:
            example: *id229
            schema:
              $ref: '#/components/schemas/RuleSetAttachRequest'
        description: Point a direct agent↔credential binding at a shared rule set.
        required: true
      responses:
        '204':
          description: Successful Response
        '400':
          content:
            application/problem+json:
              example: *id169
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Bad Request
        '401':
          content:
            application/problem+json:
              example: *id170
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unauthorized
        '403':
          content:
            application/problem+json:
              example: *id171
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Forbidden
        '404':
          content:
            application/problem+json:
              example: *id180
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Not Found
        '422':
          content:
            application/problem+json:
              example: *id172
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unprocessable Entity
        '500':
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Internal Server Error
        '503':
          content:
            application/problem+json:
              example: *id173
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Service Unavailable
        default:
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unexpected error, as RFC 9457 Problem Details.
      security:
      - BearerAuth: []
      - OAuth2: []
      summary: Attach rule set to binding
      tags:
      - Credentials
    summary: Attach rule set to binding; Detach rule set from binding
  /credentials/{credential_id}/connect:
    description: '`POST`: Begin OAuth connect flow.'
    post:
      description: |-
        Initiate the OAuth connect flow for a credential.

        Discriminates on the provider's returned challenge: OAuth2
        authorization-code providers return an ``authorize_url`` for popup
        redirect; device-flow providers return ``user_code`` /
        ``verification_uri`` for the RFC 8628 human step.
      operationId: connectCredential
      parameters:
      - description: ID of the credential.
        examples:
          example:
            summary: Credential ID
            value: cred_6968b39855d91a3561684b32
        in: path
        name: credential_id
        required: true
        schema:
          description: ID of the credential.
          examples:
          - cred_6968b39855d91a3561684b32
          title: Credential Id
          type: string
      requestBody:
        content:
          application/json:
            example: *id230
            schema:
              $ref: '#/components/schemas/ConnectRequestBody'
        description: Request body for initiating a credential connect flow.
        required: true
      responses:
        '200':
          content:
            application/json:
              schema: {}
          description: Successful Response
        '400':
          content:
            application/problem+json:
              example: *id169
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Bad Request
        '401':
          content:
            application/problem+json:
              example: *id170
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unauthorized
        '403':
          content:
            application/problem+json:
              example: *id171
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Forbidden
        '404':
          content:
            application/problem+json:
              example: *id180
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Not Found
        '409':
          content:
            application/problem+json:
              example: *id218
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Credential is not connectable
        '422':
          content:
            application/problem+json:
              example: *id172
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unprocessable Entity
        '500':
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Internal Server Error
        '503':
          content:
            application/problem+json:
              example: *id173
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Service Unavailable
        default:
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unexpected error, as RFC 9457 Problem Details.
      security:
      - BearerAuth: []
      - OAuth2: []
      summary: Begin OAuth connect flow
      tags:
      - Credentials
    summary: Begin OAuth connect flow
  /error:
    description: '`GET`: Error Page.'
    get:
      description: Minimal error endpoint for browser-facing authorization failures.
      operationId: errorPage
      parameters:
      - description: Error code to display; returned as-is in the response body.
        examples:
          example:
            summary: Example query value for `error`
            value: access_denied
        in: query
        name: error
        required: false
        schema:
          default: unknown_error
          description: Error code to display; returned as-is in the response body.
          examples:
