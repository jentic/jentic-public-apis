  /system/version:
    description: '`GET`: Running and latest-available app version.'
    get:
      description: |-
        Return the running version and the latest available release.

        Requires an authenticated session (any valid caller; no special
        permission). The SPA reads it from inside the signed-in shell to show the
        current version and, when a newer release is available, an update banner.
        The latest release is resolved best-effort (cached); on any failure it is
        ``null`` and no banner shows.
      operationId: getVersion
      responses:
        '200':
          content:
            application/json:
              example: *id275
              schema:
                $ref: '#/components/schemas/VersionResponse'
          description: Successful Response
        default:
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unexpected error, as RFC 9457 Problem Details.
      security:
      - BearerAuth: []
      - OAuth2: []
      summary: Running and latest-available app version
      tags:
      - System
    summary: Running and latest-available app version
  /users:
    description: '`GET`: List Users. `POST`: Create User.'
    get:
      description: |-
        List users with cursor-based pagination.

        Scoped to the caller: org admins see every user; anyone else sees only themselves.
      operationId: listUsers
      parameters:
      - description: Opaque cursor from a previous page's `next_cursor`; omit for the first page.
        examples:
          example:
            summary: Opaque cursor from a previous page
            value: eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
        in: query
        name: cursor
        required: false
        schema:
          anyOf:
          - examples:
            - eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
            type: string
          - type: 'null'
          description: Opaque cursor from a previous page's `next_cursor`; omit for the first page.
          examples:
          - eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
          title: Cursor
      - description: Maximum number of users to return (1-200, default 50).
        examples:
          example:
            summary: Example query value for `limit`
            value: 25
        in: query
        name: limit
        required: false
        schema:
          default: 50
          description: Maximum number of users to return (1-200, default 50).
          examples:
          - 25
          maximum: 200
          minimum: 1
          title: Limit
          type: integer
      - description: Only return users with this stored invite state; lapsed invites are stored as `pending`, so `expired` matches no users.
        examples:
          example:
            summary: Example query value for `invite_state`
            value: pending
        in: query
        name: invite_state
        required: false
        schema:
          anyOf:
          - $ref: '#/components/schemas/InviteState'
          - type: 'null'
          description: Only return users with this stored invite state; lapsed invites are stored as `pending`, so `expired` matches no users.
          examples:
          - pending
          title: Invite State
      responses:
        '200':
          content:
            application/json:
              example: *id276
              schema:
                $ref: '#/components/schemas/UserListResponse'
          description: Successful Response
        '400':
          content:
            application/problem+json:
              example: *id169
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Bad Request
        '401':
          content:
            application/problem+json:
              example: *id170
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unauthorized
        '403':
          content:
            application/problem+json:
              example: *id171
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Forbidden
        '422':
          content:
            application/problem+json:
              example: *id172
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unprocessable Entity
        '500':
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Internal Server Error
        '503':
          content:
            application/problem+json:
              example: *id173
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Service Unavailable
        default:
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unexpected error, as RFC 9457 Problem Details.
      security:
      - BearerAuth: []
      - OAuth2: []
      summary: List Users
      tags:
      - Users
