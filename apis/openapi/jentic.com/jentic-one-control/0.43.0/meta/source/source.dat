    summary: Backend identity
  /integrations:connect:
    description: '`POST`: Start an integration connect session.'
    post:
      description: |-
        Both entrypoints (agent + UI) use this endpoint.

        Agent callers: `agent_id` in the payload is refused (the caller *is*
        the agent — spoofing another agent's id is a permission-boundary
        violation). The caller's own identity is injected instead. UI / user
        callers: `agent_id` is optional — when named, confirm creates the
        direct agent-credential binding + permission rules; when omitted, the
        credential connects unbound and an agent can be bound later through
        the credentials API.
      operationId: integrationsConnect
      requestBody:
        content:
          application/json:
            example: *id243
            schema:
              $ref: '#/components/schemas/IntegrationsConnectRequest'
        description: Start connecting a credential for a vendor or a registry API.
        required: true
      responses:
        '201':
          content:
            application/json:
              schema: {}
          description: Successful Response
        '400':
          content:
            application/problem+json:
              example: *id169
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Bad Request
        '401':
          content:
            application/problem+json:
              example: *id170
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unauthorized
        '403':
          content:
            application/problem+json:
              example: *id171
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Forbidden
        '404':
          content:
            application/problem+json:
              example: *id180
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unknown vendor or API, or API targets are not enabled
        '409':
          content:
            application/problem+json:
              example: *id218
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: The API declares no supported scheme, or its hosts cannot be pinned
        '422':
          content:
            application/problem+json:
              example: *id172
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unprocessable Entity
        '429':
          content:
            application/problem+json:
              example:
                detail: Too many requests; retry after the indicated delay.
                instance: /example/path
                status: 429
                title: Too Many Requests
                type: rate_limit_exceeded
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Rate limit, open-session cap, or a recent rejection
        '500':
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Internal Server Error
        '503':
          content:
            application/problem+json:
              example: *id173
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Service Unavailable
        default:
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unexpected error, as RFC 9457 Problem Details.
      security:
      - BearerAuth: []
      - OAuth2: []
      summary: Start an integration connect session
      tags:
      - Integrations
    summary: Start an integration connect session
  /jobs:
    description: '`GET`: List Jobs.'
    get:
      description: List jobs with optional filters.
      operationId: listJobs
      parameters:
      - description: Only return jobs of this kind, e.g. `import` or `execution`.
        examples:
          example:
            summary: Example query value for `kind`
            value: import
        in: query
        name: kind
        required: false
        schema:
          anyOf:
          - examples:
            - import
            type: string
          - type: 'null'
          description: Only return jobs of this kind, e.g. `import` or `execution`.
          examples:
          - import
          title: Kind
      - description: Only return jobs in one of these states; repeat the parameter for several.
        examples:
          example:
            summary: Example query value for `status`
            value: &id244
            - running
        in: query
        name: status
        required: false
        schema:
          anyOf:
          - examples:
            - *id244
            items:
              examples:
              - running
              type: string
            type: array
          - type: 'null'
          description: Only return jobs in one of these states; repeat the parameter for several.
          examples:
          - *id244
          title: Status
      - description: Only return jobs created at or after this time (RFC 3339).
        examples:
          example:
            summary: Start of a time window (RFC 3339)
            value: '2026-01-01T00:00:00Z'
        in: query
        name: from
        required: false
        schema:
          anyOf:
          - examples:
            - '2026-01-01T00:00:00Z'
            format: date-time
            type: string
          - type: 'null'
          description: Only return jobs created at or after this time (RFC 3339).
          examples:
          - '2026-01-01T00:00:00Z'
          title: From
      - description: Only return jobs created before this time (RFC 3339).
        examples:
          example:
            summary: End of a time window (RFC 3339)
            value: '2026-01-31T23:59:59Z'
        in: query
        name: to
        required: false
        schema:
          anyOf:
          - examples:
            - '2026-01-31T23:59:59Z'
            format: date-time
            type: string
          - type: 'null'
          description: Only return jobs created before this time (RFC 3339).
          examples:
          - '2026-01-31T23:59:59Z'
          title: To
      - description: Opaque cursor from a previous page's `next_cursor`; omit for the first page.
        examples:
          example:
            summary: Opaque cursor from a previous page
            value: eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
        in: query
        name: cursor
        required: false
        schema:
          anyOf:
          - examples:
            - eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
            type: string
          - type: 'null'
          description: Opaque cursor from a previous page's `next_cursor`; omit for the first page.
          examples:
          - eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
          title: Cursor
      - description: Maximum number of jobs to return (1-100, default 25).
        examples:
          example:
            summary: Example query value for `limit`
            value: 25
        in: query
        name: limit
        required: false
        schema:
          default: 25
          description: Maximum number of jobs to return (1-100, default 25).
          examples:
          - 25
          maximum: 100
          minimum: 1
          title: Limit
          type: integer
      responses:
        '200':
          content:
            application/json:
              example: *id245
              schema:
                $ref: '#/components/schemas/JobListResponse'
          description: Successful Response
        '400':
          content:
            application/problem+json:
              example: *id169
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Bad Request
        '401':
          content:
            application/problem+json:
              example: *id170
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unauthorized
        '403':
          content:
            application/problem+json:
              example: *id171
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Forbidden
        '422':
          content:
            application/problem+json:
              example: *id172
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unprocessable Entity
        '500':
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Internal Server Error
        '503':
          content:
            application/problem+json:
              example: *id173
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Service Unavailable
        default:
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unexpected error, as RFC 9457 Problem Details.
      security:
      - BearerAuth: []
      - OAuth2: []
      summary: List Jobs
      tags:
      - Jobs
    summary: List Jobs
