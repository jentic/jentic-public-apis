      - OAuth2: []
      summary: Get an API revision
      tags:
      - APIs
    summary: Get an API revision; Delete an archived API revision
  /apis/{vendor}/{name}/{version}/revisions/{revision_id}/openapi:
    description: '`GET`: Download an API revision''s OpenAPI document.'
    get:
      description: |-
        Download the stored OpenAPI document of one revision.

        Choose the format with `Accept`: `application/json` (the default), or
        `application/openapi+yaml` / `application/yaml`; anything else returns
        406. The response carries `Content-Disposition: attachment` with a
        `.json` or `.yaml` filename. The document is served exactly as stored —
        a revision produced by confirming an overlay already includes it, so the
        `overlays` flag currently has no effect.
      operationId: getApiRevisionSpec
      parameters:
      - description: Vendor of the API.
        examples:
          example:
            summary: API vendor domain
            value: stripe.com
        in: path
        name: vendor
        required: true
        schema:
          description: Vendor of the API.
          examples:
          - stripe.com
          title: Vendor
          type: string
      - description: Name of the API.
        examples:
          example:
            summary: API name
            value: stripe
        in: path
        name: name
        required: true
        schema:
          description: Name of the API.
          examples:
          - stripe
          title: Name
          type: string
      - description: Version of the API.
        examples:
          example:
            summary: API version
            value: '2024-04-10'
        in: path
        name: version
        required: true
        schema:
          description: Version of the API.
          examples:
          - '2024-04-10'
          title: Version
          type: string
      - description: ID of the API revision.
        examples:
          example:
            summary: Revision ID (UUID)
            value: 3f2b8c1e-7d4a-4e9b-a6c5-1d2e3f4a5b6c
        in: path
        name: revision_id
        required: true
        schema:
          description: ID of the API revision.
          examples:
          - 3f2b8c1e-7d4a-4e9b-a6c5-1d2e3f4a5b6c
          title: Revision Id
          type: string
      - description: Reserved for applying overlays at read time; currently has no effect, as confirmed overlays are already part of the stored document.
        examples:
          example:
            summary: Example query value for `overlays`
            value: false
        in: query
        name: overlays
        required: false
        schema:
          default: true
          description: Reserved for applying overlays at read time; currently has no effect, as confirmed overlays are already part of the stored document.
          examples:
          - false
          title: Overlays
          type: boolean
      responses:
        '200':
          content:
            application/json:
              schema: {}
          description: Successful Response
        '400':
          content:
            application/problem+json:
              example: *id169
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Bad Request
        '401':
          content:
            application/problem+json:
              example: *id170
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unauthorized
        '403':
          content:
            application/problem+json:
              example: *id171
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Forbidden
        '422':
          content:
            application/problem+json:
              example: *id172
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unprocessable Entity
        '500':
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Internal Server Error
        '503':
          content:
            application/problem+json:
              example: *id173
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Service Unavailable
        default:
          content:
            application/problem+json:
              example: *id166
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Unexpected error, as RFC 9457 Problem Details.
      security:
      - BearerAuth: []
      - OAuth2: []
      summary: Download an API revision's OpenAPI document
      tags:
      - API Spec
    summary: Download an API revision's OpenAPI document
  /apis/{vendor}/{name}/{version}/revisions/{revision_id}/operations:
    description: '`GET`: List the operations in an API revision.'
    get:
      description: |-
        List every operation in one specific revision, live or not.

        Same rows, ordering and cursor pagination as the live-revision listing,
        but for the named revision, so you can review a draft before promoting
        it or compare against an archived one. Follow each row's `inspect` link
        for full detail. 404 if the API or revision does not exist.
      operationId: listApiRevisionOperations
      parameters:
      - description: Vendor of the API.
        examples:
          example:
            summary: API vendor domain
            value: stripe.com
        in: path
        name: vendor
        required: true
        schema:
          description: Vendor of the API.
          examples:
          - stripe.com
          title: Vendor
          type: string
      - description: Name of the API.
        examples:
          example:
            summary: API name
            value: stripe
        in: path
        name: name
        required: true
        schema:
          description: Name of the API.
          examples:
          - stripe
          title: Name
          type: string
      - description: Version of the API.
        examples:
          example:
            summary: API version
            value: '2024-04-10'
        in: path
        name: version
        required: true
        schema:
          description: Version of the API.
          examples:
          - '2024-04-10'
          title: Version
          type: string
      - description: ID of the API revision.
        examples:
          example:
            summary: Revision ID (UUID)
            value: 3f2b8c1e-7d4a-4e9b-a6c5-1d2e3f4a5b6c
        in: path
        name: revision_id
        required: true
        schema:
          description: ID of the API revision.
          examples:
          - 3f2b8c1e-7d4a-4e9b-a6c5-1d2e3f4a5b6c
          title: Revision Id
          type: string
      - description: Opaque cursor from a previous page's `next_cursor`; omit for the first page.
        examples:
          example:
            summary: Opaque cursor from a previous page
            value: eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
        in: query
        name: cursor
        required: false
        schema:
          anyOf:
          - examples:
            - eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
            type: string
          - type: 'null'
          description: Opaque cursor from a previous page's `next_cursor`; omit for the first page.
          examples:
          - eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
          title: Cursor
      - description: Maximum number of operations to return (1-200).
        examples:
          example:
            summary: Example query value for `limit`
            value: 25
        in: query
        name: limit
        required: false
        schema:
          default: 50
          description: Maximum number of operations to return (1-200).
          examples:
          - 25
          maximum: 200
          minimum: 1
          title: Limit
          type: integer
      responses:
        '200':
          content:
            application/json:
              schema: {}
          description: Successful Response
        '400':
          content:
