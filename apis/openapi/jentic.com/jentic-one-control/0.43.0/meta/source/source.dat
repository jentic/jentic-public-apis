    description: '`POST`: Approve OAuth client.'
    post:
      description: |-
        Approve an OAuth client — sets approval_status=approved and active=true.

        Also re-approves a previously denied client (deny is reversible; rows are
        never deleted, so the client's cached client_id becomes valid again).
      operationId: approveOauthClient
      parameters:
      - description: Record ID of the OAuth client (`oac_…`), not its public `client_id`.
        examples:
          example:
            summary: OAuth client record ID
            value: oac_6968b39840a935d9f7e2714b
        in: path
        name: id
        required: true
        schema:
          description: Record ID of the OAuth client (`oac_…`), not its public `client_id`.
          examples:
          - oac_6968b39840a935d9f7e2714b
          title: Id
          type: string
      responses:
        '200':
          content:
            application/json:
              example: *id093
              schema:
                $ref: '#/components/schemas/OAuthClientResponse'
          description: Successful Response
        '400':
          content:
            application/problem+json:
              example: *id169
              schema:
                $ref: '#/components/schemas/ProblemDetail'
          description: Bad Request
        '401':
          content:
            application/problem+json:
              example: *id170
              schema:
