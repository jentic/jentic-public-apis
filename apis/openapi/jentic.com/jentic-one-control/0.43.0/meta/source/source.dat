  /oauth-app-registrations:
    description: '`POST`: Register a shared OAuth application. `GET`: List OAuth app registrations.'
    get:
      description: |-
        List OAuth application registrations with cursor-based pagination.

        Admin-only: the full view carries endpoints, ``created_by``, inactive
        rows and org-wide dependent-credential counts. Non-admins discover the
        shared apps they can connect through via ``GET /vendors``.
      operationId: listOauthAppRegistrations
      parameters:
      - description: Filter by vendor slug.
        examples:
          example:
            summary: Vendor registry key
            value: github
        in: query
        name: api_vendor
        required: false
        schema:
          anyOf:
          - examples:
            - github
            type: string
          - type: 'null'
          description: Filter by vendor slug.
          examples:
          - github
          title: Api Vendor
      - description: Include registrations with is_active=false in the response.
        examples:
          example:
            summary: Example query value for `include_inactive`
            value: true
        in: query
        name: include_inactive
        required: false
        schema:
          default: false
          description: Include registrations with is_active=false in the response.
          examples:
          - true
          title: Include Inactive
          type: boolean
      - description: Filter by OAuth flow kind.
        examples:
          example:
            summary: Example query value for `flow_kind`
            value: authorization_code
        in: query
        name: flow_kind
        required: false
        schema:
          anyOf:
          - $ref: '#/components/schemas/OAuthAppRegistrationFlowKind'
          - type: 'null'
          description: Filter by OAuth flow kind.
          examples:
          - authorization_code
          title: Flow Kind
      - description: Opaque cursor from a previous page's next_cursor; omit for the first page.
        examples:
          example:
            summary: Opaque cursor from a previous page
            value: eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
        in: query
        name: cursor
        required: false
        schema:
          anyOf:
          - examples:
            - eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
            type: string
          - type: 'null'
          description: Opaque cursor from a previous page's next_cursor; omit for the first page.
          examples:
          - eyJ0IjogIjIwMjYtMDEtMTVUMDk6MzA6MDArMDA6MDAiLCAiaWQiOiAiM2YyYjhjMWUtN2Q0YS00ZTliLWE2YzUtMWQyZTNmNGE1YjZjIn0=
          title: Cursor
      - description: Maximum number of registrations to return (1-200, default 50).
        examples:
          example:
            summary: Example query value for `limit`
            value: 25
        in: query
        name: limit
        required: false
        schema:
          default: 50
          description: Maximum number of registrations to return (1-200, default 50).
          examples:
          - 25
          maximum: 200
          minimum: 1
          title: Limit
          type: integer
      responses:
        '200':
          content:
            application/json:
              example: *id253
              schema:
                $ref: '#/components/schemas/OAuthAppRegistrationListResponse'
