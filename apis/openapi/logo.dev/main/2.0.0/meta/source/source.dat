                    "value": {
                      "error": "Use Content-Type: application/json"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "A rate limit applies. Wait for `Retry-After` before you send the request again.\n\n- The daily allowance is spent. The response has the usage headers, and `Retry-After` counts the seconds to the next midnight UTC.\n- More than 60 requests in one minute. The response has `Retry-After` and no usage headers.",
            "content": {
