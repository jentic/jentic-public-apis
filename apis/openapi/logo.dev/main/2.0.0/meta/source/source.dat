          },
          {
            "lang": "javascript",
            "label": "By domain",
            "source": "const res = await fetch(\"https://api.logo.dev/v2/brands?domain=stripe.com\", {\n  headers: { Authorization: `Bearer ${process.env.LOGO_DEV_SECRET_KEY}` },\n});\nconst { data, metadata } = await res.json();"
          },
          {
            "lang": "javascript",
            "label": "By ticker",
            "source": "const res = await fetch(\"https://api.logo.dev/v2/brands?ticker=AAPL\", {\n  headers: { Authorization: `Bearer ${process.env.LOGO_DEV_SECRET_KEY}` },\n});\nconst { data, metadata } = await res.json();"
          },
          {
