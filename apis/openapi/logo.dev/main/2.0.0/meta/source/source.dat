            "label": "By ISIN",
            "source": "const res = await fetch(\"https://api.logo.dev/v2/brands?isin=US0378331005\", {\n  headers: { Authorization: `Bearer ${process.env.LOGO_DEV_SECRET_KEY}` },\n});\nconst { data, metadata } = await res.json();"
          },
          {
            "lang": "javascript",
            "label": "By crypto",
            "source": "const res = await fetch(\"https://api.logo.dev/v2/brands?crypto=BTC\", {\n  headers: { Authorization: `Bearer ${process.env.LOGO_DEV_SECRET_KEY}` },\n});\nconst { data, metadata } = await res.json();"
          },
          {
            "lang": "javascript",
            "label": "By name",
            "source": "const res = await fetch(\"https://api.logo.dev/v2/brands?name=Stripe\", {\n  headers: { Authorization: `Bearer ${process.env.LOGO_DEV_SECRET_KEY}` },\n});\nconst { data, metadata } = await res.json();"
          },
          {
            "lang": "python",
            "label": "By domain",
            "source": "import os, requests\n\nres = requests.get(\n    \"https://api.logo.dev/v2/brands\",\n    params={\"domain\": \"stripe.com\"},\n    headers={\"Authorization\": f\"Bearer {os.environ['LOGO_DEV_SECRET_KEY']}\"},\n)\ndata = res.json()[\"data\"]"
          },
          {
            "lang": "python",
            "label": "By ticker",
            "source": "import os, requests\n\nres = requests.get(\n    \"https://api.logo.dev/v2/brands\",\n    params={\"ticker\": \"AAPL\"},\n    headers={\"Authorization\": f\"Bearer {os.environ['LOGO_DEV_SECRET_KEY']}\"},\n)\ndata = res.json()[\"data\"]"
