            "label": "By crypto",
            "source": "curl --header \"Authorization: Bearer $LOGO_DEV_SECRET_KEY\" \\\n  \"https://api.logo.dev/v2/brands/brandmark?crypto=BTC\""
          },
          {
            "lang": "bash",
            "label": "By name",
            "source": "curl --header \"Authorization: Bearer $LOGO_DEV_SECRET_KEY\" \\\n  \"https://api.logo.dev/v2/brands/brandmark?name=Stripe\""
          },
          {
            "lang": "javascript",
            "label": "By domain",
            "source": "const res = await fetch(\"https://api.logo.dev/v2/brands/brandmark?domain=stripe.com\", {\n  headers: { Authorization: `Bearer ${process.env.LOGO_DEV_SECRET_KEY}` },\n});\nconst { data, metadata } = await res.json();"
          },
          {
            "lang": "javascript",
            "label": "By ticker",
            "source": "const res = await fetch(\"https://api.logo.dev/v2/brands/brandmark?ticker=AAPL\", {\n  headers: { Authorization: `Bearer ${process.env.LOGO_DEV_SECRET_KEY}` },\n});\nconst { data, metadata } = await res.json();"
          },
          {
            "lang": "javascript",
            "label": "By ISIN",
            "source": "const res = await fetch(\"https://api.logo.dev/v2/brands/brandmark?isin=US0378331005\", {\n  headers: { Authorization: `Bearer ${process.env.LOGO_DEV_SECRET_KEY}` },\n});\nconst { data, metadata } = await res.json();"
          },
          {
            "lang": "javascript",
            "label": "By crypto",
            "source": "const res = await fetch(\"https://api.logo.dev/v2/brands/brandmark?crypto=BTC\", {\n  headers: { Authorization: `Bearer ${process.env.LOGO_DEV_SECRET_KEY}` },\n});\nconst { data, metadata } = await res.json();"
          },
          {
            "lang": "javascript",
            "label": "By name",
            "source": "const res = await fetch(\"https://api.logo.dev/v2/brands/brandmark?name=Stripe\", {\n  headers: { Authorization: `Bearer ${process.env.LOGO_DEV_SECRET_KEY}` },\n});\nconst { data, metadata } = await res.json();"
          },
          {
            "lang": "python",
            "label": "By domain",
            "source": "import os, requests\n\nres = requests.get(\n    \"https://api.logo.dev/v2/brands/brandmark\",\n    params={\"domain\": \"stripe.com\"},\n    headers={\"Authorization\": f\"Bearer {os.environ['LOGO_DEV_SECRET_KEY']}\"},\n)\ndata = res.json()[\"data\"]"
          },
          {
            "lang": "python",
            "label": "By ticker",
            "source": "import os, requests\n\nres = requests.get(\n    \"https://api.logo.dev/v2/brands/brandmark\",\n    params={\"ticker\": \"AAPL\"},\n    headers={\"Authorization\": f\"Bearer {os.environ['LOGO_DEV_SECRET_KEY']}\"},\n)\ndata = res.json()[\"data\"]"
          },
          {
            "lang": "python",
            "label": "By ISIN",
            "source": "import os, requests\n\nres = requests.get(\n    \"https://api.logo.dev/v2/brands/brandmark\",\n    params={\"isin\": \"US0378331005\"},\n    headers={\"Authorization\": f\"Bearer {os.environ['LOGO_DEV_SECRET_KEY']}\"},\n)\ndata = res.json()[\"data\"]"
          },
          {
            "lang": "python",
            "label": "By crypto",
            "source": "import os, requests\n\nres = requests.get(\n    \"https://api.logo.dev/v2/brands/brandmark\",\n    params={\"crypto\": \"BTC\"},\n    headers={\"Authorization\": f\"Bearer {os.environ['LOGO_DEV_SECRET_KEY']}\"},\n)\ndata = res.json()[\"data\"]"
          },
          {
            "lang": "python",
            "label": "By name",
            "source": "import os, requests\n\nres = requests.get(\n    \"https://api.logo.dev/v2/brands/brandmark\",\n    params={\"name\": \"Stripe\"},\n    headers={\"Authorization\": f\"Bearer {os.environ['LOGO_DEV_SECRET_KEY']}\"},\n)\ndata = res.json()[\"data\"]"
          }
        ]
      }
    },
    "/v2/search": {
      "get": {
        "tags": [
          "Search"
        ],
        "summary": "Search brands",
        "description": "Finds brands by name and returns candidates with their domain and logo URL. `match` searches full names and aliases; `typeahead` completes a prefix as someone types. Costs API credits on every request, at the rate in [API credits](/platform/credits#what-each-request-costs). Follow up with [Look up a brand](/api-reference/brands/look-up-a-brand) for the full profile.",
        "operationId": "v2SearchBrands",
        "x-mint": {
          "metadata": {
            "description": "Search brands by name, with match or typeahead ranking, and get each candidate's domain and logo URL.",
            "tag": "1 credit / 1,000 searches"
          },
          "content": "<Card title=\"Get your API keys\" icon=\"key\" href=\"https://www.logo.dev/dashboard/api-keys\" horizontal arrow>\n  Your dashboard has a publishable key for the Logo.dev CDN and a secret key for the Logo.dev API. Every plan includes both.\n</Card>"
        },
        "security": [
          {
            "secretKey": []
          }
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "The name to search for.",
            "schema": {
              "type": "string",
              "examples": [
                "sweetgreen"
              ]
            }
          },
          {
            "name": "method",
            "in": "query",
            "required": false,
            "description": "`match` for full names, `typeahead` for partial input.",
            "schema": {
              "type": "string",
              "enum": [
                "match",
                "typeahead"
              ],
              "default": "match"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Results to return.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 25,
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching brands, best first. An empty array when nothing matches.",
            "headers": {
              "Request-Id": {
                "$ref": "#/components/headers/V2RequestId"
              },
              "Credits-Charged": {
                "$ref": "#/components/headers/V2CreditsCharged"
              },
              "Credits-Remaining": {
                "$ref": "#/components/headers/V2CreditsRemaining"
              },
              "RateLimit-Limit": {
                "$ref": "#/components/headers/V2SearchRateLimitLimit"
              },
              "RateLimit-Remaining": {
                "$ref": "#/components/headers/V2SearchRateLimitRemaining"
              },
              "RateLimit-Reset": {
                "$ref": "#/components/headers/V2SearchRateLimitReset"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/V2SearchResult"
                      }
                    },
                    "metadata": {
                      "$ref": "#/components/schemas/V2Metadata"
                    }
                  },
                  "required": [
                    "data",
                    "metadata"
                  ]
                },
                "example": {
                  "data": [
                    {
                      "object": "search_result",
                      "name": "Sweetgreen",
                      "domain": "sweetgreen.com",
                      "logo_url": "https://img.logo.dev/sweetgreen.com?token=LOGO_DEV_PUBLISHABLE_KEY"
                    }
                  ],
                  "metadata": {
                    "request_id": "request_01k6z8m2a4b5c6d7e8f9g0h1j2"
                  }
                }
              }
            }
          },
          "400": {
            "description": "`q` is missing, or `method` or `limit` is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V2Error"
                },
                "example": {
                  "error": {
                    "code": "invalid_request",
                    "message": "q is required",
                    "target": "q"
                  },
                  "docs_url": "https://www.logo.dev/docs/platform/errors"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/V2Unauthorized"
          },
          "402": {
            "$ref": "#/components/responses/V2SearchPaymentRequired"
          },
          "429": {
            "$ref": "#/components/responses/V2SearchRateLimited"
          },
          "500": {
            "description": "Search failed. Retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V2Error"
                },
                "example": {
                  "error": {
                    "code": "internal",
                    "message": "failed to search"
                  },
                  "docs_url": "https://www.logo.dev/docs/platform/errors"
                }
              }
            },
            "headers": {
              "RateLimit-Limit": {
                "$ref": "#/components/headers/V2SearchRateLimitLimit"
              },
              "RateLimit-Remaining": {
                "$ref": "#/components/headers/V2SearchRateLimitRemaining"
              },
              "RateLimit-Reset": {
                "$ref": "#/components/headers/V2SearchRateLimitReset"
              }
            }
          }
        }
      }
    },
    "/v2/brands/{id}/subscription": {
      "get": {
        "tags": [
          "Subscriptions"
        ],
        "summary": "Get a brand subscription",
        "description": "Returns your account's subscription to this brand, if there is one. Subscriptions decide which brands send you `brand.updated` events.",
        "operationId": "v2GetBrandSubscription",
        "x-mint": {
          "metadata": {
            "description": "Check whether your account is subscribed to a brand's update events."
          },
          "content": "<Card title=\"Get your API keys\" icon=\"key\" href=\"https://www.logo.dev/dashboard/api-keys\" horizontal arrow>\n  Your dashboard has a publishable key for the Logo.dev CDN and a secret key for the Logo.dev API. Every plan includes both.\n</Card>"
        },
        "security": [
          {
            "secretKey": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/V2BrandIdPath"
          }
        ],
        "responses": {
          "200": {
            "description": "The subscription.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/V2Subscription"
                    },
                    "metadata": {
                      "$ref": "#/components/schemas/V2Metadata"
                    }
                  },
                  "required": [
                    "data",
                    "metadata"
                  ]
                },
                "example": {
                  "data": {
                    "object": "subscription",
                    "id": "sub_7m2k9q4r8t0v1w3x5y6z8a9b0c",
                    "brand_id": "brand_4x0wr3g0000g00400000000004",
                    "created_at": "2026-09-21T12:00:00Z"
                  },
                  "metadata": {
                    "request_id": "request_01k6z8m2a4b5c6d7e8f9g0h1j2"
                  }
                }
              }
            }
          },
          "400": {
            "description": "The brand id is malformed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V2Error"
                },
                "example": {
                  "error": {
                    "code": "invalid_request",
                    "message": "id must start with \"brand_\": bad format",
                    "target": "id"
                  },
                  "docs_url": "https://www.logo.dev/docs/platform/errors"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/V2Unauthorized"
          },
          "404": {
            "description": "You are not subscribed to this brand.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V2Error"
                },
                "example": {
                  "error": {
                    "code": "resource_missing",
                    "message": "no subscription for this brand",
                    "target": "id"
                  },
                  "docs_url": "https://www.logo.dev/docs/platform/errors"
                }
              }
            }
          },
          "500": {
            "description": "Reading the subscription failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/V2Error"
                },
                "example": {
                  "error": {
                    "code": "internal",
                    "message": "failed to read subscription"
                  },
                  "docs_url": "https://www.logo.dev/docs/platform/errors"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Subscriptions"
        ],
        "summary": "Subscribe to a brand",
        "description": "Subscribes your account to `brand.updated` events for this brand. Safe to repeat: it returns `201` the first time and `200` after that, with the same body. Needs a paid plan. See [Who can use webhooks](/webhooks#who-can-use-webhooks).",
        "operationId": "v2SubscribeToBrand",
