    "/v2/brands": {
      "get": {
        "tags": [
          "Brands"
        ],
        "summary": "Look up a brand",
        "description": "Returns a brand's profile from one identifier: a domain, ticker, ISIN, crypto symbol, or name. Send exactly one. A brand Logo.dev has not indexed yet returns `202` while it is fetched; retry after 30 seconds. Costs API credits at the rate in [API credits](/platform/credits#what-each-request-costs). Billed once per brand domain per 24 hours, and only when the brand is ready. Merchant descriptors are not accepted yet.",
        "operationId": "v2GetBrand",
        "x-mint": {
          "metadata": {
            "description": "Look up a brand by domain, ticker, ISIN, crypto symbol, or name and get its name, colors, socials, logo, and brandmark.",
            "tag": "5 credits"
          },
          "content": "<Card title=\"Get your API keys\" icon=\"key\" href=\"https://www.logo.dev/dashboard/api-keys\" horizontal arrow>\n  Your dashboard has a publishable key for the Logo.dev CDN and a secret key for the Logo.dev API. Every plan includes both.\n</Card>"
        },
        "security": [
          {
            "secretKey": []
          }
        ],
        "parameters": [
