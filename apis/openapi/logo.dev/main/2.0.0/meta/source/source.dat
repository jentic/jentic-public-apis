                    "created_at": "2026-09-21T12:00:00Z"
                  },
                  "metadata": {
                    "request_id": "request_01k6z8m2a4b5c6d7e8f9g0h1j2"
                  }
                }
              }
            }
          },
          "201": {
            "description": "The subscription was created.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/V2Subscription"
                    },
                    "metadata": {
                      "$ref": "#/components/schemas/V2Metadata"
                    }
                  },
                  "required": [
                    "data",
                    "metadata"
                  ]
                },
                "example": {
                  "data": {
                    "object": "subscription",
                    "id": "sub_7m2k9q4r8t0v1w3x5y6z8a9b0c",
                    "brand_id": "brand_4x0wr3g0000g00400000000004",
                    "created_at": "2026-09-21T12:00:00Z"
                  },
                  "metadata": {
                    "request_id": "request_01k6z8m2a4b5c6d7e8f9g0h1j2"
                  }
                }
              }
            }
