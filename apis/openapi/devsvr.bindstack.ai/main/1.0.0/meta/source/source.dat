{
  "openapi": "3.1.0",
  "info": {
    "title": "RAG Query Bindstack",
    "description": "RAG Query Bindstack",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/bindstack/bindstack-external-api/1.0.0"
  },
  "paths": {
    "/v1/external/rag/query": {
      "post": {
        "summary": "Query to RAG Bindstack",
        "description": "Submit a query to the RAG system and retrieve relevant results",
        "parameters": [
          {
            "name": "X-API-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "bsk_live_DfpamfEePdn4PXDlE-LQlOqBxIh-rMB-h3ugEVb8d40"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "meeting_code",
                  "query"
                ],
                "properties": {
                  "meeting_code": {
                    "type": "string",
                    "example": "MTG-TUR7-WGK4"
                  },
                  "query": {
                    "type": "string",
                    "example": "are they have vs code ?"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful RAG query response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 200
                    },
                    "message": {
                      "type": "string",
                      "example": "Found 5 relevant results"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "meeting_code": {
                          "type": "string",
                          "example": "MTG-TUR7-WGK4"
                        },
                        "meeting_title": {
                          "type": "string",
                          "example": "Untitled Meeting"
                        },
                        "query": {
                          "type": "string",
                          "example": "are they have vs code ?"
                        },
                        "total_results": {
                          "type": "integer",
                          "example": 5
                        },
                        "results": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "content": {
                                "type": "string"
                              },
                              "similarity": {
                                "type": "number",
                                "format": "float"
                              },
                              "source_type": {
                                "type": "string",
                                "example": "transcript"
                              },
                              "source_id": {
                                "type": "string",
                                "format": "uuid"
                              },
                              "chunk_index": {
                                "type": "integer"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "code": 200,
                  "message": "Found 5 relevant results",
                  "data": {
                    "meeting_code": "MTG-TUR7-WGK4",
                    "meeting_title": "Untitled Meeting",
                    "query": "are they have vs code ?",
                    "total_results": 5,
                    "results": [
                      {
                        "content": "[Transcript - 361f46f6-7090-450c-b739-4792eacc5bc7.mp3] ...",
                        "similarity": 0.3060612,
                        "source_type": "transcript",
                        "source_id": "8951e5f0-fce1-4bc0-8dab-a9c03a7d6e3e",
                        "chunk_index": 5
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "security": []
      }
    }
  },
  "servers": [
    {
      "url": "https://devsvr.bindstack.ai/api/",
      "description": "Testing Env"
    }
  ]
}
