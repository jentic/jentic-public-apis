  /commission-reports:
    get:
      tags:
        - PayDesk
      summary: List commission reports
      description: >-
        Returns the saved commission report snapshots - the documents generated in
        PayDesk for a date window, newest first. Summary figures only; the frozen
        per-appointment rows are not returned by this endpoint. Read-only.
        Requires scope: paydesk:read.
      operationId: listCommissionReports
      parameters:
        - $ref: '#/components/parameters/Limit'
        - $ref: '#/components/parameters/StartingAfter'
        - name: from
          in: query
          required: false
          description: >-
            Return only reports GENERATED on or after this date. Accepts an
            ISO-8601 date (2026-06-01, snapped to the start of the UTC day) or a
            full timestamp. Mutually exclusive with period_from / period_to.
          schema:
            type: string
            format: date-time
        - name: to
          in: query
          required: false
          description: >-
            Return only reports GENERATED on or before this date. Accepts an
            ISO-8601 date (2026-06-30, snapped to the end of the UTC day) or a
            full timestamp. Mutually exclusive with period_from / period_to.
          schema:
            type: string
            format: date-time
        - name: period_from
          in: query
          required: false
          description: >-
            Return only reports whose COVERED period starts on or after this date.
            Results are ordered by covered-period start, newest first. Mutually
            exclusive with from / to - combining them returns 400
            (code conflicting_filters).
          schema:
            type: string
            format: date-time
        - name: period_to
          in: query
          required: false
          description: >-
            Return only reports whose COVERED period starts on or before this
            date. Mutually exclusive with from / to.
          schema:
            type: string
            format: date-time
      responses:
        '200':
          description: A paginated list of commission reports, newest first.
          content:
            application/json:
              schema:
                type: object
                properties:
                  object:
                    type: string
                    example: list
                  data:
                    type: array
                    items:
                      $ref: '#/components/schemas/CommissionReport'
                  has_more:
                    type: boolean
                  next_cursor:
                    type: string
                    nullable: true
        '400':
          $ref: '#/components/responses/BadRequest'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '402':
          $ref: '#/components/responses/PaymentRequired'
        '403':
          $ref: '#/components/responses/Forbidden'
        '429':
          $ref: '#/components/responses/TooManyRequests'
        '500':
          $ref: '#/components/responses/ServerError'

  /commission-reports/{id}:
    get:
      tags:
        - PayDesk
      summary: Retrieve a commission report
      description: >-
        Returns one saved commission report - the same summary the list returns,
        plus one row per group (team member, external, vendor, company or the
        organization, depending on groupBy). A report belonging to another
        organization returns 404 rather than 403. Requires scope: paydesk:read.
      operationId: getCommissionReport
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: string
      responses:
        '200':
          description: The requested commission report.
          content:
            application/json:
              schema:
                type: object
                properties:
                  data:
                    $ref: '#/components/schemas/CommissionReportDetail'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '402':
          $ref: '#/components/responses/PaymentRequired'
        '403':
          $ref: '#/components/responses/Forbidden'
        '404':
          $ref: '#/components/responses/NotFound'
        '429':
          $ref: '#/components/responses/TooManyRequests'
        '500':
          $ref: '#/components/responses/ServerError'

  /commission-reports/{id}/image:
    get:
      tags:
        - PayDesk
      summary: Render a commission report as a PNG
      description: >-
        Renders the report's summary page - hero total, stat tiles and both
        donut charts - as a PNG sized for a phone screen, so it can be posted
        straight into a chat or messaging channel. It is the same branded document
        the PDF export produces, cropped to its first page; the per-team sections
        and money-view tables are omitted.


        By default the image is returned base64-encoded inside the normal data
        envelope, because messaging APIs need either base64 or a publicly
        fetchable URL and this endpoint is bearer-authenticated. Pass format=png
        for the raw image/png bytes. Requires scope: paydesk:read.
      operationId: getCommissionReportImage
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: string
        - name: width
          in: query
          required: false
          description: >-
            Output width in pixels (540-2160, default 1080). The layout is fixed;
            this only changes the resolution it is rasterized at.
          schema:
            type: integer
            minimum: 540
            maximum: 2160
            default: 1080
        - name: format
          in: query
          required: false
          description: >-
            json (default) returns the base64 envelope; png returns raw image/png
            bytes.
          schema:
            type: string
            enum:
              - json
              - png
            default: json
      responses:
        '200':
          description: The rendered report image.
          content:
            application/json:
              schema:
                type: object
                properties:
                  data:
                    $ref: '#/components/schemas/CommissionReportImage'
            image/png:
              schema:
                type: string
                format: binary
        '400':
          $ref: '#/components/responses/BadRequest'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '402':
          $ref: '#/components/responses/PaymentRequired'
        '403':
          $ref: '#/components/responses/Forbidden'
        '404':
          $ref: '#/components/responses/NotFound'
        '429':
          $ref: '#/components/responses/TooManyRequests'
        '500':
          $ref: '#/components/responses/ServerError'

  /paydesk-pay-periods/{id}:
    get:
      tags:
        - PayDesk
      summary: Retrieve a pay period
      description: >-
        Returns a single pay period by id. A record belonging to another organization
        returns 404 rather than 403. Requires scope: paydesk:read.
      operationId: getPayPeriod
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: string
      responses:
        '200':
          description: The requested pay period.
          content:
            application/json:
              schema:
                type: object
                properties:
                  data:
                    $ref: '#/components/schemas/PayPeriod'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '402':
          $ref: '#/components/responses/PaymentRequired'
        '403':
          $ref: '#/components/responses/Forbidden'
        '404':
          $ref: '#/components/responses/NotFound'
        '429':
          $ref: '#/components/responses/TooManyRequests'
        '500':
          $ref: '#/components/responses/ServerError'
  /webhook-endpoints:
    get:
      tags:
        - Webhooks
      summary: List webhook endpoints
      description: >-
        Returns every webhook endpoint configured for your organization, newest
        first. Endpoints are capped at 10 per organization (the cap is shared
        with endpoints created in the app under Settings > Developer >
        Webhooks), so the list is never paginated - has_more is always false.
        The signing secret is MASKED in this response (whsec_...ab12); the full
        secret is returned only once, in the 201 response that created the
        endpoint. Requires scope: webhooks:read.
      operationId: listWebhookEndpoints
      responses:
        '200':
          description: All webhook endpoints for the organization.
          content:
            application/json:
              schema:
                type: object
                properties:
                  object:
                    type: string
                    example: list
                  data:
                    type: array
                    items:
                      $ref: '#/components/schemas/WebhookEndpoint'
                  has_more:
                    type: boolean
                    example: false
                  next_cursor:
                    type: string
                    nullable: true
                    example: null
        '401':
          $ref: '#/components/responses/Unauthorized'
        '402':
          $ref: '#/components/responses/PaymentRequired'
        '403':
          $ref: '#/components/responses/Forbidden'
        '429':
          $ref: '#/components/responses/TooManyRequests'
        '500':
          $ref: '#/components/responses/ServerError'
    post:
      tags:
        - Webhooks
      summary: Create a webhook endpoint
      description: >-
        Subscribes an HTTPS URL to one or more event types (or ["*"] for all
        events). This is the subscribe half of the REST-hook pattern
        integration platforms use: POST the target URL plus the events, store
        the returned id and secret, and DELETE the endpoint to unsubscribe.


        The 201 response is the ONLY response that carries the endpoint's full
        signing secret (whsec_...) - store it immediately; every later read
        returns it masked. Use the secret to verify the X-Genaya-Signature
        header on deliveries (t=unix,v1=hex HMAC-SHA256 of "t.rawBody").


        URLs must be https (plaintext http, private/internal addresses, and
        embedded credentials are rejected with code invalid_url). Unknown event
        types are rejected with code unknown_event - fetch the catalog from GET
        /v1/webhook-endpoints/events. Creating an endpoint past the 10-per-org
        cap returns 400 with code endpoint_limit. Supports the Idempotency-Key
        header for safe retries. Requires scope: webhooks:write.
      operationId: createWebhookEndpoint
      parameters:
        - $ref: '#/components/parameters/IdempotencyKey'
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/WebhookEndpointCreate'
      responses:
        '201':
          description: >-
            The created endpoint, with the full signing secret. This is the only
            time the secret is returned unmasked.
          content:
            application/json:
              schema:
                type: object
                properties:
                  data:
                    $ref: '#/components/schemas/WebhookEndpoint'
        '400':
          $ref: '#/components/responses/BadRequest'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '402':
          $ref: '#/components/responses/PaymentRequired'
        '403':
          $ref: '#/components/responses/Forbidden'
        '409':
          $ref: '#/components/responses/Conflict'
        '429':
          $ref: '#/components/responses/TooManyRequests'
        '500':
          $ref: '#/components/responses/ServerError'

  /webhook-endpoints/events:
    get:
      tags:
        - Webhooks
      summary: List webhook event types
      description: >-
        Returns the machine-readable catalog of event types an endpoint can
        subscribe to, so an integration can present the list without hardcoding
        it. New event types may be added over time - treat unrecognized types as
        ignorable rather than as errors. (The "Send test event" button in
        Settings > Developer > Webhooks also delivers a synthetic ping event
        that is not part of this catalog.) Requires scope: webhooks:read.
      operationId: listWebhookEventTypes
      responses:
        '200':
          description: The event type catalog.
          content:
            application/json:
              schema:
                type: object
                properties:
                  object:
                    type: string
                    example: list
                  data:
                    type: array
                    items:
                      $ref: '#/components/schemas/WebhookEventType'
                  has_more:
                    type: boolean
                    example: false
                  next_cursor:
                    type: string
                    nullable: true
                    example: null
        '401':
          $ref: '#/components/responses/Unauthorized'
        '402':
          $ref: '#/components/responses/PaymentRequired'
        '403':
          $ref: '#/components/responses/Forbidden'
        '429':
          $ref: '#/components/responses/TooManyRequests'
        '500':
          $ref: '#/components/responses/ServerError'

  /webhook-endpoints/{id}:
    get:
      tags:
        - Webhooks
      summary: Retrieve a webhook endpoint
      description: >-
        Returns a single webhook endpoint by id. The signing secret is masked -
        it is returned in full only in the create response. An endpoint
        belonging to another organization returns 404 rather than 403, so this
        can never confirm cross-tenant existence. Requires scope: webhooks:read.
      operationId: getWebhookEndpoint
      parameters:
        - name: id
          in: path
          required: true
          description: The webhook endpoint id.
          schema:
            type: string
      responses:
        '200':
          description: The requested webhook endpoint (secret masked).
          content:
            application/json:
              schema:
                type: object
                properties:
                  data:
                    $ref: '#/components/schemas/WebhookEndpoint'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '402':
          $ref: '#/components/responses/PaymentRequired'
        '403':
          $ref: '#/components/responses/Forbidden'
        '404':
          $ref: '#/components/responses/NotFound'
        '429':
          $ref: '#/components/responses/TooManyRequests'
        '500':
          $ref: '#/components/responses/ServerError'
    patch:
      tags:
        - Webhooks
      summary: Update a webhook endpoint
      description: >-
        Updates the URL, subscribed events, description, or status of an
        endpoint. Only provided fields are changed. Setting status to "enabled"
        also resets the endpoint's consecutive-failure streak, which is how you
        revive an endpoint that was automatically paused (status
        "auto_disabled") after repeated dead deliveries. The signing secret
        cannot be changed or re-revealed - delete the endpoint and create a new
        one to rotate it. Ownership is verified before the write, so an
        endpoint belonging to another organization returns 404. Requires scope:
        webhooks:write.
      operationId: updateWebhookEndpoint
      parameters:
        - name: id
          in: path
          required: true
          description: The webhook endpoint id.
          schema:
            type: string
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/WebhookEndpointUpdate'
      responses:
        '200':
          description: The updated webhook endpoint (secret masked).
          content:
            application/json:
              schema:
                type: object
                properties:
                  data:
                    $ref: '#/components/schemas/WebhookEndpoint'
        '400':
          $ref: '#/components/responses/BadRequest'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '402':
          $ref: '#/components/responses/PaymentRequired'
        '403':
          $ref: '#/components/responses/Forbidden'
        '404':
          $ref: '#/components/responses/NotFound'
        '429':
          $ref: '#/components/responses/TooManyRequests'
        '500':
          $ref: '#/components/responses/ServerError'
    delete:
      tags:
        - Webhooks
      summary: Delete a webhook endpoint
      description: >-
        Deletes a webhook endpoint and stops all future deliveries to it. This
        is the unsubscribe half of the REST-hook pattern. Requires scope:
        webhooks:write.
      operationId: deleteWebhookEndpoint
      parameters:
        - name: id
          in: path
          required: true
          description: The webhook endpoint id.
          schema:
            type: string
      responses:
        '200':
          description: The endpoint was deleted.
          content:
            application/json:
              schema:
                type: object
                properties:
                  data:
                    $ref: '#/components/schemas/WebhookEndpointDeleted'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '402':
          $ref: '#/components/responses/PaymentRequired'
        '403':
          $ref: '#/components/responses/Forbidden'
        '404':
          $ref: '#/components/responses/NotFound'
        '429':
          $ref: '#/components/responses/TooManyRequests'
        '500':
          $ref: '#/components/responses/ServerError'
  /team:
    get:
      tags:
