{
  "openapi": "3.0.3",
  "info": {
    "title": "FALAI Funnels API",
    "description": "API completa para gerenciamento de funis de vendas, etapas, itens e membros do sistema FALAI.",
    "version": "1.0.0",
    "contact": {
      "name": "FALAI Support",
      "url": "https://falaiatendimento.com"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/falaiatendimento/Falai-Funil-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://chat.falaiatendimento.com/api/v1",
      "description": "Servidor de Produção"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "tags": [
    {
      "name": "Funnels",
      "description": "Gerenciamento de funis"
    },
    {
      "name": "Funnel Steps",
      "description": "Gerenciamento de etapas do funil"
    },
    {
      "name": "Funnel Items",
      "description": "Gerenciamento de itens do funil"
    },
    {
      "name": "Funnel Members",
      "description": "Gerenciamento de membros do funil"
    }
  ],
  "paths": {
    "/accounts/{account_id}/funnels": {
      "get": {
        "tags": [
          "Funnels"
        ],
        "summary": "Listar todos os funis",
        "description": "Retorna todos os funis da conta",
        "operationId": "listFunnels",
        "parameters": [
          {
            "$ref": "#/components/parameters/AccountId"
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de funis retornada com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "payload": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Funnel"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "post": {
        "tags": [
          "Funnels"
        ],
        "summary": "Criar novo funil",
        "description": "Cria um novo funil na conta",
        "operationId": "createFunnel",
        "parameters": [
          {
            "$ref": "#/components/parameters/AccountId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FunnelCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Funil criado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Funnel"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/accounts/{account_id}/funnels/{funnel_id}": {
      "get": {
        "tags": [
          "Funnels"
        ],
        "summary": "Obter funil específico",
        "description": "Retorna detalhes de um funil específico",
        "operationId": "getFunnel",
        "parameters": [
          {
            "$ref": "#/components/parameters/AccountId"
          },
          {
            "$ref": "#/components/parameters/FunnelId"
          }
        ],
        "responses": {
          "200": {
            "description": "Funil retornado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Funnel"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "patch": {
        "tags": [
          "Funnels"
        ],
        "summary": "Atualizar funil",
        "description": "Atualiza informações de um funil existente",
        "operationId": "updateFunnel",
        "parameters": [
          {
            "$ref": "#/components/parameters/AccountId"
          },
          {
            "$ref": "#/components/parameters/FunnelId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FunnelUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Funil atualizado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Funnel"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "delete": {
        "tags": [
          "Funnels"
        ],
        "summary": "Deletar funil",
        "description": "Remove um funil da conta",
        "operationId": "deleteFunnel",
        "parameters": [
          {
            "$ref": "#/components/parameters/AccountId"
          },
          {
            "$ref": "#/components/parameters/FunnelId"
          }
        ],
        "responses": {
          "204": {
            "description": "Funil deletado com sucesso"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/accounts/{account_id}/funnels/{funnel_id}/duplicate": {
      "post": {
        "tags": [
          "Funnels"
        ],
        "summary": "Duplicar funil",
        "description": "Duplica um funil com todas as suas etapas, checklists, tarefas e mensagens",
        "operationId": "duplicateFunnel",
        "parameters": [
          {
            "$ref": "#/components/parameters/AccountId"
          },
          {
            "$ref": "#/components/parameters/FunnelId"
          }
        ],
        "responses": {
          "201": {
            "description": "Funil duplicado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Funnel"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/accounts/{account_id}/funnels/{funnel_id}/steps/reorder": {
      "post": {
        "tags": [
          "Funnels"
        ],
        "summary": "Reordenar etapas do funil",
        "description": "Reordena as etapas intermediárias do funil",
        "operationId": "reorderFunnelSteps",
        "parameters": [
          {
            "$ref": "#/components/parameters/AccountId"
          },
          {
            "$ref": "#/components/parameters/FunnelId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "steps": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer"
                        },
                        "ordered": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Etapas reordenadas com sucesso"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/accounts/{account_id}/funnels/{funnel_id}/funnel_steps": {
      "post": {
        "tags": [
          "Funnel Steps"
        ],
        "summary": "Criar etapa do funil",
        "description": "Cria uma nova etapa no funil",
        "operationId": "createFunnelStep",
        "parameters": [
          {
            "$ref": "#/components/parameters/AccountId"
          },
          {
            "$ref": "#/components/parameters/FunnelId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FunnelStepCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Etapa criada com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunnelStep"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    },
    "/accounts/{account_id}/funnels/{funnel_id}/funnel_steps/{funnel_step_id}": {
      "get": {
        "tags": [
          "Funnel Steps"
        ],
        "summary": "Obter etapa específica",
        "description": "Retorna detalhes de uma etapa específica",
        "operationId": "getFunnelStep",
        "parameters": [
          {
            "$ref": "#/components/parameters/AccountId"
          },
          {
            "$ref": "#/components/parameters/FunnelId"
          },
          {
            "$ref": "#/components/parameters/FunnelStepId"
          }
        ],
        "responses": {
          "200": {
            "description": "Etapa retornada com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunnelStep"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "patch": {
        "tags": [
          "Funnel Steps"
        ],
        "summary": "Atualizar etapa",
        "description": "Atualiza informações de uma etapa existente",
        "operationId": "updateFunnelStep",
        "parameters": [
          {
            "$ref": "#/components/parameters/AccountId"
          },
          {
            "$ref": "#/components/parameters/FunnelId"
          },
          {
            "$ref": "#/components/parameters/FunnelStepId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FunnelStepUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Etapa atualizada com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunnelStep"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "delete": {
        "tags": [
          "Funnel Steps"
        ],
        "summary": "Deletar etapa",
        "description": "Remove uma etapa do funil",
        "operationId": "deleteFunnelStep",
        "parameters": [
          {
            "$ref": "#/components/parameters/AccountId"
          },
          {
            "$ref": "#/components/parameters/FunnelId"
          },
          {
            "$ref": "#/components/parameters/FunnelStepId"
          }
        ],
        "responses": {
          "204": {
            "description": "Etapa deletada com sucesso"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/accounts/{account_id}/funnels/{funnel_id}/funnel_steps/{funnel_step_id}/funnel_items": {
      "get": {
        "tags": [
          "Funnel Items"
        ],
        "summary": "Listar itens da etapa",
        "description": "Retorna todos os itens de uma etapa com paginação (25 por página)",
        "operationId": "listFunnelItems",
        "parameters": [
          {
            "$ref": "#/components/parameters/AccountId"
          },
          {
            "$ref": "#/components/parameters/FunnelId"
          },
          {
            "$ref": "#/components/parameters/FunnelStepId"
          },
          {
            "name": "page",
            "in": "query",
            "description": "Número da página",
            "schema": {
              "type": "integer",
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de itens retornada com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "payload": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/FunnelItem"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Funnel Items"
        ],
        "summary": "Criar item",
        "description": "Cria um novo item na etapa do funil",
        "operationId": "createFunnelItem",
        "parameters": [
          {
            "$ref": "#/components/parameters/AccountId"
          },
          {
            "$ref": "#/components/parameters/FunnelId"
          },
          {
            "$ref": "#/components/parameters/FunnelStepId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FunnelItemCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Item criado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunnelItem"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    },
    "/accounts/{account_id}/funnels/{funnel_id}/funnel_steps/{funnel_step_id}/funnel_items/{funnel_item_id}": {
      "get": {
        "tags": [
          "Funnel Items"
        ],
        "summary": "Obter item específico",
        "description": "Retorna detalhes de um item específico",
        "operationId": "getFunnelItem",
        "parameters": [
          {
            "$ref": "#/components/parameters/AccountId"
          },
          {
            "$ref": "#/components/parameters/FunnelId"
          },
          {
            "$ref": "#/components/parameters/FunnelStepId"
          },
          {
            "$ref": "#/components/parameters/FunnelItemId"
          }
        ],
        "responses": {
          "200": {
            "description": "Item retornado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunnelItem"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "patch": {
        "tags": [
          "Funnel Items"
        ],
        "summary": "Atualizar item",
        "description": "Atualiza informações de um item existente",
        "operationId": "updateFunnelItem",
        "parameters": [
          {
            "$ref": "#/components/parameters/AccountId"
          },
          {
            "$ref": "#/components/parameters/FunnelId"
          },
          {
            "$ref": "#/components/parameters/FunnelStepId"
          },
          {
            "$ref": "#/components/parameters/FunnelItemId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FunnelItemUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Item atualizado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunnelItem"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "delete": {
        "tags": [
          "Funnel Items"
        ],
        "summary": "Deletar item",
        "description": "Remove um item da etapa",
        "operationId": "deleteFunnelItem",
        "parameters": [
          {
            "$ref": "#/components/parameters/AccountId"
          },
          {
            "$ref": "#/components/parameters/FunnelId"
          },
          {
            "$ref": "#/components/parameters/FunnelStepId"
          },
          {
            "$ref": "#/components/parameters/FunnelItemId"
          }
        ],
        "responses": {
          "204": {
            "description": "Item deletado com sucesso"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/accounts/{account_id}/funnels/{funnel_id}/funnel_steps/{funnel_step_id}/funnel_items/filter": {
      "post": {
        "tags": [
          "Funnel Items"
        ],
        "summary": "Filtrar itens",
        "description": "Filtra itens por diversos critérios",
        "operationId": "filterFunnelItems",
        "parameters": [
          {
            "$ref": "#/components/parameters/AccountId"
          },
          {
            "$ref": "#/components/parameters/FunnelId"
          },
          {
            "$ref": "#/components/parameters/FunnelStepId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "priority": {
                    "type": "string",
                    "enum": [
                      "low",
                      "medium",
                      "high",
                      "urgent"
                    ]
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "active",
                      "inactive"
                    ]
                  },
                  "assigned_id": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Itens filtrados com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FunnelItem"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/accounts/{account_id}/funnels/{funnel_id}/funnel_steps/{funnel_step_id}/funnel_items/{funnel_item_id}/update_step": {
      "put": {
        "tags": [
          "Funnel Items"
        ],
        "summary": "Mover item para outra etapa",
        "description": "Move um item para uma etapa diferente",
        "operationId": "updateItemStep",
        "parameters": [
          {
            "$ref": "#/components/parameters/AccountId"
          },
          {
            "$ref": "#/components/parameters/FunnelId"
          },
          {
            "$ref": "#/components/parameters/FunnelStepId"
          },
          {
            "$ref": "#/components/parameters/FunnelItemId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "funnel_item": {
                    "type": "object",
                    "properties": {
                      "funnel_step_id": {
                        "type": "integer"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Item movido com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunnelItem"
                }
              }
            }
          }
        }
      }
    },
    "/accounts/{account_id}/funnels/{funnel_id}/funnel_steps/{funnel_step_id}/funnel_items/bulk_create": {
      "post": {
        "tags": [
          "Funnel Items"
        ],
        "summary": "Criar múltiplos itens",
        "description": "Cria vários itens de uma vez a partir de conversas",
        "operationId": "bulkCreateFunnelItems",
        "parameters": [
          {
            "$ref": "#/components/parameters/AccountId"
          },
          {
            "$ref": "#/components/parameters/FunnelId"
          },
          {
            "$ref": "#/components/parameters/FunnelStepId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "title": {
                          "type": "string"
                        },
                        "conversation_id": {
                          "type": "integer"
                        },
                        "priority": {
                          "type": "string",
                          "enum": [
                            "low",
                            "medium",
                            "high",
                            "urgent"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Itens criados com sucesso"
          }
        }
      }
    },
    "/accounts/{account_id}/funnels/{funnel_id}/funnel_items/bulk_transfer": {
      "post": {
        "tags": [
          "Funnel Items"
        ],
        "summary": "Transferir múltiplos itens",
        "description": "Transfere vários itens para outra etapa ou funil",
        "operationId": "bulkTransferFunnelItems",
        "parameters": [
          {
            "$ref": "#/components/parameters/AccountId"
          },
          {
            "$ref": "#/components/parameters/FunnelId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "source_funnel_step_id": {
                    "type": "integer"
                  },
                  "target_funnel_id": {
                    "type": "integer"
                  },
                  "target_funnel_step_id": {
                    "type": "integer"
                  },
                  "item_ids": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    }
                  },
                  "transfer_mode": {
                    "type": "string",
                    "enum": [
                      "selected",
                      "all_listed",
                      "all_step"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Itens transferidos com sucesso"
          }
        }
      }
    },
    "/accounts/{account_id}/funnels/{funnel_id}/funnel_items/bulk_send_message": {
      "post": {
        "tags": [
          "Funnel Items"
        ],
        "summary": "Enviar mensagem em massa",
        "description": "Envia uma mensagem para as conversas de múltiplos itens",
        "operationId": "bulkSendMessage",
        "parameters": [
          {
            "$ref": "#/components/parameters/AccountId"
          },
          {
            "$ref": "#/components/parameters/FunnelId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "source_funnel_step_id": {
                    "type": "integer"
                  },
                  "item_ids": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    }
                  },
                  "message": {
                    "type": "string"
                  },
                  "send_mode": {
                    "type": "string",
                    "enum": [
                      "selected",
                      "all_listed",
                      "all_step"
                    ]
                  },
                  "is_private": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Mensagens enviadas com sucesso"
          }
        }
      }
    },
    "/accounts/{account_id}/funnels/{funnel_id}/funnel_items/bulk_delete": {
      "post": {
        "tags": [
          "Funnel Items"
        ],
        "summary": "Deletar múltiplos itens",
        "description": "Remove vários itens de uma vez",
        "operationId": "bulkDeleteFunnelItems",
        "parameters": [
          {
            "$ref": "#/components/parameters/AccountId"
          },
          {
            "$ref": "#/components/parameters/FunnelId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "source_funnel_step_id": {
                    "type": "integer"
                  },
                  "item_ids": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    }
                  },
                  "delete_mode": {
                    "type": "string",
                    "enum": [
                      "selected",
                      "all_listed",
                      "all_step"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Itens deletados com sucesso"
          }
        }
      }
