                            "type": "string",
                            "minLength": 1
                          },
                          "anchor": {
                            "type": "object",
                            "properties": {
                              "selector": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 2000
                              },
                              "text": {
                                "type": "string",
                                "maxLength": 200
                              }
                            },
                            "required": [
                              "selector"
                            ]
                          }
                        },
                        "required": [
