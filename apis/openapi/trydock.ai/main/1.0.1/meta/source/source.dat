                          "surfaceSlug",
                          "anchor"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "enum": [
                              "video_frame"
                            ]
                          },
                          "surfaceSlug": {
                            "type": "string",
                            "minLength": 1
                          },
                          "anchor": {
                            "type": "object",
                            "properties": {
                              "videoId": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 64
                              },
                              "t": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 86400
                              },
                              "box": {
                                "type": [
                                  "object",
                                  "null"
                                ],
                                "properties": {
                                  "x": {
                                    "type": "number",
                                    "minimum": 0,
                                    "maximum": 1
                                  },
                                  "y": {
                                    "type": "number",
                                    "minimum": 0,
                                    "maximum": 1
                                  },
                                  "w": {
                                    "type": "number",
                                    "minimum": 0,
                                    "maximum": 1
                                  },
                                  "h": {
