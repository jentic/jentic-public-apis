                            "enum": [
                              "doc_range"
                            ]
                          },
                          "surfaceSlug": {
                            "type": "string",
                            "minLength": 1
                          },
                          "anchor": {
                            "type": "object",
                            "properties": {
                              "from": {
                                "type": "integer",
                                "minimum": 0
                              },
                              "to": {
                                "type": "integer",
