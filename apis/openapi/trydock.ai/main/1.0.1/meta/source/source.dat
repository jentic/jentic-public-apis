                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "example": "r_01J5Z…"
                          },
                          "surfaceId": {
                            "type": "string"
                          },
                          "position": {
                            "type": "integer"
                          },
                          "data": {
                            "type": "object",
                            "additionalProperties": {},
                            "description": "Cell values keyed by column id. Types match the column schema."
                          },
                          "createdAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "updatedAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "createdBy": {
                            "type": "string",
                            "description": "Principal id (user OR agent)."
                          },
                          "updatedBy": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "id",
                          "surfaceId",
                          "position",
                          "data",
                          "createdAt",
                          "updatedAt",
                          "createdBy",
                          "updatedBy"
                        ]
                      }
                    },
                    "patched": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "example": "r_01J5Z…"
                          },
                          "surfaceId": {
                            "type": "string"
                          },
                          "position": {
                            "type": "integer"
                          },
                          "data": {
                            "type": "object",
                            "additionalProperties": {},
                            "description": "Cell values keyed by column id. Types match the column schema."
                          },
                          "createdAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "updatedAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "createdBy": {
                            "type": "string",
                            "description": "Principal id (user OR agent)."
                          },
                          "updatedBy": {
                            "type": "string"
                          }
                        },
                        "required": [
