                }
              }
            }
          }
        }
      }
    },
    "/api/workspaces/{slug}/files/zip": {
      "post": {
        "summary": "Bulk download multiple files as a zip",
        "description": "Capped at 50 files per request and 500 MB total uncompressed. Duplicate filenames are deduped server-side (`photo.jpg`, `photo (2).jpg`).",
        "tags": [
          "Files"
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "slug",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "fileIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1,
                    "maxItems": 50
                  },
                  "surfaceSlug": {
                    "type": "string"
                  }
                },
                "required": [
                  "fileIds",
                  "surfaceSlug"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "application/zip stream",
            "content": {
              "application/zip": {
                "schema": {
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "Bundle exceeds 500 MB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown fileId or archived file",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/workspaces/{slug}/files/{fileId}/preview": {
      "get": {
        "summary": "Text-bytes preview for small text/code files",
        "description": "Returns the raw text bytes for files ≤256 KB with a text-like MIME (text/*, application/json, yaml, xml, js, ts, sh). Used by the in-browser code preview. Returns `{ id, name, mimeType, size, text }`.",
        "tags": [
          "Files"
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
