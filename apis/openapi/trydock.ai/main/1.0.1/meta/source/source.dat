    "/api/billing": {
      "get": {
        "summary": "Get billing summary",
        "description": "Current plan, subscription status, agent/member/workspace counts, next-invoice date, card on file. Both users and agents can call.",
        "tags": [
          "Billing"
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Billing summary.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "plan": {
                      "type": "string",
                      "enum": [
                        "free",
                        "pro",
                        "scale"
                      ],
                      "description": "Plan tier. Caps live in `src/lib/plan.ts`."
                    },
                    "status": {
                      "type": "string",
                      "description": "Subscription status from Stripe (`active`, `trialing`, `past_due`, `canceled`, ...) or `none` if no subscription exists."
                    },
                    "cancelAtPeriodEnd": {
                      "type": [
                        "boolean",
                        "null"
                      ],
                      "description": "True when the user has scheduled a downgrade/cancel at the end of the current period."
                    },
                    "currentPeriodEnd": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "date-time"
                    },
                    "agentCount": {
                      "type": "integer"
                    },
                    "memberCount": {
                      "type": "integer"
                    },
                    "workspaceCount": {
                      "type": "integer"
                    },
                    "caps": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "integer"
                      },
                      "description": "Per-tier caps for the active plan."
                    },
                    "card": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "properties": {
                        "brand": {
                          "type": "string"
                        },
                        "last4": {
                          "type": "string"
                        },
                        "expMonth": {
                          "type": "integer"
                        },
                        "expYear": {
                          "type": "integer"
                        }
                      },
                      "required": [
                        "brand",
                        "last4",
                        "expMonth",
                        "expYear"
                      ]
                    },
                    "designPartnerPro": {
                      "type": "boolean",
                      "description": "Design-partner orgs are on Scale at $0."
                    }
                  },
                  "required": [
                    "plan",
                    "status"
                  ],
                  "description": "Open-ended summary. Fields beyond `plan` + `status` may be added over time."
                }
              }
            }
          }
        }
      }
    },
    "/api/billing/checkout": {
      "post": {
        "summary": "Create a Stripe Checkout session",
        "description": "Low-level — returns a Checkout URL for entering a card. Prefer `POST /api/billing/upgrade` in most flows; that handles the plan-switch branches too. Use this when you specifically want a fresh Checkout (e.g. after a portal cancellation). 409s if a subscription already exists.",
        "tags": [
          "Billing"
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "plan": {
                    "type": "string",
                    "enum": [
                      "pro",
                      "scale"
                    ],
                    "description": "Target plan. Defaults to `pro`."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Checkout URL.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "plan": {
                      "type": "string",
                      "enum": [
                        "pro",
                        "scale"
                      ]
                    }
                  },
                  "required": [
                    "url",
                    "plan"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Stripe not configured on this deployment.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Subscription already exists, or org is on design-partner Scale at $0.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/billing/portal": {
      "post": {
        "summary": "Create a Stripe Customer Portal session",
        "description": "Returns a short-lived URL for the Stripe Customer Portal — card changes, invoice history, manual cancellation. The portal itself is browser-only; agents can hand the link back to their user.",
        "tags": [
          "Billing"
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Portal URL.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string",
                      "format": "uri"
                    }
                  },
                  "required": [
                    "url"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Stripe not configured.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/billing/upgrade": {
      "post": {
        "summary": "Upgrade plan (Pro or Scale)",
        "description": "Upgrade or switch to a paid plan. **Behavior depends on principal type:**\n\n- **HUMAN** (session cookie): one-call execution. The Settings UI click is itself the consent signal.\n- **AGENT** (DK key, OAuth bearer): consent-gated. First call returns `{ status: \"confirmation_required\", confirm_token, message, expires_in }`. Agent surfaces the message to its user, user confirms, agent re-calls within 60s with the `confirm_token` set. Optionally pass `mode: \"web\"` for a web-approve URL the agent prints in chat — agent then polls `/api/web-approve/status`.\n\n**Fast paths** (both principal types): no existing subscription returns a Checkout URL; same-plan + scheduled-cancel resumes; design-partner orgs no-op at Scale.",
        "tags": [
          "Billing"
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "plan": {
                    "type": "string",
                    "enum": [
                      "pro",
                      "scale"
                    ],
                    "description": "Target plan. Defaults to `pro`."
                  },
                  "confirm_token": {
                    "type": "string",
                    "description": "Required for AGENT-initiated live plan flips. Returned on the first call."
                  },
                  "mode": {
                    "type": "string",
                    "enum": [
                      "chat",
                      "web"
                    ],
                    "description": "Agent-only consent UX. `chat` (default) = handshake via confirm_token. `web` = mint a web-approve URL the user clicks."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Discriminated by `status`: `switched` | `resumed` | `checkout-required` | `confirmation_required` | `web-approve-required` | `design-partner`.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "plan": {
                      "type": "string",
                      "enum": [
                        "free",
                        "pro",
                        "scale"
                      ],
                      "description": "Plan tier. Caps live in `src/lib/plan.ts`."
                    },
                    "status": {
                      "type": "string"
                    },
                    "checkoutUrl": {
                      "type": "string",
                      "format": "uri"
                    },
                    "targetPlan": {
                      "type": "string",
                      "enum": [
                        "pro",
                        "scale"
                      ]
                    },
                    "confirm_token": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "expires_in": {
                      "type": "integer"
                    },
                    "url": {
                      "type": "string",
                      "format": "uri",
                      "description": "web-approve flow only."
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Stripe not configured, or invalid confirm_token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/billing/downgrade": {
      "post": {
        "summary": "Schedule a downgrade to Free",
        "description": "Schedule a downgrade to Free at the end of the current billing period. The org keeps its current plan + caps until then. Idempotent on already-Free orgs.\n\nSame human-vs-agent consent split as `/api/billing/upgrade`: humans execute directly; agents must use the `confirm_token` handshake (or `mode: \"web\"` for the web-approve flow).",
        "tags": [
          "Billing"
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "confirm_token": {
                    "type": "string"
                  },
                  "mode": {
                    "type": "string",
                    "enum": [
                      "chat",
                      "web"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Discriminated by `status`: `downgrade-scheduled` | `already-free` | `confirmation_required` | `web-approve-required`.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "plan": {
                      "type": "string",
                      "enum": [
                        "free",
                        "pro",
                        "scale"
                      ],
                      "description": "Plan tier. Caps live in `src/lib/plan.ts`."
                    },
                    "status": {
                      "type": "string"
                    },
                    "confirm_token": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "expires_in": {
                      "type": "integer"
                    },
                    "url": {
                      "type": "string",
                      "format": "uri"
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid confirm_token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/billing/request-limit-increase": {
      "post": {
        "summary": "Request a limit increase",
        "description": "Agentic escape hatch. When the org bumps a cap (agents, workspaces, rows, anything), call this to register demand. We count signals on the admin side; no ticket, no reply loop, no email. Body is optional — at minimum we record \"someone hit a cap\".",
        "tags": [
          "Billing"
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "agents",
                      "workspaces",
                      "rows",
                      "other"
                    ],
                    "description": "Defaults to `other`."
                  },
                  "desiredValue": {
                    "type": "integer",
                    "description": "What the caller would like the cap to be."
                  },
                  "reason": {
                    "type": "string",
                    "maxLength": 500,
                    "description": "Free-text context. Truncated to 500 chars."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Logged.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "received"
                      ]
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "status",
                    "message"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/sheets/functions": {
      "get": {
        "summary": "List the formula function catalog",
        "description": "Returns the 39-function Dock Sheets catalog (12 V1 + 14 V2 + 7 V3 + 6 V4), the alias map (e.g. CONCAT → CONCATENATE), and the category list. Public endpoint, no auth required. Use this before writing a formula carrier so you only reference functions that actually exist.",
        "tags": [
          "Sheets formulas"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "Math",
                "Logic",
                "Text",
                "Date",
                "Lookup",
                "Predicates",
                "Other"
              ],
              "description": "Filter to one category."
            },
            "required": false,
            "description": "Filter to one category.",
            "name": "category",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "v1",
                "v2",
                "v3",
                "v4"
              ],
              "description": "Filter to one rollout slice."
            },
            "required": false,
            "description": "Filter to one rollout slice.",
            "name": "slice",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "Case-insensitive substring match against name, description, and signature."
            },
            "required": false,
            "description": "Case-insensitive substring match against name, description, and signature.",
            "name": "name",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Filtered catalog.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "count": {
                      "type": "integer"
                    },
                    "functions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string",
                            "example": "SUM"
                          },
                          "signature": {
                            "type": "string",
                            "example": "(range)"
                          },
                          "description": {
                            "type": "string",
                            "example": "Add up the numbers in a range."
                          },
                          "category": {
                            "type": "string",
                            "enum": [
                              "Math",
                              "Logic",
                              "Text",
                              "Date",
                              "Lookup",
                              "Predicates",
                              "Other"
                            ],
                            "example": "Math"
                          },
                          "slice": {
                            "type": "string",
                            "enum": [
                              "v1",
                              "v2",
                              "v3",
                              "v4"
                            ],
                            "example": "v1"
                          },
                          "examples": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "formula": {
                                  "type": "string",
                                  "example": "=SUM(B2:B10)"
                                },
                                "result": {
                                  "type": "string",
                                  "example": "318.42"
                                }
                              },
                              "required": [
                                "formula",
                                "result"
                              ]
                            }
                          }
                        },
                        "required": [
                          "name",
                          "signature",
                          "description",
                          "category",
                          "slice",
                          "examples"
                        ]
                      }
                    },
                    "aliases": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      }
                    },
                    "categories": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "count",
                    "functions",
                    "aliases",
                    "categories"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/sheets/validate-formula": {
      "post": {
        "summary": "Parse-check a formula expression",
        "description": "Returns { ok, error?, referencedFunctions, unknownFunctions }. Catches syntax errors and likely typos before you persist a stale carrier into a row. Public endpoint, no auth, no workspace context required.",
        "tags": [
          "Sheets formulas"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "formula": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000,
                    "example": "=SUMIF(B2:B10, \">0\")"
                  }
                },
                "required": [
                  "formula"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validation result.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "error": {
                      "type": "string",
                      "description": "Plain-language reason the formula didn't parse, when ok=false."
                    },
                    "referencedFunctions": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Canonical function names referenced in the formula. Aliases are resolved to their canonical form."
                    },
                    "unknownFunctions": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Any identifier that looked like a function call but isn't in the Dock catalog. Likely typos or unsupported functions."
                    }
                  },
                  "required": [
                    "ok",
                    "referencedFunctions",
                    "unknownFunctions"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/sheets/evaluate-formula": {
      "post": {
        "summary": "Evaluate a formula expression",
        "description": "Two modes:\n\n- **Standalone** — body `{ formula }` only. Public. Evaluates against an empty grid. Useful for `=SUM(1, 2, 3)` style sanity checks.\n- **In workspace** — body `{ formula, workspaceSlug, at? }`. Loads the workspace's columns + rows, evaluates the formula as if pasted into `at` (or the first cell if omitted), resolves references against actual data. Requires read access to the workspace.\n\nReturns `{ ok, displayValue, error? }`.",
        "tags": [
          "Sheets formulas"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "formula": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000,
                    "example": "=SUM(A1:A3)"
                  },
                  "workspaceSlug": {
                    "type": "string",
                    "description": "Workspace slug. Pass to evaluate against real data; omit for standalone."
                  },
                  "at": {
                    "type": "object",
                    "properties": {
                      "rowId": {
                        "type": "string"
                      },
                      "colKey": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "rowId",
                      "colKey"
                    ],
                    "description": "Optional anchor cell (only used with workspaceSlug)."
                  }
                },
                "required": [
                  "formula"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Evaluation result.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "displayValue": {
                      "type": "string",
                      "description": "The string the UI would render in the cell (matches HyperFormula's display, e.g. '60', '4.20', '#DIV/0!')."
                    },
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string",
                          "example": "DIV_BY_ZERO"
                        },
                        "summary": {
                          "type": "string",
                          "example": "Dividing by zero. Check the cell on the right side of the /."
                        }
                      },
                      "required": [
                        "code",
                        "summary"
                      ]
                    }
                  },
                  "required": [
                    "ok",
                    "displayValue"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Workspace has no columns, or anchor cell invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "In-workspace mode + unauthenticated + private workspace.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Workspace, row, or column not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/workspaces/{slug}/files": {
      "get": {
        "summary": "List files (with optional sort, search, starred, recent views)",
        "description": "Returns folders + files in the given Files surface. Default view = current folder's children. Pass `view=starred` for a flat surface-wide starred list, `view=recent` for the 50 most-recently-updated. `q` widens to a surface-wide name-contains search. `sort` + `order` override the default name asc.",
        "tags": [
          "Files"
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "slug",
            "in": "path"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "surfaceSlug",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "Folder id to descend into; omit or pass 'null' for root."
            },
            "required": false,
            "description": "Folder id to descend into; omit or pass 'null' for root.",
            "name": "parentFolderId",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "starred",
                "recent"
              ],
              "description": "Override the default folder-scoped listing."
            },
            "required": false,
            "description": "Override the default folder-scoped listing.",
            "name": "view",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "example": "hero"
            },
            "required": false,
            "name": "q",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "name",
                "createdAt",
                "updatedAt",
                "size",
                "mimeType"
              ]
            },
            "required": false,
            "name": "sort",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            },
            "required": false,
            "name": "order",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Folders + files",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "folders": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "parentFolderId": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "position": {
                            "type": "integer"
                          },
                          "createdAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "updatedAt": {
                            "type": "string",
                            "format": "date-time"
                          }
                        },
                        "required": [
                          "id",
                          "name",
                          "parentFolderId",
                          "position",
                          "createdAt",
                          "updatedAt"
                        ]
                      }
                    },
                    "files": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "example": "cmpfile_…"
                          },
                          "name": {
                            "type": "string",
                            "example": "hero.png"
                          },
                          "parentFolderId": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "size": {
                            "type": "integer",
                            "description": "Bytes."
                          },
                          "mimeType": {
                            "type": "string",
                            "example": "image/png"
                          },
                          "thumbUrl": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "description": "Server-generated 256-px webp URL. Null for non-raster files."
                          },
                          "starred": {
                            "type": "boolean"
                          },
                          "starredAt": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "format": "date-time"
                          },
                          "description": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "tags": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "exif": {
                            "type": [
                              "object",
                              "null"
                            ],
                            "additionalProperties": {}
                          },
                          "createdAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "updatedAt": {
                            "type": "string",
                            "format": "date-time"
                          }
                        },
                        "required": [
                          "id",
                          "name",
                          "parentFolderId",
                          "size",
                          "mimeType",
                          "thumbUrl",
                          "createdAt",
                          "updatedAt"
                        ]
                      }
                    }
                  },
                  "required": [
                    "folders",
                    "files"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Files surface not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/workspaces/{slug}/files/proxy-upload": {
      "post": {
        "summary": "Upload a file (server-proxied)",
        "description": "Multipart upload that streams bytes through the server. Used for SVG (server-side DOMPurify sanitization) and raster images (EXIF strip + 256-px webp thumb generation). Capped at 25 MB by the serverless body limit. Larger files MUST use the direct-to-blob token route (`POST /api/workspaces/{slug}/files`).",
        "tags": [
          "Files"
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "slug",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "surface_slug": {
                    "type": "string"
                  },
                  "parent_folder_id": {
                    "type": "string"
                  },
                  "file": {
                    "format": "binary"
                  }
                },
                "required": [
                  "surface_slug"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "File row",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "example": "cmpfile_…"
                    },
                    "name": {
                      "type": "string",
                      "example": "hero.png"
                    },
                    "parentFolderId": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "size": {
                      "type": "integer",
                      "description": "Bytes."
                    },
                    "mimeType": {
                      "type": "string",
                      "example": "image/png"
                    },
                    "thumbUrl": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Server-generated 256-px webp URL. Null for non-raster files."
                    },
                    "starred": {
                      "type": "boolean"
                    },
                    "starredAt": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "date-time"
                    },
                    "description": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "tags": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "exif": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "additionalProperties": {}
                    },
                    "createdAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "updatedAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "id",
                    "name",
                    "parentFolderId",
                    "size",
                    "mimeType",
                    "thumbUrl",
                    "createdAt",
                    "updatedAt"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Bad MIME / sanitization rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Over per-file or per-tier storage cap",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/workspaces/{slug}/files/{fileId}": {
      "patch": {
        "summary": "Rename, move, or restore a file",
        "description": "Discriminated payload: `{ name }` to rename, `{ parentFolderId }` to move (pass `null` for root, must be in the same surface), `{ restore: true }` to un-archive a soft-deleted file. Rename keeps blobKey stable so deep-links never break. Restore + name in the same body is rejected.",
        "tags": [
          "Files"
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "slug",
            "in": "path"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "fileId",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "parentFolderId": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "restore": {
                    "type": "boolean",
                    "enum": [
                      true
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated file",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "example": "cmpfile_…"
                    },
                    "name": {
                      "type": "string",
                      "example": "hero.png"
                    },
                    "parentFolderId": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "size": {
                      "type": "integer",
                      "description": "Bytes."
                    },
                    "mimeType": {
                      "type": "string",
                      "example": "image/png"
                    },
                    "thumbUrl": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Server-generated 256-px webp URL. Null for non-raster files."
                    },
                    "starred": {
                      "type": "boolean"
                    },
                    "starredAt": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "date-time"
                    },
                    "description": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "tags": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "exif": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "additionalProperties": {}
                    },
                    "createdAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "updatedAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "id",
                    "name",
                    "parentFolderId",
                    "size",
                    "mimeType",
                    "thumbUrl",
                    "createdAt",
                    "updatedAt"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Cross-surface move / archived rename / combo rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "File not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Archive (soft-delete) a file",
        "description": "Sets archivedAt + the archivedBy stamp. Blob stays in storage and the org's storage counter stays incremented until the 30-day trash cleanup cron hard-deletes it. Restorable via PATCH `{ restore: true }`.",
        "tags": [
          "Files"
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "slug",
            "in": "path"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "fileId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Archived",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    }
                  },
                  "required": [
                    "ok"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Not found or already archived",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/workspaces/{slug}/files/{fileId}/metadata": {
      "patch": {
        "summary": "Update file metadata (starred · description · tags)",
        "description": "Each call accepts any subset of the three keys. Tags are normalised server-side: lowercased, trimmed, de-duplicated, empties dropped. Description capped at 2 000 chars; empty string clears. Max 16 tags × 32 chars each.",
        "tags": [
          "Files"
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "slug",
            "in": "path"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "fileId",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "starred": {
                    "type": "boolean"
                  },
                  "description": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 2000
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 32
                    },
                    "maxItems": 16
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated file",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "file": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "example": "cmpfile_…"
                        },
                        "name": {
                          "type": "string",
                          "example": "hero.png"
                        },
                        "parentFolderId": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "size": {
                          "type": "integer",
                          "description": "Bytes."
                        },
                        "mimeType": {
                          "type": "string",
                          "example": "image/png"
                        },
                        "thumbUrl": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "Server-generated 256-px webp URL. Null for non-raster files."
                        },
                        "starred": {
                          "type": "boolean"
                        },
                        "starredAt": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "format": "date-time"
                        },
                        "description": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "tags": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "exif": {
                          "type": [
                            "object",
                            "null"
                          ],
                          "additionalProperties": {}
                        },
                        "createdAt": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "updatedAt": {
                          "type": "string",
                          "format": "date-time"
                        }
                      },
                      "required": [
                        "id",
                        "name",
                        "parentFolderId",
                        "size",
                        "mimeType",
                        "thumbUrl",
                        "createdAt",
                        "updatedAt"
                      ]
                    }
                  },
                  "required": [
                    "ok",
                    "file"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "File not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Zod validation failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/workspaces/{slug}/files/{fileId}/share": {
      "post": {
        "summary": "Mint a public share token for a file",
        "description": "Returns a public URL anyone can open (no auth) to view + download the file. Token is 32 random bytes (~256 bits of entropy). Editor role required.",
        "tags": [
          "Files"
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "slug",
            "in": "path"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "fileId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Share URL",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string",
                      "example": "https://trydock.ai/share/files/abc…"
                    },
                    "createdAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "id",
                    "url",
                    "createdAt"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "File not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "List active share tokens for a file",
        "tags": [
          "Files"
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "slug",
            "in": "path"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "fileId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Tokens list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "tokens": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "url": {
                            "type": "string",
                            "example": "https://trydock.ai/share/files/abc…"
                          },
                          "createdAt": {
                            "type": "string",
                            "format": "date-time"
                          }
                        },
                        "required": [
                          "id",
                          "url",
                          "createdAt"
                        ]
                      }
                    }
                  },
                  "required": [
                    "tokens"
                  ]
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Revoke a share token",
        "description": "Soft-revoke (sets revokedAt). Idempotent: second revoke returns `alreadyRevoked: true`.",
        "tags": [
          "Files"
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "slug",
            "in": "path"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "fileId",
            "in": "path"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "tokenId",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Revoked or already-revoked",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "alreadyRevoked": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "ok"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Missing tokenId",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
