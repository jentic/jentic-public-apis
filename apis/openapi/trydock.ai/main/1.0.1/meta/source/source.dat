              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "example": "cmpfile_…"
                    },
                    "name": {
                      "type": "string",
                      "example": "hero.png"
                    },
                    "parentFolderId": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "size": {
                      "type": "integer",
                      "description": "Bytes."
                    },
                    "mimeType": {
                      "type": "string",
                      "example": "image/png"
                    },
                    "thumbUrl": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Server-generated 256-px webp URL. Null for non-raster files."
                    },
                    "starred": {
                      "type": "boolean"
                    },
                    "starredAt": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "date-time"
                    },
                    "description": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "tags": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "exif": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "additionalProperties": {}
                    },
                    "createdAt": {
                      "type": "string",
