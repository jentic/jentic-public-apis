      "post": {
        "summary": "Create a comment on a row (legacy)",
        "description": "Legacy row-only comment endpoint. New clients should use the universal endpoint above with `target: { kind: \"row\", rowId }`.",
        "tags": [
          "Comments"
        ],
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "slug",
            "in": "path"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "body": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 10000
