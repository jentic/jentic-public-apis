                          "surfaceSlug",
                          "anchor"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "enum": [
                              "surface"
                            ]
                          },
                          "surfaceSlug": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
