{
  "openapi": "3.0.3",
  "info": {
    "title": "ANNCSU REST API - ACCESSI",
    "description": "API dei servizi REST di ANNCSU su PDND per aggiornamento accessi\nPattern Model applicati:\n- [AUDIT_REST_02 ] Inoltro dati tracciati nel dominio del Fruitore REST con correlazione\n- [BLOCK_REST] Blocking REST\n- [INTEGRITY_REST_02] Integrità del payload messaggio REST in PDND",
    "termsOfService": "https://govway.org/documentazione/api/index.html",
    "contact": {
      "email": "infopdnd_anncsu@sogei.it"
    },
    "version": "1.0.2",
    "x-api-id": "https://govway.org/apiConfig",
    "x-summary": "Servizi per la configurazione di GovWay",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/SAVVI83/anncsu-rest-api-accessi/1.0.2"
  },
  "servers": [
    {
      "url": "https://modipa.agenziaentrate.it/govway/rest/in/AgenziaEntrate/anncsuaccessi/v1",
      "description": "l'accesso all'API e' protetta dai controlli di accesso su GovWay"
    },
    {
      "url": "https://modipa-val.agenziaentrate.it/govway/rest/in/AgenziaEntrate/anncsuaccessi/v1",
      "description": "l'accesso all'API di validazione e' protetta dai controlli di accesso su GovWay"
    }
  ],
  "tags": [
    {
      "name": "anncsu",
      "description": "Servizi ANNCSU su PDND"
    },
    {
      "name": "status"
    }
  ],
  "security": [
    {
      "bearerAuth": [],
      "Agid-JWT-Signature": [],
      "Agid-JWT-TrackingEvidence": []
    }
  ],
  "paths": {
    "/accessi": {
      "post": {
        "description": "Questo endpoint consente di eseguire un'operazione sugli accessi quali inserimento, modifica e cancellazione.",
        "operationId": "gestioneAnncsuPdnd",
        "summary": "Esegui un'operazione sugli accessi",
        "tags": [
          "anncsu"
        ],
        "requestBody": {
          "description": "Dati necessari per l'operazione sugli accessi.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RichiestaOperazione"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Operazione eseguita con successo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RispostaOperazione"
                }
              }
            }
          },
          "400": {
            "description": "Richiesta non valida",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/RispostaErrore"
                }
              }
            }
          },
          "404": {
            "description": "Accesso non trovato",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/RispostaErrore"
                }
              }
            }
          },
          "500": {
            "description": "Errore interno del server",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/RispostaErrore"
                }
              }
            }
          }
        }
      }
    },
    "/status": {
      "get": {
        "summary": "Ritorna lo stato dell'applicazione.",
        "description": "Ritorna lo stato dell'applicazione. A scopo\ndi test, su base randomica puo' ritornare\nun errore.\n",
        "operationId": "show_status",
        "tags": [
          "status"
        ],
        "responses": {
          "200": {
            "description": "Il server ha ritornato lo status. \n",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Il server non è disponibile. \n",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RichiestaOperazione": {
        "type": "object",
        "properties": {
          "richiesta": {
            "type": "object",
            "properties": {
              "codcom": {
                "type": "string",
                "format": "X999",
                "description": "Codice del comune (obbligatorio)",
                "example": "A062"
              },
              "progr_nazionale": {
                "type": "string",
                "maxLength": 10,
                "description": "Progressivo nazionale (obbligatorio)",
                "example": "2000449"
              },
              "accesso": {
                "type": "object",
                "properties": {
                  "progr_civico": {
                    "type": "string",
                    "maxLength": 15,
                    "description": "Progressivo accesso (obbligatorio solo per operazione_civico='R','S')",
                    "example": "1370588"
                  },
                  "codice_civico_comunale": {
                    "type": "string",
                    "maxLength": 30,
                    "nullable": true,
                    "description": "Codifica comunale dell'accesso",
                    "example": "7569A"
                  },
                  "numero": {
                    "type": "string",
                    "maxLength": 5,
                    "nullable": true,
                    "description": "Numero civico, da non valorizzare per operazione_civico='S' o accesso identificato con il sistema metrico",
                    "example": "12"
                  },
                  "esponente": {
                    "type": "string",
                    "maxLength": 15,
                    "nullable": true,
                    "description": "Da valorizzare se necessario per identificare l'accesso, solo per tipo_operazione='I','R'",
                    "example": "A"
                  },
                  "specificita": {
                    "type": "string",
                    "maxLength": 5,
                    "nullable": true,
                    "description": "da valorizzare se necessario per identificare l'accesso per comuni specifici, solo per tipo_operazione='I','R'",
                    "example": "ROSSO"
                  },
                  "metrico": {
                    "type": "string",
                    "maxLength": 6,
                    "nullable": true,
                    "description": "metrico, da non valorizzare per operazione_civico='S' o accesso identificato con il numero civico",
                    "example": "300"
                  },
                  "sezione_censimento": {
                    "type": "string",
                    "maxLength": 13,
                    "description": "Sezione di censimento, da valorizzare solo per operazione_civico='I','R'",
                    "example": "9"
                  },
                  "operazione_civico": {
                    "type": "string",
                    "maxLength": 1,
                    "description": "Tipo di operazione sull'accesso. 'I'=inserimento, 'R'=aggiornamento, 'S'=soppressione",
                    "example": "R"
                  },
                  "coordinate": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "string",
                        "maxLength": 12,
                        "nullable": true,
                        "description": "Coordinata X, obbligatoria se viene valorizzata Y. (Valori ammessi in Italia 6.0 ≤ x ≤ 18.0)",
                        "example": "13.1022000"
                      },
                      "y": {
                        "type": "string",
                        "maxLength": 12,
                        "nullable": true,
                        "description": "Coordinata Y, obbligatoria se viene valorizzata X. (Valori ammessi in Italia 36.0 ≤ y ≤ 47.0)",
                        "example": "41.8847600"
                      },
                      "z": {
                        "type": "string",
                        "maxLength": 7,
                        "nullable": true,
                        "description": "Quota, da non valorizzare in assenza di X e Y, espressa in metri",
                        "example": "150"
                      },
                      "metodo": {
                        "type": "string",
                        "maxLength": 1,
                        "nullable": true,
                        "description": "Metodo di rilevazione, da non valorizzare in assenza di X e Y",
                        "example": "3"
                      }
                    }
                  },
                  "data_valid_amm": {
                    "type": "string",
                    "nullable": true,
                    "description": "Data di validita' amministrativa, se assente è equiparata alla data corrente, per tipo_operazione=S rappresenta la data di fine validita per le altre operazioni la data di inizio",
                    "example": "08/10/2024"
                  },
                  "isolato": {
                    "type": "string",
                    "maxLength": 4,
                    "nullable": true,
                    "description": "Codice isolato, facoltativo, da valorizzare solo per operazione_civico='I','R'",
                    "example": "101"
                  }
                }
              }
            }
          }
        }
      },
      "RispostaOperazione": {
        "type": "object",
        "properties": {
          "idRichiesta": {
            "type": "string",
            "maxLength": 15,
            "description": "Identificativo assegnato alla richiesta",
            "example": "5144"
          },
          "operazione_civico": {
            "type": "string",
            "maxLength": 1,
            "description": "Tipo di operazione sull'accesso. 'I'=inserimento, 'R'=aggiornamento, 'S'=soppressione",
            "example": "R"
          },
          "esito": {
            "type": "string",
            "description": "Esito dell'operazione",
            "example": "0"
          },
          "messaggio": {
            "type": "string",
            "description": "Messaggio associato all'esito",
            "example": "OK"
          },
          "dati": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "progr_civico": {
                  "type": "string",
                  "maxLength": 15,
                  "description": "Progressivo civico",
                  "example": "1370588"
                },
                "codice_civico_comunale": {
                  "type": "string",
                  "maxLength": 30,
                  "nullable": true,
                  "description": "Codifica comunale dell'accesso",
                  "example": "7569A"
                },
                "numero": {
                  "type": "string",
                  "maxLength": 5,
                  "description": "Numero civico",
                  "example": "12"
                },
                "esponente": {
                  "type": "string",
                  "maxLength": 15,
                  "example": "A"
                },
                "specificita": {
                  "type": "string",
                  "maxLength": 5,
                  "example": "ROSSO"
                },
                "metrico": {
                  "type": "string",
                  "maxLength": 6,
                  "description": "Metrico",
                  "example": "300"
                },
                "sez_censimento": {
                  "type": "string",
                  "description": "Sezione di censimento",
                  "example": "9"
                },
                "data_inizio": {
                  "type": "string",
                  "description": "Data di inizio validità"
                },
                "data_fine": {
                  "type": "string",
                  "description": "Data di fine validità"
                },
                "progr_nazionale": {
                  "type": "string",
                  "description": "Progressivo nazionale",
                  "example": "2000449"
                },
                "codcom": {
                  "type": "string",
                  "description": "Codice comune",
                  "example": "A062"
                },
                "coordinata_x_comune": {
                  "type": "string",
                  "description": "Coordinata X comune",
                  "example": "13.1022001143"
                },
                "coordinata_y_comune": {
                  "type": "string",
                  "description": "Coordinata Y comune",
                  "example": "41.88476233032955"
                },
                "coordinata_z_comune": {
                  "type": "string",
                  "description": "Quota del comune",
                  "example": "0"
                },
                "metodo": {
                  "type": "string",
                  "nullable": true,
                  "example": null
                },
                "data_ini_valid_amm": {
                  "type": "string",
                  "nullable": true,
                  "description": "Data di inizio validità amministrativa.",
                  "example": "08/10/2024"
                },
                "data_fine_valid_amm": {
                  "type": "string",
                  "nullable": true,
                  "description": "Data di fine validità amministrativa.",
                  "example": "08/10/2024"
                },
                "isolato": {
                  "type": "string",
                  "maxLength": 4,
                  "nullable": true,
                  "description": "Codice isolato, facoltativo, da valorizzare solo per operazione_civico='I','R'",
                  "example": "101"
                }
              }
            }
          }
        }
      },
      "RispostaErrore": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Identificativo dell'operazione.",
            "example": "5144"
          },
          "codice": {
            "type": "string",
            "description": "Codice di errore",
            "example": "23"
          },
          "messaggio": {
            "type": "string",
            "description": "Messaggio di errore.",
            "example": "Errore di validazione: [specifica qui il messaggio di errore]"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "description": "A bearer token in the format of a JWS and conformed to the specifications included in [RFC8725](https://tools.ietf.org/html/RFC8725).",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "Agid-JWT-Signature": {
        "type": "apiKey",
        "in": "header",
        "name": "Agid-JWT-Signature",
        "description": "Header della firma di JWS.\nIl valore di questo header è una firma JWS.\nVedere Modi  [integrity_rest_02] Integrità del payload del messaggio REST in PDND"
      },
      "Agid-JWT-TrackingEvidence": {
        "type": "apiKey",
        "in": "header",
        "name": "Agid-JWT-TrackingEvidence",
        "description": "Header della firma di JWS.\nIl valore di questo header è una firma JWS.\nVedere Modi  [audit_rest_02] Inoltro dati tracciati nel dominio del Fruitore REST con correlazione\nClaim da includere:\n    userID, un identificativo univoco dell'utente interno al dominio del fruitore che ha determinato l'esigenza della request di accesso all'e-service dell'erogatore;\n    userLocation, un identificativo univoco della postazione interna al dominio del fruitore da cui è avviata l'esigenza della request di accesso all'e-service dell'erogatore;\n    LoA, livello di sicurezza o di garanzia adottato nel processo di autenticazione informatica nel dominio del fruitore."
      }
    }
  }
}
