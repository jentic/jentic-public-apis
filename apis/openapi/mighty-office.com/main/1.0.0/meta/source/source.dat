{
  "openapi": "3.0.0",
  "servers": [
    {
      "url": "https://www.mighty-office.com",
      "description": "Production server"
    }
  ],
  "info": {
    "description": "REST API to access Mighty-Office features from non-human clients",
    "version": "1.0.0",
    "title": "Mighty API",
    "contact": {
      "email": "service@mighty-office.com"
    },
    "license": {
      "name": "Apache 2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/MIGHTY-OFFICE/mighty-api/1.0.0"
  },
  "tags": [
    {
      "name": "developers",
      "description": "Operations available to regular developers"
    }
  ],
  "paths": {
    "/de/api/user/login": {
      "post": {
        "tags": [
          "developers"
        ],
        "summary": "login",
        "operationId": "login",
        "description": "Provide client_id and client_secret to get access token",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "grant_type": {
                    "type": "string",
                    "description": "client_credentials",
                    "example": "client_credentials"
                  },
                  "client_id": {
                    "type": "string"
                  },
                  "client_secret": {
                    "type": "string"
                  }
                },
                "required": [
                  "grant_type",
                  "client_id",
                  "client_secret"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Returns an authtoken and expiry time in seconds",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string",
                      "format": "uuid",
                      "example": "d290f1ee-6c54-4b01-90e6-d701748f0851"
                    },
                    "token_type": {
                      "type": "string",
                      "example": "Bearer"
                    },
                    "expires": {
                      "type": "integer",
                      "example": 3600
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "bad input parameter"
          }
        }
      }
    },
    "/de/api/form/getfields/{formId}/{includeSubformFields}": {
      "get": {
        "tags": [
          "developers"
        ],
        "summary": "Get Formfields",
        "operationId": "getfields",
        "description": "Provide Field names and descriptions of a form",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "formId",
            "required": true,
            "description": "Pass a formId (Get it from your Project Manager)",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "path",
            "name": "includeSubformFields",
            "required": true,
            "description": "0 or 1 include form definitions of all subforms. default 0",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "token",
            "description": "Authtoken as Authorization Bearer Header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns form fields",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer",
                      "example": 1234
                    },
                    "title": {
                      "type": "string",
                      "example": "Form Title"
                    },
                    "formFields": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "type": {
                            "type": "string",
                            "example": "TEXTFIELD, TEXTAREA, SWITCH, OPTIONDIALOG, IMAGES, DRAWINGS, SHOWFORMANSWER etc."
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "bad input parameter"
          }
        }
      }
    },
    "/de/api/formanswer/read/{formId}/{formanswerId}/{includeSubformAnswers}": {
      "get": {
        "tags": [
          "developers"
        ],
        "summary": "Get one Formanswer",
        "operationId": "formanswer read",
        "description": "Provide one Formanswer with all filled fields",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "formId",
            "required": true,
            "description": "Pass a formId (Get it from your Project Manager)",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "path",
            "name": "formanswerId",
            "required": true,
            "description": "Pass a formanswerId (Get formanswerIds via custom report call)",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "path",
            "name": "includeSubformAnswers",
            "required": true,
            "description": "0 or 1 include subform answers. default is 0",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "token",
            "description": "Authtoken as Authorization Bearer Header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns one formamswer with all filled fields",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "formid": {
                      "type": "integer",
                      "example": 1234
                    },
                    "formtitle": {
                      "type": "string",
                      "example": "Form Title"
                    },
                    "formanswerid": {
                      "type": "integer",
                      "example": 9876
                    },
                    "modified_email": {
                      "type": "string",
                      "example": "tester@mighty-office.com"
                    },
                    "modified": {
                      "type": "string",
                      "example": "2024-03-24 17:29:30"
                    },
                    "formFields": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string",
                            "example": "isAccessible"
                          },
                          "answer": {
                            "type": "string",
                            "example": true
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "bad input parameter"
          }
        }
      }
    },
    "/de/reportexport/json/{reportId}": {
      "get": {
        "tags": [
          "developers"
        ],
        "summary": "Get Output from one Report",
        "operationId": "report",
        "description": "Provide Output of a custom Report as JSON",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "reportId",
            "required": true,
            "description": "Pass a reportId (Get it from your Project Manager)",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "fa.modified",
            "required": false,
            "description": "Pass a filter parameter as string with optional wildcard. Fieldnames depend on report.",
            "schema": {
              "type": "string"
            },
            "example": "2024-03-26%"
          },
          {
            "in": "header",
            "name": "token",
            "description": "Authtoken as Authorization Bearer Header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns output of custom report (fieldnames vary by report)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "integer",
                        "example": 1234
                      },
                      "LocationName": {
                        "type": "string"
                      },
                      "SMNummer": {
                        "type": "integer",
                        "example": 9876
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "bad input parameter"
          }
        }
      }
    },
    "/de/api/formanswer/create/{formId}": {
      "post": {
        "tags": [
          "developers"
        ],
        "summary": "Create one Formanswer",
        "operationId": "formanswer create",
        "description": "Create a new Formanswer",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "formId",
            "required": true,
            "description": "Pass a formId (Get it from your Project Manager)",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "token",
            "description": "Authtoken as Authorization Bearer Header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "fieldname1": {
                    "type": "string"
                  },
                  "fieldname2": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Returns one formamswer with id, number of fields, result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "formanswerid": {
                      "type": "integer",
                      "example": 1234
                    },
                    "fields": {
                      "type": "integer",
                      "example": 12
                    },
                    "result": {
                      "type": "string",
                      "example": "Answer created"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "bad input parameter"
          }
        }
      }
    },
    "/de/fileraw/image/{urlslug}/{filetoken}": {
      "get": {
        "tags": [
          "developers"
        ],
        "summary": "Get raw Image",
        "operationId": "fileraw",
        "description": "Get raw Image",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "urlslug",
            "required": true,
            "description": "Pass an urlslug for that file",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "filetoken",
            "required": true,
            "description": "Pass a filetoken for that file",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns raw image",
            "content": {
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "bad input parameter"
          }
        }
      }
    },
    "/de/fileraw/attachment/{urlslug}/{filetoken}": {
      "get": {
        "tags": [
          "developers"
        ],
        "summary": "Get raw Document",
        "operationId": "filerawdocument",
        "description": "Get raw Document",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "urlslug",
            "required": true,
            "description": "Pass an urlslug for that file",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "filetoken",
            "required": true,
            "description": "Pass a filetoken for that file",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns raw document",
            "content": {
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "bad input parameter"
          }
        }
      }
    },
    "/de/api/file/upload": {
      "post": {
        "tags": [
          "developers"
        ],
        "summary": "Upload a staging csv file",
        "operationId": "file upload",
        "description": "Upload a staging csv file",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "header",
            "name": "subject",
            "required": true,
            "description": "Pass a subject (Get it from your Project Manager)",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "token",
            "description": "Authtoken as Authorization Bearer Header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Returns status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "bad input parameter"
          }
        }
      }
    },
    "/de/api/file/create": {
      "post": {
        "tags": [
          "developers"
        ],
        "summary": "Upload a file to an object (image or document)",
        "operationId": "create file",
        "description": "Upload a file to an object (image or document)",
        "consumes": [
          "application/x-www-form-urlencoded"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "header",
            "name": "token",
            "description": "Authtoken as Authorization Bearer Header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "object_type": {
                    "type": "string"
                  },
                  "object_id": {
                    "type": "integer"
                  },
                  "filename": {
                    "type": "string"
                  },
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                },
                "required": [
                  "object_type",
                  "object_id",
                  "filename",
                  "file"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Returns status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "bad input parameter"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ]
}
