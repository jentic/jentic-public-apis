{
  "openapi": "3.0.3",
  "info": {
    "title": "SmartHub User API",
    "version": "1.0.0",
    "description": "User-level API for EP Residuals integration with SmartHub.\n\n## Authentication\nRequires dual-token authentication:\n- **Apigee OAuth2**: Application authorization (Authorization header)\n- **PingOne JWT**: User identity (X-PingOne-JWT header)\n\n## Authorization Model\nUses existing SmartHub permissions:\n- **Access**: Can use API\n- **AccessProjects**: Can see projects\n- **ManageFiles**: Can create folders/upload files\n- **ViewFiles**: Can list/view files\n\n## Hub Structure\n```\nEP Residuals Hub\n  ├─ Apple (Project/Studio)\n  │  └─ Folders → Files\n  ├─ Sony Pictures (Project/Studio)\n  │  └─ Folders → Files\n  └─ NBC Universal (Project/Studio)\n     └─ Folders → Files\n```\n\n## Key Features\n- Folder-level ticket metadata (ticketNumber in fields)\n- Nested folder creation (e.g., \"2024/Q4/Residuals\")\n- File upload with metadata\n- View files via SmartHub viewer URL\n",
    "contact": {
      "name": "EP SmartHub Team",
      "email": "bsinha@ep.com"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/some-75e/smarthub.user.api/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.ep.com/sc/api/smarthub/user/v1",
      "description": "Production (via Apigee)"
    }
  ],
  "security": [
    {
      "ApigeeOAuth": [],
      "PingOneJWT": []
    }
  ],
  "tags": [
    {
      "name": "Projects",
      "description": "Studio/project discovery"
    },
    {
      "name": "Folders",
      "description": "Folder browsing and management"
    },
    {
      "name": "Files",
      "description": "File upload and metadata"
    }
  ],
  "paths": {
    "/projects": {
      "get": {
        "tags": [
          "Projects"
        ],
        "summary": "List accessible studios",
        "description": "Returns studios (projects) user has access to in EP Residuals Hub.\n\n**Access Control**: User only sees projects they have project_access permission for.\n",
        "operationId": "listProjects",
        "parameters": [
          {
            "name": "hubId",
            "in": "query",
            "description": "Filter by hub ID",
            "schema": {
              "type": "string",
              "default": "hub_ep_residuals"
            },
            "example": "hub_ep_residuals"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectEnvelope"
                },
                "example": {
                  "resourceList": [
                    {
                      "id": "proj_residuals_sony",
                      "title": "Sony Pictures",
                      "studioId": "hub_ep_residuals",
                      "clientIds": [
                        "SONY_001"
                      ]
                    },
                    {
                      "id": "proj_residuals_apple",
                      "title": "Apple",
                      "studioId": "hub_ep_residuals",
                      "clientIds": [
                        "APPLE_001"
                      ]
                    }
                  ],
                  "totalCount": 2
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/projects/{projectId}/folders": {
      "get": {
        "tags": [
          "Folders"
        ],
        "summary": "Get library root folders",
        "description": "Returns root-level folders for a project (library roots, not EP App Folders)",
        "operationId": "getProjectRootFolders",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProjectId"
          }
        ],
        "responses": {
          "200": {
            "description": "Root folders",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FolderEnvelope"
                },
                "example": {
                  "resourceList": [
                    {
                      "id": "folder_sony_root",
                      "foldername": "Sony Pictures",
                      "parentId": "media_root_sony",
                      "path": "/Sony Pictures"
                    }
                  ],
                  "totalCount": 1
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/folders/{folderId}/folders": {
      "get": {
        "tags": [
          "Folders"
        ],
        "summary": "Browse child folders",
        "description": "Returns child folders within a parent folder",
        "operationId": "getSubfolders",
        "parameters": [
          {
            "$ref": "#/components/parameters/FolderId"
          },
          {
            "$ref": "#/components/parameters/PageSize"
          },
          {
            "$ref": "#/components/parameters/PageNumber"
          }
        ],
        "responses": {
          "200": {
            "description": "Child folders",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FolderEnvelope"
                },
                "example": {
                  "resourceList": [
                    {
                      "id": "folder_the_crown",
                      "foldername": "The Crown",
                      "parentId": "folder_sony_root",
                      "path": "/Sony Pictures/The Crown",
                      "fields": {
                        "ticketNumber": "RES-12345"
                      }
                    }
                  ],
                  "totalCount": 1,
                  "pageNumber": 1,
                  "pageSize": 200
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "post": {
        "tags": [
          "Folders"
        ],
        "summary": "Create folder with metadata",
        "description": "Creates folder(s) under parent. \n\n**Features**:\n- Supports nested paths (e.g., \"2024/Q4/Residuals\")\n- Returns existing folder if already exists (idempotent)\n- Stores metadata on deepest folder created\n\n**Security**: User must have ManageFiles permission\n",
        "operationId": "createFolder",
        "parameters": [
          {
            "$ref": "#/components/parameters/FolderId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FolderCreateRequest"
              },
              "examples": {
                "single": {
                  "summary": "Single folder",
                  "value": {
                    "foldername": "The Crown",
                    "fields": {
                      "ticketNumber": "RES-12345"
                    }
                  }
                },
                "nested": {
                  "summary": "Nested folder structure",
                  "value": {
                    "foldername": "2024/Q4/Residuals",
                    "fields": {
                      "ticketNumber": "RES-12345",
                      "showName": "The Crown"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Folder created or already exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FolderEnvelope"
                },
                "example": {
                  "resource": {
                    "id": "folder_crown_q4",
                    "foldername": "Residuals",
                    "parentId": "folder_crown_2024_q4",
                    "path": "/Sony Pictures/The Crown/2024/Q4/Residuals",
                    "fields": {
                      "ticketNumber": "RES-12345"
                    }
                  },
                  "message": "Folder created successfully"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/folders/{folderId}": {
      "get": {
        "tags": [
          "Folders"
        ],
        "summary": "Get folder details",
        "description": "Returns folder metadata including custom fields",
        "operationId": "getFolder",
        "parameters": [
          {
            "$ref": "#/components/parameters/FolderId"
          }
        ],
        "responses": {
          "200": {
            "description": "Folder details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FolderEnvelope"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "put": {
        "tags": [
          "Folders"
        ],
        "summary": "Update folder metadata",
        "description": "Updates folder custom fields (e.g., ticketNumber).\n\n**Behavior**: Merges with existing fields\n\n**Use Case**: Add/change ticket mapping on existing folder\n\n**Security**: User must have ManageFiles permission\n",
        "operationId": "updateFolder",
        "parameters": [
          {
            "$ref": "#/components/parameters/FolderId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FolderUpdateRequest"
              },
              "example": {
                "fields": {
                  "ticketNumber": "RES-12345"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Folder updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FolderEnvelope"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/folders/{folderId}/files": {
      "get": {
        "tags": [
          "Files"
        ],
        "summary": "List files in folder",
        "description": "Returns files within a folder",
        "operationId": "listFiles",
        "parameters": [
          {
            "$ref": "#/components/parameters/FolderId"
          },
          {
            "name": "metadata",
            "in": "query",
            "description": "Include file metadata",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "$ref": "#/components/parameters/PageSize"
          },
          {
            "$ref": "#/components/parameters/PageNumber"
          }
        ],
        "responses": {
          "200": {
            "description": "Files in folder",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileEnvelope"
                },
                "example": {
                  "resourceList": [
                    {
                      "id": "file_res_001",
                      "filename": "residuals_q4_2024.pdf",
                      "parentId": "folder_crown_q4",
                      "uploadDate": "2024-12-15T10:30:00Z",
                      "uploadedBy": "Sarah Johnson",
                      "documentType": "Residuals Report",
                      "documentLabel": "Q4 2024 Residuals"
                    }
                  ],
                  "totalCount": 1
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "post": {
        "tags": [
          "Files"
        ],
        "summary": "Upload file",
        "description": "Uploads file to folder.\n\n**File Overwrite Modes**:\n- `0`: Reject if exists (first wins)\n- `1`: Overwrite existing (last wins) - **replaces file, no versioning**\n- `2`: Auto-rename (adds suffix _1, _2, etc.)\n- `null`: Default (overwrite)\n\n**Optional**: Set `path` in info to auto-create folder structure\n\n**Note**: ticketNumber NOT stored on file (folder-level only)\n\n**Security**: User must have ManageFiles permission\n",
        "operationId": "uploadFile",
        "parameters": [
          {
            "$ref": "#/components/parameters/FolderId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "info": {
                    "type": "string",
                    "description": "JSON string of FileUploadInfo",
                    "example": "{\"fileOverwriteMode\":1,\"documentType\":\"Residuals Report\",\"documentLabel\":\"Q4 2024\"}"
                  },
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "Binary file data"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "File uploaded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileEnvelope"
                },
                "example": {
                  "resource": {
                    "id": "file_res_001",
                    "filename": "residuals_q4_2024.pdf",
                    "parentId": "folder_crown_q4",
                    "uploadDate": "2024-12-15T10:30:00Z",
                    "uploadedBy": "Sarah Johnson",
                    "documentType": "Residuals Report"
                  },
                  "message": "File uploaded successfully"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    },
    "/files/{fileId}": {
      "get": {
        "tags": [
          "Files"
        ],
        "summary": "Get file metadata",
        "description": "Returns file metadata without binary content.\n\n**To view file**: Open `https://scenechronize.com/viewer/{fileId}` in browser\n\nThis provides native SmartHub viewer with preview, annotations, and watermarking.\n",
        "operationId": "getFileMetadata",
        "parameters": [
          {
            "$ref": "#/components/parameters/FileId"
          }
        ],
        "responses": {
          "200": {
            "description": "File metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileEnvelope"
                },
                "example": {
                  "resource": {
                    "id": "file_res_001",
                    "filename": "residuals_q4_2024.pdf",
                    "parentId": "folder_crown_q4",
                    "uploadDate": "2024-12-15T10:30:00Z",
                    "uploadedBy": "Sarah Johnson",
                    "documentType": "Residuals Report"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApigeeOAuth": {
        "type": "oauth2",
        "description": "Apigee OAuth2 client credentials for application authorization.\n\n**Token Endpoint**: `https://apigee.ep.com/oauth/token`\n\n**Lifetime**: 1 hour (cache and reuse)\n",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://apigee.ep.com/oauth/token",
            "scopes": {}
          }
        }
      },
      "PingOneJWT": {
        "type": "apiKey",
        "in": "header",
        "name": "X-PingOne-JWT",
        "description": "PingOne user JWT token for user identity.\n\n**Contains**: pingUUID, session_id, user claims\n\n**Validated by**: Apigee (signature + session check)\n\n**Lifetime**: ~8 hours\n"
      }
    },
    "parameters": {
      "ProjectId": {
        "name": "projectId",
        "in": "path",
        "required": true,
        "description": "Project (studio) ID",
        "schema": {
          "type": "string"
        },
        "example": "proj_residuals_sony"
      },
      "FolderId": {
        "name": "folderId",
        "in": "path",
        "required": true,
        "description": "Folder ID",
        "schema": {
          "type": "string"
        },
        "example": "folder_crown_q4"
      },
      "FileId": {
        "name": "fileId",
        "in": "path",
        "required": true,
        "description": "File ID",
        "schema": {
          "type": "string"
        },
        "example": "file_res_001"
      },
      "PageSize": {
        "name": "pageSize",
        "in": "query",
        "description": "Results per page",
        "schema": {
          "type": "integer",
          "default": 200,
          "maximum": 200,
          "minimum": 1
        }
      },
      "PageNumber": {
        "name": "pageNumber",
        "in": "query",
        "description": "Page number (1-indexed)",
        "schema": {
          "type": "integer",
          "default": 1,
          "minimum": 1
        }
      }
    },
    "schemas": {
      "ProjectResource": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Project ID",
            "example": "proj_residuals_sony"
          },
          "title": {
            "type": "string",
            "description": "Project/studio name",
            "example": "Sony Pictures"
          },
          "studioId": {
            "type": "string",
            "description": "Parent hub ID",
            "example": "hub_ep_residuals"
          },
          "clientIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Client IDs for this studio"
          }
        }
      },
      "FolderResource": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Folder ID",
            "example": "folder_crown_q4"
          },
          "foldername": {
            "type": "string",
            "description": "Folder name",
            "example": "Residuals"
          },
          "parentId": {
            "type": "string",
            "description": "Parent folder ID",
            "example": "folder_crown_2024_q4"
          },
          "path": {
            "type": "string",
            "description": "Full folder path from root",
            "example": "/Sony Pictures/The Crown/2024/Q4/Residuals"
          },
          "fields": {
            "type": "object",
            "additionalProperties": true,
            "description": "Custom metadata (e.g., ticketNumber)",
            "example": {
              "ticketNumber": "RES-12345",
              "showName": "The Crown"
            }
          }
        }
      },
      "FileResource": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "File ID"
          },
          "filename": {
            "type": "string",
            "description": "File name"
          },
          "parentId": {
            "type": "string",
            "description": "Parent folder ID"
          },
          "path": {
            "type": "string",
            "description": "Full file path"
          },
          "uploadDate": {
            "type": "string",
            "format": "date-time",
            "description": "Upload timestamp"
          },
          "uploadedBy": {
            "type": "string",
            "description": "User who uploaded"
          },
          "documentType": {
            "type": "string",
            "description": "Document type (e.g., Residuals Report)"
          },
          "documentLabel": {
            "type": "string",
            "description": "Document label/title"
          },
          "documentDate": {
            "type": "string",
            "format": "date",
            "description": "Document date"
          },
          "notes": {
            "type": "string",
            "description": "Additional notes"
          }
        }
      },
      "FolderCreateRequest": {
        "type": "object",
        "required": [
          "foldername"
        ],
        "properties": {
          "foldername": {
            "type": "string",
            "description": "Folder name or nested path (e.g., \"2024/Q4/Residuals\")",
            "example": "2024/Q4/Residuals"
          },
          "fields": {
            "type": "object",
            "additionalProperties": true,
            "description": "Custom metadata",
            "example": {
              "ticketNumber": "RES-12345"
            }
          }
        }
      },
      "FolderUpdateRequest": {
        "type": "object",
        "properties": {
          "fields": {
            "type": "object",
            "additionalProperties": true,
            "description": "Custom metadata to merge with existing",
            "example": {
              "ticketNumber": "RES-12345"
            }
          }
        }
      },
      "FileUploadInfo": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Optional folder path to create (e.g., \"2024/Q4\")"
          },
          "filename": {
            "type": "string",
            "description": "File name (optional, defaults to uploaded filename)"
          },
          "fileOverwriteMode": {
            "type": "integer",
            "enum": [
              0,
              1,
              2
            ],
            "description": "File overwrite behavior:\n- 0: Reject if exists\n- 1: Overwrite (default)\n- 2: Auto-rename\n"
          },
          "documentType": {
            "type": "string",
            "description": "Document type",
            "example": "Residuals Report"
          },
          "documentLabel": {
            "type": "string",
            "description": "Document label",
            "example": "Q4 2024 Residuals"
          },
          "documentDate": {
            "type": "string",
            "format": "date",
            "description": "Document date"
          },
          "notes": {
            "type": "string",
            "description": "Additional notes"
          }
        }
      },
      "Envelope": {
        "type": "object",
        "description": "Standard SmartHub response wrapper",
        "properties": {
          "resource": {
            "type": "object",
            "description": "Single resource (for POST/PUT/GET single)"
          },
          "resourceList": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Multiple resources (for GET list)"
          },
          "totalCount": {
            "type": "integer",
            "description": "Total count of results"
          },
          "pageNumber": {
            "type": "integer",
            "description": "Current page number"
          },
          "pageSize": {
            "type": "integer",
            "description": "Results per page"
          },
          "message": {
            "type": "string",
            "description": "Response message"
          }
        }
      },
      "ProjectEnvelope": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Envelope"
          },
          {
            "type": "object",
            "properties": {
              "resourceList": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ProjectResource"
                }
              }
            }
          }
        ]
      },
      "FolderEnvelope": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Envelope"
          },
          {
            "type": "object",
            "properties": {
              "resource": {
                "$ref": "#/components/schemas/FolderResource"
              },
              "resourceList": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/FolderResource"
                }
              }
            }
          }
        ]
      },
      "FileEnvelope": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Envelope"
          },
          {
            "type": "object",
            "properties": {
              "resource": {
                "$ref": "#/components/schemas/FileResource"
              },
              "resourceList": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/FileResource"
                }
              }
            }
          }
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "Human-readable error message"
          },
          "errorCode": {
            "type": "string",
            "description": "Machine-readable error code"
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "examples": {
              "invalid_folder": {
                "value": {
                  "message": "Folder ID is required",
                  "errorCode": "INVALID_FOLDER_ID"
                }
              },
              "empty_filename": {
                "value": {
                  "message": "Filename cannot be empty",
                  "errorCode": "EMPTY_FILENAME"
                }
              }
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Authentication failed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "examples": {
              "invalid_token": {
                "value": {
                  "message": "JWT token invalid or expired",
                  "errorCode": "INVALID_TOKEN"
                }
              },
              "user_not_found": {
                "value": {
                  "message": "User not found or inactive",
                  "errorCode": "USER_NOT_FOUND"
                }
              }
            }
          }
        }
      },
      "Forbidden": {
        "description": "Authorization failed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "examples": {
              "api_access_disabled": {
                "value": {
                  "message": "API access not enabled for this user",
                  "errorCode": "API_ACCESS_DISABLED"
                }
              },
              "missing_permission": {
                "value": {
                  "message": "User lacks required permission",
                  "errorCode": "MISSING_PERMISSION"
                }
              },
              "client_not_authorized": {
                "value": {
                  "message": "Client not authorized for this user",
                  "errorCode": "CLIENT_NOT_AUTHORIZED"
                }
              }
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "message": "Resource not found",
              "errorCode": "RESOURCE_NOT_FOUND"
            }
          }
        }
      },
      "Conflict": {
        "description": "Resource conflict",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "message": "File already exists (use fileOverwriteMode to overwrite or rename)",
              "errorCode": "FILE_EXISTS"
            }
          }
        }
      }
    }
  }
}
