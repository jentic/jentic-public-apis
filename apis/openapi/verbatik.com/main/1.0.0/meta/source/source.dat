  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "vb_live_…"
      }
    },
    "parameters": {
      "ResourceId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": false,
        "description": "Unique key for safely retrying this POST. Cached for 24 hours.",
        "schema": {
          "type": "string",
          "maxLength": 255
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Invalid or missing API key",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Missing scope or API entitlement",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "RateLimited": {
        "description": "Rate or concurrency limit exceeded",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "type",
              "message"
            ],
            "properties": {
              "type": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "request_id": {
                "type": "string"
              },
              "details": {}
            }
          }
        }
      },
      "List": {
        "type": "object",
        "required": [
          "object",
          "data"
        ],
        "properties": {
          "object": {
            "const": "list"
          },
          "data": {
            "type": "array",
            "items": {}
          },
          "has_more": {
            "type": "boolean"
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "PresetVoice": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "matthew-en-us"
          },
          "label": {
            "type": "string",
            "example": "Matthew"
          },
          "name": {
            "type": "string"
          },
          "gender": {
            "type": [
              "string",
              "null"
            ]
          },
          "language_code": {
            "type": "string",
            "example": "en-US"
          },
          "language_name": {
            "type": "string",
            "example": "English (United States)"
          },
          "is_neural": {
            "type": "boolean"
          },
          "sample_url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "styles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "CreateGeneration": {
        "type": "object",
        "required": [
          "mode",
          "model",
          "prompt"
        ],
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "image",
              "video",
              "audio"
            ]
          },
          "model": {
            "type": "string",
            "example": "fal-ai/flux-pro/kontext/text-to-image"
          },
          "prompt": {
            "type": "string"
          },
          "persona_id": {
            "type": "string",
            "format": "uuid",
            "description": "Optional reusable persona for image/video."
          },
          "input": {
            "type": "object",
            "properties": {
              "reference_images": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "start_frame": {
                "type": "array",
                "maxItems": 1,
                "items": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "end_frame": {
                "type": "array",
                "maxItems": 1,
                "items": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "image_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "video_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "audio_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "video": {
                "type": "array",
                "maxItems": 1,
                "items": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "character": {
                "type": "array",
                "maxItems": 1,
                "items": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "motion_video": {
                "type": "array",
                "maxItems": 1,
                "items": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          },
          "parameters": {
            "type": "object",
            "properties": {
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16
              },
              "size": {
                "type": "string"
              },
              "aspect_ratio": {
                "type": "string"
              },
              "quality": {
                "type": "string"
              },
              "duration": {
                "type": "string"
              },
              "resolution": {
                "type": "string"
              },
              "voice": {
                "type": "string",
                "description": "A preset id from /v1/voices/catalog for this model, or a custom voice resource id for Speech Cloning."
              },
              "speed": {
                "type": "string"
              },
              "loop": {
                "type": "boolean"
              },
              "lyrics": {
                "type": "string"
              },
              "language_boost": {
                "type": "string"
              }
            }
          },
          "delivery": {
            "type": "string",
            "enum": [
              "public_url",
              "signed_url"
            ],
            "default": "public_url"
          }
        }
      },
      "Generation": {
        "type": "object",
        "required": [
          "id",
          "object",
          "status",
          "mode",
          "model"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "object": {
            "const": "generation"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "completed",
              "partially_completed",
              "failed"
            ]
          },
          "mode": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "output_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "media_type": {
                  "type": "string"
                },
                "expires_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          },
          "estimated_credits": {
            "type": "integer"
          }
        }
      },
      "CreateSpeechGeneration": {
        "type": "object",
        "required": [
          "model",
          "blocks"
        ],
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "verbatik/speech-lite",
              "fal-ai/minimax/speech-2.8-turbo"
            ]
          },
          "blocks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "type": "object",
              "required": [
                "text"
              ],
              "properties": {
                "text": {
                  "type": "string"
                },
                "voice": {
                  "type": "string",
                  "description": "A preset id from /v1/voices/catalog for this model, or a custom voice resource id for Speech Cloning."
                }
              }
            }
          },
          "settings": {
            "type": "object",
            "properties": {
              "volume": {
                "type": "number",
                "minimum": 0.1,
                "maximum": 10,
                "default": 1
              },
              "speed": {
                "type": "number",
                "minimum": 0.5,
                "maximum": 2,
                "default": 1
              },
              "loudness_normalization": {
                "type": "boolean",
                "default": true
              },
              "text_normalization": {
                "type": "boolean",
                "default": false
              },
              "tag_compatible": {
                "type": "boolean",
                "default": true
              }
            }
          },
          "delivery": {
            "type": "string",
            "enum": [
              "public_url",
              "signed_url"
            ],
            "default": "public_url"
          }
        }
      },
      "SpeechGeneration": {
        "type": "object",
        "required": [
          "id",
          "object",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "object": {
            "const": "speech_generation"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "completed",
              "failed"
            ]
          },
          "model": {
            "type": "string"
          },
          "line_count": {
            "type": "integer"
          },
          "character_count": {
            "type": "integer"
          },
          "estimated_credits": {
            "type": "integer"
          },
          "duration_seconds": {
            "type": [
              "number",
              "null"
            ]
          },
          "output": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "media_type": {
                    "type": "string"
                  },
                  "expires_at": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            ]
          }
        }
      },
      "CreateAgentRun": {
        "type": "object",
        "required": [
          "brief"
        ],
        "properties": {
          "brief": {
            "type": "string"
          },
          "source_images": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "priority": {
            "type": "string",
            "enum": [
              "quality",
              "balanced",
              "cost",
              "speed"
            ],
            "default": "balanced"
          },
          "direction_strategy": {
            "type": "string",
            "enum": [
              "best",
              "multiple"
            ],
            "default": "best"
          },
          "auto_approve": {
            "type": "boolean",
            "default": false
          },
          "max_credits": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "AgentRun": {
        "type": "object",
        "required": [
          "id",
          "object",
          "status",
          "plan"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "object": {
            "const": "agent_run"
          },
          "status": {
            "type": "string"
          },
          "plan": {
            "type": "object"
          },
          "estimated_credits": {
            "type": "integer"
          },
          "max_credits": {
            "type": "integer"
          },
          "reserved_credits": {
            "type": "integer"
          },
          "spent_credits": {
            "type": "integer"
          },
          "auto_approval_error": {
            "type": "string",
            "description": "Present when a plan was created but the requested automatic approval could not be applied."
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "CreateVoice": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "kind",
              "name",
              "audio_url"
            ],
            "properties": {
              "kind": {
                "const": "clone"
              },
              "name": {
                "type": "string"
              },
              "audio_url": {
                "type": "string",
                "format": "uri"
              },
              "preview_text": {
                "type": "string"
              },
              "noise_reduction": {
                "type": "boolean"
              },
              "volume_normalization": {
                "type": "boolean"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "kind",
              "name",
              "description"
            ],
            "properties": {
              "kind": {
                "const": "design"
              },
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "preview_text": {
                "type": "string"
              }
            }
          }
        ]
      },
      "Voice": {
        "type": "object",
        "required": [
          "id",
          "object",
          "name",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "object": {
            "const": "voice"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "clone",
              "design"
            ]
          },
          "preview_url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          }
        }
      },
      "CreatePersona": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "source",
              "name",
              "reference_images"
            ],
            "properties": {
              "source": {
                "const": "upload"
              },
              "name": {
                "type": "string"
              },
              "reference_images": {
                "type": "array",
                "minItems": 1,
                "maxItems": 5,
                "items": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "shared": {
                "type": "boolean"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "source",
              "name",
              "description"
            ],
            "properties": {
              "source": {
                "const": "describe"
              },
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "shared": {
                "type": "boolean"
              }
            }
          }
        ]
      },
      "Persona": {
        "type": "object",
        "required": [
          "id",
          "object",
          "name",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "object": {
            "const": "persona"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "ready",
              "failed"
            ]
          },
          "preview_url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "reference_images": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      },
      "CreateWebhook": {
        "type": "object",
        "required": [
          "url",
          "events"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "description": {
            "type": "string"
          },
          "events": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "generation.completed",
                "generation.failed",
                "agent.review_required",
                "agent.completed",
                "agent.failed",
                "voice.created",
                "persona.ready",
                "persona.failed"
              ]
            }
          }
        }
      }
    }
  }
}
