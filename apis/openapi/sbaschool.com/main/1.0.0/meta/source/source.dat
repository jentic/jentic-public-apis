{
  "openapi": "3.0.3",
  "info": {
    "title": "SBA School Management System API",
    "description": "RESTful API for Ghana Education Service (GES) School-Based Assessment management system.\n\n**Features:**\n- Dashboard overview with real-time stats\n- Assessment creation and score entry\n- Class and subject management\n- Curriculum standards mapping\n- Report card generation\n",
    "contact": {
      "name": "API Support",
      "email": "support@sbaschool.com"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    },
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/narellallc-676/sba-school-management-system-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.sbaschool.com/v1",
      "description": "Production server"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Dashboard",
      "description": "Overview dashboard statistics and analytics"
    },
    {
      "name": "Assessments",
      "description": "Assessment creation, management, and score entry"
    },
    {
      "name": "Classes",
      "description": "Class and student management"
    },
    {
      "name": "Curriculum",
      "description": "GES curriculum standards and indicators"
    },
    {
      "name": "Reports",
      "description": "Report card generation and export"
    }
  ],
  "paths": {
    "/dashboard/overview": {
      "get": {
        "tags": [
          "Dashboard"
        ],
        "summary": "Get dashboard overview",
        "description": "**SCREEN: Dashboard - Overview Tab**\n\nReturns all data needed for the main dashboard overview screen in a single API call.\n\n**Includes:**\n- Overall statistics (total students, active assessments, avg SBA score, completion rate)\n- Assessment completion breakdown (completed, in progress, not started)\n- Performance by grade level\n- Subject performance comparison\n- Recent teacher activities\n- Students requiring attention (scoring below threshold)\n\n**Used by:** Main dashboard screen when user first logs in or switches terms\n",
        "operationId": "getDashboardOverview",
        "parameters": [
          {
            "name": "term",
            "in": "query",
            "description": "Academic term number (1, 2, or 3). Defaults to current term.",
            "required": false,
            "schema": {
              "type": "integer",
              "example": 1,
              "enum": [
                1,
                2,
                3
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Dashboard data retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardOverview"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/classes/all": {
      "get": {
        "tags": [
          "Classes"
        ],
        "summary": "Get all classes",
        "description": "**SCREEN: Enter Assessment Modal - Class Selection**\n\nReturns list of all classes across all grades for dropdown selection.\nUsed when creating a new assessment to select which class to assess.\n\n**Used by:** Assessment creation modal - Class dropdown\n",
        "operationId": "getAllClasses",
        "responses": {
          "200": {
            "description": "Classes retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/inline_response_200"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/subjects": {
      "get": {
        "tags": [
          "Classes"
        ],
        "summary": "Get all subjects",
        "description": "**SCREEN: Enter Assessment Modal - Subject Selection**\n\nReturns list of all subjects available in the school.\nUsed for subject dropdown when creating assessments.\n\n**Used by:** Assessment creation modal - Subject dropdown\n",
        "operationId": "getAllSubjects",
        "responses": {
          "200": {
            "description": "Subjects retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/inline_response_200_1"
                }
              }
            }
          }
        }
      }
    },
    "/curriculum/{grade}/{subject}": {
      "get": {
        "tags": [
          "Curriculum"
        ],
        "summary": "Get curriculum standards for autocomplete",
        "description": "**SCREEN: Enter Assessment Modal - Indicator Search/Autocomplete**\n\nReturns GES curriculum framework for a specific grade and subject.\nUsed to populate the indicator autocomplete search when creating assessments.\n\n**Hierarchy:**\n- Strands (e.g., Number, Geometry)\n- Sub-strands (e.g., Fractions, Whole Numbers)\n- Learning Indicators (e.g., B5.1.2.1.1 - Identify fractions)\n\n**Used by:** Assessment creation modal - Indicator autocomplete search\n",
        "operationId": "getCurriculumStandards",
        "parameters": [
          {
            "name": "grade",
            "in": "path",
            "description": "Grade level (P1-P6, JHS1-JHS3, KG1-KG2)",
            "required": true,
            "schema": {
              "type": "string",
              "example": "P5"
            }
          },
          {
            "name": "subject",
            "in": "path",
            "description": "Subject name",
            "required": true,
            "schema": {
              "type": "string",
              "example": "Mathematics"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Curriculum standards retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurriculumFramework"
                }
              }
            }
          },
          "404": {
            "description": "Curriculum not found for grade/subject"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/assessments": {
      "post": {
        "tags": [
          "Assessments"
        ],
        "summary": "Create new assessment",
        "description": "**SCREEN: Enter Assessment Modal - Submit**\n\nCreates a new assessment record with curriculum mapping.\nCalled when user clicks \"Create & Enter Scores\" button.\n\n**Flow:**\n1. User fills form (class, subject, type, title, date, max score)\n2. User selects curriculum indicators via autocomplete\n3. User clicks \"Create & Enter Scores\"\n4. This API creates the assessment\n5. Response includes assessmentId needed for score entry\n\n**Used by:** Assessment creation modal - Submit button\n",
        "operationId": "createAssessment",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAssessmentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Assessment created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateAssessmentResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/classes/grouped": {
      "get": {
        "tags": [
          "Classes"
        ],
        "summary": "Get all classes grouped by grade",
        "description": "**SCREEN: Manage Assessments - Screen 1 (All Classes List)**\n\nReturns all classes in the school grouped by grade level.\nShows class name, teacher, student count, and subject completion status.\n\n**Grouping:**\n- Kindergarten (KG1, KG2)\n- Primary 1-6\n- JHS 1-3\n\n**Used by:** Manage Assessments screen - Class selection list\n",
        "operationId": "getClassesGrouped",
        "parameters": [
          {
            "name": "term",
            "in": "query",
            "description": "Academic term (defaults to current)",
            "required": false,
            "schema": {
              "type": "integer",
              "enum": [
                1,
                2,
                3
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Classes retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClassesGroupedResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/classes/{classId}/subjects": {
      "get": {
        "tags": [
          "Classes"
        ],
        "summary": "Get subjects for a specific class",
        "description": "**SCREEN: Manage Assessments - Screen 2 (Subject List)**\n\nReturns all subjects for a selected class with completion status.\nShows required assessment count, created count, completion percentage, and Final SBA status.\n\n**Displayed Info:**\n- Subject name\n- Required assessments (e.g., Math requires 10)\n- Created assessments (e.g., 10/10)\n- Score entry completion (e.g., 10/10 complete)\n- Final SBA status (calculated/not calculated)\n\n**Used by:** Manage Assessments - After selecting a class (e.g., P5B)\n",
        "operationId": "getClassSubjects",
        "parameters": [
          {
            "name": "classId",
            "in": "path",
            "description": "Class ID (e.g., P5B, JHS2A)",
            "required": true,
            "schema": {
              "type": "string",
              "example": "P5B"
            }
          },
          {
            "name": "term",
            "in": "query",
            "description": "Academic term",
            "required": false,
            "schema": {
              "type": "integer",
              "enum": [
                1,
                2,
                3
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Subjects retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClassSubjectsResponse"
                }
              }
            }
          },
          "404": {
            "description": "Class not found"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/classes/{classId}/subjects/{subject}/assessments": {
      "get": {
        "tags": [
          "Assessments"
        ],
        "summary": "Get all assessments for class + subject",
        "description": "**SCREEN: Manage Assessments - Screen 3 (Assessment List)**\n\nReturns all assessments for a specific class and subject.\nCan be grouped by type (Classwork, Homework, Projects, Tests) or date.\n\n**Displayed Info:**\n- Assessment title, type, date\n- Max score\n- Score entry status (e.g., 45/45 complete)\n- Average score and percentage\n- Curriculum mapping (strand, substrand, indicators)\n\n**Grouping Options:**\n- By Type: Groups assessments as Classwork (5), Homework (2), etc.\n- By Date: Groups by week/month\n- By Status: Complete vs Incomplete\n\n**Used by:** Manage Assessments - After selecting subject (e.g., P5B → Mathematics)\n",
        "operationId": "getClassSubjectAssessments",
        "parameters": [
          {
            "name": "classId",
            "in": "path",
            "description": "Class ID",
            "required": true,
            "schema": {
              "type": "string",
              "example": "P5B"
            }
          },
          {
            "name": "subject",
            "in": "path",
            "description": "Subject name",
            "required": true,
            "schema": {
              "type": "string",
              "example": "Mathematics"
            }
          },
          {
            "name": "groupBy",
            "in": "query",
            "description": "How to group assessments",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "type",
                "date",
                "status"
              ],
              "default": "type"
            }
          },
          {
            "name": "sortBy",
            "in": "query",
            "description": "Sort order",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "date_desc",
                "date_asc",
                "name_asc",
                "name_desc"
              ],
              "default": "date_desc"
            }
          },
          {
            "name": "term",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "enum": [
                1,
                2,
                3
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Assessments retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssessmentsListResponse"
                }
              }
            }
          },
          "404": {
            "description": "Class or subject not found"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/classes/{classId}/students": {
      "get": {
        "tags": [
          "Classes"
        ],
        "summary": "Get students in a class",
        "description": "**SCREEN: Score Entry Modal - Student List**\n\nReturns all students in a class for score entry.\nCalled when opening score entry modal after creating assessment or clicking existing assessment.\n\n**Displayed Info:**\n- Student ID, name, roll number\n- Listed in roll number order for easy entry\n\n**Used by:** Score entry modal - Shows list of students with input fields\n",
        "operationId": "getClassStudents",
        "parameters": [
          {
            "name": "classId",
            "in": "path",
            "description": "Class ID",
            "required": true,
            "schema": {
              "type": "string",
              "example": "P5B"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Students retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StudentsListResponse"
                }
              }
            }
          },
          "404": {
            "description": "Class not found"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/assessments/{assessmentId}/scores": {
      "post": {
        "tags": [
          "Assessments"
        ],
        "summary": "Submit assessment scores (final)",
        "description": "**SCREEN: Score Entry Modal - Submit Button**\n\nSubmits final scores for an assessment. Marks assessment as complete.\nUse POST for initial submission, PATCH for updates.\n\n**Validation:**\n- Score must be between 0 and maxScore\n- All students must have scores for final submission\n\n**Used by:** Score entry modal - \"Submit\" button (final submission)\n",
        "operationId": "submitAssessmentScores",
        "parameters": [
          {
            "name": "assessmentId",
            "in": "path",
            "description": "Assessment ID",
            "required": true,
            "schema": {
              "type": "string",
              "example": "asm_001"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitScoresRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Scores submitted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitScoresResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          },
          "404": {
            "description": "Assessment not found"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      },
      "patch": {
        "tags": [
          "Assessments"
        ],
        "summary": "Update assessment scores",
        "description": "**SCREEN: Score Entry Modal - Edit existing scores**\n\nUpdates scores for an assessment that already has scores.\nUse when editing previously submitted scores.\n\n**Used by:** Score entry modal when editing existing assessment\n",
        "operationId": "updateAssessmentScores",
        "parameters": [
          {
            "name": "assessmentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitScoresRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Scores updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitScoresResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          },
          "404": {
            "description": "Assessment not found"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/assessments/{assessmentId}/scores/draft": {
      "post": {
        "tags": [
          "Assessments"
        ],
        "summary": "Save draft scores",
        "description": "**SCREEN: Score Entry Modal - Save Draft Button**\n\nSaves partial scores as draft. Allows teacher to come back later to complete.\nDoes not mark assessment as complete.\n\n**Used by:** Score entry modal - \"Save Draft\" button\n",
        "operationId": "saveDraftScores",
        "parameters": [
          {
            "name": "assessmentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/scores_draft_body"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Draft saved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/inline_response_200_2"
                }
              }
            }
          }
        }
      }
    },
    "/reports/grade-readiness": {
      "get": {
        "tags": [
          "Reports"
        ],
        "summary": "Check report card generation readiness",
        "description": "**SCREEN: Generate Report Cards - Grade Selection**\n\nReturns subject completion status for a grade level.\nShows which subjects are ready for report generation and which are incomplete.\n\n**Displayed Info:**\n- Overall completion percentage\n- Subject-by-subject status\n- Required vs actual assessment counts\n- Final SBA calculation status\n- What's pending for each incomplete subject\n\n**Used by:** Report generation screen after selecting a grade\n",
        "operationId": "getGradeReportReadiness",
        "parameters": [
          {
            "name": "grade",
            "in": "query",
            "description": "Grade level (P5, P6, JHS1, etc.)",
            "required": true,
            "schema": {
              "type": "string",
              "example": "P5"
            }
          },
          {
            "name": "term",
            "in": "query",
            "description": "Academic term",
            "required": true,
            "schema": {
              "type": "integer",
              "enum": [
                1,
                2,
                3
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Readiness data retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportReadinessResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/reports/generate": {
      "post": {
        "tags": [
          "Reports"
        ],
        "summary": "Generate report cards",
        "description": "**SCREEN: Generate Report Cards - Generate Button**\n\nGenerates report cards for all students in a grade level.\nOnly works if all subjects are complete and Final SBA calculated.\n\n**Process:**\n1. Validates all subjects complete\n2. Validates Final SBA calculated for all subjects\n3. Generates PDF report cards for all students\n4. Returns download links or job ID for async processing\n\n**Used by:** Report generation screen - \"Generate All Report Cards\" button\n",
        "operationId": "generateReportCards",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/reports_generate_body"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Report generation started (async)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/inline_response_202"
                }
              }
            }
          },
          "400": {
            "description": "Cannot generate - incomplete subjects",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/inline_response_400"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/reports/status/{jobId}": {
      "get": {
        "tags": [
          "Reports"
        ],
        "summary": "Check report generation status",
        "description": "Poll this endpoint to check report generation progress",
        "operationId": "getReportGenerationStatus",
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Status retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/inline_response_200_3"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DashboardOverview": {
        "type": "object",
        "properties": {
          "term": {
            "type": "integer",
            "example": 1
          },
          "academicYear": {
            "type": "string",
            "example": "2024"
          },
          "stats": {
            "$ref": "#/components/schemas/DashboardOverview_stats"
          },
          "assessmentCompletion": {
            "$ref": "#/components/schemas/DashboardOverview_assessmentCompletion"
          },
          "performanceByGrade": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DashboardOverview_performanceByGrade"
            }
          },
          "subjectPerformance": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DashboardOverview_subjectPerformance"
            }
          },
          "recentActivities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DashboardOverview_recentActivities"
            }
          },
          "attentionRequired": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DashboardOverview_attentionRequired"
            }
          }
        }
      },
      "ClassBasic": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "P5B"
          },
          "name": {
            "type": "string",
            "example": "Primary 5B"
          },
          "grade": {
            "type": "string",
            "example": "P5"
          },
          "students": {
            "type": "integer",
            "example": 45
          },
          "teacher": {
            "type": "string",
            "example": "Mr. Kwame Osei"
          }
        }
      },
      "CurriculumFramework": {
        "type": "object",
        "properties": {
          "grade": {
            "type": "string",
            "example": "P5"
          },
          "subject": {
            "type": "string",
            "example": "Mathematics"
          },
          "strands": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CurriculumFramework_strands"
            }
          }
        }
      },
      "CreateAssessmentRequest": {
        "required": [
          "classId",
          "curriculum",
          "date",
          "maxScore",
          "subject",
          "term",
          "title",
          "type"
        ],
        "type": "object",
        "properties": {
          "classId": {
            "type": "string",
            "example": "P5B"
          },
          "subject": {
            "type": "string",
            "example": "Mathematics"
          },
          "type": {
            "type": "string",
            "example": "Classwork",
            "enum": [
              "Classwork",
              "Homework",
              "Project",
              "Class Test",
              "Practical"
            ]
          },
          "title": {
            "maxLength": 200,
            "type": "string",
            "example": "Fractions Exercise 1"
          },
          "date": {
            "type": "string",
