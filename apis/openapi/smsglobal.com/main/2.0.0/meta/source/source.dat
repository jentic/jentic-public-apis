{
  "openapi": "3.0.1",
  "info": {
    "title": "SMSGLobal REST API",
    "description": "The REST API allows programmatic access to SMSGlobal features in MXT. To use the REST API, you will need an MXT account and an API key and secret. You can generate these inside your MXT account. The REST API can be accessed at api.smsglobal.com. Use of SSL is supported and strongly encouraged. The REST API takes full advantage of all HTTP headers. Each part of a request and response is meaningful, including the request method (GET/POST, etc.), the individual headers (Location, Content-Type, Accept, etc.), and the response status code (200, 400, 404, etc.). Use of this API assumes a working knowledge of these HTTP components, and general use of RESTful web APIs.",
    "termsOfService": "https://www.smsglobal.com/terms-and-conditions/",
    "contact": {
      "email": "support@smsglobal.com"
    },
    "license": {
      "name": "Apache 2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
    },
    "version": "2.0.0"
  },
  "servers": [
    {
      "url": "https://api.smsglobal.com"
    }
  ],
  "security": [
    {
      "api_key": []
    }
  ],
  "paths": {
    "/v2/auto-topup": {
      "get": {
        "tags": [
          "auto topup"
        ],
        "summary": "Get the auto top-up information associated to the authenticated account.",
        "responses": {
          "200": {
            "description": "Returned when successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AutoTopupResponse"
                }
              }
            }
          },
          "403": {
            "description": "Returned when the user is not authorized"
          },
          "405": {
            "description": "Method not allowed"
          }
        }
      }
    },
    "/v2/contact/{id}": {
      "delete": {
        "tags": [
          "contact group"
        ],
        "summary": "Delete a contact",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The contact identifier",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Returned when successful"
          },
          "403": {
            "description": "Returned when the user is not authorized"
          },
          "404": {
            "description": "Returned when the contact is not found"
          },
          "405": {
            "description": "Method not allowed"
          }
        }
      },
      "get": {
        "tags": [
          "contact group"
        ],
        "summary": "Get the contact as identified by the given id",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The contact identifier",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returned when successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactResponse"
                }
              }
            }
          },
          "403": {
            "description": "Returned when the user is not authorized"
          },
          "404": {
            "description": "Returned when the contact is not found"
          },
          "405": {
            "description": "Method not allowed"
          }
        }
      },
      "put": {
        "tags": [
          "contact group"
        ],
        "summary": "Update the contact as identified by the given id. You can only update the default fields associated with each contact",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The contact identifier",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContactRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Returned when successful"
          },
          "403": {
            "description": "Returned when the user is not authorized"
          },
          "404": {
            "description": "Returned when the contact is not found"
          },
          "405": {
            "description": "Method not allowed"
          }
        }
      }
    },
    "/v2/group": {
      "get": {
        "tags": [
          "contact group"
        ],
        "summary": "Get a list of all contact groups",
        "parameters": [
          {
            "name": "offset",
            "in": "query",
            "description": "Pagination offset (default 1)",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Number of items to return (default 20)",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returned when successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GroupsResponse"
                }
              }
            }
          },
          "403": {
            "description": "Returned when the user is not authorized"
          },
          "405": {
            "description": "Method not allowed"
          }
        }
      },
      "post": {
        "tags": [
          "contact group"
        ],
        "summary": "Create a new contact group",
        "requestBody": {
          "description": "Group object that needs to be added",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GroupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Returned when successful"
          },
          "400": {
            "description": "Returned when the request is bad"
          },
          "403": {
            "description": "Returned when the user is not authorized"
          },
          "405": {
            "description": "Method not allowed"
          }
        }
      }
    },
    "/v2/group/{groupId}/contact": {
      "post": {
        "tags": [
          "contact group"
        ],
        "summary": "Create a contact",
        "parameters": [
          {
            "name": "groupId",
            "in": "path",
            "description": "Group id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "description": "Contact object that needs to be added",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContactRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Returned when successful"
          },
          "400": {
            "description": "Returned when the request is bad"
          },
          "403": {
            "description": "Returned when the user is not authorized"
          },
          "405": {
            "description": "Method not allowed"
          }
        }
      }
    },
    "/v2/group/{groupId}/contacts": {
      "get": {
        "tags": [
          "contact group"
        ],
        "summary": "Get a list of all contacts in a group",
        "parameters": [
          {
            "name": "groupId",
            "in": "path",
            "description": "Group id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Pagination offset (default 1)",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Number of items to return (default 20)",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Sort by field id or msisdn. Prefix with minus (-) for descending order",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returned when successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Returned when the parameters are wrong"
          },
          "403": {
            "description": "Returned when the user is not authorized"
          },
          "404": {
            "description": "Returned when the group is not found"
          },
          "405": {
            "description": "Method not allowed"
          }
        }
      }
    },
    "/v2/group/{id}": {
      "delete": {
        "tags": [
          "contact group"
        ],
        "summary": "Delete a contact group",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The contact group identifier",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Returned when the contact group is deleted successfully"
          },
          "403": {
            "description": "Returned when the user is not authorized"
          },
          "404": {
            "description": "Returned when group is not found"
          },
          "405": {
            "description": "Method not allowed"
          }
        }
      },
      "get": {
        "tags": [
          "contact group"
        ],
        "summary": "Get the contact group as identified by the given id",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The contact group identifier",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returned when successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GroupResponse"
                }
              }
            }
          },
          "403": {
            "description": "Returned when the user is not authorized"
          },
          "404": {
            "description": "Returned when the group is not found"
          },
          "405": {
            "description": "Method not allowed"
          }
        }
      },
      "patch": {
        "tags": [
          "contact group"
        ],
        "summary": "Update fields of a group as identified by the given id",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The contact group identifier",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "description": "Group object that needs to be updated",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GroupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Returned when successful"
          },
          "400": {
            "description": "Returned when the request is bad"
          },
          "403": {
            "description": "Returned when the user is not authorized"
          },
          "405": {
            "description": "Method not allowed"
          }
        }
      }
    },
    "/v2/dedicated-number": {
      "get": {
        "tags": [
          "dedicated number"
        ],
        "summary": "View list of dedicated numbers",
        "responses": {
          "200": {
            "description": "Returned when successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DedicatedNumbersResponse"
                }
              }
            }
          },
          "403": {
            "description": "Returned when the user is not authorized"
          },
          "405": {
            "description": "Method not allowed"
          }
        },
        "parameters": [
          {
            "name": "offset",
            "in": "query",
            "description": "Pagination Offset (default 1)",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Number of items to return (default 20)",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ]
      },
      "post": {
        "tags": [
          "dedicated number"
        ],
        "summary": "Purchase a new virtual dedicated number",
        "description": "Purchase a new virtual dedicated number. Only supported for postpaid accounts; the first available number matching the requested country/type is assigned immediately.",
        "requestBody": {
          "description": "Dedicated number purchase options",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DedicatedNumberPurchaseRequest"
              }
            }
          },
          "required": false
        },
        "responses": {
          "201": {
            "description": "Returned when the number was purchased successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DedicatedNumber"
                }
              }
            }
          },
          "400": {
            "description": "Returned when the request is invalid, the account is not postpaid, or no matching numbers are available"
          },
          "403": {
            "description": "Returned when the user is not authorized"
          }
        }
      }
    },
    "/v2/opt-outs": {
      "get": {
        "tags": [
          "opt outs"
        ],
        "summary": "View list of opted out numbers",
        "parameters": [
          {
            "name": "phoneNumber",
            "in": "query",
            "description": "Filter by phone number",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Pagination Offset (default 1)",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Number of items to return (default 20)",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returned when successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OptOutsResponse"
                }
              }
            }
          },
          "403": {
            "description": "Returned when the user is not authorized"
          },
          "405": {
            "description": "Method not allowed"
          }
        }
      },
      "post": {
        "tags": [
          "opt outs"
        ],
        "summary": "Opt out mobile numbers",
        "requestBody": {
          "description": "Optout",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OptOutRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Returned when numbers opted-out successfully"
          },
          "400": {
            "description": "Returned when request parameter is invalid"
          },
          "403": {
            "description": "Returned when the user is not authorized"
          },
          "405": {
            "description": "Method not allowed"
          }
        }
      }
    },
    "/v2/opt-outs/validate": {
      "post": {
        "tags": [
          "opt outs"
        ],
        "summary": "Validate mobile numbers for opt out",
        "requestBody": {
          "description": "Group object that needs to be updated",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OptOutValidationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Returned when validation is performed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OptOutValidationsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Returned when request parameter is invalid"
          },
          "403": {
            "description": "Returned when the user is not authorized"
          },
          "405": {
            "description": "Method not allowed"
          }
        }
      }
    },
    "/v2/opt-outs/{number}": {
      "delete": {
        "tags": [
          "opt outs"
        ],
        "summary": "Opt in a mobile number",
        "parameters": [
          {
            "name": "number",
            "in": "path",
            "description": "Opt in mobile number (msidn)",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Returned when number opted-in successfully"
          },
          "403": {
            "description": "Returned when the user is not authorized"
          },
          "404": {
            "description": "Returned when number is not found"
          },
          "405": {
            "description": "Method not allowed"
          }
        }
      }
    },
    "/v2/sharedpool": {
      "get": {
        "tags": [
          "sharedpool"
        ],
        "summary": "View list of shared pools",
        "responses": {
          "200": {
            "description": "Returned when successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SharedPoolsResponse"
                }
              }
            }
          },
          "403": {
            "description": "Returned when the user is not authorized"
          },
          "405": {
            "description": "Method not allowed"
          }
        }
      }
    },
    "/v2/sharedpool/{id}": {
      "get": {
        "tags": [
          "sharedpool"
        ],
        "summary": "View details of a shared pool",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Shared pool id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returned when successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SharedPoolResponse"
                }
              }
            }
          },
          "400": {
            "description": "Returned when the sharedpool id is not valid"
          },
          "403": {
            "description": "Returned when the user is not authorized"
          },
          "404": {
            "description": "Returned when sharedpool does not exist"
          },
          "405": {
            "description": "Method not allowed"
          }
        }
      }
    },
    "/v2/sms": {
      "get": {
        "tags": [
          "sms"
        ],
        "summary": "View list of outgoing messages",
        "parameters": [
          {
            "name": "offset",
            "in": "query",
            "description": "Pagination offset (default 1, maximum offset + limit = 10,000)",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Number of items to return (default 20, maximum 1000)",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Filter by message status. Allowed values [delivered, sent, scheduled, noCredits, invalidNumber, undelivered]",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "startDate",
            "in": "query",
            "description": "Start date of the date range filter. Date format <Y-m-d H:i:s> in account timezone",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "endDate",
            "in": "query",
            "description": "End date of the date range filter. Date format <Y-m-d H:i:s> in account timezone",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "destination",
            "in": "query",
            "description": "The number message was sent to",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "source",
            "in": "query",
            "description": "The number message was sent from",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "search",
            "in": "query",
            "description": "Search string in source, destination and message",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returned when successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SmsSentsResponse"
                }
              }
            }
          },
          "403": {
            "description": "Returned when the user is not authorized"
          },
          "405": {
            "description": "Method not allowed"
          }
        }
      },
      "post": {
        "tags": [
          "sms"
        ],
        "summary": "Send messages",
        "requestBody": {
          "description": "Message data",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SmsOutsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Returned when successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SmsOutsResponse"
                }
              }
            }
          },
          "202": {
            "description": "Returned when message(s) saved successfully and added to queue",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SmsOutsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Returned when input validation failed"
          },
          "402": {
            "description": "Returned when account is out of credits"
          },
          "403": {
            "description": "Returned when the user is not authorized"
          },
          "405": {
            "description": "Method not allowed"
          }
        }
      }
    },
    "/v2/sms/{id}": {
      "delete": {
        "tags": [
          "sms"
        ],
        "summary": "Delete outgoing message",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Outgoing message id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Returned when message deleted successfully"
          },
          "403": {
            "description": "Returned when the user is not authorized"
          },
          "404": {
            "description": "Returned when sms outgoing is not found"
          },
          "405": {
            "description": "Method not allowed"
          }
        }
      },
      "get": {
        "tags": [
          "sms"
        ],
        "summary": "View details of an outgoing message",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Outgoing message id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returned when successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SmsOutsResponse"
                }
              }
            }
          },
          "403": {
            "description": "Returned when the user is not authorized"
          },
          "404": {
            "description": "Returned when sms outgoing is not found"
          },
          "405": {
            "description": "Method not allowed"
          }
        }
      }
    },
    "/v2/sms-incoming": {
      "get": {
        "tags": [
          "sms incoming"
        ],
        "summary": "View list of incoming messages",
        "parameters": [
          {
            "name": "offset",
            "in": "query",
            "description": "Pagination offset (default 1, maximum offset + limit = 10,000)",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Number of items to return (default 20, maximum 1000)",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "startDate",
            "in": "query",
            "description": "Start date of the date range filter. Date format <Y-m-d H:i:s> in account timezone",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "endDate",
            "in": "query",
            "description": "End date of the date range filter. Date format <Y-m-d H:i:s> in account timezone",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "destination",
            "in": "query",
            "description": "The shared pool or dedicated number which the sms was sent to",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "origin",
            "in": "query",
            "description": "The number where the SMS appears to come from",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "search",
            "in": "query",
            "description": "Search string in source, destination and message",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returned when successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SmsIncomingsResponse"
                }
              }
            }
          },
          "403": {
            "description": "Returned when the user is not authorized"
          },
          "405": {
            "description": "Method not allowed"
          }
        }
      }
    },
