                  "$ref": "#/components/schemas/BusinessProfileResponse"
                }
              }
            }
          },
          "400": {
            "description": "Returned when input validation failed"
          },
          "403": {
            "description": "Returned when the user is not authorized to update the business profile, or the business profile has already been submitted to ACMA and can no longer be updated"
          },
          "404": {
            "description": "Returned when the business profile is not found"
          },
          "405": {
            "description": "Method not allowed"
          }
        }
      },
