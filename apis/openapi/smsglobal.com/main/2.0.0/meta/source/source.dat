            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Returned when the business profile is deleted successfully"
          },
          "403": {
            "description": "Returned when the user is not authorized to delete the business profile, or it is linked to one or more Sender ID registrations"
          },
          "404": {
            "description": "Returned when the business profile is not found"
          },
          "405": {
            "description": "Method not allowed"
          }
        }
      }
    },
