        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The API key identifier",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Returned when message deleted successfully"
          },
          "403": {
            "description": "Returned when the user is not authorized"
          },
          "404": {
            "description": "Returned when sms outgoing is not found"
          },
          "405": {
            "description": "Method not allowed"
          }
        }
      }
    },
    "/v2/user/verified-number": {
      "post": {
        "tags": [
          "user"
        ],
        "summary": "Register verified numbers",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifiedNumberRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Returned when successful"
          },
          "400": {
            "description": "Returned when the request is bad"
          },
          "403": {
            "description": "Returned when the user is not authorized"
          },
          "405": {
            "description": "Method not allowed"
          }
        }
      }
    },
    "/v2/user/verified-number/verify": {
      "post": {
        "tags": [
          "user"
        ],
        "summary": "Verify verified numbers",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifiedNumberVerifyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Returned when successful"
          },
          "400": {
            "description": "Returned when the request is bad"
          },
          "403": {
            "description": "Returned when the user is not authorized"
          },
          "405": {
            "description": "Method not allowed"
          }
        }
      }
    },
    "/v2/user/verified-numbers/pending": {
      "get": {
        "tags": [
          "user"
        ],
        "summary": "Get the account's pending verified numbers",
        "responses": {
          "200": {
            "description": "Returned when successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifiedNumbersResponse"
                }
              }
            }
          },
          "403": {
            "description": "Returned when the user is not authorized"
          },
          "405": {
            "description": "Method not allowed"
          }
        }
      }
    },
    "/v2/dedicated-number/{number}": {
      "get": {
        "tags": [
          "dedicated number"
        ],
        "summary": "View details of a dedicated number",
        "parameters": [
          {
            "name": "number",
            "in": "path",
            "description": "The dedicated number (MSISDN)",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returned when successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DedicatedNumber"
                }
              }
            }
          },
          "400": {
            "description": "Returned when the number is not valid"
          },
          "403": {
            "description": "Returned when the user is not authorized"
          },
          "404": {
            "description": "Returned when the dedicated number does not exist"
          },
          "405": {
            "description": "Method not allowed"
          }
        }
      }
    },
    "/v2/dedicated-number/{id}": {
      "delete": {
        "tags": [
          "dedicated number"
        ],
        "summary": "Cancel a dedicated number's auto-renewal",
        "description": "Cancel a dedicated number's auto-renewal. The number is not released immediately - it remains active and owned until the end of the current billing period.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The dedicated number identifier",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Returned when the cancellation was successful"
          },
          "403": {
            "description": "Returned when the user is not authorized"
          },
          "404": {
            "description": "Returned when the dedicated number or its active subscription is not found"
          }
        }
      }
    },
    "/v2/user/sub-account/credit": {
      "post": {
        "tags": [
          "user"
        ],
        "summary": "Transfer credits to a sub-account",
        "description": "Transfer credit balance from the authenticated (prepaid) account to one of its prepaid sub-accounts. Both accounts must share the same currency.",
        "requestBody": {
          "description": "Credit transfer details",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreditTransferRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Returned when the credit transfer was successful"
          },
          "400": {
            "description": "Returned when the authenticated account is postpaid, has insufficient balance, the sub-account cannot be found, or the currencies do not match"
          },
          "403": {
            "description": "Returned when the user is not authorized"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CardResponse": {
        "type": "object",
        "properties": {
          "default": {
            "type": "boolean",
            "description": "Whether this credit card is the default card."
          },
          "number": {
            "type": "string",
            "example": "5454-XXXX-XXXX-5454",
            "description": "The credit card's masked number."
          },
          "token": {
            "type": "string",
            "description": "The credit card identifier."
          },
          "type": {
            "type": "string",
            "example": "Visa",
            "description": "The credit card type."
          }
        }
      },
      "AutoTopupResponse": {
        "type": "object",
        "properties": {
          "disabled": {
            "type": "boolean",
            "example": false,
            "description": "Whether auto top-up is disabled for the authenticated user."
          },
          "balanceThreshold": {
            "type": "integer",
            "description": "The auto top-up low balance threshold."
          },
          "balanceAmount": {
            "type": "integer",
            "description": "The auto top-up amount."
          },
          "card": {
            "$ref": "#/components/schemas/CardResponse"
          },
          "periodicFrequency": {
            "type": "integer",
            "description": "The auto top up periodic frequency."
          },
          "periodicStartDate": {
            "type": "string",
            "example": "2019-01-01T00:00:00.000Z",
            "description": "The auto top up start date."
          },
          "periodicEndDate": {
            "type": "string",
            "example": "2019-02-01T00:00:00.000Z",
            "description": "The auto top up end date."
          },
          "periodicAmount": {
            "type": "integer",
            "description": "The periodic top up amount."
          }
        }
      },
      "ContactRequest": {
        "type": "object",
        "properties": {
          "givenName": {
            "type": "string",
            "description": "Contact given name."
          },
          "familyName": {
            "type": "string",
            "description": "Contact surname."
          },
          "displayName": {
            "type": "string",
            "description": "Contact display name."
          },
          "msisdn": {
            "type": "string",
            "description": "Contact mobile number."
          },
          "emailAddress": {
            "type": "string",
            "description": "Contact email address."
          }
        }
      },
      "ContactResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Contact identifier."
          },
          "groupId": {
            "type": "integer",
            "description": "Contact group id."
          },
          "givenName": {
            "type": "string",
            "description": "Contact given name."
          },
          "familyName": {
            "type": "string",
            "description": "Contact surname."
          },
          "displayName": {
            "type": "string",
            "description": "Contact display name."
          },
          "msisdn": {
            "type": "string",
            "description": "Contact mobile number."
          },
          "emailAddress": {
            "type": "string",
            "description": "Contact email address."
          }
        }
      },
      "ContactsResponse": {
        "type": "object",
        "properties": {
          "offset": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          },
          "contacts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContactResponse"
            }
          }
        }
      },
      "GroupRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Group name. Max length of 100 characters."
          },
          "keyword": {
            "type": "string",
            "description": "Email to SMS keyword."
          },
          "isGlobal": {
            "type": "boolean",
            "description": "Is the group globally visible to sub accounts. Defaults to false."
          },
          "defaultOrigin": {
            "type": "string",
            "description": "The default SMS origin for this group. 4-11 characters for alphanumeric or 4-15 * digits for numeric. Pass an empty string \" for shared pool numbers."
          }
        }
      },
      "GroupResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Group identifier."
          },
          "name": {
            "type": "string",
            "description": "Group name. Max length of 100 characters."
          },
          "keyword": {
            "type": "string",
            "description": "Email to SMS keyword."
          },
          "isGlobal": {
            "type": "boolean",
            "description": "Is the group globally visible to sub accounts. Defaults to false."
          },
          "contactCount": {
            "type": "integer",
            "description": "Number of contacts in the group."
          },
          "defaultOrigin": {
            "type": "string",
            "description": "The default SMS origin for this group. 4-11 characters for alphanumeric or 4-15 * digits for numeric. Pass an empty string \" for shared pool numbers."
          }
        }
      },
      "GroupsResponse": {
        "type": "object",
        "properties": {
          "offset": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          },
          "groups": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GroupResponse"
            }
          }
        }
      },
      "DedicatedNumber": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Dedicated number identifier."
          },
          "userId": {
            "type": "integer",
            "description": "User identifier."
          },
          "msisdn": {
            "type": "string",
            "description": "Mobile phone number including country and area codes. 4 to 15 digits; no spaces or other formatting."
          },
          "type": {
            "type": "string",
            "description": "How to handle incoming messages. 0 = Disable this number, 1 = SMPP, 2 = HTTP Callback, 3 = Email, 4 = SMSGlobal website only. All messages still appear on the SMSGlobal website regardless of this setting."
          },
          "emailAddress": {
            "type": "string",
            "description": "Email address to send incoming SMS to."
          },
          "httpCallbackUrl": {
            "type": "string",
            "description": "HTTP callback URL for incoming SMS."
          },
          "isAutoReplyEnabled": {
            "type": "boolean",
            "description": "Whether auto reply messages are enabled."
          },
          "autoReplyMessage": {
            "type": "string",
            "description": "The auto reply message. Maximum of 480 characters."
          },
          "autoReplyOrigin": {
            "type": "string",
            "description": "Where the auto reply should appear to come from. Blank to use the dedicated number itself. 4-15 digits or 3-11 numbers and letters."
          }
        }
      },
      "DedicatedNumbersResponse": {
        "type": "object",
        "properties": {
          "dedicatedNumbers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DedicatedNumber"
            }
          }
        }
      },
      "OptOutResponse": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string"
          },
          "number": {
            "type": "string"
          }
        }
      },
      "OptOutsResponse": {
        "type": "object",
        "properties": {
          "offset": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          },
          "optouts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OptOutResponse"
            }
          }
        }
      },
      "OptOutRequest": {
        "type": "object",
        "properties": {
          "optouts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "OptOutValidationRequest": {
        "type": "object",
        "properties": {
          "optouts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "OptOutValidationResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "number": {
            "type": "string"
          }
        }
      },
      "OptOutValidationsResponse": {
        "type": "object",
        "properties": {
          "optouts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OptOutValidationResponse"
            }
          }
        }
      },
      "SmsOutRequest": {
        "type": "object",
        "properties": {
          "destination": {
            "type": "string",
            "description": "Destination mobile number. 3-15 digits."
          },
          "destinations": {
            "type": "array",
            "description": "A collection of destination mobile numbers. 3-15 digits.",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "message": {
            "type": "string",
            "description": "The SMS message. If longer than 160 characters (GSM) or 70 characters (Unicode), splits into multiple SMS."
          },
          "origin": {
            "type": "string",
            "description": "Where the SMS appears to come from. 3-11 characters A-Za-z0-9 if alphanumeric; 3-15 digits if numeric (if set, set sharedPool to null)."
          },
          "scheduledDateTime": {
            "type": "string",
            "description": "The datetime the message should be sent in UTC."
          },
          "campaign": {
            "type": "string",
            "description": "The campaign the message is associated with (optional)."
          },
          "sharedPool": {
            "type": "string",
            "description": "The shared pool to use (if set, set origin to null)."
          },
          "notifyUrl": {
            "type": "string",
            "description": "Url to post back the status of message."
          },
          "incomingUrl": {
            "type": "string",
            "description": "Url to post back incoming messages."
          },
          "expiryDateTime": {
            "type": "string",
            "description": "The datetime in UTC at message will expire."
          }
        }
      },
      "SmsOutsRequest": {
        "type": "object",
        "properties": {
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SmsOutRequest"
            }
          }
        }
      },
      "SmsSentResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Message part identifier."
          },
          "outgoing_id": {
            "type": "integer",
            "description": "Outgoing message identifier."
          },
          "origin": {
            "type": "string",
            "description": "Where the SMS appears to come from. 4-11 characters A-Za-z0-9 if alphanumeric; 4-15 digits if numeric (if set, set sharedPool to null)."
          },
          "destination": {
            "type": "string",
            "description": "Destination mobile number. 4-15 digits."
          },
          "message": {
            "type": "string",
            "description": "Outgoing message."
          },
          "status": {
            "type": "string",
            "description": "Message status"
          },
          "dateTime": {
            "type": "string",
            "description": "The date the message was created in UTC."
          }
        }
      },
      "SmsSentsResponse": {
        "type": "object",
        "properties": {
          "offset": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SmsSentResponse"
            }
          }
        }
      },
      "SmsOutsResponse": {
        "type": "object",
        "properties": {
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SmsSentResponse"
            }
          }
        }
      },
      "CampaignResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Campaign identifier"
          }
        }
      },
      "SmsIncomingResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Incoming message identifier"
          },
          "outgoing_id": {
            "type": "integer",
            "description": "Outgoing message identifier"
          },
          "origin": {
            "type": "string",
            "description": "Where the SMS appears to come from"
          },
          "destination": {
            "type": "string",
            "description": "The shared pool or dedicated number which the sms was sent to"
          },
          "message": {
            "type": "string",
            "description": "The SMS message. If longer than 160 characters (GSM) or 70 characters (Unicode), splits into multiple SMS"
          },
          "isUnicode": {
            "type": "boolean",
            "description": "If incoming message contains Unicode characters"
          },
          "dateTime": {
            "type": "string",
            "description": "The date and time this message was received"
          },
          "campaign": {
            "$ref": "#/components/schemas/CampaignResponse"
          },
          "isMultipart": {
            "type": "boolean",
            "description": "Whether the message exceeded the maximum length and had to be split into multiple parts"
          },
          "partNumber": {
            "type": "integer",
            "description": "If concatenated, the part number this SMS represents; otherwise 1"
          },
          "totalParts": {
            "type": "integer",
            "description": "If concatenated, the total number of parts in this SMS. Ranges from 1-255"
          }
        }
      },
      "SmsIncomingsResponse": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer",
            "description": "Total number of incoming message objects"
          },
          "offset": {
            "type": "integer",
            "description": "Pagination Offset (default 1)"
          },
          "limit": {
            "type": "integer",
            "description": "Number of incoming message objects to return"
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SmsIncomingResponse"
            }
          }
        }
      },
