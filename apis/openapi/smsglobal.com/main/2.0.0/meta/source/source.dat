          }
        }
      },
      "patch": {
        "tags": [
          "business profile"
        ],
        "summary": "Update a business profile",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The business profile identifier.",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "description": "Business profile fields to update",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BusinessProfileUpdateRequest"
              }
            },
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/BusinessProfileUpdateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Returned when successful",
