{
  "openapi": "3.0.0",
  "info": {
    "title": "API Import Editeurs",
    "description": "API pour importer en Full les données élèves d'un établissement",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/MHENNEQUET_1/api-import-editeurs-recette/1.0.0"
  },
  "servers": [
    {
      "url": "https://recette.ange1d.fr"
    }
  ],
  "paths": {
    "/api/v1/import-etb-result/{uuid}": {
      "get": {
        "tags": [
          "ImportEtbResult"
        ],
        "summary": "Récupération du résultat d'un import",
        "operationId": "get_api_v1_import_etb_result",
        "parameters": [
          {
            "name": "uuid",
            "in": "path",
            "description": "Uuid reçu après l'envoi de l'import établissement",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "default": {
            "description": ""
          }
        }
      }
    },
    "/api/v1/import-etb/{codeRne}": {
      "post": {
        "tags": [
          "Import"
        ],
        "summary": "Import des données de l'établissement",
        "description": "Import des élèves, responsables, scolarités, classes et dispositifs",
        "operationId": "post_api_v1_import_etb",
        "parameters": [
          {
            "name": "codeRne",
            "in": "path",
            "description": "Code RNE de l'établissement",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "PARAMETRES",
                  "ELEVES",
                  "RESPONSABLES",
                  "SCOLARITES",
                  "CLASSES"
                ],
                "properties": {
                  "PARAMETRES": {
                    "required": [
                      "anneeScolaire",
                      "logiciel",
                      "versionLogiciel",
                      "dateVersionLogiciel"
                    ],
                    "properties": {
                      "anneeScolaire": {
                        "type": "string"
                      },
                      "logiciel": {
                        "type": "string"
                      },
                      "motDePasse": {
                        "type": "string"
                      },
                      "versionLogiciel": {
                        "type": "string"
                      },
                      "dateVersionLogiciel": {
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "ELEVES": {
                    "type": "array",
                    "items": {
                      "required": [
                        "IdEditeur",
                        "nomFamille",
                        "prenom",
                        "codeCivilite",
                        "codeSexe",
                        "dateNaissance",
                        "codePaysNaissance",
                        "adresse1",
                        "codePaysResidence",
                        "demiPension"
                      ],
                      "properties": {
                        "IdEditeur": {
                          "type": "string"
                        },
                        "IneEDleve": {
                          "type": "string"
                        },
                        "nomFamille": {
                          "type": "string"
                        },
                        "nomUsage": {
                          "type": "string"
                        },
                        "prenom": {
                          "type": "string"
                        },
                        "codeCivilite": {
                          "type": "string"
                        },
                        "codeSexe": {
                          "type": "string"
                        },
                        "dateNaissance": {
                          "type": "string"
                        },
                        "codeDepartementNaissance": {
                          "type": "string"
                        },
                        "codeCommuneNaissance": {
                          "type": "string"
                        },
                        "codePaysNaissance": {
                          "type": "string"
                        },
                        "libelleCommune": {
                          "type": "string"
                        },
                        "adresse1": {
                          "type": "string"
                        },
                        "adresse2": {
                          "type": "string"
                        },
                        "codePostal": {
                          "type": "string"
                        },
                        "codeCommune": {
                          "type": "string"
                        },
                        "codePaysResidence": {
                          "type": "string"
                        },
                        "demiPension": {
                          "type": "string"
                        },
                        "ondeUuid": {
                          "type": "string"
                        }
                      },
                      "type": "object"
                    }
                  },
                  "RESPONSABLES": {
                    "type": "array",
                    "items": {
                      "required": [
                        "IdEditeur",
                        "numeroResponsable",
                        "nomFamille",
                        "prenom",
                        "codeCivilite",
                        "codeLienParente",
                        "autoriteParentale",
                        "typeResponsable",
                        "codePcs",
                        "ADH_APEL"
                      ],
                      "properties": {
                        "IdEditeur": {
                          "type": "string"
                        },
                        "numeroResponsable": {
                          "type": "string"
                        },
                        "nomFamille": {
                          "type": "string"
                        },
                        "nomUsage": {
                          "type": "string"
                        },
                        "prenom": {
                          "type": "string"
                        },
                        "codeCivilite": {
                          "type": "string"
                        },
                        "adresse1": {
                          "type": "string"
                        },
                        "codePostal": {
                          "type": "string"
                        },
                        "adresseCourriel": {
                          "type": "string"
                        },
                        "codeCommune": {
                          "type": "string"
                        },
                        "codePaysResidence": {
                          "type": "string"
                        },
                        "codeLienParente": {
                          "type": "string"
                        },
                        "autoriteParentale": {
                          "type": "boolean"
                        },
                        "typeResponsable": {
                          "type": "integer"
                        },
                        "codePcs": {
                          "type": "string"
                        },
                        "telephone": {
                          "type": "string"
                        },
                        "portable": {
                          "type": "string"
                        },
                        "ADH_APEL": {
                          "type": "string"
                        },
                        "ondeUuid": {
                          "type": "string"
                        }
                      },
                      "type": "object"
                    }
                  },
                  "SCOLARITES": {
                    "type": "array",
                    "items": {
                      "required": [
                        "IdEditeur",
                        "codeNiveau",
                        "dateDebut",
                        "numeroClasse",
                        "etat"
                      ],
                      "properties": {
                        "IdEditeur": {
                          "type": "string"
                        },
                        "codeNiveau": {
                          "type": "string"
                        },
                        "dateDebut": {
                          "type": "string"
                        },
                        "numeroClasse": {
                          "type": "string"
                        },
                        "dateEffetRadiation": {
                          "type": "string"
                        },
                        "etat": {
                          "type": "string"
                        },
                        "codeLangueEtrangere1": {
                          "type": "string"
                        },
                        "codeLangueEtrangere2": {
                          "type": "string"
                        },
                        "codeLangueRegionale": {
                          "type": "string"
                        },
                        "regroupements": {
                          "properties": {
                            "regroupement": {
                              "type": "array",
                              "items": {
                                "required": [
                                  "numeroRegroupement",
                                  "libCourtRegroupement",
                                  "libLongRegroupement"
                                ],
                                "properties": {
                                  "numeroRegroupement": {
                                    "type": "string"
                                  },
                                  "libCourtRegroupement": {
                                    "type": "string"
                                  },
                                  "libLongRegroupement": {
                                    "type": "string"
                                  },
                                  "ondeUuid": {
                                    "type": "string"
                                  },
                                  "codeDispositifs": {
                                    "properties": {
                                      "codeDispositif": {
                                        "type": "array",
                                        "items": {
                                          "type": "string"
                                        }
                                      }
                                    },
                                    "type": "object"
                                  }
                                },
                                "type": "object"
                              }
                            }
                          },
                          "type": "object"
                        },
                        "rne_ant": {
                          "type": "string"
                        }
                      },
                      "type": "object"
                    }
                  },
                  "CLASSES": {
                    "type": "array",
                    "items": {
                      "required": [
                        "numeroClasse",
                        "libCourtClasse",
                        "codeTypeClasse",
                        "codeNiveau",
                        "codeTypeContrat"
                      ],
                      "properties": {
                        "numeroClasse": {
                          "type": "string"
                        },
                        "libCourtClasse": {
                          "type": "string"
                        },
                        "libLongClasse": {
                          "type": "string"
                        },
                        "codeTypeClasse": {
                          "type": "string"
                        },
                        "codeCycle": {
                          "type": "string"
                        },
                        "codeNiveau": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "codeTypeContrat": {
                          "type": "string"
                        },
                        "ondeUuid": {
                          "type": "string"
                        }
                      },
                      "type": "object"
                    }
                  },
                  "DISPOSITIFS": {
                    "type": "array",
                    "items": {
                      "required": [
                        "IdEditeur",
                        "codeDispositif"
                      ],
                      "properties": {
                        "IdEditeur": {
                          "type": "string"
                        },
                        "codeDispositif": {
                          "type": "string"
                        },
                        "dateDebut": {
                          "type": "string"
                        },
                        "dateFin": {
                          "type": "string"
                        }
                      },
                      "type": "object"
                    }
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Requête executée"
          },
          "400": {
            "description": "Invalide"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "oauth2": {
        "type": "oauth2",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://recette.ange1d.fr/api/v1/token",
            "scopes": {}
          }
        }
      }
    }
  },
  "security": [
    {
      "oauth2": []
    }
  ],
  "tags": [
    {
      "name": "ImportEtbResult",
      "description": "Consulter le résultat d'un import d'établissement. Permet de suivre l'état d'avancement."
    },
    {
      "name": "Import",
      "description": "Importer les données d'un établissement."
    }
  ]
}
