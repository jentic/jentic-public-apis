  },
  "host": "api-externa.klingo.app",
  "basePath": "/api/info",
  "tags": [
    {
      "name": "info",
      "description": "Informações"
    }
  ],
  "schemes": [
    "https"
  ],
  "paths": {
    "/despesas": {
      "get": {
        "tags": [
          "info"
        ],
        "summary": "Informações sobre as despesas registradas no financeiro.",
        "security": [
          {
            "app_token": []
          }
        ],
        "description": "Informações de Despesas.",
        "operationId": "despesas",
        "parameters": [
          {
            "in": "query",
            "name": "mes",
            "description": "Mês no formato YYYY-MM.",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Json com os dados",
            "schema": {
              "properties": {
                "lancamentos": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/despesas"
                  }
                }
              }
            }
          },
          "405": {
            "description": "Invalid input"
          }
        }
      }
    },
    "/consumos": {
      "get": {
        "tags": [
          "info"
        ],
        "summary": "Informações sobre os consumos de mat/med.",
        "security": [
          {
            "app_token": []
          }
        ],
        "description": "Informações de Consumos.",
        "operationId": "consumos",
        "parameters": [
          {
            "in": "query",
            "name": "mes",
            "description": "Mês no formato YYYY-MM.",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Json com os dados"
          },
          "405": {
            "description": "Invalid input"
          }
        }
      }
    },
    "/producao": {
      "get": {
        "tags": [
          "info"
        ],
        "summary": "Informações sobre produção.",
        "security": [
          {
            "app_token": []
          }
        ],
        "description": "Informações de Produção.",
        "operationId": "producao",
        "parameters": [
          {
            "in": "query",
            "name": "mes",
            "description": "Mês no formato YYYY-MM. Deve ser enviado o mês ou o período (inicio, fim)",
            "required": false,
            "type": "string"
          },
          {
            "in": "query",
            "name": "inicio",
            "description": "Data inicial YYYY-MM-DD (opcional em relação ao mês)",
            "required": false,
            "type": "string"
          },
          {
            "in": "query",
            "name": "fim",
            "description": "Data final YYYY-MM-DD (opcional em relação ao mês)",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Json com os dados"
          },
          "405": {
            "description": "Invalid input"
          }
        }
      }
    },
    "/relatorio": {
      "get": {
        "tags": [
          "info"
        ],
        "summary": "Informações de relatório do sistema.",
        "security": [
          {
            "app_token": []
          }
        ],
        "description": "Relatório do Sistema.",
        "operationId": "relatorio",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "description": "Parâmetros do Relatório.",
            "required": true,
            "schema": {
              "$ref": "#/definitions/parametros"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Json com os dados",
            "schema": {
              "$ref": "#/definitions/relatorio"
            }
          },
          "405": {
            "description": "Invalid input"
          }
        }
      }
    }
  },
  "securityDefinitions": {
    "app_token": {
      "type": "apiKey",
      "name": "X-APP-TOKEN",
      "in": "header"
    }
  },
  "definitions": {
    "parametros": {
      "type": "object",
      "properties": {
        "id": {
          "type": "number",
          "description": "Id do Relatório",
          "example": 20
        },
        "parametros": {
          "type": "string",
          "description": "Outros parâmetros do relatório",
          "example": ":periodo: 'aa'"
        }
      }
    },
    "relatorio": {
      "type": "object",
      "properties": {
        "id": {
          "type": "number",
          "description": "Id do Relatório",
          "example": 20
        },
        "title": {
          "type": "string",
          "description": "Título do Relatório",
          "example": "Agendas Marcadas"
        },
        "inputs": {
          "type": "array",
          "description": "Lista de Parâmetros",
          "items": {
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "value": {
                "type": "string"
              },
              "required": {
                "type": "string"
              }
            }
          }
        },
        "result": {
          "type": "object",
          "properties": {
            "columns": {
              "type": "array",
              "items": {
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "align": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "treat": {
                    "type": "boolean"
                  },
                  "format": {
                    "type": "string"
                  }
                }
              }
            },
            "rows": {
              "type": "number"
            },
            "data": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "despesas": {
      "type": "object",
      "properties": {
        "id_lancamento": {
          "type": "number",
          "description": "id do lancamento",
          "example": 1234
        },
        "id_unidade_operacao": {
          "type": "number",
          "description": "id da unidade",
          "example": 1234
        },
        "id_centro_custo": {
          "type": "number",
          "description": "id do centro de custo",
          "example": 1234
        },
        "id_fornecedor": {
          "type": "number",
          "description": "id do fornecedor",
          "example": 1234
        },
        "id_categoria": {
          "type": "number",
          "description": "id da categoria do lançamento",
          "example": 1234
        },
        "emissao": {
          "type": "string",
          "description": "Data de emissão da despesa",
          "example": "2022-01-01"
        },
        "venc": {
          "type": "string",
          "description": "Data de vencimento da despesa",
          "example": "2022-01-01"
        },
        "doc": {
          "type": "string",
          "description": "Número do Documento",
          "example": "1234"
        },
        "descricao": {
          "type": "string",
          "description": "Descrição da Despesa",
          "example": "Despesa de..."
        },
        "mes": {
          "type": "string",
          "description": "Mês da Despesa",
          "example": "2022-01"
        },
        "valor": {
          "type": "number",
          "description": "Valor da Despesa",
          "example": 45.2
        },
        "categoria": {
          "type": "object",
          "properties": {
            "id_categoria": {
              "type": "number",
              "description": "id da categoria do lançamento",
              "example": 1234
            },
            "st_categoria": {
              "type": "string",
              "description": "descrição da categoria do lançamento",
              "example": 1234
            },
            "ch_natureza": {
              "type": "string",
              "description": "natureza da categoria: fixo D",
              "example": "D"
            }
          }
        },
        "centro": {
          "type": "object",
          "properties": {
            "id_centro_custo": {
              "type": "number",
              "description": "id do centro de custo",
              "example": 1234
            },
            "st_nome": {
              "type": "string",
              "description": "nome do centro de custo",
              "example": "Administração"
            }
          }
        },
        "unidadeOperacao": {
          "type": "object",
          "properties": {
            "id_unidade_operacao": {
              "type": "number",
              "description": "id da unidade",
              "example": 1234
            },
            "st_nome": {
              "type": "string",
              "description": "nome do unidade",
              "example": "Unidade Canela"
            }
          }
        },
        "fornecedor": {
          "type": "object",
          "properties": {
            "id_unidade_operacao": {
              "type": "number",
              "description": "id do fornecedor",
              "example": 1234
            },
            "st_nome": {
              "type": "string",
              "description": "nome do fornecedor",
              "example": "Organizações Tabajara"
            }
          }
        }
      }
    }
  },
