{
  "openapi": "3.1.0",
  "info": {
    "title": "TerraScoutX Property API",
    "version": "1.0.0",
    "summary": "US property records by address: parcel, owner, values, tax, flood, schools and risk.",
    "description": "Free for everyone. Each API key gets 2,000 requests per calendar month (UTC). Get a key at https://terrascoutx.com/developers/ and send it in the X-Api-Key header. marketValue and totalAppraised are the county's appraised value from its latest tax roll, not an automated current-market estimate. Coverage and the fields present vary by county; a field the county does not publish is omitted rather than filled with a guess.\n\nDATA TERMS. The records are compiled from county and other public sources. They are not open data and are not released under an open license (no CC0, CC-BY or ODbL). The terms of each source county vary. Do not assume you may redistribute the data in bulk; check the source's terms if you plan to.\n\nOWNER FIELDS. owner, mailingAddress and ownershipTransfers (buyer and seller names) identify private individuals. They are public-record data in most states, but some states restrict or exempt them. Integrations should not consume or display them. Add no_owner=1 to /v1/suggest or /v1/property/{id} to leave them out, or fields= to list exactly the fields you want.",
    "contact": {
      "name": "TerraScoutX",
      "url": "https://terrascoutx.com/developers/",
      "email": "hello@terrascoutx.com"
    },
    "x-data-license": "Not open-licensed. County-sourced public records; source terms vary."
  },
  "servers": [
    {
      "url": "https://api.terrascoutx.com"
    }
  ],
  "security": [
    {
      "ApiKey": []
    },
    {
      "Bearer": []
    }
  ],
  "tags": [
    {
      "name": "Search",
      "description": "Find properties by address, parcel id or owner."
    },
    {
      "name": "Property",
      "description": "One property's full record and its related data."
    },
    {
      "name": "Coverage",
      "description": "Which counties are covered."
    },
    {
      "name": "Plans",
      "description": "The public plan catalog. No key needed."
    }
  ],
  "paths": {
    "/v1/suggest": {
      "get": {
        "tags": [
          "Search"
        ],
        "operationId": "searchProperties",
        "summary": "Search properties",
        "description": "Address autocomplete and property search. Returns matching property records, best match first. A query shorter than 2 characters returns an empty list.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "An address or parcel id, e.g. \"1000 Main St Houston\". Owner-name search is not part of this documented API; the owner fields it can return are described under Property.",
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Number of results, 1 to 20.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 8
            }
          },
          {
            "name": "state",
            "in": "query",
            "description": "Two-letter state code to search within, e.g. TX.",
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 2
            }
          },
          {
            "name": "county",
            "in": "query",
            "description": "County key to search within (see /v1/coverage), e.g. hcad.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "minValue",
            "in": "query",
            "description": "Minimum total appraised value in US dollars.",
            "schema": {
              "type": "number",
              "minimum": 0
            }
          },
          {
            "name": "maxValue",
            "in": "query",
            "description": "Maximum total appraised value in US dollars.",
            "schema": {
              "type": "number",
              "minimum": 0
            }
          },
          {
            "name": "fields",
            "in": "query",
            "description": "Comma-separated allowlist of top-level fields to return, e.g. parcelId,address,totalAppraised. id is always included. Unknown names are ignored; if none are valid, the full record is returned. Owner fields are returned only if named here and no_owner is not set.",
            "schema": {
              "type": "string"
            },
            "example": "parcelId,address,totalAppraised"
          },
          {
            "name": "no_owner",
            "in": "query",
            "description": "Set to 1 to omit owner, mailingAddress and ownershipTransfers (which names buyers and sellers). Takes precedence over fields. Recommended for any integration that has no need to identify owners.",
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching properties.",
            "headers": {
              "$ref": "#/components/headers/QuotaHeaders"
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Property"
                      }
                    }
                  },
                  "required": [
                    "results"
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/v1/property/{id}": {
      "get": {
        "tags": [
          "Property"
        ],
        "operationId": "getProperty",
        "summary": "Get a property",
        "description": "The full record for one property id, as returned by /v1/suggest. Every request made with a valid key counts toward the month, including a 404.",
        "parameters": [
          {
            "$ref": "#/components/parameters/PropertyId"
          },
          {
            "name": "fields",
            "in": "query",
            "description": "Comma-separated allowlist of top-level fields to return, e.g. parcelId,address,totalAppraised. id is always included. Unknown names are ignored; if none are valid, the full record is returned. Owner fields are returned only if named here and no_owner is not set.",
            "schema": {
              "type": "string"
            },
            "example": "parcelId,address,totalAppraised"
          },
          {
            "name": "no_owner",
            "in": "query",
            "description": "Set to 1 to omit owner, mailingAddress and ownershipTransfers (which names buyers and sellers). Takes precedence over fields. Recommended for any integration that has no need to identify owners.",
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The property.",
            "headers": {
              "$ref": "#/components/headers/QuotaHeaders"
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "property": {
                      "$ref": "#/components/schemas/Property"
                    }
                  },
                  "required": [
                    "property"
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "No property has this id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "not_found"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/v1/property/{id}/valuation-history": {
      "get": {
        "tags": [
          "Property"
        ],
        "operationId": "getValuationHistory",
        "summary": "Get a property's valuation history",
        "description": "Market, assessed and taxable values, tax and sales by year, one row per year and source, newest first. Empty where the county publishes no history.",
        "parameters": [
          {
            "$ref": "#/components/parameters/PropertyId"
          }
        ],
        "responses": {
          "200": {
            "description": "Values by year.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "valuationHistory": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ValuationYear"
                      }
                    }
                  },
                  "required": [
                    "valuationHistory"
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/v1/property/{id}/nearby-schools": {
      "get": {
        "tags": [
          "Property"
        ],
        "operationId": "getNearbySchools",
        "summary": "Get schools near a property",
        "parameters": [
          {
            "$ref": "#/components/parameters/PropertyId"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Number of schools, 1 to 10.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10,
              "default": 5
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Nearest schools first.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "schools": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/School"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/v1/property/{id}/market-context": {
      "get": {
        "tags": [
          "Property"
        ],
        "operationId": "getMarketContext",
        "summary": "Get the price trend for a property's state",
        "description": "The latest FHFA House Price Index for the property's state, with its quarter-over-quarter and year-over-year change. null if the property is unknown.",
        "parameters": [
          {
            "$ref": "#/components/parameters/PropertyId"
          }
        ],
        "responses": {
          "200": {
            "description": "Market context.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "marketContext": {
                      "oneOf": [
                        {
                          "$ref": "#/components/schemas/MarketContext"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "marketContext"
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/v1/coverage": {
      "get": {
        "tags": [
          "Coverage"
        ],
        "operationId": "getCoverage",
        "summary": "List covered counties",
        "responses": {
          "200": {
            "description": "Covered counties with their property counts.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "counties": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Coverage"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        },
        "description": "Which counties are covered and how many properties each holds. Use county_key as the county filter on /v1/suggest. Coverage is not uniform: a county listed here may publish only some of the fields."
      }
    },
    "/v1/plans": {
      "get": {
        "tags": [
          "Plans"
        ],
        "operationId": "listPlans",
        "summary": "List plans",
        "description": "The plan catalog, including the free tier's monthly request limit (2,000). No API key needed and not counted against any quota.",
        "security": [],
        "responses": {
          "200": {
            "description": "Active plans.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "plans": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": true
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Api-Key",
        "description": "Your free key from https://terrascoutx.com/developers/."
      },
      "Bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "The same key sent as Authorization: Bearer tsx_live_..."
      }
    },
    "parameters": {
      "PropertyId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "A property id from /v1/suggest, e.g. hcad-0011390000002. URL-encode it.",
        "schema": {
          "type": "string"
        }
      }
    },
    "headers": {
      "QuotaHeaders": {
        "X-Monthly-Request-Limit": {
          "description": "Requests this key may make this month.",
          "schema": {
            "type": "integer"
          }
        },
        "X-Monthly-Requests-Remaining": {
          "description": "Requests left this month.",
          "schema": {
            "type": "integer"
          }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "No key, or an unknown key.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "missing": {
                "value": {
                  "error": "api_key_required",
                  "reason": "Provide your key via the X-Api-Key header."
                }
              },
              "invalid": {
                "value": {
                  "error": "invalid_api_key"
                }
              }
            }
          }
        }
      },
      "TooManyRequests": {
        "description": "The key used this month's 2,000 requests, or the caller exceeded the per-minute rate limit.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "monthly_request_limit_exceeded",
              "limit": 2000,
              "used": 2000,
              "plan": "free"
            }
          }
        }
      },
      "Unavailable": {
        "description": "The database is briefly unavailable; retry after a few seconds.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "property_api_unavailable",
              "reason": "database_temporarily_unavailable"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "Address": {
        "type": "object",
        "properties": {
          "street": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "zip": {
            "type": "string"
          },
          "county": {
            "type": "string"
          }
        }
      },
      "Property": {
        "type": "object",
        "description": "Fields a county does not publish are omitted.",
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable property id."
          },
          "matchedOn": {
            "type": "string",
            "enum": [
              "address",
              "owner"
            ],
            "description": "Search results only: what the query matched."
          },
          "address": {
            "$ref": "#/components/schemas/Address"
          },
          "parcelId": {
            "type": "string",
            "description": "The county's own parcel or account number."
          },
          "landUse": {
            "type": "string",
            "description": "The county's land-use classification. Omitted when the county publishes none; the generic placeholder \"Real Property\" is never returned."
          },
          "landUseCode": {
            "type": "string",
            "description": "The county's land-use code. Omitted when the county publishes none."
          },
          "yearBuilt": {
            "type": "integer"
          },
          "livingAreaSqft": {
            "type": "number"
          },
          "lotSizeSqft": {
            "type": "number"
          },
          "acreage": {
            "type": "number"
          },
          "totalAppraised": {
            "type": "number",
            "description": "Total appraised value, US dollars."
          },
          "marketValue": {
            "type": "number"
          },
          "assessedValue": {
            "type": "number"
          },
          "landValue": {
            "type": "number"
          },
          "improvementValue": {
            "type": "number"
          },
          "estimatedAnnualTax": {
            "type": "number"
          },
          "effectiveTaxRate": {
            "type": "number",
            "description": "Estimated tax as a fraction of value."
          },
          "owner": {
            "type": "string",
            "description": "OWNER FIELD. The owner name as published by the county. Public-record data that can identify a private individual; integrations should not consume or display it. Omit with no_owner=1."
          },
          "mailingAddress": {
            "type": "string",
            "description": "OWNER FIELD. The owner's mailing address as published by the county. Same caution as owner. Omit with no_owner=1."
          },
          "legalDescription": {
            "type": "string"
          },
          "schoolDistrict": {
            "type": "string"
          },
          "floodZone": {
            "description": "FEMA flood zone for the parcel."
          },
          "riskScore": {
            "description": "Composite risk score with its dimensions."
          },
          "demographics": {
            "description": "Census tract figures (ACS)."
          },
          "naturalHazardRisk": {
            "description": "FEMA National Risk Index for the area."
          },
          "appraisalHistory": {
            "description": "Values by year, where published."
          },
          "taxHistory": {
            "description": "Tax by year, where published."
          },
          "buildingPermits": {
            "description": "Permits on the parcel, where a permit feed exists."
          },
          "ownershipTransfers": {
            "description": "Recorded sales and transfers, where published. OWNER FIELD: each entry names the buyer and seller. Omit with no_owner=1."
          },
          "developmentSignals": {
            "description": "Nearby development activity."
          },
          "sourceProvenance": {
            "type": "object",
            "description": "Which public source each part of the record came from."
          },
          "generatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "address",
          "parcelId"
        ]
      },
      "School": {
        "type": "object",
        "properties": {
          "ncesId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "districtName": {
            "type": [
              "string",
              "null"
            ]
          },
          "city": {
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "type": "string"
          },
          "lowGrade": {
            "type": [
              "string",
              "null"
            ]
          },
          "highGrade": {
            "type": [
              "string",
              "null"
            ]
          },
          "schoolType": {
            "type": [
              "string",
              "null"
            ]
          },
          "charter": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "enrollment": {
            "type": [
              "integer",
              "null"
            ]
          },
          "studentTeacherRatio": {
            "type": [
              "number",
              "null"
            ]
          },
          "rating": {
            "type": [
              "number",
              "null"
            ]
          },
          "ratingScale": {
            "type": [
              "number",
              "null"
            ]
          },
          "ratingLabel": {
            "type": [
              "string",
              "null"
            ]
          },
          "ratingSource": {
            "type": [
              "string",
              "null"
            ]
          },
          "ratingYear": {
            "type": [
              "string",
              "null"
            ]
          },
          "distanceMiles": {
            "type": "number"
          }
        }
      },
      "Coverage": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string"
          },
          "county": {
            "type": "string"
          },
          "county_key": {
            "type": "string",
            "description": "Use as the county filter on /v1/suggest."
          },
          "property_count": {
            "type": "string"
          },
          "updated_at": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ValuationYear": {
        "type": "object",
        "properties": {
          "taxYear": {
            "type": "integer"
          },
          "marketValue": {
            "type": [
              "number",
              "null"
            ]
          },
          "assessedValue": {
            "type": [
              "number",
              "null"
            ]
          },
          "taxableValue": {
            "type": [
              "number",
              "null"
            ]
          },
          "landValue": {
            "type": [
              "number",
              "null"
            ]
          },
          "improvementValue": {
            "type": [
              "number",
              "null"
            ]
          },
          "actualTax": {
            "type": [
              "number",
              "null"
            ]
          },
          "saleDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "salePrice": {
            "type": [
              "number",
              "null"
            ]
          },
          "sourceKey": {
            "type": "string"
          },
          "sourceUrl": {
            "type": "string"
          }
        },
        "required": [
          "taxYear",
          "sourceKey",
          "sourceUrl"
        ]
      },
      "MarketContext": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string"
          },
          "periodDate": {
            "type": "string",
            "format": "date"
          },
          "indexValue": {
            "type": "number"
          },
          "quarterChangePercent": {
            "type": [
              "number",
              "null"
            ]
          },
          "yearChangePercent": {
            "type": [
              "number",
              "null"
            ]
          },
          "source": {
            "type": "string",
            "const": "FHFA House Price Index"
          },
          "sourceUrl": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
