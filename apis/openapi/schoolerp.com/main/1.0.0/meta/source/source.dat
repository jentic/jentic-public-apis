    "/staff/upload/instructions": {
      "get": {
        "x-role-required": [
          "school_admin",
          "accountant",
          "receptionist"
        ],
        "x-permission-required": [
          "staff:read"
        ],
        "tags": [
          "Staff"
        ],
        "summary": "Get Excel upload instructions",
        "description": "Get detailed instructions for Excel upload format.\n\nUsed for \"SHOW EXCEL FORMAT INSTRUCTIONS\" button.\n",
        "operationId": "getStaffUploadInstructions",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/SchoolIdHeader"
          }
        ],
        "responses": {
          "200": {
            "description": "Upload instructions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "general_instructions": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "column_formatting": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "column": {
                                "type": "string"
                              },
                              "allowed_values": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "data": {
                    "general_instructions": [
                      "Download the template for excel and upload the **exact** template without changing its structure.",
                      "Name, Department, Designation, Gender are mandatory fields.",
                      "Add corresponding Department & Designation before uploading the excel.",
                      "Date format for Date of Birth (DOB), Date of Profession (DOP), Date Of Joining (DOJ) is **DD-MM-YYYY**."
                    ],
                    "column_formatting": [
                      {
                        "column": "Department",
                        "allowed_values": [
