          "stripe_price_id_monthly": {
            "type": "string"
          },
          "stripe_price_id_yearly": {
            "type": "string"
          },
          "billing_cycle": {
            "type": "string",
            "enum": [
              "monthly",
              "yearly"
            ],
            "default": "monthly"
          },
