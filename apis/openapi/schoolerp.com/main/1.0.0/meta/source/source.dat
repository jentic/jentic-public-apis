          },
          {
            "name": "class_id",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Filter by class ID"
          },
          {
            "name": "section_id",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Filter by section ID"
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "active",
                "inactive"
              ]
            },
            "description": "Only remove active or inactive students"
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "student_ids": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    },
                    "description": "Specific student IDs to remove (optional, if not provided, removes all matching filter)"
                  },
                  "reason": {
                    "type": "string",
                    "description": "Reason for removal"
                  }
                }
              },
              "example": {
                "student_ids": [
                  1,
                  2,
                  3
                ],
                "reason": "Bulk removal for class transfer"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Students removed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string"
                        },
                        "removed_count": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "data": {
                    "message": "Students removed successfully",
                    "removed_count": 3
                  }
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
