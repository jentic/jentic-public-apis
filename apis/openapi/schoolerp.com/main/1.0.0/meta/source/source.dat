    "/staff/assign-subjects": {
      "get": {
        "x-role-required": [
          "school_admin",
          "accountant",
          "receptionist"
        ],
        "x-permission-required": [
          "staff:read"
        ],
        "tags": [
          "Staff"
        ],
        "summary": "List all teachers with assigned subjects",
        "description": "Get list of all teachers with their assigned subjects, grouped by subject name.\n\nUsed for \"Assign Teacher Subjects\" list view with columns:\n- # (row number)\n- Teacher Name (clickable, links to teacher profile)\n- Subjects (grouped by subject name, showing class and sections, e.g., \"SOCIAL SCIENCE\" -> \"6 : A, B\")\n- Actions (edit icon)\n\n**Response Format:**\n- Groups subjects by subject name\n- Under each subject, shows class and sections\n- Format: \"Subject Name\" -> \"Class : Section1, Section2\"\n- Example: \"SOCIAL SCIENCE\" -> \"6 : A, B\" means teacher teaches Social Science to Class 6, Sections A and B\n",
        "operationId": "listTeachersWithSubjects",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/SchoolIdHeader"
          },
          {
            "$ref": "#/components/parameters/PageParam"
          },
          {
            "$ref": "#/components/parameters/PerPageParam"
          },
          {
            "name": "class_id",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Filter by class ID"
          },
          {
            "name": "subject_id",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Filter by subject ID"
          },
          {
            "name": "academic_year_id",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Filter by academic year ID"
          }
        ],
        "responses": {
          "200": {
            "description": "List of teachers with assigned subjects",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer"
                          },
                          "staff_id": {
                            "type": "integer"
                          },
                          "teacher_name": {
                            "type": "string",
                            "description": "Full name of teacher (first_name + last_name)"
                          },
                          "employee_id": {
                            "type": "string"
                          },
                          "subjects": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "subject_id": {
                                  "type": "integer"
                                },
                                "subject_name": {
                                  "type": "string",
                                  "description": "Subject name (e.g., \"SOCIAL SCIENCE\", \"ENGLISH\")"
                                },
                                "class_sections": {
                                  "type": "array",
                                  "items": {
                                    "type": "object",
                                    "properties": {
                                      "class_id": {
                                        "type": "integer"
                                      },
                                      "class_name": {
                                        "type": "string",
                                        "description": "Class name (e.g., \"6\", \"7\", \"8\", \"LKG\")"
                                      },
                                      "sections": {
                                        "type": "array",
                                        "items": {
                                          "type": "object",
                                          "properties": {
                                            "section_id": {
                                              "type": "integer"
                                            },
                                            "section_name": {
                                              "type": "string",
                                              "description": "Section name (e.g., \"A\", \"B\", \"C\")"
                                            },
                                            "created_at": {
                                              "type": "string",
                                              "format": "date-time"
                                            }
                                          }
                                        }
                                      }
                                    }
                                  },
                                  "description": "Grouped by class, showing sections for each class"
                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    "meta": {
