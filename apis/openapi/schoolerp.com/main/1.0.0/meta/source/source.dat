    "/schools/available": {
      "get": {
        "x-role-required": [
          "super_admin",
          "organization_admin",
          "school_admin"
        ],
        "x-permission-required": [
          "schools:read"
        ],
        "tags": [
          "Schools"
        ],
        "summary": "Get available schools",
        "description": "Get list of schools available to current user based on their role and organization context.\n\n**Authentication & Authorization:**\n- User context is extracted from JWT token (user_id, organization_id, role)\n- **Super Admin**: Returns all schools across all organizations\n- **Organization Admin**: Returns all schools within their organization\n- **School Admin**: Returns schools they have access to (may have roles in multiple schools)\n\n**Multi-Tenancy Structure:**\n- Returns all schools the user has access to (within their organization, unless super admin)\n- Schools can have the same name (different `id`) - e.g., \"ABC School\" (Main) and \"ABC School\" (Secondary)\n- Schools can have different names - e.g., \"ABC School\" and \"XYZ School\"\n- Each school can have multiple branches (see `/schools/{id}/branches` endpoint)\n- Data isolation is at school level (all modules scoped to `school_id`)\n",
        "operationId": "getAvailableSchools",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "organization_id",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Filter by organization ID (optional).\n- Super Admin: Can filter by any organization\n- Organization Admin: Can only filter by their own organization (ignored if different)\n- School Admin: Ignored (returns their accessible schools)\n"
          },
          {
            "name": "is_active",
            "in": "query",
            "schema": {
              "type": "boolean"
            },
            "description": "Filter by active status (optional)"
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Search schools by name, code, or city (optional)"
          }
        ],
        "responses": {
          "200": {
            "description": "Available schools",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "school": {
                            "$ref": "#/components/schemas/School"
                          },
                          "organization": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "integer"
                              },
                              "name": {
                                "type": "string"
                              },
                              "subdomain": {
                                "type": "string"
                              },
                              "plan_id": {
                                "type": "integer",
                                "description": "Reference to subscription_plans table"
                              },
                              "plan": {
                                "type": "object",
                                "description": "Related subscription plan object (when included)",
                                "properties": {
                                  "id": {
                                    "type": "integer"
                                  },
                                  "name": {
                                    "type": "string"
                                  },
                                  "code": {
                                    "type": "string"
                                  },
                                  "plan_type": {
                                    "type": "string"
                                  }
                                }
                              }
                            }
                          },
                          "role": {
                            "type": "string",
                            "description": "User's role in this school"
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "data": [
                    {
                      "school": {
                        "id": 1,
                        "organization_id": 1,
                        "name": "ABC School",
                        "code": "ABC001",
                        "subdomain": "abc-main",
                        "address": "123, Education Street",
                        "city": "New Delhi",
                        "state": "Delhi",
                        "country": "India",
                        "pin_code": "110016",
                        "phone": "+91-11-12345678",
                        "email": "info@abcschool.com",
                        "website": "https://www.abcschool.com",
                        "logo_url": "https://cdn.schoolerp.com/schools/logos/abc.jpg",
                        "established_year": 1990,
                        "school_type": "private",
                        "affiliation_number": "AFF123456",
                        "registration_number": "REG789012",
                        "settings": {
                          "timezone": "Asia/Kolkata",
                          "date_format": "DD/MM/YYYY"
                        },
                        "created_at": "2024-01-01T10:00:00Z",
                        "updated_at": "2024-01-01T10:00:00Z"
                      },
                      "organization": {
                        "id": 1,
                        "name": "ABC Education Group",
                        "subdomain": "abc",
                        "plan_id": 3,
                        "plan": {
                          "id": 3,
                          "name": "Premium Plan",
                          "code": "premium",
                          "plan_type": "premium"
                        }
                      },
                      "role": "school_admin"
                    },
                    {
                      "school": {
                        "id": 2,
                        "organization_id": 1,
                        "name": "ABC School",
                        "code": "ABC002",
                        "subdomain": "abc-secondary",
                        "address": "456, Learning Avenue",
                        "city": "New Delhi",
