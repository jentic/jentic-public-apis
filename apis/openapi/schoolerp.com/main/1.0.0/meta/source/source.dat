                          "timezone": "Asia/Kolkata",
                          "date_format": "DD/MM/YYYY"
                        },
                        "created_at": "2024-01-01T10:00:00Z",
                        "updated_at": "2024-01-01T10:00:00Z"
                      },
                      "organization": {
                        "id": 1,
                        "name": "ABC Education Group",
