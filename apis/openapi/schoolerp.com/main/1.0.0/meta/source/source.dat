        ],
        "summary": "Assign subject to teacher",
        "description": "Assign a subject to a teacher for specific class and section.\n\nUsed for \"Assign Teacher Subject\" modal - assigning new subject after selecting class.\nCreates entry in teacher_subjects table with class_id, section_id, and subject_id.\n",
        "operationId": "assignSubjectToTeacher",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
