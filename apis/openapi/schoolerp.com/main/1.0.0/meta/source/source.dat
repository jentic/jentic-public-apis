    "/students/send-app-id-password": {
      "post": {
        "x-role-required": [
          "school_admin"
        ],
        "x-permission-required": [
          "student:send_notification"
        ],
        "tags": [
          "Students"
        ],
        "summary": "Send APP ID and Password",
        "description": "Send APP ID and Password to parents/guardians via SMS/Email.\n\nUsed for \"Send APP ID Password\" button in \"VIEW STUDENT DETAILS\" page.\nSends login credentials to all parents/guardians of selected students.\n",
        "operationId": "sendAppIdPassword",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/SchoolIdHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "student_ids"
                ],
                "properties": {
                  "student_ids": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    },
                    "description": "Array of student IDs"
                  },
                  "send_via": {
                    "type": "string",
                    "enum": [
                      "sms",
                      "email",
                      "both"
                    ],
                    "default": "both",
                    "description": "Send via SMS, Email, or both"
                  }
                }
              },
              "example": {
                "student_ids": [
                  1,
                  2,
                  3
                ],
                "send_via": "both"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Notification sent successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string"
                        },
                        "sent_count": {
                          "type": "integer"
                        },
                        "failed_count": {
                          "type": "integer"
                        },
                        "details": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "student_id": {
                                "type": "integer"
                              },
                              "parent_id": {
                                "type": "integer"
                              },
                              "status": {
                                "type": "string"
                              },
                              "error": {
                                "type": "string"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "data": {
                    "message": "APP ID and Password sent successfully",
                    "sent_count": 6,
                    "failed_count": 0,
                    "details": [
                      {
                        "student_id": 1,
                        "parent_id": 1,
                        "status": "sent"
                      },
                      {
                        "student_id": 1,
                        "parent_id": 2,
                        "status": "sent"
                      }
                    ]
                  }
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/students/{id}/subjects": {
      "get": {
        "x-role-required": [
          "school_admin",
          "accountant",
          "receptionist",
          "teacher"
        ],
        "x-permission-required": [
          "student:read"
        ],
        "tags": [
          "Students"
        ],
        "summary": "Get student subjects",
        "description": "Get all subjects assigned to a student.\n\nUsed for \"Student Subjects\" button in \"VIEW STUDENT DETAILS\" page.\nReturns subjects based on class-section assignment.\n",
        "operationId": "getStudentSubjects",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdPathParam"
          },
          {
            "$ref": "#/components/parameters/SchoolIdHeader"
          }
        ],
        "responses": {
          "200": {
            "description": "Student subjects",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "student_id": {
                          "type": "integer"
                        },
                        "student_name": {
                          "type": "string"
                        },
                        "standard": {
                          "type": "string"
                        },
                        "subjects": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "subject_id": {
                                "type": "integer"
                              },
                              "subject_name": {
                                "type": "string"
                              },
                              "subject_code": {
                                "type": "string"
                              },
                              "is_graded": {
                                "type": "boolean"
                              },
                              "is_main": {
                                "type": "boolean"
                              },
                              "is_additional": {
                                "type": "boolean"
                              },
                              "is_optional": {
                                "type": "boolean"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "data": {
                    "student_id": 1,
                    "student_name": "AARADHYA CHOUDHARY",
                    "standard": "1-A",
                    "subjects": [
                      {
                        "subject_id": 1,
                        "subject_name": "English",
                        "subject_code": "ENG",
                        "is_graded": false,
                        "is_main": true,
                        "is_additional": false,
                        "is_optional": false
                      },
                      {
                        "subject_id": 2,
                        "subject_name": "Mathematics",
                        "subject_code": "MATH",
                        "is_graded": false,
                        "is_main": true,
                        "is_additional": false,
                        "is_optional": false
                      },
                      {
                        "subject_id": 3,
                        "subject_name": "Hindi",
                        "subject_code": "HIN",
                        "is_graded": false,
                        "is_main": true,
                        "is_additional": false,
                        "is_optional": false
                      }
                    ]
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/students/bulk-remove": {
