{
  "openapi": "3.0.3",
  "info": {
    "title": "School ERP API",
    "description": "Complete REST API for School ERP SaaS platform covering all 200+ modules and 250+ routes.\n\n## Features\n- Multi-tenant architecture\n- JWT authentication\n- Role-based access control\n- Comprehensive CRUD operations\n- Advanced filtering and search\n- Bulk operations\n- File uploads\n- Real-time notifications\n\n## Authentication\nAll endpoints require JWT Bearer token authentication. Include the token in the Authorization header:\n```\nAuthorization: Bearer <your_jwt_token>\n```\n\n## Multi-Tenancy\nAll endpoints are tenant-scoped. Include the school ID in the X-School-ID header:\n```\nX-School-ID: <school_id>\n```\n",
    "version": "1.0.0",
    "contact": {
      "name": "School ERP API Support",
      "email": "api-support@schoolerp.com"
    },
    "license": {
      "name": "Proprietary"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/ACHRARAJEEV/school-erp-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.schoolerp.com/api/v1",
      "description": "Production server"
    }
  ],
  "tags": [
    {
      "name": "Organizations",
      "description": "Organization management (SaaS multi-tenancy)"
    },
    {
      "name": "Subscriptions",
      "description": "Subscription and billing management"
    },
    {
      "name": "Roles",
      "description": "Role management (RBAC)"
    },
