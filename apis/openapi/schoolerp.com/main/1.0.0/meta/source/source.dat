            "$ref": "#/components/responses/NotFound"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/organizations/{id}/schools": {
      "get": {
        "tags": [
          "Organizations"
        ],
        "summary": "Get organization schools",
        "description": "Get all schools for an organization",
        "operationId": "getOrganizationSchools",
        "x-role-required": [
          "super_admin",
          "school_admin"
        ],
        "x-permission-required": [
          "organizations:read",
          "schools:read"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdPathParam"
          },
          {
            "$ref": "#/components/parameters/PageParam"
          },
          {
            "$ref": "#/components/parameters/PerPageParam"
          }
        ],
        "responses": {
          "200": {
            "description": "Organization schools",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "items": {
                        "$ref": "#/components/schemas/School"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/organizations/{id}/subscription": {
      "get": {
        "tags": [
          "Subscriptions"
        ],
        "summary": "Get organization subscription",
        "description": "Get current subscription for an organization",
        "operationId": "getOrganizationSubscription",
        "x-role-required": [
          "super_admin",
          "school_admin"
        ],
        "x-permission-required": [
          "subscriptions:read"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdPathParam"
          }
        ],
        "responses": {
          "200": {
            "description": "Subscription details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Subscription"
                    }
                  }
                },
                "example": {
                  "data": {
                    "id": 1,
                    "organization_id": 1,
                    "plan_id": 3,
                    "plan": {
                      "id": 3,
                      "name": "Premium Plan",
                      "code": "premium",
                      "plan_type": "premium",
                      "price_monthly": 999.0,
                      "price_yearly": 9990.0,
                      "max_schools": 10,
                      "max_students": 5000,
                      "max_staff": 500,
                      "features": {
                        "basic_features": true,
                        "reports": true,
                        "advanced_reports": true,
                        "custom_branding": true,
                        "api_access": true,
                        "white_label": true,
                        "sms_notifications": true,
                        "email_notifications": true,
                        "push_notifications": true,
                        "biometric_attendance": true,
                        "online_payments": true,
                        "parent_portal": true,
                        "staff_portal": true,
                        "student_portal": true,
                        "multi_language": true,
                        "custom_domain": false,
                        "dedicated_support": false,
                        "sla": false
                      },
                      "is_active": true,
                      "is_public": true
                    },
                    "billing_cycle": "yearly",
                    "status": "active",
                    "stripe_subscription_id": "sub_1234567890",
                    "current_period_start": "2024-01-01T00:00:00Z",
                    "current_period_end": "2025-01-01T00:00:00Z",
                    "cancel_at_period_end": false,
                    "cancelled_at": null,
                    "created_at": "2024-01-01T00:00:00Z",
                    "updated_at": "2024-01-01T00:00:00Z"
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      },
      "post": {
        "tags": [
          "Subscriptions"
        ],
        "summary": "Create subscription",
        "description": "Create a new subscription for an organization",
        "operationId": "createSubscription",
        "x-role-required": [
          "super_admin"
        ],
        "x-permission-required": [
          "subscriptions:create"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdPathParam"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "plan_id"
                ],
                "properties": {
                  "plan_id": {
                    "type": "integer",
                    "description": "Subscription plan ID"
                  },
                  "billing_cycle": {
                    "type": "string",
                    "enum": [
                      "monthly",
                      "yearly"
                    ],
                    "default": "monthly"
                  },
                  "stripe_price_id": {
                    "type": "string"
                  },
                  "payment_method_id": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Subscription created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": null
                  }
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      },
      "put": {
        "tags": [
          "Subscriptions"
        ],
        "summary": "Update subscription",
        "description": "Update subscription plan (upgrade/downgrade)",
        "operationId": "updateSubscription",
        "x-role-required": [
          "super_admin"
        ],
        "x-permission-required": [
          "subscriptions:update"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdPathParam"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "plan_id"
                ],
                "properties": {
                  "plan_id": {
                    "type": "integer",
                    "description": "New subscription plan ID"
                  },
                  "billing_cycle": {
                    "type": "string",
                    "enum": [
                      "monthly",
                      "yearly"
                    ]
                  },
                  "stripe_price_id": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Subscription updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": null
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/organizations/{id}/subscription/cancel": {
      "post": {
        "tags": [
          "Subscriptions"
        ],
        "summary": "Cancel subscription",
        "description": "Cancel an organization's subscription",
        "operationId": "cancelSubscription",
        "x-role-required": [
          "super_admin",
          "school_admin"
        ],
        "x-permission-required": [
          "subscriptions:update"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdPathParam"
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "cancel_immediately": {
                    "type": "boolean",
                    "default": false
                  },
                  "reason": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Subscription cancelled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/subscription-plans": {
      "get": {
        "tags": [
          "Subscriptions"
        ],
        "summary": "List subscription plans",
        "description": "Get list of available subscription plans",
        "operationId": "listSubscriptionPlans",
        "x-role-required": [
          "super_admin",
          "school_admin"
        ],
        "x-permission-required": [
          "subscription_plans:read"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "is_active",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "is_public",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "plan_type",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "free",
                "basic",
                "premium",
                "enterprise",
                "custom"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of subscription plans",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "items": {
                        "$ref": "#/components/schemas/SubscriptionPlan"
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/PaginationMeta"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Subscriptions"
        ],
        "summary": "Create subscription plan",
        "description": "Create a new subscription plan (super admin only)",
        "operationId": "createSubscriptionPlan",
        "x-role-required": [
          "super_admin"
        ],
        "x-permission-required": [
          "subscription_plans:create"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
