      "SchoolSettings": {
        "type": "object",
        "description": "Comprehensive school settings stored in JSONB format",
        "properties": {
          "basic": {
            "type": "object",
            "description": "Basic settings",
            "properties": {
              "name": {
                "type": "string",
                "description": "School name"
              },
              "description": {
                "type": "string",
                "description": "School description"
              },
              "validity_period": {
                "type": "object",
                "properties": {
                  "start_date": {
                    "type": "string",
                    "format": "date"
                  },
                  "end_date": {
                    "type": "string",
                    "format": "date"
                  }
                }
              },
              "status": {
                "type": "string",
                "enum": [
                  "disabled",
                  "enabled",
                  "pending"
                ],
                "description": "Status (無効/有効/保留)"
              }
            }
          },
          "notifications": {
            "type": "object",
            "description": "Notification settings",
            "properties": {
              "destination": {
                "type": "string",
                "enum": [
                  "disabled",
                  "email",
                  "slack"
                ],
                "description": "Notification destination (無効/メール/Slack)"
              },
              "content": {
                "type": "string",
                "enum": [
                  "disabled",
                  "summary",
                  "detailed"
                ],
                "description": "Notification content (無効/概要/詳細)"
              },
              "timing": {
                "type": "string",
                "enum": [
                  "disabled",
                  "immediate",
                  "regular"
                ],
                "description": "Notification timing (無効/即時/定期)"
              },
              "message": {
                "type": "string",
                "description": "Notification message"
              }
            }
          },
          "advanced": {
            "type": "object",
            "description": "Advanced settings including API integration",
            "properties": {
              "enabled": {
                "type": "boolean",
                "description": "Enable/Disable advanced settings"
              },
              "validity_period": {
                "type": "object",
                "properties": {
                  "start_date": {
                    "type": "string",
                    "format": "date"
                  },
                  "end_date": {
                    "type": "string",
                    "format": "date"
                  }
                }
              },
              "api_integration": {
                "type": "object",
                "description": "API integration settings",
                "properties": {
                  "api_key": {
                    "type": "string",
                    "description": "API key"
                  },
                  "api_secret": {
                    "type": "string",
                    "description": "API secret"
                  },
                  "api_endpoint": {
                    "type": "string",
                    "format": "uri",
                    "description": "API endpoint URL"
                  },
                  "api_version": {
                    "type": "string",
                    "description": "API version"
                  },
                  "authentication_method": {
                    "type": "string",
                    "enum": [
                      "oauth2",
                      "api_key",
                      "basic"
                    ],
                    "description": "Authentication method (OAuth2/APIキー/Basic認証)"
                  },
                  "request_headers": {
                    "type": "string",
                    "description": "API request headers"
                  },
                  "response_format": {
                    "type": "string",
                    "enum": [
                      "json",
                      "xml",
                      "csv"
                    ],
                    "description": "API response format"
                  },
                  "timeout": {
                    "type": "integer",
                    "description": "API timeout in seconds"
                  },
                  "retry_count": {
                    "type": "integer",
                    "description": "API retry count"
                  },
                  "retry_interval": {
                    "type": "integer",
                    "description": "API retry interval in seconds"
                  },
                  "retry_condition_enabled": {
                    "type": "boolean",
                    "description": "Enable retry conditions"
                  },
                  "error_handling_enabled": {
                    "type": "boolean",
                    "description": "Enable error handling"
                  },
                  "log_level": {
                    "type": "string",
                    "enum": [
                      "error",
                      "warning",
                      "info"
                    ],
                    "description": "API log level (エラー/警告/情報)"
                  }
                }
              },
              "features": {
                "type": "object",
                "description": "Feature toggles",
                "additionalProperties": {
                  "type": "boolean"
                }
              },
              "data_processing": {
                "type": "object",
                "description": "Data processing settings",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "scripts": {
                "type": "object",
                "description": "Processing scripts",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "history": {
                "type": "object",
                "description": "History tracking settings",
                "additionalProperties": {
                  "type": "boolean"
                }
              },
              "http_settings": {
                "type": "object",
                "properties": {
                  "http_https_enabled": {
                    "type": "boolean",
                    "description": "HTTP/HTTPS settings"
                  }
                }
              }
            }
          }
        }
      },
