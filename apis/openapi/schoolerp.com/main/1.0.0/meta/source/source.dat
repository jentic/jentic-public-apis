              "organization_admin",
              "school_admin",
              "school_staff",
              "accountant",
              "receptionist",
              "guardian",
              "hostel_admin",
              "library",
              "bus_incharge",
              "asset_manager"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "inactive",
              "suspended"
            ],
            "default": "active"
          }
        }
      },
