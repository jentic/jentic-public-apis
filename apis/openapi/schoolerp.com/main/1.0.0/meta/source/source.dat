          }
        }
      },
      "post": {
        "x-role-required": [
          "school_admin"
        ],
        "x-permission-required": [
          "classes:update"
        ],
        "tags": [
          "Academic"
        ],
        "summary": "Assign teacher to class-section",
        "description": "Assign a teacher to a specific class-section.\n\nUsed for \"ADD STAFF\" button in \"Update Class Teacher\" page.\nCreates entry in class_teachers table.\n",
        "operationId": "assignTeacherToClassSection",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdPathParam",
            "name": "id",
            "description": "Class ID"
          },
          {
            "name": "section_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Section ID"
          },
          {
            "$ref": "#/components/parameters/SchoolIdHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClassTeacherInput"
              },
              "example": {
                "staff_id": 10,
                "academic_year_id": 1
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Teacher assigned to class-section",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/ClassTeacher"
                    }
                  }
                },
                "example": {
                  "data": {
                    "id": 1,
                    "class_id": 3,
                    "section_id": 5,
                    "staff_id": 10,
                    "teacher": {
                      "id": 10,
                      "first_name": "KHUSHITA",
                      "last_name": "JAIN",
                      "employee_id": "EMP010"
                    },
                    "class_section": "3-A",
                    "created_at": "2024-07-25T07:38:00Z"
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "Conflict - Teacher already assigned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "TEACHER_ALREADY_ASSIGNED",
                    "message": "This teacher is already assigned to this class-section."
                  }
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
