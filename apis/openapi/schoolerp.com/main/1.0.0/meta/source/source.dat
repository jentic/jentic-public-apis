    "/users": {
      "get": {
        "x-role-required": [
          "super_admin",
          "organization_admin",
          "school_admin"
        ],
        "x-permission-required": [
          "users:read"
        ],
        "tags": [
          "Users"
        ],
        "summary": "List users",
        "description": "Get list of users with filtering and pagination.\n\n**Role-Based Access:**\n- **Super Admin**: Returns all users across all organizations\n- **Organization Admin**: Returns users in their organization\n- **School Admin**: Returns users in their school\n",
        "operationId": "listUsers",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/SchoolIdHeader"
          },
          {
            "$ref": "#/components/parameters/PageParam"
          },
          {
            "$ref": "#/components/parameters/PerPageParam"
          },
          {
            "$ref": "#/components/parameters/SearchParam"
          },
          {
            "name": "role",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "super_admin",
                "organization_admin",
                "school_admin",
                "school_staff",
                "accountant",
                "receptionist",
                "guardian",
                "hostel_admin",
                "library",
                "bus_incharge",
                "asset_manager"
              ]
            },
            "description": "Filter by role"
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "active",
                "inactive",
                "suspended"
              ]
            },
            "description": "Filter by status"
          },
          {
            "name": "school_id",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Filter by school ID (super admin only)"
          },
          {
            "name": "organization_id",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Filter by organization ID (super admin only)"
          }
        ],
        "responses": {
          "200": {
            "description": "List of users",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/User"
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/PaginationMeta"
                    }
                  }
                },
                "example": {
                  "data": [
                    {
                      "id": 123,
                      "email": "admin@school1.com",
                      "role": "school_admin",
                      "first_name": "John",
                      "last_name": "Doe",
                      "phone": "+91-9876543210",
                      "school_id": 1,
                      "organization_id": 1,
                      "status": "active",
                      "created_at": "2024-01-15T10:00:00Z",
                      "updated_at": "2024-01-15T10:00:00Z"
                    },
                    {
                      "id": 456,
                      "email": "teacher@school1.com",
                      "role": "school_staff",
                      "first_name": "Jane",
                      "last_name": "Smith",
                      "phone": "+91-9876543211",
                      "school_id": 1,
                      "organization_id": 1,
                      "status": "active",
                      "created_at": "2024-01-20T09:00:00Z",
                      "updated_at": "2024-01-20T09:00:00Z"
                    },
                    {
                      "id": 789,
                      "email": "accountant@school1.com",
                      "role": "accountant",
                      "first_name": "Robert",
                      "last_name": "Johnson",
                      "phone": "+91-9876543212",
                      "school_id": 1,
                      "organization_id": 1,
                      "status": "active",
                      "created_at": "2024-02-01T08:00:00Z",
