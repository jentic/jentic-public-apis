    "/permissions/check": {
      "post": {
        "x-role-required": [
          "super_admin",
          "organization_admin",
          "school_admin",
          "accountant",
          "receptionist",
          "guardian",
          "hostel_admin",
          "library",
          "bus_incharge",
          "asset_manager",
          "school_staff"
        ],
        "x-permission-required": [],
        "tags": [
          "Permissions"
        ],
        "summary": "Check permissions",
        "description": "Check if current user has specific permissions.\n\n**Usage:**\n- Frontend can use this to check permissions before showing/hiding UI elements\n- Returns which permissions the user has and which are missing\n",
        "operationId": "checkPermissions",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/SchoolIdHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "permissions"
                ],
                "properties": {
                  "permissions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Array of permission codes to check (e.g., ['students:read', 'fees:create'])"
                  },
                  "resource_type": {
                    "type": "string",
                    "description": "Optional resource type for context-specific checks"
                  },
                  "resource_id": {
                    "type": "integer",
                    "description": "Optional resource ID for context-specific checks"
                  }
                }
              },
              "example": {
                "permissions": [
                  "students:read",
                  "students:create",
                  "fees:update"
                ],
                "resource_type": "student",
                "resource_id": 123
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Permission check results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "has_permission": {
                          "type": "boolean",
                          "description": "True if user has all requested permissions"
                        },
                        "missing_permissions": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "description": "List of permission codes user is missing"
                        },
                        "granted_permissions": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "description": "List of permission codes user has"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "data": {
                    "has_permission": false,
                    "missing_permissions": [
                      "fees:update"
                    ],
                    "granted_permissions": [
                      "students:read",
                      "students:create"
                    ]
                  }
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
