    "/staff/extra-fields": {
      "get": {
        "x-role-required": [
          "school_admin",
          "accountant",
          "receptionist"
        ],
        "x-permission-required": [
          "staff:read"
        ],
        "tags": [
          "Staff"
        ],
        "summary": "List extra field definitions",
        "description": "Get list of all extra field definitions for staff.\n\nUsed for \"Additional Information Fields\" section and \"Fields Order\" button.\n",
        "operationId": "listExtraFieldDefinitions",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/SchoolIdHeader"
          },
          {
            "$ref": "#/components/parameters/PageParam"
          }
        ],
        "responses": {
          "200": {
            "description": "List of extra field definitions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
