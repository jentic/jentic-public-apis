    "/students/export-excel": {
      "post": {
        "x-role-required": [
          "school_admin",
          "accountant"
        ],
        "x-permission-required": [
          "student:export"
        ],
        "tags": [
          "Students"
        ],
        "summary": "Export students to Excel",
        "description": "Export filtered student list to Excel file.\n\nUsed for \"Export Excel\" button in \"VIEW STUDENT DETAILS\" page.\nExports all students matching the filter criteria.\n",
        "operationId": "exportStudentsToExcel",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/SchoolIdHeader"
          },
          {
            "name": "class_id",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Filter by class ID"
          },
          {
            "name": "section_id",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Filter by section ID"
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "active",
                "inactive",
                "removed"
              ]
            },
            "description": "Filter by status"
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "include_fields": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Fields to include in export"
                  }
                }
              },
              "example": {
                "include_fields": [
                  "admission_number",
                  "name",
                  "roll_no",
                  "standard",
                  "parent_name",
                  "phone"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Excel file",
            "content": {
              "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
