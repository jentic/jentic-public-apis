            "$ref": "#/components/parameters/IdPathParam"
          },
          {
            "$ref": "#/components/parameters/SchoolIdHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TeacherSubjectInput"
              },
              "example": {
                "class_id": 6,
                "section_id": 1,
                "subject_id": 5,
                "academic_year_id": 1
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Subject assigned to teacher",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/TeacherSubject"
                    }
                  }
                },
                "example": {
                  "data": {
                    "id": 1,
                    "staff_id": 2,
                    "class_id": 6,
                    "class": {
                      "id": 6,
                      "name": "6",
                      "code": "CLASS_6"
                    },
                    "section_id": 1,
                    "section": {
                      "id": 1,
                      "name": "A",
                      "code": "A"
                    },
                    "subject_id": 5,
                    "subject": {
                      "id": 5,
                      "name": "Social Science",
                      "code": "SOCIAL_SCIENCE"
                    },
                    "standard": "6-A",
                    "academic_year_id": 1,
                    "created_at": "2024-07-25T07:38:00Z",
                    "updated_at": "2024-07-25T07:38:00Z"
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "Conflict - Assignment already exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "ASSIGNMENT_ALREADY_EXISTS",
                    "message": "This subject is already assigned to this teacher for the specified class and section."
                  }
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
