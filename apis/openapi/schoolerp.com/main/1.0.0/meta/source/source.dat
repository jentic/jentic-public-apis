            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "BaseChapter": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "school_id": {
            "type": "integer"
          },
          "name": {
            "type": "string",
            "description": "Chapter name (e.g., \"Vedic Mathematics\", \"Number System\")"
          },
          "description": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "BaseChapterInput": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "description": {
            "type": "string"
          }
        }
      },
      "SyllabusTemplate": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "school_id": {
            "type": "integer"
          },
          "name": {
            "type": "string",
            "description": "Template name (e.g., \"RBSE - 9 - Mathematics\")"
          },
          "description": {
            "type": "string"
          },
          "standards": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer"
                },
                "name": {
                  "type": "string"
                },
                "code": {
                  "type": "string"
                }
              }
            },
            "description": "Associated classes/standards (Nursery, LKG, UKG, 1-12)"
          },
          "subjects": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer"
                },
                "name": {
                  "type": "string"
                },
                "code": {
                  "type": "string"
                }
              }
            },
            "description": "Associated subjects"
          },
          "competitions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CompetitionExam"
            },
            "description": "Associated competitions"
          },
          "exams": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CompetitionExam"
            },
            "description": "Associated exams"
          },
          "chapters_count": {
            "type": "integer",
            "description": "Number of chapters in template"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SyllabusTemplateInput": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "description": {
            "type": "string"
          },
          "class_ids": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "Array of class IDs (standards: Nursery, LKG, UKG, 1-12)"
          },
          "subject_ids": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "Array of subject IDs"
          },
          "competition_exam_ids": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "Array of competition/exam IDs (optional)"
          }
        }
      },
      "SyllabusTemplateChapter": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "template_id": {
            "type": "integer"
          },
          "name": {
            "type": "string",
            "description": "Chapter name (e.g., \"Vedic Mathematics\", \"Number System\")"
          },
          "display_order": {
            "type": "integer",
            "description": "Order column in \"Syllabus Chapters\" modal"
          },
          "main_basechapter": {
            "$ref": "#/components/schemas/BaseChapter",
            "description": "Main Basechapters column (can be null)"
          },
          "basechapters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BaseChapter"
            },
            "description": "Basechapters column (array, can be empty)"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SyllabusTemplateChapterInput": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "display_order": {
            "type": "integer",
            "default": 0,
            "description": "Order for display"
          },
          "main_basechapter_id": {
            "type": "integer",
            "description": "Main base chapter ID (optional)"
          },
          "basechapter_ids": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "Array of base chapter IDs (optional, can be empty)"
          }
        }
      },
      "CompetitionExam": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "school_id": {
            "type": "integer"
          },
          "category": {
            "type": "string",
            "description": "Competition/exam category (e.g., \"Class 5-10\", \"Class 11-12\", \"Extracurricular Activity\", \"Language Learning\", or any custom category)"
          },
          "name": {
            "type": "string",
            "description": "Competition/exam name (e.g., \"NTSE STAGE-1\", \"Board\", \"Summer Camp\")"
          },
          "description": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CompetitionExamInput": {
        "type": "object",
        "required": [
          "category",
          "name"
        ],
        "properties": {
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Competition/exam category (can be any custom category name)"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "description": {
            "type": "string"
          }
        }
      },
      "Book": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "school_id": {
            "type": "integer"
          },
          "isbn": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "category_id": {
            "type": "integer"
          },
          "edition": {
            "type": "string"
          },
          "total_copies": {
            "type": "integer"
          },
          "available_copies": {
            "type": "integer"
          },
          "book_number": {
            "type": "string"
          },
          "shelf_number": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "format": "decimal"
          },
          "status": {
            "type": "string",
            "enum": [
              "available",
              "checked_out",
              "reserved"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "BookInput": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "isbn": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "category_id": {
            "type": "integer"
          },
          "edition": {
            "type": "string"
          },
          "total_copies": {
            "type": "integer"
          },
          "book_number": {
            "type": "string"
          },
          "shelf_number": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "format": "decimal"
          }
        }
      },
      "Checkout": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "school_id": {
            "type": "integer"
          },
          "book_id": {
            "type": "integer"
          },
          "checkoutable_type": {
            "type": "string",
            "enum": [
              "Student",
              "Staff"
            ]
          },
          "checkoutable_id": {
            "type": "integer"
          },
          "checkout_date": {
            "type": "string",
            "format": "date"
          },
          "due_date": {
            "type": "string",
            "format": "date"
          },
          "return_date": {
            "type": "string",
            "format": "date"
          },
          "fine_amount": {
            "type": "number",
            "format": "decimal"
          },
          "status": {
            "type": "string",
            "enum": [
              "checked_out",
              "returned",
              "overdue"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Unauthorized - Invalid or missing authentication token",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "UNAUTHORIZED",
                "message": "Invalid or expired token"
              }
            }
          }
        }
      },
      "Forbidden": {
        "description": "Forbidden - Insufficient permissions",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "FORBIDDEN",
                "message": "You do not have permission to access this resource"
              }
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "NOT_FOUND",
                "message": "Resource not found"
              }
            }
          }
        }
      },
      "ValidationError": {
        "description": "Validation error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ValidationError"
            }
          }
        }
      },
      "Conflict": {
        "description": "Conflict - Resource already exists or constraint violation",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "CONFLICT",
                "message": "Resource already exists",
                "details": {
                  "field": "admission_number",
                  "message": "Admission number already exists for this school"
                }
              }
            }
          }
        }
      },
      "TooManyRequests": {
        "description": "Too many requests - Rate limit exceeded",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "TOO_MANY_REQUESTS",
                "message": "Rate limit exceeded. Please try again later.",
                "details": {
                  "retry_after": 60
                }
              }
            }
          }
        }
      },
      "InternalServerError": {
        "description": "Internal server error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": {
                "code": "INTERNAL_SERVER_ERROR",
                "message": "An unexpected error occurred"
              }
            }
          }
        }
      }
    }
  }
}
