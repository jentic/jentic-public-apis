        "description": "Download Excel template for bulk student upload.\n\nUsed for \"Download Template\" button in \"Upload Excel\" section.\nReturns Excel file with all required columns and optional columns including extra fields.\n\n**Template Includes:**\n- Required columns: Admission Number, First Name, Last Name, Date of Birth, Gender, Class, Section, Date of Admission\n- Optional columns: All other student fields (SR No, Aadhaar Number, Address, City, State, etc.)\n- **Extra Fields**: All active extra field definitions for students are included as columns\n- Extra field columns use the `field_name` as the column header\n- Example: If \"NIC No.\" and \"PEN (Permanent Education No.)\" are defined, they appear as columns\n\n**Extra Fields in Template:**\n- Only active extra field definitions (`is_active=true`) are included\n- Columns are ordered by `display_order`\n- Column headers match the `field_name` exactly\n",
        "operationId": "downloadStudentUploadTemplate",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/SchoolIdHeader"
          },
          {
            "name": "include_extra_fields",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": true
            },
            "description": "Include extra field columns in template (default: true)"
          }
        ],
        "responses": {
          "200": {
            "description": "Excel template file",
            "content": {
              "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    },
    "/students/upload/instructions": {
      "get": {
        "x-role-required": [
          "school_admin"
        ],
        "x-permission-required": [
          "student:create"
        ],
        "tags": [
          "Students"
        ],
        "summary": "Get Excel format instructions",
        "description": "Get instructions for uploading Excel file.\n\nUsed for \"SHOW EXCEL FORMAT INSTRUCTIONS\" button in \"Upload Excel\" section.\nReturns detailed instructions on Excel format, required columns, and data validation rules.\n",
        "operationId": "getStudentUploadInstructions",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/SchoolIdHeader"
          }
        ],
        "responses": {
          "200": {
            "description": "Excel format instructions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "instructions": {
                          "type": "string",
                          "description": "Detailed instructions text"
                        },
                        "required_columns": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "description": "List of required column names"
                        },
                        "sample_data": {
                          "type": "object",
                          "description": "Sample row data"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "data": {
                    "instructions": "Instructions for Uploading Excel:\n1. Download the template using \"Download Template\" button\n2. Fill in all required fields (marked with *)\n3. Maximum 400 students per upload\n4. Ensure all dates are in DD-MM-YYYY format\n5. Gender must be: Male, Female, or Other\n6. Category must be: GENERAL, OBC, SC, ST, or OTHER\n7. RTE must be: Yes or No\n8. Save file as .xlsx format\n",
                    "required_columns": [
                      "Admission Number",
                      "First Name",
                      "Last Name",
                      "Date of Birth",
                      "Gender",
                      "Class",
                      "Section",
                      "Date of Admission"
                    ],
                    "optional_columns": [
                      "SR No",
                      "Aadhaar Number",
                      "Address",
                      "City",
                      "State",
                      "Pin Code",
                      "Student Contact",
                      "Email",
                      "Nationality",
                      "Religion",
                      "Category",
                      "Blood Group",
                      "Transport",
                      "Medium",
                      "Pen Number",
                      "RTE",
                      "Apaar ID",
                      "House"
                    ],
                    "extra_fields": [
                      {
                        "field_name": "NIC No.",
                        "data_type": "Number",
                        "description": "NIC Number (numeric value)"
                      },
                      {
                        "field_name": "PEN (Permanent Education No.)",
                        "data_type": "Text",
                        "description": "Permanent Education Number (text value)"
                      }
                    ],
                    "sample_data": {
                      "admission_number": "STU2024001",
                      "first_name": "Rahul",
                      "last_name": "Sharma",
                      "date_of_birth": "15-05-2010",
                      "gender": "Male",
                      "class": "1",
                      "section": "A",
                      "admission_date": "01-04-2024",
                      "sr_no": "PVT001",
                      "aadhaar_number": "123456789012",
                      "address": "123, Green Park, Sector 15",
                      "city": "New Delhi",
                      "state": "Delhi",
                      "pin_code": "110016",
                      "student_contact": "9876543210",
                      "email": "rahul.sharma@email.com",
                      "nationality": "Indian",
                      "religion": "Hindu",
                      "category": "GENERAL",
                      "blood_group": "O+",
                      "transport": "Route 1",
                      "medium": "English",
                      "pen_number": "PEN123456",
                      "rte": "No",
                      "apaar_id": "APAAR123456",
                      "house": "Red House",
                      "NIC No.": "NIC123456",
                      "PEN (Permanent Education No.)": "PEN789012"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/students/upload": {
      "post": {
        "x-role-required": [
          "school_admin"
        ],
        "x-permission-required": [
          "student:create"
        ],
        "tags": [
          "Students"
        ],
        "summary": "Bulk upload students via Excel",
        "description": "Upload students in bulk using Excel file.\n\nUsed for \"UPLOAD EXCEL\" button in \"All in One\" section.\nMaximum 400 students per upload.\nReturns summary of successful and failed uploads.\n",
        "operationId": "bulkUploadStudents",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/SchoolIdHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "Excel file (.xlsx) with student data"
                  },
                  "max_students": {
                    "type": "integer",
                    "default": 400,
                    "description": "Maximum number of students to upload (default: 400)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Upload summary",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "total_rows": {
                          "type": "integer"
                        },
                        "successful": {
                          "type": "integer"
                        },
                        "failed": {
                          "type": "integer"
                        },
                        "errors": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "row": {
                                "type": "integer"
                              },
                              "admission_number": {
                                "type": "string"
                              },
                              "error": {
                                "type": "string"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "data": {
                    "total_rows": 100,
                    "successful": 95,
                    "failed": 5,
                    "errors": [
                      {
                        "row": 3,
                        "admission_number": "STU2024003",
                        "error": "Duplicate admission number"
                      },
                      {
                        "row": 15,
                        "admission_number": "STU2024015",
                        "error": "Invalid date format"
                      }
                    ]
                  }
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/students/print-form": {
      "get": {
        "x-role-required": [
