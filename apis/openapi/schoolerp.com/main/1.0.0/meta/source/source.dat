          "200": {
            "description": "School switched successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "properties": {
                        "token": {
                          "type": "string",
                          "description": "New JWT token with updated school context"
                        },
                        "school": {
                          "$ref": "#/components/schemas/School"
                        },
                        "organization": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "integer"
                            },
                            "name": {
                              "type": "string"
                            },
                            "subdomain": {
                              "type": "string"
                            },
                            "plan_id": {
                              "type": "integer",
                              "description": "Reference to subscription_plans table"
                            },
                            "plan": {
                              "type": "object",
                              "description": "Related subscription plan object (when included)",
                              "properties": {
                                "id": {
                                  "type": "integer"
                                },
                                "name": {
                                  "type": "string"
                                },
                                "code": {
                                  "type": "string"
                                },
                                "plan_type": {
                                  "type": "string"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
