    "/staff/{id}/reset-password": {
      "post": {
        "x-role-required": [
          "school_admin"
        ],
        "x-permission-required": [
          "staff:update"
        ],
        "tags": [
          "Staff"
        ],
        "summary": "Reset staff password",
        "description": "Reset password for staff member.\n\nUsed for \"Reset password\" option in context menu.\n",
        "operationId": "resetStaffPassword",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdPathParam"
          },
          {
            "$ref": "#/components/parameters/SchoolIdHeader"
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "new_password": {
                    "type": "string",
                    "minLength": 8,
                    "description": "New password (if not provided, generates random password)"
                  },
                  "notify": {
                    "type": "boolean",
                    "default": true,
                    "description": "Send password to staff via email/SMS"
                  }
                }
              },
              "example": {
                "new_password": "",
                "notify": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password reset successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string"
                        },
                        "password": {
                          "type": "string",
                          "description": "New password (only if notify=false)"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "data": {
                    "message": "Password reset successfully. New password sent to staff member."
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/staff/{id}/login-devices": {
      "get": {
        "x-role-required": [
          "school_admin",
          "accountant",
          "receptionist"
        ],
        "x-permission-required": [
          "staff:read"
        ],
        "tags": [
          "Staff"
        ],
        "summary": "Get staff login devices",
        "description": "Get all login devices for a staff member.\n\nUsed for \"Staff login devices\" option in context menu.\nReturns devices from staff_devices table.\n",
        "operationId": "getStaffLoginDevices",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdPathParam"
          },
          {
            "$ref": "#/components/parameters/SchoolIdHeader"
          }
        ],
        "responses": {
          "200": {
            "description": "Staff login devices",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer"
                          },
                          "device_type": {
                            "type": "string"
                          },
                          "device_id": {
                            "type": "string"
                          },
                          "device_name": {
                            "type": "string"
                          },
                          "status": {
                            "type": "string"
                          },
                          "assigned_date": {
                            "type": "string",
                            "format": "date"
                          },
                          "created_at": {
                            "type": "string",
                            "format": "date-time"
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "data": [
                    {
                      "id": 1,
                      "device_type": "mobile",
                      "device_id": "ABC123XYZ",
                      "device_name": "Samsung Galaxy S21",
                      "status": "active",
                      "assigned_date": "2024-01-01",
                      "created_at": "2024-01-01T10:00:00Z"
                    },
                    {
                      "id": 2,
                      "device_type": "tablet",
                      "device_id": "DEF456UVW",
                      "device_name": "iPad Pro",
                      "status": "active",
                      "assigned_date": "2024-01-15",
                      "created_at": "2024-01-15T11:00:00Z"
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/staff/sms-credentials": {
      "post": {
        "x-role-required": [
          "school_admin"
        ],
        "x-permission-required": [
          "staff:update"
        ],
        "tags": [
          "Staff"
        ],
        "summary": "SMS credentials to teachers",
        "description": "Send SMS with login credentials to teachers/staff.\n\nUsed for \"SMS Credentials To Teachers\" button in staff listing.\n",
        "operationId": "smsCredentialsToTeachers",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/SchoolIdHeader"
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "staff_ids": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    },
                    "description": "Staff IDs to send credentials to (if empty, sends to all teachers)"
                  },
                  "role_filter": {
                    "type": "string",
                    "enum": [
                      "teacher",
                      "all"
                    ],
                    "default": "teacher",
                    "description": "Filter by role (teacher = only teachers, all = all staff)"
                  }
                }
              },
              "example": {
                "staff_ids": [],
                "role_filter": "teacher"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "SMS sent successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string"
                        },
                        "sent_count": {
                          "type": "integer"
                        },
                        "failed_count": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "data": {
                    "message": "SMS credentials sent successfully",
                    "sent_count": 25,
                    "failed_count": 2
                  }
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/staff/export": {
      "get": {
        "x-role-required": [
          "school_admin",
          "accountant",
          "receptionist"
        ],
        "x-permission-required": [
          "staff:read"
        ],
        "tags": [
          "Staff"
        ],
        "summary": "Export staff to Excel",
        "description": "Export staff list to Excel file.\n\nUsed for \"Export excel\" button in staff listing.\n\n**Export Columns:**\n- Name, Designation, Departments, Emp. Code, Contacts, Login Roles, Short Code (if enabled)\n",
        "operationId": "exportStaff",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/SchoolIdHeader"
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "active",
                "inactive",
                "all"
              ],
              "default": "all"
            },
            "description": "Filter by status"
          },
          {
            "name": "department_id",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Filter by department ID"
          },
          {
            "name": "designation_id",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Filter by designation ID"
          },
          {
            "name": "include_columns",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated list of columns to include (name, designation, departments, emp_code, contacts, login_roles, short_code)",
            "example": "name,designation,departments,emp_code,contacts,login_roles"
          }
        ],
        "responses": {
          "200": {
            "description": "Excel file",
            "content": {
              "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "application/vnd.ms-excel": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    },
    "/staff/upload": {
      "post": {
        "x-role-required": [
          "school_admin"
        ],
        "x-permission-required": [
          "staff:create"
        ],
        "tags": [
          "Staff"
        ],
        "summary": "Bulk upload staff from Excel",
        "description": "Upload staff data from Excel file.\n\nUsed for \"Upload Excel\" section - \"All in One\" upload.\n\n**Excel Format Requirements:**\n- Download template first using GET /staff/upload/template\n- Use exact template structure (columns: name, dob, gender, adhar_no, address, religion, category, nationality, contact1, contact2, doj, dop, employee_code, alma_mater, major, short_code, department, designation, rfid, uuid, blood_group, website)\n- Date format: DD-MM-YYYY (e.g., 25-11-1994)\n- Mandatory fields: name, department, designation, gender\n- Department and Designation must exist before upload\n- Gender: male, female\n- Category: GENERAL, OBC, SC, ST, SBC, BC-A, BC-B, MINORITY, EWS, OTHER\n- Religion: HINDU, MUSLIM, SIKH, BUDDHIST, CHRISTIAN, JAIN, PARSI, OTHER\n- Website: 1 or 0\n",
        "operationId": "bulkUploadStaff",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/SchoolIdHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "Excel file (.xls, .xlsx)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Staff uploaded successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "total_rows": {
                          "type": "integer"
                        },
                        "successful": {
                          "type": "integer"
                        },
                        "failed": {
                          "type": "integer"
                        },
                        "errors": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "row": {
                                "type": "integer"
                              },
                              "error": {
                                "type": "string"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "data": {
                    "total_rows": 10,
                    "successful": 8,
                    "failed": 2,
                    "errors": [
                      {
                        "row": 3,
                        "error": "Invalid date format for DOB"
                      },
                      {
                        "row": 7,
                        "error": "Department 'Invalid Dept' not found"
                      }
                    ]
                  }
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
