          },
          {
            "$ref": "#/components/parameters/SchoolIdHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "role_id"
                ],
                "properties": {
                  "role_id": {
                    "type": "integer",
                    "description": "Role ID to assign"
                  }
                }
              },
              "example": {
                "role_id": 5
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Role added to staff",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Role"
                    }
                  }
                },
                "example": {
                  "data": {
                    "id": 5,
                    "name": "Teacher",
                    "code": "teacher",
                    "description": "Teacher role"
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "Conflict - Role already assigned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "ROLE_ALREADY_ASSIGNED",
                    "message": "Role is already assigned to this staff member."
                  }
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/staff/{id}/roles/{role_id}": {
