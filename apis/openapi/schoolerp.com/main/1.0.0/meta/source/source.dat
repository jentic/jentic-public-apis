        "summary": "Get teachers for a class-section",
        "description": "Get all teachers assigned to a specific class-section",
        "operationId": "getClassSectionTeachers",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdPathParam",
            "name": "id",
            "description": "Class ID"
          },
          {
            "name": "section_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Section ID"
          },
          {
            "$ref": "#/components/parameters/SchoolIdHeader"
          }
        ],
        "responses": {
          "200": {
            "description": "Class-section teachers",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ClassTeacher"
                      }
                    }
                  }
                },
                "example": {
                  "data": [
                    {
                      "id": 1,
                      "class_id": 3,
                      "section_id": 5,
                      "staff_id": 10,
                      "teacher": {
                        "id": 10,
                        "first_name": "KHUSHITA",
                        "last_name": "JAIN",
                        "employee_id": "EMP010"
                      },
                      "created_at": "2024-07-25T07:38:00Z"
