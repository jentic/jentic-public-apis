    "/students": {
      "get": {
        "x-role-required": [
          "school_admin",
          "accountant",
          "receptionist"
        ],
        "x-permission-required": [
          "student:list"
        ],
        "tags": [
          "Students"
        ],
        "summary": "List students",
        "description": "Get list of students with filtering and pagination.\n\nUsed for \"VIEW STUDENT DETAILS\" page - left sidebar student list.\nReturns students with parent names, photos, roll numbers, and standard format.\n",
        "operationId": "listStudents",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/SchoolIdHeader"
          },
          {
            "$ref": "#/components/parameters/PageParam"
          },
          {
            "$ref": "#/components/parameters/PerPageParam"
          },
          {
            "$ref": "#/components/parameters/SearchParam"
          },
          {
            "name": "class_id",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Filter by class ID (e.g., 1, 2, 3, LKG, NURSERY, UKG)"
          },
          {
            "name": "section_id",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Filter by section ID (e.g., A, B, C)"
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "active",
                "inactive",
                "removed"
              ]
            },
            "description": "Filter by status (active, inactive, removed)"
          },
          {
            "name": "include_parent_name",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": true
            },
            "description": "Include parent/guardian name in response (default: true)"
          },
          {
            "name": "include_photo",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": true
            },
            "description": "Include photo URL in response (default: true)"
          },
          {
            "name": "include_counts",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": true
            },
            "description": "Include status counts in meta (e.g., ACTIVE STUDENTS (50)) (default: true)"
          }
        ],
        "responses": {
          "200": {
            "description": "List of students",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/StudentListItem"
                      }
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "page": {
                          "type": "integer"
                        },
                        "per_page": {
                          "type": "integer"
                        },
                        "total": {
                          "type": "integer"
                        },
                        "total_pages": {
                          "type": "integer"
                        },
                        "counts_by_status": {
                          "type": "object",
                          "description": "Student counts by status (e.g., ACTIVE STUDENTS (50), REMOVED STUDENTS (13))",
                          "properties": {
                            "active": {
                              "type": "integer",
                              "example": 50
                            },
                            "inactive": {
                              "type": "integer",
                              "example": 0
                            },
                            "removed": {
                              "type": "integer",
                              "example": 13
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "data": [
                    {
                      "id": 1,
                      "first_name": "AARADHYA",
                      "last_name": "CHOUDHARY",
                      "photo_url": "https://cdn.schoolerp.com/students/photos/aaradhya.jpg",
                      "parent_name": "RAMDEV CHOUDHARY",
                      "roll_no": "1101",
                      "standard": "1-A",
                      "sr_no": "2257",
                      "admission_number": "STU2024001",
                      "class_id": 1,
                      "section_id": 1,
                      "status": "active"
                    },
                    {
                      "id": 2,
                      "first_name": "AARUSH",
                      "last_name": null,
                      "photo_url": "https://cdn.schoolerp.com/students/photos/aarush.jpg",
                      "parent_name": "NARESH PARIWAL",
                      "roll_no": "1102",
                      "standard": "1-A",
                      "sr_no": "2258",
                      "admission_number": "STU2024002",
                      "class_id": 1,
                      "section_id": 1,
                      "status": "active"
                    },
                    {
                      "id": 3,
                      "first_name": "AARYAN JAYEL",
                      "last_name": null,
                      "photo_url": null,
                      "parent_name": "RAMPAL JAYEL",
                      "roll_no": "1103",
                      "standard": "1-A",
                      "sr_no": "2259",
                      "admission_number": "STU2024003",
                      "class_id": 1,
                      "section_id": 1,
                      "status": "active"
                    }
                  ],
                  "meta": {
                    "page": 1,
                    "per_page": 20,
                    "total": 50,
                    "total_pages": 3,
                    "counts_by_status": {
                      "active": 50,
                      "inactive": 0,
                      "removed": 13
                    }
                  }
                }
              }
            }
          }
        }
      },
