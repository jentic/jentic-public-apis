                          "Manager",
                          "Exam Incharge",
                          "Receptionist",
                          "Administrator",
                          "Accountant",
                          "Cashier",
                          "Teacher",
                          "Exam-Incharge",
                          "Driver",
                          "Peon",
                          "Sweeper",
                          "Gaurd",
                          "Store keeper",
                          "Cook",
                          "PTI",
                          "Typist"
                        ]
                      },
                      {
                        "column": "Gender",
                        "allowed_values": [
                          "male",
                          "female"
                        ]
                      },
                      {
                        "column": "Date of Birth (DOB), Date of Profession (DOP), Date Of Joining (DOJ)",
                        "allowed_values": [
                          "DD-MM-YYYY (Eg. 25-11-1994)"
                        ]
                      },
                      {
                        "column": "Category",
                        "allowed_values": [
                          "GENERAL",
                          "OBC",
                          "SC",
                          "ST",
                          "SBC",
                          "BC-A",
                          "BC-B",
                          "MINORITY",
                          "EWS",
                          "OTHER"
                        ]
                      },
                      {
                        "column": "Religion",
                        "allowed_values": [
                          "HINDU",
                          "MUSLIM",
                          "SIKH",
                          "BUDDHIST",
                          "CHRISTIAN",
                          "JAIN",
                          "PARSI",
                          "OTHER"
                        ]
                      },
                      {
                        "column": "Website",
                        "allowed_values": [
                          "1",
                          "0"
                        ]
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
