    "/students/{id}/parents/link-other-student": {
      "post": {
        "x-role-required": [
          "school_admin"
        ],
        "x-permission-required": [
          "student:update"
        ],
        "tags": [
          "Students"
        ],
        "summary": "Link other student guardians",
        "description": "Link guardians from another student to this student.\n\nUsed for \"LINK OTHER STUDENT GUARDIANS\" button in \"Guardian Details\" section.\n",
        "operationId": "linkOtherStudentGuardians",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdPathParam"
          },
          {
            "$ref": "#/components/parameters/SchoolIdHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "other_student_id"
                ],
                "properties": {
                  "other_student_id": {
                    "type": "integer",
                    "description": "ID of the other student whose guardians to link"
                  },
                  "link_all": {
                    "type": "boolean",
                    "default": true,
                    "description": "Link all guardians or select specific ones"
                  },
                  "parent_ids": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    },
                    "description": "Specific parent IDs to link (if link_all=false)"
                  }
                }
              },
              "example": {
                "other_student_id": 2,
                "link_all": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Guardians linked successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string"
                        },
                        "linked_count": {
                          "type": "integer"
                        },
                        "linked_parents": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/StudentParent"
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "data": {
                    "message": "Guardians linked successfully",
                    "linked_count": 2,
                    "linked_parents": [
                      {
                        "id": 3,
                        "student_id": 1,
                        "relation": "father",
                        "name": "RAMDEV CHOUDHARY",
                        "primary_contact": "6375855047",
                        "app_access": true,
                        "gatepass_access": true
                      }
                    ]
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
