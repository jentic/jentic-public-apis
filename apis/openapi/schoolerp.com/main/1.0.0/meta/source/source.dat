              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Sibling relationship created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                }
              }
            }
          }
        }
      }
