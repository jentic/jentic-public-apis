            "type": "integer"
          },
          "school_id": {
            "type": "integer"
          },
          "setting_key": {
            "type": "string",
            "description": "Setting key (e.g., \"prospectus\", \"reset_invoice_no_financial_year\", \"student_fees_notification\")"
          },
          "setting_value": {
            "type": "string",
            "description": "Setting value (can be string, JSON string, etc.)"
          },
          "settings": {
            "type": "object",
            "description": "Complex settings stored as JSONB (for settings with multiple fields, options, etc.)",
            "additionalProperties": true
          },
          "setting_category": {
            "type": "string",
            "description": "Setting category (e.g., \"School Features\", \"Automatic Notifications\", \"Director Settings\", \"Admin Settings\", \"Accounts Settings\", \"Enquiry Settings\", \"App Settings\", \"Student Certificates\", \"Teacher App Features\", \"HR Payroll Settings\")"
          },
          "display_order": {
            "type": "integer",
            "description": "Display order in UI"
          },
          "is_active": {
            "type": "boolean",
            "description": "Whether setting is active"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
