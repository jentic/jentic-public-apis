    "/staff/{id}/reset-credentials-link": {
      "post": {
        "x-role-required": [
          "school_admin"
        ],
        "x-permission-required": [
          "staff:update"
        ],
        "tags": [
          "Staff"
        ],
        "summary": "Send reset credentials link",
        "description": "Send reset credentials link to staff member's email/phone.\n\nUsed for \"Send reset credentials link\" option in context menu.\n",
        "operationId": "sendResetCredentialsLink",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdPathParam"
          },
          {
            "$ref": "#/components/parameters/SchoolIdHeader"
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "method": {
                    "type": "string",
                    "enum": [
                      "email",
                      "sms",
                      "both"
                    ],
                    "default": "email",
                    "description": "Method to send link (email, sms, both)"
                  }
                }
              },
              "example": {
                "method": "email"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reset credentials link sent",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                },
