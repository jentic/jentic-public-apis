      "UserInput": {
        "type": "object",
        "required": [
          "email",
          "password",
          "school_id"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 255,
            "description": "User email address (must be unique per school)"
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 8,
            "description": "User password (minimum 8 characters)"
          },
          "first_name": {
            "type": "string",
            "maxLength": 100
          },
          "last_name": {
            "type": "string",
            "maxLength": 100
          },
          "phone": {
            "type": "string",
            "maxLength": 20
          },
          "school_id": {
            "type": "integer",
            "description": "School ID for this user"
          },
          "organization_id": {
            "type": "integer",
            "description": "Organization ID (optional, defaults to school's organization)"
          },
          "role": {
            "type": "string",
