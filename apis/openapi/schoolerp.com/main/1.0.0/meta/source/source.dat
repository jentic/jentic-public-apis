    "/classes/teachers": {
      "get": {
        "x-role-required": [
          "school_admin",
          "accountant",
          "receptionist"
        ],
        "x-permission-required": [
          "classes:read"
        ],
        "tags": [
          "Academic"
        ],
        "summary": "List all classes with assigned teachers",
        "description": "Get list of all classes with their assigned teachers and student counts.\n\nUsed for \"Update Class Teacher\" page with columns:\n- Class (format: \"Grade-Section\", e.g., \"1-A\", \"3-B\")\n- Student Count (number of students in the class-section)\n- Teacher (assigned teacher name with X to remove, or \"ADD STAFF\" button)\n\n**Response Format:**\n- Class name in \"Grade-Section\" format (e.g., \"1-A\", \"3-B\")\n- Student count calculated from students table\n- Assigned teachers array (can have multiple teachers per class-section)\n",
        "operationId": "listClassesWithTeachers",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/SchoolIdHeader"
          },
          {
            "$ref": "#/components/parameters/PageParam"
          },
          {
            "$ref": "#/components/parameters/PerPageParam"
          },
          {
            "name": "class_id",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Filter by class ID"
          },
          {
            "name": "academic_year_id",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Filter by academic year ID"
          }
        ],
        "responses": {
          "200": {
            "description": "List of classes with assigned teachers",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "class_id": {
                            "type": "integer"
                          },
                          "section_id": {
                            "type": "integer"
                          },
                          "class_name": {
                            "type": "string",
                            "description": "Class name (e.g., \"1\", \"3\")"
                          },
                          "section_name": {
                            "type": "string",
                            "description": "Section name (e.g., \"A\", \"B\", \"C\")"
                          },
                          "class_section": {
                            "type": "string",
                            "description": "Class-section format (e.g., \"1-A\", \"3-B\")"
                          },
                          "student_count": {
                            "type": "integer",
                            "description": "Number of students in this class-section"
                          },
                          "teachers": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "id": {
                                  "type": "integer",
                                  "description": "Class teacher assignment ID"
                                },
                                "staff_id": {
                                  "type": "integer"
                                },
                                "teacher_name": {
                                  "type": "string",
                                  "description": "Full name of teacher (first_name + last_name)"
                                },
                                "employee_id": {
                                  "type": "string"
                                },
                                "created_at": {
                                  "type": "string",
                                  "format": "date-time"
                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/PaginationMeta"
                    }
                  }
                },
                "example": {
                  "data": [
                    {
                      "class_id": 1,
                      "section_id": 1,
                      "class_name": "1",
                      "section_name": "A",
                      "class_section": "1-A",
                      "student_count": 50,
