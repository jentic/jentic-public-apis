    "/students/{id}/message": {
      "post": {
        "x-role-required": [
          "school_admin",
          "teacher"
        ],
        "x-permission-required": [
          "student:send_message"
        ],
        "tags": [
          "Students"
        ],
        "summary": "Send message to student/parents",
        "description": "Send message to student or parents/guardians.\n\nUsed for message icon in \"VIEW STUDENT DETAILS\" page.\n",
        "operationId": "sendMessageToStudent",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdPathParam"
          },
          {
            "$ref": "#/components/parameters/SchoolIdHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "message"
                ],
                "properties": {
                  "message": {
                    "type": "string",
                    "description": "Message content"
                  },
                  "send_to": {
                    "type": "string",
                    "enum": [
                      "student",
                      "parents",
                      "both"
                    ],
                    "default": "parents",
                    "description": "Send to student, parents, or both"
                  },
                  "send_via": {
                    "type": "string",
                    "enum": [
                      "sms",
                      "email",
                      "app",
                      "all"
                    ],
                    "default": "all",
                    "description": "Send via SMS, Email, App, or all"
                  }
                }
              },
              "example": {
                "message": "Please attend the parent-teacher meeting on 20th June.",
                "send_to": "parents",
                "send_via": "all"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Message sent successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string"
                        },
                        "sent_count": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "data": {
                    "message": "Message sent successfully",
                    "sent_count": 2
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
