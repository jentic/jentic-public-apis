      "post": {
        "x-role-required": [
          "super_admin",
          "organization_admin",
          "school_admin"
        ],
        "x-permission-required": [
          "users:create"
        ],
        "tags": [
          "Users"
        ],
        "summary": "Create user",
        "description": "Create a new user account.\n\n**Role-Based Access:**\n- **Super Admin**: Can create users for any organization/school\n- **Organization Admin**: Can create users for schools in their organization\n- **School Admin**: Can create users for their school\n\n**Note**: After creating a user, assign roles using `POST /users/{id}/roles`\n",
        "operationId": "createUser",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/SchoolIdHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserInput"
              },
              "examples": {
                "school_admin": {
                  "summary": "Create School Admin",
                  "value": {
                    "email": "newadmin@school1.com",
                    "password": "SecurePassword123!",
                    "first_name": "Alice",
                    "last_name": "Williams",
                    "phone": "+91-9876543213",
                    "school_id": 1,
                    "organization_id": 1,
                    "role": "school_admin",
                    "status": "active"
                  }
                },
                "teacher": {
                  "summary": "Create Teacher/Staff",
                  "value": {
                    "email": "newteacher@school1.com",
                    "password": "SecurePassword123!",
                    "first_name": "Bob",
                    "last_name": "Brown",
                    "phone": "+91-9876543214",
                    "school_id": 1,
                    "organization_id": 1,
                    "role": "school_staff",
                    "status": "active"
                  }
                },
                "parent": {
                  "summary": "Create Parent/Guardian",
                  "value": {
                    "email": "newparent@example.com",
                    "password": "SecurePassword123!",
                    "first_name": "Carol",
                    "last_name": "Davis",
                    "phone": "+91-9876543215",
                    "school_id": 1,
                    "organization_id": 1,
                    "role": "guardian",
                    "status": "active"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/User"
                    }
                  }
                },
                "example": {
                  "data": {
                    "id": 999,
                    "email": "newadmin@school1.com",
                    "role": "school_admin",
                    "first_name": "Alice",
                    "last_name": "Williams",
                    "phone": "+91-9876543213",
                    "school_id": 1,
                    "organization_id": 1,
                    "status": "active",
                    "created_at": "2024-06-15T10:30:00Z",
                    "updated_at": "2024-06-15T10:30:00Z"
                  }
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "409": {
            "description": "User already exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "code": "CONFLICT",
                    "message": "User with this email already exists for this school"
                  }
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/users/{id}": {
      "get": {
        "x-role-required": [
          "super_admin",
          "organization_admin",
          "school_admin"
        ],
        "x-permission-required": [
          "users:read"
        ],
        "tags": [
          "Users"
        ],
        "summary": "Get user",
        "description": "Get user details with roles and permissions",
        "operationId": "getUser",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IdPathParam"
          },
          {
            "$ref": "#/components/parameters/SchoolIdHeader"
          }
        ],
        "responses": {
          "200": {
            "description": "User details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/User"
                        },
                        {
                          "type": "object",
                          "properties": {
                            "roles": {
                              "type": "array",
                              "description": "All roles assigned to this user",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "id": {
                                    "type": "integer"
                                  },
                                  "name": {
                                    "type": "string"
                                  },
                                  "code": {
                                    "type": "string"
                                  },
                                  "description": {
                                    "type": "string"
                                  },
                                  "school_id": {
                                    "type": "integer",
                                    "nullable": true
                                  },
                                  "organization_id": {
                                    "type": "integer",
                                    "nullable": true
                                  }
                                }
                              }
                            },
                            "permissions": {
                              "type": "array",
                              "description": "Aggregated permissions from all roles",
                              "items": {
                                "type": "string"
                              }
                            }
                          }
                        }
                      ]
                    }
                  }
                },
                "example": {
                  "data": {
                    "id": 123,
