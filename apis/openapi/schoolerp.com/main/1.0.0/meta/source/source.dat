    "/auth/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "User login",
        "description": "Authenticate user and receive JWT token.\n\n**Important**: `school_id` is required to identify which school the user is logging into.\nUsers can have access to multiple schools, so the school_id determines the context.\n\n**User Types**:\n- **Super Admin**: Can login to any school (school_id can be any school they have access to)\n- **Organization Admin**: Can login to any school in their organization\n- **School Admin**: Can login to their assigned school(s)\n- **School Staff/Teachers**: Can login to their assigned school\n- **Guardian/Parents**: Can login to see their children's school data\n- **Accountant, Receptionist, etc.**: Can login to their assigned school\n",
        "operationId": "login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password",
                  "school_id"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "description": "User email address"
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "description": "User password"
                  },
                  "school_id": {
                    "type": "integer",
                    "description": "School ID to login to (required for multi-tenant context)"
                  }
                }
              },
              "examples": {
                "school_admin": {
                  "summary": "Login as School Admin",
                  "value": {
                    "email": "admin@school1.com",
                    "password": "password123",
                    "school_id": 1
                  }
                },
                "teacher": {
                  "summary": "Login as Teacher",
                  "value": {
                    "email": "teacher@school1.com",
                    "password": "password123",
                    "school_id": 1
                  }
                },
                "parent": {
                  "summary": "Login as Parent/Guardian",
                  "value": {
                    "email": "parent@example.com",
                    "password": "password123",
                    "school_id": 1
                  }
                },
                "accountant": {
                  "summary": "Login as Accountant",
                  "value": {
                    "email": "accountant@school1.com",
                    "password": "password123",
                    "school_id": 1
                  }
                },
                "super_admin": {
                  "summary": "Login as Super Admin",
                  "value": {
                    "email": "superadmin@platform.com",
                    "password": "password123",
                    "school_id": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful login",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "token": {
                          "type": "string",
                          "description": "JWT access token"
                        },
                        "refresh_token": {
                          "type": "string",
                          "description": "Refresh token for obtaining new access tokens"
                        },
                        "expires_in": {
                          "type": "integer",
                          "description": "Token expiration time in seconds"
                        },
                        "user": {
                          "$ref": "#/components/schemas/User"
                        },
                        "roles": {
                          "type": "array",
                          "description": "All roles assigned to the user for this school",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "integer"
                              },
                              "name": {
                                "type": "string"
                              },
                              "code": {
                                "type": "string"
                              },
                              "description": {
                                "type": "string"
                              }
                            }
                          }
                        },
                        "permissions": {
                          "type": "array",
                          "description": "Aggregated permissions from all user roles",
                          "items": {
                            "type": "string"
                          }
                        },
                        "school": {
                          "type": "object",
                          "description": "School context for this login",
                          "properties": {
                            "id": {
                              "type": "integer"
                            },
                            "name": {
                              "type": "string"
                            },
                            "code": {
                              "type": "string"
                            },
                            "subdomain": {
                              "type": "string"
                            }
                          }
                        },
                        "organization": {
                          "type": "object",
                          "description": "Organization context",
                          "properties": {
                            "id": {
                              "type": "integer"
                            },
                            "name": {
                              "type": "string"
                            },
                            "subdomain": {
                              "type": "string"
                            },
                            "plan_id": {
                              "type": "integer"
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "examples": {
                  "school_admin": {
                    "summary": "School Admin Login Response",
                    "value": {
                      "data": {
                        "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VyX2lkIjoxMjMsInNjaG9vbF9pZCI6MSwicm9sZSI6InNjaG9vbF9hZG1pbiIsImV4cCI6MTcwNDA2NDgwMH0.example",
                        "refresh_token": "refresh_token_abc123xyz",
                        "expires_in": 3600,
                        "user": {
                          "id": 123,
                          "email": "admin@school1.com",
                          "role": "school_admin",
                          "first_name": "John",
                          "last_name": "Doe",
                          "phone": "+91-9876543210",
                          "school_id": 1,
                          "organization_id": 1,
                          "status": "active",
                          "created_at": "2024-01-15T10:00:00Z",
                          "updated_at": "2024-01-15T10:00:00Z"
                        },
                        "roles": [
                          {
                            "id": 3,
                            "name": "School Admin",
                            "code": "school_admin",
                            "description": "School administrator with full access to their school(s)"
                          }
                        ],
                        "permissions": [
                          "students:read",
                          "students:create",
                          "students:update",
                          "students:delete",
                          "staff:read",
                          "staff:create",
                          "fees:read",
                          "fees:create",
                          "fees:update",
                          "exams:read",
                          "exams:create",
                          "reports:read"
                        ],
                        "school": {
                          "id": 1,
                          "name": "ABC School",
                          "code": "ABC001",
                          "subdomain": "abc-main"
                        },
                        "organization": {
                          "id": 1,
                          "name": "ABC Education Group",
                          "subdomain": "abc",
                          "plan_id": 3
                        }
                      }
                    }
                  },
                  "teacher": {
                    "summary": "Teacher Login Response",
                    "value": {
                      "data": {
                        "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VyX2lkIjo0NTYsInNjaG9vbF9pZCI6MSwicm9sZSI6InNjaG9vbF9zdGFmZiIsImV4cCI6MTcwNDA2NDgwMH0.example",
                        "refresh_token": "refresh_token_teacher123",
                        "expires_in": 3600,
                        "user": {
                          "id": 456,
                          "email": "teacher@school1.com",
                          "role": "school_staff",
                          "first_name": "Jane",
                          "last_name": "Smith",
                          "phone": "+91-9876543211",
                          "school_id": 1,
                          "organization_id": 1,
                          "status": "active",
                          "created_at": "2024-01-20T09:00:00Z",
                          "updated_at": "2024-01-20T09:00:00Z"
                        },
                        "roles": [
                          {
                            "id": 11,
                            "name": "School Staff",
                            "code": "school_staff",
                            "description": "General school staff with custom permissions"
                          }
                        ],
                        "permissions": [
                          "students:read",
                          "attendance:read",
                          "attendance:create",
                          "exams:read",
                          "homework:read",
                          "homework:create"
                        ],
                        "school": {
                          "id": 1,
                          "name": "ABC School",
                          "code": "ABC001",
                          "subdomain": "abc-main"
                        },
                        "organization": {
                          "id": 1,
                          "name": "ABC Education Group",
                          "subdomain": "abc",
                          "plan_id": 3
                        }
                      }
                    }
                  },
                  "parent": {
                    "summary": "Parent/Guardian Login Response",
                    "value": {
                      "data": {
                        "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VyX2lkIjo3ODksInNjaG9vbF9pZCI6MSwicm9sZSI6Imd1YXJkaWFuIiwiZXhwIjoxNzA0MDY0ODAwfQ.example",
                        "refresh_token": "refresh_token_parent123",
                        "expires_in": 3600,
                        "user": {
                          "id": 789,
