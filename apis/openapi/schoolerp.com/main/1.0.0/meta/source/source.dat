            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "pattern": "^[a-z_]+$",
            "description": "Lowercase with underscores (e.g., 'custom_teacher')"
          },
          "description": {
            "type": "string"
          },
          "organization_id": {
            "type": "integer",
            "nullable": true,
            "description": "Organization ID for organization-specific roles"
          },
          "school_id": {
            "type": "integer",
            "nullable": true,
            "description": "School ID for school-specific roles"
          },
          "permission_ids": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "Array of permission IDs to assign to this role"
          }
        }
      },
      "Permission": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "code": {
