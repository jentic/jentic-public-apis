          },
          "is_main": {
            "type": "boolean",
            "default": false,
            "description": "Main subject (shown as \"MA\" tag)"
          },
          "is_additional": {
            "type": "boolean",
            "default": false,
            "description": "Additional subject (shown as \"A+\" tag)"
          },
          "is_optional": {
            "type": "boolean",
            "default": false,
            "description": "Optional subject (for some students only)"
          },
          "display_order": {
