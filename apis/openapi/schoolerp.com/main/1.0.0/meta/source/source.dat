    "/auth/me": {
      "get": {
        "x-role-required": [
          "super_admin",
          "organization_admin",
          "school_admin",
          "accountant",
          "receptionist",
          "guardian",
          "hostel_admin",
          "library",
          "bus_incharge",
          "asset_manager",
          "school_staff"
        ],
        "x-permission-required": [],
        "tags": [
          "Authentication"
        ],
        "summary": "Get current user",
        "description": "Get authenticated user information with roles and permissions",
        "operationId": "getCurrentUser",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/SchoolIdHeader"
          }
        ],
        "responses": {
          "200": {
            "description": "Current user information",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/User",
                      "properties": {
                        "roles": {
                          "type": "array",
                          "description": "All roles assigned to the user for current school",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "integer"
                              },
                              "name": {
                                "type": "string"
                              },
                              "code": {
                                "type": "string"
                              },
                              "description": {
                                "type": "string"
                              }
                            }
                          }
                        },
                        "permissions": {
                          "type": "array",
                          "description": "Aggregated permissions from all roles",
                          "items": {
                            "type": "string"
                          }
                        },
                        "school": {
                          "type": "object",
                          "description": "Current school context",
                          "properties": {
                            "id": {
                              "type": "integer"
                            },
                            "name": {
                              "type": "string"
                            },
                            "code": {
                              "type": "string"
                            }
                          }
                        },
                        "organization": {
                          "type": "object",
                          "description": "Organization context",
                          "properties": {
                            "id": {
                              "type": "integer"
                            },
                            "name": {
                              "type": "string"
                            },
                            "subdomain": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "data": {
                    "id": 123,
                    "email": "admin@school1.com",
                    "role": "school_admin",
                    "first_name": "John",
                    "last_name": "Doe",
                    "phone": "+91-9876543210",
                    "school_id": 1,
                    "organization_id": 1,
                    "status": "active",
                    "roles": [
                      {
                        "id": 3,
                        "name": "School Admin",
                        "code": "school_admin",
                        "description": "School administrator with full access to their school(s)"
                      }
                    ],
                    "permissions": [
                      "students:read",
                      "students:create",
                      "students:update",
                      "students:delete",
                      "staff:read",
                      "fees:read",
                      "fees:create"
                    ],
                    "school": {
                      "id": 1,
                      "name": "ABC School",
                      "code": "ABC001"
                    },
                    "organization": {
                      "id": 1,
                      "name": "ABC Education Group",
                      "subdomain": "abc"
                    },
                    "created_at": "2024-01-15T10:00:00Z",
                    "updated_at": "2024-01-15T10:00:00Z"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/auth/forgot-password": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Request password reset",
        "description": "Send password reset email to user",
        "operationId": "forgotPassword",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "school_id"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "description": "User email address"
                  },
                  "school_id": {
                    "type": "integer",
                    "description": "School ID for multi-tenant context"
                  }
                }
              },
              "example": {
                "email": "admin@school1.com",
                "school_id": 1
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password reset email sent",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                },
                "example": {
                  "data": {
                    "message": "Password reset email sent successfully"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/reset-password": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Reset password",
        "description": "Reset password using token from email",
        "operationId": "resetPassword",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "token",
                  "password",
                  "password_confirmation"
                ],
                "properties": {
                  "token": {
                    "type": "string",
                    "description": "Password reset token from email"
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "description": "New password",
                    "minLength": 8
                  },
                  "password_confirmation": {
                    "type": "string",
                    "format": "password",
                    "description": "Confirm new password (must match password)"
                  }
                }
              },
              "example": {
                "token": "reset_token_abc123xyz",
                "password": "newpassword123",
                "password_confirmation": "newpassword123"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password reset successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                },
                "example": {
                  "data": {
                    "message": "Password reset successfully"
                  }
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
