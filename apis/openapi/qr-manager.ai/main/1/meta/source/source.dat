openapi: 3.1.0

info:
  title: QR Manager AI API
  version: "1"
  description: |
    The QR Manager AI REST API lets you create, manage, and analyse QR codes
    programmatically. All endpoints require an API key issued from
    **Settings → API Keys**.

    ### Authentication

    Pass your API key as a Bearer token in every request:

    ```
    Authorization: Bearer qrm_your_api_key_here
    ```

    ### Plan requirements

    | Tier | Access |
    |---|---|
    | **Free** | No API access |
    | **Starter** | List, get, analytics, notifications, folders (read + write) |
    | **Pro / Enterprise** | Full access including create, update, and delete QR codes |

    ### Base URL

    ```
    https://qr-manager.ai/api/v1
    ```

  contact:
    name: QR Manager AI Support
    email: support@qr-manager.ai
  license:
    name: Proprietary

servers:
  - url: https://qr-manager.ai/api/v1
    description: Production

security:
  - ApiKeyAuth: []

tags:
  - name: QR Codes
    description: Create, retrieve, update, and delete QR codes.
  - name: Analytics
    description: Scan analytics for individual QR codes and your account.
  - name: Notifications
    description: Per-QR email notification thresholds.
  - name: Folders
    description: Organise QR codes into folders.

# ─── Paths ────────────────────────────────────────────────────────────────────

paths:

  # ── QR Codes ──────────────────────────────────────────────────────────────

  /qr:
    get:
      operationId: listQrCodes
      summary: List QR codes
      description: Returns all active (non-deleted) QR codes for the authenticated account, ordered newest first.
      tags: [QR Codes]
      x-required-plan: Starter
      responses:
        "200":
          description: OK
          content:
            application/json:
              schema:
                type: object
                required: [qrCodes]
                properties:
                  qrCodes:
                    type: array
                    items:
                      $ref: "#/components/schemas/QrCode"
              example:
                qrCodes:
                  - id: clxyz123
                    slug: abc12345
                    qrType: URL
                    redirectUrl: "https://example.com"
                    qrContent: null
                    title: My Campaign
                    scanCount: 482
                    shortUrl: "https://qr-m.app/abc12345"
                    fgColor: "#000000"
                    bgColor: "#ffffff"
                    dotStyle: rounded
                    cornerStyle: square
                    expiresAt: null
                    maxScans: null
                    utmSource: instagram
                    utmMedium: social
                    utmCampaign: spring_launch
                    safetyStatus: SAFE
                    folder:
                      id: clfdr001
                      name: Marketing
                    createdAt: "2026-01-15T09:00:00.000Z"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"

    post:
      operationId: createQrCode
      summary: Create a QR code
      description: |
        Creates a new QR code or shortlink. The required body fields depend on the `qrType`.

        **Required plan: Pro or Enterprise**

        | Type | Required fields | Notes |
        |---|---|---|
        | `URL` | `redirectUrl` | Dynamic redirect QR code |
        | `SHORTLINK` | `redirectUrl` | Short redirect URL only — no QR image generated |
        | `VCARD` | `vcardName` | |
        | `WIFI` | `wifiSsid` | |
        | `SMS` | `smsPhone` | |
        | `EMAIL` | `emailTo` | |
        | `PHONE` | `phone` | |

        `SHORTLINK` codes share the same redirect infrastructure as `URL` codes but have their own
        per-tier count limits and no QR image. Styling fields are ignored for shortlinks.
      tags: [QR Codes]
      x-required-plan: Pro
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/CreateQrCodeBody"
            examples:
              url:
                summary: URL QR code
                value:
                  qrType: URL
                  redirectUrl: "https://example.com/campaign"
                  title: Summer Sale
                  utmSource: instagram
                  utmMedium: social
                  utmCampaign: summer_2026
                  fgColor: "#1a1a1a"
                  bgColor: "#ffffff"
                  dotStyle: rounded
                  maxScans: 5000
                  expiresAt: "2026-09-01T00:00:00.000Z"
                  folder: Marketing
              vcard:
                summary: vCard QR code
                value:
                  qrType: VCARD
                  vcardName: Jane Smith
                  vcardOrg: Acme Corp
                  vcardPhone: "+14155550100"
                  vcardEmail: jane@acme.com
                  vcardUrl: "https://acme.com"
              wifi:
                summary: WiFi QR code
                value:
                  qrType: WIFI
                  wifiSsid: GuestNetwork
                  wifiPassword: hunter2
                  wifiSecurity: WPA
      responses:
        "201":
          description: Created
          content:
            application/json:
              schema:
                type: object
                required: [qr]
                properties:
                  qr:
                    $ref: "#/components/schemas/QrCode"
        "400":
          $ref: "#/components/responses/BadRequest"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "422":
          $ref: "#/components/responses/UnprocessableEntity"
        "429":
          $ref: "#/components/responses/PlanLimitReached"

  /qr/{slug}:
    parameters:
      - name: slug
        in: path
        required: true
        description: The 8-character slug that identifies the QR code.
        schema:
          type: string
          example: abc12345

    get:
      operationId: getQrCode
      summary: Get a QR code
      description: Returns a single QR code by its slug.
      tags: [QR Codes]
      x-required-plan: Starter
      responses:
        "200":
          description: OK
          content:
            application/json:
              schema:
                type: object
                required: [qr]
                properties:
                  qr:
                    $ref: "#/components/schemas/QrCode"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "404":
          $ref: "#/components/responses/NotFound"

    patch:
      operationId: updateQrCode
      summary: Update a QR code
      description: |
        Partially updates a QR code. All fields are optional — only send what you
        want to change. Pass `null` explicitly to clear a nullable field (e.g.
        `"expiresAt": null` removes the expiry date).

        For `URL`-type codes, `redirectUrl` is re-screened for safety before saving.

        **Required plan: Pro or Enterprise**
      tags: [QR Codes]
      x-required-plan: Pro
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/UpdateQrCodeBody"
            example:
              redirectUrl: "https://example.com/new-landing"
              title: Updated Title
              utmCampaign: summer_2026_v2
              maxScans: 10000
              expiresAt: "2026-12-31T23:59:59.000Z"
      responses:
        "200":
          description: OK
          content:
            application/json:
              schema:
                type: object
                required: [qr]
                properties:
                  qr:
                    $ref: "#/components/schemas/QrCode"
        "400":
          $ref: "#/components/responses/BadRequest"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "404":
          $ref: "#/components/responses/NotFound"
        "422":
          $ref: "#/components/responses/UnprocessableEntity"

    delete:
      operationId: deleteQrCode
      summary: Delete a QR code
      description: |
        Soft-deletes a QR code. The short URL immediately stops redirecting.
        Deleted codes are retained for 30 days then permanently purged.

        **Required plan: Pro or Enterprise**
      tags: [QR Codes]
      x-required-plan: Pro
      responses:
        "204":
          description: Deleted successfully — no response body.
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "404":
          $ref: "#/components/responses/NotFound"

  # ── Analytics ─────────────────────────────────────────────────────────────

  /qr/{slug}/analytics:
    parameters:
      - name: slug
        in: path
        required: true
        schema:
          type: string
          example: abc12345
      - name: range
        in: query
        description: Rolling window in days. Accepted values are `7`, `30`, or `90`. Ignored when `from`/`to` or `period` is provided. Defaults to `30`.
        schema:
          type: integer
          enum: [7, 30, 90]
          default: 30
      - name: period
        in: query
        description: Named rolling window alias. Overrides `range`; ignored when `from`/`to` is provided.
        schema:
          type: string
          enum: [week, month, quarter, year]
      - name: from
        in: query
        description: Custom window start date (YYYY-MM-DD, UTC midnight). Takes priority over `period` and `range`. Capped at 365 days.
        schema:
          type: string
          format: date
          example: "2026-01-01"
      - name: to
        in: query
        description: Custom window end date (YYYY-MM-DD). Defaults to today when `from` is provided without `to`.
        schema:
          type: string
          format: date
          example: "2026-01-31"
      - name: tz
        in: query
        description: IANA timezone for day/hour boundary bucketing. Defaults to `UTC`.
        schema:
          type: string
          example: America/New_York
      - name: granularity
        in: query
        description: Time bucket size. `hour` is only accepted for windows of 7 days or less and returns `hourlySeries` instead of `dailyScans`.
        schema:
          type: string
          enum: [day, hour]
          default: day

    get:
      operationId: getQrAnalytics
      summary: Get QR code analytics
      description: |
        Returns scan analytics for a single QR code.

        - **Starter+**: total scan counts, unique scan count, and a time series (`dailyScans` or `hourlySeries`).
        - **Pro / Enterprise**: additionally returns top-5 breakdowns by country, city, region, device, browser, OS, referrer, and language.

        `URL` and `SHORTLINK` codes return full analytics. Other types return `totalScans` only (static codes don't route through the server).

        **`uniqueScans`** counts distinct scanner fingerprints (coarse IP prefix + user-agent) per calendar day.
        Accurate from 2026-05-30 onwards; historical rows before this date are counted as unique by default.
      tags: [Analytics]
      x-required-plan: Starter
      responses:
        "200":
          description: OK
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/QrAnalyticsResponse"
              examples:
                starter_daily:
                  summary: Starter — daily granularity
                  value:
                    slug: abc12345
                    range: 30
                    totalScans: 1842
                    periodScans: 374
                    uniqueScans: 298
                    last7Days: 92
                    last30Days: 374
                    dailyScans:
                      - date: "2026-04-26"
                        scans: 12
                      - date: "2026-04-27"
                        scans: 8
                named_period:
                  summary: Named period (period=month)
                  value:
                    slug: abc12345
                    period: month
                    totalScans: 1842
                    periodScans: 374
                    uniqueScans: 298
                    dailyScans:
                      - date: "2026-05-01"
                        scans: 9
                hourly:
                  summary: Hourly granularity (granularity=hour, range=7)
                  value:
                    slug: abc12345
                    range: 7
                    totalScans: 1842
                    periodScans: 374
                    uniqueScans: 298
                    hourlySeries:
                      - hour: "2026-05-24T00:00"
                        scans: 2
                      - hour: "2026-05-24T01:00"
                        scans: 0
                pro:
                  summary: Pro response (includes breakdowns)
                  value:
                    slug: abc12345
                    range: 30
                    totalScans: 1842
                    periodScans: 374
                    uniqueScans: 298
                    last7Days: 92
                    last30Days: 374
                    dailyScans:
                      - date: "2026-04-26"
                        scans: 12
                    topCountries:
                      - name: United States
                        scans: 210
                    topCities:
                      - name: New York
                        scans: 48
                    topRegions:
                      - name: New York
                        scans: 95
                    topDevices:
                      - name: Mobile
                        scans: 295
                    topBrowsers:
                      - name: Chrome
                        scans: 198
                    topOs:
                      - name: Android
                        scans: 180
                    topReferrers:
                      - name: instagram.com
                        scans: 42
                    topLanguages:
                      - name: en-US
                        scans: 201
        "400":
          $ref: "#/components/responses/BadRequest"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "404":
          $ref: "#/components/responses/NotFound"

  /analytics:
    get:
      operationId: getAccountAnalytics
      summary: Get account-wide analytics
      description: |
        Returns an aggregated analytics summary across all URL-type QR codes in the account.

        - **Starter+**: total scans, unique scan count, time series, and top 10 QR codes by period scans.
        - **Pro / Enterprise**: additionally returns top-5 breakdowns by country, city, region, device, language, and referrer.

        **`uniqueScans`** counts distinct scanner fingerprints across all QR codes in the account for the period.
        Accurate from 2026-05-30 onwards; historical rows before this date are counted as unique by default.
      tags: [Analytics]
      x-required-plan: Starter
      parameters:
        - name: range
          in: query
          description: Rolling window in days. Accepted values are `7`, `30`, or `90`. Ignored when `from`/`to` or `period` is provided. Defaults to `30`.
          schema:
            type: integer
            enum: [7, 30, 90]
            default: 30
        - name: period
          in: query
          description: Named rolling window alias. Overrides `range`; ignored when `from`/`to` is provided.
          schema:
            type: string
            enum: [week, month, quarter, year]
        - name: from
          in: query
          description: Custom window start date (YYYY-MM-DD, UTC midnight). Capped at 365 days.
          schema:
            type: string
            format: date
            example: "2026-01-01"
        - name: to
          in: query
          description: Custom window end date (YYYY-MM-DD). Defaults to today when `from` is provided without `to`.
          schema:
            type: string
            format: date
            example: "2026-01-31"
        - name: tz
          in: query
          description: IANA timezone for day/hour boundary bucketing. Defaults to `UTC`.
          schema:
            type: string
            example: America/New_York
        - name: granularity
          in: query
          description: Time bucket size. `hour` is only accepted for windows of 7 days or less and returns `hourlySeries` instead of `dailyScans`.
          schema:
            type: string
            enum: [day, hour]
            default: day
      responses:
        "200":
          description: OK
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/AccountAnalyticsResponse"
              examples:
                starter:
                  summary: Starter — daily granularity
                  value:
                    range: 30
                    totalScans: 12483
                    periodScans: 2841
                    uniqueScans: 2190
                    qrCodeCount: 17
                    topQrCodes:
                      - slug: abc12345
                        title: Summer Campaign
                        periodScans: 820
                        totalScans: 4200
                    dailyScans:
                      - date: "2026-04-26"
                        scans: 98
                named_period:
                  summary: Named period (period=quarter)
                  value:
                    period: quarter
                    totalScans: 12483
                    periodScans: 8210
                    uniqueScans: 6300
                    qrCodeCount: 17
                    topQrCodes:
                      - slug: abc12345
                        title: Summer Campaign
                        periodScans: 2800
                        totalScans: 4200
                    dailyScans:
                      - date: "2026-02-28"
                        scans: 91
                pro:
                  summary: Pro response (includes breakdowns)
                  value:
                    range: 30
                    totalScans: 12483
                    periodScans: 2841
                    uniqueScans: 2190
                    qrCodeCount: 17
                    topQrCodes:
                      - slug: abc12345
                        title: Summer Campaign
                        periodScans: 820
                        totalScans: 4200
                    dailyScans:
                      - date: "2026-04-26"
                        scans: 98
                    topCountries:
                      - name: United States
                        scans: 1820
                    topCities:
                      - name: New York
                        scans: 410
                    topRegions:
                      - name: California
                        scans: 680
                    topDevices:
                      - name: Mobile
                        scans: 2100
                    topLanguages:
                      - name: en-US
                        scans: 1900
                    topReferrers:
                      - name: instagram.com
                        scans: 320
        "400":
          $ref: "#/components/responses/BadRequest"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"

  # ── Notifications ─────────────────────────────────────────────────────────

  /qr/{slug}/notifications:
    parameters:
      - name: slug
        in: path
        required: true
        schema:
          type: string
          example: abc12345

    patch:
      operationId: updateQrNotifications
      summary: Update notification settings
      description: |
        Configures per-QR email alert thresholds. All fields are optional — omit
        a field to leave it unchanged, or pass `null` to clear it.

        Email alerts must also be enabled in your account settings for these to fire.

        **Constraints:**
        - `notifyOnScansLeft` requires the QR code to have `maxScans` set.
        - `notifyOnExpiryDays` requires the QR code to have `expiresAt` set.

        **Required plan: Starter or above**
      tags: [Notifications]
      x-required-plan: Starter
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/UpdateNotificationsBody"
            examples:
              set:
                summary: Set thresholds
                value:
                  notifyOnScanCount: 100
                  notifyOnScansLeft: 50
                  notifyOnExpiryDays: 7
                  notifyOnInactiveDays: 14
              clear:
                summary: Clear a threshold
                value:
                  notifyOnInactiveDays: null
      responses:
        "200":
          description: OK
          content:
            application/json:
              schema:
                type: object
                required: [notifications]
                properties:
                  notifications:
                    $ref: "#/components/schemas/NotificationSettings"
              example:
                notifications:
                  slug: abc12345
                  notifyOnScanCount: 100
                  notifyOnScansLeft: 50
                  notifyOnExpiryDays: 7
                  notifyOnInactiveDays: null
        "400":
          $ref: "#/components/responses/BadRequest"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "404":
          $ref: "#/components/responses/NotFound"
        "422":
          $ref: "#/components/responses/UnprocessableEntity"

  # ── Folders ───────────────────────────────────────────────────────────────

  /folders:
    get:
      operationId: listFolders
      summary: List folders
      description: Returns all folders in the account, ordered by parent then name. Includes the count of active QR codes in each folder.
      tags: [Folders]
      x-required-plan: Starter
      responses:
        "200":
          description: OK
          content:
            application/json:
              schema:
                type: object
                required: [folders]
                properties:
                  folders:
                    type: array
                    items:
                      $ref: "#/components/schemas/Folder"
              example:
                folders:
                  - id: clfdr001
                    name: Marketing
                    parentId: null
                    qrCodeCount: 12
                    createdAt: "2026-01-10T08:00:00.000Z"
                  - id: clfdr002
                    name: Q1 Campaigns
                    parentId: clfdr001
                    qrCodeCount: 4
                    createdAt: "2026-01-12T10:30:00.000Z"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"

    post:
      operationId: createFolder
      summary: Create a folder
      description: |
        Creates a new folder. Folders support one level of nesting — you can
        create a subfolder inside a top-level folder, but not inside a subfolder.

        **Required plan: Starter or above**
      tags: [Folders]
      x-required-plan: Starter
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/CreateFolderBody"
            examples:
              top_level:
                summary: Top-level folder
                value:
                  name: Marketing
              nested:
                summary: Subfolder
                value:
                  name: Q2 Campaigns
                  parentId: clfdr001
      responses:
        "201":
          description: Created
          content:
            application/json:
              schema:
                type: object
                required: [folder]
                properties:
                  folder:
                    $ref: "#/components/schemas/Folder"
        "400":
          $ref: "#/components/responses/BadRequest"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "404":
          $ref: "#/components/responses/NotFound"
        "409":
          $ref: "#/components/responses/Conflict"

  /folders/{id}:
    parameters:
      - name: id
        in: path
        required: true
        description: The folder ID.
        schema:
          type: string
          example: clfdr001

    patch:
      operationId: updateFolder
      summary: Rename a folder
      description: |
        Renames a folder. The name must be unique within its parent level.

        **Required plan: Starter or above**
      tags: [Folders]
      x-required-plan: Starter
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [name]
              properties:
                name:
                  type: string
                  minLength: 1
                  example: Q2 Campaigns
      responses:
        "200":
          description: OK
          content:
            application/json:
              schema:
                type: object
                required: [folder]
                properties:
                  folder:
                    $ref: "#/components/schemas/Folder"
        "400":
          $ref: "#/components/responses/BadRequest"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "404":
          $ref: "#/components/responses/NotFound"
        "409":
          $ref: "#/components/responses/Conflict"

    delete:
      operationId: deleteFolder
      summary: Delete a folder
      description: |
        Deletes a folder. QR codes in the folder are unlinked (not deleted) and
        move to the root level. Subfolders are also unlinked rather than deleted.

        **Required plan: Starter or above**
      tags: [Folders]
      x-required-plan: Starter
      responses:
        "204":
          description: Deleted successfully — no response body.
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "404":
          $ref: "#/components/responses/NotFound"

# ─── Components ───────────────────────────────────────────────────────────────

components:

  securitySchemes:
    ApiKeyAuth:
      type: http
      scheme: bearer
      description: API key from Settings → API Keys. Keys are prefixed with `qrm_`.

  # ── Schemas ──────────────────────────────────────────────────────────────

  schemas:

    QrCode:
      type: object
      required: [id, slug, qrType, scanCount, shortUrl, fgColor, bgColor, dotStyle, cornerStyle, createdAt]
      properties:
        id:
          type: string
          description: Unique internal ID (cuid).
          example: clxyz123
        slug:
          type: string
          description: 8-character short code used in the redirect URL.
          example: abc12345
        qrType:
          $ref: "#/components/schemas/QrType"
        redirectUrl:
          type: string
          nullable: true
          description: Destination URL for URL-type QR codes. Null for static types.
          example: "https://example.com"
        qrContent:
          type: string
          nullable: true
          description: Encoded data for static QR types (vCard, WiFi, SMS, etc.). Null for URL type.
        title:
          type: string
          nullable: true
          example: Summer Campaign
        scanCount:
          type: integer
          description: Total all-time scan count (bots excluded).
          example: 482
        shortUrl:
          type: string
          description: The full scannable short URL.
          example: "https://qr-m.app/abc12345"
        fgColor:
          type: string
          description: Foreground colour as a 6-digit hex string.
          example: "#000000"
        bgColor:
          type: string
          description: Background colour as a 6-digit hex string.
          example: "#ffffff"
        dotStyle:
          $ref: "#/components/schemas/DotStyle"
        cornerStyle:
          $ref: "#/components/schemas/CornerStyle"
        cornerDotType:
          $ref: "#/components/schemas/CornerDotType"
        eyeOuterColor:
          type: string
          nullable: true
          description: Hex colour override for the eye outer squares. Null inherits `fgColor`.
          example: "#1a1a1a"
        eyeInnerColor:
          type: string
          nullable: true
          description: Hex colour override for the eye inner dots. Null inherits `fgColor`.
          example: "#1a1a1a"
        gradientType:
          $ref: "#/components/schemas/GradientType"
          nullable: true
        gradientEndColor:
          type: string
          nullable: true
          description: Second colour for the gradient. Required when `gradientType` is set.
          example: "#ff6600"
        errorCorrectionLevel:
          $ref: "#/components/schemas/ErrorCorrectionLevel"
        logoSize:
          type: number
          nullable: true
          minimum: 0.1
          maximum: 0.4
          description: Logo size as a fraction of the QR code width (0.1–0.4).
          example: 0.3
        logoMargin:
          type: integer
          nullable: true
          minimum: 0
          maximum: 20
          description: Padding (px) between the logo and surrounding dots.
          example: 4
        frameStyle:
          type: integer
          nullable: true
          minimum: 1
          maximum: 16
          description: Frame template (1–16). Null means no frame.
          example: 1
        frameColor:
          type: string
          nullable: true
          description: Hex colour for the frame. Only applies when `frameStyle` is set.
          example: "#000000"
        frameText:
          type: string
          nullable: true
          description: Label text shown in the frame (max 50 chars). Only applies when `frameStyle` is set.
          example: Scan me
        qrShape:
          $ref: "#/components/schemas/QrShape"
        roundSize:
          type: boolean
          description: Smooth dot edges by flooring sizes to integers (true = smoother, required for circle shape).
          default: false
        hideBackgroundDots:
          type: boolean
          description: Hide QR dots behind the logo image area.
          default: true
        bgRound:
          type: number
          nullable: true
          minimum: 0
          maximum: 1
          description: Background corner rounding (0 = square, 1 = fully rounded).
          example: 0.5
        outerMargin:
          type: integer
          nullable: true
          minimum: 0
          maximum: 40
          description: Extra whitespace (px) around the outside of the QR code.
          example: 10
        expiresAt:
          type: string
          format: date-time
          nullable: true
          description: When set, the QR code stops redirecting after this datetime.
        maxScans:
          type: integer
          nullable: true
          description: When set, the QR code stops redirecting after this many total scans.
          example: 5000
        utmSource:
          type: string
          nullable: true
          example: instagram
        utmMedium:
          type: string
          nullable: true
          example: social
        utmCampaign:
          type: string
          nullable: true
          example: spring_launch
        safetyStatus:
          type: string
          nullable: true
          enum: [SAFE, UNSAFE]
          description: "`null` means the URL has not yet been screened."
        folder:
          nullable: true
          description: The folder this QR code belongs to, or null if unfoldered.
          oneOf:
            - type: "null"
            - type: object
              required: [id, name]
              properties:
                id:
                  type: string
                name:
                  type: string
        createdAt:
          type: string
          format: date-time
          example: "2026-01-15T09:00:00.000Z"

    CreateQrCodeBody:
      type: object
      properties:
        qrType:
          $ref: "#/components/schemas/QrType"
          default: URL
        title:
          type: string
          description: Human-readable label shown in the dashboard.
          example: Summer Campaign
        fgColor:
          type: string
          description: Foreground colour (6-digit hex). Defaults to `#000000`.
          pattern: "^#[0-9a-fA-F]{6}$"
          example: "#1a1a1a"
        bgColor:
          type: string
          description: Background colour (6-digit hex). Defaults to `#ffffff`.
          pattern: "^#[0-9a-fA-F]{6}$"
          example: "#ffffff"
        dotStyle:
          $ref: "#/components/schemas/DotStyle"
        cornerStyle:
          $ref: "#/components/schemas/CornerStyle"
        cornerDotType:
          $ref: "#/components/schemas/CornerDotType"
        eyeOuterColor:
          type: string
          nullable: true
          description: Hex colour override for the eye outer squares.
          pattern: "^#[0-9a-fA-F]{6}$"
          example: "#1a1a1a"
        eyeInnerColor:
          type: string
          nullable: true
          description: Hex colour override for the eye inner dots.
          pattern: "^#[0-9a-fA-F]{6}$"
          example: "#1a1a1a"
        gradientType:
          $ref: "#/components/schemas/GradientType"
          nullable: true
          description: Gradient direction. Requires `gradientEndColor`.
        gradientEndColor:
          type: string
          nullable: true
          description: Second colour for the dot gradient (6-digit hex). Required when `gradientType` is set.
          pattern: "^#[0-9a-fA-F]{6}$"
          example: "#ff6600"
        errorCorrectionLevel:
          $ref: "#/components/schemas/ErrorCorrectionLevel"
        logoSize:
          type: number
          nullable: true
          minimum: 0.1
          maximum: 0.4
          description: Logo size as a fraction of the QR code width (0.1–0.4). Requires a logo to be set via the dashboard.
          example: 0.3
        logoMargin:
          type: integer
          nullable: true
          minimum: 0
          maximum: 20
          description: Padding (px) between the logo and surrounding dots.
          example: 4
        frameStyle:
          type: integer
          nullable: true
          minimum: 1
          maximum: 16
          description: Frame template number (1–16). Omit for no frame.
          example: 1
        frameColor:
          type: string
          nullable: true
          description: Hex colour for the frame. Only used when `frameStyle` is set.
          pattern: "^#[0-9a-fA-F]{6}$"
          example: "#000000"
        frameText:
          type: string
          nullable: true
          description: Label text in the frame (max 50 chars). Only used when `frameStyle` is set.
          example: Scan me
        qrShape:
          $ref: "#/components/schemas/QrShape"
        roundSize:
          type: boolean
          description: Smooth dot edges. Automatically enabled for `circle` shape. Defaults to `false`.
        hideBackgroundDots:
          type: boolean
          description: Hide QR dots behind the logo area. Defaults to `true`.
        bgRound:
          type: number
          nullable: true
          minimum: 0
          maximum: 1
          description: Background corner rounding (0 = square corners, 1 = fully rounded).
          example: 0.5
        outerMargin:
          type: integer
          nullable: true
          minimum: 0
          maximum: 40
          description: Extra whitespace (px) around the outside of the QR code.
          example: 10
        maxScans:
          type: integer
          minimum: 1
          nullable: true
          description: Stop redirecting after this many scans.
        expiresAt:
          type: string
          format: date-time
          nullable: true
          description: Stop redirecting after this datetime (ISO 8601).
        folder:
          type: string
          nullable: true
          description: Folder name to place the QR code in. Must already exist.
          example: Marketing
        redirectUrl:
          type: string
          description: "**URL and SHORTLINK types — required.** The destination to redirect to."
          example: "https://example.com/campaign"
        utmSource:
          type: string
          description: "**URL type only.** Appended as `utm_source` to redirectUrl."
        utmMedium:
          type: string
          description: "**URL type only.** Appended as `utm_medium` to redirectUrl."
        utmCampaign:
          type: string
          description: "**URL type only.** Appended as `utm_campaign` to redirectUrl."
        vcardName:
          type: string
          description: "**VCARD type — required.** Full name."
          example: Jane Smith
        vcardOrg:
          type: string
          description: "**VCARD type.** Organisation."
        vcardPhone:
          type: string
          description: "**VCARD type.** Phone number."
        vcardEmail:
          type: string
          description: "**VCARD type.** Email address."
        vcardUrl:
          type: string
          description: "**VCARD type.** Website URL."
        vcardAddress:
          type: string
          description: "**VCARD type.** Street address."
        wifiSsid:
          type: string
          description: "**WIFI type — required.** Network name (SSID)."
        wifiPassword:
          type: string
          description: "**WIFI type.** Network password."
        wifiSecurity:
          type: string
          enum: [WPA, WEP, nopass]
          default: WPA
          description: "**WIFI type.** Security protocol."
        smsPhone:
          type: string
          description: "**SMS type — required.** Recipient phone number."
        smsMessage:
          type: string
          description: "**SMS type.** Pre-filled message body."
        emailTo:
          type: string
          description: "**EMAIL type — required.** Recipient email address."
        emailSubject:
          type: string
          description: "**EMAIL type.** Pre-filled subject line."
        emailBody:
          type: string
          description: "**EMAIL type.** Pre-filled email body."
        phone:
          type: string
          description: "**PHONE type — required.** Phone number to dial."

    UpdateQrCodeBody:
      type: object
      description: All fields are optional. Pass `null` to clear a nullable field.
      properties:
        title:
          type: string
          nullable: true
          example: Updated Title
        fgColor:
          type: string
          pattern: "^#[0-9a-fA-F]{6}$"
        bgColor:
          type: string
          pattern: "^#[0-9a-fA-F]{6}$"
        dotStyle:
          $ref: "#/components/schemas/DotStyle"
        cornerStyle:
          $ref: "#/components/schemas/CornerStyle"
        cornerDotType:
          $ref: "#/components/schemas/CornerDotType"
        eyeOuterColor:
          type: string
          nullable: true
          pattern: "^#[0-9a-fA-F]{6}$"
          description: Hex colour for the eye outer squares. Pass `null` to clear.
        eyeInnerColor:
          type: string
          nullable: true
          pattern: "^#[0-9a-fA-F]{6}$"
          description: Hex colour for the eye inner dots. Pass `null` to clear.
        gradientType:
          $ref: "#/components/schemas/GradientType"
          nullable: true
          description: Gradient direction. Pass `null` to remove the gradient (also clears `gradientEndColor`).
        gradientEndColor:
          type: string
          nullable: true
          pattern: "^#[0-9a-fA-F]{6}$"
          description: Second gradient colour. Pass `null` to clear.
        errorCorrectionLevel:
          $ref: "#/components/schemas/ErrorCorrectionLevel"
        logoSize:
          type: number
          nullable: true
          minimum: 0.1
          maximum: 0.4
          description: Logo size fraction (0.1–0.4). Pass `null` to reset to default.
        logoMargin:
          type: integer
          nullable: true
          minimum: 0
          maximum: 20
          description: Logo padding (px). Pass `null` to reset to default.
        frameStyle:
          type: integer
          nullable: true
          minimum: 1
          maximum: 16
          description: Frame template (1–16). Pass `null` to remove the frame (also clears `frameColor` and `frameText`).
        frameColor:
          type: string
          nullable: true
          pattern: "^#[0-9a-fA-F]{6}$"
          description: Frame colour. Pass `null` to clear.
        frameText:
          type: string
          nullable: true
          description: Frame label text (max 50 chars). Pass `null` to clear.
        qrShape:
          $ref: "#/components/schemas/QrShape"
        roundSize:
          type: boolean
          description: Smooth dot edges.
        hideBackgroundDots:
          type: boolean
          description: Hide QR dots behind the logo area.
        bgRound:
          type: number
          nullable: true
          minimum: 0
          maximum: 1
          description: Background corner rounding (0–1). Pass `null` to reset to default.
        outerMargin:
          type: integer
          nullable: true
          minimum: 0
          maximum: 40
          description: Outer whitespace (px). Pass `null` to reset to default.
        maxScans:
          type: integer
          minimum: 1
          nullable: true
        expiresAt:
          type: string
          format: date-time
          nullable: true
        folder:
          type: string
          nullable: true
          description: Folder name. Pass `null` to move the QR code out of any folder.
        redirectUrl:
          type: string
          description: "**URL and SHORTLINK types.** New redirect destination."
        utmSource:
          type: string
          nullable: true
        utmMedium:
          type: string
          nullable: true
        utmCampaign:
          type: string
          nullable: true
        vcardName:
          type: string
        vcardOrg:
          type: string
        vcardPhone:
          type: string
        vcardEmail:
          type: string
        vcardUrl:
          type: string
        vcardAddress:
          type: string
        wifiSsid:
          type: string
        wifiPassword:
          type: string
        wifiSecurity:
          type: string
          enum: [WPA, WEP, nopass]
        smsPhone:
          type: string
        smsMessage:
          type: string
        emailTo:
          type: string
        emailSubject:
          type: string
        emailBody:
          type: string
        phone:
          type: string

    UpdateNotificationsBody:
      type: object
      description: All fields are optional integers ≥ 1, or `null` to clear. Omit a field to leave it unchanged.
      properties:
        notifyOnScanCount:
          type: integer
          minimum: 1
          nullable: true
          description: Fire an alert at every multiple of N total scans.
          example: 100
        notifyOnScansLeft:
          type: integer
          minimum: 1
          nullable: true
          description: |
            Fire an alert when N scans remain before `maxScans` is reached.
            Requires the QR code to have `maxScans` set.
          example: 50
        notifyOnExpiryDays:
          type: integer
          minimum: 1
          nullable: true
          description: |
            Fire an alert N days before `expiresAt`.
            Requires the QR code to have `expiresAt` set.
          example: 7
        notifyOnInactiveDays:
          type: integer
          minimum: 1
          nullable: true
          description: Fire an alert after N consecutive days with no scans.
          example: 14

    NotificationSettings:
      type: object
      required: [slug]
      properties:
        slug:
          type: string
          example: abc12345
        notifyOnScanCount:
          type: integer
          nullable: true
          example: 100
        notifyOnScansLeft:
          type: integer
          nullable: true
          example: 50
        notifyOnExpiryDays:
          type: integer
          nullable: true
          example: 7
        notifyOnInactiveDays:
          type: integer
          nullable: true
          example: 14

    QrAnalyticsResponse:
      type: object
      required: [slug, totalScans]
      properties:
        slug:
          type: string
          example: abc12345
        range:
          type: integer
          description: Present when the `range` param was used. The rolling window in days.
          example: 30
        period:
          type: string
          enum: [week, month, quarter, year]
          description: Present when the `period` param was used.
          example: month
        from:
          type: string
          format: date
          description: Present when a custom `from`/`to` window was requested.
          example: "2026-01-01"
        to:
          type: string
          format: date
          description: Present when a custom `from`/`to` window was requested.
          example: "2026-01-31"
        tz:
          type: string
          description: Present when a non-UTC timezone was requested.
          example: America/New_York
        totalScans:
          type: integer
          description: All-time scan count (bot scans excluded).
          example: 1842
        periodScans:
          type: integer
          description: Total scan count within the requested window (includes repeat scans).
          example: 374
        uniqueScans:
          type: integer
          description: |
            Deduplicated scan count within the window. Counts distinct scanner fingerprints
            (coarse IP prefix + user-agent) per calendar day. Accurate from 2026-05-30 onwards.
          example: 298
        last7Days:
          type: integer
          description: Present when `range=30` or `range=90`.
          example: 92
        last30Days:
          type: integer
          nullable: true
          description: Present when `range=30` or `range=90`.
          example: 374
        last90Days:
          type: integer
          nullable: true
          description: Present when `range=90`.
        dailyScans:
          type: array
          description: One entry per calendar day in the window, oldest first. Present when `granularity=day` (default).
          items:
            $ref: "#/components/schemas/DailyCount"
        hourlySeries:
          type: array
          description: One entry per hour in the window, oldest first. Present when `granularity=hour` (replaces `dailyScans`).
          items:
            $ref: "#/components/schemas/HourlyCount"
        topCountries:
          type: array
          description: "**Pro / Enterprise only.** Top 5 countries by scan count."
          items:
            $ref: "#/components/schemas/BreakdownEntry"
        topCities:
          type: array
          description: "**Pro / Enterprise only.** Top 5 cities."
          items:
            $ref: "#/components/schemas/BreakdownEntry"
        topRegions:
          type: array
          description: "**Pro / Enterprise only.** Top 5 states or provinces."
          items:
            $ref: "#/components/schemas/BreakdownEntry"
        topDevices:
          type: array
          description: "**Pro / Enterprise only.** Top 5 device types (Mobile, Desktop, Tablet)."
          items:
            $ref: "#/components/schemas/BreakdownEntry"
        topBrowsers:
          type: array
          description: "**Pro / Enterprise only.** Top 5 browsers."
          items:
            $ref: "#/components/schemas/BreakdownEntry"
        topOs:
          type: array
          description: "**Pro / Enterprise only.** Top 5 operating systems."
          items:
            $ref: "#/components/schemas/BreakdownEntry"
        topReferrers:
          type: array
          description: "**Pro / Enterprise only.** Top 5 referring domains."
          items:
            $ref: "#/components/schemas/BreakdownEntry"
        topLanguages:
          type: array
          description: "**Pro / Enterprise only.** Top 5 Accept-Language values."
          items:
            $ref: "#/components/schemas/BreakdownEntry"
        note:
          type: string
          description: Present for static QR types (non-URL, non-SHORTLINK) explaining why detailed analytics are unavailable.

    AccountAnalyticsResponse:
      type: object
      required: [totalScans, periodScans, uniqueScans, qrCodeCount, topQrCodes]
      properties:
        range:
          type: integer
          description: Present when the `range` param was used.
          example: 30
        period:
          type: string
          enum: [week, month, quarter, year]
          description: Present when the `period` param was used.
          example: quarter
        from:
          type: string
          format: date
          description: Present when a custom `from`/`to` window was requested.
        to:
          type: string
          format: date
          description: Present when a custom `from`/`to` window was requested.
        tz:
          type: string
          description: Present when a non-UTC timezone was requested.
        totalScans:
          type: integer
          description: All-time total across all QR codes in the account.
          example: 12483
        periodScans:
          type: integer
          description: Total scans in the window across all QR codes (includes repeat scans).
          example: 2841
        uniqueScans:
          type: integer
          description: |
            Deduplicated scan count for the window. Counts distinct scanner fingerprints
            (coarse IP prefix + user-agent) per calendar day. Accurate from 2026-05-30 onwards.
          example: 2190
        qrCodeCount:
          type: integer
          description: Total number of active URL-type QR codes in the account.
          example: 17
        topQrCodes:
          type: array
          description: Top 10 QR codes by period scans.
          items:
            type: object
            required: [slug, periodScans, totalScans]
            properties:
              slug:
                type: string
                example: abc12345
              title:
                type: string
                nullable: true
                example: Summer Campaign
              periodScans:
                type: integer
                example: 820
              totalScans:
                type: integer
                example: 4200
        dailyScans:
          type: array
          description: One entry per calendar day in the window, oldest first. Present when `granularity=day` (default).
          items:
            $ref: "#/components/schemas/DailyCount"
        hourlySeries:
          type: array
          description: One entry per hour in the window, oldest first. Present when `granularity=hour` (replaces `dailyScans`).
          items:
            $ref: "#/components/schemas/HourlyCount"
        topCountries:
          type: array
          description: "**Pro / Enterprise only.** Top 5 countries."
          items:
            $ref: "#/components/schemas/BreakdownEntry"
        topCities:
          type: array
          description: "**Pro / Enterprise only.** Top 5 cities."
          items:
            $ref: "#/components/schemas/BreakdownEntry"
        topRegions:
          type: array
          description: "**Pro / Enterprise only.** Top 5 states or provinces."
          items:
            $ref: "#/components/schemas/BreakdownEntry"
        topDevices:
          type: array
          description: "**Pro / Enterprise only.** Top 5 device types."
          items:
            $ref: "#/components/schemas/BreakdownEntry"
        topLanguages:
          type: array
          description: "**Pro / Enterprise only.** Top 5 Accept-Language values."
          items:
            $ref: "#/components/schemas/BreakdownEntry"
        topReferrers:
          type: array
          description: "**Pro / Enterprise only.** Top 5 referring domains."
          items:
            $ref: "#/components/schemas/BreakdownEntry"

    Folder:
      type: object
      required: [id, name, parentId, qrCodeCount, createdAt]
      properties:
        id:
          type: string
          example: clfdr001
        name:
          type: string
          example: Marketing
        parentId:
          type: string
          nullable: true
          description: ID of the parent folder, or `null` for top-level folders.
          example: null
        qrCodeCount:
          type: integer
          description: Number of active (non-deleted) QR codes directly in this folder.
          example: 12
        createdAt:
          type: string
          format: date-time
          example: "2026-01-10T08:00:00.000Z"

    CreateFolderBody:
      type: object
      required: [name]
      properties:
        name:
          type: string
          minLength: 1
          example: Marketing
        parentId:
          type: string
          nullable: true
          description: ID of a top-level folder to nest this folder inside. Omit for a top-level folder. Folders only support one level of nesting.
          example: clfdr001

    DailyCount:
      type: object
      required: [date, scans]
      properties:
        date:
          type: string
          format: date
          example: "2026-04-26"
        scans:
          type: integer
          example: 42

    HourlyCount:
      type: object
      required: [hour, scans]
      properties:
        hour:
          type: string
          description: Hour bucket in `YYYY-MM-DDTHH:00` format, in the requested timezone.
          example: "2026-04-26T14:00"
        scans:
          type: integer
          example: 7

    BreakdownEntry:
      type: object
      required: [name, scans]
      properties:
        name:
          type: string
          example: United States
        scans:
          type: integer
          example: 210

    QrType:
      type: string
      enum: [URL, SHORTLINK, VCARD, WIFI, SMS, EMAIL, PHONE, APP_STORE, SOCIAL]
      description: |
        - `URL` — Dynamic redirect QR code. Destination can be updated after creation.
        - `SHORTLINK` — Short redirect URL only. No QR image; same redirect infrastructure as URL. Separate per-tier count limit.
        - `VCARD` — Contact card encoded in the QR pattern.
        - `WIFI` — WiFi credentials encoded in the QR pattern.
        - `SMS` — Pre-filled SMS encoded in the QR pattern.
        - `EMAIL` — Pre-filled email encoded in the QR pattern.
        - `PHONE` — Phone number encoded in the QR pattern.
        - `APP_STORE` — Dynamic redirect with separate iOS and Android URLs. Managed via the dashboard only.
        - `SOCIAL` — Dynamic multi-link social profile page. Managed via the dashboard only.

    DotStyle:
      type: string
      enum: [square, dots, rounded, extra-rounded, classy, classy-rounded]
      default: square
      description: Style of the QR code dot modules.

    CornerStyle:
      type: string
      enum: [square, extra-rounded, dot, dots, rounded, classy, classy-rounded]
      default: square
      description: Style of the QR code corner finder (eye outer) squares.

    CornerDotType:
      type: string
      enum: [square, extra-rounded, dot, dots, rounded, classy, classy-rounded]
      default: square
      description: Style of the QR code corner finder inner dots.

    QrShape:
      type: string
      enum: [square, circle]
      default: square
      description: Overall shape of the QR code — `square` (standard) or `circle` (circular).

    GradientType:
      type: string
      enum: [linear, upDown, diagonal1, diagonal2, radial]
      description: Gradient direction applied to the dot modules. Requires `gradientEndColor`.

    ErrorCorrectionLevel:
      type: string
      enum: [L, M, Q, H]
      default: M
      description: |
        Error correction capacity.
        - `L` — ~7% of codewords can be restored
        - `M` — ~15% (default)
        - `Q` — ~25%
        - `H` — ~30% (allows large logos)

    Error:
      type: object
      required: [error]
      properties:
        error:
          type: string
          description: Human-readable error message.
          example: QR code not found.

  # ── Responses ────────────────────────────────────────────────────────────

  responses:
    Unauthorized:
      description: Missing or invalid API key.
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/Error"
          example:
            error: Unauthorized

    Forbidden:
      description: Your plan does not include access to this endpoint.
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/Error"
          example:
            error: API access requires a Starter account or above.

    NotFound:
      description: The requested resource does not exist or belongs to another account.
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/Error"
          example:
            error: QR code not found.

    BadRequest:
      description: The request body is missing required fields or contains invalid values.
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/Error"
          example:
            error: redirectUrl is required for URL type

    UnprocessableEntity:
      description: The request is well-formed but cannot be processed due to a business rule constraint (e.g. a URL failed safety screening).
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/Error"
          example:
            error: notifyOnScansLeft requires the QR code to have a maxScans limit set.

    Conflict:
      description: A resource with the same unique identifier already exists.
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/Error"
          example:
            error: A folder with this name already exists at this level

    PlanLimitReached:
      description: The account has reached its QR code limit for the current plan.
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/Error"
          example:
            error: Account limit of 250 QR codes reached.
