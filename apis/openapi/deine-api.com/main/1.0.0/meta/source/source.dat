{
  "openapi": "3.0.0",
  "info": {
    "title": "Handelssimulator API v1",
    "description": "API for Handelssimulator game data and player management",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/nocompany-922-92b/GeneratedAPI_2025-12-24-1411/1.0.0"
  },
  "servers": [
    {
      "url": "https://deine-api.com/api/v1"
    }
  ],
  "paths": {
    "/epochs": {
      "get": {
        "operationId": "getEpochs",
        "summary": "Hole alle verfügbaren Epochen",
        "responses": {
          "200": {
            "description": "Liste aller Epochen",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Epoch"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/epochs/{epochId}/items": {
      "get": {
        "operationId": "getItemsByEpoch",
        "summary": "Hole alle Items für eine Epoche",
        "parameters": [
          {
            "name": "epochId",
            "in": "path",
            "required": true,
            "description": "z.B. 'antike'",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Liste der Items für die Epoche",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Item"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/epochs/{epochId}/cities": {
      "get": {
        "operationId": "getCitiesByEpoch",
        "summary": "Hole alle Städte für eine Epoche",
        "parameters": [
          {
            "name": "epochId",
            "in": "path",
            "required": true,
            "description": "z.B. 'antike'",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Liste der Städte für die Epoche",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/City"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/epochs/{epochId}/vehicles": {
      "get": {
        "operationId": "getVehiclesByEpoch",
        "summary": "Hole alle Fahrzeuge für eine Epoche",
        "parameters": [
          {
            "name": "epochId",
            "in": "path",
            "required": true,
            "description": "z.B. 'antike'",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Liste der Fahrzeuge für die Epoche",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Vehicle"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/market/{epochId}/{cityId}/prices": {
      "get": {
        "operationId": "getMarketPrices",
        "summary": "Hole aktuelle Marktpreise für eine Stadt",
        "parameters": [
          {
            "name": "epochId",
            "in": "path",
            "required": true,
            "description": "z.B. 'antike'",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cityId",
            "in": "path",
            "required": true,
            "description": "z.B. 'rom'",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Aktuelle Marktpreise (basePrice ±30%)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/players/{userId}/save": {
      "post": {
        "operationId": "savePlayerData",
        "summary": "Speichere Spieler-Daten",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "description": "Roblox User ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlayerSaveData"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bestätigung der Speicherung",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SaveResponse"
                }
              }
            }
          }
        }
      }
    },
    "/players/{userId}/login": {
      "post": {
        "operationId": "logPlayerLogin",
        "summary": "Log Player Login",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "description": "Roblox User ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlayerLoginData"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login Bestätigung",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          }
        }
      }
    },
    "/leaderboard/{epochId}": {
      "get": {
        "operationId": "getLeaderboard",
        "summary": "Hole Rangliste für Epoche (optional)",
        "parameters": [
          {
            "name": "epochId",
            "in": "path",
            "required": true,
            "description": "z.B. 'antike'",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Rangliste der Spieler",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LeaderboardEntry"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Epoch": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Epochen-ID"
          },
          "name": {
            "type": "string",
            "description": "Interner Name der Epoche"
          },
          "displayName": {
            "type": "string",
            "description": "Anzeigename der Epoche"
          },
          "icon": {
            "type": "string",
            "description": "Roblox Asset ID für Icon (rbxassetid://NUMMER)"
          },
          "description": {
            "type": "string",
            "description": "Beschreibung der Epoche"
          },
          "startGold": {
            "type": "integer",
            "description": "Startgold für die Epoche"
          },
          "startVehicle": {
            "type": "string",
            "description": "Startfahrzeug ID"
          },
          "backgroundColor": {
            "type": "string",
            "description": "Hintergrundfarbe (Hex)"
          }
        }
      },
      "Item": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Item-ID"
          },
          "name": {
            "type": "string",
            "description": "Name des Items"
          },
          "description": {
            "type": "string",
            "description": "Beschreibung des Items"
          },
          "icon": {
            "type": "string",
            "description": "Roblox Asset ID für Icon (rbxassetid://NUMMER)"
          },
          "basePrice": {
            "type": "integer",
            "description": "Basispreis des Items"
          },
          "weight": {
            "type": "number",
            "format": "float",
            "description": "Gewicht des Items"
          },
          "rarity": {
            "type": "string",
            "description": "Seltenheit (z.B. Common, Rare, Epic, Legendary)"
          },
          "category": {
            "type": "string",
            "description": "Kategorie des Items"
          },
          "color": {
            "type": "string",
            "description": "Farbe (Hex)"
          }
        }
      },
      "City": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Stadt-ID"
          },
          "name": {
            "type": "string",
            "description": "Name der Stadt"
          },
          "description": {
            "type": "string",
            "description": "Beschreibung der Stadt"
          },
          "icon": {
            "type": "string",
            "description": "Roblox Asset ID für Icon (rbxassetid://NUMMER)"
          },
          "position": {
            "type": "object",
            "properties": {
              "x": {
                "type": "integer"
              },
              "y": {
                "type": "integer"
              },
              "z": {
                "type": "integer"
              }
            },
            "description": "3D Position der Stadt"
          },
          "specialties": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Spezialitäten der Stadt (Item IDs)"
          },
          "population": {
            "type": "string",
            "description": "Bevölkerungsgröße (z.B. Groß, Mittel)"
          },
          "climate": {
            "type": "string",
            "description": "Klima der Stadt"
          },
          "landmark": {
            "type": "string",
            "description": "Wahrzeichen der Stadt"
          }
        }
      },
      "Vehicle": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Fahrzeug-ID"
          },
          "name": {
            "type": "string",
            "description": "Name des Fahrzeugs"
          },
          "description": {
            "type": "string",
            "description": "Beschreibung des Fahrzeugs"
          },
          "icon": {
            "type": "string",
            "description": "Roblox Asset ID für Icon (rbxassetid://NUMMER)"
          },
          "model": {
            "type": "string",
            "description": "Roblox Asset ID für Modell (rbxassetid://NUMMER)"
          },
          "capacity": {
            "type": "integer",
            "description": "Kapazität des Fahrzeugs"
          },
          "speed": {
            "type": "integer",
            "description": "Geschwindigkeit des Fahrzeugs"
          },
          "cost": {
            "type": "integer",
            "description": "Anschaffungskosten"
          },
          "unlockLevel": {
            "type": "integer",
            "description": "Freischaltlevel"
          },
          "fuel": {
            "type": "string",
            "description": "Kraftstoffart"
          },
          "maintenance": {
            "type": "string",
            "description": "Wartungsaufwand"
          },
          "waterOnly": {
            "type": "boolean",
            "description": "Nur Wasserfahrzeug (optional)",
            "nullable": true
          }
        }
      },
      "PlayerSaveData": {
        "type": "object",
        "properties": {
          "serverId": {
            "type": "string",
            "description": "Server ID"
          },
          "epoch": {
            "type": "string",
            "description": "Epoche"
          },
          "data": {
            "type": "object",
            "properties": {
              "Level": {
                "type": "integer"
              },
              "Gold": {
                "type": "integer"
              },
              "Experience": {
                "type": "integer"
              },
              "Inventory": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "ItemId": {
                      "type": "string"
                    },
                    "Quantity": {
                      "type": "integer"
                    }
                  }
                }
              },
              "CurrentVehicle": {
                "type": "string"
              },
              "Vehicles": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "CurrentCity": {
                "type": "string"
              },
              "Buildings": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "Statistics": {
                "type": "object",
                "properties": {
                  "TradesCompleted": {
                    "type": "integer"
                  },
                  "TotalProfit": {
                    "type": "integer"
                  },
                  "DistanceTraveled": {
                    "type": "integer"
                  }
                }
              }
            }
          },
          "timestamp": {
            "type": "integer",
            "description": "Unix Timestamp"
          }
        },
        "required": [
          "serverId",
          "epoch",
          "data",
          "timestamp"
        ]
      },
      "SaveResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "PlayerLoginData": {
        "type": "object",
        "properties": {
          "serverId": {
            "type": "string",
            "description": "Server ID"
          },
          "epoch": {
            "type": "string",
            "description": "Epoche"
          },
          "username": {
            "type": "string"
          },
          "timestamp": {
            "type": "integer",
            "description": "Unix Timestamp"
          }
        },
        "required": [
          "serverId",
          "epoch",
          "username",
          "timestamp"
        ]
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "welcomeMessage": {
            "type": "string"
          }
        }
      },
      "LeaderboardEntry": {
        "type": "object",
        "properties": {
          "rank": {
            "type": "integer"
          },
          "userId": {
            "type": "integer"
          },
          "username": {
            "type": "string"
          },
          "gold": {
            "type": "integer"
          },
          "level": {
            "type": "integer"
          }
        }
      }
    }
  },
  "securitySchemes": {},
  "security": []
}
