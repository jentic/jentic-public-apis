    "/defunti/api/method/post": {
      "post": {
        "tags": [
          "Defunti"
        ],
        "operationId": "postDefunti",
        "description": "Inserimento Defunti",
        "summary": "Inserimento Defunti",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "_ssgv",
            "in": "cookie",
            "required": true,
            "description": "Cookie di Sessione per identificare lo user",
            "schema": {
              "type": "integer",
              "description": "ID univoco associato al token di sessione dell'utente",
              "example": 1
            }
          }
        ],
        "requestBody": {
          "description": "Oggetto defunti da caricare",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nome": {
                    "type": "string",
                    "description": "Nome del defunto",
                    "example": "Mario"
                  },
                  "cognome": {
                    "type": "string",
                    "description": "Cognome del defunto",
                    "example": "Rossi"
                  },
                  "sesso": {
                    "type": "string",
                    "description": "Sesso del defunto",
                    "example": "M"
                  },
                  "notIdentitaria": {
                    "type": "string",
                    "description": "Nota dell'identità di genere del defunto"
                  },
                  "dataNascita": {
                    "type": "string",
                    "description": "Data di nascita del defunto",
                    "example": "2024-10-01"
                  },
                  "dataOraMorte": {
                    "type": "string",
                    "description": "Data e ora di morte del defunto"
                  },
                  "inumazione": {
                    "type": "integer",
                    "description": "ID dell'inumazione",
                    "example": 1
                  },
                  "malattiaInfettiva": {
                    "type": "boolean",
                    "description": "Campo in cui si spiega se il defunto aveva una malattia infettiva o meno",
                    "example": true
                  },
                  "luogoNascita": {
                    "type": "string",
                    "description": "Luogo di nascita del defunto",
                    "example": "Cagliari"
                  },
                  "dataOraSepoltura": {
                    "type": "string",
                    "description": "Data e ora di sepoltura del defunto",
                    "example": "2024-10-01"
                  },
                  "esumazioneAnni": {
                    "type": "integer",
                    "description": "Esumazione in anni del defunto",
                    "example": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Defunto creato con successo",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Defunto creato con successo"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Richiesta non valida, impossibile elaborare JSON o file",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Errore nella lettura della richiesta"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Errore interno del server durante la creazione del defunto",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Errore durante il caricamento del file ..."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
