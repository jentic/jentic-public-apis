                    "type": "integer",
                    "description": "ID dell'utente che ha richiesto assistenza",
                    "example": 1
                  },
                  "oggetto": {
                    "type": "string",
                    "description": "Oggetto della richiesta di assistenza",
                    "example": "Richiesta informazioni aggiornata"
                  },
                  "label": {
                    "type": "string",
                    "description": "Etichetta o categoria aggiornata della richiesta di assistenza",
                    "example": "Tecnico"
                  },
                  "testo": {
                    "type": "string",
                    "description": "Testo aggiornato della richiesta di assistenza",
                    "example": "Ho bisogno di assistenza per un problema tecnico."
                  },
                  "allegati": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Lista aggiornata di allegati relativi alla richiesta di assistenza",
                    "example": [
                      "screenshot_aggiornato.png",
                      "documento_aggiornato.pdf"
                    ]
                  },
                  "file": {
                    "type": "array",
                    "description": "Lista di file allegati aggiornati alla richiesta",
                    "items": {
                      "type": "string",
                      "format": "binary"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Richiesta di assistenza aggiornata con successo",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Richiesta di assistenza aggiornata con successo"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Richiesta non valida, errore nel parsing dei dati",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "ID della richiesta di assistenza non corrispondente"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Richiesta di assistenza non trovata",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Richiesta di assistenza non trovata"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Errore interno del server",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Errore durante l'aggiornamento della richiesta di assistenza"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JW"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "ID dell'user, non necessario nella creazione dell'utente, autogenerato",
            "example": 1
          },
          "is_active": {
            "type": "boolean",
            "example": true
          },
          "email": {
            "type": "string",
            "example": "john.doe@example.com"
          },
          "logged": {
            "type": "boolean",
            "example": false
          },
          "comuni": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "Roma",
              "Milano"
            ]
          },
          "permission": {
            "type": "string",
            "enum": [
              "SUPERADMIN",
              "ADMIN",
              "SUPERUTENTE",
              "RESPONSABILE",
              "UTENTE"
            ],
            "example": "ADMIN"
          },
          "nome": {
            "type": "string",
            "example": "John"
          },
          "cognome": {
            "type": "string",
            "example": "Doe"
          },
          "foto": {
            "type": "string",
            "example": "https://example.com/john.jpg"
          },
          "impostazioni_notifiche": {
            "type": "string",
            "example": "true-6;false-0;false-0"
          },
          "tokens": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "token": {
                  "type": "string",
                  "example": "random-token-1234"
                }
              }
            }
          }
        }
      },
      "Cimiteri": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "ID del cimitero, non necessario nella creazione del cimitero, autogenerato",
            "example": 1
          },
          "latitudine": {
            "type": "number",
            "format": "float",
            "example": 41.9028
          },
          "longitudine": {
            "type": "number",
            "format": "float",
            "example": 12.4964
          },
          "regione": {
            "type": "string",
            "example": "Lazio"
          },
          "provincia": {
            "type": "string",
            "example": "Roma"
          },
          "comune": {
            "type": "string",
            "example": "Roma"
          },
          "posti_totali": {
            "type": "integer",
            "example": 1000
          },
          "inumazioni_presenti": {
            "type": "integer",
            "example": 300
          },
          "rotazione_esumazioni": {
            "type": "boolean",
            "example": true
          },
          "planimetria": {
            "type": "array",
            "items": {
              "type": "string",
              "example": "/media/cimiteri/planimetrie/cimitero_roma_1/planimetria1.pdf"
            }
          }
        }
      },
      "Settori": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "ID del settore, autogenerato",
            "example": 1
          },
          "cimitero_id": {
            "type": "integer",
            "description": "ID del cimitero, autogenerato",
            "example": 1
          },
          "nome": {
            "type": "string",
            "description": "nome del settore",
            "example": "Settore 1"
          },
          "matrix": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "La matrice di [**Righe, **Colonne] che contiene le celle del settore. Ciascuna colonna contiene una stringa \"tipo|n.cippo|...etc.",
            "example": [
              [
                "Loculo|",
                "Loculo|",
                "Loculo|"
              ],
              [
                "Loculo|4",
                "Loculo|5",
                "Loculo|"
              ]
            ]
          },
          "righe": {
            "type": "integer",
            "description": "Righe della matrice",
            "example": 1
          },
          "colonne": {
            "type": "integer",
            "description": "Colonne della matrice",
            "example": 1
          },
          "sepolture_settore": {
            "type": "integer",
            "description": "Numero settore della sepoltura",
            "example": 1
          },
          "snapshot": {
            "type": "string",
            "description": "Percorso dell'immagine che viene catturato dal canvas che presenta il settore",
            "example": "media/settori/snapshots/nomesnapshot_01.png"
          },
          "punti_canvas": {
            "type": "string",
            "description": "Identificano la forma 2D disegnata dall'utente nel momento del censimento cimiteriale. Rappresenta quindi una lista di punti all'interno di una stringa.",
            "example": "[x1,y1],[x2,y2],[x3,y3]"
          },
          "color": {
            "type": "string",
            "description": "Colore del settore in hex",
            "example": "#000000"
          },
          "refPlanimetria": {
            "type": "integer",
            "description": "Numero che serve per distinguere i settori all'interno di un cimitero con più planimetrie",
            "example": 1
          }
        }
      },
      "Sepoltura": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "ID del settore, autogenerato",
            "example": 1
          },
          "settore_id": {
            "type": "integer",
            "description": "ID del settore, autogenerato",
            "example": 1
          },
          "coordinata_x": {
            "type": "integer",
            "description": "Coordinata asse X",
            "example": 1
          },
          "coordinata_y": {
            "type": "integer",
            "description": "Coordinata asse Y",
            "example": 1
          },
          "numero_cippo": {
            "type": "integer",
            "description": "Numero di cippo della tomba",
            "example": 1
          },
          "parcel_number": {
            "type": "integer",
            "description": "E' il numero d'ordine della bolletta di seppellimento",
            "example": 1
          },
          "stato_inumazione": {
            "type": "array",
            "values": [
              "In assestamento",
              "Da riassegnare",
              "Necessita manutenzione"
            ],
            "items": {
              "type": "string"
            },
            "example": [
              "In assestamento",
              "Da riassegnare",
              "Necessita manutenzione"
            ]
          },
          "occupato": {
            "type": "boolean",
            "description": "Occupazione della tomba/loculo",
            "example": true
          },
          "tipologia": {
            "type": "array",
            "values": [
              "Non ancora assegnato",
              "Ossario",
              "Inumazione",
              "Tumulo/Loculo"
            ],
            "items": {
              "type": "string"
            },
            "example": [
              "Non ancora assegnato",
              "Ossario",
              "Inumazione",
              "Tumulo/Loculo"
            ]
          },
          "foto": {
            "type": "string",
            "example": "/media/sepoltura/seplturaX.png"
          }
        }
      },
      "Defunti": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "ID del settore, autogenerato",
            "example": 1
          },
          "inumazione_id": {
            "type": "integer",
            "description": "ID dell'inumazione",
            "example": 1
          },
          "nome": {
            "type": "string",
            "description": "Nome del defunto",
            "example": "Orazio"
          },
          "cognome": {
            "type": "string",
            "description": "Cognome del defunto",
            "example": "Rossi"
          },
          "sesso": {
            "type": "string",
            "description": "Sesso del defunto",
            "example": "M"
          },
          "nota_identitaria": {
            "type": "string",
            "description": "Nota dell'identità di genere del defunto",
            "example": ""
          },
          "data_nascita": {
            "type": "string",
            "description": "Data di nascita del defunto",
            "example": "2024-10-01"
          },
          "data_ora_morte": {
            "type": "string",
            "description": "Data e ora della morte del defunto",
            "example": "2024-10-01T14:30:00.000Z"
          },
          "luogo_nascita": {
            "type": "string",
            "description": "Luogo di nascita del defunto",
            "example": "Padova"
          },
          "malattia_infettiva": {
            "type": "boolean",
            "description": "Indica se il defunto aveva una malattia infettiva",
            "example": false
          },
          "data_ora_sepoltura": {
            "type": "string",
            "description": "Data e ora della sepoltura",
            "example": "2024-10-05T10:00:00Z"
          },
          "esumazione_anni": {
            "type": "integer",
            "description": "Numero di anni prima dell'esumazione",
            "example": 10
          }
        }
      },
      "Contratti": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "ID del contratto, autogenerato",
            "example": 1
          },
          "defunto_id": {
            "type": "integer",
            "description": "ID del defunto associato al contratto",
            "example": 1
          },
          "inizio_contratto": {
            "type": "string",
            "description": "Data di inizio del contratto",
            "example": "2024-01-01"
          },
          "fine_contratto": {
            "type": "string",
            "description": "Data di fine del contratto",
            "example": "2029-01-01"
          },
          "file": {
            "type": "string",
            "description": "File allegato al contratto",
            "example": "contratto.pdf"
          },
          "stato_contratto": {
            "type": "string",
            "description": "Stato attuale del contratto",
            "values": [
              "Regolare",
              "In scadenza",
              "Scaduto"
            ],
            "example": "Regolare"
          },
          "tipo_contratto": {
            "type": "string",
            "description": "Tipologia di contratto",
            "values": [
              "Type1",
              "Type2",
              "Type3",
              "Type4",
              "Esumazione"
            ],
            "example": "Type1"
          }
        }
      },
      "AventiDiritto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "ID degli aventi diritto, autogenerato",
            "example": 1
          },
          "defunto_id": {
            "type": "integer",
            "description": "ID del defunto associato",
            "example": 1
          },
          "nome": {
            "type": "string",
            "description": "Nome dell'avente diritto",
            "example": "Giovanni"
          },
          "cognome": {
            "type": "string",
            "description": "Cognome dell'avente diritto",
            "example": "Bianchi"
          },
          "codice_fiscale": {
            "type": "string",
            "description": "Codice fiscale dell'avente diritto",
            "example": "BNCGNN80A01H501Z"
          },
          "email": {
            "type": "string",
            "description": "Indirizzo email dell'avente diritto",
            "example": "giovanni.bianchi@example.com"
          },
          "telefono": {
            "type": "string",
            "description": "Numero di telefono dell'avente diritto",
            "example": "+393331234567"
          }
        }
      },
      "Assistenza": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "ID degli aventi diritto, autogenerato",
            "example": 1
          }
        },
        "utente_id": {
          "type": "integer",
          "description": "ID dell'utente che ha richiesto assistenza",
          "example": 1
        },
        "oggetto": {
          "type": "string",
          "description": "Oggetto della richiesta di assistenza",
          "example": "Richiesta informazioni"
        },
        "label": {
          "type": "string",
          "description": "Etichetta o categoria della richiesta",
          "values": [
            "Tecnico",
            "Amministrativo",
            "Funzionale"
          ],
          "example": "Tecnico"
        },
        "testo": {
          "type": "string",
          "description": "Testo della richiesta di assistenza",
          "example": "Ho bisogno di assistenza per il recupero della password."
        },
        "allegati": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Lista di allegati relativi alla richiesta di assistenza",
          "example": [
            "screenshot.png",
            "documento.pdf"
          ]
        },
        "risposta": {
          "type": "string",
          "description": "Risposta fornita dal team di assistenza",
          "example": "La password è stata reimpostata con successo."
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}
