        "tags": [
          "Defunti"
        ],
        "description": "Recupera i defunti",
        "operationId": "getDefunti",
        "summary": "Recupera i defunti per ID",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "_ssgv",
            "in": "cookie",
            "required": true,
            "description": "Cookie di Sessione per identificare lo user",
            "schema": {
              "type": "integer",
              "description": "ID univoco associato al token di sessione dell'utente",
              "example": 1
            }
          },
          {
            "name": "id",
            "in": "query",
            "description": "ID del cimitero da recuperare",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "inumazione",
            "in": "query",
            "description": "Nome dell'inumato",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "nome",
            "in": "query",
            "description": "Il nome del defunto",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cognome",
            "in": "query",
            "description": "Il cognome del defunto",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sesso",
            "in": "query",
            "description": "Il sesso del defunto",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "dataOraMorte",
            "in": "query",
            "description": "Data e ora della morte",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "luogoNascita",
            "in": "query",
            "description": "Il luogo di nascita del defunto",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "malattiaInfettiva",
            "in": "query",
            "description": "Campo in cui si spiega se il defunto aveva una malattia infettiva o meno",
            "required": false,
            "schema": {
              "type": "bool"
            }
          },
          {
            "name": "dataNascita",
            "in": "query",
            "description": "Data di nascita del defunto",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "dataOraSepoltura",
            "in": "query",
            "description": "Data e ora di sepoltura del defunto",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Defunto/i recuperato/i con successo",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Defunti"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Richiesta non valida, ID o defunto mancante",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Deve essere passato un ID o un defunto"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Defunto non trovato",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Defunto non trovato"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Errore interno del server",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Errore interno del server"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
