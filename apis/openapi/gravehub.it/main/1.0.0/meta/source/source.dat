        ],
        "operationId": "postContratti",
        "description": "Inserimento Contratti",
        "summary": "Inserimento Contratti",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "_ssgv",
            "in": "cookie",
            "required": true,
            "description": "Cookie di Sessione per identificare lo user",
            "schema": {
              "type": "integer",
              "description": "ID univoco associato al token di sessione dell'utente",
              "example": 1
            }
          }
        ],
        "requestBody": {
          "description": "Contratti da caricare",
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "cimitero": {
                    "type": "string",
                    "description": "Stringa JSON contenente i dettagli del contratto",
                    "example": "{\n\"id\": , \"inizio\": , \"fine\": , \"file\": , \"statoContratto\": , \"tipoContratto\": , \"defunto\":\n}\n"
                  },
                  "file": {
                    "type": "array",
                    "description": "Contratti da caricare",
                    "items": {
                      "type": "string",
                      "format": "binary"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Contratto creato con successo",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Contratto creato con successo"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Richiesta non valida, impossibile elaborare JSON o file",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Errore nella lettura della richiesta"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Errore interno del server durante la creazione del Contratto",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Errore durante il caricamento del file ..."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
