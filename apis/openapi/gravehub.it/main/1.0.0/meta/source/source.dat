{
  "openapi": "3.1.1",
  "info": {
    "title": "GraveHub APIs Docs",
    "termsOfService": "https://gravhub.it",
    "description": "APIs per la gestione cimiteriale attraverso il software GravHub",
    "version": "1.0.0",
    "contact": {
      "name": "Supporto Tecnico",
      "url": "https://dedpartners.com",
      "email": "assistenza@gravehub.it"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/CRISTIANO_5/gravehub-apis-docs/1.0.0"
  },
  "servers": [
    {
      "url": "https://gravehub.it",
      "description": "Server Produzione"
    },
    {
      "url": "https://collaudo.gravhub.it",
      "description": "Server di Collaudo"
    }
  ],
  "tags": [
    {
      "name": "Sessioni",
      "description": "Operazioni relative alle sessioni"
    },
    {
      "name": "Cimiteri",
      "description": "Operazioni relative ai cimiteri"
    },
    {
      "name": "Utenti",
      "description": "Operazioni relative agli utenti"
    },
    {
      "name": "Settori",
      "description": "Operazioni relative ai Settori"
    },
    {
      "name": "Sepoltura",
      "description": "Operazioni relative alle Sepolture"
    },
    {
      "name": "Defunti",
      "description": "Operazioni relative ai Defunti"
    },
    {
      "name": "Contratti",
      "description": "Operazioni relative ai Contratti"
    },
    {
      "name": "Aventi Diritto",
      "description": "Operazioni relative agli Aventi Diritto"
    },
    {
      "name": "Assistenza",
      "description": "Operazioni relative all'Assistenza"
    }
  ],
  "paths": {
    "/jwt/auth/login": {
      "post": {
        "description": "Login dell'utente",
        "tags": [
          "Sessioni"
        ],
        "operationId": "login",
        "summary": "Login dell'utente all'interno del sistema",
        "requestBody": {
          "description": "Invio di un JSON con email e password",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "description": "La mail dell'utente"
                  },
                  "password": {
                    "type": "string",
                    "description": "La password dell'utente"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Status OK, l'utente ha effettuato il login",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Utente identificato, OTP inviato"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request, i dati inviati non sono validi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Richiesta non valida"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized, utente con questa password non trovato",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Utente con questa password non trovato"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not Found, utente non trovato",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Utente non trovato"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/jwt/auth/logout": {
      "post": {
        "description": "Logout dell'utente",
        "operationId": "logout",
        "tags": [
          "Sessioni"
        ],
        "summary": "Logout dell'utente dal sistema",
        "parameters": [
          {
            "name": "_ssgv",
            "in": "cookie",
            "required": true,
            "description": "Cookie di Sessione per identificare lo user",
            "schema": {
              "type": "integer",
              "description": "ID univoco associato al token di sessione dell'utente",
              "example": 1
            }
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Logout effettuato",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Logout effettuato con successo"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request, Richiesta non valida"
          },
          "500": {
            "description": "Server Internal Error"
          }
        }
      }
    },
    "/jwt/auth/api-rest/refresh": {
      "post": {
        "tags": [
          "Sessioni"
        ],
        "operationId": "refreshToken",
        "description": "Richiedere un nuovo access token",
        "summary": "Richiedere un nuovo access token se la sessione è ancora valida",
        "parameters": [
          {
            "name": "_ssgv",
            "in": "cookie",
            "required": true,
            "description": "Cookie di Sessione per identificare lo user",
            "schema": {
              "type": "integer",
              "description": "ID univoco associato al token di sessione dell'utente",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sessione valida",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Nuovo access token generato"
                    },
                    "token": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Sessione scaduta o non valida",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Sessione scaduta o non valida"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Server Internal Error"
          }
        }
      }
    },
    "/api-rest/user/get": {
      "get": {
        "tags": [
          "Utenti"
        ],
        "operationId": "getUsers",
        "description": "Ottieni tutti gli utenti",
        "summary": "Ottieni gli utenti o cercalo tramite la mail",
        "parameters": [
          {
            "name": "email",
            "in": "query",
            "description": "Email per cercare uno specifico user",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "_ssgv",
            "in": "cookie",
            "required": true,
            "description": "Cookie di Sessione per identificare lo user",
            "schema": {
              "type": "integer",
              "description": "ID univoco associato al token di sessione dell'utente",
              "example": 1
            }
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "users trovati",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/User"
                  }
                }
              }
            }
          },
          "404": {
            "description": "User not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api-rest/user/post": {
      "post": {
        "tags": [
          "Utenti"
        ],
        "operationId": "createUser",
        "description": "Crea un nuovo user",
        "summary": "Crea un nuovo user",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "_ssgv",
            "in": "cookie",
            "required": true,
            "description": "Cookie di Sessione per identificare lo user",
            "schema": {
              "type": "integer",
              "description": "ID univoco associato al token di sessione dell'utente",
              "example": 1
            }
          }
        ],
        "requestBody": {
          "description": "object per crearne un nuovo user",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/User"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User creato con successo"
          },
          "400": {
            "description": "Invalida request o email già esistente"
          },
          "500": {
            "description": "Errore nella hash password o internal server error"
          }
        }
      }
    },
    "/api-rest/user/delete/{id}": {
      "delete": {
        "tags": [
          "Utenti"
        ],
        "operationId": "deleteUser",
        "description": "Elimina un user dall'ID",
        "summary": "Elimina un user dall'ID",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "_ssgv",
            "in": "cookie",
            "required": true,
            "description": "Cookie di Sessione per identificare lo user",
            "schema": {
              "type": "integer",
              "description": "ID univoco associato al token di sessione dell'utente",
              "example": 1
            }
          },
          {
            "name": "id",
            "in": "path",
            "description": "ID dell'user da eliminare",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User eliminato con successo",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "User eliminato con successo"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "User not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api-rest/user/put/{id}": {
      "put": {
        "tags": [
          "Utenti"
        ],
        "operationId": "updateUser",
        "description": "Aggiornare un utente dall'ID",
        "summary": "Aggiornare un utente dall'ID",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "_ssgv",
            "in": "cookie",
            "required": true,
            "description": "Cookie di Sessione per identificare lo user",
            "schema": {
              "type": "integer",
              "description": "ID univoco associato al token di sessione dell'utente",
              "example": 1
            }
          },
          {
            "name": "id",
            "in": "path",
            "description": "ID of the user to update",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "requestBody": {
          "description": "User object with updated information",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/User"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "404": {
            "description": "User not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api-rest/user/put/notifiche/{email}": {
      "put": {
        "tags": [
          "Utenti"
        ],
        "operationId": "updateUserNotification",
        "description": "Update user notification settings by email",
        "summary": "Update user notification settings by email",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "_ssgv",
            "in": "cookie",
            "required": true,
            "description": "Cookie di Sessione per identificare lo user",
            "schema": {
              "type": "integer",
              "description": "ID univoco associato al token di sessione dell'utente",
              "example": 1
            }
          },
          {
            "name": "email",
            "in": "path",
            "description": "Email of the user to update notification settings",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "New notification settings",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "impostazioni_notifiche": {
                    "type": "string",
                    "example": "true-6;false-0;false-0"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Notification settings updated successfully"
          },
          "404": {
            "description": "User not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/cimiteri/api/method/post": {
      "post": {
        "tags": [
          "Cimiteri"
        ],
        "operationId": "postCimitero",
        "description": "Censimento Cimiteriale",
        "summary": "Censimento Cimiteriale",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "_ssgv",
            "in": "cookie",
            "required": true,
            "description": "Cookie di Sessione per identificare lo user",
            "schema": {
              "type": "integer",
              "description": "ID univoco associato al token di sessione dell'utente",
              "example": 1
            }
          }
        ],
        "requestBody": {
          "description": "Oggetto cimitero e planimetrie da caricare",
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "cimitero": {
                    "type": "string",
                    "description": "Stringa JSON contenente i dettagli del cimitero",
                    "example": "{\n  \"latitudine\": 41.9028,\n  \"longitudine\": 12.4964,\n  \"regione\": \"Lazio\",\n  \"provincia\": \"Roma\",\n  \"comune\": \"Roma\",\n  \"posti_totali\": 1000,\n  \"inumazioni_presenti\": 300,\n  \"rotazione_esumazioni\": true\n}\n"
                  },
                  "file": {
                    "type": "array",
                    "description": "Planimetrie da caricare come file",
                    "items": {
                      "type": "string",
                      "format": "binary"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cimitero creato con successo",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Cimitero creato con successo"
                    },
                    "cimitero": {
                      "type": "integer",
                      "example": 1
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Richiesta non valida, impossibile elaborare JSON o file",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Errore nel parsing JSON: ..."
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Errore interno del server durante la creazione del cimitero",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Errore durante il caricamento del file ..."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/cimiteri/api/method/get": {
      "get": {
        "tags": [
          "Cimiteri"
        ],
        "description": "Recupera cimiteri per ID o comune",
        "operationId": "getCimiteri",
        "summary": "Recupera cimiteri per ID o comune",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "_ssgv",
            "in": "cookie",
            "required": true,
            "description": "Cookie di Sessione per identificare lo user",
            "schema": {
              "type": "integer",
              "description": "ID univoco associato al token di sessione dell'utente",
              "example": 1
            }
          },
          {
            "name": "id",
            "in": "query",
            "description": "ID del cimitero da recuperare",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "comune",
            "in": "query",
            "description": "Nome del comune per filtrare i cimiteri",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cimitero/i recuperato/i con successo",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Cimiteri"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Richiesta non valida, ID o comune mancante",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Deve essere passato un ID o un comune"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Cimitero non trovato",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Cimitero non trovato"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Errore interno del server",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Errore interno del server"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/cimiteri/api/method/delete/{id}": {
      "delete": {
        "tags": [
          "Cimiteri"
        ],
        "description": "Elimina un cimitero per ID",
        "operationId": "deleteCimitero",
        "summary": "Elimina un cimitero per ID",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "_ssgv",
            "in": "cookie",
            "required": true,
            "description": "Cookie di Sessione per identificare lo user",
            "schema": {
              "type": "integer",
              "description": "ID univoco associato al token di sessione dell'utente",
              "example": 1
            }
          },
          {
            "name": "id",
            "in": "path",
            "description": "ID del cimitero da eliminare",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cimitero eliminato con successo",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Cimitero eliminato con successo"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Richiesta non valida, ID mancante o non valido",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "ID deve essere un numero positivo"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Cimitero non trovato",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Cimitero non trovato"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Errore interno del server",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Errore durante l'eliminazione del cimitero"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/cimiteri/api/method/put/{id}": {
      "put": {
        "tags": [
          "Cimiteri"
        ],
        "description": "Aggiorna un cimitero per ID",
        "operationId": "updateCimitero",
        "summary": "Aggiorna un cimitero per ID",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "_ssgv",
            "in": "cookie",
            "required": true,
            "description": "Cookie di Sessione per identificare lo user",
            "schema": {
              "type": "integer",
              "description": "ID univoco associato al token di sessione dell'utente",
              "example": 1
            }
          },
          {
            "name": "id",
            "in": "path",
            "description": "ID del cimitero da aggiornare",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "requestBody": {
          "description": "Oggetto cimitero aggiornato e caricamento di nuova planimetria",
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "cimitero": {
                    "type": "string",
                    "description": "Stringa JSON contenente i dettagli aggiornati del cimitero",
                    "example": "{\n  \"latitudine\": 41.9028,\n  \"longitudine\": 12.4964,\n  \"regione\": \"Lazio\",\n  \"provincia\": \"Roma\",\n  \"comune\": \"Roma\",\n  \"posti_totali\": 1200,\n  \"inumazioni_presenti\": 350,\n  \"rotazione_esumazioni\": true\n}\n"
                  },
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "Nuova planimetria del cimitero"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cimitero aggiornato con successo",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
