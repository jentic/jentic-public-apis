            "minimum": 0
          },
          "modalities": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "providers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string"
                },
                "display_name": {
                  "type": "string"
                },
                "models": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
