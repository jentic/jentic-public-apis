          }
        ],
        "x-codeSamples": [
          {
            "lang": "javascript",
            "label": "TypeScript SDK",
            "source": "import { NinjaChat } from \"@ninjachat/sdk\";\nconst client = new NinjaChat({ apiKey: process.env.NINJACHAT_API_KEY! });\nconst result = await client.embeddings.create({\n  model: \"text-embedding-3-small\", input: [\"A document to index\"],\n});\nconsole.log(result.data[0].embedding);"
          },
          {
            "lang": "python",
            "label": "Python SDK",
            "source": "import os\nfrom ninjachat import NinjaChat\nclient = NinjaChat(api_key=os.environ[\"NINJACHAT_API_KEY\"])\nresult = client.embeddings.create(\n    model=\"text-embedding-3-small\", input=[\"A document to index\"],\n)\nprint(result[\"data\"][0][\"embedding\"])"
          }
        ],
        "x-ninjachat-status": "current"
      }
    },
