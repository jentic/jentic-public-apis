            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "WebhookActionRequest": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "update"
                ]
              },
              "endpoint_id": {
                "type": "string",
                "pattern": "^[a-fA-F0-9]{24}$"
              },
              "events": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/WebhookEvent"
                },
