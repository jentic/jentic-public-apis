          "models",
          "modalities",
          "providers",
          "request_id"
        ],
        "additionalProperties": false
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "description": "Safely retry the same logical write without duplicate billing or execution."
      }
    }
