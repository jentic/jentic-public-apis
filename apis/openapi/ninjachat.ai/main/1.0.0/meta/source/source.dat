          {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "rotate_secret"
                ]
              },
              "endpoint_id": {
                "type": "string",
                "pattern": "^[a-fA-F0-9]{24}$"
              }
            },
            "required": [
              "action",
              "endpoint_id"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "retry"
                ]
              },
              "delivery_id": {
                "type": "string",
                "pattern": "^[a-fA-F0-9]{24}$"
              }
            },
            "required": [
              "action",
              "delivery_id"
            ],
            "additionalProperties": false
          }
        ]
      },
