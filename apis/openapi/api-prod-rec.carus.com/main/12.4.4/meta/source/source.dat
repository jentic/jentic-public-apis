          },
          "bookingVersionCode": {
            "maximum": 99999999999999,
            "exclusiveMaximum": false,
            "minimum": 1,
            "exclusiveMinimum": false,
            "type": "number",
            "description": "booking version code to be used in modify requests"
          },
          "isCancelled": {
            "type": "boolean",
            "description": "is booking cancelled"
          },
          "bookingStatusCode": {
            "maxLength": 10,
            "minLength": 0,
