      "BookingStatus": {
        "type": "object",
        "properties": {
          "bookingStatusCode": {
            "maxLength": 10,
            "minLength": 0,
            "type": "string",
            "description": "Status of the booking. Note that booking status comes from a user-defined list and meanings may vary. See cancelled field for a Boolean status if the booking is cancelled or not."
          },
          "bookingStatusName": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string",
            "description": "Name of the booking status"
          },
