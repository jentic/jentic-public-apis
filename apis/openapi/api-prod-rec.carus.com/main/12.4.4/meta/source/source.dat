      "AllowedExternalIdTypeUses": {
        "required": [
          "agent",
          "bookingHeader",
          "bookingRow",
          "companyCustomer",
          "nameListRow",
          "naturalPersonCustomer",
          "supplier"
        ],
        "type": "object",
        "properties": {
          "companyCustomer": {
            "type": "boolean",
            "description": "If true, the External ID type can be connected to customers which are companies (Gender Company)"
          },
          "agent": {
            "type": "boolean",
            "description": "If true, the External ID type can be connected to agents"
          },
          "supplier": {
            "type": "boolean",
            "description": "If true, the External ID type can be connected to suppliers"
          },
          "naturalPersonCustomer": {
            "type": "boolean",
            "description": "If true, the External ID type can be connected to customers which are Natural Persons (Gender Male/Female)"
          },
          "bookingHeader": {
            "type": "boolean",
            "description": "If true, the External ID type is allowed in booking header"
          },
          "nameListRow": {
            "type": "boolean",
            "description": "If true, the External ID type is allowed in namelist"
          },
          "bookingRow": {
            "type": "boolean",
            "description": "If true, the External ID type is allowed on booking row"
          },
          "restrictToCategoryStructureGroupCode": {
            "maxLength": 10,
            "minLength": 0,
            "type": "string",
            "description": "External ID type is allowed on booking rows with categories in this group. Only relevant when bookingRow is true"
          }
        }
      },
      "CargoExternalIdType": {
        "required": [
          "active",
          "allowedUses",
          "anonymize",
          "defaultInBooking",
          "externalIdTypeCode",
          "id",
          "name",
          "validation"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Internal (CarRes) ID of the external identification type",
            "format": "int64"
          },
          "externalIdTypeCode": {
            "maxLength": 10,
            "minLength": 0,
            "type": "string"
          },
          "name": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string",
            "description": "Name of External identification type in provided language"
          },
          "internalName": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string",
            "description": "Default name of External identification type"
          },
          "description": {
            "maxLength": 1000,
            "minLength": 0,
            "type": "string"
          },
          "standardizedIdTypeCode": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "systemValidationCode": {
            "maxLength": 20,
            "minLength": 0,
            "type": "string"
          },
          "anonymize": {
            "type": "boolean",
            "description": "If true, the value of the type is deleted when the connected entity is anonymized"
          },
          "defaultInBooking": {
            "type": "boolean",
            "description": "If true, then used as default in bookings"
          },
          "active": {
            "type": "boolean"
          },
          "allowedUses": {
            "$ref": "#/components/schemas/AllowedExternalIdTypeUses"
          },
          "validation": {
            "$ref": "#/components/schemas/ExternalIdTypeValidation"
          },
          "salesChannelRule": {
            "$ref": "#/components/schemas/CargoExternalIdTypeSalesChannelRule"
          }
        }
      },
      "CargoExternalIdTypeCollection": {
        "type": "object",
        "properties": {
          "_links": {
            "$ref": "#/components/schemas/CollectionLinks"
          },
          "_meta": {
            "$ref": "#/components/schemas/CollectionMeta"
          },
          "externalIdTypes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CargoExternalIdType"
            }
          }
        },
        "description": "List of external ids"
      },
      "CargoExternalIdTypeSalesChannelRule": {
        "type": "object",
        "properties": {
          "updateLimit": {
            "$ref": "#/components/schemas/ExternalIdTypeSalesChannelRuleUpdateLimit"
          }
        }
      },
      "ExternalIdTypeSalesChannelRuleUpdateLimit": {
        "required": [
          "fromEvent",
          "maxHours"
        ],
        "type": "object",
        "properties": {
          "fromEvent": {
            "type": "string",
            "enum": [
              "ARRIVAL",
              "DEPARTURE",
              "UNKNOWN"
            ]
          },
          "maxHours": {
            "type": "number",
            "description": "Maximum hours after event when updates are still permitted."
          }
        }
      },
      "ExternalIdTypeValidation": {
        "required": [
          "allCharactersAllowed",
          "alphabeticCharactersAllowed",
          "forceToCase",
          "numbersAllowed"
        ],
        "type": "object",
        "properties": {
          "minLength": {
            "maximum": 128,
            "minimum": 1,
            "type": "integer",
            "description": "Minimum length for the value of the External ID type",
            "format": "int32"
          },
          "maxLength": {
            "maximum": 128,
            "minimum": 1,
            "type": "integer",
            "description": "Maximum length for the value of the External ID type",
            "format": "int32"
          },
          "numbersAllowed": {
            "type": "boolean",
            "description": "If true, the value of this type is allowed to include numbers"
          },
          "alphabeticCharactersAllowed": {
            "type": "boolean",
            "description": "If true, the value of this type is allowed to include letters A-Z"
          },
          "allCharactersAllowed": {
            "type": "boolean",
            "description": "If true, the value of this type is allowed to include other chars than A-Z"
          },
          "forceToCase": {
            "type": "string",
            "enum": [
              "NO_CHECK",
              "LOWERCASE",
              "UPPERCASE",
              "UNKNOWN"
            ]
          },
          "regularExpression": {
            "maxLength": 256,
            "minLength": 0,
            "type": "string",
            "description": "The value of this type must match the regular expression"
          }
        }
      },
      "CargoProduct": {
        "type": "object",
        "properties": {
          "extProductCode": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string",
            "description": "Product code used externally (combination of brochure code and product code in CarRes)"
          },
          "productName": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string",
            "description": "product name"
          },
          "startBookingDate": {
            "type": "string",
            "description": "start date for when new bookings of the product can be done",
            "format": "date"
          },
          "endBookingDate": {
            "type": "string",
            "description": "end date for when new bookings of the product can be done",
            "format": "date"
          },
          "hasPackageRule": {
            "type": "boolean",
            "description": "flag describing if product has package rule"
          },
          "minDaysBeforeDeparture": {
            "maximum": 99999999999999,
            "minimum": 0,
            "type": "integer",
            "description": "value defines how many days before the departure bookings are allowed by minimum",
            "format": "int64"
          },
          "maxDaysBeforeDeparture": {
            "maximum": 99999999999999,
            "minimum": 0,
            "type": "integer",
            "description": "value defines how many days before the departure bookings are allowed by maximum",
            "format": "int64"
          },
          "productTypes": {
            "type": "array",
            "description": "a list of product types the product has been mapped to",
            "items": {
              "$ref": "#/components/schemas/CargoProductType"
            }
          }
        },
        "description": "A Product object."
      },
      "CargoProductCollection": {
        "type": "object",
        "properties": {
          "products": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CargoProduct"
            }
          },
          "_links": {
            "$ref": "#/components/schemas/CollectionLinks"
          },
