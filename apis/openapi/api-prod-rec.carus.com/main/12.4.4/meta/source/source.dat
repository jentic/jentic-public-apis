      "CargoExtSearchResult": {
        "required": [
          "arrivalPortExtCode",
          "arrivalTime",
          "bookingCode",
          "bookingStatusCode",
          "departureCode",
          "departurePortExtCode",
          "departureTime",
          "id",
          "isCancelled",
          "isCheckedIn",
          "journeyCode",
          "onWaitlist",
          "rowStatusCode",
          "vehicleCategory",
          "vesselCode"
        ],
        "type": "object",
        "properties": {
          "id": {
            "maxLength": 28,
            "minLength": 0,
            "type": "string",
            "description": "Internal ID for the main vehicle row. Will usually be a integer, but may be bigger than allowed for integer types so presented as string. "
          },
          "bookingCode": {
            "maxLength": 10,
            "minLength": 0,
            "type": "string",
            "description": "Booking Code"
          },
          "bookingStatusCode": {
            "maxLength": 10,
            "minLength": 0,
            "type": "string",
            "description": "Code for the booking status on that booking"
          },
          "rowStatusCode": {
            "maxLength": 10,
            "minLength": 0,
            "type": "string",
            "description": "Code for the booking status on that booking row"
          },
          "onWaitlist": {
            "type": "boolean",
            "description": "True if the main vehicle row is on a waiting list, false otherwise"
          },
          "isCancelled": {
            "type": "boolean",
            "description": "True if the booking is cancelled, false otherwise"
          },
          "isCheckedIn": {
            "type": "boolean",
            "description": "True if the main vehicle row is checked in, false otherwise"
          },
          "isBoarded": {
            "type": "boolean",
            "description": "True if vehicle has been boarded, false otherwise."
          },
          "isDischarged": {
            "type": "boolean",
            "description": "True if vehicle has been discharged, false otherwise."
          },
          "isCargoVehicle": {
            "type": "boolean",
            "description": "True if vehicle is cargo"
          },
          "departureCode": {
            "type": "string",
            "description": "departure code for the departure for the main vehicle row"
          },
          "journeyCode": {
            "maxLength": 10,
            "minLength": 0,
            "type": "string",
            "description": "journey (route) code for the departure for the main vehicle row"
          },
          "departureTime": {
            "type": "string",
            "description": "The planned date and time of the departure (local time for the departure port)",
            "format": "date-time"
          },
          "arrivalTime": {
            "type": "string",
            "description": "The planned date and time of the arrival (local time for the arrival port)",
            "format": "date-time"
          },
          "vesselCode": {
            "maxLength": 10,
            "minLength": 0,
            "type": "string",
            "description": "code for the vessel to be used"
          },
          "vesselName": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string",
            "description": "name of the vessel to be used"
          },
          "customerCode": {
            "maxLength": 10,
            "minLength": 0,
            "type": "string",
            "description": "code for the customer who made the booking, if made by a registered customer"
          },
          "customerName": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string",
            "description": "name of the customer who made the booking, if made by a registered customer"
          },
          "bookingBalance": {
            "maximum": 1000000000000000000,
            "exclusiveMaximum": false,
            "minimum": -1000000000000000000,
            "exclusiveMinimum": false,
            "type": "number",
            "description": "current balance for the booking this vehicle is part of.",
            "format": "double"
          },
          "bookingPrice": {
            "maximum": 1000000000000000000,
            "exclusiveMaximum": false,
            "minimum": -1000000000000000000,
            "exclusiveMinimum": false,
            "type": "number",
            "description": "total price for the booking this vehicle is part of.",
            "format": "double"
          },
          "bookingIsOpen": {
            "type": "boolean",
            "description": "True if the booking is currently open by another user or system."
          },
          "bookingLastChanged": {
            "type": "string",
            "description": "date and time when booking was last updated.",
            "format": "date-time"
          },
          "salesChannelCode": {
            "maxLength": 10,
            "minLength": 0,
            "type": "string",
            "description": "ID of the sales channel on which this booking was made"
          },
          "internalNote": {
            "type": "string",
            "description": "additional information about cargo"
          },
          "externalNote": {
            "maxLength": 1000,
            "minLength": 0,
            "type": "string",
            "description": "external note"
          },
          "nameList": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NameListItem"
            }
          },
          "departurePortExtCode": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string",
            "description": "Port code used externally"
          },
          "departurePortExtName": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string",
            "description": "translated port name used externally"
          },
          "arrivalPortExtCode": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string",
            "description": "Port code used externally"
          },
          "arrivalPortExtName": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string",
            "description": "translated port name used externally"
          },
          "vehicleCategory": {
            "$ref": "#/components/schemas/CargoExtVehicleSummary"
          }
        }
      },
      "CargoExtSearchResultsCollection": {
        "type": "object",
        "properties": {
          "_links": {
