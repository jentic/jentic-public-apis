          },
          "countryExtCode": {
            "maxLength": 3,
            "minLength": 0,
            "type": "string",
            "description": "Country code used externally"
          },
          "active": {
            "type": "boolean",
            "description": "flag describing if the unit is active or not"
          }
        },
        "description": "Cargo unit object"
