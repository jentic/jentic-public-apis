          },
          "currencyExtCode": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string",
            "description": "Currency code used externally"
          },
          "bookingCode": {
            "maxLength": 10,
            "minLength": 0,
            "type": "string",
            "description": "Booking code in CarRes"
          },
          "includeSoldOut": {
            "type": "boolean",
            "description": "if true then include sold out row, if not then only availalbe"
          },
          "includeNotPossible": {
            "type": "boolean",
            "description": "if true then include also not possible rows. This is only intended for debugging so you can see why (e.g. missing price)"
          },
