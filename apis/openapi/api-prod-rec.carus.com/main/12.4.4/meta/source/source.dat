      "CargoRegistrationNumber": {
        "required": [
          "registrationNumberCode"
        ],
        "type": "object",
        "properties": {
          "primary": {
            "type": "boolean"
          },
          "registrationNumberCode": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string",
            "description": "Registration plate number"
          },
          "registrationStateCode": {
            "maxLength": 10,
            "minLength": 0,
            "type": "string",
            "description": "State ID in country of booking",
            "example": "CA"
          },
          "registrationCountryCode": {
            "maxLength": 3,
            "minLength": 1,
            "type": "string",
            "description": "This is the CarRes internal ID, although it's recommended to use ISO 3166-1 Alpha-3, but it's not enforced."
          },
          "driverInfo": {
            "$ref": "#/components/schemas/DriverInfo"
          },
          "driversNameListRowNumber": {
            "maximum": 99999,
            "type": "integer",
            "description": "\\*DEPRECATED*\\ This field will be removed in a future release - use corresponding field under driverInfo instead.",
            "format": "int32"
          },
          "driverNote": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string",
            "description": "\\*DEPRECATED*\\ This field will be removed in a future release - use corresponding field under driverInfo instead."
          }
        },
        "description": "Object representing Cargo registration number"
      },
      "ExternalId": {
        "required": [
          "externalIdTypeCode",
          "value"
        ],
        "type": "object",
        "properties": {
          "externalIdTypeCode": {
            "maxLength": 10,
            "minLength": 0,
            "type": "string",
            "description": "Type of external id."
          },
          "value": {
            "maxLength": 128,
            "minLength": 0,
            "type": "string",
            "description": "Value of external id."
          },
          "externalValidation": {
            "$ref": "#/components/schemas/ExternalIdValidation"
          }
        },
        "description": "External id used by customers, agents, suppliers etc."
      },
      "ExternalIdValidation": {
        "required": [
          "manuallyApproved",
          "valid"
        ],
        "type": "object",
        "properties": {
          "validationToken": {
            "type": "string",
            "description": "A token received from the external validation service. Not supported by all external services."
          },
          "validationHash": {
            "type": "string",
            "description": "A hash calculated using the fields that are validated."
          },
          "manuallyApproved": {
            "type": "boolean",
            "description": "If automatic validation fails, an in-house user can manually approve an external ID."
          },
          "valid": {
            "type": "boolean",
            "description": "Indicates if the current external ID value is valid."
          }
        },
        "description": "Used if an External ID has been configured to be validated using an external service."
      },
