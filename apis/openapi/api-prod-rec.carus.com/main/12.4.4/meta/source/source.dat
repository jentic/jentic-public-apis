      "CargoBookingControlFlags": {
        "type": "object",
        "properties": {
          "isValidCargoBooking": {
            "type": "boolean",
            "description": "flags describes i the booking fits the cargo api definition of a valid booking"
          },
          "isLocked": {
            "type": "boolean",
            "description": "flag describes if the booking is currently being locked by another user (cannot be read or written)"
          },
          "isCancelAllowed": {
            "type": "boolean",
            "description": "flag describes if canceling of the booking is possible through cargo api"
          },
          "cancelNotAllowedReasonCode": {
            "type": "string",
            "description": "code describing the reason why cancel is not allowed",
            "enum": [
              "GROUP_BOOKING",
              "OTHER_REASON"
            ]
          },
          "isUpdateAllowed": {
            "type": "boolean",
            "description": "flag describes if updating of the booking is possible through cargo api"
          },
          "updateNotAllowedReasonCode": {
            "type": "string",
            "enum": [
              "MISSING_CATEGORY_TRANSLATION",
              "MANUAL_PRICE_USED",
              "ROW_ALREADY_CHECKED_IN",
              "JOURNEY_IS_IN_THE_PAST",
              "BOOKING_IS_READONLY",
              "CUSTOMER_NOT_ALLOWED_FOR_API",
              "PRODUCT_DOES_NOT_ALLOW_UPDATES",
              "GROUP_BOOKING",
              "INVALID_CARGO_BOOKING",
              "LOCKED_BY_OTHER_USER",
              "OTHER_REASON"
            ]
          }
        },
        "description": "flags are used by the backend to advice the frontend what options are available to the booking at the time of fetching it"
      },
