            "type": "number",
            "description": "length of the vehicle",
            "format": "double"
          },
          "width": {
            "maximum": 99999,
            "exclusiveMaximum": false,
            "minimum": 0,
            "exclusiveMinimum": false,
            "type": "number",
            "description": "width of the vehicle",
            "format": "double"
          },
          "height": {
            "maximum": 9999999999,
            "exclusiveMaximum": false,
            "minimum": 0,
            "exclusiveMinimum": false,
            "type": "number",
            "description": "height of the vehicle",
            "format": "double"
          },
          "tarWeight": {
            "maximum": 9999999999,
            "exclusiveMaximum": false,
            "minimum": 0,
