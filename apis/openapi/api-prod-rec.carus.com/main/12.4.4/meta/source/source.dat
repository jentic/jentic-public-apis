    "/cargo-self-service/v1/bookings-search/{departureDateFromDate}/{departureDateFromHours}/{departureDateFromMins}/{departureDateToDate}/{departureDateToHours}/{departureDateToMins}": {
      "post": {
        "tags": [
          "CargoSelfServiceBookings"
        ],
        "summary": "Search bookings",
        "description": "search bookings",
        "operationId": "bookingSearch",
        "parameters": [
          {
            "name": "X-Carus-APISYS",
            "in": "header",
            "description": "Code for the APISYS (Also known as External API or External API Translation) in CarRes. This determines what entities (categories, ports, etc.) are exposed and can map the codes to external values. It also steers some parameters such as sales channel.",
            "required": true,
            "style": "simple",
            "explode": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Carus-Auth",
            "in": "header",
            "description": "Carus Auth token, identifying the end user who is making the call. The \"end user\" can be either an Agent, a Customer or a Sub-Login, depending on context. This should be obtained from the relevant authentication endpoint in the API being called.",
            "required": true,
            "style": "simple",
            "explode": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "departureDateFromDate",
            "in": "path",
            "description": "Limit the search to departures after (or equal to) this date (departureDateFromDate together with departureDateFromHours and departureDateFromMins provide the date-time to search from). Note that the index does not include an unlimited departure history. We only include departures a specified number of days back from today (and all future departures). Usually the limit is 150 days but it may vary according to configuration. If you try to request from a date earlier than this limit you will get an error.",
            "required": true,
            "style": "simple",
            "explode": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "departureDateFromHours",
            "in": "path",
            "description": "Limit the search to departures after (or equal to) this hour of the day on the date specified (departureDateFromDate together with departureDateFromHours and departureDateFromMins provide the date-time to search from)",
            "required": true,
            "style": "simple",
            "explode": false,
            "schema": {
              "maximum": 23,
              "minimum": 0,
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "departureDateFromMins",
            "in": "path",
            "description": "Limit the search to departures after (or equal to) this many minutes past the hour of the day on the date specified (departureDateFromDate together with departureDateFromHours and departureDateFromMins provide the date-time to search from)",
            "required": true,
            "style": "simple",
            "explode": false,
            "schema": {
              "maximum": 59,
              "minimum": 0,
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "departureDateToDate",
            "in": "path",
            "description": "Limit the search to departures before (or equal to) this date (departureDateToDate together with departureDateToHours and departureDateToMins provide the date-time to search to)",
            "required": true,
            "style": "simple",
            "explode": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "departureDateToHours",
            "in": "path",
            "description": "Limit the search to departures before (or equal to) this hour of the day on the date specified (departureDateToDate together with departureDateToHours and departureDateToMins provide the date-time to search to)",
            "required": true,
            "style": "simple",
            "explode": false,
            "schema": {
              "maximum": 23,
              "minimum": 0,
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "departureDateToMins",
            "in": "path",
            "description": "Limit the search to departures before (or equal to) this many minutes past the hour of the day on the date specified (departureDateToDate together with departureDateToHours and departureDateToMins provide the date-time to search to)",
            "required": true,
            "style": "simple",
            "explode": false,
            "schema": {
              "maximum": 59,
              "minimum": 0,
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "Accept-Language",
            "in": "header",
            "description": "Standard header for specifying the language to use. See https://developer.mozilla.org/en-US/docs/Web/HTTP/Headers/Accept-Language When an APISYS is supplied then the external codes should be used. Usually this would be ISO 639-1 codes. Locales are not supported.",
            "required": false,
            "style": "simple",
            "explode": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "description": "Page size in a collection. Default value - 10",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "pageNum",
            "in": "query",
