            "type": "string",
            "description": "Main booking status",
            "enum": [
              "OK",
              "CANCEL",
              "UNKNOWN"
            ]
          },
          "isBookable": {
            "type": "boolean",
            "description": "Is user allowed to book with this status"
          }
