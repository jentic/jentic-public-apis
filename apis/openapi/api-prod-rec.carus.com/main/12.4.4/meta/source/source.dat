            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Comma-separated list of fields used for sorting (add `-` to the end of field name to change sorting direction)",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "X-Carus-RenderNullFields",
            "in": "header",
            "description": "If true, then server should return null fields and empty arrays in a response. If false then any null fields or empty objects/lists will not be returned at all. Assuming you serialise to a known type, they will then end up as null. This can seriously reduce the volume of data transferred.",
