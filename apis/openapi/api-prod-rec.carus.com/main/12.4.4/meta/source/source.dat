      "CargoLoginInformation": {
        "required": [
          "customerCode",
          "customerLoginCode",
          "customerName"
        ],
        "type": "object",
        "properties": {
          "customerCode": {
            "maxLength": 10,
            "minLength": 0,
            "type": "string",
            "description": "CarRes' internal ID of a registered customer",
            "example": "JOHNDOE"
          },
          "customerName": {
            "type": "string"
          },
          "customerLoginCode": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string",
            "description": "customer login code"
          },
          "customerSubLogin": {
            "$ref": "#/components/schemas/CargoCustomerSubLogin"
          },
          "customerPrivileges": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CustomerPrivilege"
            }
          }
        }
      },
      "CustomerPrivilege": {
        "required": [
          "privilegeCode"
        ],
        "type": "object",
        "properties": {
          "privilegeCode": {
            "type": "string",
            "description": "Can be one of the following values: - AMEND_BOOK - Amend booking - AMEND_CUS - Modify customer - CANCEL_BOOK - Cancel booking - CLOSE_DEP - Close departure - CREATE_BOOK - Create booking - MANAGE_LOGIN - Manage customer web login details - SEND_SMS - Send SMS message - UPDATE_BOKCNT - Update phone or email on booking - UPDATE_NAMES - Update names on booking - UPDATE_PROTSP - Update protected space - UPDATE_REF - Update booking row reference - UPDATE_REGNUM - Update register numbers on booking "
          },
          "privilegeSettings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CustomerPrivilegeSetting"
            }
          }
        },
        "description": "Customer privilege"
      },
      "CustomerPrivilegeSetting": {
        "required": [
          "dataType",
          "settingCode"
        ],
        "type": "object",
        "properties": {
          "tingCode": {
            "$ref": "#/components/schemas/CustomerPrivilegeSetting"
          },
          "settingCode": {
            "type": "string",
            "description": "Can be one of the following values: - AMEND_BOOK MAX_MOVE_JRY - Maximum amount of hours journey can be moved - AMEND_BOOK PREVENT_3RD_CTY - Prevent set of 3rd country on booking - AMEND_BOOK PREVENT_IMDG - Prevent booking of dangerous goods "
          },
          "dataType": {
            "type": "string",
            "enum": [
              "TEXT",
              "NUMERIC",
              "DATE",
              "BOOLEAN"
            ]
          },
          "textValue": {
            "type": "string"
          },
          "numericValue": {
            "type": "number"
          },
          "dateValue": {
            "type": "string",
            "format": "date-time"
          },
          "booleanValue": {
            "type": "boolean"
          }
        },
        "description": "Customer privilege setting"
      },
      "CargoCustomer": {
