          },
          "totalWeight": {
            "maximum": 9999999999,
            "exclusiveMaximum": false,
            "minimum": 0,
            "exclusiveMinimum": false,
            "type": "number",
            "description": "weight of the vehicle",
            "format": "double"
          },
          "hasHazardousGoods": {
            "type": "boolean",
            "description": "True if the vehicle has any hazardous goods (IMDG) registered, false otherwise"
          },
          "vehicleType": {
            "type": "string",
            "enum": [
              "trailer",
              "trucker",
              "driverlessCar",
              "unknown"
