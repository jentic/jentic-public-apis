            "description": "Page size in a collection. Default value - 10",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "pageNum",
            "in": "query",
            "description": "Starting point for this page in a collection",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "X-Carus-RenderNullFields",
            "in": "header",
            "description": "If true, then server should return null fields and empty arrays in a response. If false then any null fields or empty objects/lists will not be returned at all. Assuming you serialise to a known type, they will then end up as null. This can seriously reduce the volume of data transferred.",
            "required": false,
            "style": "simple",
            "explode": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of booking status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingStatusCollection"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/BookingStatusCollection"
                }
              }
            }
          },
          "400": {
            "description": "Cannot create object based on provided data.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error400"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/Error400"
                }
              }
            }
          },
          "401": {
            "description": "Client is not authenticated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error401"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/Error401"
                }
              }
            }
          },
          "403": {
            "description": "Request is not allowed by authenticated client.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error403"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/Error403"
                }
              }
            }
          },
          "404": {
            "description": "Object not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error404"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/Error404"
                }
              }
            }
          },
          "406": {
            "description": "Content type provided by client in Accept-header is not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error406"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/Error406"
                }
              }
            }
          },
          "409": {
            "description": "Update resulted in conflict.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error409"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/Error409"
                }
              }
            }
          },
          "429": {
            "description": "Client has tried too many requests and exceeded rate-limits.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error429"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/Error429"
                }
              }
            }
          }
        },
        "security": [
          {
            "default": []
          }
        ],
        "x-throttling-tier": "Unlimited"
      }
    }
  },
