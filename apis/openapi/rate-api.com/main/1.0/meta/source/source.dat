{
    "openapi": "3.0.3",
    "info": {
        "title": "Rate-API",
        "description": "Latest and historical foreign-exchange rates for 160+ currencies (checked hourly, updated as sources publish), plus conversion. Authenticate with your API key from the Rate-API dashboard.",
        "version": "1.0",
        "contact": {
            "name": "Rate-API",
            "url": "https://rate-api.com"
        }
    },
    "servers": [
        {
            "url": "https://rate-api.com/api/v1"
        }
    ],
    "security": [
        {
            "api_key": []
        }
    ],
    "paths": {
        "/latest": {
            "get": {
                "summary": "Latest rates",
                "description": "Latest exchange rates for a base currency.",
                "operationId": "GetLatest",
                "parameters": [
                    {
                        "name": "base",
                        "in": "query",
                        "required": false,
                        "description": "Base currency code, e.g. USD.",
                        "schema": {
                            "type": "string",
                            "default": "USD"
                        }
                    },
                    {
                        "name": "symbols",
                        "in": "query",
                        "required": false,
                        "description": "Comma-separated target codes to filter, e.g. EUR,GBP.",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/LatestResponse"
                                }
                            }
                        }
                    },
                    "default": {
                        "description": "Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/convert": {
            "get": {
                "summary": "Convert an amount",
                "description": "Convert an amount from one currency to another (Pro plan and up).",
                "operationId": "Convert",
                "parameters": [
                    {
                        "name": "from",
                        "in": "query",
                        "required": true,
                        "description": "Source currency code.",
                        "schema": {
                            "type": "string",
                            "default": "USD"
                        }
                    },
                    {
                        "name": "to",
                        "in": "query",
                        "required": true,
                        "description": "Target currency code.",
                        "schema": {
                            "type": "string",
                            "default": "EUR"
                        }
                    },
                    {
                        "name": "amount",
                        "in": "query",
                        "required": true,
                        "description": "Amount to convert.",
                        "schema": {
                            "type": "string",
                            "default": "100"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ConvertResponse"
                                }
                            }
                        }
                    },
                    "default": {
                        "description": "Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/pair/{from}/{to}": {
            "get": {
                "summary": "Pair rate",
                "description": "Latest rate for a currency pair.",
                "operationId": "GetPair",
                "parameters": [
                    {
                        "name": "from",
                        "in": "path",
                        "required": true,
                        "description": "Source currency code.",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "to",
                        "in": "path",
                        "required": true,
                        "description": "Target currency code.",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PairResponse"
                                }
                            }
                        }
                    },
                    "default": {
                        "description": "Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/historical": {
            "get": {
                "summary": "Historical rates",
                "description": "Exchange rates for a past date (Pro plan and up).",
                "operationId": "GetHistorical",
                "parameters": [
                    {
                        "name": "date",
                        "in": "query",
                        "required": true,
                        "description": "Date in YYYY-MM-DD format.",
                        "schema": {
                            "type": "string",
                            "default": "2026-01-01"
                        }
                    },
                    {
                        "name": "base",
                        "in": "query",
                        "required": false,
                        "description": "Base currency code.",
                        "schema": {
                            "type": "string",
                            "default": "USD"
                        }
                    },
                    {
                        "name": "symbols",
                        "in": "query",
                        "required": false,
                        "description": "Comma-separated target codes.",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/LatestResponse"
                                }
                            }
                        }
                    },
                    "default": {
                        "description": "Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/timeseries": {
            "get": {
                "summary": "Time series",
                "description": "Daily rates for every day from start_date to end_date (inclusive, at most 366 days), keyed by date then currency. Days with no published rates are omitted. Business plan and up.",
                "operationId": "GetTimeseries",
                "parameters": [
                    {
                        "name": "start_date",
                        "in": "query",
                        "required": true,
                        "description": "First day of the range, YYYY-MM-DD.",
                        "schema": {
                            "type": "string",
                            "default": "2026-01-01"
                        }
                    },
                    {
                        "name": "end_date",
                        "in": "query",
                        "required": true,
                        "description": "Last day of the range, YYYY-MM-DD. The range may span at most 366 days.",
                        "schema": {
                            "type": "string",
                            "default": "2026-01-31"
                        }
                    },
                    {
                        "name": "base",
                        "in": "query",
                        "required": false,
                        "description": "Base currency code.",
                        "schema": {
                            "type": "string",
                            "default": "USD"
                        }
                    },
                    {
                        "name": "symbols",
                        "in": "query",
                        "required": false,
                        "description": "Comma-separated target codes, e.g. EUR,GBP.",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/TimeseriesResponse"
                                }
                            }
                        }
                    },
                    "default": {
                        "description": "Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/fluctuation": {
            "get": {
                "summary": "Fluctuation",
                "description": "How each currency moved between start_date and end_date (at most 366 days): start and end rate, absolute change and percentage change. Business plan and up.",
                "operationId": "GetFluctuation",
                "parameters": [
                    {
                        "name": "start_date",
                        "in": "query",
                        "required": true,
                        "description": "First day of the range, YYYY-MM-DD.",
                        "schema": {
                            "type": "string",
                            "default": "2026-01-01"
                        }
                    },
                    {
                        "name": "end_date",
                        "in": "query",
                        "required": true,
                        "description": "Last day of the range, YYYY-MM-DD. The range may span at most 366 days.",
                        "schema": {
                            "type": "string",
                            "default": "2026-01-31"
                        }
                    },
                    {
                        "name": "base",
                        "in": "query",
                        "required": false,
                        "description": "Base currency code.",
                        "schema": {
                            "type": "string",
                            "default": "USD"
                        }
                    },
                    {
                        "name": "symbols",
                        "in": "query",
                        "required": false,
                        "description": "Comma-separated target codes, e.g. EUR,GBP.",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/FluctuationResponse"
                                }
                            }
                        }
                    },
                    "default": {
                        "description": "Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/crypto": {
            "get": {
                "summary": "Crypto rates",
                "description": "Top cryptocurrency prices in USD (Pro plan and up).",
                "operationId": "GetCrypto",
                "parameters": [
                    {
                        "name": "symbols",
                        "in": "query",
                        "required": false,
                        "description": "Comma-separated crypto symbols, e.g. BTC,ETH.",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/GenericResponse"
                                }
                            }
                        }
                    },
                    "default": {
                        "description": "Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/status": {
            "get": {
                "summary": "Key status",
                "description": "Confirms the key works and reports the plan it belongs to. Useful for validating a saved credential.",
                "operationId": "GetStatus",
                "parameters": [],
                "responses": {
                    "200": {
                        "description": "Success",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/GenericResponse"
                                }
                            }
                        }
                    },
                    "default": {
                        "description": "Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/stocks": {
            "get": {
                "summary": "Stock prices",
                "description": "Latest closing prices for the tracked equities, in USD (Pro plan and up).",
                "operationId": "GetStocks",
                "parameters": [
                    {
                        "name": "symbols",
                        "in": "query",
                        "required": false,
                        "description": "Comma-separated tickers, e.g. AAPL,MSFT.",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/GenericResponse"
                                }
                            }
                        }
                    },
                    "default": {
                        "description": "Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/metals": {
            "get": {
                "summary": "Precious metals",
                "description": "Gold, silver, platinum and palladium priced per troy ounce in USD (Pro plan and up).",
                "operationId": "GetMetals",
                "parameters": [
                    {
                        "name": "symbols",
                        "in": "query",
                        "required": false,
                        "description": "Comma-separated metal codes, e.g. XAU,XAG.",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/GenericResponse"
                                }
                            }
                        }
                    },
                    "default": {
                        "description": "Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/currencies": {
            "get": {
                "summary": "List currencies",
                "description": "All supported currencies with names and symbols.",
                "operationId": "ListCurrencies",
                "parameters": [],
                "responses": {
                    "200": {
                        "description": "Success",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/CurrenciesResponse"
                                }
                            }
                        }
                    },
                    "default": {
                        "description": "Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/usage": {
            "get": {
                "summary": "Usage",
                "description": "Request counts for the current key.",
                "operationId": "GetUsage",
                "parameters": [],
                "responses": {
                    "200": {
                        "description": "Success",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/GenericResponse"
                                }
                            }
                        }
                    },
                    "default": {
                        "description": "Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/quota": {
            "get": {
                "summary": "Quota",
                "description": "Plan quota and remaining requests for the current key.",
                "operationId": "GetQuota",
                "parameters": [],
                "responses": {
                    "200": {
                        "description": "Success",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/GenericResponse"
                                }
                            }
                        }
                    },
                    "default": {
                        "description": "Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "api_key": {
                "type": "apiKey",
                "in": "header",
                "name": "X-API-Key",
                "description": "Your Rate-API key."
            }
        },
        "schemas": {
            "LatestResponse": {
                "type": "object",
                "properties": {
                    "success": {
                        "type": "boolean"
                    },
                    "timestamp": {
                        "type": "integer"
                    },
                    "base": {
                        "type": "string",
                        "example": "USD"
                    },
                    "date": {
                        "type": "string",
                        "example": "2026-06-27"
                    },
                    "rates": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "number"
                        },
                        "description": "Currency code to rate."
                    }
                }
            },
            "TimeseriesResponse": {
                "type": "object",
                "properties": {
                    "success": {
                        "type": "boolean"
                    },
                    "timeseries": {
                        "type": "boolean"
                    },
                    "base": {
                        "type": "string",
                        "example": "USD"
                    },
                    "start_date": {
                        "type": "string",
                        "example": "2026-01-01"
                    },
                    "end_date": {
                        "type": "string",
                        "example": "2026-01-31"
                    },
                    "rates": {
                        "type": "object",
                        "description": "Date (YYYY-MM-DD) to an object of currency code to rate.",
                        "additionalProperties": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "number"
                            }
                        }
                    },
                    "api_version": {
                        "type": "string",
                        "example": "v1"
                    },
                    "request_id": {
                        "type": "string"
                    },
                    "timestamp": {
                        "type": "integer"
                    }
                }
            },
            "FluctuationResponse": {
                "type": "object",
                "properties": {
                    "success": {
                        "type": "boolean"
                    },
                    "fluctuation": {
                        "type": "boolean"
                    },
                    "base": {
                        "type": "string",
                        "example": "USD"
                    },
                    "start_date": {
                        "type": "string",
                        "example": "2026-01-01"
                    },
                    "end_date": {
                        "type": "string",
                        "example": "2026-01-31"
                    },
                    "rates": {
                        "type": "object",
                        "description": "Currency code to its movement over the range.",
                        "additionalProperties": {
                            "type": "object",
                            "properties": {
                                "start_rate": {
                                    "type": "number",
                                    "description": "First published rate on or after start_date."
                                },
                                "end_rate": {
                                    "type": "number",
                                    "description": "Last published rate on or before end_date."
                                },
                                "change": {
                                    "type": "number",
                                    "description": "end_rate minus start_rate."
                                },
                                "change_pct": {
                                    "type": "number",
                                    "description": "Change as a percentage of start_rate."
                                }
                            }
                        }
                    },
                    "api_version": {
                        "type": "string",
                        "example": "v1"
                    },
                    "request_id": {
                        "type": "string"
                    },
                    "timestamp": {
                        "type": "integer"
                    }
                }
            },
            "ConvertResponse": {
                "type": "object",
                "properties": {
                    "success": {
                        "type": "boolean"
                    },
                    "query": {
                        "type": "object",
                        "properties": {
                            "from": {
                                "type": "string"
                            },
                            "to": {
                                "type": "string"
                            },
                            "amount": {
                                "type": "number"
                            }
                        }
                    },
                    "info": {
                        "type": "object",
                        "properties": {
                            "timestamp": {
                                "type": "integer"
                            },
                            "rate": {
                                "type": "number"
                            }
                        }
                    },
                    "date": {
                        "type": "string"
                    },
                    "result": {
                        "type": "number"
                    }
                }
            },
            "PairResponse": {
                "type": "object",
                "properties": {
                    "success": {
                        "type": "boolean"
                    },
                    "pair": {
                        "type": "object",
                        "properties": {
                            "from": {
                                "type": "string"
                            },
                            "to": {
                                "type": "string"
                            }
                        }
                    },
                    "rate": {
                        "type": "number"
                    },
                    "timestamp": {
                        "type": "integer"
                    },
                    "date": {
                        "type": "string"
                    }
                }
            },
            "CurrenciesResponse": {
                "type": "object",
                "properties": {
                    "success": {
                        "type": "boolean"
                    },
                    "currencies": {
                        "type": "object",
                        "description": "Currency code to metadata."
                    },
                    "total": {
                        "type": "integer"
                    },
                    "timestamp": {
                        "type": "integer"
                    }
                }
            },
            "GenericResponse": {
                "type": "object",
                "properties": {
                    "success": {
                        "type": "boolean"
                    }
                }
            },
            "Error": {
                "type": "object",
                "properties": {
                    "success": {
                        "type": "boolean",
                        "example": false
                    },
                    "error": {
                        "type": "object",
                        "properties": {
                            "code": {
                                "type": "integer"
                            },
                            "type": {
                                "type": "string"
                            },
                            "message": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    }
}