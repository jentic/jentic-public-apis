1,"maxLength":64}},"constraints":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}},"why":{"type":"string","maxLength":200}},"required":["id"],"additionalProperties":false}},"egress":{"default":{"allowHosts":[]},"type":"object","properties":{"allowHosts":{"default":[],"maxItems":20,"type":"array","items":{"type":"string","maxLength":253}}},"required":["allowHosts"],"additionalProperties":false},"data":{"type":"object","properties":{"migrations":{"maxItems":200,"type":"array","items":{"type":"object","properties":{"version":{"type":"integer","minimum":1,"maximum":9007199254740991},"name":{"type":"string","pattern":"^[a-z0-9][a-z0-9_]{0,59}$"},"file":{"type":"string","maxLength":80},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}},"required":["version","name","file","sha256"],"additionalProperties":false}}},"required":["migrations"],"additionalProperties":false}},"required":["schemaVersion","worker","assets","d1","r2","vars","secrets","build","schedules","capabilities","egress"],"additionalProperties":false}]},{"type":"null"}]},"resources":{"anyOf":[{"type":"object","properties":{"worker":{"type":"object","properties":{"modules":{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991},"bytes":{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991}},"required":["modules","bytes"],"additionalProperties":false},"assets":{"anyOf":[{"type":"object","properties":{"files":{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991},"bytes":{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991}},"required":["files","bytes"],"additionalProperties":false},{"type":"null"}]},"d1":{"anyOf":[{"type":"object","properties":{"binding":{"type":"string"}},"required":["binding"],"additionalProperties":false},{"type":"null"}]},"r2":{"anyOf":[{"type":"object","properties":{"binding":{"type":"string"}},"required":["binding"],"additionalProperties":false},{"type":"null"}]}},"required":["worker","assets","d1","r2"],"additionalProperties":false},{"type":"null"}]},"warnings":{"type":"array","items":{"type":"object","properties":{"code":{"type":"string"},"message":{"type":"string"}},"required":["code","message"],"additionalProperties":false}},"failure":{"anyOf":[{"type":"object","properties":{"code":{"type":"string"},"message":{"type":"string"},"details":{"anyOf":[{"type":"object","properties":{"errors":{"type":"array","items":{"type":"object","properties":{"path":{"type":"string","description":"Archive path, with a JSON pointer after `#` for config files."},"code":{"type":"string"},"message":{"type":"string"}},"required":["path","code","message"],"additionalProperties":false}}},"additionalProperties":{}},{"type":"null"}]}},"required":["code","message"],"additionalProperties":false},{"type":"null"}]},"url":{"type":"string","description":"Published app URL."},"draftUrl":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Draft URL (workspace editors only; null for others)."},"createdAt":{"type":"string","format":"date-time"},"startedAt":{"anyOf":[{"type":"string","format":"date-time"},{"type":"null"}]},"finishedAt":{"anyOf":[{"type":"string","format":"date-time"},{"type":"null"}]},"needsMigration":{"type":"boolean","description":"This version changes stored data in a way the published version may not read (a warning: publishing is still allowed)."},"migrationFindings":{"type":"array","items":{"type":"object","properties":{"source":{"type":"string","enum":["migration","bundle"],"description":"A migration file, or SQL in the app code."},"file":{"type":"string"},"line":{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991,"description":"1-based line; 0 for a whole-file finding."},"kind":{"type":"string","enum":["drop_table","drop_view","drop_column","rename_table","rename_column","type_change","edited_migration"],"description":"What the statement does to stored data."},"statement":{"type":"string"}},"required":["source","file","line","kind","statement"],"additionalProperties":false},"description":"Why needsMigration is set (empty when it is not)."},"restorePoint":{"anyOf":[{"type":"object","properties":{"takenAt":{"type":"string","format":"date-time"},"available":{"type":"boolean","description":"False when the restore point could not be taken (the publish went ahead)."}},"required":["takenAt","available"],"additionalProperties":false},{"type":"null"}],"description":"Restore point of the app's stored data taken right before this version was last published; null if never published or the app stores no database."}},"required":["id","appId","number","status","target","isDraft","isPublished","publishedAt","archive","resources","warnings","failure","url","draftUrl","createdAt","startedAt","finishedAt","needsMigration","migrationFindings","restorePoint"],"additionalProperties":false},"description":"Deployments, newest first. `manifest` is omitted; read a single deploy for it."},"hasMore":{"type":"boolean","description":"Another page exists. When `false` you have reached the end — stop requesting pages."},"nextCursor":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Pass verbatim as the next request's `cursor` to fetch the next page. Null exactly when `hasMore` is false."}},"required":["data","hasMore","nextCursor"],"additionalProperties":false},"EmptyBodyDto":{"type":"object","properties":{},"additionalProperties":false},"SetupLinkDto":{"type":"object","properties":{"url":{"type":"string","description":"Open in a browser signed in to Trayo with permission to manage apps."},"expiresAt":{"type":"null"}},"required":["url","expiresAt"],"additionalProperties":false},"SetSecretDto":{"type":"object","properties":{"value":{"type":"string","minLength":1,"description":"The secret value. Write-only: it is never returned by any API."}},"required":["value"],"additionalProperties":false},"SecretSetDto":{"type":"object","properties":{"name":{"type":"string"},"updatedAt":{"type":"string","format":"date-time"}},"required":["name","updatedAt"],"additionalProperties":false},"SecretDeletedDto":{"type":"object","properties":{"name":{"type":"string"},"deleted":{"type":"boolean","const":true}},"required":["name","deleted"],"additionalProperties":false},"AppScheduleListDto":{"type":"object","properties":{"data":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string","format":"uuid"},"name":{"type":"string"},"description":{"type":"string"},"cron":{"type":"string","description":"5-field cron, evaluated in `timezone`."},"cronText":{"description":"The cadence in words.","type":"string"},"timezone":{"type":"string"},"path":{"type":"string"},"enabled":{"type":"boolean"},"userEditable":{"type":"boolean"},"nextRunAt":{"anyOf":[{"type":"string","format":"date-time"},{"type":"null"}]},"lastRunAt":{"anyOf":[{"type":"string","format":"date-time"},{"type":"null"}]},"lastStatus":{"anyOf":[{"type":"string"},{"type":"null"}]}},"required":["id","name","description","cron","timezone","path","enabled","userEditable","nextRunAt","lastRunAt","lastStatus"],"additionalProperties":false}}},"required":["data"],"additionalProperties":false},"AppScheduleRunListDto":{"type":"object","properties":{"data":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string","description":"Run id."},"trigger":{"type":"string","enum":["cron","manual","api"]},"scheduledFor":{"type":"string","format":"date-time"},"startedAt":{"anyOf":[{"type":"string","format":"date-time"},{"type":"null"}]},"finishedAt":{"anyOf":[{"type":"string","format":"date-time"},{"type":"null"}]},"status":{"type":"string","enum":["running","ok","error","timeout","skipped_overlap","skipped_inactive","skipped_budget"],"description":"`skipped_*`: the run did not execute (previous run still going, app paused, or daily run budget used)."},"httpStatus":{"anyOf":[{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991},{"type":"null"}]},"durationMs":{"anyOf":[{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991},{"type":"null"}]},"error":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Redacted, at most 2000 characters."},"deploymentId":{"anyOf":[{"type":"string"},{"type":"null"}]}},"required":["id","trigger","scheduledFor","startedAt","finishedAt","status","httpStatus","durationMs","error","deploymentId"],"additionalProperties":false},"description":"Runs of this schedule, newest first, kept for 30 days."},"hasMore":{"type":"boolean","description":"Another page exists. When `false` you have reached the end — stop requesting pages."},"nextCursor":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Pass verbatim as the next request's `cursor` to fetch the next page. Null exactly when `hasMore` is false."}},"required":["data","hasMore","nextCursor"],"additionalProperties":false},"UpdateAppScheduleDto":{"type":"object","properties":{"enabled":{"description":"Turn the schedule on or off.","type":"boolean"},"cron":{"description":"New 5-field cadence (only when the schedule is `userEditable`). At least 15 minutes between runs.","type":"string","minLength":1,"maxLength":100},"timezone":{"description":"IANA time zone (only when `userEditable`).","type":"string","minLength":1,"maxLength":64}},"additionalProperties":false},"RunScheduleResponseDto":{"type":"object","properties":{"runId":{"type":"string","description":"Id of the run; it appears in the run history."}},"required":["runId"],"additionalProperties":false},"AppErrorListDto":{"type":"object","properties":{"data":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string","format":"uuid"},"occurredAt":{"type":"string","format":"date-time"},"variant":{"type":"string","enum":["published","draft"]},"source":{"type":"string","enum":["http","schedule","tail"]},"requestId":{"anyOf":[{"type":"string"},{"type":"null"}]},"method":{"anyOf":[{"type":"string"},{"type":"null"}]},"path":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Request path without the query string."},"status":{"anyOf":[{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991},{"type":"null"}]},"errorClass":{"anyOf":[{"type":"string"},{"type":"null"}]},"message":{"type":"string","description":"Redacted."},"stack":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Redacted."},"deploymentId":{"anyOf":[{"type":"string","format":"uuid"},{"type":"null"}]}},"required":["id","occurredAt","variant","source","requestId","method","path","status","errorClass","message","stack","deploymentId"],"additionalProperties":false},"description":"Runtime errors, newest first, kept for 7 days."},"hasMore":{"type":"boolean","description":"Another page exists. When `false` you have reached the end — stop requesting pages."},"nextCursor":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Pass verbatim as the next request's `cursor` to fetch the next page. Null exactly when `hasMore` is false."}},"required":["data","hasMore","nextCursor"],"additionalProperties":false}}},"security":[{"bearerAuth":[]}],"x-recipes":[{"id":"start-here","title":"First three calls with a new key","when":"You have a key and nothing else. Confirms the key works, learns which workspace and plan it acts in, and sets the two settings every stakeholder-finding route reads.","spends":"Nothing.","steps":[{"operationId":"whoami","note":"Confirms the key, and returns the workspace, the plan, `canInitiate`, and the lookup limits. A 401 here means the key is wrong; nothing else in this API will work either.","method":"GET","path":"/v1/whoami","summary":"Who this key is: permissions, workspace and limits"},{"operationId":"getWorkspace","note":"Read `stakeholderCriteria` and `solutions`. If both are null, stakeholder search seeds on seniority alone and discovery attaches no people to events, even on a run started with `people: \"add\"`.","method":"GET","path":"/v1/workspace","summary":"Read workspace onboarding assumptions and settings"},{"operationId":"updateWorkspace","note":"Set them, in prose, BEFORE you run discovery — they steer work that starts after they are set, not retroactively.","optional":true,"method":"PATCH","path":"/v1/workspace","summary":"Correct workspace onboarding assumptions and settings"},{"operationId":"listRecipes","note":"Pick the recipe for the task at hand from this list.","optional":true,"method":"GET","path":"/v1/recipes","summary":"The call sequences that make up a task"}]},{"id":"discover-account-events","title":"Run discovery for companies and read their events","when":"You have a list of companies and want events — news, hiring, job changes — matched against signals you define. This is the core loop of the API. Import accounts and create signals once, then save the account IDs and signal keys. To automate later checks, have a scheduler you control call `POST /v1/discoveries` with those saved values on each execution, wait for the run to settle, and read its events. Saving accounts or signals does not schedule a run in an API-only workspace.","spends":"Public REST and MCP usage is recorded without daily usage caps, workspace quota cutoffs or lookup quotas for now. Workspace request pacing still applies. ","steps":[{"operationId":"batchCreateAccounts","note":"One-time setup: save `created[].id` and duplicate `skipped[].existingId` for later runs. Up to 200 per call. `url` must carry a scheme. Supply the bare `linkedinHandle` whenever known: it is the strongest way to identify the company and is tried before the website and name. Every account created here is assigned to the user your key acts as, which is what makes it eligible for discovery.","method":"POST","path":"/v1/accounts/batch","summary":"Batch create accounts"},{"operationId":"createSignal","note":"One-time setup: define what counts as an event, save its key, and reuse that key on later runs instead of creating the same signal again. `news` searches the web. `jobs` and `job_change` search hiring data.","method":"POST","path":"/v1/signals","summary":"Create a signal"},{"operationId":"startDiscovery","note":"Send a new `Idempotency-Key` for each intended run. Reuse that key with the same request body only for retries of that run; a later scheduled execution needs a different key even with the same accounts and signals. Add `people: \"add\"` if you want people attached to the events; the default adds none. The response returns 202 with `status: running`. Poll this run until `settledAt` is set. Then read `blockedSignals` and `error` before reporting results. These outcomes apply to every signal type, including `news`. While a run is active, keep polling the same run. `account_not_ready` means Trayo could not search the account this time. After the run settles, retry the affected account IDs. `company_not_found` means Trayo could not identify the company from the supplied details. For `company_not_found`, check the named accounts before starting another discovery. If an identity is wrong, send the correct `linkedinHandle` with `trayo_update_account` over MCP, or with `PATCH /v1/accounts/{id}` and a workspace API key over REST. When no handle is known, send a corrected website `url` instead. Both need `accounts:write`. `trayo_update_account` also reports whether Trayo can now identify the company. Importing the same hostname again skips the existing account and does not update it. After the current run settles, start a new discovery for the corrected account IDs.","method":"POST","path":"/v1/discoveries","summary":"Start a discovery run"},{"operationId":"getDiscovery","note":"`settledAt` says when to stop polling — the run is searched AND its events are written, and the counts are frozen from then on. `candidatesScreened` (deprecated name `eventsFound`), `candidatesMatched` and `eventsNew` describe this execution; they are not the size of the scoped event page. `error` non-null on a completed run means it did not do everything it was asked. `eventsNew: 0` on a re-run is success: results deduplicate against the workspace. Do not poll on `completedAt` — that is the end of the search, not the end of the run.","until":"`settledAt` is non-null (`status` reads `completed` or `failed` then too). Poll every few seconds with backoff and a finite cap; never a tight loop.","method":"GET","path":"/v1/discoveries/{runId}","summary":"Get a discovery run"},{"operationId":"listEvents","note":"Filter by `discoveryRunId` for everything this run wrote, at any event date, plus the events standing for its accounts, signals and lookback window, including ones earlier runs wrote. This page can be non-empty when `eventsNew` is zero, and once the run settles, paging to the end collects at least `eventsNew` events — one page is capped and need not. Read it before settlement for what has landed so far. Follow `nextCursor` until `hasMore` is false. Keep `discoveryRunId` on every page. For repeated new-event digests, record `checkStartedAt` before each run; after settlement, read each saved `accountId` with `signalKeys` and `discoveredSince` set to the last successful checkpoint instead of reusing an old `discoveryRunId`. Page to the end, deduplicate event IDs, and suppress IDs delivered by earlier successful checks: the timestamp boundary is inclusive, so an event can match two checks. After all reads and digest output succeed, persist the newly delivered IDs and advance the checkpoint to `checkStartedAt` together. If a read or output fails, leave both unchanged. Every event names the signals it matched in `signalKeys` — so run all your signals together and attribute each event afterwards, rather than one run per signal. `signalType` is only the kind of source (`news`, `jobs`, `job_change`) and several signals share one. To go the other way, `?signalKey=` filters the list to one signal. Send `expand=signals` only for the per-match `confidence` and `evidence`; the keys are already there.","method":"GET","path":"/v1/events","summary":"List events"}],"then":"Rank by `scores.timing.score` on each account rather than counting events, and put the people worth acting on in a list (`prospect-to-list`)."},{"id":"lookalike-companies","title":"Find companies like these","when":"You have example companies and want a ranked list of similar companies.","spends":"Nothing. This search is not metered.","steps":[{"operationId":"findLookalikeCompanies","note":"Send {\"companies\":[{\"linkedinUrl\":\"https://www.linkedin.com/company/stripe\"}],\"limit\":100}. Each of the 1–50 seeds can carry companyId for an exact company reference, or linkedinUrl, website and name for matching in that order. companyId accepts a number or numeric string; it takes precedence when supplied and is not a workspace account UUID. The limit is the total number of results wanted, up to 500. One response, no pagination.","method":"POST","path":"/v1/accounts/lookalikes","summary":"Find companies similar to a list of seed companies"}],"then":"Read seeds to check matched identities and any not_found or not_indexed inputs. Reuse companyId from a matched seed or result in a later search. The companies come best match first, each with a preliminary high, medium or low similarity label. filtered counts the seed subsidiaries, repeat listings and companies outside the seeds' employee range that were left out; send matchSize false to allow any size. Results also rank higher when people at your workspace's accounts used to work there; send useWorkspaceAccounts false to rank on the seeds alone. Nothing is saved. To save selected companies, use batchCreateAccounts with name and a website url including https://, in batches of 200. Also send linkedinHandle from linkedinUrl when available; omit rows without a name or usable website."},{"id":"competitor-roster","title":"Rank a company's competitors","when":"You want a short, ranked list of who a company competes with, with the reason for each row.","spends":"Nothing metered. Generation typically takes 10 to 25 seconds; allow 45 seconds for the client timeout. A repeat call with the same pins returns the stored roster at once.","steps":[{"operationId":"generateCompetitorRoster","note":"Send {\"company\":{\"self\":true}} for your own workspace, or {\"company\":{\"website\":\"qodo.ai\"}}. Add pins for competitors you already know, most important first; the first pin is rank 1. cap defaults to 15, maximum 50.","method":"POST","path":"/v1/companies/competitors","summary":"Rank the competitors of one company"}],"then":"Read subject.indexed: false means no similarity data was available for this company, so the roster came from your pins and the companies named while it was generated. Each entry carries source (pool, pin, nomination), rankReason (pinned, incumbent, alignment), the verdict and both alignment scores. unresolvedNominations lists names that matched no company in our data. A repeat call with the same pins and an equal or smaller cap answers from the stored roster with reused: true; send refresh: true to build a new one."},{"id":"prospect-to-list","title":"Find companies or people you do not have, and keep the good ones","when":"You are starting from a description (\"Series B fintechs in Europe\", \"heads of data at logistics companies\") rather than from records you already hold.","spends":"One search against your quota per `POST /v1/find` that RUNS — a search that ran counts whether or not its results were useful, so read the response before sending a second one. Each account you then import draws on the same quota, as on `batchCreateAccounts`.","steps":[{"operationId":"find","note":"`target` plus a natural-language `query`; add `filters` to make any criterion exact. One ranked page of at most 50. Read-only: nothing is written by finding. Before you re-run a disappointing search, read the three fields that say why it was thin. `interpreted` is what Trayo actually read out of your sentence — a criterion missing from `interpreted.filters` was NOT enforced, and resending `interpreted.filters` as `filters` makes the search exact and reproducible. `truncated: true` means more matched than this search can show, so narrow rather than page deeper. `degraded: true` means part of the search failed or timed out, so a thin page may be an outage rather than an absence of matches; `notes` then carries a `search_degraded` entry, which is the only account of what went wrong. Use what came back or refine what you send — do not just spend another search on the same words, because a repeat is billed as a new search and some causes persist for a workspace and degrade every repeat. An unqualified query is the usual cause of a thin page: \"GPU cloud and AI compute providers\" comes back dominated by companies over 27,000 people, because nothing in it says how big; say \"startup\", or send `filters.headcount`, and the same search returns the companies you meant. (`droppedUnaddressable` counts rows removed for having no website at all — a large one means the sentence swept up directories and institutions.) `notes` is the fourth, and the one to open whenever any of the other three says something went wrong: it names a filter whose values were not all scanned to the end, a bare city name that turned out to mean several places, or the degradation `degraded: true` reports. A bare city is `\"dublin\"`, Ireland and Ohio, or `\"newark\"`, New Jersey and California. Pin one as `\"newark|california\"` or `\"dublin||IE\"`. Several values of one filter are a union, so one call with twenty industries returns what twenty single-industry calls return; you do not need to split a search unless `notes` says a value ran out of budget.","method":"POST","path":"/v1/find","summary":"Find companies or people not yet in your workspace"},{"operationId":"batchCreateAccounts","note":"Bring the companies in. Deduplicated on hostname, then on `linkedinHandle`; a repeat is `alreadyAdded`, not an error.","optional":true,"method":"POST","path":"/v1/accounts/batch","summary":"Batch create accounts"},{"operationId":"batchCreatePeople","note":"Bring the people in. A person needs an account to belong to, so create accounts first.","optional":true,"method":"POST","path":"/v1/people/batch","summary":"Batch create people"},{"operationId":"createList","note":"A named working set that outlives this session and shows up in the Trayo app under the user your key acts as.","method":"POST","path":"/v1/lists","summary":"Create a list"},{"operationId":"addListMembers","note":"By `personId` or `accountId`, with `via: \"find\"` recording how they got there. Re-adding a member is a skip, so the same batch is safe to send twice.","method":"POST","path":"/v1/lists/{id}/members","summary":"Add members"}],"then":"Hand the LIST to whatever acts on it — a CRM push, a campaign, a person — rather than your session's memory of it."},{"id":"stakeholders-at-a-company","title":"Find the right people at one company and get their contact details","when":"You know the company and need the people who own or buy what you sell, with an email or phone to reach them.","spends":"One use of your usage quota per company overview and per stakeholder search that returns. One lookup per field started (email, phone), found or not, against the plan's allowance — check `lookups` on `GET /v1/whoami`.","steps":[{"operationId":"researchCompany","note":"A few seconds: what the company does, `whyNow`, and `fit` against what you sell.","optional":true,"method":"POST","path":"/v1/research/company","summary":"A quick overview of a company: what it does, why now, and fit"},{"operationId":"searchStakeholders","note":"Any company by website, or an account of yours. Synchronous, read-only, best first, each with a reason. Omit `definition` to use the workspace's.","method":"POST","path":"/v1/stakeholders/search","summary":"Find the stakeholders at a company that fit a definition"},{"operationId":"batchCreatePeople","note":"Import the ones you want; a person must belong to an account, so create it first if needed.","method":"POST","path":"/v1/people/batch","summary":"Batch create people"},{"operationId":"enrichPerson","note":"Explicit, asynchronous (202), idempotent. Re-sending never double-runs or spends twice; `skipped` says why a field was not started.","method":"POST","path":"/v1/people/{id}/enrich","summary":"Look up an email and/or phone"},{"operationId":"getPersonContact","note":"Free to read. Each field is `in_progress`, then `found` or `not_found`.","until":"No field is `in_progress`. Poll every few seconds with backoff and a finite cap; never a tight loop.","method":"GET","path":"/v1/people/{id}/enrich","summary":"Read the contact lookup state"}]},{"id":"contact-without-importing","title":"One person's email or phone, without adding them to the workspace","when":"You have a name and a LinkedIn profile or a company website, and want contact details for someone who does not need to become a record.","spends":"One lookup per field, against the same allowance as a person-bound lookup.","steps":[{"operationId":"lookupContact","note":"`fields: [\"email\"]` answers in the same response. Ask for `phone` and it answers 202 with a `lookupId`: a phone lookup takes minutes. Include the known employer `company.website` even with a LinkedIn profile: without it, a matching name can produce `match` at the wrong employer. Read `email.identityConfidence` before outreach; a `conflict` also reads `email.status: \"unconfirmed\"`. Hold every `conflict` for human review; the field does not block sending. `match` does not prove mailbox ownership or current employment, and `unknown` is inconclusive.","method":"POST","path":"/v1/contacts/lookup","summary":"Find an email or phone for a person you describe"},{"operationId":"getContactLookup","note":"Collect the phone result. Asking again for the same person reads the stored answer for nothing.","until":"The lookup is no longer in progress. Poll every few seconds with backoff and a finite cap; never a tight loop.","optional":true,"method":"GET","path":"/v1/contacts/lookups/{lookupId}","summary":"Collect a lookup that was still running"}]},{"id":"brief-before-outreach","title":"What to know about a person before writing to them","when":"You are about to reach out and want the angle, the likely challenges, and your own history with them.","spends":"One use of your usage quota per overview or answer returned. A call that fails costs nothing.","steps":[{"operationId":"researchPerson","note":"For someone you have just found and do NOT hold: a fixed overview of ANY person Trayo holds, from their public profile. `grounded: true` adds a web search and takes longer.","optional":true,"method":"POST","path":"/v1/research/person","summary":"A quick overview of a person: career, likely challenges, and angles"},{"operationId":"askPerson","note":"For someone you already hold: YOUR question, answered from the Trayo record plus the profile — the only route that can see what discovery attached, what you sent, and whether they replied. Send `intent` to steer the form of the answer. Capability: people:read includes derived briefing context, including linked account research, signals, outreach history and workspace prose. Answers can include those facts without separate source scopes. The key and its owner's current workspace role must both allow people:read; losing unrelated owner permissions does not block this operation. Check key.effectiveScopes in GET /v1/whoami. Direct account and workspace reads still require accounts:read, and direct event reads events:read.","optional":true,"method":"POST","path":"/v1/people/{id}/ask","summary":"Ask a question about a person"}],"then":"\"Who is this person\" is research; \"did we ever email them, and are they worth a sequence\" is ask. Use one or the other, not both for the same question."},{"id":"exact-prospecting","title":"Companies and people by exact criteria","when":"Your target is a WHERE clause — an industry, a headcount band, a country, a funding stage, a founded year, a title — and you want all available matches, paginated. Same route as `prospect-to-list`. send `filters` instead of (or as well as) `query`.","spends":"Nothing for a filters-only search. One search against your quota per search with a `query`, counted whether or not the results were useful. Each account you then import draws on the same quota.","steps":[{"operationId":"listFindIndustries","note":"Industry is a closed taxonomy. Pick exact values here (`?contains=software`) — an unlisted value matches nothing.","method":"GET","path":"/v1/find/industries","summary":"The industry taxonomy `filters.industries` accepts"},{"operationId":"find","note":"`target: \"companies\"` with `filters`. At least one of industries / hq.cities / hq.states / headcount. Page with `nextCursor`; if `truncated` is true, narrow the filters instead of paging deeper. The same three diagnostics apply here as in `prospect-to-list` — `interpreted`, `truncated`, `degraded` — and on a filters-only search `interpreted` is null and `degraded` always false, because nothing was interpreted and the sentence search did not run.","optional":true,"method":"POST","path":"/v1/find","summary":"Find companies or people not yet in your workspace"},{"operationId":"find","note":"`target: \"people\"` with the same company filters plus `filters.title`. To search inside companies you have already picked, name them instead: `filters.companyWebsites` with the `website` each row carried — the form you have without asking this API for anything. Other company filters narrow only these companies. Without `query`, read `resolvedWebsites` in the answer to see which company each one became before you trust the rows, and `unresolvedWebsites` for the ones left out of the search: `not_found` (no company on the domain) or `uncertain` (several possible companies, listed in `alternatives`; send the right one's `id` as `filters.companyIds`). A `404` only when none resolved. `perCompany` bounds how much one employer contributes. With a `query`, company filters instead check each ranked person's current employer; people whose employer cannot be checked are left out, and `query_page_filtered` explains a short page. That sentence-search page is not refilled.","method":"POST","path":"/v1/find","summary":"Find companies or people not yet in your workspace"},{"operationId":"batchCreateAccounts","note":"Track the companies: each row carries `name` and a ready `url`.","optional":true,"method":"POST","path":"/v1/accounts/batch","summary":"Batch create accounts"},{"operationId":"batchCreatePeople","note":"Import the people you want to work; `linkedinUrl` carries over.","optional":true,"method":"POST","path":"/v1/people/batch","summary":"Batch create people"}],"then":"Contact details as in `contact-without-importing`; a brief as in `brief-before-outreach`."},{"id":"recent-movers","title":"People who just changed company","when":"A champion left a customer, or a competitor's people are moving — you want who moved where in the last 90 days. Or you want everyone who recently started a role, such as a new CISO, at any company.","spends":"Nothing to search. One lookup per contact field you then look up.","steps":[{"operationId":"searchJobChanges","note":"`source` (the company left), `destination` (the company joined), or both. Or, with no company, `title` plus `destinationFilters`. `startedSince` keeps roles started since a month, with or without a company. Up to 25 moves, read-only. A source-only search may read a bounded sample (`sampled: true`), so it is not exhaustive.","method":"POST","path":"/v1/job-changes/search","summary":"Find recent company moves"},{"operationId":"batchCreatePeople","note":"Import the movers you want to work.","optional":true,"method":"POST","path":"/v1/people/batch","summary":"Batch create people"},{"operationId":"enrichPerson","note":"Then contact details, as in `stakeholders-at-a-company`.","optional":true,"method":"POST","path":"/v1/people/{id}/enrich","summary":"Look up an email and/or phone"}]},{"id":"signal-triggered-prospecting","title":"Each run: new companies, their recent signals, a few people each, their emails","when":"Before you write any code, ask the user every question in `ask` and wait for the answers. If you cannot ask, start your reply with your guess for each one, then build. You are building an app or script that, when the user starts it or their own scheduler triggers it, takes a batch of companies the workspace does not hold yet, checks them for signals over a recent window, and returns a few people at each company that fired, with work emails. The chain is find, add companies, discover, read events, search stakeholders, add people, look up emails.","spends":"Nothing for a filters-only find, discovery, events or stakeholder search. A find with a `query` is one search against your quota, counted whether or not its results were useful. Each email looked up is one lookup against `lookups.email` on `GET /v1/whoami`, found or not: 50 companies with 3 people each can draw 150, so read `remaining` first and size the batch to it.","ask":["Trigger: does the user start each check, or will a scheduler they control call the API? Trayo does not schedule discovery for API-only workspaces. Keep the API key on the backend that runs the job.","Destination: where do results go: the app itself, a spreadsheet, or a CRM such as HubSpot?","Batch size: how many companies to CHECK per run? Default to about 50 per run, not a whole market in one call. Only some of them will show the signal, so say so up front rather than promising a number of hits.","Where it is built: build it where you can keep editing and re-running it. Do not hand it off to a hosted app builder unless the user asks; iterating there loses the loop with this API and these recipes.","Brand: use the user's logo and color palette by default. Ask for them, or read them off their website."],"steps":[{"operationId":"whoami","note":"The app needs a workspace API key. The user creates their own on the API keys page of the Trayo web app (any workspace member can, and the key gets at most their own permissions), or reuses the key their MCP connection uses. Never ask the user to paste the key into the conversation: have them put it in a secret file or environment variable the app reads, such as `TRAYO_API_KEY` in `.env`, and keep it on the server side, never in code that runs in the browser. Send it on every call as `Authorization: Bearer <key>`. Call this first, with that key, before any other step. On a missing key or a 401, stop and show a clear error that says how to fix it, such as \"Trayo API key missing or invalid: create one on the API keys page in Trayo and set TRAYO_API_KEY\". Never carry on and render zero results: a count of zero reads as \"nothing found\". Show `workspace.name` in the app so the user sees which workspace it acts in. If an MCP connection is also in use, compare `workspace.id` with the one `trayo_whoami` returns; if they differ, the key and the connection point at different workspaces, so stop and ask the user which workspace is meant. Read `canInitiate`, and `capabilities.emailLookup.available` before you offer emails.","method":"GET","path":"/v1/whoami","summary":"Who this key is: permissions, workspace and limits"},{"operationId":"listSignals","note":"Pick the signal keys this app uses and show their names in the app. If none fits, create one with `createSignal` once, then reuse its key on every run.","method":"GET","path":"/v1/signals","summary":"List signals"},{"operationId":"find","note":"Filters only, so the search is free and pages: `{\"target\":\"companies\",\"filters\":{\"hq\":{\"countries\":[\"US\"]},\"headcount\":{\"min\":1000},\"excludeWorkspace\":true},\"limit\":100}`. For this repeatable batch, pair `hq.countries` with the indexed `headcount` band: country alone checks only a bounded set of the largest companies (`led_by_headcount`). `excludeWorkspace: true` leaves out companies the workspace already holds, so every row is new. A page can be shorter than `limit` with `hasMore: true`; follow `nextCursor` until you hold the batch. The batch is companies CHECKED, not companies that fire: a signal such as an acquisition shows up at a small share of companies, and every company checked stays in the workspace. So cap the companies checked per run and report how many fired; do not loop until a number of companies fire. A `query` search returns one page with no cursor, so it cannot fill a batch of new companies run after run. If `truncated` is true, narrow the filters. Read `interpreted`, `degraded` and `notes` as in `prospect-to-list`.","method":"POST","path":"/v1/find","summary":"Find companies or people not yet in your workspace"},{"operationId":"batchCreateAccounts","note":"`{\"accounts\":[{\"name\",\"url\",\"linkedinHandle\"}]}`, up to 200: `name` and `url` off the row, `linkedinHandle` as the last path segment of `linkedinUrl` when present. Do not post the find row as is; unknown keys are rejected. Account ids are `created[].id`; a `skipped` row with `reasonCode: \"duplicate\"` carries the existing id in `existingId`.","method":"POST","path":"/v1/accounts/batch","summary":"Batch create accounts"},{"operationId":"startDiscovery","note":"`{\"accountIds\":[...],\"signalKeys\":[...],\"lookbackDays\":90,\"people\":\"none\"}`. `people: \"none\"` because this recipe picks the people itself. Up to 500 accounts and 50 signals per run. Send an `Idempotency-Key` derived from a stable identifier for this intended execution and the sorted account ids. Reuse it for HTTP retries, but use a different key for the next scheduled execution, so a double click or a retried script never starts a second run; the same key with a different body is `409 idempotency_key_reused`. Returns 202 with the run `id`.","method":"POST","path":"/v1/discoveries","summary":"Start a discovery run"},{"operationId":"getDiscovery","note":"`settledAt` is the only sign the run is final; do not stop on `status` or `completedAt`. Then read `error` and `blockedSignals`: each entry names a signal and the `accountIds` it could not search. Accounts added minutes ago are often `account_not_ready`; start a second run on those ids once this one settles, with a new `Idempotency-Key`. `company_not_found` needs the company's identity fixed first (`updateAccount` with `linkedinHandle`). Show what is still blocked instead of folding it into a zero. A run takes minutes: an app shows progress, a script waits.","until":"`settledAt` is non-null. Poll every few seconds with backoff and a finite cap; never a tight loop.","method":"GET","path":"/v1/discoveries/{runId}","summary":"Get a discovery run"},{"operationId":"listEvents","note":"`?discoveryRunId=<id>&since=<the window start>`. The run page also carries events earlier runs wrote, and `since` filters on `eventDate`, so it keeps the window you promised. Follow `nextCursor` until `hasMore` is false. Group by `accountId`; `signalKeys` names the signal each event matched. A `job_change` is dated by the month the job started, so one can fall just before `since`; drop `since` to keep every event the run wrote. An empty page on a settled run with no `error` is a real \"no signals in this window\": say exactly that.","method":"GET","path":"/v1/events","summary":"List events"},{"operationId":"searchStakeholders","note":"One call per account that fired: `{\"company\":{\"accountId\":\"...\"},\"limit\":3}`. Omit `definition` to use the workspace's `stakeholderCriteria` (set it first, as in `start-here`). Synchronous and read-only. Run a few at a time within your rate limit.","method":"POST","path":"/v1/stakeholders/search","summary":"Find the stakeholders at a company that fit a definition"},{"operationId":"batchCreatePeople","note":"Project each stakeholder to `{fullName, title, linkedinUrl, accountId}`; the stakeholder row carries extra keys and is rejected as is. Leave out `title` or `linkedinUrl` when it is null: a null is rejected and the row lands in `skipped`. Up to 200 per call. Person ids are `created[].id`, `updated[].id`, or `existingId` on a `skipped` row.","method":"POST","path":"/v1/people/batch","summary":"Batch create people"},{"operationId":"batchEnrichPeople","note":"`{\"personIds\":[...],\"fields\":[\"email\"]}`, up to 200. Answers 200: `accepted[]` says what started per person, and `skipped` and `stoppedBy` say who was not reached and why. Show that in the app instead of an empty email cell. An email already on file costs nothing.","method":"POST","path":"/v1/people/enrich/batch","summary":"Look up emails and phones for many people"},{"operationId":"getPersonContact","note":"Per person. `email.value` is set once `email.lookup.state` is `found`. `not_found` ends this poll and can be tried again after `retryAvailableAt`; `error` can be tried again now.","until":"No `email.lookup.state` is `in_progress`. Poll every few seconds with backoff and a finite cap; never a tight loop.","method":"GET","path":"/v1/people/{id}/enrich","summary":"Read the contact lookup state"}],"then":"Show one row per person: company, the event behind it (`title`, `eventDate`, `url`), name, title, email. The next run needs no bookkeeping: these companies are now in the workspace, so `excludeWorkspace` leaves them out. Put the people on a list (`prospect-to-list`) if someone else will act on them."},{"id":"buying-committee-for-a-company","title":"Map the buying committee at one company","when":"Before you write any code, ask the user every question in `ask` and wait for the answers. If you cannot ask, start your reply with your guess for each one, then build. You are building an app where someone types a company and gets the people who would buy, champion or evaluate what the workspace sells, each with a reason, and optionally their emails. Works for any company, whether the workspace holds it or not.","spends":"Nothing to research or search. One lookup per email started, found or not, against `lookups.email` on `GET /v1/whoami`.","ask":["Trigger: does the user start each check, or will a scheduler they control call the API? Trayo does not schedule discovery for API-only workspaces. Keep the API key on the backend that runs the job.","Destination: where do results go: the app itself, a spreadsheet, or a CRM such as HubSpot?","Batch size: how many companies to CHECK per run? Default to about 50 per run, not a whole market in one call. Only some of them will show the signal, so say so up front rather than promising a number of hits.","Where it is built: build it where you can keep editing and re-running it. Do not hand it off to a hosted app builder unless the user asks; iterating there loses the loop with this API and these recipes.","Brand: use the user's logo and color palette by default. Ask for them, or read them off their website."],"steps":[{"operationId":"whoami","note":"The app needs a workspace API key. The user creates their own on the API keys page of the Trayo web app (any workspace member can, and the key gets at most their own permissions), or reuses the key their MCP connection uses. Never ask the user to paste the key into the conversation: have them put it in a secret file or environment variable the app reads, such as `TRAYO_API_KEY` in `.env`, and keep it on the server side, never in code that runs in the browser. Send it on every call as `Authorization: Bearer <key>`. Call this first, with that key, before any other step. On a missing key or a 401, stop and show a clear error that says how to fix it, such as \"Trayo API key missing or invalid: create one on the API keys page in Trayo and set TRAYO_API_KEY\". Never carry on and render zero results: a count of zero reads as \"nothing found\". Show `workspace.name` in the app so the user sees which workspace it acts in. If an MCP connection is also in use, compare `workspace.id` with the one `trayo_whoami` returns; if they differ, the key and the connection point at different workspaces, so stop and ask the user which workspace is meant. Read `canInitiate`, and `capabilities.emailLookup.available` before you offer emails.","method":"GET","path":"/v1/whoami","summary":"Who this key is: permissions, workspace and limits"},{"operationId":"getWorkspace","note":"Read `stakeholderPersonas` (`title`, `seniority`, `buyingRole`) and `stakeholderCriteria`: together they are the committee, so use the personas as the groups the app shows. If both are empty, ask the user to set them with `updateWorkspace`; without them the search ranks on seniority alone.","method":"GET","path":"/v1/workspace","summary":"Read workspace onboarding assumptions and settings"},{"operationId":"researchCompany","note":"`{\"company\":{\"website\":\"acme.com\"}}`. Shows who the company is (`displayName`, `oneLiner`, `employeeCount`) so the user can confirm it is the one they meant. A few seconds.","optional":true,"method":"POST","path":"/v1/research/company","summary":"A quick overview of a company: what it does, why now, and fit"},{"operationId":"searchStakeholders","note":"`{\"company\":{\"website\":\"acme.com\"},\"limit\":10}`, or `{\"company\":{\"accountId\":\"...\"}}` for an account you hold. Omit `definition` to search with the workspace's criteria, or send one persona as `definition` per call to fill each role separately. Check the returned `company` before you trust the people. Show each person's `whyThisPerson`. Nothing is saved.","method":"POST","path":"/v1/stakeholders/search","summary":"Find the stakeholders at a company that fit a definition"},{"operationId":"batchCreateAccounts","note":"Only when the user keeps people, the returned `company.accountId` is null, and you want the account id first. Send `{name, url}` from the resolved company; a duplicate returns `existingId`. Otherwise skip this step and send `company: {name, domain}` on each person below.","optional":true,"method":"POST","path":"/v1/accounts/batch","summary":"Batch create accounts"},{"operationId":"batchCreatePeople","note":"The people the user keeps, projected to `{fullName, title, linkedinUrl}` plus `accountId` or `company: {name, domain}`. Leave out `title` or `linkedinUrl` when it is null.","optional":true,"method":"POST","path":"/v1/people/batch","summary":"Batch create people"},{"operationId":"batchEnrichPeople","note":"Emails, as in `signal-triggered-prospecting`: `{\"personIds\":[...],\"fields\":[\"email\"]}`.","optional":true,"method":"POST","path":"/v1/people/enrich/batch","summary":"Look up emails and phones for many people"},{"operationId":"getPersonContact","note":"Per person, until the email lookup is no longer `in_progress`.","until":"No `email.lookup.state` is `in_progress`. Poll every few seconds with backoff and a finite cap; never a tight loop.","optional":true,"method":"GET","path":"/v1/people/{id}/enrich","summary":"Read the contact lookup state"}],"then":"Nothing is saved before the user keeps someone, so the app can map as many companies as it likes and write only the committees worth working."}]}