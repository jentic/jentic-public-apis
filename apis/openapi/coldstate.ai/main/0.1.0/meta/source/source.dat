{"openapi":"3.1.0","info":{"title":"ColdState API","version":"0.1.0","summary":"Deterministic Knowledge Infrastructure for AI agents","description":"Deterministic, verifiable knowledge retrieval. Global knowledge base (48M entries, 35 domains) with fetch / cite / verify primitives, plus zero-knowledge custom indexes. Identical query + kb_snapshot ⇒ identical results. Also exposed as an MCP server at /mcp (Streamable HTTP, stateless).","termsOfService":"https://services.coldstate.ai/terms","contact":{"name":"ColdState","url":"https://services.coldstate.ai","email":"daniel@coldstate.ai"}},"externalDocs":{"description":"Human-readable API reference","url":"https://services.coldstate.ai/docs"},"servers":[{"url":"https://cold-api.coldstate.ai"}],"security":[{"bearerAuth":[]}],"tags":[{"name":"Knowledge","description":"Global knowledge base: search, fetch, cite, verify, related, resolve"},{"name":"Indexes","description":"Zero-knowledge custom indexes"},{"name":"Search","description":"Search custom indexes"},{"name":"Auth","description":"Accounts, sessions, API keys"},{"name":"Usage","description":"Metering"},{"name":"Billing","description":"Stripe subscription management"},{"name":"MCP","description":"Model Context Protocol endpoint"},{"name":"Meta","description":"Health and discovery"}],"paths":{"/health":{"get":{"tags":["Meta"],"security":[],"summary":"Liveness","responses":{"200":{"description":"OK"}}}},"/ready":{"get":{"tags":["Meta"],"security":[],"summary":"Readiness (db, redis, tokenizer)","responses":{"200":{"description":"OK"}}}},"/openapi.json":{"get":{"tags":["Meta"],"security":[],"summary":"This document","responses":{"200":{"description":"OK"}}}},"/llms.txt":{"get":{"tags":["Meta"],"security":[],"summary":"llms.txt index","responses":{"200":{"description":"text/markdown"}}}},"/.well-known/mcp/server.json":{"get":{"tags":["Meta"],"security":[],"summary":"MCP registry server.json","responses":{"200":{"description":"OK"}}}},"/mcp":{"post":{"tags":["MCP"],"summary":"MCP Streamable HTTP endpoint (JSON-RPC 2.0)","description":"Stateless Model Context Protocol server. Send `Accept: application/json, text/event-stream`. `initialize` and `tools/list` need no key; `tools/call` forwards your bearer key to the corresponding /v1 route so auth, limits and metering are per customer.","responses":{"200":{"description":"JSON-RPC response (JSON or SSE)"},"401":{"description":"Tool call without a valid API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/search/global":{"post":{"tags":["Knowledge"],"summary":"Search the global knowledge base","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/GlobalSearchRequest"}}}},"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/GlobalSearchResponse"}}}},"400":{"description":"Validation error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate or quota limit exceeded","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/search/domains":{"get":{"tags":["Knowledge"],"summary":"List knowledge domains with counts","responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DomainsResponse"}}}},"401":{"description":"Missing or invalid API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate or quota limit exceeded","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/knowledge/fetch":{"get":{"tags":["Knowledge"],"summary":"Fetch an entry verbatim by stable id","parameters":[{"name":"id","in":"query","required":true,"description":"Stable entry id, e.g. eng_000229f438f7cebd","schema":{"type":"string"}}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Entry"}}}},"401":{"description":"Missing or invalid API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Unknown id","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate or quota limit exceeded","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/knowledge/cite":{"get":{"tags":["Knowledge"],"summary":"Canonical citation for an entry","parameters":[{"name":"id","in":"query","required":true,"description":"Stable entry id","schema":{"type":"string"}}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Citation"}}}},"401":{"description":"Missing or invalid API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Unknown id","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate or quota limit exceeded","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/knowledge/verify":{"post":{"tags":["Knowledge"],"summary":"Verify a cited fact is unchanged","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/VerifyRequest"}}}},"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/VerifyResponse"}}}},"400":{"description":"Validation error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate or quota limit exceeded","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/knowledge/snapshot":{"get":{"tags":["Knowledge"],"summary":"Current knowledge-base snapshot","responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Snapshot"}}}},"401":{"description":"Missing or invalid API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate or quota limit exceeded","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/knowledge/related":{"get":{"tags":["Knowledge"],"summary":"Related entries via the concept-cluster graph","parameters":[{"name":"id","in":"query","required":true,"description":"Stable entry id","schema":{"type":"string"}},{"name":"limit","in":"query","required":false,"description":"1–50, default 10","schema":{"type":"integer","minimum":1,"maximum":50}}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RelatedResponse"}}}},"401":{"description":"Missing or invalid API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Unknown id","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate or quota limit exceeded","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/knowledge/resolve":{"get":{"tags":["Knowledge"],"summary":"Resolve a name/alias to a canonical entry","parameters":[{"name":"query","in":"query","required":true,"description":"Surface form to resolve (≤500 chars)","schema":{"type":"string"}},{"name":"limit","in":"query","required":false,"description":"Max alternatives, 1–5","schema":{"type":"integer","minimum":1,"maximum":5}}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ResolveResponse"}}}},"400":{"description":"Validation error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate or quota limit exceeded","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/knowledge/batch":{"post":{"tags":["Knowledge"],"summary":"Several queries against one snapshot","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/BatchRequest"}}}},"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/BatchResponse"}}}},"400":{"description":"Validation error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate or quota limit exceeded","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/knowledge/stats":{"get":{"tags":["Knowledge"],"summary":"Query coverage stats, or global KB stats","parameters":[{"name":"query","in":"query","required":false,"description":"Optional query","schema":{"type":"string"}},{"name":"domain","in":"query","required":false,"description":"Optional domain filter","schema":{"type":"string"}}],"responses":{"200":{"description":"OK"},"401":{"description":"Missing or invalid API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate or quota limit exceeded","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/knowledge/capabilities":{"get":{"tags":["Knowledge"],"summary":"Machine-readable service manifest","responses":{"200":{"description":"OK"},"401":{"description":"Missing or invalid API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate or quota limit exceeded","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/knowledge/isomorph":{"get":{"tags":["Knowledge"],"summary":"Cross-domain structural analog of an entry","parameters":[{"name":"id","in":"query","required":true,"description":"Stable entry id","schema":{"type":"string"}},{"name":"limit","in":"query","required":false,"description":"1–35, default 8","schema":{"type":"integer","minimum":1,"maximum":35}}],"responses":{"200":{"description":"OK"},"401":{"description":"Missing or invalid API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Unknown id or no analog available","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate or quota limit exceeded","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/indexes":{"get":{"tags":["Indexes"],"summary":"List your indexes","responses":{"200":{"description":"OK"},"401":{"description":"Missing or invalid API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate or quota limit exceeded","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}},"post":{"tags":["Indexes"],"summary":"Create an index (async build)","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateIndexRequest"}}}},"responses":{"202":{"description":"Queued; poll GET /v1/indexes/{index_id}"},"400":{"description":"Validation error or plan limit","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate or quota limit exceeded","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/indexes/{index_id}":{"get":{"tags":["Indexes"],"summary":"Index detail and status","parameters":[{"name":"index_id","in":"path","required":true,"description":"idx_…","schema":{"type":"string"}}],"responses":{"200":{"description":"OK"},"401":{"description":"Missing or invalid API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Not your index","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate or quota limit exceeded","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}},"delete":{"tags":["Indexes"],"summary":"Delete an index","parameters":[{"name":"index_id","in":"path","required":true,"description":"idx_…","schema":{"type":"string"}}],"responses":{"200":{"description":"Deleted"},"401":{"description":"Missing or invalid API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Not your index","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate or quota limit exceeded","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/indexes/{index_id}/documents":{"get":{"tags":["Indexes"],"summary":"Browse documents (ref ids + metrics only)","parameters":[{"name":"index_id","in":"path","required":true,"description":"idx_…","schema":{"type":"string"}},{"name":"limit","in":"query","required":false,"description":"1–100","schema":{"type":"integer"}},{"name":"offset","in":"query","required":false,"description":"≥0","schema":{"type":"integer"}}],"responses":{"200":{"description":"OK"},"400":{"description":"Index not ready","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate or quota limit exceeded","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/indexes/{index_id}/download":{"get":{"tags":["Indexes"],"summary":"Download an IaaS index file (single use, 24h TTL)","parameters":[{"name":"index_id","in":"path","required":true,"description":"idx_…","schema":{"type":"string"}}],"responses":{"200":{"description":"application/x-sqlite3"},"400":{"description":"Not an IaaS index / expired","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate or quota limit exceeded","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/indexes/{index_id}/search":{"post":{"tags":["Search"],"summary":"Search a custom index","parameters":[{"name":"index_id","in":"path","required":true,"description":"idx_…","schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/IndexSearchRequest"}}}},"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/IndexSearchResponse"}}}},"400":{"description":"Validation error or index not ready","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Not your index","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate or quota limit exceeded","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/indexes/{index_id}/explain"