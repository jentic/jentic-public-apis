":{"type":"integer"},"REACTIVE":{"type":"integer"},"DECOHERENT":{"type":"integer"}}},"Pagination":{"type":"object","properties":{"offset":{"type":"integer"},"limit":{"type":"integer"},"total":{"type":"integer"},"has_more":{"type":"boolean"}}},"KnowledgeResult":{"type":"object","properties":{"id":{"type":"string","description":"Stable entry id"},"title":{"type":"string"},"snippet":{"type":"string"},"metadata":{"type":"object","properties":{"domain":{"type":"string"},"source":{"type":"string"}}},"score":{"$ref":"#/components/schemas/Score"},"state":{"$ref":"#/components/schemas/State"}}},"GlobalSearchRequest":{"type":"object","required":["query"],"properties":{"query":{"type":"string","maxLength":2000},"domain":{"type":"string","description":"Optional domain filter, e.g. MEDICINE (case-insensitive)"},"limit":{"type":"integer","minimum":1,"maximum":100,"default":10},"offset":{"type":"integer","minimum":0,"default":0}}},"GlobalSearchResponse":{"type":"object","properties":{"source":{"type":"string","const":"global"},"domain":{"type":["string","null"]},"query":{"type":"string"},"kb_snapshot":{"type":["string","null"],"description":"Pin this to reproduce results later"},"results":{"type":"array","items":{"$ref":"#/components/schemas/KnowledgeResult"}},"diagnostics":{"type":"object","properties":{"execution_time_ms":{"type":"number"},"results_count":{"type":"integer"},"state_distribution":{"$ref":"#/components/schemas/StateDistribution"}}},"pagination":{"$ref":"#/components/schemas/Pagination"}}},"DomainsResponse":{"type":"object","properties":{"domains":{"type":"array","items":{"type":"object","properties":{"name":{"type":"string"},"count":{"type":"integer"}}}}}},"Entry":{"allOf":[{"$ref":"#/components/schemas/KnowledgeResult"},{"type":"object","properties":{"content":{"type":"string"},"content_hash":{"type":"string","description":"sha256 of content"},"kb_snapshot":{"type":["string","null"]},"created_at":{"type":"string"}}}]},"Citation":{"type":"object","properties":{"id"