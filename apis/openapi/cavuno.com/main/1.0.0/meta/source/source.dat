deleted","deleted_at","slug","company_id"],"description":"V1 Job delete tombstone. Minimum identity to drop a downstream copy without re-fetching.","example":{"id":"jobs_01EXAMPLEJOB","object":"job","revision":3,"deleted":true,"deleted_at":"2026-07-24T14:00:00Z","slug":"senior-engineer","company_id":"companies_01EXAMPLE"}},"WebhookJobChangedField":{"type":"string","enum":["slug","title","status","company_id","company_name","location","description","url","employment_type","workplace_type","published_at","expires_at"],"description":"A single closed Job changed_fields vocabulary member.","example":"title"},"WebhookJobCreatedEvent":{"type":"object","properties":{"id":{"type":"string","description":"Stable public event id (evt_…)."},"object":{"type":"string","enum":["event"]},"type":{"type":"string","enum":["job.created"]},"schema_version":{"type":"string","enum":["1"]},"occurred_at":{"type":"string","description":"ISO-8601 UTC timestamp with second precision (…Z)."},"board_id":{"type":"string","description":"Board account id that owns the event."},"data":{"type":"object","properties":{"object":{"type":"object","properties":{"id":{"type":"string"},"object":{"type":"string","enum":["job"]},"slug":{"type":"string","nullable":true},"title":{"type":"string"},"status":{"type":"string"},"company_id":{"type":"string","nullable":true},"company_name":{"type":"string","nullable":true},"location":{"type":"string","nullable":true},"description":{"type":"string","nullable":true},"url":{"type":"string","nullable":true,"format":"uri"},"employment_type":{"type":"string","nullable":true},"workplace_type":{"type":"string","nullable":true},"published_at":{"type":"string","nullable":true,"description":"ISO-8601 UTC timestamp with second precision (…Z)."},"expires_at":{"type":"string","nullable":true,"description":"ISO-8601 UTC timestamp with second precision (…Z)."},"updated_at":{"type":"string","nullable":true,"description":"ISO-8601 UTC timestamp with second precision (…Z)."},"revision":{