":"<p>Build the next generation of robotics platforms.</p>","url":"https://example-board.cavuno.com/companies/acme/jobs/senior-engineer","employment_type":"full_time","workplace_type":"remote","published_at":"2026-07-24T12:00:00Z","expires_at":"2026-08-23T12:00:00Z","updated_at":"2026-07-24T13:00:00Z","revision":2},"changed_fields":["title"]}}},"WebhookJobDeletedEvent":{"type":"object","properties":{"id":{"type":"string","description":"Stable public event id (evt_…)."},"object":{"type":"string","enum":["event"]},"type":{"type":"string","enum":["job.deleted"]},"schema_version":{"type":"string","enum":["1"]},"occurred_at":{"type":"string","description":"ISO-8601 UTC timestamp with second precision (…Z)."},"board_id":{"type":"string","description":"Board account id that owns the event."},"data":{"type":"object","properties":{"object":{"type":"object","properties":{"id":{"type":"string"},"object":{"type":"string","enum":["job"]},"revision":{"type":"integer","minimum":0,"exclusiveMinimum":true},"deleted":{"type":"boolean","enum":[true]},"deleted_at":{"type":"string","description":"ISO-8601 UTC timestamp with second precision (…Z)."},"slug":{"type":"string","nullable":true},"company_id":{"type":"string","nullable":true}},"required":["id","object","revision","deleted","deleted_at","slug","company_id"],"description":"V1 Job delete tombstone. Minimum identity to drop a downstream copy without re-fetching."},"changed_fields":{"type":"array","items":{"type":"string"},"maxItems":0,"description":"Empty for create/delete events."}},"required":["object","changed_fields"]}},"required":["id","object","type","schema_version","occurred_at","board_id","data"],"example":{"id":"evt_01EXAMPLEJOBDELETED","object":"event","type":"job.deleted","schema_version":"1","occurred_at":"2026-07-24T14:00:00Z","board_id":"acc_01EXAMPLEBOARD","data":{"object":{"id":"jobs_01EXAMPLEJOB","object":"job","revision":3,"deleted":true,"deleted_at":"2026-07-24T14:00:00Z","slug":"senior-engineer","company_id":"c