      "post": {
        "tags": [
          "Request Secure Upload URLs"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "clientID": {
                      "type": "string"
                    },
                    "jobID": {
                      "type": "string",
                      "example": "00085"
                    },
                    "uploadUrls": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "s3Location": {
                            "type": "string",
                            "example": "2mw.highschool.teams/coach-at-university.com/00085/clips/Uni-A-vs-Uni-B-Play-008.mp4"
                          },
                          "filename": {
                            "type": "string",
                            "example": "Uni-A-vs-Uni-B-Play-008.mp4"
                          },
                          "uploadUrl": {
                            "type": "string",
                            "example": "https://s3.amazonaws.com/2mw.highschool.teams/coach-at-university.com/00085/clips/Uni-A-vs-Uni-B-Play-008.mp4?X-Amz-Algorithm=AWS4-HMAC-SHA256&X-Amz-Credential=AKIAJ2Z"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
