{
  "openapi": "3.0.3",
  "info": {
    "title": "2 Minute Warning Third Party API",
    "description": "2MW Job Submission API for Third Party Access\n",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/2minutewarning/ThirdParty/1.0.0"
  },
  "servers": [
    {
      "description": "Pre Production Environment",
      "url": "https://apis-ppe.2minutewarning.com/v1/"
    },
    {
      "description": "Production Environment",
      "url": "https://apis.2minutewarning.com/v1/"
    }
  ],
  "tags": [
    {
      "name": "Authentication",
      "description": "Endpoints for fetching auth id token."
    },
    {
      "name": "Submit Job",
      "description": "Submit a job for processing by 2MW servers."
    },
    {
      "name": "Request Secure Upload URLs",
      "description": "Request secure upload URLs for uploading video clips to 2MW servers."
    },
    {
      "name": "Get Jobs Status",
      "description": "Get current status of all jobs."
    },
    {
      "name": "Get Job Status",
      "description": "Get the current status of a jobID."
    },
    {
      "name": "Get Cutups Results",
      "description": "Get the results by cutupIDs."
    },
    {
      "name": "Get Cutup Result by CutupID",
      "description": "Get cutup result by cutupID."
    },
    {
      "name": "Get Cutup CSV Data by CutupID",
      "description": "Get CSV Data for a Cutup using the CutupID."
    },
    {
      "name": "Update Cutup CSV Data by CutupID",
      "description": "Update CSV Data for a Cutup using the CutupID."
    },
    {
      "name": "Get Plays Results",
      "description": "Get the results by playID."
    },
    {
      "name": "Get Plays Results in Bulk",
      "description": "Get Plays Results in Bulk."
    },
    {
      "name": "Get CSV Data Result of Play",
      "description": "Get the CSV data result by playID."
    },
    {
      "name": "Get ScoutCards Results of Play",
      "description": "Get the .vsdx or .pptx scoutcards results by playID."
    },
    {
      "name": "Get Tracking Data Result of Play",
      "description": "Get the csv or json tracking data result by playID."
    },
    {
      "name": "Get CSV Configuration",
      "description": "Get CSV Configuration"
    },
    {
      "name": "Submit Feedback",
      "description": "Submit feedback to 2 Minute Warning"
    }
  ],
  "paths": {
    "/login": {
      "options": {
        "summary": "CORS support",
        "description": "Enable CORS by returning correct headers",
        "responses": {
          "200": {
            "description": "Default response for CORS method",
            "headers": {
              "Access-Control-Allow-Origin": {
                "schema": {
                  "type": "string"
                }
              },
              "Access-Control-Allow-Methods": {
                "schema": {
                  "type": "string"
                }
              },
              "Access-Control-Allow-Headers": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {}
          }
        },
        "x-amazon-apigateway-integration": {
          "type": "mock",
          "requestTemplates": {
            "application/json": "{\n  \"statusCode\" : 200\n}\n"
          },
          "responses": {
            "default": {
              "statusCode": "200",
              "responseParameters": {
                "method.response.header.Access-Control-Allow-Headers": "'Content-Type,X-Amz-Date,Authorization,x-api-key,x-user-token'",
                "method.response.header.Access-Control-Allow-Methods": "'*'",
                "method.response.header.Access-Control-Allow-Origin": "'*'"
              },
              "responseTemplates": {
                "application/json": "{}\n"
              }
            }
          }
        },
        "tags": [
          "Authentication"
        ]
      },
      "post": {
        "tags": [
          "Authentication"
        ],
        "responses": {
          "200": {
            "description": "OK - Keep the <code>idToken</code> and <code>refreshToken</code> for subsequent calls.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "SUCCESS"
                      ],
                      "example": "SUCCESS"
                    },
                    "message": {
                      "type": "string",
                      "enum": [
                        "Successfully logged in."
                      ],
                      "example": "Successfully logged in."
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "refreshToken": {
                          "type": "string",
                          "example": "eyJraWQiOiJSVVdxd3l..."
                        },
                        "idToken": {
                          "type": "string",
                          "example": "eyJraWQiOiJSVVdxd3l..."
                        },
                        "accessToken": {
                          "type": "string",
                          "example": "eyJraWQiOiJSVVdxd3l..."
                        },
                        "identityId": {
                          "type": "string",
                          "example": "us-east-2:8ca2e25e-8715-4d2f-8a4d-28208a68b427"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not found"
          },
          "500": {
            "description": "Server Error"
          },
          "503": {
            "description": "Service Unavailable"
          }
        },
        "x-amazon-apigateway-integration": {
          "type": "aws_proxy",
          "passthroughBehavior": "never",
          "httpMethod": "POST",
          "connectionType": "INTERNET",
          "contentHandling": "CONVERT_TO_TEXT",
          "uri": {
            "Fn::Sub": "arn:aws:apigateway:${AWS::Region}:lambda:path/2015-03-31/functions/${login.Arn}/invocations"
          }
        },
        "x-amazon-apigateway-request-validator": "all",
        "security": [],
        "summary": "Get id token with email and password",
        "description": "Receive the id token for subsequent calls to other endpoints by authenticating\n        with email and password.<br>\n        Keep the <code>idToken</code> and <code>refreshToken</code> from the response for subsequent\n          calls to other endpoints.",
        "parameters": [
          {
            "name": "x-api-key",
            "description": "API Key provided to you by 2 Minute Warning. The API Key is used to identify \n    the Third Party client making the request. Please keep this key secure.<br><br>\n    <strong>Note: </strong>Make sure that the key <code>x-api-key</code> are all small caps.",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9]+$",
              "minLength": 3,
              "maxLength": 256,
              "example": "1234567890abcdef"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "coach@myuniversity.com"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 256,
                    "pattern": "^[a-zA-Z0-9!@#$%^&*()-_+=~`[\\]{}|:;''<>,.?\\/]*$",
                    "example": "MyPasword123!"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/refreshToken": {
      "options": {
        "summary": "CORS support",
        "description": "Enable CORS by returning correct headers",
        "responses": {
          "200": {
            "description": "Default response for CORS method",
            "headers": {
              "Access-Control-Allow-Origin": {
                "schema": {
                  "type": "string"
                }
              },
              "Access-Control-Allow-Methods": {
                "schema": {
                  "type": "string"
                }
              },
              "Access-Control-Allow-Headers": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {}
          }
        },
        "x-amazon-apigateway-integration": {
          "type": "mock",
          "requestTemplates": {
            "application/json": "{\n  \"statusCode\" : 200\n}\n"
          },
          "responses": {
            "default": {
              "statusCode": "200",
              "responseParameters": {
                "method.response.header.Access-Control-Allow-Headers": "'Content-Type,X-Amz-Date,Authorization,x-api-key,x-user-token'",
                "method.response.header.Access-Control-Allow-Methods": "'*'",
                "method.response.header.Access-Control-Allow-Origin": "'*'"
              },
              "responseTemplates": {
                "application/json": "{}\n"
              }
            }
          }
        },
        "tags": [
          "Authentication"
        ]
      },
      "post": {
        "tags": [
          "Authentication"
        ],
        "responses": {
          "200": {
            "description": "OK - Keep the <code>idToken</code> and <code>refreshToken</code> for subsequent calls.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "SUCCESS"
                      ],
                      "example": "SUCCESS"
                    },
                    "message": {
                      "type": "string",
                      "enum": [
                        "Successfully refreshed token."
                      ],
                      "example": "Successfully refreshed token."
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "idToken": {
                          "type": "string",
                          "example": "eyJraWQiOiJSVVdxd3l..."
                        },
                        "accessToken": {
                          "type": "string",
                          "example": "eyJraWQiOiJSVVdxd3l..."
                        },
                        "identityId": {
                          "type": "string",
                          "example": "us-east-2:8ca2e25e-8715-4d2f-8a4d-28208a68b427"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not found"
          },
          "500": {
            "description": "Server Error"
          },
          "503": {
            "description": "Service Unavailable"
          }
        },
        "x-amazon-apigateway-integration": {
          "type": "aws_proxy",
          "passthroughBehavior": "never",
          "httpMethod": "POST",
          "connectionType": "INTERNET",
          "contentHandling": "CONVERT_TO_TEXT",
          "uri": {
            "Fn::Sub": "arn:aws:apigateway:${AWS::Region}:lambda:path/2015-03-31/functions/${refreshToken.Arn}/invocations"
          }
        },
        "x-amazon-apigateway-request-validator": "all",
        "security": [],
        "summary": "Refresh your id token if already expired",
        "description": "The <code>idToken</code> returned by the <code>/login</code>\n        endpoint expires after a certain amount of time if not used. To fetch a new <code>idToken</code>,\n        make a request to this endpoint using the <code>refreshToken</code> returned by the <code>/login</code>\n        endpoint.<br>\n        Keep the <code>idToken</code> and <code>refreshToken</code> from the response for subsequent\n          calls to other endpoints.",
        "parameters": [
          {
            "name": "x-api-key",
            "description": "API Key provided to you by 2 Minute Warning. The API Key is used to identify \n    the Third Party client making the request. Please keep this key secure.<br><br>\n    <strong>Note: </strong>Make sure that the key <code>x-api-key</code> are all small caps.",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9]+$",
              "minLength": 3,
              "maxLength": 256,
              "example": "1234567890abcdef"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "refreshToken"
                ],
                "properties": {
                  "refreshToken": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9-_.]+$",
                    "minLength": 3,
                    "maxLength": 4096,
                    "example": "eyJhbGciOiJIUzI1..."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/jobs": {
      "options": {
        "summary": "CORS support",
        "description": "Enable CORS by returning correct headers",
        "responses": {
          "200": {
            "description": "Default response for CORS method",
            "headers": {
              "Access-Control-Allow-Origin": {
                "schema": {
                  "type": "string"
                }
              },
              "Access-Control-Allow-Methods": {
                "schema": {
                  "type": "string"
                }
              },
              "Access-Control-Allow-Headers": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {}
          }
        },
        "x-amazon-apigateway-integration": {
          "type": "mock",
          "requestTemplates": {
            "application/json": "{\n  \"statusCode\" : 200\n}\n"
          },
          "responses": {
            "default": {
              "statusCode": "200",
              "responseParameters": {
                "method.response.header.Access-Control-Allow-Headers": "'Content-Type,X-Amz-Date,Authorization,x-api-key,x-user-token'",
                "method.response.header.Access-Control-Allow-Methods": "'*'",
                "method.response.header.Access-Control-Allow-Origin": "'*'"
              },
              "responseTemplates": {
                "application/json": "{}\n"
              }
            }
          }
        },
        "tags": [
          "Submit Job",
          "Get Jobs Status"
        ]
      },
      "post": {
        "tags": [
          "Submit Job"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "clientID": {
                      "type": "string"
                    },
                    "jobID": {
                      "type": "string"
                    },
                    "startTime": {
                      "type": "string"
                    },
                    "callbackURL": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not found"
          },
          "500": {
            "description": "Server Error"
          },
          "503": {
            "description": "Service Unavailable"
          }
        },
        "x-amazon-apigateway-integration": {
          "type": "aws_proxy",
          "credentials": {
            "Fn::Sub": "${ApiRole.Arn}"
          },
          "uri": {
            "Fn::Sub": "arn:aws:apigateway:${AWS::Region}:lambda:path/2015-03-31/functions/${submitJob.Arn}/invocations"
          },
          "passthroughBehavior": "never",
          "httpMethod": "POST",
          "connectionType": "INTERNET",
          "contentHandling": "CONVERT_TO_TEXT"
        },
        "x-amazon-apigateway-request-validator": "all",
        "security": [
          {
            "DdamenLambdaAuthorizer": []
          }
        ],
        "summary": "Submit a new job for AI Analysis",
        "description": "<style>\n    /* This is for local purposes only. Swagger removes these styles on the Web UI. */\n    code {\n        color: #9012fe;\n        font-weight: bold;\n        font-family: monospace;\n    }\n</style>\n\n<h3>Introduction and Definitions</h3>\n\n<p>This endpoint allows you to submit <code>jobs</code> to 2MW for AI analysis.</p>\n\n<p>Each <code>job</code> contains one\n    or more <code>cutups</code>.</p>\n\n<p> A <code>cutup</code> is a group of individual <code>plays</code>. It can have a single <code>play</code>, or multiple\n    <code>plays</code> that are from the same game\n    or from different games.</p>\n\n<p>A <code>play</code> is a video clip that shows a single football\n    play, beginning at the pre-motion formation up to the end of play. We currently require a sideline view of\n    the video but we are currently working for support on endzone views.</p>\n\n<p>The video clip of the <code>play</code> can come from a pre-cut video file, or it can come from a monolithic video file\n    containing multiple <code>plays</code> stitched together. The request body described below\n    allows for both sources.</p>\n\n<h3>Required Data</h3>\n\n<p>To submit a job for AI analysis, there are a couple of things you need to prepare:</p>\n\n<ul>\n    <li>\n        <h5>URL Links to Video Files</h5>\n        <p>The video can be a short clips of individual <code>plays</code>, or a monolithic video\n        file that contains a different <code>plays</code> stitched together from either the same game or\n        different games. Simply provide the URL Links to these video clips.</p>\n    </li>\n    <li>\n    <h5>Start Frames and Duration of Each Play</h5>\n    <p>If the video contains more than one <code>play</code>, you will need to specify\n        the start frames and duration frames of each <code>play</code>.</p>\n        <p><code>Note:</code> the endpoint\n            expects the exact frame count and not timestamps.</p>\n    </li>\n    <li>\n    <h5>Team and Game Info (optional)</h5>\n    <p>For better results, you can optionally provide:\n        <ul>\n        <li>Offense Team</li>\n        <li>Defense Team</li>\n        <li>Year and Week of the Game</li>\n    </p>\n    </li>\n</ul>\n<h3>\n    ",
        "parameters": [
          {
            "name": "x-api-key",
            "description": "API Key provided to you by 2 Minute Warning. The API Key is used to identify \n    the Third Party client making the request. Please keep this key secure.<br><br>\n    <strong>Note: </strong>Make sure that the key <code>x-api-key</code> are all small caps.",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9]+$",
              "minLength": 3,
              "maxLength": 256,
              "example": "1234567890abcdef"
            }
          },
          {
            "name": "x-user-token",
            "description": "The word <code>Bearer</code> followed by the <code>idToken</code>\n    you received from the <code>/login</code> endpoint. It is a\n    long string and is used to authenticate and identify users making the api request.<br><br>\n    <strong>Notes: </strong><br>\n    <ul>\n      <li>Make sure that the key <code>x-user-token</code> are all small caps.</li>\n      <li>Make sure the word <code>Bearer</code> precedes the <code>idToken</code>, separated by a space.</li>\n      <li>If the token is expired, you can get a new <code>idToken</code> from the\n        <code>/refreshToken</code> endpoint.</li>\n    </ul>",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^Bearers[A-Za-z0-9-_=]+.[A-Za-z0-9-_=]+.?[A-Za-z0-9-_.+/=]*$",
              "minLength": 3,
              "maxLength": 4096,
              "example": "Bearer eyJraWQiOiJSVVdxd3l..."
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "league",
                  "cutups"
                ],
                "properties": {
                  "jobID": {
                    "type": "string",
                    "pattern": "^[0-9]+$",
                    "minLength": 5,
                    "maxLength": 5
                  },
                  "name": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9 \\-_.&,()]+$",
                    "minLength": 3,
                    "maxLength": 256,
                    "example": "2022-09-10 OSU O at TROY"
                  },
                  "timeZone": {
                    "type": "string",
                    "pattern": "^[+\\-](0?\\d|1[0-4]):[0-5]\\d$",
                    "example": "-05:00"
                  },
                  "league": {
                    "type": "string",
                    "enum": [
                      "NFL",
                      "NCAA",
                      "HIGH_SCHOOL"
                    ],
                    "example": "HIGH_SCHOOL"
                  },
                  "callbackURL": {
                    "type": "string",
                    "pattern": "^$|https?:\\/\\/(www\\.)?[-a-zA-Z0-9@:%._\\+~#=]{1,256}\\.[a-zA-Z0-9()]{1,6}\\b([-a-zA-Z0-9()@:%_\\+.~#?&//=]*)",
                    "maxLength": 2048,
                    "example": "unused"
                  },
                  "email": {
                    "description": "Optional email address to receive notification when job is done.",
                    "type": "string",
                    "format": "email",
                    "maxLength": 256,
                    "example": "coach@myuniversity.com"
                  },
                  "cutups": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": [
                        "cutupID",
                        "name",
                        "analysisRequestedFor",
                        "createReports",
                        "createScoutCards",
                        "isFullGame",
                        "splittingRequired",
                        "plays"
                      ],
                      "properties": {
                        "gameID": {
                          "type": "string",
                          "pattern": "^$|^[A-Za-z0-9 \\-_.]+$",
                          "maxLength": 256,
                          "example": "01-Central-Florida-O-vs-South-Carolina-09-01-2022"
                        },
                        "cutupID": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9\\-_]+$",
                          "minLength": 3,
                          "maxLength": 256,
                          "example": "7dfd382f-91a9-46d5-ab8b-7a9238bd8a7e"
                        },
                        "name": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9 \\-_.&,()]+$",
                          "minLength": 3,
                          "maxLength": 256,
                          "example": "01 Central Florida O vs South Carolina 09-01-2022"
                        },
                        "teamInfo": {
                          "type": "object",
                          "properties": {
                            "name": {
                              "type": "string",
                              "pattern": "^$|^[A-Za-z0-9 \\-_.&,()]+$",
                              "maxLength": 256,
                              "example": "Northwestern"
                            },
                            "conference": {
                              "type": "string",
                              "pattern": "^$|^[A-Za-z0-9 \\-_.&,()]+$",
                              "maxLength": 256,
                              "example": "Big 10 Conference"
                            },
                            "offenseTeam": {
                              "type": "string",
                              "pattern": "^$|^[A-Za-z0-9 \\-_.&,()]+$",
                              "maxLength": 256,
                              "example": "Northwestern"
                            },
                            "defenseTeam": {
                              "type": "string",
                              "pattern": "^$|^[A-Za-z0-9 \\-_.&,()]+$",
                              "maxLength": 256,
                              "example": "Nebraska"
                            }
                          }
                        },
                        "gameInfo": {
                          "type": "object",
                          "required": [
                            "year",
                            "week"
                          ],
                          "properties": {
                            "year": {
                              "type": "string",
                              "pattern": "^$|^\\d{4}$",
                              "example": "2022"
                            },
                            "week": {
                              "type": "string",
                              "pattern": "^$|^\\d{1,2}$",
                              "example": "01"
                            },
                            "homeTeam": {
                              "type": "string",
                              "pattern": "^$|^[A-Za-z0-9 \\-_.&,()]+$",
                              "maxLength": 256,
                              "example": "Northwestern"
                            },
                            "awayTeam": {
                              "type": "string",
                              "pattern": "^$|^[A-Za-z0-9 \\-_.&,()]+$",
                              "maxLength": 256,
                              "example": "Nebraska"
                            },
                            "firstTeamOnOffense": {
                              "type": "string",
                              "pattern": "^$|^[A-Za-z0-9 \\-_.&,()]+$",
                              "maxLength": 256,
                              "example": "Northwestern"
                            },
                            "teamBeingScouted": {
                              "type": "string",
                              "pattern": "^$|^[A-Za-z0-9 \\-_.&,()]+$",
                              "maxLength": 256,
                              "example": "Northwestern"
                            }
                          }
                        },
                        "analysisRequestedFor": {
                          "type": "string",
                          "enum": [
                            "OFFENSE",
                            "DEFENSE",
                            "SPECIAL TEAMS"
                          ]
                        },
                        "baseDefenseTemplate": {
                          "type": "string",
                          "enum": [
                            "2-3-6",
                            "3-3-5",
                            "3-4-4",
                            "4-3-4",
                            "4-2-5"
                          ]
                        },
                        "createReports": {
                          "type": "boolean"
                        },
                        "createScoutCards": {
                          "type": "boolean"
                        },
                        "isFullGame": {
                          "type": "boolean"
                        },
                        "splittingRequired": {
                          "type": "boolean"
                        },
                        "urlToVideo": {
                          "type": "string",
                          "pattern": "^$|https?:\\/\\/(www\\.)?[-a-zA-Z0-9@:%._\\+~#=]{1,256}\\.[a-zA-Z0-9()]{1,6}\\b([-a-zA-Z0-9()@:%_\\+.~#?&//=]*)",
                          "maxLength": 2048,
                          "example": "unused"
                        },
                        "urlToExchangeFile": {
                          "type": "string",
                          "pattern": "^$|https?:\\/\\/(www\\.)?[-a-zA-Z0-9@:%._\\+~#=]{1,256}\\.[a-zA-Z0-9()]{1,6}\\b([-a-zA-Z0-9()@:%_\\+.~#?&//=]*)",
                          "maxLength": 2048,
                          "example": "unused"
                        },
                        "urlToMetadata": {
                          "type": "string",
                          "pattern": "^$|https?:\\/\\/(www\\.)?[-a-zA-Z0-9@:%._\\+~#=]{1,256}\\.[a-zA-Z0-9()]{1,6}\\b([-a-zA-Z0-9()@:%_\\+.~#?&//=]*)",
                          "maxLength": 2048,
                          "example": "unused"
                        },
                        "analysisType": {
                          "type": "string",
                          "enum": [
                            "ODK",
                            "PLAYTYPE",
                            "MOMENT_OF_SNAP",
                            "FIELD_POSITION",
                            "DOWN",
                            "FORMATION",
                            "RUNPASS",
                            "PRESNAP"
                          ],
                          "default": "PRESNAP"
                        },
                        "plays": {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "type": "object",
                            "required": [
                              "playID",
                              "name",
                              "videoInfo"
                            ],
                            "properties": {
                              "playID": {
                                "type": "string",
                                "pattern": "^[A-Za-z0-9\\-_]+$",
                                "minLength": 3,
                                "maxLength": 256,
                                "example": "1c3d2a21-bcb2-4f15-a42e-2267838e7ca8"
                              },
                              "name": {
                                "type": "string",
                                "pattern": "^[A-Za-z0-9 \\-_.&,()]+$",
                                "minLength": 3,
                                "maxLength": 256,
                                "example": "01 Northwestern O vs Nebraska 08-27-2022 Play 003"
                              },
                              "videoInfo": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "required": [
                                    "urlToVideo",
                                    "cameraView"
                                  ],
                                  "properties": {
                                    "urlToVideo": {
                                      "type": "string",
                                      "pattern": "^$|https?:\\/\\/(www\\.)?[-a-zA-Z0-9@:%._\\+~#=]{1,256}\\.[a-zA-Z0-9()]{1,6}\\b([-a-zA-Z0-9()@:%_\\+.~#?&//=]*)",
                                      "maxLength": 2048,
                                      "example": "https://example.com/video.mp4"
                                    },
                                    "cameraView": {
                                      "type": "string",
                                      "enum": [
                                        "SB",
                                        "SL",
                                        "EZ"
                                      ]
                                    },
                                    "start": {
                                      "type": "number",
                                      "description": "Required if splittingRequired = true and urlToExchangeFile is not provided",
                                      "multipleOf": 1,
                                      "minimum": 0,
                                      "example": 620
                                    },
                                    "duration": {
                                      "type": "number",
                                      "description": "Required if splittingRequired = true and urlToExchangeFile is not provided",
                                      "multipleOf": 1,
                                      "minimum": 0,
                                      "example": 418
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "description": "<style>\n    /* This is for local purposes only. Swagger removes these styles on the Web UI. */\n    code {\n        color: #9012fe;\n        font-weight: bold;\n        font-family: monospace;\n    }\n</style>\n\n<h3>Jobs Object Definition</h3>\n<table>\n    <thead>\n        <tr>\n            <th>Property Name</th>\n            <th>Data Type</th>\n            <th>Description</th>\n            <th>Example(s)</th>\n            <th>Required</th>\n        </tr>\n    </thead>\n    <tbody>\n        <tr>\n            <td>name</td>\n            <td>string</td>\n            <td>Reader-friendly name of the job.</td>\n            <td>My AI Analysis Job 20230102</td>\n            <td>Yes</td>\n        </tr>\n        <tr>\n            <td>timeZone</td>\n            <td>string</td>\n            <td>Client time zone, in +/-HH:MM format.</td>\n            <td>-05:00</td>\n            <td>No</td>\n        </tr>\n        <tr>\n            <td>league</td>\n            <td>enum:<br>string</td>\n            <td>\n            The competition level of the cutups to be submitted. The enum options are:\n            <ul>\n                <li>NFL</li>\n                <li>NCAA</li>\n                <li>HIGH_SCHOOL</li>\n            </ul>\n            </td>\n            <td>NCAA</td>\n            <td>Yes</td>\n        </tr>\n        <tr>\n            <td>callbackURL</td>\n            <td>string</td>\n            <td><code>Currently unused</code></td>\n            <td><code>Currently unused</code></td>\n            <td>No</td>\n        </tr>\n        <tr>\n            <td>email</td>\n            <td>string</td>\n            <td>\n                Email address to send job completion notification to.<br>\n                If no email is provided, we will send the result to the email address associated with the <code>idToken</code> used to submit the job.\n            </td>\n            <td>coach@myuniversity.com</td>\n            <td>No</td>\n        </tr>\n        <tr>\n            <td>cutups</td>\n            <td>array:<br>objects</td>\n            <td>Array of <code>cutup</code> objects to be analyzed.</td>\n            <td>\n                <code>[<br>\n                &nbsp;&nbsp;{cutup},<br>\n                &nbsp;&nbsp;{cutup},<br>\n                &nbsp;&nbsp;{cutup},<br>\n                &nbsp;&nbsp;...<br>\n                ]</code><br>\n                For each <code>cutup</code> object, see:<br>\n                <code>Cutup Object Definition</code></td>\n            <td>Yes</td>\n        </tr>\n    </tbody>\n</table>\n<br>\n<h3>Cutup Object Definition</h3>\n<table>\n    <thead>\n        <tr>\n            <th>Property Name</th>\n            <th>Data Type</th>\n            <th>Description</th>\n            <th>Example(s)</th>\n            <th>Required</th>\n        </tr>\n    </thead>\n    <tbody>\n        <tr>\n            <td>gameID</td>\n            <td>string</td>\n            <td>If the cutup is a game, the unique identifier for the game can be provided here.</td>\n            <td>\n                <ul>\n                    <li>01-Central-Florida-O-vs-South-Carolina-09-01-2022</li>\n                    <li>7dfd382f-91a9-46d5-ab8b-7a9238bd8a7e</li>\n                </ul>\n            </td>\n            <td>No</td>\n        </tr>\n        <tr>\n            <td>cutupID</td>\n            <td>string</td>\n            <td>\n                A unique identifier for the cutup. This identifier must be unique against other cutups. This could be an ID used internally by the Third Party to identify the cutup.<br>\n                If the cutup is from a full game, the <code>gameID</code> can also be used as the <code>cutupID</code>.\n            </td>\n            <td>\n                <ul>\n                    <li>01-Central-Florida-O-vs-South-Carolina-09-01-2022</li>\n                    <li>7dfd382f-91a9-46d5-ab8b-7a9238bd8a7e</li>\n                </ul>\n            </td>\n            <td>Yes</td>\n        </tr>\n        <tr>\n            <td>name</td>\n            <td>string</td>\n            <td>A reader-friendly name for the cutup.</td>\n            <td>\n                <ul>\n                    <li>Week 1, Central Florida (Offense) vs South Carolina (Defense) 09-01-2022</li>\n                    <li>01 Central Florida O vs South Carolina 09-01-2022</li>\n                </ul>\n            </td>\n            <td>Yes</td>\n        </tr>\n        <tr>\n            <td>teamInfo</td>\n            <td>object</td>\n            <td>If the cutup is from a full game, you can provide details about the teams playing, and our systems will attempt to look up public records and include additional data with the analysis report.</td>\n            <td>\n                See:<br>\n                <code>TeamInfo Object Definition</code>\n            </td>\n            <td>No</td>\n        </tr>\n        <tr>\n            <td>isFullGame</td>\n            <td>bool</td>\n            <td>\n                Defines if the cutup is a from a full game or not.<br>\n                <code>Note:</code> If <code>isFullGame</code> is set to <code>true</code>, the <code>gameID</code> field is required.\n            </td>\n            <td>true</td>\n            <td>Yes</td>\n        </tr>\n        <tr>\n            <td>gameInfo</td>\n            <td>object</td>\n            <td>If the cutup is from a full game, you can provide details about the game, and our systems will attempt to look up public records and include additional data with the analysis report.</td>\n            <td>\n                See:<br>\n                <code>GameInfo Object Definition</code>\n            </td>\n            <td>Yes if <code>isFullGame</code> is set to <code>true</code></td>\n        </tr>\n        <tr>\n            <!-- space added to add some padding to the right -->\n            <!-- unfortunately the hosted version of swagger do not support custom css -->\n            <td>analysisRequestedFor&nbsp;&nbsp;</td>\n            <td>enum:<br>string</td>\n            <td>\n                Defines the intended use of the analysis report. The options are:\n                <ul>\n                    <li>DEFENSE</li>\n                    <li>OFFENSE</li>\n                    <li>SPECIAL_TEAMS</li>\n                </ul>\n            </td>\n            <td>DEFENSE</td>\n            <td>Yes</td>\n        </tr>\n        <tr>\n            <!-- space added to add some padding to the right -->\n            <!-- unfortunately the hosted version of swagger do not support custom css -->\n            <td>baseDefenseTemplate&nbsp;&nbsp;</td>\n            <td>enum:<br>string</td>\n            <td>\n                Base defense formation template of the play.<br>\n                Options are:\n                <ul>\n                    <li>2-3-6</li>\n                    <li>3-3-5</li>\n                    <li>3-4-4</li>\n                    <li>4-3-4</li>\n                    <li>4-2-5</li>\n                </ul>\n            </td>\n            <td>2-3-6</td>\n            <td>No</td>\n        </tr>\n        <tr>\n            <td>createReports</td>\n            <td>bool</td>\n            <td>\n                Defines if reports should be generated for the cutup.\n            </td>\n            <td>true</td>\n            <td>Yes</td>\n        </tr>\n        <tr>\n            <td>createScoutCards</td>\n            <td>bool</td>\n            <td>\n                Defines if scoutcards should be generated for the cutup.\n            </td>\n            <td>true</td>\n            <td>Yes</td>\n        </tr>\n        <tr>\n            <td>splittingRequired</td>\n            <td>bool</td>\n            <td>\n                Defines if the provided video is monolithic and requires splitting by the provided start and duration frames for each play. More information on the <code>Video Info Object Definition</code>\n            </td>\n            <td>true</td>\n            <td>Yes</td>\n        </tr>\n        <tr>\n            <td>urlToVideo</td>\n            <td>string</td>\n            <td><code>Currently unused</code></td>\n            <td><code>Currently unused</code></td>\n            <td>No</td>\n        </tr>\n        <tr>\n            <td>urlToExchangeFile</td>\n            <td>string</td>\n            <td><code>Currently unused</code></td>\n            <td><code>Currently unused</code></td>\n            <td>No</td>\n        </tr>\n        <tr>\n            <td>urlToMetaData</td>\n            <td>string</td>\n            <td><code>Currently unused</code></td>\n            <td><code>Currently unused</code></td>\n            <td>No</td>\n        </tr>\n        <tr>\n            <td>analysisType</td>\n            <td>enum:<br>string</td>\n            <td>\n                Type of analysis to be performed. The options are:\n                <ul>\n                    <li>ODK</li>\n                    <li>PLAYTYPE</li>\n                    <li>MOMENT_OF_SNAP</li>\n                    <li>FIELD_POSITION</li>\n                    <li>DOWN</li>\n                    <li>FORMATION</li>\n                    <li>RUNPASS</li>\n                    <li>PRESNAP</li>\n                </ul>\n            </td>\n            <td>PRESNAP</td>\n            <td>No (Defaults to PRESNAP)</td>\n        </tr>\n        <tr>\n            <td>plays</td>\n            <td>array:<br>objects</td>\n            <td>\n                An array of <code>play</code> objects that makes up the <code>cutup</code>.\n            </td>\n            <td>\n                <code>[<br>\n                    &nbsp;&nbsp;{play},<br>\n                    &nbsp;&nbsp;{play},<br>\n                    &nbsp;&nbsp;{play},<br>\n                    &nbsp;&nbsp;...<br>\n                    ]</code><br>\n                For each <code>play</code>object, see:<br>\n                <code>Play Object Definition</code>\n            </td>\n            <td>Yes</td> \n        </tr>\n    </tbody>\n</table>\n<br>\n<h3>Team Info Object Definition</h3>\n<table>\n    <thead>\n        <tr>\n            <th>Property Name</th>\n            <th>Data Type</th>\n            <th>Description</th>\n            <th>Example(s)</th>\n            <th>Required</th>\n        </tr>\n    </thead>\n    <tbody>\n        <tr>\n            <td>name</td>\n            <td>string</td>\n            <td>Name of the team requesting the analysis.</td>\n            <td>Northwestern</td>\n            <td>No</td>\n        </tr>\n        <tr>\n            <td>conference</td>\n            <td>string</td>\n            <td>Conference of the teams playing in the cutup.</td>\n            <td>Big 10 Conference</td>\n            <td>No</td>\n        </tr>\n        <tr>\n            <td>offenseTeam</td>\n            <td>string</td>\n            <td>Name of the offense team in the cutup.</td>\n            <td>Northwestern</td>\n            <td>No</td>\n        </tr>\n        <tr>\n            <td>defenseTeam</td>\n            <td>string</td>\n            <td>Name of the defense team in the cutup.</td>\n            <td>Nebraska</td>\n            <td>No</td>\n        </tr>\n    </tbody>\n</table>\n<br>\n<h3>Game Info Object Definition</h3>\nNote: This object is only required if the <code>isFullGame</code> from the parent <code>cutup</code>is set to <code>true</code>.\n<table>\n    <thead>\n        <tr>\n            <th>Property Name</th>\n            <th>Data Type</th>\n            <th>Description</th>\n            <th>Example(s)</th>\n            <th>Required</th>\n        </tr>\n    </thead>\n    <tbody>\n        <tr>\n            <td>year</td>\n            <td>string</td>\n            <td>Year of the game in the cutup.</td>\n            <td>2022</td>\n            <td>Yes</td>\n        </tr>\n        <tr>\n            <td>week</td>\n            <td>string</td>\n            <td>Week number of the season. Requires 2 digits. Prepend zero for single digit weeks.</td>\n            <td>08</td>\n            <td>Yes</td>\n        </tr>\n        <tr>\n            <td>homeTeam</td>\n            <td>string</td>\n            <td>Home Team of the Game</td>\n            <td>Northwestern</td>\n            <td>Yes</td>\n        </tr>\n        <tr>\n            <td>awayTeam</td>\n            <td>string</td>\n            <td>Away Team of the Game</td>\n            <td>Nebraska</td>\n            <td>Yes</td>\n        </tr>\n        <tr>\n            <td>firstTeamOnOffense</td>\n            <td>string</td>\n            <td>Team that plays Offense first</td>\n            <td>Northwestern</td>\n            <td>Yes</td>\n        </tr>\n        <tr>\n            <td>teamBeingScouted</td>\n            <td>string</td>\n            <td>Team that is being scouted</td>\n            <td>Northwestern</td>\n            <td>Yes</td>\n        </tr>\n    </tbody>\n</table>\n<br>\n<h3>Play Object Definition</h3>\n<table>\n    <thead>\n        <tr>\n            <th>Property Name</th>\n            <th>Data Type</th>\n            <th>Description</th>\n            <th>Example(s)</th>\n            <th>Required</th>\n        </tr>\n    </thead>\n    <tbody>\n        <tr>\n            <td>playID</td>\n            <td>string</td>\n            <td>A unique identifier of the <code>play</code> within the <code>cutup</code>. This could be individual unique IDs like hash strings, or a common base name with the play number as suffix.</td>\n            <td>\n                <ul>\n                    <li>1c3d2a21-bcb2-4f15-a42e-2267838e7ca8</li>\n                    <li>01-Northwestern-O-vs-Nebraska-08-27-2022-Play-003</li>\n                    <li>01-Northwestern-O-vs-Nebraska-08-27-2022-Play-004</li>\n                </ul>\n            </td>\n            <td>Yes</td>\n        </tr>\n        <tr>\n            <td>name</td>\n            <td>string</td>\n            <td>Reader-friendly name of the play.</td>\n            <td>01 Northwestern O vs Nebraska 08-27-2022 Play 003</td>\n            <td>Yes</td>\n        </tr>\n        <tr>\n            <td>videoInfo</td>\n            <td>array:<br>objects</td>\n            <td>\n                An array of <code>videoInfo</code> objects that defines the view angle and the start and duration frames (if monolithic) of the video.\n            </td>\n            <td>\n                <code>[<br>\n                &nbsp;&nbsp;{videoInfo},<br>\n                &nbsp;&nbsp;{videoInfo},<br>\n                &nbsp;&nbsp;{videoInfo},<br>\n                &nbsp;&nbsp;...<br>\n                ]</code><br>\n                For each <code>videoInfo</code> object, see:<br>\n                <code>Video Info Object Defintion</code>\n            </td>\n            <td>Yes</td>\n        </tr>\n    </tbody>\n</table>\n<br>\n<h3>Video Info Object Definition</h3>\n<table>\n    <thead>\n        <tr>\n            <th>Property Name</th>\n            <th>Data Type</th>\n            <th>Description</th>\n            <th>Example(s)&nbsp;&nbsp;</th>\n            <th>Required</th>\n        </tr>\n    </thead>\n    <tbody>\n        <tr>\n            <td>urlToVideo</td>\n            <td>string</td>\n            <td>\n                URL to the video file. Please pre-sign the URL if authentication is required. <code>Note:</code> If <code>s3PathToVideoFile</code> is used, this value is ignored. In this case, because this field is required, you may pass an empty string.\n            </td>\n            <td>\n                <ul>\n                    <li>https://example.com/video.mp4</li>\n                </ul>\n            </td>\n            <td>Yes</td>\n        </tr>\n        <tr>\n            <td>cameraView</td>\n            <td>enum:<br>string</td>\n            <td>\n                The view angle of the video clip.<br>\n                The options are:\n                <ul>\n                    <li>\"SB\" - scoreboard view</li>\n                    <li>\"SL\" - sideline view</li>\n                    <li>\"EZ\" - endzone view</li>\n                </ul>\n                <code>Note:</code> Currently only SL view angle is required and used. We are working to make SB and EZ usable to enhance the accuracy of our AI.\n            </td>\n            <td>SL</td>\n            <td>Yes</td>\n        </tr>\n        <tr>\n            <td>start</td>\n            <td>integer</td>\n            <td>\n                The frame number of the start of the play.<br>\n                <code>Additional Notes:</code><br>\n                <ul>\n                    <li>This is not the timestamp of the start of the play. This is the exact frame number of the start of the play.</li>\n                    <li>If <code>splittingRequired</code> is set to <code>true</code>, this field is required.</li>\n                    <li>If <code>splittingRequired</code> is set to <code>false</code>, this field must not be set.</li>\n                </ul>\n            </td>\n            <td>620</td>\n            <td>Yes if <code>splittingRequired</code> is set to <code>true</code></td>\n        </tr>\n        <tr>\n            <td>duration</td>\n            <td>integer</td>\n            <td>\n                The number of frames to analyze, starting from the <code>start</code> frame.<br>\n                <code>Additional Notes:</code><br>\n                <ul>\n                    <li>This is not the time of the duration of the play. This is the exact frame count from the start to the end of the play.</li>\n                    <li>If <code>splittingRequired</code> is set to <code>true</code>, this field is required.</li>\n                    <li>If <code>splittingRequired</code> is set to <code>false</code>, this field must not be set.</li>\n                </ul>\n            </td>\n            <td>418</td>\n            <td>Yes if <code>splittingRequired</code> is set to <code>true</code></td>\n        </tr>\n        <tr>\n            <td>s3PathToVideoFile</td>\n            <td>string</td>\n            <td>\n                S3 location of the video file. If this field is provided, <code>urlToVideo</code> will be ignored.\n            </td>\n            <td>\n                <ul>\n                    <li>2mw.bucket.teams/path/video.mp4</li>\n                </ul>\n            </td>\n            <td>No</td>\n    </tbody>\n</table>"
        }
      },
      "get": {
        "tags": [
          "Get Jobs Status"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "clientID": {
                      "type": "string"
                    },
                    "jobs": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "jobID": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "numberOfPlays": {
                            "type": "number"
                          },
                          "finishTime": {
                            "type": "string"
                          },
                          "status": {
                            "type": "string"
                          },
                          "statusDetails": {
                            "type": "string"
                          },
                          "cutups": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "name": {
                                  "type": "string"
                                },
                                "cutupID": {
                                  "type": "string"
                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    "pagination": {
                      "type": "object",
                      "properties": {
                        "page": {
                          "type": "number"
                        },
                        "pageSize": {
                          "type": "number"
                        },
                        "hasMore": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not found"
          },
          "500": {
            "description": "Server Error"
          },
          "503": {
            "description": "Service Unavailable"
          }
        },
        "x-amazon-apigateway-integration": {
          "type": "aws_proxy",
          "credentials": {
            "Fn::Sub": "${ApiRole.Arn}"
          },
          "uri": {
            "Fn::Sub": "arn:aws:apigateway:${AWS::Region}:lambda:path/2015-03-31/functions/${getJobsStatus.Arn}/invocations"
          },
          "passthroughBehavior": "never",
          "httpMethod": "POST",
          "connectionType": "INTERNET",
          "contentHandling": "CONVERT_TO_TEXT"
        },
        "summary": "Return status of all jobs associated with account",
        "description": "Return status of all jobs associated with account",
        "x-amazon-apigateway-request-validator": "all",
        "parameters": [
          {
            "name": "x-api-key",
            "description": "API Key provided to you by 2 Minute Warning. The API Key is used to identify \n    the Third Party client making the request. Please keep this key secure.<br><br>\n    <strong>Note: </strong>Make sure that the key <code>x-api-key</code> are all small caps.",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9]+$",
              "minLength": 3,
              "maxLength": 256,
              "example": "1234567890abcdef"
            }
          },
          {
            "name": "x-user-token",
            "description": "The word <code>Bearer</code> followed by the <code>idToken</code>\n    you received from the <code>/login</code> endpoint. It is a\n    long string and is used to authenticate and identify users making the api request.<br><br>\n    <strong>Notes: </strong><br>\n    <ul>\n      <li>Make sure that the key <code>x-user-token</code> are all small caps.</li>\n      <li>Make sure the word <code>Bearer</code> precedes the <code>idToken</code>, separated by a space.</li>\n      <li>If the token is expired, you can get a new <code>idToken</code> from the\n        <code>/refreshToken</code> endpoint.</li>\n    </ul>",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
