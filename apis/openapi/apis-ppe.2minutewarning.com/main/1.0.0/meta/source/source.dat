      "post": {
        "tags": [
          "Submit Feedback"
        ],
        "summary": "Submit feedback to 2 Minute Warning",
        "description": "Submit feedback to 2 Minute Warning",
        "x-amazon-apigateway-request-validator": "all",
        "requestBody": {
          "description": "Submit feedback to 2 Minute Warning",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "league",
                  "jobID",
                  "playID",
                  "issueType",
                  "issueDetails"
                ],
                "properties": {
                  "league": {
                    "type": "string",
                    "enum": [
                      "NFL",
                      "NCAA",
                      "HIGH_SCHOOL"
                    ],
                    "example": "HIGH_SCHOOL"
                  },
                  "jobID": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9]+$",
                    "minLength": 4,
                    "maxLength": 10
                  },
                  "playID": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9\\-_]+$",
                    "minLength": 3,
                    "maxLength": 256,
                    "example": "1c3d2a21-bcb2-4f15-a42e-2267838e7ca8"
                  },
                  "issueType": {
                    "type": "string",
                    "enum": [
                      "DATA",
                      "REPORT",
                      "SCOUTCARD",
                      "OTHER"
                    ]
                  },
                  "issueDetails": {
                    "type": "string",
                    "maxLength": 2048,
                    "pattern": "^[A-Za-z0-9 \\-\\/!@#$%^&*()_+=:;><.,?''{}\\[\\]]*$"
                  },
                  "appName": {
                    "type": "string",
                    "maxLength": 256,
                    "pattern": "^[A-Za-z0-9 \\-_.&,]*$"
                  },
                  "metadata": {
                    "type": "string",
                    "maxLength": 2048,
                    "pattern": "^[A-Za-z0-9 \\-\\/!@#$%^&*()_+=:;><.,?''{}\\[\\]]*$"
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 256
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "clientID": {
                      "type": "string"
                    },
                    "jobID": {
                      "type": "string"
                    },
                    "playID": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not found"
          },
          "500": {
            "description": "Server Error"
          },
          "503": {
            "description": "Service Unavailable"
          }
        },
        "security": [
          {
            "DdamenLambdaAuthorizer": []
          }
        ],
        "x-amazon-apigateway-integration": {
          "type": "aws_proxy",
          "credentials": {
            "Fn::Sub": "${ApiRole.Arn}"
          },
          "uri": {
            "Fn::Sub": "arn:aws:apigateway:${AWS::Region}:lambda:path/2015-03-31/functions/${submitFeedback.Arn}/invocations"
          },
          "passthroughBehavior": "never",
          "httpMethod": "POST",
          "connectionType": "INTERNET",
          "contentHandling": "CONVERT_TO_TEXT"
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "DdamenLambdaAuthorizer": {
        "type": "apiKey",
        "name": "Unused",
        "in": "header",
        "x-amazon-apigateway-authtype": "custom",
        "x-amazon-apigateway-authorizer": {
          "type": "request",
          "identitySource": "method.request.header.x-user-token,method.request.header.x-api-key",
