]}}}},"429":{"description":"Rate or execution limit exceeded"},"502":{"description":"Upstream source failure"}}}},"/v1/compare-products":{"post":{"operationId":"compare_products","summary":"Compare source-backed product records from multiple public product pages in one bounded call.","requestBody":{"required":true,"content":{"application/json":{"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"urls":{"minItems":2,"maxItems":6,"type":"array","items":{"type":"string","maxLength":2048,"format":"uri"}},"select":{"maxItems":9,"type":"array","items":{"type":"string","enum":["name","brand","description","price","currency","sku","availability","images","attributes"]}},"response_mode":{"type":"string","enum":["minimal","standard","evidence"]},"max_age_ms":{"type":"integer","minimum":0,"maximum":300000}},"required":["urls"],"additionalProperties":false}}}},"responses":{"200":{"description":"Successful execution envelope","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Invalid request"},"402":{"description":"Payment authorization required. Production uses x402 v2 exact USDC on Base mainnet or Stripe live carry-forward invoicing; the response includes a standard PAYMENT-REQUIRED challenge.","headers":{"PAYMENT-REQUIRED":{"schema":{"type":"string"},"description":"Base64-encoded x402 v2 PaymentRequired object"},"WWW-Authenticate":{"schema":{"type":"string"},"description":"Compatibility x402 challenge"},"X-Payment-Required":{"schema":{"type":"string","enum":["true"]}}}},"429":{"description":"Rate or execution limit exceeded"},"502":{"description":"Upstream source failure"}}}},"/v1/source-snapshot":{"post":{"operationId":"source_snapshot","summary":"Return a bounded, source-hashed snapshot of a public webpage with caller-controlled change checks.","requestBody":{"required":true,"content":{"application/json":{"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"url":{"type":"string","maxLength":2048,"format":"uri"},"include":{"maxItems":3,"type":"array","items":{"type":"string","enum":["text","links","structured_data"]}},"max_chars":{"type":"integer","minimum":200,"maximum":20000},"known_content_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"response_mode":{"type":"string","enum":["minimal","standard","evidence"]},"max_age_ms":{"type":"integer","minimum":0,"maximum":300000}},"required":["url"],"additionalProperties":false}}}},"responses":{"200":{"description":"Successful execution envelope","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Invalid request"},"402":{"description":"Payment authorization required. Production uses x402 v2 exact USDC on Base mainnet or Stripe live carry-forward invoicing; the response includes a standard PAYMENT-REQUIRED challenge.","headers":{"PAYMENT-REQUIRED":{"schema":{"type":"string"},"description":"Base64-encoded x402 v2 PaymentRequired object"},"WWW-Authenticate":{"schema":{"type":"string"},"description":"Compatibility x402 challenge"},"X-Payment-Required":{"schema":{"type":"string","enum":["true"]}}}},"429":{"description":"Rate or execution limit exceeded"},"502":{"description":"Upstream source failure"}}}}}}