{"openapi":"3.1.0","info":{"title":"Found17 API","version":"1.0.0-production","description":"FOUND17 production: Base mainnet x402 for agents and Stripe live carry-forward invoicing for human/business usage."},"servers":[{"url":"https://found17.com"}],"security":[{"x402Payment":[]},{"stripeSandboxAccount":[]}],"components":{"securitySchemes":{"x402Payment":{"type":"apiKey","in":"header","name":"PAYMENT-SIGNATURE","description":"Base64-encoded x402 v2 exact USDC authorization on Base mainnet."},"stripeSandboxAccount":{"type":"apiKey","in":"header","name":"X-Found17-Account-Id","description":"Human/business billing account identifier; pair with X-Found17-Billing-Mode: stripe."}}},"paths":{"/health":{"get":{"operationId":"health","responses":{"200":{"description":"Service health"}}}},"/services":{"get":{"operationId":"listServices","responses":{"200":{"description":"Machine-readable service catalog"}}}},"/v1/quote":{"get":{"operationId":"quoteService","responses":{"200":{"description":"Non-binding execution quote"}}}},"/v1/source-watches":{"post":{"operationId":"createSourceWatch","summary":"Create a time-bounded public-source watch","requestBody":{"required":true,"content":{"application/json":{"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"url":{"type":"string","maxLength":2048,"format":"uri"},"interval_seconds":{"type":"integer","minimum":900,"maximum":86400},"expires_in_seconds":{"type":"integer","minimum":900,"maximum":2592000}},"required":["url"],"additionalProperties":false}}}},"responses":{"201":{"description":"Watch created"},"400":{"description":"Invalid request"},"429":{"description":"Rate limited"}}}},"/v1/source-watches/{watch_id}":{"get":{"operationId":"getSourceWatch","parameters":[{"name":"watch_id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Watch status"},"401":{"description":"Missing or invalid watch token"}}},"delete":{"operationId":"deleteSourceWatch","parameters":[{"name":"watch_id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Watch deleted"},"401":{"description":"Missing or invalid watch token"}}}},"/v1/source-watches/{watch_id}/check":{"post":{"operationId":"checkSourceWatch","parameters":[{"name":"watch_id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Watch status after a bounded source check"},"401":{"description":"Missing or invalid watch token"}}}},"/v1/web-to-product":{"post":{"operationId":"web_to_product","summary":"Extract a normalized product record from a public product page without inventing missing fields.","requestBody":{"required":true,"content":{"application/json":{"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"url":{"type":"string","maxLength":2048,"format":"uri"},"select":{"maxItems":9,"type":"array","items":{"type":"string","enum":["name","brand","description","price","currency","sku","availability","images","attributes"]}},"response_mode":{"type":"string","enum":["minimal","standard","evidence"]},"max_age_ms":{"type":"integer","minimum":0,"maximum":300000}},"required":["url"],"additionalProperties":false}}}},"responses":{"200":{"description":"Successful execution envelope","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Invalid request"},"402":{"description":"Payment authorization required. Production uses x402 v2 exact USDC on Base mainnet or Stripe live carry-forward invoicing; the response includes a standard PAYMENT-REQUIRED challenge.","headers":{"PAYMENT-REQUIRED":{"schema":{"type":"string"},"description":"Base64-encoded x402 v2 PaymentRequired object"},"WWW-Authenticate":{"schema":{"type":"string"},"description":"Compatibility x402 challenge"},"X-Payment-Required":{"schema":{"type":"string","enum":["true"]}}}},"429":{"description":"Rate or execution limit exceeded"},"502":{"description":"Upstream source failure"}}}},"/v1/verify-claim":{"post":{"operationId":"verify_claim","summary":"Evaluate whether supplied public sources establish a claim and return evidence without fabricated citations.","requestBody":{"required":true,"content":{"application/json":{"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"claim":{"type":"string","minLength":1,"maxLength":2000},"source_urls":{"minItems":1,"maxItems":5,"type":"array","items":{"type":"string","maxLength":2048,"format":"uri"}},"response_mode":{"type":"string","enum":["minimal","standard","evidence"]},"max_age_ms":{"type":"integer","minimum":0,"maximum":300000}},"required":["claim","source_urls"],"additionalProperties":false}}}},"responses":{"200":{"description":"Successful execution envelope","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Invalid request"},"402":{"description":"Payment authorization required. Production uses x402 v2 exact USDC on Base mainnet or Stripe live carry-forward invoicing; the response includes a standard PAYMENT-REQUIRED challenge.","headers":{"PAYMENT-REQUIRED":{"schema":{"type":"string"},"description":"Base64-encoded x402 v2 PaymentRequired object"},"WWW-Authenticate":{"schema":{"type":"string"},"description":"Compatibility x402 challenge"},"X-Payment-Required":{"schema":{"type":"string","enum":["true"]}}}},"429":{"description":"Rate or execution limit exceeded"},"502":{"description":"Upstream source failure"}}}},"/v1/web-qa":{"post":{"operationId":"web_qa","summary":"Run reproducible HTTP/HTML/SEO/accessibility checks on a public webpage.","requestBody":{"required":true,"content":{"application/json":{"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"url":{"type":"string","maxLength":2048,"format":"uri"},"response_mode":{"type":"string","enum":["minimal","standard","evidence"]},"max_age_ms":{"type":"integer","minimum":0,"maximum":300000}},"required":["url"],"additionalP