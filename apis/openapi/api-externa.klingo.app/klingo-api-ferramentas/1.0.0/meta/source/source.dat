    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/klingo/klingo-api-ferramentas/1.0.0"
  },
  "host": "api-externa.klingo.app",
  "basePath": "/api/ferramentas",
  "tags": [
    {
      "name": "tarefas",
      "description": "Tarefas"
    }
  ],
  "schemes": [
    "https"
  ],
  "paths": {
    "/tarefa/criar": {
      "post": {
        "tags": [
          "tarefas"
        ],
        "summary": "Criação de nova tarefa.",
        "security": [
          {
            "app_token": []
          }
        ],
        "description": "Dados da criação de tarefa.",
        "operationId": "tarefascriar",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "description": "Dados da Chamada.",
            "required": true,
            "schema": {
              "$ref": "#/definitions/tarefa"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Json com os dados da tarefa criada."
          },
          "405": {
            "description": "Invalid input"
          }
        }
      }
    }
  },
  "securityDefinitions": {
    "app_token": {
      "type": "apiKey",
      "name": "X-APP-TOKEN",
      "in": "header"
    }
  },
  "definitions": {
    "tarefa": {
      "type": "object",
      "properties": {
        "descricao": {
          "type": "string",
          "description": "Descrição da Tarefa",
          "example": "Lorem Ipsum"
        },
        "id_paciente": {
          "type": "number",
          "description": "Id do Paciente vinculado a tarefa (Opcional)",
          "example": 123
        },
        "id_medico": {
          "type": "number",
          "description": "Id do Médico para o qual a tarefa está sendo aberta",
          "example": 123
        }
      }
    }
  },
  "externalDocs": {
    "description": "Find out more about Swagger",
    "url": "http://swagger.io"
  }
