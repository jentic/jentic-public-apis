ss` will be false and the `Error` value will be non-null.","title":"RecurringTaskValidationResultDtoAstroResult"},"MeetingAssigneeDto":{"type":"object","properties":{"id":{"type":"string","format":"uuid","description":"The unique identifier of this Resource"},"initials":{"type":"string","description":"A shortened set of initials to use when representing this MeetingAssignee visually\r\nin small areas.  The initials may be used in small icons or other overlays."},"name":{"type":["string","null"],"description":"The name of this MeetingAssignee"},"description":{"type":["string","null"],"description":"A more complete description of the MeetingAssignee."},"isActive":{"type":"boolean","description":"True if this MeetingAssignee is currently active with the Project."},"colorName":{"type":["string","null"],"description":"Collaboration Color for this resource.\r\n            \r\neg. teal, cyan, lightblue, blurple, purple, pink, orange, gray"},"firstName":{"type":["string","null"],"description":"The first or given name of this MeetingAssignee.\r\n            \r\nFor personnel MeetingAssignees only."},"lastName":{"type":["string","null"],"description":"The last or family name of this MeetingAssignee.\r\n            \r\nFor personnel MeetingAssignees only."},"shortName":{"type":["string","null"],"description":"A shortened version of the name of this MeetingAssignee.  This is used in areas\r\nwhere the Initials are too short but the full name is too long."},"avatarUrl":{"type":["string","null"],"description":"A link to an Avatar for this MeetingAssignee.  Avatars are small images or representations\r\nthat can be used to visually identify this MeetingAssignee at a glance."},"email":{"type":["string","null"],"description":"The email address for the resource. It can be empty if the resource does not have a login."}},"description":"A MeetingAssignee is a Resource to whom a Meeting is assigned. A single Meeting\r\ncan be assigned to multiple MeetingAssignee.","title":"MeetingAssigneeDto"},"TaskTagDto":{"type":"object","properties":{"id":{"type":"string","format":"uuid","description":"The unique identifier of this TaskTag."},"name":{"type":"string","description":"The common name of this TaskTag."},"color":{"type":"string","description":"The color that will be used to represent this Tag visually.  This color\r\nis automatically chosen by the application when a user creates a Tag.\r\n            \r\nYou can choose specify any color that can be represented using HTML RGB\r\nsyntax such as `#0088FF`, in the format `RRGGBB`.  You may not use names\r\nfor colors."}},"description":"A TaskTag is a connection between a Task and a Tag.  Each Task can have zero, one or many\r\nTaskTags associated with it.  TaskTags can be assigned and removed from the Task to help you\r\nclassify your Tasks and prioritize work.","title":"TaskTagDto"},"TaskTodoDto":{"type":"object","properties":{"id":{"type":"string","format":"uuid","description":"The unique identifier of this TaskTodo."},"text":{"type":"string","description":"The full description of this TaskTodo."},"complete":{"type":"boolean","description":"True if this TaskTodo is complete."},"createDate":{"type":"string","format":"date-time","description":"The timestamp in UTC when this object was created."},"modifyDate":{"type":"string","format":"date-time","description":"The timestamp in UTC when this object was last modified."}},"description":"A TaskTodo is a sub-task that represents a unit of work on the Task.  You can use\r\nTaskTodo to represent individual items for a larger piece of work.","title":"TaskTodoDto"},"TaskOwnerDto":{"type":"object","properties":{"id":{"type":"string","format":"uuid","description":"The unique identifier of this Resource."},"initials":{"type":"string","description":"The resource initials."},"name":{"type":["string","null"],"description":"Display name for this Resource."},"shortName":{"type":["string","null"],"description":"Short display name for this Resource."},"firstName":{"type":["