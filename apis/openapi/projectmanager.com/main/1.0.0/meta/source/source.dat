{"openapi":"3.1.0","info":{"title":"API Reference","version":"1.0.0"},"paths":{"/api/data/api-keys":{"get":{"operationId":"apiKey_listApiKeys","summary":"List Api Keys","description":"Returns a list of all API keys within the current workspace.\r\n            \r\nAn API key is a credential that you can use to make REST v4 API calls for ProjectManager.com.  When you create\r\na new API key, that API key is only visible in the response JSON for the `CreateApiKey` method.  If you do not\r\npreserve this information, it cannot be recreated.\r\n            \r\nSome best practices for working with API keys:\r\n* An API key is valid for a two-year period after it is created.  We encourage you to rotate your API keys\r\nregularly according to your company's security policies.\r\n* You should create separate API keys for each system that works with your API.  If that API key is exposed\r\nor if that program needs to be shut down, you can revoke that one key and reissue it.\r\n* An API key is tied to the workspace that created it. A single API key can only interact with one workspace.","tags":["apiKey"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiKeyDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]},"post":{"operationId":"apiKey_createApiKey","summary":"Create Api Key","description":"Creates a new API key for the current user with the specified options.\r\n            \r\nAn API key is a credential that you can use to make REST v4 API calls for ProjectManager.com.  When you create\r\na new API key, that API key is only visible in the response JSON for the `CreateApiKey` method.  If you do not\r\npreserve this information, it cannot be recreated.\r\n            \r\nSome best practices for working with API keys:\r\n* An API key is valid for a two year period after it is created.  We encourage you to rotate your API keys\r\nregularly according to your company's security policies.\r\n* You should create separate API keys for each system that works with your API.  If that API key is exposed\r\nor if that program needs to be shut down, you can revoke that one key and reissue it.\r\n* An API key is tied to the workspace that created it. A single API key can only interact with one workspace.","tags":["apiKey"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiKeyDtoAstroResult"}}}}},"requestBody":{"description":"Options for the API key to create","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiKeyCreateDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/api-keys/revoke-all":{"delete":{"operationId":"apiKey_revokeAllApiKeys","summary":"Revoke All Api Keys","description":"This API call revokes all existing API keys in given workspace.  No existing keys will continue to work\r\nafter this call completes.  We strongly encourage you to revoke a single API key at a time; this method\r\nshould only be used if you need to rapidly halt access to your product for automated systems.\r\n            \r\nAn API key is a credential that you can use to make REST v4 API calls for ProjectManager.com.  When you create\r\na new API key, that API key is only visible in the response JSON for the `CreateApiKey` method.  If you do not\r\npreserve this information, it cannot be recreated.\r\n            \r\nSome best practices for working with API keys:\r\n* An API key is valid for a two year period after it is created.  We encourage you to rotate your API keys\r\nregularly according to your company's security policies.\r\n* You should create separate API keys for each system that works with your API.  If that API key is exposed\r\nor if that program needs to be shut down, you can revoke that one key and reissue it.\r\n* An API key is tied to the workspace that created it. A single API key can only interact with one workspace.","tags":["apiKey"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/api-keys/{id}/revoke":{"delete":{"operationId":"apiKey_revokeApiKey","summary":"Revoke API Key","description":"Revokes a single API key in the current workspace.\r\n            \r\nAn API key is a credential that you can use to make REST v4 API calls for ProjectManager.com.  When you create\r\na new API key, that API key is only visible in the response JSON for the `CreateApiKey` method.  If you do not\r\npreserve this information, it cannot be recreated.\r\n            \r\nSome best practices for working with API keys:\r\n* An API key is valid for a two year period after it is created.  We encourage you to rotate your API keys\r\nregularly according to your company's security policies.\r\n* You should create separate API keys for each system that works with your API.  If that API key is exposed\r\nor if that program needs to be shut down, you can revoke that one key and reissue it.\r\n* An API key is tied to the workspace that created it. A single API key can only interact with one workspace.","tags":["apiKey"],"parameters":[{"name":"id","in":"path","description":"The unique identifier of the API key to revoke","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/changesets/{changeSetId}":{"get":{"operationId":"changeset_retrieveChangesetStatus","summary":"Retrieve Changeset status","description":"Retrieve a Changeset by its unique ID.\r\n            \r\nA Changeset is an individual edit that has been made to a project.  Since multiple users can\r\nedit a project at the same time, individual Changesets are applied in a sequential fashion. If\r\na Changeset causes a conflict or cannot be applied, it will be rejected.  You can examine a\r\nChangeset to determine its conflict resolution status.\r\n            \r\nWhen checking the status of a Changeset, you can call either RetrieveChangeset or\r\nRetrieveCompletedChangeset.  Using RetrieveChangeset will give you the immediate status of the\r\nChangeset.  Using RetrieveCompletedChangeset will delay the response until the Changeset has\r\nfinished processing.","tags":["changeset"],"parameters":[{"name":"changeSetId","in":"path","description":"The unique ID number of the Changeset to retrieve","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectChangeStatusDtoAstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/changesets/{changeSetId}/poll":{"get":{"operationId":"changeset_retrieveCompletedChangesetStatus","summary":"Retrieve Completed Changeset status","description":"Retrieve a Changeset by its unique ID. This endpoint waits for the Changeset to complete its\r\nprocessing prior to returning a result.\r\n            \r\nA Changeset is an individual edit that has been made to a project.  Since multiple users can\r\nedit a project at the same time, individual Changesets are applied in a sequential fashion. If\r\na Changeset causes a conflict or cannot be applied, it will be rejected.  You can examine a\r\nChangeset to determine its conflict resolution status.\r\n            \r\nWhen checking the status of a Changeset, you can call either RetrieveChangeset or\r\nRetrieveCompletedChangeset.  Using RetrieveChangeset will give you the immediate status of the\r\nChangeset.  Using RetrieveCompletedChangeset will delay the response until the Changeset has\r\nfinished processing.\r\n            \r\nAlthough most Changesets complete instantly, some Changesets may need additional time to\r\ncomplete.  If the Changeset cannot be processed within a reasonable length of time, this API\r\ncall may fail.  If this API fails, it will return a status error indicating the Changeset is\r\nstill being processed.","tags":["changeset"],"parameters":[{"name":"changeSetId","in":"path","description":"The unique ID number of the Changeset to retrieve","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectChangeStatusDtoAstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/countries":{"get":{"operationId":"country_retrievesAListOfAllCountries","summary":"Retrieves a list of all countries.","description":"This method returns a list of all countries available in the system.\r\n\r\nEach country includes its unique identifier (ISO2 code) and name.","tags":["country"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CountryDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/countries/{isoCode}/states":{"get":{"operationId":"country_retrievesAListOfStatesForAGivenCountryIsoCode","summary":"Retrieves a list of states for a given country ISO code.","description":"This method returns a list of all states for the specified country.\r\n\r\nEach state includes its unique identifier, state code, and name.","tags":["country"],"parameters":[{"name":"isoCode","in":"path","description":"The ISO code of the country.","required":true,"schema":{"type":"string"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/StateDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/tasks/{taskId}/comments":{"post":{"operationId":"discussion_createTaskComment","summary":"Create Task Comment","description":"Adds a Markdown-formatted comment to a task.\r\n            \r\nTasks can have discussions attached to them.  These discussions can include text with simple\r\nformatting.  Discussion comments are formatted using [Markdown](https://www.markdownguide.org/)\r\nand users should be aware that HTML embedding is not permitted due to the risk of cross-site\r\nattacks and other embedding challenges.","tags":["discussion"],"parameters":[{"name":"taskId","in":"path","description":"The unique ID number of the task being commented upon","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DiscussionCommentCreateResponseDtoAstroResult"}}}}},"requestBody":{"description":"The Markdown-formatted text of the comment","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DiscussionCommentCreateDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/comments/{commentId}/like":{"post":{"operationId":"discussion_likeComment","summary":"Like Comment","description":"Puts a thumbsup on a comment","tags":["discussion"],"parameters":[{"name":"commentId","in":"path","description":"the id of the comment","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AstroResult"}}}}},"security":[{"oauth2":[]}]},"delete":{"operationId":"discussion_unlikeComment","summary":"Unlike Comment","description":"Unlike a comment that was previously liked","tags":["discussion"],"parameters":[{"name":"commentId","in":"path","description":"the id of the comment","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/comments/{commentId}":{"delete":{"operationId":"discussion_removeComment","summary":"Remove Comment","description":"Removes a comment by it's id","tags":["discussion"],"parameters":[{"name":"commentId","in":"path","description":"Remove a comment","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/tasks/{taskId}/discussions":{"get":{"operationId":"discussion_retrieveTaskComments","summary":"Retrieve Task Comments","description":"Retrieve all comments written about a task","tags":["discussion"],"parameters":[{"name":"taskId","in":"path","description":"The unique ID number of the task to retrieve comments","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DiscussionCommentDtoListAstroResult"}}}}},"deprecated":true,"security":[{"oauth2":[]}]},"post":{"operationId":"discussion_createTaskComments","summary":"Create Task Comments","description":"Adds a Markdown-formatted comment to a task.\r\n            \r\nTasks can have discussions attached to them.  These discussions can include text with simple\r\nformatting.  Discussion comments are formatted using [Markdown](https://www.markdownguide.org/)\r\nand users should be aware that HTML embedding is not permitted due to the risk of cross-site\r\nattacks and other embedding challenges.","tags":["discussion"],"parameters":[{"name":"taskId","in":"path","description":"The unique ID number of the task being commented upon","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DiscussionCommentCreateResponseDtoAstroResult"}}}}},"deprecated":true,"requestBody":{"description":"The Markdown-formatted text of the comment","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DiscussionCommentCreateDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/files/{documentId}/download":{"get":{"operationId":"file_downloadFile","summary":"Download File","description":"Downloads the contents of a file that was previously uploaded to ProjectManager.com.\r\n            \r\nProjectManager allows you to store Files connected to other elements of your Workspace\r\nsuch as a Project, a Task, or Home.  Files are maintained separately based on the location\r\nwhere the file was stored.\r\n            \r\nWhen you upload a File, please allow a few moments for the File to be processed and verified.\r\nProjectManager may reject File uploads that contain problems such as malware. Once a File has\r\ncompleted the upload the process, you may retrieve it using the DownloadFile API.\r\n            \r\nIf successful, this API returns the file contents as an octet-stream (raw bytes).  If an error\r\noccurs, you will receive a JSON result with error information.","tags":["file"],"parameters":[{"name":"documentId","in":"path","description":"The unique identifier of the document to download","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"type","in":"query","description":"If you specify a type of `html`, processes the file using text encoding. A type of `inline` displays PDF files in the browser. Otherwise, returns a download.","required":false,"schema":{"type":"string"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"string","format":"byte"}}}}},"security":[{"oauth2":[]}]}},"/api/data/files/{documentId}/thumbnail":{"get":{"operationId":"file_downloadAThumbnailImage","summary":"Download a Thumbnail Image","description":"Downloads a thumbnail image associated with a document that was previously uploaded to ProjectManager.com.\r\n            \r\nProjectManager allows you to store files linked to various elements within your Workspace,\r\nsuch as Projects, Tasks, or your Home. Files are organized based on their storage location.\r\n            \r\nWhen uploading a file, please allow some time for the file to undergo processing and verification.\r\nProjectManager may reject file uploads containing issues such as malware. Once a file has\r\ncompleted the upload process, you can retrieve its associated thumbnail using the DownloadThumbnail API.\r\n            \r\nIf successful, this API returns the file contents as an octet-stream (raw bytes).  If an error\r\noccurs, you will receive a JSON result with error information.","tags":["file"],"parameters":[{"name":"documentId","in":"path","description":"The unique identifier of the document for which to download the thumbnail.","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"string","format":"byte"}}}}},"security":[{"oauth2":[]}]}},"/api/data/files/{fileId}":{"put":{"operationId":"file_updateFile","summary":"Update File","description":"Updates information about a File uploaded to your Workspace.\r\n            \r\nProjectManager allows you to store Files connected to other elements of your Workspace\r\nsuch as a Project, a Task, or Home.  Files are maintained separately based on the location\r\nwhere the file was stored.\r\n            \r\nWhen you upload a File, please allow a few moments for the File to be processed and verified.\r\nProjectManager may reject File uploads that contain problems such as malware. Once a File has\r\ncompleted the upload the process, you may retrieve it using the DownloadFile API.\r\n            \r\nThis API returns a JSON response indicating success or failure.","tags":["file"],"parameters":[{"name":"fileId","in":"path","description":"The unique identifier of the File to update","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AstroResult"}}}}},"requestBody":{"description":"Information to change about the File and its location","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateRequestDto"}}}},"security":[{"oauth2":[]}]},"delete":{"operationId":"file_deleteFile","summary":"Delete file","description":"In case of soft delete moves file to trash folder. For hard delete completely deletes\r\nfile's metadata from pm database as well as from amazon storage\r\n            \r\nThis API returns a JSON response indicating success or failure.","tags":["file"],"parameters":[{"name":"fileId","in":"path","description":"The unique identifier of the File to delete","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"hard","in":"query","description":"Param indicates that file should be hard deleted","required":false,"schema":{"type":"boolean"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/holidays/resource":{"get":{"operationId":"holiday_queryResourceHolidays","summary":"Query resource holidays","description":"Retrieve a list of resource holidays that match an [OData formatted query](https://www.odata.org/).","tags":["holiday"],"parameters":[{"name":"$top","in":"query","description":"The number of records to return","required":false,"schema":{"type":"integer"}},{"name":"$skip","in":"query","description":"Skips the given number of records and then returns $top records","required":false,"schema":{"type":"integer"}},{"name":"$filter","in":"query","description":"Filter the expression according to oData queries","required":false,"schema":{"type":"string"}},{"name":"$orderby","in":"query","description":"Order collection by this field.","required":false,"schema":{"type":"string"}},{"name":"$expand","in":"query","description":"Include related data in the response","required":false,"schema":{"type":"string"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ResourceHolidayDtoListAstroResult"}}}}},"deprecated":true,"security":[{"oauth2":[]}]}},"/api/data/holidays/country":{"get":{"operationId":"holiday_queryCountryHolidays","summary":"Query country holidays","description":"Retrieve a list of country holidays that match an [OData formatted query](https://www.odata.org/).","tags":["holiday"],"parameters":[{"name":"$top","in":"query","description":"The number of records to return","required":false,"schema":{"type":"integer"}},{"name":"$skip","in":"query","description":"Skips the given number of records and then returns $top records","required":false,"schema":{"type":"integer"}},{"name":"$filter","in":"query","description":"Filter the expression according to oData queries","required":false,"schema":{"type":"string"}},{"name":"$orderby","in":"query","description":"Order collection by this field.","required":false,"schema":{"type":"string"}},{"name":"$expand","in":"query","description":"Include related data in the response","required":false,"schema":{"type":"string"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CountryHolidayDtoListAstroResult"}}}}},"deprecated":true,"security":[{"oauth2":[]}]}},"/api/data/holidays/global":{"get":{"operationId":"holiday_queryGlobalHolidays","summary":"Query global holidays","description":"Retrieve a list of global holidays that match an [OData formatted query](https://www.odata.org/).","tags":["holiday"],"parameters":[{"name":"$top","in":"query","description":"The number of records to return","required":false,"schema":{"type":"integer"}},{"name":"$skip","in":"query","description":"Skips the given number of records and then returns $top records","required":false,"schema":{"type":"integer"}},{"name":"$filter","in":"query","description":"Filter the expression according to oData queries","required":false,"schema":{"type":"string"}},{"name":"$orderby","in":"query","description":"Order collection by this field.","required":false,"schema":{"type":"string"}},{"name":"$expand","in":"query","description":"Include related data in the response","required":false,"schema":{"type":"string"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/GlobalHolidayDtoListAstroResult"}}}}},"deprecated":true,"security":[{"oauth2":[]}]}},"/api/data/holidays":{"get":{"operationId":"holidays_listsHolidayDefinitionsForTheCurrentWorkspace","summary":"Lists holiday definitions for the current workspace.","description":"Returns a summary per holiday, ordered by name.","tags":["holidays"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HolidayListItemDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]},"post":{"operationId":"holidays_createsAHolidayOmitResourceIdsAndCountryIdForGlobalScopeSetOneListForPeopleOrCountryScope","summary":"Creates a holiday. Omit ResourceIds and CountryId for global scope; set one list for people or country scope.","description":"Persists the definition in one transaction. One occurrence is stored for each day from DateFrom through DateTo\r\n(inclusive), each as a full calendar day off. Omit CountryId and ResourceIds for a workspace-wide holiday; set one list\r\nfor people or country scope. Each CountryId is an ISO 3166-1 alpha-2 string (for example NZ). The inclusive range is capped\r\n(see server validation) to limit payload size.","tags":["holidays"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HolidayDetailDtoListAstroResult"}}}}},"requestBody":{"description":"Name, date range, and optional country or resource targeting.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HolidayCreateDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/holidays/{id}":{"get":{"operationId":"holidays_getsASingleHolidayDefinition","summary":"Gets a single holiday definition.","description":"Returns HTTP 404 if the holiday does not exist or is not in the workspace.","tags":["holidays"],"parameters":[{"name":"id","in":"path","description":"Public identifier of the holiday (GUID).","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HolidayDetailDtoAstroResult"}}}}},"security":[{"oauth2":[]}]},"put":{"operationId":"holidays_updatesAHolidayDisplayName","summary":"Updates a holiday display name.","description":"Only the name can be changed. Dates, occurrences, and country or resource scope are set at create time and are not modified by this endpoint.","tags":["holidays"],"parameters":[{"name":"id","in":"path","description":"Public identifier of the holiday to update (GUID).","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HolidayDetailDtoAstroResult"}}}}},"requestBody":{"description":"The new display name.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HolidayUpdateDto"}}}},"security":[{"oauth2":[]}]},"delete":{"operationId":"holidays_deletesAHolidayDefinitionAndItsOccurrencesAndAssignmentsCascadeInTheDatabase","summary":"Deletes a holiday definition and its occurrences and assignments (cascade in the database).","description":"Removes the definition and all child occurrence and assignment rows. Succeeds if the holiday has already been deleted.","tags":["holidays"],"parameters":[{"name":"id","in":"path","description":"Public identifier of the holiday to delete (GUID).","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/home/files":{"post":{"operationId":"homeFile_uploadHomeFile","summary":"Upload Home File","description":"Uploads a file to the My Files folder on your Home Files page.\r\n            \r\nProjectManager allows you to store Files connected to other elements of your Workspace\r\nsuch as a Project, a Task, or Home.  Files are maintained separately based on the location\r\nwhere the file was stored.\r\n            \r\nWhen you upload a File, please allow a few moments for the File to be processed and verified.\r\nProjectManager may reject File uploads that contain problems such as malware. Once a File has\r\ncompleted the upload the process, you may retrieve it using the DownloadFile API.\r\n            \r\nThis API returns a JSON response indicating success or failure.","tags":["homeFile"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/FileDtoAstroResult"}}}}},"requestBody":{"content":{"multipart/form-data":{"schema":{"type":"object","properties":{"file":{"type":"string","format":"binary"}}}}}},"security":[{"oauth2":[]}]}},"/api/data/home/folders/{folderId}/files":{"post":{"operationId":"homeFile_uploadHomeFileToFolder","summary":"Upload Home File To Folder","description":"Uploads a file to a specific folder on your Home Files page.\r\n            \r\nProjectManager allows you to store Files connected to other elements of your Workspace\r\nsuch as a Project, a Task, or Home.  Files are maintained separately based on the location\r\nwhere the file was stored.\r\n            \r\nYou can organize your files in the Home Files and Project Files pages by adding folders.\r\n            \r\nWhen you upload a File, please allow a few moments for the File to be processed and verified.\r\nProjectManager may reject File uploads that contain problems such as malware. Once a File has\r\ncompleted the upload the process, you may retrieve it using the DownloadFile API.\r\n            \r\nThis API returns a JSON response indicating success or failure.","tags":["homeFile"],"parameters":[{"name":"folderId","in":"path","description":"The reference to the sub folder to put the file into","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/FileDtoAstroResult"}}}}},"requestBody":{"content":{"multipart/form-data":{"schema":{"type":"object","properties":{"file":{"type":"string","format":"binary"}}}}}},"security":[{"oauth2":[]}]}},"/api/data/hourly-rates":{"get":{"operationId":"hourlyRate_getHourlyRates","summary":"Get Hourly Rates","description":"All hourly rates including Inactive rates","tags":["hourlyRate"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HourlyRateDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]},"post":{"operationId":"hourlyRate_createHourlyRate","summary":"Create Hourly Rate","description":"Create a hourly rate","tags":["hourlyRate"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HourlyRateDtoAstroResult"}}}}},"requestBody":{"description":"The rate data.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HourlyRateCreateDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/hourly-rates/values/{rateValueId}":{"put":{"operationId":"hourlyRate_updateHourlyRateValue","summary":"Update Hourly Rate Value","description":"Update Hourly Rate Value","tags":["hourlyRate"],"parameters":[{"name":"rateValueId","in":"path","description":"The rate valueId","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HourlyRateValueDtoAstroResult"}}}}},"requestBody":{"description":"The rate value data","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HourlyRateValueUpdateDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/hourly-rates/{rateId}":{"get":{"operationId":"hourlyRate_getHourlyRate","summary":"Get Hourly Rate","description":"Get Hourly Rate","tags":["hourlyRate"],"parameters":[{"name":"rateId","in":"path","description":"The unique identifier for the rate","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HourlyRateDetailsDtoAstroResult"}}}}},"security":[{"oauth2":[]}]},"delete":{"operationId":"hourlyRate_deleteHourlyRate","summary":"Delete Hourly Rate","description":"Delete a hourly rate","tags":["hourlyRate"],"parameters":[{"name":"rateId","in":"path","description":"The rate Id.","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/hourly-rate-periods":{"get":{"operationId":"hourlyRatePeriod_getRatePeriods","summary":"Get Rate Periods","description":"Gets a list of all rate periods in a work space","tags":["hourlyRatePeriod"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HourlyRatePeriodDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]},"post":{"operationId":"hourlyRatePeriod_createRatePeriod","summary":"Create Rate Period","description":"Creates a rate period","tags":["hourlyRatePeriod"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HourlyRatePeriodDtoAstroResult"}}}}},"requestBody":{"description":"The rate period start date.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HourlyRatePeriodCreateDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/integrations/{integrationId}":{"get":{"operationId":"integration_retrieveIntegration","summary":"Retrieve Integration","description":"Retrieves an Integration specified by a unique identifier.\r\n            \r\nThe Integrations API is intended for use by ProjectManager and its business development partners.  Please\r\ncontact ProjectManager's sales team to request use of this API.","tag