"},"level":{"type":"integer","description":"The hierarchical level of this Task within the Task structure.\r\n            \r\nA Level of 1 indicates that the Task is at the top level (e.g. a root Task),\r\nwhile higher values indicate deeper levels in the hierarchy (e.g. subtasks)."},"fields":{"type":["array","null"],"items":{"$ref":"#/components/schemas/TaskFieldValueDto"},"description":"Obsolete - use FieldValues instead","deprecated":true},"fieldValues":{"type":["array","null"],"items":{"$ref":"#/components/schemas/SimpleTaskFieldValueDto"},"description":"Task fields array with values"},"files":{"type":["array","null"],"items":{"$ref":"#/components/schemas/TaskFileDto"},"description":"The list of files associated with this Task, if any.\r\n            \r\nThis field will be present when you fetch a single object.\r\nWhen you query for multiple objects, this field is not included in results by default.\r\nTo expand this field, specify the name of this field in the `$expand` parameter."},"parentTaskId":{"type":["string","null"],"format":"uuid","description":"The parent task of this Task."},"childTaskCount":{"type":["integer","null"],"description":"The number of child tasks"},"parentTaskName":{"type":["string","null"],"description":"The name for the parent task of this Task."},"ownerId":{"type":["string","null"],"format":"uuid","description":"The ownerId of this Task."},"owner":{"oneOf":[{"$ref":"#/components/schemas/TaskOwnerDto"},{"type":"null"}],"description":"The owner of this Task."},"recurring":{"type":["boolean","null"],"description":"If this is a recurring task"},"recurringParentTaskId":{"type":["string","null"],"format":"uuid","description":"The parent task in the recurring task sequence"},"recurringSettings":{"oneOf":[{"$ref":"#/components/schemas/RecurringTaskSettingsDto"},{"type":"null"}],"description":"The Task Recurrency settings"},"approvalStatus":{"type":["string","null"],"description":"The Task Approval Status"},"approvalStatusModifiedBy":{"type":["