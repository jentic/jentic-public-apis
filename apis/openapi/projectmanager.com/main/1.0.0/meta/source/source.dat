ion of Tasks that contributes towards a goal.  Within a Project, Tasks\r\nrepresent individual items of work that team members must complete.  The sum total of Tasks\r\nwithin a Project represents the work to be completed for that Project.","title":"MeetingProjectDto"},"MeetingDto":{"type":"object","properties":{"id":{"type":"string","format":"uuid","description":"The unique identifier of the Meeting"},"name":{"type":"string","description":"The common name of this Meeting."},"description":{"type":["string","null"],"description":"This field contains the Meeting's description."},"plannedStartDate":{"type":["string","null"],"format":"date-time","description":"The planned start date/time for this Meeting, in UTC.\r\nClients should convert to local time only when displaying to the user."},"plannedFinishDate":{"type":["string","null"],"format":"date-time","description":"The planned finish date/time for this Meeting, in UTC.\r\nClients should convert to local time only when displaying to the user."},"plannedDuration":{"type":["integer","null"],"description":"The planned duration (in minutes) for this Meeting."},"plannedEffort":{"type":["integer","null"],"description":"The planned effort (in minutes) for this Meeting."},"priorityId":{"type":["integer","null"],"description":"Return the priority of a Meeting"},"assignees":{"type":"array","items":{"$ref":"#/components/schemas/MeetingAssigneeDto"},"description":"The list of resources assigned to this Meeting"},"shortId":{"type":["string","null"],"description":"A short ID that can be used to refer to this Meeting. This short ID is\r\nguaranteed to be unique within your Workspace."},"tags":{"type":["array","null"],"items":{"$ref":"#/components/schemas/TaskTagDto"},"description":"The tags that apply to this Meeting."},"todos":{"type":["array","null"],"items":{"$ref":"#/components/schemas/TaskTodoDto"},"description":"A list of todo items for this Meeting."},"createDate":{"type":"string","format":"date-time","description":"Timestamp