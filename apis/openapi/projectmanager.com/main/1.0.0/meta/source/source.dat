ation-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/integrations":{"get":{"operationId":"integration_retrieveAllIntegrations","summary":"Retrieve All Integrations","description":"Retrieves all Integrations for the current Workspace.\r\n            \r\nThe Integrations API is intended for use by ProjectManager and its business development partners.  Please\r\ncontact ProjectManager's sales team to request use of this API.","tags":["integration"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/IntegrationDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/integrations/categories":{"get":{"operationId":"integrationCategory_retrieveProviderCategories","summary":"Retrieve Provider Categories","description":"Retrieves the list of available IntegrationProvider categories.\r\n            \r\nAn IntegrationProvider is the name of an external application or service that can be connected to\r\nProjectManager.com.  The Integrations API is intended for use by ProjectManager and its business\r\ndevelopment partners.  Please contact ProjectManager's sales team to request use of this API.","tags":["integrationCategory"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/IntegrationCategoryDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/integrations/providers":{"get":{"operationId":"integrationProvider_listProviders","summary":"List Providers","description":"List all available IntegrationProviders that can be activated.\r\n            \r\nAn IntegrationProvider is the name of an external application or service that can be connected to\r\nProjectManager.com.  The Integrations API is intended for use by ProjectManager and its business\r\ndevelopment partners.  Please contact ProjectManager's sales team to request use of this API.","tags":["integrationProvider"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/IntegrationProviderDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/integrations/providers/{providerId}":{"post":{"operationId":"integrationProvider_activateIntegrationProvider","summary":"Activate Integration Provider","description":"Activates an Integration Provider and retrieves authentication information about a specific IntegrationProvider.\r\n            \r\nAn IntegrationProvider is the name of an external application or service that can be connected to\r\nProjectManager.com.  The Integrations API is intended for use by ProjectManager and its business\r\ndevelopment partners.  Please contact ProjectManager's sales team to request use of this API.","tags":["integrationProvider"],"parameters":[{"name":"providerId","in":"path","description":"The unique identifier of the IntegrationProvider for which you are requesting authentication information","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ConnectionSchemaDtoAstroResult"}}}}},"security":[{"oauth2":[]}]},"put":{"operationId":"integrationProvider_updateIntegrationProvider","summary":"Update Integration Provider","description":"Allows you to update the auth status of the provider specific connection.\r\n            \r\nAn IntegrationProvider is the name of an external application or service that can be connected to\r\nProjectManager.com.  The Integrations API is intended for use by ProjectManager and its business\r\ndevelopment partners.  Please contact ProjectManager's sales team to request use of this API.","tags":["integrationProvider"],"parameters":[{"name":"providerId","in":"path","description":"The identifier to the provider","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AstroResult"}}}}},"requestBody":{"description":"Specify the auth status","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AuthenticationDto"}}}},"security":[{"oauth2":[]}]},"delete":{"operationId":"integrationProvider_deactivateIntegrationProvider","summary":"Deactivate Integration Provider","description":"Allows you to deactivate an integration provider.\r\n            \r\nAn IntegrationProvider is the name of an external application or service that can be connected to\r\nProjectManager.com.  The Integrations API is intended for use by ProjectManager and its business\r\ndevelopment partners.  Please contact ProjectManager's sales team to request use of this API.","tags":["integrationProvider"],"parameters":[{"name":"providerId","in":"path","description":"The identifier to the provider","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/integrations/providers/{providerId}/user-connection":{"post":{"operationId":"integrationProvider_createUserIntegrationProviderConnection","summary":"Create User Integration Provider Connection","description":"Retrieves user authentication information about a specific IntegrationProvider.\r\n            \r\nThis connection can be used for requests to Providers that require specific user data.\r\n            \r\nAn IntegrationProvider is the name of an external application or service that can be connected to\r\nProjectManager.com.  The Integrations API is intended for use by ProjectManager and its business\r\ndevelopment partners.  Please contact ProjectManager's sales team to request use of this API.","tags":["integrationProvider"],"parameters":[{"name":"providerId","in":"path","description":"The unique identifier of the IntegrationProvider for which you are requesting authentication information","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ConnectionSchemaDtoAstroResult"}}}}},"security":[{"oauth2":[]}]},"put":{"operationId":"integrationProvider_updateUserIntegrationProviderConnection","summary":"Update User Integration Provider Connection","description":"Allows you to update the auth status of the provider specific user connection.\r\n            \r\nAn IntegrationProvider is the name of an external application or service that can be connected to\r\nProjectManager.com.  The Integrations API is intended for use by ProjectManager and its business\r\ndevelopment partners.  Please contact ProjectManager's sales team to request use of this API.","tags":["integrationProvider"],"parameters":[{"name":"providerId","in":"path","description":"The identifier to the provider","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AstroResult"}}}}},"requestBody":{"description":"Specify the auth status","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AuthenticationDto"}}}},"security":[{"oauth2":[]}]},"delete":{"operationId":"integrationProvider_disconnectUserIntegrationProviderConnection","summary":"Disconnect User Integration Provider Connection","description":"Allows you to disconnect the provider specific user connection.\r\n            \r\nAn IntegrationProvider is the name of an external application or service that can be connected to\r\nProjectManager.com.  The Integrations API is intended for use by ProjectManager and its business\r\ndevelopment partners.  Please contact ProjectManager's sales team to request use of this API.","tags":["integrationProvider"],"parameters":[{"name":"providerId","in":"path","description":"The identifier to the provider","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/license":{"get":{"operationId":"license_retrieveLicenses","summary":"Retrieve Licenses","description":"Retrieve information about the current licenses possessed by this Workspace.\r\n            \r\nLicenses contain information about your current subscription level and features that have\r\nbeen enabled on your Workspace.  To modify the License information, please log on to the\r\nProjectManager.com application and use the Account | Editions screen to review or update\r\nyour Licenses.","tags":["license"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/LicenseDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/license/{bundleSku}/try":{"post":{"operationId":"license_addLicense","summary":"Add License","description":"Adds a new License to the current Workspace.\r\n            \r\nLicenses contain information about your current subscription level and features that have\r\nbeen enabled on your Workspace.  To modify the License information, please log on to the\r\nProjectManager.com application and use the Account | Editions screen to review or update\r\nyour Licenses.","tags":["license"],"parameters":[{"name":"bundleSku","in":"path","description":"Information about the SKU you wish to add to your Workspace","required":true,"schema":{"type":"string"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/LicenseDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/me":{"get":{"operationId":"me_retrieveMe","summary":"Retrieve Me","description":"Retrieve information about the currently logged on user.\r\n            \r\nThis API call will always succeed with a 200 OK if called with valid authentication information.\r\nIf the authentication information provided is not valid, calling this API will return a 401\r\nAuthentication Failed error message.  If successful, this API returns information about the user\r\nincluding its home URL, email address, user name, and workspace name.","tags":["me"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WorkSpaceUserInfoDtoAstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/me/avatar":{"post":{"operationId":"me_updateMyAvatar","summary":"Update My Avatar","description":"Updates the logged in user avatar","tags":["me"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AstroResult"}}}}},"requestBody":{"content":{"multipart/form-data":{"schema":{"type":"object","properties":{"file":{"type":"string","format":"binary"}}}}}},"security":[{"oauth2":[]}]},"delete":{"operationId":"me_removeMyAvatar","summary":"Remove My Avatar","description":"Removes the logged in user's custom avatar so the default initials are shown.","tags":["me"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/meetings/{meetingId}/recurring/weekly":{"post":{"operationId":"meetingRecurrency_createWeeklyRecurringMeetings","summary":"Create Weekly Recurring Meetings","description":"Changes an existing Meeting into a Recurring Meeting, so that it will recur regularly given the specified\r\nrules.\r\n            \r\nA Recurring Meeting is one that occurs on a specific regular frequency, such as Daily, Weekly, Monthly,\r\nor Yearly. To create a Recurring Meeting, you must first create a regular Meeting with the necessary information,\r\nthen call one of the Create Recurring Meeting APIs. To remove an instance of a Recurring Meeting, call Delete\r\nRecurring Meeting and specify one or more instances of the Recurring Meeting.","tags":["meetingRecurrency"],"parameters":[{"name":"meetingId","in":"path","description":"The unique identifier of the Meeting","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RecurringTaskChangeSetDetailsAstroResult"}}}}},"requestBody":{"description":"The weekly recurring settings","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WeeklyRecurringSettingsDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/meetings/{meetingId}/recurring/monthly":{"post":{"operationId":"meetingRecurrency_createMonthlyRecurringMeetings","summary":"Create Monthly Recurring Meetings","description":"Changes an existing Meeting into a Recurring Meeting, so that it will recur regularly given the specified\r\nrules.\r\n            \r\nA Recurring Meeting is one that occurs on a specific regular frequency, such as Daily, Weekly, Monthly,\r\nor Yearly. To create a Recurring Meeting, you must first create a regular Meeting with the necessary information,\r\nthen call one of the Create Recurring Meeting APIs. To remove an instance of a Recurring Meeting, call Delete\r\nRecurring Meeting and specify one or more instances of the Recurring Meeting.","tags":["meetingRecurrency"],"parameters":[{"name":"meetingId","in":"path","description":"The unique identifier of the Meeting","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RecurringTaskChangeSetDetailsAstroResult"}}}}},"requestBody":{"description":"The monthly recurring settings","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MonthlyRecurringSettingsDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/meetings/{meetingId}/recurring/daily":{"post":{"operationId":"meetingRecurrency_createDailyRecurringMeetings","summary":"Create Daily Recurring Meetings","description":"Changes an existing Meeting into a Recurring Meeting, so that it will recur regularly given the specified\r\nrules.\r\n            \r\nA Recurring Meeting is one that occurs on a specific regular frequency, such as Daily, Weekly, Monthly,\r\nor Yearly. To create a Recurring Meeting, you must first create a regular Meeting with the necessary information,\r\nthen call one of the Create Recurring Meeting APIs. To remove an instance of a Recurring Meeting, call Delete\r\nRecurring Meeting and specify one or more instances of the Recurring Meeting.","tags":["meetingRecurrency"],"parameters":[{"name":"meetingId","in":"path","description":"The unique identifier of the Meeting","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RecurringTaskChangeSetDetailsAstroResult"}}}}},"requestBody":{"description":"The daily recurring settings","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DailyRecurringSettingsDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/meetings/{meetingId}/recurring/yearly":{"post":{"operationId":"meetingRecurrency_createYearlyRecurringMeetings","summary":"Create Yearly Recurring Meetings","description":"Changes an existing Meeting into a Recurring Meeting, so that it will recur regularly given the specified\r\nrules.\r\n            \r\nA Recurring Meeting is one that occurs on a specific regular frequency, such as Daily, Weekly, Monthly,\r\nor Yearly. To create a Recurring Meeting, you must first create a regular Meeting with the necessary information,\r\nthen call one of the Create Recurring Meeting APIs. To remove an instance of a Recurring Meeting, call Delete\r\nRecurring Meeting and specify one or more instances of the Recurring Meeting.","tags":["meetingRecurrency"],"parameters":[{"name":"meetingId","in":"path","description":"The unique identifier of the Meeting","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RecurringTaskChangeSetDetailsAstroResult"}}}}},"requestBody":{"description":"The yearly recurring settings","content":{"application/json":{"schema":{"$ref":"#/components/schemas/YearlyRecurringSettingsDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/meetings/{meetingId}/recurring/{option}":{"delete":{"operationId":"meetingRecurrency_deleteRecurringMeetings","summary":"Delete Recurring Meetings","description":"Removes one or more instances of a Recurring Meeting based on the `option` you specify: `this` means\r\nto remove a single instance, `all` means to remove all instances, or `future` means to remove all future\r\ninstances of the Recurring Meeting.\r\n            \r\nA Recurring Meeting is one that occurs on a specific regular frequency, such as Daily, Weekly, Monthly,\r\nor Yearly. To create a Recurring Meeting, you must first create a regular Meeting with the necessary information,\r\nthen call one of the Create Recurring Meeting APIs. To remove an instance of a Recurring Meeting, call Delete\r\nRecurring Meeting and specify one or more instances of the Recurring Meeting.","tags":["meetingRecurrency"],"parameters":[{"name":"meetingId","in":"path","description":"The unique identifier of the Recurring Meeting","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"option","in":"path","description":"The options for the deletion","required":true,"schema":{"type":"string"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DeletedTasksDtoAstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/meetings/{meetingId}/recurring/settings/validate":{"post":{"operationId":"meetingRecurrency_validateRecurringMeetingSettings","summary":"Validate Recurring Meeting settings","description":"Reviews potential updates to a Recurring Meeting and report back on the list of changes that would\r\noccur if this Recurring Meeting was updated with these settings.\r\n            \r\nWhen making changes to a Recurring Meeting, you may want to investigate the consequences of your changes first\r\nbefore finalizing the changes. You can use the Validate Recurring Meetings API to examine these changes. When\r\nyou are happy with the changes, call Update Recurring Meetings to complete them.\r\n            \r\nA Recurring Meeting is one that occurs on a specific regular frequency, such as Daily, Weekly, Monthly,\r\nor Yearly. To create a Recurring Meeting, you must first create a regular Meeting with the necessary information,\r\nthen call one of the Create Recurring Meeting APIs. To remove an instance of a Recurring Meeting, call Delete\r\nRecurring Meeting and specify one or more instances of the Recurring Meeting.","tags":["meetingRecurrency"],"parameters":[{"name":"meetingId","in":"path","description":"The unique identifier of the Meeting","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RecurringTaskValidationResultDtoAstroResult"}}}}},"requestBody":{"description":"The new settings","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RecurringTaskSettingsDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/meetings/{meetingId}/recurring/settings":{"put":{"operationId":"meetingRecurrency_updateRecurringMeetingSettings","summary":"Update Recurring Meeting settings","description":"Updates the settings for a Recurring Meeting and regenerates occurrences of the Recurring Meeting\r\nfrom the new rules.\r\n            \r\nWhen making changes to a Recurring Meeting, you may want to investigate the consequences of your changes first\r\nbefore finalizing the changes. You can use the Validate Recurring Meetings API to examine these changes. When\r\nyou are happy with the changes, call Update Recurring Meetings to complete them.\r\n            \r\nA Recurring Meeting is one that occurs on a specific regular frequency, such as Daily, Weekly, Monthly,\r\nor Yearly. To create a Recurring Meeting, you must first create a regular Meeting with the necessary information,\r\nthen call one of the Create Recurring Meeting APIs. To remove an instance of a Recurring Meeting, call Delete\r\nRecurring Meeting and specify one or more instances of the Recurring Meeting.","tags":["meetingRecurrency"],"parameters":[{"name":"meetingId","in":"path","description":"The unique identifier of the Meeting","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RecurringTaskChangeSetDetailsAstroResult"}}}}},"requestBody":{"description":"The new settings","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RecurringTaskSettingsDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/meetings":{"get":{"operationId":"meetings_getMeetings","summary":"Get Meetings","description":"Retrieve a list of Meetings.\r\n            \r\nThis endpoint does not use OData. If `projectId` is provided, results are limited to that Project.","tags":["meetings"],"parameters":[{"name":"projectId","in":"query","description":"Optional project id to scope results","required":false,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MeetingDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]},"post":{"operationId":"meetings_createMeeting","summary":"Create Meeting","description":"Creates a new Meeting for the current user.\r\nIf you specify an assignee for this Meeting, that user will be assigned to it.\r\nIf you do not specify an assignee, the Meeting will be automatically assigned to you.","tags":["meetings"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MeetingDtoAstroResult"}}}},"400":{"description":"Bad Request","content":{"application/json":{"schema":{"description":"Any type"}}}}},"requestBody":{"description":"The data used to create the Meeting","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MeetingCreateDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/meetings/{meetingId}":{"get":{"operationId":"meetings_getMeeting","summary":"Get Meeting","description":"Retrieve a Meeting by its unique identifier or by its short ID.\r\nA Meeting has both a unique identifier, which is a GUID, and a short ID, which is a small text label that is unique only within your Workspace.","tags":["meetings"],"parameters":[{"name":"meetingId","in":"path","description":"the id of the meeting","required":true,"schema":{"type":"string"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MeetingDetailsDtoAstroResult"}}}}},"security":[{"oauth2":[]}]},"put":{"operationId":"meetings_updateMeeting","summary":"Update Meeting","description":"Updates a Meeting by its unique identifier, which is a GUID.","tags":["meetings"],"parameters":[{"name":"meetingId","in":"path","description":"the id of the meeting","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MeetingDtoAstroResult"}}}},"400":{"description":"Bad Request","content":{"application/json":{"schema":{"description":"Any type"}}}}},"requestBody":{"description":"the fields to update","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MeetingUpdateDto"}}}},"security":[{"oauth2":[]}]},"delete":{"operationId":"meetings_removeMeeting","summary":"Remove Meeting","description":"Removes a Meeting by its unique identifier, which is a GUID.","tags":["meetings"],"parameters":[{"name":"meetingId","in":"path","description":"the id of the meeting to remove","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/meetings/{meetingId}/tags":{"get":{"operationId":"meetingTag_retrieveTagsForAMeeting","summary":"Retrieve tags for a Meeting","description":"Returns the list of tags assigned to the specified Meeting.","tags":["meetingTag"],"parameters":[{"name":"meetingId","in":"path","description":"The unique identifier of the Meeting","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskTagDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]},"post":{"operationId":"meetingTag_replaceMeetingTags","summary":"Replace Meeting Tags","description":"Replaces the existing tags on a Meeting with a newly provided list.\r\nA tag is a connection between a Meeting and a Tag. Each Meeting can have zero, one or many tags.","tags":["meetingTag"],"parameters":[{"name":"meetingId","in":"path","description":"The unique identifier of the Meeting","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskTagDtoListAstroResult"}}}}},"requestBody":{"description":"The replacement list of tags for this Meeting","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/NameDto"}}}}},"security":[{"oauth2":[]}]},"put":{"operationId":"meetingTag_addTagsToMeeting","summary":"Add tags to Meeting","description":"Add one or more tags to a Meeting.","tags":["meetingTag"],"parameters":[{"name":"meetingId","in":"path","description":"The unique identifier of the Meeting","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskTagDtoListAstroResult"}}}}},"requestBody":{"description":"The tags to add","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/NameDto"}}}}},"security":[{"oauth2":[]}]},"delete":{"operationId":"meetingTag_removeTagsFromMeeting","summary":"Remove tags from Meeting","description":"Removes one or more tags from a Meeting.","tags":["meetingTag"],"parameters":[{"name":"meetingId","in":"path","description":"The unique identifier of the Meeting","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AstroResult"}}}}},"requestBody":{"description":"The tags to remove","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/NameDto"}}}}},"security":[{"oauth2":[]}]}},"/api/data/meetings/{meetingId}/todos":{"get":{"operationId":"meetingTodos_getMeetingTodos","summary":"Get Meeting Todos","description":"Get todos for a meeting","tags":["meetingTodos"],"parameters":[{"name":"meetingId","in":"path","description":"The id of the meeting","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MeetingTodoDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]},"post":{"operationId":"meetingTodos_createMeetingTodos","summary":"Create Meeting Todos","description":"Creates a new todos and associates it with the meeting","tags":["meetingTodos"],"parameters":[{"name":"meetingId","in":"path","description":"The id of the meeting","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MeetingTodoDtoAstroResult"}}}}},"requestBody":{"description":"The todos to create","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MeetingTodoCreateDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/meetings/todos/{todoId}":{"put":{"operationId":"meetingTodos_updateAMeetingTodos","summary":"Update a Meeting Todos","description":"Update a todos","tags":["meetingTodos"],"parameters":[{"name":"todoId","in":"path","description":"The id of the todos","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MeetingTodoDtoAstroResult"}}}}},"requestBody":{"description":"The fields to update","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MeetingTodoUpdateDto"}}}},"security":[{"oauth2":[]}]},"delete":{"operationId":"meetingTodos_removeMeetingTodos","summary":"Remove Meeting Todos","description":"Remove meeting todos","tags":["meetingTodos"],"parameters":[{"name":"todoId","in":"path","description":"The id of the todos to remove","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/notifications":{"get":{"operationId":"notification_retrieveNotifications","summary":"Retrieve Notifications","description":"Retrieve the most recent notifications for the current user, along with the amount of notifications.\r\n            \r\nA notification represents a message sent to a user to inform them of relevant actions or events within their\r\nworkspace. Notifications are ephemeral and may be deleted when they are no longer needed.  When a user has more\r\nthan 1,000 pending notifications some old notifications will be deleted automatically.\r\n            \r\nThis API retrieves 500 notifications at a time.  To fetch more than 500 notifications, repeat this API call\r\nusing the parameter `lastId` of the oldest notification from each batch to fetch the next 500 notifications.","tags":["notification"],"parameters":[{"name":"lastId","in":"query","description":"To continue loading more notifications in a series of requests, provide the ID of the oldest notification from\r\nthe currently loaded batch as the `lastId` parameter","required":false,"schema":{"type":"string","format":"uuid"}},{"name":"senderId","in":"query","description":"Filter the notifications to only those sent by the user with the specified ID","required":false,"schema":{"type":"string","format":"uuid"}},{"name":"notificationTypes","in":"query","description":"Specifies the types of notifications to return.  If not provided, all notifications will be returned.","required":false,"schema":{"type":"array","items":{"type":"string"}}},{"name":"asFlatList","in":"query","description":"If set to true all notifications will be returned as a flat list, otherwise they will be grouped by parent in the same manner as displayed in the UI.","required":false,"schema":{"type":"boolean","default":false}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NotificationResponseDtoAstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/notifications/count":{"get":{"operationId":"notification_count","summary":"Notification Count","description":"Retrieve the total count of pending notifications for the current user.\r\n            \r\nA notification represents a message sent to a user to inform them of relevant actions or events within their\r\nworkspace. Notifications are ephemeral and may be deleted when they are no longer needed.  When a user has more\r\nthan 1,000 pending notifications some old notifications will be deleted automatically.","tags":["notification"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NotificationTotalCountDtoAstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/notifications/unreadcount":{"get":{"operationId":"notification_unreadNotificationCount","summary":"Unread Notification Count","description":"Retrieve the count of unread notifications for the current user.\r\n            \r\nA notification represents a message sent to a user to inform them of relevant actions or events within their\r\nworkspace. Notifications are ephemeral and may be deleted when they are no longer needed.  When a user has more\r\nthan 1,000 pending notifications some old notifications will be deleted automatically.","tags":["notification"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NotificationUnreadCountDtoAstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/notifications/deleteall":{"delete":{"operationId":"notification_deleteAllNotifications","summary":"Delete All Notifications","description":"Delete all pending notifications for the current user.\r\n            \r\nA notification represents a message sent to a user to inform them of relevant actions or events within their\r\nworkspace. Notifications are ephemeral and may be deleted when they are no longer needed.  When a user has more\r\nthan 1,000 pending notifications some old notifications will be deleted automatically.","tags":["notification"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/notifications/{id}/markread":{"post":{"operationId":"notification_markNotificationRead","summary":"Mark Notification Read","description":"Marks a pending notification as read.\r\n            \r\nA notification represents a message sent to a user to inform them of relevant actions or events within their\r\nworkspace. Notifications are ephemeral and may be deleted when they are no longer needed.  When a user has more\r\nthan 1,000 pending notifications some old notifications will be deleted automatically.","tags":["notification"],"parameters":[{"name":"id","in":"path","description":"The unique identifier of the notification to mark read","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NotificationTimestampDtoAstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/notifications/markallread":{"post":{"operationId":"notification_readAllNotifications","summary":"Read All Notifications","description":"Marks all pending notification for the current user as read.\r\n            \r\nA notification represents a message sent to a user to inform them of relevant actions or events within their\r\nworkspace. Notifications are ephemeral and may be deleted when they are no longer needed.  When a user has more\r\nthan 1,000 pending notifications some old notifications will be deleted automatically.","tags":["notification"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NotificationTimestampDtoAstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/notifications/delete/{id}":{"delete":{"operationId":"notification_deleteNotification","summary":"Delete Notification","description":"Deletes a pending notification that is no longer wanted.\r\n            \r\nA notification represents a message sent to a user to inform them of relevant actions or events within their\r\nworkspace. Notifications are ephemeral and may be deleted when they are no longer needed.  When a user has more\r\nthan 1,000 pending notifications some old notifications will be deleted automatically.","tags":["notification"],"parameters":[{"name":"id","in":"path","description":"The unique identifier of the notification to mark read","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/notifications/{id}/markunread":{"post":{"operationId":"notification_markNotificationUnread","summary":"Mark Notification Unread","description":"Marks a pending notification as unread.\r\n            \r\nA notification represents a message sent to a user to inform them of relevant actions or events within their\r\nworkspace. Notifications are ephemeral and may be deleted when they are no longer needed.  When a user has more\r\nthan 1,000 pending notifications some old notifications will be deleted automatically.","tags":["notification"],"parameters":[{"name":"id","in":"path","description":"The unique identifier of the notification to mark read","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/non-project-tasks":{"get":{"operationId":"npt_getNpts","summary":"Get Npts","description":"Retrieve a list of Non-Project Tasks (NPTs).\r\n            \r\nThis endpoint does not use OData.","tags":["npt"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NptDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]},"post":{"operationId":"npt_createNpt","summary":"Create Npt","description":"Creates a new Non-Project Task (NPT) for the current user. If you specify an assignee for this NPT, that user will be assigned to this task. \r\nIf you do not specify an assignee, the NPT will be automatically assigned to you. \r\n \r\nA Non-Project Task (NPT) is an individual element of work that is outside of a project. \r\nMany people use NPTs to track personal work or general administrative work.  NPTs have nearly\r\nall the same features as other tasks, but since they are not part of a project, they can\r\nbe tracked separately by individuals.","tags":["npt"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NptDtoAstroResult"}}}},"400":{"description":"Bad Request","content":{"application/json":{"schema":{"description":"Any type"}}}}},"requestBody":{"description":"The data used to create the Npt","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NptCreateDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/non-project-tasks/{nptId}":{"get":{"operationId":"npt_getNpt","summary":"Get Npt","description":"Retrieve a Non-Project Task (NPT) by its unique identifier or by its short ID.  \r\nAn NPT has both a unique identifier, which is a GUID, and a short ID, which is a small text label that is unique only within your Workspace. \r\n\r\nA Non-Project Task (NPT) is an individual element of work that is outside of a project. \r\nMany people use NPTs to track personal work or general administrative work.  NPTs have nearly\r\nall the same features as other tasks, but since they are not part of a project, they can\r\nbe tracked separately by individuals.","tags":["npt"],"parameters":[{"name":"nptId","in":"path","description":"the id of the npt","required":true,"schema":{"type":"string"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NptDetailsDtoAstroResult"}}}}},"security":[{"oauth2":[]}]},"put":{"operationId":"npt_updateNpt","summary":"Update Npt","description":"Updates a Non-Project Task (NPT) by its unique identifier, which is a GUID.  \r\n\r\nA Non-Project Task (NPT) is an individual element of work that is outside of a project. \r\nMany people use NPTs to track personal work or general administrative work.  NPTs have nearly\r\nall the same features as other tasks, but since they are not part of a project, they can\r\nbe tracked separately by individuals.","tags":["npt"],"parameters":[{"name":"nptId","in":"path","description":"the id of the npt","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NptDtoAstroResult"}}}},"400":{"description":"Bad Request","content":{"application/json":{"schema":{"description":"Any type"}}}}},"requestBody":{"description":"the fields to update","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NptUpdateDto"}}}},"security":[{"oauth2":[]}]},"delete":{"operationId":"npt_removeNpt","summary":"Remove Npt","description":"Removes a Non-Project Task (NPT) by its unique identifier, which is a GUID.  \r\n \r\nA Non-Project Task (NPT) is an individual element of work that is outside of a project. \r\nMany people use NPTs to track personal work or general administrative work.  NPTs have nearly\r\nall the same features as other tasks, but since they are not part of a project, they can\r\nbe tracked separately by individuals.","tags":["npt"],"parameters":[{"name":"nptId","in":"path","description":"the id of the npt to remove","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/non-project-tasks/{nptId}/time":{"get":{"operationId":"npt_plannedAllocationsAndActualTimesheetMinutesForANonProjectTaskGroupedByResource","summary":"Planned allocations and actual timesheet minutes for a non-project task, grouped by resource.","description":"Returns a summary of planned allocations and logged timesheet minutes for the specified NPT,\r\ngrouped by resource. Use this when the client needs time rollups without loading individual\r\ntimesheet entries. The root `totalActualMinutes` is at least the task's stored actual work\r\n(minutes) and the merged timesheet total. `hasTimeEntries` is true only when merged timesheet\r\nrows exist, not when actual work was set without timesheets (e.g. import).","tags":["npt"],"parameters":[{"name":"nptId","in":"path","description":"The unique identifier of the non-project task","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskTimeSummaryDtoAstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/non-project-tasks/{nptId}/comments":{"get":{"operationId":"nptDiscussion_retrieveNptComments","summary":"Retrieve Npt Comments","description":"Retrieve all comments written about a Npt","tags":["nptDiscussion"],"parameters":[{"name":"nptId","in":"path","description":"The unique ID number of the Npt to retrieve comments","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DiscussionCommentDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]},"post":{"operationId":"nptDiscussion_createNptComments","summary":"Create Npt Comments","description":"Adds a Markdown-formatted comment to a Npt.\r\n            \r\nNpts can have discussions attached to them.  These discussions can include text with simple\r\nformatting.  Discussion comments are formatted using [Markdown](https://www.markdownguide.org/)\r\nand users should be aware that HTML embedding is not permitted due to the risk of cross-site\r\nattacks and other embedding challenges.","tags":["nptDiscussion"],"parameters":[{"name":"nptId","in":"path","description":"The unique ID number of the Npt being commented upon","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DiscussionCommentCreateResponseDtoAstroResult"}}}}},"requestBody":{"description":"The Markdown-formatted text of the comment","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DiscussionCommentCreateDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/non-project-tasks/comments/{commentId}/like":{"post":{"operationId":"nptDiscussion_likeAComment","summary":"Like a comment","description":"Puts a thumbsup on a comment","tags":["nptDiscussion"],"parameters":[{"name":"commentId","in":"path","description":"the id of the comment","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AstroResult"}}}}},"security":[{"oauth2":[]}]},"delete":{"operationId":"nptDiscussion_removesAThumbsupFromAComment","summary":"Removes a thumbsup from a comment","description":"Unlike a comment that was previously liked","tags":["nptDiscussion"],"parameters":[{"name":"commentId","in":"path","description":"the id of the comment","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/non-project-tasks/comments/{commentId}":{"delete":{"operationId":"nptDiscussion_removeAComment","summary":"Remove a comment","description":"Removes a comment by it's id","tags":["nptDiscussion"],"parameters":[{"name":"commentId","in":"path","description":"Remove a comment","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/non-project-tasks/{taskId}/files":{"get":{"operationId":"nptFiles_getNptFiles","summary":"Get Npt Files","description":"retrieves Npt files","tags":["nptFiles"],"parameters":[{"name":"taskId","in":"path","description":"The reference to the Npt","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskFileDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]},"post":{"operationId":"nptFiles_uploadFileToNonProjectTasks","summary":"Upload File To Non Project Tasks","description":"Uploads a file to a non-project task.\r\n            \r\nProjectManager allows you to store Files connected to other elements of your Workspace\r\nsuch as a Project, a Task, or Home.  Files are maintained separately based on the location\r\nwhere the file was stored.\r\n            \r\nWhen you upload a File, please allow a few moments for the File to be processed and verified.\r\nProjectManager may reject File uploads that contain problems such as malware. Once a File has\r\ncompleted the upload the process, you may retrieve it using the DownloadFile API.\r\n            \r\nThis API returns a JSON response indicating success or failure.","tags":["nptFiles"],"parameters":[{"name":"taskId","in":"path","description":"The reference to the task","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/FileDtoAstroResult"}}}}},"requestBody":{"content":{"multipart/form-data":{"schema":{"type":"object","properties":{"file":{"type":"string","format":"binary"}}}}}},"security":[{"oauth2":[]}]}},"/api/data/npt/{taskId}/recurring/weekly":{"post":{"operationId":"nptRecurrency_createWeeklyRecurringNpts","summary":"Create Weekly Recurring Npts","description":"Changes an existing Non-Project Task into a Recurring Task, so that it will recur regularly given the specified\r\nrules.\r\n            \r\nA Recurring Task is one that must be completed on a specific regular frequency, such as Daily, Weekly, Monthly,\r\nor Yearly.  To create a Recurring Task, you must first create a regular Task with the necessary information,\r\nthen call one of the Create Recurring Task APIs.  To remove an instance of a Recurring Task, call Delete\r\nRecurring Task and specify one or more instances of the Recurring Task.","tags":["nptRecurrency"],"parameters":[{"name":"taskId","in":"path","description":"The unique identifier of the NPT Tasks","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RecurringTaskChangeSetDetailsAstroResult"}}}}},"requestBody":{"description":"The weekly recurring settings","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WeeklyRecurringSettingsDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/npt/{taskId}/recurring/monthly":{"post":{"operationId":"nptRecurrency_createMonthlyRecurringNpts","summary":"Create Monthly Recurring Npts","description":"Changes an existing Non-Project Task into a Recurring Task, so that it will recur regularly given the specified\r\nrules.\r\n            \r\nA Recurring Task is one that must be completed on a specific regular frequency, such as Daily, Weekly, Monthly,\r\nor Yearly.  To create a Recurring Task, you must first create a regular Task with the necessary information,\r\nthen call one of the Create Recurring Task APIs.  To remove an instance of a Recurring Task, call Delete\r\nRecurring Task and specify one or more instances of the Recurring Task.","tags":["nptRecurrency"],"parameters":[{"name":"taskId","in":"path","description":"The unique identifier of the NPT Tasks","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RecurringTaskChangeSetDetailsAstroResult"}}}}},"requestBody":{"description":"The monthly recurring settings","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MonthlyRecurringSettingsDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/npt/{taskId}/recurring/daily":{"post":{"operationId":"nptRecurrency_createDailyRecurringNpts","summary":"Create Daily Recurring Npts","description":"Changes an existing Non-Project Task into a Recurring Task, so that it will recur regularly given the specified\r\nrules.\r\n            \r\nA Recurring Task is one that must be completed on a specific regular frequency, such as Daily, Weekly, Monthly,\r\nor Yearly.  To create a Recurring Task, you must first create a regular Task with the necessary information,\r\nthen call one of the Create Recurring Task APIs.  To remove an instance of a Recurring Task, call Delete\r\nRecurring Task and specify one or more instances of the Recurring Task.","tags":["nptRecurrency"],"parameters":[{"name":"taskId","in":"path","description":"The unique identifier of the NPT Tasks","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RecurringTaskChangeSetDetailsAstroResult"}}}}},"requestBody":{"description":"The daily recurring settings","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DailyRecurringSettingsDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/npt/{taskId}/recurring/yearly":{"post":{"operationId":"nptRecurrency_createYearlyRecurringNpts","summary":"Create Yearly Recurring Npts","description":"Changes an existing Non-Project Task into a Recurring Task, so that it will recur regularly given the specified\r\nrules.\r\n            \r\nA Recurring Task is one that must be completed on a specific regular frequency, such as Daily, Weekly, Monthly,\r\nor Yearly.  To create a Recurring Task, you must first create a regular Task with the necessary information,\r\nthen call one of the Create Recurring Task APIs.  To remove an instance of a Recurring Task, call Delete\r\nRecurring Task and specify one or more instances of the Recurring Task.","tags":["nptRecurrency"],"parameters":[{"name":"taskId","in":"path","description":"The unique identifier of the NPT Tasks","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RecurringTaskChangeSetDetailsAstroResult"}}}}},"requestBody":{"description":"The yearly recurring settings","content":{"application/json":{"schema":{"$ref":"#/components/schemas/YearlyRecurringSettingsDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/npt/{taskId}/recurring/{option}":{"delete":{"operationId":"nptRecurrency_deleteRecurringNpts","summary":"Delete Recurring Npts","description":"Removes one or more instances of a Recurring Non-Project Task based on the `option` you specify: `this` means\r\nto remove a single instance, `all` means to remove all instances, or `future` means to remove all future\r\ninstances of the Recurring Task.\r\n            \r\nA Recurring Task is one that must be completed on a specific regular frequency, such as Daily, Weekly, Monthly,\r\nor Yearly.  To create a Recurring Task, you must first create a regular Task with the necessary information,\r\nthen call one of the Create Recurring Task APIs.  To remove an instance of a Recurring Task, call Delete\r\nRecurring Task and specify one or more instances of the Recurring Task.","tags":["nptRecurrency"],"parameters":[{"name":"taskId","in":"path","description":"The unique identifier of the Recurring Npt Tasks","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"option","in":"path","description":"The options for the deletion","required":true,"schema":{"type":"string"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DeletedTasksDtoAstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/npt/{taskId}/recurring/settings/validate":{"post":{"operationId":"nptRecurrency_validateRecurringNpts","summary":"Validate Recurring Npts","description":"Reviews potential updates to a Recurring Non-Project Task and report back on the list of changes that would\r\noccur if this Recurring Non-Project Task was updated with these settings.\r\n            \r\nWhen making changes to a Recurring Npt, you may want to investigate the consequences of your changes first\r\nbefore finalizing the changes.  You can use the Validate Recurring Npts API to examine these changes.  When\r\nyou are happy with the changes, call Update Recurring Npts to complete them.\r\n            \r\nA Recurring Task is one that must be completed on a specific regular frequency, such as Daily, Weekly, Monthly,\r\nor Yearly.  To create a Recurring Task, you must first create a regular Task with the necessary information,\r\nthen call one of the Create Recurring Task APIs.  To remove an instance of a Recurring Task, call Delete\r\nRecurring Task and specify one or more instances of the Recurring Task.","tags":["nptRecurrency"],"parameters":[{"name":"taskId","in":"path","description":"The unique identifier of the NPT Tasks","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RecurringTaskValidationResultDtoAstroResult"}}}}},"requestBody":{"description":"The new settings","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RecurringTaskSettingsDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/npt/{taskId}/recurring/settings":{"put":{"operationId":"nptRecurrency_updateRecurringNpts","summary":"Update Recurring Npts","description":"Updates the settings for a Recurring Non-Project Task and re-generates occurrences of the Recurring Non-Project\r\nTask from the new rules.\r\n            \r\nWhen making changes to a Recurring Npt, you may want to investigate the consequences of your changes first\r\nbefore finalizing the changes.  You can use the Validate Recurring Npts API to examine these changes.  When\r\nyou are happy with the changes, call Update Recurring Npts to complete them.\r\n            \r\nA Recurring Task is one that must be completed on a specific regular frequency, such as Daily, Weekly, Monthly,\r\nor Yearly.  To create a Recurring Task, you must first create a regular Task with the necessary information,\r\nthen call one of the Create Recurring Task APIs.  To remove an instance of a Recurring Task, call Delete\r\nRecurring Task and specify one or more instances of the Recurring Task.","tags":["nptRecurrency"],"parameters":[{"name":"taskId","in":"path","description":"The unique identifier of the NPT Tasks","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RecurringTaskChangeSetDetailsAstroResult"}}}}},"requestBody":{"description":"The new settings","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RecurringTaskSettingsDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/non-project-tasks/statuses":{"get":{"operationId":"nptStatus_getNptTaskStatuses","summary":"Get Npt Task Statuses","description":"Get a list of task statuses that can be used by non-protect tasks.","tags":["nptStatus"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NptStatusDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]},"post":{"operationId":"nptStatus_createNptTaskStatus","summary":"Create Npt Task Status","description":"Creates a new status level for non-project tasks.","tags":["nptStatus"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NptStatusDtoAstroResult"}}}},"400":{"description":"Bad Request","content":{"application/json":{"schema":{"description":"Any type"}}}}},"requestBody":{"description":"Information about the new status level to create","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NptStatusCreateDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/non-project-tasks/statuses/{nptStatusId}":{"put":{"operationId":"nptStatus_updateNptTaskStatus","summary":"Update Npt Task Status","description":"Updates an existing status level for non-project tasks.","tags":["nptStatus"],"parameters":[{"name":"nptStatusId","in":"path","description":"The unique identifier of the status to update","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NptStatusDtoAstroResult"}}}},"400":{"description":"Bad Request","content":{"application/json":{"schema":{"description":"Any type"}}}}},"requestBody":{"description":"Information about the status level to update","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NptStatusUpdateDto"}}}},"security":[{"oauth2":[]}]},"delete":{"operationId":"nptStatus_deleteNptTaskStatus","summary":"Delete Npt Task Status","description":"Deletes an existing status level for non-project tasks.\r\n            \r\nYou will not be able to delete a status if there are tasks assigned to it\r\nor if it is the default status level.","tags":["nptStatus"],"parameters":[{"name":"nptStatusId","in":"path","description":"The unique identifier of the status to delete","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/non-project-tasks/{taskId}/tags":{"get":{"operationId":"nptTag_retrieveTaskTags","summary":"Retrieve TaskTags","description":"Retrieve the existing TaskTags on a Task\r\n            \r\nA TaskTag is a connection between a Task and a Tag.  Each Task can have zero, one or many\r\nTaskTags associated with it.  TaskTags can be assigned and removed from the Task to help you\r\nclassify your Tasks and prioritize work.","tags":["nptTag"],"parameters":[{"name":"taskId","in":"path","description":"The unique identifier of the Task for which we will retrieve TaskTags","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskTagDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]},"post":{"operationId":"nptTag_replaceTaskTags","summary":"Replace TaskTags","description":"Replaces the existing TaskTags on a Task with a newly provided list of TaskTags.\r\n            \r\nA TaskTag is a connection between a Task and a Tag.  Each Task can have zero, one or many\r\nTaskTags associated with it.  TaskTags can be assigned and removed from the Task to help you\r\nclassify your Tasks and prioritize work.","tags":["nptTag"],"parameters":[{"name":"taskId","in":"path","description":"The unique identifier of the Task for which we will replace TaskTags","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskTagDtoListAstroResult"}}}}},"requestBody":{"description":"The replacement list of TaskTags for this Task","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/NameDto"}}}}},"security":[{"oauth2":[]}]},"put":{"operationId":"nptTag_addTaskTagToTask","summary":"Add TaskTag to Task","description":"Add one or more new TaskTags to a Task.\r\n            \r\nA TaskTag is a connection between a Task and a Tag.  Each Task can have zero, one or many\r\nTaskTags associated with it.  TaskTags can be assigned and removed from the Task to help you\r\nclassify your Tasks and prioritize work.","tags":["nptTag"],"parameters":[{"name":"taskId","in":"path","description":"The unique identifier of the Task for which we will add TaskTags","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskTagDtoListAstroResult"}}}}},"requestBody":{"description":"The new TaskTags to add to this Task","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/NameDto"}}}}},"security":[{"oauth2":[]}]},"delete":{"operationId":"nptTag_removeTaskTagFromTask","summary":"Remove TaskTag from Task","description":"Removes one or more existing TaskTags from a Task.\r\n            \r\nA TaskTag is a connection between a Task and a Tag.  Each Task can have zero, one or many\r\nTaskTags associated with it.  TaskTags can be assigned and removed from the Task to help you\r\nclassify your Tasks and prioritize work.","tags":["nptTag"],"parameters":[{"name":"taskId","in":"path","description":"The unique identifier of the Task for which we will remove existing TaskTags","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AstroResult"}}}}},"requestBody":{"description":"The TaskTags to remove from this Task","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/NameDto"}}}}},"security":[{"oauth2":[]}]}},"/api/data/non-project-tasks/{nptId}/todos":{"get":{"operationId":"nptTodos_getNptTodos","summary":"Get Npt Todos","description":"Get todos for a npt","tags":["nptTodos"],"parameters":[{"name":"nptId","in":"path","description":"the id of the npt","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskTodoDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]},"post":{"operationId":"nptTodos_createNptTodo","summary":"Create Npt Todo","description":"Creates a new todo and associates it with the npt","tags":["nptTodos"],"parameters":[{"name":"nptId","in":"path","description":"the id of the npt","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskTodoDtoAstroResult"}}}}},"requestBody":{"description":"The todo to create","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskTodoCreateDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/non-project-tasks/todos/{todoId}":{"put":{"operationId":"nptTodos_updateANptTodo","summary":"Update A Npt Todo","description":"Update a Todo","tags":["nptTodos"],"parameters":[{"name":"todoId","in":"path","description":"the id of the todo","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskTodoDtoAstroResult"}}}}},"requestBody":{"description":"the fields to update","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskTodoUpdateDto"}}}},"security":[{"oauth2":[]}]},"delete":{"operationId":"nptTodos_removeNptTodo","summary":"Remove Npt Todo","description":"Remove Npt Todo","tags":["nptTodos"],"parameters":[{"name":"todoId","in":"path","description":"the id of the todo to remove","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/projects":{"get":{"operationId":"project_queryProjects","summary":"Query Projects","description":"Retrieve a list of Projects that match an [OData formatted query](https://www.odata.org/).\r\n            \r\nA Project is a collection of Tasks that contributes towards a goal.  Within a Project, Tasks\r\nrepresent individual items of work that team members must complete.  The sum total of Tasks\r\nwithin a Project represents the work to be completed for that Project.","tags":["project"],"parameters":[{"name":"$top","in":"query","description":"The number of records to return","required":false,"schema":{"type":"integer"}},{"name":"$skip","in":"query","description":"Skips the given number of records and then returns $top records","required":false,"schema":{"type":"integer"}},{"name":"$filter","in":"query","description":"Filter the expression according to oData queries","required":false,"schema":{"type":"string"}},{"name":"$orderby","in":"query","description":"Order collection by this field.","required":false,"schema":{"type":"string"}},{"name":"$expand","in":"query","description":"Include related data in the response","required":false,"schema":{"type":"string"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]},"post":{"operationId":"project_createProject","summary":"Create Project","description":"Create a new project based on the details provided.\r\n            \r\nA Project is a collection of Tasks that contributes towards a goal.  Within a Project, Tasks\r\nrepresent individual items of work that team members must complete.  The sum total of Tasks\r\nwithin a Project represents the work to be completed for that Project.","tags":["project"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectDtoAstroResult"}}}}},"requestBody":{"description":"Information about the Project you wish to create","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectCreateDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/projects/{projectId}":{"get":{"operationId":"project_retrieveProject","summary":"Retrieve Project","description":"Retrieves a project based on its unique identifier.\r\n            \r\nA Project is a collection of Tasks that contributes towards a goal.  Within a Project, Tasks\r\nrepresent individual items of work that team members must complete.  The sum total of Tasks\r\nwithin a Project represents the work to be completed for that Project.","tags":["project"],"parameters":[{"name":"projectId","in":"path","description":"The unique identifier of the Project to retrieve.","required":true,"schema":{"type":"string"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectDtoAstroResult"}}}}},"security":[{"oauth2":[]}]},"put":{"operationId":"project_updateProject","summary":"Update Project","description":"Update an existing Project and replace the values of fields specified.\r\n            \r\nA Project is a collection of Tasks that contributes towards a goal.  Within a Project, Tasks\r\nrepresent individual items of work that team members must complete.  The sum total of Tasks\r\nwithin a Project represents the work to be completed for that Project.","tags":["project"],"parameters":[{"name":"projectId","in":"path","description":"The unique identifier of the Project to update","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AstroResult"}}}}},"requestBody":{"description":"All non-null fields in this object will replace previous data within the Project","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectUpdateDto"}}}},"security":[{"oauth2":[]}]},"delete":{"operationId":"project_deleteProject","summary":"Delete Project","description":"Delete a project based on the details provided.\r\n            \r\nA Project is a collection of Tasks that contributes towards a goal.  Within a Project, Tasks\r\nrepresent individual items of work that team members must complete.  The sum total of Tasks\r\nwithin a Project represents the work to be completed for that Project.","tags":["project"],"parameters":[{"name":"projectId","in":"path","description":"The unique identifier of the Project to delete","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"hardDelete","in":"query","description":"Hard delete project true or false","required":false,"schema":{"type":"boolean"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AstroResult"}}}}},"security":[{"oauth2":[]}]},"post":{"operationId":"risk_createProjectRisk","summary":"Create Project Risk","description":"Creates a new Risk within the specified Project.\r\n            \r\nThe Risk will inherit Project context such as access permissions\r\nand workspace ownership. Validation is applied to ensure the\r\nProject exists and the caller has permission to create Risks.","tags":["risk"],"parameters":[{"name":"projectId","in":"path","description":"The id of the project","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RiskDtoAstroResult"}}}},"400":{"description":"Bad Request","content":{"application/json":{"schema":{"description":"Any type"}}}}},"deprecated":true,"requestBody":{"description":"The data used to create the Risk","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RiskCreateDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/projects/{projectId}/restore":{"put":{"operationId":"project_restoreProject","summary":"Restore Project","description":"Restore a soft deleted project based on its unique identifier.\r\n            \r\nA Project is a collection of Tasks that contributes towards a goal.  Within a Project, Tasks\r\nrepresent individual items of work that team members must complete.  The sum total of Tasks\r\nwithin a Project represents the work to be completed for that Project.","tags":["project"],"parameters":[{"name":"projectId","in":"path","description":"The unique identifier of the Project to delete","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AstroResult"}}}}},"deprecated":true,"security":[{"oauth2":[]}]}},"/api/data/projects/{projectId}/reopen/status":{"get":{"operationId":"project_reopenProjectStatus","summary":"Reopen Project Status","description":"Check if a project is in a valid state so that it can be reopened without any side effects.\r\nFor example, if Rates have changed for this project, reopening it will result is project\r\ncosts being recalculated which will adjust costs.\r\n            \r\nThis endpoint will return what side effects may occur if it is reopened.","tags":["project"],"parameters":[{"name":"projectId","in":"path","description":"The unique identifier of the project to check.","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectReopenStatusDtoAstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/projects/export":{"post":{"operationId":"project_createProjectExport","summary":"Create Project Export","description":"Initiates a new Export action for Projects.\r\n            \r\nReturns the identifier of this Projects Export.","tags":["project"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ExportDtoAstroResult"}}}}},"requestBody":{"description":"The settings to use for this export action","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectExportSettingsDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/risks":{"get":{"operationId":"risk_queryRisks","summary":"Query Risks","description":"Retrieve a list of risks that match an [OData formatted query](https://www.odata.org/).\r\n            \r\nA Risk represents a tracked item of concern for a project.  Risks may be categorized as Changes, Risks,\r\nAssumptions, Issues, or Dependencies.","tags":["risk"],"parameters":[{"name":"$top","in":"query","description":"The number of records to return","required":false,"schema":{"type":"integer"}},{"name":"$skip","in":"query","description":"Skips the given number of records and then returns $top records","required":false,"schema":{"type":"integer"}},{"name":"$filter","in":"query","description":"Filter the expression according to oData queries","required":false,"schema":{"type":"string"}},{"name":"$orderby","in":"query","description":"Order collection by this field.","required":false,"schema":{"type":"string"}},{"name":"$expand","in":"query","description":"Include related data in the response","required":false,"schema":{"type":"string"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RiskDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/risks/{riskId}":{"get":{"operationId":"risk_getRisk","summary":"Get Risk","description":"Retrieve a Risk by its unique identifier or by its short ID.\r\nA Risk has both a unique identifier (GUID) and a short ID\r\nthat is unique within a Workspace.","tags":["risk"],"parameters":[{"name":"riskId","in":"path","description":"The id of the risk","required":true,"schema":{"type":"string"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RiskDetailsDtoAstroResult"}}}}},"security":[{"oauth2":[]}]},"put":{"operationId":"risk_updateRisk","summary":"Update Risk","description":"Updates an existing Risk.\r\n            \r\nOnly the fields provided in the request body will be updated.\r\nFields omitted from the request will remain unchanged.\r\n            \r\nAuthorization is enforced to ensure the caller has access\r\nto modify the specified Risk.","tags":["risk"],"parameters":[{"name":"riskId","in":"path","description":"The id of the risk","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RiskDtoAstroResult"}}}},"400":{"description":"Bad Request","content":{"application/json":{"schema":{"description":"Any type"}}}}},"requestBody":{"description":"The fields to update","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RiskUpdateDto"}}}},"security":[{"oauth2":[]}]},"delete":{"operationId":"risk_removeRisk","summary":"Remove Risk","description":"Permanently removes the specified Risk.\r\n            \r\nThis operation cannot be undone. Any related references\r\n(such as links, history, or notifications) will be handled\r\naccording to system rules.\r\n            \r\nAuthorization is enforced to ensure the caller has permission\r\nto delete the Risk.","tags":["risk"],"parameters":[{"name":"riskId","in":"path","description":"The id of the risk to remove","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/risks/projects/{projectId}":{"get":{"operationId":"risk_getRisksForProject","summary":"Get Risks for Project","description":"Retrieves all Risks associated with the specified Project.\r\n            \r\nThis endpoint returns a flat list of Risk summaries (not details)\r\nand does not use OData. Results are scoped to the Project and\r\nrespect feature flags such as Hourly Rates.","tags":["risk"],"parameters":[{"name":"projectId","in":"path","description":"The id of the project","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RiskDetailsDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/projects/{projectId}/risks":{"post":{"operationId":"risk_createRisk","summary":"Create Risk","description":"Creates a new Risk within the specified Project.\r\n            \r\nThe Risk will inherit Project context such as access permissions\r\nand workspace ownership. Validation is applied to ensure the\r\nProject exists and the caller has permission to create Risks.","tags":["risk"],"parameters":[{"name":"projectId","in":"path","description":"The id of the project","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RiskDtoAstroResult"}}}},"400":{"description":"Bad Request","content":{"application/json":{"schema":{"description":"Any type"}}}}},"requestBody":{"description":"The data used to create the Risk","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RiskCreateDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/projects/{projectId}/risks/export":{"post":{"operationId":"risk_createRiskExport","summary":"Create Risk Export","description":"Initiates a new Export action for Risks.\r\n            \r\nReturns the identifier of this Risk Export.","tags":["risk"],"parameters":[{"name":"projectId","in":"path","description":"The unique identifier of the Project for which to export Risks","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ExportDtoAstroResult"}}}},"400":{"description":"Bad Request","content":{"application/json":{"schema":{"description":"Any type"}}}}},"requestBody":{"description":"The settings to use for this export action","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RiskExportSettingsDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/projects/chargecodes":{"get":{"operationId":"projectChargeCode_retrieveChargeCodes","summary":"Retrieve Charge Codes","description":"Retrieve all defined ChargeCodes that can be used when creating Projects.\r\n            \r\nA ChargeCode is a code used to identify costs within your Projects.  Each ChargeCode has\r\na name and a unique identifier.  ChargeCodes are defined per Workspace and are shared\r\namong Projects.","tags":["projectChargeCode"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectChargeCodeDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]},"post":{"operationId":"projectChargeCode_createProjectChargeCode","summary":"Create Project Charge Code","description":"Create a project charge code","tags":["projectChargeCode"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectChargeCodeDtoAstroResult"}}}},"400":{"description":"Bad Request","content":{"application/json":{"schema":{"description":"Any type"}}}}},"requestBody":{"description":"The data to create the charge code","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectChargeCodeCreateDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/projects/chargecodes/{chargeCodeId}":{"put":{"operationId":"projectChargeCode_updateProjectChargeCode","summary":"Update Project Charge Code","description":"Update a project charge code","tags":["projectChargeCode"],"parameters":[{"name":"chargeCodeId","in":"path","description":"The id of the charge code","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectChargeCodeDtoAstroResult"}}}}},"requestBody":{"description":"The data to update the charge code","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectChargeCodeUpdateDto"}}}},"security":[{"oauth2":[]}]},"delete":{"operationId":"projectChargeCode_deleteProjectChargeCode","summary":"Delete Project Charge Code","description":"Delete a project charge code","tags":["projectChargeCode"],"parameters":[{"name":"chargeCodeId","in":"path","description":"The id of the charge code","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/projects/customers":{"get":{"operationId":"projectCustomer_retrieveProjectCustomers","summary":"Retrieve Project Customers","description":"Retrieves all ProjectCustomers defined within your Workspace.\r\n            \r\nA ProjectCustomer is a code used to identify customers associated with your Projects.  Each\r\nProjectCustomer has a name and a unique identifier.  ProjectCustomers are defined per\r\nWorkspace and are shared among Projects.","tags":["projectCustomer"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectCustomerDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]},"post":{"operationId":"projectCustomer_createProjectCustomer","summary":"Create Project Customer","description":"Create a project customer","tags":["projectCustomer"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectCustomerDtoAstroResult"}}}},"400":{"description":"Bad Request","content":{"application/json":{"schema":{"description":"Any type"}}}}},"requestBody":{"description":"The data to create the customer","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectCustomerCreateDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/projects/customers/{customerId}":{"put":{"operationId":"projectCustomer_updateProjectCustomer","summary":"Update Project Customer","description":"Updates a project customer","tags":["projectCustomer"],"parameters":[{"name":"customerId","in":"path","description":"The id of the customer to update","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectCustomerDtoAstroResult"}}}}},"requestBody":{"description":"The data to update","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectCustomerCreateDto"}}}},"security":[{"oauth2":[]}]},"delete":{"operationId":"projectCustomer_deleteProjectCustomer","summary":"Delete Project Customer","description":"Delete a project customer. They will also be removed from any projects they were assigned too.","tags":["projectCustomer"],"parameters":[{"name":"customerId","in":"path","description":"The id of the customer to remove","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/projects/fields":{"get":{"operationId":"projectField_retrieveProjectFields","summary":"Retrieve Project Fields","description":"Retrieves all ProjectFields defined within your Workspace.\r\n            \r\nA ProjectField is a custom field defined within your Workspace.  You can define ProjectFields\r\nfor any integration purpose that is important to your business.  Each ProjectField has a data\r\ntype as well as options in how it is handled.  ProjectFields can be edited for each Project\r\nwithin your Workspace.","tags":["projectField"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectFieldDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]},"post":{"operationId":"projectField_createProjectField","summary":"Create Project Field","description":"Creates a new ProjectField within your Workspace.\r\n            \r\nA ProjectField is a custom field defined within your Workspace.  You can define ProjectFields\r\nfor any integration purpose that is important to your business.  Each ProjectField has a data\r\ntype as well as options in how it is handled.  ProjectFields can be edited for each Project\r\nwithin your Workspace.","tags":["projectField"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectFieldDtoAstroResult"}}}},"400":{"description":"Bad Request","content":{"application/json":{"schema":{"description":"Any type"}}}}},"requestBody":{"description":"Information about the ProjectField to create","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectFieldCreateDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/projects/fields/{fieldId}":{"put":{"operationId":"projectField_updateProjectFieldDefinitionEGRename","summary":"Update Project Field Definition (e.g. rename)","description":"Updates the definition of a ProjectField within your Workspace, such as renaming the field.\r\nThis changes the field metadata for the entire Workspace, not the value stored for any project.\r\nTo change a field's value for a specific project, use UpdateProjectFieldValue instead.\r\n            \r\nA ProjectField is a custom field defined within your Workspace.  You can define ProjectFields\r\nfor any integration purpose that is important to your business.  Each ProjectField has a data\r\ntype as well as options in how it is handled.  ProjectFields can be edited for each Project\r\nwithin your Workspace.","tags":["projectField"],"parameters":[{"name":"fieldId","in":"path","description":"The unique identifier or short ID of the ProjectField to update","required":true,"schema":{"type":"string"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AstroResult"}}}}},"requestBody":{"description":"The new definition (e.g. name) for this ProjectField","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateProjectFieldDto"}}}},"security":[{"oauth2":[]}]},"delete":{"operationId":"projectField_deleteProjectField","summary":"Delete Project Field","description":"Deletes an existing ProjectField within your Workspace.\r\n            \r\nA ProjectField is a custom field defined within your Workspace.  You can define ProjectFields\r\nfor any integration purpose that is important to your business.  Each ProjectField has a data\r\ntype as well as options in how it is handled.  ProjectFields can be edited for each Project\r\nwithin your Workspace.","tags":["projectField"],"parameters":[{"name":"fieldId","in":"path","description":"The unique identifier or short ID  of this ProjectField","required":true,"schema":{"type":"string"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/projects/{projectId}/fields/{fieldId}":{"get":{"operationId":"projectField_retrieveProjectFieldValue","summary":"Retrieve ProjectField Value","description":"Retrieves the current ProjectField value for a particular Project and ProjectField.\r\n            \r\nA ProjectField is a custom field defined within your Workspace.  You can define ProjectFields\r\nfor any integration purpose that is important to your business.  Each ProjectField has a data\r\ntype as well as options in how it is handled.  ProjectFields can be edited for each Project\r\nwithin your Workspace.","tags":["projectField"],"parameters":[{"name":"projectId","in":"path","description":"The unique identifier of the Project of the value to retrieve","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"fieldId","in":"path","description":"The unique identifier or short ID of the ProjectField of the value to retrieve","required":true,"schema":{"type":"string"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectFieldValueDtoAstroResult"}}}}},"security":[{"oauth2":[]}]},"put":{"operationId":"projectField_updateProjectFieldValue","summary":"Update ProjectField Value","description":"Sets or replaces the value of a ProjectField for a specific Project within your Workspace.\r\nThis updates the stored value (e.g. \"High\", \"123\", \"2025-01-15\") for that project–field combination,\r\nnot the field definition itself. Use UpdateProjectField or UpdateProjectFieldOptions to change\r\nthe field's name or dropdown options.\r\n            \r\nA ProjectField is a custom field defined within your Workspace.  You can define ProjectFields\r\nfor any integration purpose that is important to your business.  Each ProjectField has a data\r\ntype as well as options in how it is handled.  ProjectFields can be edited for each Project\r\nwithin your Workspace.","tags":["projectField"],"parameters":[{"name":"projectId","in":"path","description":"The unique identifier of the Project for which to set this field value","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"fieldId","in":"path","description":"The unique identifier or short ID of the ProjectField","required":true,"schema":{"type":"string"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AstroResult"}}}}},"requestBody":{"description":"The new value for this ProjectField on the specified Project","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateProjectFieldValueDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/projects/fields/{fieldId}/options":{"put":{"operationId":"projectField_updateProjectFieldOptionsForDropdownTypes","summary":"Update Project Field Options (for dropdown types)","description":"Updates the list of options for a ProjectField of type Dropdown. This changes the field\r\ndefinition for the entire Workspace (the choices available when editing any project),\r\nnot the value stored for any specific project. To change a field's value for a project,\r\nuse UpdateProjectFieldValue instead.\r\n            \r\nA ProjectField is a custom field defined within your Workspace.  You can define ProjectFields\r\nfor any integration purpose that is important to your business.  Each ProjectField has a data\r\ntype as well as options in how it is handled.  ProjectFields can be edited for each Project\r\nwithin your Workspace.","tags":["projectField"],"parameters":[{"name":"fieldId","in":"path","description":"The unique identifier or short ID of the ProjectField to update","required":true,"schema":{"type":"string"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AstroResult"}}}}},"requestBody":{"description":"The new list of option strings (e.g. [\"Option A\", \"Option B\", \"Option C\"])","content":{"application/json":{"schema":{"type":"array","items":{"type":"string"}}}}},"security":[{"oauth2":[]}]}},"/api/data/projects/{projectId}/fields":{"get":{"operationId":"projectField_retrieveAllProjectFieldValues","summary":"Retrieve All ProjectField Values","description":"Retrieves all ProjectField values for a particular Project.\r\n            \r\nA ProjectField is a custom field defined within your Workspace.  You can define ProjectFields\r\nfor any integration purpose that is important to your business.  Each ProjectField has a data\r\ntype as well as options in how it is handled.  ProjectFields can be edited for each Project\r\nwithin your Workspace.","tags":["projectField"],"parameters":[{"name":"projectId","in":"path","description":"The unique identifier of the Project for which we want ProjectField values","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectFieldValueDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/projects/{projectId}/files":{"post":{"operationId":"projectFile_uploadProjectFile","summary":"Upload Project File","description":"Uploads a file to the All Files folder on the Files page within the project that you specify.\r\n            \r\nProjectManager allows you to store Files connected to other elements of your Workspace\r\nsuch as a Project, a Task, or Home.  Files are maintained separately based on the location\r\nwhere the file was stored.\r\n            \r\nWhen you upload a File, please allow a few moments for the File to be processed and verified.\r\nProjectManager may reject File uploads that contain problems such as malware. Once a File has\r\ncompleted the upload the process, you may retrieve it using the DownloadFile API.\r\n            \r\nThis API returns a JSON response indicating success or failure.","tags":["projectFile"],"parameters":[{"name":"projectId","in":"path","description":"The reference to the project","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/FileDtoAstroResult"}}}}},"requestBody":{"content":{"multipart/form-data":{"schema":{"type":"object","properties":{"file":{"type":"string","format":"binary"}}}}}},"security":[{"oauth2":[]}]}},"/api/data/projects/{projectId}/folders/{folderId}/files":{"post":{"operationId":"projectFile_uploadProjectFileToFolder","summary":"Upload Project File To Folder","description":"Uploads a file to a specific folder on the Files page within the project that you specify.\r\n            \r\nProjectManager allows you to store Files connected to other elements of your Workspace\r\nsuch as a Project, a Task, or Home.  Files are maintained separately based on the location\r\nwhere the file was stored.\r\n            \r\nYou can organize your files in the Home Files and Project Files pages by adding folders.\r\n            \r\nWhen you upload a File, please allow a few moments for the File to be processed and verified.\r\nProjectManager may reject File uploads that contain problems such as malware. Once a File has\r\ncompleted the upload the process, you may retrieve it using the DownloadFile API.\r\n            \r\nThis API returns a JSON response indicating success or failure.","tags":["projectFile"],"parameters":[{"name":"projectId","in":"path","description":"The reference to the project","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"folderId","in":"path","description":"The reference to the sub folder to put the file into","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/FileDtoAstroResult"}}}}},"requestBody":{"content":{"multipart/form-data":{"schema":{"type":"object","properties":{"file":{"type":"string","format":"binary"}}}}}},"security":[{"oauth2":[]}]}},"/api/data/project-folders":{"get":{"operationId":"projectFolder_retrieveProjectFolders","summary":"Retrieve Project Folders","description":"Retrieves all ProjectFolders defined within your Workspace.\r\n            \r\nA ProjectFolder is a named storage location that can contain Projects.","tags":["projectFolder"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectFolderDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]},"post":{"operationId":"projectFolder_createProjectFolder","summary":"Create Project Folder","description":"Create a project folder","tags":["projectFolder"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectFolderDtoAstroResult"}}}}},"requestBody":{"description":"The data to create the folder","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectFolderCreateDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/project-folders/{projectFolderId}":{"put":{"operationId":"projectFolder_updateProjectFolder","summary":"Update Project Folder","description":"Update a project folder","tags":["projectFolder"],"parameters":[{"name":"projectFolderId","in":"path","description":"The id of the folder","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectFolderDtoAstroResult"}}}}},"requestBody":{"description":"The data to update the folder","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectFolderUpdateDto"}}}},"security":[{"oauth2":[]}]},"delete":{"operationId":"projectFolder_deleteProjectFolder","summary":"Delete Project Folder","description":"Delete a project folder","tags":["projectFolder"],"parameters":[{"name":"projectFolderId","in":"path","description":"The id of the folder","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/projects/members":{"get":{"operationId":"projectMembers_retrieveNewProjectMembers","summary":"Retrieve New Project Members","description":"Returns a list of users that can be added as members of a new project, as well as their available project security roles.\r\n            \r\nA project member is a user who has access to a specific project. Project members are assigned a project security role, which controls the level of access they have to\r\nthe project. Possible project security roles include manage, edit, collaborate, creator, and guest.","tags":["projectMembers"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectMemberDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/projects/membership":{"get":{"operationId":"projectMembers_retrieveProjectsTheUserIsAMemberOf","summary":"Retrieve Projects the user is a member of","description":"Returns a list of project permissions the user is a member of","tags":["projectMembers"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectAccessDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/projects/{projectId}/members":{"get":{"operationId":"projectMembers_retrieveProjectMembers","summary":"Retrieve Project Members","description":"Returns a list of users that are currently members of a specified project, as well as their current project security roles and available project security roles.\r\nOptionally include users who are not currently members of the project, but who can be added.\r\n            \r\nA project member is a user who has access to a specific project. Project members are assigned a project security role, which controls the level of access they have to\r\nthe project. Possible project security roles include manage, edit, collaborate, creator, and guest.","tags":["projectMembers"],"parameters":[{"name":"projectId","in":"path","description":"Reference to the project","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"includeAllUsers","in":"query","description":"Set to true to include all users in the workspace","required":false,"schema":{"type":"boolean","default":false}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectMemberDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]},"put":{"operationId":"projectMembers_updateAListOfUserProjectMembership","summary":"Update A List Of User Project Membership","description":"Updates the project access for a current member of a specified project\r\nby giving the users a new project security role.\r\n            \r\nA project member is a user who has access to a specific project.\r\nProject members are assigned a project security role, which controls the level of access they have to\r\nthe project.\r\nPossible project security roles include manage, edit, collaborate, creator, and guest.","tags":["projectMembers"],"parameters":[{"name":"projectId","in":"path","description":"Reference to Project","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectMemberDtoAstroResult"}}}}},"deprecated":true,"requestBody":{"description":"The permission to update","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectMembersAccessDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/projects/{projectId}/members/{userId}":{"get":{"operationId":"projectMembers_retrieveUserProjectMembership","summary":"Retrieve User Project Membership","description":"Returns the project security role in a specified project for a current project member.\r\n            \r\nA project member is a user who has access to a specific project. Project members are assigned a project security role, which controls the level of access they have to\r\nthe project. Possible project security roles include manage, edit, collaborate, creator, and guest.","tags":["projectMembers"],"parameters":[{"name":"projectId","in":"path","description":"Reference of Project","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"userId","in":"path","description":"Reference of User","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectMemberDtoAstroResult"}}}}},"security":[{"oauth2":[]}]},"post":{"operationId":"projectMembers_createUserProjectMembership","summary":"Create User Project Membership","description":"Creates a membership for a user in a specified project\r\nand assigns the user the appropriate project access based on the specified project security role.\r\n            \r\nA project member is a user who has access to a specific project.\r\nProject members are assigned a project security role, which controls the level of access they have to\r\nthe project.\r\nPossible project security roles include manage, edit, collaborate, creator, and guest.","tags":["projectMembers"],"parameters":[{"name":"projectId","in":"path","description":"Reference to Project","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"userId","in":"path","description":"Reference to User","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectMemberDtoAstroResult"}}}}},"deprecated":true,"requestBody":{"description":"The permission to set","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectMemberRoleDto"}}}},"security":[{"oauth2":[]}]},"put":{"operationId":"projectMembers_createOrUpdateUserProjectMembership","summary":"Create Or Update User Project Membership","description":"Creates or updates (upserts) a user's membership in a specified project. If the user is not yet a member they\r\nare added; if they are already a member their project security role is replaced.\r\n            \r\nThe role is optional. When the role is omitted for a new member, a default role is applied based on the user's\r\nworkspace access: users who can edit all projects become a Manager, guest users become a Guest, and everyone\r\nelse becomes an Editor. When the role is omitted for a user who is already a member, their current role is left\r\nunchanged.\r\n            \r\nA project member is a user who has access to a specific project. Project members are assigned a project security role, which controls the level of access they have to\r\nthe project. Possible project security roles include manage, edit, collaborate, creator, and guest.","tags":["projectMembers"],"parameters":[{"name":"projectId","in":"path","description":"Reference to Project","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"userId","in":"path","description":"Reference to User","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectMemberDtoAstroResult"}}}}},"requestBody":{"description":"The permission to set. The role is optional.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectMemberRoleDto"}}}},"security":[{"oauth2":[]}]},"delete":{"operationId":"projectMembers_removeUserProjectMembership","summary":"Remove User Project Membership","description":"Removes a current project member from a specified project. This removes the user's access to that project.\r\n            \r\nA project member is a user who has access to a specific project. Project members are assigned a project security role, which controls the level of access they have to\r\nthe project. Possible project security roles include manage, edit, collaborate, creator, and guest.","tags":["projectMembers"],"parameters":[{"name":"projectId","in":"path","description":"Reference to Project","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"userId","in":"path","description":"Reference to User","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/projects/{projectId}/teams/{teamId}/members":{"post":{"operationId":"projectMembers_addAllActivePeopleOnABusinessTeamToAProject","summary":"Add all active people on a business team to a project.","description":"Resolves the team to its member resources, grants project access to each user who is not already a member,\r\nand leaves existing members unchanged. Access levels follow the same rules as creating or updating\r\nindividual project membership (workspace role constraints, guest vs licensed user, global admin, etc.).\r\n            \r\nA project member is a user who has access to a specific project.\r\nProject members are assigned a project security role, which controls the level of access they have to\r\nthe project.\r\nPossible project security roles include manage, edit, collaborate, creator, and guest.","tags":["projectMembers"],"parameters":[{"name":"projectId","in":"path","description":"Reference to the project receiving access.","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"teamId","in":"path","description":"Business team identifier (`BusinessTeamId`); all active team members with a user account are considered.","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectMemberDtoAstroResult"}}}}},"requestBody":{"description":"Optional flags for default access (e.g. editor vs collaborator) for newly added members.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AddProjectTeamMembersRequestDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/projects/priorities":{"get":{"operationId":"projectPriority_retrieveProjectPriorities","summary":"Retrieve Project Priorities","description":"Retrieves all ProjectPriorities defined within your Workspace.\r\n            \r\nA ProjectPriority is a named priority level used by your business to determine how to decide\r\nwhich Projects are the most important.  You can name your ProjectPriority levels anything you like\r\nand you can reorganize the order of the ProjectPriority levels at any time.\r\n            \r\nNote that TaskPriority and ProjectPriority are different classes of priority levels.  Even\r\nif they may have similar names, they are different objects and must be tracked separately.","tags":["projectPriority"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectPriorityDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]},"post":{"operationId":"projectPriority_createProjectPriority","summary":"Create Project Priority","description":"Create a project priority","tags":["projectPriority"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectPriorityDtoAstroResult"}}}}},"requestBody":{"description":"The data to create the priority","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectPriorityCreateDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/projects/priorities/{priorityId}":{"put":{"operationId":"projectPriority_updateProjectPriority","summary":"Update Project Priority","description":"Updates a project priority","tags":["projectPriority"],"parameters":[{"name":"priorityId","in":"path","description":"The id of the priority to update","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectPriorityDtoAstroResult"}}}}},"requestBody":{"description":"The data to update","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectPriorityCreateDto"}}}},"security":[{"oauth2":[]}]},"delete":{"operationId":"projectPriority_deleteProjectPriority","summary":"Delete Project Priority","description":"Delete a project priority. They will also be removed from any projects they were assigned too.","tags":["projectPriority"],"parameters":[{"name":"priorityId","in":"path","description":"The id of the priority to remove","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/projects/statuses":{"get":{"operationId":"projectStatus_retrieveProjectStatuses","summary":"Retrieve Project Statuses","description":"Retrieves all ProjectStatuses defined within your Workspace.\r\n            \r\nA ProjectStatus is a named condition used by your business to categorize the completion level\r\nof Tasks and Projects within your Workspace.  You can name your ProjectStatus levels anything\r\nyou like and you can reorganize the order of the ProjectPriority levels at any time.","tags":["projectStatus"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectStatusDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]},"post":{"operationId":"projectStatus_createProjectStatus","summary":"Create Project Status","description":"Create a project Status","tags":["projectStatus"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectStatusDtoAstroResult"}}}}},"requestBody":{"description":"The data to create the Status","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectStatusCreateDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/projects/statuses/{projectStatusId}":{"put":{"operationId":"projectStatus_updateProjectStatus","summary":"Update Project Status","description":"Update a project Status","tags":["projectStatus"],"parameters":[{"name":"projectStatusId","in":"path","description":"The status Id","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectStatusDtoAstroResult"}}}}},"requestBody":{"description":"The data to create the Status","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectStatusUpdateDto"}}}},"security":[{"oauth2":[]}]},"delete":{"operationId":"projectStatus_deleteProjectStatus","summary":"Delete Project Status","description":"Delete a project Status","tags":["projectStatus"],"parameters":[{"name":"projectStatusId","in":"path","description":"The status Id","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/projects/templates":{"get":{"operationId":"projectTemplate_retrieveProjectTemplates","summary":"Retrieve Project Templates","description":"Retrieves all ProjectTemplates defined in the system.\r\n            \r\nA ProjectTemplate is a definition of default project related data (eg. Tasks) that can be applied\r\nto a new project when it is created.  ProjectTemplates are categorized using the TemplateCategory\r\nsystem.","tags":["projectTemplate"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectTemplateDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/projects/templates/categories":{"get":{"operationId":"projectTemplate_retrieveTemplateCategories","summary":"Retrieve Template Categories","description":"Retrieves all ProjectTemplate Categories defined in the system.\r\n            \r\nA ProjectTemplate is a definition of default project related data (eg. Tasks) that can be applied\r\nto a new project when it is created.  ProjectTemplates are categorized using the TemplateCategory\r\nsystem.","tags":["projectTemplate"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectTemplateCategoryDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/projects/{projectId}/versions":{"get":{"operationId":"projectVersion_retrieveProjectVersions","summary":"Retrieve Project Versions","description":"Returns projects versions including version, user who made changes","tags":["projectVersion"],"parameters":[{"name":"projectId","in":"path","description":"The unique identifier of the Project","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectVersionDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/projects/{projectChangeId}/version/download":{"get":{"operationId":"projectVersion_downloadMsProjectXml","summary":"Download MSProject Xml","description":"Exports and returns project version as an MS Project XML attachment","tags":["projectVersion"],"parameters":[{"name":"projectChangeId","in":"path","description":"Project change Guid","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"string","format":"byte"}}}}},"security":[{"oauth2":[]}]}},"/api/data/projects/{projectId}/version/{version}/restore":{"post":{"operationId":"projectVersion_restoreProjectVersion","summary":"Restore Project Version","description":"Restores a Project to the state it was in at a specific Version in time.\r\n            \r\nIf successful, all changes made to the Project since this Version will be undone and the Project will\r\nreturn to its former state.","tags":["projectVersion"],"parameters":[{"name":"projectId","in":"path","description":"The unique identifier of the Project to restore","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"version","in":"path","description":"The version number to restore to","required":true,"schema":{"type":"integer"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectRestoreProjectDtoAstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/projects/{projectId}/version/{version}/copy":{"post":{"operationId":"projectVersion_copyProjectVersion","summary":"Copy Project Version","description":"Create a Copy of a Project as of a specific Version, optionally moving it to a new Timezone.","tags":["projectVersion"],"parameters":[{"name":"projectId","in":"path","description":"The unique identifier of the Project to copy","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"version","in":"path","description":"The version number of the Project to copy","required":true,"schema":{"type":"integer"}},{"name":"timezoneOffset","in":"query","description":"If specified, sets the default timezone of the newly copied Project to this\r\n            specified timezone","required":false,"schema":{"type":"integer"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectRestoreProjectDtoAstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/resources":{"get":{"operationId":"resource_queryResources","summary":"Query Resources","description":"Retrieve a list of Resources that match an [OData formatted query](https://www.odata.org/).\r\n            \r\nA Resource represents a person, material, or tool that is used within your Projects.\r\nWhen you attach a Resources to more than one Task, the software will schedule the usage\r\nof your Resource so that it is not allocated to more than one Task at the same time.\r\nThe users in your Workspace are also considered Resources.  To invite a new User to your\r\nWorkspace, create a new Resource for that user.","tags":["resource"],"parameters":[{"name":"$top","in":"query","description":"The number of records to return","required":false,"schema":{"type":"integer"}},{"name":"$skip","in":"query","description":"Skips the given number of records and then returns $top records","required":false,"schema":{"type":"integer"}},{"name":"$filter","in":"query","description":"Filter the expression according to oData queries","required":false,"schema":{"type":"string"}},{"name":"$orderby","in":"query","description":"Order collection by this field.","required":false,"schema":{"type":"string"}},{"name":"$expand","in":"query","description":"Include related data in the response","required":false,"schema":{"type":"string"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ResourceDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]},"post":{"operationId":"resource_createResource","summary":"Create Resource","description":"Create a new Resource within your Workspace.\r\n            \r\nA Resource represents a person, material, or tool that is used within your Projects.\r\nWhen you attach a Resources to more than one Task, the software will schedule the usage\r\nof your Resource so that it is not allocated to more than one Task at the same time.\r\nThe users in your Workspace are also considered Resources.  To invite a new User to your\r\nWorkspace, create a new Resource for that user.","tags":["resource"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ResourceDtoAstroResult"}}}}},"requestBody":{"description":"The details for the new Resource to create","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ResourceCreateDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/resources/{resourceId}":{"get":{"operationId":"resource_retrieveResource","summary":"Retrieve Resource","description":"Retrieve the Resource matching the specified unique ID.\r\n            \r\nA Resource represents a person, material, or tool that is used within your Projects.\r\nWhen you attach a Resources to more than one Task, the software will schedule the usage\r\nof your Resource so that it is not allocated to more than one Task at the same time.\r\nThe users in your Workspace are also considered Resources.  To invite a new User to your\r\nWorkspace, create a new Resource for that user.","tags":["resource"],"parameters":[{"name":"resourceId","in":"path","description":"The id of the Resource","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ResourceDetailsDtoAstroResult"}}}}},"security":[{"oauth2":[]}]},"put":{"operationId":"resource_updateResource","summary":"Update Resource","description":"Updates an existing Resource based on information you provide.\r\n            \r\nA Resource represents a person, material, or tool that is used within your Projects.\r\nWhen you attach a Resources to more than one Task, the software will schedule the usage\r\nof your Resource so that it is not allocated to more than one Task at the same time.\r\nThe users in your Workspace are also considered Resources.  To invite a new User to your\r\nWorkspace, create a new Resource for that user.","tags":["resource"],"parameters":[{"name":"resourceId","in":"path","description":"The id of the resource","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ResourceDtoAstroResult"}}}}},"requestBody":{"description":"The information to update the resource","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ResourceUpdateDto"}}}},"security":[{"oauth2":[]}]},"delete":{"operationId":"resource_deleteResource","summary":"Delete Resource","description":"Deletes an existing Resource based on information you provide.\r\n            \r\nA Resource represents a person, material, or tool used within your Projects.\r\nWhen you attach a Resources to more than one Task, the software will schedule the usage\r\nof your Resource so that it is not allocated to more than one Task at the same time.\r\nThe users in your Workspace are also considered Resources.  To invite a new User to your\r\nWorkspace, create a new Resource for that user.","tags":["resource"],"parameters":[{"name":"resourceId","in":"path","description":"The id of the resource","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ResourceDtoAstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/resources/bulk":{"post":{"operationId":"resource_createManyResources","summary":"Create Many Resources","description":"Create new Resources within your Workspace.\r\n            \r\nA Resource represents a person, material, or tool that is used within your Projects.\r\nWhen you attach a Resources to more than one Task, the software will schedule the usage\r\nof your Resource so that it is not allocated to more than one Task at the same time.\r\nThe users in your Workspace are also considered Resources.  To invite a new User to your\r\nWorkspace, create a new Resource for that user.","tags":["resource"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ResourcesDtoAstroResult"}}}}},"requestBody":{"description":"The details for the new Resources to create","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ResourcesCreateDto"}}}},"security":[{"oauth2":[]}]},"put":{"operationId":"resource_bulkUpdateResources","summary":"Bulk Update Resources","description":"Updates a list of existing Resources in a single API call.\r\n            \r\nEach entry identifies the Resource to update via its ResourceId and supplies the fields to change.\r\nOnly fields that are sensible to update across many Resources at once are accepted; see\r\nResourceBulkUpdateDto for the supported fields. The whole request is validated before any changes\r\nare applied - if any entry fails validation, no Resources are updated and the individual failures\r\nare returned in the AdditionalErrors of the result.","tags":["resource"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ResourceDtoListAstroResult"}}}}},"requestBody":{"description":"The list of Resources to update","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/ResourceBulkUpdateDto"}}}}},"security":[{"oauth2":[]}]}},"/api/data/resources/{resourceId}/resendinvite":{"get":{"operationId":"resource_resendInviteEmail","summary":"Resend Invite Email","description":"Resend Invite Email to a Resource within your Workspace.\r\n            \r\nWhen you create a Resource that is a person, ProjectManager sends that person an email inviting them to join\r\nyour Workspace.  If that email is accidentally deleted or sent to a spam folder, you can request this email\r\nbe sent again using this API.","tags":["resource"],"parameters":[{"name":"resourceId","in":"path","description":"The unique identifier of the Resource to send an invitation email","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/resources/{resourceId}/avatar":{"get":{"operationId":"resource_getResourceAvatar","summary":"Get Resource Avatar","description":"Get Resource Avatar","tags":["resource"],"parameters":[{"name":"resourceId","in":"path","description":"The id of the resource","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/resources/skills":{"get":{"operationId":"resourceSkill_retrieveResourceSkills","summary":"Retrieve Resource Skills","description":"Retrieves all ResourceSkills defined within your Workspace.\r\n            \r\nA ResourceSkill is a capability possessed by a Resource that can be used to distinguish\r\ndifferent classes of Resources suitable for use by a Task.  You can specify that a Task\r\nrequires a Resource with a particular set of ResourceSkills and then allocate Resources\r\nbased on whether or not they have the suitable ResourceSkills.","tags":["resourceSkill"],"parameters":[{"name":"$top","in":"query","description":"The number of records to return","required":false,"schema":{"type":"integer"}},{"name":"$skip","in":"query","description":"Skips the given number of records and then returns $top records","required":false,"schema":{"type":"integer"}},{"name":"$filter","in":"query","description":"Filter the expression according to oData queries","required":false,"schema":{"type":"string"}},{"name":"$orderby","in":"query","description":"Order collection by this field.","required":false,"schema":{"type":"string"}},{"name":"$expand","in":"query","description":"Include related data in the response","required":false,"schema":{"type":"string"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ResourceSkillDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]},"post":{"operationId":"resourceSkill_createResourceSkill","summary":"Create Resource Skill","description":"Create a Resource Skill.","tags":["resourceSkill"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ResourceSkillDtoAstroResult"}}}}},"requestBody":{"description":"The name of the skill to create.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateResourceSkillDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/resources/skills/{resourceSkillId}":{"put":{"operationId":"resourceSkill_updateResourceSkill","summary":"Update Resource Skill","description":"Update a Resource Skill.","tags":["resourceSkill"],"parameters":[{"name":"resourceSkillId","in":"path","description":"The id of the skill to update.","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ResourceSkillDtoAstroResult"}}}}},"requestBody":{"description":"The data of the skill to update.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateResourceSkillDto"}}}},"security":[{"oauth2":[]}]},"delete":{"operationId":"resourceSkill_deleteResourceSkill","summary":"Delete Resource Skill","description":"The endpoint is used to delete a resource skill. Users assigned to this skill will no longer be assigned thereafter.","tags":["resourceSkill"],"parameters":[{"name":"resourceSkillId","in":"path","description":"The Id of the skill to be removed.","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/resources/teams/{resourceTeamId}":{"get":{"operationId":"resourceTeam_getResourceTeam","summary":"Get Resource Team","description":"Retrieves a single ResourceTeam object by its unique identifier\r\n            \r\nA ResourceTeam is a grouping of Resources that allows you to keep track of assignments\r\nin a manner consistent with your business needs.  You can assign Resources to be members\r\nof zero, one, or many ResourceTeams.","tags":["resourceTeam"],"parameters":[{"name":"resourceTeamId","in":"path","description":"The unique identifier of the ResourceTeam to retrieve","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ResourceTeamDtoAstroResult"}}}}},"security":[{"oauth2":[]}]},"put":{"operationId":"resourceTeam_updateResourceTeam","summary":"Update Resource Team","description":"Update a Resource Team.\r\n            \r\nA ResourceTeam is a grouping of Resources that allows you to keep track of assignments\r\nin a manner consistent with your business needs.  You can assign Resources to be members\r\nof zero, one, or many ResourceTeams.","tags":["resourceTeam"],"parameters":[{"name":"resourceTeamId","in":"path","description":"The id of the resource team","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ResourceTeamDtoAstroResult"}}}}},"requestBody":{"description":"The name of the team to Update.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateResourceTeamDto"}}}},"security":[{"oauth2":[]}]},"delete":{"operationId":"resourceTeam_deleteResourceTeam","summary":"Delete Resource Team","description":"Deletes a resource team by its unique identifier.\r\n            \r\nA ResourceTeam is a grouping of Resources that allows you to keep track of assignments\r\nin a manner consistent with your business needs.  You can assign Resources to be members\r\nof zero, one, or many ResourceTeams.","tags":["resourceTeam"],"parameters":[{"name":"resourceTeamId","in":"path","description":"The unique ID of the team to be removed","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/resources/teams":{"get":{"operationId":"resourceTeam_queryResourceTeams","summary":"Query Resource Teams","description":"Retrieves all ResourceTeams defined within your Workspace that match an [OData formatted query](https://www.odata.org/).\r\n            \r\nA ResourceTeam is a grouping of Resources that allows you to keep track of assignments\r\nin a manner consistent with your business needs.  You can assign Resources to be members\r\nof zero, one, or many ResourceTeams.","tags":["resourceTeam"],"parameters":[{"name":"$top","in":"query","description":"The number of records to return","required":false,"schema":{"type":"integer"}},{"name":"$skip","in":"query","description":"Skips the given number of records and then returns $top records","required":false,"schema":{"type":"integer"}},{"name":"$filter","in":"query","description":"Filter the expression according to oData queries","required":false,"schema":{"type":"string"}},{"name":"$orderby","in":"query","description":"Order collection by this field.","required":false,"schema":{"type":"string"}},{"name":"$expand","in":"query","description":"Include related data in the response","required":false,"schema":{"type":"string"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ResourceTeamDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]},"post":{"operationId":"resourceTeam_createResourceTeam","summary":"Create Resource Team","description":"Create a Resource Team within your workspace\r\n            \r\nA ResourceTeam is a grouping of Resources that allows you to keep track of assignments\r\nin a manner consistent with your business needs.  You can assign Resources to be members\r\nof zero, one, or many ResourceTeams.","tags":["resourceTeam"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ResourceTeamDtoAstroResult"}}}}},"requestBody":{"description":"The name of the ResourceTeam to create","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateResourceTeamDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/risks/{riskId}/files":{"post":{"operationId":"riskFile_uploadRiskFile","summary":"Upload Risk File","description":"Uploads a file to a risk.\r\n            \r\nProjectManager allows you to store Files connected to other elements of your Workspace\r\nsuch as a Project, a Task, or Home.  Files are maintained separately based on the location\r\nwhere the file was stored.\r\n            \r\nWhen you upload a File, please allow a few moments for the File to be processed and verified.\r\nProjectManager may reject File uploads that contain problems such as malware. Once a File has\r\ncompleted the upload the process, you may retrieve it using the DownloadFile API.\r\n            \r\nThis API returns a JSON response indicating success or failure.","tags":["riskFile"],"parameters":[{"name":"riskId","in":"path","description":"The reference to the risk","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/FileDtoAstroResult"}}}}},"requestBody":{"content":{"multipart/form-data":{"schema":{"type":"object","properties":{"file":{"type":"string","format":"binary"}}}}}},"security":[{"oauth2":[]}]}},"/api/data/risks/{riskId}/tags":{"get":{"operationId":"riskTag_retrieveTagsForARisk","summary":"Retrieve tags for a Risk","description":"Returns the list of tags assigned to the specified Risk.","tags":["riskTag"],"parameters":[{"name":"riskId","in":"path","description":"The unique identifier of the Risk","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskTagDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]},"post":{"operationId":"riskTag_replaceRiskTags","summary":"Replace Risk Tags","description":"Replaces the existing tags on a Risk with a newly provided list.\r\nA tag is a connection between a Risk and a Tag. Each Risk can have zero, one or many tags.","tags":["riskTag"],"parameters":[{"name":"riskId","in":"path","description":"The unique identifier of the Risk","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskTagDtoListAstroResult"}}}}},"requestBody":{"description":"The replacement list of tags for this Risk","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/NameDto"}}}}},"security":[{"oauth2":[]}]},"put":{"operationId":"riskTag_addTagsToRisk","summary":"Add tags to Risk","description":"Add one or more tags to a Risk.","tags":["riskTag"],"parameters":[{"name":"riskId","in":"path","description":"The unique identifier of the Risk","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskTagDtoListAstroResult"}}}}},"requestBody":{"description":"The tags to add","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/NameDto"}}}}},"security":[{"oauth2":[]}]},"delete":{"operationId":"riskTag_removeTagsFromRisk","summary":"Remove tags from Risk","description":"Removes one or more tags from a Risk.","tags":["riskTag"],"parameters":[{"name":"riskId","in":"path","description":"The unique identifier of the Risk","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AstroResult"}}}}},"requestBody":{"description":"The tags to remove","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/NameDto"}}}}},"security":[{"oauth2":[]}]}},"/api/data/security/businessroles":{"get":{"operationId":"security_listBusinessRoles","summary":"List Business Roles","description":"Returns every business role in the current workspace, including built-in and custom roles.\r\n            \r\nEach role includes a permissions object with entitlement and grant state for the account security matrix.","tags":["security"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/BusinessRolesListDtoAstroResult"}}}}},"security":[{"oauth2":[]}]},"post":{"operationId":"security_createBusinessRole","summary":"Create Business Role","description":"Chargebee entitlements are evaluated read-only when saving permission grants; this call does not change subscription state.","tags":["security"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RoleDtoAstroResult"}}}}},"requestBody":{"description":"Role name, optional description, and permission settings for the new role.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RoleCreateDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/security/businessroles/{roleId}":{"put":{"operationId":"security_updateBusinessRole","summary":"Update Business Role","description":"Send property change sets using the same pattern as other workspace batch-update APIs.\r\n            \r\nFor permissions, include a permissions property with a partial or full permissions object; omitted keys are merged with the current role.\r\nKeys may use the same names as GET `permissions` (e.g. `editUsers`) or RetrieveMe / POST-create style (e.g. `editUser`).\r\nThe response body matches create when successful.","tags":["security"],"parameters":[{"name":"roleId","in":"path","description":"Business role identifier.","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RoleDtoAstroResult"}}}}},"requestBody":{"description":"List of property name and value pairs to apply.","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/RoleUpdateChangeItemDto"}}}}},"security":[{"oauth2":[]}]},"delete":{"operationId":"security_deleteBusinessRole","summary":"Delete Business Role","description":"Built-in roles cannot be deleted. Users assigned to the role may need to be reassigned before the role can be removed.","tags":["security"],"parameters":[{"name":"roleId","in":"path","description":"Identifier of the custom role to remove.","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/security/email/validation/resend":{"get":{"operationId":"security_resendEmailValidation","summary":"Resend Email Validation","description":"Sends another validation email to the authenticated user's workspace email address.","tags":["security"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/tags":{"get":{"operationId":"tag_queryTags","summary":"Query Tags","description":"Retrieve a list of Tags that match an [OData formatted query](https://www.odata.org/).\r\n            \r\nA Tag is a named categorization you can use to distinguish objects from each other.\r\nTags each have a unique identifier, a name, and a color.","tags":["tag"],"parameters":[{"name":"$top","in":"query","description":"The number of records to return","required":false,"schema":{"type":"integer"}},{"name":"$skip","in":"query","description":"Skips the given number of records and then returns $top records","required":false,"schema":{"type":"integer"}},{"name":"$filter","in":"query","description":"Filter the expression according to oData queries","required":false,"schema":{"type":"string"}},{"name":"$orderby","in":"query","description":"Order collection by this field.","required":false,"schema":{"type":"string"}},{"name":"$expand","in":"query","description":"Include related data in the response","required":false,"schema":{"type":"string"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TagDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]},"post":{"operationId":"tag_createTag","summary":"Create Tag","description":"Creates a new Tag based on information you provide.\r\n            \r\nA Tag is a named categorization you can use to distinguish objects from each other.\r\nTags each have a unique identifier, a name, and a color.","tags":["tag"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TagDtoAstroResult"}}}}},"requestBody":{"description":"The information for the new Tag to create","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TagCreateDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/tags/{tagId}":{"put":{"operationId":"tag_updateTag","summary":"Update Tag","description":"Updates an existing Tag based on information you provide.\r\n            \r\nA Tag is a named categorization you can use to distinguish objects from each other.\r\nTags each have a unique identifier, a name, and a color.","tags":["tag"],"parameters":[{"name":"tagId","in":"path","description":"The id of the tag","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TagDtoAstroResult"}}}}},"requestBody":{"description":"The information to update the tag","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TagUpdateDto"}}}},"security":[{"oauth2":[]}]},"delete":{"operationId":"tag_deleteTag","summary":"Delete Tag","description":"Permanently removes the specified Tag.","tags":["tag"],"parameters":[{"name":"tagId","in":"path","description":"The id of the tag to delete","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/tasks":{"get":{"operationId":"task_queryTasks","summary":"Query Tasks","description":"Retrieve a list of Tasks that match an [OData formatted query](https://www.odata.org/).\r\n            \r\nA Task is an individual element of work that must be performed to complete a Project.  A\r\nTask can have one or more Resources assigned to it.  Tasks can be linked to other Tasks to\r\nindicate whether they have a dependency or a connection.","tags":["task"],"parameters":[{"name":"$top","in":"query","description":"The number of records to return","required":false,"schema":{"type":"integer"}},{"name":"$skip","in":"query","description":"Skips the given number of records and then returns $top records","required":false,"schema":{"type":"integer"}},{"name":"$filter","in":"query","description":"Filter the expression according to oData queries","required":false,"schema":{"type":"string"}},{"name":"$orderby","in":"query","description":"Order collection by this field.","required":false,"schema":{"type":"string"}},{"name":"$expand","in":"query","description":"Include related data in the response","required":false,"schema":{"type":"string"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/tasks/{taskId}":{"get":{"operationId":"task_retrieveTask","summary":"Retrieve Task","description":"Retrieve a Task by its unique identifier or by its short ID.  A Task has both a unique\r\nidentifier, which is a GUID, and a short ID, which is a small text label that is unique\r\nonly within your Workspace.\r\n            \r\nA Task is an individual element of work that must be performed to complete a Project.  A\r\nTask can have one or more Resources assigned to it.  Tasks can be linked to other Tasks to\r\nindicate whether they have a dependency or a connection.\r\n            \r\nThis GET operation will also update the internal \"last viewed\" date for this Task for the\r\ncurrent user.","tags":["task"],"parameters":[{"name":"taskId","in":"path","description":"The unique identifier or short ID of the Task to retrieve","required":true,"schema":{"type":"string"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskDetailsDtoAstroResult"}}}}},"security":[{"oauth2":[]}]},"put":{"operationId":"task_updateTask","summary":"Update Task","description":"Update an existing Task and replace the values of fields specified.\r\n            \r\nA Task is an individual element of work that must be performed to complete a Project.  A\r\nTask can have one or more Resources assigned to it.  Tasks can be linked to other Tasks to\r\nindicate whether they have a dependency or a connection.\r\n            \r\nMultiple users can be working on data at the same time.  When you call an API to update an\r\nobject, this call is converted into a Changeset that is then applied sequentially.  You can use\r\nRetrieveChangeset to see the status of an individual Changeset.\r\n            \r\nKnown Issues:  This API returns an error if your Update call includes too many changes in a\r\nsingle API call.  Please restrict usage to one change per API request.  This API will be\r\ndeprecated and replaced with an improved API call in a future release.","tags":["task"],"parameters":[{"name":"taskId","in":"path","description":"The unique identifier of the Task to update","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChangeSetStatusDtoAstroResult"}}}}},"requestBody":{"description":"All non-null fields in this object will replace existing data in the Task","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskUpdateDto"}}}},"security":[{"oauth2":[]}]},"delete":{"operationId":"task_deleteTask","summary":"Delete Task","description":"Delete an existing Task.\r\n            \r\nA Task is an individual element of work that must be performed to complete a Project.  A\r\nTask can have one or more Resources assigned to it.  Tasks can be linked to other Tasks to\r\nindicate whether they have a dependency or a connection.\r\n            \r\nMultiple users can be working on data at the same time.  When you call an API to update an\r\nobject, this call is converted into a Changeset that is then applied sequentially.  You can use\r\nRetrieveChangeset to see the status of an individual Changeset.","tags":["task"],"parameters":[{"name":"taskId","in":"path","description":"Unique identifier of the Task to delete","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChangeSetStatusDtoAstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/tasks/{taskId}/subtasks":{"get":{"operationId":"task_fetchTheFirstLevelChildTasksFromTheTask","summary":"Fetch the first level child tasks from the task","description":"Fetch the first level child tasks from the task","tags":["task"],"parameters":[{"name":"taskId","in":"path","description":"Parent task id","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/projects/{projectId}/tasks":{"post":{"operationId":"task_createTask","summary":"Create Task","description":"Create a new Task within a specified project.\r\n            \r\nA Task is an individual element of work that must be performed to complete a Project.  A\r\nTask can have one or more Resources assigned to it.  Tasks can be linked to other Tasks to\r\nindicate whether they have a dependency or a connection.","tags":["task"],"parameters":[{"name":"projectId","in":"path","description":"The unique identifier of the Project that will contain this Task","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChangeSetStatusDtoAstroResult"}}}}},"requestBody":{"description":"The new Task to create","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskCreateDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/tasks/priorities":{"get":{"operationId":"task_retrieveTaskPriorities","summary":"Retrieve Task Priorities","description":"Retrieves all TaskPriorities defined within your Workspace.\r\n            \r\nA TaskPriority is a named priority level used by your business to determine how to decide\r\nwhich Tasks are the most important.  You can name your TaskPriority levels anything you like\r\nand you can reorganize the order of the TaskPriority levels at any time.\r\n            \r\nNote that TaskPriority and ProjectPriority are different classes of priority levels.  Even\r\nif they may have similar names, they are different objects and must be tracked separately.","tags":["task"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskPriorityDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/projects/{projectId}/tasks/bulk":{"post":{"operationId":"task_createManyTasks","summary":"Create Many Tasks","description":"Create multiple new Tasks within a specified project with a single API call.\r\n            \r\nA Task is an individual element of work that must be performed to complete a Project.  A\r\nTask can have one or more Resources assigned to it.  Tasks can be linked to other Tasks to\r\nindicate whether they have a dependency or a connection.","tags":["task"],"parameters":[{"name":"projectId","in":"path","description":"The unique identifier of the Project that will contain these Tasks","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChangeSetStatusDtoListAstroResult"}}}}},"requestBody":{"description":"The list of new Tasks to create","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/TaskCreateDto"}}}}},"security":[{"oauth2":[]}]}},"/api/data/tasks/{taskId}/parent/{parentTaskId}":{"post":{"operationId":"task_addParentTask","summary":"Add Parent Task","description":"Adds a task parent relationship","tags":["task"],"parameters":[{"name":"taskId","in":"path","description":"The task that will become the child","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"parentTaskId","in":"path","description":"The parent task","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChangeSetStatusDtoAstroResult"}}}}},"security":[{"oauth2":[]}]},"put":{"operationId":"task_updateParentTask","summary":"Update Parent Task","description":"Updates a task parent relationship","tags":["task"],"parameters":[{"name":"taskId","in":"path","description":"The task that will become the child","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"parentTaskId","in":"path","description":"The parent task","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChangeSetStatusDtoAstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/tasks/{taskId}/parent":{"delete":{"operationId":"task_removeParentTask","summary":"Remove Parent Task","description":"Removes a task parent relationship completely","tags":["task"],"parameters":[{"name":"taskId","in":"path","description":"The child task","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChangeSetStatusDtoAstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/tasks/{taskId}/approval-status":{"put":{"operationId":"task_updateTheApprovalStatusOfATask","summary":"Update the approval status of a Task.","description":"Sets the approval status of an existing Task to either `Approved` or `Denied`.\r\n            \r\nApproval status is only supported for project Tasks. Non-project tasks (NPTs) and\r\nnon-task task types do not support approval and will return a validation error.\r\n            \r\nThis operation is processed as a Changeset to ensure sequential application and\r\nconcurrency safety.","tags":["task"],"parameters":[{"name":"taskId","in":"path","description":"The unique identifier of the Task to update","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChangeSetStatusDtoAstroResult"}}}}},"requestBody":{"description":"The approval status update payload indicating whether the Task is approved or denied.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskApprovalStatusUpdateDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/tasks/{taskId}/mark-read":{"post":{"operationId":"task_markTaskAsReadForTheCurrentUser","summary":"Mark task as read for the current user","description":"Updates the task user read record (last viewed) for the authenticated user. Use this\r\nwhen the UI only needs to mark file/discussion read state\r\nwithout loading full task details.","tags":["task"],"parameters":[{"name":"taskId","in":"path","description":"Task unique identifier","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/task/{taskId}/time":{"get":{"operationId":"task_plannedAllocationsAndActualTimesheetMinutesForATaskGroupedByResource","summary":"Planned allocations and actual timesheet minutes for a task, grouped by resource.","description":"Returns a summary of planned allocations and logged timesheet minutes for the specified task,\r\ngrouped by resource. Use this when the client needs time rollups without loading individual\r\ntimesheet entries.","tags":["task"],"parameters":[{"name":"taskId","in":"path","description":"The unique identifier of the task","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskTimeSummaryDtoAstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/tasks/{taskId}/assignees":{"get":{"operationId":"taskAssignee_returnsTaskAssignees","summary":"Returns task assignees","description":"Returns list of assignees.\r\n            \r\nA TaskAssignee is an assignment of a Resource to a Task.  You can assign multiple Resources\r\nto a Task and designate what proportion of their time will be allocated to this Task.","tags":["taskAssignee"],"parameters":[{"name":"taskId","in":"path","description":"The unique identifier of the Task","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AssigneeDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]},"post":{"operationId":"taskAssignee_replaceTaskAssignees","summary":"Replace Task Assignees","description":"Replace all TaskAssignees on a Task with new TaskAssignees.\r\n            \r\nA TaskAssignee is an assignment of a Resource to a Task.  You can assign multiple Resources\r\nto a Task and designate how much of their time will be allocated to this Task.\r\n\r\nIn the request body, id is the id of the Resource you would like to assign to the Task, and \r\nassignedEffort is the amount of time that Resource is expected to spend on the task. assignedEffort \r\nshould be entered in minutes.","tags":["taskAssignee"],"parameters":[{"name":"taskId","in":"path","description":"The unique identifier of the Task whose TaskAssignees will be replaced","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChangeSetStatusDtoAstroResult"}}}}},"requestBody":{"description":"The new list of TaskAssignees for this Task","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/AssigneeUpsertDto"}}}}},"security":[{"oauth2":[]}]},"put":{"operationId":"taskAssignee_createOrUpdateTaskAssignee","summary":"Create Or Update TaskAssignee","description":"Adds or updates a TaskAssignee to a Task.  If the TaskAssignee is already assigned to the Task, update\r\ntheir allocation.  If the TaskAssignee is not yet assigned to the Task, assign them and set their\r\nallocation level to the correct amount.\r\n            \r\nA TaskAssignee is an assignment of a Resource to a Task.  You can assign multiple Resources\r\nto a Task and designate what proportion of their time will be allocated to this Task.","tags":["taskAssignee"],"parameters":[{"name":"taskId","in":"path","description":"The unique identifier of the Task to add or update an assignment","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChangeSetStatusDtoAstroResult"}}}}},"requestBody":{"description":"List of Assignee data","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/AssigneeUpsertDto"}}}}},"security":[{"oauth2":[]}]},"delete":{"operationId":"taskAssignee_deleteTaskAssignees","summary":"Delete Task Assignees","description":"Remove one or more TaskAssignees from a Task.\r\n            \r\nA TaskAssignee is an assignment of a Resource to a Task.  You can assign multiple Resources\r\nto a Task and designate what proportion of their time will be allocated to this Task.","tags":["taskAssignee"],"parameters":[{"name":"taskId","in":"path","description":"The unique identifier of the Task whose TaskAssignee will be removed","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChangeSetStatusDtoAstroResult"}}}}},"requestBody":{"description":"List of TaskAssignee records to remove","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/IdDto"}}}}},"security":[{"oauth2":[]}]}},"/api/data/projects/{projectId}/tasks/fields":{"get":{"operationId":"taskField_retrieveTaskFields","summary":"Retrieve Task Fields","description":"Retrieves all TaskFields defined for a specific Project within your Workspace.\r\n            \r\nA TaskField is a custom field defined within your Workspace for a specific Project.  You can\r\ndefine TaskFields for any integration purpose that is important to your business.  Each\r\nTaskField has a data type as well as options in how it is handled.  TaskFields can be edited\r\nfor each Task inside this Project.","tags":["taskField"],"parameters":[{"name":"projectId","in":"path","description":"The unique identifier of the Project to retrieve TaskFields","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskFieldDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]},"post":{"operationId":"taskField_createTaskField","summary":"Create Task Field","description":"Creates a new TaskField for a specific Project within your Workspace.\r\n            \r\nA TaskField is a custom field defined within your Workspace for a specific Project.  You can\r\ndefine TaskFields for any integration purpose that is important to your business.  Each\r\nTaskField has a data type as well as options in how it is handled.  TaskFields can be edited\r\nfor each Task inside this Project.","tags":["taskField"],"parameters":[{"name":"projectId","in":"path","description":"The unique identifier of the Project within which to create this TaskField","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChangeSetStatusDtoAstroResult"}}}}},"requestBody":{"description":"Information about the TaskField to create","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateTaskFieldDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/projects/tasks/fields":{"get":{"operationId":"taskField_queryTaskFields","summary":"Query Task Fields","description":"Retrieve a list of TaskFields that match an [OData formatted query](https://www.odata.org/).\r\n            \r\nA TaskField is a custom field defined within your Workspace for a specific Project.  You can\r\ndefine TaskFields for any integration purpose that is important to your business.  Each\r\nTaskField has a data type as well as options in how it is handled.  TaskFields can be edited\r\nfor each Task inside a Project.","tags":["taskField"],"parameters":[{"name":"$top","in":"query","description":"The number of records to return","required":false,"schema":{"type":"integer"}},{"name":"$skip","in":"query","description":"Skips the given number of records and then returns $top records","required":false,"schema":{"type":"integer"}},{"name":"$filter","in":"query","description":"Filter the expression according to oData queries","required":false,"schema":{"type":"string"}},{"name":"$orderby","in":"query","description":"Order collection by this field.","required":false,"schema":{"type":"string"}},{"name":"$expand","in":"query","description":"Include related data in the response","required":false,"schema":{"type":"string"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskFieldDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/projects/{projectId}/tasks/fields/{fieldId}":{"delete":{"operationId":"taskField_deleteTaskField","summary":"Delete Task Field","description":"Deletes a TaskField for a specific Project within your Workspace.\r\n            \r\nA TaskField is a custom field defined within your Workspace for a specific Project.  You can\r\ndefine TaskFields for any integration purpose that is important to your business.  Each\r\nTaskField has a data type as well as options in how it is handled.  TaskFields can be edited\r\nfor each Task inside this Project.","tags":["taskField"],"parameters":[{"name":"projectId","in":"path","description":"The unique identifier of the Project that contains this TaskField","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"fieldId","in":"path","description":"The unique identifier of the TaskField to delete","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/tasks/fields/values":{"get":{"operationId":"taskField_queryTaskFieldValues","summary":"Query Task Field Values","description":"Retrieve a list of TaskFieldValues that match an [OData formatted query](https://www.odata.org/).\r\n            \r\nA TaskField is a custom field defined within your Workspace for a specific Project.  You can\r\ndefine TaskFields for any integration purpose that is important to your business.  Each\r\nTaskField has a data type as well as options in how it is handled.  TaskFields can be edited\r\nfor each Task inside this Project.","tags":["taskField"],"parameters":[{"name":"$top","in":"query","description":"The number of records to return","required":false,"schema":{"type":"integer"}},{"name":"$skip","in":"query","description":"Skips the given number of records and then returns $top records","required":false,"schema":{"type":"integer"}},{"name":"$filter","in":"query","description":"Filter the expression according to oData queries","required":false,"schema":{"type":"string"}},{"name":"$orderby","in":"query","description":"Order collection by this field.","required":false,"schema":{"type":"string"}},{"name":"$expand","in":"query","description":"Include related data in the response","required":false,"schema":{"type":"string"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskFieldValueDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/tasks/{taskId}/fields/{fieldId}":{"get":{"operationId":"taskField_retrieveTaskFieldValue","summary":"Retrieve Task Field Value","description":"This endpoint has been replace with `tasks/{taskId}/fields/{fieldId}/values`","tags":["taskField"],"parameters":[{"name":"taskId","in":"path","description":"The unique identifier of the Task of the value to retrieve","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"fieldId","in":"path","description":"The unique identifier of the TaskField of the value to retrieve","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskFieldValueDtoAstroResult"}}}}},"deprecated":true,"security":[{"oauth2":[]}]},"put":{"operationId":"taskField_updateTaskFieldValue","summary":"Update Task Field Value","description":"This endpoint has been replace with `tasks/{taskId}/fields/{fieldId}/values`","tags":["taskField"],"parameters":[{"name":"taskId","in":"path","description":"The unique identifier of the Task whose value you wish to update","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"fieldId","in":"path","description":"The unique identifier of the TaskField whose value you wish to update","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChangeSetStatusDtoAstroResult"}}}}},"deprecated":true,"requestBody":{"description":"The new value for this TaskField for this Task","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateTaskFieldValueDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/tasks/{taskId}/fields":{"get":{"operationId":"taskField_retrieveAllTaskFieldValues","summary":"Retrieve All Task Field Values","description":"This endpoint has been replace with `tasks/{taskId}/fields/{fieldId}/values`","tags":["taskField"],"parameters":[{"name":"taskId","in":"path","description":"The unique identifier of the Task for which we want TaskField values","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskFieldValueDtoListAstroResult"}}}}},"deprecated":true,"security":[{"oauth2":[]}]}},"/api/data/tasks/{taskId}/files":{"get":{"operationId":"taskFile_getTaskFiles","summary":"Get Task Files","description":"retrieves task files","tags":["taskFile"],"parameters":[{"name":"taskId","in":"path","description":"The reference to the task","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskFileDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]},"post":{"operationId":"taskFile_uploadTaskFile","summary":"Upload Task File","description":"Uploads a file to a task.\r\n            \r\nProjectManager allows you to store Files connected to other elements of your Workspace\r\nsuch as a Project, a Task, or Home.  Files are maintained separately based on the location\r\nwhere the file was stored.\r\n            \r\nWhen you upload a File, please allow a few moments for the File to be processed and verified.\r\nProjectManager may reject File uploads that contain problems such as malware. Once a File has\r\ncompleted the upload the process, you may retrieve it using the DownloadFile API.\r\n            \r\nThis API returns a JSON response indicating success or failure.","tags":["taskFile"],"parameters":[{"name":"taskId","in":"path","description":"The reference to the task","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/FileDtoAstroResult"}}}}},"requestBody":{"content":{"multipart/form-data":{"schema":{"type":"object","properties":{"file":{"type":"string","format":"binary"}}}}}},"security":[{"oauth2":[]}]}},"/api/data/tasks/{taskId}/links-to":{"post":{"operationId":"taskLink_createTaskLink","summary":"Create Task Link","description":"Creates a new link (dependency) from this Task to another Task in the same Project.\r\n            \r\nA Task Link connects a predecessor Task to a successor Task, indicating a scheduling\r\ndependency between them. The link type controls how the two Tasks' dates relate to\r\neach other, and lag adds (or, if negative, removes) time between them.\r\n            \r\nValid LinkType values (case-insensitive): finishToStart, startToStart, finishToFinish, startToFinish.\r\nOmitting LinkType defaults to finishToStart.","tags":["taskLink"],"parameters":[{"name":"taskId","in":"path","description":"The unique identifier of the predecessor Task for this link","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChangeSetStatusDtoAstroResult"}}}}},"requestBody":{"description":"The Task to link to, along with the link type and lag","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskLinkCreateDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/tasks/{taskId}/links-to/{successorTaskId}":{"put":{"operationId":"taskLink_updateTaskLink","summary":"Update Task Link","description":"Updates the link type and/or lag of an existing link between this Task and another Task.","tags":["taskLink"],"parameters":[{"name":"taskId","in":"path","description":"The unique identifier of the predecessor Task for this link","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"successorTaskId","in":"path","description":"The unique identifier of the successor Task for this link","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChangeSetStatusDtoAstroResult"}}}}},"requestBody":{"description":"The new link type and lag for this link","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskLinkUpdateDto"}}}},"security":[{"oauth2":[]}]},"delete":{"operationId":"taskLink_deleteTaskLink","summary":"Delete Task Link","description":"Removes an existing link between this Task and another Task.","tags":["taskLink"],"parameters":[{"name":"taskId","in":"path","description":"The unique identifier of the predecessor Task for this link","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"successorTaskId","in":"path","description":"The unique identifier of the successor Task for this link","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChangeSetStatusDtoAstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/tasks/{taskId}/links":{"get":{"operationId":"taskLink_retrieveTaskLinks","summary":"Retrieve Task Links","description":"Retrieve the existing links from this Task to other Tasks.","tags":["taskLink"],"parameters":[{"name":"taskId","in":"path","description":"The unique identifier of the predecessor Task","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskLinkDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/tasks/{taskId}/metadata":{"get":{"operationId":"taskMetadata_getTaskMetadata","summary":"Get task metadata","description":"Retrieves extra metadata about a Task","tags":["taskMetadata"],"parameters":[{"name":"taskId","in":"path","description":"Task ID","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"isSystem","in":"query","description":"If metadata is for system or customer, isSystem = true is only of ProjectManager","required":false,"schema":{"type":"boolean","default":false}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/StringStringDictionaryAstroResult"}}}}},"security":[{"oauth2":[]}]},"put":{"operationId":"taskMetadata_addMetadata","summary":"Add Metadata","description":"Adds a metadata to a task","tags":["taskMetadata"],"parameters":[{"name":"taskId","in":"path","description":"Task ID","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"isSystem","in":"query","description":"If metadata is for system or customer, isSystem = true is only of ProjectManager","required":false,"schema":{"type":"boolean","default":false}},{"name":"isOverride","in":"query","description":"If false we merge with the keys","required":false,"schema":{"type":"boolean","default":false}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AstroResult"}}}}},"requestBody":{"description":"The metadata","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskMetadataUpdateDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/projects/{projectId}/tasks/metadata":{"get":{"operationId":"taskMetadata_taskMetadataSearch","summary":"Task Metadata Search","description":"Get tasks by project ID and foreign key ID","tags":["taskMetadata"],"parameters":[{"name":"projectId","in":"path","description":"Project ID","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"foreignKey","in":"query","description":"Foreign Key ID","required":false,"schema":{"type":"string"}},{"name":"isSystem","in":"query","description":"If metadata is for system or customer, isSystem = true is only of ProjectManager","required":false,"schema":{"type":"boolean","default":false}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskMetadataSearchDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/tasks/{taskId}/recurring/weekly":{"post":{"operationId":"taskRecurrency_createWeeklyRecurringTasks","summary":"Create Weekly Recurring Tasks","description":"Changes an existing Task into a Recurring Task, so that it will recur regularly given the specified rules.\r\n            \r\nA Recurring Task is one that must be completed on a specific regular frequency, such as Daily, Weekly, Monthly,\r\nor Yearly.  To create a Recurring Task, you must first create a regular Task with the necessary information,\r\nthen call one of the Create Recurring Task APIs.  To remove an instance of a Recurring Task, call Delete\r\nRecurring Task and specify one or more instances of the Recurring Task.","tags":["taskRecurrency"],"parameters":[{"name":"taskId","in":"path","description":"The unique identifier of the Task","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RecurringTaskChangeSetDetailsChangeSetStatusDtoAstroResult"}}}}},"requestBody":{"description":"The weekly recurring settings","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WeeklyRecurringSettingsDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/tasks/{taskId}/recurring/monthly":{"post":{"operationId":"taskRecurrency_createMonthlyRecurringTasks","summary":"Create Monthly Recurring Tasks","description":"Changes an existing Task into a Recurring Task, so that it will recur regularly given the specified rules.\r\n            \r\nA Recurring Task is one that must be completed on a specific regular frequency, such as Daily, Weekly, Monthly,\r\nor Yearly.  To create a Recurring Task, you must first create a regular Task with the necessary information,\r\nthen call one of the Create Recurring Task APIs.  To remove an instance of a Recurring Task, call Delete\r\nRecurring Task and specify one or more instances of the Recurring Task.","tags":["taskRecurrency"],"parameters":[{"name":"taskId","in":"path","description":"The unique identifier of the Task","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RecurringTaskChangeSetDetailsChangeSetStatusDtoAstroResult"}}}}},"requestBody":{"description":"The monthly recurring settings","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MonthlyRecurringSettingsDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/tasks/{taskId}/recurring/daily":{"post":{"operationId":"taskRecurrency_createDailyRecurringTasks","summary":"Create Daily Recurring Tasks","description":"Changes an existing Task into a Recurring Task, so that it will recur regularly given the specified rules.\r\n            \r\nA Recurring Task is one that must be completed on a specific regular frequency, such as Daily, Weekly, Monthly,\r\nor Yearly.  To create a Recurring Task, you must first create a regular Task with the necessary information,\r\nthen call one of the Create Recurring Task APIs.  To remove an instance of a Recurring Task, call Delete\r\nRecurring Task and specify one or more instances of the Recurring Task.","tags":["taskRecurrency"],"parameters":[{"name":"taskId","in":"path","description":"The unique identifier of the Task","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RecurringTaskChangeSetDetailsChangeSetStatusDtoAstroResult"}}}}},"requestBody":{"description":"The daily recurring settings","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DailyRecurringSettingsDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/tasks/{taskId}/recurring/yearly":{"post":{"operationId":"taskRecurrency_createYearlyRecurringTasks","summary":"Create Yearly Recurring Tasks","description":"Changes an existing Task into a Recurring Task, so that it will recur regularly given the specified rules.\r\n            \r\nA Recurring Task is one that must be completed on a specific regular frequency, such as Daily, Weekly, Monthly,\r\nor Yearly.  To create a Recurring Task, you must first create a regular Task with the necessary information,\r\nthen call one of the Create Recurring Task APIs.  To remove an instance of a Recurring Task, call Delete\r\nRecurring Task and specify one or more instances of the Recurring Task.","tags":["taskRecurrency"],"parameters":[{"name":"taskId","in":"path","description":"The unique identifier of the Task","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RecurringTaskChangeSetDetailsChangeSetStatusDtoAstroResult"}}}}},"requestBody":{"description":"The yearly recurring settings","content":{"application/json":{"schema":{"$ref":"#/components/schemas/YearlyRecurringSettingsDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/tasks/{taskId}/recurring/{option}":{"delete":{"operationId":"taskRecurrency_deleteRecurringTasks","summary":"Delete Recurring Tasks","description":"Removes one or more instances of a Recurring Task based on the `option` you specify: `this` means to remove\r\na single instance, `all` means to remove all instances, or `future` means to remove all future instances of\r\nthe Recurring Task.\r\n            \r\nA Recurring Task is one that must be completed on a specific regular frequency, such as Daily, Weekly, Monthly,\r\nor Yearly.  To create a Recurring Task, you must first create a regular Task with the necessary information,\r\nthen call one of the Create Recurring Task APIs.  To remove an instance of a Recurring Task, call Delete\r\nRecurring Task and specify one or more instances of the Recurring Task.","tags":["taskRecurrency"],"parameters":[{"name":"taskId","in":"path","description":"The unique identifier of the Task","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"option","in":"path","description":"Specify `this`, `all`, or `future` to indicate which task recurrnces to delete.","required":true,"schema":{"type":"string"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChangeSetStatusDtoAstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/tasks/{taskId}/recurring/settings/validate":{"post":{"operationId":"taskRecurrency_validateRecurringTasks","summary":"Validate Recurring Tasks","description":"Reviews potential updates to a Recurring Task and report back on the list of changes that would occur if this\r\nRecurring Task was updated with these settings.\r\n            \r\nWhen making changes to a Recurring Task, you may want to investigate the consequences of your changes first\r\nbefore finalizing the changes.  You can use the Validate Recurring Tasks API to examine these changes.  When\r\nyou are happy with the changes, call Update Recurring Tasks to complete them.\r\n            \r\nA Recurring Task is one that must be completed on a specific regular frequency, such as Daily, Weekly, Monthly,\r\nor Yearly.  To create a Recurring Task, you must first create a regular Task with the necessary information,\r\nthen call one of the Create Recurring Task APIs.  To remove an instance of a Recurring Task, call Delete\r\nRecurring Task and specify one or more instances of the Recurring Task.","tags":["taskRecurrency"],"parameters":[{"name":"taskId","in":"path","description":"The unique identifier of the Task","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RecurringTaskValidationResultDtoAstroResult"}}}}},"requestBody":{"description":"The new settings","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RecurringTaskSettingsDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/tasks/{taskId}/recurring/settings":{"put":{"operationId":"taskRecurrency_updateRecurringTasks","summary":"Update Recurring Tasks","description":"Updates the settings for a Recurring Task and re-generates occurrences of the Recurring Task from the new rules.\r\n            \r\nWhen making changes to a Recurring Task, you may want to investigate the consequences of your changes first\r\nbefore finalizing the changes.  You can use the Validate Recurring Tasks API to examine these changes.  When\r\nyou are happy with the changes, call Update Recurring Tasks to complete them.\r\n            \r\nA Recurring Task is one that must be completed on a specific regular frequency, such as Daily, Weekly, Monthly,\r\nor Yearly.  To create a Recurring Task, you must first create a regular Task with the necessary information,\r\nthen call one of the Create Recurring Task APIs.  To remove an instance of a Recurring Task, call Delete\r\nRecurring Task and specify one or more instances of the Recurring Task.","tags":["taskRecurrency"],"parameters":[{"name":"taskId","in":"path","description":"The unique identifier of the Task","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RecurringTaskChangeSetDetailsAstroResult"}}}}},"requestBody":{"description":"The new settings","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RecurringTaskSettingsDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/projects/{projectId}/tasks/statuses":{"get":{"operationId":"taskStatus_retrieveTaskStatuses","summary":"Retrieve Task Statuses","description":"Retrieves the list of TaskStatus levels for a specific Project within your Workspace.\r\n            \r\nA TaskStatus is a named status level used by your business to determine how to measure the\r\nprogress of Tasks.  You can define your own named status levels that are appropriate for\r\nyour business and determine which status levels are considered done.","tags":["taskStatus"],"parameters":[{"name":"projectId","in":"path","description":"The unique identifier of the Project to retrieve TaskStatuses","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskStatusDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]},"post":{"operationId":"taskStatus_createTaskStatus","summary":"Create TaskStatus","description":"Creates a new TaskStatus level for a specific Project within your Workspace.\r\n            \r\nA TaskStatus is a named status level used by your business to determine how to measure the\r\nprogress of Tasks.  You can define your own named status levels that are appropriate for\r\nyour business.","tags":["taskStatus"],"parameters":[{"name":"projectId","in":"path","description":"The unique identifier of the Project for the new TaskStatus","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskStatusDtoAstroResult"}}}}},"requestBody":{"description":"Information about the new TaskStatus level to create within this Project","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskStatusCreateDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/tasks/statuses/{taskStatusId}":{"put":{"operationId":"taskStatus_updateTaskStatus","summary":"Update TaskStatus","description":"Updates an existing TaskStatus level for a specific Project within your Workspace.\r\n            \r\nA TaskStatus is a named status level used by your business to determine how to measure the\r\nprogress of Tasks.  You can define your own named status levels that are appropriate for\r\nyour business.","tags":["taskStatus"],"parameters":[{"name":"taskStatusId","in":"path","description":"The id of the task status","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskStatusDtoAstroResult"}}}}},"requestBody":{"description":"Information about the existing TaskStatus to update within this Project","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskStatusUpdateDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/projects/{projectId}/tasks/statuses/{taskStatusId}":{"delete":{"operationId":"taskStatus_deleteTaskStatus","summary":"Delete TaskStatus","description":"The endpoint is used to delete a TaskStatus.\r\n            \r\nYou will not be able to delete a TaskStatus if there are tasks that have been assigned to this status level\r\nor if the TaskStatus is the default status level.","tags":["taskStatus"],"parameters":[{"name":"projectId","in":"path","description":"The unique identifier of the Project for the TaskStatus level to delete","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"taskStatusId","in":"path","description":"The Id of the TaskStatus level to be removed.","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AstroResult"}}}}},"deprecated":true,"security":[{"oauth2":[]}]}},"/api/data/tasks/statuses/{taskStatusId}/tasks":{"post":{"operationId":"taskStatus_moveTasksToATaskStatus","summary":"Move Tasks to a TaskStatus","description":"Moves one or more Tasks into the specified TaskStatus.  If a Position is specified for a Task,\r\nit will be placed at that position within the target TaskStatus.  If no Position is specified,\r\nthe Task will be placed at the end of the list within the target TaskStatus.","tags":["taskStatus"],"parameters":[{"name":"taskStatusId","in":"path","description":"The unique identifier of the TaskStatus to move the Tasks into","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskStatusMoveResultDtoListAstroResult"}}}},"400":{"description":"Bad Request","content":{"application/json":{"schema":{"description":"Any type"}}}}},"requestBody":{"description":"The Tasks to move and the position each should occupy within the target TaskStatus","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/TaskStatusMoveDto"}}}}},"security":[{"oauth2":[]}]}},"/api/data/tasks/{taskId}/tags":{"get":{"operationId":"taskTag_retrieveTaskTags","summary":"Retrieve TaskTags","description":"Retrieve the existing TaskTags on a Task\r\n            \r\nA TaskTag is a connection between a Task and a Tag.  Each Task can have zero, one or many\r\nTaskTags associated with it.  TaskTags can be assigned and removed from the Task to help you\r\nclassify your Tasks and prioritize work.","tags":["taskTag"],"parameters":[{"name":"taskId","in":"path","description":"The unique identifier of the Task for which we will retrieve TaskTags","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskTagDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]},"post":{"operationId":"taskTag_replaceTaskTags","summary":"Replace TaskTags","description":"Replaces the existing TaskTags on a Task with a newly provided list of TaskTags.\r\n            \r\nA TaskTag is a connection between a Task and a Tag.  Each Task can have zero, one or many\r\nTaskTags associated with it.  TaskTags can be assigned and removed from the Task to help you\r\nclassify your Tasks and prioritize work.","tags":["taskTag"],"parameters":[{"name":"taskId","in":"path","description":"The unique identifier of the Task for which we will replace TaskTags","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChangeSetStatusDtoAstroResult"}}}}},"requestBody":{"description":"The replacement list of TaskTags for this Task","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/NameDto"}}}}},"security":[{"oauth2":[]}]},"put":{"operationId":"taskTag_addTaskTagToTask","summary":"Add TaskTag to Task","description":"Add one or more new TaskTags to a Task.\r\n            \r\nA TaskTag is a connection between a Task and a Tag.  Each Task can have zero, one or many\r\nTaskTags associated with it.  TaskTags can be assigned and removed from the Task to help you\r\nclassify your Tasks and prioritize work.","tags":["taskTag"],"parameters":[{"name":"taskId","in":"path","description":"The unique identifier of the Task for which we will add TaskTags","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChangeSetStatusDtoAstroResult"}}}}},"requestBody":{"description":"The new TaskTags to add to this Task","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/NameDto"}}}}},"security":[{"oauth2":[]}]},"delete":{"operationId":"taskTag_removeTaskTagFromTask","summary":"Remove TaskTag from Task","description":"Removes one or more existing TaskTags from a Task.\r\n            \r\nA TaskTag is a connection between a Task and a Tag.  Each Task can have zero, one or many\r\nTaskTags associated with it.  TaskTags can be assigned and removed from the Task to help you\r\nclassify your Tasks and prioritize work.","tags":["taskTag"],"parameters":[{"name":"taskId","in":"path","description":"The unique identifier of the Task for which we will remove existing TaskTags","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChangeSetStatusDtoAstroResult"}}}}},"requestBody":{"description":"The TaskTags to remove from this Task","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/NameDto"}}}}},"security":[{"oauth2":[]}]}},"/api/data/tasks/{taskId}/todos":{"get":{"operationId":"taskTodo_getTodos","summary":"Get Todos","description":"Retrieve a list of todos for a task","tags":["taskTodo"],"parameters":[{"name":"taskId","in":"path","description":"the id of the task","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskTodoDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]},"post":{"operationId":"taskTodo_createTodo","summary":"Create Todo","description":"Create a todo for a task","tags":["taskTodo"],"parameters":[{"name":"taskId","in":"path","description":"the id of the task","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskTodoDtoAstroResult"}}}}},"requestBody":{"description":"the data for creating a todo","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskTodoCreateDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/tasks/todos/{todoId}":{"put":{"operationId":"taskTodo_updateTodo","summary":"Update Todo","description":"Update a todo for a task","tags":["taskTodo"],"parameters":[{"name":"todoId","in":"path","description":"the id of the todo","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskTodoDtoAstroResult"}}}}},"requestBody":{"description":"the data for updating a todo","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskTodoUpdateDto"}}}},"security":[{"oauth2":[]}]},"delete":{"operationId":"taskTodo_deleteTodo","summary":"Delete Todo","description":"Remove a todo","tags":["taskTodo"],"parameters":[{"name":"todoId","in":"path","description":"the id of the todo","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/integrations/teams/application":{"get":{"operationId":"teams_retrieveZipFileForTeamsIntegrations","summary":"Retrieve zip file for Teams Integrations","description":"Retrieves zip file for teams integrations.\r\n            \r\nThe Teams API is intended for use by ProjectManager and its business development partners.  Please\r\ncontact ProjectManager's sales team to request use of this API.","tags":["teams"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"type":"string","format":"byte"}}}}},"security":[{"oauth2":[]}]}},"/api/data/timesheets":{"get":{"operationId":"timesheet_queryTimeEntries","summary":"Query Time Entries","description":"Retrieve a list of time entries that match an [OData formatted query](https://www.odata.org/).\r\n            \r\nA Timesheet is a collection of time entries for a particular Resource for a specific week.  Each time\r\nentry records the number of whole minutes spent by this Resource on an activity. An activity can be a Task\r\nin any project that Resource can access, or the activity can be an administrative task such as \"Sick\r\nLeave\" or \"Meetings\".  When a time entry is linked to a Task, the number of minutes spent on the time entry\r\nare recorded as time spent on the Task.  Time entries linked to an administrative tasks are grouped for\r\nreporting but are not added to any Task within your Workspace.\r\n            \r\nTime entries are recorded in whole minutes.  If you specify a time entry in fractional hours, either using\r\nthe API or via the web application, the amount you specify will be converted to minutes and rounded to the\r\nnearest neighbor using the rounding algorithm Midpoint-Away-From-Zero.\r\n            \r\nWhen a Timesheet is submitted for approval or approved, users are no longer permitted to create, update, or\r\ndelete time entries for that week.  Users with Global Admin level access can override this restriction and\r\ncontinue to make changes to a Timesheet after approval.","tags":["timesheet"],"parameters":[{"name":"$top","in":"query","description":"The number of records to return","required":false,"schema":{"type":"integer"}},{"name":"$skip","in":"query","description":"Skips the given number of records and then returns $top records","required":false,"schema":{"type":"integer"}},{"name":"$filter","in":"query","description":"Filter the expression according to oData queries","required":false,"schema":{"type":"string"}},{"name":"$orderby","in":"query","description":"Order collection by this field.","required":false,"schema":{"type":"string"}},{"name":"$expand","in":"query","description":"Include related data in the response","required":false,"schema":{"type":"string"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TimesheetDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]},"post":{"operationId":"timesheet_createTimeEntry","summary":"Create Time Entry","description":"Creates new time entry for Resource on a given day.\r\n            \r\nA Timesheet is a collection of time entries for a particular Resource for a specific week.  Each time\r\nentry records the number of whole minutes spent by this Resource on an activity. An activity can be a Task\r\nin any project that Resource can access, or the activity can be an administrative task such as \"Sick\r\nLeave\" or \"Meetings\".  When a time entry is linked to a Task, the number of minutes spent on the time entry\r\nare recorded as time spent on the Task.  Time entries linked to an administrative tasks are grouped for\r\nreporting but are not added to any Task within your Workspace.\r\n            \r\nTime entries are recorded in whole minutes.  If you specify a time entry in fractional hours, either using\r\nthe API or via the web application, the amount you specify will be converted to minutes and rounded to the\r\nnearest neighbor using the rounding algorithm Midpoint-Away-From-Zero.\r\n            \r\nWhen a Timesheet is submitted for approval or approved, users are no longer permitted to create, update, or\r\ndelete time entries for that week.  Users with Global Admin level access can override this restriction and\r\ncontinue to make changes to a Timesheet after approval.","tags":["timesheet"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TimesheetResponseDtoAstroResult"}}}}},"requestBody":{"description":"The time entry you wish to create","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TimesheetCreateRequestDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/timesheets/{timesheetId}":{"put":{"operationId":"timesheet_updateTimeEntry","summary":"Update Time Entry","description":"Updates a time entry by its unique identifier.\r\n            \r\nA Timesheet is a collection of time entries for a particular Resource for a specific week.  Each time\r\nentry records the number of whole minutes spent by this Resource on an activity. An activity can be a Task\r\nin any project that Resource can access, or the activity can be an administrative task such as \"Sick\r\nLeave\" or \"Meetings\".  When a time entry is linked to a Task, the number of minutes spent on the time entry\r\nare recorded as time spent on the Task.  Time entries linked to an administrative tasks are grouped for\r\nreporting but are not added to any Task within your Workspace.\r\n            \r\nTime entries are recorded in whole minutes.  If you specify a time entry in fractional hours, either using\r\nthe API or via the web application, the amount you specify will be converted to minutes and rounded to the\r\nnearest neighbor using the rounding algorithm Midpoint-Away-From-Zero.\r\n            \r\nWhen a Timesheet is submitted for approval or approved, users are no longer permitted to create, update, or\r\ndelete time entries for that week.  Users with Global Admin level access can override this restriction and\r\ncontinue to make changes to a Timesheet after approval.","tags":["timesheet"],"parameters":[{"name":"timesheetId","in":"path","description":"The unique identifier of the time entry to update","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TimesheetResponseDtoAstroResult"}}}}},"requestBody":{"description":"The new information that should replace the previous time entry","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TimesheetUpdateRequestDto"}}}},"security":[{"oauth2":[]}]},"delete":{"operationId":"timesheet_deleteTimeEntry","summary":"Delete Time Entry","description":"Delete time entry by its unique identifier.\r\n            \r\nA Timesheet is a collection of time entries for a particular Resource for a specific week.  Each time\r\nentry records the number of whole minutes spent by this Resource on an activity. An activity can be a Task\r\nin any project that Resource can access, or the activity can be an administrative task such as \"Sick\r\nLeave\" or \"Meetings\".  When a time entry is linked to a Task, the number of minutes spent on the time entry\r\nare recorded as time spent on the Task.  Time entries linked to an administrative tasks are grouped for\r\nreporting but are not added to any Task within your Workspace.\r\n            \r\nTime entries are recorded in whole minutes.  If you specify a time entry in fractional hours, either using\r\nthe API or via the web application, the amount you specify will be converted to minutes and rounded to the\r\nnearest neighbor using the rounding algorithm Midpoint-Away-From-Zero.\r\n            \r\nWhen a Timesheet is submitted for approval or approved, users are no longer permitted to create, update, or\r\ndelete time entries for that week.  Users with Global Admin level access can override this restriction and\r\ncontinue to make changes to a Timesheet after approval.","tags":["timesheet"],"parameters":[{"name":"timesheetId","in":"path","description":"The unique identifier of the time entry to delete","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/timesheets/admin-tasks":{"get":{"operationId":"timesheet_retrieveAdministrativeTasks","summary":"Retrieve Administrative Tasks","description":"Retrieves a list of Administrative Tasks that are defined for use within your Workspace.\r\n            \r\nAdministrative tasks are a list of regular, recurring non-Task actions that are typically associated with\r\noverhead, such as sick leave, travel, or attending meetings.\r\n            \r\nA Timesheet is a collection of time entries for a particular Resource for a specific week.  Each time\r\nentry records the number of whole minutes spent by this Resource on an activity. An activity can be a Task\r\nin any project that Resource can access, or the activity can be an administrative task such as \"Sick\r\nLeave\" or \"Meetings\".  When a time entry is linked to a Task, the number of minutes spent on the time entry\r\nare recorded as time spent on the Task.  Time entries linked to an administrative tasks are grouped for\r\nreporting but are not added to any Task within your Workspace.\r\n            \r\nTime entries are recorded in whole minutes.  If you specify a time entry in fractional hours, either using\r\nthe API or via the web application, the amount you specify will be converted to minutes and rounded to the\r\nnearest neighbor using the rounding algorithm Midpoint-Away-From-Zero.\r\n            \r\nWhen a Timesheet is submitted for approval or approved, users are no longer permitted to create, update, or\r\ndelete time entries for that week.  Users with Global Admin level access can override this restriction and\r\ncontinue to make changes to a Timesheet after approval.","tags":["timesheet"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TimesheetAdminTypeDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/timesheets/approvals":{"post":{"operationId":"timesheet_submitTimeSheet","summary":"Submit TimeSheet","description":"Submit a Timesheet for approval for a specific Resource and week.\r\n            \r\nA Timesheet is a collection of time entries for a particular Resource for a specific week.  Each time\r\nentry records the number of whole minutes spent by this Resource on an activity. An activity can be a Task\r\nin any project that Resource can access, or the activity can be an administrative task such as \"Sick\r\nLeave\" or \"Meetings\".  When a time entry is linked to a Task, the number of minutes spent on the time entry\r\nare recorded as time spent on the Task.  Time entries linked to an administrative tasks are grouped for\r\nreporting but are not added to any Task within your Workspace.\r\n            \r\nTime entries are recorded in whole minutes.  If you specify a time entry in fractional hours, either using\r\nthe API or via the web application, the amount you specify will be converted to minutes and rounded to the\r\nnearest neighbor using the rounding algorithm Midpoint-Away-From-Zero.\r\n            \r\nWhen a Timesheet is submitted for approval or approved, users are no longer permitted to create, update, or\r\ndelete time entries for that week.  Users with Global Admin level access can override this restriction and\r\ncontinue to make changes to a Timesheet after approval.","tags":["timesheet"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TimeSheetApprovalResponseDtoAstroResult"}}}}},"requestBody":{"description":"The Timesheet to be submitted for approval","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TimeSheetApprovalDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/timesheets/approvals/approve":{"post":{"operationId":"timesheet_approveTimeSheet","summary":"Approve TimeSheet","description":"Approve an existing Timesheet approval request.\r\n            \r\nA Timesheet is a collection of time entries for a particular Resource for a specific week.  Each time\r\nentry records the number of whole minutes spent by this Resource on an activity. An activity can be a Task\r\nin any project that Resource can access, or the activity can be an administrative task such as \"Sick\r\nLeave\" or \"Meetings\".  When a time entry is linked to a Task, the number of minutes spent on the time entry\r\nare recorded as time spent on the Task.  Time entries linked to an administrative tasks are grouped for\r\nreporting but are not added to any Task within your Workspace.\r\n            \r\nTime entries are recorded in whole minutes.  If you specify a time entry in fractional hours, either using\r\nthe API or via the web application, the amount you specify will be converted to minutes and rounded to the\r\nnearest neighbor using the rounding algorithm Midpoint-Away-From-Zero.\r\n            \r\nWhen a Timesheet is submitted for approval or approved, users are no longer permitted to create, update, or\r\ndelete time entries for that week.  Users with Global Admin level access can override this restriction and\r\ncontinue to make changes to a Timesheet after approval.","tags":["timesheet"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TimeSheetApprovalResponseDtoAstroResult"}}}}},"requestBody":{"description":"The Timesheet to approve","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TimeSheetApprovalDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/timesheets/approvals/reject":{"post":{"operationId":"timesheet_rejectTimeSheet","summary":"Reject TimeSheet","description":"Rejects a specific resource's Timesheet approval request for a specific week.\r\n            \r\nA Timesheet is a collection of time entries for a particular Resource for a specific week.  Each time\r\nentry records the number of whole minutes spent by this Resource on an activity. An activity can be a Task\r\nin any project that Resource can access, or the activity can be an administrative task such as \"Sick\r\nLeave\" or \"Meetings\".  When a time entry is linked to a Task, the number of minutes spent on the time entry\r\nare recorded as time spent on the Task.  Time entries linked to an administrative tasks are grouped for\r\nreporting but are not added to any Task within your Workspace.\r\n            \r\nTime entries are recorded in whole minutes.  If you specify a time entry in fractional hours, either using\r\nthe API or via the web application, the amount you specify will be converted to minutes and rounded to the\r\nnearest neighbor using the rounding algorithm Midpoint-Away-From-Zero.\r\n            \r\nWhen a Timesheet is submitted for approval or approved, users are no longer permitted to create, update, or\r\ndelete time entries for that week.  Users with Global Admin level access can override this restriction and\r\ncontinue to make changes to a Timesheet after approval.","tags":["timesheet"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TimeSheetApprovalResponseDtoAstroResult"}}}}},"requestBody":{"description":"Information about the Timesheet approval request to be rejected","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TimeSheetApprovalRejectDto"}}}},"security":[{"oauth2":[]}]}},"/api/data/users/roles":{"get":{"operationId":"userRole_retrieveUserRoles","summary":"Retrieve UserRoles","description":"Retrieves the list of UserRoles defined within this Workspace.\r\n            \r\nA UserRole is a name for a privilege level granted to a specific User.  The 'Global Admin'\r\nUserRole is granted to the owner of the Workspace, and this UserRole cannot be changed.\r\nYou can choose which UserRole applies to a User within your Workspace.","tags":["userRole"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UserRoleDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/workload/resources/{resourceId}":{"get":{"operationId":"workload_queryResourceWorkload","summary":"Query Resource Workload","description":"Retrieve information about the expected workload for a Resource.  The workload for a Resource is a list of\r\ntasks, days, and the amount of time spent on each task per day.  You can examine a Resource's workload to\r\nidentify when that Resource is required to contribute to specific tasks.\r\n            \r\nTo query for workload for a Resource, you must first know the unique identifier of the Resource.  You may\r\nuse the QueryResource API to identify the resource, and then use its `id` field to call `QueryResourceWorkload`.\r\n            \r\nWorkload is defined in two ways: either automatically by the ProjectManager.com system, or manually by editing\r\nthe workload page within the ProjectManager.com app.  When you query for workload information, each entry will\r\nspecify whether the assignment was created manually or via the system.  If a task does not have any workload\r\nallocated, it will not be returned by this API.\r\n            \r\nThe `QueryResourceWorkload` API uses Gridify-style querying. For a full description of query rules, see\r\n[Querying Tutorial](https://developer.projectmanager.com/getting-started/querying-tutorial).  When querying\r\nfor workload, you can use filters, sorting, pagination, and you can also request additional\r\ndata to be included in the API result.  The QueryResourceWorkload API returns a maximum of 1000 results per\r\nrequest as a single page.  To retrieve all workload for a Resource, you must fetch pages starting with the\r\nnumber 1 until no additional data is returned.","tags":["workload"],"parameters":[{"name":"resourceId","in":"path","description":"The id of the Resource","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"filter","in":"query","description":"A Gridify formatted filter used to search by `task.projectId` and/or `date` and/or `minutes`","required":false,"schema":{"type":"string"}},{"name":"sort","in":"query","description":"A Gridify formatted ordering used to sort by `date`, `task.name` and/or `createdDate`. Defaults to `date asc`.","required":false,"schema":{"type":"string"}},{"name":"include","in":"query","description":"A comma separated list of additional data to include in each result. Set to `task` to include basic Task details, and/or `assignment` to include the assignment's total assigned minutes.","required":false,"schema":{"type":"string"}},{"name":"page","in":"query","description":"The page number to retrieve, starting at 1. Defaults to 1. Pages over individual allocations.","required":false,"schema":{"type":"integer","default":1}},{"name":"pageSize","in":"query","description":"The number of allocations, no less than 1 or more than 1000, per page. Defaults to 1000.","required":false,"schema":{"type":"integer","default":1000}},{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ResourceWorkloadAllocationDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/workspaces":{"get":{"operationId":"workSpace_retrieveCurrentWorkspace","summary":"Retrieve current workspace","description":"Returns the workspace the user is currently logged on to as a single-item list.\r\n            \r\nThis endpoint does not return every workspace the user can access. To switch workspaces\r\nor list all accessible workspaces, use workspace selection flows (for example `/api/data/me`\r\nand the workspace selector).","tags":["workSpace"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WorkSpaceDtoListAstroResult"}}}}},"security":[{"oauth2":[]}]}},"/api/data/workspaces/settings":{"put":{"operationId":"workSpace_updateCurrentWorkspaceSettings","summary":"Update current workspace settings","description":"Updates workspace-level scheduling defaults for the workspace the user is currently logged on to,\r\nincluding default planned hours and working-day hours (Monday through Sunday).\r\n            \r\nOnly properties included in the request body are updated; omitted properties are left unchanged.\r\nWhen workingDays is provided, only the weekdays included in that object are updated.\r\n            \r\nValues must be between 0 and 24.","tags":["workSpace"],"parameters":[{"name":"x-integration-name","in":"header","description":"The name of the calling system passed along as a header parameter","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WorkSpaceDtoAstroResult"}}}}},"requestBody":{"description":"Workspace settings to update","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WorkspaceSettingsUpdateDto"}}}},"security":[{"oauth2":[]}]}}},"tags":[{"name":"apiKey"},{"name":"changeset"},{"name":"country"},{"name":"discussion"},{"name":"file"},{"name":"holiday"},{"name":"holidays"},{"name":"homeFile"},{"name":"hourlyRate"},{"name":"hourlyRatePeriod"},{"name":"integration"},{"name":"integrationCategory"},{"name":"integrationProvider"},{"name":"license"},{"name":"me"},{"name":"meetingRecurrency"},{"name":"meetings"},{"name":"meetingTag"},{"name":"meetingTodos"},{"name":"notification"},{"name":"npt"},{"name":"nptDiscussion"},{"name":"nptFiles"},{"name":"nptRecurrency"},{"name":"nptStatus"},{"name":"nptTag"},{"name":"nptTodos"},{"name":"project"},{"name":"risk"},{"name":"projectChargeCode"},{"name":"projectCustomer"},{"name":"projectField"},{"name":"projectFile"},{"name":"projectFolder"},{"name":"projectMembers"},{"name":"projectPriority"},{"name":"projectStatus"},{"name":"projectTemplate"},{"name":"projectVersion"},{"name":"resource"},{"name":"resourceSkill"},{"name":"resourceTeam"},{"name":"riskFile"},{"name":"riskTag"},{"name":"security"},{"name":"tag"},{"name":"task"},{"name":"taskAssignee"},{"name":"taskField"},{"name":"taskFile"},{"name":"taskLink"},{"name":"taskMetadata"},{"name":"taskRecurrency"},{"name":"taskStatus"},{"name":"taskTag"},{"name":"taskTodo"},{"name":"teams"},{"name":"timesheet"},{"name":"userRole"},{"name":"workload"},{"name":"workSpace"}],"servers":[{"url":"https://api.projectmanager.com","description":"https://api.projectmanager.com"}],"components":{"schemas":{"AstroError":{"type":"object","properties":{"technicalError":{"type":["string","null"],"description":"A technical description of the error that occurred.  Not suitable for\r\ndisplay to end users."},"additionalErrors":{"type":["array","null"],"items":{"type":"string"},"description":"If additional errors beyond the main error in `Message` occurred, they will be\r\nlisted here as individual messages."},"validationErrors":{"type":["object","null"],"additionalProperties":{"type":"array","items":{"type":"string"}},"description":"This contains a dictionary of validation errors. The key is the name of the field"},"message":{"type":["string","null"],"description":"A description of the error that occurred.  If your application has a user\r\ninterface, show this message to explain what went wrong."}},"description":"Information about an error that occurred within the ProjectManager API.","title":"AstroError"},"HttpStatusCode":{"type":"string","enum":["Continue","SwitchingProtocols","Processing","EarlyHints","OK","Created","Accepted","NonAuthoritativeInformation","NoContent","ResetContent","PartialContent","MultiStatus","AlreadyReported","IMUsed","MultipleChoices","MovedPermanently","Found","SeeOther","NotModified","UseProxy","Unused","TemporaryRedirect","PermanentRedirect","BadRequest","Unauthorized","PaymentRequired","Forbidden","NotFound","MethodNotAllowed","NotAcceptable","ProxyAuthenticationRequired","RequestTimeout","Conflict","Gone","LengthRequired","PreconditionFailed","RequestEntityTooLarge","RequestUriTooLong","UnsupportedMediaType","RequestedRangeNotSatisfiable","ExpectationFailed","MisdirectedRequest","UnprocessableEntity","Locked","FailedDependency","UpgradeRequired","PreconditionRequired","TooManyRequests","RequestHeaderFieldsTooLarge","UnavailableForLegalReasons","InternalServerError","NotImplemented","BadGateway","ServiceUnavailable","GatewayTimeout","HttpVersionNotSupported","VariantAlsoNegotiates","InsufficientStorage","LoopDetected","NotExtended","NetworkAuthenticationRequired"],"title":"HttpStatusCode"},"ApiKeyDto":{"type":"object","properties":{"id":{"type":"string","format":"uuid","description":"Internal access token id"},"createdBy":{"type":"string","format":"uuid","description":"Created by user id"},"expires":{"type":"string","format":"date-time","description":"Expires date"},"apiKey":{"type":"string","description":"Bearer Key"},"name":{"type":"string","description":"Name of token"}},"description":"Represents api access key entity","title":"ApiKeyDto"},"ApiKeyDtoListAstroResult":{"type":"object","properties":{"error":{"oneOf":[{"$ref":"#/components/schemas/AstroError"},{"type":"null"}],"description":"If the API call failed, this will contain information about the error that occurred."},"success":{"type":"boolean","description":"True if the API call succeeded; false otherwise."},"hasError":{"type":"boolean","description":"True if the API call failed."},"statusCode":{"$ref":"#/components/schemas/HttpStatusCode","description":"The HTTP code of the response."},"data":{"type":"array","items":{"$ref":"#/components/schemas/ApiKeyDto"},"description":"If the API call succeeded, this will contain the results."}},"description":"An API result that contains different values depending on whether the API call succeeded or failed.\r\nIf the API call succeeded, the `Success` value will be true and you can use the `Data` element.\r\nIf the API call failed, `Success` will be false and the `Error` value will be non-null.","title":"ApiKeyDtoListAstroResult"},"ApiKeyCreateDto":{"type":"object","properties":{"tokenName":{"type":"string","minLength":1,"description":"Name of token"}},"required":["tokenName"],"description":"Represents a new api access key entity","title":"ApiKeyCreateDto"},"ApiKeyDtoAstroResult":{"type":"object","properties":{"error":{"oneOf":[{"$ref":"#/components/schemas/AstroError"},{"type":"null"}],"description":"If the API call failed, this will contain information about the error that occurred."},"success":{"type":"boolean","description":"True if the API call succeeded; false otherwise."},"hasError":{"type":"boolean","description":"True if the API call failed."},"statusCode":{"$ref":"#/components/schemas/HttpStatusCode","description":"The HTTP code of the response."},"data":{"$ref":"#/components/schemas/ApiKeyDto","description":"Represents api access key entity"}},"description":"An API result that contains different values depending on whether the API call succeeded or failed.\r\nIf the API call succeeded, the `Success` value will be true and you can use the `Data` element.\r\nIf the API call failed, `Success` will be false and the `Error` value will be non-null.","title":"ApiKeyDtoAstroResult"},"AstroResult":{"type":"object","properties":{"error":{"oneOf":[{"$ref":"#/components/schemas/AstroError"},{"type":"null"}],"description":"If the API call failed, this will contain information about the error that occurred."},"success":{"type":"boolean","description":"True if the API call succeeded; false otherwise."},"hasError":{"type":"boolean","description":"True if the API call failed."},"statusCode":{"$ref":"#/components/schemas/HttpStatusCode","description":"The HTTP code of the response."}},"description":"An API result that contains different values depending on whether the API call succeeded or failed.\r\nUse the `Success` value to determine if the API call succeeded.  If the API call failed, you can\r\nexamine the `Error` value to determine what went wrong.","title":"AstroResult"},"State":{"type":"string","enum":["NotStarted","InProgress","Success","Discard","Fail"],"description":"The state of the ProjectChange","title":"State"},"ProjectChangeStatusDto":{"type":"object","properties":{"id":{"type":"string","format":"uuid","description":"The unique identifier of this ProjectChange."},"success":{"type":["boolean","null"],"description":"True if this ProjectChange was successfully applied.  If the ProjectChange has not been\r\napplied, this value is null."},"state":{"$ref":"#/components/schemas/State","description":"A status flag that indicates the progress of the ProjectChange through resolution."}},"description":"A ProjectChange is an individual edit that has been made to a project.  Since multiple users\r\ncan edit a project at the same time, individual ProjectChanges are applied in a sequential\r\nfashion. If a ProjectChange causes a conflict or cannot be applied, it will be rejected.\r\nYou can examine a ProjectChange to determine its conflict resolution status.","title":"ProjectChangeStatusDto"},"ProjectChangeStatusDtoAstroResult":{"type":"object","properties":{"error":{"oneOf":[{"$ref":"#/components/schemas/AstroError"},{"type":"null"}],"description":"If the API call failed, this will contain information about the error that occurred."},"success":{"type":"boolean","description":"True if the API call succeeded; false otherwise."},"hasError":{"type":"boolean","description":"True if the API call failed."},"statusCode":{"$ref":"#/components/schemas/HttpStatusCode","description":"The HTTP code of the response."},"data":{"$ref":"#/components/schemas/ProjectChangeStatusDto","description":"A ProjectChange is an individual edit that has been made to a project.  Since multiple users\r\ncan edit a project at the same time, individual ProjectChanges are applied in a sequential\r\nfashion. If a ProjectChange causes a conflict or cannot be applied, it will be rejected.\r\nYou can examine a ProjectChange to determine its conflict resolution status."}},"description":"An API result that contains different values depending on whether the API call succeeded or failed.\r\nIf the API call succeeded, the `Success` value will be true and you can use the `Data` element.\r\nIf the API call failed, `Success` will be false and the `Error` value will be non-null.","title":"ProjectChangeStatusDtoAstroResult"},"CountryDto":{"type":"object","properties":{"id":{"type":"string","description":"Gets or sets the unique identifier for the country. This should translate to the ISO2 code\r\nfor that country."},"name":{"type":"string","description":"Gets or sets the name of the country."},"countryId":{"type":"integer","description":"The PM Internal Id Reference for a country"},"cultureName":{"type":"string","description":"The Culture name for a country"}},"description":"Represents a country with its details.","title":"CountryDto"},"CountryDtoListAstroResult":{"type":"object","properties":{"error":{"oneOf":[{"$ref":"#/components/schemas/AstroError"},{"type":"null"}],"description":"If the API call failed, this will contain information about the error that occurred."},"success":{"type":"boolean","description":"True if the API call succeeded; false otherwise."},"hasError":{"type":"boolean","description":"True if the API call failed."},"statusCode":{"$ref":"#/components/schemas/HttpStatusCode","description":"The HTTP code of the response."},"data":{"type":"array","items":{"$ref":"#/components/schemas/CountryDto"},"description":"If the API call succeeded, this will contain the results."}},"description":"An API result that contains different values depending on whether the API call succeeded or failed.\r\nIf the API call succeeded, the `Success` value will be true and you can use the `Data` element.\r\nIf the API call failed, `Success` will be false and the `Error` value will be non-null.","title":"CountryDtoListAstroResult"},"StateDto":{"type":"object","properties":{"id":{"type":"integer","description":"Gets or sets the unique identifier for the state."},"stateCode":{"type":"string","description":"Gets 