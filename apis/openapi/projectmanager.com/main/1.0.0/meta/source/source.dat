["boolean","null"],"description":"Active/Inactive the Resource."},"approverId":{"type":["string","null"],"format":"uuid","description":"The Approver Id associated with this Resource.\r\n            \r\nApplies to personnel Resources only."},"colorName":{"type":["string","null"],"description":"Collaboration Color for this resource.\r\n            \r\neg. teal, cyan, lightblue, blurple, purple, pink, orange, gray"},"language":{"type":["string","null"],"description":"Translation Language for this resource.\r\n            \r\ne.g. en-US, en-GB, fr-FR, es-ES"},"publicAvatarId":{"type":["integer","null"],"minimum":1,"maximum":42,"description":"Public avatar image index (1-42). The avatar URL is generated as /assets/images/avatars/{index:000}.png.\r\nOnly numeric public avatars are accepted; custom URLs are not supported."},"clearAvatar":{"type":["boolean","null"],"description":"When true, removes the resource's custom avatar so the default initials are shown."},"defaultPlannedHours":{"type":["number","null"],"format":"double","description":"Default planned effort in hours. When set, updates the resource; when omitted, existing value is unchanged."},"workingDays":{"oneOf":[{"$ref":"#/components/schemas/ResourceWorkingDaysHours"},{"type":"null"}],"description":"Per-day working hours. When non-null, updates or creates the resource calendar; set only days to change—they merge over workspace defaults."}},"description":"A Resource represents a person, material, or tool that is used within your Projects.\r\nWhen you attach a Resources to more than one Task, the software will schedule the usage\r\nof your Resource so that it is not allocated to more than one Task at the same time.\r\nThe users in your Workspace are also considered Resources.  To invite a new User to your\r\nWorkspace, create a new Resource for that user.","title":"ResourceUpdateDto"},"ResourcesCreateDto":{"type":"object","properties":{"projectIds":{"type":["array","null"],"items":{"type":"string","format":"uuid"},"description":"When creating a user they will also be added to the projectIds specified. If null or empty the user will be\r\ninvited but no access will be given to any projects."},"users":{"type":"array","items":{"$ref":"#/components/schemas/ResourceCreateDto"},"description":"A list of Users to create"}},"description":"The ResourcesCreate object allows you to create multiple Users with a single API call.\r\nIn ProjectManager.com, a User is a special class of Resource.\r\n            \r\nA Resource represents a person, material, or tool that is used within your Projects.\r\nWhen you attach a Resources to more than one Task, the software will schedule the usage\r\nof your Resource so that it is not allocated to more than one Task at the same time.\r\nThe users in your Workspace are also considered Resources.  To invite a new User to your\r\nWorkspace, create a new Resource for that user.","title":"ResourcesCreateDto"},"UserError":{"type":"object","properties":{"email":{"type":"string","description":"The email of the Resource that could not be created"},"reason":{"type":"string","description":"A description of the reason this Resource could not be created"},"statusCode":{"$ref":"#/components/schemas/HttpStatusCode","description":"A status code explaining the category of reason this Resource could not be created"}},"description":"Represents an individual error for a specific Resource that could not be created in the context\r\nof a bulk Resource creation API call.","title":"UserError"},"ResourcesDto":{"type":"object","properties":{"resources":{"type":"array","items":{"$ref":"#/components/schemas/ResourceDto"},"description":"The list of the Resources created by this API call."},"errors":{"type":["array","null"],"items":{"$ref":"#/components/schemas/UserError"},"description":"The list of errors that occurred for Resources that could not be created."}},"description":"The Resources object represents the results of a bulk Resource creation API call.\r\n            \r\nA Resource represents a person, material, or tool that is used within your Projects.\r\nWhen you attach a Resources to more than one Task, the software will schedule the usage\r\nof your Resource so that it is not allocated to more than one Task at the same time.\r\nThe users in your Workspace are also considered Resources.  To invite a new User to your\r\nWorkspace, create a new Resource for that user.","title":"ResourcesDto"},"ResourcesDtoAstroResult":{"type":"object","properties":{"error":{"oneOf":[{"$ref":"#/components/schemas/AstroError"},{"type":"null"}],"description":"If the API call failed, this will contain information about the error that occurred."},"success":{"type":"boolean","description":"True if the API call succeeded; false otherwise."},"hasError":{"type":"boolean","description":"True if the API call failed."},"statusCode":{"$ref":"#/components/schemas/HttpStatusCode","description":"The HTTP code of the response."},"data":{"$ref":"#/components/schemas/ResourcesDto","description":"The Resources object represents the results of a bulk Resource creation API call.\r\n            \r\nA Resource represents a person, material, or tool that is used within your Projects.\r\nWhen you attach a Resources to more than one Task, the software will schedule the usage\r\nof your Resource so that it is not allocated to more than one Task at the same time.\r\nThe users in your Workspace are also considered Resources.  To invite a new User to your\r\nWorkspace, create a new Resource for that user."}},"description":"An API result that contains different values depending on whether the API call succeeded or failed.\r\nIf the API call succeeded, the `Success` value will be true and you can use the `Data` element.\r\nIf the API call failed, `Success` will be false and the `Error` value will be non-null.","title":"ResourcesDtoAstroResult"},"ResourceBulkUpdateDto":{"type":"object","properties":{"resourceId":{"type":"string","format":"uuid","description":"The unique identifier of 