{
  "openapi": "3.0.3",
  "info": {
    "title": "SecurityTrails API",
    "description": "SecurityTrails API provides access to current and historical DNS, WHOIS, domain, and IP intelligence data. It is a read-only API for security enrichment and automation.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://docs.securitytrails.com/reference",
    "x-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://api.securitytrails.com/v1"
    }
  ],
  "security": [
    {
      "apiKeyHeader": []
    }
  ],
  "paths": {
    "/ping": {
      "get": {
        "operationId": "ping",
        "summary": "Test API connectivity",
        "description": "Returns a simple response to verify that the API key is valid and the service is reachable.",
        "responses": {
          "200": {
            "description": "Successful ping response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing API key"
          }
        }
      }
    },
    "/domain/{hostname}": {
      "get": {
        "operationId": "getDomainDetails",
        "summary": "Get domain details",
        "description": "Returns the current data about the given hostname, including DNS records, Alexa rank, and associated information.",
        "parameters": [
          {
            "name": "hostname",
            "in": "path",
            "required": true,
            "description": "The domain hostname to look up (e.g., 'example.com')",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Domain details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "hostname": {
                      "type": "string"
                    },
                    "alexa_rank": {
                      "type": "integer"
                    },
                    "current_dns": {
                      "type": "object"
                    },
                    "subdomain_count": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Domain not found"
          }
        }
      }
    },
    "/domain/{hostname}/subdomains": {
      "get": {
        "operationId": "getSubdomains",
        "summary": "List subdomains for a domain",
        "description": "Returns child subdomains discovered for the given hostname.",
        "parameters": [
          {
            "name": "hostname",
            "in": "path",
            "required": true,
            "description": "The domain hostname",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "children_only",
            "in": "query",
            "description": "If set to true, returns only immediate child subdomains",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of subdomains",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "subdomains": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "subdomain_count": {
                      "type": "integer"
                    },
                    "endpoint": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/domain/{hostname}/tags": {
      "get": {
        "operationId": "getDomainTags",
        "summary": "Get tags for a domain",
        "description": "Returns tags associated with the given domain hostname.",
        "parameters": [
          {
            "name": "hostname",
            "in": "path",
            "required": true,
            "description": "The domain hostname",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Domain tags",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "tags": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string"
                          },
                          "value": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/domain/{hostname}/associated": {
      "get": {
        "operationId": "getAssociatedDomains",
        "summary": "Get associated domains",
        "description": "Returns domains that are associated with the given hostname through shared registrant or DNS data.",
        "parameters": [
          {
            "name": "hostname",
            "in": "path",
            "required": true,
            "description": "The domain hostname",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Page number for pagination",
            "schema": {
              "type": "integer",
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Associated domains",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "records": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "alexa_rank": {
                            "type": "integer"
                          },
                          "hostname": {
                            "type": "string"
                          },
                          "mail_provider": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    },
                    "record_count": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/domain/{hostname}/whois": {
      "get": {
        "operationId": "getDomainWhois",
        "summary": "Get WHOIS data for a domain",
        "description": "Returns parsed WHOIS data for the given hostname including registrant, registrar, and date information.",
        "parameters": [
          {
            "name": "hostname",
            "in": "path",
            "required": true,
            "description": "The domain hostname",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "WHOIS data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "registrarName": {
                      "type": "string"
                    },
                    "contactEmail": {
                      "type": "string"
                    },
                    "domainName": {
                      "type": "string"
                    },
                    "nameServers": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "createdDate": {
                      "type": "string"
                    },
                    "updatedDate": {
                      "type": "string"
                    },
                    "expiresDate": {
                      "type": "string"
                    },
                    "status": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/history/{hostname}/dns/{type}": {
      "get": {
        "operationId": "getDnsHistory",
        "summary": "Get historical DNS records",
        "description": "Returns historical DNS records for the given hostname and record type.",
        "parameters": [
          {
            "name": "hostname",
            "in": "path",
            "required": true,
            "description": "The domain hostname",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "path",
            "required": true,
            "description": "DNS record type",
            "schema": {
              "type": "string",
              "enum": ["a", "aaaa", "mx", "ns", "soa", "txt"]
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Page number for pagination",
            "schema": {
              "type": "integer",
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Historical DNS records",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "records": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "values": {
                            "type": "array",
                            "items": {
                              "type": "object"
                            }
                          },
                          "type": {
                            "type": "string"
                          },
                          "first_seen": {
                            "type": "string"
                          },
                          "last_seen": {
                            "type": "string"
                          },
                          "organizations": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    },
                    "pages": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/history/{hostname}/whois": {
      "get": {
        "operationId": "getWhoisHistory",
        "summary": "Get historical WHOIS records",
        "description": "Returns historical WHOIS records for the given hostname.",
        "parameters": [
          {
            "name": "hostname",
            "in": "path",
            "required": true,
            "description": "The domain hostname",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Page number for pagination",
            "schema": {
              "type": "integer",
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Historical WHOIS records",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "object",
                      "properties": {
                        "items": {
                          "type": "array",
                          "items": {
                            "type": "object"
                          }
                        },
                        "count": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ips/nearby/{ipaddress}": {
      "get": {
        "operationId": "getIpNeighbors",
        "summary": "Get neighboring IP addresses",
        "description": "Returns the neighbors in the given IP address range.",
        "parameters": [
          {
            "name": "ipaddress",
            "in": "path",
            "required": true,
            "description": "An IPv4 address",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Neighboring IP addresses",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "blocks": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/search/list": {
      "post": {
        "operationId": "searchDomains",
        "summary": "Search domains with filters",
        "description": "Search for domains using a filter expression. Supports filtering by DNS records, WHOIS data, keyword, and other attributes.",
        "parameters": [
          {
            "name": "include_ips",
            "in": "query",
            "description": "Include IP information in results",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Page number for pagination",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "scroll",
            "in": "query",
            "description": "Enable scrolling through large result sets",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["filter"],
                "properties": {
                  "filter": {
                    "type": "object",
                    "description": "Filter expression object for domain search"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Search results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "records": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "hostname": {
                            "type": "string"
                          },
                          "alexa_rank": {
                            "type": "integer"
                          },
                          "host_provider": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "mail_provider": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    },
                    "record_count": {
                      "type": "integer"
                    },
                    "meta": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ips/list": {
      "post": {
        "operationId": "searchIps",
        "summary": "Search IPs with filters",
        "description": "Search for IPs that match a given filter.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Page number for pagination",
            "schema": {
              "type": "integer",
              "default": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["filter"],
                "properties": {
                  "filter": {
                    "type": "object",
                    "description": "Filter expression for IP search"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "IP search results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "records": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "record_count": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/feeds/domains": {
      "get": {
        "operationId": "getNewDomainsFeed",
        "summary": "Get newly registered domains feed",
        "description": "Returns a feed of newly registered domains. Available as a daily or real-time feed.",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "description": "Feed type: new or all",
            "schema": {
              "type": "string",
              "enum": ["new", "all"],
              "default": "new"
            }
          },
          {
            "name": "filter",
            "in": "query",
            "description": "TLD filter",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Domain feed data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyHeader": {
        "type": "apiKey",
        "name": "APIKEY",
        "in": "header",
        "description": "SecurityTrails API key passed in the APIKEY header"
      }
    }
  }
}