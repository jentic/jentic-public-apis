  },
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sb-access-token",
        "description": "Supabase session cookie (web auth)."
      },
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Supabase access token (mobile style auth)."
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Bad request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Unauthorized",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Forbidden",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "InternalError": {
        "description": "Internal server error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "SuccessOnly": {
        "description": "Success response",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      },
      "OAuthError": {
        "description": "OAuth error response",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string"
                },
                "error_description": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "TokenResponse": {
        "description": "OAuth token response",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "token_type",
                "access_token",
                "refresh_token",
                "expires_in"
              ],
              "properties": {
                "token_type": {
                  "type": "string",
                  "example": "bearer"
                },
                "access_token": {
                  "type": "string"
                },
                "refresh_token": {
                  "type": "string"
                },
                "expires_in": {
                  "type": "integer",
                  "example": 3600
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "details": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": true
              }
            ]
          },
          "code": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          }
        }
      },
      "GenerateImageRequest": {
        "type": "object",
        "required": [
          "dishName"
        ],
        "properties": {
          "dishName": {
            "type": "string"
          }
        }
      },
      "GenerateMenuRequest": {
        "type": "object",
        "properties": {
          "household_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          }
        }
      },
      "GenerateRecipeRequest": {
        "type": "object",
        "required": [
          "dishName"
        ],
        "properties": {
          "dishName": {
            "type": "string"
          },
          "servings": {
            "type": "integer",
            "minimum": 1,
            "default": 2
          }
        }
      },
      "GeneratedRecipe": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "ingredients": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "amount",
                "unit"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "amount": {
                  "type": "string"
                },
                "unit": {
                  "type": "string"
                }
              }
            }
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "category": {
            "type": "string",
            "nullable": true
          },
          "servings": {
            "type": "integer"
          },
          "cuisine": {
            "type": "string",
            "nullable": true
          },
          "diet_type": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cooking_time_minutes": {
            "type": "integer",
            "nullable": true
          },
          "difficulty": {
            "type": "string",
            "nullable": true
          },
          "main_ingredient": {
            "type": "string",
            "nullable": true
          },
          "occasion": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "calories_per_serving": {
            "type": "integer",
            "nullable": true
          },
          "cooking_method": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "UpdateProfileRequest": {
        "type": "object",
        "properties": {
          "first_name": {
            "type": "string",
            "nullable": true
          },
          "last_name": {
            "type": "string",
            "nullable": true
          },
          "avatar_url": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "CreateInvitationRequest": {
        "type": "object",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "AcceptInvitationRequest": {
        "type": "object",
        "required": [
          "token",
          "email"
        ],
        "properties": {
          "token": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "ResendInvitationRequest": {
        "type": "object",
        "required": [
          "invitation_id"
        ],
        "properties": {
          "invitation_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "OAuthTokenRequest": {
        "type": "object",
        "required": [
          "grant_type",
          "client_id",
          "client_secret"
        ],
        "properties": {
          "grant_type": {
            "type": "string",
            "enum": [
              "authorization_code",
              "refresh_token"
            ]
          },
          "code": {
            "type": "string"
          },
          "refresh_token": {
            "type": "string"
          },
          "client_id": {
            "type": "string"
          },
          "client_secret": {
            "type": "string"
          },
          "redirect_uri": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    },
    {
      "cookieAuth": []
    }
  ]
}
