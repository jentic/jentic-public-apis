                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/RedTeamPlugin"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "🔴 Enterprise: Red Team Plugins"
        ],
        "summary": "Create Custom Plugin",
        "description": "# 🔴 ENTERPRISE ONLY\n\nCreate a custom red team plugin for your specific testing needs.\n\n**Server:** `https://api.promptfoo.app`\n\n**Authentication:** API Key (required)\n\n**Use cases:**\n- Test company-specific security rules\n- Create custom attack patterns\n- Test industry-specific vulnerabilities",
        "operationId": "createRedTeamPlugin",
        "servers": [
          {
            "url": "https://api.promptfoo.app"
          }
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
