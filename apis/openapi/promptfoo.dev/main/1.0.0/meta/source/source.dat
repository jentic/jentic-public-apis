        ],
        "summary": "List Red Team Configurations",
        "description": "# 🔴 ENTERPRISE ONLY\n\nGet all saved red team testing configurations.\n\n**Server:** `https://api.promptfoo.app`\n\n**Authentication:** API Key (required)\n\n**What is a configuration?**\nA configuration defines how red team tests should run:\n- Which plugins to use\n- How many tests to generate\n- Target system information\n- Test parameters\n\n**Reference:** https://www.promptfoo.dev/docs/red-team/configuration/",
        "operationId": "listRedTeamConfigs",
        "servers": [
          {
            "url": "https://api.promptfoo.app"
          }
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "List of configurations",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/RedTeamConfig"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "🔴 Enterprise: Red Team Configs"
        ],
        "summary": "Create New Configuration",
        "description": "# 🔴 ENTERPRISE ONLY\n\nCreate a new red team testing configuration.\n\n**Server:** `https://api.promptfoo.app`\n\n**Authentication:** API Key (required)\n\n**What to include:**\n- Configuration name\n- List of plugins to use\n- Number of tests to generate\n- Optional: Target system details",
        "operationId": "createRedTeamConfig",
        "servers": [
          {
            "url": "https://api.promptfoo.app"
          }
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "plugins"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "plugins": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "example": [
                      "harmful",
                      "jailbreak",
                      "pii"
                    ]
                  },
                  "numTests": {
                    "type": "integer",
                    "example": 50
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Configuration created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RedTeamConfig"
                }
              }
            }
          }
        }
      }
    },
