                        "name": "fields[course]",
                        "in": "query",
                        "description": "Return only these fields, comma separated. `id` is always included whether you ask for it or not. The key is the model's table name, so it is `fields[course]` for this resource.",
                        "schema": {
                            "type": "string"
                        },
                        "example": "centerId,category,name"
                    },
