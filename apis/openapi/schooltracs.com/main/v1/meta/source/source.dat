            "post": {
                "operationId": "postCustomers",
                "tags": [
                    "Students"
                ],
                "summary": "Create a student",
                "description": "**Why you'll use it**\n\nPush a completed registration form straight into SchoolTracs. If the person has not committed yet and you only want them tracked as an enquiry, use `POST /v1/leads` instead.\n\n**Before you send**\n\n`name` is required. `centerId` defaults to the centre bound to your API key. The student number is generated for you and cannot be set. This endpoint does not deduplicate — search first if you might already have the person.\n\n**Plan**\n\nAvailable on every plan. This is one of the few resources a FREE key can write to.\n\nIf you have subscribed a `student.*` [webhook](#description/webhooks), creating a student fires a `student.created` delivery.",
                "parameters": [],
                "responses": {
                    "201": {
                        "description": "The requested record.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/Customer"
                                        },
                                        "meta": {
                                            "$ref": "#/components/schemas/Meta"
                                        }
                                    },
                                    "required": [
                                        "data",
                                        "meta"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationFailed"
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    },
                    "500": {
                        "$ref": "#/components/responses/ServerError"
                    }
                },
                "requestBody": {
