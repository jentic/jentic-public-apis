        "/journal-items": {
            "get": {
                "operationId": "getJournalItems",
                "tags": [
                    "Journal"
                ],
                "summary": "List journal notes",
                "description": "**Why you'll use it**\n\nPull a student's progress history into a parent portal or a report, or review what a teacher wrote after a lesson.\n\n**Before you send**\n\nPAID plan only. Date ranges are bounded: `filter[postedDate]` and `filter[created]` may look back at most 3 years and span at most a year. With no date filter at all, the last 3 years are returned rather than everything.\n\n**Plan**\n\nPAID plan only. A FREE key gets `403 Journal access is not included in the current subscription plan.`.\n\n**Example queries**\n\n- `?filter[customerId]=9101&sort=-postedDate`  \n  One student's notes, newest first.\n- `?filter[privacy]=customer&filter[postedDate][gte]=2026-01-01`  \n  Notes shared with students this year — safe to surface in a parent portal.\n- `?filter[activityId]=88201&include=staff`  \n  Everything written about one lesson, with the author attached.\n\n**Related records you can pull in** (`?include=`)\n\n- `customer` — The student the note is about, as `{id, name}`.\n- `staff` — Who wrote it, as `{id, name}`.\n- `activity` — The lesson it relates to, as `{id, name, date}`.\n- `attachments` — Files attached to the note — read-only here; uploading needs the staff app.",
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Page number, starting at 1. How deep you may page is capped by your plan — 5 pages on FREE and 200 on PAID, independent of page size. Going past the cap is a `422`, not an empty page.",
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "default": 1
                        }
                    },
                    {
                        "name": "pageSize",
                        "in": "query",
                        "description": "Records per page. Defaults to 50, with a hard ceiling of 500 and a plan ceiling of 50 on FREE / 500 on PAID. Asking for more than your plan allows returns `422` — it is never silently clamped.",
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "default": 50
                        }
                    },
                    {
                        "name": "perPage",
                        "in": "query",
                        "description": "Alias for `pageSize`. If both are sent, `pageSize` wins.",
                        "schema": {
                            "type": "integer",
                            "minimum": 1
                        }
                    },
                    {
                        "name": "sort",
                        "in": "query",
                        "description": "Sort by one or more fields, comma separated. Prefix a field with `-` to sort descending (`sort=-created,name`). Sorting by anything outside the list below is rejected.",
                        "schema": {
                            "type": "string",
                            "x-allowed-fields": [
                                "id",
                                "centerId",
                                "customerId",
                                "activityId",
                                "staffId",
                                "content",
                                "privacy",
                                "postedDate",
                                "originalId",
                                "created",
                                "updated",
                                "deleted"
                            ]
                        },
                        "example": "-created"
                    },
                    {
                        "name": "fields[journal_item]",
                        "in": "query",
                        "description": "Return only these fields, comma separated. `id` is always included whether you ask for it or not. The key is the model's table name, so it is `fields[journal_item]` for this resource.",
                        "schema": {
                            "type": "string"
                        },
                        "example": "centerId,customerId,activityId"
                    },
                    {
                        "name": "include",
                        "in": "query",
                        "description": "Related records to embed in the response, comma separated.",
                        "schema": {
                            "type": "string"
                        },
                        "example": "customer,staff"
                    },
                    {
                        "name": "filter[activityId]",
                        "in": "query",
                        "description": "The lesson the note is about, when it relates to one. Exact match. A comma-separated list becomes an `IN (...)` match, and an explicit `null` matches rows where the field is unset. Operators: `eq`, `neq`, `ne`, `in`, `nin`, `exists` — e.g. `filter[activityId][eq]=…`, or the JSON form `filter[activityId]={\"eq\":\"…\"}`.",
                        "schema": {
                            "oneOf": [
                                {
