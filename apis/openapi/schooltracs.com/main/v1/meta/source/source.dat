        "/invoices/{id}": {
            "get": {
                "operationId": "getInvoicesId",
                "tags": [
                    "Invoices"
                ],
                "summary": "Get one invoice",
                "description": "**Why you'll use it**\n\nRender a statement, or check what a payment was actually for.\n\n**Plan**\n\nPAID plan only. A FREE key gets `403 Invoice access is not included in the current subscription plan.`.\n\n**Example queries**\n\n- `/71220?include=invoiceItems,receipts,customer`  \n  Everything needed to show a full statement in one call.\n\n**Related records you can pull in** (`?include=`)\n\n- `customer` — Who it is addressed to, as `{id, name, number}`.\n- `invoiceItems` — The lines on the invoice, with price, quantity, discount and tax.\n- `orderItems` — The underlying orders the lines were billed from — the full order records, not a summary.\n- `receipts` — Payments received against this invoice.",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "description": "Identifier of the record to act on. A record outside the centres your key covers reports `404`, never `403`.",
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "fields[invoice]",
                        "in": "query",
                        "description": "Return only these fields, comma separated. `id` is always included whether you ask for it or not. The key is the model's table name, so it is `fields[invoice]` for this resource.",
                        "schema": {
                            "type": "string"
                        },
                        "example": "customerId,billDate,number"
                    },
                    {
                        "name": "include",
                        "in": "query",
                        "description": "Related records to embed in the response, comma separated.",
                        "schema": {
                            "type": "string"
                        },
                        "example": "customer,invoiceItems"
                    },
                    {
                        "name": "withTrashed",
                        "in": "query",
                        "description": "Include soft-deleted records alongside live ones. PAID plan only — a FREE key is silently given the normal, non-deleted result set instead.",
                        "schema": {
                            "type": "boolean"
                        }
                    },
                    {
                        "name": "onlyTrashed",
                        "in": "query",
                        "description": "Return only soft-deleted records. PAID plan only — a FREE key is silently given the normal, non-deleted result set instead.",
                        "schema": {
                            "type": "boolean"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "The requested record.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/Invoice"
                                        },
                                        "meta": {
                                            "$ref": "#/components/schemas/Meta"
                                        }
                                    },
                                    "required": [
                                        "data",
                                        "meta"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFound"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationFailed"
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    },
                    "500": {
                        "$ref": "#/components/responses/ServerError"
                    }
                },
                "x-plan-required": "PAID"
            },
            "patch": {
                "operationId": "patchInvoicesId",
                "tags": [
                    "Invoices"
                ],
                "summary": "Change an invoice due date",
                "description": "**Why you'll use it**\n\nGrant an extension, or correct a due date that was set wrong — without reissuing the invoice.\n\n**Before you send**\n\n`dueDate` is the only thing you can change, and it is the only thing there is to change: invoices are not created or revised through this API.\n\nThe key must be **present in the body**. Sending `null` clears the due date; leaving the key out altogether is rejected with `422` rather than treated as a no-op, because those two intentions are impossible to tell apart.\n\nA due date earlier than the invoice date is rejected with `422`.\n\n**Plan**\n\nPAID plan only — a FREE key has no write scope for this resource, so the request is rejected with `403 This API is not included in the current subscription plan.` before it reaches the controller.\n\nSaving fires the same `invoice.*` [webhook](#description/webhooks) as any other invoice change.",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "description": "Identifier of the record to act on. A record outside the centres your key covers reports `404`, never `403`.",
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "The requested record.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/Invoice"
                                        },
                                        "meta": {
                                            "$ref": "#/components/schemas/Meta"
                                        }
                                    },
                                    "required": [
                                        "data",
                                        "meta"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFound"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationFailed"
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    },
                    "500": {
                        "$ref": "#/components/responses/ServerError"
                    }
                },
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "dueDate": {
                                        "type": [
                                            "string",
                                            "null"
                                        ],
                                        "format": "date",
                                        "description": "Must be present in the body. Send `null` to clear it; omitting the key is rejected."
                                    }
                                },
                                "required": [
                                    "dueDate"
                                ],
                                "additionalProperties": true
                            },
                            "example": {
                                "dueDate": "2026-02-15"
                            }
                        }
                    }
                },
                "x-plan-required": "PAID"
            }
        },
        "/invoices/{id}/void": {
            "post": {
                "operationId": "postInvoicesIdVoid",
                "tags": [
                    "Invoices"
                ],
                "summary": "Void an invoice",
                "description": "**Why you'll use it**\n\nCancel an invoice raised in error, together with what it was billing for.\n\n**Before you send**\n\n**This cancels the underlying orders, not just the document.** Voiding an invoice for a course enrolment cancels that enrolment's remaining lessons too. That is deliberate — leaving the orders alive with their invoice gone would corrupt the billing records — but it means voiding is a bigger action than it sounds.\n\nAn invoice with any payment against it is rejected with `422`. Reverse the payment first.\n\nVoiding is not repeatable: a second attempt on the same invoice returns `404`. The invoice number is cleared, and the document keeps its internal record of what it used to be.\n\n**Plan**\n\nPAID plan only — a FREE key has no write scope for this resource, so the request is rejected with `403 This API is not included in the current subscription plan.` before it reaches the controller.\n\nThe body is ignored; there is nothing to send — including `confirmed`. If the sales engine raises a warning while cancelling the underlying orders you get a `409` and nothing changes, and there is no payload that waves it through; clear what it reports, or void the invoice in SchoolTracs.\n\nVoiding fires the same `invoice.*` [webhook](#description/webhooks) as any other invoice change, so downstream systems see it.",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "description": "Identifier of the record to act on. A record outside the centres your key covers reports `404`, never `403`.",
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "The voided invoice — `number` cleared and `deleted` true.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/Invoice"
                                        },
                                        "meta": {
                                            "$ref": "#/components/schemas/Meta"
                                        }
                                    },
                                    "required": [
                                        "data",
                                        "meta"
                                    ]
                                },
                                "example": {
                                    "data": {
                                        "id": 71220,
                                        "customerId": 9101,
                                        "billDate": "2026-01-02",
                                        "number": null,
                                        "customers": "Amelia Tsang",
                                        "invoiceDate": "2026-01-02",
                                        "dueDate": "2026-01-16",
                                        "total": 0,
                                        "paid": 0,
                                        "dueAmount": 0,
                                        "centerId": 41,
                                        "remark": null,
                                        "staffId": 3301,
                                        "finalized": true,
                                        "url": null,
                                        "created": "2026-01-02T03:12:11+00:00",
                                        "updated": "2026-03-18T01:04:22+00:00",
                                        "deleted": true
                                    },
                                    "meta": {
                                        "message": "Voided",
                                        "apiVersion": "v1",
                                        "timestamp": "2026-03-18T01:04:22+00:00"
                                    }
                                }
                            }
                        }
                    },
