        "/facilities": {
            "get": {
                "operationId": "getFacilities",
                "tags": [
                    "Rooms"
                ],
                "summary": "List rooms",
                "description": "**Why you'll use it**\n\nBuild a room picker, or resolve room names to the IDs a timetable display needs.\n\n**Example queries**\n\n- `?filter[offsite]=0&sort=name`  \n  On-site rooms only, alphabetically.\n- `?filter[capacity][gte]=20`  \n  Rooms big enough for a workshop.\n\n**Related records you can pull in** (`?include=`)\n\n- `center` — The centre the room belongs to, as `{id, name}`.",
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Page number, starting at 1. How deep you may page is capped by your plan — 5 pages on FREE and 200 on PAID, independent of page size. Going past the cap is a `422`, not an empty page.",
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "default": 1
                        }
                    },
                    {
                        "name": "pageSize",
                        "in": "query",
                        "description": "Records per page. Defaults to 50, with a hard ceiling of 500 and a plan ceiling of 50 on FREE / 500 on PAID. Asking for more than your plan allows returns `422` — it is never silently clamped.",
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "default": 50
                        }
                    },
                    {
                        "name": "perPage",
                        "in": "query",
                        "description": "Alias for `pageSize`. If both are sent, `pageSize` wins.",
                        "schema": {
                            "type": "integer",
                            "minimum": 1
                        }
