        },
        "responses": {
            "Unauthorized": {
                "description": "The `X-Api-Key` header was missing, unrecognised or belongs to a revoked key. This comes from middleware, so the body is the short `{\"message\": \"Unauthorized\"}` form.",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/MiddlewareError"
                        }
                    }
                }
            },
            "Forbidden": {
                "description": "Your plan does not include this endpoint, or you tried to write to a centre your key does not cover. A plan refusal comes from middleware and uses the short form; a controller refusal uses the `Error` envelope.",
                "content": {
                    "application/json": {
                        "schema": {
                            "anyOf": [
                                {
                                    "$ref": "#/components/schemas/MiddlewareError"
                                },
                                {
                                    "$ref": "#/components/schemas/Error"
                                }
                            ]
                        }
                    }
                }
            },
            "NotFound": {
                "description": "No such record. This is also what you get for a record that exists but belongs to another centre — the API will not tell you the difference.",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/Error"
                        }
                    }
                }
            },
            "BadRequest": {
                "description": "The request was understood but the operation is not allowed in the current state. The `message` explains what stopped it, and is safe to show to a person.",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/Error"
                        }
                    }
                }
            },
            "ValidationFailed": {
                "description": "Validation failed, or you crossed a plan limit on page size, page depth or date range. Validation failures fill `errors` with a list of problems per field; limit failures carry only a `message`.",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/Error"
                        }
                    }
                }
            },
            "ConfirmationUnavailable": {
                "description": "The action stopped on a warning from the sales engine and nothing was changed. Unlike the other sales actions, this endpoint does not accept a `confirmed` payload, so the warning cannot be waved through from the API — clear whatever it reports, or carry out the action in SchoolTracs.",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/ConfirmationRequired"
                        }
                    }
                }
            },
            "NeedsConfirmation": {
                "description": "The action would do something worth a second look, and stopped to ask. Nothing has been changed. Re-send the identical request with `confirmed` set to acknowledge it.",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/ConfirmationRequired"
                        }
                    }
                }
            },
            "TooManyRequests": {
                "description": "A rate limit ran out. `window` names which budget and `retry_after` says how many seconds to wait — also sent as the `Retry-After` header. Every response carries `X-RateLimit-Limit` and `X-RateLimit-Remaining` for the per-minute budget, so you can slow down before hitting this.",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/RateLimitError"
                        }
                    }
                },
                "headers": {
                    "Retry-After": {
                        "description": "Seconds until the window resets.",
                        "schema": {
                            "type": "integer"
                        }
                    },
                    "X-RateLimit-Limit": {
                        "description": "The ceiling for the window you hit.",
                        "schema": {
                            "type": "integer"
                        }
                    },
                    "X-RateLimit-Remaining": {
                        "description": "Requests left in the window.",
                        "schema": {
                            "type": "integer"
                        }
                    }
                }
            },
            "ServerError": {
                "description": "Something failed on our side. The message is deliberately generic; the detail is in our logs. Safe to retry.",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/Error"
                        }
                    }
                }
            }
        }
    }
}
