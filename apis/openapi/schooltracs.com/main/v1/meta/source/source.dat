                                "mobile",
                                "calendarId",
                                "shareCalendarId",
                                "number",
                                "rosterGroup",
                                "centerId",
                                "preferredColor",
                                "customFields",
                                "created",
                                "updated",
                                "deleted"
                            ]
                        },
                        "example": "-created"
