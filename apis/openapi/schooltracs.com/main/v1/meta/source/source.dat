        },
        "/activities/{id}/attendance": {
            "patch": {
                "operationId": "patchActivitiesIdAttendance",
                "tags": [
                    "Lessons"
                ],
                "summary": "Mark attendance",
                "description": "**Why you'll use it**\n\nTake the register from a tablet at the door, a card reader, or your own teaching app, and have it land in SchoolTracs immediately.\n\n**Before you send**\n\nIdentify the student with `customerId` — the path ID is the lesson. The student has to already be booked into that lesson; if they are not, you get `404`.\n\nMarking someone `P` or `T` stamps their arrival time if it is blank, and — the first time they move into a present state — **notifies the people who normally get a present notification** and awards any attendance loyalty points. Moving them back out of a present state clears the arrival time and reverses those points. Do not use this endpoint to test things against live data.\n\nA lesson inside a locked timetable period is rejected with `400`.\n\n**Plan**\n\nPAID plan only — a FREE key has no write scope for this resource, so the request is rejected with `403 This API is not included in the current subscription plan.` before it reaches the controller.\n\nAttendance codes:\n\n| Code | Meaning |\n|---|---|\n| `P` | Present |\n| `T` | Late |\n| `A` | Absent |\n| `L` | Leave |\n| `S` | Sick leave |\n| `M` | Moved |\n| `O` | Other |\n| `W` | Severe weather |\n| `H` | Rescheduled |\n\nThe response is the attendance record itself, not the lesson.",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "description": "Identifier of the record to act on. A record outside the centres your key covers reports `404`, never `403`.",
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "The updated attendance record.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "object",
                                            "properties": {
                                                "id": {
                                                    "type": "integer",
                                                    "description": "The booking record's ID, not the lesson's."
                                                },
                                                "activityId": {
                                                    "type": "integer"
                                                },
                                                "customerId": {
                                                    "type": "integer"
                                                },
                                                "attendance": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ],
                                                    "description": "The code now stored."
                                                },
                                                "attendanceUpdated": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ],
                                                    "format": "date-time",
                                                    "description": "ISO 8601 timestamp with a timezone offset, for example `2026-03-17T08:31:02+00:00`."
                                                },
                                                "arrivalTime": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ],
                                                    "description": "Time in `HH:mm:ss` format without a timezone offset, for example `16:25:00`. Stamped automatically on a move into `P` or `T`, cleared on a move out."
                                                },
                                                "remark": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ]
                                                },
                                                "extRemark": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ],
                                                    "description": "A second remark field, shown externally."
                                                }
                                            }
                                        },
                                        "meta": {
                                            "$ref": "#/components/schemas/Meta"
                                        }
                                    },
                                    "required": [
                                        "data",
                                        "meta"
                                    ]
                                },
                                "example": {
                                    "data": {
                                        "id": 310884,
                                        "activityId": 88201,
                                        "customerId": 9101,
                                        "attendance": "P",
                                        "attendanceUpdated": "2026-03-17T08:31:02+00:00",
                                        "arrivalTime": "16:25:00",
                                        "remark": "Arrived 5 min early.",
                                        "extRemark": null
                                    },
                                    "meta": {
                                        "message": "Updated",
                                        "apiVersion": "v1",
                                        "timestamp": "2026-03-17T08:31:02+00:00"
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "$ref": "#/components/responses/BadRequest"
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFound"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationFailed"
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    },
                    "500": {
                        "$ref": "#/components/responses/ServerError"
                    }
                },
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "customerId": {
                                        "type": "integer",
                                        "description": "Required."
                                    },
                                    "attendance": {
                                        "type": "string",
                                        "enum": [
                                            "P",
                                            "T",
                                            "A",
                                            "L",
                                            "S",
                                            "M",
                                            "O",
                                            "W",
                                            "H"
                                        ],
                                        "description": "Required."
                                    },
                                    "remark": {
                                        "type": [
                                            "string",
                                            "null"
                                        ]
                                    },
                                    "extRemark": {
                                        "type": [
                                            "string",
                                            "null"
                                        ]
                                    }
                                },
                                "required": [
                                    "customerId",
                                    "attendance"
                                ],
                                "additionalProperties": true
                            },
                            "example": {
                                "customerId": 9101,
                                "attendance": "P",
                                "remark": "Arrived 5 min early."
                            }
                        }
                    }
                },
                "x-plan-required": "PAID"
            }
        },
        "/activities/{id}/makeup": {
            "post": {
                "operationId": "postActivitiesIdMakeup",
                "tags": [
                    "Lessons"
                ],
                "summary": "Schedule a make-up lesson",
                "description": "**Why you'll use it**\n\nMove a student from a lesson they are missing into a replacement one, in a single call that does both halves of the swap and keeps them linked.\n\n**Before you send**\n\nThe path ID is the lesson being **missed**; `toActivityId` is the replacement. The student must already be booked into the lesson they are missing.\n\nIf they are still marked as attending it, they are dropped from it first, and the two bookings are linked so the make-up shows up as one on both lessons.\n\nA lesson that already has a make-up scheduled is rejected with `422` — cancel the existing one first.\n\n**Plan**\n\nPAID plan only — a FREE key has no write scope for this resource, so the request is rejected with `403 This API is not included in the current subscription plan.` before it reaches the controller.\n\nThis behaves like a member of staff arranging the make-up, not like a student booking one: the self-service rules about how far ahead a make-up may be, how many are allowed, and whether it must be with the same teacher are **not** enforced here. Those settings exist for the student app.\n\nIf the swap would do something that normally warrants a warning, you get a `409` describing it; re-send the identical request with `confirmed: {\"<kind>\": true}` to proceed.",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "description": "Identifier of the record to act on. A record outside the centres your key covers reports `404`, never `403`.",
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "The original booking, now linked to its make-up.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "object",
                                            "description": "The booking on the lesson being missed, after the swap.",
                                            "properties": {
                                                "id": {
                                                    "type": "integer"
                                                },
                                                "activityId": {
                                                    "type": "integer",
                                                    "description": "The lesson being missed."
                                                },
                                                "customerId": {
                                                    "type": "integer"
                                                },
                                                "status": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ],
                                                    "description": "The booking status after the drop — a skip state."
                                                },
                                                "moveFromId": {
                                                    "type": [
                                                        "integer",
                                                        "null"
                                                    ],
                                                    "description": "Set on the *replacement* booking, pointing back here."
                                                },
                                                "moveToId": {
                                                    "type": [
                                                        "integer",
                                                        "null"
                                                    ],
                                                    "description": "The replacement booking this lesson was made up into."
                                                }
                                            }
                                        },
                                        "meta": {
                                            "$ref": "#/components/schemas/Meta"
                                        }
                                    },
                                    "required": [
                                        "data",
                                        "meta"
                                    ]
                                },
                                "example": {
                                    "data": {
                                        "id": 310912,
                                        "activityId": 88201,
                                        "customerId": 9102,
                                        "status": "S",
                                        "moveFromId": null,
                                        "moveToId": 310977
                                    },
                                    "meta": {
                                        "message": "Updated",
                                        "apiVersion": "v1",
                                        "timestamp": "2026-03-16T02:14:50+00:00"
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "$ref": "#/components/responses/BadRequest"
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFound"
                    },
                    "409": {
                        "$ref": "#/components/responses/NeedsConfirmation"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationFailed"
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    },
                    "500": {
                        "$ref": "#/components/responses/ServerError"
                    }
                },
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "customerId": {
                                        "type": "integer",
                                        "description": "Required."
                                    },
                                    "toActivityId": {
                                        "type": "integer",
                                        "description": "Required."
                                    },
                                    "confirmed": {
                                        "type": [
                                            "array",
                                            "null"
                                        ]
                                    }
                                },
                                "required": [
                                    "customerId",
                                    "toActivityId"
                                ],
                                "additionalProperties": true
                            },
                            "example": {
                                "customerId": 9102,
                                "toActivityId": 88233
                            }
                        }
                    }
                },
                "x-plan-required": "PAID"
            }
        },
        "/activities/{id}/makeup/cancel": {
            "post": {
                "operationId": "postActivitiesIdMakeupCancel",
                "tags": [
                    "Lessons"
                ],
                "summary": "Cancel a make-up lesson",
                "description": "**Why you'll use it**\n\nUndo a make-up: drop the replacement booking and put the student back on the lesson they were originally in.\n\n**Before you send**\n\nYou can call this with **either** lesson in the path — the one that was missed or the replacement. The API works out which is which from the link between them.\n\nA lesson with no make-up link is rejected with `422`.\n\n**Plan**\n\nPAID plan only — a FREE key has no write scope for this resource, so the request is rejected with `403 This API is not included in the current subscription plan.` before it reaches the controller.\n\nThis is a genuine undo, not just unlinking the two bookings: the replacement booking is removed, and the student is re-enrolled on the original lesson as an ordinary single booking. Their attendance on that lesson starts clean.\n\nUnlike scheduling a make-up, this endpoint takes no `confirmed` payload. If the sales engine raises a warning you get a `409` and nothing changes, and the only way past it is to clear what it reports or do the cancellation in SchoolTracs.",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "description": "Identifier of the record to act on. A record outside the centres your key covers reports `404`, never `403`.",
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "The booking restored on the original lesson.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "object",
                                            "description": "The restored booking on the original lesson.",
                                            "properties": {
                                                "id": {
                                                    "type": "integer"
                                                },
                                                "activityId": {
                                                    "type": "integer"
                                                },
                                                "customerId": {
                                                    "type": "integer"
                                                },
                                                "status": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ],
                                                    "description": "Back to an ordinary single booking."
                                                },
                                                "moveFromId": {
                                                    "type": [
                                                        "integer",
                                                        "null"
                                                    ]
                                                },
                                                "moveToId": {
                                                    "type": [
                                                        "integer",
                                                        "null"
                                                    ],
                                                    "description": "Cleared, because the link is gone."
                                                }
                                            }
                                        },
                                        "meta": {
                                            "$ref": "#/components/schemas/Meta"
                                        }
                                    },
                                    "required": [
                                        "data",
                                        "meta"
                                    ]
                                },
                                "example": {
                                    "data": {
                                        "id": 310912,
                                        "activityId": 88201,
                                        "customerId": 9102,
                                        "status": "T",
                                        "moveFromId": null,
                                        "moveToId": null
                                    },
                                    "meta": {
                                        "message": "Updated",
                                        "apiVersion": "v1",
                                        "timestamp": "2026-03-16T04:02:11+00:00"
                                    }
                                }
                            }
                        }
                    },
