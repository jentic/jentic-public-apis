            "post": {
                "operationId": "postJournalItems",
                "tags": [
                    "Journal"
                ],
                "summary": "Write a journal note",
                "description": "**Why you'll use it**\n\nPost feedback from your own teaching tool straight onto a student's record.\n\n**Before you send**\n\n`customerId`, `staffId` and `content` are all required. `staffId` is required because an API key is not a person — there is no signed-in member of staff to attribute the note to, so you have to say who wrote it.\n\nSetting `privacy` to `customer` shares the note with the student **and sends them a notification**. Use `staff` for internal notes. Attachments cannot be uploaded through this endpoint.\n\n**Plan**\n\nPAID plan only — a FREE key has no write scope for this resource, so the request is rejected with `403 This API is not included in the current subscription plan.` before it reaches the controller.",
                "parameters": [],
                "responses": {
                    "201": {
                        "description": "The requested record.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/JournalItem"
                                        },
                                        "meta": {
                                            "$ref": "#/components/schemas/Meta"
                                        }
                                    },
                                    "required": [
                                        "data",
                                        "meta"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationFailed"
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    },
                    "500": {
                        "$ref": "#/components/responses/ServerError"
                    }
                },
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "centerId": {
                                        "type": "integer",
                                        "minimum": 1,
                                        "description": "Defaults to the centre bound to the API key. A supplied value must match the bound centre. Optional — omit it to leave the stored value alone."
                                    },
                                    "customerId": {
                                        "type": "integer",
                                        "description": "Required."
                                    },
                                    "activityId": {
                                        "type": [
                                            "integer",
                                            "null"
                                        ]
                                    },
                                    "staffId": {
                                        "type": "integer",
                                        "description": "Required."
                                    },
                                    "content": {
                                        "type": "string",
                                        "description": "Required."
                                    },
                                    "privacy": {
                                        "type": "string",
                                        "enum": [
                                            "customer",
                                            "staff"
                                        ],
                                        "description": "Optional — omit it to leave the stored value alone."
                                    }
                                },
                                "required": [
                                    "customerId",
                                    "staffId",
                                    "content"
                                ],
                                "additionalProperties": true,
                                "description": "Keys outside this list are dropped before validation rather than rejected. `id`, `created`, `updated`, `deleted` and `deletedAt` are never writable."
                            },
                            "example": {
                                "centerId": 41,
                                "customerId": 9101,
                                "activityId": 88201,
                                "staffId": 3301,
                                "content": "Confident with the C major scale this week.",
                                "privacy": "customer"
                            }
                        }
                    }
                },
                "x-plan-required": "PAID"
            }
        },
        "/journal-items/{id}": {
            "get": {
                "operationId": "getJournalItemsId",
                "tags": [
                    "Journal"
                ],
                "summary": "Get one journal note",
                "description": "**Why you'll use it**\n\nRead a single note with its attachments and author.\n\n**Plan**\n\nPAID plan only. A FREE key gets `403 Journal access is not included in the current subscription plan.`.\n\n**Related records you can pull in** (`?include=`)\n\n- `customer` — The student the note is about, as `{id, name}`.\n- `staff` — Who wrote it, as `{id, name}`.\n- `activity` — The lesson it relates to, as `{id, name, date}`.\n- `attachments` — Files attached to the note — read-only here; uploading needs the staff app.",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "description": "Identifier of the record to act on. A record outside the centres your key covers reports `404`, never `403`.",
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "fields[journal_item]",
                        "in": "query",
                        "description": "Return only these fields, comma separated. `id` is always included whether you ask for it or not. The key is the model's table name, so it is `fields[journal_item]` for this resource.",
                        "schema": {
                            "type": "string"
                        },
                        "example": "centerId,customerId,activityId"
                    },
                    {
                        "name": "include",
                        "in": "query",
                        "description": "Related records to embed in the response, comma separated.",
                        "schema": {
                            "type": "string"
                        },
                        "example": "customer,staff"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "The requested record.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/JournalItem"
                                        },
                                        "meta": {
                                            "$ref": "#/components/schemas/Meta"
                                        }
                                    },
                                    "required": [
                                        "data",
                                        "meta"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFound"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationFailed"
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    },
                    "500": {
                        "$ref": "#/components/responses/ServerError"
                    }
                },
                "x-plan-required": "PAID"
            },
            "patch": {
                "operationId": "patchJournalItemsId",
                "tags": [
                    "Journal"
                ],
                "summary": "Edit a journal note",
                "description": "**Why you'll use it**\n\nCorrect a note — fix a typo, add what you left out, or change who can see it.\n\n**Before you send**\n\nAn edit updates the note in place and keeps its `id`. Only `content`, `privacy` and `staffId` are taken from the body; anything else you send is ignored. The note is flagged as edited, but no earlier version is kept and no new record is written.\n\nThere is no way to take a note down through this API. `deletedAt` is rejected like any other deletion attempt — see [There is no delete endpoint](#description/there-is-no-delete-endpoint). Removing a note is a staff-app action.\n\n**Plan**\n\nPAID plan only — a FREE key has no write scope for this resource, so the request is rejected with `403 This API is not included in the current subscription plan.` before it reaches the controller.\n\n`PUT` is accepted as an equivalent alias for `PATCH` on this path.\n\nAn update never moves a record between centres: `centerId` is dropped before anything is written. You may still send it, but it has to match the centre the record is already in — a different one is rejected with `403`.\n\nAny edit that leaves the note on `privacy: customer` notifies the student again — not just one that switches it from `staff`. Fixing a typo on a shared note sends a second notification, so batch your corrections.",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "description": "Identifier of the record to act on. A record outside the centres your key covers reports `404`, never `403`.",
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "The requested record.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/JournalItem"
                                        },
                                        "meta": {
                                            "$ref": "#/components/schemas/Meta"
                                        }
                                    },
                                    "required": [
                                        "data",
                                        "meta"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFound"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationFailed"
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    },
                    "500": {
                        "$ref": "#/components/responses/ServerError"
                    }
                },
                "requestBody": {
                    "required": false,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "centerId": {
                                        "type": "integer",
                                        "minimum": 1,
                                        "description": "Defaults to the centre bound to the API key. A supplied value must match the bound centre. Optional — omit it to leave the stored value alone."
                                    },
                                    "customerId": {
                                        "type": "integer",
                                        "description": "Optional — omit it to leave the stored value alone."
                                    },
                                    "activityId": {
                                        "type": [
                                            "integer",
                                            "null"
                                        ]
                                    },
                                    "staffId": {
                                        "type": "integer",
                                        "description": "Optional — omit it to leave the stored value alone."
                                    },
                                    "content": {
                                        "type": "string",
                                        "description": "Optional — omit it to leave the stored value alone."
                                    },
                                    "privacy": {
                                        "type": "string",
                                        "enum": [
                                            "customer",
                                            "staff"
                                        ],
                                        "description": "Optional — omit it to leave the stored value alone."
                                    }
                                },
                                "additionalProperties": true,
                                "description": "Keys outside this list are dropped before validation rather than rejected. `id`, `created`, `updated`, `deleted` and `deletedAt` are never writable."
                            },
                            "example": {
                                "content": "Confident with C major; next week contrary motion.",
                                "privacy": "staff"
                            }
                        }
                    }
                },
                "x-plan-required": "PAID"
            }
        },
        "/leads": {
            "get": {
                "operationId": "getLeads",
                "tags": [
                    "Leads"
                ],
                "summary": "List leads",
                "description": "**Why you'll use it**\n\nPull your enquiry pipeline into a CRM or a follow-up dashboard, or check what came in from the website overnight.\n\n**Before you send**\n\nUnlike most of the finance-side resources, leads read on any plan. Your key still only ever sees leads in the centres it covers, and a key with no centre context at all is refused with `403`.\n\nA lead's `status` and assigned owner are not part of the read response, even though you can set them when saving one. If you need to track pipeline stage, keep it on your side.\n\n**Example queries**\n\n- `?filter[created][gte]=2026-03-01&sort=-created`  \n  This month's enquiries, newest first.\n- `?filter[name]=fenwick`  \n  Partial name search, the same as it works on students.\n- `?filter[email][exists]=false&filter[mobile][exists]=true`  \n  Leads you can only reach by phone — useful for deciding who to call.\n- `?include=center&fields[lead]=name,mobile,marketingSource`  \n  A lean call list with the centre attached.\n\n**Related records you can pull in** (`?include=`)\n\n- `center` — The centre the lead belongs to, as `{id, name}`.",
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Page number, starting at 1. How deep you may page is capped by your plan — 5 pages on FREE and 200 on PAID, independent of page size. Going past the cap is a `422`, not an empty page.",
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "default": 1
                        }
                    },
                    {
                        "name": "pageSize",
                        "in": "query",
                        "description": "Records per page. Defaults to 50, with a hard ceiling of 500 and a plan ceiling of 50 on FREE / 500 on PAID. Asking for more than your plan allows returns `422` — it is never silently clamped.",
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "default": 50
                        }
                    },
                    {
                        "name": "perPage",
                        "in": "query",
                        "description": "Alias for `pageSize`. If both are sent, `pageSize` wins.",
                        "schema": {
                            "type": "integer",
                            "minimum": 1
                        }
                    },
                    {
                        "name": "sort",
                        "in": "query",
                        "description": "Sort by one or more fields, comma separated. Prefix a field with `-` to sort descending (`sort=-created,name`). Sorting by anything outside the list below is rejected.",
                        "schema": {
                            "type": "string",
                            "x-allowed-fields": [
                                "id",
                                "name",
                                "fullName",
                                "localName",
                                "firstName",
                                "lastName",
                                "gender",
                                "email",
                                "phone",
                                "mobile",
                                "contact1Name",
                                "contact1Phone",
                                "contact1Email",
                                "contact2Name",
                                "contact2Phone",
                                "contact2Email",
                                "address",
                                "district",
                                "dobYear",
                                "dobMonth",
                                "dobDay",
                                "education",
                                "level",
                                "occupation",
                                "marketingSource",
                                "centerId",
                                "comment",
                                "citizenId",
                                "created",
                                "updated",
                                "deleted"
                            ]
                        },
                        "example": "-created"
                    },
                    {
                        "name": "fields[lead]",
                        "in": "query",
                        "description": "Return only these fields, comma separated. `id` is always included whether you ask for it or not. The key is the model's table name, so it is `fields[lead]` for this resource.",
                        "schema": {
                            "type": "string"
                        },
                        "example": "name,fullName,localName"
                    },
                    {
                        "name": "include",
                        "in": "query",
                        "description": "Related records to embed in the response, comma separated.",
                        "schema": {
                            "type": "string"
                        },
                        "example": "center"
                    },
                    {
                        "name": "filter[address]",
                        "in": "query",
                        "description": "Partial match (`LIKE %value%`). A comma-separated list matches any of the values. Operators: `eq`, `neq`, `ne`, `in`, `nin`, `like`, `exists` — e.g. `filter[address][eq]=…`, or the JSON form `filter[address]={\"eq\":\"…\"}`.",
                        "schema": {
                            "oneOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "object",
                                    "additionalProperties": true,
                                    "x-operators": [
                                        "eq",
                                        "neq",
                                        "ne",
                                        "in",
                                        "nin",
                                        "like",
                                        "exists"
                                    ]
                                }
                            ]
                        }
                    },
                    {
                        "name": "filter[centerId]",
                        "in": "query",
                        "description": "Exact match. A comma-separated list becomes an `IN (...)` match, and an explicit `null` matches rows where the field is unset. Operators: `eq`, `neq`, `ne`, `in`, `nin`, `exists` — e.g. `filter[centerId][eq]=…`, or the JSON form `filter[centerId]={\"eq\":\"…\"}`.",
                        "schema": {
