            "post": {
                "operationId": "postEnrollments",
                "tags": [
                    "Enrolments"
                ],
                "summary": "Create an enrolment",
                "description": "**Why you'll use it**\n\nBook a student onto a course from your own sign-up flow, and let SchoolTracs work out the lessons, the quota and the order.\n\n**Before you send**\n\nPoint at the **first lesson** you want them in — `activityId` — and the API follows the series from there.\n\nYou must supply either `feeId` (to start a new order) or `orderId` (to add to one that exists); with neither, the request is rejected with `422`. `courseId` is optional and defaults to the lesson's own course.\n\nThe enrolment is created **unpaid**. No invoice, receipt or payment is taken — billing stays a separate step, exactly as it is for staff checkout.\n\n**Plan**\n\nPAID plan only. A FREE key gets `403 Enrollment write access is not included in the current subscription plan.`.\n\nIf the booking would do something worth a second look — overfilling a class, clashing with another lesson — you get a `409` describing the concern instead of a booking. Re-send the identical request with `confirmed: {\"<kind>\": true}` to go ahead. An enrolment is a course order underneath, so this also fires an `order.created` [webhook](#description/webhooks) if you have one subscribed — there is no separate \"enrolments\" webhook.",
                "parameters": [],
                "responses": {
                    "201": {
                        "description": "The requested record.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/Enrollment"
                                        },
                                        "meta": {
                                            "$ref": "#/components/schemas/Meta"
                                        }
                                    },
                                    "required": [
                                        "data",
                                        "meta"
                                    ]
                                }
                            }
                        }
                    },
                    "400": {
                        "$ref": "#/components/responses/BadRequest"
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "409": {
                        "$ref": "#/components/responses/NeedsConfirmation"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationFailed"
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    },
                    "500": {
                        "$ref": "#/components/responses/ServerError"
                    }
                },
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "customerId": {
                                        "type": "integer",
                                        "description": "Required."
                                    },
                                    "activityId": {
                                        "type": "integer",
                                        "description": "Required."
                                    },
                                    "courseId": {
                                        "type": [
                                            "integer",
                                            "null"
                                        ]
                                    },
                                    "feeId": {
                                        "type": [
                                            "integer",
                                            "null"
                                        ]
                                    },
                                    "orderId": {
                                        "type": [
                                            "integer",
                                            "null"
                                        ]
                                    },
                                    "confirmed": {
                                        "type": [
                                            "array",
                                            "null"
                                        ]
                                    }
                                },
                                "required": [
                                    "customerId",
                                    "activityId"
                                ],
                                "additionalProperties": true
                            },
                            "example": {
                                "customerId": 9101,
                                "activityId": 88201,
                                "feeId": 4410
                            }
                        }
                    }
                },
                "x-plan-required": "PAID"
            }
        },
        "/enrollments/{id}": {
            "get": {
                "operationId": "getEnrollmentsId",
                "tags": [
                    "Enrolments"
                ],
                "summary": "Get one enrolment",
                "description": "**Why you'll use it**\n\nRead one enrolment with its derived course, date span and active flag — handy right after a create, to see what the booking engine actually produced.",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "description": "Identifier of the record to act on. A record outside the centres your key covers reports `404`, never `403`.",
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "fields[order_item]",
                        "in": "query",
                        "description": "Return only these fields, comma separated. `id` is always included whether you ask for it or not. The key is the model's table name, so it is `fields[order_item]` for this resource.",
                        "schema": {
                            "type": "string"
                        },
                        "example": "orderId,centerId,customerId"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "The requested record.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/Enrollment"
                                        },
                                        "meta": {
                                            "$ref": "#/components/schemas/Meta"
                                        }
                                    },
                                    "required": [
                                        "data",
                                        "meta"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFound"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationFailed"
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    },
                    "500": {
                        "$ref": "#/components/responses/ServerError"
                    }
                }
            },
            "patch": {
                "operationId": "patchEnrollmentsId",
                "tags": [
                    "Enrolments"
                ],
                "summary": "Update an enrolment",
                "description": "**Why you'll use it**\n\nChange the billing period or the quantity bought — extend a term, shorten one, or correct a miscounted package.\n\n**Before you send**\n\nOnly `startDate`, `endDate` and `quantity` can be changed, and at least one of them has to be present or the request is rejected with `422`. Changing `quantity` runs through the same pricing engine staff use, so totals, quota and scheduled lessons are all recalculated together.\n\n**Plan**\n\nPAID plan only. A FREE key gets `403 Enrollment write access is not included in the current subscription plan.`.\n\n`PUT` is accepted as an equivalent alias for `PATCH` on this path.\n\nLike creating, this can come back as a `409` asking you to confirm. Re-send with `confirmed`. Fires an `order.updated` [webhook](#description/webhooks) if you have one subscribed.",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "description": "Identifier of the record to act on. A record outside the centres your key covers reports `404`, never `403`.",
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "The requested record.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/Enrollment"
                                        },
                                        "meta": {
                                            "$ref": "#/components/schemas/Meta"
                                        }
                                    },
                                    "required": [
                                        "data",
                                        "meta"
                                    ]
                                }
                            }
                        }
                    },
                    "400": {
                        "$ref": "#/components/responses/BadRequest"
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFound"
                    },
                    "409": {
                        "$ref": "#/components/responses/NeedsConfirmation"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationFailed"
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    },
                    "500": {
                        "$ref": "#/components/responses/ServerError"
                    }
                },
                "requestBody": {
                    "required": false,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "startDate": {
                                        "type": [
                                            "string",
                                            "null"
                                        ],
                                        "format": "date",
                                        "description": "Optional — omit it to leave the stored value alone."
                                    },
                                    "endDate": {
                                        "type": [
                                            "string",
                                            "null"
                                        ],
                                        "format": "date",
                                        "description": "Optional — omit it to leave the stored value alone."
                                    },
                                    "quantity": {
                                        "type": "number",
                                        "description": "Optional — omit it to leave the stored value alone."
                                    },
                                    "confirmed": {
                                        "type": [
                                            "array",
                                            "null"
                                        ]
                                    }
                                },
                                "additionalProperties": true
                            },
                            "example": {
                                "endDate": "2026-07-31",
                                "quantity": 10
                            }
                        }
                    }
                },
                "x-plan-required": "PAID"
            }
        },
        "/enrollments/{id}/cancel": {
            "post": {
                "operationId": "postEnrollmentsIdCancel",
                "tags": [
                    "Enrolments"
                ],
                "summary": "Cancel an enrolment",
                "description": "**Why you'll use it**\n\nStop a student's remaining lessons on a course when they withdraw — the closest thing to a delete this API offers for enrolments.\n\n**Before you send**\n\nCancelling drops every still-booked lesson **from the next upcoming one onwards**. Lessons already taken are left alone, and so is the billing history. An enrolment with nothing upcoming left to cancel is rejected with `422`.\n\nNo refund is issued and no credit note is raised. Money is a separate, deliberate step — handle it in SchoolTracs, or with the refund tools staff already use.\n\n**Plan**\n\nPAID plan only. A FREE key gets `403 Enrollment write access is not included in the current subscription plan.`.\n\nIf cancelling would trigger a warning staff would normally see, you get a `409` describing it. Re-send the identical request with `confirmed: {\"<kind>\": true}` to proceed. Fires an `order.updated` [webhook](#description/webhooks) if you have one subscribed.",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "description": "Identifier of the record to act on. A record outside the centres your key covers reports `404`, never `403`.",
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "The enrolment after cancellation — note `active` is now false and `paid` may exceed `total`, which is the credit owed.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/Enrollment"
                                        },
                                        "meta": {
                                            "$ref": "#/components/schemas/Meta"
                                        }
                                    },
                                    "required": [
                                        "data",
                                        "meta"
                                    ]
                                },
                                "example": {
                                    "data": {
                                        "id": 55310,
                                        "orderId": 55310,
                                        "centerId": 41,
                                        "customerId": 9101,
                                        "feeId": 4410,
                                        "courseId": 3120,
                                        "courseName": "Grade 3",
                                        "active": false,
                                        "firstDate": "2026-01-06",
                                        "lastDate": "2026-03-17",
                                        "startDate": "2026-01-01",
                                        "endDate": "2026-06-30",
                                        "total": 3200,
                                        "paid": 5120,
                                        "scheduled": 5,
                                        "quota": 8,
                                        "quotaUnit": "visit",
                                        "billDate": "2026-01-02",
                                        "created": "2026-01-02T03:12:10+00:00",
                                        "updated": "2026-03-18T01:04:22+00:00",
                                        "deleted": false
                                    },
                                    "meta": {
                                        "message": "Cancelled",
                                        "apiVersion": "v1",
                                        "timestamp": "2026-03-18T01:04:22+00:00"
                                    }
                                }
                            }
                        }
                    },
