        "/order-items/{id}": {
            "get": {
                "operationId": "getOrderItemsId",
                "tags": [
                    "Orders"
                ],
                "summary": "Get one order",
                "description": "**Why you'll use it**\n\nTrace a single sale end to end — what was bought, what it cost, which invoice billed it and which receipt paid it.\n\n**Plan**\n\nPAID plan only. A FREE key gets `403 Order access is not included in the current subscription plan.`.\n\n**Example queries**\n\n- `/55310?include=customer,invoice,receipt.incomeItems`  \n  The full trail behind one line.\n\n**Related records you can pull in** (`?include=`)\n\n- `customer` — Who bought it, as `{id, name, number}`.\n- `staff` — Who sold it, as `{id, name}`.\n- `invoice` — The invoice it was billed on, summarised.\n- `receipt` — The receipt it was paid on, summarised. Its `incomeItems` are only filled in if you ask for `receipt.incomeItems`.\n- `receipt.incomeItems` — The individual payments on that receipt — cash, card, credit. Ask for this rather than plain `receipt` when you need the payment breakdown, otherwise it comes back empty.\n- `fee` — The fee it was priced from, as `{id, name}`.\n- `product` — The product sold, as `{id, name}`.\n- `tax` — The tax applied, as `{id, name, rate}`.\n- `center` — The centre, as `{id, name}`.",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "description": "Identifier of the record to act on. A record outside the centres your key covers reports `404`, never `403`.",
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "fields[order_item]",
                        "in": "query",
                        "description": "Return only these fields, comma separated. `id` is always included whether you ask for it or not. The key is the model's table name, so it is `fields[order_item]` for this resource.",
                        "schema": {
                            "type": "string"
                        },
                        "example": "centerId,invoiceId,receiptId"
                    },
                    {
                        "name": "include",
                        "in": "query",
                        "description": "Related records to embed in the response, comma separated.",
                        "schema": {
                            "type": "string"
                        },
                        "example": "customer,staff"
                    },
                    {
                        "name": "withTrashed",
                        "in": "query",
                        "description": "Include soft-deleted records alongside live ones. PAID plan only — a FREE key is silently given the normal, non-deleted result set instead.",
                        "schema": {
                            "type": "boolean"
                        }
                    },
                    {
                        "name": "onlyTrashed",
                        "in": "query",
                        "description": "Return only soft-deleted records. PAID plan only — a FREE key is silently given the normal, non-deleted result set instead.",
                        "schema": {
                            "type": "boolean"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "The requested record.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/OrderItem"
                                        },
                                        "meta": {
                                            "$ref": "#/components/schemas/Meta"
                                        }
                                    },
                                    "required": [
                                        "data",
                                        "meta"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFound"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationFailed"
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    },
                    "500": {
                        "$ref": "#/components/responses/ServerError"
                    }
                },
                "x-plan-required": "PAID"
            }
        },
        "/products": {
            "get": {
                "operationId": "getProducts",
                "tags": [
                    "Products"
                ],
                "summary": "List products",
                "description": "**Why you'll use it**\n\nPublish a shop catalogue, or check stock before promising an item to a student.\n\n**Example queries**\n\n- `?filter[canCustomerRead]=1&filter[quantity][gt]=0`  \n  Publicly visible items actually in stock.\n- `?filter[category]=Books&sort=name`  \n  One category, alphabetically.\n- `?filter[code]=BK-G3-01`  \n  Exact lookup by your own code.",
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Page number, starting at 1. How deep you may page is capped by your plan — 5 pages on FREE and 200 on PAID, independent of page size. Going past the cap is a `422`, not an empty page.",
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "default": 1
                        }
                    },
                    {
                        "name": "pageSize",
                        "in": "query",
                        "description": "Records per page. Defaults to 50, with a hard ceiling of 500 and a plan ceiling of 50 on FREE / 500 on PAID. Asking for more than your plan allows returns `422` — it is never silently clamped.",
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "default": 50
                        }
                    },
                    {
                        "name": "perPage",
                        "in": "query",
                        "description": "Alias for `pageSize`. If both are sent, `pageSize` wins.",
                        "schema": {
                            "type": "integer",
                            "minimum": 1
                        }
                    },
                    {
                        "name": "sort",
                        "in": "query",
                        "description": "Sort by one or more fields, comma separated. Prefix a field with `-` to sort descending (`sort=-created,name`). Sorting by anything outside the list below is rejected.",
                        "schema": {
                            "type": "string",
                            "x-allowed-fields": [
                                "id",
                                "code",
                                "category",
                                "name",
                                "price",
