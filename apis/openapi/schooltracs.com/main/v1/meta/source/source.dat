                ],
                "summary": "Update a course",
                "description": "**Why you'll use it**\n\nRename a course, extend its run, or change its default duration and capacity.\n\n**Before you send**\n\nRenaming has reach: changing `category`, `name` or `level` rewrites the matching names on the course's fees and on every lesson already generated from it, so the timetable and the billing history stay consistent with the new name. That is usually what you want, but it is not a small edit.\n\n**Plan**\n\nPAID plan only — a FREE key has no write scope for this resource, so the request is rejected with `403 This API is not included in the current subscription plan.` before it reaches the controller.\n\n`PUT` is accepted as an equivalent alias for `PATCH` on this path.\n\nAn update never moves a record between centres: `centerId` is dropped before anything is written. You may still send it, but it has to match the centre the record is already in — a different one is rejected with `403`.",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "description": "Identifier of the record to act on. A record outside the centres your key covers reports `404`, never `403`.",
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "The requested record.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/Course"
                                        },
                                        "meta": {
                                            "$ref": "#/components/schemas/Meta"
                                        }
                                    },
                                    "required": [
                                        "data",
                                        "meta"
                                    ]
                                }
                            }
                        }
                    },
                    "400": {
                        "$ref": "#/components/responses/BadRequest"
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFound"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationFailed"
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    },
                    "500": {
                        "$ref": "#/components/responses/ServerError"
                    }
                },
                "requestBody": {
                    "required": false,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "centerId": {
                                        "type": "integer",
                                        "minimum": 1,
                                        "description": "Defaults to the centre bound to the API key. A supplied value must match the bound centre. Optional — omit it to leave the stored value alone."
                                    },
                                    "category": {
                                        "type": [
                                            "string",
                                            "null"
                                        ],
                                        "maxLength": 45
                                    },
                                    "name": {
                                        "type": "string",
                                        "maxLength": 100,
                                        "description": "Optional — omit it to leave the stored value alone."
                                    },
                                    "level": {
                                        "type": [
                                            "string",
                                            "null"
                                        ],
                                        "maxLength": 60
                                    },
                                    "bookableStaffIds": {
                                        "type": [
                                            "array",
                                            "null"
                                        ]
                                    },
                                    "canCustomerRead": {
                                        "type": [
                                            "boolean",
                                            "null"
                                        ]
                                    },
                                    "rank": {
                                        "type": [
                                            "number",
                                            "null"
                                        ]
                                    },
                                    "startDate": {
                                        "type": [
                                            "string",
                                            "null"
                                        ],
                                        "format": "date"
                                    },
                                    "endDate": {
                                        "type": [
                                            "string",
                                            "null"
                                        ],
                                        "format": "date"
                                    },
                                    "activityDuration": {
                                        "type": [
                                            "number",
                                            "null"
                                        ],
                                        "minimum": 1
                                    },
                                    "capacity": {
                                        "type": [
                                            "number",
                                            "null"
                                        ],
                                        "minimum": 1
                                    },
                                    "options": {
                                        "type": [
                                            "array",
                                            "null"
                                        ]
                                    },
                                    "description": {
                                        "type": [
                                            "string",
                                            "null"
                                        ],
                                        "maxLength": 255
                                    },
                                    "detail": {
                                        "type": [
                                            "string",
                                            "null"
                                        ],
                                        "maxLength": 255
                                    },
                                    "remark": {
                                        "type": [
                                            "string",
                                            "null"
                                        ],
                                        "maxLength": 255
                                    },
                                    "schoolCalendarId": {
                                        "type": [
                                            "integer",
                                            "null"
                                        ]
                                    },
                                    "regular": {
                                        "type": [
                                            "boolean",
                                            "null"
                                        ]
                                    }
                                },
                                "additionalProperties": true,
                                "description": "Keys outside this list are dropped before validation rather than rejected. `id`, `created`, `updated`, `deleted` and `deletedAt` are never writable."
                            },
                            "example": {
                                "endDate": "2026-12-20",
                                "capacity": 8
                            }
                        }
                    }
                },
                "x-plan-required": "PAID"
            }
        },
        "/customers": {
            "get": {
                "operationId": "getCustomers",
                "tags": [
                    "Students"
                ],
                "summary": "List students",
                "description": "**Why you'll use it**\n\nSync your student list into a CRM or mailing tool, find someone by name or phone number, or pull everyone who joined this term.\n\n**Before you send**\n\nOn a FREE key this returns a reduced record — 16 fields, with the rest absent rather than null. Every PAID-only field is marked in the schema below, so you can tell at a glance what you will and will not get.\n\nThe same split applies to sorting: a FREE key may only sort by the fields it can see. `sort` lists every field here because the list is a property of the plan rather than the endpoint, so sorting by a PAID-only field on a FREE key is rejected rather than ignored.\n\n**Example queries**\n\n- `?filter[name]=tsang`  \n  Partial, case-insensitive name search — the default behaviour for text fields.\n- `?filter[mobile]=98765432`  \n  Find someone by phone number. Also a partial match, so a fragment works.\n- `?filter[email][exists]=false&filter[optIn]=1`  \n  Marketing opt-ins you have no email address for.\n- `?filter[enrollDate][gte]=2026-01-01&sort=-enrollDate`  \n  This year's new students, newest first.\n- `?filter[quitDate][exists]=false&fields[customer]=name,mobile,email`  \n  Active students only, with just the contact details.\n\n**Related records you can pull in** (`?include=`)\n\n- `center` — The centre the student belongs to, as `{id, name}`.",
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Page number, starting at 1. How deep you may page is capped by your plan — 5 pages on FREE and 200 on PAID, independent of page size. Going past the cap is a `422`, not an empty page.",
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "default": 1
                        }
                    },
                    {
                        "name": "pageSize",
                        "in": "query",
                        "description": "Records per page. Defaults to 50, with a hard ceiling of 500 and a plan ceiling of 50 on FREE / 500 on PAID. Asking for more than your plan allows returns `422` — it is never silently clamped.",
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "default": 50
                        }
                    },
                    {
                        "name": "perPage",
                        "in": "query",
                        "description": "Alias for `pageSize`. If both are sent, `pageSize` wins.",
                        "schema": {
                            "type": "integer",
                            "minimum": 1
                        }
                    },
                    {
                        "name": "sort",
                        "in": "query",
                        "description": "Sort by one or more fields, comma separated. Prefix a field with `-` to sort descending (`sort=-created,name`). Sorting by anything outside the list below is rejected.",
                        "schema": {
                            "type": "string",
                            "x-allowed-fields": [
                                "id",
                                "name",
                                "number",
                                "fullName",
                                "localName",
                                "billName",
                                "firstName",
                                "lastName",
                                "gender",
                                "email",
                                "phone",
                                "mobile",
                                "contact1Name",
                                "contact1Phone",
                                "contact1Email",
                                "contact2Name",
                                "contact2Phone",
                                "contact2Email",
                                "address",
                                "district",
                                "dobYear",
                                "dobMonth",
                                "dobDay",
                                "birthday",
                                "education",
                                "level",
                                "occupation",
                                "barcode",
                                "optIn",
                                "enrollDate",
                                "quitDate",
                                "marketingSource",
                                "centerId",
                                "detail",
                                "remark",
                                "appEnabled",
                                "appConnected",
                                "customFields",
                                "citizenId",
                                "created",
                                "updated",
                                "deleted"
                            ]
                        },
                        "example": "-created"
                    },
                    {
                        "name": "fields[customer]",
                        "in": "query",
                        "description": "Return only these fields, comma separated. `id` is always included whether you ask for it or not. The key is the model's table name, so it is `fields[customer]` for this resource.",
                        "schema": {
                            "type": "string"
                        },
                        "example": "name,number,fullName"
                    },
                    {
                        "name": "include",
                        "in": "query",
                        "description": "Related records to embed in the response, comma separated.",
                        "schema": {
                            "type": "string"
                        },
                        "example": "center"
                    },
                    {
                        "name": "filter[address]",
                        "in": "query",
                        "description": "Partial match (`LIKE %value%`). A comma-separated list matches any of the values. Operators: `eq`, `neq`, `ne`, `in`, `nin`, `like`, `exists` — e.g. `filter[address][eq]=…`, or the JSON form `filter[address]={\"eq\":\"…\"}`.",
                        "schema": {
                            "oneOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "object",
                                    "additionalProperties": true,
                                    "x-operators": [
                                        "eq",
                                        "neq",
                                        "ne",
                                        "in",
                                        "nin",
                                        "like",
                                        "exists"
                                    ]
                                }
                            ]
                        }
                    },
                    {
                        "name": "filter[appConnected]",
                        "in": "query",
                        "description": "Whether the student has actually linked the mobile app, as opposed to merely being allowed to. Exact match. A comma-separated list becomes an `IN (...)` match. Operators: `gt`, `gte`, `lt`, `lte`, `eq`, `ne`, `neq`, `in`, `nin`, `exists` — e.g. `filter[appConnected][gte]=…`, or the JSON form `filter[appConnected]={\"gte\":\"…\"}`.",
                        "schema": {
