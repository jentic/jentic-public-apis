                            "string",
                            "null"
                        ],
                        "description": "How the fee repeats: `by-quota` (a block of lessons), `monthly`, or `termly`. Anything that is not `by-quota` needs a `cycleSize`, or it falls back to `by-quota`."
                    },
                    "cycleSize": {
                        "type": [
                            "number",
                            "null"
                        ],
                        "description": "How many months or terms one cycle covers."
                    },
                    "quota": {
