            "post": {
                "operationId": "postFees",
                "tags": [
                    "Fees"
                ],
                "summary": "Create a fee",
                "description": "**Why you'll use it**\n\nPublish a new price — an early-bird rate, a short course, a holiday intensive.\n\n**Before you send**\n\n`billName` and `price` are required. Two defaults are applied for you if you leave them out: `cycleMode` becomes `by-quota` and `quotaUnit` becomes `minute`. A `cycleMode` of `monthly` or `termly` without a `cycleSize` is quietly downgraded to `by-quota`, so set both together.\n\nIf you attach a `courseId`, the course has to be in a centre your key covers, and its centre has to match the `centerId` you send.\n\n**Plan**\n\nPAID plan only — a FREE key has no write scope for this resource, so the request is rejected with `403 This API is not included in the current subscription plan.` before it reaches the controller.",
                "parameters": [],
                "responses": {
                    "201": {
                        "description": "The requested record.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/Fee"
                                        },
                                        "meta": {
                                            "$ref": "#/components/schemas/Meta"
                                        }
                                    },
                                    "required": [
                                        "data",
                                        "meta"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationFailed"
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    },
                    "500": {
                        "$ref": "#/components/responses/ServerError"
                    }
                },
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "centerId": {
                                        "type": "integer",
                                        "minimum": 1,
                                        "description": "Defaults to the centre bound to the API key. A supplied value must match the bound centre. Optional — omit it to leave the stored value alone."
                                    },
                                    "category": {
                                        "type": [
                                            "string",
                                            "null"
                                        ],
                                        "maxLength": 45
                                    },
                                    "name": {
                                        "type": [
                                            "string",
                                            "null"
                                        ],
                                        "maxLength": 100
                                    },
                                    "level": {
                                        "type": [
                                            "string",
                                            "null"
                                        ],
                                        "maxLength": 60
                                    },
                                    "billName": {
                                        "type": "string",
                                        "description": "Required."
                                    },
                                    "courseId": {
                                        "type": [
                                            "integer",
                                            "null"
                                        ]
                                    },
                                    "taxId": {
                                        "type": [
                                            "integer",
                                            "null"
                                        ]
                                    },
                                    "saleFrom": {
                                        "type": [
                                            "string",
                                            "null"
                                        ],
                                        "format": "date"
                                    },
                                    "saleTo": {
                                        "type": [
                                            "string",
                                            "null"
                                        ],
                                        "format": "date"
                                    },
                                    "cycleMode": {
                                        "type": [
                                            "string",
                                            "null"
                                        ],
                                        "enum": [
                                            "by-quota",
                                            "monthly",
                                            "termly",
                                            null
                                        ]
                                    },
                                    "cycleSize": {
                                        "type": [
                                            "number",
                                            "null"
                                        ],
                                        "minimum": 1
                                    },
                                    "quota": {
                                        "type": [
                                            "number",
                                            "null"
                                        ],
                                        "minimum": 1
                                    },
                                    "quotaUnit": {
                                        "type": [
                                            "string",
                                            "null"
                                        ],
                                        "enum": [
                                            "minute",
                                            "visit",
                                            null
                                        ]
                                    },
                                    "price": {
                                        "type": "number",
                                        "description": "Required."
                                    },
                                    "detail": {
                                        "type": [
                                            "string",
                                            "null"
                                        ]
                                    },
                                    "remark": {
                                        "type": [
                                            "string",
                                            "null"
                                        ]
                                    },
                                    "showOnStore": {
                                        "type": [
                                            "boolean",
                                            "null"
                                        ]
                                    }
                                },
                                "required": [
                                    "billName",
                                    "price"
                                ],
                                "additionalProperties": true,
                                "description": "Keys outside this list are dropped before validation rather than rejected. `id`, `created`, `updated`, `deleted` and `deletedAt` are never writable."
                            },
                            "example": {
                                "centerId": 41,
                                "courseId": 3120,
                                "billName": "Piano Grade 3 — 4 lessons",
                                "price": 2680,
                                "cycleMode": "by-quota",
                                "quota": 4,
                                "quotaUnit": "visit"
                            }
                        }
                    }
                },
                "x-plan-required": "PAID"
            }
        },
        "/fees/{id}": {
            "get": {
                "operationId": "getFeesId",
                "tags": [
                    "Fees"
                ],
                "summary": "Get one fee",
                "description": "**Why you'll use it**\n\nRead a single price, its cycle and its quota before quoting or enrolling.",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "description": "Identifier of the record to act on. A record outside the centres your key covers reports `404`, never `403`.",
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "fields[fee]",
                        "in": "query",
                        "description": "Return only these fields, comma separated. `id` is always included whether you ask for it or not. The key is the model's table name, so it is `fields[fee]` for this resource.",
                        "schema": {
                            "type": "string"
                        },
                        "example": "centerId,category,name"
                    },
                    {
                        "name": "withTrashed",
                        "in": "query",
                        "description": "Include soft-deleted records alongside live ones. PAID plan only — a FREE key is silently given the normal, non-deleted result set instead.",
                        "schema": {
                            "type": "boolean"
                        }
                    },
                    {
                        "name": "onlyTrashed",
                        "in": "query",
                        "description": "Return only soft-deleted records. PAID plan only — a FREE key is silently given the normal, non-deleted result set instead.",
