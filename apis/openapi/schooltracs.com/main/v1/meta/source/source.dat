            "Enrollment": {
                "type": "object",
                "description": "A student's ongoing place on a course, together with what it costs and how much of it has been paid or scheduled. Behind the scenes an enrolment **is** the course order, which is why `id` and `orderId` are always the same number — you can read either one off a response and hand it back as `orderId` on a later call.",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "orderId": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "description": "The same value as `id`, surfaced separately so you never have to know that an enrolment and an order are one record. Computed on the fly rather than stored, so it cannot be sorted on."
                    },
                    "centerId": {
                        "type": [
                            "integer",
                            "null"
                        ]
                    },
                    "customerId": {
                        "type": [
                            "integer",
                            "null"
                        ]
                    },
                    "feeId": {
                        "type": [
                            "integer",
                            "null"
                        ]
                    },
                    "courseId": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "description": "Derived from the lessons actually booked, not stored on the order. It is `null` for an enrolment with no live lessons. Computed on the fly rather than stored, so it cannot be sorted on."
                    },
                    "courseName": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "description": "Derived alongside `courseId`, for display without a second call. Computed on the fly rather than stored, so it cannot be sorted on."
                    },
                    "active": {
                        "type": "boolean",
                        "description": "Derived: true when at least one still-booked lesson is today or later. Also usable as a filter, where it switches the query between current and finished enrolments. Computed on the fly rather than stored, so it cannot be sorted on."
                    },
                    "firstDate": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date",
                        "description": "The earliest still-booked lesson. Derived, so it moves as lessons are added or dropped. Computed on the fly rather than stored, so it cannot be sorted on."
                    },
                    "lastDate": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date",
                        "description": "The latest still-booked lesson. Derived. Computed on the fly rather than stored, so it cannot be sorted on."
                    },
                    "startDate": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date",
                        "description": "The order's own billing period start — stored, and one of the three things `PATCH` can change. Not the same as `firstDate`."
                    },
                    "endDate": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date",
                        "description": "The order's own billing period end. Stored and writable, unlike `lastDate`."
                    },
                    "total": {
                        "type": [
                            "number",
                            "null"
                        ],
                        "description": "What the enrolment costs."
                    },
                    "paid": {
                        "type": [
                            "number",
                            "null"
                        ],
                        "description": "How much has been received against it."
                    },
                    "scheduled": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "description": "How much of the quota has actually been placed on the timetable."
                    },
                    "quota": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "description": "How much was bought, in `quotaUnit` — lessons, visits or minutes."
                    },
                    "quotaUnit": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "billDate": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date",
                        "description": "The date the order was billed on."
                    },
                    "created": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    },
                    "updated": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    },
                    "deleted": {
                        "type": "boolean"
                    }
                }
            },
