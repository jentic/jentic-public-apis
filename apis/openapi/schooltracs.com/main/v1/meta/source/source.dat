        "/customers/{id}": {
            "get": {
                "operationId": "getCustomersId",
                "tags": [
                    "Students"
                ],
                "summary": "Get one student",
                "description": "**Why you'll use it**\n\nLoad a full student record for a profile screen, a booking confirmation, or a support call.\n\nA student belonging to a centre your key does not cover returns `404`, the same as one that does not exist.\n\n**Related records you can pull in** (`?include=`)\n\n- `center` — The centre the student belongs to, as `{id, name}`.",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "description": "Identifier of the record to act on. A record outside the centres your key covers reports `404`, never `403`.",
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "fields[customer]",
                        "in": "query",
                        "description": "Return only these fields, comma separated. `id` is always included whether you ask for it or not. The key is the model's table name, so it is `fields[customer]` for this resource.",
                        "schema": {
                            "type": "string"
                        },
                        "example": "name,number,fullName"
                    },
                    {
                        "name": "include",
                        "in": "query",
                        "description": "Related records to embed in the response, comma separated.",
                        "schema": {
                            "type": "string"
                        },
                        "example": "center"
                    },
                    {
                        "name": "withTrashed",
                        "in": "query",
                        "description": "Include soft-deleted records alongside live ones. PAID plan only — a FREE key is silently given the normal, non-deleted result set instead.",
                        "schema": {
                            "type": "boolean"
                        }
                    },
                    {
                        "name": "onlyTrashed",
                        "in": "query",
                        "description": "Return only soft-deleted records. PAID plan only — a FREE key is silently given the normal, non-deleted result set instead.",
                        "schema": {
                            "type": "boolean"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "The requested record.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/Customer"
                                        },
                                        "meta": {
                                            "$ref": "#/components/schemas/Meta"
                                        }
                                    },
                                    "required": [
                                        "data",
                                        "meta"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "404": {
