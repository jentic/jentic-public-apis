        "/receipts/{id}": {
            "get": {
                "operationId": "getReceiptsId",
                "tags": [
                    "Receipts"
                ],
                "summary": "Get one receipt",
                "description": "**Why you'll use it**\n\nRender a receipt, or check how a particular payment was split across methods and lines.\n\n**Plan**\n\nPAID plan only. A FREE key gets `403 Receipt access is not included in the current subscription plan.`.\n\n**Example queries**\n\n- `/66104?include=incomeItems,receiptItems,customer`  \n  Everything needed to reprint a receipt.\n\n**Related records you can pull in** (`?include=`)\n\n- `customer` — The student the receipt is for, as `{id, name, number}`.\n- `center` — The centre, as `{id, name}`.\n- `incomeItems` — How the money arrived — cash, card, transfer, credit — one entry per payment method.\n- `receiptItems` — What the money was applied to, line by line.\n- `pointTransaction` — The loyalty points earned or spent on this receipt.",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "description": "Identifier of the record to act on. A record outside the centres your key covers reports `404`, never `403`.",
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "fields[receipt]",
                        "in": "query",
                        "description": "Return only these fields, comma separated. `id` is always included whether you ask for it or not. The key is the model's table name, so it is `fields[receipt]` for this resource.",
                        "schema": {
                            "type": "string"
                        },
                        "example": "centerId,number,receiptDate"
                    },
                    {
                        "name": "include",
                        "in": "query",
                        "description": "Related records to embed in the response, comma separated.",
                        "schema": {
                            "type": "string"
                        },
                        "example": "customer,center"
                    },
                    {
                        "name": "withTrashed",
                        "in": "query",
                        "description": "Include soft-deleted records alongside live ones. PAID plan only — a FREE key is silently given the normal, non-deleted result set instead.",
                        "schema": {
                            "type": "boolean"
                        }
                    },
                    {
                        "name": "onlyTrashed",
                        "in": "query",
                        "description": "Return only soft-deleted records. PAID plan only — a FREE key is silently given the normal, non-deleted result set instead.",
                        "schema": {
                            "type": "boolean"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "The requested record.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/Receipt"
                                        },
                                        "meta": {
                                            "$ref": "#/components/schemas/Meta"
                                        }
                                    },
                                    "required": [
                                        "data",
                                        "meta"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFound"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationFailed"
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    },
                    "500": {
                        "$ref": "#/components/responses/ServerError"
                    }
                },
                "x-plan-required": "PAID"
            }
        },
        "/staffs": {
            "get": {
                "operationId": "getStaffs",
                "tags": [
                    "Staff"
                ],
                "summary": "List staff",
                "description": "**Why you'll use it**\n\nBuild a teacher directory, resolve names to the `staffId` the journal and lesson endpoints want, or sync a roster.\n\n**Example queries**\n\n- `?filter[rosterGroup]=Piano&sort=name`  \n  One teaching team.\n- `?filter[email]=priya@example.com`  \n  Exact lookup by email — this field matches exactly rather than partially.\n\n**Related records you can pull in** (`?include=`)\n\n- `center` — The centre the person belongs to, as `{id, name}`.",
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Page number, starting at 1. How deep you may page is capped by your plan — 5 pages on FREE and 200 on PAID, independent of page size. Going past the cap is a `422`, not an empty page.",
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "default": 1
                        }
                    },
                    {
                        "name": "pageSize",
                        "in": "query",
                        "description": "Records per page. Defaults to 50, with a hard ceiling of 500 and a plan ceiling of 50 on FREE / 500 on PAID. Asking for more than your plan allows returns `422` — it is never silently clamped.",
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "default": 50
                        }
                    },
                    {
                        "name": "perPage",
                        "in": "query",
                        "description": "Alias for `pageSize`. If both are sent, `pageSize` wins.",
                        "schema": {
                            "type": "integer",
                            "minimum": 1
                        }
                    },
                    {
                        "name": "sort",
                        "in": "query",
                        "description": "Sort by one or more fields, comma separated. Prefix a field with `-` to sort descending (`sort=-created,name`). Sorting by anything outside the list below is rejected.",
                        "schema": {
