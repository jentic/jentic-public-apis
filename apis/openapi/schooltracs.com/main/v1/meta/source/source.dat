        "/courses": {
            "get": {
                "operationId": "getCourses",
                "tags": [
                    "Courses"
                ],
                "summary": "List courses",
                "description": "**Why you'll use it**\n\nBuild a course catalogue for your website, or resolve a course name to the `courseId` the lesson and enrolment endpoints need.\n\n**Example queries**\n\n- `?filter[category]=Piano&filter[canCustomerRead]=1`  \n  Everything in one subject that is safe to show publicly.\n- `?filter[endDate][gte]=2026-03-18&sort=rank,name`  \n  Courses still running, in the order staff arranged them.",
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Page number, starting at 1. How deep you may page is capped by your plan — 5 pages on FREE and 200 on PAID, independent of page size. Going past the cap is a `422`, not an empty page.",
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "default": 1
