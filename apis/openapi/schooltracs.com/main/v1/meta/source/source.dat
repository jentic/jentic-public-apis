            "post": {
                "operationId": "postCourses",
                "tags": [
                    "Courses"
                ],
                "summary": "Create a course",
                "description": "**Why you'll use it**\n\nAdd a new course from your own admin tooling, ready for fees and lessons to be attached to it.\n\n**Before you send**\n\nThe combination of `category`, `name` and `level` has to be unique within the centre. A clash comes back as `400` with a message naming the existing course, not a `422`. Creating a course does not generate any lessons.\n\n**Plan**\n\nPAID plan only — a FREE key has no write scope for this resource, so the request is rejected with `403 This API is not included in the current subscription plan.` before it reaches the controller.",
                "parameters": [],
                "responses": {
                    "201": {
                        "description": "The requested record.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/Course"
                                        },
                                        "meta": {
                                            "$ref": "#/components/schemas/Meta"
                                        }
                                    },
                                    "required": [
                                        "data",
                                        "meta"
                                    ]
                                }
                            }
                        }
                    },
                    "400": {
                        "$ref": "#/components/responses/BadRequest"
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationFailed"
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    },
                    "500": {
                        "$ref": "#/components/responses/ServerError"
                    }
                },
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "centerId": {
                                        "type": "integer",
                                        "minimum": 1,
                                        "description": "Defaults to the centre bound to the API key. A supplied value must match the bound centre. Optional — omit it to leave the stored value alone."
                                    },
                                    "category": {
                                        "type": [
                                            "string",
                                            "null"
                                        ],
                                        "maxLength": 45
                                    },
                                    "name": {
                                        "type": "string",
                                        "maxLength": 100,
                                        "description": "Required."
                                    },
                                    "level": {
                                        "type": [
                                            "string",
                                            "null"
                                        ],
                                        "maxLength": 60
                                    },
                                    "bookableStaffIds": {
                                        "type": [
                                            "array",
                                            "null"
                                        ]
                                    },
                                    "canCustomerRead": {
                                        "type": [
                                            "boolean",
                                            "null"
                                        ]
                                    },
                                    "rank": {
                                        "type": [
                                            "number",
                                            "null"
                                        ]
                                    },
                                    "startDate": {
                                        "type": [
                                            "string",
                                            "null"
                                        ],
                                        "format": "date"
                                    },
                                    "endDate": {
                                        "type": [
                                            "string",
                                            "null"
                                        ],
                                        "format": "date"
                                    },
                                    "activityDuration": {
                                        "type": [
                                            "number",
                                            "null"
                                        ],
                                        "minimum": 1
                                    },
                                    "capacity": {
                                        "type": [
                                            "number",
                                            "null"
                                        ],
                                        "minimum": 1
                                    },
                                    "options": {
                                        "type": [
                                            "array",
                                            "null"
                                        ]
                                    },
                                    "description": {
                                        "type": [
                                            "string",
                                            "null"
                                        ],
                                        "maxLength": 255
                                    },
                                    "detail": {
                                        "type": [
                                            "string",
                                            "null"
                                        ],
                                        "maxLength": 255
                                    },
                                    "remark": {
                                        "type": [
                                            "string",
                                            "null"
                                        ],
                                        "maxLength": 255
                                    },
                                    "schoolCalendarId": {
                                        "type": [
                                            "integer",
                                            "null"
                                        ]
                                    },
                                    "regular": {
                                        "type": [
                                            "boolean",
                                            "null"
                                        ]
                                    }
                                },
                                "required": [
                                    "name"
                                ],
                                "additionalProperties": true,
                                "description": "Keys outside this list are dropped before validation rather than rejected. `id`, `created`, `updated`, `deleted` and `deletedAt` are never writable."
                            },
                            "example": {
                                "centerId": 41,
                                "category": "Piano",
                                "name": "Grade 4",
                                "level": "Intermediate",
                                "activityDuration": 60,
                                "capacity": 6,
                                "startDate": "2026-09-01",
                                "endDate": "2027-06-30"
                            }
                        }
                    }
                },
                "x-plan-required": "PAID"
            }
