                "requestBody": {
                    "required": false,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "additionalProperties": true,
                                "properties": {
                                    "confirmed": {
                                        "type": "object",
                                        "additionalProperties": {
                                            "type": "boolean"
                                        },
                                        "description": "Acknowledges the warnings a previous attempt came back with. Take each key from that `409` response's `confirm` payload and set it to `true`."
                                    }
