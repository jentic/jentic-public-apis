                    "500": {
                        "$ref": "#/components/responses/ServerError"
                    }
                }
            },
            "patch": {
                "operationId": "patchCustomersId",
                "tags": [
                    "Students"
                ],
                "summary": "Update a student",
                "description": "**Why you'll use it**\n\nKeep contact details, marketing consent and custom fields in step with your own systems.\n\n**Before you send**\n\nSend only the keys you are changing. `number` and `appConnected` are never writable.\n\n**Plan**\n\nAvailable on every plan. This is one of the few resources a FREE key can write to.\n\n`PUT` is accepted as an equivalent alias for `PATCH` on this path.\n\nAn update never moves a record between centres: `centerId` is dropped before anything is written. You may still send it, but it has to match the centre the record is already in — a different one is rejected with `403`.\n\nIf you have subscribed a `student.*` [webhook](#description/webhooks), this fires a `student.updated` delivery.",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "description": "Identifier of the record to act on. A record outside the centres your key covers reports `404`, never `403`.",
                        "schema": {
