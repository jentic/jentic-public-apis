                    {
                        "name": "filter[scheduled]",
                        "in": "query",
                        "description": "How much of the quota has actually been placed on the timetable. Exact match. A comma-separated list becomes an `IN (...)` match. Operators: `gt`, `gte`, `lt`, `lte`, `eq`, `ne`, `neq`, `in`, `nin`, `exists` — e.g. `filter[scheduled][gte]=…`, or the JSON form `filter[scheduled]={\"gte\":\"…\"}`.",
                        "schema": {
