        "/receipts": {
            "get": {
                "operationId": "getReceipts",
                "tags": [
                    "Receipts"
                ],
                "summary": "List receipts",
                "description": "**Why you'll use it**\n\nReconcile takings by day or payment method, or show a student everything they have paid.\n\n**Before you send**\n\nPAID plan only. As with orders, undoing is not deleting: **a receipt is reversed by a later receipt pointing back at it**, and the original row stays exactly where it was. Reversed receipts are excluded by default; `filter[reversed]=true` returns only those. A `withTrashed` query asks a different question and will not find them.\n\n**Plan**\n\nPAID plan only. A FREE key gets `403 Receipt access is not included in the current subscription plan.`.\n\n**Example queries**\n\n- `?filter[receiptDate]=2026-03-17&include=incomeItems`  \n  One day's takings broken down by payment method — a till reconciliation.\n- `?filter[customerId]=9101&include=receiptItems&sort=-receiptDate`  \n  Everything one student has paid, and what for.\n- `?filter[reversed]=true&filter[receiptDate][gte]=2026-01-01`  \n  Reversals this year, which are invisible without the flag.\n- `?filter[staffId]=3301&filter[receiptDate][gte]=2026-03-01`  \n  Payments taken by one member of staff this month.\n\n**Related records you can pull in** (`?include=`)\n\n- `customer` — The student the receipt is for, as `{id, name, number}`.\n- `center` — The centre, as `{id, name}`.\n- `incomeItems` — How the money arrived — cash, card, transfer, credit — one entry per payment method.\n- `receiptItems` — What the money was applied to, line by line.\n- `pointTransaction` — The loyalty points earned or spent on this receipt.",
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Page number, starting at 1. How deep you may page is capped by your plan — 5 pages on FREE and 200 on PAID, independent of page size. Going past the cap is a `422`, not an empty page.",
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "default": 1
                        }
                    },
                    {
                        "name": "pageSize",
                        "in": "query",
                        "description": "Records per page. Defaults to 50, with a hard ceiling of 500 and a plan ceiling of 50 on FREE / 500 on PAID. Asking for more than your plan allows returns `422` — it is never silently clamped.",
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "default": 50
                        }
                    },
                    {
                        "name": "perPage",
                        "in": "query",
                        "description": "Alias for `pageSize`. If both are sent, `pageSize` wins.",
                        "schema": {
                            "type": "integer",
                            "minimum": 1
                        }
                    },
                    {
                        "name": "sort",
                        "in": "query",
                        "description": "Sort by one or more fields, comma separated. Prefix a field with `-` to sort descending (`sort=-created,name`). Sorting by anything outside the list below is rejected.",
                        "schema": {
                            "type": "string",
                            "x-allowed-fields": [
                                "id",
                                "centerId",
                                "number",
                                "receiptDate",
                                "detail",
                                "remark",
                                "staffId",
                                "total",
                                "paid",
                                "header",
                                "footer",
                                "created",
                                "updated",
                                "deleted"
                            ]
                        },
                        "example": "-created"
                    },
                    {
                        "name": "fields[receipt]",
                        "in": "query",
                        "description": "Return only these fields, comma separated. `id` is always included whether you ask for it or not. The key is the model's table name, so it is `fields[receipt]` for this resource.",
                        "schema": {
                            "type": "string"
                        },
                        "example": "centerId,number,receiptDate"
                    },
                    {
                        "name": "include",
                        "in": "query",
                        "description": "Related records to embed in the response, comma separated.",
                        "schema": {
                            "type": "string"
                        },
                        "example": "customer,center"
                    },
                    {
                        "name": "filter[centerId]",
                        "in": "query",
                        "description": "Exact match. A comma-separated list becomes an `IN (...)` match, and an explicit `null` matches rows where the field is unset. Operators: `eq`, `neq`, `ne`, `in`, `nin`, `exists` — e.g. `filter[centerId][eq]=…`, or the JSON form `filter[centerId]={\"eq\":\"…\"}`.",
                        "schema": {
                            "oneOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "object",
                                    "additionalProperties": true,
                                    "x-operators": [
                                        "eq",
                                        "neq",
                                        "ne",
                                        "in",
                                        "nin",
                                        "exists"
                                    ]
                                }
                            ]
                        }
                    },
                    {
                        "name": "filter[created]",
                        "in": "query",
                        "description": "Matches that calendar date. A comma-separated list matches any of the dates. Operators: `gt`, `gte`, `lt`, `lte`, `eq`, `ne`, `neq`, `in`, `nin`, `exists` — e.g. `filter[created][gte]=…`, or the JSON form `filter[created]={\"gte\":\"…\"}`.",
                        "schema": {
                            "oneOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "object",
                                    "additionalProperties": true,
