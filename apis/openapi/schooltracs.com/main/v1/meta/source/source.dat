                    }
                }
            },
            "patch": {
                "operationId": "patchFeesId",
                "tags": [
                    "Fees"
                ],
                "summary": "Update a fee",
                "description": "**Why you'll use it**\n\nChange a price, close a fee for sale, or correct its quota.\n\n**Before you send**\n\nEditing a fee does not reprice enrolments already sold at the old price — it only affects what is sold from now on. To stop selling something without deleting it, set `saleTo` to today.\n\n**Plan**\n\nPAID plan only — a FREE key has no write scope for this resource, so the request is rejected with `403 This API is not included in the current subscription plan.` before it reaches the controller.\n\n`PUT` is accepted as an equivalent alias for `PATCH` on this path.\n\nAn update never moves a record between centres: `centerId` is dropped before anything is written. You may still send it, but it has to match the centre the record is already in — a different one is rejected with `403`.",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "description": "Identifier of the record to act on. A record outside the centres your key covers reports `404`, never `403`.",
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "The requested record.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/Fee"
                                        },
                                        "meta": {
                                            "$ref": "#/components/schemas/Meta"
                                        }
                                    },
                                    "required": [
                                        "data",
                                        "meta"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFound"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationFailed"
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    },
                    "500": {
                        "$ref": "#/components/responses/ServerError"
                    }
                },
                "requestBody": {
                    "required": false,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "centerId": {
                                        "type": "integer",
                                        "minimum": 1,
                                        "description": "Defaults to the centre bound to the API key. A supplied value must match the bound centre. Optional — omit it to leave the stored value alone."
                                    },
                                    "category": {
                                        "type": [
                                            "string",
                                            "null"
                                        ],
                                        "maxLength": 45
                                    },
                                    "name": {
                                        "type": [
                                            "string",
                                            "null"
                                        ],
                                        "maxLength": 100
                                    },
                                    "level": {
                                        "type": [
                                            "string",
                                            "null"
                                        ],
                                        "maxLength": 60
                                    },
                                    "billName": {
                                        "type": "string",
                                        "description": "Optional — omit it to leave the stored value alone."
                                    },
                                    "courseId": {
                                        "type": [
                                            "integer",
                                            "null"
                                        ]
                                    },
                                    "taxId": {
                                        "type": [
                                            "integer",
                                            "null"
                                        ]
                                    },
                                    "saleFrom": {
                                        "type": [
                                            "string",
                                            "null"
                                        ],
                                        "format": "date"
                                    },
                                    "saleTo": {
                                        "type": [
                                            "string",
                                            "null"
                                        ],
                                        "format": "date"
                                    },
                                    "cycleMode": {
                                        "type": [
                                            "string",
                                            "null"
                                        ],
                                        "enum": [
                                            "by-quota",
                                            "monthly",
                                            "termly",
                                            null
                                        ]
                                    },
                                    "cycleSize": {
                                        "type": [
                                            "number",
                                            "null"
                                        ],
                                        "minimum": 1
                                    },
                                    "quota": {
                                        "type": [
                                            "number",
                                            "null"
                                        ],
                                        "minimum": 1
                                    },
                                    "quotaUnit": {
                                        "type": [
                                            "string",
                                            "null"
                                        ],
                                        "enum": [
                                            "minute",
                                            "visit",
                                            null
                                        ]
                                    },
                                    "price": {
                                        "type": "number",
                                        "description": "Optional — omit it to leave the stored value alone."
                                    },
                                    "detail": {
                                        "type": [
                                            "string",
                                            "null"
                                        ]
                                    },
                                    "remark": {
                                        "type": [
                                            "string",
                                            "null"
                                        ]
                                    },
                                    "showOnStore": {
                                        "type": [
                                            "boolean",
                                            "null"
                                        ]
                                    }
                                },
                                "additionalProperties": true,
                                "description": "Keys outside this list are dropped before validation rather than rejected. `id`, `created`, `updated`, `deleted` and `deletedAt` are never writable."
                            },
                            "example": {
                                "price": 5320,
                                "saleTo": "2026-08-31"
                            }
                        }
                    }
                },
                "x-plan-required": "PAID"
            }
        },
        "/invoices": {
            "get": {
                "operationId": "getInvoices",
                "tags": [
                    "Invoices"
                ],
                "summary": "List invoices",
                "description": "**Why you'll use it**\n\nDrive a debtors report, sync billing into your accounts package, or find everything a family owes.\n\n**Before you send**\n\nThe whole resource is PAID-only. `filter[dueAmount]` is computed rather than stored, so it is the quickest way to find unpaid invoices without pulling totals and subtracting them yourself.\n\n**Plan**\n\nPAID plan only. A FREE key gets `403 Invoice access is not included in the current subscription plan.`.\n\n**Example queries**\n\n- `?filter[dueAmount][gt]=0&sort=dueDate`  \n  Everything outstanding, soonest due first — a chase list.\n- `?filter[customerId]=9101&include=invoiceItems,receipts`  \n  One student's billing history with lines and payments attached.\n- `?filter[invoiceDate][gte]=2026-03-01&filter[invoiceDate][lte]=2026-03-31`  \n  One month, for a reconciliation run. Keep ranges under 90 days to stay off the historical-pull limit.\n- `?filter[dueDate][lt]=2026-03-18&filter[dueAmount][gt]=0`  \n  Overdue and unpaid.\n\n**Related records you can pull in** (`?include=`)\n\n- `customer` — Who it is addressed to, as `{id, name, number}`.\n- `invoiceItems` — The lines on the invoice, with price, quantity, discount and tax.\n- `orderItems` — The underlying orders the lines were billed from — the full order records, not a summary.\n- `receipts` — Payments received against this invoice.",
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Page number, starting at 1. How deep you may page is capped by your plan — 5 pages on FREE and 200 on PAID, independent of page size. Going past the cap is a `422`, not an empty page.",
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "default": 1
                        }
                    },
                    {
                        "name": "pageSize",
                        "in": "query",
                        "description": "Records per page. Defaults to 50, with a hard ceiling of 500 and a plan ceiling of 50 on FREE / 500 on PAID. Asking for more than your plan allows returns `422` — it is never silently clamped.",
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "default": 50
                        }
                    },
                    {
                        "name": "perPage",
                        "in": "query",
                        "description": "Alias for `pageSize`. If both are sent, `pageSize` wins.",
                        "schema": {
                            "type": "integer",
                            "minimum": 1
                        }
                    },
                    {
                        "name": "sort",
                        "in": "query",
                        "description": "Sort by one or more fields, comma separated. Prefix a field with `-` to sort descending (`sort=-created,name`). Sorting by anything outside the list below is rejected.",
                        "schema": {
                            "type": "string",
                            "x-allowed-fields": [
                                "id",
                                "customerId",
                                "billDate",
                                "number",
                                "customers",
                                "invoiceDate",
                                "dueDate",
                                "total",
                                "paid",
                                "centerId",
                                "remark",
                                "staffId",
                                "finalized",
                                "created",
                                "updated",
                                "deleted"
                            ]
                        },
                        "example": "-created"
                    },
                    {
                        "name": "fields[invoice]",
                        "in": "query",
                        "description": "Return only these fields, comma separated. `id` is always included whether you ask for it or not. The key is the model's table name, so it is `fields[invoice]` for this resource.",
                        "schema": {
                            "type": "string"
                        },
                        "example": "customerId,billDate,number"
                    },
                    {
                        "name": "include",
                        "in": "query",
                        "description": "Related records to embed in the response, comma separated.",
                        "schema": {
                            "type": "string"
                        },
                        "example": "customer,invoiceItems"
                    },
                    {
                        "name": "filter[billDate]",
                        "in": "query",
                        "description": "The date the charge relates to, which may differ from `invoiceDate`. Matches that calendar date. A comma-separated list matches any of the dates. Operators: `gt`, `gte`, `lt`, `lte`, `eq`, `ne`, `neq`, `in`, `nin`, `exists` — e.g. `filter[billDate][gte]=…`, or the JSON form `filter[billDate]={\"gte\":\"…\"}`.",
                        "schema": {
                            "oneOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "object",
                                    "additionalProperties": true,
                                    "x-operators": [
                                        "gt",
                                        "gte",
                                        "lt",
                                        "lte",
                                        "eq",
                                        "ne",
                                        "neq",
                                        "in",
                                        "nin",
                                        "exists"
                                    ]
                                }
                            ]
                        }
                    },
                    {
                        "name": "filter[centerId]",
                        "in": "query",
                        "description": "Exact match. A comma-separated list becomes an `IN (...)` match, and an explicit `null` matches rows where the field is unset. Operators: `eq`, `neq`, `ne`, `in`, `nin`, `exists` — e.g. `filter[centerId][eq]=…`, or the JSON form `filter[centerId]={\"eq\":\"…\"}`.",
                        "schema": {
