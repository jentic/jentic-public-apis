                                    "preferredColor": {
                                        "type": [
                                            "string",
                                            "null"
                                        ]
                                    },
                                    "customFields": {
                                        "type": [
                                            "array",
                                            "null"
                                        ]
                                    }
                                },
                                "required": [
                                    "name"
                                ],
                                "additionalProperties": true,
                                "description": "Keys outside this list are dropped before validation rather than rejected. `id`, `created`, `updated`, `deleted` and `deletedAt` are never writable."
                            },
                            "example": {
                                "centerId": 41,
                                "name": "Marcus Oyelaran",
                                "email": "marcus.oyelaran@example.com",
                                "mobile": "96667777",
                                "rosterGroup": "Piano"
                            }
                        }
                    }
                },
                "x-plan-required": "PAID"
            }
        },
        "/staffs/{id}": {
            "get": {
                "operationId": "getStaffsId",
                "tags": [
                    "Staff"
                ],
                "summary": "Get one staff member",
                "description": "**Why you'll use it**\n\nRead a single person's contact details and calendar settings.\n\n**Related records you can pull in** (`?include=`)\n\n- `center` — The centre the person belongs to, as `{id, name}`.",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "description": "Identifier of the record to act on. A record outside the centres your key covers reports `404`, never `403`.",
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "fields[staff]",
                        "in": "query",
                        "description": "Return only these fields, comma separated. `id` is always included whether you ask for it or not. The key is the model's table name, so it is `fields[staff]` for this resource.",
                        "schema": {
                            "type": "string"
                        },
                        "example": "name,email,loginEnabled"
                    },
                    {
                        "name": "include",
                        "in": "query",
                        "description": "Related records to embed in the response, comma separated.",
                        "schema": {
                            "type": "string"
                        },
                        "example": "center"
                    },
                    {
                        "name": "withTrashed",
                        "in": "query",
                        "description": "Include soft-deleted records alongside live ones. PAID plan only — a FREE key is silently given the normal, non-deleted result set instead.",
                        "schema": {
                            "type": "boolean"
                        }
                    },
                    {
                        "name": "onlyTrashed",
                        "in": "query",
                        "description": "Return only soft-deleted records. PAID plan only — a FREE key is silently given the normal, non-deleted result set instead.",
                        "schema": {
                            "type": "boolean"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "The requested record.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/Staff"
                                        },
                                        "meta": {
                                            "$ref": "#/components/schemas/Meta"
                                        }
                                    },
                                    "required": [
                                        "data",
                                        "meta"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFound"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationFailed"
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    },
                    "500": {
                        "$ref": "#/components/responses/ServerError"
                    }
                }
            },
            "patch": {
                "operationId": "patchStaffsId",
                "tags": [
                    "Staff"
                ],
                "summary": "Update a staff member",
                "description": "**Why you'll use it**\n\nKeep contact details, roster group and timetable colour in step with your own records.\n\n**Before you send**\n\nSign-in fields stay off-limits on update too.\n\n**Plan**\n\nPAID plan only — a FREE key has no write scope for this resource, so the request is rejected with `403 This API is not included in the current subscription plan.` before it reaches the controller.\n\n`PUT` is accepted as an equivalent alias for `PATCH` on this path.\n\nAn update never moves a record between centres: `centerId` is dropped before anything is written. You may still send it, but it has to match the centre the record is already in — a different one is rejected with `403`.",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "description": "Identifier of the record to act on. A record outside the centres your key covers reports `404`, never `403`.",
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "The requested record.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/Staff"
                                        },
                                        "meta": {
                                            "$ref": "#/components/schemas/Meta"
                                        }
                                    },
                                    "required": [
                                        "data",
                                        "meta"
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFound"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationFailed"
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    },
                    "500": {
                        "$ref": "#/components/responses/ServerError"
                    }
                },
                "requestBody": {
                    "required": false,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "description": "Optional — omit it to leave the stored value alone."
                                    },
                                    "email": {
                                        "type": [
                                            "string",
                                            "null"
                                        ],
                                        "format": "email"
                                    },
                                    "fullName": {
                                        "type": [
                                            "string",
                                            "null"
                                        ]
                                    },
                                    "localName": {
                                        "type": [
                                            "string",
                                            "null"
                                        ]
                                    },
                                    "citizenId": {
                                        "type": [
                                            "string",
                                            "null"
                                        ]
                                    },
                                    "gender": {
                                        "type": [
                                            "string",
                                            "null"
                                        ]
                                    },
                                    "locale": {
                                        "type": [
                                            "string",
                                            "null"
                                        ]
                                    },
                                    "detail": {
                                        "type": [
                                            "string",
                                            "null"
                                        ]
                                    },
                                    "remark": {
                                        "type": [
                                            "string",
                                            "null"
                                        ]
                                    },
                                    "phone": {
                                        "type": [
                                            "string",
                                            "null"
                                        ]
                                    },
                                    "mobile": {
                                        "type": [
                                            "string",
                                            "null"
                                        ]
                                    },
                                    "calendarId": {
                                        "type": [
                                            "string",
                                            "null"
                                        ]
                                    },
                                    "shareCalendarId": {
                                        "type": [
                                            "string",
                                            "null"
                                        ]
                                    },
                                    "number": {
                                        "type": [
                                            "string",
                                            "null"
                                        ]
                                    },
                                    "rosterGroup": {
                                        "type": [
                                            "string",
                                            "null"
                                        ]
                                    },
                                    "centerId": {
                                        "type": "integer",
                                        "minimum": 1,
                                        "description": "Defaults to the centre bound to the API key. A supplied value must match the bound centre. Optional — omit it to leave the stored value alone."
                                    },
                                    "preferredColor": {
                                        "type": [
                                            "string",
                                            "null"
                                        ]
                                    },
                                    "customFields": {
                                        "type": [
                                            "array",
                                            "null"
                                        ]
                                    }
                                },
                                "additionalProperties": true,
                                "description": "Keys outside this list are dropped before validation rather than rejected. `id`, `created`, `updated`, `deleted` and `deletedAt` are never writable."
                            },
                            "example": {
                                "mobile": "96667788",
                                "rosterGroup": "Piano & Theory"
                            }
                        }
                    }
                },
                "x-plan-required": "PAID"
            }
        }
    },
    "components": {
        "securitySchemes": {
            "ApiKeyAuth": {
                "type": "apiKey",
                "in": "header",
                "name": "X-Api-Key",
                "description": "Create a key under **Settings → Integration → API access** and send it on every request as `X-Api-Key`. A key is bound to one organisation and one centre at creation time; that binding cannot be changed by the request. An unknown or revoked key returns `401 {\"message\":\"Unauthorized\"}`, and a key whose plan does not include the endpoint returns `403 {\"message\":\"This API is not included in the current subscription plan.\"}`."
            }
        },
        "schemas": {
            "Meta": {
                "type": "object",
                "description": "Accompanies every successful response.",
                "properties": {
                    "message": {
                        "type": "string",
                        "description": "Short status word — `OK`, `Created`, `Updated`, `Cancelled`, `Voided`, `Deleted`."
                    },
                    "apiVersion": {
                        "type": "string",
                        "const": "v1"
                    },
                    "timestamp": {
                        "type": "string",
                        "format": "date-time",
                        "description": "When the server built the response, ISO 8601."
                    }
                },
                "required": [
                    "apiVersion",
                    "timestamp"
                ]
            },
            "PaginationMeta": {
                "type": "object",
                "description": "The meta block on a list endpoint. Note it carries no `message` — that key appears only on single-record responses.",
                "properties": {
                    "currentPage": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "description": "The page you are on."
                    },
                    "from": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "description": "Index of the first record on this page, 1-based."
                    },
                    "lastPage": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "description": "Total number of pages for the query."
                    },
                    "perPage": {
                        "type": "integer",
                        "description": "Records per page actually used."
                    },
                    "to": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "description": "Index of the last record on this page."
                    },
                    "total": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "description": "Total matching records across all pages."
                    },
                    "links": {
                        "type": "object",
                        "description": "Ready-made URLs for the surrounding pages. `prev` and `next` are `null` at the ends.",
                        "properties": {
                            "first": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "format": "uri"
                            },
                            "last": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "format": "uri"
                            },
                            "prev": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "format": "uri"
                            },
                            "next": {
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "format": "uri"
                            }
                        }
                    },
                    "apiVersion": {
                        "type": "string",
                        "const": "v1"
                    },
                    "timestamp": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "required": [
                    "perPage",
                    "links",
                    "apiVersion",
                    "timestamp"
                ]
            },
            "Error": {
                "type": "object",
                "description": "The error envelope returned by the controllers.",
                "properties": {
                    "status": {
                        "type": "string",
                        "const": "error"
                    },
                    "message": {
                        "type": "string",
                        "description": "A sentence you can show to a person."
                    },
                    "errors": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        "description": "Field name => list of problems. Populated on `422`, empty otherwise."
                    }
                },
                "required": [
                    "status",
                    "message"
                ]
            },
            "MiddlewareError": {
                "type": "object",
                "description": "The shorter envelope used by the auth and rate-limit middleware, which run before any controller. It has no `status` or `errors` key — do not assume every failure looks like `Error`.",
                "properties": {
                    "message": {
                        "type": "string"
                    }
                },
                "required": [
                    "message"
                ]
            },
            "RateLimitError": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string"
                    },
                    "retry_after": {
                        "type": "integer",
                        "description": "Seconds until the window resets. Also sent as the `Retry-After` header."
                    },
                    "limit": {
                        "type": "integer",
                        "description": "The ceiling you hit."
                    },
                    "window": {
                        "type": "string",
                        "description": "Which budget ran out: `minute`, `day`, `month`, `app-minute`, `write-minute`, `historical-pull` or `concurrent`."
                    }
                },
                "required": [
                    "message"
                ]
            },
            "ConfirmationRequired": {
                "type": "object",
                "description": "A sales action stopped to warn you about something. Re-send the identical request with `confirmed: {\"<kind>\": true}` to go ahead anyway.",
                "properties": {
                    "confirm": {
                        "description": "What needs confirming, and the key to acknowledge it under."
                    },
                    "message": {
                        "type": "string"
                    }
                },
                "required": [
                    "confirm",
                    "message"
                ]
            },
            "Activity": {
                "type": "object",
                "description": "A lesson is one dated, timed session of a course — the thing that appears on a timetable. Attendance and make-up status live on each lesson, per student.",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "centerId": {
                        "type": [
                            "integer",
                            "null"
                        ]
                    },
                    "nextId": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "description": "The following lesson in a repeating series, if there is one."
                    },
                    "category": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "description": "The first level of the course name, copied onto the lesson when it is created."
                    },
                    "name": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "level": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "description": "The third level of the course name, copied onto the lesson."
                    },
                    "date": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date",
                        "description": "The lesson date, in `YYYY-MM-DD` format, for example `2026-03-17`. Combine it with `startTime` and `endTime` to place the session on the timetable."
                    },
                    "startDate": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date",
                        "description": "The start of the repeating series, in `YYYY-MM-DD` format."
                    },
                    "endDate": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date",
                        "description": "The end of the repeating series, in `YYYY-MM-DD` format."
                    },
                    "startTime": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "description": "Lesson start time without a timezone offset, in `HH:mm` or `HH:mm:ss` format, for example `16:30` or `16:30:00` (4:30 pm). Hours must be `00`–`23`; minutes and seconds must be `00`–`59`. Both forms are accepted on create and update; responses return the stored value. Interpret it together with `date` as a timetable time."
                    },
                    "endTime": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "description": "Lesson end time without a timezone offset, in `HH:mm` or `HH:mm:ss` format, for example `17:30` or `17:30:00`. Both forms are accepted on create and update; responses return the stored value. Hours can exceed 23 for an overnight lesson: `25:30:00` means 1:30 am on the day after `date`. When creating a lesson, the latest permitted value is `32:00` or `32:00:00` (8:00 am next day)."
                    },
                    "color": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "classId": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "description": "Groups a repeating series together. Every lesson generated from the same schedule shares it."
                    },
                    "number": {
                        "type": [
                            "number",
                            "null"
                        ]
                    },
                    "quota": {
                        "type": [
                            "number",
                            "null"
                        ],
                        "description": "How many students the lesson can take."
                    },
                    "enrolled": {
                        "type": [
                            "number",
                            "null"
                        ],
                        "description": "How many are currently booked in."
                    },
                    "detail": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "remark": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "moreInfo": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "description": "Free-form notes shown to students."
                    },
                    "created": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    },
                    "updated": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    },
                    "deleted": {
                        "type": "boolean"
                    },
                    "attendance": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "description": "Matches lessons where **any** booked student carries this attendance code. Combine with `filter[customerId]` to ask about one student. Returned for convenience, but not something you can filter, sort or select on."
                    },
                    "attendanceUpdated": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time",
                        "description": "When that attendance was last set, as an ISO 8601 timestamp with a timezone offset, for example `2026-03-17T08:31:02+00:00`. Present only alongside `attendance`. Returned for convenience, but not something you can filter, sort or select on."
                    },
                    "pendingMakeup": {
                        "type": "boolean",
                        "description": "Lessons a student skipped and has not yet rebooked. Returned for convenience, but not something you can filter, sort or select on."
                    },
                    "makeUpToActivityIds": {
                        "type": "array",
                        "description": "The lessons a skipped session was made up into. Present only when scoped to one student. Returned for convenience, but not something you can filter, sort or select on."
                    },
                    "customers": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "integer"
                                },
                                "name": {
                                    "type": [
                                        "string",
                                        "null"
                                    ]
                                },
                                "orderItemId": {
                                    "type": [
                                        "integer",
                                        "null"
                                    ]
                                },
                                "makeUpToActivityIds": {
                                    "type": "array"
                                },
                                "status": {
                                    "type": [
                                        "string",
                                        "null"
                                    ]
                                },
                                "pendingMakeup": {
                                    "type": "boolean"
                                },
                                "attendance": {
                                    "type": [
                                        "string",
                                        "null"
                                    ]
                                },
                                "attendanceUpdated": {
                                    "type": [
                                        "string",
                                        "null"
                                    ],
                                    "format": "date-time"
                                },
                                "receivables": {
                                    "type": [
                                        "string",
                                        "null"
                                    ]
                                },
                                "paid": {
                                    "type": [
                                        "string",
                                        "null"
                                    ]
                                },
                                "remark": {
                                    "type": [
                                        "string",
                                        "null"
                                    ]
                                },
                                "extRemark": {
                                    "type": [
                                        "string",
                                        "null"
                                    ]
                                }
                            }
                        },
                        "description": "Every student booked into the lesson, with their attendance, payment and make-up state. A booking's `status` is one of `W` weekly, `B` fortnightly, `T` single, `M` make-up, `S` skipped, `J` just-skipped, `N` normal, `Q` quit, `D` quit and moved up, `I` temporarily quit. Always present — this one is loaded on every request, so you do not need to ask for it."
                    },
                    "staffs": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "integer"
                                },
                                "name": {
                                    "type": [
                                        "string",
                                        "null"
                                    ]
                                }
                            }
                        },
                        "description": "The teachers assigned to the lesson. Present only when you ask for it with `?include=staffs`."
                    },
                    "facilities": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "integer"
                                },
                                "name": {
                                    "type": [
                                        "string",
                                        "null"
                                    ]
                                }
                            }
                        },
                        "description": "The rooms or resources booked for it. Present only when you ask for it with `?include=facilities`."
                    },
                    "center": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "integer"
                            },
                            "name": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            }
                        },
                        "description": "The centre the lesson belongs to, as `{id, name}`. Present only when you ask for it with `?include=center`."
                    }
                }
            },
            "Center": {
                "type": "object",
                "description": "The branches your key can see. Read-only — centres are set up in SchoolTracs itself.",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "displayName": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "description": "The name shown to students and on printed documents, where it differs from the internal one."
                    },
                    "address": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "created": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    },
                    "updated": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    },
                    "deleted": {
                        "type": "boolean"
                    }
                }
            },
            "Course": {
                "type": "object",
                "description": "A course is the template a timetable is generated from: what it is called, how long each lesson runs, how many students fit, and when it runs between.",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "centerId": {
                        "type": [
                            "integer",
                            "null"
                        ]
                    },
                    "category": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "description": "The first of the three name levels — typically the subject, e.g. `Piano`."
                    },
                    "name": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "description": "The second name level, e.g. `Grade 3`."
                    },
                    "level": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "description": "The third name level, e.g. `Intermediate`. All three together are what staff see as the course name."
                    },
                    "bookableStaffIds": {
                        "type": "array",
                        "description": "Restricts booking to specific teachers. Leaving it empty makes the course a regular group course."
                    },
                    "canCustomerRead": {
                        "type": "boolean",
                        "description": "Whether students can see the course in the student app and online store."
                    },
                    "rank": {
                        "type": [
