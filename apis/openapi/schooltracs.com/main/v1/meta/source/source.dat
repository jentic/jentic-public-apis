        "/enrollments": {
            "get": {
                "operationId": "getEnrollments",
                "tags": [
                    "Enrolments"
                ],
                "summary": "List enrolments",
                "description": "**Why you'll use it**\n\nAnswer \"who is on this course\", \"what has this student signed up for\", and \"which enrolments still owe money\" without stitching together lessons and invoices yourself.\n\n**Before you send**\n\n`filter[active]` is the important one here, and it is not an ordinary field filter:\n\n- `filter[active]=true` keeps only enrolments with a booked lesson today or later;\n- `filter[active]=false` keeps only those with none left — finished or dropped;\n- omitting it returns both.\n\nOn a **FREE** key that choice is made for you: you always get active enrolments only, whatever you ask for. On **PAID**, `filter[billDate]` and `filter[created]` ranges may look back at most 3 years and span at most a year.\n\n**Example queries**\n\n- `?filter[customerId]=9101&filter[active]=true`  \n  What this student is currently enrolled in.\n- `?filter[feeId]=4410&filter[active]=true`  \n  Everyone currently signed up on one fee — a class roster by billing rather than by timetable.\n- `?filter[paid]=0&filter[active]=true&sort=billDate`  \n  Live enrolments with nothing paid against them yet, oldest first.\n- `?filter[active]=false&filter[endDate][gte]=2026-01-01`  \n  Enrolments that finished this year — a re-enrolment call list.",
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Page number, starting at 1. How deep you may page is capped by your plan — 5 pages on FREE and 200 on PAID, independent of page size. Going past the cap is a `422`, not an empty page.",
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "default": 1
                        }
                    },
                    {
                        "name": "pageSize",
                        "in": "query",
                        "description": "Records per page. Defaults to 50, with a hard ceiling of 500 and a plan ceiling of 50 on FREE / 500 on PAID. Asking for more than your plan allows returns `422` — it is never silently clamped.",
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "default": 50
                        }
                    },
                    {
                        "name": "perPage",
                        "in": "query",
                        "description": "Alias for `pageSize`. If both are sent, `pageSize` wins.",
                        "schema": {
                            "type": "integer",
                            "minimum": 1
                        }
                    },
                    {
                        "name": "sort",
                        "in": "query",
                        "description": "Sort by one or more fields, comma separated. Prefix a field with `-` to sort descending (`sort=-created,name`). Sorting by anything outside the list below is rejected.",
                        "schema": {
                            "type": "string",
                            "x-allowed-fields": [
                                "id",
                                "centerId",
                                "customerId",
                                "feeId",
                                "startDate",
                                "endDate",
                                "total",
                                "paid",
                                "scheduled",
                                "quota",
                                "quotaUnit",
                                "billDate",
                                "created",
                                "updated",
                                "deleted"
                            ]
                        },
                        "example": "-created"
                    },
                    {
                        "name": "fields[order_item]",
                        "in": "query",
                        "description": "Return only these fields, comma separated. `id` is always included whether you ask for it or not. The key is the model's table name, so it is `fields[order_item]` for this resource.",
                        "schema": {
                            "type": "string"
                        },
                        "example": "orderId,centerId,customerId"
                    },
                    {
                        "name": "filter[active]",
                        "in": "query",
                        "description": "Derived: true when at least one still-booked lesson is today or later. Also usable as a filter, where it switches the query between current and finished enrolments. A flag, not a field match — see the endpoint description for what it switches on.",
                        "schema": {
                            "oneOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "object",
                                    "additionalProperties": true,
                                    "x-operators": []
                                }
                            ]
                        }
                    },
                    {
                        "name": "filter[billDate]",
                        "in": "query",
                        "description": "The date the order was billed on. Matches that calendar date. A comma-separated list matches any of the dates. Operators: `gt`, `gte`, `lt`, `lte`, `eq`, `ne`, `neq`, `in`, `nin`, `exists` — e.g. `filter[billDate][gte]=…`, or the JSON form `filter[billDate]={\"gte\":\"…\"}`.",
                        "schema": {
                            "oneOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "object",
                                    "additionalProperties": true,
                                    "x-operators": [
                                        "gt",
                                        "gte",
                                        "lt",
                                        "lte",
                                        "eq",
                                        "ne",
                                        "neq",
                                        "in",
                                        "nin",
                                        "exists"
                                    ]
                                }
                            ]
                        }
                    },
                    {
                        "name": "filter[centerId]",
                        "in": "query",
                        "description": "Exact match. A comma-separated list becomes an `IN (...)` match, and an explicit `null` matches rows where the field is unset. Operators: `eq`, `neq`, `ne`, `in`, `nin`, `exists` — e.g. `filter[centerId][eq]=…`, or the JSON form `filter[centerId]={\"eq\":\"…\"}`.",
                        "schema": {
                            "oneOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "object",
                                    "additionalProperties": true,
                                    "x-operators": [
                                        "eq",
                                        "neq",
                                        "ne",
                                        "in",
                                        "nin",
                                        "exists"
                                    ]
                                }
                            ]
                        }
                    },
                    {
                        "name": "filter[created]",
                        "in": "query",
                        "description": "Matches that calendar date. A comma-separated list matches any of the dates. Operators: `gt`, `gte`, `lt`, `lte`, `eq`, `ne`, `neq`, `in`, `nin`, `exists` — e.g. `filter[created][gte]=…`, or the JSON form `filter[created]={\"gte\":\"…\"}`.",
                        "schema": {
                            "oneOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "object",
                                    "additionalProperties": true,
                                    "x-operators": [
                                        "gt",
                                        "gte",
                                        "lt",
                                        "lte",
                                        "eq",
                                        "ne",
                                        "neq",
                                        "in",
                                        "nin",
                                        "exists"
                                    ]
                                }
                            ]
                        }
                    },
                    {
                        "name": "filter[customerId]",
                        "in": "query",
                        "description": "Exact match. A comma-separated list becomes an `IN (...)` match, and an explicit `null` matches rows where the field is unset. Operators: `eq`, `neq`, `ne`, `in`, `nin`, `exists` — e.g. `filter[customerId][eq]=…`, or the JSON form `filter[customerId]={\"eq\":\"…\"}`.",
                        "schema": {
                            "oneOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "object",
                                    "additionalProperties": true,
                                    "x-operators": [
                                        "eq",
                                        "neq",
                                        "ne",
                                        "in",
                                        "nin",
                                        "exists"
                                    ]
                                }
                            ]
                        }
                    },
                    {
                        "name": "filter[deleted]",
                        "in": "query",
                        "description": "Exact match. A comma-separated list becomes an `IN (...)` match, and an explicit `null` matches rows where the field is unset. Operators: `eq`, `neq`, `ne`, `in`, `nin`, `exists` — e.g. `filter[deleted][eq]=…`, or the JSON form `filter[deleted]={\"eq\":\"…\"}`.",
                        "schema": {
                            "oneOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "object",
                                    "additionalProperties": true,
                                    "x-operators": [
                                        "eq",
                                        "neq",
                                        "ne",
                                        "in",
                                        "nin",
                                        "exists"
                                    ]
                                }
                            ]
                        }
                    },
                    {
                        "name": "filter[endDate]",
                        "in": "query",
                        "description": "The order's own billing period end. Stored and writable, unlike `lastDate`. Matches that calendar date. A comma-separated list matches any of the dates. Operators: `gt`, `gte`, `lt`, `lte`, `eq`, `ne`, `neq`, `in`, `nin`, `exists` — e.g. `filter[endDate][gte]=…`, or the JSON form `filter[endDate]={\"gte\":\"…\"}`.",
                        "schema": {
                            "oneOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "object",
                                    "additionalProperties": true,
                                    "x-operators": [
                                        "gt",
                                        "gte",
                                        "lt",
                                        "lte",
                                        "eq",
                                        "ne",
                                        "neq",
                                        "in",
                                        "nin",
                                        "exists"
                                    ]
                                }
                            ]
                        }
                    },
                    {
                        "name": "filter[feeId]",
                        "in": "query",
                        "description": "Exact match. A comma-separated list becomes an `IN (...)` match, and an explicit `null` matches rows where the field is unset. Operators: `eq`, `neq`, `ne`, `in`, `nin`, `exists` — e.g. `filter[feeId][eq]=…`, or the JSON form `filter[feeId]={\"eq\":\"…\"}`.",
