          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Endpoint updated"
          }
        }
      },
      "delete": {
        "operationId": "deleteEndpoint",
        "summary": "Delete Serverless Endpoint",
