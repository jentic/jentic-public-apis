{
  "openapi": "3.0.3",
  "info": {
    "title": "Vast.ai API",
    "description": "GPU marketplace REST API. Manage GPU instances, search for offers, manage billing, volumes, serverless endpoints, teams, and machine hosting on the Vast.ai platform.",
    "version": "0.1.0",
    "x-jentic-source-url": "https://vast.ai/docs/rest-api",
    "x-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://console.vast.ai",
      "description": "Vast.ai Production API"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/v0/auth/apikeys/": {
      "post": {
        "operationId": "createApiKey",
        "summary": "Create API Key",
        "description": "Create a new API key with specified permissions.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Name for the API key"
                  },
                  "permissions": {
                    "type": "object",
                    "description": "Permission settings for the key"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "API key created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "showApiKeys",
        "summary": "Show API Keys",
        "description": "List all API keys for the account.",
        "responses": {
          "200": {
            "description": "List of API keys",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/v0/auth/apikeys/{key_id}/": {
      "delete": {
        "operationId": "deleteApiKey",
        "summary": "Delete API Key",
        "description": "Delete an API key.",
        "parameters": [
          {
            "name": "key_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "API key deleted"
          }
        }
      }
    },
    "/api/v0/users/current/": {
      "get": {
        "operationId": "showUser",
        "summary": "Show User",
        "description": "Get current user account information.",
        "responses": {
          "200": {
            "description": "User details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "setUser",
        "summary": "Set User",
        "description": "Update current user account settings.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User updated"
          }
        }
      }
    },
    "/api/v0/bundles/": {
      "get": {
        "operationId": "searchOffers",
        "summary": "Search Offers",
        "description": "Search for available GPU rental offers with filtering criteria.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Search query with filter expressions"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Maximum number of results"
          },
          {
            "name": "order",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Sort order field"
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["on-demand", "interruptible", "bid"]
            },
            "description": "Rental type filter"
          }
        ],
        "responses": {
          "200": {
            "description": "List of matching offers",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "offers": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v0/asks/{id}/": {
      "put": {
        "operationId": "createInstance",
        "summary": "Create Instance",
        "description": "Create a new GPU instance from an offer.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Offer ID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "image": {
                    "type": "string",
                    "description": "Docker image to use"
                  },
                  "disk": {
                    "type": "number",
                    "description": "Disk space in GB"
                  },
                  "onstart": {
                    "type": "string",
                    "description": "Startup script"
                  },
                  "env": {
                    "type": "object",
                    "description": "Environment variables"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Instance created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/v0/instances/{id}/": {
      "get": {
        "operationId": "showInstance",
        "summary": "Show Instance",
        "description": "Get details of a specific instance.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Instance details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "destroyInstance",
        "summary": "Destroy Instance",
        "description": "Permanently destroy an instance.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Instance destroyed"
          }
        }
      },
      "put": {
        "operationId": "manageInstance",
        "summary": "Manage Instance",
        "description": "Start, stop, or manage an instance.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "state": {
                    "type": "string",
                    "enum": ["running", "stopped"],
                    "description": "Desired instance state"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Instance state changed"
          }
        }
      }
    },
    "/api/v0/instances/": {
      "get": {
        "operationId": "showInstances",
        "summary": "Show Instances",
        "description": "List all instances for the account.",
        "responses": {
          "200": {
            "description": "List of instances",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "instances": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v0/instances/{id}/reboot/": {
      "put": {
        "operationId": "rebootInstance",
        "summary": "Reboot Instance",
        "description": "Reboot a running instance.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Instance rebooting"
          }
        }
      }
    },
    "/api/v0/instances/bid_price/{id}/": {
      "put": {
        "operationId": "changeBid",
        "summary": "Change Bid",
        "description": "Change the bid price for an interruptible instance.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "price": {
                    "type": "number",
                    "description": "New bid price per hour"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bid updated"
          }
        }
      }
    },
    "/api/v0/instances/{id}/ssh/": {
      "post": {
        "operationId": "attachSshKey",
        "summary": "Attach SSH Key",
        "description": "Attach an SSH key to an instance.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "ssh_key_id": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "SSH key attached"
          }
        }
      }
    },
    "/api/v0/ssh/": {
      "post": {
        "operationId": "createSshKey",
        "summary": "Create SSH Key",
        "description": "Add a new SSH public key to the account.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "ssh_key": {
                    "type": "string",
                    "description": "SSH public key content"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "SSH key created"
          }
        }
      },
      "get": {
        "operationId": "showSshKeys",
        "summary": "Show SSH Keys",
        "description": "List all SSH keys for the account.",
        "responses": {
          "200": {
            "description": "List of SSH keys",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/v0/ssh/{key_id}/": {
      "delete": {
        "operationId": "deleteSshKey",
        "summary": "Delete SSH Key",
        "description": "Delete an SSH key from the account.",
        "parameters": [
          {
            "name": "key_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "SSH key deleted"
          }
        }
      }
    },
    "/api/v0/secrets/": {
      "post": {
        "operationId": "createEnvVar",
        "summary": "Create Environment Variable",
        "description": "Create a new secret environment variable.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string"
                  }
                },
                "required": ["name", "value"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Environment variable created"
          }
        }
      },
      "get": {
        "operationId": "showEnvVars",
        "summary": "Show Environment Variables",
        "description": "List all secret environment variables.",
        "responses": {
          "200": {
            "description": "List of environment variables",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "updateEnvVar",
        "summary": "Update Environment Variable",
        "description": "Update an existing environment variable.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Environment variable updated"
          }
        }
      },
      "delete": {
        "operationId": "deleteEnvVar",
        "summary": "Delete Environment Variable",
        "description": "Delete a secret environment variable.",
        "responses": {
          "200": {
            "description": "Environment variable deleted"
          }
        }
      }
    },
    "/api/v0/machines/": {
      "get": {
        "operationId": "showMachines",
        "summary": "Show Machines",
        "description": "List all machines for the hosting account.",
        "responses": {
          "200": {
            "description": "List of machines",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/v0/machines/{machine_id}/list/": {
      "post": {
        "operationId": "listMachine",
        "summary": "List Machine",
        "description": "List a machine for rental on the marketplace.",
        "parameters": [
          {
            "name": "machine_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Machine listed"
          }
        }
      }
    },
    "/api/v0/machines/{machine_id}/unlist/": {
      "post": {
        "operationId": "unlistMachine",
        "summary": "Unlist Machine",
        "description": "Remove a machine from the rental marketplace.",
        "parameters": [
          {
            "name": "machine_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Machine unlisted"
          }
        }
      }
    },
    "/api/v0/endptjobs/": {
      "post": {
        "operationId": "createEndpoint",
        "summary": "Create Serverless Endpoint",
        "description": "Create a new serverless endpoint.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Endpoint created"
          }
        }
      },
      "get": {
        "operationId": "showEndpoints",
        "summary": "Show Serverless Endpoints",
        "description": "List all serverless endpoints.",
        "responses": {
          "200": {
            "description": "List of endpoints",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/v0/endptjobs/{id}/": {
      "put": {
        "operationId": "updateEndpoint",
        "summary": "Update Serverless Endpoint",
        "description": "Update a serverless endpoint configuration.",
