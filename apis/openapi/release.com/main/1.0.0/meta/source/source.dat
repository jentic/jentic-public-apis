    "/apps/{app_id}/builds": {
      "get": {
        "tags": [
          "Builds"
        ],
        "summary": "List Builds",
        "operationId": "builds_index",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BuildIndex"
                }
