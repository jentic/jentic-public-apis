                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid request."
          },
          "401": {
            "description": "Missing or invalid API key."
          },
          "403": {
            "description": "Authenticated identity is not allowed to perform this action."
          },
          "429": {
            "description": "Capacity or fairness limit reached; follow Retry-After when present."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "marrowApiKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "MARROW_API_KEY",
        "description": "A named Marrow agent API key. Dashboard sessions are not accepted."
      },
      "marrowDashboardSession": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "MARROW_DASHBOARD_SESSION",
        "description": "A short-lived dashboard session accepted only for coordination_owner_approval on the runtime route."
      }
    }
  },
  "security": [
    {
      "marrowApiKey": []
    }
  ]
}
