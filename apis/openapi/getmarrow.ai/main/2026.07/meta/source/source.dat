    "/v1/agent/commit": {
      "post": {
        "operationId": "commitAgentOutcome",
        "summary": "Close a governed action with outcome and proof evidence.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "required": [
                  "decision_id",
                  "success",
                  "outcome"
                ],
                "properties": {
                  "decision_id": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "success": {
                    "type": "boolean"
                  },
                  "outcome": {
                    "type": "string",
                    "maxLength": 20000
                  },
                  "gate_receipt_id": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "arbitration_receipt_id": {
                    "type": "string",
                    "maxLength": 128,
                    "description": "Required when the decision was created by coordination arbitration."
                  },
                  "owner_approval_receipt_id": {
                    "type": "string",
                    "maxLength": 128,
                    "description": "Required for review_required arbitration; short-lived and consumed once."
                  },
                  "proof": {
                    "type": "object",
                    "additionalProperties": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful tenant-scoped response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "202": {
            "description": "Successful tenant-scoped response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid request."
          },
          "401": {
            "description": "Missing or invalid API key."
          },
          "403": {
            "description": "Authenticated identity is not allowed to perform this action."
          },
          "429": {
            "description": "Capacity or fairness limit reached; follow Retry-After when present."
          }
        }
      }
    },
    "/v1/agent/enforcement": {
      "get": {
        "operationId": "getActionEnforcementCoverage",
        "summary": "Read tenant-scoped action-permit closure, bypass, sidecar, hook, and configuration-drift coverage.",
        "parameters": [
          {
            "name": "agent_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 128
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful tenant-scoped response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid request."
          },
          "401": {
            "description": "Missing or invalid API key."
          },
          "403": {
            "description": "Authenticated identity is not allowed to perform this action."
          },
          "429": {
            "description": "Capacity or fairness limit reached; follow Retry-After when present."
          }
        }
      },
      "post": {
        "operationId": "controlActionPermit",
        "summary": "Issue, verify, close, or heartbeat a signed permit for one governed action.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "operation",
                  "agent_id",
                  "session_id"
                ],
                "properties": {
                  "operation": {
                    "type": "string",
                    "enum": [
                      "issue",
                      "verify",
                      "close",
                      "heartbeat"
                    ]
                  },
                  "agent_id": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "session_id": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "harness": {
                    "type": "string",
                    "maxLength": 64
                  },
                  "action": {
                    "type": "string",
                    "maxLength": 16384
                  },
                  "action_type": {
                    "type": "string",
                    "maxLength": 64
                  },
                  "target": {
                    "type": "string",
                    "maxLength": 16384
                  },
                  "surfaces": {
                    "type": "array",
                    "maxItems": 16,
                    "description": "Canonical action surfaces. Verify must send the same set used to issue the permit; ordering is normalized and duplicates are rejected.",
                    "items": {
                      "type": "string",
                      "maxLength": 80
                    }
                  },
                  "proof_requirements": {
                    "type": "array",
                    "maxItems": 16,
                    "description": "Exact server-required proof field names; broad proof categories do not satisfy these fields.",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]{0,79}$"
                    }
                  },
                  "decision_id": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "gate_receipt_id": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "owner_approval_receipt_id": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "permit": {
                    "type": "string",
                    "maxLength": 4096,
                    "writeOnly": true
                  },
                  "permit_id": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "success": {
                    "type": "boolean"
                  },
                  "evidence": {
                    "type": "object",
                    "description": "Exact proof-field map. Every required field needs a non-empty validated value; an empty blockers array is allowed when blockers is required.",
                    "additionalProperties": true
                  },
                  "expected_hooks": {
                    "type": "array",
                    "maxItems": 3,
                    "items": {
                      "type": "string"
                    }
                  },
                  "observed_hooks": {
                    "type": "array",
                    "maxItems": 3,
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful tenant-scoped response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid request."
          },
          "401": {
            "description": "Missing or invalid API key."
          },
          "403": {
            "description": "Authenticated identity is not allowed to perform this action."
          },
          "429": {
            "description": "Capacity or fairness limit reached; follow Retry-After when present."
          }
        }
      }
    },
    "/v1/agent/report": {
      "get": {
        "operationId": "getAgentValueReport",
        "summary": "Read tenant-scoped reliability, proof, outcome, and value metrics.",
        "responses": {
          "200": {
            "description": "Successful tenant-scoped response.",
            "content": {
