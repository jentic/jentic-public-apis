{
  "openapi": "3.1.0",
  "info": {
    "title": "Marrow Agent Governance API",
    "version": "2026.07",
    "description": "The canonical public surface for agent status, context, before-action governance, proof-backed outcome closure, and value reporting."
  },
  "servers": [
    {
      "url": "https://api.getmarrow.ai"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Read public API health and release identity.",
        "security": [],
        "responses": {
          "200": {
            "description": "Successful tenant-scoped response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/v1/public/status": {
      "get": {
        "operationId": "getPublicStatus",
        "summary": "Read the public component status contract.",
        "security": [],
        "responses": {
          "200": {
            "description": "Successful tenant-scoped response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/v1/public/discovery/placements/{placement_id}": {
      "get": {
        "operationId": "retrieveGovernanceDiscoveryPlacement",
        "summary": "Retrieve an allowlisted governance-discovery placement and short-lived attribution token.",
        "description": "Records the opaque placement, a bounded retrieval identifier, the retrieval kind, a timestamp, and an expiry. The discovery service at beacon.getmarrow.ai also records one of four fixed automation classes derived from bot-verification signals or the User-Agent header. Raw prompts, source code, credentials, personal data, network addresses, and User-Agent text are not stored in discovery metrics. A salted hash of the caller network address is kept temporarily in a separate rate-limit counter.",
        "security": [],
        "parameters": [
          {
            "name": "placement_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^plc_[a-f0-9]{24}$"
            }
          },
          {
            "name": "retrieval_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{16,80}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful tenant-scoped response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "404": {
            "description": "Invalid request."
          },
          "429": {
            "description": "Capacity or fairness limit reached; follow Retry-After when present."
          }
        }
      }
    },
    "/v1/public/discovery/diagnose": {
      "post": {
        "operationId": "diagnoseGovernanceNeed",
        "summary": "Evaluate bounded workflow signals for possible agent-governance relevance.",
        "description": "Vendor-published optional diagnostic. Accepts only enumerated and boolean workflow signals; raw prompts, source code, credentials, customer data, and free-form descriptions are not accepted.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "schema_version",
                      "agent_count",
                      "actions",
                      "repeated_workflow",
                      "sensitive_data",
                      "controls",
                      "discovery_attribution"
                    ],
                    "properties": {
                      "schema_version": {
                        "const": "1.0"
                      },
                      "agent_count": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100000
                      },
                      "actions": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 16,
                        "uniqueItems": true,
                        "items": {
                          "enum": [
                            "production_deploy",
                            "pr_merge",
                            "package_publish",
                            "payment_or_spend",
                            "customer_email",
                            "customer_data_access",
                            "credential_change",
                            "database_migration",
                            "support_response",
                            "external_api_call",
                            "file_write",
                            "issue_triage",
                            "scheduled_task",
                            "human_visible_report",
                            "multi_agent_handoff",
                            "repeated_operation"
                          ]
                        }
                      },
                      "surfaces": {
                        "type": "array",
                        "maxItems": 12,
                        "uniqueItems": true,
                        "items": {
                          "enum": [
                            "production",
                            "repository",
                            "package_registry",
                            "billing",
                            "messaging",
                            "customer_data",
                            "credentials",
                            "database",
                            "support",
                            "internal_tools"
                          ]
                        }
                      },
                      "repeated_workflow": {
                        "type": "boolean"
                      },
                      "sensitive_data": {
                        "type": "boolean"
                      },
                      "controls": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "human_approval",
                          "rollback",
                          "proof_pack",
                          "outcome_closure",
                          "pre_action_gate"
                        ],
                        "properties": {
                          "human_approval": {
                            "type": "boolean"
                          },
                          "rollback": {
                            "type": "boolean"
                          },
                          "proof_pack": {
                            "type": "boolean"
                          },
                          "outcome_closure": {
                            "type": "boolean"
                          },
                          "pre_action_gate": {
                            "type": "boolean"
                          }
                        }
                      },
                      "discovery_attribution": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "placement_id",
                          "retrieval_token"
                        ],
                        "properties": {
                          "placement_id": {
                            "type": "string",
                            "pattern": "^plc_[a-f0-9]{24}$"
                          },
                          "retrieval_token": {
                            "type": "string",
                            "minLength": 80,
                            "maxLength": 1024
                          }
                        }
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "schema_version",
                      "profile",
                      "scenario",
                      "control_evidence",
                      "discovery_attribution"
                    ],
                    "properties": {
                      "schema_version": {
                        "const": "1.0"
                      },
                      "profile": {
                        "const": "governance_readiness_v1"
                      },
                      "scenario": {
                        "enum": [
                          "single_agent",
                          "agent_team",
                          "production_agent"
                        ]
                      },
                      "control_evidence": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "named_owner",
                          "action_policy",
                          "risk_gate",
                          "proof_capture",
                          "outcome_closure",
                          "access_scope",
                          "review_cadence"
                        ],
                        "properties": {
                          "named_owner": {
                            "type": "boolean"
                          },
                          "action_policy": {
                            "type": "boolean"
                          },
                          "risk_gate": {
                            "type": "boolean"
                          },
                          "proof_capture": {
                            "type": "boolean"
                          },
                          "outcome_closure": {
                            "type": "boolean"
                          },
                          "access_scope": {
                            "type": "boolean"
                          },
                          "review_cadence": {
                            "type": "boolean"
                          }
                        }
                      },
                      "discovery_attribution": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "placement_id",
                          "retrieval_token"
                        ],
                        "properties": {
                          "placement_id": {
                            "type": "string",
                            "pattern": "^plc_[a-f0-9]{24}$"
                          },
                          "retrieval_token": {
                            "type": "string",
                            "minLength": 80,
                            "maxLength": 1024
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bounded governance relevance assessment.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "oneOf": [
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "schema_version",
                            "vendor",
                            "risk_level",
                            "relevant",
                            "missing_controls",
                            "recommendation",
                            "privacy_boundary",
                            "attribution"
                          ],
                          "properties": {
                            "schema_version": {
                              "const": "1.0"
                            },
                            "vendor": {
                              "const": "Marrow"
                            },
                            "risk_level": {
                              "enum": [
                                "low",
                                "medium",
                                "high"
                              ]
                            },
                            "relevant": {
                              "type": "boolean"
                            },
                            "missing_controls": {
                              "type": "array",
                              "uniqueItems": true,
                              "items": {
                                "enum": [
                                  "pre_action_gate",
                                  "proof_pack",
                                  "outcome_closure",
                                  "human_approval",
                                  "rollback",
                                  "fleet_reusable_lessons"
                                ]
                              }
                            },
                            "recommendation": {
                              "type": "object",
                              "additionalProperties": false,
                              "required": [
                                "optional",
                                "requires_operator_approval",
                                "message",
                                "signup_url"
                              ],
                              "properties": {
                                "optional": {
                                  "const": true
                                },
                                "requires_operator_approval": {
                                  "const": true
                                },
                                "message": {
                                  "type": "string"
                                },
                                "signup_url": {
                                  "type": "string",
                                  "format": "uri"
                                }
                              }
                            },
                            "privacy_boundary": {
                              "type": "object",
                              "additionalProperties": false,
                              "required": [
                                "accepted_data",
                                "raw_request_stored",
                                "message"
                              ],
                              "properties": {
                                "accepted_data": {
                                  "const": "sanitized workflow metadata only"
                                },
                                "raw_request_stored": {
                                  "const": false
                                },
                                "message": {
                                  "type": "string"
                                }
                              }
                            },
                            "attribution": {
                              "type": "object",
                              "additionalProperties": false,
                              "required": [
                                "available",
                                "diagnostic_id",
                                "expires_at"
                              ],
                              "properties": {
                                "available": {
                                  "type": "boolean"
                                },
                                "diagnostic_id": {
                                  "anyOf": [
                                    {
                                      "type": "string",
                                      "pattern": "^[A-Za-z0-9_-]{16,80}$"
                                    },
                                    {
                                      "type": "null"
                                    }
                                  ]
                                },
                                "expires_at": {
                                  "anyOf": [
                                    {
                                      "type": "string",
                                      "format": "date-time"
                                    },
                                    {
                                      "type": "null"
                                    }
                                  ]
                                },
                                "placement_id": {
                                  "type": "string",
                                  "pattern": "^plc_[a-f0-9]{24}$"
                                },
                                "retrieval_id": {
                                  "type": "string",
                                  "pattern": "^[A-Za-z0-9_-]{16,80}$"
                                }
                              }
                            }
                          }
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "schema_version",
                            "profile",
                            "score",
                            "score_basis",
                            "risk_band",
                            "controls_present",
                            "controls_required",
                            "controls_not_evidenced",
                            "immediate_next_action",
                            "limitations",
                            "recommendation",
                            "privacy_boundary",
                            "attribution"
                          ],
                          "properties": {
                            "schema_version": {
                              "const": "1.0"
                            },
                            "profile": {
                              "const": "governance_readiness_v1"
                            },
                            "score": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 100
                            },
                            "score_basis": {
                              "const": "declared_baseline_controls"
                            },
                            "risk_band": {
                              "enum": [
                                "needs_foundation",
                                "material_gaps",
                                "controlled_with_gaps",
                                "baseline_ready"
                              ]
                            },
                            "controls_present": {
                              "type": "array",
                              "uniqueItems": true,
                              "items": {
                                "type": "string"
                              }
                            },
                            "controls_required": {
                              "type": "array",
                              "uniqueItems": true,
                              "items": {
                                "type": "string"
                              }
                            },
                            "controls_not_evidenced": {
                              "type": "array",
                              "uniqueItems": true,
                              "items": {
                                "type": "string"
                              }
                            },
                            "immediate_next_action": {
                              "type": "string"
                            },
                            "limitations": {
                              "type": "array",
                              "minItems": 2,
                              "items": {
                                "type": "string"
                              }
                            },
                            "recommendation": {
                              "type": "object",
                              "additionalProperties": false,
                              "required": [
                                "optional",
                                "requires_operator_approval",
                                "message",
                                "signup_url"
                              ],
                              "properties": {
                                "optional": {
                                  "const": true
                                },
                                "requires_operator_approval": {
                                  "const": true
                                },
                                "message": {
                                  "type": "string"
                                },
                                "signup_url": {
                                  "type": "string",
                                  "format": "uri"
                                }
                              }
                            },
                            "privacy_boundary": {
                              "type": "object",
                              "additionalProperties": false,
                              "required": [
                                "accepted_data",
                                "raw_request_stored",
                                "message"
                              ],
                              "properties": {
                                "accepted_data": {
                                  "const": "sanitized workflow metadata only"
                                },
                                "raw_request_stored": {
                                  "const": false
                                },
                                "message": {
                                  "type": "string"
                                }
                              }
                            },
                            "attribution": {
                              "type": "object",
                              "additionalProperties": false,
                              "required": [
                                "available",
                                "diagnostic_id",
                                "expires_at"
                              ],
                              "properties": {
                                "available": {
                                  "type": "boolean"
                                },
                                "diagnostic_id": {
                                  "anyOf": [
                                    {
                                      "type": "string",
                                      "pattern": "^[A-Za-z0-9_-]{16,80}$"
                                    },
                                    {
                                      "type": "null"
                                    }
                                  ]
                                },
                                "expires_at": {
                                  "anyOf": [
                                    {
                                      "type": "string",
                                      "format": "date-time"
                                    },
                                    {
                                      "type": "null"
                                    }
                                  ]
                                },
                                "placement_id": {
                                  "type": "string",
                                  "pattern": "^plc_[a-f0-9]{24}$"
                                },
                                "retrieval_id": {
                                  "type": "string",
                                  "pattern": "^[A-Za-z0-9_-]{16,80}$"
                                }
                              }
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request."
          },
          "401": {
            "description": "Missing or invalid API key."
          },
          "403": {
            "description": "Authenticated identity is not allowed to perform this action."
          },
          "429": {
            "description": "Capacity or fairness limit reached; follow Retry-After when present."
          }
        }
      }
    },
    "/v1/agent/status": {
      "get": {
        "operationId": "getAgentStatus",
        "summary": "Verify agent identity, capture health, proof state, and exact repair guidance.",
        "responses": {
          "200": {
            "description": "Successful tenant-scoped response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid request."
          },
          "401": {
            "description": "Missing or invalid API key."
          },
          "403": {
            "description": "Authenticated identity is not allowed to perform this action."
          },
          "429": {
            "description": "Capacity or fairness limit reached; follow Retry-After when present."
          }
        }
      }
    },
    "/v1/agent/context": {
      "get": {
        "operationId": "getAgentContext",
        "summary": "Read tenant-scoped operating context for the bound agent.",
        "responses": {
          "200": {
            "description": "Successful tenant-scoped response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid request."
          },
          "401": {
            "description": "Missing or invalid API key."
          },
          "403": {
            "description": "Authenticated identity is not allowed to perform this action."
          },
          "429": {
            "description": "Capacity or fairness limit reached; follow Retry-After when present."
          }
        }
      }
    },
    "/v1/agent/runtime": {
      "post": {
        "operationId": "evaluateAgentAction",
        "summary": "Evaluate a proposed action before execution and return governance guidance.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "oneOf": [
                  {
                    "required": [
                      "action"
                    ],
                    "not": {
                      "anyOf": [
                        {
                          "required": [
                            "type"
                          ],
                          "properties": {
                            "type": {
                              "const": "coordination_owner_approval"
                            }
                          }
                        },
                        {
                          "required": [
                            "coordination"
                          ],
                          "properties": {
                            "coordination": {
                              "type": "object",
                              "required": [
                                "owner_approval"
                              ]
                            }
                          }
                        }
                      ]
                    }
                  },
                  {
                    "required": [
                      "type",
                      "coordination"
                    ],
                    "not": {
                      "required": [
                        "action"
                      ]
                    },
                    "properties": {
                      "type": {
                        "const": "coordination_owner_approval"
                      },
                      "coordination": {
                        "type": "object",
                        "required": [
                          "owner_approval"
                        ],
                        "not": {
                          "required": [
                            "proposals"
                          ]
                        }
                      }
                    }
                  }
                ],
                "properties": {
                  "action": {
                    "type": "string",
                    "maxLength": 8000
                  },
                  "type": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "context": {
                    "type": "object",
                    "additionalProperties": true
                  },
                  "coordination": {
                    "type": "object",
                    "oneOf": [
                      {
                        "required": [
                          "objective",
                          "proposals"
                        ]
                      },
                      {
                        "required": [
                          "owner_approval"
                        ]
                      }
                    ],
                    "properties": {
                      "objective": {
                        "type": "string",
                        "maxLength": 600
                      },
                      "owner_intent": {
                        "type": "string",
                        "maxLength": 400
                      },
                      "conflict_type": {
                        "type": "string",
                        "enum": [
                          "action_conflict",
                          "policy_conflict",
                          "evidence_conflict",
                          "authority_conflict",
                          "risk_conflict"
                        ]
                      },
                      "proposals": {
                        "type": "array",
                        "minItems": 2,
                        "maxItems": 8,
                        "items": {
                          "type": "object",
                          "required": [
                            "proposal_id",
                            "agent_id",
                            "action"
                          ],
                          "properties": {
                            "proposal_id": {
                              "type": "string",
                              "maxLength": 128
                            },
                            "agent_id": {
                              "type": "string",
                              "maxLength": 128
                            },
                            "action": {
                              "type": "string",
                              "maxLength": 500
                            },
                            "rationale": {
                              "type": "string",
                              "maxLength": 20000
                            },
                            "confidence": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            },
                            "risk_level": {
                              "type": "string",
                              "enum": [
                                "low",
                                "medium",
                                "high"
                              ]
                            },
                            "requires_owner_approval": {
                              "type": "boolean"
                            },
                            "evidence": {
                              "type": "array",
                              "maxItems": 8,
                              "items": {
                                "type": "object",
                                "required": [
                                  "kind",
                                  "reference"
                                ],
                                "properties": {
                                  "kind": {
                                    "type": "string",
                                    "maxLength": 40
                                  },
                                  "reference": {
                                    "type": "string",
                                    "maxLength": 160,
                                    "description": "Opaque evidence identifier only; URLs, paths, credentials, and raw evidence are rejected."
                                  }
                                },
                                "additionalProperties": false
                              }
                            }
                          },
                          "additionalProperties": false
                        }
                      },
                      "owner_approval": {
                        "type": "object",
                        "required": [
                          "arbitration_receipt_id",
                          "gate_receipt_id",
                          "decision_id",
                          "selected_proposal_id",
                          "reason"
                        ],
                        "properties": {
                          "arbitration_receipt_id": {
                            "type": "string",
                            "maxLength": 128
                          },
                          "gate_receipt_id": {
                            "type": "string",
                            "maxLength": 128
                          },
                          "decision_id": {
                            "type": "string",
                            "maxLength": 128
                          },
                          "selected_proposal_id": {
                            "type": "string",
                            "maxLength": 128
                          },
                          "reason": {
                            "type": "string",
                            "minLength": 8,
                            "maxLength": 400
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": true
              }
            }
          }
        },
        "security": [
          {
            "marrowApiKey": []
          }
        ],
        "x-marrow-conditional-security": {
          "discriminator": "type",
          "cases": {
            "coordination_owner_approval": {
              "security": [
                {
                  "marrowDashboardSession": []
                }
              ],
              "required_body_path": "coordination.owner_approval",
              "forbidden_body_path": "coordination.proposals"
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tenant-scoped runtime gate, optional arbitration receipt, or authenticated owner-approval receipt.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "additionalProperties": true,
                      "properties": {
                        "decision_id": {
                          "type": "string",
                          "maxLength": 128
                        },
                        "arbitration": {
                          "anyOf": [
                            {
                              "type": "object",
                              "additionalProperties": true,
