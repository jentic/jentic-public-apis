{
  "openapi": "3.0.1",
  "info": {
    "title": "SGA - Requerimento de Mudas API",
    "description": "API para gerenciamento de requerimentos de mudas no sistema SGA.",
    "version": "V1",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/grb-0ea/api-requerimento-de-mudas-iat/V1"
  },
  "servers": [
    {
      "url": "https://hml-apigateway.paas.pr.gov.br/iat/sga/requerimentomudas-des/",
      "description": "DES"
    },
    {
      "url": "https://hml-apigateway.paas.pr.gov.br/iat/sga/requerimentomudas/",
      "description": "HML"
    },
    {
      "url": "https://apigateway.paas.pr.gov.br/iat/sga/requerimentomudas/",
      "description": "PRD"
    }
  ],
  "paths": {
    "/v1/wsRequerimentoMudas/cadastrarImovel": {
      "post": {
        "summary": "Cadastra um novo imóvel.",
        "description": "Cria um novo registro de imóvel no sistema.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImovelRest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Imóvel cadastrado com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImovelRest"
                }
              }
            }
          },
          "401": {
            "description": "Não autorizado."
          },
          "500": {
            "description": "Erro interno do servidor."
          }
        }
      }
    },
    "/v1/wsRequerimentoMudas/cadastrarRequerimento": {
      "post": {
        "summary": "Cadastra um novo requerimento de mudas.",
        "description": "Cria um novo requerimento de mudas, incluindo anexos.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "requerimento": {
                    "$ref": "#/components/schemas/WsRequerimentoMudasApi"
                  },
                  "anexos": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "binary"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Requerimento cadastrado com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RetornoRequisitarMudasRest"
                }
              }
            }
          },
          "401": {
            "description": "Não autorizado."
          },
          "500": {
            "description": "Erro interno do servidor."
          }
        }
      }
    },
