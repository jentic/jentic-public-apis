            "$ref": "#/components/responses/NotFoundError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/api/trainer/dashboard/stats": {
      "get": {
        "summary": "Eğitmen dashboard istatistiklerini getir",
        "description": "Eğitmenin ana dashboard'unda gösterilecek özet istatistikleri getirir.\n\nİstatistikler:\n- Aktif üye sayısı\n- Bugünkü seans sayısı\n- Bu haftaki seans sayısı\n- Bu ayki seans sayısı\n- Toplam antrenman programı sayısı\n- Bekleyen görevler\n",
        "tags": [
          "TrainerDashboard"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Dashboard istatistikleri başarıyla getirildi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "members": {
                          "type": "object",
                          "properties": {
                            "total_assigned": {
                              "type": "integer",
                              "description": "Eğitmene atanmış toplam üye"
                            },
                            "active": {
                              "type": "integer",
                              "description": "Aktif üye sayısı"
                            },
                            "new_this_month": {
                              "type": "integer",
                              "description": "Bu ay eklenen yeni üye"
                            }
                          }
                        },
                        "sessions": {
                          "type": "object",
                          "properties": {
                            "today": {
                              "type": "integer",
                              "description": "Bugünkü seans sayısı"
                            },
                            "this_week": {
                              "type": "integer",
                              "description": "Bu haftaki seans sayısı"
                            },
                            "this_month": {
                              "type": "integer",
                              "description": "Bu ayki seans sayısı"
                            },
                            "completed_this_month": {
                              "type": "integer",
                              "description": "Bu ay tamamlanan seans"
                            }
                          }
                        },
                        "programs": {
                          "type": "object",
                          "properties": {
                            "total_active": {
                              "type": "integer",
                              "description": "Aktif program sayısı"
                            },
                            "ending_soon": {
                              "type": "integer",
                              "description": "Yakında bitecek program sayısı"
                            }
                          }
                        },
                        "tasks": {
                          "type": "object",
                          "properties": {
                            "pending_measurements": {
                              "type": "integer",
                              "description": "Bekleyen ölçüm sayısı"
                            },
                            "pending_assessments": {
                              "type": "integer",
                              "description": "Bekleyen değerlendirme sayısı"
                            },
                            "unread_messages": {
                              "type": "integer",
                              "description": "Okunmamış mesaj sayısı"
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "members": {
                      "total_assigned": 25,
                      "active": 22,
                      "new_this_month": 3
                    },
                    "sessions": {
                      "today": 5,
                      "this_week": 28,
                      "this_month": 95,
                      "completed_this_month": 82
                    },
                    "programs": {
                      "total_active": 20,
                      "ending_soon": 4
                    },
                    "tasks": {
                      "pending_measurements": 3,
                      "pending_assessments": 2,
                      "unread_messages": 5
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          }
        }
      }
    },
    "/api/trainer/dashboard/activities": {
      "get": {
        "summary": "Son aktiviteleri getir",
        "description": "Eğitmenin son aktivitelerini kronolojik sırada listeler.\n\nAktivite türleri:\n- Üye ekleme/güncelleme\n- Ölçüm kaydı\n- Program oluşturma/güncelleme\n- Seans tamamlama\n- Mesaj gönderme/alma\n",
        "tags": [
          "TrainerDashboard"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "default": 10,
              "maximum": 50
            },
            "description": "Getirilecek aktivite sayısı"
          },
          {
            "in": "query",
            "name": "type",
            "schema": {
              "type": "string",
              "enum": [
                "member",
                "measurement",
                "program",
                "session",
                "message",
                "all"
              ],
              "default": "all"
            },
            "description": "Aktivite türü filtresi"
          }
        ],
        "responses": {
          "200": {
            "description": "Aktivite listesi başarıyla getirildi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer"
                          },
                          "type": {
                            "type": "string",
                            "enum": [
                              "member_added",
                              "measurement_recorded",
                              "program_created",
                              "session_completed",
                              "message_received"
                            ]
                          },
                          "title": {
                            "type": "string"
                          },
                          "description": {
                            "type": "string"
                          },
                          "related_member": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "integer"
                              },
                              "name": {
                                "type": "string"
                              }
                            }
                          },
                          "timestamp": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "icon": {
                            "type": "string"
                          },
                          "color": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": [
                    {
                      "id": 1,
                      "type": "measurement_recorded",
                      "title": "Ölçüm Kaydedildi",
                      "description": "Ahmet Yılmaz için yeni ölçüm kaydedildi",
                      "related_member": {
                        "id": 42,
                        "name": "Ahmet Yılmaz"
                      },
                      "timestamp": "2024-01-15T14:30:00Z",
