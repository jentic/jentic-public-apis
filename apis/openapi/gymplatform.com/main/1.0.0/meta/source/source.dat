                        "totalMembers": 150
                      }
                    ]
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/api/admin/analytics/members": {
      "get": {
        "summary": "Üye raporu oluştur",
        "description": "Belirli tarih aralığı için detaylı üye raporu oluşturur.\nExcel veya PDF export için kullanılabilir.\n\n**Yetki:** Sadece Admin\n",
        "tags": [
          "Analytics"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/StartDateParam"
          },
          {
            "$ref": "#/components/parameters/EndDateParam"
          },
          {
            "name": "status",
            "in": "query",
            "description": "Üye durumu filtresi",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "active",
                "inactive",
                "expired"
              ],
              "default": "all"
            }
          },
          {
            "name": "format",
            "in": "query",
            "description": "Çıktı formatı",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "csv"
              ],
              "default": "json"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Üye raporu başarıyla oluşturuldu",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "reportDate": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "dateRange": {
                          "type": "object",
                          "properties": {
                            "start": {
                              "type": "string",
                              "format": "date"
                            },
                            "end": {
                              "type": "string",
                              "format": "date"
                            }
                          }
                        },
                        "summary": {
                          "type": "object",
                          "properties": {
                            "totalMembers": {
                              "type": "integer"
                            },
                            "activeMembers": {
                              "type": "integer"
                            },
                            "newMembers": {
                              "type": "integer"
                            },
                            "expiredMembers": {
                              "type": "integer"
                            }
                          }
                        },
                        "members": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/User"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
