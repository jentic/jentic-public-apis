    "/api/admin/trainers/{id}": {
      "get": {
        "summary": "Eğitmen detaylarını getir",
        "description": "Belirtilen ID'ye sahip eğitmenin detaylı bilgilerini getirir.\nUzmanlık alanları, atanmış üyeler ve performans özeti dahildir.\n\n**Yetki:** Sadece Admin\n",
        "tags": [
          "Trainers"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Eğitmen ID'si",
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "example": 2
          }
        ],
        "responses": {
          "200": {
            "description": "Eğitmen detayları başarıyla getirildi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/User"
                        },
                        {
                          "type": "object",
                          "properties": {
                            "specializations": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "specialization_id": {
                                    "type": "integer"
                                  },
                                  "name": {
                                    "type": "string"
                                  },
                                  "certification": {
                                    "type": "string"
                                  }
                                }
                              }
                            },
                            "memberCount": {
                              "type": "integer"
                            },
                            "activeMembers": {
                              "type": "array",
                              "items": {
                                "$ref": "#/components/schemas/User"
                              }
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "put": {
        "summary": "Eğitmen bilgilerini güncelle",
        "description": "Belirtilen eğitmenin bilgilerini günceller.\n\n**Yetki:** Sadece Admin\n",
        "tags": [
          "Trainers"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Güncellenecek eğitmen ID'si",
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "example": 2
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "first_name": {
                    "type": "string"
                  },
                  "last_name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "phone": {
                    "type": "string"
                  },
                  "bio": {
                    "type": "string"
                  },
                  "is_active": {
                    "type": "boolean"
                  },
                  "specializations": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    }
                  }
                }
              },
              "example": {
                "bio": "Güncellenmiş biyografi",
                "specializations": [
                  1,
                  2,
                  4
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Eğitmen başarıyla güncellendi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Eğitmen bilgileri güncellendi"
                    },
                    "data": {
                      "$ref": "#/components/schemas/User"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "delete": {
        "summary": "Eğitmeni sil (soft delete)",
        "description": "Eğitmeni sistemden siler (soft delete).\nEğitmenin üyeleri otomatik olarak atanmamış duruma geçer.\n\n**Yetki:** Sadece Admin\n\n**Uyarı:** Eğitmene atanmış üyeler varsa yeni eğitmen ataması yapılmalıdır.\n",
        "tags": [
          "Trainers"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Silinecek eğitmen ID'si",
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "example": 2
          }
        ],
        "responses": {
          "200": {
            "description": "Eğitmen başarıyla silindi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Eğitmen başarıyla silindi"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "unassignedMembers": {
                          "type": "integer",
                          "description": "Atama kaldırılan üye sayısı",
                          "example": 5
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
