    "/api/admin/trainers": {
      "get": {
        "summary": "Tüm eğitmenleri listele",
        "description": "Salona ait tüm eğitmenleri sayfalama ve filtreleme ile listeler.\n\n**Yetki:** Sadece Admin\n\n**Filtreleme:**\n- `search`: Ad, soyad veya e-posta'da arama\n- `is_active`: Aktif/pasif eğitmenler\n- `specialization`: Uzmanlık alanına göre filtreleme\n",
        "tags": [
          "Trainers"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/PageParam"
          },
          {
            "$ref": "#/components/parameters/LimitParam"
          },
          {
            "$ref": "#/components/parameters/SearchParam"
          },
          {
            "name": "is_active",
            "in": "query",
            "description": "Aktif/pasif filtresi",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "specialization",
            "in": "query",
            "description": "Uzmanlık alanı filtresi",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Eğitmen listesi başarıyla getirildi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "allOf": [
                          {
                            "$ref": "#/components/schemas/User"
                          },
                          {
                            "type": "object",
                            "properties": {
                              "memberCount": {
                                "type": "integer",
                                "description": "Atanmış üye sayısı",
                                "example": 15
                              },
                              "specializations": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                },
                                "example": [
                                  "Fitness",
                                  "Pilates",
                                  "Yoga"
                                ]
                              }
                            }
                          }
                        ]
                      }
                    },
                    "pagination": {
                      "$ref": "#/components/schemas/Pagination"
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": [
                    {
                      "user_id": 2,
                      "first_name": "Ali",
                      "last_name": "Koç",
                      "email": "ali@example.com",
                      "phone": "05551234567",
                      "role": "TRAINER",
                      "is_active": true,
                      "memberCount": 15,
                      "specializations": [
                        "Fitness",
                        "Pilates"
                      ]
                    }
                  ],
                  "pagination": {
                    "page": 1,
                    "limit": 10,
                    "totalItems": 5,
                    "totalPages": 1
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "post": {
        "summary": "Yeni eğitmen oluştur",
        "description": "Salona yeni bir eğitmen ekler.\nEğitmen için otomatik olarak kullanıcı hesabı oluşturulur.\n\n**Yetki:** Sadece Admin\n\n**Otomatik İşlemler:**\n- Kullanıcı hesabı TRAINER rolüyle oluşturulur\n- Şifre hashlenir\n- Hoş geldiniz e-postası gönderilir (opsiyonel)\n",
        "tags": [
          "Trainers"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "first_name",
                  "last_name",
                  "phone",
                  "password"
                ],
                "properties": {
                  "first_name": {
                    "type": "string",
                    "minLength": 2,
                    "example": "Ali"
                  },
                  "last_name": {
                    "type": "string",
                    "minLength": 2,
                    "example": "Koç"
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "ali@example.com"
                  },
                  "phone": {
                    "type": "string",
                    "example": "05551234567"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 6,
                    "example": "trainer123"
                  },
                  "bio": {
                    "type": "string",
                    "example": "10 yıllık fitness deneyimi"
                  },
                  "specializations": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    },
                    "description": "Uzmanlık alanı ID'leri",
                    "example": [
                      1,
                      2,
                      3
                    ]
                  }
                }
              },
              "examples": {
                "basic": {
                  "summary": "Temel eğitmen kaydı",
                  "value": {
                    "first_name": "Ali",
                    "last_name": "Koç",
                    "email": "ali@example.com",
                    "phone": "05551234567",
                    "password": "trainer123"
                  }
                },
                "withBio": {
                  "summary": "Biyografi ile kayıt",
                  "value": {
                    "first_name": "Ayşe",
                    "last_name": "Yılmaz",
                    "email": "ayse@example.com",
                    "phone": "05559876543",
                    "password": "securePass456",
                    "bio": "Pilates ve Yoga uzmanı, 8 yıllık deneyim",
                    "specializations": [
                      1,
                      3
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Eğitmen başarıyla oluşturuldu",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Eğitmen başarıyla oluşturuldu"
                    },
                    "data": {
                      "$ref": "#/components/schemas/User"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Doğrulama hatası",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                },
                "examples": {
                  "emailExists": {
                    "summary": "E-posta zaten kayıtlı",
                    "value": {
                      "success": false,
                      "message": "Bu e-posta adresi zaten kullanılıyor"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
