                          }
                        },
                        "progress": {
                          "type": "object",
                          "properties": {
                            "completed_days": {
                              "type": "integer"
                            },
                            "total_days": {
                              "type": "integer"
                            },
                            "completion_percentage": {
                              "type": "number"
                            },
                            "current_week": {
                              "type": "integer"
                            },
                            "total_weeks": {
                              "type": "integer"
                            }
                          }
                        },
                        "next_workout": {
                          "type": "object",
                          "nullable": true,
                          "properties": {
                            "day_name": {
                              "type": "string"
                            },
                            "exercises_count": {
                              "type": "integer"
                            },
                            "estimated_duration": {
                              "type": "integer"
                            }
                          }
                        },
                        "stats": {
                          "type": "object",
                          "properties": {
                            "total_exercises_done": {
                              "type": "integer"
                            },
                            "total_sets_done": {
                              "type": "integer"
                            },
                            "total_weight_lifted": {
                              "type": "number"
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "program": {
                      "id": 1,
                      "name": "Kas Geliştirme Programı",
                      "trainer": {
                        "id": 5,
                        "name": "Can Demir"
                      },
                      "start_date": "2024-01-01",
                      "end_date": "2024-03-25"
                    },
                    "progress": {
                      "completed_days": 12,
                      "total_days": 48,
                      "completion_percentage": 25,
                      "current_week": 4,
                      "total_weeks": 12
                    },
                    "next_workout": {
                      "day_name": "Göğüs & Triceps",
                      "exercises_count": 6,
                      "estimated_duration": 60
                    },
                    "stats": {
                      "total_exercises_done": 72,
                      "total_sets_done": 288,
                      "total_weight_lifted": 15400
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/api/member/dashboard/subscriptions": {
      "get": {
        "summary": "Üyeliklerimi getir",
        "description": "Üyenin aktif ve geçmiş üyeliklerini listeler.\nHer üyelik için paket bilgisi, tarihler ve ödeme durumu gösterilir.\n",
        "tags": [
          "MemberDashboard"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "status",
            "schema": {
              "type": "string",
              "enum": [
                "active",
                "expired",
                "frozen",
                "all"
              ],
              "default": "all"
            },
            "description": "Üyelik durumu filtresi"
          }
        ],
        "responses": {
          "200": {
            "description": "Üyelikler başarıyla getirildi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "current": {
                          "$ref": "#/components/schemas/MemberSubscription",
                          "nullable": true
                        },
                        "history": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/MemberSubscription"
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "current": {
                      "subscription_id": 123,
                      "package": {
                        "id": 5,
                        "name": "Premium Üyelik + 8 PT",
                        "duration_days": 90
                      },
                      "start_date": "2024-01-01",
                      "end_date": "2024-03-31",
                      "status": "active",
                      "days_remaining": 75,
                      "pt_sessions": {
                        "total": 8,
                        "used": 3,
                        "remaining": 5
                      },
                      "payment_status": "paid",
                      "total_amount": 3500
                    },
                    "history": [
                      {
                        "subscription_id": 98,
                        "package": {
                          "id": 3,
                          "name": "Standart Üyelik",
                          "duration_days": 30
                        },
                        "start_date": "2023-12-01",
                        "end_date": "2023-12-31",
                        "status": "completed",
                        "payment_status": "paid",
                        "total_amount": 800
                      }
                    ]
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
