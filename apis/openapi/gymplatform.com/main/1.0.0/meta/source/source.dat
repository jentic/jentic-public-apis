    "/api/member/dashboard/stats": {
      "get": {
        "summary": "Üye dashboard istatistiklerini getir",
        "description": "Üyenin ana dashboard'unda gösterilecek özet istatistikleri getirir.\n\nİstatistikler:\n- Üyelik durumu ve kalan gün\n- Bu ay giriş sayısı\n- Aktif antrenman programı\n- Son ölçüm özeti\n- Kazanılan rozetler\n- Yaklaşan etkinlikler\n",
        "tags": [
          "MemberDashboard"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Dashboard istatistikleri başarıyla getirildi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "membership": {
                          "type": "object",
                          "properties": {
                            "status": {
                              "type": "string",
                              "enum": [
                                "active",
                                "expired",
                                "frozen",
                                "pending"
                              ]
                            },
                            "package_name": {
                              "type": "string"
                            },
                            "days_remaining": {
                              "type": "integer"
                            },
                            "end_date": {
                              "type": "string",
                              "format": "date"
                            },
                            "pt_sessions_remaining": {
                              "type": "integer"
                            }
                          }
                        },
                        "attendance": {
                          "type": "object",
                          "properties": {
                            "this_month": {
                              "type": "integer"
                            },
                            "last_month": {
                              "type": "integer"
                            },
                            "streak": {
                              "type": "integer",
                              "description": "Ardışık giriş günü sayısı"
                            }
                          }
                        },
                        "program": {
                          "type": "object",
                          "nullable": true,
                          "properties": {
                            "name": {
                              "type": "string"
                            },
                            "progress_percentage": {
                              "type": "number"
                            },
                            "next_workout": {
                              "type": "string"
                            }
                          }
                        },
                        "measurements": {
                          "type": "object",
                          "nullable": true,
                          "properties": {
                            "last_date": {
                              "type": "string",
                              "format": "date"
                            },
                            "weight": {
                              "type": "number"
                            },
                            "weight_change": {
                              "type": "number"
                            }
                          }
                        },
                        "badges": {
                          "type": "object",
                          "properties": {
                            "total": {
                              "type": "integer"
                            },
                            "recent": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "name": {
                                    "type": "string"
                                  },
                                  "icon": {
                                    "type": "string"
                                  }
                                }
                              }
                            }
                          }
                        },
                        "upcoming_events": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "membership": {
                      "status": "active",
                      "package_name": "Premium Üyelik + 8 PT",
                      "days_remaining": 45,
                      "end_date": "2024-03-01",
                      "pt_sessions_remaining": 5
                    },
                    "attendance": {
                      "this_month": 12,
                      "last_month": 15,
                      "streak": 4
                    },
                    "program": {
                      "name": "Kas Geliştirme Programı",
                      "progress_percentage": 65,
                      "next_workout": "Göğüs & Triceps"
                    },
                    "measurements": {
                      "last_date": "2024-01-08",
                      "weight": 75.5,
                      "weight_change": -1.2
                    },
                    "badges": {
                      "total": 8,
                      "recent": [
                        {
                          "name": "İlk Hafta",
                          "icon": "star"
                        },
                        {
                          "name": "10 Giriş",
                          "icon": "trophy"
                        }
                      ]
                    },
                    "upcoming_events": 3
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/api/member/dashboard/upcoming-classes": {
      "get": {
