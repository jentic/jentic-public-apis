            "description": "Yenilenecek abonelik ID'si",
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "example": 10
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "price_paid": {
                    "type": "number",
                    "description": "Ödenen tutar",
                    "example": 500
                  },
                  "payment_status": {
                    "type": "string",
                    "enum": [
                      "PENDING",
                      "PARTIAL",
                      "PAID"
                    ],
                    "example": "PAID"
                  }
                }
              },
              "example": {
                "price_paid": 500,
                "payment_status": "PAID"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Abonelik başarıyla yenilendi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Abonelik başarıyla yenilendi"
                    },
                    "data": {
                      "$ref": "#/components/schemas/MemberSubscription"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Yenileme başarısız",
