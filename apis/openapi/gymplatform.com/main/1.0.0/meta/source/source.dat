    "/api/admin/members/{id}/subscriptions": {
      "get": {
        "summary": "Üyenin abonelik geçmişini getir",
        "description": "Belirtilen üyenin tüm abonelik kayıtlarını getirir.\nAktif, geçmiş ve iptal edilmiş tüm abonelikler dahildir.\n\n**Yetki:** Admin veya Eğitmen\n",
        "tags": [
          "Members"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Üye ID'si",
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "example": 5
          }
        ],
        "responses": {
          "200": {
            "description": "Abonelik listesi başarıyla getirildi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/MemberSubscription"
                      }
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": [
                    {
                      "subscription_id": 10,
                      "user_id": 5,
                      "package_id": 1,
                      "start_date": "2024-01-01",
                      "end_date": "2024-01-31",
                      "status": "ACTIVE",
                      "price_paid": 500,
                      "payment_status": "PAID",
                      "package": {
                        "package_id": 1,
                        "name": "Aylık Üyelik",
                        "duration_days": 30
                      }
                    },
                    {
                      "subscription_id": 5,
                      "user_id": 5,
                      "package_id": 2,
                      "start_date": "2023-12-01",
                      "end_date": "2023-12-31",
                      "status": "EXPIRED",
                      "price_paid": 500,
                      "payment_status": "PAID"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/api/admin/members/{id}/assign-trainer": {
      "post": {
        "summary": "Üyeye eğitmen ata",
        "description": "Belirtilen üyeye bir eğitmen atar.\nÖnceki eğitmen ataması varsa üzerine yazılır.\n\n**Yetki:** Sadece Admin\n\n**Not:** Eğitmen atandığında hem üyeye hem eğitmene bildirim gönderilir.\n",
        "tags": [
          "Members"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Üye ID'si",
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "example": 5
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "trainer_id"
                ],
                "properties": {
                  "trainer_id": {
                    "type": "integer",
                    "description": "Atanacak eğitmen ID'si",
                    "example": 2
                  }
                }
              },
              "example": {
                "trainer_id": 2
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Eğitmen başarıyla atandı",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Eğitmen başarıyla atandı"
                    },
                    "data": {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/User"
                        },
                        {
                          "type": "object",
                          "properties": {
                            "trainer": {
                              "$ref": "#/components/schemas/User"
                            }
                          }
                        }
                      ]
                    }
                  }
                },
                "example": {
                  "success": true,
                  "message": "Eğitmen başarıyla atandı",
                  "data": {
                    "user_id": 5,
                    "first_name": "Ahmet",
                    "last_name": "Yılmaz",
                    "assigned_trainer_id": 2,
                    "trainer": {
                      "user_id": 2,
                      "first_name": "Ali",
                      "last_name": "Koç",
                      "role": "TRAINER"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Geçersiz istek",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "invalidTrainer": {
                    "summary": "Geçersiz eğitmen",
                    "value": {
                      "success": false,
                      "message": "Belirtilen eğitmen bulunamadı veya aktif değil"
                    }
                  },
                  "notTrainer": {
                    "summary": "Kullanıcı eğitmen değil",
                    "value": {
                      "success": false,
                      "message": "Belirtilen kullanıcı eğitmen rolünde değil"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
