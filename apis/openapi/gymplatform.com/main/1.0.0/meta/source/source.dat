    "/api/measurements": {
      "post": {
        "summary": "Yeni ölçüm kaydet",
        "description": "Bir üye için yeni vücut ölçümü kaydeder.\n\n**Zorunlu alanlar:**\n- member_id: Üye ID\n- date: Ölçüm tarihi\n\nTüm ölçüm değerleri opsiyoneldir. En az bir ölçüm değeri girilmelidir.\n\nBMI otomatik hesaplanır (kilo ve boy girilmişse).\n",
        "tags": [
          "Measurements"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MeasurementCreate"
              },
              "examples": {
                "basicMeasurement": {
                  "summary": "Temel ölçüm",
                  "value": {
                    "member_id": 42,
                    "date": "2024-01-15",
                    "weight": 75.5,
                    "height": 175
                  }
                },
                "fullMeasurement": {
                  "summary": "Detaylı ölçüm",
                  "value": {
                    "member_id": 42,
                    "date": "2024-01-15",
                    "weight": 75.5,
                    "height": 175,
                    "body_fat_percentage": 18.5,
                    "muscle_mass": 35.2,
                    "chest": 98,
                    "waist": 82,
                    "hips": 95,
                    "left_arm": 32,
                    "right_arm": 32.5,
                    "left_forearm": 28,
                    "right_forearm": 28,
                    "left_thigh": 55,
                    "right_thigh": 55.5,
                    "left_calf": 38,
                    "right_calf": 38,
                    "neck": 38,
                    "shoulders": 115,
                    "notes": "Sabah aç karnına ölçüm"
                  }
                },
                "withPhotos": {
                  "summary": "Fotoğraflı ölçüm",
                  "value": {
                    "member_id": 42,
                    "date": "2024-01-15",
                    "weight": 75.5,
                    "body_fat_percentage": 18.5,
                    "photos": {
                      "front": "https://example.com/photos/front.jpg",
                      "side": "https://example.com/photos/side.jpg",
                      "back": "https://example.com/photos/back.jpg"
                    },
                    "notes": "Aylık ilerleme fotoğrafı"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Ölçüm başarıyla kaydedildi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Ölçüm başarıyla kaydedildi"
                    },
                    "data": {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/Measurement"
                        },
                        {
                          "type": "object",
                          "properties": {
                            "comparison": {
                              "type": "object",
                              "description": "Önceki ölçümle karşılaştırma"
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Geçersiz istek",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "missingFields": {
                    "summary": "Eksik alanlar",
                    "value": {
                      "success": false,
                      "message": "Zorunlu alanlar eksik: member_id, date"
                    }
                  },
                  "noMeasurements": {
                    "summary": "Ölçüm değeri yok",
                    "value": {
                      "success": false,
                      "message": "En az bir ölçüm değeri girilmelidir"
                    }
                  },
                  "invalidValues": {
                    "summary": "Geçersiz değerler",
                    "value": {
                      "success": false,
                      "message": "Ölçüm değerleri pozitif sayı olmalıdır"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "404": {
            "description": "Üye bulunamadı",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "success": false,
                  "message": "Üye bulunamadı"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/members": {
      "get": {
        "summary": "Tüm üyeleri listele",
        "description": "Salona ait tüm üyeleri sayfalama, arama ve filtreleme özellikleriyle listeler.\n\n**Yetki:** Admin veya Eğitmen\n\n**Filtreleme Seçenekleri:**\n- `search`: Ad, soyad veya e-posta'da arama\n- `status`: Aktif/pasif üye filtresi\n- `trainer_id`: Belirli eğitmene atanmış üyeler\n- `subscription_status`: Abonelik durumuna göre filtreleme\n",
        "tags": [
          "Members"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/PageParam"
          },
          {
            "$ref": "#/components/parameters/LimitParam"
          },
          {
            "$ref": "#/components/parameters/SearchParam"
          },
          {
            "name": "status",
            "in": "query",
            "description": "Üye durumu filtresi",
            "schema": {
              "type": "string",
              "enum": [
                "active",
                "inactive"
              ]
            }
          },
          {
            "name": "trainer_id",
            "in": "query",
            "description": "Eğitmen ID'sine göre filtrele",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "subscription_status",
            "in": "query",
            "description": "Abonelik durumu filtresi",
            "schema": {
              "type": "string",
              "enum": [
                "ACTIVE",
                "EXPIRED",
                "FROZEN",
                "NONE"
              ]
            }
          },
          {
            "$ref": "#/components/parameters/SortByParam"
          },
          {
            "$ref": "#/components/parameters/SortOrderParam"
          }
        ],
        "responses": {
          "200": {
            "description": "Üye listesi başarıyla getirildi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "allOf": [
                          {
                            "$ref": "#/components/schemas/User"
                          },
                          {
                            "type": "object",
                            "properties": {
                              "trainer": {
                                "$ref": "#/components/schemas/User"
                              },
                              "activeSubscription": {
                                "$ref": "#/components/schemas/MemberSubscription"
                              }
                            }
                          }
                        ]
                      }
                    },
                    "pagination": {
                      "$ref": "#/components/schemas/Pagination"
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": [
                    {
                      "user_id": 5,
                      "first_name": "Ahmet",
                      "last_name": "Yılmaz",
                      "email": "ahmet@example.com",
                      "phone": "05551234567",
                      "role": "MEMBER",
                      "is_active": true,
                      "member_number": "M-2024-001",
                      "trainer": {
                        "user_id": 2,
                        "first_name": "Ali",
                        "last_name": "Koç"
                      },
                      "activeSubscription": {
                        "subscription_id": 10,
                        "status": "ACTIVE",
                        "end_date": "2024-02-15"
                      }
                    }
                  ],
                  "pagination": {
                    "page": 1,
                    "limit": 10,
                    "totalItems": 45,
                    "totalPages": 5
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "post": {
        "summary": "Yeni üye oluştur",
        "description": "Salona yeni bir üye ekler.\nÜye numarası otomatik olarak oluşturulur.\n\n**Yetki:** Sadece Admin\n\n**Otomatik İşlemler:**\n- Üye numarası otomatik atanır (M-YYYY-XXX formatında)\n- Şifre hashlenir\n- Hoş geldiniz bildirimi gönderilir (opsiyonel)\n",
        "tags": [
          "Members"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserCreate"
              },
              "examples": {
                "basic": {
                  "summary": "Temel üye kaydı",
                  "value": {
                    "first_name": "Ahmet",
                    "last_name": "Yılmaz",
                    "email": "ahmet@example.com",
                    "phone": "05551234567",
                    "password": "password123"
                  }
                },
                "full": {
                  "summary": "Detaylı üye kaydı",
                  "value": {
                    "first_name": "Mehmet",
                    "last_name": "Demir",
                    "email": "mehmet@example.com",
                    "phone": "05559876543",
                    "password": "securePass456",
                    "national_id": "12345678901",
                    "date_of_birth": "1985-03-20",
                    "gender": "MALE",
                    "emergency_contact_name": "Ayşe Demir",
                    "emergency_contact_phone": "05551112233",
                    "health_conditions": "Kalp rahatsızlığı yok",
                    "address": "Ankara, Çankaya"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Üye başarıyla oluşturuldu",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Üye başarıyla oluşturuldu"
                    },
                    "data": {
                      "$ref": "#/components/schemas/User"
                    }
                  }
                },
                "example": {
                  "success": true,
                  "message": "Üye başarıyla oluşturuldu",
                  "data": {
                    "user_id": 15,
                    "first_name": "Ahmet",
                    "last_name": "Yılmaz",
                    "email": "ahmet@example.com",
                    "phone": "05551234567",
                    "role": "MEMBER",
                    "member_number": "M-2024-015",
                    "is_active": true,
                    "created_at": "2024-01-15T14:30:00Z"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Doğrulama hatası",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                },
                "examples": {
                  "emailExists": {
                    "summary": "E-posta zaten kayıtlı",
                    "value": {
                      "success": false,
                      "message": "Bu e-posta adresi zaten kullanılıyor"
                    }
                  },
                  "phoneExists": {
                    "summary": "Telefon zaten kayıtlı",
                    "value": {
                      "success": false,
                      "message": "Bu telefon numarası zaten kullanılıyor"
                    }
                  },
                  "validation": {
                    "summary": "Doğrulama hatası",
                    "value": {
                      "success": false,
                      "message": "Doğrulama hatası",
                      "errors": [
                        {
                          "msg": "Ad en az 2 karakter olmalıdır",
                          "path": "first_name"
                        },
                        {
                          "msg": "Geçerli bir e-posta adresi giriniz",
                          "path": "email"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
