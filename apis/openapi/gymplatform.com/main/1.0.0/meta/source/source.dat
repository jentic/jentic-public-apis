                        "package_id": 1,
                        "name": "Aylık Üyelik",
                        "is_active": false
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/api/admin/payments": {
      "get": {
        "summary": "Tüm ödemeleri listele",
        "description": "Salona ait tüm ödemeleri sayfalama, arama ve filtreleme ile listeler.\n\n**Yetki:** Admin veya Eğitmen\n\n**Filtreleme:**\n- `status`: PENDING, COMPLETED, FAILED, REFUNDED\n- `payment_type`: SUBSCRIPTION, PT_SESSION, PRODUCT, OTHER\n- `payment_method`: CASH, CREDIT_CARD, BANK_TRANSFER, OTHER\n- `startDate`, `endDate`: Tarih aralığı\n- `member_id`: Belirli üyenin ödemeleri\n",
        "tags": [
          "Payments"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/PageParam"
          },
          {
            "$ref": "#/components/parameters/LimitParam"
          },
          {
            "$ref": "#/components/parameters/SearchParam"
          },
          {
            "name": "status",
            "in": "query",
            "description": "Ödeme durumu filtresi",
            "schema": {
              "type": "string",
              "enum": [
                "PENDING",
                "COMPLETED",
                "FAILED",
                "REFUNDED"
              ]
            }
          },
          {
            "name": "payment_type",
            "in": "query",
            "description": "Ödeme tipi filtresi",
            "schema": {
              "type": "string",
              "enum": [
                "SUBSCRIPTION",
                "PT_SESSION",
                "PRODUCT",
                "OTHER"
              ]
            }
          },
          {
            "name": "payment_method",
            "in": "query",
            "description": "Ödeme yöntemi filtresi",
            "schema": {
              "type": "string",
              "enum": [
                "CASH",
                "CREDIT_CARD",
                "BANK_TRANSFER",
                "OTHER"
              ]
            }
          },
          {
            "$ref": "#/components/parameters/StartDateParam"
          },
          {
            "$ref": "#/components/parameters/EndDateParam"
          },
          {
            "name": "member_id",
            "in": "query",
            "description": "Üye ID filtresi",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ödeme listesi başarıyla getirildi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "allOf": [
                          {
                            "$ref": "#/components/schemas/Payment"
                          },
                          {
                            "type": "object",
                            "properties": {
                              "member": {
                                "type": "object",
                                "properties": {
                                  "user_id": {
                                    "type": "integer"
                                  },
                                  "first_name": {
                                    "type": "string"
                                  },
                                  "last_name": {
                                    "type": "string"
                                  }
                                }
                              }
                            }
                          }
                        ]
                      }
                    },
                    "pagination": {
                      "$ref": "#/components/schemas/Pagination"
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": [
                    {
                      "payment_id": 1,
                      "user_id": 5,
                      "amount": 500,
                      "payment_type": "SUBSCRIPTION",
                      "payment_method": "CREDIT_CARD",
                      "status": "COMPLETED",
                      "payment_date": "2024-01-15T10:30:00Z",
                      "member": {
                        "user_id": 5,
                        "first_name": "Ahmet",
                        "last_name": "Yılmaz"
                      }
                    }
                  ],
                  "pagination": {
                    "page": 1,
                    "limit": 10,
                    "totalItems": 150,
                    "totalPages": 15
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "post": {
        "summary": "Yeni ödeme kaydı oluştur",
        "description": "Manuel ödeme kaydı oluşturur.\n\n**Yetki:** Sadece Admin\n\n**Kullanım Alanları:**\n- Nakit ödemeler\n- Havale/EFT ödemeleri\n- PT seans ödemeleri\n- Ürün satışları\n\n**Not:** Abonelik ödemeleri için subscription endpoint'i kullanılması önerilir.\n",
        "tags": [
          "Payments"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaymentCreate"
              },
              "examples": {
                "subscriptionPayment": {
                  "summary": "Abonelik ödemesi",
                  "value": {
                    "user_id": 5,
                    "subscription_id": 10,
                    "amount": 500,
                    "payment_type": "SUBSCRIPTION",
                    "payment_method": "CREDIT_CARD",
                    "description": "Ocak ayı üyelik ödemesi"
                  }
                },
                "ptPayment": {
                  "summary": "PT seans ödemesi",
                  "value": {
                    "user_id": 5,
                    "amount": 300,
                    "payment_type": "PT_SESSION",
                    "payment_method": "CASH",
                    "description": "5 PT seans paketi"
                  }
                },
                "productPayment": {
                  "summary": "Ürün satışı",
                  "value": {
                    "user_id": 5,
                    "amount": 150,
                    "payment_type": "PRODUCT",
                    "payment_method": "CASH",
                    "description": "Protein tozu satışı"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Ödeme başarıyla oluşturuldu",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Ödeme başarıyla kaydedildi"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Payment"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Doğrulama hatası",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                },
                "examples": {
                  "invalidAmount": {
                    "summary": "Geçersiz tutar",
                    "value": {
                      "success": false,
                      "message": "Tutar 0'dan büyük olmalıdır"
                    }
                  },
                  "memberNotFound": {
                    "summary": "Üye bulunamadı",
                    "value": {
                      "success": false,
                      "message": "Belirtilen üye bulunamadı"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/api/admin/payments/summary": {
      "get": {
        "summary": "Ödeme özeti getir",
        "description": "Belirli bir dönem için ödeme özetini getirir.\nToplam gelir, ödeme yöntemlerine göre dağılım ve grafik verileri içerir.\n\n**Yetki:** Sadece Admin\n",
        "tags": [
          "Payments"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/StartDateParam"
          },
          {
            "$ref": "#/components/parameters/EndDateParam"
          },
          {
            "name": "groupBy",
            "in": "query",
            "description": "Gruplama türü",
            "schema": {
              "type": "string",
              "enum": [
                "day",
                "week",
                "month"
              ],
              "default": "day"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ödeme özeti başarıyla getirildi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "totalRevenue": {
                          "type": "number",
                          "example": 75000,
                          "description": "Toplam gelir"
                        },
                        "completedPayments": {
                          "type": "integer",
                          "example": 120,
                          "description": "Tamamlanan ödeme sayısı"
                        },
                        "pendingPayments": {
                          "type": "integer",
                          "example": 5,
                          "description": "Bekleyen ödeme sayısı"
                        },
                        "refundedAmount": {
                          "type": "number",
                          "example": 1500,
                          "description": "İade edilen toplam tutar"
                        },
                        "byPaymentType": {
                          "type": "object",
                          "properties": {
                            "SUBSCRIPTION": {
                              "type": "number",
                              "example": 60000
                            },
                            "PT_SESSION": {
                              "type": "number",
                              "example": 10000
                            },
                            "PRODUCT": {
                              "type": "number",
                              "example": 5000
                            }
                          }
                        },
                        "byPaymentMethod": {
                          "type": "object",
                          "properties": {
                            "CASH": {
                              "type": "number",
                              "example": 20000
                            },
                            "CREDIT_CARD": {
                              "type": "number",
                              "example": 45000
                            },
                            "BANK_TRANSFER": {
                              "type": "number",
                              "example": 10000
                            }
                          }
                        },
                        "chartData": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "date": {
                                "type": "string",
                                "format": "date"
                              },
                              "amount": {
                                "type": "number"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "totalRevenue": 75000,
                    "completedPayments": 120,
                    "pendingPayments": 5,
                    "refundedAmount": 1500,
                    "byPaymentType": {
                      "SUBSCRIPTION": 60000,
                      "PT_SESSION": 10000,
                      "PRODUCT": 5000
                    },
                    "byPaymentMethod": {
                      "CASH": 20000,
                      "CREDIT_CARD": 45000,
                      "BANK_TRANSFER": 10000
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
