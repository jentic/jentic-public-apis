          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "put": {
        "summary": "Paket bilgilerini güncelle",
        "description": "Belirtilen paketin bilgilerini günceller.\n\n**Yetki:** Sadece Admin\n\n**Uyarı:** Aktif abonelikleri olan paketlerin fiyat güncellemesi\nmevcut abonelikleri etkilemez, sadece yeni satışları etkiler.\n",
        "tags": [
          "Packages"
