    "/api/admin/calendar/reservations/{id}": {
      "delete": {
        "summary": "Rezervasyon iptal et",
        "description": "Belirtilen rezervasyonu iptal eder.\n\nİptal kuralları:\n- Etkinlik başlamadan en az 2 saat önce iptal edilmelidir (ayarlanabilir)\n- Geç iptal durumunda ceza uygulanabilir\n- İptal sonrası bekleme listesindeki ilk üye otomatik olarak yükseltilir\n",
        "tags": [
          "Calendar"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Rezervasyon ID",
            "example": 101
          },
          {
            "in": "query",
            "name": "reason",
            "schema": {
              "type": "string"
            },
            "description": "İptal nedeni",
            "example": "Üye hastalandı"
          },
          {
            "in": "query",
            "name": "notify_member",
            "schema": {
              "type": "boolean",
              "default": true
            },
            "description": "Üyeye bildirim gönderilsin mi?"
          }
        ],
        "responses": {
          "200": {
            "description": "Rezervasyon başarıyla iptal edildi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Rezervasyon başarıyla iptal edildi"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "cancelled_reservation": {
                          "$ref": "#/components/schemas/EventReservation"
                        },
                        "promoted_from_waitlist": {
                          "$ref": "#/components/schemas/EventReservation",
                          "nullable": true,
                          "description": "Bekleme listesinden yükseltilen üye (varsa)"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "success": true,
                  "message": "Rezervasyon başarıyla iptal edildi",
                  "data": {
                    "cancelled_reservation": {
                      "id": 101,
                      "member_id": 42,
                      "status": "cancelled",
                      "cancelled_at": "2024-01-14T10:00:00Z",
                      "cancellation_reason": "Üye hastalandı"
                    },
                    "promoted_from_waitlist": {
                      "id": 104,
                      "member_id": 55,
                      "status": "confirmed",
                      "promoted_at": "2024-01-14T10:00:05Z"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "İptal yapılamadı",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "tooLate": {
                    "summary": "Çok geç iptal",
                    "value": {
                      "success": false,
                      "message": "Etkinlik başlamasına 2 saatten az kaldı, iptal yapılamaz"
                    }
                  },
                  "alreadyCancelled": {
                    "summary": "Zaten iptal edilmiş",
                    "value": {
                      "success": false,
                      "message": "Bu rezervasyon zaten iptal edilmiş"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "404": {
            "description": "Rezervasyon bulunamadı",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "success": false,
                  "message": "Rezervasyon bulunamadı"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/calendar/events/{id}/waiting-list": {
      "get": {
        "summary": "Bekleme listesini görüntüle",
        "description": "Belirtilen etkinliğin bekleme listesini sıralı şekilde getirir.\nListe, ekleme zamanına göre sıralanır (FIFO).\n",
        "tags": [
          "Calendar"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Etkinlik ID",
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Bekleme listesi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "event": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "integer"
                            },
                            "title": {
                              "type": "string"
                            },
                            "capacity": {
                              "type": "integer"
                            },
                            "current_participants": {
                              "type": "integer"
                            }
                          }
                        },
                        "waiting_list": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/WaitingListEntry"
                          }
                        },
                        "total_waiting": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "event": {
                      "id": 1,
                      "title": "Sabah Yoga",
                      "capacity": 20,
                      "current_participants": 20
                    },
                    "waiting_list": [
                      {
                        "id": 201,
                        "position": 1,
                        "member": {
                          "id": 55,
                          "name": "Zeynep Kaya",
                          "email": "zeynep@example.com",
                          "phone": "533-222-3344"
                        },
                        "added_at": "2024-01-12T09:15:00Z",
                        "auto_promote": true
                      },
                      {
                        "id": 202,
                        "position": 2,
                        "member": {
                          "id": 67,
                          "name": "Emre Yıldız",
                          "email": "emre@example.com",
                          "phone": "534-333-4455"
                        },
                        "added_at": "2024-01-12T10:30:00Z",
                        "auto_promote": false
                      }
                    ],
                    "total_waiting": 2
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "404": {
            "description": "Etkinlik bulunamadı",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "success": false,
                  "message": "Etkinlik bulunamadı"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Bekleme listesine ekle",
        "description": "Üyeyi etkinliğin bekleme listesine ekler.\n\nSeçenekler:\n- **auto_promote**: true ise yer açıldığında otomatik yükseltilir\n- Bekleme listesi sırası ekleme zamanına göredir (FIFO)\n",
        "tags": [
          "Calendar"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Etkinlik ID",
            "example": 1
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "member_id"
                ],
                "properties": {
                  "member_id": {
                    "type": "integer",
                    "description": "Üye ID",
                    "example": 55
                  },
                  "auto_promote": {
                    "type": "boolean",
                    "description": "Yer açıldığında otomatik yükseltilsin mi?",
                    "default": true,
                    "example": true
                  },
                  "notes": {
                    "type": "string",
                    "description": "Bekleme listesi notu",
                    "example": "Acil durum, mümkünse öncelik verilsin"
                  }
                }
              },
              "examples": {
                "autoPromote": {
                  "summary": "Otomatik yükseltme ile",
                  "value": {
                    "member_id": 55,
                    "auto_promote": true
                  }
                },
                "manualOnly": {
                  "summary": "Manuel yükseltme",
                  "value": {
                    "member_id": 55,
                    "auto_promote": false,
                    "notes": "Sadece kesin katılabilirse arayın"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Bekleme listesine eklendi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Bekleme listesine eklendi"
                    },
                    "data": {
                      "$ref": "#/components/schemas/WaitingListEntry"
                    }
                  }
                },
                "example": {
                  "success": true,
                  "message": "Bekleme listesine eklendi",
                  "data": {
                    "id": 203,
                    "event_id": 1,
                    "member_id": 55,
                    "position": 3,
                    "auto_promote": true,
                    "added_at": "2024-01-12T11:00:00Z"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Geçersiz istek",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "alreadyInList": {
                    "summary": "Zaten listede",
                    "value": {
                      "success": false,
                      "message": "Bu üye zaten bekleme listesinde"
                    }
                  },
                  "hasReservation": {
                    "summary": "Rezervasyon var",
                    "value": {
                      "success": false,
                      "message": "Bu üyenin zaten onaylı rezervasyonu var"
                    }
                  },
                  "eventNotFull": {
                    "summary": "Etkinlik dolu değil",
                    "value": {
                      "success": false,
                      "message": "Etkinlikte boş yer var, doğrudan rezervasyon yapılabilir"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "404": {
            "description": "Etkinlik veya üye bulunamadı",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "success": false,
                  "message": "Etkinlik bulunamadı"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/calendar/events/{id}/promote-waiting": {
      "post": {
        "summary": "Bekleme listesinden yükselt",
        "description": "Bekleme listesindeki bir üyeyi etkinliğe dahil eder.\n\nYükseltme kuralları:\n- Belirli bir rezervasyon ID verilmezse sıradaki ilk üye yükseltilir\n- Etkinlikte yer olmalıdır\n- Yükseltilen üyeye bildirim gönderilir\n",
        "tags": [
          "Calendar"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Etkinlik ID",
            "example": 1
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "waiting_list_id": {
                    "type": "integer",
                    "description": "Yükseltilecek bekleme listesi kaydı ID (opsiyonel)",
                    "example": 201
                  },
                  "notify_member": {
                    "type": "boolean",
                    "description": "Üyeye bildirim gönderilsin mi?",
                    "default": true,
                    "example": true
                  }
                }
              },
              "examples": {
                "promoteFirst": {
                  "summary": "Sıradaki ilk üyeyi yükselt",
                  "value": {}
                },
                "promoteSpecific": {
                  "summary": "Belirli üyeyi yükselt",
                  "value": {
                    "waiting_list_id": 202,
                    "notify_member": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Üye başarıyla yükseltildi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Üye başarıyla etkinliğe eklendi"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "reservation": {
                          "$ref": "#/components/schemas/EventReservation"
                        },
                        "removed_from_waiting": {
                          "$ref": "#/components/schemas/WaitingListEntry"
                        },
                        "notification_sent": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "success": true,
                  "message": "Üye başarıyla etkinliğe eklendi",
                  "data": {
                    "reservation": {
                      "id": 105,
                      "event_id": 1,
                      "member_id": 55,
                      "status": "confirmed",
                      "reserved_at": "2024-01-14T15:00:00Z",
                      "promoted_from_waitlist": true
                    },
                    "removed_from_waiting": {
                      "id": 201,
                      "member_id": 55,
                      "position": 1
                    },
                    "notification_sent": true
                  }
                }
              }
            }
          },
          "400": {
            "description": "Yükseltme yapılamadı",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "eventFull": {
                    "summary": "Etkinlik dolu",
                    "value": {
                      "success": false,
                      "message": "Etkinlik kapasitesi dolu"
                    }
                  },
                  "emptyWaitlist": {
                    "summary": "Boş bekleme listesi",
                    "value": {
                      "success": false,
                      "message": "Bekleme listesinde üye yok"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "404": {
            "description": "Etkinlik veya bekleme kaydı bulunamadı",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "eventNotFound": {
                    "summary": "Etkinlik bulunamadı",
                    "value": {
                      "success": false,
                      "message": "Etkinlik bulunamadı"
                    }
                  },
                  "waitlistEntryNotFound": {
                    "summary": "Bekleme kaydı bulunamadı",
                    "value": {
                      "success": false,
                      "message": "Belirtilen bekleme listesi kaydı bulunamadı"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
