    "/api/trainer/programs": {
      "get": {
        "summary": "Antrenman programlarını listele",
        "description": "Eğitmenin oluşturduğu veya belirli bir üyeye ait antrenman programlarını listeler.\n\nFiltreleme seçenekleri:\n- Üye ID (member_id)\n- Program durumu (status)\n- Tarih aralığı\n\nSayfalama desteklenir.\n",
        "tags": [
          "WorkoutPrograms"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/PageParam"
          },
          {
            "$ref": "#/components/parameters/LimitParam"
          },
          {
            "in": "query",
            "name": "member_id",
            "schema": {
              "type": "integer"
            },
            "description": "Üye ID'sine göre filtrele",
            "example": 42
          },
          {
            "in": "query",
            "name": "status",
            "schema": {
              "type": "string",
              "enum": [
                "ACTIVE",
                "COMPLETED",
                "PAUSED",
                "DRAFT"
              ]
            },
            "description": "Program durumu filtresi",
            "example": "ACTIVE"
          },
          {
            "in": "query",
            "name": "start_date",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Başlangıç tarihi filtresi"
          },
          {
            "in": "query",
            "name": "search",
            "schema": {
              "type": "string"
            },
            "description": "Program adında arama"
          }
        ],
        "responses": {
          "200": {
            "description": "Program listesi başarıyla getirildi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/WorkoutProgram"
                      }
                    },
                    "pagination": {
                      "$ref": "#/components/schemas/Pagination"
                    }
                  }
                },
                "examples": {
                  "programList": {
                    "summary": "Program listesi",
                    "value": {
                      "success": true,
                      "data": [
                        {
                          "program_id": 1,
                          "name": "Kas Geliştirme Programı",
                          "description": "12 haftalık kas geliştirme programı",
                          "member": {
                            "user_id": 42,
                            "name": "Ahmet Yılmaz"
                          },
                          "trainer": {
                            "user_id": 5,
                            "name": "Can Demir"
                          },
                          "status": "ACTIVE",
                          "start_date": "2024-01-01",
                          "end_date": "2024-03-25",
                          "total_exercises": 24,
                          "total_days": 4,
                          "created_at": "2024-01-01T10:00:00Z"
                        },
                        {
                          "program_id": 2,
                          "name": "Kilo Verme Programı",
                          "description": "HIIT ve kardiyo ağırlıklı program",
                          "member": {
                            "user_id": 55,
                            "name": "Zeynep Kaya"
                          },
                          "trainer": {
                            "user_id": 5,
                            "name": "Can Demir"
                          },
                          "status": "ACTIVE",
                          "start_date": "2024-01-15",
                          "end_date": "2024-04-15",
                          "total_exercises": 18,
                          "total_days": 5
                        }
                      ],
                      "pagination": {
                        "page": 1,
                        "limit": 10,
                        "totalItems": 25,
                        "totalPages": 3
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      },
      "post": {
        "summary": "Yeni antrenman programı oluştur",
        "description": "Bir üye için yeni antrenman programı oluşturur.\n\nProgram oluşturulduktan sonra egzersizler ayrı endpoint üzerinden eklenir.\n\n**Zorunlu alanlar:**\n- name: Program adı\n- member_id: Hedef üye\n",
        "tags": [
          "WorkoutPrograms"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WorkoutProgramCreate"
              },
              "examples": {
                "basicProgram": {
                  "summary": "Temel program",
                  "value": {
                    "name": "Başlangıç Fitness Programı",
                    "member_id": 42,
                    "description": "Yeni başlayanlar için 8 haftalık temel fitness programı",
                    "start_date": "2024-02-01",
                    "end_date": "2024-03-28",
                    "goal": "Genel fitness ve kondisyon"
                  }
                },
                "advancedProgram": {
                  "summary": "Detaylı program",
                  "value": {
                    "name": "Yarışma Hazırlık Programı",
                    "member_id": 42,
                    "description": "Vücut geliştirme yarışmasına hazırlık programı",
                    "start_date": "2024-02-01",
                    "end_date": "2024-05-15",
                    "goal": "Yarışma kondisyonu",
                    "days_per_week": 6,
                    "notes": "- Kardiyo sabahları aç karna\n- Ağırlık antrenmanları öğleden sonra\n- Pazar aktif dinlenme\n"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Program başarıyla oluşturuldu",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Program başarıyla oluşturuldu"
                    },
                    "data": {
                      "$ref": "#/components/schemas/WorkoutProgram"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Geçersiz istek",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "missingFields": {
                    "summary": "Eksik alanlar",
                    "value": {
                      "success": false,
                      "message": "Zorunlu alanlar eksik: name, member_id"
                    }
                  },
                  "memberNotFound": {
                    "summary": "Üye bulunamadı",
                    "value": {
                      "success": false,
                      "message": "Belirtilen üye bulunamadı"
                    }
                  },
                  "invalidDates": {
                    "summary": "Geçersiz tarihler",
                    "value": {
                      "success": false,
                      "message": "Bitiş tarihi başlangıç tarihinden önce olamaz"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          }
        }
      }
    },
    "/api/trainer/programs/{id}": {
      "get": {
        "summary": "Program detayını getir",
        "description": "Belirtilen ID'ye sahip programın tüm detaylarını getirir.\nGünlere ayrılmış egzersizler, set/tekrar bilgileri ve ilerleme istatistikleri dahildir.\n",
