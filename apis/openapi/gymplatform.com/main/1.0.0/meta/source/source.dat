      "CalendarEvent": {
        "type": "object",
        "properties": {
          "event_id": {
            "type": "integer",
            "example": 1
          },
          "salon_id": {
            "type": "integer",
            "example": 1
          },
          "title": {
            "type": "string",
            "example": "Grup Yoga Dersi"
          },
          "description": {
            "type": "string",
            "example": "Başlangıç seviyesi yoga dersi"
          },
          "event_type": {
            "type": "string",
            "enum": [
              "CLASS",
              "PT_SESSION",
              "MEETING",
              "MAINTENANCE",
              "OTHER"
            ],
            "example": "CLASS"
          },
          "start_time": {
            "type": "string",
            "format": "date-time",
            "example": "2024-01-15T10:00:00Z"
          },
          "end_time": {
            "type": "string",
            "format": "date-time",
            "example": "2024-01-15T11:00:00Z"
          },
          "trainer_id": {
            "type": "integer",
            "nullable": true
          },
          "max_participants": {
            "type": "integer",
            "example": 20
          },
          "current_participants": {
            "type": "integer",
            "example": 15
          },
          "is_recurring": {
            "type": "boolean",
            "example": true
          },
          "recurrence_rule": {
            "type": "string",
            "nullable": true,
            "example": "FREQ=WEEKLY;BYDAY=MO,WE,FR"
          },
          "status": {
            "type": "string",
            "enum": [
              "SCHEDULED",
              "CANCELLED",
              "COMPLETED"
            ],
            "example": "SCHEDULED"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
