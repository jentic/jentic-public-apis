    "/api/admin/salons/{id}/toggle-active": {
      "put": {
        "summary": "Salon durumunu değiştir (aktif/pasif)",
        "description": "Salonun aktif durumunu tersine çevirir.\n\n**Pasife alma etkileri:**\n- Salon kullanıcıları giriş yapamaz\n- Yeni üye kaydı yapılamaz\n- Mevcut üyelikler etkilenmez ancak erişilemez\n\n**Aktife alma:**\n- Tüm erişimler yeniden açılır\n",
        "tags": [
          "Salons"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Salon ID",
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Salon durumu başarıyla değiştirildi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "salon_id": {
                          "type": "integer"
                        },
                        "is_active": {
                          "type": "boolean"
                        },
                        "affected_users": {
                          "type": "integer",
                          "description": "Etkilenen kullanıcı sayısı"
                        }
                      }
                    }
                  }
                },
                "examples": {
                  "deactivated": {
                    "summary": "Pasife alındı",
                    "value": {
                      "success": true,
                      "message": "Salon pasife alındı",
                      "data": {
                        "salon_id": 1,
