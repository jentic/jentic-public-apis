    "/api/superadmin/reports/salon-performance": {
      "get": {
        "summary": "Salon performans raporunu getir",
        "description": "Tüm salonların performans metriklerini karşılaştırmalı olarak getirir.\n\nMetrikler:\n- Toplam üye sayısı ve değişim\n- Aktif üye oranı\n- Aylık gelir\n- Üye başına ortalama gelir (ARPU)\n- Churn oranı (üye kaybı)\n- Seans kullanım oranları\n",
        "tags": [
          "SuperAdminReports"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "period",
            "schema": {
              "type": "string",
              "enum": [
                "this_month",
                "last_month",
                "this_quarter",
                "this_year",
                "custom"
              ],
              "default": "this_month"
            },
            "description": "Rapor dönemi"
          },
          {
            "in": "query",
            "name": "start_date",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Özel dönem başlangıç tarihi (period=custom ise)"
          },
          {
            "in": "query",
            "name": "end_date",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Özel dönem bitiş tarihi (period=custom ise)"
          },
          {
            "in": "query",
            "name": "sort_by",
            "schema": {
              "type": "string",
              "enum": [
                "revenue",
                "members",
                "growth",
                "churn"
              ],
              "default": "revenue"
            },
            "description": "Sıralama kriteri"
          },
          {
            "in": "query",
            "name": "salon_ids",
            "schema": {
              "type": "string"
            },
            "description": "Belirli salonları filtrele (virgülle ayrılmış ID'ler)",
            "example": "1,2,5"
          }
        ],
        "responses": {
          "200": {
            "description": "Salon performans raporu başarıyla getirildi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "period": {
                          "type": "object",
                          "properties": {
                            "start": {
                              "type": "string",
                              "format": "date"
                            },
                            "end": {
                              "type": "string",
                              "format": "date"
                            }
                          }
                        },
                        "platform_summary": {
                          "type": "object",
                          "properties": {
                            "total_salons": {
                              "type": "integer"
                            },
                            "active_salons": {
                              "type": "integer"
                            },
                            "total_revenue": {
                              "type": "number"
                            },
                            "total_members": {
                              "type": "integer"
                            },
                            "average_revenue_per_salon": {
                              "type": "number"
                            }
                          }
                        },
                        "salons": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "salon_id": {
                                "type": "integer"
                              },
                              "salon_name": {
                                "type": "string"
                              },
                              "metrics": {
                                "type": "object",
                                "properties": {
                                  "total_members": {
                                    "type": "integer"
                                  },
                                  "active_members": {
                                    "type": "integer"
                                  },
                                  "new_members": {
                                    "type": "integer"
                                  },
                                  "churned_members": {
                                    "type": "integer"
                                  },
                                  "churn_rate": {
                                    "type": "number"
                                  },
                                  "revenue": {
                                    "type": "number"
                                  },
                                  "arpu": {
                                    "type": "number"
                                  },
                                  "session_utilization": {
                                    "type": "number"
                                  }
                                }
                              },
                              "growth": {
                                "type": "object",
                                "properties": {
                                  "members_change": {
                                    "type": "number"
                                  },
                                  "revenue_change": {
                                    "type": "number"
                                  }
                                }
                              },
                              "rank": {
                                "type": "integer"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "period": {
                      "start": "2024-01-01",
                      "end": "2024-01-31"
                    },
                    "platform_summary": {
                      "total_salons": 15,
                      "active_salons": 14,
                      "total_revenue": 425000,
                      "total_members": 3500,
                      "average_revenue_per_salon": 30357
                    },
                    "salons": [
                      {
                        "salon_id": 1,
                        "salon_name": "FitLife Istanbul",
                        "metrics": {
                          "total_members": 450,
                          "active_members": 420,
                          "new_members": 35,
                          "churned_members": 12,
                          "churn_rate": 2.67,
                          "revenue": 58500,
                          "arpu": 139.29,
                          "session_utilization": 78.5
                        },
                        "growth": {
                          "members_change": 5.4,
                          "revenue_change": 8.2
                        },
                        "rank": 1
                      },
                      {
                        "salon_id": 2,
                        "salon_name": "PowerGym Ankara",
                        "metrics": {
                          "total_members": 320,
                          "active_members": 290,
                          "new_members": 22,
                          "churned_members": 18,
                          "churn_rate": 5.63,
                          "revenue": 42000,
                          "arpu": 144.83,
                          "session_utilization": 65.2
                        },
                        "growth": {
                          "members_change": 1.2,
                          "revenue_change": -2.5
                        },
                        "rank": 2
                      }
                    ]
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          }
        }
      }
    },
    "/api/superadmin/reports/financial-summary": {
      "get": {
        "summary": "Finansal özet raporunu getir",
        "description": "Platform genelinde finansal özet ve trend verilerini getirir.\n\nİçerik:\n- Toplam gelir ve değişim\n- Gelir kırılımı (üyelik, PT, ürün satışı vb.)\n- Salon bazlı gelir dağılımı\n- Ödeme yöntemlerine göre dağılım\n- Gecikmiş ödemeler\n- Aylık/haftalık trendler\n",
        "tags": [
          "SuperAdminReports"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "period",
            "schema": {
              "type": "string",
              "enum": [
                "this_month",
                "last_month",
                "this_quarter",
                "this_year",
                "custom"
              ],
              "default": "this_month"
            },
            "description": "Rapor dönemi"
          },
          {
            "in": "query",
            "name": "start_date",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Özel dönem başlangıç tarihi"
          },
          {
            "in": "query",
            "name": "end_date",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Özel dönem bitiş tarihi"
          },
          {
            "in": "query",
            "name": "group_by",
            "schema": {
              "type": "string",
              "enum": [
                "day",
                "week",
                "month"
              ],
              "default": "week"
            },
            "description": "Trend verilerini gruplama"
          }
        ],
        "responses": {
          "200": {
            "description": "Finansal özet raporu başarıyla getirildi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "period": {
                          "type": "object",
                          "properties": {
                            "start": {
                              "type": "string",
                              "format": "date"
                            },
                            "end": {
                              "type": "string",
                              "format": "date"
                            }
                          }
                        },
                        "summary": {
                          "type": "object",
                          "properties": {
                            "total_revenue": {
                              "type": "number"
                            },
                            "previous_period_revenue": {
                              "type": "number"
                            },
                            "revenue_change": {
                              "type": "number"
                            },
                            "revenue_change_percentage": {
                              "type": "number"
                            },
                            "total_transactions": {
                              "type": "integer"
                            },
                            "average_transaction": {
                              "type": "number"
                            }
                          }
                        },
                        "by_category": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "category": {
                                "type": "string"
                              },
                              "amount": {
                                "type": "number"
                              },
                              "percentage": {
                                "type": "number"
                              },
                              "transaction_count": {
                                "type": "integer"
                              }
                            }
                          }
                        },
                        "by_payment_method": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "method": {
                                "type": "string"
                              },
                              "amount": {
                                "type": "number"
                              },
                              "percentage": {
                                "type": "number"
                              }
                            }
                          }
                        },
                        "by_salon": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "salon_id": {
                                "type": "integer"
                              },
                              "salon_name": {
                                "type": "string"
                              },
                              "revenue": {
                                "type": "number"
                              },
                              "percentage": {
                                "type": "number"
                              }
                            }
                          }
                        },
                        "overdue_payments": {
                          "type": "object",
                          "properties": {
                            "total_amount": {
                              "type": "number"
                            },
                            "count": {
                              "type": "integer"
                            }
                          }
                        },
                        "trends": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "period": {
                                "type": "string"
                              },
                              "revenue": {
                                "type": "number"
                              },
                              "transactions": {
                                "type": "integer"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
