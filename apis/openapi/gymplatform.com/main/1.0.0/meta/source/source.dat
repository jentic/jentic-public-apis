            "in": "path",
            "required": true,
            "description": "Güncellenecek paket ID'si",
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "example": 1
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PackageCreate"
              },
              "examples": {
                "priceUpdate": {
                  "summary": "Fiyat güncelleme",
                  "value": {
                    "price": 550
                  }
                },
                "fullUpdate": {
                  "summary": "Tam güncelleme",
                  "value": {
                    "name": "Aylık Üyelik (Güncellendi)",
                    "description": "Yenilenmiş tüm erişim paketi",
                    "price": 600,
                    "max_freezes": 2
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Paket başarıyla güncellendi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Paket bilgileri güncellendi"
                    },
                    "data": {
                      "$ref": "#/components/schemas/MembershipPackage"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "delete": {
        "summary": "Paketi sil",
        "description": "Belirtilen paketi sistemden siler.\n\n**Yetki:** Sadece Admin\n\n**Uyarı:** Aktif abonelikleri olan paketler silinemez!\nÖnce paketi pasif duruma getirin.\n",
        "tags": [
          "Packages"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Silinecek paket ID'si",
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Paket başarıyla silindi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Paket başarıyla silindi"
                    }
                  }
                }
              }
