    "/api/admin/packages/{id}/toggle-active": {
      "put": {
        "summary": "Paket durumunu değiştir (aktif/pasif)",
        "description": "Paketin aktif/pasif durumunu tersine çevirir.\n\n**Yetki:** Sadece Admin\n\n**Kullanım Senaryoları:**\n- Paketi satıştan kaldırmak için pasif yapın\n- Silmek yerine pasif yapmak daha güvenlidir (abonelik geçmişi korunur)\n",
        "tags": [
          "Packages"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Durumu değiştirilecek paket ID'si",
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Paket durumu başarıyla değiştirildi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Paket aktif duruma getirildi"
                    },
                    "data": {
                      "$ref": "#/components/schemas/MembershipPackage"
                    }
                  }
                },
                "examples": {
                  "activated": {
                    "summary": "Paket aktifleştirildi",
                    "value": {
                      "success": true,
                      "message": "Paket aktif duruma getirildi",
                      "data": {
                        "package_id": 1,
                        "name": "Aylık Üyelik",
                        "is_active": true
                      }
                    }
                  },
                  "deactivated": {
                    "summary": "Paket pasifleştirildi",
                    "value": {
                      "success": true,
                      "message": "Paket pasif duruma getirildi",
