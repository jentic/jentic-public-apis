    "/api/admin/calendar/events/{id}/reserve": {
      "post": {
        "summary": "Etkinliğe rezervasyon yap",
        "description": "Belirtilen etkinliğe rezervasyon oluşturur.\n\nKurallar:\n- Etkinlik kapasitesi doluysa bekleme listesine eklenebilir\n- Aynı üye aynı etkinliğe birden fazla rezervasyon yapamaz\n- Geçmiş tarihli etkinliklere rezervasyon yapılamaz\n- Üyelik durumu aktif olmalıdır\n",
        "tags": [
          "Calendar"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Etkinlik ID",
            "example": 1
          }
        ],
        "requestBody": {
          "required": true,
