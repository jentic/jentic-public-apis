    "/api/admin/analytics/overview": {
      "get": {
        "summary": "Dashboard genel KPI'ları getir",
        "description": "Dashboard için temel performans göstergelerini getirir.\nÜye sayıları, gelir özeti ve günlük istatistikler dahildir.\n\n**Yetki:** Admin veya Eğitmen\n\n**Dönen Veriler:**\n- Toplam/aktif üye sayısı\n- Bu ayki gelir\n- Süresi dolmak üzere olan abonelikler\n- Bugünkü giriş sayısı\n",
        "tags": [
          "Analytics"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Dashboard KPI'ları başarıyla getirildi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/DashboardKPIs"
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "totalMembers": 150,
                    "activeMembers": 120,
                    "newMembersThisMonth": 15,
                    "totalRevenue": 75000,
                    "monthlyRevenue": 25000,
                    "expiringSoon": 8,
                    "todayCheckins": 45,
                    "activeTrainers": 5,
                    "pendingPayments": 3,
                    "frozenSubscriptions": 5
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/api/admin/analytics/financial-trend": {
      "get": {
        "summary": "Finansal trend verilerini getir",
        "description": "Belirli bir dönem için gelir ve gider trendlerini getirir.\nGrafik çizimi için time-series formatında veri döner.\n\n**Yetki:** Sadece Admin\n\n**Dönen Veriler:**\n- Günlük/haftalık/aylık gelir\n- Günlük/haftalık/aylık gider\n- Net kar/zarar\n- Karşılaştırmalı veriler (önceki dönem)\n",
        "tags": [
          "Analytics"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/StartDateParam"
          },
          {
            "$ref": "#/components/parameters/EndDateParam"
          },
          {
            "name": "groupBy",
            "in": "query",
            "description": "Gruplama periyodu",
            "schema": {
              "type": "string",
              "enum": [
                "day",
                "week",
                "month"
              ],
              "default": "day"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Finansal trend verileri başarıyla getirildi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "summary": {
                          "type": "object",
                          "properties": {
                            "totalRevenue": {
                              "type": "number",
                              "example": 75000
                            },
                            "totalExpenses": {
                              "type": "number",
                              "example": 45000
                            },
                            "netProfit": {
                              "type": "number",
                              "example": 30000
                            },
                            "revenueChange": {
                              "type": "number",
                              "description": "Önceki döneme göre değişim yüzdesi",
                              "example": 12.5
                            }
                          }
                        },
                        "chartData": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "date": {
                                "type": "string",
                                "format": "date"
                              },
                              "revenue": {
                                "type": "number"
                              },
                              "expenses": {
                                "type": "number"
                              },
                              "profit": {
                                "type": "number"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "summary": {
                      "totalRevenue": 75000,
                      "totalExpenses": 45000,
                      "netProfit": 30000,
                      "revenueChange": 12.5
                    },
                    "chartData": [
                      {
                        "date": "2024-01-01",
                        "revenue": 2500,
                        "expenses": 1500,
                        "profit": 1000
                      },
                      {
                        "date": "2024-01-02",
                        "revenue": 3000,
                        "expenses": 1200,
                        "profit": 1800
                      }
                    ]
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/api/admin/analytics/member-stats": {
      "get": {
        "summary": "Üye istatistiklerini getir",
        "description": "Üye büyüme, dağılım ve retention istatistiklerini getirir.\n\n**Yetki:** Sadece Admin\n\n**Dönen Veriler:**\n- Üye büyüme grafiği\n- Cinsiyet dağılımı\n- Yaş dağılımı\n- Abonelik durumu dağılımı\n- Retention oranı\n",
