    "/api/admin/salons": {
      "get": {
        "summary": "Tüm salonları listele",
        "description": "Platform'daki tüm salonları sayfalama ve arama destekli listeler.\nSadece SUPER_ADMIN yetkisi ile erişilebilir.\n\nFiltreleme seçenekleri:\n- İsim araması\n- Durum filtresi (aktif/pasif)\n- Şehir filtresi\n",
        "tags": [
          "Salons"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/PageParam"
          },
          {
            "$ref": "#/components/parameters/LimitParam"
          },
          {
            "in": "query",
            "name": "search",
            "schema": {
              "type": "string"
            },
            "description": "Salon adı veya sahip adında arama",
            "example": "FitLife"
          },
          {
            "in": "query",
            "name": "status",
            "schema": {
              "type": "string",
              "enum": [
                "active",
                "inactive",
                "all"
              ],
              "default": "all"
            },
            "description": "Durum filtresi"
          },
          {
            "in": "query",
            "name": "city",
            "schema": {
              "type": "string"
            },
            "description": "Şehir filtresi",
            "example": "Istanbul"
          },
          {
            "in": "query",
            "name": "sort_by",
            "schema": {
              "type": "string",
              "enum": [
                "name",
                "created_at",
                "member_count",
                "revenue"
              ],
              "default": "created_at"
            },
            "description": "Sıralama kriteri"
          },
          {
            "in": "query",
            "name": "sort_order",
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ],
              "default": "desc"
            },
            "description": "Sıralama yönü"
          }
        ],
        "responses": {
          "200": {
            "description": "Salon listesi başarıyla getirildi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Salon"
                      }
                    },
                    "pagination": {
                      "$ref": "#/components/schemas/Pagination"
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": [
                    {
                      "salon_id": 1,
                      "name": "FitLife Istanbul",
                      "owner_name": "Mehmet Yılmaz",
                      "owner_email": "mehmet@fitlife.com",
                      "phone": "+90 532 123 4567",
                      "address": "Levent Mah. No:15, Beşiktaş",
                      "city": "Istanbul",
                      "is_active": true,
                      "stats": {
                        "total_members": 450,
                        "active_members": 420,
                        "total_trainers": 12,
                        "monthly_revenue": 58500
                      },
                      "created_at": "2023-06-15T10:00:00Z"
                    },
                    {
                      "salon_id": 2,
                      "name": "PowerGym Ankara",
                      "owner_name": "Ali Demir",
                      "owner_email": "ali@powergym.com",
                      "phone": "+90 533 234 5678",
                      "address": "Kızılay Mah. No:42, Çankaya",
                      "city": "Ankara",
                      "is_active": true,
                      "stats": {
                        "total_members": 320,
                        "active_members": 290,
                        "total_trainers": 8,
                        "monthly_revenue": 42000
                      },
                      "created_at": "2023-08-20T14:30:00Z"
                    }
                  ],
                  "pagination": {
                    "page": 1,
                    "limit": 10,
                    "totalItems": 15,
                    "totalPages": 2
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          }
        }
      },
      "post": {
        "summary": "Yeni salon oluştur",
        "description": "Platforma yeni bir salon ekler.\nSalon oluşturulduğunda otomatik olarak admin kullanıcısı da oluşturulur.\n\n**Zorunlu alanlar:**\n- name: Salon adı\n- owner_name: Salon sahibi adı\n- owner_email: Salon sahibi email (admin hesabı için)\n- phone: İletişim telefonu\n",
        "tags": [
          "Salons"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SalonCreate"
              },
              "examples": {
                "basicSalon": {
                  "summary": "Temel salon",
                  "value": {
                    "name": "New Gym Istanbul",
                    "owner_name": "Ahmet Yılmaz",
                    "owner_email": "ahmet@newgym.com",
                    "phone": "+90 532 111 2233",
                    "address": "Kadıköy, Istanbul",
                    "city": "Istanbul"
                  }
                },
                "fullSalon": {
                  "summary": "Detaylı salon",
                  "value": {
                    "name": "Premium Fitness Center",
                    "owner_name": "Mehmet Demir",
                    "owner_email": "mehmet@premiumfitness.com",
                    "owner_password": "securePassword123",
                    "phone": "+90 533 222 3344",
                    "address": "Nişantaşı Mah. No:42, Şişli",
                    "city": "Istanbul",
                    "logo_url": "https://example.com/logo.png",
                    "website": "https://premiumfitness.com",
                    "working_hours": {
                      "weekdays": "06:00-23:00",
                      "weekends": "08:00-22:00"
                    },
                    "capacity": 200,
                    "features": [
                      "Sauna",
                      "Havuz",
                      "Spa"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Salon başarıyla oluşturuldu",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Salon başarıyla oluşturuldu"
                    },
                    "data": {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/Salon"
                        },
                        {
                          "type": "object",
                          "properties": {
                            "admin_user": {
                              "type": "object",
                              "properties": {
                                "user_id": {
                                  "type": "integer"
                                },
                                "email": {
                                  "type": "string"
                                },
                                "temporary_password": {
                                  "type": "string",
                                  "description": "İlk giriş için geçici şifre (email ile de gönderilir)"
                                }
                              }
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Geçersiz istek",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "missingFields": {
                    "summary": "Eksik alanlar",
                    "value": {
                      "success": false,
                      "message": "Zorunlu alanlar eksik: name, owner_email"
                    }
                  },
                  "emailExists": {
                    "summary": "Email zaten kayıtlı",
                    "value": {
                      "success": false,
                      "message": "Bu email adresi zaten kayıtlı"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          }
        }
      }
    },
