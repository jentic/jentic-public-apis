                            },
                            "newMembersThisMonth": {
                              "type": "integer",
                              "example": 3
                            },
                            "lostMembersThisMonth": {
                              "type": "integer",
                              "example": 1
                            },
                            "totalPTSessions": {
                              "type": "integer",
                              "example": 120
                            },
                            "completedPTSessions": {
                              "type": "integer",
                              "example": 100
                            },
                            "retentionRate": {
                              "type": "number",
                              "example": 85.5
                            },
                            "averageSessionsPerMember": {
                              "type": "number",
