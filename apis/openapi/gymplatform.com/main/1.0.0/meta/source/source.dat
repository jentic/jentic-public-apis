                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Egzersiz başarıyla silindi"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Silme işlemi başarısız",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "success": false,
