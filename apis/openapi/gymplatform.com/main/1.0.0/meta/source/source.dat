    "/api/auth/register": {
      "post": {
        "summary": "Yeni salon ve admin kullanıcı kaydı",
        "description": "Yeni bir salon oluşturur ve salon için admin kullanıcı kaydeder.\nBu endpoint herkese açıktır ve kimlik doğrulama gerektirmez.\n\n**Not:** Her kayıt işlemi benzersiz bir salon oluşturur.\n",
        "tags": [
          "Auth"
        ],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              },
              "examples": {
                "basic": {
                  "summary": "Temel kayıt",
                  "value": {
                    "salon_name": "Fitness Plus",
                    "owner_name": "Mehmet Kaya",
                    "email": "info@fitnessplus.com",
                    "password": "securePassword123"
                  }
                },
                "withPhone": {
                  "summary": "Telefon ile kayıt",
                  "value": {
                    "salon_name": "Power Gym",
                    "owner_name": "Ali Yıldız",
                    "email": "info@powergym.com",
                    "password": "myPassword456",
                    "phone": "05551234567"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Salon ve kullanıcı başarıyla oluşturuldu",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Salon başarıyla oluşturuldu"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "token": {
                          "type": "string",
                          "description": "JWT access token",
                          "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                        },
                        "user": {
                          "$ref": "#/components/schemas/User"
                        },
                        "salon": {
                          "$ref": "#/components/schemas/Salon"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Geçersiz istek - Eksik veya hatalı parametreler",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                },
                "examples": {
                  "emailExists": {
                    "summary": "E-posta zaten kayıtlı",
                    "value": {
                      "success": false,
                      "message": "Bu e-posta adresi zaten kayıtlı"
                    }
                  },
                  "missingFields": {
                    "summary": "Eksik alanlar",
                    "value": {
                      "success": false,
                      "message": "Doğrulama hatası",
                      "errors": [
                        {
                          "msg": "Salon adı zorunludur",
                          "path": "salon_name"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Kullanıcı girişi",
        "description": "E-posta ve şifre ile kullanıcı girişi yapar.\nBaşarılı girişte JWT token ve kullanıcı bilgileri döner.\n\n**Token Kullanımı:**\n- Dönen token'ı tüm korumalı endpoint'lerde `Authorization: Bearer <token>` header'ında kullanın\n- Token'ın geçerlilik süresi dolduğunda `/api/auth/refresh-token` endpoint'ini kullanarak yenileyin\n",
        "tags": [
          "Auth"
        ],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              },
              "examples": {
                "admin": {
                  "summary": "Admin girişi",
                  "value": {
                    "email": "admin@fitnessplus.com",
                    "password": "password123"
                  }
                },
                "trainer": {
                  "summary": "Eğitmen girişi",
                  "value": {
                    "email": "trainer@fitnessplus.com",
                    "password": "trainerPass"
                  }
                },
                "member": {
                  "summary": "Üye girişi",
                  "value": {
                    "email": "member@example.com",
                    "password": "memberPass"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Giriş başarılı",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                },
                "example": {
                  "success": true,
                  "data": {
                    "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VyX2lkIjoxLCJpYXQiOjE3MDQ...",
                    "refreshToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VyX2lkIjoxLCJ0eXBlIjoicmVm...",
                    "user": {
                      "user_id": 1,
                      "salon_id": 1,
                      "role": "ADMIN",
                      "first_name": "Mehmet",
                      "last_name": "Kaya",
                      "email": "admin@fitnessplus.com",
                      "phone": "05551234567",
                      "is_active": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "description": "Kimlik doğrulama hatası",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "invalidCredentials": {
                    "summary": "Geçersiz kimlik bilgileri",
                    "value": {
                      "success": false,
                      "message": "E-posta veya şifre hatalı"
                    }
                  },
                  "userNotFound": {
                    "summary": "Kullanıcı bulunamadı",
                    "value": {
                      "success": false,
                      "message": "Bu e-posta adresiyle kayıtlı kullanıcı bulunamadı"
                    }
                  },
                  "inactiveUser": {
                    "summary": "Pasif kullanıcı",
                    "value": {
                      "success": false,
                      "message": "Hesabınız pasif durumda. Lütfen yöneticiyle iletişime geçin."
                    }
                  },
                  "inactiveSalon": {
                    "summary": "Pasif salon",
                    "value": {
                      "success": false,
                      "message": "Salonunuz pasif durumda. Lütfen yöneticiyle iletişime geçin."
                    }
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "summary": "Mevcut kullanıcı bilgilerini getir",
        "description": "Giriş yapmış kullanıcının detaylı bilgilerini döner.\nSalon bilgileri ve ilişkili veriler de dahildir.\n",
        "tags": [
          "Auth"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Kullanıcı bilgileri başarıyla getirildi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/User"
                        },
                        {
                          "type": "object",
                          "properties": {
                            "salon": {
                              "$ref": "#/components/schemas/Salon"
                            }
                          }
                        }
                      ]
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "user_id": 1,
                    "salon_id": 1,
                    "role": "ADMIN",
                    "first_name": "Mehmet",
                    "last_name": "Kaya",
                    "email": "admin@fitnessplus.com",
                    "phone": "05551234567",
                    "is_active": true,
                    "created_at": "2024-01-01T10:00:00Z",
                    "salon": {
                      "salon_id": 1,
                      "name": "Fitness Plus",
                      "is_active": true
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/api/auth/refresh-token": {
      "post": {
        "summary": "Access token yenileme",
        "description": "Refresh token kullanarak yeni bir access token alır.\n\n**Kullanım Senaryosu:**\n- Access token süresi dolduğunda bu endpoint'i çağırın\n- Yeni access token ile isteklerinize devam edin\n- Refresh token da geçersizse kullanıcıyı tekrar login'e yönlendirin\n",
        "tags": [
          "Auth"
        ],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenRequest"
              },
              "example": {
                "refreshToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VyX2lkIjoxLCJ0eXBlIjoicmVmcmVzaCIsImlhdCI6MTcwNH0..."
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token başarıyla yenilendi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "token": {
                          "type": "string",
                          "description": "Yeni JWT access token",
                          "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                        },
                        "refreshToken": {
                          "type": "string",
                          "description": "Yeni refresh token (opsiyonel - rotation açıksa)",
                          "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Geçersiz veya süresi dolmuş refresh token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "invalidToken": {
                    "summary": "Geçersiz token",
                    "value": {
                      "success": false,
                      "message": "Geçersiz refresh token"
                    }
                  },
                  "expiredToken": {
                    "summary": "Süresi dolmuş token",
                    "value": {
                      "success": false,
                      "message": "Refresh token süresi dolmuş. Lütfen tekrar giriş yapın."
                    }
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "summary": "Kullanıcı çıkışı",
        "description": "Kullanıcının oturumunu sonlandırır.\nServer tarafında token'ı geçersiz kılar (blacklist'e ekler).\n\n**Not:** Client tarafında da token'ı silmeyi unutmayın.\n",
        "tags": [
          "Auth"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Çıkış başarılı",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Başarıyla çıkış yapıldı"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
