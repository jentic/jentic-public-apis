    "/api/admin/subscriptions/expiring": {
      "get": {
        "summary": "Süresi dolmak üzere olan abonelikleri listele",
        "description": "Önümüzdeki 7 gün içinde süresi dolacak abonelikleri listeler.\nYenileme hatırlatmaları için kullanılır.\n\n**Yetki:** Sadece Admin\n",
        "tags": [
          "Subscriptions"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "description": "Kaç gün içinde biten abonelikler (varsayılan 7)",
            "schema": {
              "type": "integer",
              "default": 7,
              "minimum": 1,
              "maximum": 30
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Süresi dolmak üzere olan abonelikler",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "allOf": [
                          {
                            "$ref": "#/components/schemas/MemberSubscription"
                          },
                          {
                            "type": "object",
                            "properties": {
                              "daysRemaining": {
                                "type": "integer",
                                "description": "Kalan gün sayısı",
                                "example": 3
                              }
                            }
                          }
                        ]
                      }
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": [
                    {
                      "subscription_id": 10,
                      "user_id": 5,
                      "end_date": "2024-01-20",
                      "status": "ACTIVE",
                      "daysRemaining": 3,
                      "member": {
                        "user_id": 5,
                        "first_name": "Ahmet",
                        "last_name": "Yılmaz",
                        "phone": "05551234567"
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/api/admin/subscriptions": {
      "get": {
        "summary": "Tüm abonelikleri listele",
        "description": "Salona ait tüm abonelikleri sayfalama ve filtreleme ile listeler.\n\n**Yetki:** Admin veya Eğitmen\n\n**Filtreleme:**\n- `status`: ACTIVE, EXPIRED, FROZEN, CANCELLED\n- `member_id`: Belirli üyenin abonelikleri\n- `package_id`: Belirli paketteki abonelikler\n",
        "tags": [
          "Subscriptions"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/PageParam"
          },
          {
            "$ref": "#/components/parameters/LimitParam"
          },
          {
            "name": "status",
            "in": "query",
            "description": "Abonelik durumu filtresi",
            "schema": {
              "type": "string",
              "enum": [
                "ACTIVE",
                "EXPIRED",
                "FROZEN",
                "CANCELLED"
              ]
            }
          },
          {
            "name": "member_id",
            "in": "query",
            "description": "Üye ID filtresi",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "package_id",
            "in": "query",
            "description": "Paket ID filtresi",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Abonelik listesi başarıyla getirildi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/MemberSubscription"
                      }
                    },
                    "pagination": {
                      "$ref": "#/components/schemas/Pagination"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "post": {
        "summary": "Yeni abonelik oluştur (paket satışı)",
        "description": "Üyeye yeni bir abonelik (paket satışı) oluşturur.\n\n**Yetki:** Sadece Admin\n\n**Otomatik İşlemler:**\n- Bitiş tarihi paket süresine göre hesaplanır\n- PT seansları paketten aktarılır\n- Ödeme kaydı oluşturulur (opsiyonel)\n\n**Uyarı:** Üyenin aktif aboneliği varsa yeni abonelik mevcut bitiş tarihinden itibaren başlar.\n",
        "tags": [
          "Subscriptions"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubscriptionCreate"
              },
              "examples": {
                "basic": {
                  "summary": "Temel abonelik",
                  "value": {
                    "user_id": 5,
                    "package_id": 1,
                    "start_date": "2024-01-15"
                  }
                },
                "withPayment": {
                  "summary": "Ödeme ile abonelik",
                  "value": {
                    "user_id": 5,
                    "package_id": 2,
                    "start_date": "2024-01-15",
                    "price_paid": 2000,
                    "payment_status": "PAID"
                  }
                },
                "partialPayment": {
                  "summary": "Kısmi ödeme ile",
                  "value": {
                    "user_id": 5,
                    "package_id": 1,
                    "start_date": "2024-01-15",
                    "price_paid": 250,
                    "payment_status": "PARTIAL"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Abonelik başarıyla oluşturuldu",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Abonelik başarıyla oluşturuldu"
                    },
                    "data": {
                      "$ref": "#/components/schemas/MemberSubscription"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Doğrulama hatası",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                },
                "examples": {
                  "memberNotFound": {
                    "summary": "Üye bulunamadı",
                    "value": {
                      "success": false,
                      "message": "Belirtilen üye bulunamadı"
                    }
                  },
                  "packageNotFound": {
                    "summary": "Paket bulunamadı",
                    "value": {
                      "success": false,
                      "message": "Belirtilen paket bulunamadı veya aktif değil"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/api/admin/subscriptions/{id}": {
      "put": {
        "summary": "Abonelik bilgilerini güncelle",
        "description": "Belirtilen aboneliğin bilgilerini günceller.\n\n**Yetki:** Sadece Admin\n\n**Güncellenebilir Alanlar:**\n- Bitiş tarihi\n- Ödeme durumu\n- Kalan PT seansları\n",
        "tags": [
          "Subscriptions"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Abonelik ID'si",
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "example": 10
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "end_date": {
                    "type": "string",
                    "format": "date",
                    "description": "Yeni bitiş tarihi"
                  },
                  "remaining_pt_sessions": {
                    "type": "integer",
                    "description": "Kalan PT seans sayısı"
                  },
                  "payment_status": {
                    "type": "string",
                    "enum": [
                      "PENDING",
                      "PARTIAL",
                      "PAID"
                    ]
                  }
                }
              },
              "example": {
                "end_date": "2024-02-15",
                "payment_status": "PAID"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Abonelik başarıyla güncellendi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Abonelik bilgileri güncellendi"
                    },
                    "data": {
                      "$ref": "#/components/schemas/MemberSubscription"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/api/admin/subscriptions/{id}/cancel": {
      "put": {
        "summary": "Aboneliği iptal et",
        "description": "Belirtilen aboneliği iptal eder.\n\n**Yetki:** Sadece Admin\n\n**Uyarı:** İptal edilen abonelik geri alınamaz!\nİade işlemi ayrıca yapılmalıdır.\n",
