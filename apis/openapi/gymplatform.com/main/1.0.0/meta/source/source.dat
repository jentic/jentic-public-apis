              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/api/admin/subscriptions/{id}/freeze": {
      "put": {
        "summary": "Aboneliği dondur",
        "description": "Belirtilen aboneliği geçici olarak dondurur.\nDondurma süresi boyunca abonelik süresi işlemez.\n\n**Yetki:** Sadece Admin\n\n**Kurallar:**\n- Paketin izin verdiği dondurma hakkı kadar dondurulabilir\n- Maksimum dondurma süresi pakette tanımlıdır\n- Sadece ACTIVE durumundaki abonelikler dondurulabilir\n",
        "tags": [
          "Subscriptions"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Dondurulacak abonelik ID'si",
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "example": 10
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "freeze_days"
                ],
                "properties": {
                  "freeze_days": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Dondurma süresi (gün)",
                    "example": 7
                  },
                  "reason": {
                    "type": "string",
                    "description": "Dondurma nedeni",
                    "example": "Tatil"
                  }
                }
              },
              "example": {
                "freeze_days": 7,
                "reason": "Tatil"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Abonelik başarıyla donduruldu",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Abonelik 7 gün süreyle donduruldu"
                    },
                    "data": {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/MemberSubscription"
                        },
                        {
                          "type": "object",
                          "properties": {
                            "freeze_end_date": {
                              "type": "string",
                              "format": "date",
                              "example": "2024-01-22"
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Dondurma başarısız",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "noFreezeRight": {
                    "summary": "Dondurma hakkı yok",
                    "value": {
                      "success": false,
                      "message": "Dondurma hakkınız kalmamıştır"
                    }
                  },
                  "maxDaysExceeded": {
                    "summary": "Maksimum süre aşıldı",
                    "value": {
                      "success": false,
                      "message": "Maksimum dondurma süresi 14 gündür"
                    }
                  },
                  "notActive": {
                    "summary": "Abonelik aktif değil",
                    "value": {
                      "success": false,
                      "message": "Sadece aktif abonelikler dondurulabilir"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/api/admin/subscriptions/{id}/unfreeze": {
      "put": {
        "summary": "Abonelik dondurmasını kaldır",
