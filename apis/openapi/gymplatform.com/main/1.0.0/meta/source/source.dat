    "/api/superadmin/reports/user-activity": {
      "get": {
        "summary": "Kullanıcı aktivite raporunu getir",
        "description": "Platform genelinde kullanıcı aktivite metriklerini getirir.\n\nMetrikler:\n- Aktif kullanıcı sayıları (DAU, WAU, MAU)\n- Kullanıcı rollere göre dağılım\n- Giriş istatistikleri\n- En aktif kullanıcılar\n- Aktivite trendleri\n",
        "tags": [
          "SuperAdminReports"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "period",
            "schema": {
              "type": "string",
              "enum": [
                "today",
                "this_week",
                "this_month",
                "custom"
              ],
              "default": "this_week"
            },
            "description": "Rapor dönemi"
          },
          {
            "in": "query",
            "name": "start_date",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Özel dönem başlangıç tarihi"
          },
          {
            "in": "query",
            "name": "end_date",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Özel dönem bitiş tarihi"
          },
          {
            "in": "query",
            "name": "salon_id",
            "schema": {
              "type": "integer"
            },
            "description": "Belirli salon için filtrele"
          }
        ],
        "responses": {
          "200": {
            "description": "Kullanıcı aktivite raporu başarıyla getirildi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "active_users": {
                          "type": "object",
                          "properties": {
                            "dau": {
                              "type": "integer",
                              "description": "Günlük aktif kullanıcı"
                            },
                            "wau": {
                              "type": "integer",
                              "description": "Haftalık aktif kullanıcı"
                            },
                            "mau": {
                              "type": "integer",
                              "description": "Aylık aktif kullanıcı"
                            }
                          }
                        },
                        "by_role": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "role": {
                                "type": "string"
                              },
                              "total": {
                                "type": "integer"
                              },
                              "active": {
                                "type": "integer"
                              },
                              "percentage": {
                                "type": "number"
                              }
                            }
                          }
                        },
                        "checkin_stats": {
                          "type": "object",
                          "properties": {
                            "total_checkins": {
                              "type": "integer"
                            },
                            "average_per_day": {
                              "type": "number"
                            },
                            "peak_hours": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "hour": {
                                    "type": "integer"
                                  },
                                  "count": {
                                    "type": "integer"
                                  }
                                }
                              }
                            }
                          }
                        },
                        "most_active_users": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "user_id": {
                                "type": "integer"
                              },
                              "name": {
                                "type": "string"
                              },
                              "salon_name": {
                                "type": "string"
                              },
                              "checkin_count": {
                                "type": "integer"
                              },
                              "last_activity": {
                                "type": "string",
                                "format": "date-time"
                              }
                            }
                          }
                        },
                        "trends": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "date": {
                                "type": "string",
                                "format": "date"
                              },
                              "active_users": {
                                "type": "integer"
                              },
                              "checkins": {
                                "type": "integer"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "active_users": {
                      "dau": 1250,
                      "wau": 2800,
                      "mau": 3500
                    },
                    "by_role": [
                      {
                        "role": "MEMBER",
                        "total": 3200,
                        "active": 2650,
                        "percentage": 82.8
                      },
                      {
                        "role": "TRAINER",
                        "total": 180,
                        "active": 165,
                        "percentage": 91.7
                      },
                      {
                        "role": "ADMIN",
                        "total": 35,
                        "active": 35,
                        "percentage": 100
                      }
                    ],
                    "checkin_stats": {
                      "total_checkins": 8500,
                      "average_per_day": 1214,
                      "peak_hours": [
                        {
                          "hour": 18,
                          "count": 450
                        },
                        {
                          "hour": 19,
                          "count": 420
                        },
                        {
                          "hour": 8,
                          "count": 380
                        }
                      ]
                    },
                    "most_active_users": [
                      {
                        "user_id": 42,
                        "name": "Ahmet Yılmaz",
                        "salon_name": "FitLife Istanbul",
                        "checkin_count": 28,
                        "last_activity": "2024-01-15T18:30:00Z"
                      },
                      {
                        "user_id": 55,
                        "name": "Zeynep Kaya",
                        "salon_name": "FitLife Istanbul",
                        "checkin_count": 25,
                        "last_activity": "2024-01-15T09:00:00Z"
                      }
                    ],
                    "trends": [
                      {
                        "date": "2024-01-09",
                        "active_users": 1180,
                        "checkins": 1150
                      },
                      {
                        "date": "2024-01-10",
                        "active_users": 1220,
                        "checkins": 1200
                      },
                      {
                        "date": "2024-01-11",
                        "active_users": 1320,
                        "checkins": 1280
                      }
                    ]
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          }
        }
      }
    },
    "/api/superadmin/settings/platform": {
      "get": {
        "summary": "Get platform settings",
        "tags": [
          "SuperAdmin"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Platform settings retrieved successfully."
          },
          "401": {
            "description": "Unauthorized."
          }
        }
      },
      "put": {
        "summary": "Update platform settings",
        "tags": [
          "SuperAdmin"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "platform_name": {
                    "type": "string"
                  },
                  "maintenance_mode": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Platform settings updated successfully."
          },
          "401": {
            "description": "Unauthorized."
          }
        }
      }
    },
