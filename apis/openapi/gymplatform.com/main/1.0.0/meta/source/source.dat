    "/api/admin/calendar/events": {
      "get": {
        "summary": "Takvim etkinliklerini listele",
        "description": "Belirli tarih aralığındaki tüm takvim etkinliklerini getirir.\nGrup dersleri, PT seansları, özel etkinlikler ve salon aktiviteleri listelenebilir.\n\nFiltreleme seçenekleri:\n- Tarih aralığı (startDate - endDate)\n- Etkinlik türü (type)\n- Eğitmen (trainer_id)\n- Durum (status)\n",
        "tags": [
          "Calendar"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "startDate",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Başlangıç tarihi (YYYY-MM-DD)",
            "example": "2024-01-01"
          },
          {
            "in": "query",
            "name": "endDate",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Bitiş tarihi (YYYY-MM-DD)",
            "example": "2024-01-31"
          },
          {
            "in": "query",
            "name": "type",
            "schema": {
              "type": "string",
              "enum": [
                "group_class",
                "pt_session",
                "personal_training",
                "event",
                "maintenance",
                "holiday"
              ]
            },
            "description": "Etkinlik türü filtresi"
          },
          {
            "in": "query",
            "name": "trainer_id",
            "schema": {
              "type": "integer"
            },
            "description": "Eğitmen ID'sine göre filtrele"
          },
          {
            "in": "query",
            "name": "status",
            "schema": {
              "type": "string",
              "enum": [
                "scheduled",
                "in_progress",
                "completed",
                "cancelled"
              ]
            },
            "description": "Etkinlik durumu"
          },
          {
            "in": "query",
            "name": "room",
            "schema": {
              "type": "string"
            },
            "description": "Salon/oda filtresi"
          }
        ],
        "responses": {
          "200": {
            "description": "Etkinlik listesi başarıyla getirildi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/CalendarEvent"
                      }
                    }
                  }
                },
                "examples": {
                  "eventList": {
                    "summary": "Haftalık etkinlik listesi",
                    "value": {
                      "success": true,
                      "data": [
                        {
                          "id": 1,
                          "title": "Sabah Yoga",
                          "type": "group_class",
                          "start_time": "2024-01-15T07:00:00Z",
                          "end_time": "2024-01-15T08:00:00Z",
                          "trainer_id": 5,
                          "trainer_name": "Ayşe Yılmaz",
                          "room": "Yoga Salonu",
                          "capacity": 20,
                          "current_participants": 15,
                          "status": "scheduled",
                          "color": "#4CAF50",
                          "recurrence": "weekly"
                        },
                        {
                          "id": 2,
                          "title": "PT - Mehmet Öz",
                          "type": "pt_session",
                          "start_time": "2024-01-15T09:00:00Z",
                          "end_time": "2024-01-15T10:00:00Z",
                          "trainer_id": 3,
                          "trainer_name": "Can Demir",
                          "member_id": 42,
                          "member_name": "Mehmet Öz",
                          "status": "scheduled",
                          "color": "#2196F3"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          }
        }
      },
      "post": {
        "summary": "Yeni etkinlik oluştur",
        "description": "Yeni bir takvim etkinliği oluşturur.\n\nDesteklenen etkinlik türleri:\n- **group_class**: Grup dersleri (yoga, pilates, spinning vb.)\n- **pt_session**: Kişisel antrenman seansları\n- **personal_training**: Özel ders\n- **event**: Özel etkinlikler (seminer, tanışma günü vb.)\n- **maintenance**: Bakım/temizlik\n- **holiday**: Tatil günleri\n\nTekrarlayan etkinlikler için recurrence alanı kullanılır.\n",
        "tags": [
          "Calendar"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CalendarEventCreate"
              },
              "examples": {
                "groupClass": {
                  "summary": "Haftalık grup dersi",
                  "value": {
                    "title": "Sabah Yoga",
                    "description": "Başlangıç seviyesi yoga dersi. Herkes katılabilir.",
                    "type": "group_class",
                    "start_time": "2024-01-15T07:00:00Z",
                    "end_time": "2024-01-15T08:00:00Z",
                    "trainer_id": 5,
                    "room": "Yoga Salonu",
                    "capacity": 20,
                    "color": "#4CAF50",
                    "recurrence": "weekly",
                    "recurrence_end": "2024-06-30",
                    "notes": "Mat salondan temin edilebilir"
                  }
                },
                "ptSession": {
                  "summary": "PT seansı",
                  "value": {
                    "title": "PT - Mehmet Öz",
                    "type": "pt_session",
                    "start_time": "2024-01-15T09:00:00Z",
                    "end_time": "2024-01-15T10:00:00Z",
                    "trainer_id": 3,
                    "member_id": 42,
                    "room": "PT Alanı 1",
                    "color": "#2196F3",
                    "notes": "Bacak günü, diz sakatlığına dikkat"
                  }
                },
                "maintenance": {
                  "summary": "Bakım çalışması",
                  "value": {
                    "title": "Aylık Cihaz Bakımı",
                    "type": "maintenance",
                    "start_time": "2024-01-20T22:00:00Z",
                    "end_time": "2024-01-21T06:00:00Z",
                    "room": "Tüm Salon",
                    "color": "#FF9800",
                    "notes": "Tüm cihazlar bakıma alınacak"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Etkinlik başarıyla oluşturuldu",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Etkinlik başarıyla oluşturuldu"
                    },
                    "data": {
                      "$ref": "#/components/schemas/CalendarEvent"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Geçersiz istek",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "timeConflict": {
                    "summary": "Zaman çakışması",
                    "value": {
                      "success": false,
                      "message": "Bu zaman aralığında eğitmenin başka bir etkinliği var"
                    }
                  },
                  "invalidTime": {
                    "summary": "Geçersiz zaman",
                    "value": {
                      "success": false,
                      "message": "Bitiş zamanı başlangıç zamanından önce olamaz"
                    }
                  },
                  "missingFields": {
                    "summary": "Eksik alanlar",
                    "value": {
                      "success": false,
                      "message": "Zorunlu alanlar eksik: title, start_time, end_time"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          }
        }
      }
    },
    "/api/admin/calendar/events/{id}": {
      "get": {
        "summary": "Etkinlik detayını getir",
        "description": "Belirtilen ID'ye sahip etkinliğin tüm detaylarını getirir.\nRezervasyonlar, bekleme listesi ve katılımcı bilgileri dahildir.\n",
        "tags": [
