              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/MembershipStats"
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "activeSubscriptions": 120,
                    "expiredSubscriptions": 30,
                    "frozenSubscriptions": 5,
                    "newMembersThisMonth": 15,
                    "churnRate": 5.2,
                    "retentionRate": 85.5,
                    "genderDistribution": {
                      "MALE": 65,
