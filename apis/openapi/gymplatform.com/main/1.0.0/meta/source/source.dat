                },
                "example": {
                  "success": false,
                  "message": "Program bulunamadı"
                }
              }
            }
          }
        }
      }
    },
    "/api/trainer/programs/{id}/exercises": {
      "post": {
        "summary": "Programa egzersiz ekle",
        "description": "Mevcut bir programa yeni egzersiz ekler.\n\nEgzersiz belirli bir güne (day_number) ve sıraya (order) atanabilir.\nSet, tekrar, dinlenme süresi ve ağırlık bilgileri belirtilebilir.\n",
        "tags": [
          "WorkoutPrograms"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Program ID",
            "example": 1
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProgramExerciseCreate"
              },
              "examples": {
                "basicExercise": {
                  "summary": "Temel egzersiz ekleme",
                  "value": {
                    "exercise_id": 1,
                    "day_number": 1,
                    "sets": 4,
                    "reps": "8-10",
                    "rest_seconds": 90,
                    "order": 1
                  }
                },
                "detailedExercise": {
                  "summary": "Detaylı egzersiz ekleme",
                  "value": {
                    "exercise_id": 5,
                    "day_number": 1,
                    "sets": 3,
                    "reps": "12",
                    "rest_seconds": 60,
                    "weight": "15kg dumbbells",
                    "tempo": "2-1-2-0",
                    "notes": "Full range of motion, kontrollü hareket",
                    "order": 2
                  }
                },
                "supersetExercise": {
                  "summary": "Superset egzersiz",
                  "value": {
                    "exercise_id": 10,
                    "day_number": 2,
                    "sets": 3,
                    "reps": "10-12",
                    "rest_seconds": 0,
                    "superset_with": 11,
                    "notes": "Superset: Bicep curl ile birlikte",
                    "order": 3
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Egzersiz programa başarıyla eklendi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Egzersiz programa eklendi"
                    },
                    "data": {
                      "$ref": "#/components/schemas/ProgramExercise"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Geçersiz istek",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "exerciseNotFound": {
                    "summary": "Egzersiz bulunamadı",
                    "value": {
                      "success": false,
                      "message": "Belirtilen egzersiz bulunamadı"
                    }
                  },
                  "duplicateExercise": {
                    "summary": "Egzersiz zaten ekli",
                    "value": {
                      "success": false,
                      "message": "Bu egzersiz bu günde zaten mevcut"
                    }
                  },
                  "invalidDay": {
                    "summary": "Geçersiz gün",
                    "value": {
                      "success": false,
                      "message": "Geçersiz gün numarası"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "404": {
            "description": "Program bulunamadı",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "success": false,
                  "message": "Program bulunamadı"
                }
              }
            }
          }
        }
      }
    },
    "/api/trainer/programs/{id}/exercises/{exerciseId}": {
      "delete": {
        "summary": "Programdan egzersiz kaldır",
        "description": "Belirtilen egzersizi programdan kaldırır.\nDiğer egzersizlerin sıralaması otomatik güncellenir.\n",
        "tags": [
          "WorkoutPrograms"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Program ID",
            "example": 1
          },
          {
            "in": "path",
            "name": "exerciseId",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Program egzersiz bağlantı ID (veya egzersiz ID)",
            "example": 5
          }
        ],
        "responses": {
          "200": {
            "description": "Egzersiz programdan başarıyla kaldırıldı",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Egzersiz programdan kaldırıldı"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "404": {
            "description": "Program veya egzersiz bulunamadı",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "programNotFound": {
                    "summary": "Program bulunamadı",
                    "value": {
                      "success": false,
                      "message": "Program bulunamadı"
                    }
                  },
                  "exerciseNotInProgram": {
                    "summary": "Egzersiz programda yok",
                    "value": {
                      "success": false,
                      "message": "Bu egzersiz programda bulunamadı"
                    }
                  }
                }
              }
            }
