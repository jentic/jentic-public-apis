                  "message": "Paket artık aktif değil. Farklı bir paket seçin."
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/api/admin/subscriptions/{id}/change-package": {
      "post": {
        "summary": "Paket değiştir (upgrade/downgrade)",
        "description": "Mevcut aboneliğin paketini değiştirir.\nKalan süre yeni pakete göre hesaplanır.\n\n**Yetki:** Sadece Admin\n\n**Hesaplama:**\n- Upgrade: Fark ücreti alınır\n- Downgrade: Kalan süre orantılı olarak uzatılır\n",
        "tags": [
          "Subscriptions"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Paketi değiştirilecek abonelik ID'si",
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "example": 10
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "new_package_id"
                ],
                "properties": {
                  "new_package_id": {
                    "type": "integer",
                    "description": "Yeni paket ID'si",
                    "example": 2
                  },
                  "additional_payment": {
                    "type": "number",
                    "description": "Ek ödeme tutarı (upgrade için)",
                    "example": 500
                  }
                }
              },
              "example": {
                "new_package_id": 2,
                "additional_payment": 500
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Paket başarıyla değiştirildi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Paket başarıyla değiştirildi"
                    },
                    "data": {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/MemberSubscription"
                        },
                        {
                          "type": "object",
                          "properties": {
                            "priceDifference": {
                              "type": "number",
                              "description": "Fiyat farkı (pozitif = upgrade)",
                              "example": 500
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Paket değiştirme başarısız",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "samePackage": {
                    "summary": "Aynı paket",
                    "value": {
                      "success": false,
                      "message": "Zaten bu paketi kullanıyorsunuz"
                    }
                  },
                  "packageNotFound": {
                    "summary": "Paket bulunamadı",
                    "value": {
                      "success": false,
                      "message": "Belirtilen paket bulunamadı veya aktif değil"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
