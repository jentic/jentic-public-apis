    "/api/admin/salons/{id}/activities": {
      "get": {
        "summary": "Salon aktivite loglarını getir",
        "description": "Belirtilen salona ait aktivite loglarını listeler.\n\nLog türleri:\n- Kullanıcı işlemleri (kayıt, silme, güncelleme)\n- Finansal işlemler\n- Üyelik değişiklikleri\n- Sistem olayları\n",
        "tags": [
          "Salons"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Salon ID",
            "example": 1
          },
          {
            "in": "query",
            "name": "type",
            "schema": {
              "type": "string",
              "enum": [
                "user",
                "financial",
                "subscription",
                "system",
                "all"
              ],
              "default": "all"
            },
            "description": "Aktivite türü filtresi"
          },
          {
            "in": "query",
            "name": "start_date",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Başlangıç tarihi filtresi"
          },
          {
            "in": "query",
            "name": "end_date",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Bitiş tarihi filtresi"
          },
          {
            "$ref": "#/components/parameters/PageParam"
          },
          {
            "$ref": "#/components/parameters/LimitParam"
          }
        ],
        "responses": {
          "200": {
            "description": "Aktivite logları başarıyla getirildi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer"
                          },
                          "type": {
                            "type": "string"
                          },
                          "action": {
                            "type": "string"
                          },
                          "description": {
                            "type": "string"
                          },
                          "user": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "integer"
                              },
                              "name": {
                                "type": "string"
                              }
                            }
                          },
                          "metadata": {
                            "type": "object"
                          },
                          "timestamp": {
                            "type": "string",
                            "format": "date-time"
                          }
                        }
                      }
                    },
                    "pagination": {
                      "$ref": "#/components/schemas/Pagination"
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": [
                    {
                      "id": 1001,
                      "type": "user",
                      "action": "member_created",
                      "description": "Yeni üye kaydı: Ahmet Yılmaz",
                      "user": {
                        "id": 5,
                        "name": "Admin User"
                      },
                      "metadata": {
                        "member_id": 42,
                        "package": "Premium Üyelik"
                      },
                      "timestamp": "2024-01-15T14:30:00Z"
                    },
                    {
                      "id": 1000,
                      "type": "financial",
                      "action": "payment_received",
                      "description": "Ödeme alındı: 1500 TL",
                      "user": {
                        "id": 42,
                        "name": "Ahmet Yılmaz"
                      },
                      "metadata": {
                        "amount": 1500,
                        "payment_method": "credit_card"
                      },
                      "timestamp": "2024-01-15T14:25:00Z"
                    }
                  ],
                  "pagination": {
                    "page": 1,
                    "limit": 20,
                    "totalItems": 150,
                    "totalPages": 8
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "404": {
            "description": "Salon bulunamadı",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "success": false,
                  "message": "Salon bulunamadı"
                }
              }
            }
          }
        }
      }
    },
