  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT token ile kimlik doğrulama. Login endpoint'inden alınan token'ı kullanın."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "message": {
            "type": "string",
            "example": "Bir hata oluştu"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "ValidationError": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "message": {
            "type": "string",
            "example": "Doğrulama hatası"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "example": "field"
                },
                "value": {
                  "type": "string"
                },
                "msg": {
                  "type": "string",
                  "example": "E-posta adresi geçerli değil"
                },
                "path": {
                  "type": "string",
                  "example": "email"
                },
                "location": {
                  "type": "string",
                  "example": "body"
                }
              }
            }
          }
        }
      },
      "SuccessResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "example": "İşlem başarılı"
          },
          "data": {
            "type": "object"
          }
        }
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "example": 1,
            "description": "Mevcut sayfa numarası"
          },
          "limit": {
            "type": "integer",
            "example": 10,
            "description": "Sayfa başına öğe sayısı"
          },
          "totalItems": {
            "type": "integer",
            "example": 100,
            "description": "Toplam öğe sayısı"
          },
          "totalPages": {
            "type": "integer",
            "example": 10,
            "description": "Toplam sayfa sayısı"
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "integer",
            "example": 1,
            "description": "Kullanıcı benzersiz ID'si"
          },
          "salon_id": {
            "type": "integer",
            "example": 1,
            "nullable": true,
            "description": "Bağlı olduğu salon ID'si (SUPER_ADMIN için null)"
          },
          "role": {
            "type": "string",
            "enum": [
              "SUPER_ADMIN",
              "ADMIN",
              "TRAINER",
              "MEMBER"
            ],
            "example": "MEMBER",
            "description": "Kullanıcı rolü"
          },
          "first_name": {
            "type": "string",
            "example": "Ahmet",
            "description": "Ad"
          },
          "last_name": {
            "type": "string",
            "example": "Yılmaz",
            "description": "Soyad"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "ahmet@example.com",
            "description": "E-posta adresi"
          },
          "phone": {
            "type": "string",
            "example": "05551234567",
            "description": "Telefon numarası"
          },
          "national_id": {
            "type": "string",
            "example": "12345678901",
            "nullable": true,
            "description": "TC Kimlik No"
          },
          "date_of_birth": {
            "type": "string",
            "format": "date",
            "example": "1990-05-15",
            "nullable": true,
            "description": "Doğum tarihi"
          },
          "gender": {
            "type": "string",
            "enum": [
              "MALE",
              "FEMALE",
              "OTHER"
            ],
            "nullable": true,
            "example": "MALE",
            "description": "Cinsiyet"
          },
          "is_email_verified": {
            "type": "boolean",
            "example": true,
            "description": "E-posta doğrulandı mı"
          },
          "is_phone_verified": {
            "type": "boolean",
            "example": false,
            "description": "Telefon doğrulandı mı"
          },
          "last_login": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Son giriş zamanı"
          },
          "assigned_trainer_id": {
            "type": "integer",
            "nullable": true,
            "description": "Atanan eğitmen ID'si (Üyeler için)"
          },
          "member_number": {
            "type": "string",
            "example": "M-2024-001",
            "nullable": true,
            "description": "Üye numarası"
          },
          "emergency_contact_name": {
            "type": "string",
            "nullable": true,
            "description": "Acil durum iletişim kişisi"
          },
          "emergency_contact_phone": {
            "type": "string",
            "nullable": true,
            "description": "Acil durum telefonu"
          },
          "health_conditions": {
            "type": "string",
            "nullable": true,
            "description": "Sağlık durumu notları"
          },
          "profile_photo_url": {
            "type": "string",
            "nullable": true,
            "description": "Profil fotoğrafı URL'i"
          },
          "bio": {
            "type": "string",
            "nullable": true,
            "description": "Biyografi"
          },
          "address": {
            "type": "string",
            "nullable": true,
            "description": "Adres"
          },
          "is_active": {
            "type": "boolean",
            "example": true,
            "description": "Aktif mi"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Oluşturulma tarihi"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Güncellenme tarihi"
          }
        }
      },
      "UserCreate": {
        "type": "object",
        "required": [
          "first_name",
          "last_name",
          "phone",
          "password"
        ],
        "properties": {
          "first_name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100,
            "example": "Ahmet",
            "description": "Ad (zorunlu)"
          },
          "last_name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100,
            "example": "Yılmaz",
            "description": "Soyad (zorunlu)"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "ahmet@example.com",
            "description": "E-posta adresi"
          },
          "phone": {
            "type": "string",
            "example": "05551234567",
            "description": "Telefon numarası (zorunlu)"
          },
          "password": {
            "type": "string",
            "minLength": 6,
            "example": "password123",
            "description": "Şifre (min 6 karakter, zorunlu)"
          },
          "national_id": {
            "type": "string",
            "example": "12345678901",
            "description": "TC Kimlik No"
          },
          "date_of_birth": {
            "type": "string",
            "format": "date",
            "example": "1990-05-15",
            "description": "Doğum tarihi"
          },
          "gender": {
            "type": "string",
            "enum": [
              "MALE",
              "FEMALE",
              "OTHER"
            ],
            "example": "MALE",
            "description": "Cinsiyet"
          },
          "emergency_contact_name": {
            "type": "string",
            "description": "Acil durum iletişim kişisi"
          },
          "emergency_contact_phone": {
            "type": "string",
            "description": "Acil durum telefonu"
          },
          "health_conditions": {
            "type": "string",
            "description": "Sağlık durumu notları"
          },
          "address": {
            "type": "string",
            "description": "Adres"
          }
        }
      },
      "UserUpdate": {
        "type": "object",
        "properties": {
          "first_name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100,
            "example": "Ahmet"
          },
          "last_name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100,
            "example": "Yılmaz"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "ahmet@example.com"
          },
          "phone": {
            "type": "string",
            "example": "05551234567"
          },
          "national_id": {
            "type": "string",
            "example": "12345678901"
          },
          "date_of_birth": {
            "type": "string",
            "format": "date",
            "example": "1990-05-15"
          },
          "gender": {
            "type": "string",
            "enum": [
              "MALE",
              "FEMALE",
              "OTHER"
            ]
          },
          "emergency_contact_name": {
            "type": "string"
          },
          "emergency_contact_phone": {
            "type": "string"
          },
          "health_conditions": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "bio": {
            "type": "string"
          },
          "is_active": {
            "type": "boolean"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "admin@example.com",
            "description": "Kayıtlı e-posta adresi"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "password123",
            "description": "Kullanıcı şifresi"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "type": "object",
            "properties": {
              "token": {
                "type": "string",
                "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
                "description": "JWT access token"
              },
              "refreshToken": {
                "type": "string",
                "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
                "description": "JWT refresh token"
              },
              "user": {
                "$ref": "#/components/schemas/User"
              }
            }
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": [
          "salon_name",
          "owner_name",
          "email",
          "password"
        ],
        "properties": {
          "salon_name": {
            "type": "string",
            "example": "Fitness Plus",
            "description": "Salon adı"
          },
          "owner_name": {
            "type": "string",
            "example": "Mehmet Kaya",
            "description": "Salon sahibi adı"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "info@fitnessplus.com",
            "description": "E-posta adresi"
          },
          "password": {
            "type": "string",
            "minLength": 6,
            "example": "securePassword123",
            "description": "Şifre (min 6 karakter)"
          },
          "phone": {
            "type": "string",
            "example": "05551234567",
            "description": "Telefon numarası"
          }
        }
      },
      "RefreshTokenRequest": {
        "type": "object",
        "required": [
          "refreshToken"
        ],
        "properties": {
          "refreshToken": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
            "description": "Refresh token"
          }
        }
      },
      "Salon": {
        "type": "object",
        "properties": {
          "salon_id": {
            "type": "integer",
            "example": 1,
            "description": "Salon benzersiz ID'si"
          },
          "name": {
            "type": "string",
            "example": "Fitness Plus",
            "description": "Salon adı"
          },
          "address": {
            "type": "string",
            "example": "Atatürk Cad. No: 123, İstanbul",
            "description": "Adres"
          },
          "phone": {
            "type": "string",
            "example": "02121234567",
            "description": "Telefon"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "info@fitnessplus.com",
            "description": "E-posta"
          },
          "logo_url": {
            "type": "string",
            "nullable": true,
            "description": "Logo URL'i"
          },
          "is_active": {
            "type": "boolean",
            "example": true,
            "description": "Aktif mi"
          },
          "subscription_status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "TRIAL",
              "EXPIRED",
              "CANCELLED"
            ],
            "example": "ACTIVE",
            "description": "Abonelik durumu"
          },
          "subscription_end_date": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "description": "Abonelik bitiş tarihi"
          },
          "settings": {
            "type": "object",
            "description": "Salon ayarları"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SalonCreate": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "Fitness Plus",
            "description": "Salon adı (zorunlu)"
          },
          "address": {
            "type": "string",
            "example": "Atatürk Cad. No: 123, İstanbul"
          },
          "phone": {
            "type": "string",
            "example": "02121234567"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "info@fitnessplus.com"
          },
          "settings": {
            "type": "object"
          }
        }
      },
      "MembershipPackage": {
        "type": "object",
        "properties": {
          "package_id": {
            "type": "integer",
            "example": 1
          },
          "salon_id": {
            "type": "integer",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "Aylık Üyelik"
          },
          "description": {
            "type": "string",
            "example": "Tüm ekipmanlara sınırsız erişim"
          },
          "duration_days": {
            "type": "integer",
            "example": 30,
            "description": "Süre (gün)"
          },
          "price": {
            "type": "number",
            "format": "decimal",
            "example": 500,
            "description": "Fiyat (TL)"
          },
          "max_freezes": {
            "type": "integer",
            "example": 2,
            "description": "Maksimum dondurma hakkı"
          },
          "max_freeze_days": {
            "type": "integer",
            "example": 14,
            "description": "Maksimum dondurma günü"
          },
          "includes_pt": {
            "type": "boolean",
            "example": false,
            "description": "PT dahil mi"
          },
          "pt_sessions": {
            "type": "integer",
            "example": 0,
            "description": "PT seans sayısı"
          },
          "is_active": {
            "type": "boolean",
            "example": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PackageCreate": {
        "type": "object",
        "required": [
          "name",
          "duration_days",
          "price"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "Aylık Üyelik",
            "description": "Paket adı (zorunlu)"
          },
          "description": {
            "type": "string",
            "example": "Tüm ekipmanlara sınırsız erişim"
          },
          "duration_days": {
            "type": "integer",
            "minimum": 1,
            "example": 30,
            "description": "Süre gün cinsinden (zorunlu)"
          },
          "price": {
            "type": "number",
            "minimum": 0,
            "example": 500,
            "description": "Fiyat TL cinsinden (zorunlu)"
          },
          "max_freezes": {
            "type": "integer",
            "minimum": 0,
            "example": 2
          },
          "max_freeze_days": {
            "type": "integer",
            "minimum": 0,
            "example": 14
          },
          "includes_pt": {
            "type": "boolean",
            "example": false
          },
          "pt_sessions": {
            "type": "integer",
            "minimum": 0,
            "example": 0
          }
        }
      },
      "MemberSubscription": {
        "type": "object",
        "properties": {
