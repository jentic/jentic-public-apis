                                  "type": "integer"
                                },
                                "total_sessions": {
                                  "type": "integer"
                                },
                                "completion_percentage": {
                                  "type": "number"
                                }
                              }
                            }
                          }
                        }
                      ]
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "program_id": 1,
                    "name": "Kas Geliştirme Programı",
                    "description": "12 haftalık kas geliştirme programı. Haftada 4 gün antrenman.",
                    "member": {
                      "user_id": 42,
                      "name": "Ahmet Yılmaz",
                      "email": "ahmet@example.com"
                    },
                    "trainer": {
                      "user_id": 5,
                      "name": "Can Demir"
                    },
                    "status": "ACTIVE",
                    "start_date": "2024-01-01",
                    "end_date": "2024-03-25",
                    "notes": "Isınma ve soğuma dahil",
                    "days": [
                      {
