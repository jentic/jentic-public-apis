      "post": {
        "summary": "Yeni egzersiz oluştur",
        "description": "Egzersiz kütüphanesine yeni bir egzersiz ekler.\n\nZorunlu alanlar:\n- name: Egzersiz adı\n- category: Egzersiz kategorisi\n\nVideo ve resim URL'leri opsiyoneldir.\n",
        "tags": [
          "Exercises"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExerciseCreate"
              },
              "examples": {
                "basicExercise": {
                  "summary": "Temel egzersiz",
                  "value": {
                    "name": "Dumbbell Fly",
                    "description": "Göğüs kasları için izolasyon egzersizi",
                    "category": "CHEST",
                    "muscle_groups": [
                      "pectoralis major"
                    ],
                    "equipment_needed": "Dumbbells, Bench",
                    "difficulty_level": "BEGINNER",
                    "instructions": "1. Bench'e sırt üstü yatın\n2. Her iki elde dumbbell tutun\n3. Kollarınızı yana açın\n4. Kontrollü şekilde birleştirin"
                  }
                },
                "advancedExercise": {
                  "summary": "Detaylı egzersiz",
                  "value": {
                    "name": "Bulgarian Split Squat",
                    "description": "Tek bacak kuvvet ve denge egzersizi",
                    "category": "LEGS",
                    "muscle_groups": [
                      "quadriceps",
                      "glutes",
                      "hamstrings",
                      "core"
                    ],
                    "equipment_needed": "Bench, Dumbbells (optional)",
                    "difficulty_level": "ADVANCED",
                    "video_url": "https://example.com/videos/bulgarian-split-squat.mp4",
                    "image_url": "https://example.com/images/bulgarian-split-squat.jpg",
                    "instructions": "1. Bench'in önünde durun\n2. Bir ayağınızı arkaya bench'e koyun\n3. Ön bacağınızı bükün\n4. Diz 90 derece olana kadar inin\n5. Yukarı itin\n",
                    "tips": "Diz ayak parmağının önüne geçmemeli"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Egzersiz başarıyla oluşturuldu",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Egzersiz başarıyla oluşturuldu"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Exercise"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Geçersiz istek",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "missingFields": {
                    "summary": "Eksik alanlar",
                    "value": {
                      "success": false,
                      "message": "Zorunlu alanlar eksik: name, category"
                    }
                  },
                  "duplicateName": {
                    "summary": "Aynı isimli egzersiz var",
                    "value": {
                      "success": false,
                      "message": "Bu isimde bir egzersiz zaten mevcut"
                    }
                  },
                  "invalidCategory": {
                    "summary": "Geçersiz kategori",
                    "value": {
                      "success": false,
                      "message": "Geçersiz kategori değeri"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          }
        }
      }
    },
