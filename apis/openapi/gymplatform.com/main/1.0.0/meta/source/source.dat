    "/api/trainer/exercises": {
      "get": {
        "summary": "Egzersiz listesini getir",
        "description": "Salon'a ait tüm egzersizleri listeler.\nKategoriye, kas grubuna ve zorluk seviyesine göre filtrelenebilir.\n\nSayfalama desteklenir ve sonuçlar egzersiz adına göre sıralanır.\n",
        "tags": [
          "Exercises"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/PageParam"
          },
          {
            "$ref": "#/components/parameters/LimitParam"
          },
          {
            "in": "query",
            "name": "category",
            "schema": {
              "type": "string",
              "enum": [
                "CHEST",
                "BACK",
                "SHOULDERS",
                "ARMS",
                "LEGS",
                "CORE",
                "CARDIO",
                "FLEXIBILITY"
              ]
            },
            "description": "Egzersiz kategorisi",
            "example": "CHEST"
          },
          {
            "in": "query",
            "name": "muscle_group",
            "schema": {
              "type": "string"
            },
            "description": "Hedef kas grubu",
            "example": "pectoralis major"
          },
          {
            "in": "query",
            "name": "difficulty_level",
            "schema": {
              "type": "string",
              "enum": [
                "BEGINNER",
                "INTERMEDIATE",
                "ADVANCED"
              ]
            },
            "description": "Zorluk seviyesi",
            "example": "INTERMEDIATE"
          },
          {
            "in": "query",
            "name": "search",
            "schema": {
              "type": "string"
            },
            "description": "Egzersiz adı veya açıklamasında arama",
            "example": "bench"
          },
          {
            "in": "query",
            "name": "is_active",
            "schema": {
              "type": "boolean"
            },
            "description": "Sadece aktif/pasif egzersizleri getir"
          }
        ],
        "responses": {
          "200": {
            "description": "Egzersiz listesi başarıyla getirildi",
