                      },
                      "timestamp": "2024-01-15T12:00:00Z",
                      "icon": "check-circle",
                      "color": "#2196F3"
                    },
                    {
                      "id": 3,
                      "type": "program_created",
                      "title": "Program Oluşturuldu",
