    "/api/admin/calendar/events/{id}/reservations": {
      "get": {
        "summary": "Etkinlik rezervasyonlarını listele",
        "description": "Belirtilen etkinliğe ait tüm rezervasyonları listeler.\nHer rezervasyon için üye bilgileri ve rezervasyon durumu gösterilir.\n",
