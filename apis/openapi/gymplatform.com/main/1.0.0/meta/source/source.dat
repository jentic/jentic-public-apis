      }
    },
    "/api/admin/payments/{id}": {
      "get": {
        "summary": "Ödeme detaylarını getir",
        "description": "Belirtilen ID'ye sahip ödemenin detaylarını getirir.\n\n**Yetki:** Admin veya Eğitmen\n",
        "tags": [
          "Payments"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Ödeme ID'si",
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Ödeme detayları başarıyla getirildi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/Payment"
                        },
                        {
                          "type": "object",
                          "properties": {
                            "member": {
                              "$ref": "#/components/schemas/User"
                            },
                            "subscription": {
                              "$ref": "#/components/schemas/MemberSubscription"
                            },
                            "createdBy": {
                              "type": "object",
                              "properties": {
                                "user_id": {
                                  "type": "integer"
                                },
                                "first_name": {
                                  "type": "string"
                                },
                                "last_name": {
                                  "type": "string"
                                }
                              }
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "put": {
        "summary": "Ödeme bilgilerini güncelle",
        "description": "Belirtilen ödemenin bilgilerini günceller.\n\n**Yetki:** Sadece Admin\n\n**Uyarı:** Tamamlanmış ödemeler için sadece açıklama ve notlar güncellenebilir.\n",
        "tags": [
          "Payments"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Güncellenecek ödeme ID'si",
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "example": 1
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "payment_type": {
                    "type": "string",
                    "enum": [
                      "SUBSCRIPTION",
                      "PT_SESSION",
                      "PRODUCT",
                      "OTHER"
                    ]
                  },
                  "amount": {
                    "type": "number",
                    "minimum": 0
                  },
                  "payment_method": {
                    "type": "string",
                    "enum": [
                      "CASH",
                      "CREDIT_CARD",
                      "BANK_TRANSFER",
                      "OTHER"
                    ]
                  },
                  "payment_date": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "PENDING",
                      "COMPLETED",
                      "FAILED"
                    ]
                  },
                  "description": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "status": "COMPLETED",
                "description": "Ödeme onaylandı"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ödeme başarıyla güncellendi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Ödeme bilgileri güncellendi"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Payment"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/api/admin/payments/{id}/refund": {
      "put": {
        "summary": "Ödeme iadesi yap",
        "description": "Belirtilen ödeme için iade işlemi başlatır.\n\n**Yetki:** Sadece Admin\n\n**Kurallar:**\n- Sadece COMPLETED durumundaki ödemeler iade edilebilir\n- İade tutarı orijinal tutarı aşamaz\n- Kısmi iade desteklenir\n\n**Not:** İade işlemi abonelik durumunu otomatik olarak güncellemez.\nGerekirse aboneliği manuel olarak iptal edin.\n",
        "tags": [
          "Payments"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "İade edilecek ödeme ID'si",
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "example": 1
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "refund_amount": {
                    "type": "number",
                    "description": "İade tutarı (belirtilmezse tam iade)",
                    "example": 250
                  },
                  "reason": {
                    "type": "string",
                    "description": "İade nedeni",
                    "example": "Üye talebi"
                  }
                }
              },
              "example": {
                "refund_amount": 250,
                "reason": "Kısmi iade - üye talebi"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "İade işlemi başarılı",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "250.00 TL iade işlemi tamamlandı"
                    },
                    "data": {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/Payment"
                        },
                        {
                          "type": "object",
                          "properties": {
                            "refund_amount": {
                              "type": "number",
                              "example": 250
                            },
                            "refund_date": {
                              "type": "string",
                              "format": "date-time"
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "İade yapılamaz",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "alreadyRefunded": {
                    "summary": "Zaten iade edilmiş",
                    "value": {
                      "success": false,
                      "message": "Bu ödeme zaten iade edilmiş"
                    }
                  },
                  "notCompleted": {
                    "summary": "Ödeme tamamlanmamış",
                    "value": {
                      "success": false,
                      "message": "Sadece tamamlanmış ödemeler iade edilebilir"
                    }
                  },
                  "exceedsAmount": {
                    "summary": "Tutar aşımı",
                    "value": {
                      "success": false,
                      "message": "İade tutarı orijinal ödeme tutarını aşamaz"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
