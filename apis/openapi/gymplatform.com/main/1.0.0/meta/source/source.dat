    "/api/measurements/member/{member_id}": {
      "get": {
        "summary": "Üye ölçümlerini listele",
        "description": "Belirli bir üyenin tüm vücut ölçümlerini listeler.\nÖlçümler tarihe göre sıralanır (en yeni en üstte).\n\nDöndürülen ölçümler:\n- Kilo (weight)\n- Boy (height)\n- Vücut yağ oranı (body_fat_percentage)\n- Kas kütlesi (muscle_mass)\n- Çevre ölçüleri (göğüs, bel, kalça, kol, bacak vb.)\n- BMI (hesaplanmış)\n",
        "tags": [
          "Measurements"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "member_id",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Üye ID",
            "example": 42
          },
          {
            "in": "query",
            "name": "start_date",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Başlangıç tarihi filtresi"
          },
          {
            "in": "query",
            "name": "end_date",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Bitiş tarihi filtresi"
          },
          {
            "$ref": "#/components/parameters/PageParam"
          },
          {
            "$ref": "#/components/parameters/LimitParam"
          }
        ],
        "responses": {
          "200": {
            "description": "Ölçüm listesi başarıyla getirildi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Measurement"
                      }
                    },
                    "pagination": {
                      "$ref": "#/components/schemas/Pagination"
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": [
                    {
                      "measurement_id": 25,
                      "member_id": 42,
                      "date": "2024-01-15",
                      "weight": 75.5,
                      "height": 175,
                      "body_fat_percentage": 18.5,
                      "muscle_mass": 35.2,
                      "chest": 98,
                      "waist": 82,
                      "hips": 95,
                      "left_arm": 32,
                      "right_arm": 32.5,
                      "left_thigh": 55,
                      "right_thigh": 55.5,
                      "bmi": 24.65,
                      "notes": "Haftalık ölçüm",
                      "created_by": 5,
                      "created_at": "2024-01-15T10:30:00Z"
                    },
                    {
                      "measurement_id": 20,
                      "member_id": 42,
                      "date": "2024-01-08",
                      "weight": 76.2,
                      "height": 175,
                      "body_fat_percentage": 19.2,
                      "muscle_mass": 34.8,
                      "bmi": 24.89
                    }
                  ],
                  "pagination": {
                    "page": 1,
                    "limit": 10,
                    "totalItems": 15,
                    "totalPages": 2
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "404": {
            "description": "Üye bulunamadı",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "success": false,
                  "message": "Üye bulunamadı"
                }
              }
            }
          }
        }
      }
    },
    "/api/measurements/member/{member_id}/progress": {
      "get": {
        "summary": "Ölçüm ilerleme grafiği verilerini getir",
        "description": "Üyenin ölçüm değişimlerini grafik için zaman serisi formatında getirir.\nBelirli bir metrik (kilo, yağ oranı vb.) için trend analizi yapılabilir.\n\nDesteklenen metrikler:\n- weight: Kilo\n- body_fat_percentage: Vücut yağ oranı\n- muscle_mass: Kas kütlesi\n- bmi: BMI\n- chest, waist, hips: Çevre ölçüleri\n",
        "tags": [
          "Measurements"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "member_id",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Üye ID",
            "example": 42
          },
          {
            "in": "query",
            "name": "metric",
            "schema": {
              "type": "string",
              "enum": [
                "weight",
                "body_fat_percentage",
                "muscle_mass",
                "bmi",
                "chest",
                "waist",
                "hips"
              ]
            },
            "description": "Görüntülenecek metrik",
            "example": "weight"
          },
          {
            "in": "query",
            "name": "period",
            "schema": {
              "type": "string",
              "enum": [
                "1month",
                "3months",
                "6months",
                "1year",
                "all"
              ],
              "default": "3months"
            },
            "description": "Zaman aralığı"
          }
        ],
        "responses": {
          "200": {
            "description": "İlerleme verileri başarıyla getirildi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "metric": {
                          "type": "string",
                          "description": "Seçilen metrik"
                        },
                        "unit": {
                          "type": "string",
                          "description": "Ölçü birimi"
                        },
                        "data_points": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "date": {
                                "type": "string",
                                "format": "date"
                              },
                              "value": {
                                "type": "number"
                              }
                            }
                          }
                        },
                        "summary": {
                          "type": "object",
                          "properties": {
                            "start_value": {
                              "type": "number"
                            },
                            "current_value": {
                              "type": "number"
                            },
                            "change": {
                              "type": "number"
                            },
                            "change_percentage": {
                              "type": "number"
                            },
                            "trend": {
                              "type": "string",
                              "enum": [
                                "increasing",
                                "decreasing",
                                "stable"
                              ]
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "metric": "weight",
                    "unit": "kg",
                    "data_points": [
                      {
                        "date": "2024-01-01",
                        "value": 80
                      },
                      {
                        "date": "2024-01-08",
                        "value": 79.2
                      },
                      {
                        "date": "2024-01-15",
                        "value": 78.5
                      },
                      {
                        "date": "2024-01-22",
                        "value": 77.8
                      }
                    ],
                    "summary": {
                      "start_value": 80,
                      "current_value": 77.8,
                      "change": -2.2,
                      "change_percentage": -2.75,
                      "trend": "decreasing"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "404": {
            "description": "Üye bulunamadı",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/measurements/{id}": {
      "get": {
        "summary": "Ölçüm detayını getir",
        "description": "Belirtilen ID'ye sahip ölçümün tüm detaylarını getirir.\nÖnceki ölçümle karşılaştırma bilgisi de dahildir.\n",
        "tags": [
          "Measurements"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Ölçüm ID",
            "example": 25
          }
        ],
        "responses": {
          "200": {
            "description": "Ölçüm detayı başarıyla getirildi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/Measurement"
                        },
                        {
                          "type": "object",
                          "properties": {
                            "comparison": {
                              "type": "object",
                              "description": "Önceki ölçümle karşılaştırma",
                              "properties": {
                                "weight_change": {
                                  "type": "number"
                                },
                                "body_fat_change": {
                                  "type": "number"
                                },
                                "muscle_mass_change": {
                                  "type": "number"
                                }
                              }
                            }
                          }
                        }
                      ]
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "measurement_id": 25,
                    "member_id": 42,
                    "member": {
                      "name": "Ahmet Yılmaz",
                      "email": "ahmet@example.com"
                    },
                    "date": "2024-01-15",
                    "weight": 75.5,
                    "height": 175,
                    "body_fat_percentage": 18.5,
                    "muscle_mass": 35.2,
                    "chest": 98,
                    "waist": 82,
                    "hips": 95,
                    "left_arm": 32,
                    "right_arm": 32.5,
                    "left_thigh": 55,
                    "right_thigh": 55.5,
                    "bmi": 24.65,
                    "notes": "Haftalık ölçüm, su tutulumu yüksek",
                    "photos": {
                      "front": "https://example.com/photos/front.jpg",
                      "side": "https://example.com/photos/side.jpg",
                      "back": "https://example.com/photos/back.jpg"
                    },
                    "created_by": {
                      "user_id": 5,
                      "name": "Can Demir"
                    },
                    "created_at": "2024-01-15T10:30:00Z",
                    "comparison": {
                      "weight_change": -0.7,
                      "body_fat_change": -0.7,
                      "muscle_mass_change": 0.4
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "404": {
            "description": "Ölçüm bulunamadı",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "success": false,
                  "message": "Ölçüm bulunamadı"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Ölçüm güncelle",
        "description": "Mevcut bir ölçümü günceller.\nSadece gönderilen alanlar güncellenir.\n",
        "tags": [
          "Measurements"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
