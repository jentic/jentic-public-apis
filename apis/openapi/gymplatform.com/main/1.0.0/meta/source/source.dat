                          "is_active": true
                        },
                        {
                          "exercise_id": 2,
                          "name": "Squat",
                          "description": "Bacak kasları için temel egzersiz",
                          "category": "LEGS",
                          "muscle_groups": [
                            "quadriceps",
                            "glutes",
                            "hamstrings"
                          ],
