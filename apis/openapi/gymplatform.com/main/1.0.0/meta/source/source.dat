            "schema": {
              "type": "integer"
            },
            "description": "Program ID",
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Program detayı başarıyla getirildi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/WorkoutProgram"
                        },
                        {
                          "type": "object",
                          "properties": {
                            "days": {
                              "type": "array",
                              "items": {
                                "$ref": "#/components/schemas/WorkoutDay"
                              }
