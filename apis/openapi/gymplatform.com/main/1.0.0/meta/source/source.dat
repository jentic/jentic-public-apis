    "/api/trainer/exercises/{id}": {
      "get": {
        "summary": "Egzersiz detayını getir",
        "description": "Belirtilen ID'ye sahip egzersizin tüm detaylarını getirir.\nVideo/resim linkleri, talimatlar ve kullanım istatistikleri dahildir.\n",
        "tags": [
          "Exercises"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Egzersiz ID",
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Egzersiz detayı başarıyla getirildi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/Exercise"
                        },
                        {
                          "type": "object",
                          "properties": {
                            "usage_stats": {
                              "type": "object",
                              "properties": {
                                "total_programs": {
                                  "type": "integer",
                                  "description": "Bu egzersizi içeren program sayısı"
                                },
                                "total_sessions": {
                                  "type": "integer",
                                  "description": "Toplam yapılan seans sayısı"
                                }
                              }
                            }
                          }
                        }
                      ]
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "exercise_id": 1,
                    "name": "Bench Press",
                    "description": "Göğüs kası için temel bileşik egzersiz. Pectoralis major, triceps ve ön deltoidleri çalıştırır.",
                    "category": "CHEST",
                    "muscle_groups": [
                      "pectoralis major",
                      "triceps",
                      "anterior deltoid"
                    ],
                    "equipment_needed": "Barbell, Bench",
                    "difficulty_level": "INTERMEDIATE",
                    "video_url": "https://example.com/videos/bench-press.mp4",
                    "image_url": "https://example.com/images/bench-press.jpg",
                    "instructions": "1. Sırt üstü bench'e yatın\n2. Barı omuz genişliğinde kavrayın\n3. Barı göğsünüze doğru indirin\n4. Kontrollü şekilde yukarı itin\n5. Kollarınızı tamamen açın ama kilitlemeyin\n",
                    "tips": "Sırtınızı hafif kambur tutun, ayaklarınızı yere basın",
                    "is_active": true,
                    "created_at": "2024-01-01T10:00:00Z",
                    "usage_stats": {
                      "total_programs": 25,
                      "total_sessions": 450
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "404": {
            "description": "Egzersiz bulunamadı",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "success": false,
                  "message": "Egzersiz bulunamadı"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Egzersiz güncelle",
        "description": "Mevcut bir egzersizi günceller.\nSadece gönderilen alanlar güncellenir.\n",
        "tags": [
          "Exercises"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Egzersiz ID",
            "example": 1
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExerciseUpdate"
              },
              "examples": {
                "updateDescription": {
                  "summary": "Açıklama güncelleme",
                  "value": {
                    "description": "Göğüs kasları için geliştirilmiş talimatlar",
                    "instructions": "Güncellenmiş talimatlar..."
                  }
                },
                "addMedia": {
                  "summary": "Medya ekleme",
                  "value": {
                    "video_url": "https://example.com/videos/new-video.mp4",
                    "image_url": "https://example.com/images/new-image.jpg"
                  }
                },
                "deactivate": {
                  "summary": "Pasife al",
                  "value": {
                    "is_active": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Egzersiz başarıyla güncellendi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Egzersiz başarıyla güncellendi"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Exercise"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Geçersiz güncelleme isteği",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "success": false,
                  "message": "Geçersiz kategori değeri"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "404": {
            "description": "Egzersiz bulunamadı",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "success": false,
                  "message": "Egzersiz bulunamadı"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Egzersiz sil (soft delete)",
        "description": "Egzersizi pasife alır (soft delete).\nEgzersiz tamamen silinmez, is_active = false olarak işaretlenir.\n\n**Not:** Aktif antrenman programlarında kullanılan egzersizler silinemez.\n",
        "tags": [
          "Exercises"
        ],
        "security": [
          {
            "bearerAuth": []
          }
