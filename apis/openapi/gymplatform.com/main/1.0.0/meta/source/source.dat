      "put": {
        "summary": "Etkinlik güncelle",
        "description": "Mevcut bir etkinliği günceller.\nTekrarlayan etkinliklerde güncelleme seçenekleri:\n- Sadece bu etkinlik\n- Bu ve sonraki etkinlikler\n- Tüm etkinlikler\n",
        "tags": [
          "Calendar"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Etkinlik ID",
            "example": 1
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/CalendarEventUpdate"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "update_scope": {
                        "type": "string",
                        "enum": [
                          "single",
                          "future",
                          "all"
                        ],
                        "description": "Tekrarlayan etkinliklerde güncelleme kapsamı"
                      }
                    }
                  }
                ]
              },
              "examples": {
                "changeTime": {
                  "summary": "Saat değişikliği",
                  "value": {
                    "start_time": "2024-01-15T08:00:00Z",
                    "end_time": "2024-01-15T09:00:00Z",
                    "update_scope": "single"
                  }
                },
                "changeTrainer": {
                  "summary": "Eğitmen değişikliği",
                  "value": {
                    "trainer_id": 7,
                    "notes": "Ayşe hoca izinli, yerine Fatma hoca",
                    "update_scope": "single"
                  }
                },
                "cancelRecurrence": {
                  "summary": "Tekrarı iptal et",
                  "value": {
                    "recurrence": null,
                    "update_scope": "future"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Etkinlik başarıyla güncellendi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Etkinlik başarıyla güncellendi"
                    },
                    "data": {
                      "$ref": "#/components/schemas/CalendarEvent"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Geçersiz güncelleme isteği",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "success": false,
                  "message": "Rezervasyonu olan etkinliğin kapasitesi mevcut katılımcı sayısının altına düşürülemez"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "404": {
            "description": "Etkinlik bulunamadı",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "success": false,
                  "message": "Etkinlik bulunamadı"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Etkinlik sil",
        "description": "Etkinliği siler. Tekrarlayan etkinliklerde silme seçenekleri:\n- Sadece bu etkinlik\n- Bu ve sonraki etkinlikler\n- Tüm etkinlikler\n\n**Dikkat:** Rezervasyonu olan etkinlikler silindiğinde üyeler bilgilendirilir.\n",
        "tags": [
