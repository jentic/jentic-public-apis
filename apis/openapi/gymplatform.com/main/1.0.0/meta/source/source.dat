    "/api/admin/packages": {
      "get": {
        "summary": "Tüm üyelik paketlerini listele",
        "description": "Salona ait tüm üyelik paketlerini sayfalama ile listeler.\n\n**Yetki:** Admin veya Eğitmen\n\n**Filtreleme:**\n- `is_active`: Aktif/pasif paketler\n- `includes_pt`: PT dahil paketler\n",
        "tags": [
          "Packages"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/PageParam"
          },
          {
            "$ref": "#/components/parameters/LimitParam"
          },
          {
            "name": "is_active",
            "in": "query",
            "description": "Aktif paketleri filtrele",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "includes_pt",
            "in": "query",
            "description": "PT dahil paketleri filtrele",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paket listesi başarıyla getirildi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/MembershipPackage"
                      }
                    },
                    "pagination": {
                      "$ref": "#/components/schemas/Pagination"
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": [
                    {
                      "package_id": 1,
                      "name": "Aylık Üyelik",
                      "description": "Tüm ekipmanlara sınırsız erişim",
                      "duration_days": 30,
                      "price": 500,
                      "max_freezes": 1,
                      "max_freeze_days": 7,
                      "includes_pt": false,
                      "pt_sessions": 0,
                      "is_active": true
                    },
                    {
                      "package_id": 2,
                      "name": "3 Aylık Üyelik + PT",
                      "description": "3 aylık üyelik ve 12 PT seansı",
                      "duration_days": 90,
                      "price": 2000,
                      "max_freezes": 2,
                      "max_freeze_days": 14,
                      "includes_pt": true,
                      "pt_sessions": 12,
                      "is_active": true
                    }
                  ],
                  "pagination": {
                    "page": 1,
                    "limit": 10,
                    "totalItems": 5,
                    "totalPages": 1
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "post": {
        "summary": "Yeni üyelik paketi oluştur",
        "description": "Salon için yeni bir üyelik paketi oluşturur.\n\n**Yetki:** Sadece Admin\n\n**Paket Özellikleri:**\n- Süre (gün cinsinden)\n- Fiyat\n- Dondurma hakları\n- PT seansları (opsiyonel)\n",
        "tags": [
          "Packages"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PackageCreate"
              },
              "examples": {
                "basic": {
                  "summary": "Temel aylık üyelik",
                  "value": {
                    "name": "Aylık Üyelik",
                    "description": "Tüm ekipmanlara sınırsız erişim",
                    "duration_days": 30,
                    "price": 500,
                    "max_freezes": 1,
                    "max_freeze_days": 7
                  }
                },
                "withPT": {
                  "summary": "PT dahil paket",
                  "value": {
                    "name": "3 Aylık Premium",
                    "description": "3 aylık üyelik + 12 PT seansı",
                    "duration_days": 90,
                    "price": 2500,
                    "max_freezes": 2,
                    "max_freeze_days": 14,
                    "includes_pt": true,
                    "pt_sessions": 12
                  }
                },
                "yearly": {
                  "summary": "Yıllık üyelik",
                  "value": {
                    "name": "Yıllık Üyelik",
                    "description": "365 gün sınırsız erişim",
                    "duration_days": 365,
                    "price": 4500,
                    "max_freezes": 3,
                    "max_freeze_days": 30
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Paket başarıyla oluşturuldu",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Paket başarıyla oluşturuldu"
                    },
                    "data": {
                      "$ref": "#/components/schemas/MembershipPackage"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Doğrulama hatası",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                },
                "examples": {
                  "duplicateName": {
                    "summary": "Paket adı mevcut",
                    "value": {
                      "success": false,
                      "message": "Bu isimde bir paket zaten mevcut"
                    }
                  },
                  "validation": {
                    "summary": "Doğrulama hatası",
                    "value": {
                      "success": false,
                      "message": "Doğrulama hatası",
                      "errors": [
                        {
                          "msg": "Paket adı zorunludur",
                          "path": "name"
                        },
                        {
                          "msg": "Fiyat 0'dan büyük olmalıdır",
                          "path": "price"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/api/admin/packages/{id}": {
      "get": {
        "summary": "Paket detaylarını getir",
        "description": "Belirtilen ID'ye sahip paketin detaylarını getirir.\nPaketi kullanan aktif abonelik sayısı da dahildir.\n\n**Yetki:** Admin veya Eğitmen\n",
        "tags": [
          "Packages"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Paket ID'si",
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Paket detayları başarıyla getirildi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/MembershipPackage"
                        },
                        {
                          "type": "object",
                          "properties": {
                            "activeSubscriptionCount": {
                              "type": "integer",
                              "description": "Bu paketi kullanan aktif abonelik sayısı",
                              "example": 25
                            }
                          }
                        }
                      ]
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "package_id": 1,
                    "salon_id": 1,
