    "/v1/organizations/{organization_id_L2H_LL}/shipments": {
      "parameters": [
        {
          "name": "organization_id_L2H_LL",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/organization_id"
          }
        }
      ],
      "post": {
        "tags": [
          "ShipX - Shipments",
          "UC/ShipX - Shipments"
        ],
        "summary": "UC/Shipments Locker2Hub (Label-less)",
        "description": "Shipments Locker2Hub (Label-less)",
        "operationId": "createShipmentL2H_LL",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "description": "This requestBody contains specific data and information for a L2H shipment use-case.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "receiver": {
                    "$ref": "#/components/schemas/receiver"
                  },
                  "sender": {
                    "$ref": "#/components/schemas/receiver",
                    "description": "If no data are provided, the data of the organization under which the shipment is being created will be used by default"
                  },
                  "parcels": {
                    "oneOf": [
                      {
                        "$ref": "#/components/schemas/parcels_template"
                      },
                      {
                        "$ref": "#/components/schemas/parcels_array"
