    "/v1/shipments/{shipment_id}/attributes": {
      "parameters": [
        {
          "name": "shipment_id",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/shipment_id"
          }
        },
        {
          "name": "reference",
          "in": "query",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/reference",
            "description": "Additional shipment description that will be printed in the label (e.g. order number).\nThe new reference should be encoded (SPACE is encoded as '+' or \"%20\").\n",
            "example": "New%20ORDER-CODE:#001000990"
          }
        }
      ],
      "put": {
        "tags": [
          "ShipX - Labels"
        ],
        "summary": "Shipment Reference Edit",
        "description": "Requirements: \n- this feature is disabled by default. The activation is enabled on-demand by contacting InPost's integration team.\n- in order to change a shipment reference, the parcel should have the `pickup_time_expired` or `stored` status.\n",
        "operationId": "shipmentEditReference",
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/shipments/{shipment_id}/label": {
      "parameters": [
        {
          "name": "shipment_id",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/shipment_id"
          }
        }
      ],
      "get": {
        "tags": [
          "ShipX - Labels"
        ],
        "summary": "Label",
        "description": "Get label in various format.",
        "operationId": "getLabel",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/format"
          },
          {
            "$ref": "#/components/parameters/type-2"
          }
        ],
        "responses": {
          "200": {
            "description": "File",
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tracking/{tracking_number}": {
      "parameters": [
        {
          "name": "tracking_number",
          "in": "path",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/tracking_number"
          }
        }
      ],
      "get": {
        "tags": [
          "ShipX - Tracking"
        ],
        "summary": "Tracking",
        "description": "For implementing an on-demand alignment, the best solution can be request of the tracking via ShipX Tracking API with the tracking number\n\nTracking resource is an object **representing information about the current status of the shipment in the logistics system**. It can be utilized to get information about the creation, status change and status history of the shipment\n",
        "operationId": "getTracking",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "tracking_number": "820100559215100015577452",
                  "service": "inpost_locker_standard",
                  "type": "inpost_locker_standard",
                  "status": "confirmed",
                  "custom_attributes": {
                    "size": "A",
                    "target_machine_id": "ITALE23817",
                    "target_machine_detail": {
                      "name": "ITALE23817",
                      "opening_hours": "24/7",
                      "location_description": "COOP Alessandria - Via Sclavo 15",
                      "location": {
                        "latitude": 44.91389,
                        "longitude": 8.6327
                      },
                      "address": {
                        "line1": "Via Sclavo 15",
                        "line2": "15100 Alessandria"
                      },
                      "type": [
                        "parcel_locker"
                      ],
                      "location247": true
                    },
                    "end_of_week_collection": false
                  },
                  "tracking_details": [
                    {
                      "status": "confirmed",
                      "origin_status": "Prepared",
                      "agency": "RM",
                      "datetime": "2022-02-14T12:48:19.000+01:00"
                    }
                  ],
                  "expected_flow": [],
                  "created_at": "2022-02-14T12:48:18.926+01:00",
                  "updated_at": "2022-02-14T12:48:19.570+01:00"
                }
              }
            }
          },
          "400": {
            "description": "uknown_tracking_number",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "status": 400,
                  "error": "uknown_tracking_number",
                  "message": "Cannot identify type of shipment by given tracking number (612345678901234567890123)",
                  "details": null
                }
              }
            }
          },
          "404": {
            "description": "resource_not_found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "status": 404,
                  "error": "resource_not_found",
                  "description": "Tracking information about 612345678901234567890123 InPost Locker shipment has not been found.",
                  "details": null
                }
              }
            }
          }
        }
      }
    },
    "/v1/statuses": {
      "get": {
        "tags": [
          "ShipX - Tracking"
        ],
        "summary": "Shipment Tracking Statuses",
        "description": "|Status|Description |\n |--------------|---------------|\n |created |Parcel created, but not ready for shipment. |\n |confirmed            |The label is ready for the download, but the journey of the parcel has not yet begun. |\n |dispatched_by_sender     |The parcel is waiting for the courier to collect from the parcel machine or PUDO. From there it will go to the nearest InPost branch and then to the collection parcel machine. |\n |taken_by_courier    |The parcel has been picked up from the Sender and is being delivered to the parcel machine indicated by you. |\n |adopted_at_source_branch |The parcel has been delivered to an InPost branch, from where it will soon set off on its further journey. |\n |sent_from_source_branch |The parcel has been sent from InPost branch, to the destination InPost depot. |\n |adopted_at_sorting_center  |The parcel has get into the InPost sorting center. |\n |sent_from_sorting_center  |The parcel has left the InPost sorting center. |\n |adopted_at_target_branch  |The parcel has arrived to the destination InPost branch, it will go out for delivery soon. |\n |out_for_delivery |The shipment will reach the recipient on the next working day at the latest.  |\n |ready_to_pickup |It\u2019s done! The parcel will wait for the collection in the Parcel Machine or PUDO. The Receiver gets a notification, a text message and an e-mail with the collection code. If the parcel is not collected within this time, it will be returned to the Sender, which will be notified to the Receiver in a separate communication. |\n |delivered |The journey of the parcel from the Sender to the Recipient has ended. |\n |pickup_reminder_sent |You still have some hours to collect the parcel from the parcel machine or PUDO (depending on the specific contract). Then it will be returned to the Sender |\n |pickup_time_expired |The time for you to collect the parcel from the parcel machine or PUDO has passed. InPost delivery man will take the parcel to your branch at the next visit to the parcel machine. The Recipient still has a chance to collect the parcel if he arrives at the parcel machine before the delivery man. |\n |missing |Under investigation. Please reach out to InPost CS team for further information. |\n |claimed |The end user has opened a claim and the parcel is currently under investigation.  |\n |returned_to_sender |The parcel has completed its way back to the Sender. |\n |other |Internal technical status which may vary depending on each case. For additional info reach out to CS team |\n |oversized |The parcel exceeds the maximum weight allowance and/or dimensions accepted by InPost.  |\n |handed_over |Parcel transferred for transport abroad. |\n |returned_to_agency |The parcel is in the InPost depot, on its way back to the Sender. |\n |canceled |The shipping label has been canceled or expired. The parcel has not been sent to the Recipient. |\n |collected_from_sender |Courier collected the parcel from the Sender and passes it to the InPost branch. |",
        "operationId": "shipments_statuses",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "href": "http://stage-api-shipx-it.easypack24.net/v1/statuses",
                  "items": [
                    {
                      "name": "created",
                      "title": "Parcel created.",
                      "description": "Parcel created, but not ready for shipment."
                    },
                    {
                      "name": "confirmed",
                      "title": "Prepared by the Sender.",
                      "description": "The Sender informed us that they had prepared the parcel for shipment. The journey of the parcel has not yet begun."
                    },
                    {
                      "name": "dispatched_by_sender",
                      "title": "Parcel shipped at the parcel machine.",
                      "description": "The parcel is waiting for the delivery man to take it out of the parcel machine. From there it will go to the nearest InPost branch and then to the collection parcel machine."
                    },
                    {
                      "name": "taken_by_courier",
                      "title": "Picked up from Sender.",
                      "description": "The parcel has been picked up from the Sender and is being delivered to the parcel machine indicated by you."
                    },
                    {
                      "name": "out_for_delivery",
                      "title": "Handed over for delivery.",
                      "description": "The shipment will reach the recipient on the next working day at the latest. InPost delivery men deliver parcels even late in the evening, so it is worth having your phone on."
                    },
                    {
                      "name": "ready_to_pickup",
                      "title": "Placed in the (collection) parcel machine.",
                      "description": "It\u2019s done! The parcel will wait for the collection in the Parcel Machine. The Receiver gets a notification in the application, a text message and an e-mail with the collection code. If the parcel is not collected within this time, it will be returned to the Sender, which will be notified to the Receiver in a separate communication."
                    },
                    {
                      "name": "delivered",
                      "title": "Delivered.",
                      "description": "The journey of the parcel from the Sender to the Recipient has ended, but it does not have to mean the end of our acquaintance:) If you like InPost, visit our fanpage on Facebook. Thank you!"
                    },
                    {
                      "name": "pickup_reminder_sent",
                      "title": "Reminder of a pending parcel.",
                      "description": "You still have 12 hours to collect the parcel from the parcel machine. Then it will be returned to the Sender. Do you want to extend the stay of your parcel for a fee? Do it in InPost App. Read about it on our website https://inpost.pl/przedluzenie-czasu-odbioru-paczki"
                    },
                    {
                      "name": "pickup_time_expired",
                      "title": "The deadline for collecting has passed.",
                      "description": "The time for you to collect the parcel from the parcel machine has passed. InPost delivery man will take the parcel to your branch at the next visit to the parcel machine. The Recipient still has a chance to collect the parcel if he arrives at the parcel machine before the delivery man."
                    },
                    {
                      "name": "missing",
                      "title": "translation missing: en_GB.statuses.missing.title",
                      "description": "translation missing: en_GB.statuses.missing.description"
                    },
                    {
                      "name": "canceled",
                      "title": "The label was cancelled.",
                      "description": "The shipping label has been canceled or expired. The parcel has not been sent to the Recipient."
                    },
                    {
                      "name": "claimed",
                      "title": "Complained in Parcel Machine.",
                      "description": "Please complete the complaint process by filling out the form on the InPost website."
                    },
                    {
                      "name": "returned_to_sender",
                      "title": "Return to sender.",
                      "description": "The parcel has set off on its way back to the Sender."
                    },
                    {
                      "name": "other",
                      "title": "Other status.",
                      "description": "The parcel is in an unrecognized status."
                    },
                    {
                      "name": "oversized",
                      "title": "Oversize parcel.",
                      "description": "The parcel does not fit into the locker of the parcel machine."
                    },
                    {
                      "name": "handed_over",
                      "title": "Handed over.",
                      "description": "Parcel transferred for transport abroad."
                    },
                    {
                      "name": "returned_to_agency",
                      "title": "Returned to agency.",
                      "description": "Parcel in depot ready to be returned to sender."
                    },
                    {
                      "name": "collected_from_sender",
                      "title": "Picked up from the client.",
                      "description": "Courier collected the parcel from the Sender and passes it to the InPost branch."
                    },
                    {
                      "name": "adopted_at_sorting_center",
                      "title": "Parcel waiting for transferring.",
                      "description": "The parcel is waiting to be transferred to the destination town. Most InPost parcels stop at the Main Sorting Facility for a while. Up to one million parcels per day are sorted in the state-of-the-art warehouse!"
                    },
                    {
                      "name": "adopted_at_source_branch",
                      "title": "Parcel in the warehouse.",
                      "description": "The parcel is in our warehouse, from here it will start its journey."
                    },
                    {
                      "name": "adopted_at_target_branch",
                      "title": "The parcel is in town.",
                      "description": "The parcel is already in the Recipient's town. Soon it will reach the hands of the delivery man and begin the final leg of the journey."
                    },
                    {
                      "name": "sent_from_sorting_center",
                      "title": "Sent from the Sorting Facility.",
                      "description": "The parcel is going to the Recipient's town."
                    },
                    {
                      "name": "sent_from_source_branch",
                      "title": "On the road.",
                      "description": "Your parcel is on its way to the next intermediate hub."
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Our APIs are divided into two categories:\n- **Public**: no security parameters required.\n- **Private**: a Bearer Token linked to your company will be required, in some cases, you will also need your OrganizationID as path parameter.\n\n### Request access\nTo get your **Bearer Token** and **OrganizationID** please contact InPost on the email provided at the top of this page.\n\nRemember that we provide two different token: one for **production environment** and one for **staging environment**. "
      }
    },
    "parameters": {
      "name": {
        "name": "name",
        "in": "query",
        "description": "Searches for points by name. \n\n*case-sensitive: parameter in capital letters.*\n",
        "schema": {
          "type": "string",
          "example": "ITMIL00001P OR ITMIL00001P,ITMIL00005P,..."
        }
      },
      "type": {
        "name": "type",
        "in": "query",
        "description": "Searches for points by type.",
        "schema": {
          "$ref": "#/components/schemas/type",
          "example": "pop OR parcel_locker,pop,..."
        }
      },
      "functions": {
        "name": "functions",
        "in": "query",
        "description": "Searches for points by functions.",
        "schema": {
          "type": "string",
          "$ref": "#/components/schemas/functions",
          "example": "parcel OR parcel,parcel_send,..."
        }
      },
      "partner_id": {
        "name": "partner_id",
        "in": "query",
        "description": "Searches for points by partner_id.",
        "schema": {
          "type": "string",
          "example": "1,0,... OR 1"
        }
      },
      "is_next": {
        "name": "is_next",
        "in": "query",
        "description": "Filter for NEXT points.",
        "schema": {
          "type": "boolean",
          "example": true
        }
      },
      "payment_available": {
        "name": "payment_available",
        "in": "query",
        "description": "Searches by point's payment availability.",
        "schema": {
          "type": "boolean",
          "example": true
        }
      },
      "city": {
        "name": "city",
        "in": "query",
        "description": "Searches for points with given cities.  \n\n*case-sensitive*: parameters with the first capital letter.\n",
        "schema": {
          "type": "string",
          "example": "Roma,Lecce,... OR Roma"
        }
      },
      "province": {
        "name": "province",
        "in": "query",
        "description": "Searches for points with given provinces.\n\n*case-sensitive*: parameters with capital letters.\n",
        "schema": {
          "maxLength": 2,
          "minLength": 2,
          "type": "string",
          "example": "MI,BA,... OR MI"
        }
      },
      "relative_point": {
        "name": "relative_point",
        "in": "query",
        "description": "Searches for points closest to the given coordinates.",
        "schema": {
          "type": "string",
          "format": "latitude,longitude",
          "example": "52.123,19.321"
        }
      },
      "relative_post_code": {
        "name": "relative_post_code",
        "in": "query",
        "description": "Searches for points closest to the given postcode.",
        "schema": {
          "type": "string",
          "example": 20068
        }
      },
      "max_distance": {
        "name": "max_distance",
        "in": "query",
        "description": "Searches for points in distance up to the given value from `relative_point` or `relative_post_code`.",
        "schema": {
          "type": "number",
          "example": 2000,
          "default": 10000,
          "format": "meters",
          "maximum": 50000
        }
      },
      "limit": {
        "name": "limit",
        "in": "query",
        "description": "Limit the maximum number of points retrieved when using `relative_point` or `relative_post_code`.",
        "schema": {
          "type": "number",
          "example": 10
        }
      },
      "points_sort_by": {
        "name": "sort_by",
        "in": "query",
        "description": "**SORTING:** Sorts results by given parameter.",
        "schema": {
          "type": "string",
          "enum": [
            "name",
            "distance_to_relative_point",
            "status"
          ],
          "example": "status",
          "default": "name"
        }
      },
      "sort_order": {
        "name": "sort_order",
        "in": "query",
        "description": "**SORTING:** Set sort .",
        "schema": {
          "type": "string",
          "enum": [
            "asc",
            "desc"
          ],
          "example": "desc",
          "default": "asc"
        }
      },
      "page": {
        "name": "page",
        "in": "query",
        "description": "**PAGINATION:** Defines the page for which the results should be returned.",
        "schema": {
          "type": "number",
          "example": 4,
          "default": 1
        }
      },
      "per_page": {
        "name": "per_page",
        "in": "query",
        "description": "**PAGINATION:** Defines the amount of points returned per page.",
        "schema": {
          "type": "number",
          "example": 100,
          "default": 25,
          "maximum": 500
        }
      },
      "fields": {
        "name": "fields",
        "in": "query",
        "description": "**ATTRIBUTES-FILTERING:** Defines the point attributes that should be returned.",
        "schema": {
          "type": "string",
          "example": "name,type"
        }
      },
      "id": {
        "name": "id",
        "in": "query",
        "description": "Searches for shipment by ID or IDs.",
        "schema": {
          "type": "string",
          "example": "44792,44791"
        }
      },
      "created_at": {
        "name": "created_at",
        "in": "query",
        "description": "Filter by creation date",
        "schema": {
          "type": "string",
          "example": "2016-01-07"
        }
      },
      "created_at_gteq": {
        "name": "created_at_gteq",
        "in": "query",
        "description": "Filter for shipments created after given date.",
        "schema": {
          "type": "string",
          "format": "timestamp",
          "example": "1451650200"
        }
      },
      "created_at_lteq": {
        "name": "created_at_lteq",
        "in": "query",
        "description": "Filter for shipments created before given date.",
        "schema": {
          "type": "string",
          "format": "timestamp",
          "example": "1451650200"
        }
      },
      "tracking_number": {
        "name": "tracking_number",
        "in": "query",
        "description": "Filter by tracking number",
        "schema": {
          "$ref": "#/components/schemas/tracking_number"
        }
      },
      "status": {
        "name": "status",
        "in": "query",
        "description": "Filter for shipments with given [statuses](/#operation/shipments_statuses).",
        "schema": {
          "type": "string",
          "example": "confirmed"
        }
      },
      "service": {
        "name": "service",
        "in": "query",
        "description": "Searches for shipments with given service or services.",
        "schema": {
          "type": "string",
          "example": "inpost_locker_standard"
        }
      },
      "carrier": {
        "name": "carrier",
        "in": "query",
        "description": "Searches for shipments with given carrier or carriers.",
        "schema": {
          "type": "string",
          "example": "InPost%20Kurier"
        }
      },
      "receiver_name": {
        "name": "receiver_name",
        "in": "query",
        "description": "Searches for shipments for which the receiver first_name, last_name or company_name starts with the given string.",
        "schema": {
          "type": "string",
          "example": "Smith"
        }
      },
      "receiver_address": {
        "name": "receiver_address",
        "in": "query",
        "description": "Searches for shipments for which receiver address starts with the given string.",
        "schema": {
          "type": "string",
          "example": "Zaw"
        }
      },
      "receiver_city": {
        "name": "receiver_city",
        "in": "query",
        "description": "Searches for shipments with receivers city matching the given string",
        "schema": {
          "type": "string",
          "example": "Roma"
        }
      },
      "receiver_post_code": {
        "name": "receiver_post_code",
        "in": "query",
        "description": "Searches for shipments which receivers postal code starts with the given string",
        "schema": {
          "type": "string",
          "example": 20060
        }
      },
      "receiver_country_code": {
        "name": "receiver_country_code",
        "in": "query",
        "description": "Searches for shipments with receivers country code matching the given string",
        "schema": {
          "type": "string",
          "example": "IT"
        }
      },
      "receiver_phone": {
        "name": "receiver_phone",
        "in": "query",
        "description": "Searches for shipments with receivers telephone number matching the given string",
        "schema": {
          "type": "string",
          "example": 320009988
        }
      },
      "receiver_email": {
        "name": "receiver_email",
        "in": "query",
        "description": "Searches for shipments which receivers email starts with the given string",
        "schema": {
          "type": "string",
          "example": "devnull@inpost.pl"
        }
      },
      "sender_name": {
        "name": "sender_name",
        "in": "query",
        "description": "Searches for shipments for which the sender first_name, last_name or company_name starts with the given string.",
        "schema": {
          "type": "string",
          "example": "Smith"
        }
      },
      "sender_address": {
        "name": "sender_address",
        "in": "query",
        "description": "Searches for shipments for which sender address starts with the given string.",
        "schema": {
          "type": "string",
          "example": "Zaw"
        }
      },
      "sender_city": {
        "name": "sender_city",
        "in": "query",
        "description": "Searches for shipments with senders city matching the given string",
        "schema": {
          "type": "string",
          "example": "Roma"
        }
      },
      "sender_post_code": {
        "name": "sender_post_code",
        "in": "query",
        "description": "Searches for shipments which sender's postal code starts with the given string",
        "schema": {
          "type": "string",
          "example": 20060
        }
      },
      "sender_country_code": {
        "name": "sender_country_code",
        "in": "query",
        "description": "Searches for shipments with senders country code matching the given string",
        "schema": {
          "type": "string",
          "example": "IT"
        }
      },
      "sender_phone": {
        "name": "sender_phone",
        "in": "query",
        "description": "Searches for shipments with sender's telephone number matching the given string",
        "schema": {
          "type": "string",
          "example": 320009988
        }
      },
      "sender_email": {
        "name": "sender_email",
        "in": "query",
        "description": "Searches for shipments which senders email starts with the given string",
        "schema": {
          "type": "string",
          "example": "devnull@inpost.pl"
        }
      },
      "external_customer_id": {
        "name": "external_customer_id",
        "in": "query",
        "description": "Searches for shipments created by a broker for which the id is identical to the given string",
        "schema": {
          "type": "string",
          "example": "Broker390"
        }
      },
      "shipments_sort_by": {
        "name": "sort_by",
        "in": "query",
        "description": "**SORTING:** Sorts results by given parameter.",
        "schema": {
          "type": "string",
          "enum": [
            "id",
            "created_at",
            "tracking_number",
            "service",
            "status",
            "insurance_amount",
            "cod_amount",
            "external_customer_id"
          ],
          "example": "id",
          "default": "created_at"
        }
      },
      "format": {
        "name": "format",
        "in": "query",
        "description": "Label's file type",
        "schema": {
          "type": "string",
          "enum": [
            "pdf",
            "zpl"
          ],
          "example": "pdf",
          "default": "pdf"
        }
      },
      "type-2": {
        "name": "type",
        "in": "query",
        "description": "Label's page format",
        "schema": {
          "type": "string",
          "enum": [
            "normal",
            "A6"
          ],
          "example": "normal"
        }
      }
    },
    "schemas": {
      "type": {
        "type": "array",
        "description": "Point types:\n * `parcel_locker` - APM \n * `pok` - PUDO\n * `pop` - Post Office (Not used in Italy)\n",
        "items": {
          "type": "string",
          "enum": [
            "parcel_locker",
            "pok",
            "pop"
          ]
        },
        "example": [
          "pok",
          "pop"
        ]
      },
      "functions": {
        "type": "array",
        "description": "Functions offered by the point:\n  * `parcel` - Send and collect standard parcel \n  * `parcel_send` - Standard parcel send \n  * `parcel_collect` - Standard parcel collect \n  * `parcel_reverse_return_send`- Standard parcel reverse return to sender \n  * `standard_courier_send` - Courier parcel send\n",
        "items": {
          "type": "string",
          "enum": [
            "parcel",
            "parcel_send",
            "parcel_collect",
            "parcel_reverse_return_send",
            "standard_courier_send"
          ]
        },
        "example": [
          "parcel",
          "parcel_collect",
          "parcel_reverse_return_send",
          "parcel_send",
          "standard_courier_send"
        ]
      },
      "status": {
        "type": "string",
        "description": "The current Point status\n  * `Created` - just added in our Console, not visible anywhere\n  * `Operating` - fully functional\n  * `NonOperating` - something is not working (temporary, can be used)\n  * `Overloaded` - no compartment available, every compartment is used (temporary, can be used)\n  * `Disabled` - intentionally marked to prevent its usage (under maintenance, shouldn't be used)\n  * `Removed` - doesn't exists anymore (permanent)\n",
        "example": "Operating",
        "enum": [
          "Created",
          "Operating",
          "NonOperating",
          "Overloaded",
          "Disabled",
          "Removed"
        ]
      },
      "address_details": {
        "type": "object",
        "description": "Point complete address with specific properties.",
        "properties": {
          "city": {
            "type": "string",
            "example": "Abbiategrasso"
          },
          "province": {
            "type": "string",
            "maxLength": 2,
            "minLength": 2,
            "example": "MI"
          },
          "post_code": {
            "type": "string",
            "example": 20081
          },
          "street": {
            "type": "string",
            "example": "Via Pavia c/o Abbiategrasso Energie"
          },
          "building_number": {
            "type": "string",
            "example": 14
          },
          "flat_number": {
            "type": "string",
            "example": null
          }
        }
      },
      "operating_hours_extended": {
        "type": "object",
        "description": "Is available when `location_247=false`.",
        "properties": {
          "customer": {
            "type": "object",
            "properties": {
              "monday": {
                "description": "List of objects containing available time slots for the weekday:\n  * `start` - Integer, minutes after midnight \n  * `end` - Integer, minutes after midnight\n",
                "type": "array",
                "example": [
                  {
                    "start": 540,
                    "end": 750
                  },
                  {
                    "start": 930,
                    "end": 1140
                  }
                ]
              },
              "tuesday": {
                "description": "List of objects containing available time slots for the weekday:\n  * `start` - Integer, minutes after midnight \n  * `end` - Integer, minutes after midnight\n",
                "type": "array",
                "example": [
                  {
                    "start": 540,
                    "end": 750
                  },
                  {
                    "start": 930,
                    "end": 1140
                  }
                ]
              },
              "wednesday": {
                "description": "List of objects containing available time slots for the weekday:\n  * `start` - Integer, minutes after midnight \n  * `end` - Integer, minutes after midnight\n",
                "type": "array",
                "example": [
                  {
                    "start": 540,
                    "end": 750
                  },
                  {
                    "start": 930,
                    "end": 1140
                  }
                ]
              },
              "thursday": {
                "description": "List of objects containing available time slots for the weekday:\n  * `start` - Integer, minutes after midnight \n  * `end` - Integer, minutes after midnight\n",
                "type": "array",
                "example": [
                  {
                    "start": 930,
                    "end": 1140
                  }
                ]
              },
              "friday": {
                "description": "List of objects containing available time slots for the weekday:\n  * `start` - Integer, minutes after midnight \n  * `end` - Integer, minutes after midnight\n",
                "type": "array",
                "example": [
                  {
                    "start": 540,
                    "end": 750
                  },
                  {
                    "start": 930,
                    "end": 1140
                  }
                ]
              },
              "saturday": {
                "description": "List of objects containing available time slots for the weekday:\n  * `start` - Integer, minutes after midnight \n  * `end` - Integer, minutes after midnight\n",
                "type": "array",
                "example": [
                  {
                    "start": 540,
                    "end": 750
                  }
                ]
              },
              "sunday": {
                "description": "List of objects containing available time slots for the weekday:\n  * `start` - Integer, minutes after midnight \n  * `end` - Integer, minutes after midnight\n",
                "type": "array",
                "example": []
              }
            }
          }
        }
      },
      "point": {
        "type": "object",
        "description": "An item is basically a Point",
        "properties": {
          "href": {
            "description": "API URI for specific Point",
            "type": "string",
            "minLength": 0,
            "example": "https://stage-api-shipx-it.easypack24.net/v1/points/ITABB00496P"
          },
          "name": {
            "description": "Point ID",
            "type": "string",
            "minLength": 0,
            "example": "ITABB00496P"
          },
          "type": {
            "$ref": "#/components/schemas/type"
          },
          "status": {
            "$ref": "#/components/schemas/status"
          },
          "location": {
            "description": "Point coordinates",
            "type": "object",
            "properties": {
              "longitude": {
                "description": "Longitude co-ordinate of the Point location.",
                "type": "number",
                "example": 8.91682
              },
              "latitude": {
                "description": "Latitude co-ordinate of the Point location.",
                "type": "number",
                "example": 45.39495
              }
            }
          },
          "location_type": {
            "description": "Not used in italy.",
            "type": "string",
            "example": null
          },
          "location_date": {
            "description": "Not used in italy.",
            "type": "string",
            "example": null
          },
          "location_description": {
            "description": "The name of point's location",
            "type": "string",
            "example": "Presso Abbiategrasso Energie"
          },
          "location_description_1": {
            "description": "Further explaination about how to reach the Point.",
            "type": "string",
            "example": "Secondo piano, porta verde"
          },
          "location_description_2": {
            "description": "Not used.",
            "type": "string",
            "example": null
          },
          "distance": {
            "description": "If `relative_point` parameter is set. Shows the distance (meters) from the relative point location.",
            "type": "integer",
            "example": null
          },
          "opening_hours": {
            "description": "Point operating hours (dismissed).",
            "type": "string",
            "example": "Lun-Ven: 9:00 - 13:00 - 15:30 - 19:00 Sab: 9:00 - 12:00"
          },
          "address": {
            "description": "Point address recap on two lines (used also for parcel labels).",
            "type": "object",
            "properties": {
              "line1": {
                "description": "Address and building number.",
                "type": "string",
                "example": "Via Pavia c/o Abbiategrasso Energie 14"
              },
              "line2": {
                "description": "Zip code and city.",
                "type": "string",
                "example": "20081 Abbiategrasso"
              }
            }
          },
          "address_details": {
            "$ref": "#/components/schemas/address_details"
          },
          "phone_number": {
            "description": "Not used.",
            "type": "string",
            "example": null
          },
          "payment_point_descr": {
            "description": "Not used.",
            "type": "string",
            "example": null
          },
          "functions": {
            "$ref": "#/components/schemas/functions"
          },
          "partner_id": {
            "description": "Identiy the courier (InPost Logistic = 1)",
            "type": "integer",
            "example": 1
          },
          "is_next": {
            "description": "Not used in Italy.",
            "type": "boolean",
            "example": false
          },
          "payment_available": {
            "description": "Not used in Italy.",
            "type": "boolean",
            "example": true
          },
          "payment_type": {
            "description": "Not used in Italy.",
            "type": "object",
            "example": null
          },
          "virtual": {
            "description": "Not used in Italy.",
            "type": "string",
            "example": null
          },
          "recommended_low_interest_box_machines_list": {
            "description": "Not used in Italy. List of recommended points nearby.",
            "type": "array",
            "example": [
              "ITABB00496P",
              "ITABB00400P",
              "ITABB00996P"
            ]
          },
          "apm_doubled": {
            "description": "Not used in Italy.",
            "example": null
          },
          "location_247": {
            "description": "Identify points available 24/7.",
            "type": "boolean",
            "example": false
          },
          "operating_hours_extended": {
            "$ref": "#/components/schemas/operating_hours_extended"
          },
          "agency": {
            "description": "Identify the linked logistic agency",
            "type": "string",
            "example": "MI"
          },
          "image_url": {
            "description": "The point image",
            "type": "string",
            "example": "https://static.easypack24.net/points/it/images/ITABB00496P.jpg"
          },
          "easy_access_zone": {
            "description": "Not used in Italy. Does the parcel locker have an easy access zone?",
            "type": "boolean",
            "example": null
          },
          "air_index_level": {
            "description": "Not used in Italy.",
            "type": "boolean",
            "example": null
          }
        }
      },
      "points": {
        "type": "object",
        "properties": {
          "href": {
            "description": "The used endpoint server.",
            "type": "string",
            "minLength": 1,
            "example": "https://stage-api-shipx-it.easypack24.net/v1/points"
          },
          "count": {
            "description": "Available points found",
            "type": "integer",
            "minLength": 1,
            "example": 940
          },
          "page": {
            "description": "The current page (usefull when you use pagination query parameters **page** and **per_page**)",
            "type": "integer",
            "minLength": 1,
            "example": 1,
            "default": 1
          },
          "per_page": {
            "description": "Points per page (usefull when you use pagination query parameters **page** and **per_page**)",
            "type": "integer",
            "minLength": 1,
            "example": 25,
            "default": 25
          },
          "total_pages": {
            "description": "Total number of pages page (usefull when you use pagination query parameters **page** and **per_page**)",
            "type": "integer",
            "minLength": 1,
            "example": 38
          },
          "items": {
            "description": "The list of Lockers & PUDOs",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/point"
            }
          }
        }
      },
      "organization_id": {
        "type": "number",
        "description": "Your `organization_id` provided with the API Token. [Read more in the Authentication section.](/#section/Authentication)",
        "example": 23
      },
      "tracking_number": {
        "type": "string",
        "description": "Tracking Id provided in all shipments.",
        "example": "820100559215100015577452"
      },
      "status-2": {
        "type": "string",
        "description": "The shipment's status\n",
        "example": "confirmed"
      },
      "service": {
        "type": "string",
        "description": "Service selected by the client.",
        "example": "inpost_locker_standard",
        "enum": [
          "inpost_locker_standard",
          "inpost_courier_c2c"
        ]
      },
      "application_id": {
        "type": "number",
        "description": "The application used for shipment creation",
        "example": 23
      },
      "custom_attributes": {
        "type": "object",
        "description": "Additional shipment attributes.\n",
        "properties": {
          "target_point": {
            "description": "The id of the destination Point.\n\n**IMPORTANT**: the target point has to be in **Operating** Status\n",
            "type": "string",
            "example": "ITARC23379"
          },
          "sending_method": {
            "description": "Identify the sending method. \n\n**IMPORTANT**: this parameter is mandatory [`parcel_locker`] in case of `L2L` and `L2H` shipments\n\n**IMPORTANT**: this parameter is mandatory [`any_point`] in case of `label-less` shipments\n",
            "type": "string",
            "enum": [
              "parcel_locker",
              "any_point"
            ],
            "example": "parcel_locker"
          }
        }
      },
      "address_shipment": {
        "type": "object",
        "description": "Complete address with specific properties.",
        "properties": {
          "city": {
            "type": "string",
            "example": "Abbiategrasso"
          },
          "post_code": {
            "type": "string",
            "example": 20081
          },
          "street": {
            "type": "string",
            "example": "Via Pavia c/o Abbiategrasso Energie"
          },
          "building_number": {
            "type": "string",
            "example": 14
          }
        }
      },
      "receiver": {
        "type": "object",
        "properties": {
          "company_name": {
            "description": "Is the name showed on labels\n\n**IMPORTANT** - If used:\n\n- `first_name` and `last_name` will be ignored.\n",
            "type": "string",
            "example": "Servizi SRL"
          },
          "first_name": {
            "description": "Is the first name showed on labels\n\n**IMPORTANT** - If used:\n- `last_name` field become mandatory\n- `company_name` field will be ignored \n",
            "type": "string",
            "example": "Francesco"
          },
          "last_name": {
            "description": "Is the last name showed on labels\n\n**IMPORTANT** - If used:\n- `first_name` field become mandatory\n- `company_name` field will be ignored \n",
            "type": "string",
            "example": "Pantaleo"
          },
          "email": {
            "description": "Used for notifications",
            "type": "string",
            "example": "test@gmail.com"
          },
          "phone": {
            "description": "Mobile italian phone used for notifications.\n\n- Don't use fixed telephone/landline numbers\n- International prefix is optional, but if it\u2019s present it has to be `+39` or `0039`\n- The number should always start with a `3` \n- Don't use special characters and blank\n\nYou can use this regex for input validation on the frontend\n\n`(^(\\(?(((\\+)|00)39)?\\)?(3)(\\d{8,9}))$)`\n",
            "maxLength": 10,
            "minLength": 9,
            "type": "string",
            "example": "3380000888"
          },
          "address": {
            "$ref": "#/components/schemas/address_shipment"
          }
        }
      },
      "reference": {
        "type": "string",
        "minLength": 3,
        "maxLength": 100,
        "description": "Additional shipment description that will be printed in the label (e.g. order number)",
        "example": "ORDER: #0011001"
      },
      "date": {
        "type": "string",
        "example": "2022-02-14T12:48:18.858+01:00"
      },
      "parcels_templates": {
        "type": "string",
        "description": "\nTemplate allowed:\n\n- small (8 x 38 x 64 cm) - **Max Weight:** 25kg\n- medium (19 x 38 x 64 cm) - **Max Weight:** 25kg\n- large (41 x 38 x 64 cm) - **Max Weight:** 25kg\n",
        "enum": [
          "small",
          "medium",
          "large"
        ]
      },
      "parcel": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "An identificative ID for the parcel. Mandatory when you have more than one parcel in the list.",
            "example": "small package"
          },
          "tracking_number": {
            "type": "string",
            "description": "The tracking number to use in the [Tracking API](/#operation/getTracking)",
            "example": "00001214542120021254"
          },
          "template": {
            "$ref": "#/components/schemas/parcels_templates"
          },
          "dimensions": {
            "type": "object",
            "description": "When the `template` parameter isn't used, you can use the `dimension` to specify parcel's dimensions.",
            "properties": {
              "length": {
                "type": "string",
                "example": 80
              },
              "width": {
                "type": "string",
                "example": 360
              },
              "height": {
                "type": "string",
                "example": 640
              },
              "unit": {
                "type": "string",
                "example": "mm"
              }
            }
          },
          "weight": {
            "type": "object",
            "description": "When the `template` parameter isn't used, you can use the `weight` to specify parcel's weight.",
            "properties": {
              "amount": {
                "type": "string",
                "example": 19
              },
              "unit": {
                "type": "string",
                "example": "kg"
              }
            }
          }
        }
      },
      "external_customer_id": {
        "type": "string",
        "description": "ID of the broker generating shipments within a different organization for customer service purpose",
        "example": 23
      },
      "shipment": {
        "type": "object",
        "description": "An item is basically a Shipment",
        "properties": {
          "href": {
            "description": "API URI for specific Shipment",
            "type": "string",
            "minLength": 0,
            "example": "https://stage-api-shipx-it.easypack24.net/v1/points/ITABB00496P"
          },
          "id": {
            "description": "Shipment ID",
            "type": "number",
            "minLength": 0,
            "example": 44792
          },
          "status": {
            "$ref": "#/components/schemas/status-2"
          },
          "tracking_number": {
            "$ref": "#/components/schemas/tracking_number"
          },
          "service": {
            "$ref": "#/components/schemas/service"
          },
          "application_id": {
            "$ref": "#/components/schemas/application_id"
          },
          "custom_attributes": {
            "$ref": "#/components/schemas/custom_attributes"
          },
          "sender": {
            "$ref": "#/components/schemas/receiver"
          },
          "receiver": {
            "$ref": "#/components/schemas/receiver"
          },
          "reference": {
            "$ref": "#/components/schemas/reference"
          },
          "created_at": {
            "$ref": "#/components/schemas/date",
            "description": "Shipment's creation date"
          },
          "updated_at": {
            "$ref": "#/components/schemas/date",
            "description": "Shipment's last update date"
          },
          "parcels": {
            "items": {
              "$ref": "#/components/schemas/parcel"
            }
          },
          "external_customer_id": {
            "$ref": "#/components/schemas/external_customer_id"
          },
          "sending_method": {
            "description": "Ignore this parameter and use the content of custom_attributes"
          }
        }
      },
      "shipments": {
        "type": "object",
        "properties": {
          "href": {
            "description": "The used endpoint server.",
            "type": "string",
            "minLength": 1,
            "example": "https://stage-api-shipx-it.easypack24.net/v1/points"
          },
          "count": {
            "description": "Available shipments found",
            "type": "integer",
            "minLength": 1,
            "example": 940
          },
          "page": {
            "description": "The current page (usefull when you use pagination query parameters **page** and **per_page**)",
            "type": "integer",
            "minLength": 1,
            "example": 1,
            "default": 1
          },
          "per_page": {
            "description": "Points per page (usefull when you use pagination query parameters **page** and **per_page**)",
            "type": "integer",
            "minLength": 1,
            "example": 25,
            "default": 25
          },
          "total_pages": {
            "description": "Total number of pages page (usefull when you use pagination query parameters **page** and **per_page**)",
            "type": "integer",
            "minLength": 1,
            "example": 38
          },
          "items": {
            "description": "The list of Shipments",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/shipment"
            }
          }
        }
      },
      "parcels_template": {
        "type": "object",
        "description": "Parcels included in the shipment.\n\n**IMPORTANT** Italian market support only one parcel per shipment.\n",
        "properties": {
          "template": {
            "$ref": "#/components/schemas/parcels_templates"
          }
        }
      },
      "parcels_array": {
        "type": "array",
        "description": "Parcels included in the shipment.\n\n**IMPORTANT** Italian market support only one parcel per shipment.\n",
        "items": {
          "$ref": "#/components/schemas/parcel"
        }
      },
      "additional_services": {
        "type": "array",
        "description": "Additional services lists, `required only in case of label-less shipment`.\n",
        "items": {
          "type": "string",
          "enum": [
            "labelless"
          ]
        },
        "example": [
          "labelless"
        ]
      },
      "custom_attributes_H2L": {
        "type": "object",
        "description": "Additional shipment attributes.\n",
        "properties": {
          "target_point": {
            "description": "The id of the destination Point.\n\n**IMPORTANT**: the target point has to be in **Operating** Status\n",
            "type": "string",
            "example": "ITARC23379"
          }
        }
      },
      "custom_attributes_L2L": {
        "type": "object",
        "description": "Additional shipment attributes.\n",
        "properties": {
          "target_point": {
            "description": "The id of the destination Point.\n\n**IMPORTANT**: the target point has to be in **Operating** Status\n",
            "type": "string",
            "example": "ITARC23379"
          },
          "sending_method": {
            "description": "Identify the sending method. \n\n**IMPORTANT**: in case of L2L shipment, the parameter should be `parcel_locker`\n\n**IMPORTANT**: this parameter is mandatory [`any_point`] in case of `label-less` shipments\n",
            "type": "string",
            "enum": [
              "parcel_locker",
              "any_point"
            ],
            "example": "parcel_locker"
          }
        }
      },
      "custom_attributes_L2L-LL": {
        "type": "object",
        "description": "Additional shipment attributes.\n",
        "properties": {
          "target_point": {
            "description": "The id of the destination Point.\n\n**IMPORTANT**: the target point has to be in **Operating** Status\n",
            "type": "string",
            "example": "ITARC23379"
          },
          "sending_method": {
            "description": "Identify the sending method. \n\n**IMPORTANT**: this parameter is mandatory [`any_point`] in case of `label-less` shipments\n",
            "type": "string",
            "enum": [
              "parcel_locker",
              "any_point"
            ],
            "example": "any_point"
          }
        }
      },
      "custom_attributes_L2H": {
        "type": "object",
        "description": "Additional shipment attributes.\n",
        "properties": {
          "sending_method": {
            "description": "Identify the sending method. \n\n**IMPORTANT**: in case of L2H shipment, the parameter should be `parcel_locker`\n\n**IMPORTANT**: this parameter is mandatory [`any_point`] in case of `label-less` shipments\n",
            "type": "string",
            "enum": [
              "parcel_locker",
              "any_point"
            ],
            "example": "parcel_locker"
          }
        }
      },
      "custom_attributes_L2H-LL": {
        "type": "object",
        "description": "Additional shipment attributes.\n",
        "properties": {
          "sending_method": {
            "description": "Identify the sending method. \n\n**IMPORTANT**: this parameter is mandatory [`any_point`] in case of `label-less` shipments\n",
            "type": "string",
            "enum": [
              "parcel_locker",
              "any_point"
            ],
            "example": "any_point"
          }
        }
      },
      "shipment_id": {
        "type": "number",
        "description": "Shipment ID provided after a [Shipment POST action](/#operation/createShipment).",
        "example": 23
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}