{
  "openapi": "3.1.0",
  "info": {
    "title": "Zapier API",
    "description": "The Zapier API enables automation with Zapier by generating tree links based on user requests. These links can then be used in workflows to automatically send trees or include them in emails, gifts, or other actions.",
    "contact": {
      "email": "jovian@ecomatcher.com"
    },
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/JOVIAN_1/zapier-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.ecomatcher.com"
    }
  ],
  "paths": {
    "/normal/authentication": {
      "post": {
        "summary": "Authorize and validate credentials",
        "description": "Ensuring that only approved users and systems can access and use the Zapier integration.",
        "operationId": "updatePet",
        "requestBody": {
          "description": "Validate credentials",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Authentication"
              }
            },
            "application/xml": {
              "schema": {
                "$ref": "#/components/schemas/Authentication"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/Authentication"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful authentication"
          },
          "400": {
            "description": "Invalid ID supplied"
          },
          "404": {
            "description": "Pet not found"
          },
          "422": {
            "description": "Validation exception"
          },
          "default": {
            "description": "Unexpected error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Authentication": {
        "type": "object",
        "properties": {
          "company_id": {
            "type": "integer",
            "format": "int64",
            "examples": [
              10
            ]
          }
        },
        "xml": {
          "name": "authentication"
        }
      }
    },
    "securitySchemes": {
      "api_key": {
        "type": "apiKey",
        "name": "api_key",
        "in": "header"
      }
    }
  },
  "security": [
    {
      "api_key": []
    }
  ]
}
