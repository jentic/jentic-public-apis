"security":[{"ApiKeyAuth":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/StudyTemplateUseInput"}}}}}},"/api/v1/study-templates":{"get":{"responses":{"200":{"description":"Success.","content":{"application/json":{"schema":{"type":"object","required":["data","pagination"],"properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/StudyTemplate"}},"pagination":{"type":"object","required":["total","limit","offset"],"properties":{"total":{"type":"integer","description":"Templates matching the search."},"limit":{"type":["integer","null"],"description":"Page size requested; null when every match is returned."},"offset":{"type":"integer","description":"Number of matching templates skipped."}}}}}}}},"400":{"description":"Invalid template configuration or request."},"401":{"description":"Unauthorized."},"404":{"description":"Template not found or not owned by the caller."},"409":{"description":"Revision changed or a saved Audience/file is unavailable."},"500":{"description":"Internal server error. Responses are private and non-cacheable."}},"operationId":"listStudyTemplates","summary":"List your personal Study templates","description":"Templates are private by default. Owners may enable team sharing; current teammates can read and use shared templates. Only owners may update, delete or change sharing. The questionnaire is copied into an independent draft on use; using a template never starts research. Predefined templates are adapted in the app to the Study's goal, context and selected Audiences: contextual questions name the product, task, price or compared options the context states, in the language of the brief; standardized instrument items (SUS, SEQ) keep their wording, in a published validated translation where one exists and otherwise in their original language; and when adaptation fails or would change the template structure, the saved questions are used as written. Custom templates retain their saved wording unless adaptation is requested. Uploaded assets are copied on save and use. A template also carries the research method it was built with: a calculator-backed method that designs its own tasks at execution (Van Westendorp, Gabor-Granger, MaxDiff, conjoint, Kano, NPS, top-box, key drivers, TURF) writes those questions when the Study runs, and the saved questions are asked alongside them.","tags":["Study Templates"],"security":[{"ApiKeyAuth":[]}],"parameters":[{"in":"query","name":"search","required":false,"description":"Case-insensitive substring of the template name (at most 200 characters).","schema":{"type":"string","maxLength":200}},{"in":"query","name":"limit","required":false,"description":"Templates per page. Omit to list every visible template.","schema":{"type":"integer","minimum":1,"maximum":100}},{"in":"query","name":"offset","required":false,"description":"Number of matching templates to skip.","schema":{"type":"integer","minimum":0,"default":0}}]},"post":{"responses":{"201":{"description":"Created.","content":{"application/json":{"schema":{"type":"object","required":["data"],"properties":{"data":{"$ref":"#/components/schemas/StudyTemplate"}}}}}},"400":{"description":"Malformed JSON or invalid template configuration or request."},"401":{"description":"Unauthorized."},"404":{"description":"Template not found or not owned by the caller."},"409":{"description":"Revision changed or a saved file is unavailable."},"413":{"description":"Request exceeds 1 MiB."},"500":{"description":"Internal server error. Responses are private and non-cacheable."}},"operationId":"saveStudyTemplate","summary":"Save a personal Custom Study template","description":"Templates are private by default. Owners may enable team sharing; current teammates can read and use shared templates. Only owners may update, delete or change sharing. The questionnaire is copied into an independent draft on use; using a template never starts research. Predefined templates are adapted in the app to the Study's goal, context and selected Audiences: contextual questions name the product, task, price or compared options the context states, in the language of the brief; standardized instrument items (SUS, SEQ) keep their wording, in a published validated translation where one exists and otherwise in their original language; and when adaptation fails or would change the template structure, the saved questions are used as written. Custom templates retain their saved wording unless adaptation is requested. Uploaded assets are copied on save and use. A template also carries the research method it was built with: a calculator-backed method that designs its own tasks at execution (Van Westendorp, Gabor-Granger, MaxDiff, conjoint, Kano, NPS, top-box, key drivers, TURF) writes those questions when the Study runs, and the saved questions are asked alongside them.","tags":["Study Templates"],"security":[{"ApiKeyAuth":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/StudyTemplateCreateInput"}}}},"parameters":[]}},"/api/v1/uploads/import":{"post":{"responses":{"200":{"description":"Every file imported.","content":{"application/json":{"schema":{"type":"object","required":["data"],"properties":{"data":{"type":"object","required":["files"],"properties":{"files":{"type":"array","items":{"type":"object","required":["name","path","url","mimeType"],"properties":{"id":{"type":"string"},"name":{"type":"string"},"mimeType":{"type":"string"},"path":{"type":"string","description":"Storage path, chat/{userId}/..."},"url":{"type":"string","description":"Durable /api/uploads/chat/... URL."}}}}}}}}}}},"400":{"description":"Invalid request, or a file could not be downloaded, returned a non-200 status, or is empty."},"401":{"description":"Authentication required."},"403":{"description":"A referenced Minds upload does not belong to the caller."},"413":{"description":"A file exceeds the 100 MB limit."}},"operationId":"importUploads","summary":"Import files by URL into durable account storage","description":"Copies up to 20 files from public HTTP(S) URLs (for example the short-lived download link of a chat host) into the upload storage of the caller and returns durable Minds upload URLs to pass wherever a file URL is accepted (Audience briefs, Study drafts, validations, Mind knowledge, source imports). Downloads are SSRF-protected and limited to 100 MB per file; private-network URLs are refused. A file already in that storage is confirmed rather than copied. Imports are content-addressed, so retrying the same file returns the same path. All files are imported or none is reported: the first failing file is named by its one-based position (\"Study asset N ...\").","tags":["Uploads"],"security":[{"ApiKeyAuth":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["files"],"additionalProperties":false,"properties":{"files":{"type":"array","minItems":1,"maxItems":20,"items":{"type":"object","required":["url"],"additionalProperties":false,"properties":{"url":{"type":"string","description":"Public HTTP(S) URL, or a Minds upload URL/path the caller owns."},"name":{"type":"string","description":"File name to store; derived from the URL when omitted."},"type":{"type":"string","description":"MIME type when known; otherwise taken from the download."},"id":{"type":"string","description":"Caller identifier echoed back on the imported file."}}}}}}}}},"parameters":[]}},"/api/v1/user/shareable-sparks":{"get":{"responses":{"200":{"description":"Owned Minds in data, plus pagination."},"400":{"description":"Invalid pagination or filter."},"401":{"description":"Unauthorized."}},"operationId":"listShareableMinds","summary":"List owned Minds available for embedding","tags":["Minds"],"security":[{"ApiKeyAuth":[]}],"parameters":[{"in":"query","name":"limit","schema":{"type":"integer","minimum":1,"maximum":100,"default":100}},{"in":"query","name":"offset","schema":{"type":"integer","minimum":0,"default":0}},{"in":"query","name":"includePrivate","schema":{"type":"string","enum":["true","false","1","0"]}}]}}},"components":{"schemas":{"ApiKeySummary":{"type":"object","required":["id","name","createdAt","lastUsedAt"],"properties":{"id":{"type":"string","description":"API key ID (cuid: `c` followed by 24 lowercase alphanumerics). Use it with `DELETE /v1/api-keys/{keyId}`."},"name":{"type":["string","null"],"description":"Human-readable label, or null for an unnamed key."},"createdAt":{"type":"string","format":"date-time"},"lastUsedAt":{"type":["string","null"],"format":"date-time","description":"Last time the key authenticated a request; null if never used."}}},"ApiKeyCreated":{"type":"object","required":["id","name","createdAt","key"],"properties":{"id":{"type":"string","description":"API key ID (cuid). Use it with `DELETE /v1/api-keys/{keyId}`."},"name":{"type":["string","null"],"description":"Label as stored (trimmed), or null."},"createdAt":{"type":"string","format":"date-time"},"key":{"type":"string","pattern":"^minds_[0-9a-f]{48}$","description":"Raw secret, `minds_` followed by 48 hex characters. Send it as `Authorization: Bearer <key>`. Shown only once."}}},"AudienceDetail":{"type":"object","required":["id","name","mindCount","minds","createdAt","updatedAt","isPublic","currentMemberRole","sources","calibration"],"properties":{"id":{"type":"string","format":"uuid"},"name":{"type":"string"},"marketplaceSubtitle":{"type":["string","null"],"description":"Short subtitle shown in the public marketplace listing."},"marketplaceDescription":{"type":["string","null"],"description":"Longer description shown in the public marketplace listing."},"mindCount":{"type":"integer","minimum":0},"membersLoaded":{"type":"boolean","description":"Present in preview mode. False means the member array is incomplete; mindCount remains authoritative."},"minds":{"type":"array","description":"Member Minds ordered by name.","items":{"$ref":"#/components/schemas/AudienceDetailMember"}},"createdAt":{"type":"string","format":"date-time"},"updatedAt":{"type":"string","format":"date-time"},"isPublic":{"type":"boolean","description":"Anyone signed in can open the Audience and its Minds (marketplace listing)."},"currentMemberRole":{"type":"string","enum":["owner","admin","member","team_member","public_viewer"],"description":"The caller's relationship to this Audience. `public_viewer` also covers read-only access inherited from a containing Study."},"isSharedWithTeam":{"type":"boolean","description":"Collaborators only. Every member of the owner's team can open the Audience and read and chat with every Mind in it; no edit rights on the Minds."},"isLinkSharingEnabled":{"type":"boolean","description":"Collaborators only. Anyone with the public link can open the Audience."},"publicShareId":{"type":["string","null"],"description":"Collaborators only. Token of the public share link, when link sharing has been enabled."},"grounding":{"allOf":[{"$ref":"#/components/schemas/AudienceDetailGrounding"}],"description":"Stored research grounding. Absent when the Audience was never grounded."},"sources":{"type":"array","description":"The Audience's source bundle in creation order: the original brief, later recalibration adjustments, keywords, links and uploaded files. Uploaded-file URLs are signed and are redacted for public and Study-cascade viewers.","items":{"$ref":"#/components/schemas/AudienceSourceRecord"}},"derivedDistributions":{"type":"array","description":"Baseline demographics derived from what the members actually are, for dimensions the research did not cover. Present only when the member count is within the derivation cap and at least one dimension could be derived. A `grounding` chart that holds one value every member shares (an age range, \"Region: United States and Europe\", \"1-20 staff\") is a membership constraint, marked `kind: 'eligibility'` and shown as \"All members: …\", never as a 100% chart; where the Minds carry finer values for that dimension and no quota chart already shows them, an entry here gives the members' own breakdown (ages in standard bands), with the constraint in its `interpretation`. Not research evidence and never used for cohort allocation.","items":{"$ref":"#/components/schemas/GroundingDistribution"}},"calibration":{"$ref":"#/components/schemas/AudienceCalibrationState"},"research":{"type":"object","description":"Where the Audience's research stands (same shape as `research` on `GET /audiences/{audienceId}/progress`). `researching`: the Audience is usable and its background web research is running; `researched`: done; `usable`: it failed and the Audience stays on what was already known.","properties":{"phase":{"type":"string","enum":["usable","researching","researched"]},"status":{"type":["string","null"],"enum":["queued","running","completed","failed",null]},"stage":{"type":["string","null"],"enum":["researching","waiting_for_runs","recalibrating","done",null]},"progress":{"type":"integer","minimum":0,"maximum":100},"startedAt":{"type":["string","null"],"format":"date-time"},"operation":{"type":["object","null"],"description":"Owner-only latest durable recalibration: receipt, status, result.grounding and member counts, or safe terminal error."},"completedAt":{"type":["string","null"],"format":"date-time"},"outcome":{"type":["object","null"],"additionalProperties":true}}}}},"AudienceDetailMember":{"type":"object","required":["id","name","discipline","profileImageUrl","createdAt","cohortProfile"],"properties":{"id":{"type":"string","format":"uuid"},"name":{"type":"string"},"discipline":{"type":["string","null"]},"profileImageUrl":{"type":["string","null"],"format":"uri","description":"Absolute avatar URL, or null while the portrait is still being generated."},"createdAt":{"type":"string","format":"date-time"},"cohortProfile":{"oneOf":[{"$ref":"#/components/schemas/CohortMemberProfile"},{"type":"null"}],"description":"The segment of every grounded distribution this member represents. Null for Minds that were never allocated."}}},"CohortMemberProfile":{"type":"object","required":["memberIndex","assignments"],"properties":{"memberIndex":{"type":"integer","minimum":0},"assignments":{"type":"array","items":{"type":"object","required":["distribution","segment","sourceIdx"],"properties":{"distribution":{"type":"string","description":"Name of the grounded distribution."},"segment":{"type":"string","description":"Label of the assigned segment."},"sourceIdx":{"type":"integer","description":"Index into the grounding sources; -1 for assumed or derived segments."},"dimension":{"type":"string","enum":["age","gender","income","life_stage","representation","education","employment_status","marital_status","household_size","household_income","geography","occupation","industry","gender_identity","source_sex","nationality","visual_presentation","duration_years","none"],"description":"Shared attribute dimension (GROUNDING_DIMENSIONS). gender_identity and source_sex are one gender attribute; gender is appearance."},"canonical":{"type":"string","description":"Language-independent segment concept, e.g. `feminine` or an age band such as `65+`."}}}}}},"AudienceDetailGrounding":{"type":"object","required":["snapshotId","distributions","reviewDistributions","sources","summary","confidence","appliedToPersonas","createdAt"],"properties":{"snapshotId":{"type":["string","null"],"description":"Identifier of the grounding snapshot currently applied."},"distributions":{"type":"array","description":"Active distributions that drive cohort allocation, bounded to the Audience definition.","items":{"$ref":"#/components/schemas/GroundingDistribution"}},"reviewDistributions":{"type":"array","description":"Complete source-identified distribution universe, including options that are not allocated.","items":{"$ref":"#/components/schemas/GroundingDistribution"}},"studyUse":{"type":"object","description":"Collaborators only. Disclosed new-research or reconstruction mode, matching the reviewed preview."},"sourceFindings":{"type":"array","items":{"type":"object"},"description":"Collaborators only. Original observed and historical findings retained separately from the active composition."},"researchStudyAnalysis":{"type":["object","null"],"description":"Classification of uploaded research files and their audience, quota, routing and evidence contracts."},"screeningAdvisories":{"type":"array","items":{"type":"object"},"description":"Collaborators only. Screening rules that read answers the Study collects: advisory, not applied to the members, kept with the Audience for the Study (same entries as the from-brief grounding)."},"sources":{"type":"array","items":{"$ref":"#/components/schemas/GroundingSource"}},"summary":{"type":["string","null"]},"confidence":{"type":"number","minimum":0,"maximum":1},"appliedToPersonas":{"type":"boolean","description":"True when deterministic cohort allocation assigned the members to the distributions."},"allocationConfig":{"type":["object","null"],"description":"Deterministic cohort allocation controls used for the current member profiles."},"hardConstraints":{"oneOf":[{"$ref":"#/components/schemas/GroundingHardConstraints"},{"type":"null"}]},"allocationAudit":{"type":["object","null"],"description":"Per-distribution audit of target versus achieved segment counts."},"coverage":{"type":["object","null"],"description":"How each relevant standard dimension is covered: `sourced` (evidence for these people), `proxy` (a wider or related population), `assumed` (the model's stated assumption, replaced when research finds evidence) or `missing`.","properties":{"dimensions":{"type":"array","items":{"type":"object","properties":{"dimension":{"type":"string"},"status":{"type":"string","enum":["sourced","proxy","assumed","missing"]},"distribution":{"type":"string"}}}},"counts":{"type":"object","properties":{"sourced":{"type":"integer"},"proxy":{"type":"integer"},"assumed":{"type":"integer"},"missing":{"type":"integer"}}}}},"createdAt":{"type":"string","format":"date-time"}}},"GroundingHardConstraints":{"type":"object","description":"Inclusion rules resolved from the Audience specification. Values outside these bounds are excluded from allocation.","required":["gender","age","country","categoricalMemberships"],"properties":{"gender":{"type":["string","null"],"enum":["feminine","masculine","androgynous",null]},"age":{"oneOf":[{"type":"object","required":["min","max"],"properties":{"min":{"type":"integer"},"max":{"type":"integer"}}},{"type":"null"}]},"country":{"type":["string","null"]},"categoricalMemberships":{"type":"array","items":{"type":"object","required":["axisTerms","allowedValueTerms"],"properties":{"axisTerms":{"type":"array","items":{"type":"string"}},"allowedValueTerms":{"type":"array","items":{"type":"string"}}}}}}},"AudienceSourceRecord":{"type":"object","required":["id","kind","text","url","filename","createdAt"],"properties":{"id":{"type":"string","format":"uuid"},"kind":{"type":"string","enum":["brief","adjustment","keyword","link","file"]},"text":{"type":["string","null"],"description":"Brief, adjustment or keyword text. Null for link and file rows."},"url":{"type":["string","null"],"description":"Link URL or uploaded-file URL. Null for text rows; redacted for viewers without collaborator access."},"filename":{"type":["string","null"],"description":"Original file name for file rows."},"createdAt":{"type":"string","format":"date-time"}}},"AudienceCalibrationState":{"type":"object","required":["active","startedAt"],"properties":{"active":{"type":"boolean","description":"True while a recalibration run is in flight for this Audience."},"startedAt":{"type":["string","null"],"format":"date-time"},"operation":{"type":["object","null"],"description":"Owner-only latest durable recalibration: receipt, status, result.grounding and member counts, or safe terminal error."}}},"Formation":{"type":"object","description":"A persisted segmentation of one Audience into subgroups.","required":["id","name","status","source","visibility","canMutate","createdAt","updatedAt","createdByUserId","subgroups","hypothesis","progress"],"properties":{"id":{"type":"string","format":"uuid"},"name":{"type":"string"},"status":{"type":"string","enum":["building","ready","failed"]},"source":{"type":"string","enum":["auto","manual"]},"visibility":{"type":"string","enum":["shared","viewer_private"]},"canMutate":{"type":"boolean","description":"Whether the caller may recompute or delete this Formation."},"createdAt":{"type":"string","format":"date-time"},"updatedAt":{"type":"string","format":"date-time"},"createdByUserId":{"type":"string","format":"uuid"},"subgroups":{"type":"array","description":"Materialised subgroups in display order. A first build may have none; recompute retains the previous completed buckets until replacement succeeds.","items":{"$ref":"#/components/schemas/FormationSubgroup"}},"hypothesis":{"oneOf":[{"$ref":"#/components/schemas/StoredFormationHypothesis"},{"type":"object","maxProperties":0}],"description":"Only proposal fields are returned; legacy empty or invalid proposals become an empty object."},"progress":{"oneOf":[{"$ref":"#/components/schemas/FormationBuildProgress"},{"type":"null"}],"description":"Live build progress while `building`, the failure reason when `failed`, null once `ready`."}}},"FormationSubgroup":{"type":"object","required":["id","label","definition","isAuxiliary","position","memberships"],"properties":{"id":{"type":"string","format":"uuid"},"label":{"type":"string"},"definition":{"type":["string","null"],"description":"Natural-language membership rule."},"isAuxiliary":{"type":"boolean","description":"True for the catch-all bucket (e.g. Other or Unanswered)."},"position":{"type":"integer","minimum":0},"memberships":{"type":"array","description":"Minds assigned to this subgroup. A Mind may appear in several subgroups when overlap is allowed.","items":{"type":"object","required":["mindId","confidence"],"properties":{"mindId":{"type":"string","format":"uuid"},"confidence":{"type":["number","null"],"minimum":0,"maximum":1}}}}}},"StoredFormationHypothesis":{"type":"object","required":["intent","subgroups"],"properties":{"intent":{"type":"string","minLength":1},"subgroups":{"type":"array","minItems":1,"maxItems":15,"items":{"type":"object","required":["id","label","definition"],"properties":{"id":{"type":"string","minLength":1},"label":{"type":"string","minLength":1},"definition":{"type":"string","minLength":1}}}}}},"FormationBuildProgress":{"type":"object","required":["phase","done","total"],"properties":{"phase":{"type":"string","enum":["classify","reconcile","ask"]},"done":{"type":"integer","minimum":0},"total":{"type":"integer","minimum":0},"failureReason":{"type":"string","description":"Safe public explanation when failed; raw diagnostics are never returned."}}},"FormationSummary":{"type":"object","required":["id","name","status","source","dimensionKey","visibility","createdAt","updatedAt","createdByUserId","subgroups","canMutate"],"properties":{"id":{"type":"string","format":"uuid"},"name":{"type":"string"},"status":{"type":"string","enum":["building","ready","failed"],"description":"Build state. Subgroup memberships are only populated once `ready`."},"source":{"type":"string","enum":["auto","manual"]},"dimensionKey":{"type":["string","null"],"description":"Set on auto-seeded Formations (e.g. `age`, `gender`, or `grounding:<axis>` for grounding-derived splits); null for user-created ones."},"visibility":{"type":"string","enum":["shared","viewer_private"],"description":"`shared` Formations are visible to every Audience viewer; `viewer_private` ones only to their creator."},"createdAt":{"type":"string","format":"date-time"},"updatedAt":{"type":"string","format":"date-time"},"createdByUserId":{"type":"string","format":"uuid"},"canMutate":{"type":"boolean","description":"Whether the caller may recompute or delete this Formation."},"subgroups":{"type":"array","items":{"type":"object","required":["id","label","isAuxiliary","position","_count"],"properties":{"id":{"type":"string","format":"uuid"},"label":{"type":"string"},"isAuxiliary":{"type":"boolean","description":"True for the catch-all bucket (e.g. Other or Unanswered)."},"position":{"type":"integer","minimum":0},"_count":{"type":"object","required":["memberships"],"properties":{"memberships":{"type":"integer","minimum":0,"description":"Number of Minds in this subgroup."}}}}}}}},"FormationHypothesis":{"type":"object","description":"A proposed split of the Audience into 2 to 15 subgroups.","required":["intent","subgroups"],"properties":{"intent":{"type":"string","minLength":1,"description":"One line restating the split, e.g. \"Audience by gender\"."},"subgroups":{"type":"array","minItems":2,"maxItems":15,"items":{"type":"object","required":["id","label","definition"],"properties":{"id":{"type":"string","minLength":1,"description":"Stable lowercase slug, e.g. `woman` or `25-34`."},"label":{"type":"string","minLength":1,"description":"Short human-facing name."},"definition":{"type":"string","minLength":1,"description":"One-sentence decision rule for membership in this subgroup."}}}}}},"PlanLimitError":{"type":"object","description":"Error body of a plan-limit refusal (HTTP 403).","properties":{"statusCode":{"type":"integer","enum":[403]},"statusMessage":{"type":"string","description":"Human-readable message naming the plan and the limit."},"data":{"$ref":"#/components/schemas/PlanLimitEnvelope"}}},"PlanLimitEnvelope":{"type":"object","required":["code","limitType","currentPlan","limit"],"properties":{"code":{"type":"string","enum":["PLAN_LIMIT"]},"limitType":{"type":"string","description":"Which cap was hit, e.g. `audienceMembers` or `minds` (legacy responses may say `audienceMembers`)."},"currentPlan":{"type":"string"},"limit":{"type":"integer"},"current":{"type":"integer","description":"Consumption against the cap."},"requested":{"type":"integer","description":"How many units this request asked for."},"itemsToCreate":{"type":"integer","description":"Bulk-create size that pushed the request over the cap."},"periodEnd":{"type":"string","format":"date-time","description":"End of the metering window when the cap is periodic."},"context":{"type":"string"},"reason":{"type":"string"},"audienceId":{"type":"string","format":"uuid"},"isTrialing":{"type":"boolean"}}},"AudienceFromBriefResult":{"type":"object","required":["id","name","mindCount","minds","createdAt","updatedAt","isPublic","isSharedWithTeam","isLinkSharingEnabled","currentMemberRole","grounding","audienceCreationMode"],"properties":{"id":{"type":"string","format":"uuid"},"name":{"type":"string"},"mindCount":{"type":"integer"},"minds":{"type":"array","items":{"$ref":"#/components/schemas/AudienceMindSummary"}},"createdAt":{"type":"string","format":"date-time"},"updatedAt":{"type":"string","format":"date-time"},"isPublic":{"type":"boolean"},"isSharedWithTeam":{"type":"boolean"},"isLinkSharingEnabled":{"type":"boolean"},"publicShareId":{"type":["string","null"]},"currentMemberRole":{"type":"string","enum":["owner"]},"research":{"type":"object","description":"Where the Audience's research stands. `researching`: it is usable now and its web research continues in the background (follow `research` on `GET /audiences/{audienceId}/progress`); `researched`: research finished with the creation.","properties":{"phase":{"type":"string","enum":["usable","researching","researched"]},"status":{"type":["string","null"],"enum":["queued","running","completed","failed",null]},"stage":{"type":["string","null"],"enum":["researching","waiting_for_runs","recalibrating","done",null]},"progress":{"type":"integer","minimum":0,"maximum":100}}},"grounding":{"oneOf":[{"$ref":"#/components/schemas/AudienceGrounding"},{"type":"null"}]},"audienceCreationMode":{"type":"string","enum":["balanced","segment_coverage","benchmark_depth"],"description":"The EFFECTIVE creation mode applied by the server (after the plan gate — may differ from the requested mode on plans below Pro)."},"replayed":{"type":"boolean","description":"Present and true only on an idempotent replay (200): the audience was created by an earlier request with the same idempotency key."},"datasetSegmentation":{"oneOf":[{"type":"object","properties":{"selectedVariableCount":{"type":"integer"},"observedProfileCount":{"type":"integer"},"recommendedMindCount":{"type":"integer"},"createdMindCount":{"type":"integer"}}},{"type":"null"}]},"withheldFromMemberKnowledge":{"type":["array","null"],"description":"Supplied sources that shaped grounding and study design but were deliberately kept out of the member Minds' knowledge, so they cannot leak the study's own outcomes or raw respondent rows into the predictions. Empty when everything supplied reached member knowledge; null on an idempotent replay, which means unknown rather than nothing. A non-empty list with `includeWebSearch: true` is normal; with `includeWebSearch: false` the request is refused outright when nothing survives.","items":{"type":"object","required":["title","reason"],"properties":{"title":{"type":"string","description":"File name, link title or keyword as supplied."},"reason":{"type":"string","enum":["respondent_dataset","study_report","questionnaire","screener","distribution_source","tabular","unclassified"],"description":"`unclassified` means the research-study analysis never classified it as supporting material; a file reaches member knowledge only on a positive classification, never by default."}}}},"memberTraining":{"oneOf":[{"type":"object","required":["enqueued","queuedMemberCount","pollUrlTemplate"],"description":"Per-Mind background training enqueued for this creation. Every creation path trains every member: training is committed with the Audience and resumes on its own if the build is interrupted, so `queuedMemberCount` equals `mindCount`. Null on idempotent replays (training bookkeeping is not persisted).","properties":{"enqueued":{"type":"boolean"},"queuedMemberCount":{"type":"integer"},"pollUrlTemplate":{"type":["string","null"],"description":"Substitute each member id to poll its training progress, e.g. /api/v1/minds/{mindId}/training."}}},{"type":"null"}]},"cohortAllocation":{"oneOf":[{"type":"object","required":["config","audit"],"properties":{"config":{"type":"object"},"audit":{"type":"object"},"profiles":{"type":"array","items":{"type":"object"}}}},{"type":"null"}]},"cohortAllocationCoverage":{"type":"object","description":"Which members the deterministic cohort allocation actually covered. Members flagged as real people are excluded individually (they cannot be given an invented demographic profile); `skipReason` explains a null `cohortAllocation`.","required":["memberCount","allocatedMemberCount","excludedRealPersonCount","skipReason"],"properties":{"memberCount":{"type":"integer"},"allocatedMemberCount":{"type":"integer"},"excludedRealPersonCount":{"type":"integer"},"excludedRealPersonNames":{"type":"array","items":{"type":"string"}},"skipReason":{"type":["string","null"],"enum":["no_grounded_distributions","all_members_flagged_real_person",null]}}}}},"AudienceMindSummary":{"type":"object","required":["id","name"],"properties":{"id":{"type":"string","format":"uuid"},"name":{"type":"string"},"discipline":{"type":["string","null"]},"profileImageUrl":{"type":["string","null"]}}},"AudienceGrounding":{"type":"object","required":["distributions","sources","summary","confidence"],"properties":{"distributions":{"type":"array","items":{"$ref":"#/components/schemas/GroundingDistribution"}},"reviewDistributions":{"type":"array","description":"Complete source-identified distribution universe, including screener-excluded, conditional, and unweighted options that were not allocated.","items":{"$ref":"#/components/schemas/GroundingDistribution"}},"researchStudyAnalysis":{"type":["object","null"],"description":"Canonical content-based classification of uploaded research files and their audience, quota, routing, and evidence contracts."},"research":{"type":["object","null"],"description":"Research coverage and axisReconciliation audit. An unavailable or budget_exceeded axis review is not a successful semantic validation; failureReason explains unusable model output or infrastructure failure. `dimensionCoverage.dimensions` lists the standard dimensions covered for this population — the fixed core pool every audience of people carries (age, gender identity, representation, geography, education, employment status, income, household size) plus any the planner judged relevant — each with a reason and a status: `sourced`, `proxy` (wider area or population), `assumed` (model-proposed shares, never used for sizing) or `missing`."},"sources":{"type":"array","items":{"$ref":"#/components/schemas/GroundingSource"}},"summary":{"type":"string"},"confidence":{"type":"number","minimum":0,"maximum":1},"suggestedMinAudienceSize":{"type":"integer","minimum":3,"maximum":50},"screeningAdvisories":{"type":"array","description":"Screening rules that read answers the Study collects (for example a screen-out on willingness to pay combined with income). Minds do not carry Study answers as profile attributes, so these rules are advisory: the Audience is created, the rule is not applied to its members, and it stays in `researchStudyAnalysis.allocationRules` (disposition `advisory`, `studyAnswers`) for the Study. Rules on profile attributes are enforced and never listed here.","items":{"type":"object","required":["ruleId","disposition","appliesTo","studyQuestions","reason","notice"],"properties":{"ruleId":{"type":"string"},"disposition":{"type":"string","enum":["advisory"]},"appliesTo":{"type":"string","enum":["study_answers"]},"studyQuestions":{"type":"array","items":{"type":"string"}},"reason":{"type":"string"},"notice":{"type":"string"}}}},"flaggedDistributions":{"type":"array","description":"Axes demoted to supplementary context because they measure the Study outcome itself (`audienceContext.reason = study_outcome`). Never used for cohort allocation.","items":{"type":"object","required":["name","reason"],"properties":{"name":{"type":"string"},"reason":{"type":"string","enum":["study_outcome"]},"category":{"type":"string","enum":["demographic","geographic","psychographic","behavioral","firmographic"]},"tier":{"type":"string","enum":["target","broader","general","global"]}}}}}},"GroundingDistribution":{"type":"object","required":["name","distribution"],"properties":{"name":{"type":"string"},"translations":{"type":"object","description":"Read-only presentation, attached on read for the caller's locale (`x-locale` header or `aox-locale` cookie; default `en`): `{ [locale]: { name?, displayHeading?, segments?: { [originalLabel]: string } } }` with the friendly label a profile shows (a survey question as the attribute it measures, e.g. \"Openness to new cuisines\"; an awkward answer as a profile value). Only wording that differs from the original is present. `name` and each segment `label` stay the identity; never send this back.","additionalProperties":{"type":"object"}},"dimension":{"type":"string","enum":["age","gender","income","life_stage","representation","education","employment_status","marital_status","household_size","household_income","geography","occupation","industry","gender_identity","source_sex","nationality","visual_presentation","duration_years","none"],"description":"Language-independent personal dimension the distribution measures. Allocation reads it, with each segment's canonical, to keep every member's combination plausible."},"userEdit":{"type":"object","description":"Read-only record of what the Audience's owner changed on this chart, layered on its evidence (which stays as research found it): `kind` is `shares` (target shares set via `cohortAllocation.targetOverrides` or a rework instruction), `excluded_segment` (values removed; they stay in `reviewDistributions` with their evidence), `excluded_chart` (the chart was removed) or `user_defined` (the owner made the chart). `userShares` are the shares the owner set, `evidenceShares` the chart's evidence shares, `excludedSegments` the removed values; `instruction`, `revision` and `editedAt` say where and when. Members whose value an edit decided carry profile basis `user_target`, with the evidence share in the reason.","required":["kind","evidenceShares"],"properties":{"kind":{"type":"string","enum":["shares","excluded_segment","excluded_chart","user_defined"]},"userShares":{"type":"array","items":{"type":"object","properties":{"label":{"type":"string"},"pct":{"type":"number"}}}},"evidenceShares":{"type":"array","items":{"type":"object","properties":{"label":{"type":"string"},"pct":{"type":"number"}}}},"excludedSegments":{"type":"array","items":{"type":"string"}},"instruction":{"type":"string"},"revision":{"type":"integer"},"editedAt":{"type":"string","format":"date-time"}}},"durationStart":{"type":"object","nullable":true,"description":"duration_years only: the earliest age at which the counted time can begin for this audience, with its evidence. No member is given more years than its age minus this allows.","required":["minimumAge","evidence"],"properties":{"minimumAge":{"type":"integer","minimum":0,"maximum":80},"evidence":{"type":"object","required":["kind"],"properties":{"kind":{"type":"string","enum":["source","definitional"]},"sourceIdx":{"type":"integer","minimum":0},"quote":{"type":"string"},"justification":{"type":"string"}}}}},"segmentAgeBounds":{"type":"array","nullable":true,"description":"Ages outside which no member of this audience can be in a segment (e.g. the earliest age an occupation's training allows), with evidence. Allocation keeps every member inside its segments' ages without moving a share.","items":{"type":"object","required":["segment","evidence"],"properties":{"segment":{"type":"string"},"minAge":{"type":"integer","minimum":0,"maximum":110},"maxAge":{"type":"integer","minimum":0,"maximum":110},"evidence":{"type":"object","required":["kind"],"properties":{"kind":{"type":"string","enum":["source","definitional"]},"sourceIdx":{"type":"integer","minimum":0},"quote":{"type":"string"},"justification":{"type":"string"}}}}}},"distribution":{"type":"array","items":{"type":"object","required":["label","pct","sourceIdx"],"properties":{"label":{"type":"string"},"pct":{"type":"number","minimum":0,"maximum":100},"sourceIdx":{"type":"integer","minimum":0},"canonical":{"type":"string","description":"Language-independent value for the dimension, e.g. \"employment_full_time\", \"18-24\", or for duration_years a whole-year range like \"6-10\", \"<5\", \"30+\"."},"review":{"type":"object","properties":{"status":{"type":"string","enum":["included","excluded_by_source","conditional","unweighted"]},"evidence":{"type":"string","enum":["target","observed","candidate"]},"reason":{"type":"string"},"sourceFile":{"type":"string"}}}}}},"tier":{"type":"string","enum":["target","broader","general","global"]},"segmentRelations":{"type":"array","nullable":true,"description":"Evidence-backed relations from one of this distribution's segments to segments of another distribution of the same audience. subset: every member in segment is in one of targetSegments. excludes: no member in segment is in any of targetSegments. Enforced by cohort allocation and reported in allocationAudit.segmentRelations.","items":{"type":"object","required":["type","segment","targetDistribution","targetSegments","evidence"],"properties":{"type":{"type":"string","enum":["subset","excludes"]},"segment":{"type":"string"},"targetDistribution":{"type":"string"},"targetSegments":{"type":"array","items":{"type":"string"}},"evidence":{"type":"object","required":["kind"],"properties":{"kind":{"type":"string","enum":["source","definitional"]},"sourceIdx":{"type":"integer","minimum":0},"quote":{"type":"string"},"justification":{"type":"string"}}}}}}}},"GroundingSource":{"type":"object","required":["url","title","snippet","domain","confidence"],"properties":{"url":{"type":"string"},"title":{"type":"string"},"snippet":{"type":"string"},"domain":{"type":"string"},"publishedDate":{"type":"string"},"confidence":{"type":"number","minimum":0,"maximum":1},"tier":{"type":"string","enum":["target","broader","general","global"]},"isUserProvided":{"type":"boolean"}}},"SavedAudienceResponse":{"type":"object","required":["data"],"properties":{"data":{"type":"object","required":["id","name","mindCount","mindIds","minds","isLinkSharingEnabled","currentMemberRole"],"properties":{"id":{"type":"string"},"name":{"type":"string"},"mindCount":{"type":"integer","minimum":0},"mindIds":{"type":"array","items":{"type":"string"}},"minds":{"type":"array","items":{"type":"object"}},"createdAt":{"type":"string","format":"date-time"},"updatedAt":{"type":"string","format":"date-time"},"isPublic":{"type":"boolean"},"isSharedWithTeam":{"type":"boolean"},"isLinkSharingEnabled":{"type":"boolean"},"publicShareId":{"type":["string","null"]},"currentMemberRole":{"type":"string","enum":["owner"]}}}}},"ChatMessageRequest":{"type":"object","description":"Send `content` (or its alias `message`). Everything else is optional; `model`/`provider`, `response_format`, `tools` and `tool_choice` are validated for every chat shape but only applied on single-Mind chats.","properties":{"content":{"type":"string","minLength":1,"description":"Message text. Required unless `message` is given."},"message":{"type":"string","description":"Alias for `content`. `message` wins when both are present."},"role":{"type":"string","enum":["user","system"],"default":"user","description":"`user` triggers a reply. `system` stores the text in the transcript as context for later turns and returns immediately without calling the model or counting against message caps."},"model":{"type":"string","description":"Per-message model override for single-Mind chats. Must be one of the supported IDs for `provider` (e.g. `claude-sonnet-5`, `gpt-5.4`, `gemini-3.7-flash`); retired IDs are forwarded to their replacement. Must be sent together with `provider`."},"provider":{"type":"string","enum":["anthropic","openai","google"],"description":"Provider of `model`. Must be sent together with `model`. Precedence: request override, then your team's preferred provider, then the product default."},"endUserName":{"type":["string","null"],"maxLength":120,"description":"Display name of the human end user for this turn. Omitted/empty means the Mind addresses the user neutrally (never the API-key owner's name). Aliases: `userDisplayName`, `userName`."},"response_format":{"$ref":"#/components/schemas/ChatResponseFormat"},"tools":{"type":"array","maxItems":128,"items":{"$ref":"#/components/schemas/ChatToolDefinition"},"description":"User-defined tools (function calling). Calls are returned in `tool_calls` for you to execute; they are never run server-side. Single-Mind chats only."},"tool_choice":{"$ref":"#/components/schemas/ChatToolChoice"}}},"ChatResponseFormat":{"type":"object","description":"OpenAI-style structured output request. `json_schema` runs a second extraction pass over the Mind's answer; `json_object` parses the answer as JSON (code fences are stripped). The parsed value is returned in `parsed`; `content` carries the JSON string. Extraction failures are soft: `parsed` is omitted and `content` keeps the prose.","required":["type"],"properties":{"type":{"type":"string","enum":["text","json_object","json_schema"]},"json_schema":{"type":"object","description":"Required when `type` is `json_schema`.","required":["name","schema"],"properties":{"name":{"type":"string","minLength":1},"description":{"type":"string","description":"Guides the extraction model."},"schema":{"type":"object","description":"JSON Schema for the output object.","additionalProperties":true},"strict":{"type":"boolean","default":true}}}}},"ChatToolDefinition":{"type":"object","required":["name"],"properties":{"name":{"type":"string","minLength":1,"description":"Unique per request. Must not collide with the internal tool names `GET_SPARK_RAG`, `GENERATE_IMAGE`, `WEB_SEARCH`, `DISPLAY_IMAGE`, `GET_IMAGE_DETAILS`, `DOCUMENT_PROCESSING`, `ANALYZE_LINK`."},"description":{"type":"string","description":"When and how the Mind should call the tool. Drives tool selection."},"parameters":{"type":"object","description":"JSON Schema of the arguments. Omit for a no-argument tool.","additionalProperties":true},"strict":{"type":"boolean","description":"Enforce strict argument validation."}}},"ChatToolChoice":{"description":"`auto` lets the Mind decide, `required` forces at least one call, `none` disables user tools for this turn, `{ \"name\": \"…\" }` forces one specific tool. Ignored when `tools` is empty.","oneOf":[{"type":"string","enum":["auto","required","none"]},{"type":"object","required":["name"],"properties":{"name":{"type":"string","minLength":1}}}]},"ChatToolCall":{"type":"object","required":["id","name","arguments"],"properties":{"id":{"type":"string","description":"Echo this back as `tool_call_id` when you send the result."},"name":{"type":"string","description":"Name of one of your `tools`."},"arguments":{"type":"object","additionalProperties":true,"description":"Arguments generated by the Mind, matching the tool's `parameters` schema."}}},"ChatMessageResponse":{"oneOf":[{"$ref":"#/components/schemas/ChatMindMessageResponse"},{"$ref":"#/components/schemas/ChatMultiMindMessageResponse"},{"$ref":"#/components/schemas/ChatStudyMessageResponse"},{"$ref":"#/components/schemas/ChatSystemMessageResponse"}]},"ChatMindMessageResponse":{"type":"object","description":"Single-Mind chat reply.","required":["content","messageId"],"properties":{"content":{"type":"string","description":"The Mind's reply. A JSON string when `response_format` was `json_schema`/`json_object`; may be empty when the turn ended in `tool_calls`."},"messageId":{"type":"string","description":"ID of the persisted assistant message."},"metadata":{"$ref":"#/components/schemas/MindCompletionMetadata","description":"Source-policy and retrieval status for a knowledge-only reply."},"parsed":{"description":"Parsed structured output. Present only when `response_format` was given and extraction succeeded."},"tool_calls":{"type":"array","items":{"$ref":"#/components/schemas/ChatToolCall"},"description":"Present only when the Mind called one of your `tools`. Execute them and send the results in a follow-up message."}}},"ChatMultiMindMessageResponse":{"type":"object","description":"Multi-Mind chat reply: one entry per Mind that spoke this turn, in speaking order.","required":["messages"],"properties":{"messages":{"type":"array","minItems":1,"items":{"type":"object","required":["content","messageId","mind"],"properties":{"content":{"type":"string"},"messageId":{"type":"string"},"metadata":{"$ref":"#/components/schemas/MindCompletionMetadata","description":"Source-policy and retrieval status for this Mind."},"mind":{"type":"object","required":["id","name"],"properties":{"id":{"type":"string","format":"uuid"},"name":{"type":"string"}}}}}}}},"ChatStudyMessageResponse":{"type":"object","description":"Study chat reply: the question is classified, every ready Mind answers, and answers are aggregated per Audience.","required":["outputData"],"properties":{"outputData":{"$ref":"#/components/schemas/StudyOutputData"}}},"ChatSystemMessageResponse":{"type":"object","description":"Returned for `role: \"system\"`; nothing was generated.","required":["messageId","role"],"properties":{"messageId":{"type":"string"},"role":{"type":"string","enum":["system"]}}},"ChatStudyMindsNotReadyError":{"type":"object","required":["statusCode","statusMessage","data"],"properties":{"statusCode":{"type":"integer","enum":[409]},"statusMessage":{"type":"string"},"data":{"type":"object","required":["code","studyId","notReadyCount","failedCount","trainingCount","notReady"],"properties":{"code":{"type":"string","enum":["PANEL_MINDS_NOT_READY"]},"studyId":{"type":"string","format":"uuid","description":"The chat ID."},"notReadyCount":{"type":"integer"},"failedCount":{"type":"integer","description":"Minds whose training failed; retrain them with `POST /v1/minds/{mindId}/retrain`."},"trainingCount":{"type":"integer","description":"Minds still training; poll `GET /v1/minds/{mindId}/training`."},"notReady":{"type":"array","items":{"type":"object","required":["mindId","name","audienceId","trainingStatus"],"properties":{"mindId":{"type":"string","format":"uuid"},"name":{"type":"string"},"audienceId":{"type":"string","format":"uuid"},"trainingStatus":{"type":"string","enum":["queued","running","failed"]}}}}}}}},"ChatCreateRequest":{"type":"object","description":"Exactly one of `mindId`, `mindIds` or `audienceIds` selects the chat shape. `audienceIds` wins when present; otherwise `mindIds` wins over `mindId`.","properties":{"responseThread":{"type":"object","additionalProperties":false,"required":["studyId","messageId"],"description":"Continue this Mind’s exact Study response with its prior context and assets. Requires one Mind. Repeated creation resumes the existing thread (200).","properties":{"studyId":{"type":"string","format":"uuid"},"messageId":{"type":"string"}}},"name":{"type":"string","description":"Display name. Defaults to \"API Chat\" for Mind chats and \"API Study\" for Study chats."},"description":{"type":"string","description":"Optional free-text description."},"mindId":{"type":"string","format":"uuid","description":"Single Mind to chat with 1:1."},"mindIds":{"type":"array","items":{"type":"string","format":"uuid"},"description":"Two or more Minds for a moderated multi-Mind conversation (duplicates are ignored). A single-element array behaves like `mindId`."},"audienceIds":{"type":"array","items":{"type":"string","format":"uuid"},"description":"Audiences to attach to a Study chat. Every message fans out to all Minds in these Audiences."}}},"ChatCreated":{"type":"object","required":["id","name","createdAt","minds"],"properties":{"id":{"type":"string","format":"uuid","description":"Chat ID for `POST /v1/chats/{chatId}/messages` and `DELETE /v1/chats/{chatId}`."},"name":{"type":"string"},"description":{"type":["string","null"]},"createdAt":{"type":"string","format":"date-time"},"minds":{"type":"array","items":{"$ref":"#/components/schemas/StudyMind"},"description":"Minds assigned to the chat. One entry for a 1:1 chat, several for a multi-Mind chat."}}},"ChatStudyCreated":{"type":"object","required":["id","name","type","audiences","createdAt"],"properties":{"id":{"type":"string","format":"uuid"},"name":{"type":"string"},"type":{"type":"string","enum":["study"]},"audiences":{"type":"array","items":{"$ref":"#/components/schemas/ChatAudienceSummary"}},"createdAt":{"type":"string","format":"date-time"}}},"ChatAudienceSummary":{"type":"object","required":["id","name","mindCount"],"properties":{"id":{"type":"string","format":"uuid"},"name":{"type":"string"},"mindCount":{"type":"integer","minimum":0,"description":"Number of Minds in the Audience at creation time."}}},"ChatPlanLimitError":{"type":"object","description":"Shape of every 403 plan-limit refusal on the Chat endpoints. `data.code` is always `PLAN_LIMIT`; `limitType` says which cap was hit.","required":["statusCode","statusMessage","data"],"properties":{"statusCode":{"type":"integer","enum":[403]},"statusMessage":{"type":"string","description":"Human-readable wall copy, e.g. `Free plan limit reached` or `Free plan monthly synthetic-response limit reached. Upgrade your plan for more responses.`"},"data":{"type":"object","required":["code","limitType","currentPlan","limit"],"properties":{"code":{"type":"string","enum":["PLAN_LIMIT"]},"limitType":{"type":"string","enum":["flows","messages","responses","audienceMembers"],"description":"`flows`: started-Study cap. `messages`: per-chat user-message cap. `responses`: monthly synthetic-response allowance. `audienceMembers`: per-Audience member cap."},"currentPlan":{"type":"string","description":"Plan slug, e.g. `free`, `premium`, `team`."},"limit":{"type":"integer"},"current":{"type":"integer","description":"Usage against the cap, when known."},"requested":{"type":"integer","description":"Units this request needed (response metering only)."},"periodEnd":{"type":"string","format":"date-time","description":"When the monthly response allowance resets (response metering only)."},"context":{"type":"string","enum":["chatCreation","studyCreation","sharedStudyUsage","sharedMindUsage"],"description":"Which surface hit the wall, when the gate knows it."},"source":{"type":"string","description":"Usage-metering source tag, e.g. `api_v1`."},"isTrialing":{"type":"boolean"},"audienceId":{"type":"string","format":"uuid","description":"Offending Audience (`audienceMembers` only)."}}}}},"MindDetail":{"type":"object","required":["id","name","description","type","tags","profileDetails","isPublic","isLinkSharingEnabled","knowledgeItemCount","readyToChat","createdAt","updatedAt"],"properties":{"id":{"type":"string","format":"uuid"},"name":{"type":"string"},"description":{"type":"string"},"type":{"type":"string","enum":["creative","expert","user"]},"discipline":{"type":["string","null"]},"systemPrompt":{"type":"string","description":"Full generated system prompt, present only for owners and explicit Mind, shared-team, or private-Audience collaborators."},"sourcePolicy":{"type":"string","enum":["auto","knowledge_only"],"description":"Persisted source policy, present only when systemPrompt inspection is authorized."},"tags":{"type":"array","items":{"type":"string"}},"profileDetails":{"$ref":"#/components/schemas/MindProfileDetails"},"isPublic":{"type":"boolean"},"isLinkSharingEnabled":{"type":"boolean"},"publicShareId":{"type":["string","null"],"format":"uuid","description":"Public share token (present only when link sharing is enabled)."},"profileImageUrl":{"type":["string","null"],"format":"uri"},"phoneNumber":{"type":["string","null"]},"clonedVoiceStatus":{"type":["string","null"],"description":"Voice cloning status; null if not cloned."},"profitSplitOptIn":{"type":"boolean"},"knowledgeItemCount":{"type":"integer","description":"Number of portfolio/knowledge items attached."},"trainingStatus":{"type":["string","null"],"enum":["queued","running","completed","failed",null],"description":"Current training lifecycle state, from the same authority as GET /v1/minds/{id}/training. A Mind created from 2026-09-18T21:30:00Z without a system prompt never reports `completed`: it reports `failed` (retryable) until it is retrained. Older Minds keep their historical status. Poll GET /v1/minds/{id}/training for full detail."},"readyToChat":{"type":"boolean","description":"True only when training has completed; a mind's id exists before it is ready."},"createdAt":{"type":"string","format":"date-time"},"updatedAt":{"type":"string","format":"date-time"}}},"MindProfileDetails":{"type":"object","description":"The Mind's stored cohort profile. `defaults` always lists the eight default attributes in this order (age, gender, geography, employment_status, occupation, income, education, life_stage); an empty `values` array means not known. `attributes` lists every other stored attribute in stored order. Nothing is inferred from the persona text.","required":["defaults","attributes"],"properties":{"defaults":{"type":"array","items":{"type":"object","required":["dimension","values"],"properties":{"dimension":{"type":"string","enum":["age","gender","geography","employment_status","occupation","income","education","life_stage"]},"values":{"type":"array","description":"One entry per stored value; several values are listed separately, never joined.","items":{"$ref":"#/components/schemas/MindProfileAttribute"}}}}},"attributes":{"type":"array","items":{"$ref":"#/components/schemas/MindProfileAttribute"}}}},"MindProfileAttribute":{"type":"object","required":["label","value","dimension","state","basis"],"properties":{"label":{"type":"string","description":"The stored distribution name."},"value":{"type":["string","null"],"description":"The stored value; null when the profile records the attribute without one (see state)."},"dimension":{"type":["string","null"],"description":"The shared attribute the value belongs to, or null."},"canonical":{"type":"string","description":"The value in the shared vocabulary, present only when the stored wording is that value (or an age band)."},"state":{"type":"string","enum":["assigned","unknown","not_applicable","not_asked","missing","refused"]},"basis":{"type":"string","enum":["user_target","internal_target","observed","public_evidence","modeled","unknown"],"description":"`modeled` is an assumption without a source."},"reason":{"type":"string","description":"The stored explanation of the basis."},"options":{"type":"array","items":{"type":"string"},"description":"Present on the options of one multi-select question shown as one attribute: `label` is the question and `value` lists these selected options, each in its stored wording."},"translations":{"type":"object","description":"Read-only presentation for the caller's locale (`x-locale` header or `aox-locale` cookie; default `en`): `{ [locale]: { label?, value? } }` with the friendly label a profile shows (a survey question as the attribute it measures, e.g. \"Openness to new cuisines\"; an awkward answer as a profile value). Only wording that differs from the stored `label`/`value` is present; those stay the identity.","additionalProperties":{"type":"object","properties":{"label":{"type":"string"},"value":{"type":"string"}}}},"figure":{"type":"object","description":"A specific figure inside the stored segment: the exact age in an age band, or an amount derived inside a bracket (approximate).","required":["value","approximate"],"properties":{"value":{"type":"number"},"unit":{"type":"string"},"unitPosition":{"type":"string","enum":["before","after"]},"approximate":{"type":"boolean"}}}}},"UpdateMindRequest":{"type":"object","description":"All fields are optional, but at least one must be present. Fields of the wrong type are ignored rather than rejected.","properties":{"name":{"type":"string","minLength":2,"maxLength":100,"description":"Display name (trimmed; 2-100 characters after trimming)."},"description":{"type":"string","description":"Short summary of the Mind (trimmed)."},"type":{"type":"string","enum":["creative","expert","user"],"description":"Mind archetype. Case-insensitive; aliases `artist` -> creative and `client` / `consumer` -> user; any other value becomes `creative`."},"discipline":{"type":"string","description":"Area of expertise. An empty string clears it (stored as null)."},"systemPrompt":{"type":"string","description":"Replace the full system prompt verbatim (not trimmed). Use `POST /v1/minds/{mindId}/regenerate-prompt` to rebuild it from the knowledge base instead."},"sourcePolicy":{"type":"string","enum":["auto","knowledge_only"],"description":"Persisted answer policy. `knowledge_only` always retrieves processed Mind knowledge and fails closed when it cannot support the answer; a request-level setting can never downgrade it. In a Study it still reads the stimulus a question is asked about (attached files, images, links), never as a source of facts. Empty string or null resets to `auto`."},"tags":{"type":"array","items":{"type":"string"},"maxItems":20,"description":"Replaces the tag list. Entries are trimmed, non-string and empty entries are dropped, and only the first 20 are kept."},"isPublic":{"type":"boolean","deprecated":true,"description":"Accepted for backward compatibility but always stored as false. Individual Minds cannot be made public; share an Audience instead."},"isLinkSharingEnabled":{"type":"boolean","description":"true keeps or generates a `publicShareId` so the Mind is readable via its share link; false clears it."},"profileImageUrl":{"type":"string","format":"uri","description":"Avatar URL stored as given (not downloaded or re-hosted). An empty string clears the image."}}},"MindCompletionRequest":{"type":"object","properties":{"messages":{"type":"array","maxItems":100,"description":"Conversation in chronological order, ending with a `user` message or the results of prior assistant tool calls. Omit or send `[]` for the greeting bootstrap. With `sourcePolicy: \"knowledge_only\"` only the last `user` message is sent to the model.","items":{"$ref":"#/components/schemas/MindCompletionMessage"}},"responseMode":{"type":"string","enum":["sync","stream"],"default":"sync","description":"`sync` buffers the whole reply into one JSON response. `stream` answers with `text/event-stream` and delivers the same payload in a terminal `result` frame; use it whenever generation may exceed ~60 s (web search, large attachments)."},"model":{"type":"string","description":"Model override, e.g. `claude-sonnet-5-5`, `gpt-6.1-sol`, `gpt-6-luna`, `gemini-3.8-flash`. Provider is auto-detected from the `claude-`, `gemini-`, `gpt-`/`o1`/`o3`/`o4`/`chatgpt-` prefixes; retired IDs are forwarded to their replacement. Without an override the team's preferred provider (if any) or the product default is used."},"modelConnection":{"type":"object","additionalProperties":false,"required":["id","revision"],"properties":{"id":{"type":"string","format":"uuid"},"revision":{"type":"integer","minimum":1}},"description":"Explicit verified team connection. Cannot be combined with model/provider. Requires streaming, and tools/structured capabilities when used. Errors never fall back to a native model."},"provider":{"type":"string","enum":["openai","anthropic","google"],"description":"Provider of `model`. Required only when the provider cannot be auto-detected from the model name."},"language":{"type":"string","enum":["en","es","fr","de","zh","tr","ar","ja","ko"],"description":"Reply language hint. Falls back to the `x-locale` header, then `en`. Strong personas may still answer in their native language."},"endUserName":{"type":["string","null"],"description":"Display name of the human end user, normalized and truncated to 120 characters. Omitted/empty means the Mind addresses the user neutrally and never infers the API-key owner's name. Aliases: `userDisplayName`, `userName`."},"sourcePolicy":{"type":"string","enum":["auto","knowledge_only","request_only"],"default":"auto","description":"`auto` lets the Mind use its knowledge, web search, link analysis and attachments. `knowledge_only` is fail-closed: it retrieves the Mind's processed knowledge for the last user message, disables every internal and user tool, rejects attachments and media content parts (including tool results), and answers from persona only when nothing relevant is found (recorded in `metadata.knowledgeRetrieval.status: \"fallback\"`). A Mind saved with `knowledge_only` can never be downgraded per request. `request_only` is accepted for parity with Study runs and behaves like `auto` here."},"citationMarkers":{"type":"string","enum":["inline","none"],"default":"inline","description":"`inline` leaves `[[CITE:n]]` markers (0-based indexes into `metadata.ragCitations`) after grounded claims in `content`. `none` strips them; `metadata.ragCitations` still lists the sources."},"response_format":{"$ref":"#/components/schemas/ChatResponseFormat"},"tools":{"type":"array","maxItems":128,"items":{"$ref":"#/components/schemas/ChatToolDefinition"},"description":"User-defined tools. Calls are returned in `tool_calls`; execute them yourself and send the result back as a `tool` message. Ignored with `sourcePolicy: \"knowledge_only\"`."},"tool_choice":{"$ref":"#/components/schemas/ChatToolChoice"},"parallel_tool_calls":{"type":"boolean","default":true,"description":"Accepted for OpenAI compatibility. Advisory only: the runtime does not currently constrain how many tool calls a turn may contain."},"participants":{"type":"array","maxItems":100,"items":{"type":"string"},"description":"Names (at most 200 characters each) of other participants when the Mind is one voice in a wider conversation. When non-empty the Mind answers in multi-participant mode instead of 1:1 interview mode."}}},"MindCompletionMessage":{"type":"object","required":["role","content"],"properties":{"role":{"type":"string","enum":["user","assistant","tool","system"]},"content":{"type":["string","array"],"description":"Required for every role. User strings must be non-empty (whitespace-only returns 400); assistant strings may be empty. Structured content-part arrays accept inline media and HTTP(S) URLs, but not provider options, provider-owned file/item references, custom provider parts, claimed provider execution or SDK approval state. Tool results must use the tool role; assistant tool-result parts are provider-owned state and are rejected. Tool strings are paired with tool_call_id and the matching earlier assistant call; malformed or unmatched tool history returns 400.","oneOf":[{"type":"string"},{"type":"array","maxItems":128,"items":{"type":"object","additionalProperties":true}}]},"tool_calls":{"type":"array","items":{"$ref":"#/components/schemas/ChatToolCall"},"description":"On `assistant` messages: the tool calls the Mind made in that turn, echoed back verbatim."},"tool_call_id":{"type":"string","description":"On `tool` messages: the `id` of the call this result answers. `content` is the tool result (typically a JSON string)."},"metadata":{"type":"object","description":"Per-message metadata. Only `attachedFiles` is read.","properties":{"attachedFiles":{"type":"array","maxItems":100,"items":{"$ref":"#/components/schemas/MindCompletionAttachment"},"description":"Files, images or web pages to process (PDF, DOCX, TXT/MD, CSV/XLSX, PNG/JPG/WEBP, HTML). Processed in parallel (30 s per file) before the Mind sees the message; the extracted content is appended to the last user message but never persisted. At most 100 attachments across the whole request before deduplication. Attachments are deduplicated by `url` across the whole history. Not allowed with `sourcePolicy: \"knowledge_only\"`."}}}}},"MindCompletionAttachment":{"type":"object","description":"Provide either `url` or `path`, not both. Files without a resolvable `url` are skipped.","properties":{"url":{"type":"string","format":"uri","description":"Public HTTP(S) URL of the file or web page."},"path":{"type":"string","description":"Storage path of an authorized upload. Renewal requires ownership, a valid chat-file signature or shared Study context access; an arbitrary path does not grant file access."},"name":{"type":"string","description":"Display name shown to the Mind."},"type":{"type":"string","description":"MIME type, e.g. `application/pdf`, `image/png`."},"description":{"type":"string"},"transcription":{"type":"string","description":"Pre-transcribed audio/video content."}}},"MindCompletionResponse":{"type":"object","required":["messageId","content"],"properties":{"messageId":{"type":"string","description":"Opaque per-call ID (`msg_` + 32 hex chars). Nothing is persisted; use it for your own correlation."},"content":{"type":"string","description":"The Mind's reply. A JSON string when `response_format` was `json_schema`/`json_object`; empty when the turn ended in `tool_calls` or an image-only result."},"parsed":{"type":["string","number","boolean","object","array","null"],"description":"Parsed structured output. Present only when `response_format` was given and extraction succeeded."},"tool_calls":{"type":"array","items":{"$ref":"#/components/schemas/ChatToolCall"},"description":"Present only when the Mind called one of your `tools`."},"metadata":{"$ref":"#/components/schemas/MindCompletionMetadata"}}},"MindCompletionMetadata":{"type":"object","description":"Present only when at least one field applies. Internal tools (knowledge retrieval, web search, image display/generation, link analysis, document processing) surface their results here, never in `tool_calls`.","properties":{"ragCitations":{"type":"array","items":{"$ref":"#/components/schemas/MindCompletionCitation"},"description":"Verified knowledge, web, link and document sources. Inline `[[CITE:n]]` markers in `content` index into this array (0-based)."},"images":{"type":"array","items":{"$ref":"#/components/schemas/MindCompletionImage"},"description":"Images the Mind displayed or generated. URLs are absolute."},"documentAnalysis":{"type":"string","description":"Analysis text of the last processed attachment, when any."},"chatCitationProvenance":{"$ref":"#/components/schemas/StudyCitationProvenance"},"sourcePolicy":{"type":"string","enum":["knowledge_only"],"description":"Present only for a knowledge-only reply."},"knowledgeRetrieval":{"$ref":"#/components/schemas/MindCompletionKnowledgeRetrieval"},"answerProvenance":{"$ref":"#/components/schemas/MindCompletionAnswerProvenance"}}},"MindCompletionCitation":{"type":"object","required":["id","displaySource"],"properties":{"id":{"type":"string"},"displaySource":{"type":"string","description":"Human-readable source name, file name or URL host."},"rawLink":{"type":"string","format":"uri"},"title":{"type":"string"},"snippet":{"type":"string"},"similarity":{"type":"number","minimum":0,"maximum":1,"description":"Relevance score for knowledge and web sources."},"sourceType":{"type":"string","enum":["mind_knowledge","web","link","document"]}}},"MindCompletionImage":{"type":"object","required":["id","url","filename","description","source"],"properties":{"id":{"type":"string"},"url":{"type":"string","format":"uri"},"filename":{"type":"string"},"description":{"type":"string"},"source":{"type":"string","description":"`generated` for AI-generated images, otherwise where the displayed image came from (e.g. `memory`)."},"path":{"type":"string"},"provider":{"type":"string","description":"Image generation provider (generated images only)."},"size":{"type":"string","description":"e.g. `1024x1024` (generated images only)."}}},"MindCompletionKnowledgeRetrieval":{"type":"object","description":"Source-safe retrieval summary for `sourcePolicy: \"knowledge_only\"`. Titles only; storage paths and raw file contents are never returned.","required":["status","retrievalAttempted","chunksFound","sourceCount","sources"],"properties":{"status":{"type":"string","enum":["grounded","fallback"],"description":"`grounded` when relevant knowledge chunks were used; `fallback` when none matched and the Mind answered from persona/cohort profile only."},"retrievalAttempted":{"type":"boolean","description":"False when the request had no user question to retrieve for."},"chunksFound":{"type":"integer","minimum":0,"description":"Chunks used for this answer (not the Mind's total embedding count)."},"sourceCount":{"type":"integer","minimum":0},"sources":{"type":"array","items":{"type":"object","required":["title","sourceType"],"properties":{"title":{"type":"string"},"sourceType":{"type":"string","enum":["mind_knowledge"]}}}}}},"MindCompletionAnswerProvenance":{"type":"object","description":"Answer-level origin recorded on every reply. Exact claim citations (`ragCitations` + `chatCitationProvenance`) take precedence when present.","required":["origin","sourcePolicy","retrievalAttempted","retrievalChunksFound","evidenceSourceTypes","fallbackStatus","unsupported","recordedAt","verifier"],"properties":{"origin":{"type":"string","enum":["cited_sources","mind_knowledge","request_evidence","mind_personality","unsupported"]},"sourcePolicy":{"type":"string","enum":["auto","knowledge_only","request_only"]},"retrievalAttempted":{"type":"boolean"},"retrievalChunksFound":{"type":"integer","minimum":0},"evidenceSourceTypes":{"type":"array","items":{"type":"string","enum":["mind_knowledge","web","request_evidence","mind_personality"]}},"fallbackStatus":{"type":"string","enum":["grounded","persona_profile","uncertainty_required"]},"unsupported":{"type":"boolean","description":"True when a factual question could not be grounded; the Mind was instructed to express uncertainty."},"recordedAt":{"type":"string","format":"date-time"},"verifier":{"type":"string","enum":["single-mind-answer-provenance-v1"]}}},"MindCompletionNotReadyError":{"type":"object","required":["statusCode","statusMessage","data"],"properties":{"statusCode":{"type":"integer","enum":[409]},"statusMessage":{"type":"string","enum":["This Mind is still training","This Mind failed training and must be retrained before it can chat"]},"data":{"type":"object","required":["code","mindId","trainingStatus"],"properties":{"code":{"type":"string","enum":["SPARK_NOT_READY"]},"mindId":{"type":"string","format":"uuid"},"trainingStatus":{"type":"string","enum":["queued","running","failed"]}}}}},"MindCompletionSseEvent":{"type":"object","oneOf":[{"$ref":"#/components/schemas/MindCompletionStartEvent"},{"$ref":"#/components/schemas/MindCompletionResponse"},{"$ref":"#/components/schemas/MindCompletionErrorEvent"},{"$ref":"#/components/schemas/MindCompletionDoneEvent"}],"description":"`data` payloads by frame: `start` → MindCompletionStartEvent, `result` → MindCompletionResponse, `error` → MindCompletionErrorEvent, `done` → MindCompletionDoneEvent. Lines starting with `:` are heartbeats and carry no data."},"MindCompletionStartEvent":{"type":"object","required":["type","timestamp"],"properties":{"type":{"type":"string","enum":["start"]},"timestamp":{"type":"integer","description":"Unix epoch milliseconds when generation began."}}},"MindCompletionErrorEvent":{"type":"object","description":"Sent instead of `result` when the completion failed after the stream opened. `status` is the HTTP status the same request would have received in `sync` mode.","required":["type","status","message"],"properties":{"type":{"type":"string","enum":["error"]},"status":{"type":"integer","description":"e.g. 400, 401, 403, 404, 409, 429, 500, 503."},"message":{"type":"string","description":"Public client-error message, or generic Completion failed for server/provider failures."},"errorType":{"type":"string","enum":["unsupported_model_capability","model_not_found","invalid_prompt","ai_generation_error"],"description":"Optional stable public error code."}}},"MindCompletionDoneEvent":{"type":"object","required":["type"],"properties":{"type":{"type":"string","enum":["done"]}}},"MindExportStatusResponse":{"type":"object","required":["data"],"properties":{"data":{"type":"object","required":["status"],"properties":{"status":{"type":"string","enum":["idle","queued","processing","completed","failed"],"description":"`idle` also covers an unknown or mismatched `jobId` (the job does not belong to this Mind, format, and locale)."},"progress":{"type":"number","minimum":0,"maximum":100,"description":"Present for `queued` / `processing`."},"error":{"type":"string","description":"Present for `failed`."},"kind":{"type":"string","enum":["persona_profile"],"description":"Present for `completed`."},"format":{"type":"string","enum":["pdf","md","docx","pptx"],"description":"Present for `completed`."},"filename":{"type":"string","description":"Present for `completed`."},"mimeType":{"type":"string","description":"Present for `completed`: `application/pdf`, `text/markdown;charset=utf-8`, or the docx / pptx OpenXML MIME type."},"generatedAt":{"type":["string","null"],"format":"date-time","description":"Present for `completed`."},"downloadUrl":{"type":"string","description":"Present for `completed`: relative path to `GET /v1/minds/{mindId}/export-download` for this artifact."},"content":{"type":"string","description":"Inline UTF-8 markdown; present for completed `md` exports unless `metadata=1`."},"contentBase64":{"type":"string","description":"Inline base64 file bytes; present for completed `pdf` / `docx` / `pptx` exports unless `metadata=1`."}}}}},"KnowledgeItemProcessing":{"type":"object","description":"Durable background-processing state recorded on the item. `status` is the ingestion lifecycle; poll the item `statusUrl` for embedding/pattern counts and the `readyForRetrieval` gate. Only public lifecycle fields are returned. Worker diagnostics and arbitrary metadata are omitted.","required":["status"],"properties":{"status":{"type":"string","enum":["queued","running","completed","failed","unknown"],"description":"Ingestion lifecycle state."},"regeneratePrompt":{"type":"boolean","description":"Whether the Mind system prompt is regenerated once embeddings and patterns finish successfully."},"error":{"type":"string","description":"Generic failure message when `status` is `failed`; internal diagnostics are not returned."},"startedAt":{"type":"string","format":"date-time"},"completedAt":{"type":"string","format":"date-time"},"failedAt":{"type":"string","format":"date-time"},"embeddingsCreated":{"type":"integer","minimum":0},"patternsCreated":{"type":"integer","minimum":0},"promptRegenerated":{"type":"boolean","description":"Whether the optional prompt-regeneration step completed. Present only when recorded."}},"additionalProperties":false},"KnowledgeItem":{"type":"object","description":"A knowledge source attached to a Mind. Exactly one of `link` or `filePath` is set for user-added items; auto-collected sources can also be link-based.","required":["id","description","link","filePath","isWatched","category","relevance","evidence","createdAt","updatedAt"],"properties":{"id":{"type":"string","format":"uuid"},"description":{"type":"string","description":"Human-readable description supplied when the item was added."},"link":{"type":["string","null"],"format":"uri","description":"Source URL for link-based items; null for uploaded files."},"filePath":{"type":["string","null"],"description":"Storage path of the uploaded file (`portfolio/{userId}/{timestamp}_{name}`); null for link-based items."},"isWatched":{"type":"boolean","description":"True when a link item is watched for weekly content changes (managed in the product UI; links only)."},"category":{"type":"string","enum":["lived_experience","social_context","category_behaviour","product_context","education","employment","household_context","economic_context","local_context","business_operations","business_market","business_regulation","business_finance","business_workforce","uncategorized"],"description":"Knowledge category: the search goal the source was collected for, else the category read once from its content. `uncategorized` until either exists, or when the content has no defensible subject."},"relevance":{"type":["number","null"],"minimum":0,"maximum":1,"description":"How useful the source is for the stakeholder role or search topic it was reviewed for (0–1): the content review's score, read once from its content and shared by every Mind reviewed for the same role or topic, not a judgement about this individual Mind. Null until reviewed. Scales the source's height on the knowledge sphere."},"evidence":{"type":["string","null"],"enum":["primary_data","first_hand","analysis","reporting","opinion","marketing","reference","other",null],"description":"What kind of evidence the source is, read once from its content; null until assessed."},"processing":{"$ref":"#/components/schemas/KnowledgeItemProcessing","description":"Absent for legacy items without recorded processing metadata."},"statusUrl":{"type":"string","description":"Relative path of `GET /api/v1/minds/{mindId}/knowledge/{itemId}/status` for this item."},"createdAt":{"type":"string","format":"date-time"},"updatedAt":{"type":"string","format":"date-time"}}},"AddKnowledgeLinkRequest":{"type":"object","title":"Link","required":["link","description"],"properties":{"link":{"type":"string","format":"uri","description":"URL of a web page, YouTube video, or research paper. Note the field is `link`, not `url`."},"description":{"type":"string","description":"Description of the content."},"regeneratePrompt":{"type":"boolean","default":false,"description":"Regenerate the Mind system prompt once ingestion succeeds."}}},"AddKnowledgeRemoteFileRequest":{"type":"object","title":"Remote or workspace file","required":["file","description"],"properties":{"file":{"type":"object","required":["name","url"],"properties":{"name":{"type":"string","description":"Filename including extension; used to derive the storage name and content type."},"url":{"type":"string","format":"uri","description":"Public/signed HTTPS URL, or an authorized Minds workspace upload URL. Workspace uploads require file ownership, a valid chat-file signature, or shared context access through the uploader’s Study; editing the Mind alone is insufficient. Private-network and unsafe URLs are rejected."},"type":{"type":"string","description":"MIME type hint. Falls back to the fetched response `Content-Type`."}}},"description":{"type":"string","description":"Description of the content."},"regeneratePrompt":{"type":"boolean","default":false,"description":"Regenerate the Mind system prompt once ingestion succeeds."}}},"AddKnowledgeKeywordsRequest":{"type":"object","title":"Keyword web search","required":["keywords"],"properties":{"keywords":{"type":"array","minItems":1,"maxItems":15,"items":{"type":"string"},"description":"Search topics. Trimmed, de-duplicated, and capped at 15 (extras are silently dropped). Must contain at least one non-empty string."},"regeneratePrompt":{"type":"boolean","default":true,"description":"Regenerate the Mind system prompt after the collected content is processed."}}},"KnowledgeItemAccepted":{"type":"object","title":"Knowledge item accepted","description":"Created item for file and link modes. `filePath` is present for uploads, `link` for URLs; `isWatched`/`updatedAt` are not included here (see the list endpoint).","required":["id","description","createdAt","processing","statusUrl"],"properties":{"id":{"type":"string","format":"uuid"},"description":{"type":"string"},"link":{"type":"string","format":"uri","description":"Present for link mode only."},"filePath":{"type":"string","description":"Present for file modes only: `portfolio/{userId}/{uuid}_{sanitizedName}`."},"createdAt":{"type":"string","format":"date-time"},"processing":{"$ref":"#/components/schemas/KnowledgeItemProcessing","description":"Always `{ status: \"queued\", regeneratePrompt }` at creation: the full reading (tables and charts for files) runs in the background."},"searchable":{"type":"boolean","description":"File modes only. True when the file's text was already indexed before the response, so the Mind can use it at once; its tables and charts are added when `processing` completes. False when the text could not be read in the request (pictures, recordings): poll `statusUrl` until `readyForRetrieval` is true."},"statusUrl":{"type":"string","description":"Relative path of `GET /api/v1/minds/{mindId}/knowledge/{itemId}/status`; poll until `readyForRetrieval` is true."}}},"KnowledgeEnrichmentAccepted":{"type":"object","title":"Keyword enrichment accepted","required":["mindId","keywords","queued","regeneratePrompt","message"],"properties":{"mindId":{"type":"string","format":"uuid"},"keywords":{"type":"array","items":{"type":"string"},"description":"Normalised keywords actually queued (trimmed, de-duplicated, max 15)."},"queued":{"type":"boolean","const":true},"regeneratePrompt":{"type":"boolean"},"message":{"type":"string","example":"Knowledge enrichment queued with 2 keyword(s). Web search and content processing will run in background."}}},"KnowledgePatternEvidence":{"type":"object","required":["mind"],"properties":{"mind":{"type":"string","description":"The extracted pattern text (citation/quote) supporting this sub-aspect."},"portfolioItemId":{"type":["string","null"],"format":"uuid","description":"Knowledge item the pattern was extracted from. Present only for privileged callers; null for patterns without a source item."},"createdAt":{"type":"string","format":"date-time","description":"When the pattern was extracted. Present only for privileged callers."}}},"KnowledgePatternSubAspect":{"type":"object","required":["id","name","description","occurrences","evidence"],"properties":{"id":{"type":"string","description":"Framework sub-aspect ID, or `(none)` for patterns filed directly under the aspect."},"name":{"type":"string","description":"Sub-aspect name, or `(General)` for patterns without a sub-aspect."},"description":{"type":"string","description":"Framework definition; empty string when unknown."},"occurrences":{"type":"integer","description":"Number of patterns matched to this sub-aspect."},"evidence":{"type":"array","items":{"$ref":"#/components/schemas/KnowledgePatternEvidence"}}}},"KnowledgePatternAspect":{"type":"object","required":["id","name","description","occurrences","subAspects"],"properties":{"id":{"type":"string","description":"Framework aspect ID (e.g. `ocean-O`)."},"name":{"type":"string"},"description":{"type":"string"},"occurrences":{"type":"integer","description":"Number of patterns matched to this aspect (sum of its sub-aspects)."},"subAspects":{"type":"array","description":"Sub-aspects with at least one occurrence, sorted by occurrences descending.","items":{"$ref":"#/components/schemas/KnowledgePatternSubAspect"}}}},"KnowledgePatternFramework":{"type":"object","required":["id","name","totalOccurrences","aspects"],"properties":{"id":{"type":"string","description":"Framework ID (e.g. `ocean`, `disc`, `riasec`)."},"name":{"type":"string","description":"Framework display name (e.g. `Big Five (OCEAN)`)."},"totalOccurrences":{"type":"integer","description":"Sum of aspect occurrences within this framework."},"aspects":{"type":"array","description":"Aspects with at least one occurrence, sorted by occurrences descending.","items":{"$ref":"#/components/schemas/KnowledgePatternAspect"}}}},"MindPattern":{"type":"object","required":["id","aspect","subAspect","mind"],"properties":{"id":{"type":"integer","description":"Pattern row ID."},"aspect":{"type":"string","description":"Detected method / aspect (legacy name for the `method` column)."},"subAspect":{"type":["string","null"],"description":"Detected competency / sub-aspect (legacy name for the `competency` column)."},"mind":{"type":"string","description":"The supporting quote or insight text for this pattern."},"mindId":{"type":["string","null"],"format":"uuid","description":"Owning Mind. Full rows only."},"userId":{"type":["string","null"],"format":"uuid","description":"User who owned the source material. Full rows only."},"messageId":{"type":["string","null"],"description":"Chat message the pattern was extracted from, if any. Full rows only."},"portfolioItemId":{"type":["string","null"],"format":"uuid","description":"Knowledge item the pattern was extracted from, if any. Full rows only."},"isPredefined":{"type":"boolean","description":"Full rows only."},"isPredefinedAspect":{"type":"boolean","description":"Whether `aspect` comes from a predefined framework. Full rows only."},"isPredefinedSubAspect":{"type":"boolean","description":"Whether `subAspect` comes from a predefined framework. Full rows only."},"createdAt":{"type":"string","format":"date-time","description":"Full rows only."}}},"TrainingStatus":{"type":"object","required":["status","readyToChat"],"properties":{"status":{"type":"string","enum":["queued","running","completed","failed"],"description":"Training lifecycle state."},"readyToChat":{"type":"boolean","description":"True only when training has completed and the mind can answer. This is the moment a mind (and an Audience whose minds all report it) is ready: chat and Studies can use it."},"learningInBackground":{"type":"boolean","description":"True while a mind that is already `readyToChat` keeps learning from its sources in the background: a wider source collection, then a system prompt rebuilt from everything collected. Its answers can still deepen until it settles; nothing needs to wait for it."},"fullyTrained":{"type":"boolean","description":"True once the mind is `readyToChat` and its background knowledge step has settled (`learningInBackground` false). Automatic validation of a new Audience waits for every member to be fully trained."},"message":{"type":["string","null"],"description":"Human-readable progress / status message."},"startedAt":{"type":["string","null"],"format":"date-time","description":"When training started (null until running)."},"completedAt":{"type":["string","null"],"format":"date-time","description":"When training finished (completed or failed)."},"knowledgeState":{"type":["object","null"],"description":"What the mind actually knows, which is a different question from whether it can answer. Null only when the lookup itself failed, which never blocks the readiness fields. `readyToChat` flips true as soon as a profile and system prompt exist; a mind whose collection found nothing keeps one generated training-context item instead and still reports ready. Check `fallbackOnly` before running research on it.","required":["sourceCount","researchedSourceCount","embeddingCount","fallbackOnly"],"properties":{"sourceCount":{"type":"integer","description":"Knowledge items attached to the mind, including any fallback item."},"researchedSourceCount":{"type":"integer","description":"Items that are researched or user-supplied, i.e. not the generated fallback."},"embeddingCount":{"type":"integer","description":"Searchable embeddings built from those items."},"fallbackOnly":{"type":"boolean","description":"True when the mind answers from its generated profile alone, with no researched or supplied knowledge."},"fallbackReason":{"type":["string","null"],"description":"Why collection was skipped, e.g. `no_web_without_seeded_corpus`."}}},"error":{"type":["object","null"],"description":"Present only when status is `failed`.","required":["code","retryable"],"properties":{"code":{"type":"string","enum":["COLLECTION_FAILED","PROFILE_GEN_FAILED","TIMEOUT","INTERNAL"]},"retryable":{"type":"boolean","description":"When true, POST /v1/minds/{id}/retrain may recover the mind."}}}}},"MindSummary":{"type":"object","required":["id","name","description","type","tags","createdAt","updatedAt"],"properties":{"id":{"type":"string","format":"uuid","description":"Mind ID."},"name":{"type":"string","description":"Mind display name."},"description":{"type":"string","description":"Short summary of the Mind."},"type":{"type":"string","enum":["creative","expert","user"],"description":"Mind archetype."},"discipline":{"type":["string","null"],"description":"Area of expertise / domain."},"sourcePolicy":{"type":"string","enum":["auto","knowledge_only"],"description":"Persisted source policy for this Mind."},"tags":{"type":"array","items":{"type":"string"},"description":"User-supplied tags (max 20)."},"profileImageUrl":{"type":["string","null"],"format":"uri","description":"Avatar image; resolved to an absolute URL."},"createdAt":{"type":"string","format":"date-time"},"updatedAt":{"type":"string","format":"date-time"}}},"Pagination":{"type":"object","required":["total","limit","offset"],"properties":{"total":{"type":"integer","description":"Total matching rows."},"limit":{"type":"integer","description":"Page size requested."},"offset":{"type":"integer","description":"Number of rows skipped."}}},"CreateMindRequest":{"type":"object","required":["name","discipline"],"properties":{"name":{"type":"string","minLength":2,"maxLength":100,"description":"Mind display name."},"discipline":{"type":"string","description":"Area of expertise (e.g. \"Marketing\", \"Engineering\")."},"description":{"type":"string","description":"Short summary. Defaults to \"Created via API\"."},"mode":{"type":"string","enum":["keywords","clone","link","manual"],"default":"keywords","description":"Training mode."},"type":{"type":"string","enum":["creative","expert","user"],"default":"expert"},"keywords":{"type":"array","items":{"type":"string"},"description":"Required when `mode=keywords`."},"personaContext":{"type":"string","description":"Required when `mode=clone` (name + brief context of the person to emulate)."},"contextLink":{"type":"string","format":"uri","description":"Required when `mode=link` (URL the AI will scrape)."},"link":{"type":"string","format":"uri","description":"Deprecated alias for `contextLink`."},"tags":{"type":"array","items":{"type":"string"},"maxItems":20},"profileImageUrl":{"type":"string","format":"uri","description":"Public HTTP(S) raster avatar URL. Remote downloads are limited to 50 MiB and 30 seconds; private destinations and SVG are refused. If download or storage fails, creation retains the original URL."},"generateImage":{"type":"boolean","description":"Trigger async AI profile-image generation after creation. Defaults to true for auto-training modes; pass false to opt out."},"includeWebSearch":{"type":"boolean","default":true,"description":"Set false to skip automatic web research. For a strictly private source-only Mind, use mode=manual, upload knowledge, then regenerate the prompt."},"isRealPerson":{"type":"boolean","description":"Whether the Mind emulates a real, named person. Defaults to true for mode=clone and false otherwise. Synthetic Minds (false) get name-blind persona prompts: the name is a label, never the seed of the biography."},"sourcePolicy":{"type":"string","enum":["auto","knowledge_only"],"default":"auto","description":"Persisted source policy. knowledge_only always retrieves processed Mind knowledge and fails closed when it cannot support the answer. In a Study it still reads the stimulus a question is asked about (attached files, images, links), never as a source of facts."},"isLinkSharingEnabled":{"type":"boolean","description":"Enable link sharing; generates a `publicShareId`."},"locale":{"type":"string","description":"ISO 639-1 code for the auto-generated description language. Falls back to the user's preferredLanguage, then `en`."}}},"StudyAnalytics":{"type":"object","additionalProperties":true,"required":["studyName","totalAudiences","totalMinds","totalQuestions","totalDataPoints","questions"],"properties":{"studyName":{"type":"string"},"locale":{"type":"string","description":"Study display locale used to format values: the language of the Study's confirmed research plan (studyLocale), else the stored Study locale, else en."},"totalAudiences":{"type":"integer","minimum":0},"totalMinds":{"type":"integer","minimum":0,"description":"Total Minds across the Study's Audiences (legacy wire name)."},"totalQuestions":{"type":"integer","minimum":0},"totalDataPoints":{"type":"integer","minimum":0},"questions":{"type":"array","items":{"type":"object","additionalProperties":true,"properties":{"index":{"type":"integer","minimum":1},"title":{"type":"string"},"type":{"type":"string","enum":["scale","categorical","multiselect","qualitative"]},"classification":{"$ref":"#/components/schemas/StudyQuestionClassification"},"stats":{"type":"object","additionalProperties":true}}}},"scaleQuestionRankings":{"type":"array","description":"Scale questions ranked by overall mean, only among questions that share one scale (authored points, else range) and one unit. A missing unit and a missing range each form their own audience. A question alone on its measure has no ranking position and appears in no audience. Replaces the former single scaleQuestionRanking list, which compared means on different scales and units.","items":{"type":"object","required":["scale","questions"],"properties":{"scale":{"type":"object","description":"The shared scale. Empty for open numeric questions without authored bounds.","properties":{"range":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"number"}},"points":{"type":"array","items":{"type":"object","required":["label","value"],"properties":{"label":{"type":"string"},"value":{"type":"number"}}}}}},"unit":{"$ref":"#/components/schemas/NumericUnit"},"questions":{"type":"array","minItems":2,"description":"Highest mean first.","items":{"type":"object","required":["title","mean","sigma","signalStrength"],"properties":{"title":{"type":"string"},"mean":{"type":"number"},"sigma":{"type":"number"},"signalStrength":{"type":"string","enum":["strong","moderate","weak"]}}}}}}}}},"StudyAskRequest":{"type":"object","required":["question"],"properties":{"question":{"type":"string","minLength":1,"description":"Research question to ask the study."},"sourcePolicy":{"type":"string","enum":["auto","knowledge_only"],"default":"auto","description":"knowledge_only forbids live/request sources, requires each Mind's processed knowledge, and fails closed when retrieval is empty."},"historyMode":{"type":"string","enum":["last5","followup_only","none"],"default":"none","description":"How much of each Mind's own prior answers this question carries. Defaults to none. Use last5 when a respondent's coherence across items is the deliverable."},"audienceIds":{"type":"array","description":"Optional subset of attached audience UUIDs to ask. Defaults to all audiences on the study.","items":{"type":"string","format":"uuid"}},"attachments":{"type":"array","description":"Files or images to process once and include as context for every Mind in the Study. Workspace uploads require ownership, a valid chat-file signature or shared Study context access. Remote HTTP(S) URLs are fetched with their own access token; knowing a storage path does not authorize renewal.","items":{"$ref":"#/components/schemas/StudyAttachment"}},"links":{"type":"array","description":"Web links to fetch and summarize for context.","items":{"$ref":"#/components/schemas/StudyContextLink"}},"keywords":{"type":"array","description":"Keyword/source pairs to fetch and summarize for context.","items":{"$ref":"#/components/schemas/StudyKeywordContext"}},"model":{"type":"string","description":"Optional per-request model override. Must be sent together with `provider`."},"provider":{"type":"string","enum":["openai","anthropic","google"],"description":"Provider for the model override. Must be sent together with `model`."},"disableQuestionClassifier":{"type":"boolean","default":false,"description":"Skip automatic scale/categorical/multiselect/qualitative classification."},"responseMode":{"type":"string","enum":["stream","queued"],"default":"stream","description":"Use queued to persist the question and return immediately while durable workers generate the answers. Queued asks support sourcePolicy auto; use the durable runs endpoint for request_only, knowledge_only, or model connections."},"responseForm":{"type":"string","enum":["concise","standard","expanded"],"description":"How long and how shaped each answer should be, for qualitative questions: `concise` one short message (5-20 words), `standard` 1-3 sentences (25-90 words), `expanded` 2-5 sentences (70-180 words). Omit to let the question decide, which is the existing behaviour. An authored form outranks the phrasing of the question, so a fixed instrument keeps its exact wording. Ignored for scale, categorical and multiselect questions, which are shaped by their answer space."},"clientRequestId":{"type":"string","format":"uuid","description":"Optional idempotency key for queued submissions."}}},"StudyAttachment":{"type":"object","properties":{"url":{"type":"string","description":"External URL for the uploaded or remote file."},"path":{"type":"string","description":"Storage path for an uploaded file."},"name":{"type":"string"},"type":{"type":"string","description":"MIME type when known."}}},"StudyContextLink":{"type":"object","properties":{"label":{"type":"string","description":"URL or display label."},"url":{"type":"string","description":"URL to fetch when separate from `label`."},"id":{"type":"string"}}},"StudyKeywordContext":{"type":"object","properties":{"label":{"type":"string","description":"Keyword or topic label."},"url":{"type":"string","description":"Optional source URL for the keyword."},"id":{"type":"string"}}},"StudyAskSseEvent":{"oneOf":[{"$ref":"#/components/schemas/StudyAskStartEvent"},{"$ref":"#/components/schemas/StudyAskClassificationEvent"},{"$ref":"#/components/schemas/StudyAskAnswerEvent"},{"$ref":"#/components/schemas/StudyAskAggregatingEvent"},{"$ref":"#/components/schemas/StudyAskResultEvent"},{"$ref":"#/components/schemas/StudyAskDoneEvent"},{"$ref":"#/components/schemas/StudyAskE