yload"},"studyId":{"type":["string","null"],"format":"uuid"},"startRequestId":{"type":["string","null"],"format":"uuid"},"startLeaseExpiresAt":{"type":["string","null"],"format":"date-time"},"createdAt":{"type":"string","format":"date-time"},"updatedAt":{"type":"string","format":"date-time"}}},"StudyTemplateAsset":{"type":"object","additionalProperties":false,"required":["id","name","url"],"properties":{"id":{"type":"string"},"name":{"type":"string"},"url":{"type":"string"},"path":{"type":"string"},"mimeType":{"type":"string"},"kind":{"type":"string","enum":["link"]},"sizeBytes":{"type":"number","minimum":0},"mediaType":{"type":"string","enum":["video"]}}},"StudyTemplateConfiguration":{"type":"object","additionalProperties":false,"required":["version","goal","studyLocale","questions","methodId"],"properties":{"version":{"type":"integer","enum":[1]},"goal":{"type":"string","enum":["concept","comparison","website","pricing","market","explore"]},"studyLocale":{"type":"string","enum":["ar","de","en","es","fr","ja","ko","tr","zh"]},"methodId":{"type":"string","description":"A registered research method that is currently available. Methods that design their own tasks at execution (Van Westendorp, MaxDiff, Kano, NPS, …) keep only the qualitative questions in `questions`."},"questions":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["text","response"],"properties":{"text":{"type":"string"},"response":{"$ref":"#/components/schemas/StudyTemplateQuestionResponse"},"attachments":{"type":"array","items":{"$ref":"#/components/schemas/StudyTemplateAsset"},"default":[]}}}}}},"StudyTemplate":{"type":"object","required":["id","name","revision","configuration","createdAt","updatedAt","isSharedWithTeam","canManage","canShareWithTeam"],"properties":{"id":{"type":"string","format":"uuid"},"name":{"type":"string"},"revision":{"type":"integer","minimum":1},"isSharedWithTeam":{"type":"boolean"},"canManage":{"type":"boolean","description":"Only the owner may update, delete or share this template."},"canShareWithTeam":{"type":"boolean","description":"The owner has a team, or can turn off existing sharing."},"configuration":{"$ref":"#/components/schemas/StudyTemplateConfiguration"},"createdAt":{"type":"string","format":"date-time"},"updatedAt":{"type":"string","format":"date-time"}}},"StudyTemplateCreateInput":{"type":"object","additionalProperties":false,"required":["name","configuration"],"properties":{"requestId":{"type":"string","format":"uuid","description":"Reuse only for retries of the same save."},"name":{"type":"string","minLength":1,"maxLength":200},"configuration":{"$ref":"#/components/schemas/StudyTemplateConfiguration"}}},"StudyTemplateUpdateInput":{"type":"object","additionalProperties":false,"required":["expectedRevision"],"anyOf":[{"required":["name"]},{"required":["configuration"]},{"required":["isSharedWithTeam"]}],"properties":{"name":{"type":"string","minLength":1,"maxLength":200},"configuration":{"$ref":"#/components/schemas/StudyTemplateConfiguration"},"expectedRevision":{"type":"integer","minimum":1},"isSharedWithTeam":{"type":"boolean","description":"Owner only. Share with the authenticated owner’s current team, or turn sharing off."}}},"StudyTemplateUseInput":{"type":"object","additionalProperties":false,"required":["expectedRevision","requestId"],"properties":{"expectedRevision":{"type":"integer","minimum":1},"requestId":{"type":"string","format":"uuid","description":"Unique per intended draft; reuse only for retries."}}},"ResearchQuestionCondition":{"type":"object","additionalProperties":false,"required":["questionId"],"oneOf":[{"required":["answerIn"]},{"required":["answerNotIn"]},{"required":["categoryIn"]},{"required":["categoryNotIn"]}],"description":"Ask this question only of respondents whose own answer to an earlier question matched. Give exactly one of: answerIn (asked when the respondent chose any of these options) or answerNotIn (asked when it chose none of them) for an earlier categorical or multiselect question, using its option labels exactly; or categoryIn / categoryNotIn for an earlier open (qualitative) question, which codes each respondent's own answer into one of the categories named for that question (one coding frame per question, at most 12 categories) after it has been answered and before this question runs. An answer that fits none of the categories counts as none of them. Scale and ranking questions cannot gate. Respondents not asked are recorded as not asked and excluded from this question's results.","properties":{"questionId":{"type":"string","minLength":1,"maxLength":80,"description":"Id of the earlier question whose answer decides."},"answerIn":{"type":"array","minItems":1,"maxItems":100,"items":{"type":"string","minLength":1,"maxLength":500}},"answerNotIn":{"type":"array","minItems":1,"maxItems":100,"items":{"type":"string","minLength":1,"maxLength":500}},"categoryIn":{"type":"array","minItems":1,"maxItems":100,"items":{"type":"string","minLength":1,"maxLength":500}},"categoryNotIn":{"type":"array","minItems":1,"maxItems":100,"items":{"type":"string","minLength":1,"maxLength":500}}}},"ResearchQuestionResponse":{"oneOf":[{"type":"object","required":["type"],"additionalProperties":false,"properties":{"type":{"type":"string","enum":["qualitative"]}}},{"type":"object","required":["type","categoricalOptions"],"additionalProperties":false,"properties":{"type":{"type":"string","enum":["categorical"]},"categoricalOptions":{"type":"array","minItems":2,"maxItems":100,"uniqueItems":true,"items":{"type":"string","minLength":1},"description":"Predefined answer choices shown to every Mind."}}},{"type":"object","required":["type","categoricalOptions"],"additionalProperties":false,"properties":{"type":{"type":"string","enum":["multiselect"]},"categoricalOptions":{"type":"array","minItems":2,"maxItems":100,"uniqueItems":true,"items":{"type":"string","minLength":1},"description":"Predefined answers from which each Mind may select 