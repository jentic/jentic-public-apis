erms"],"additionalProperties":false,"properties":{"workspace_id":{"type":"string","format":"uuid"},"api_key":{"type":"string","description":"The workspace-scoped `mcpkey_` secret, shown EXACTLY once. Send it as `x-api-key` on the generation endpoints, or as a bearer token to `mcp_url`. It cannot be retrieved again."},"mcp_url":{"type":"string","format":"uri","description":"Hosted MCP endpoint this key authenticates against."},"plan":{"type":"string","enum":["agent_unclaimed"]},"limits":{"$ref":"#/components/schemas/AgentOnboardingLimits"},"claim_url":{"type":"string","format":"uri","description":"Present only while the claim surface is enabled. Give this to your human: opening it in a browser transfers the workspace and everything generated in it to their account."},"docs":{"type":"string","format":"uri"},"terms":{"type":"string","format":"uri"}}},"AgentOnboardingResponse":{"type":"object","required":["ok","data"],"additionalProperties":false,"properties":{"ok":{"type":"boolean","enum":[true]},"data":{"$ref":"#/components/schemas/AgentOnboarding"}}},"GenerationCapabilitiesResponse":{"type":"object","required":["ok","data"],"additionalProperties":false,"properties":{"ok":{"type":"boolean","enum":[true]},"data":{"type":"array","items":{"$ref":"#/components/schemas/GenerationCapability"}}}},"GenerationQuoteResponse":{"type":"object","required":["ok","data"],"additionalProperties":false,"properties":{"ok":{"type":"boolean","enum":[true]},"data":{"$ref":"#/components/schemas/GenerationQuote"}}},"GenerationJobMutationResponse":{"type":"object","required":["ok","data"],"additionalProperties":false,"properties":{"ok":{"type":"boolean","enum":[true]},"data":{"$ref":"#/components/schemas/GenerationJobMutation"}}},"GenerationJobsResponse":{"type":"object","required":["ok","data"],"additionalProperties":false,"properties":{"ok":{"type":"boolean","enum":[true]},"data":{"type":"array","items":{"$ref":"#/components/schemas/GenerationJob"}}}},"GenerationJobDetailResponse":{"type":"