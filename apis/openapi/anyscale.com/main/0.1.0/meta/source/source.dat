          },
          {
            "description": "Filters the list to be ones expected for private endpoints home page",
            "required": false,
            "schema": {
              "title": "For Private Endpoints Homepage",
              "type": "boolean",
              "description": "Filters the list to be ones expected for private endpoints home page",
              "default": false
            },
            "name": "for_private_endpoints_homepage",
            "in": "query"
          },
          {
            "description": "Filters the list to be ones expected for fine tuning tutorial section",
            "required": false,
            "schema": {
              "title": "For Fine Tuning",
              "type": "boolean",
              "description": "Filters the list to be ones expected for fine tuning tutorial section",
              "default": false
            },
            "name": "for_fine_tuning",
            "in": "query"
          },
          {
            "description": "Filters the list to show the ones expected for ai apps section",
            "required": false,
            "schema": {
              "title": "For Ai Apps Section",
              "type": "boolean",
              "description": "Filters the list to show the ones expected for ai apps section",
              "default": false
            },
            "name": "for_ai_apps_section",
            "in": "query"
          },
          {
            "description": "Filters the list to show the ones expected for gallery section",
            "required": false,
            "schema": {
              "title": "For Gallery",
              "type": "boolean",
              "description": "Filters the list to show the ones expected for gallery section",
              "default": false
            },
            "name": "for_gallery",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
