                "$ref": "#/components/schemas/ServiceEventOrigin"
              }
            ],
            "description": "The origin of the Service events."
          },
          "service_id": {
            "title": "Service Id",
            "type": "string",
            "description": "The id of the Service v2. Present only for Service events."
          },
          "service_version_name": {
            "title": "Service Version Name",
            "type": "string",
            "description": "The name of the associated Service Version. Present only for Service Version event"
          },
          "service_version_id": {
            "title": "Service Version Id",
