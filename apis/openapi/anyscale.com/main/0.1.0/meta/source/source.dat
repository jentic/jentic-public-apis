      "LogDownloadConfig": {
        "title": "LogDownloadConfig",
        "type": "object",
        "properties": {
          "next_page_token": {
            "title": "Next Page Token",
            "type": "string",
            "description": "The next page token (requests to the Log Download API are paginated)."
          },
          "page_size": {
            "title": "Page Size",
            "type": "integer",
            "description": "Page size (default: 1000 items/page).",
            "default": 1000
          },
          "ttl_seconds": {
            "title": "Ttl Seconds",
            "type": "integer",
            "description": "The time-to-live of the presigned url in seconds (default: 4 hours).",
            "default": 14400
          },
          "use_bearer_token": {
            "title": "Use Bearer Token",
            "type": "boolean",
            "description": "Using access token allows us to avoid presigning urls. This is much faster in most cases. This is only supported in GCE. Caller must use the access_token returned from the API to download the logs. Set the access_token as a Bearer token in the Authorization header.",
            "default": false
          }
        },
        "description": "Configuration for listing log files."
      },
      "LogDownloadRequest": {
        "title": "LogDownloadRequest",
        "type": "object",
        "properties": {
          "filter": {
            "title": "Filter",
            "allOf": [
              {
                "$ref": "#/components/schemas/LogFilter"
              }
            ],
            "description": "The filters for downloading logs.",
            "default": {}
          },
          "config": {
            "title": "Config",
            "allOf": [
              {
                "$ref": "#/components/schemas/LogDownloadConfig"
              }
            ],
            "description": "The configutation for downloading logs.",
            "default": {
              "page_size": 1000,
              "ttl_seconds": 14400,
              "use_bearer_token": false
            }
          }
        },
        "description": "These are the request parameters for listing logs."
      },
      "LogDownloadResult": {
        "title": "LogDownloadResult",
        "required": [
          "log_chunks"
        ],
        "type": "object",
        "properties": {
          "log_chunks": {
            "title": "Log Chunks",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LogFileChunk"
            },
            "description": "A list of log file chunks."
          },
          "next_page_token": {
            "title": "Next Page Token",
            "type": "string",
            "description": "Page token to fetch newer logs."
          },
          "previous_page_token": {
            "title": "Previous Page Token",
            "type": "string",
            "description": "Page token to fetch older logs."
          },
          "bearer_token": {
            "title": "Bearer Token",
            "type": "string",
            "description": "Token to be used as a Bearer token passed in via Authorization header to access the log chunks."
          }
        },
        "description": "The result from a call to /logs/get_log_files."
      },
      "LogFileChunk": {
        "title": "LogFileChunk",
        "required": [
          "cluster_id",
          "chunk_name",
          "chunk_url",
          "size",
          "file_name",
          "node_type",
          "node_ip",
          "instance_id",
          "session_id"
        ],
        "type": "object",
        "properties": {
          "cluster_id": {
            "title": "Cluster Id",
            "type": "string",
            "description": "The cluster ID that this file originates from."
          },
          "chunk_name": {
            "title": "Chunk Name",
            "type": "string",
            "description": "The full object name of a chunk (e.g. .../dashboard_agent.log/chunk-one.log)"
          },
          "chunk_url": {
            "title": "Chunk Url",
            "type": "string",
            "description": "A presigned URL to download this chunk."
          },
          "size": {
            "title": "Size",
            "type": "integer",
            "description": "The size of this chunk (should never exceed 10MB)."
          },
          "file_name": {
            "title": "File Name",
            "type": "string",
            "description": "The full file name (path) of a file (e.g. .../dashboard_agent.log"
          },
          "node_type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/NodeType"
              }
            ],
            "description": "The type of node that this file originated from (e.g. head-node, worker-nodes"
          },
          "node_ip": {
            "title": "Node Ip",
            "type": "string",
            "description": "The node IP that this file originated from."
          },
          "instance_id": {
            "title": "Instance Id",
            "type": "string",
            "description": "The instance ID that this file originated from."
          },
          "session_id": {
            "title": "Session Id",
            "type": "string",
            "description": "The session ID that this file originated from."
          },
          "ray_pid": {
            "title": "Ray Pid",
            "type": "string",
            "description": "The PID that this file originated from, if appropriate."
          },
          "ray_worker_id": {
            "title": "Ray Worker Id",
            "type": "string",
            "description": "The Ray worker ID that this file originated from, if appropriate."
          },
          "job_id": {
            "title": "Job Id",
            "type": "string",
            "description": "The Ray job ID that this file originated from, if appropriate."
          }
        },
        "description": "When we retrieve log file chunks from a cloud storage bucket, we infer properties about the chunks\nusing a combination of (a) the filename/path, and (b) the chunk labels/metadata. We pass this metadata\ndown to the client, so the client can group/categorize/process chunks as needed."
      },
      "LogFilter": {
        "title": "LogFilter",
        "type": "object",
        "properties": {
          "node_ip": {
            "title": "Node Ip",
            "type": "string",
            "description": "Filter logs by node_ip (Internal Node IP)."
          },
          "actor_id": {
            "title": "Actor Id",
            "type": "string",
            "description": "Filter logs by actor_id."
          },
          "task_id": {
            "title": "Task Id",
            "type": "string",
            "description": "Filter logs by task_id."
          },
          "glob": {
            "title": "Glob",
            "type": "string",
            "description": "Filter logs by a glob filter."
          },
          "cluster_id": {
            "title": "Cluster Id",
            "type": "string",
            "description": "Filter logs by cluster_id."
          },
          "job_id": {
            "title": "Job Id",
            "type": "string",
            "description": "Filter logs by job_id (Anyscale Job ID)."
          },
          "job_run": {
            "title": "Job Run",
            "type": "string",
            "description": "Filter logs by job_run_id (Anyscale Job Run ID)."
          },
          "instance_id": {
            "title": "Instance Id",
            "type": "string",
            "description": "Filter logs by instance_id (Cloud Provider Instance ID)."
          },
          "node_type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/NodeType"
              }
            ],
            "description": "Filter logs by node_type (head-node, worker-nodes)."
          },
          "process_id": {
            "title": "Process Id",
            "type": "string",
            "description": "Filter logs by process_id."
          },
          "session_id": {
            "title": "Session Id",
            "type": "string",
            "description": "Filter logs by session_id."
          },
          "file_name": {
            "title": "File Name",
            "type": "string",
            "description": "Filter logs by log file name."
          }
        },
        "description": "These are the available filters for downloading logs.\nWe match these filters against the log file path/name (or object attributes) to identify which log files to return\nto the frontend.\n\nThese are mutually exclusive:\n    {cluster_id, job_id, job_run}\n    {actor_id, process_id, task_id}"
      },
      "LogItem": {
        "title": "LogItem",
        "required": [
          "timestamp",
          "timestamp_ns",
          "payload"
        ],
        "type": "object",
        "properties": {
          "timestamp": {
            "title": "Timestamp",
