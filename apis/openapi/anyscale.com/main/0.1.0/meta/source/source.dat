                }
              }
            }
          }
        }
      }
    },
    "/api/v2/organizations/{organization_id}/test_saml_acs": {
      "post": {
        "summary": "Test Saml Acs",
        "description": "Use this organization's Single Sign On (SSO) test config\nwith the SAML2 protocol as a test. This will return a 2xx status code if authentication was successful, or a 4xx or 5xx code if not.\nEither way, we will not create an authenticated session and the caller will not be logged in.\n\nUse this endpoint to test out a new sso_config without setting\nit as the only way to log into your organization.",
        "operationId": "test_saml_acs_api_v2_organizations__organization_id__test_saml_acs_post",
        "parameters": [
