              "type": "string",
              "description": "A path within Anyscale console to redirect to after the user logs in. This only supports paths and not full urls."
            },
            "name": "redirect_to",
            "in": "query"
          },
          {
            "description": "If true, do not use SSO to log in.",
            "required": false,
            "schema": {
