            "required": false,
            "schema": {
              "title": "Name Contains",
              "type": "string",
              "description": "filter by name of project"
            },
            "name": "name_contains",
            "in": "query"
          },
          {
            "description": "filter by creator id",
            "required": false,
            "schema": {
              "title": "Creator Id",
              "type": "string",
              "description": "filter by creator id"
            },
            "name": "creator_id",
            "in": "query"
          },
          {
            "description": "filter by cloud this project is associated with",
            "required": false,
            "schema": {
              "title": "Parent Cloud Id",
              "type": "string",
              "description": "filter by cloud this project is associated with"
            },
            "name": "parent_cloud_id",
            "in": "query"
          },
          {
            "description": "include default projects",
            "required": false,
            "schema": {
              "title": "Include Defaults",
              "type": "boolean",
              "description": "include default projects",
              "default": true
            },
            "name": "include_defaults",
            "in": "query"
          },
          {
            "description": "If absent, the sort order will be determined according to the entity type.",
            "required": false,
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/ProjectsSortField"
                }
              ],
              "description": "If absent, the sort order will be determined according to the entity type."
            },
            "name": "sort_field",
            "in": "query"
          },
          {
            "description": "If sort_field is absent, this field is ignored.If absent, this field defaults to ascending.",
            "required": false,
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/SortOrder"
                }
              ],
              "description": "If sort_field is absent, this field is ignored.If absent, this field defaults to ascending.",
              "default": "ASC"
            },
            "name": "sort_order",
            "in": "query"
          },
          {
            "required": false,
            "schema": {
              "title": "Paging Token",
              "type": "string"
            },
            "name": "paging_token",
            "in": "query"
          },
          {
            "required": false,
            "schema": {
              "title": "Count",
              "maximum": 50.0,
              "minimum": 0.0,
              "type": "integer"
            },
            "name": "count",
            "in": "query"
          }
        ],
