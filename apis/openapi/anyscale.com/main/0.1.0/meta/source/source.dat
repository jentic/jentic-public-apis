      "RayGCSExternalStorageConfig": {
        "title": "RayGCSExternalStorageConfig",
        "type": "object",
        "properties": {
          "address": {
            "title": "Address",
            "type": "string",
            "description": "Address to connect to external storage at. Must be accessible from instances running in the provided cloud."
          },
          "redis_certificate_path": {
            "title": "Redis Certificate Path",
            "type": "string",
            "description": "Path to the certificate on the head node. This path is only relevant when TLS is enabled.",
            "default": "/etc/ssl/certs/ca-certificates.crt"
          },
          "enable": {
            "title": "Enable",
            "type": "boolean",
            "description": "Enable GCS Fault Tolerance (FT) for the service. Default is set to True.",
            "default": true
          }
        },
        "additionalProperties": false,
        "description": "This model is derived from ClusterGCSExternalStorageConfig and includes an additional `enable` field.\nRayGCSExternalStorageConfig is converted into ClusterGCSExternalStorageConfig to filter for fields that are relevant when creating ray_gcs_external_storage_config."
      },
      "RayRuntimeEnvConfig": {
        "title": "RayRuntimeEnvConfig",
        "type": "object",
        "properties": {
          "working_dir": {
            "title": "Working Dir",
            "type": "string",
            "description": "The working directory that your code will run in. Must be a remote URI like an s3 or git path."
          },
          "py_modules": {
            "title": "Py Modules",
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Python modules that will be installed along with your runtime env. These must be remote URIs."
          },
          "relative_working_dir": {
            "title": "Relative Working Dir",
            "type": "string",
            "description": "Relative path to the working directory that your code will run in. The appropriate cloud deployment object storage will be prepended to this path."
          },
          "relative_py_modules": {
            "title": "Relative Py Modules",
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Relative paths to python modules that will be installed along with your runtime env. The appropriate cloud deployment object storage will be prepended to these paths. If `py_modules` are specified, they will be also be installed."
          },
          "py_executable": {
            "title": "Py Executable",
            "type": "string",
            "description": "Specifies the executable used for running the Ray workers. It can include arguments as well."
          },
          "pip": {
            "title": "Pip",
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "A list of pip packages to install."
          },
          "conda": {
            "title": "Conda",
            "description": "[Union[Dict[str, Any], str]: Either the conda YAML config or the name of a local conda env (e.g., \"pytorch_p36\"), "
          },
          "env_vars": {
            "title": "Env Vars",
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Environment variables to set."
          },
          "config": {
            "title": "Config",
            "type": "object",
            "description": "Config for runtime environment. Can be used to setup setup_timeout_seconds, the timeout of runtime environment creation."
          },
          "excludes": {
            "title": "Excludes",
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "File path globs that will be excluded when uploading local files for working_dir."
          },
          "image_uri": {
            "title": "Image Uri",
            "type": "string",
            "description": "Specifies the image URI of the container in which the job will run."
          }
        },
        "description": "A runtime env config. Can be used to start a production job."
      },
