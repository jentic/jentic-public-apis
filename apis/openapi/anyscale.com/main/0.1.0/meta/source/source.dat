    "/api/v2/logs/query_aggregated_logs": {
      "get": {
        "summary": "Query Aggregated Logs",
        "description": "Fetching logs for customer aggregated logs.",
        "operationId": "query_aggregated_logs_api_v2_logs_query_aggregated_logs_get",
        "parameters": [
          {
            "description": "The cluster id used to fetch logs. Exactly one of cluster_id, workspace_id, ha_job_id, or service_id must be set.",
            "required": false,
            "schema": {
              "title": "Cluster Id",
              "type": "string",
              "description": "The cluster id used to fetch logs. Exactly one of cluster_id, workspace_id, ha_job_id, or service_id must be set."
            },
            "name": "cluster_id",
            "in": "query"
          },
          {
            "description": "The workspace id used to fetch logs. Exactly one of cluster_id, workspace_id, ha_job_id, or service_id must be set.",
            "required": false,
            "schema": {
              "title": "Workspace Id",
              "type": "string",
              "description": "The workspace id used to fetch logs. Exactly one of cluster_id, workspace_id, ha_job_id, or service_id must be set."
            },
            "name": "workspace_id",
            "in": "query"
          },
          {
            "description": "The production job id used to fetch logs. Exactly one of cluster_id, workspace_id, ha_job_id, or service_id must be set.",
            "required": false,
            "schema": {
              "title": "Ha Job Id",
              "type": "string",
              "description": "The production job id used to fetch logs. Exactly one of cluster_id, workspace_id, ha_job_id, or service_id must be set."
            },
            "name": "ha_job_id",
            "in": "query"
          },
          {
            "description": "The service id used to fetch logs. Exactly one of cluster_id, workspace_id, ha_job_id, ray_job_submission_id, ray_job_id, or service_id must be set.",
            "required": false,
            "schema": {
              "title": "Service Id",
              "type": "string",
              "description": "The service id used to fetch logs. Exactly one of cluster_id, workspace_id, ha_job_id, ray_job_submission_id, ray_job_id, or service_id must be set."
            },
            "name": "service_id",
            "in": "query"
          },
          {
            "description": "Number of chunks to fetch. Defaults to 400. Max of 1000.",
            "required": false,
            "schema": {
              "title": "Page Size",
              "maximum": 1000.0,
              "exclusiveMinimum": 0.0,
              "type": "integer",
              "description": "Number of chunks to fetch. Defaults to 400. Max of 1000.",
              "default": 400
            },
            "name": "page_size",
            "in": "query"
          },
          {
            "description": "The start time for the query as a nanosecond Unix epoch. If not set, the query will use the time one hour ago.",
            "required": false,
            "schema": {
              "title": "Start Time",
              "type": "integer",
              "description": "The start time for the query as a nanosecond Unix epoch. If not set, the query will use the time one hour ago."
            },
            "name": "start_time",
            "in": "query"
          },
          {
            "description": "The end time for the query as a nanosecond Unix epoch. If not set, the query will use the time now.",
            "required": false,
            "schema": {
              "title": "End Time",
              "type": "integer",
              "description": "The end time for the query as a nanosecond Unix epoch. If not set, the query will use the time now."
            },
            "name": "end_time",
            "in": "query"
          },
          {
            "description": "Positive search terms to filter in the logs. Defaults to no filter. This can be a regex and the search is case insensitive.",
            "required": false,
            "schema": {
              "title": "Positive Search Filter",
              "type": "string",
              "description": "Positive search terms to filter in the logs. Defaults to no filter. This can be a regex and the search is case insensitive."
            },
            "name": "positive_search_filter",
            "in": "query"
          },
          {
            "description": "Negative search terms to filter out the logs. Defaults to no filter. This can be a regex and the search is case insensitive.",
            "required": false,
            "schema": {
              "title": "Negative Search Filter",
              "type": "string",
              "description": "Negative search terms to filter out the logs. Defaults to no filter. This can be a regex and the search is case insensitive."
            },
            "name": "negative_search_filter",
            "in": "query"
          },
          {
            "description": "Advanced search query with syntax supporting NOT, AND, OR operators. Cannot be used together with positive_search_filter or negative_search_filter.",
            "required": false,
            "schema": {
              "title": "Search Query",
              "type": "string",
              "description": "Advanced search query with syntax supporting NOT, AND, OR operators. Cannot be used together with positive_search_filter or negative_search_filter."
            },
            "name": "search_query",
            "in": "query"
          },
          {
            "description": "The source file (worker, raylet, dashboard, controller, proxy, replica, AUTOSCALER..) to filter the logs. Default to no filter.",
            "required": false,
            "schema": {
              "title": "Source",
              "type": "string",
              "description": "The source file (worker, raylet, dashboard, controller, proxy, replica, AUTOSCALER..) to filter the logs. Default to no filter."
            },
            "name": "source",
            "in": "query"
          },
          {
            "description": "The tags to filter the logs. Default to no filter. The format of this field is expected to be in json. The filer will apply to match each key of the object and do exact match on the value.",
            "required": false,
            "schema": {
              "title": "Filter Tags",
              "type": "string",
              "description": "The tags to filter the logs. Default to no filter. The format of this field is expected to be in json. The filer will apply to match each key of the object and do exact match on the value.",
              "format": "json-string"
            },
            "name": "filter_tags",
            "in": "query"
          },
          {
            "description": "Whether the result should be sorted by descending timestamp. Also determines the query direction. When false, it will start to query from the start_time and return results until it reaches the page_size or the end_time. When true, it will start to query from the end_time and return results until it reaches the page_size or the start_time. Default to false.",
            "required": false,
            "schema": {
              "title": "Reverse Sort",
              "type": "boolean",
              "description": "Whether the result should be sorted by descending timestamp. Also determines the query direction. When false, it will start to query from the start_time and return results until it reaches the page_size or the end_time. When true, it will start to query from the end_time and return results until it reaches the page_size or the start_time. Default to false.",
              "default": false
            },
            "name": "reverse_sort",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogitembatchResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
