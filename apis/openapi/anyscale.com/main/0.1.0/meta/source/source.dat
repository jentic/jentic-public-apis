              "title": "Creator Id",
              "type": "string",
              "description": "creator_id to filter by"
            },
            "name": "creator_id",
            "in": "query"
          },
          {
            "description": "name to filter by",
            "required": false,
            "schema": {
              "title": "Name",
              "type": "string",
              "description": "name to filter by"
            },
            "name": "name",
            "in": "query"
          },
          {
            "description": "ha_job_id to filter by",
            "required": false,
            "schema": {
              "title": "Ha Job Id",
              "type": "string",
              "description": "ha_job_id to filter by"
            },
            "name": "ha_job_id",
            "in": "query"
          },
          {
            "description": "DEPRECATED: Shows only ray client runs. Orthogonaol to passing ha_job_id",
            "required": false,
            "schema": {
              "title": "Show Ray Client Runs Only",
              "type": "boolean",
              "description": "DEPRECATED: Shows only ray client runs. Orthogonaol to passing ha_job_id",
              "default": true
            },
            "name": "show_ray_client_runs_only",
            "in": "query"
          },
          {
            "description": "Filter Jobs by their type. Their type is determined by their usage within the product e.g. Interactive sessions, job runs",
            "required": false,
            "schema": {
              "uniqueItems": true,
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/JobRunType"
