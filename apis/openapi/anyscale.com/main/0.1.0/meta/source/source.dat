                "$ref": "#/components/schemas/PageQuery"
              }
            ],
            "description": "Pagination information.",
            "default": {
              "count": 10
            }
          },
          "sorting_directives": {
            "title": "Sorting Directives",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/JobQueueSortDirective"
            },
            "description": "List of sorting criteria (multi-field sort supported)."
          },
          "tags_filter": {
            "title": "Tags Filter",
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "Filter by tags, keys are ANDed, values are ORed"
          }
        },
        "description": "Query model used to filter Job Queues."
      },
