    "/api/v2/sessions/{session_id}/events": {
      "get": {
        "summary": "Get Events",
        "description": "Return events for this cluster.\n\nThere are multiple endpoints to return events.\n\nThis endpoint is for the dataplane to fetch events to power the oss ray dashboard.\n\nThe /cluster_events endpoint is used by the UI to fetch events to power general\ndebugging UI features like train dashboard.\n\nFinally, there are events endpoints for each workload type (workspaces, jobs, services). Those endpoints\nhave some additional logic to stitch together cluster events with workload-specific events.",
        "operationId": "get_events_api_v2_sessions__session_id__events_get",
        "parameters": [
          {
            "required": true,
            "schema": {
              "title": "Session Id",
              "type": "string"
            },
            "name": "session_id",
            "in": "path"
          },
          {
            "required": true,
            "schema": {
              "title": "Start Index",
              "minimum": 0.0,
              "type": "integer"
            },
            "name": "start_index",
            "in": "query"
          },
          {
            "required": true,
            "schema": {
              "title": "End Index",
              "type": "integer"
            },
            "name": "end_index",
            "in": "query"
          },
          {
            "required": false,
            "schema": {
              "title": "Start Time",
              "type": "string",
              "format": "date-time"
            },
            "name": "start_time",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClustereventsoutputResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/sessions/{session_id}/cluster_events": {
      "get": {
        "summary": "Get Cluster Events",
        "description": "Return events for this cluster.\n\nThere are multiple endpoints to return events. This endpoint is for the UI to fetch\nevents. This should power general observability event views shared by different workload types.\nLike the task view or the Train dashboard view.\n\nThe /events endpoint is used by the dataplane to fetch events and has cluster auth requirements.\n\nFinally, there are events endpoints for each workload type (workspaces, jobs, services). Those endpoints\nhave some additional logic to stitch together cluster events with workload-specific events.",
        "operationId": "get_cluster_events_api_v2_sessions__session_id__cluster_events_get",
        "parameters": [
          {
            "required": true,
            "schema": {
              "title": "Session Id",
              "type": "string"
            },
            "name": "session_id",
            "in": "path"
          },
          {
            "description": "Filter for events that have occurred since this value",
            "required": false,
            "schema": {
              "title": "Start Time",
              "type": "string",
              "description": "Filter for events that have occurred since this value",
              "format": "date-time"
            },
            "name": "start_time",
            "in": "query"
          },
          {
            "description": "Filter for events that have occurred before this value",
            "required": false,
            "schema": {
              "title": "End Time",
              "type": "string",
              "description": "Filter for events that have occurred before this value",
              "format": "date-time"
            },
            "name": "end_time",
            "in": "query"
          },
          {
            "description": "Filter for events from these sources",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/ClusterEventSource"
              },
              "description": "Filter for events from these sources"
            },
            "name": "sources",
            "in": "query"
          },
          {
            "description": "Filter for autoscaler events relevant to specific resource bundles.Each string should be a JSON-encoded resource bundle. We accept a string here because query params do not support dictionaries. Ex: ['{\"CPU\": 1, \"GPU\": 1}', '{\"GPU\": 1}']",
            "required": false,
            "schema": {
              "title": "Autoscaler Resource Bundles",
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Filter for autoscaler events relevant to specific resource bundles.Each string should be a JSON-encoded resource bundle. We accept a string here because query params do not support dictionaries. Ex: ['{\"CPU\": 1, \"GPU\": 1}', '{\"GPU\": 1}']"
            },
            "name": "autoscaler_resource_bundles",
            "in": "query"
          },
          {
            "description": "Filter for events from this instance. This is a string that is the instance id of the instance.",
            "required": false,
            "schema": {
              "title": "Instance Id",
              "type": "string",
              "description": "Filter for events from this instance. This is a string that is the instance id of the instance."
            },
            "name": "instance_id",
            "in": "query"
          },
          {
            "description": "Filter for events from this instance. This is a string that is the node ip of the instance.",
            "required": false,
            "schema": {
              "title": "Instance Node Ip",
              "type": "string",
              "description": "Filter for events from this instance. This is a string that is the node ip of the instance."
            },
            "name": "instance_node_ip",
            "in": "query"
          },
          {
            "description": "Fetch events in ascending order of time. Default is descending order.",
            "required": false,
            "schema": {
              "title": "Ascending Order",
              "type": "boolean",
              "description": "Fetch events in ascending order of time. Default is descending order.",
              "default": false
            },
            "name": "ascending_order",
            "in": "query"
          },
          {
            "description": "Max number of events to fetch.",
            "required": false,
            "schema": {
              "title": "Count",
              "type": "integer",
              "description": "Max number of events to fetch.",
              "default": 1000
            },
            "name": "count",
            "in": "query"
          },
          {
            "description": "Filter by level of event. If level is not set, query will return all level values",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/EventLevel"
              },
              "description": "Filter by level of event. If level is not set, query will return all level values"
            },
            "name": "level",
            "in": "query"
          },
          {
            "description": "Filter by message of event. If message is not set, query will not filter for message",
            "required": false,
            "schema": {
              "title": "Message",
              "type": "string",
              "description": "Filter by message of event. If message is not set, query will not filter for message"
            },
            "name": "message",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClustereventListResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
