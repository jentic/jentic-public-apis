                }
              ],
              "description": "Lineage direction (IN, OUT, BIDIR)"
            },
            "name": "direction",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LineagegraphResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/entra/authorize": {
      "get": {
        "summary": "Authorize",
        "description": "Generate Microsoft Entra OAuth authorization URL.\n\nThis is the entry point for Entra OAuth flow. The frontend should redirect\nthe user to the returned authorization_url.\n\nArgs:\n    organization_id: Organization ID for this OAuth flow. Optional for new user\n        registration; required for existing user login.\n\nReturns:\n    Dictionary with authorization_url key\n\nRaises:\n    HTTPException 400: If deployment is not Azure\n    HTTPException 500: If Entra OAuth client ID or secret is not configured",
        "operationId": "authorize_api_v2_entra_authorize_get",
        "parameters": [
          {
            "description": "Organization ID for OAuth flow (optional for registration)",
            "required": false,
            "schema": {
              "title": "Organization Id",
              "type": "string",
              "description": "Organization ID for OAuth flow (optional for registration)"
            },
            "name": "organization_id",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/entra/callback": {
      "get": {
        "summary": "Callback",
        "description": "Handle OAuth callback from Microsoft Entra.\n\nThis endpoint:\n1. Validates the state parameter\n2. Exchanges the authorization code for tokens\n3. Validates the ID token\n4. If the user's email belongs to multiple organizations, creates a magic\n   link and redirects to the org picker\n5. Otherwise finds or creates the user, creates a session, and redirects\n   to the console\n\nOn authorization errors (user denied consent, etc.), Microsoft redirects here\nwith error/error_description instead of a code (RFC 6749 §4.1.2.1).\n\nArgs:\n    state: State parameter for CSRF validation\n    code: Authorization code from Microsoft (absent on error)\n    error: OAuth error code (present when user denies consent or auth fails)\n    error_description: Human-readable error description\n\nReturns:\n    Redirect to console home page on success, org picker on multi-org,\n    or registration page with error on failure",
        "operationId": "callback_api_v2_entra_callback_get",
        "parameters": [
          {
            "description": "State parameter for CSRF validation",
            "required": true,
            "schema": {
              "title": "State",
              "type": "string",
              "description": "State parameter for CSRF validation"
            },
            "name": "state",
            "in": "query"
          },
          {
            "description": "Authorization code from Microsoft",
            "required": false,
            "schema": {
              "title": "Code",
              "type": "string",
              "description": "Authorization code from Microsoft"
            },
            "name": "code",
            "in": "query"
          },
          {
            "description": "OAuth error code from Microsoft",
            "required": false,
            "schema": {
              "title": "Error",
              "type": "string",
              "description": "OAuth error code from Microsoft"
            },
            "name": "error",
            "in": "query"
          },
          {
            "description": "OAuth error description from Microsoft",
            "required": false,
            "schema": {
              "title": "Error Description",
              "type": "string",
              "description": "OAuth error description from Microsoft"
            },
            "name": "error_description",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
