                }
              }
            }
          }
        }
      }
    },
    "/api/v2/scim/scim-migration-preview": {
      "get": {
        "summary": "Scim Migration Preview",
        "description": "Preview permission changes from users' perspective before SCIM enforcement.\n\nThis endpoint compares current effective permissions (direct + user group)\nwith post-migration permissions (user group only) and returns only the\nactual changes users will experience.\n\nUsers with no effective permission changes are not included.\n\nExample output format:\n    user1@example.com:\n      - clouds:\n          - cloud1: readonly -> collaborator\n          - cloud2: collaborator -> (removed)\n      - projects:\n          - proj1: owner -> collaborator\n      - organization: owner -> collaborator",
        "operationId": "scim_migration_preview_api_v2_scim_scim_migration_preview_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DryrunpermissiondiffresultResponse"
                }
              }
            }
          }
        }
      }
    },
