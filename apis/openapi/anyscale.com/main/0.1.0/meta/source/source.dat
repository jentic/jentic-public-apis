        "operationId": "get_job_events_api_v2_decorated_ha_jobs__production_job_id__events_get",
        "parameters": [
          {
            "description": "ID of the production job to fetch logs for. Note: This API doesn't support offset based pagination and the time filter should instead be used.",
            "required": true,
            "schema": {
              "title": "Production Job Id",
              "type": "string",
              "description": "ID of the production job to fetch logs for. Note: This API doesn't support offset based pagination and the time filter should instead be used."
            },
            "name": "production_job_id",
            "in": "path"
          },
          {
            "description": "Filter if origin of event is included in this list. If \"\" in this list, no origin will be included in filter, so no results will be returned. Default behavior is to include all origin values in filter.",
            "required": false,
