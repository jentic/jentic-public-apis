    "/api/v2/data_catalogs/connections/{connection_id}/catalogs/{catalog_id}/schemas/{schema_id}/tables/{table_id}/preview": {
      "get": {
        "summary": "Get Table Preview",
        "description": "Gets a preview of data for a specific table with sample rows. Note: Requires a running SQL warehouse. If no warehouse is running, allow_warehouse_start must be true to proceed (will incur compute costs).",
        "operationId": "get_table_preview_api_v2_data_catalogs_connections__connection_id__catalogs__catalog_id__schemas__schema_id__tables__table_id__preview_get",
        "parameters": [
          {
            "description": "ID of the provider connection",
            "required": true,
            "schema": {
              "title": "Connection Id",
              "type": "string",
              "description": "ID of the provider connection"
            },
            "name": "connection_id",
            "in": "path"
          },
          {
            "description": "ID of the catalog",
            "required": true,
            "schema": {
              "title": "Catalog Id",
              "type": "string",
              "description": "ID of the catalog"
            },
            "name": "catalog_id",
            "in": "path"
          },
          {
            "description": "ID of the schema",
            "required": true,
            "schema": {
              "title": "Schema Id",
              "type": "string",
              "description": "ID of the schema"
            },
            "name": "schema_id",
            "in": "path"
          },
          {
            "description": "ID of the table",
            "required": true,
            "schema": {
              "title": "Table Id",
              "type": "string",
              "description": "ID of the table"
            },
            "name": "table_id",
            "in": "path"
          },
          {
            "description": "Version of the table to retrieve",
            "required": false,
            "schema": {
              "title": "Version",
              "type": "string",
              "description": "Version of the table to retrieve",
              "default": "latest"
            },
            "name": "version",
            "in": "query"
          },
          {
            "description": "Whether to allow starting a stopped SQL warehouse. Starting a warehouse incurs compute costs. If false and no warehouse is running, the request will fail with an error. See: https://www.databricks.com/product/pricing/databricks-sql",
            "required": true,
            "schema": {
              "title": "Allow Warehouse Start",
              "type": "boolean",
              "description": "Whether to allow starting a stopped SQL warehouse. Starting a warehouse incurs compute costs. If false and no warehouse is running, the request will fail with an error. See: https://www.databricks.com/product/pricing/databricks-sql"
            },
            "name": "allow_warehouse_start",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TableDataPreview"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/events/{entity_type}/{entity_id}/events": {
      "get": {
        "summary": "Get Unified Events",
        "description": "Get events for any entity type (production jobs, workspaces, or services)",
        "operationId": "get_unified_events_api_v2_events__entity_type___entity_id__events_get",
        "parameters": [
          {
            "description": "The type of entity",
            "required": true,
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/EntityType"
                }
              ],
              "description": "The type of entity"
            },
            "name": "entity_type",
            "in": "path"
          },
          {
            "description": "The ID of the entity",
            "required": true,
            "schema": {
              "title": "Entity Id",
              "type": "string",
              "description": "The ID of the entity"
            },
            "name": "entity_id",
            "in": "path"
          },
          {
            "description": "Filter if origin of event is included in this list. If \"\" in this list, no origin will be included in filter, so no results will be returned. Default behavior is to include all origin values in filter.\n\nAvailable origins by entity type:\n• Jobs: JOB, CLUSTER\n• Workspaces: WORKSPACE, CLUSTER\n• Services: SERVICE, SERVICE_VERSION, ALB, SERVE_DEPLOYMENT, CLUSTER\n• Clusters: AUTOSCALER, CLUSTER_LIFECYCLE, IDLE_TERMINATION, JOBS, WORKSPACE_SNAPSHOT, OS, CLUSTER",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/UnifiedOriginFilter"
              },
              "description": "Filter if origin of event is included in this list. If \"\" in this list, no origin will be included in filter, so no results will be returned. Default behavior is to include all origin values in filter.\n\nAvailable origins by entity type:\n• Jobs: JOB, CLUSTER\n• Workspaces: WORKSPACE, CLUSTER\n• Services: SERVICE, SERVICE_VERSION, ALB, SERVE_DEPLOYMENT, CLUSTER\n• Clusters: AUTOSCALER, CLUSTER_LIFECYCLE, IDLE_TERMINATION, JOBS, WORKSPACE_SNAPSHOT, OS, CLUSTER",
              "default": []
            },
            "name": "origin",
            "in": "query"
          },
          {
            "description": "Filter by level of event",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/EventLevel"
              },
              "description": "Filter by level of event"
            },
            "name": "level",
            "in": "query"
          },
          {
            "description": "Filter by message of event",
            "required": false,
            "schema": {
              "title": "Message",
              "type": "string",
              "description": "Filter by message of event"
            },
            "name": "message",
            "in": "query"
          },
          {
            "description": "The start time for the query. Non-inclusive. If start_time is not set, the query will use beginning of time.",
            "required": false,
            "schema": {
              "title": "Start Time",
              "type": "string",
              "description": "The start time for the query. Non-inclusive. If start_time is not set, the query will use beginning of time.",
              "format": "date-time"
            },
            "name": "start_time",
            "in": "query"
          },
          {
            "description": "The end time for the query. Non-inclusive. If end_time is not set, the query will use the time now.",
            "required": false,
            "schema": {
              "title": "End Time",
              "type": "string",
              "description": "The end time for the query. Non-inclusive. If end_time is not set, the query will use the time now.",
              "format": "date-time"
            },
            "name": "end_time",
            "in": "query"
          },
          {
            "description": "Fetch events in ascending order of time. Default is descending order.",
            "required": false,
            "schema": {
              "title": "Ascending Order",
              "type": "boolean",
              "description": "Fetch events in ascending order of time. Default is descending order.",
              "default": false
            },
            "name": "ascending_order",
            "in": "query"
          },
          {
            "description": "Show all verbose service events without truncation if set to True. Only applicable to service events.",
            "required": false,
            "schema": {
              "title": "Include Verbose Events",
              "type": "boolean",
              "description": "Show all verbose service events without truncation if set to True. Only applicable to service events.",
              "default": false
            },
            "name": "include_verbose_events",
            "in": "query"
          },
          {
            "description": "Filter for events from this instance. This is a string that is the instance id of the instance.",
            "required": false,
            "schema": {
              "title": "Instance Id",
              "type": "string",
              "description": "Filter for events from this instance. This is a string that is the instance id of the instance."
            },
            "name": "instance_id",
            "in": "query"
          },
          {
            "description": "Filter for autoscaler events relevant to specific resource bundles.Each string should be a JSON-encoded resource bundle. We accept a string here because query params do not support dictionaries. Ex: ['{\"CPU\": 1, \"GPU\": 1}', '{\"GPU\": 1}']",
            "required": false,
            "schema": {
              "title": "Autoscaler Resource Bundles",
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Filter for autoscaler events relevant to specific resource bundles.Each string should be a JSON-encoded resource bundle. We accept a string here because query params do not support dictionaries. Ex: ['{\"CPU\": 1, \"GPU\": 1}', '{\"GPU\": 1}']"
            },
            "name": "autoscaler_resource_bundles",
            "in": "query"
          },
          {
            "description": "Filter for events from this instance. This is a string that is the node ip of the instance.",
            "required": false,
            "schema": {
              "title": "Instance Node Ip",
              "type": "string",
              "description": "Filter for events from this instance. This is a string that is the node ip of the instance."
