            "description": "Name of the Service"
          },
          "description": {
            "title": "Description",
            "type": "string",
            "description": "Description of the Service"
          },
          "project_id": {
            "title": "Project Id",
            "type": "string",
            "description": "Id of the project this Service will start clusters in. This configuration cannot be changed after the service is created."
          },
          "cloud_id": {
            "title": "Cloud Id",
            "type": "string",
            "description": "Id of the cloud this Service belongs to, and will launch clusters in. This configuration cannot be changed."
          },
          "creator_id": {
            "title": "Creator Id",
            "type": "string",
            "description": "Id of the user who created the Service"
          },
          "created_at": {
            "title": "Created At",
            "type": "string",
            "description": "Time the Service was created",
            "format": "date-time"
          },
          "hostname": {
            "title": "Hostname",
            "type": "string",
            "description": "The hostname of the service"
          },
          "current_state": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ServiceEventCurrentState"
              }
            ],
            "description": "The current state of this service"
          },
          "goal_state": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ServiceGoalStates"
              }
            ],
            "description": "The goal state of this service"
          },
          "auth_token": {
            "title": "Auth Token",
            "type": "string",
            "description": "Token to use for service auth. To use the token, add it as a header with the key 'Authorization' and the value 'Bearer <token>'"
          },
          "auto_rollout_enabled": {
            "title": "Auto Rollout Enabled",
            "type": "boolean",
            "description": "Whether or not the service is using auto rollout"
          },
          "versions": {
            "title": "Versions",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DecoratedProductionServiceV2VersionAPIModel"
            },
            "description": "DEPRECATED. Please use `primary_version` and `canary_version` fields. Active versions of this service, sorted by creation time in ascending order."
          },
          "primary_version": {
            "title": "Primary Version",
            "allOf": [
              {
                "$ref": "#/components/schemas/DecoratedProductionServiceV2VersionAPIModel"
              }
            ],
            "description": "Primary version of this service. If the service is terminated, this field refers to the most recently active version."
          },
          "canary_version": {
            "title": "Canary Version",
            "allOf": [
              {
                "$ref": "#/components/schemas/DecoratedProductionServiceV2VersionAPIModel"
              }
            ],
            "description": "Canary version of this service. Present only if the service is in the `ROLLING_OUT` state."
          },
          "service_observability_urls": {
            "title": "Service Observability Urls",
            "allOf": [
              {
                "$ref": "#/components/schemas/ServiceObservabilityUrls"
              }
            ],
            "description": "A JSON object with useful urls pointing to Grafana dashboards."
          },
          "base_url": {
            "title": "Base Url",
            "type": "string",
            "description": "The base url of this service"
          },
          "ended_at": {
            "title": "Ended At",
            "type": "string",
            "description": "Time the Service was terminated",
            "format": "date-time"
          },
          "creator": {
            "title": "Creator",
            "allOf": [
              {
                "$ref": "#/components/schemas/MiniUser"
              }
            ],
            "description": "The creator of this service"
          },
          "is_multi_version": {
            "title": "Is Multi Version",
            "type": "boolean",
            "description": "Whether the service is a multi-version service."
          },
          "error_message": {
            "title": "Error Message",
            "type": "string",
            "description": "Error message occurred while processing the API request."
          },
          "type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ServiceType"
              }
            ],
            "description": "Type of the Service"
          }
        },
        "description": "Shared model to be inherited. It should not be used directly."
      },
      "DecoratedProductionJob": {
        "title": "DecoratedProductionJob",
        "required": [
          "id",
          "name",
          "created_at",
          "creator_id",
