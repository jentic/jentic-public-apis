            "title": "Name",
            "type": "string",
            "description": "Name of the job"
          },
          "description": {
            "title": "Description",
            "type": "string",
            "description": "Description of the job"
          },
          "created_at": {
            "title": "Created At",
            "type": "string",
            "description": "The time this job was created",
            "format": "date-time"
          },
          "updated_at": {
            "title": "Updated At",
            "type": "string",
            "description": "The time this job was last updated",
            "format": "date-time"
          },
          "status_updated_at": {
            "title": "Status Updated At",
            "type": "string",
            "description": "The time this job's status was last updated",
            "format": "date-time"
          },
          "creator_id": {
            "title": "Creator Id",
            "type": "string",
            "description": "The id of the user who created this job"
          },
          "config": {
            "title": "Config",
            "allOf": [
              {
                "$ref": "#/components/schemas/ProductionJobConfig"
              }
            ],
            "description": "The config that was used to create this job"
          },
          "job_queue_config": {
            "title": "Job Queue Config",
            "allOf": [
              {
                "$ref": "#/components/schemas/JobQueueConfig"
              }
            ],
            "description": "Job Queue configuration of this job (if applicable)"
          },
          "state": {
            "title": "State",
            "allOf": [
              {
                "$ref": "#/components/schemas/ProductionJobStateTransition"
              }
            ],
            "description": "The current state of this job"
          },
          "project_id": {
            "title": "Project Id",
            "type": "string",
            "description": "Id of the project this job will start clusters in"
          },
          "last_job_run_id": {
            "title": "Last Job Run Id",
            "type": "string",
            "description": "The id of the last job run"
          },
          "schedule_id": {
            "title": "Schedule Id",
            "type": "string",
            "description": "If the job was launched via Scheduled job, this will contain the id of that schedule."
          },
          "job_queue_id": {
            "title": "Job Queue Id",
            "type": "string",
            "description": "Id of the job queue this job is being enqueued to"
          },
          "overview_url": {
            "title": "Overview Url",
            "type": "string",
            "description": "URL to the job overview page in the Anyscale console"
          },
          "is_service": {
            "title": "Is Service",
            "type": "boolean",
            "description": "Indicates if this job is runs with indefinitely with HA"
          },
          "url": {
            "title": "Url",
            "type": "string",
            "description": "URL to access deployment running in service"
          },
          "token": {
            "title": "Token",
            "type": "string",
            "description": "Token used to authenticate user service if it is accessible to public internet. This field will beempty if user service is not publically accessible."
          },
          "access": {
            "allOf": [
              {
                "$ref": "#/components/schemas/UserServiceAccessTypes"
              }
            ],
            "description": "Whether service can be accessed by public internet traffic.",
            "default": "public"
          },
          "healthcheck_url": {
            "title": "Healthcheck Url",
            "type": "string",
            "description": "The healthcheck url. Anyscale will poll this url to determine whether the service is healthy or not. Only present for services"
          },
          "archived_at": {
            "title": "Archived At",
            "type": "string",
            "description": "The time in which this instance is archived.",
            "format": "date-time"
          },
          "cloud_id": {
            "title": "Cloud Id",
            "type": "string",
            "description": "The id of the cloud to which the job belongs."
          }
        },
        "description": "ProductionJob type that is exposed in create and terminate endpoints."
      },
