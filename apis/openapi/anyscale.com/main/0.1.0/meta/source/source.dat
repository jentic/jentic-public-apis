      "WriteCloud": {
        "title": "WriteCloud",
        "required": [
          "name",
          "provider",
          "region",
          "credentials"
        ],
        "type": "object",
        "properties": {
          "name": {
            "title": "Name",
            "type": "string",
            "description": "Name of this Cloud."
          },
          "provider": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CloudProviders"
              }
            ],
            "description": "Provider of this Cloud (e.g. AWS)."
          },
          "compute_stack": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ComputeStack"
              }
            ],
            "description": "The compute stack associated with this cloud's primary cloud resource."
          },
          "region": {
            "title": "Region",
            "type": "string",
            "description": "Region this Cloud is operating in. This value needs to be supported by this Cloud's provider. (e.g. us-west-2)"
          },
          "credentials": {
            "title": "Credentials",
            "type": "string",
            "description": "Credentials needed to interact with this Cloud."
          },
          "config": {
            "title": "Config",
            "allOf": [
              {
                "$ref": "#/components/schemas/CloudConfig"
              }
            ],
            "description": "Additional configurable properties of this Cloud.",
            "default": {
              "max_stopped_instances": 0
            }
          },
          "is_k8s": {
            "title": "Is K8S",
            "type": "boolean",
            "description": "Whether this cloud is managed via Kubernetes.",
            "default": false
          },
          "is_aioa": {
            "title": "Is Aioa",
            "type": "boolean",
            "description": "Whether this cloud is an AIOA cloud.",
            "default": false
          },
          "availability_zones": {
            "title": "Availability Zones",
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The availability zones that instances of this cloud are allowed to be launched in."
          },
          "is_bring_your_own_resource": {
            "title": "Is Bring Your Own Resource",
            "type": "boolean",
            "description": "Whether the resources of this cloud are provided by the customer."
          },
          "is_private_cloud": {
            "title": "Is Private Cloud",
            "type": "boolean",
            "description": "Whether this cloud is a private cloud.",
            "default": false
          },
          "cluster_management_stack_version": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ClusterManagementStackVersions"
              }
            ],
            "description": "The cluster management stack version of the cloud.",
            "default": "v2"
          },
          "is_private_service_cloud": {
            "title": "Is Private Service Cloud",
            "type": "boolean",
            "description": "Whether services created in this cloud should be private."
          },
          "auto_add_user": {
            "title": "Auto Add User",
            "type": "boolean",
            "description": "Whether all users in the organization should be automatically added to this cloud. This field is only relevant for organizations with cloud isolation enabled, because all users in the organization automatically have access to all clouds if cloud isolation is not enabled.",
            "default": false
          },
          "lineage_tracking_enabled": {
            "title": "Lineage Tracking Enabled",
            "type": "boolean",
            "description": "Whether lineage tracking is enabled for this cloud.",
            "default": false
          },
          "external_id": {
            "title": "External Id",
            "type": "string",
            "description": "The trust policy external ID specified by the user for the cloud control plane role. It must start with the organization ID."
          },
          "creator_id": {
            "title": "Creator Id",
            "type": "string",
            "description": "DEPRECATED. This is now optional and does not need to be passed in."
          }
        },
        "description": "Model used to create a Cloud."
      },
