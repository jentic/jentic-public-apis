            "title": "Nfs Mount Targets",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NFSMountTarget"
            },
            "description": "A set of mount targets that should be used for mounting NFS (potentially one per zone, or just a single one to be used for all zone(s) that the cloud resource spans)."
          },
          "nfs_mount_path": {
            "title": "Nfs Mount Path",
            "type": "string",
            "description": "The path of the NFS server to mount (e.g. on GCP, this is the \"root_dir\" parameter)."
          },
          "user_tag_annotation_prefix": {
            "title": "User Tag Annotation Prefix",
            "type": "string",
            "description": "Prefix for user-defined tag annotations on K8s pods. If not set, tags are added without any prefix."
          },
          "aws_vpc_id": {
            "title": "Aws Vpc Id",
            "type": "string",
            "description": "The AWS vpc id of this cloud."
          },
          "aws_subnet_ids_with_availability_zones": {
            "title": "Aws Subnet Ids With Availability Zones",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SubnetIdWithAvailabilityZoneAWS"
            },
            "description": "A list of AWS subnet IDs with its availability zone of this cloud."
          },
          "aws_iam_role_arns": {
            "title": "Aws Iam Role Arns",
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "A list of 1 or 2 AWS IAM role arns of this cloud (the IAM role Anyscale uses to access this cloud & the IAM role assigned to nodes in the cluster). In the VM compute stack, both are required; in the K8S compute stack, only the first is required."
          },
          "aws_security_groups": {
            "title": "Aws Security Groups",
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "A list of AWS security groups of this cloud."
          },
          "aws_s3_id": {
            "title": "Aws S3 Id",
            "type": "string",
            "description": "The AWS S3 id of this cloud."
          },
          "aws_efs_id": {
            "title": "Aws Efs Id",
            "type": "string",
            "description": "The AWS EFS id of this cloud."
          },
          "aws_efs_mount_target_ip": {
            "title": "Aws Efs Mount Target Ip",
            "type": "string",
            "description": "The AWS EFS mount target IP of this cloud."
          },
          "aws_cloudformation_stack_id": {
            "title": "Aws Cloudformation Stack Id",
            "type": "string",
            "description": "The AWS CloudFormation stack id of this cloud."
          },
          "gcp_vpc_id": {
            "title": "Gcp Vpc Id",
            "type": "string",
            "description": "The GCP vpc id of this cloud."
          },
          "gcp_subnet_ids": {
            "title": "Gcp Subnet Ids",
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "A list of GCP subnet IDs of this cloud."
          },
          "memorydb_cluster_config": {
            "title": "Memorydb Cluster Config",
            "allOf": [
              {
                "$ref": "#/components/schemas/AWSMemoryDBClusterConfig"
              }
            ],
            "description": "The AWS memorydb cluster config of this cloud."
          }
        }
      },
      "CreateCloudResourceGCP": {
        "title": "CreateCloudResourceGCP",
        "required": [
          "gcp_vpc_id",
          "gcp_subnet_ids",
          "gcp_cluster_node_service_account_email",
          "gcp_anyscale_iam_service_account_email",
          "gcp_firewall_policy_ids",
          "gcp_cloud_storage_bucket_id"
        ],
        "type": "object",
        "properties": {
          "compute_stack": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ComputeStack"
              }
            ],
