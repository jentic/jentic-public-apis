          },
          "kubernetes_ingress_external_address": {
            "title": "Kubernetes Ingress External Address",
            "type": "string",
            "description": "On the Kubernetes compute stack, the address of the ingress used for serving traffic for Anyscale services."
          },
          "kubernetes_namespaces": {
            "title": "Kubernetes Namespaces",
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "A list of Kubernetes namespaces associated with this cloud resource."
          },
          "kubernetes_zones": {
            "title": "Kubernetes Zones",
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "On the Kubernetes compute stack, a list of zones to launch pods in."
          },
          "kubernetes_dataplane_identity": {
            "title": "Kubernetes Dataplane Identity",
            "type": "string",
            "description": "The IAM identity of the kubernetes manager which will be used for the validation during registration."
          },
          "kubernetes_nfs_persistent_volume_claim": {
            "title": "Kubernetes Nfs Persistent Volume Claim",
            "type": "string",
            "description": "The name of the persistent volume claim used to mount NFS into pods."
          },
          "persistent_volume_claim": {
            "title": "Persistent Volume Claim",
            "type": "string",
            "description": "For Kubernetes deployments, the name of the persistent volume claim used to mount shared storage into pods."
          },
          "csi_ephemeral_volume_driver": {
            "title": "Csi Ephemeral Volume Driver",
            "type": "string",
            "description": "For Kubernetes deployments, the CSI ephemeral volume driver used to mount shared storage into pods."
          },
          "cloud_storage_bucket_name": {
            "title": "Cloud Storage Bucket Name",
            "type": "string",
            "description": "A fully qualified storage bucket name for cloud storage, e.g. s3://bucket-name, gs://bucket-name, or abfss://bucket-name@account.dfs.core.windows.net."
          },
          "cloud_storage_bucket_endpoint": {
            "title": "Cloud Storage Bucket Endpoint",
            "type": "string",
            "description": "An endpoint for cloud storage, e.g. used to override the default cloud storage scheme's endpoint (e.g. for S3, this would be passed to the AWS_ENDPOINT_URL environment variable)."
          },
          "cloud_storage_bucket_region": {
            "title": "Cloud Storage Bucket Region",
            "type": "string",
            "description": "The region of the cloud storage bucket."
          },
          "nfs_mount_targets": {
            "title": "Nfs Mount Targets",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NFSMountTarget"
            },
            "description": "A set of mount targets that should be used for mounting NFS (potentially one per zone, or just a single one to be used for all zone(s) that the cloud resource spans)."
          },
          "nfs_mount_path": {
            "title": "Nfs Mount Path",
            "type": "string",
            "description": "The path of the NFS server to mount (e.g. on GCP, this is the \"root_dir\" parameter)."
          },
          "user_tag_annotation_prefix": {
            "title": "User Tag Annotation Prefix",
            "type": "string",
            "description": "Prefix for user-defined tag annotations on K8s pods. If not set, tags are added without any prefix."
          },
          "gcp_vpc_id": {
            "title": "Gcp Vpc Id",
            "type": "string",
            "description": "The GCP vpc id of this cloud."
          },
          "gcp_subnet_ids": {
            "title": "Gcp Subnet Ids",
            "type": "array",
            "items": {
