            "title": "State",
            "allOf": [
              {
                "$ref": "#/components/schemas/DecoratedProductionJobStateTransition"
              }
            ],
            "description": "The current state of this job"
          },
          "project_id": {
            "title": "Project Id",
            "type": "string",
            "description": "Id of the project this job will start clusters in"
          },
          "last_job_run_id": {
            "title": "Last Job Run Id",
            "type": "string",
            "description": "The id of the last job run"
          },
          "schedule_id": {
            "title": "Schedule Id",
            "type": "string",
            "description": "If the job was launched via Scheduled job, this will contain the id of that schedule."
          },
          "job_queue_id": {
            "title": "Job Queue Id",
            "type": "string",
            "description": "Id of the job queue this job is being enqueued to"
          },
          "overview_url": {
            "title": "Overview Url",
