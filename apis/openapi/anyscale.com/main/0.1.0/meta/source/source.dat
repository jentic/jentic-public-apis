      "backend__server__api__product__models__catalog_client_models__TableMetadata": {
        "title": "TableMetadata",
        "required": [
          "name",
          "catalog_name",
          "schema_name",
          "table_type"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the table"
          },
          "catalog_name": {
            "type": "string",
            "description": "Name of the parent catalog"
          },
          "schema_name": {
            "type": "string",
            "description": "Name of the parent schema"
          },
          "table_type": {
            "type": "string",
            "description": "Type of table (e.g., 'MANAGED', 'EXTERNAL', 'VIEW')"
          },
          "data_source_format": {
            "type": "string",
            "description": "Data format of the table (e.g., 'DELTA', 'PARQUET')"
          },
          "description": {
            "type": "string",
            "description": "Description or comment for the table"
          },
          "owner": {
            "type": "string",
            "description": "Owner of the table"
          },
          "created_at": {
            "type": "integer",
            "description": "Creation timestamp in milliseconds since epoch",
            "default": 0
          },
          "updated_at": {
            "type": "integer",
            "description": "Last update timestamp in milliseconds since epoch",
            "default": 0
          },
          "full_name": {
            "type": "string",
            "description": "Fully qualified name of the table"
          },
          "columns": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ColumnInfo"
            },
            "description": "List of columns in the table"
          },
          "storage_location": {
            "type": "string",
            "description": "Physical storage location of the table data"
          },
          "properties": {
            "type": "object",
            "description": "Additional table properties"
          },
          "version": {
            "type": "string",
            "description": "Version identifier for versioned tables (e.g., Delta Lake)"
          },
          "row_count": {
            "type": "integer",
            "description": "Number of rows in the table"
          },
          "size_bytes": {
            "type": "integer",
            "description": "Size of the table data in bytes"
          }
        },
        "additionalProperties": false,
        "description": "Detailed metadata for a table.\n\nExtends TableInfo with additional metadata fields like row count, size, and versioning."
      },
      "backend__server__api__product__models__data_catalogs__TableMetadata": {
        "title": "TableMetadata",
        "type": "object",
        "properties": {
          "owner": {
            "type": "string",
            "description": "Owner of the entity"
          },
          "full_name": {
            "type": "string",
            "description": "Fully qualified name of the entity"
          },
          "column_count": {
            "type": "integer",
            "description": "Number of columns in the table"
          }
        },
        "additionalProperties": false,
        "description": "Metadata for tables."
      }
