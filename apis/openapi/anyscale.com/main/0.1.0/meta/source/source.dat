      "post": {
        "summary": "Saml Acs",
        "description": "Authenticate the user for Single Sign On (SSO)\nusing the SAML2 protocol. If successful, log the user in by setting\nthe session cookie. Then redirect to the RelayState parameter if it's\nunder the Anyscale domain, or otherwise just to the Anyscale landing page.",
        "operationId": "saml_acs_api_v2_organizations__organization_id__saml_acs_post",
