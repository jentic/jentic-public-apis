      "SearchJobRunsRequest": {
        "title": "SearchJobRunsRequest",
        "required": [
          "ha_job_ids"
        ],
        "type": "object",
        "properties": {
          "ha_job_ids": {
            "title": "Ha Job Ids",
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of production job IDs to fetch job runs for. Maximum 100."
          },
          "max_runs_per_job": {
            "title": "Max Runs Per Job",
            "maximum": 100.0,
            "minimum": 1.0,
            "type": "integer",
            "description": "Maximum number of runs to return per job. Defaults to 10.",
            "default": 10
          },
          "sort_by_clauses": {
            "title": "Sort By Clauses",
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SortByClause_JobRunSortField_"
            },
            "description": "Sort order for job runs. If not specified, defaults to creation time descending.",
            "default": [
              {
                "sort_field": "CREATED_AT",
                "sort_order": "DESC"
              }
            ]
          },
          "run_name": {
            "title": "Run Name",
            "type": "string",
            "description": "Filter job runs by exact name. If provided, only runs matching this name are returned."
          }
        },
        "description": "Request body for searching job runs across multiple production jobs."
      },
      "SearchJobRunsResponse": {
        "title": "SearchJobRunsResponse",
        "required": [
