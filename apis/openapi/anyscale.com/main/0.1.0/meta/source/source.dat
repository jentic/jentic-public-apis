          "file_type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CloudDataBucketFileType"
              }
            ],
            "description": "The type of file that will be uploaded (e.g. 'runtime_env_packages')."
          },
          "file_name": {
            "title": "File Name",
            "type": "string",
            "description": "The name of the file that will be uploaded (e.g. 'runtime_env_1234.zip'). NOTE: The file name may contain a subdir prefix (eg. my_name/subdir/runtime_env_1234)."
          }
        },
        "description": "DEPRECATED: Use CloudDataBucketPresignedUrlRequest instead.\n\nTODO(janet): Remove this model in a few months.\n\nDefines request parameters needed to generate a presigned URL for uploading a file to a cloud data bucket."
      },
      "CloudDataBucketPresignedUploadScheme": {
        "title": "CloudDataBucketPresignedUploadScheme",
        "enum": [
