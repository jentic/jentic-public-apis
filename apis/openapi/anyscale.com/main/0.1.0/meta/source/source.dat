            "title": "Required Resources",
            "type": "object",
            "additionalProperties": {
              "type": "number"
            },
            "description": "Resources required by this deployment to schedule."
          },
          "deployment_config": {
            "title": "Deployment Config",
            "type": "object"
          },
          "deployment_topology": {
            "title": "Deployment Topology",
            "allOf": [
              {
                "$ref": "#/components/schemas/DeploymentTopology"
              }
            ],
            "description": "Deployment topology graph for the application this deployment belongs to."
          },
          "cluster": {
            "$ref": "#/components/schemas/MiniCluster"
          },
          "creator": {
            "$ref": "#/components/schemas/MiniUser"
          },
          "namespace": {
            "title": "Namespace",
            "allOf": [
              {
                "$ref": "#/components/schemas/MiniNamespace"
              }
            ],
            "description": "This field is deprecated",
