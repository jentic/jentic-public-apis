      "DecoratedComputeTemplateConfig": {
        "title": "DecoratedComputeTemplateConfig",
        "required": [
          "cloud_id",
          "head_node_type",
          "cloud"
        ],
        "type": "object",
        "properties": {
          "cloud_id": {
            "type": "string",
            "description": "The ID of the Anyscale cloud to use for launching sessions."
          },
          "maximum_uptime_minutes": {
            "type": "integer",
            "description": "If set to a positive number, Anyscale will terminate the cluster this many minutes after cluster start."
          },
          "deployment_configs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CloudDeploymentComputeConfig"
            },
            "description": "A list of cloud deployment-specific configs to use."
          },
          "max_workers": {
            "type": "integer",
            "description": "DEPRECATED. This attribute will be ignored - please use the \"max_resources\" flag to configure resource limits."
          },
          "region": {
            "type": "string",
            "description": "The region to launch sessions in, e.g. \"us-west-2\"."
          },
          "allowed_azs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The availability zones that sessions are allowed to be launched in, e.g. \"us-west-2a\". If not specified or \"any\" is provided as the option, any AZ may be used. If \"any\" is provided, it must be the only item in the list."
          },
          "head_node_type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ComputeNodeType"
              }
            ],
            "description": "Node configuration to use for the head node. "
          },
          "worker_node_types": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkerNodeType"
            },
            "description": "A list of node types to use for worker nodes. "
          },
          "aws_advanced_configurations_json": {
            "type": "object",
            "description": "The advanced configuration json that we pass directly AWS APIs when launching an instance. We may do some validation on this json and reject the json if it is using a configuration that Anyscale does not support."
          },
          "gcp_advanced_configurations_json": {
            "type": "object",
            "description": "The advanced configuration json that we pass directly GCP APIs when launching an instance. We may do some validation on this json and reject the json if it is using a configuration that Anyscale does not support."
          },
          "advanced_configurations_json": {
            "type": "object",
            "description": "Advanced configurations for this compute node type to pass to the cloud provider when launching this instance."
          },
          "auto_select_worker_config": {
            "type": "boolean",
            "description": "If set to true, worker node groups will automatically be selected based on workload.",
            "default": false
          },
          "flags": {
            "type": "object",
            "description": "A set of advanced cluster-level flags that can be used to configure a particular workload."
          },
          "idle_termination_minutes": {
            "type": "integer",
            "description": "If set to a positive number, Anyscale will terminate the cluster this many minutes after the cluster is idle. Idle time is defined as the time during which a Cluster is not running a user command or a Ray driver. Time spent running commands on Jupyter or ssh is still considered 'idle'. To disable, set this field to 0."
          },
          "cloud": {
            "allOf": [
              {
                "$ref": "#/components/schemas/MiniCloud"
              }
            ],
            "description": "The decorated cloud_id"
          }
        },
        "additionalProperties": false,
        "description": "DEPRECATED: Please use ClusterCompute and the corresponding ClusterComputeConfig instead.\nConfiguration of compute resources to use for launching a session. Used when reading a compute template."
      },
