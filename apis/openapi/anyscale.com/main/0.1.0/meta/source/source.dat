      "ScheduleConfig": {
        "title": "ScheduleConfig",
        "required": [
          "cron_expression"
        ],
        "type": "object",
        "properties": {
          "cron_expression": {
            "title": "Cron Expression",
            "type": "string",
            "description": "A cron expression to define the frequency at which to run this cron job, for example '0 0 * * *' is a cron expression that means 'run at midnight'. Visit crontab.guru to construct a precise cron_expression."
          },
          "timezone": {
            "title": "Timezone",
            "type": "string",
            "description": "The timezone in which to interpret the cron_expression. Default is Universal time (UTC).",
            "default": "Universal"
          }
        }
      },
      "ScheduleSortField": {
        "title": "ScheduleSortField",
        "enum": [
          "NAME",
          "ID",
          "CREATED_AT",
          "NEXT_TRIGGER_AT"
        ],
        "type": "string",
        "description": "Fields available for sorting schedules."
      },
