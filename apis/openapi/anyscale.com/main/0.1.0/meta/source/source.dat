            "allOf": [
              {
                "$ref": "#/components/schemas/CloudDataBucketPresignedUploadScheme"
              }
            ],
            "description": "The scheme of the upload URL for uploading the file to the cloud data bucket."
          },
          "file_exists": {
            "title": "File Exists",
            "type": "boolean",
            "description": "Whether or not an object under the returned URI already exists."
          },
          "bucket_name": {
            "title": "Bucket Name",
            "type": "string",
            "description": "The name of the cloud data bucket where the file will be uploaded (e.g. 'anyscale-production-data-cld-123')."
          },
          "bucket_path": {
            "title": "Bucket Path",
            "type": "string",
            "description": "The path to the file in the cloud data bucket (e.g. 'org_id/cloud_id/runtime_env_packages/job_id.zip')."
          }
        },
        "description": "DEPRECATED: Use CloudDataBucketPresignedUrlResponse instead.\n\nTODO(janet): Remove this model in a few months.\n\nDefines information needed to upload a file to a cloud data bucket."
      },
      "CloudDataBucketPresignedUploadRequest": {
        "title": "CloudDataBucketPresignedUploadRequest",
        "required": [
          "file_type",
          "file_name"
