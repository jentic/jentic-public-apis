    "/api/v2/experimental_workspaces/{workspace_id}/events": {
      "get": {
        "summary": "Get Workspace Events",
        "description": "Retrieves events for a Workspace. (DEPRECATED: Use /api/v2/events/workspace/{workspace_id}/events instead)",
        "operationId": "get_workspace_events_api_v2_experimental_workspaces__workspace_id__events_get",
        "parameters": [
          {
            "description": "ID of the Workspace to retreive.",
            "required": true,
            "schema": {
              "title": "Workspace Id",
              "type": "string",
              "description": "ID of the Workspace to retreive."
            },
            "name": "workspace_id",
            "in": "path"
          },
          {
            "description": "Filter if origin of event is included in this list. If \"\" in this list, no origin will be included in filter, so no results will be returned. Default behavior is to include all origin values in filter.",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/WorkspaceEventSourceFilter"
              },
              "description": "Filter if origin of event is included in this list. If \"\" in this list, no origin will be included in filter, so no results will be returned. Default behavior is to include all origin values in filter.",
              "default": [
                "WORKSPACE",
                "CLUSTER"
              ]
            },
            "name": "origin",
            "in": "query"
          },
          {
            "description": "Filter by level of event",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/EventLevel"
              },
              "description": "Filter by level of event"
            },
            "name": "level",
            "in": "query"
          },
          {
            "description": "Filter by message of event. If message is not set, query will not filter for message",
            "required": false,
            "schema": {
              "title": "Message",
              "type": "string",
              "description": "Filter by message of event. If message is not set, query will not filter for message"
            },
            "name": "message",
            "in": "query"
          },
          {
            "description": "The start time for the query. Non-inclusive. If  start_time is not set, the query will use beginning of time.",
            "required": false,
            "schema": {
              "title": "Start Time",
              "type": "string",
              "description": "The start time for the query. Non-inclusive. If  start_time is not set, the query will use beginning of time.",
              "format": "date-time"
            },
            "name": "start_time",
            "in": "query"
          },
          {
            "description": "The end time for the query. Non-inclusive. If end_time is not set, the query will use the time now.",
            "required": false,
            "schema": {
              "title": "End Time",
              "type": "string",
              "description": "The end time for the query. Non-inclusive. If end_time is not set, the query will use the time now.",
              "format": "date-time"
            },
            "name": "end_time",
            "in": "query"
          },
          {
            "description": "Fetch events in ascending order of time. Default is descending order.",
            "required": false,
            "schema": {
              "title": "Ascending Order",
              "type": "boolean",
              "description": "Fetch events in ascending order of time. Default is descending order.",
              "default": false
            },
            "name": "ascending_order",
            "in": "query"
          },
          {
            "required": false,
            "schema": {
              "title": "Paging Token",
              "type": "string"
            },
            "name": "paging_token",
            "in": "query"
          },
          {
            "required": false,
            "schema": {
              "title": "Count",
              "maximum": 1000.0,
              "minimum": 0.0,
              "type": "integer"
            },
            "name": "count",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
