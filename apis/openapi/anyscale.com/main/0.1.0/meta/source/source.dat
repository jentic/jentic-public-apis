          },
          "url": {
            "title": "Url",
            "type": "string",
            "description": "The presigned URL to use for uploading or downloading the file in the cloud data bucket."
          },
          "file_exists": {
            "title": "File Exists",
            "type": "boolean",
            "description": "Whether or not an object under the returned URI already exists."
          },
          "bucket_name": {
            "title": "Bucket Name",
            "type": "string",
            "description": "The name of the cloud data bucket where the file will be uploaded (e.g. 'anyscale-production-data-cld-123')."
          },
          "bucket_path": {
            "title": "Bucket Path",
            "type": "string",
            "description": "The path to the file in the cloud data bucket (e.g. 'org_id/cloud_id/runtime_env_packages/job_id.zip')."
          },
          "url_scheme": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CloudDataBucketPresignedUrlScheme"
              }
