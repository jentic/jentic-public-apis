    "/api/v2/decorated_ha_jobs/": {
      "get": {
        "summary": "List Decorated Jobs",
        "operationId": "list_decorated_jobs_api_v2_decorated_ha_jobs__get",
        "parameters": [
          {
            "description": "project_id to filter by",
            "required": false,
            "schema": {
              "title": "Project Id",
              "type": "string",
              "description": "project_id to filter by"
            },
            "name": "project_id",
            "in": "query"
          },
          {
            "description": "workspace_id to filter by",
            "required": false,
            "schema": {
              "title": "Workspace Id",
              "type": "string",
              "description": "workspace_id to filter by"
            },
            "name": "workspace_id",
            "in": "query"
          },
          {
            "description": "name to filter by",
            "required": false,
            "schema": {
              "title": "Name",
              "type": "string",
              "description": "name to filter by"
            },
            "name": "name",
            "in": "query"
          },
          {
            "description": "A list of session states to filter by",
            "required": false,
            "schema": {
              "uniqueItems": true,
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/HaJobStates"
              },
              "description": "A list of session states to filter by",
              "default": []
            },
            "name": "state_filter",
            "in": "query"
          },
          {
            "description": "The job type to filter by",
            "required": false,
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/HaJobType"
                }
              ],
              "description": "The job type to filter by"
            },
            "name": "type_filter",
            "in": "query"
          },
          {
            "description": "filter by creator id",
            "required": false,
            "schema": {
              "title": "Creator Id",
              "type": "string",
              "description": "filter by creator id"
            },
            "name": "creator_id",
            "in": "query"
          },
          {
            "description": "filter by cron_job_id id",
            "required": false,
            "schema": {
              "title": "Source Cron Job Id",
              "type": "string",
              "description": "filter by cron_job_id id"
            },
            "name": "source_cron_job_id",
            "in": "query"
          },
          {
            "description": "The archive status to filter by. Defaults to unarchived.",
            "required": false,
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/ArchiveStatus"
                }
              ],
              "description": "The archive status to filter by. Defaults to unarchived.",
              "default": "NOT_ARCHIVED"
            },
            "name": "archive_status",
            "in": "query"
          },
          {
            "description": "cloud_id to filter by",
            "required": false,
            "schema": {
              "title": "Cloud Id",
              "type": "string",
              "description": "cloud_id to filter by"
            },
            "name": "cloud_id",
            "in": "query"
          },
          {
            "description": "job_queue_id to filter by",
            "required": false,
            "schema": {
              "title": "Job Queue Id",
              "type": "string",
              "description": "job_queue_id to filter by"
            },
            "name": "job_queue_id",
            "in": "query"
          },
          {
            "description": "Repeatable filter of tags in the form key:value. Can be specified multiple times. Values with the same key are ORed; keys are ANDed.",
            "required": false,
            "schema": {
              "title": "Tag Filter",
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Repeatable filter of tags in the form key:value. Can be specified multiple times. Values with the same key are ORed; keys are ANDed."
            },
            "name": "tag_filter",
            "in": "query"
          },
          {
            "description": "Filter for jobs created at or after this time (inclusive). If not set, no lower bound is applied.",
            "required": false,
            "schema": {
              "title": "Created At From",
