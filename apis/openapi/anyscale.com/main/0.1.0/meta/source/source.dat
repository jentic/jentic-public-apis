            "allOf": [
              {
                "$ref": "#/components/schemas/RayGCSExternalStorageConfig"
              }
            ],
            "description": "Config for the Ray GCS to connect to external storage. If populated, head node fault tolerance is enabled for this service."
          },
          "tracing_config": {
            "title": "Tracing Config",
            "allOf": [
              {
                "$ref": "#/components/schemas/TracingConfig"
              }
            ],
            "description": "Config for initializing tracing within Anyscale runtime."
          },
          "build_id": {
            "title": "Build Id",
