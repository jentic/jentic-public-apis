            "description": "The associated cluster id.Present only for Service Version event and only when the cluster is associated with the event."
          },
          "serve_deployment_name": {
            "title": "Serve Deployment Name",
            "type": "string",
            "description": "Name of serve deployment associated with this event. Present only for Serve Deployment events."
          },
          "metadata": {
            "title": "Metadata",
            "type": "object",
            "description": "The metadata of the event"
          },
          "goal_state_initiator": {
            "title": "Goal State Initiator",
            "allOf": [
              {
                "$ref": "#/components/schemas/MiniUser"
              }
            ],
            "description": "The user who initiated the service goal state change. Present only for goal state changes."
