      "DecoratedBuild": {
        "title": "DecoratedBuild",
        "required": [
          "application_template_id",
          "id",
          "application_template",
          "revision",
          "creator_id",
          "status",
          "created_at",
          "last_modified_at",
          "is_byod",
          "creator"
        ],
        "type": "object",
        "properties": {
          "application_template_id": {
            "title": "Application Template Id",
            "type": "string",
            "description": "ID of the App Config this Build belongs to."
          },
          "config_json": {
            "title": "Config Json",
            "allOf": [
              {
                "$ref": "#/components/schemas/AppConfigConfigSchema"
              }
            ],
            "description": "Config JSON used to create this Build."
          },
          "containerfile": {
            "title": "Containerfile",
            "type": "string",
            "description": "The containerfile used to build the image."
          },
          "containerfile_path": {
            "title": "Containerfile Path",
            "type": "string",
            "description": "The original file path of the containerfile."
          },
          "docker_image_name": {
            "title": "Docker Image Name",
            "type": "string",
            "description": "The name of the docker image for this build."
          },
          "registry_login_secret": {
            "title": "Registry Login Secret",
            "type": "string",
            "description": "The name or identifier of a secret containing credentials to authenticate to the docker registry hosting the image."
          },
          "ray_version": {
            "title": "Ray Version",
            "type": "string",
            "description": "The Ray version to use for this build."
          },
          "id": {
            "title": "Id",
            "type": "string",
            "description": "Server assigned unique identifier."
          },
          "application_template": {
            "title": "Application Template",
            "allOf": [
              {
                "$ref": "#/components/schemas/AppConfig"
              }
            ],
            "description": "App Config this Build belongs to."
          },
          "revision": {
            "title": "Revision",
            "type": "integer",
            "description": "Auto incrementing version number for this Build"
          },
          "creator_id": {
            "title": "Creator Id",
            "type": "string",
            "description": "ID of the user who created this Build."
          },
          "error_message": {
            "title": "Error Message",
            "type": "string",
            "description": "Detailed error message. This will only be populated if the Build operation failed."
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/BuildStatus"
              }
            ],
            "description": "\n    Status of the Build.\n\n    `pending` - Build operation is queued and has not started yet.\n    `in_progress` - Build operation is in progress.\n    `succeeded` - Build operation completed successfully.\n    `failed` - Build operation completed unsuccessfully.\n    `pending_cancellation` - Build operation is marked for cancellation.\n    `cancelled` - Build operation was cancelled before it completed.\n    "
          },
          "created_at": {
            "title": "Created At",
            "type": "string",
            "description": "Timestamp of when this Build was created.",
            "format": "date-time"
          },
          "last_modified_at": {
            "title": "Last Modified At",
            "type": "string",
            "description": "Timestamp of when this Build was last updated.",
            "format": "date-time"
          },
          "deleted_at": {
            "title": "Deleted At",
            "type": "string",
            "description": "Timestamp of when this Build was deleted.",
            "format": "date-time"
          },
          "is_byod": {
            "title": "Is Byod",
            "type": "boolean",
            "description": "True if the image URI used in this build was user-specified."
          },
          "cloud_id": {
            "title": "Cloud Id",
            "type": "string",
            "description": "The build cloud associated with this build. If None, the build is a v1 build."
          },
          "digest": {
            "title": "Digest",
            "type": "string",
            "description": "The digest of the image created by this build."
          },
          "creator": {
            "title": "Creator",
            "allOf": [
              {
                "$ref": "#/components/schemas/MiniUser"
              }
            ],
            "description": "Read-only field. Information about the creator."
          },
          "byod_ray_version": {
            "title": "Byod Ray Version",
            "type": "string",
            "description": "Read-only field. If this is a BYOD build, contains the user specified Ray version."
          }
        },
        "description": "Model used to create a Build."
      },
