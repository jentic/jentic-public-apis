    "/api/v2/services-v2/{service_id}/events": {
      "get": {
        "summary": "Get Service Events",
        "description": "Get Service events (DEPRECATED: Use /api/v2/events/service/{service_id}/events instead)",
        "operationId": "get_service_events_api_v2_services_v2__service_id__events_get",
        "parameters": [
          {
            "required": true,
            "schema": {
              "title": "Service Id",
              "type": "string"
            },
            "name": "service_id",
            "in": "path"
          },
          {
            "description": "Filter if origin of event is included in this list. If \"\" in this list, no origin will be included in filter, so no results will be returned. Default behavior is to include all origin values in filter.",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/ServiceEventScopeFilter"
              },
              "description": "Filter if origin of event is included in this list. If \"\" in this list, no origin will be included in filter, so no results will be returned. Default behavior is to include all origin values in filter.",
              "default": [
                "SERVICE",
                "SERVICE_VERSION",
                "ALB",
                "SERVE_DEPLOYMENT",
                "CLUSTER"
              ]
            },
            "name": "origin",
            "in": "query"
          },
          {
            "description": "Filter by level of event",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/EventLevel"
              },
              "description": "Filter by level of event"
            },
            "name": "level",
            "in": "query"
          },
          {
            "description": "Filter by message of event",
            "required": false,
            "schema": {
              "title": "Message",
              "type": "string",
              "description": "Filter by message of event"
            },
            "name": "message",
            "in": "query"
          },
          {
            "description": "The start time for the query. Non-inclusive. If start_time is not set, the query will use beginning of time.",
            "required": false,
            "schema": {
              "title": "Start Time",
              "type": "string",
              "description": "The start time for the query. Non-inclusive. If start_time is not set, the query will use beginning of time.",
              "format": "date-time"
            },
            "name": "start_time",
            "in": "query"
          },
          {
            "description": "The end time for the query. Non-inclusive. If end_time is not set, the query will use the time now.",
            "required": false,
            "schema": {
              "title": "End Time",
              "type": "string",
              "description": "The end time for the query. Non-inclusive. If end_time is not set, the query will use the time now.",
              "format": "date-time"
            },
            "name": "end_time",
            "in": "query"
          },
          {
            "description": "Show all verbose service events without truncation if set to True.",
            "required": false,
            "schema": {
              "title": "Include Verbose Events",
              "type": "boolean",
              "description": "Show all verbose service events without truncation if set to True.",
              "default": false
            },
            "name": "include_verbose_events",
            "in": "query"
          },
          {
            "description": "Fetch events in ascending order of time. Default is descending order.",
            "required": false,
            "schema": {
              "title": "Ascending Order",
              "type": "boolean",
              "description": "Fetch events in ascending order of time. Default is descending order.",
              "default": false
            },
            "name": "ascending_order",
            "in": "query"
          },
          {
            "required": false,
            "schema": {
              "title": "Paging Token",
              "type": "string"
            },
            "name": "paging_token",
            "in": "query"
          },
          {
            "required": false,
            "schema": {
              "title": "Count",
              "maximum": 1000.0,
              "minimum": 0.0,
              "type": "integer"
            },
            "name": "count",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecoratedserviceeventapimodelListResponse"
                }
              }
            }
