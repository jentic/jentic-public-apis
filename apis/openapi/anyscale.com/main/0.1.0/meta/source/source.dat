        }
      }
    },
    "/api/v2/scim/migrate-permissions": {
      "post": {
        "summary": "Migrate Scim Permissions",
        "description": "Migrate organization permissions to SCIM-based user group permissions.\n\nThis endpoint removes individual user permissions after SCIM is enabled,\nso that users only have permissions through their user groups.\n\n**IMPORTANT**: This is a destructive operation that cannot be undone.\nOnly call this after SCIM is fully configured:\n1. User groups are created and synced from your IdP\n2. User group permissions are assigned to resources\n3. Users are added to their respective user groups\n\nThe migration process for each user:\n1. Remove all direct cloud access grants.\n2. Remove all direct project access grants.\n3. Remove all explicit \"read-only override\" grants.\n4. Demote org owner to org collaborator (keep collaborator permission; do not delete it).\n\n**Note**: Users will retain their organization collaborator permission\nas this is a minimum requirement for organization membership.\n\nBy default, `dry_run=true` (safe mode). Pass `dry_run=false` to actually apply changes.\n\nPermission requirements:\n- Caller must be an organization admin",
        "operationId": "migrate_scim_permissions_api_v2_scim_migrate_permissions_post",
        "parameters": [
          {
            "required": false,
            "schema": {
              "title": "Dry Run",
              "type": "boolean",
              "default": true
            },
            "name": "dry_run",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScimmigrationresultResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/scim/list-user-permissions": {
      "get": {
        "summary": "List Scim User Permissions",
        "description": "List users and their effective cloud permissions, plus org owners.\n\nThis endpoint is intended to help customers verify access configuration while migrating\nto SCIM. The response does not include user-group details.\n\nArgs:\n    user_id: Optional user ID to filter. If provided, only that user's permissions\n             are returned.",
        "operationId": "list_scim_user_permissions_api_v2_scim_list_user_permissions_get",
        "parameters": [
          {
            "required": false,
            "schema": {
              "title": "User Id",
