          "scope": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CloudDataBucketRequestScope"
              }
            ],
            "description": "The scope of the upload request (e.g., organization-level or cloud-level). Defaults to cloud-level.",
            "default": "cloud"
          },
          "cloud_resource_id": {
            "title": "Cloud Resource Id",
            "type": "string",
            "description": "The cloud resource ID of the bucket to generate a presigned URL for. If not specified, the primary cloud resource for the cloud will be used."
          },
          "cloud_deployment_id": {
            "title": "Cloud Deployment Id",
