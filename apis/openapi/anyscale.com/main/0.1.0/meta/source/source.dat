      "CloudDataBucketPresignedUploadInfo": {
        "title": "CloudDataBucketPresignedUploadInfo",
        "required": [
          "file_uri",
          "upload_url",
          "upload_scheme",
          "file_exists",
          "bucket_name",
          "bucket_path"
        ],
        "type": "object",
