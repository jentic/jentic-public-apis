            "description": "Time the version was created",
            "format": "date-time"
          },
          "weight": {
            "title": "Weight",
            "type": "integer",
            "description": "The target percentage of traffic sent to this version. This is a number between 0 and 100."
          },
          "current_weight": {
            "title": "Current Weight",
            "type": "integer",
            "description": "The current percentage of traffic sent to this version. This is a number between 0 and 100."
          },
          "target_weight": {
            "title": "Target Weight",
            "type": "integer",
            "description": "The target weight for this version during a weight change operation. This is a number between 0 and 100."
          },
          "version": {
            "title": "Version",
            "type": "string",
            "description": "The version string identifier for this version"
          },
          "ray_serve_config": {
