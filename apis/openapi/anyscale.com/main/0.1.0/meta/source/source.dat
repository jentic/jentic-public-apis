            "title": "Base Snapshot",
            "type": "string",
            "description": "Metadata on base snapshot"
          },
          "id": {
            "title": "Id",
            "type": "string",
            "description": "Server assigned unique identifier of the workspace."
          },
          "created_at": {
            "title": "Created At",
            "type": "string",
            "description": "Time at which Workspace was created.",
            "format": "date-time"
          },
          "creator_id": {
            "title": "Creator Id",
            "type": "string",
            "description": "Identifier of user who created the Workspace."
          },
          "creator_email": {
            "title": "Creator Email",
            "type": "string",
            "description": "Email of user who created the Workspace."
          },
          "creator_deleted_at": {
            "title": "Creator Deleted At",
            "type": "string",
            "description": "Timestamp of when the user who created the workspace was deleted.",
            "format": "date-time"
          },
          "organization_id": {
            "title": "Organization Id",
            "type": "string",
            "description": "Organization that the workspace is associated with."
          },
          "is_deleted": {
            "title": "Is Deleted",
            "type": "boolean",
            "description": "Is the workspace deleted"
          },
          "cluster_id": {
            "title": "Cluster Id",
            "type": "string",
            "description": "ID of the Cluster."
          },
          "environment_id": {
            "title": "Environment Id",
