              "type": "string",
              "description": "The cluster id used to query metrics. Exactly one of cluster_id, workspace_id, ha_job_id, or service_id must be set."
            },
            "name": "cluster_id",
            "in": "query"
          },
          {
            "description": "The workspace id used to query metrics. Exactly one of cluster_id, workspace_id, ha_job_id, or service_id must be set.",
            "required": false,
            "schema": {
              "title": "Workspace Id",
              "type": "string",
              "description": "The workspace id used to query metrics. Exactly one of cluster_id, workspace_id, ha_job_id, or service_id must be set."
            },
            "name": "workspace_id",
            "in": "query"
          },
          {
            "description": "The production job id used to query metrics. Exactly one of cluster_id, workspace_id, ha_job_id, or service_id must be set.",
            "required": false,
            "schema": {
              "title": "Ha Job Id",
              "type": "string",
              "description": "The production job id used to query metrics. Exactly one of cluster_id, workspace_id, ha_job_id, or service_id must be set."
            },
            "name": "ha_job_id",
            "in": "query"
          },
          {
            "description": "The service id used to query metrics. Exactly one of cluster_id, workspace_id, ha_job_id, or service_id must be set.",
            "required": false,
            "schema": {
              "title": "Service Id",
              "type": "string",
              "description": "The service id used to query metrics. Exactly one of cluster_id, workspace_id, ha_job_id, or service_id must be set."
            },
            "name": "service_id",
            "in": "query"
          },
          {
            "description": "Optional start timestamp (Unix). If provided, filters metric names to those present in [start, end].",
            "required": false,
            "schema": {
              "title": "Start",
              "type": "number",
              "description": "Optional start timestamp (Unix). If provided, filters metric names to those present in [start, end]."
