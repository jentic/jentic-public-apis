        "title": "DecoratedWorkloadConnectionInfo",
        "required": [
          "id",
          "workload_id",
          "workload_type",
          "connection",
          "created_at",
          "created_by"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Workload connection ID"
