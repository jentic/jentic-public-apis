            "title": "Name",
            "type": "string",
            "description": "Name of the job"
          },
          "description": {
            "title": "Description",
            "type": "string",
            "description": "Description of the job"
          },
          "created_at": {
            "title": "Created At",
            "type": "string",
            "description": "The time this job was created",
            "format": "date-time"
          },
          "updated_at": {
            "title": "Updated At",
            "type": "string",
            "description": "The time this job was last updated",
            "format": "date-time"
          },
          "status_updated_at": {
            "title": "Status Updated At",
            "type": "string",
            "description": "The time this job's status was last updated",
            "format": "date-time"
          },
          "creator_id": {
            "title": "Creator Id",
            "type": "string",
            "description": "The id of the user who created this job"
          },
          "config": {
            "title": "Config",
            "allOf": [
              {
                "$ref": "#/components/schemas/ProductionJobConfig"
              }
            ],
