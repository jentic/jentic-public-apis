            "schema": {
              "uniqueItems": true,
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/BaseJobStatus"
              },
              "description": "A list of session states to filter by",
              "default": []
            },
            "name": "state_filter",
            "in": "query"
          },
          {
            "description": "'asc' for ascending, 'desc' for descending. Entirely ignored.",
            "required": false,
            "schema": {
              "title": "Order",
              "type": "string",
              "description": "'asc' for ascending, 'desc' for descending. Entirely ignored.",
              "default": "desc"
            },
            "name": "order",
            "in": "query"
          },
          {
            "description": "If absent, the sort order will be determined according to the type_filter.",
            "required": false,
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/JobsSortField"
                }
              ],
              "description": "If absent, the sort order will be determined according to the type_filter."
            },
            "name": "sort_field",
            "in": "query"
          },
          {
            "description": "If sort_field is absent, this field is ignored.If absent, this field defaults to ascending.",
            "required": false,
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/SortOrder"
                }
              ],
              "description": "If sort_field is absent, this field is ignored.If absent, this field defaults to ascending.",
              "default": "ASC"
            },
            "name": "sort_order",
            "in": "query"
          },
          {
            "required": false,
            "schema": {
              "title": "Paging Token",
              "type": "string"
            },
            "name": "paging_token",
            "in": "query"
          },
          {
            "required": false,
            "schema": {
              "title": "Count",
              "maximum": 50.0,
              "minimum": 0.0,
              "type": "integer"
            },
            "name": "count",
            "in": "query"
          }
        ],
        "responses": {
