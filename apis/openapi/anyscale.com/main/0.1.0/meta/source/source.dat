    "/api/v2/experimental_workspaces/": {
      "get": {
        "summary": "List Workspaces",
        "description": "Lists all Workspace the user has access to",
        "operationId": "list_workspaces_api_v2_experimental_workspaces__get",
        "parameters": [
          {
            "description": "Search for workspace with a name that equals the provided value",
            "required": false,
            "schema": {
              "title": "Name",
              "type": "string",
              "description": "Search for workspace with a name that equals the provided value"
            },
            "name": "name",
            "in": "query"
          },
          {
            "description": "Search for workspace with a name that contains the provided value",
            "required": false,
            "schema": {
              "title": "Name Contains",
              "type": "string",
              "description": "Search for workspace with a name that contains the provided value"
            },
            "name": "name_contains",
            "in": "query"
          },
          {
            "description": "List workspaces created by a given user",
            "required": false,
            "schema": {
              "title": "Creator Id",
              "type": "string",
              "description": "List workspaces created by a given user"
            },
            "name": "creator_id",
            "in": "query"
          },
          {
            "description": "Search for workspace with project_id",
            "required": false,
            "schema": {
              "title": "Project Id",
              "type": "string",
              "description": "Search for workspace with project_id"
            },
            "name": "project_id",
            "in": "query"
          },
          {
            "description": "Search for workspace with cloud_id",
            "required": false,
            "schema": {
              "title": "Cloud Id",
              "type": "string",
              "description": "Search for workspace with cloud_id"
            },
            "name": "cloud_id",
            "in": "query"
          },
          {
            "description": "A list of session states to filter by",
            "required": false,
            "schema": {
              "uniqueItems": true,
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/SessionState"
              },
              "description": "A list of session states to filter by",
              "default": []
            },
            "name": "state_filter",
            "in": "query"
          },
          {
            "description": "Repeatable filter of tags in the form key:value. Can be specified multiple times. Values with the same key are ORed; keys are ANDed.",
            "required": false,
            "schema": {
              "title": "Tag Filter",
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Repeatable filter of tags in the form key:value. Can be specified multiple times. Values with the same key are ORed; keys are ANDed."
            },
            "name": "tag_filter",
            "in": "query"
          },
          {
            "description": "If absent, the sort order will be determined according to the type_filter.",
            "required": false,
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/ExperimentalWorkspacesSortField"
                }
              ],
              "description": "If absent, the sort order will be determined according to the type_filter."
            },
            "name": "sort_field",
            "in": "query"
          },
          {
            "description": "If sort_field is absent, this field is ignored.If absent, this field defaults to ascending.",
            "required": false,
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/SortOrder"
                }
              ],
              "description": "If sort_field is absent, this field is ignored.If absent, this field defaults to ascending.",
              "default": "ASC"
            },
            "name": "sort_order",
            "in": "query"
          },
          {
            "required": false,
            "schema": {
              "title": "Paging Token",
              "type": "string"
            },
            "name": "paging_token",
            "in": "query"
          },
          {
            "required": false,
            "schema": {
              "title": "Count",
              "maximum": 50.0,
              "minimum": 0.0,
              "type": "integer",
              "default": 10
            },
            "name": "count",
            "in": "query"
