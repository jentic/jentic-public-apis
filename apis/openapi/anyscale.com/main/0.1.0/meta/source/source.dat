      "MiniBuild": {
        "title": "MiniBuild",
        "required": [
          "id",
          "revision",
          "status",
          "application_template_name",
          "application_template_id"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Server assigned unique identifier."
          },
          "revision": {
            "type": "integer",
            "description": "Auto incrementing version number for this Build"
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/BuildStatus"
              }
            ],
            "description": "\n    Status of the Build.\n\n    `pending` - Build operation is queued and has not started yet.\n    `in_progress` - Build operation is in progress.\n    `succeeded` - Build operation completed successfully.\n    `failed` - Build operation completed unsuccessfully.\n    `pending_cancellation` - Build operation is marked for cancellation.\n    `cancelled` - Build operation was cancelled before it completed.\n    "
          },
          "application_template_name": {
            "type": "string",
            "description": "The name of the cluster environment this build belongs to"
          },
          "application_template_id": {
            "type": "string",
            "description": "The id of the cluster environment this build belongs to"
          },
          "docker_image_name": {
            "type": "string",
            "description": "The name of the docker image for this build."
          },
          "cloud_id": {
            "type": "string",
            "description": "The cloud ID of the cluster environment this build belongs to."
          }
        },
        "additionalProperties": false,
        "description": "The greatest common factor data about a build that is used by most endpoints"
      },
      "MiniCloud": {
        "title": "MiniCloud",
