      "UserInfo": {
        "title": "UserInfo",
        "required": [
          "id",
          "email",
          "name",
          "username",
          "verified",
          "organization_permission_level",
          "organization_ids",
          "organizations",
          "ld_hash",
          "ld_hash_fields",
          "pylon_hash"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "lastname": {
            "type": "string",
            "description": "The user's last name."
          },
          "username": {
            "type": "string"
          },
          "verified": {
            "type": "boolean"
          },
          "organization_permission_level": {
            "allOf": [
              {
                "$ref": "#/components/schemas/OrganizationPermissionLevel"
              }
            ],
            "description": "User's permission level in the organization. This value is absent if the user does not have a permission level assigned."
          },
          "organization_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Deprecated: use organization -- List of organizations that the logged in user is a part of."
          },
          "organizations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Organization"
            },
            "description": "List of organizations that the logged in user is a part of."
          },
          "has_setup_cloud": {
            "type": "boolean",
            "description": "True if the user has clouds setup in their organization."
          },
          "ld_hash": {
            "type": "string",
            "description": "Server generated secure hash of the user info that should be sent to LaunchDarkly along with the user data."
          },
          "ld_hash_fields": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of fields in the userInfo used to generate the secure hash. Clients should send those fields to LaunchDarkly as the user data. These fields should be used in addition to the \"key\" field which is based off the user's id."
          },
          "pylon_hash": {
            "type": "string",
            "description": "Server generated secure hash of the user info that should be sent to Pylon along with the user data."
          },
          "is_support_user": {
            "type": "boolean",
            "default": false
          },
          "is_in_general_platform_org": {
            "type": "boolean",
            "description": "Whether this user is part of an org that has access to the general Anyscale platform.",
            "default": true
          },
          "is_in_private_endpoints_org": {
            "type": "boolean",
            "description": "Whether this user is part of an org that has access to the Private Endpoints product",
            "default": false
          },
          "has_password": {
            "type": "boolean",
            "description": "Whether the user has a password set.",
            "default": false
          }
        },
        "additionalProperties": false
      },
