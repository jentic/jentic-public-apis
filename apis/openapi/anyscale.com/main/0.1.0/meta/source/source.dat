      "CloudResponse": {
        "title": "CloudResponse",
        "required": [
          "result"
        ],
        "type": "object",
        "properties": {
          "result": {
            "$ref": "#/components/schemas/Cloud"
          }
        },
        "additionalProperties": false,
        "description": "A response from the API. Contains a field \"result\" which has the contents of the response."
      },
      "CloudState": {
        "title": "CloudState",
        "enum": [
          "CREATING",
          "ACTIVE",
          "VERIFICATION_FAILED",
          "DELETING",
          "DELETED",
          "CLAIMED"
        ],
        "type": "string",
        "description": "An enumeration."
      },
      "CloudStatus": {
        "title": "CloudStatus",
        "enum": [
          "pending",
          "ready"
        ],
        "type": "string",
        "description": "An enumeration."
      },
      "CloudType": {
        "title": "CloudType",
        "enum": [
          "AWS",
          "GCP"
        ],
        "type": "string",
        "description": "An enumeration."
      },
      "CloudTypes": {
        "title": "CloudTypes",
        "enum": [
          "PUBLIC",
          "INTERNAL"
        ],
        "type": "string",
        "description": "An enumeration."
      },
      "CloudVersion": {
        "title": "CloudVersion",
        "enum": [
          "v1",
          "v2"
        ],
        "type": "string",
        "description": "An enumeration."
      },
      "CloudWaitlistStatus": {
        "title": "CloudWaitlistStatus",
        "enum": [
          "CLAIMED",
          "IN_WAITLIST",
          "BANNED",
          "NOT_IN_WAITLIST"
        ],
        "type": "string",
        "description": "An enumeration."
      },
      "CloudWithCloudResource": {
        "title": "CloudWithCloudResource",
        "required": [
          "name",
          "provider",
          "region",
          "credentials",
          "id",
          "type",
          "creator_id",
          "created_at",
          "is_default",
          "customer_aggregated_logs_config_id"
        ],
        "type": "object",
        "properties": {
          "name": {
            "title": "Name",
            "type": "string",
            "description": "Name of this Cloud."
          },
          "provider": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CloudProviders"
              }
            ],
            "description": "Provider of this Cloud (e.g. AWS)."
          },
          "compute_stack": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ComputeStack"
              }
            ],
            "description": "The compute stack associated with this cloud's primary cloud resource."
          },
          "region": {
            "title": "Region",
            "type": "string",
            "description": "Region this Cloud is operating in. This value needs to be supported by this Cloud's provider. (e.g. us-west-2)"
          },
          "credentials": {
            "title": "Credentials",
            "type": "string",
            "description": "Credentials needed to interact with this Cloud."
          },
          "config": {
            "title": "Config",
            "allOf": [
              {
                "$ref": "#/components/schemas/CloudConfig"
              }
            ],
            "description": "Additional configurable properties of this Cloud.",
            "default": {
              "max_stopped_instances": 0
            }
          },
          "is_k8s": {
            "title": "Is K8S",
            "type": "boolean",
            "description": "Whether this cloud is managed via Kubernetes.",
            "default": false
          },
          "is_aioa": {
            "title": "Is Aioa",
            "type": "boolean",
            "description": "Whether this cloud is an AIOA cloud.",
            "default": false
          },
          "availability_zones": {
            "title": "Availability Zones",
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The availability zones that instances of this cloud are allowed to be launched in."
          },
          "is_bring_your_own_resource": {
            "title": "Is Bring Your Own Resource",
            "type": "boolean",
            "description": "Whether the resources of this cloud are provided by the customer."
          },
          "is_private_cloud": {
            "title": "Is Private Cloud",
            "type": "boolean",
            "description": "Whether this cloud is a private cloud.",
            "default": false
          },
          "cluster_management_stack_version": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ClusterManagementStackVersions"
              }
            ],
            "description": "The cluster management stack version of the cloud.",
            "default": "v2"
          },
          "is_private_service_cloud": {
            "title": "Is Private Service Cloud",
            "type": "boolean",
            "description": "Whether services created in this cloud should be private."
          },
          "auto_add_user": {
            "title": "Auto Add User",
            "type": "boolean",
            "description": "Whether all users in the organization should be automatically added to this cloud. This field is only relevant for organizations with cloud isolation enabled, because all users in the organization automatically have access to all clouds if cloud isolation is not enabled.",
            "default": false
          },
          "lineage_tracking_enabled": {
            "title": "Lineage Tracking Enabled",
            "type": "boolean",
            "description": "Whether lineage tracking is enabled for this cloud.",
            "default": false
          },
          "external_id": {
            "title": "External Id",
            "type": "string",
            "description": "The trust policy external ID specified by the user for the cloud control plane role. It must start with the organization ID."
          },
          "id": {
            "title": "Id",
            "type": "string",
            "description": "Server assigned unique identifier."
          },
          "type": {
            "$ref": "#/components/schemas/CloudTypes"
          },
          "creator_id": {
            "title": "Creator Id",
            "type": "string",
            "description": "ID of the User who created this Cloud."
          },
          "created_at": {
            "title": "Created At",
            "type": "string",
            "description": "Time when this Cloud was created.",
            "format": "date-time"
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CloudStatus"
              }
            ],
            "description": "The status of this cloud.",
            "default": "ready"
          },
          "state": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CloudState"
              }
            ],
            "description": "The state of this cloud.",
            "default": "CREATING"
          },
          "version": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CloudVersion"
              }
            ],
            "description": "The version of the cloud.",
            "default": "v2"
          },
          "is_default": {
            "title": "Is Default",
            "type": "boolean",
            "description": "Whether this cloud is the default cloud."
          },
          "customer_aggregated_logs_config_id": {
            "title": "Customer Aggregated Logs Config Id",
            "type": "string",
            "description": "the id of the customer aggregated logs config associated with this cloud."
          },
          "is_aggregated_logs_enabled": {
            "title": "Is Aggregated Logs Enabled",
            "type": "boolean",
            "description": "Whether the aggregated logs are enabled for this cloud."
          },
          "system_cluster_config_id": {
            "title": "System Cluster Config Id",
            "type": "string",
            "description": "the id of the system cluster config associated with this cloud."
          },
          "cloud_resource": {
            "title": "Cloud Resource",
            "allOf": [
              {
                "$ref": "#/components/schemas/CloudResource"
              }
            ],
            "description": "The cloud resource of this cloud."
          }
        },
        "description": "Model used to create a Cloud."
      },
