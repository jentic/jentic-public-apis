            "description": "Declaration of node resources for Autoscaler."
          },
          "physical_resources": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PhysicalResources"
              }
            ],
            "description": "DEPRECATED: This field is deprecated. Please use required_resources instead."
          },
          "required_resources": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PhysicalResources"
              }
            ],
            "description": "Required resources for compute node type which specifies the actual CPU, memory, and GPU resources that should be allocated for this node type."
          },
          "labels": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Labels to associate the node with for scheduling purposes. Defaults to the list of Ray & Anyscale default labels."
          },
          "required_labels": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Required labels that must be present on the node for scheduling purposes."
          },
          "aws_advanced_configurations_json": {
            "type": "object",
            "description": "The advanced configuration json that we pass directly AWS APIs when launching an instance. We may do some validation on this json and reject the json if it is using a configuration that Anyscale does not support."
          },
          "gcp_advanced_configurations_json": {
            "type": "object",
            "description": "The advanced configuration json that we pass directly GCP APIs when launching an instance. We may do some validation on this json and reject the json if it is using a configuration that Anyscale does not support."
          },
          "advanced_configurations_json": {
            "type": "object",
            "description": "Advanced configurations for this compute node type to pass to the cloud provider when launching this instance."
          },
          "flags": {
            "type": "object",
            "description": "A set of advanced node-level flags that can be used to configure a particular workload."
          },
          "min_workers": {
            "type": "integer",
            "description": "The minimum number of nodes of this type that Anyscale should spin up."
          },
          "max_workers": {
            "type": "integer",
            "description": "The maximum number of nodes of this type that Anyscale should spin up."
          },
          "use_spot": {
            "type": "boolean",
            "description": "Whether or not to use spot instances for this node type.",
            "default": false
          },
          "fallback_to_ondemand": {
            "type": "boolean",
            "description": "If use_spot is True, then we will attempt to use spot instances. If this is true as well, then we will fall back to on demand instances if spot instances are not available. If use_spot is False, this value is ignored.",
            "default": false
          }
        },
        "additionalProperties": false
      },
