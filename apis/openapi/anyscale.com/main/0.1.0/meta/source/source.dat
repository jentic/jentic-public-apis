            "description": "The name of the file that will be uploaded (e.g. 'runtime_env_1234.zip'). NOTE: The file name may contain a subdir prefix (eg. my_name/subdir/runtime_env_1234)."
          },
          "access_mode": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CloudDataBucketAccessMode"
