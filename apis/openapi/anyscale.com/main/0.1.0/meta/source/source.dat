                {
                  "$ref": "#/components/schemas/LineageArtifactType"
                }
              ],
              "description": "Lineage artifact type."
            },
            "name": "artifact_type",
            "in": "query"
          },
          {
            "description": "Filter by cloud ID.",
            "required": false,
            "schema": {
              "title": "Cloud Id",
              "type": "string",
              "description": "Filter by cloud ID."
            },
            "name": "cloud_id",
            "in": "query"
          },
          {
            "description": "Filter by project ID.",
            "required": false,
            "schema": {
              "title": "Project Id",
              "type": "string",
              "description": "Filter by project ID."
            },
            "name": "project_id",
            "in": "query"
          },
          {
            "description": "Filter artifacts created by a given user ID.",
            "required": false,
            "schema": {
              "title": "Creator Id",
              "type": "string",
              "description": "Filter artifacts created by a given user ID."
            },
            "name": "creator_id",
            "in": "query"
          },
          {
            "description": "Filter artifacts with name or URI containing this value (case-insensitive).",
            "required": false,
            "schema": {
              "title": "Name Or Uri Contains",
              "type": "string",
              "description": "Filter artifacts with name or URI containing this value (case-insensitive)."
            },
            "name": "name_or_uri_contains",
            "in": "query"
          },
          {
            "description": "Filter by lineage direction: IN, OUT, or BIDIR.",
            "required": false,
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/LineageDirection"
                }
              ],
              "description": "Filter by lineage direction: IN, OUT, or BIDIR."
            },
            "name": "lineage_direction",
            "in": "query"
          },
          {
            "description": "Sort field. Defaults to created_at.",
            "required": false,
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/LineageArtifactSortField"
                }
              ],
              "description": "Sort field. Defaults to created_at.",
              "default": "created_at"
            },
            "name": "sort_field",
            "in": "query"
          },
          {
            "description": "Sort order. Defaults to descending.",
            "required": false,
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/SortOrder"
                }
              ],
              "description": "Sort order. Defaults to descending.",
              "default": "DESC"
            },
            "name": "sort_order",
            "in": "query"
          },
          {
            "description": "Pagination token",
            "required": false,
            "schema": {
              "title": "Paging Token",
              "type": "string",
              "description": "Pagination token"
            },
            "name": "paging_token",
            "in": "query"
          },
          {
            "description": "Page size",
            "required": false,
            "schema": {
              "title": "Count",
              "maximum": 50.0,
              "minimum": 0.0,
              "type": "integer",
              "description": "Page size"
            },
            "name": "count",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LineageartifactListResponse"
                }
              }
