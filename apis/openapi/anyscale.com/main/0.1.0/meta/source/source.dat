      "DecoratedSession": {
        "title": "DecoratedSession",
        "required": [
          "name",
          "project_id",
          "cloud_id",
          "cluster_config",
          "id",
          "state",
          "creator_id",
          "created_at",
          "access_token",
          "tensorboard_available",
          "cluster_config_last_modified_at",
          "ssh_authorized_keys",
          "ssh_private_key",
          "cloud",
          "creator"
        ],
        "type": "object",
        "properties": {
          "name": {
            "title": "Name",
            "type": "string",
            "description": "Name of the session to be created."
          },
          "project_id": {
            "title": "Project Id",
            "type": "string",
            "description": "Project that the session will be created in."
          },
          "cloud_id": {
            "title": "Cloud Id",
            "type": "string",
            "description": "Cloud that the session will use."
          },
          "cluster_config": {
            "title": "Cluster Config",
            "type": "string",
            "description": "Cluster config that the session can later be started with."
          },
          "build_id": {
            "title": "Build Id",
            "type": "string",
            "description": "ID of the Build that this session was started with."
          },
          "compute_template_id": {
            "title": "Compute Template Id",
            "type": "string",
            "description": "ID of the compute template that this session was started with."
          },
          "idle_timeout": {
            "title": "Idle Timeout",
            "type": "integer",
            "description": "Idle timeout (in minutes), after which the session is stopped. Idle time is defined as the time during which a session is not running a user command (through 'anyscale exec' or the Web UI), and does not have an attached driver. Time spent running Jupyter commands, or commands run through ssh, is still considered 'idle'.",
            "default": 120
          },
          "uses_app_config": {
            "title": "Uses App Config",
            "type": "boolean",
            "description": "Whether or not the session uses app config. If true, it means this is not a legacy session started with cluster yaml.",
            "default": false
          },
          "allow_public_internet_traffic": {
            "title": "Allow Public Internet Traffic",
            "type": "boolean",
            "description": "Whether public internet traffic can access Serve endpoints or if an authentication token is required.",
            "default": false
          },
          "user_service_access": {
            "allOf": [
              {
                "$ref": "#/components/schemas/UserServiceAccessTypes"
              }
            ],
            "description": "Whether user service can be accessed by public internet traffic.",
            "default": "public"
          },
          "user_service_token": {
            "title": "User Service Token",
            "type": "string",
            "description": "User service token that is used to authenticate access to public user services. This must be a valid 32 byte URL safe string and can be generated by calling `secrets.token_urlsafe(32))`. This is ignored if the user service has private access. If not specified for a public user service, a token is autogenerated."
          },
          "ha_job_id": {
            "title": "Ha Job Id",
            "type": "string",
            "description": "This is used internally by Anyscale to associate clusters to a job. It is set automatically and should *not* be used directly."
          },
          "id": {
            "title": "Id",
            "type": "string",
            "description": "Server assigned unique identifier."
          },
          "state": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SessionState"
              }
            ],
            "description": "[DEPRECATED] Current state of the Session. Please use `cluster_status`."
          },
          "pending_state": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SessionState"
              }
            ],
            "description": "Pending state of the Session if a state transition has been requested."
          },
          "state_data": {
            "title": "State Data",
            "allOf": [
              {
                "$ref": "#/components/schemas/SessionStateData"
              }
            ],
            "description": "Additional information about the current state"
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ClusterStatus"
              }
            ],
            "description": "Current state of the Cluster."
          },
          "status_details": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ClusterStatusDetails"
              }
            ],
            "description": "Current state details of the Cluster. This is a more granular status than `status`. It should be used to get more details regarding the `status`."
          },
          "creator_id": {
            "title": "Creator Id",
            "type": "string",
            "description": "Identifier of user who created the Session."
          },
          "created_at": {
            "title": "Created At",
            "type": "string",
            "description": "Time at which session was created.",
            "format": "date-time"
          },
          "archived_at": {
            "title": "Archived At",
            "type": "string",
            "description": "The time in which this cluster is archived.",
            "format": "date-time"
          },
          "webterminal_auth_url": {
            "title": "Webterminal Auth Url",
            "type": "string",
            "description": "URL to authenticate with the webterminalThis field will only be populated after the Session finishes starting."
          },
          "metrics_dashboard_url": {
            "title": "Metrics Dashboard Url",
            "type": "string",
            "description": "URL for Grafana (metrics) dashboard for this Session in the running cluster state. This field will only be populated after the Session finishes starting."
          },
          "data_metrics_dashboard_url": {
            "title": "Data Metrics Dashboard Url",
            "type": "string",
            "description": "URL for Data Grafana dashboard for this Session. This field will only be populated after the Session finishes starting."
          },
          "train_metrics_dashboard_url": {
            "title": "Train Metrics Dashboard Url",
            "type": "string",
            "description": "URL for Train Grafana dashboard for this Session. This field will only be populated after the Session finishes starting."
          },
          "serve_metrics_dashboard_url": {
            "title": "Serve Metrics Dashboard Url",
            "type": "string",
            "description": "URL for Serve Grafana dashboard for this Session. This field will only be populated after the Session finishes starting."
          },
          "serve_deployment_metrics_dashboard_url": {
            "title": "Serve Deployment Metrics Dashboard Url",
            "type": "string",
            "description": "URL for Serve deployment Grafana dashboard for this Session. This field will only be populated after the Session finishes starting."
          },
          "serve_llm_metrics_dashboard_url": {
            "title": "Serve Llm Metrics Dashboard Url",
            "type": "string",
            "description": "URL for Serve LLM Grafana dashboard for this Session. This field will only be populated after the Session finishes starting."
          },
          "supports_full_grafana_view": {
            "title": "Supports Full Grafana View",
            "type": "boolean",
            "description": "Whether the session supports full Grafana embedding view. This field will only be populated after the Session finishes starting.",
            "default": false
          },
          "persistent_metrics_url": {
            "title": "Persistent Metrics Url",
            "type": "string",
            "description": "URL for persistent Grafana (metrics) dashboard for this Session in the non-running cluster state. This field will only be populated after the Session finishes starting."
          },
          "connect_url": {
            "title": "Connect Url",
            "type": "string",
            "description": "URL for Anyscale connect for this Session. This field will only be populated after the Session finishes starting."
          },
          "jupyter_notebook_url": {
            "title": "Jupyter Notebook Url",
            "type": "string",
            "description": "URL for Jupyter Lab for this Session. This field will only be populated after the Session finishes starting."
          },
          "ray_dashboard_url": {
            "title": "Ray Dashboard Url",
            "type": "string",
            "description": "URL for Ray dashboard for this Session. This field will only be populated after the Session finishes starting."
          },
          "access_token": {
            "title": "Access Token",
            "type": "string",
            "description": "[DEPRECATED] Call GET /api/v2/authentication/{cluster_id}/cluster_access_token to get this."
          },
          "service_proxy_url": {
            "title": "Service Proxy Url",
            "type": "string",
            "description": "Link to the web services proxy (e.g. jupyter, tensorboard, etc). This field will be populated when the web based services are available after the Session finishes starting."
          },
          "tensorboard_available": {
            "title": "Tensorboard Available",
            "type": "boolean",
            "description": "Represents whether Tensorboard is available."
          },
          "cluster_config_last_modified_at": {
            "title": "Cluster Config Last Modified At",
            "type": "string",
            "description": "Time when the cluster config for the Session was last modified.",
            "format": "date-time"
          },
          "host_name": {
            "title": "Host Name",
            "type": "string",
            "description": "URL for the head node of the cluster. This field will be populated after the cluster finishes starting."
          },
          "head_node_ip": {
            "title": "Head Node Ip",
            "type": "string",
            "description": "Head IP of the Session. This field will be populated after the cluster finishes starting."
          },
          "ssh_authorized_keys": {
            "title": "Ssh Authorized Keys",
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Serialized SSH Public Keys to be placed in the machine's authorized_keys."
          },
          "ssh_private_key": {
            "title": "Ssh Private Key",
            "type": "string",
            "description": "SSH Private key that can be used to access the session's servers."
          },
          "anyscaled_config": {
            "title": "Anyscaled Config",
            "type": "string",
            "description": "Serialized AnyscaleD config that is general to head and worker nodes."
          },
          "anyscaled_config_generated_at": {
            "title": "Anyscaled Config Generated At",
            "type": "string",
            "description": "Time when AnyscaleD config was generated at.",
            "format": "date-time"
          },
          "default_build_id": {
            "title": "Default Build Id",
            "type": "string",
            "description": "Default build id used for the session. Only not null when using default builds."
          },
          "idle_timeout_last_activity_at": {
            "title": "Idle Timeout Last Activity At",
            "type": "string",
            "description": "The time when this session started idling. If idle_timeout is enabled and this value is None, then this session is still active.",
            "format": "date-time"
          },
          "ray_version": {
            "title": "Ray Version",
            "type": "string",
            "description": "The last known ray version running on this cluster."
          },
          "ray_version_last_updated_at": {
            "title": "Ray Version Last Updated At",
            "type": "string",
            "description": "The time in which the ray version of this was updated.",
            "format": "date-time"
          },
          "user_service_url": {
            "title": "User Service Url",
            "type": "string",
            "description": "URL to access user services (e.g. Ray Serve)"
          },
          "ray_component_activities_last_reported_at": {
            "title": "Ray Component Activities Last Reported At",
            "type": "string",
            "description": "When we last saw an observation from Ray Dashboard. This is populated even if we see an observation of no activity.",
            "format": "date-time"
          },
          "activity_details": {
            "title": "Activity Details",
            "type": "object",
            "description": "Details of latest positive activity report for all relavant components. Format is mapping of activity type to activity details (includes timestamp and other activity specific fields)."
          },
          "maximum_uptime_will_terminate_cluster_at": {
            "title": "Maximum Uptime Will Terminate Cluster At",
            "type": "string",
            "description": "The time the cluster will be terminated due to its maximum uptime. If None, the cluster will not be terminated for this reason.",
            "format": "date-time"
          },
          "idle_termination_status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/IdleTerminationStatus"
              }
            ],
            "description": "The status of autosuspend"
          },
          "ray_dashboard_snapshot_last_reported_at": {
            "title": "Ray Dashboard Snapshot Last Reported At",
            "type": "string",
            "description": "The time of the last snapshot recorded from the ray dashboard",
            "format": "date-time"
          },
          "is_system_cluster": {
            "title": "Is System Cluster",
            "type": "boolean",
            "description": "Represents clusters that are used for system workloads but not visible to the user",
            "default": false
          },
          "build": {
            "title": "Build",
            "allOf": [
              {
                "$ref": "#/components/schemas/MiniBuild"
              }
            ],
            "description": "The decorated build_id"
          },
          "cloud": {
            "title": "Cloud",
            "allOf": [
              {
                "$ref": "#/components/schemas/MiniCloud"
              }
            ],
            "description": "The decorated cloud_id"
          },
          "creator": {
            "title": "Creator",
            "allOf": [
              {
                "$ref": "#/components/schemas/MiniUser"
              }
            ],
            "description": "The decorated creator_id"
          },
          "compute_template": {
            "title": "Compute Template",
            "allOf": [
              {
                "$ref": "#/components/schemas/MiniComputeTemplate"
              }
            ],
            "description": "The decorated compute_template_id"
          },
          "idle_time_remaining_seconds": {
            "title": "Idle Time Remaining Seconds",
            "type": "integer",
            "description": "The idle-time remaining in seconds before the session is auto-suspended."
          },
          "access": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SessionAccess"
              }
            ],
            "description": "The varieity of users with access to this session."
          },
          "project": {
            "title": "Project",
            "allOf": [
              {
                "$ref": "#/components/schemas/MiniProject"
              }
            ],
            "description": "The cluster's project"
          },
          "latest_started_at": {
            "title": "Latest Started At",
            "type": "string",
            "description": "The datetime of the latest transition to StartingUp state.",
            "format": "date-time"
          }
        },
        "description": "Model used to read a Session."
      },
