            "required": false,
            "schema": {
              "title": "Cloud Id",
              "type": "string",
              "description": "cloud_id to filter by"
            },
            "name": "cloud_id",
            "in": "query"
          },
          {
            "description": "name to filter by",
            "required": false,
            "schema": {
              "title": "Name",
              "type": "string",
              "description": "name to filter by"
            },
            "name": "name",
            "in": "query"
          },
          {
            "description": "filter by creator id",
            "required": false,
            "schema": {
              "title": "Creator Id",
              "type": "string",
              "description": "filter by creator id"
            },
            "name": "creator_id",
            "in": "query"
          },
          {
            "description": "Field to sort by. If absent, defaults to CREATED_AT descending.",
            "required": false,
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/ScheduleSortField"
                }
              ],
              "description": "Field to sort by. If absent, defaults to CREATED_AT descending."
            },
            "name": "sort_field",
            "in": "query"
          },
          {
            "description": "If sort_field is absent, this field is ignored. If absent, this field defaults to ascending.",
            "required": false,
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/SortOrder"
                }
              ],
              "description": "If sort_field is absent, this field is ignored. If absent, this field defaults to ascending.",
              "default": "ASC"
            },
            "name": "sort_order",
            "in": "query"
          },
          {
            "required": false,
            "schema": {
              "title": "Paging Token",
              "type": "string"
            },
            "name": "paging_token",
            "in": "query"
          },
          {
            "required": false,
            "schema": {
              "title": "Count",
              "maximum": 50.0,
              "minimum": 0.0,
              "type": "integer",
              "default": 10
            },
            "name": "count",
            "in": "query"
          }
        ],
