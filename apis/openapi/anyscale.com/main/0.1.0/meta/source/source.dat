          },
          "total_granted_usd": {
            "type": "number",
            "description": "Total amount of USD granted to the credit."
          },
          "ledger": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CommitLedgerRecordV2"
            },
            "description": "List of ledger records for this credit."
          },
          "grants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreditGrantRecordV2"
            },
            "description": "List of grant records for this credit."
          },
          "credit_type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CreditType"
              }
            ],
            "default": "COMMIT"
          }
        },
        "additionalProperties": false
      },
      "CreditRecordCreditV2": {
        "title": "CreditRecordCreditV2",
        "required": [
          "credit_name",
          "contract_name",
          "effective_date_start",
          "effective_date_end",
          "total_balance_usd",
          "last_month_usage_usd",
          "amount_consumed_usd",
          "total_granted_usd",
          "ledger",
          "grants"
        ],
        "type": "object",
        "properties": {
          "credit_name": {
            "type": "string",
            "description": "Name of the credit."
          },
          "contract_name": {
            "type": "string",
            "description": "Name of the contract the credit is attached to."
          },
          "effective_date_start": {
            "type": "string",
            "description": "UTC date the credit can first be used (inclusive).",
            "format": "date"
          },
          "effective_date_end": {
            "type": "string",
            "description": "UTC date the credit can last be used (inclusive).",
            "format": "date"
          },
          "total_balance_usd": {
            "type": "number",
            "description": "Total balance of the credit in USD."
          },
          "last_month_usage_usd": {
            "type": "number",
            "description": "Amount of USD consumed from the credit in the last month."
          },
          "amount_consumed_usd": {
            "type": "number",
            "description": "Amount of USD consumed from the credit."
          },
          "total_granted_usd": {
            "type": "number",
            "description": "Total amount of USD granted to the credit."
          },
          "ledger": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreditLedgerRecordV2"
            },
            "description": "List of ledger records for this credit."
          },
          "grants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreditGrantRecordV2"
            },
            "description": "List of grant records for this credit."
          },
          "credit_type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CreditType"
              }
            ],
            "default": "CREDIT"
          }
        },
        "additionalProperties": false
      },
      "CreditType": {
        "title": "CreditType",
        "enum": [
          "CREDIT",
          "COMMIT"
        ],
        "type": "string",
        "description": "Lists possible credit types."
      },
      "CreditsV2": {
        "title": "CreditsV2",
        "required": [
          "in_use_credits",
          "pending_credits",
          "expired_credits",
          "in_use_commits",
          "pending_commits",
          "expired_commits",
          "current_balance_usd",
          "amount_spent_usd",
          "total_granted_usd"
        ],
        "type": "object",
        "properties": {
          "in_use_credits": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreditRecordCreditV2"
            },
            "description": "List of in-use credits."
          },
          "pending_credits": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreditRecordCreditV2"
            },
            "description": "List of pending credits."
          },
          "expired_credits": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreditRecordCreditV2"
            },
            "description": "List of expired credits."
          },
          "in_use_commits": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreditRecordCommitV2"
            },
            "description": "List of in-use commits."
          },
          "pending_commits": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreditRecordCommitV2"
            },
            "description": "List of pending commits."
          },
          "expired_commits": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreditRecordCommitV2"
            },
            "description": "List of expired commits."
          },
          "current_balance_usd": {
            "type": "number",
            "description": "Summary of current balance of all credits and commits."
          },
          "amount_spent_usd": {
            "type": "number",
            "description": "Summary of total amount spent across all credits and commits."
          },
          "total_granted_usd": {
            "type": "number",
            "description": "Summary of total granted across all credits and commits."
          }
        },
        "additionalProperties": false,
        "description": "In-use credits are currently usable, pending credits will be usable in the future,\nand expired credits are no longer usable."
      },
      "CustomerAlertStatus": {
        "title": "CustomerAlertStatus",
        "enum": [
          "ok",
          "in_alarm",
          "evaluating"
        ],
        "type": "string",
        "description": "Lists allowed options for Metronome customer alert status.\n\nNote this model is used on both the read (ReadMetronomeAlert) and write path\nfor the database. If changes to this model are non-backwards\ncompatible, we'll need to split this model into a separate read\nand write model.\n\nDoc: https://docs.metronome.com/api/#operation/getCustomerAlert"
      },
