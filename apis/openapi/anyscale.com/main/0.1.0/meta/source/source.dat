            "title": "Http Route",
            "type": "string",
            "description": "HTTP route of this deployment"
          },
          "grafana_dashboard_url": {
            "title": "Grafana Dashboard Url",
            "type": "string",
            "description": "URL of the grafana dashboard for this deployment. If absent, the dashboard has not been created"
          },
          "class_name": {
