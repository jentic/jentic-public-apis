          },
          "current_state": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ServiceEventCurrentState"
              }
            ],
            "description": "Present only for Service events."
          },
          "goal_state": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ServiceGoalStates"
              }
            ],
            "description": "Present only for Service events."
          },
          "level": {
            "$ref": "#/components/schemas/EventLevel"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
