    "/api/v2/workspace_templates/": {
      "get": {
        "summary": "List Templates",
        "description": "List user's workspace templates with pagination, filtering, and search",
        "operationId": "list_templates_api_v2_workspace_templates__get",
        "parameters": [
          {
            "description": "Filter by template name (partial match)",
            "required": false,
            "schema": {
              "title": "Name",
              "type": "string",
              "description": "Filter by template name (partial match)"
            },
            "name": "name",
            "in": "query"
          },
          {
            "description": "Filter by template name, description, or labels (partial match)",
            "required": false,
            "schema": {
              "title": "Text Contains",
              "type": "string",
              "description": "Filter by template name, description, or labels (partial match)"
            },
            "name": "text_contains",
            "in": "query"
          },
          {
            "description": "Filter by complexity level",
            "required": false,
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/WorkspaceTemplateComplexity"
                }
              ],
              "description": "Filter by complexity level"
            },
            "name": "complexity",
            "in": "query"
          },
          {
            "description": "Filter by category",
            "required": false,
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/WorkspaceTemplateCategory"
                }
              ],
              "description": "Filter by category"
            },
            "name": "category",
            "in": "query"
          },
          {
            "description": "Comma-separated list of labels to filter by",
            "required": false,
            "schema": {
              "title": "Labels",
              "type": "string",
              "description": "Comma-separated list of labels to filter by"
            },
            "name": "labels",
            "in": "query"
          },
          {
            "description": "Filter by cloud ID",
            "required": false,
            "schema": {
              "title": "Cloud Id",
              "type": "string",
              "description": "Filter by cloud ID"
            },
            "name": "cloud_id",
            "in": "query"
          },
          {
            "description": "Filter by global templates",
            "required": false,
            "schema": {
              "title": "Is Global",
              "type": "boolean",
              "description": "Filter by global templates"
            },
            "name": "is_global",
            "in": "query"
          },
          {
            "description": "Filter by creator user ID",
            "required": false,
            "schema": {
              "title": "Creator Id",
              "type": "string",
              "description": "Filter by creator user ID"
            },
            "name": "creator_id",
            "in": "query"
          },
          {
            "description": "Filter by published templates",
            "required": false,
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/PublishedFilter"
                }
              ],
              "description": "Filter by published templates"
            },
            "name": "published",
            "in": "query"
          },
          {
            "required": false,
            "schema": {
              "title": "Paging Token",
              "type": "string"
            },
            "name": "paging_token",
            "in": "query"
          },
          {
            "required": false,
            "schema": {
              "title": "Count",
              "maximum": 1000.0,
              "minimum": 0.0,
              "type": "integer",
              "default": 20
            },
            "name": "count",
            "in": "query"
          },
          {
            "description": "If absent, the sort order will be determined according to the type_filter.",
            "required": false,
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/WorkspaceTemplatesSortField"
                }
              ],
              "description": "If absent, the sort order will be determined according to the type_filter."
            },
            "name": "sort_field",
            "in": "query"
          },
          {
            "description": "If sort_field is absent, this field is ignored.If absent, this field defaults to ascending.",
            "required": false,
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/SortOrder"
                }
              ],
              "description": "If sort_field is absent, this field is ignored.If absent, this field defaults to ascending.",
              "default": "ASC"
            },
            "name": "sort_order",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspacetemplateListResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
