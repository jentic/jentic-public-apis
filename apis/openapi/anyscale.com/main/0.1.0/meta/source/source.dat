            "default": false
          },
          "customer_aggregated_logs_enabled": {
            "type": "boolean",
            "description": "Whether this cloud has customer aggregated logs enabled.",
            "default": false
          }
        },
        "additionalProperties": false,
        "description": "The greatest common factor for cloud data across most endpoints of the API server"
