      "delete": {
        "summary": "Delete Lineage Artifact",
        "description": "Delete an Anyscale tracked artifact (soft delete).\n\nRequires write permission on at least one project linked to this artifact.\nThe artifact's relationships to workloads (artifact_runs) will be soft-deleted.\nThe artifact record itself is preserved but becomes invisible when all its\nrelationships are deleted. If the same artifact URI is used in a future\nlineage event, new relationships will be created.",
        "operationId": "delete_lineage_artifact_api_v2_lineage_artifacts__artifact_id__delete",
        "parameters": [
          {
            "required": true,
            "schema": {
              "title": "Artifact Id",
              "type": "string"
            },
            "name": "artifact_id",
            "in": "path"
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
