            "title": "Cloud Id",
            "type": "string",
            "description": "The cloud id to which the job queue belongs to."
          },
          "compute_config_id": {
            "title": "Compute Config Id",
            "type": "string",
            "description": "The id of the compute configuration that will be used to create cluster associated with the queue."
          },
          "cluster_environment_build_id": {
            "title": "Cluster Environment Build Id",
            "type": "string",
            "description": "The id of the cluster environment build that will be used to create cluster associated with the queue."
          },
          "max_concurrency": {
            "title": "Max Concurrency",
            "type": "integer",
            "description": "Max number of jobs to be run concurrently. Defaults to 1, ie running no more than 1 job at a time.",
            "default": 1
          },
          "idle_timeout_sec": {
            "title": "Idle Timeout Sec",
            "type": "integer",
            "description": "Max period of time queue will be accepting new jobs, before being sealed off and its associated cluster being shutdown"
          },
          "execution_mode": {
            "allOf": [
              {
                "$ref": "#/components/schemas/JobQueueExecutionMode"
              }
            ],
            "description": "Execution mode of the jobs submitted into the queue (one of: FIFO,LIFO,PRIORITY",
            "default": "FIFO"
          },
          "state": {
            "allOf": [
              {
                "$ref": "#/components/schemas/JobQueueState"
              }
            ],
            "description": "The current state of this job queue"
          }
        },
        "description": "Model of a Job Queue for use in the SDK."
      },
      "JobQueueConfig": {
        "title": "JobQueueConfig",
        "type": "object",
        "properties": {
          "priority": {
            "title": "Priority",
            "type": "integer",
            "description": "Job's relative priority (only relevant for Job Queues of type PRIORITY). Valid values range from 0 (highest) to +inf (lowest). Default value is None"
          }
        },
        "description": "Captures job's configuration in the context of its scheduling & execution via Job Queues"
      },
