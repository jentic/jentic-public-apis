    "/api/v2/user_groups/": {
      "get": {
        "summary": "List User Groups",
        "description": "List all user groups in the user's organization.\n\nThis endpoint returns all user groups that belong to the authenticated user's organization.\nUser groups are used for managing permissions on resources.\n\nQuery Parameters:\n- **count**: Number of results per page (required)\n- **paging_token**: Token for pagination (optional)\n\nReturns:\n- List of user groups with id and name\n- Pagination metadata\n\nPermission requirements:\n- Caller must be an organization admin",
        "operationId": "list_user_groups_api_v2_user_groups__get",
        "parameters": [
          {
            "required": false,
            "schema": {
              "title": "Paging Token",
              "type": "string"
            },
            "name": "paging_token",
            "in": "query"
          },
          {
            "required": false,
            "schema": {
              "title": "Count",
              "maximum": 50.0,
              "minimum": 0.0,
              "type": "integer",
              "default": 10
            },
            "name": "count",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsergroupListResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/user_groups/memberships/list": {
      "get": {
