        "title": "RunAttemptStatus",
        "enum": [
          "PENDING",
          "RUNNING",
          "FINISHED",
          "ERRORED",
          "ABORTED"
        ],
        "type": "string",
        "description": "An enumeration."
      },
      "RunStatus": {
        "title": "RunStatus",
        "enum": [
          "INITIALIZING",
          "SCHEDULING",
          "RUNNING",
          "RESTARTING",
          "RESIZING",
          "FINISHED",
          "ERRORED",
          "ABORTED"
        ],
        "type": "string",
        "description": "An enumeration."
      },
      "S3DownloadLocation": {
        "title": "S3DownloadLocation",
        "required": [
          "fields",
          "url"
        ],
        "type": "object",
        "properties": {
          "fields": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "url": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "SCIMMigrationResult": {
        "title": "SCIMMigrationResult",
        "required": [
          "organization_id",
          "total_users_processed",
          "users_migrated",
          "errors"
        ],
        "type": "object",
        "properties": {
          "organization_id": {
            "title": "Organization Id",
            "type": "string"
          },
          "total_users_processed": {
            "title": "Total Users Processed",
            "type": "integer"
          },
          "users_migrated": {
            "title": "Users Migrated",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserMigrationResult"
            }
          },
          "errors": {
            "title": "Errors",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "users_to_remove": {
            "title": "Users To Remove",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserToRemove"
            }
          },
          "dry_run": {
            "title": "Dry Run",
            "type": "boolean",
            "default": true
          }
        },
        "description": "Result of the SCIM permission migration for an organization."
      },
      "SSOConfig": {
        "title": "SSOConfig",
        "required": [
          "sso_connection",
          "directory_sync",
          "domain_verifications"
        ],
        "type": "object",
        "properties": {
          "sso_connection": {
            "$ref": "#/components/schemas/SSOConnection"
          },
          "directory_sync": {
            "$ref": "#/components/schemas/DirectorySync"
          },
          "domain_verifications": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DomainVerification"
            }
          }
        },
        "additionalProperties": false
      },
      "SSOConnection": {
        "title": "SSOConnection",
        "required": [
          "url",
          "state"
        ],
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/SSOConnectionState"
          }
        },
        "additionalProperties": false
      },
      "SSOConnectionState": {
        "title": "SSOConnectionState",
        "enum": [
          "active",
          "inactive"
        ],
        "type": "string",
        "description": "Enum for SSO connection states."
      },
      "SSOLoginInfo": {
        "title": "SSOLoginInfo",
        "required": [
          "sso_required"
        ],
        "type": "object",
        "properties": {
          "saml_idp_url": {
            "title": "Saml Idp Url",
            "type": "string",
            "description": "The url to the SAML IdP"
          },
          "sso_required": {
            "title": "Sso Required",
            "type": "boolean",
            "description": "Is SSO required for login?"
          }
        },
        "description": "Information regarding how to initiate SSO for the frontend.\n\nContains the url to the SAML IdP. It is the frontend's\nresponsibility to redirect the user there."
      },
      "SSOMode": {
        "title": "SSOMode",
        "enum": [
          "off",
          "optional",
          "required"
        ],
        "type": "string",
        "description": "An enumeration."
      },
