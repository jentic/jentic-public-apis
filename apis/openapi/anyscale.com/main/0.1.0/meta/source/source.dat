      "DecoratedProductionServiceV2APIModel": {
        "title": "DecoratedProductionServiceV2APIModel",
        "required": [
          "id",
          "name",
          "project_id",
          "cloud_id",
          "creator_id",
          "created_at",
          "hostname",
          "current_state",
          "goal_state",
