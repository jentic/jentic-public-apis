          {
            "description": "If True, we always return default cluster envs before user created cluster envs. If False, we always return default cluster envs after user created cluster envs. If absent, default to True. Note that we never intersperse default cluster envs with user created cluster envs.",
            "required": false,
            "schema": {
              "title": "Defaults First",
              "type": "boolean",
              "description": "If True, we always return default cluster envs before user created cluster envs. If False, we always return default cluster envs after user created cluster envs. If absent, default to True. Note that we never intersperse default cluster envs with user created cluster envs.",
              "default": true
            },
            "name": "defaults_first",
            "in": "query"
          },
          {
            "required": false,
            "schema": {
