            "schema": {
              "title": "Start Time",
              "type": "string",
              "description": "The start time for the query. If  start_time is not set, the query will use beginning of time. Non-inclusive.",
              "format": "date-time"
            },
            "name": "start_time",
            "in": "query"
          },
          {
            "description": "The end time for the query. If end_time is not set, the query will use the time now. Non-inclusive.",
            "required": false,
            "schema": {
              "title": "End Time",
              "type": "string",
              "description": "The end time for the query. If end_time is not set, the query will use the time now. Non-inclusive.",
              "format": "date-time"
            },
            "name": "end_time",
            "in": "query"
          },
          {
            "description": "Fetch events in ascending order of time. Default is descending order.",
            "required": false,
            "schema": {
              "title": "Ascending Order",
              "type": "boolean",
              "description": "Fetch events in ascending order of time. Default is descending order.",
              "default": false
            },
            "name": "ascending_order",
            "in": "query"
          },
          {
            "required": false,
            "schema": {
              "title": "Paging Token",
              "type": "string"
            },
            "name": "paging_token",
            "in": "query"
          },
          {
