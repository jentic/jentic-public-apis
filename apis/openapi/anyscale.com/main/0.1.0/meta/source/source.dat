            "allOf": [
              {
                "$ref": "#/components/schemas/MiniJobRun"
              }
            ],
            "description": "The last job run that a production job ran with metadata"
          },
          "schedule": {
            "title": "Schedule",
            "allOf": [
              {
                "$ref": "#/components/schemas/MiniSchedule"
              }
