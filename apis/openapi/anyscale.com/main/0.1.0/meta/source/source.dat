      "CreateClusterComputeConfig": {
        "title": "CreateClusterComputeConfig",
        "required": [
          "cloud_id",
          "head_node_type"
        ],
        "type": "object",
        "properties": {
          "cloud_id": {
            "type": "string",
            "description": "The ID of the Anyscale cloud to use for launching Clusters."
          },
          "maximum_uptime_minutes": {
            "type": "integer",
            "description": "If set to a positive number, Anyscale will terminate the cluster this many minutes after cluster start."
          },
          "deployment_configs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CloudDeploymentComputeConfig"
            },
            "description": "A list of cloud deployment-specific configs to use."
          },
          "max_workers": {
            "type": "integer",
            "description": "DEPRECATED. This attribute will be ignored - please use the \"max_resources\" flag to configure resource limits."
          },
          "region": {
            "type": "string",
            "description": "Deprecated! When creating a cluster compute, a region does not have to be provided. Instead we will use the value from the cloud.",
            "default": "USE_CLOUD"
          },
          "allowed_azs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The availability zones that sessions are allowed to be launched in, e.g. \"us-west-2a\". If not specified or \"any\" is provided as the option, any AZ may be used.\nIf \"any\" is provided, it must be the only item in the list."
          },
          "head_node_type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ComputeNodeType"
              }
            ],
            "description": "Node configuration to use for the head node. "
          },
          "worker_node_types": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkerNodeType"
            },
            "description": "A list of node types to use for worker nodes. "
          },
          "aws_advanced_configurations_json": {
            "type": "object",
            "description": "[DEPRECATED: use advanced_configurations_json instead] The advanced configuration json that we pass directly AWS APIs when launching an instance. We may do some validation on this json and reject the json if it is using a configuration that Anyscale does not support."
          },
          "gcp_advanced_configurations_json": {
            "type": "object",
            "description": "[DEPRECATED: use advanced_configurations_json instead] The advanced configuration json that we pass directly GCP APIs when launching an instance. We may do some validation on this json and reject the json if it is using a configuration that Anyscale does not support."
          },
          "advanced_configurations_json": {
            "type": "object",
            "description": "Advanced configurations for this compute node type to pass to the cloud provider when launching this instance."
          },
          "auto_select_worker_config": {
            "type": "boolean",
            "description": "If set to true, worker node groups will automatically be selected based on workload.",
            "default": false
          },
          "flags": {
            "type": "object",
            "description": "A set of advanced cluster-level flags that can be used to configure a particular workload."
          },
          "idle_termination_minutes": {
            "minimum": 0.0,
            "type": "integer",
            "description": "If set to a positive number, Anyscale will terminate the cluster this many minutes after the cluster is idle. Idle time is defined as the time during which a Cluster is not running a user command or a Ray driver. Time spent running commands on Jupyter or ssh is still considered 'idle'. To disable, set this field to 0.",
            "default": 120
          }
        },
        "additionalProperties": false,
        "description": "Configuration of compute resources to use for launching a Cluster. Used when creating a cluster compute."
      },
      "CreateComputeTemplate": {
        "title": "CreateComputeTemplate",
        "required": [
          "config"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "project_id": {
            "type": "string"
          },
          "config": {
            "$ref": "#/components/schemas/CreateComputeTemplateConfig"
          },
          "anonymous": {
            "type": "boolean",
            "description": "An anonymous cluster compute does not show up in the list of cluster configs. They can still have a name so they can be easily identified.",
            "default": false
          },
          "new_version": {
            "type": "boolean",
            "description": "If a Compute Template with the same name already exists, create this config as a new version.",
            "default": false
          }
        },
        "additionalProperties": false,
        "description": "DEPRECATED: Please use CreateClusterCompute instead."
      },
      "CreateComputeTemplateConfig": {
        "title": "CreateComputeTemplateConfig",
        "required": [
          "cloud_id",
          "head_node_type"
        ],
        "type": "object",
        "properties": {
          "cloud_id": {
            "type": "string",
            "description": "The ID of the Anyscale cloud to use for launching sessions."
          },
          "maximum_uptime_minutes": {
            "type": "integer",
            "description": "If set to a positive number, Anyscale will terminate the cluster this many minutes after cluster start."
          },
          "deployment_configs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CloudDeploymentComputeConfig"
            },
            "description": "A list of cloud deployment-specific configs to use."
          },
          "max_workers": {
            "type": "integer",
            "description": "DEPRECATED. This attribute will be ignored - please use the \"max_resources\" flag to configure resource limits."
          },
          "region": {
            "type": "string",
            "description": "The region to launch sessions in, e.g. \"us-west-2\"."
          },
          "allowed_azs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The availability zones that sessions are allowed to be launched in, e.g. \"us-west-2a\". If not specified or \"any\" is provided as the option, any AZ may be used. If \"any\" is provided, it must be the only item in the list."
          },
          "head_node_type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ComputeNodeType"
              }
            ],
            "description": "Node configuration to use for the head node. "
          },
          "worker_node_types": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkerNodeType"
            },
            "description": "A list of node types to use for worker nodes. "
          },
          "aws_advanced_configurations_json": {
            "type": "object",
            "description": "The advanced configuration json that we pass directly AWS APIs when launching an instance. We may do some validation on this json and reject the json if it is using a configuration that Anyscale does not support."
          },
          "gcp_advanced_configurations_json": {
            "type": "object",
            "description": "The advanced configuration json that we pass directly GCP APIs when launching an instance. We may do some validation on this json and reject the json if it is using a configuration that Anyscale does not support."
          },
          "advanced_configurations_json": {
            "type": "object",
            "description": "Advanced configurations for this compute node type to pass to the cloud provider when launching this instance."
          },
          "auto_select_worker_config": {
            "type": "boolean",
            "description": "If set to true, worker node groups will automatically be selected based on workload.",
            "default": false
          },
          "flags": {
            "type": "object",
            "description": "A set of advanced cluster-level flags that can be used to configure a particular workload."
          },
          "idle_termination_minutes": {
            "minimum": 0.0,
            "type": "integer",
            "description": "If set to a positive number, Anyscale will terminate the cluster this many minutes after the cluster is idle. Idle time is defined as the time during which a Cluster is not running a user command or a Ray driver. Time spent running commands on Jupyter or ssh is still considered 'idle'. To disable, set this field to 0.",
            "default": 120
          }
        },
        "additionalProperties": false,
        "description": "DEPRECATED: Please use CreateClusterCompute and the corresponding ClusterComputeConfig instead.\nConfiguration of compute resources to use for launching a session. Used when creating a compute template."
      },
      "CreateDataset": {
        "title": "CreateDataset",
        "required": [
          "filename",
          "name"
        ],
        "type": "object",
        "properties": {
          "filename": {
            "title": "Filename",
            "type": "string"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "project_id": {
            "title": "Project Id",
            "type": "string"
          }
        },
        "description": "Fields specified when creating either a new:\n1. Dataset\n2. Dataset version"
      },
      "CreateEmptyCloud": {
        "title": "CreateEmptyCloud",
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of this Cloud."
          }
        },
        "additionalProperties": false,
        "description": "Model used to create an empty Cloud shell (no resources configured yet).\nThe cloud can be configured with credentials and resources later.\nProvider and region will be determined when resources are added."
      },
      "CreateExperimentalWorkspace": {
        "title": "CreateExperimentalWorkspace",
        "required": [
          "name",
          "project_id",
          "cloud_id",
          "compute_config_id",
          "cluster_environment_build_id"
        ],
        "type": "object",
        "properties": {
          "name": {
            "title": "Name",
            "type": "string",
            "description": "Name of the workspace to be created."
          },
          "description": {
            "title": "Description",
            "type": "string",
            "description": "Description of Workspace."
          },
          "project_id": {
            "title": "Project Id",
            "type": "string",
            "description": "Id of the project that this workspace belongs to."
          },
          "cloud_id": {
            "title": "Cloud Id",
            "type": "string",
            "description": "The cloud id for the workspace. DEPRECATED: We figure out the cloud_id from the compute_config."
          },
          "compute_config_id": {
            "title": "Compute Config Id",
            "type": "string",
            "description": "The compute config id for the workspace"
          },
          "base_snapshot": {
            "title": "Base Snapshot",
            "type": "string",
            "description": "Metadata on base snapshot"
          },
          "cluster_environment_build_id": {
            "title": "Cluster Environment Build Id",
            "type": "string",
            "description": "The cluster environment build id for the cluster used by the workspace"
          },
          "idle_timeout_minutes": {
            "title": "Idle Timeout Minutes",
            "type": "integer",
            "description": "Idle timeout (in minutes), after which the Cluster is terminated. Idle time is defined as the time during which a Cluster is not running a user command (through 'anyscale exec' or the Web UI), and does not have an attached driver. Time spent running Jupyter commands, or commands run through ssh, is still considered 'idle'."
          },
          "cloned_job_id": {
            "title": "Cloned Job Id",
            "type": "string",
            "description": "Ha job id of the associated ha job (could be job or v1 service)."
          },
          "cloned_workspace_id": {
            "title": "Cloned Workspace Id",
            "type": "string",
            "description": "Id of the cloned workspace."
          },
          "template_id": {
            "title": "Template Id",
            "type": "string",
            "description": "The Id of the template to use."
          },
          "template_version_id": {
            "title": "Template Version Id",
            "type": "string",
            "description": "The Id of the template version to use."
          },
          "template_url": {
            "title": "Template Url",
            "type": "string",
            "description": "The template's URL to use. When this is specified, the template_id is only used for generating the build id."
          },
          "tags": {
            "title": "Tags",
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Tags to associate with the workspace."
          },
          "proxied_artifacts": {
            "title": "Proxied Artifacts",
            "allOf": [
              {
                "$ref": "#/components/schemas/WorkspaceDataplaneProxiedArtifacts"
              }
            ],
            "description": "The proxied artifacts for the workspace."
          },
          "skip_start": {
            "title": "Skip Start",
            "type": "boolean",
            "description": "Skip start the workspace on creation."
          }
        },
        "description": "Model used to create a Workspace."
      },
      "CreateInstanceUsageBudget": {
        "title": "CreateInstanceUsageBudget",
        "required": [
          "name",
          "budget_amount",
          "evaluation_period"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "budget_amount": {
            "type": "number"
          },
          "evaluation_period": {
            "$ref": "#/components/schemas/InstanceUsageBudgetEvaluationPeriod"
          },
          "budget_unit": {
            "allOf": [
              {
                "$ref": "#/components/schemas/InstanceUsageBudgetUnit"
              }
            ],
            "default": "ANYSCALE_CREDITS"
          },
          "project_id": {
            "type": "string"
          },
          "cloud_id": {
            "type": "string"
          },
          "notification_channel": {
            "$ref": "#/components/schemas/CreateNotificationChannelRecord"
          }
        },
        "additionalProperties": false
      },
      "CreateInternalProductionJob": {
        "title": "CreateInternalProductionJob",
        "required": [
          "name",
          "config"
        ],
        "type": "object",
        "properties": {
          "name": {
            "title": "Name",
            "type": "string",
            "description": "Name of the job"
          },
          "description": {
            "title": "Description",
            "type": "string",
            "description": "Description of the job"
          },
          "project_id": {
            "title": "Project Id",
            "type": "string",
            "description": "Id of the project this job will start clusters in"
          },
          "config": {
            "$ref": "#/components/schemas/CreateProductionJobConfig"
          },
          "job_queue_config": {
            "title": "Job Queue Config",
            "allOf": [
              {
                "$ref": "#/components/schemas/CreateJobQueueConfig"
              }
            ],
            "description": "Configuration specifying semantic of the execution using job queues"
          },
          "tags": {
            "title": "Tags",
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Tags to associate with the job"
          },
          "workspace_id": {
            "title": "Workspace Id",
            "type": "string",
            "description": "Id of the workspace that this job is generated from"
          }
        }
      },
      "CreateJobQueueConfig": {
        "title": "CreateJobQueueConfig",
        "type": "object",
        "properties": {
          "priority": {
            "title": "Priority",
            "type": "integer",
            "description": "Job's relative priority (only relevant for Job Queues of type PRIORITY). Valid values range from 0 (highest) to +inf (lowest). Default value is None"
          },
          "target_job_queue_id": {
            "title": "Target Job Queue Id",
            "type": "string",
            "description": "Identifier of the existing Job Queue this job should be added to. Note, only one of `target_job_queue_id`, `target_job_queue_name` or `job_queue_spec` could be provided"
          },
          "target_job_queue_name": {
            "title": "Target Job Queue Name",
            "type": "string",
            "description": "Existing Job Queue user-provided name (identifier), this job should be added to. Note, only one of `target_job_queue_id`, `target_job_queue_name` or `job_queue_spec` could be provided"
          },
          "job_queue_spec": {
            "title": "Job Queue Spec",
            "allOf": [
              {
                "$ref": "#/components/schemas/JobQueueSpec"
              }
            ],
            "description": "Spec of the Job Queue definition that should be created and associated with this job. Note, only one of `target_job_queue_id`, `target_job_queue_name` or `job_queue_spec` could be provided"
          }
        },
        "description": "Specifies configuration of the job being added to a Job Queue"
      },
      "CreateJobQueueRequests": {
        "title": "CreateJobQueueRequests",
        "required": [
          "compute_config_id",
          "cluster_environment_build_id",
          "idle_timeout_sec",
          "project_id"
        ],
        "type": "object",
        "properties": {
          "job_queue_name": {
            "title": "Job Queue Name",
            "type": "string",
            "description": "Optional user-provided identifier of the queue that could be subsequently used to reference the queue when submitting jobs. Note that name has to be unique within the project."
          },
          "execution_mode": {
            "allOf": [
              {
                "$ref": "#/components/schemas/JobQueueExecutionMode"
              }
            ],
            "description": "Execution mode of the jobs submitted into the queue (one of: FIFO,LIFO,PRIORITY",
            "default": "FIFO"
          },
          "compute_config_id": {
            "title": "Compute Config Id",
            "type": "string",
