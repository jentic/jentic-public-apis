        ],
        "description": "DEPRECATED: Use CloudDataBucketPresignedUrlScheme instead.\n\nTODO(janet): Remove this model in a few months.\n\nDefines the scheme of the presigned URL for uploading a file to a cloud data bucket."
      },
      "CloudDataBucketPresignedUrlRequest": {
        "title": "CloudDataBucketPresignedUrlRequest",
        "required": [
          "file_type",
          "file_name",
          "access_mode"
        ],
        "type": "object",
        "properties": {
          "file_type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CloudDataBucketFileType"
              }
            ],
