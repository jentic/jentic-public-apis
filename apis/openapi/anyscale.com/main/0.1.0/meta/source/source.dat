      "ApplyProductionServiceMultiVersionV2Model": {
        "title": "ApplyProductionServiceMultiVersionV2Model",
        "required": [
          "service_versions"
        ],
        "type": "object",
        "properties": {
          "rollout_strategy": {
            "allOf": [
              {
                "$ref": "#/components/schemas/RolloutStrategy"
              }
            ],
            "description": "Strategy for rollout. The ROLLOUT strategy will deploy your Ray Serve configuration onto a newly started cluster, and then shift traffic over to the new cluster. You can manually control the speed of the rollout using the canary_percent configuration.\nThe IN_PLACE strategy will use Ray Serve in place upgrade to update your existing cluster in place. When using this rollout strategy, you may only change the ray_serve_config field. You cannot partially shift traffic or rollback an in place upgrade. In place upgrades are faster and riskier than rollouts, and we recommend only using them for relatively safe changes (for example, increasing the number of replicas on a Ray Serve deployment).\nThe MULTI_VERSION strategy will deploy multiple versions of the service. You can shift traffic between versions using the traffic_percent configuration.Default strategy is ROLLOUT.",
            "default": "ROLLOUT"
          },
          "cloud_id": {
            "title": "Cloud Id",
            "type": "string",
            "description": "Id of the cloud this Service will launch clusters in."
          },
          "project_id": {
            "title": "Project Id",
            "type": "string",
            "description": "Id of the project this Service will start clusters in."
          },
          "service_versions": {
            "title": "Service Versions",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApplyProductionServiceV2Model"
            },
            "description": "List of versions to deploy. Each version is a deployment of the service."
          }
        }
      },
      "ApplyProductionServiceV2Model": {
        "title": "ApplyProductionServiceV2Model",
        "required": [
          "name",
          "ray_serve_config",
          "build_id",
          "compute_config_id"
        ],
        "type": "object",
        "properties": {
          "name": {
            "title": "Name",
            "type": "string",
            "description": "Name of the Service"
          },
          "description": {
            "title": "Description",
            "type": "string",
            "description": "Description of the Service"
          },
          "project_id": {
            "title": "Project Id",
            "type": "string",
            "description": "Id of the project this Service will start clusters in"
          },
          "version": {
            "title": "Version",
            "type": "string",
            "description": "A version string that represents the version for this service. Will be populated with a random version if not specified."
          },
          "canary_percent": {
            "title": "Canary Percent",
            "type": "integer",
            "description": "A manual target percent for this service. If this field is not set, the service will automatically roll out. If set, this should be a number between 0 and 100. The newly created version will have weight `canary_percent` and the existing version will have `100 - canary_percent`."
          },
          "ray_serve_config": {
            "title": "Ray Serve Config",
            "allOf": [
              {
                "$ref": "#/components/schemas/RayServeConfig"
              }
            ],
            "description": "The Ray Serve config to use for this service. This config defines your Ray Serve application, and will be passed directly to Ray Serve. You can learn more about Ray Serve config files here: https://docs.ray.io/en/latest/serve/production-guide/config.html"
          },
          "build_id": {
            "title": "Build Id",
            "type": "string",
            "description": "The id of the cluster env build. This id will determine the docker image your Service is run using."
          },
          "compute_config_id": {
            "title": "Compute Config Id",
            "type": "string",
            "description": "The id of the compute configuration that you want to use. This id will specify the resources required for your ServiceThe compute template includes a `cloud_id` that must be fixed for each service."
          },
          "config": {
            "title": "Config",
            "allOf": [
              {
                "$ref": "#/components/schemas/ServiceConfig"
              }
            ],
            "description": "Target Service's configuration"
          },
          "rollout_strategy": {
            "allOf": [
              {
                "$ref": "#/components/schemas/RolloutStrategy"
              }
            ],
            "description": "Strategy for rollout. The ROLLOUT strategy will deploy your Ray Serve configuration onto a newly started cluster, and then shift traffic over to the new cluster. You can manually control the speed of the rollout using the canary_percent configuration.\nThe IN_PLACE strategy will use Ray Serve in place upgrade to update your existing cluster in place. When using this rollout strategy, you may only change the ray_serve_config field. You cannot partially shift traffic or rollback an in place upgrade. In place upgrades are faster and riskier than rollouts, and we recommend only using them for relatively safe changes (for example, increasing the number of replicas on a Ray Serve deployment).\nDefault strategy is ROLLOUT.",
            "default": "ROLLOUT"
          },
          "ray_gcs_external_storage_config": {
            "title": "Ray Gcs External Storage Config",
            "allOf": [
              {
                "$ref": "#/components/schemas/RayGCSExternalStorageConfig"
              }
            ],
            "description": "Config for the Ray GCS to connect to external storage. If populated, head node fault tolerance will be enabled for this service."
          },
          "tracing_config": {
            "title": "Tracing Config",
            "allOf": [
              {
                "$ref": "#/components/schemas/TracingConfig"
              }
            ],
            "description": "Config for initializing tracing within Anyscale runtime."
          },
          "auto_complete_rollout": {
            "title": "Auto Complete Rollout",
            "type": "boolean",
            "description": "Flag to indicate whether or not to complete the rollout after the canary version reaches 100%.",
            "default": true
          },
          "max_surge_percent": {
            "title": "Max Surge Percent",
            "type": "integer",
            "description": "Max amount of excess capacity allocated during the rollout (0-100)."
          },
          "tags": {
            "title": "Tags",
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Tags to associate with the service"
          },
          "traffic_percent": {
            "title": "Traffic Percent",
            "type": "integer",
            "description": " Percentage of traffic forwarded to a particular service version from the ALB."
          },
          "connection_ids": {
            "title": "Connection Ids",
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of connection IDs to associate with the service.",
            "nullable": true
          }
        },
        "description": "DEPRECATED. Please do not use this model directly. Use ApplyServiceModel."
      },
