            "format": "date-time"
          },
          "timestamp_ns": {
            "title": "Timestamp Ns",
            "type": "integer",
            "description": "The nanosecond timestamp for when the log is produced."
          },
          "payload": {
            "title": "Payload",
            "type": "object",
            "description": "Log statement payload as JSON object."
