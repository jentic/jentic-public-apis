        ],
        "description": "An enumeration."
      },
      "JobQueueSpec": {
        "title": "JobQueueSpec",
        "required": [
          "idle_timeout_sec"
        ],
        "type": "object",
        "properties": {
          "job_queue_name": {
            "title": "Job Queue Name",
            "type": "string",
            "description": "Optional user-provided identifier of the queue that could be subsequently used to reference the queue when submitting jobs. Note that name has to be unique within the project."
          },
          "execution_mode": {
            "allOf": [
              {
                "$ref": "#/components/schemas/JobQueueExecutionMode"
              }
            ],
            "description": "Execution mode of the jobs submitted into the queue (one of: FIFO,LIFO,PRIORITY",
            "default": "FIFO"
          },
          "compute_config_id": {
            "title": "Compute Config Id",
            "type": "string",
            "description": "The id of the compute configuration that will be used to create cluster associated with the queue. Defaults to default compute config in the given project"
          },
          "cluster_environment_build_id": {
            "title": "Cluster Environment Build Id",
            "type": "string",
            "description": "The id of the cluster environment build that will be used to create cluster associated with the queue."
          },
          "max_concurrency": {
            "title": "Max Concurrency",
            "type": "integer",
            "description": "Max number of jobs to be run concurrently. Defaults to 1, ie running no more than 1 job at a time.",
            "default": 1
          },
          "idle_timeout_sec": {
            "title": "Idle Timeout Sec",
            "type": "integer",
            "description": "Max period of time queue will be accepting new jobs, before being sealed off and its associated cluster being shutdown"
          },
          "auto_termination_threshold_job_count": {
            "title": "Auto Termination Threshold Job Count",
            "type": "integer",
            "description": "Maximum number of jobs the cluster can run before it becomes eligible for termination."
          }
        },
        "description": "Specifies definition of the Job Queue to be created"
      },
      "JobQueueSpecResponse": {
        "title": "JobQueueSpecResponse",
        "type": "object",
        "properties": {
          "name": {
            "title": "Name",
            "type": "string",
            "description": "Name of the job queue."
          },
          "execution_mode": {
            "title": "Execution Mode",
            "type": "string",
            "description": "Execution mode (FIFO, PRIORITY)."
          },
          "compute_config": {
            "title": "Compute Config",
            "type": "string",
            "description": "Compute config name."
          },
          "max_concurrency": {
            "title": "Max Concurrency",
            "type": "integer",
            "description": "Max concurrent jobs."
          },
          "idle_timeout_s": {
            "title": "Idle Timeout S",
            "type": "integer",
            "description": "Idle timeout in seconds."
          }
        },
        "description": "Job queue specification matching CLI JobQueueSpec format."
      },
      "JobQueueState": {
        "title": "JobQueueState",
        "enum": [
          "ACTIVE",
          "SEALED"
        ],
        "type": "string",
        "description": "Typical job queue lifecycle looks like following:\n\n1. ACTIVE: job queue is actively accepting new jobs, executing them on\n   the running cluster\n2. SEALED: job queue is sealed, after being idle for the specified idle-timeout\n   amount of time (job queue is considered idle, when it is empty)."
      },
      "JobQueueTerminationResponse": {
        "title": "JobQueueTerminationResponse",
        "required": [
          "job_queue_id",
          "total_jobs_marked_for_termination"
        ],
        "type": "object",
        "properties": {
          "job_queue_id": {
            "title": "Job Queue Id",
            "type": "string",
            "description": "ID of the job queue being terminated."
          },
          "session_id": {
            "title": "Session Id",
            "type": "string",
            "description": "ID of the associated cluster/session. Frontend can poll the job queue API for status updates."
          },
          "total_jobs_marked_for_termination": {
            "title": "Total Jobs Marked For Termination",
            "type": "integer",
            "description": "Number of jobs that were marked for termination."
          }
        },
        "description": "Response for job queue termination API."
      },
      "JobQueuesQuery": {
        "title": "JobQueuesQuery",
        "type": "object",
        "properties": {
          "name": {
            "title": "Name",
            "allOf": [
