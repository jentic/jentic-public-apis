            "description": "The name or identifier of a secret containing credentials to authenticate to the docker registry hosting the image."
          },
          "ray_version": {
            "title": "Ray Version",
            "type": "string",
            "description": "The Ray version to use for this build."
          },
          "id": {
            "title": "Id",
            "type": "string",
            "description": "Server assigned unique identifier."
          },
          "application_template": {
            "title": "Application Template",
            "allOf": [
