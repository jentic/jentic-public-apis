      "get": {
        "summary": "Get User Group",
        "description": "Get a specific user group by ID.\n\nReturns details for a single user group if it exists in the authenticated user's organization.\n\nPath Parameters:\n- **group_id**: The ID of the user group to retrieve\n\nReturns:\n- User group with id and name\n\nPermission requirements:\n- Caller must be an organization admin",
        "operationId": "get_user_group_api_v2_user_groups__group_id__get",
