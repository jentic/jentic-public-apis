      "DecoratedJobQueue": {
        "title": "DecoratedJobQueue",
        "required": [
          "id",
          "current_job_queue_state",
          "execution_mode",
          "max_concurrency",
          "idle_timeout_sec",
          "created_at",
          "creator_id",
          "creator_email",
          "compute_config_id",
          "project_id",
          "cloud_id"
        ],
        "type": "object",
        "properties": {
          "id": {
            "title": "Id",
            "type": "string",
            "description": "Server assigned unique identifier of the job queue."
          },
          "user_provided_id": {
            "title": "User Provided Id",
            "type": "string",
            "description": "User provided identifier of the job queue."
          },
          "name": {
            "title": "Name",
            "type": "string",
            "description": "Name of the job queue. Drived from the field user_provided_id."
          },
          "current_job_queue_state": {
            "allOf": [
              {
                "$ref": "#/components/schemas/JobQueueState"
              }
            ],
            "description": "The current state of the job queue."
          },
          "execution_mode": {
            "allOf": [
              {
                "$ref": "#/components/schemas/JobQueueExecutionMode"
              }
            ],
            "description": "The execution mode of the job queue."
          },
          "max_concurrency": {
            "title": "Max Concurrency",
            "type": "integer",
            "description": "The maximum number of jobs that can be run concurrently."
          },
          "idle_timeout_sec": {
            "title": "Idle Timeout Sec",
            "type": "integer",
            "description": "The number of seconds a job can be idle before it is terminated."
          },
          "created_at": {
            "title": "Created At",
            "type": "string",
            "description": "Time at which job queue was created.",
            "format": "date-time"
          },
          "creator_id": {
            "title": "Creator Id",
            "type": "string",
            "description": "Identifier of user who created the job queue."
          },
          "creator_email": {
            "title": "Creator Email",
            "type": "string",
            "description": "Email of user who created the job queue."
          },
          "compute_config_id": {
            "title": "Compute Config Id",
            "type": "string",
            "description": "The compute config id for the job queue"
          },
          "current_cluster_state": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SessionState"
              }
            ],
            "description": "The current state of the cluster associated with the job queue."
          },
          "cluster_id": {
            "title": "Cluster Id",
            "type": "string",
            "description": "The cluster id associated with the job queue. Cluster id could be null, in case when Job Queue has been created but cluster has not been provisioned yet."
          },
          "project_id": {
            "title": "Project Id",
            "type": "string",
            "description": "The project id associated with the job queue."
          },
          "cloud_id": {
            "title": "Cloud Id",
            "type": "string",
            "description": "The cloud id associated with the job queue."
          },
          "sealed_at": {
            "title": "Sealed At",
            "type": "string",
            "description": "Time at which job queue was sealed (archived).",
            "format": "date-time"
          },
          "total_jobs": {
            "title": "Total Jobs",
            "type": "integer",
            "description": "Total number of jobs in the job queue."
          },
          "successful_jobs": {
            "title": "Successful Jobs",
            "type": "integer",
            "description": "Number of successful jobs in the job queue."
          },
          "failed_jobs": {
            "title": "Failed Jobs",
            "type": "integer",
            "description": "Number of failed jobs in the job queue."
          },
          "active_jobs": {
            "title": "Active Jobs",
            "type": "integer",
            "description": "Number of active jobs in the job queue."
          }
        },
        "description": "Fields representing a JobQueue with additional metadata."
      },
      "DecoratedListServiceAPIModel": {
        "title": "DecoratedListServiceAPIModel",
        "required": [
