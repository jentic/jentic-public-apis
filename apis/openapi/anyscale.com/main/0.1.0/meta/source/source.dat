    "/api/v2/logs/get_log_files": {
      "post": {
        "summary": "Get Log Files",
        "description": "API for downloading logs of a session.\n\n This is a paginated api, which means that a single call to this will result in one page of results (log files).\n The page size and next page token (in LogDownloadRequest) can be used to list all log files, either iteratively or in a single go.\n\n Parameters\n ----------\nlog_download_request: LogDownloadRequest\n     Parameters to filter logs and control download. This is read from the request body.\n\n Returns\n -------\n Response[LogDownloadResult]\n     List of logs files, with their presigned URL and next page token if there are more results.\n\n Raises\n ------\n HTTPException(400)\n     If the user is using a cloud provider (currently non-AWS) that does not support this feature.\n\n HTTPException(403)\n     If the user does not have access to the session.\n\n HTTPException(404)\n     If the session or cloud could not be found in the DB.\n\n HTTPException(500)\n     If there are any other errors while downloading logs.\n ",
        "operationId": "get_log_files_api_v2_logs_get_log_files_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LogDownloadRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogdownloadresultResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/logs/job_logs_download_v2/{job_id}": {
      "get": {
        "summary": "Get Job Logs Download V2",
        "description": "Fetches the job logs of a single job run. This is a single API that supports job logs no\nmatter if the job is still running or not.\n\nIf the job is still running, the logs will be fetched from the streaming logs s3 path.\nIf the job is not running, the logs will be fetched from downloaded logs s3 path.\nIf a pagination token is provided, we use the streaming logs or downloaded logs path\ndepending on the format of the pagination token.\n\nTODO(aguo): Implement job alive or dead detection",
        "operationId": "get_job_logs_download_v2_api_v2_logs_job_logs_download_v2__job_id__get",
        "parameters": [
          {
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            },
            "name": "job_id",
            "in": "path"
          },
          {
            "description": "Number of chunks to fetch. Defaults to 400. Max of 1000.",
            "required": false,
            "schema": {
              "title": "Page Size",
              "maximum": 1000.0,
              "exclusiveMinimum": 0.0,
              "type": "integer",
              "description": "Number of chunks to fetch. Defaults to 400. Max of 1000.",
              "default": 400
            },
            "name": "page_size",
            "in": "query"
          },
          {
            "description": "Pagination token for getting newer logs.",
            "required": false,
            "schema": {
              "title": "Next Page Token",
              "type": "string",
              "description": "Pagination token for getting newer logs."
            },
            "name": "next_page_token",
            "in": "query"
          },
          {
            "description": "Pagination token for getting older logs.",
            "required": false,
            "schema": {
              "title": "Previous Page Token",
              "type": "string",
              "description": "Pagination token for getting older logs."
            },
            "name": "previous_page_token",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogdownloadresultResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
