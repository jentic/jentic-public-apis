          },
          "job_queue_id": {
            "title": "Job Queue Id",
            "type": "string",
            "description": "Id of the job queue this job is being enqueued to"
          },
          "overview_url": {
            "title": "Overview Url",
            "type": "string",
            "description": "URL to the job overview page in the Anyscale console"
          }
        },
        "description": "Model of a Production Job for use in the SDK."
      },
      "ProductionJobConfig": {
        "title": "ProductionJobConfig",
        "required": [
          "build_id",
          "compute_config_id"
        ],
        "type": "object",
        "properties": {
          "entrypoint": {
            "title": "Entrypoint",
            "type": "string",
            "description": "A script that will be run to start your job.This command will be run in the root directory of the specified runtime env. Eg. 'python script.py'",
            "default": ""
          },
          "ray_serve_config": {
            "title": "Ray Serve Config",
            "allOf": [
              {
                "$ref": "#/components/schemas/RayServeConfig"
              }
            ],
            "description": "The Ray Serve config to use for this Production service. This config defines your Ray Serve application, and will be passed directly to Ray Serve. You can learn more about Ray Serve config files here: https://docs.ray.io/en/latest/serve/production-guide/config.html"
          },
          "runtime_env": {
            "title": "Runtime Env",
            "allOf": [
              {
                "$ref": "#/components/schemas/RayRuntimeEnvConfig"
              }
            ],
            "description": "A ray runtime env json. Your entrypoint will be run in the environment specified by this runtime env."
          },
          "build_id": {
            "title": "Build Id",
            "type": "string",
            "description": "The id of the cluster env build. This id will determine the docker image your job is run on."
          },
          "image_uri": {
            "title": "Image Uri",
            "type": "string",
            "description": "The image URI of the container in which the job will run. Can be an Anyscale image (anyscale/ray:*), cluster environment image (anyscale/image/*), or a BYOD image from an external registry. Either build_id or image_uri must be provided."
          },
          "registry_login_secret": {
            "title": "Registry Login Secret",
            "type": "string",
            "description": "The name or identifier of a secret containing credentials to authenticate to the docker registry hosting the image. Only used with image_uri for BYOD images from external registries."
          },
          "compute_config_id": {
            "title": "Compute Config Id",
            "type": "string",
            "description": "The id of the compute configuration that you want to use. This id will specify the resources required for your job"
          },
          "compute_config": {
            "title": "Compute Config",
            "allOf": [
              {
                "$ref": "#/components/schemas/CreateClusterComputeConfig"
              }
            ],
            "description": "One-off compute that the cluster will use."
          },
          "max_retries": {
            "title": "Max Retries",
            "type": "integer",
            "description": "The number of retries this job will attempt on failure. Set to None to set infinite retries",
            "default": 5
          },
          "timeout_s": {
            "title": "Timeout S",
            "type": "integer",
            "description": "The timeout in seconds for each job run. Set to None for no limit to be set"
          },
          "connection_ids": {
            "title": "Connection Ids",
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of connection IDs to associate with the job."
          },
          "runtime_env_config": {
            "title": "Runtime Env Config",
            "allOf": [
              {
                "$ref": "#/components/schemas/RayRuntimeEnvConfig"
              }
            ],
            "description": "DEPRECATED: Use runtime_env"
          }
        }
      },
      "ProductionJobEvent": {
        "title": "ProductionJobEvent",
        "required": [
          "id",
          "created_at",
          "origin",
          "ha_job_id"
        ],
        "type": "object",
        "properties": {
          "id": {
            "title": "Id",
            "type": "string",
            "description": "Id of the Job event"
          },
          "created_at": {
            "title": "Created At",
            "type": "string",
            "description": "The time this event was created.",
            "format": "date-time"
          },
          "event_type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/HaJobStates"
              }
            ],
            "description": "Type of Job event"
          },
          "error_type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/HaJobErrorTypes"
              }
            ],
            "description": "Type of Job error. Only populated for JOB type events that are in error state"
          },
          "level": {
            "allOf": [
              {
                "$ref": "#/components/schemas/EventLevel"
              }
            ],
            "description": "Level of Job event"
          },
          "message": {
            "title": "Message",
            "type": "string",
            "description": "Message of Job event"
          },
          "origin": {
            "allOf": [
              {
                "$ref": "#/components/schemas/HaJobEventOrigin"
              }
            ],
            "description": "The origin of the Job events."
          },
          "ha_job_id": {
            "title": "Ha Job Id",
            "type": "string",
            "description": "The id of the Job."
          },
          "cluster_id": {
            "title": "Cluster Id",
            "type": "string",
            "description": "The associated cluster id.Present only for Job event and only when the cluster is associated with the event."
          },
          "metadata": {
            "title": "Metadata",
            "type": "object",
            "description": "The metadata of the event"
          },
          "has_additional_sensitive_message": {
            "title": "Has Additional Sensitive Message",
            "type": "boolean",
            "description": "Whether we have additional sensitive message details stored that can be subsequently fetched.",
            "default": false
          }
        },
        "description": "Model of Production Job Event used in internal API."
      },
      "ProductionJobEventScopeFilter": {
        "title": "ProductionJobEventScopeFilter",
        "enum": [
          "JOB",
          "CLUSTER",
          ""
        ],
        "type": "string",
        "description": "An enumeration."
      },
      "ProductionJobStateTransition": {
        "title": "ProductionJobStateTransition",
        "required": [
          "id",
          "state_transitioned_at",
          "current_state"
        ],
        "type": "object",
        "properties": {
          "id": {
            "title": "Id",
            "type": "string",
            "description": "The id of this job state transition"
          },
          "state_transitioned_at": {
            "title": "State Transitioned At",
            "type": "string",
            "description": "The last time the state of this job was updated",
            "format": "date-time"
          },
          "current_state": {
            "allOf": [
              {
                "$ref": "#/components/schemas/HaJobStates"
              }
            ],
            "description": "The current state of the job"
          },
          "goal_state": {
            "allOf": [
              {
                "$ref": "#/components/schemas/HaJobGoalStates"
              }
            ],
            "description": "The goal state of the job"
          },
          "error": {
            "title": "Error",
            "type": "string",
            "description": "An error message that occurred in this job state transition"
          },
          "operation_message": {
            "title": "Operation Message",
            "type": "string",
            "description": "The logging message for this job state transition"
          },
          "cluster_id": {
            "title": "Cluster Id",
            "type": "string",
            "description": "The id of the cluster the job is running on"
          }
        }
      },
