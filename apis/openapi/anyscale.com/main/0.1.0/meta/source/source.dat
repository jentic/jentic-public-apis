    "/api/v2/services-v2/": {
      "get": {
        "summary": "List Services",
        "operationId": "list_services_api_v2_services_v2__get",
        "parameters": [
          {
            "description": "project_id to filter by",
            "required": false,
            "schema": {
              "title": "Project Id",
              "type": "string",
              "description": "project_id to filter by"
            },
            "name": "project_id",
            "in": "query"
          },
          {
            "description": "name to filter by",
            "required": false,
            "schema": {
              "title": "Name",
              "type": "string",
              "description": "name to filter by"
            },
            "name": "name",
            "in": "query"
          },
          {
            "description": "A list of Service states to filter by",
            "required": false,
            "schema": {
              "uniqueItems": true,
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/ServiceEventCurrentState"
              },
              "description": "A list of Service states to filter by",
              "default": []
            },
            "name": "state_filter",
            "in": "query"
          },
          {
            "description": "The archive status to filter by. Defaults to unarchived.",
            "required": false,
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/ArchiveStatus"
                }
              ],
              "description": "The archive status to filter by. Defaults to unarchived.",
              "default": "NOT_ARCHIVED"
            },
            "name": "archive_status",
            "in": "query"
          },
          {
            "description": "creator_id to filter by",
            "required": false,
            "schema": {
              "title": "Creator Id",
              "type": "string",
              "description": "creator_id to filter by"
            },
            "name": "creator_id",
            "in": "query"
          },
          {
            "description": "cloud_id to filter by",
            "required": false,
            "schema": {
              "title": "Cloud Id",
              "type": "string",
              "description": "cloud_id to filter by"
            },
            "name": "cloud_id",
            "in": "query"
          },
          {
            "description": "Application type to filter by",
            "required": false,
            "schema": {
              "uniqueItems": true,
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/ApplicationType"
              },
              "description": "Application type to filter by",
              "default": []
            },
            "name": "application_type",
            "in": "query"
          },
          {
            "description": "Repeatable filter of tags in the form key:value. Can be specified multiple times. Values with the same key are ORed; keys are ANDed.",
            "required": false,
            "schema": {
              "title": "Tag Filter",
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Repeatable filter of tags in the form key:value. Can be specified multiple times. Values with the same key are ORed; keys are ANDed."
            },
            "name": "tag_filter",
            "in": "query"
          },
          {
            "description": "If absent, the default sorting order is 1. status (active first).2. Last updated at (desc). 3. Name (asc).",
            "required": false,
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/ServiceSortField"
                }
              ],
              "description": "If absent, the default sorting order is 1. status (active first).2. Last updated at (desc). 3. Name (asc)."
            },
            "name": "sort_field",
            "in": "query"
          },
          {
            "description": "If sort_field is absent, this field is ignored.If absent, this field defaults to ascending.",
            "required": false,
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/SortOrder"
                }
              ],
              "description": "If sort_field is absent, this field is ignored.If absent, this field defaults to ascending.",
              "default": "ASC"
            },
            "name": "sort_order",
            "in": "query"
          },
          {
            "required": false,
            "schema": {
              "title": "Paging Token",
              "type": "string"
            },
            "name": "paging_token",
            "in": "query"
          },
          {
            "required": false,
            "schema": {
              "title": "Count",
              "maximum": 50.0,
              "minimum": 0.0,
              "type": "integer"
            },
            "name": "count",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
