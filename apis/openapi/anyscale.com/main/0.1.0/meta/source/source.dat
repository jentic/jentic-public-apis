                "$ref": "#/components/schemas/UserServiceAccessTypes"
              }
            ],
            "description": "Whether service can be accessed by public internet traffic.",
            "default": "public"
          },
          "healthcheck_url": {
            "title": "Healthcheck Url",
            "type": "string",
            "description": "The healthcheck url. Anyscale will poll this url to determine whether the service is healthy or not. Only present for services"
          },
          "archived_at": {
            "title": "Archived At",
            "type": "string",
            "description": "The time in which this instance is archived.",
            "format": "date-time"
          },
          "cloud_id": {
            "title": "Cloud Id",
