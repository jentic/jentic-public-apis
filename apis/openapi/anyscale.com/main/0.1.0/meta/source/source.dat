          },
          "cloud_id": {
            "title": "Cloud Id",
            "type": "string",
            "description": "List job queues associated with a given cloud."
          },
          "archive_status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ArchiveStatus"
              }
            ],
            "description": "Filter by archive status. NOT_ARCHIVED shows ACTIVE queues, ARCHIVED shows SEALED queues, ALL shows both.",
            "default": "NOT_ARCHIVED"
          },
          "paging": {
            "title": "Paging",
            "allOf": [
