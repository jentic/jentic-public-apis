        "description": "Fetches the serve controller logs of the cluster.\nThe logs will be fetched from the streaming logs s3 bucket.\n\nIf a pagination token is provided, we use the streaming logs or downloaded logs bucket\ndepending on the format of the pagination token.",
        "operationId": "get_train_logs_download_api_v2_train_runs_logs_get",
        "parameters": [
          {
            "required": true,
            "schema": {
              "title": "Cluster Id",
              "type": "string"
            },
            "name": "cluster_id",
            "in": "query"
          },
          {
            "required": true,
            "schema": {
              "title": "Log Id",
              "type": "string"
            },
            "name": "log_id",
            "in": "query"
          },
          {
            "description": "Number of chunks to fetch. Defaults to 400. Max of 1000.",
            "required": false,
            "schema": {
              "title": "Page Size",
              "maximum": 1000.0,
              "exclusiveMinimum": 0.0,
              "type": "integer",
              "description": "Number of chunks to fetch. Defaults to 400. Max of 1000.",
              "default": 400
            },
            "name": "page_size",
            "in": "query"
          },
          {
            "description": "Pagination token for getting newer logs.",
            "required": false,
            "schema": {
              "title": "Next Page Token",
              "type": "string",
              "description": "Pagination token for getting newer logs."
            },
            "name": "next_page_token",
            "in": "query"
          },
          {
            "description": "Pagination token for getting older logs.",
            "required": false,
            "schema": {
              "title": "Previous Page Token",
              "type": "string",
              "description": "Pagination token for getting older logs."
            },
            "name": "previous_page_token",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogdownloadresultResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
