            "title": "Max Concurrency",
            "type": "integer",
            "description": "Max number of jobs to be run concurrently. Defaults to 1, ie running no more than 1 job at a time.",
            "default": 1
          },
          "idle_timeout_sec": {
            "title": "Idle Timeout Sec",
            "type": "integer",
