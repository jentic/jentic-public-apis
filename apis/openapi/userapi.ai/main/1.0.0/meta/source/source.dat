{
  "openapi": "3.0.3",
  "info": {
    "title": "UserAPI.ai API",
    "version": "1.0.0",
    "description": "Official UserAPI.ai REST API for Midjourney automation. Base URL: https://api.userapi.ai (alternative: https://ru.api.userapi.ai).",
    "x-jentic-source-url": "https://userapi.ai/openapi.json"
  },
  "servers": [
    {
      "url": "https://api.userapi.ai",
      "description": "Primary API endpoint"
    },
    {
      "url": "https://ru.api.userapi.ai",
      "description": "Alternative endpoint"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "tags": [
    {
      "name": "Midjourney",
      "description": "Midjourney task creation and management endpoints"
    },
    {
      "name": "Discord",
      "description": "Discord account endpoints"
    }
  ],
  "paths": {
    "/midjourney/v2/imagine": {
      "post": {
        "tags": [
          "Midjourney"
        ],
        "summary": "Create imagine task",
        "operationId": "createImagineTask",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImagineRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HashResponse"
                }
              }
            }
          }
        }
      }
    },
    "/midjourney/v2/animate": {
      "post": {
        "tags": [
          "Midjourney"
        ],
        "summary": "Animate upscaled result",
        "operationId": "createAnimateTask",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnimateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HashResponse"
                }
              }
            }
          }
        }
      }
    },
    "/midjourney/v2/describe": {
      "post": {
        "tags": [
          "Midjourney"
        ],
        "summary": "Generate prompts from image",
        "operationId": "createDescribeTask",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DescribeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HashResponse"
                }
              }
            }
          }
        }
      }
    },
    "/midjourney/v2/upload": {
      "post": {
        "tags": [
          "Midjourney"
        ],
        "summary": "Upload image to Discord",
        "operationId": "uploadImage",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/UploadMultipartRequest"
              }
            },
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UploadUrlRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Upload completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadResponse"
                }
              }
            }
          }
        }
      }
    },
    "/midjourney/v2/upscale": {
      "post": {
        "tags": [
          "Midjourney"
        ],
        "summary": "Upscale one image from grid",
        "operationId": "createUpscaleTask",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpscaleRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HashResponse"
                }
              }
            }
          }
        }
      }
    },
    "/midjourney/v2/upsample": {
      "post": {
        "tags": [
          "Midjourney"
        ],
        "summary": "Advanced upscale variants",
        "operationId": "createUpsampleTask",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpsampleRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HashResponse"
                }
              }
            }
          }
        }
      }
    },
    "/midjourney/v2/variation": {
      "post": {
        "tags": [
          "Midjourney"
        ],
        "summary": "Generate variation from task",
        "operationId": "createVariationTask",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VariationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HashResponse"
                }
              }
            }
          }
        }
      }
    },
    "/midjourney/v2/seed": {
      "post": {
        "tags": [
          "Midjourney"
        ],
        "summary": "Calculate seed from generated image",
        "operationId": "createSeedTask",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SeedRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task accepted or completed",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/HashResponse"
                    },
                    {
                      "$ref": "#/components/schemas/TaskStatus"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/midjourney/v2/vary-subtle": {
      "post": {
        "tags": [
          "Midjourney"
        ],
        "summary": "Vary subtle from upscaled image",
        "operationId": "createVarySubtleTask",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VaryRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HashResponse"
                }
              }
            }
          }
        }
      }
    },
    "/midjourney/v2/vary-strong": {
      "post": {
        "tags": [
          "Midjourney"
        ],
        "summary": "Vary strong from upscaled image",
        "operationId": "createVaryStrongTask",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VaryRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HashResponse"
                }
              }
            }
          }
        }
      }
    },
    "/midjourney/v2/inpaint": {
      "post": {
        "tags": [
          "Midjourney"
        ],
        "summary": "Inpaint selected image area",
        "operationId": "createInpaintTask",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InpaintRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HashResponse"
                }
              }
            }
          }
        }
      }
    },
    "/midjourney/v2/blend": {
      "post": {
        "tags": [
          "Midjourney"
        ],
        "summary": "Blend 2-5 images",
        "operationId": "createBlendTask",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BlendRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HashResponse"
                }
              }
            }
          }
        }
      }
    },
    "/midjourney/v2/reroll": {
      "post": {
        "tags": [
          "Midjourney"
        ],
        "summary": "Reroll generated image",
        "operationId": "createRerollTask",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RerollRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HashResponse"
                }
              }
            }
          }
        }
      }
    },
    "/midjourney/v2/zoom": {
      "post": {
        "tags": [
          "Midjourney"
        ],
        "summary": "Zoom image out or custom zoom",
        "operationId": "createZoomTask",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ZoomRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HashResponse"
                }
              }
            }
          }
        }
      }
    },
    "/midjourney/v2/pan": {
      "post": {
        "tags": [
          "Midjourney"
        ],
        "summary": "Pan upscaled image",
        "operationId": "createPanTask",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PanRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HashResponse"
                }
              }
            }
          }
        }
      }
    },
    "/midjourney/v2/info": {
      "post": {
        "tags": [
          "Midjourney"
        ],
        "summary": "Get account subscription info task",
        "operationId": "createInfoTask",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InfoRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HashResponse"
                }
              }
            }
          }
        }
      }
    },
    "/midjourney/v2/prefer": {
      "post": {
        "tags": [
          "Midjourney"
        ],
        "summary": "Toggle account preferences",
        "operationId": "setPreferMode",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PreferRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Immediate result or accepted async task",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/HashResponse"
                    },
                    {
                      "$ref": "#/components/schemas/StatusEnvelope"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/midjourney/v2/status": {
      "get": {
        "tags": [
          "Midjourney"
        ],
        "summary": "Get task status by hash",
        "operationId": "getTaskStatus",
        "parameters": [
          {
            "name": "hash",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Task status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskStatus"
                }
              }
            }
          }
        }
      }
    },
    "/midjourney/v2/speed": {
      "post": {
        "tags": [
          "Midjourney"
        ],
        "summary": "Toggle account speed mode",
        "operationId": "setSpeedMode",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SpeedRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Immediate result or accepted async task",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/HashResponse"
                    },
                    {
                      "$ref": "#/components/schemas/StatusEnvelope"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/discord/info": {
      "get": {
        "tags": [
          "Discord"
        ],
        "summary": "Get Discord account info by account hash",
        "operationId": "getDiscordAccountInfo",
        "parameters": [
          {
            "name": "account_hash",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Discord account details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DiscordInfoResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "api-key"
      }
    },
    "schemas": {
      "WebhookType": {
        "type": "string",
        "enum": [
          "progress",
          "result"
        ]
      },
      "HashResponse": {
        "type": "object",
        "required": [
          "hash"
        ],
        "properties": {
          "hash": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "FileResult": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "proxy_url": {
            "type": "string",
            "format": "uri"
          },
          "filename": {
            "type": "string"
          },
          "content_type": {
            "type": "string"
          },
          "width": {
            "type": "integer"
          },
          "height": {
            "type": "integer"
          },
          "size": {
            "type": "integer"
          }
        }
      },
      "TaskStatus": {
        "type": "object",
        "description": "Generic task status payload used by status endpoint and webhooks.",
        "required": [
          "hash",
          "type",
          "status"
        ],
        "properties": {
          "account_hash": {
            "type": "string",
            "format": "uuid"
          },
          "hash": {
            "type": "string",
            "format": "uuid"
          },
          "parent_hash": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "webhook_url": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "webhook_type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/WebhookType"
              }
            ],
            "nullable": true
          },
          "callback_id": {
            "type": "string",
            "nullable": true
          },
          "choice": {
            "description": "Method-specific choice value (number/string).",
            "oneOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "nullable": true
          },
          "prompt": {
            "type": "string",
            "nullable": true
          },
          "type": {
            "type": "string"
          },
          "progress": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "status": {
            "type": "string",
            "enum": [
              "sent",
              "waiting",
              "progress",
              "done",
              "error"
            ]
          },
          "result": {
            "description": "Method-specific result payload.",
            "nullable": true
          },
          "next_actions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "prefilter_result": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status_reason": {
            "type": "string",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": true
      },
      "StatusEnvelope": {
        "type": "object",
        "required": [
          "status",
          "result"
        ],
        "properties": {
          "status": {
            "type": "boolean"
          },
          "result": {
            "$ref": "#/components/schemas/TaskStatus"
          }
        }
      },
      "ImagineRequest": {
        "type": "object",
        "required": [
          "prompt"
        ],
        "properties": {
          "prompt": {
            "type": "string"
          },
          "webhook_url": {
            "type": "string",
            "format": "uri"
          },
          "webhook_type": {
            "$ref": "#/components/schemas/WebhookType"
          },
          "account_hash": {
            "type": "string",
            "format": "uuid"
          },
          "is_disable_prefilter": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "AnimateRequest": {
        "type": "object",
        "required": [
          "hash",
          "choice"
        ],
        "properties": {
          "hash": {
            "type": "string",
            "format": "uuid",
            "description": "Hash of a completed upscale task."
          },
          "choice": {
            "type": "string",
            "enum": [
              "high",
              "low"
            ]
          },
          "webhook_url": {
            "type": "string",
            "format": "uri"
          },
          "webhook_type": {
            "$ref": "#/components/schemas/WebhookType"
          }
        }
      },
      "DescribeRequest": {
        "type": "object",
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "webhook_url": {
            "type": "string",
            "format": "uri"
          },
          "webhook_type": {
            "$ref": "#/components/schemas/WebhookType"
          },
          "account_hash": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "UploadMultipartRequest": {
        "type": "object",
        "required": [
          "image"
        ],
        "properties": {
          "image": {
            "type": "string",
            "format": "binary"
          },
          "account_hash": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "UploadUrlRequest": {
        "type": "object",
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "account_hash": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "UploadResponse": {
        "type": "object",
        "required": [
          "account_hash",
          "image"
        ],
        "properties": {
          "account_hash": {
            "type": "string",
            "format": "uuid"
          },
          "image": {
            "allOf": [
              {
                "$ref": "#/components/schemas/FileResult"
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "ephemeral": {
                    "type": "boolean"
                  }
                }
              }
            ]
          }
        }
      },
      "UpscaleRequest": {
        "type": "object",
        "required": [
          "hash",
          "choice"
        ],
        "properties": {
          "hash": {
            "type": "string",
            "format": "uuid"
          },
          "choice": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "webhook_url": {
            "type": "string",
            "format": "uri"
          },
          "webhook_type": {
            "$ref": "#/components/schemas/WebhookType"
          }
        }
      },
      "UpsampleRequest": {
        "type": "object",
        "required": [
          "hash",
          "choice"
        ],
        "properties": {
          "hash": {
            "type": "string",
            "format": "uuid"
          },
          "choice": {
            "type": "string",
            "enum": [
              "v6_2x_subtle",
              "v6_2x_creative",
              "v5_2x",
              "v5_4x",
              "subtle",
              "creative",
              "v6r1_2x_subtle",
              "v6r1_2x_creative",
              "v7_2x_subtle",
              "v7_2x_creative"
            ]
          },
          "webhook_url": {
            "type": "string",
            "format": "uri"
          },
          "webhook_type": {
            "$ref": "#/components/schemas/WebhookType"
          }
        }
      },
      "VariationRequest": {
        "type": "object",
        "required": [
          "hash",
          "choice"
        ],
        "properties": {
          "hash": {
            "type": "string",
            "format": "uuid"
          },
          "choice": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "prompt": {
            "type": "string",
            "description": "Optional in remix mode."
          },
          "webhook_url": {
            "type": "string",
            "format": "uri"
          },
          "webhook_type": {
            "$ref": "#/components/schemas/WebhookType"
          }
        }
      },
      "SeedRequest": {
        "type": "object",
        "required": [
          "hash"
        ],
        "properties": {
          "hash": {
            "type": "string",
            "format": "uuid"
          },
          "is_async": {
            "type": "boolean",
            "default": false
          },
          "webhook_url": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "VaryRequest": {
        "type": "object",
        "required": [
          "hash"
        ],
        "properties": {
          "hash": {
            "type": "string",
            "format": "uuid"
          },
          "prompt": {
            "type": "string",
            "description": "Optional in remix mode."
          },
          "webhook_url": {
            "type": "string",
            "format": "uri"
          },
          "webhook_type": {
            "$ref": "#/components/schemas/WebhookType"
          }
        }
      },
      "InpaintRequest": {
        "type": "object",
        "required": [
          "hash",
          "mask",
          "prompt"
        ],
        "properties": {
          "hash": {
            "type": "string",
            "format": "uuid"
          },
          "mask": {
            "type": "string",
            "description": "Base64-encoded PNG mask where white area is redrawn."
          },
          "prompt": {
            "type": "string"
          },
          "webhook_url": {
            "type": "string",
            "format": "uri"
          },
          "webhook_type": {
            "$ref": "#/components/schemas/WebhookType"
          }
        }
      },
      "BlendImage": {
        "type": "object",
        "required": [
          "url",
          "ext"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "ext": {
            "type": "string",
            "enum": [
              "jpg",
              "png"
            ]
          }
        }
      },
      "BlendRequest": {
        "type": "object",
        "required": [
          "urls"
        ],
        "properties": {
          "urls": {
            "type": "array",
            "minItems": 2,
            "maxItems": 5,
            "items": {
              "$ref": "#/components/schemas/BlendImage"
            }
          },
          "webhook_url": {
            "type": "string",
            "format": "uri"
          },
          "webhook_type": {
            "$ref": "#/components/schemas/WebhookType"
          },
          "account_hash": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "RerollRequest": {
        "type": "object",
        "required": [
          "hash"
        ],
        "properties": {
          "hash": {
            "type": "string",
            "format": "uuid"
          },
          "webhook_url": {
            "type": "string",
            "format": "uri"
          },
          "webhook_type": {
            "$ref": "#/components/schemas/WebhookType"
          },
          "prompt": {
            "type": "string",
            "description": "Optional in remix mode."
          }
        }
      },
      "ZoomRequest": {
        "type": "object",
        "required": [
          "hash"
        ],
        "properties": {
          "hash": {
            "type": "string",
            "format": "uuid"
          },
          "choice": {
            "type": "integer",
            "enum": [
              50,
              75
            ],
            "description": "50 = Zoom Out 2x, 75 = Zoom Out 1.5x."
          },
          "prompt": {
            "type": "string",
            "description": "Used for custom zoom. Required when choice is omitted."
          },
          "webhook_url": {
            "type": "string",
            "format": "uri"
          },
          "webhook_type": {
            "$ref": "#/components/schemas/WebhookType"
          }
        },
        "anyOf": [
          {
            "required": [
              "choice"
            ]
          },
          {
            "required": [
              "prompt"
            ]
          }
        ]
      },
      "PanRequest": {
        "type": "object",
        "required": [
          "hash",
          "choice"
        ],
        "properties": {
          "hash": {
            "type": "string",
            "format": "uuid"
          },
          "choice": {
            "type": "string",
            "enum": [
              "left",
              "right",
              "up",
              "down"
            ]
          },
          "prompt": {
            "type": "string",
            "description": "Optional in remix mode."
          },
          "webhook_url": {
            "type": "string",
            "format": "uri"
          },
          "webhook_type": {
            "$ref": "#/components/schemas/WebhookType"
          }
        }
      },
      "InfoRequest": {
        "type": "object",
        "required": [
          "account_hash"
        ],
        "properties": {
          "account_hash": {
            "type": "string",
            "format": "uuid"
          },
          "webhook_url": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "PreferRequest": {
        "type": "object",
        "required": [
          "account_hash",
          "choice"
        ],
        "properties": {
          "account_hash": {
            "type": "string",
            "format": "uuid"
          },
          "choice": {
            "type": "string",
            "enum": [
              "remix"
            ]
          },
          "is_async": {
            "type": "boolean",
            "default": false
          },
          "webhook_url": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "SpeedRequest": {
        "type": "object",
        "required": [
          "account_hash",
          "choice"
        ],
        "properties": {
          "account_hash": {
            "type": "string",
            "format": "uuid"
          },
          "choice": {
            "type": "string",
            "enum": [
              "relax",
              "fast",
              "turbo"
            ]
          },
          "is_async": {
            "type": "boolean",
            "default": false
          },
          "webhook_url": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "DiscordInfoResponse": {
        "type": "object",
        "required": [
          "hash",
          "status"
        ],
        "properties": {
          "hash": {
            "type": "string",
            "format": "uuid"
          },
          "token": {
            "type": "string"
          },
          "channel_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "active",
              "tos",
              "banned",
              "error"
            ]
          },
          "status_reason": {
            "type": "string",
            "nullable": true
          },
          "external_username": {
            "type": "string"
          },
          "external_email": {
            "type": "string"
          },
          "is_remix": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": true
      }
    }
  }
}