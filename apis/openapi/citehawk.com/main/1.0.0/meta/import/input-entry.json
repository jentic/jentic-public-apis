      "LookerStudioField": {
        "type": "object",
        "description": "One field descriptor. The connector maps conceptType and semanticType onto Looker Studio field types.",
        "properties": {
          "name": {
            "type": "string",
            "description": "Field id, matching a key in a data row."
          },
          "label": {
            "type": "string",
            "description": "Human label shown in Looker Studio."
          },
          "dataType": {
            "type": "string",
            "enum": [
              "STRING",
              "NUMBER"
            ]
          },
          "semantics": {
            "type": "object",
            "properties": {
              "conceptType": {
                "type": "string",
                "enum": [
                  "DIMENSION",
                  "METRIC"
                ]
              },
              "semanticType": {
                "type": "string",
                "enum": [
                  "YEAR_MONTH_DAY",
                  "PERCENT",
                  "NUMBER"
                ],
                "description": "Absent means plain text for a dimension and plain number for a metric. PERCENT fields are fractions 0-1."
              }
            },
            "required": [
              "conceptType"
            ]
          },
          "aggregation": {
            "type": "string",
            "enum": [
              "AVG",
              "SUM"
            ],
            "description": "Default aggregation for a metric. Rates average; counts sum."
          }
        },
        "required": [
          "name",
          "label",
          "dataType",
          "semantics"
        ]
      },
      "LookerStudioSchemaResponse": {
        "type": "object",
        "properties": {
          "schema": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LookerStudioField"
            }
          }
        },
        "required": [
          "schema"
        ]
      },
      "LookerStudioRow": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "description": "Collection day as YYYYMMDD, the format Looker Studio expects for a YEAR_MONTH_DAY dimension."
          },
          "brand_name": {
            "type": "string"
          },
          "provider": {
            "type": "string",
            "description": "The AI model the row is measured on. 'all' is the cross-model rollup."
          },
          "prompt_type": {
            "type": "string",
            "enum": [
              "discovery",
              "branded",
              "all"
            ]
          },
          "metric_version": {
            "type": "string",
            "description": "Which generation of the metric definitions wrote the row, as a string so it can be used as a dimension."
          },
          "sov": {
            "type": "number",
            "description": "Share of voice as a fraction 0-1."
          },
          "mention_rate": {
            "type": "number",
            "description": "Share of answers mentioning the brand, 0-1."
          },
          "citation_rate": {
            "type": "number",
            "description": "Share of answers citing the brand's own site, 0-1."
          },
          "avg_sentiment": {
            "type": "number",
            "description": "Average sentiment of the mentions, roughly -1..1."
          },
          "responses_collected": {
            "type": "integer"
          }
        },
        "required": [
          "date",
          "brand_name",
          "provider",
          "prompt_type",
          "metric_version",
          "sov",
          "mention_rate",
          "citation_rate",
          "avg_sentiment",
          "responses_collected"
        ]
      },
      "LookerStudioDataResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LookerStudioRow"
            }
          },
          "rows": {
            "type": "integer",
            "description": "Number of rows in data."
          }
        },
        "required": [
          "data",
          "rows"
        ]
      }
    }
