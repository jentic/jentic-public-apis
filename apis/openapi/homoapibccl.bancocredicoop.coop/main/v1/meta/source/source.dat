    "/ConFirma/gestion": {
      "post": {
        "tags": [
          "Echeq"
        ],
        "summary": "Gestion de Echeqs con Firma",
        "description": "Este apartado describe el proceso mediante el cual una empresa realiza una acción de echeq CON FIRMA, a través de APIs de BCCL. El flujo detalla la creación diferentes acciones de echeq individual o múltiple.",
        "operationId": "postConFirmaGestion",
