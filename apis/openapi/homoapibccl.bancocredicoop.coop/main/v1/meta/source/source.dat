    "/beneficiario/{numeroAdherente}": {
      "get": {
        "tags": [
          "Echeq"
        ],
        "summary": "Consultar beneficiario en agenda.",
        "description": "Este servicio permite consultar la existencia de un beneficiario en la agenda de beneficiarios de Echeq del Adherente.",
        "operationId": "getBeneficiario",
        "parameters": [
          {
            "name": "numeroAdherente",
            "in": "path",
            "description": "Número de adherente de la empresa.",
            "required": true,
            "style": "simple",
            "explode": true,
            "schema": {
              "type": "string"
            },
            "example": "3160"
          },
          {
            "name": "documento",
            "in": "query",
            "description": "Número de documento de la empresa.",
            "required": true,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "string"
            },
            "example": "30526874249"
          },
          {
            "name": "documentoTipo",
            "in": "query",
            "description": "Tipo de documento de la empresa.",
            "required": true,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "string",
              "enum": [
                "CUIT",
                "CUIL",
                "CDI"
              ]
            },
            "example": "CUIT"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseConsultaBeneficiario"
                },
                "examples": {
                  "Response Alta Beneficiario": {
                    "value": {
                      "data": {
                        "numeroAdherente": "3160",
                        "beneficiario": {
                          "nombre": "Fund Med Mar del Plata",
                          "documento": "30526874249",
                          "documentoTipo": "CUIT"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Error de negocio.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response400"
                },
                "examples": {
                  "Parámetros inválidos": {
                    "value": {
                      "error": {
                        "codigo": "APIE-8001",
                        "descripcion": "Parametros invalidos"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "No Autorizado. Expiró el access token o no es válido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Response401"
                }
              }
            }
          },
          "500": {
            "description": "Error interno del servidor."
          }
        },
        "security": [
          {
            "oAuth2ClientCredentials": []
          },
          {
            "default": []
          }
        ],
        "x-auth-type": "Application & Application User",
        "x-throttling-tier": "Unlimited",
        "x-wso2-application-security": {
          "security-types": [
            "oauth2"
          ],
          "optional": false
        }
      }
    },
    "/beneficiario": {
      "post": {
        "tags": [
          "Echeq"
        ],
        "summary": "Alta de nuevos beneficiarios.",
