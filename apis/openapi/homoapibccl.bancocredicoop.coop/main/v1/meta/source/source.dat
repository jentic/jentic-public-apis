            "type": "integer",
            "description": "Número de adherente de banca internet."
          },
          "cbuCuenta": {
            "type": "string",
            "description": "Cuenta de depósito (CBU), 22 caracteres numéricos.",
            "maxLength": 22,
            "minLength": 22
          },
          "accion": {
            "type": "string",
            "description": "Indica la acción a realizar con el echeq, dato fijo para DEPOSITAR.",
            "enum": [
              "DEPOSITAR"
            ]
          },
          "operadoresFirmantes": {
            "type": "array",
            "description": "Lista de firmantes (opcional).",
            "items": {
              "type": "object",
              "properties": {
                "documento": {
                  "type": "string",
                  "description": "Número de documento del firmante."
                },
                "documentoTipo": {
                  "type": "string",
                  "description": "Tipo de documento. Valores posibles CUIT, CUIL, CDI, DNI, LC, PE, CI, LE.",
                  "enum": [
                    "CUIT",
                    "CUIL",
                    "CDI",
                    "DNI",
                    "LC",
                    "PE",
                    "CI",
                    "LE"
                  ]
                }
              }
            }
          },
          "echeqs": {
            "type": "array",
            "description": "Lista de echeqs.",
            "items": {
              "type": "object",
              "properties": {
                "idCheque": {
                  "type": "string",
                  "description": "ID del echeq. Campo opcional."
                },
                "cmc7": {
                  "type": "string",
                  "description": "Código CMC7, numérico de longitud fija (29 dígitos). Campo opcional.",
                  "maxLength": 29,
                  "minLength": 29
                },
                "monto": {
                  "type": "string",
                  "description": "Monto del echeq. Formato hasta 13 dígitos enteros + 2 decimales (ej 123456.25).",
                  "pattern": "^\\d{1,13}\\.\\d{2}$"
                },
                "fechaPago": {
                  "type": "string",
                  "description": "Fecha de pago en formato aaaaMMDD. Debe ser igual o anterior a la fecha del día.",
                  "pattern": "^\\d{8}$"
                }
              }
            }
          }
        }
      },
