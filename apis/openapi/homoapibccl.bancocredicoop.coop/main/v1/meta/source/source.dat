                    "numeroAdherente": 3160,
                    "idOrigen": "e80f90a6-e52e-471e-af2e-ecd6939f77c6",
                    "beneficiarios": [
                      {
                        "orden": "0",
                        "documento": "30526874249",
                        "documentoTipo": "CUIT"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
