  "paths": {
    "/emision": {
      "get": {
        "tags": [
          "Echeq"
        ],
        "summary": "Consulta de Echeq",
        "description": "Consulta de estado de emisión de Echeq.",
        "operationId": "getEcheq",
        "parameters": [
          {
            "name": "idOperacion",
            "in": "query",
            "description": "Identificador único de la operación bancaria provisto por la respuesta del api de echeq.",
            "required": true,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "string"
            },
            "example": "3356"
          },
          {
            "name": "numeroAdherente",
            "in": "query",
            "description": "Número de adherente",
            "required": true,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "string"
            },
            "example": "33288473"
          }
        ],
        "responses": {
          "200": {
            "description": "Ok",
            "content": {
