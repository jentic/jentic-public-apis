      "RequestListaCheques": {
        "type": "object",
        "properties": {
          "numeroAdherente": {
            "type": "string",
            "description": "Número de adherente de banca internet."
          },
          "idOrigen": {
            "type": "string",
            "format": "uuid",
            "description": "Código único del sistema de la empresa."
          },
          "filtro": {
            "type": "object",
            "properties": {
              "gestion": {
                "type": "string",
                "enum": [
                  "GENERADOS",
                  "RECIBIDOS"
                ]
              },
              "estado": {
                "type": "string",
                "description": "Estado de un Echeq, para ver los estados disponibles ir la tabla BIP.ECHEQ_ESTADOS."
              },
              "idCheque": {
                "type": "string"
              },
              "cmc7": {
                "type": "string",
                "description": "Formato del cmc7, especificación de COELSA.",
                "maximum": 29,
                "minimum": 29
              },
              "numeroCheque": {
                "type": "string",
                "description": "Número de Cheque."
              },
              "cuitCuilCdi": {
                "description": "Numero de CUIT, CUIL o CDI.",
                "minimum": 11,
                "maximun": 11
              },
              "fechaEmisionDesde": {
                "type": "string",
                "description": "Formato aaaaMMDD.",
                "minimum": 8,
                "maximun": 8
              },
              "fechaEmisionHasta": {
                "type": "string",
                "description": "Formato aaaaMMDD. En caso de existir fechaPagoDesde, esta debe ser mayor.",
                "minimum": 8,
                "maximun": 8
              },
              "cbuEmisor": {
                "type": "string",
                "description": "Aplica solo si el campo GESTION tiene el valor GENERADOS.",
                "minimun": 22,
                "maximun": 22
              },
              "moneda": {
                "type": "string",
                "description": "Identificador de la moneda, permite los valores ARS o USD (opcional)."
              },
              "pagina": {
                "type": "string",
                "description": "Valor inicial 1."
              },
              "limite": {
                "type": "string",
                "description": "Es la cantidad de cheques a consultar por página, debe ser múltiplo de 20, valor máximo 100.",
                "enum": [
                  "20",
                  "40",
                  "60",
                  "80",
                  "100"
                ]
              }
            },
            "required": [
              "estado",
              "gestion",
              "limite",
              "pagina"
            ]
          }
        },
        "required": [
          "idOrigen",
          "numeroAdherente"
        ]
      },
