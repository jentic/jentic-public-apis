  "components": {
    "schemas": {
      "RequestEcheq": {
        "type": "object",
        "properties": {
          "idOrigen": {
            "type": "string",
            "format": "uuid",
            "description": "Código único del sistema de la empresa."
          },
          "numeroAdherente": {
            "type": "string",
            "description": "Número de adherente de banca internet."
          },
          "operadoresFirmantes": {
            "type": "array",
            "description": "Lista de firmantes (opcional).",
            "items": {
              "type": "object",
              "properties": {
                "documento": {
                  "type": "string",
                  "description": "Número de documento del firmante."
                },
                "documentoTipo": {
                  "type": "string",
                  "enum": [
                    "CUIT",
                    "CUIL",
                    "CDI",
                    "DNI",
                    "LC",
                    "PE",
                    "CI",
                    "LE"
                  ]
                }
              }
            }
          },
          "cbuCuentaDebito": {
            "type": "string",
            "description": "Número de CBU asociado a la cuenta débito, 22 digitos.",
            "minimum": 8,
            "maximun": 8
          },
          "echeqs": {
            "type": "array",
            "description": "Lista de Echeqs.",
            "items": {
              "type": "object",
              "properties": {
                "numeroCheque": {
                  "type": "integer",
                  "description": "Número de cheque (opcional, máximo 8 dígitos).",
                  "maximum": 8
                },
                "monto": {
                  "type": "string",
                  "description": "Monto del Echeq, 13 dígitos parte entera y 2 dígitos parte decimal separado por . “punto”. Ej. 123456.25."
                },
                "fechaPago": {
                  "type": "string",
                  "description": "Alfanumérico de 8 posiciones en formato AAAAMMDD. Ej. 19891228"
                },
                "motivoPago": {
                  "type": "string",
                  "description": "Alfanumérico hasta 150 posiciones.No permite caracteres especiales AZ y Números.",
                  "maxLength": 150
                },
                "concepto": {
                  "type": "string",
                  "description": "Concepto por el cual se emite el Echeq.",
                  "enum": [
                    "ALQ",
                    "CUO",
                    "EXP",
                    "FAC",
                    "PRE",
                    "SEG",
                    "HON",
                    "VAR"
                  ],
                  "maxLength": 3,
                  "caracter": {
                    "type": "string",
                    "description": "Numérico de 1 dígito, \"0\" No a la orden ó \"1\" A la orden."
                  },
                  "modo": {
                    "type": "string",
                    "description": "Numérico de 1 dígito, \"0\" No cruzado ó \"1\" Cruzado"
                  },
                  "beneficiarioNombre": {
                    "type": "string",
                    "description": "Alfanumérico hasta 100 posiciones."
                  },
                  "beneficiarioDocumentoTipo": {
                    "type": "string",
                    "description": "Tipo de documento del beneficiario (CUIT, CUIL, CDI)."
                  },
                  "beneficiarioDocumento": {
                    "type": "string",
                    "description": "Número de documento del beneficiario."
                  },
                  "tipoCheque": {
                    "type": "string",
                    "description": "Tipo de cheque Común(ECHC) o Diferido(ECHD)."
                  },
                  "mails": {
                    "type": "array",
                    "description": "Email",
                    "maxItems": 3,
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "required": [
          "cbuCuentaDebito",
          "echeqs",
          "idOrigen",
          "numeroAdherente"
        ]
      },
