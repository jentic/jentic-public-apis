      "RequestDepositarEcheq": {
        "type": "object",
        "properties": {
          "idOrigen": {
            "type": "string",
            "format": "uuid",
            "description": "Código único del sistema de la empresa. UUID alfanumérico de hasta 36 caracteres.",
