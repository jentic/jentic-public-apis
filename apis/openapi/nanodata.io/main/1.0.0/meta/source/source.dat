{
  "openapi": "3.0.3",
  "info": {
    "title": "Nanodata API",
    "description": "Nanodata Exchange, Leaderboard ve Payment API Dokümantasyonu",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/blockeyfi/nanodata-api-exchange/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.nanodata.io"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/exchange": {
      "post": {
        "summary": "Connect Exchange",
        "tags": [
          "Exchange"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "exchange",
                  "apiKey",
                  "secretKey",
                  "connectionName"
                ],
                "properties": {
                  "exchange": {
                    "type": "string"
                  },
                  "apiKey": {
                    "type": "string"
                  },
                  "secretKey": {
                    "type": "string"
                  },
                  "passphrase": {
                    "type": "string",
                    "nullable": true
                  },
                  "connectionName": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Exchange connected"
          },
          "400": {
            "description": "Invalid credentials / duplicate / missing passphrase"
          }
        }
      }
    },
    "/api/exchange/currentlyConnected": {
      "post": {
        "summary": "Get connected exchanges",
        "tags": [
          "Exchange"
        ],
        "responses": {
          "200": {
            "description": "Connected exchanges list"
          }
        }
      }
    },
    "/api/exchange/disconnetExchange": {
      "post": {
        "summary": "Disconnect exchange",
        "tags": [
          "Exchange"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "connectionId"
                ],
                "properties": {
                  "connectionId": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Disconnected"
          },
          "404": {
            "description": "Not connected"
          }
        }
      }
    },
    "/api/exchange/copyTrade": {
      "post": {
        "summary": "Copy trades",
        "tags": [
          "Exchange"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "traderId",
                  "capitalPercent"
                ],
                "properties": {
                  "traderId": {
                    "type": "string"
                  },
                  "capitalPercent": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 100
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Copy started"
          },
          "400": {
            "description": "Invalid input"
          },
          "403": {
            "description": "No subscription / limit reached"
          }
        }
      }
    },
    "/api/exchange/getOpenPositions": {
      "post": {
        "summary": "Get open positions",
        "tags": [
          "Exchange"
        ],
        "responses": {
          "200": {
            "description": "Positions list"
          }
        }
      }
    },
    "/api/exchange/closePosition": {
      "post": {
        "summary": "Close position(s)",
        "tags": [
          "Exchange"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "positionIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Position(s) closed"
          },
          "404": {
            "description": "Position not found"
          }
        }
      }
    },
    "/api/exchange/updatePosition": {
      "post": {
        "summary": "Update position",
        "tags": [
          "Exchange"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "positionId"
                ],
                "properties": {
                  "positionId": {
                    "type": "string"
                  },
                  "stopLoss": {
                    "type": "number"
                  },
                  "takeProfit": {
                    "type": "number"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated"
          },
          "400": {
            "description": "Invalid values"
          }
        }
      }
    },
    "/api/exchange/defaultCapitalPercent": {
      "post": {
        "summary": "Get default capital percent",
        "tags": [
          "Exchange"
        ],
        "responses": {
          "200": {
            "description": "Default percent"
          }
        }
      }
    },
    "/api/exchange/updateCapitalPercent": {
      "post": {
        "summary": "Update capital percent",
        "tags": [
          "Exchange"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "capitalPercent"
                ],
                "properties": {
                  "capitalPercent": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 100
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated"
          },
          "400": {
            "description": "Invalid percent"
          }
        }
      }
    },
    "/api/exchange/setDefaultCapitalPercent": {
      "post": {
        "summary": "Set default capital percent",
        "tags": [
          "Exchange"
        ],
        "responses": {
          "200": {
            "description": "Default updated"
          }
        }
      }
    },
    "/api/exchange/marketSentiments": {
      "get": {
        "summary": "Market sentiments",
        "tags": [
          "Exchange"
        ],
        "parameters": [
          {
            "name": "timeframe",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "1H",
                "4H",
                "1D"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sentiment data"
          }
        }
      }
    },
    "/api/exchange/sentiment-details": {
      "post": {
        "summary": "Sentiment details",
        "tags": [
          "Exchange"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "symbol"
                ],
                "properties": {
                  "symbol": {
                    "type": "string"
                  },
                  "timeframe": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Details"
          },
          "400": {
            "description": "Invalid symbol"
          }
        }
      }
    },
    "/api/leaderboards/getLeaderboardsData": {
      "post": {
        "summary": "Get leaderboards",
        "tags": [
          "Leaderboards"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "exchange": {
                    "type": "string"
                  },
                  "period": {
                    "type": "string",
                    "enum": [
                      "DAILY",
                      "WEEKLY",
                      "MONTHLY",
                      "ALL"
                    ]
                  },
                  "page": {
                    "type": "number"
                  },
                  "limit": {
                    "type": "number"
                  },
                  "search": {
                    "type": "string"
                  },
                  "sortBy": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Leaderboard data"
          }
        }
      }
    },
    "/api/leaderboards/getTraderPositions": {
      "post": {
        "summary": "Get trader positions",
        "tags": [
          "Leaderboards"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "encryptedUid"
                ],
                "properties": {
                  "encryptedUid": {
                    "type": "string"
                  },
                  "exchange": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Positions & history"
          },
          "400": {
            "description": "Invalid UID"
          }
        }
      }
    },
    "/api/leaderboards/selectTradersToDisplay": {
      "post": {
        "summary": "Select traders (Admin only)",
        "tags": [
          "Leaderboards"
        ],
        "responses": {
          "200": {
            "description": "Selection saved"
          }
        }
      }
    },
    "/api/leaderboards/process-leaderboard-data": {
      "post": {
        "summary": "Process leaderboard data",
        "tags": [
          "Leaderboards"
        ],
        "responses": {
          "200": {
            "description": "Processed"
          }
        }
      }
    },
    "/api/payment/create-checkout-session": {
      "post": {
        "summary": "Create checkout session",
        "tags": [
          "Payment"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "priceId"
                ],
                "properties": {
                  "priceId": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stripe session created"
          },
          "400": {
            "description": "Invalid priceId / active subscription"
          }
        }
      }
    },
    "/api/payment/create-portal-session": {
      "post": {
        "summary": "Create portal session",
        "tags": [
          "Payment"
        ],
        "responses": {
          "200": {
            "description": "Portal URL returned"
          }
        }
      }
    },
    "/api/webhook/stripe": {
      "post": {
        "summary": "Stripe webhook",
        "tags": [
          "Webhook"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Webhook processed"
          },
          "400": {
            "description": "Invalid signature"
          }
        }
      }
    }
  }
}
