{
  "openapi": "3.0.3",
  "info": {
    "title": "Dog CEO Dog API",
    "description": "The internet's biggest collection of open source dog pictures. Free, no auth required.",
    "version": "1.0.0",
    "contact": {
      "name": "Dog CEO",
      "url": "https://dog.ceo"
    },
    "license": {
      "name": "MIT",
      "url": "https://github.com/ElliottLandsworh/dog-ceo-api/blob/master/LICENSE"
    },
    "x-jentic-source-url": "https://dog.ceo/dog-api/documentation/"
  },
  "servers": [
    {
      "url": "https://dog.ceo/api",
      "description": "Production server"
    }
  ],
  "paths": {
    "/breeds/list/all": {
      "get": {
        "operationId": "listAllBreeds",
        "summary": "List all breeds",
        "description": "Returns a list of all dog breeds with their sub-breeds.",
        "tags": [
          "breeds"
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BreedsListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/breeds/image/random": {
      "get": {
        "operationId": "getRandomImage",
        "summary": "Random image from all breeds",
        "description": "Display a single random image from all dogs collection.",
        "tags": [
          "images"
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SingleImageResponse"
                }
              }
            }
          }
        }
      }
    },
    "/breeds/image/random/{count}": {
      "get": {
        "operationId": "getMultipleRandomImages",
        "summary": "Multiple random images from all breeds",
        "description": "Display multiple random images from all dogs collection. Max 50.",
        "tags": [
          "images"
        ],
        "parameters": [
          {
            "name": "count",
            "in": "path",
            "required": true,
            "description": "Number of images to return (max 50)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MultiImageResponse"
                }
              }
            }
          }
        }
      }
    },
    "/breed/{breed}/images": {
      "get": {
        "operationId": "getBreedImages",
        "summary": "All images from a breed",
        "description": "Returns an array of all the images from a breed.",
        "tags": [
          "breeds",
          "images"
        ],
        "parameters": [
          {
            "name": "breed",
            "in": "path",
            "required": true,
            "description": "Breed name (e.g. hound)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MultiImageResponse"
                }
              }
            }
          }
        }
      }
    },
    "/breed/{breed}/images/random": {
      "get": {
        "operationId": "getRandomBreedImage",
        "summary": "Random image from a breed",
        "description": "Returns a random dog image from a breed.",
        "tags": [
          "breeds",
          "images"
        ],
        "parameters": [
          {
            "name": "breed",
            "in": "path",
            "required": true,
            "description": "Breed name (e.g. hound)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SingleImageResponse"
                }
              }
            }
          }
        }
      }
    },
    "/breed/{breed}/images/random/{count}": {
      "get": {
        "operationId": "getMultipleRandomBreedImages",
        "summary": "Multiple random images from a breed",
        "description": "Return multiple random dog images from a breed.",
        "tags": [
          "breeds",
          "images"
        ],
        "parameters": [
          {
            "name": "breed",
            "in": "path",
            "required": true,
            "description": "Breed name (e.g. hound)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "count",
            "in": "path",
            "required": true,
            "description": "Number of images to return (max 50)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MultiImageResponse"
                }
              }
            }
          }
        }
      }
    },
    "/breed/{breed}/list": {
      "get": {
        "operationId": "listSubBreeds",
        "summary": "List sub-breeds",
        "description": "Returns an array of all the sub-breeds from a breed.",
        "tags": [
          "breeds"
        ],
        "parameters": [
          {
            "name": "breed",
            "in": "path",
            "required": true,
            "description": "Breed name (e.g. hound)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubBreedsListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/breed/{breed}/{subBreed}/images": {
      "get": {
        "operationId": "getSubBreedImages",
        "summary": "All images from a sub-breed",
        "description": "Returns an array of all the images from the sub-breed.",
        "tags": [
          "breeds",
          "images"
        ],
        "parameters": [
          {
            "name": "breed",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "subBreed",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MultiImageResponse"
                }
              }
            }
          }
        }
      }
    },
    "/breed/{breed}/{subBreed}/images/random": {
      "get": {
        "operationId": "getRandomSubBreedImage",
        "summary": "Random image from a sub-breed",
        "description": "Returns a random image from a sub-breed.",
        "tags": [
          "breeds",
          "images"
        ],
        "parameters": [
          {
            "name": "breed",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "subBreed",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SingleImageResponse"
                }
              }
            }
          }
        }
      }
    },
    "/breed/{breed}/{subBreed}/images/random/{count}": {
      "get": {
        "operationId": "getMultipleRandomSubBreedImages",
        "summary": "Multiple random images from a sub-breed",
        "description": "Return multiple random dog images from a sub-breed.",
        "tags": [
          "breeds",
          "images"
        ],
        "parameters": [
          {
            "name": "breed",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "subBreed",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "count",
            "in": "path",
            "required": true,
            "description": "Number of images to return (max 50)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MultiImageResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SingleImageResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "URL of the dog image"
          },
          "status": {
            "type": "string",
            "enum": [
              "success",
              "error"
            ]
          }
        }
      },
      "MultiImageResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Array of dog image URLs"
          },
          "status": {
            "type": "string",
            "enum": [
              "success",
              "error"
            ]
          }
        }
      },
      "BreedsListResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "Object with breed names as keys and arrays of sub-breeds as values"
          },
          "status": {
            "type": "string",
            "enum": [
              "success",
              "error"
            ]
          }
        }
      },
      "SubBreedsListResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Array of sub-breed names"
          },
          "status": {
            "type": "string",
            "enum": [
              "success",
              "error"
            ]
          }
        }
      }
    }
  },
  "security": []
}
