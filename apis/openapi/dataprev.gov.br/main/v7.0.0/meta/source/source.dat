      "RefinanciamentoRequest": {
        "title": "OperacaoRefinRequest",
        "required": [
          "UFAPS",
          "classificadorModalidade",
          "codigoSolicitante",
          "cpfMutuario",
          "dataFimContrato",
          "dataInicioContrato",
          "dataPrimeiroDesconto",
          "listaContratosQuitados",
          "nomeMutuario",
          "numeroBeneficio",
          "numeroContrato",
          "numeroParcelas",
          "valorCETAnual",
          "valorCETMensal",
          "valorEmprestimo",
          "valorIOF",
          "valorPago",
          "valorParcela",
          "valorTaxaAnual",
          "valorTaxaMensal",
          "valorTroco"
        ],
        "type": "object",
        "properties": {
          "numeroBeneficio": {
            "type": "integer",
            "description": "Número do Benefício (NB)",
            "format": "int64"
          },
          "codigoSolicitante": {
            "type": "integer",
            "description": "Código do Solicitante (CBC)",
            "format": "int32"
          },
          "numeroContrato": {
            "maxLength": 20,
            "minLength": 0,
            "type": "string",
            "description": "Número do Contrato"
          },
          "cpfMutuario": {
            "type": "integer",
            "description": "CPF do Beneficiário",
            "format": "int64"
          },
          "nomeMutuario": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string",
            "description": "Nome do Beneficiário"
          },
          "dataInicioContrato": {
            "type": "string",
            "description": "Data de Início do Contrato no formato ddMMyyyy",
            "format": "ddMMyyyy",
            "example": "01012020"
          },
          "dataFimContrato": {
            "type": "string",
            "description": "Data Fim do Contrato no formato ddMMyyyy",
            "format": "ddMMyyyy",
            "example": "01012020"
          },
          "cbcIfPagadora": {
            "type": "integer",
            "description": "CBC da IF Pagadora",
            "format": "int32"
          },
          "agenciaPagadora": {
            "maximum": 9999,
            "type": "integer",
            "description": "Agência Pagadora",
            "format": "int32"
          },
          "contaCorrente": {
            "maxLength": 13,
            "minLength": 1,
            "type": "string",
            "description": "Conta Corrente"
          },
          "canalAtendimento": {
            "type": "integer",
            "description": "Canal de Atendimento",
            "format": "int32"
          },
          "competenciaInicioDesconto": {
            "type": "string",
            "description": "Competência de Início de Desconto no formato yyyyMM",
            "format": "yyyyMM",
            "example": "202401"
          },
          "classificadorModalidade": {
            "type": "integer",
            "description": "Tipo de Consignação",
            "format": "int32"
          },
          "numeroParcelas": {
            "maximum": 99,
            "type": "integer",
            "description": "Número de Parcelas",
            "format": "int32"
          },
          "valorEmprestimo": {
            "type": "number",
            "description": "Valor do Empréstimo"
          },
          "valorParcela": {
            "type": "number",
            "description": "Valor da Parcela"
          },
          "valorIOF": {
            "type": "number",
            "description": "Valor do IOF"
          },
          "valorTroco": {
            "type": "number",
            "description": "Valor do Troco"
          },
          "valorPago": {
            "type": "number",
            "description": "Valor Pago"
          },
