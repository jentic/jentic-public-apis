      "AverbacaoRMCRequest": {
        "title": "OperacaoAverbacaoRMCRequest",
        "required": [
          "UFAPS",
          "codigoSolicitante",
          "cpfMutuario",
          "dataInicioContrato",
          "nomeMutuario",
          "numeroBeneficio",
          "numeroContrato"
        ],
        "type": "object",
        "properties": {
          "numeroBeneficio": {
            "type": "integer",
            "description": "Número do Benefício (NB)",
            "format": "int64"
          },
          "codigoSolicitante": {
            "type": "integer",
            "description": "Código do Solicitante (CBC)",
            "format": "int32"
          },
          "numeroContrato": {
            "maxLength": 20,
            "minLength": 0,
            "type": "string",
            "description": "Número do Contrato"
          },
          "cpfMutuario": {
            "type": "integer",
            "description": "CPF do Beneficiário",
            "format": "int64"
          },
          "nomeMutuario": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string",
            "description": "Nome do Beneficiário"
          },
          "dataInicioContrato": {
            "type": "string",
            "description": "Data de Início do Contrato no formato ddMMyyyy",
            "format": "ddMMyyyy",
            "example": "01012020"
          },
          "cbcIfPagadora": {
            "type": "integer",
            "description": "CBC da IF Pagadora",
            "format": "int32"
          },
          "agenciaPagadora": {
            "maximum": 9999,
            "type": "integer",
            "description": "Agência Pagadora",
            "format": "int32"
          },
          "contaCorrente": {
            "maxLength": 13,
            "minLength": 1,
            "type": "string",
            "description": "Conta Corrente"
          },
          "canalAtendimento": {
            "type": "integer",
            "description": "Canal de Atendimento",
            "format": "int32"
          },
          "valorLimiteCartao": {
            "type": "number",
            "description": "Valor Limite Cartão"
          },
          "percentualRMC": {
            "type": "number",
            "description": "Percentual RMC"
          },
          "UFAPS": {
            "type": "string",
            "description": "UF da APS"
          },
          "CNPJCorrespondente": {
            "type": "integer",
            "description": "CNPJ do Correspondente Bancário",
            "format": "int64"
          },
          "CPFCorrespondente": {
            "type": "integer",
            "description": "CPF do Correspondente Bancário",
            "format": "int64"
          },
          "DVContaCorrente": {
            "maxLength": 1,
            "minLength": 1,
            "type": "string",
            "description": "Dígito Verificador da Conta Corrente"
          },
          "CNPJAgenciaBancaria": {
            "type": "integer",
            "description": "CNPJ da Agência Bancária",
            "format": "int64"
          }
        }
      },
