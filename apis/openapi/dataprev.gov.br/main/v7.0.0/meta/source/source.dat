      "SuspensaoTrabalhadorRequest": {
        "required": [
          "codigoInscricaoEmpregador",
          "codigoSolicitante",
          "cpfTrabalhador",
          "matricula",
          "numeroContrato",
          "numeroInscricaoEmpregador"
        ],
        "type": "object",
        "properties": {
          "cpfTrabalhador": {
            "type": "integer",
            "description": "CPF do Trabalhador",
            "format": "int64",
