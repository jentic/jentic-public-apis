        "properties": {
          "inicioDataHoraTransmissao": {
            "pattern": "^\\d{14}$",
            "type": "string",
            "format": "ddMMyyyyHHmmss"
          },
          "fimDataHoraTransmissao": {
            "pattern": "^\\d{14}$",
            "type": "string",
            "format": "ddMMyyyyHHmmss"
          },
          "hashOperacao": {
            "pattern": "^\\d{1,15}$",
            "type": "string"
          },
          "cpfTitular": {
            "pattern": "^\\d{1,11}$",
            "type": "string"
          },
          "idIfRequisicao": {
            "type": "integer",
            "format": "int32"
          },
          "idIfSolicitante": {
            "type": "integer",
            "format": "int32"
          },
          "numeroBeneficio": {
            "pattern": "^\\d{1,12}$",
            "type": "string"
          },
          "idOperacao": {
            "type": "integer",
            "format": "int32"
          },
          "numeroContrato": {
            "maxLength": 20,
            "minLength": 0,
            "type": "string"
          },
          "statusRetorno": {
            "type": "integer",
            "format": "int32"
          },
          "codigoFamiliar": {
            "pattern": "^\\d{1,11}$",
            "type": "string"
          },
          "matricula": {
            "type": "string"
          },
          "codigoInscricaoEmpregador": {
            "type": "integer",
            "format": "int32"
          },
          "numeroInscricaoEmpregador": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
