      "ExclusaoPortabilidadeRequest": {
        "title": "OperacaoExclusaoPortabilidadeRequest",
        "required": [
          "codigoOrigem",
          "codigoProponente",
          "listaContratosExcluidos",
          "numeroBeneficio",
          "numeroUnico"
        ],
        "type": "object",
        "properties": {
          "numeroUnico": {
            "maximum": 1e+21,
            "minimum": 0,
            "type": "integer",
            "description": "Número Único"
          },
          "numeroBeneficio": {
            "type": "integer",
            "description": "Número do Benefício (NB)",
            "format": "int64"
          },
          "codigoOrigem": {
            "maximum": 999,
            "minimum": 1,
            "type": "integer",
            "description": "Código do Solicitante de Origem (CBC)",
            "format": "int32"
          },
          "codigoProponente": {
            "maximum": 999,
            "minimum": 1,
            "type": "integer",
            "description": "Código do Solicitante do Proponente (CBC)",
            "format": "int32"
          },
          "listaContratosExcluidos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DadosContratoExcluidoPortabilidade"
            }
          }
        }
      },
