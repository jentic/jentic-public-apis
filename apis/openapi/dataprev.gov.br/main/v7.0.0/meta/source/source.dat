      "DadosInclusaoDescontoCartaoRequest": {
        "title": "DadosInclusaoDescontoCartaoRequest",
        "required": [
          "codigoSolicitante",
          "numeroBeneficio",
          "numeroContrato",
          "valorCETAnual",
          "valorCETMensal",
          "valorDesconto",
          "valorIOF",
          "valorSaldoLimiteCartao",
          "valorTaxaAnual",
          "valorTaxaMensal",
          "valorUtilizadoMesCartao"
        ],
        "type": "object",
        "properties": {
          "numeroBeneficio": {
            "type": "integer",
            "description": "Número do Benefício (NB)",
            "format": "int64",
            "example": 8817819997
          },
          "codigoSolicitante": {
            "type": "integer",
            "description": "Código do Solicitante (CBC)",
            "format": "int32",
            "example": 997
          },
          "numeroContrato": {
            "maxLength": 20,
            "minLength": 0,
            "type": "string",
            "description": "Número do Contrato",
            "example": "1997123478"
          },
          "classificadorModalidade": {
            "type": "integer",
            "description": "Código do tipo de consignação: 77 ou 99",
            "format": "int32",
            "example": 77
          },
          "valorSaldoLimiteCartao": {
            "type": "number",
            "description": "Valor do Saldo Limite do Cartão",
            "example": 2500
          },
          "valorUtilizadoMesCartao": {
            "type": "number",
            "description": "Valor Utilizado no Mês Cartão",
            "example": 500
          },
          "valorDesconto": {
            "type": "number",
            "description": "Valor do Desconto",
            "example": 100
          },
          "valorIOF": {
            "type": "number",
            "description": "Valor do IOF",
            "example": 0.1
          },
          "valorTaxaAnual": {
            "type": "number",
            "description": "Percentual da Taxa de Juros Anual",
            "example": 0.9
          },
          "valorCETAnual": {
            "type": "number",
            "description": "Percentual do CET (Custo Efetivo Total) Anual",
            "example": 1.2
          },
          "valorTaxaMensal": {
            "type": "number",
            "description": "Percentual da Taxa de Juros Mensal",
            "example": 0.4
          },
          "valorCETMensal": {
            "type": "number",
            "description": "Percentual do CET (Custo Efetivo Total) Mensal",
            "example": 0.5
          }
        },
        "description": "Dados de Inclusão de Desconto de Cartão"
      },
      "InclusaoDescontoCartaoRequest": {
        "required": [
          "inclusaoDescontoCartao"
        ],
        "type": "object",
        "properties": {
          "inclusaoDescontoCartao": {
            "type": "array",
            "description": "Dados de Inclusão de Desconto de Cartão",
            "items": {
              "$ref": "#/components/schemas/DadosInclusaoDescontoCartaoRequest"
            }
          }
        }
      },
