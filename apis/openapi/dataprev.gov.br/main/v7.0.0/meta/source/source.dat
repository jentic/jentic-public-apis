      "ExclusaoRmaRequest": {
        "title": "ExclusaoDescontoCartaoRMARequest",
        "required": [
          "codigoSolicitante",
          "motivoExclusao",
          "numeroBeneficio",
          "numeroContrato"
        ],
        "type": "object",
        "properties": {
          "numeroBeneficio": {
            "type": "integer",
            "description": "Número do Benefício (NB)",
            "format": "int64",
            "example": 8858585850
          },
          "codigoSolicitante": {
            "type": "integer",
            "description": "Código do Solicitante (CBC)",
            "format": "int32",
            "example": 999
          },
          "numeroContrato": {
            "maxLength": 20,
            "minLength": 0,
            "type": "string",
            "description": "Número do Contrato",
            "example": "199912345678"
          },
          "motivoExclusao": {
            "type": "integer",
            "description": "Motivo Exclusão",
            "format": "int32",
            "example": 5
          }
        }
      },
