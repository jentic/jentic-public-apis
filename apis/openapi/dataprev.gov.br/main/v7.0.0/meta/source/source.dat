            "format": "int64"
          },
          "codigoSolicitante": {
            "type": "integer",
            "description": "Código do Solicitante (CBC)",
            "format": "int32"
          },
          "numeroContrato": {
            "type": "string",
            "description": "Número do Contrato"
          }
        }
      },
