      "AverbacaoPortabilidadeTrabalhadorRequest": {
        "title": "AverbacaoPortabilidadeTrabalhadorRequest",
        "required": [
          "codigoInscricaoEmpregador",
          "codigoSolicitante",
          "cpfTrabalhador",
          "dataFimContrato",
          "dataInicioContrato",
          "dataPrimeiroDesconto",
          "matricula",
          "nomeTrabalhador",
          "numeroContrato",
          "numeroInscricaoEmpregador",
          "numeroParcelas",
          "numeroUnico",
          "valorCETAnual",
          "valorCETMensal",
          "valorEmprestimo",
          "valorPago",
          "valorParcela",
          "valorTaxaAnual",
          "valorTaxaMensal"
        ],
        "type": "object",
        "properties": {
          "codigoSolicitante": {
            "type": "integer",
            "description": "Código do Solicitante (CBC)",
            "format": "int32",
            "example": 999
          },
          "numeroContrato": {
            "type": "string",
            "description": "Número de Contrato",
            "example": "199912345678"
          },
          "numeroUnico": {
            "maximum": 1e+21,
            "minimum": 0,
            "type": "integer",
            "description": "Número Único",
            "example": 7234567890123457000
          },
          "cpfTrabalhador": {
            "type": "integer",
            "description": "CPF do Trabalhador",
            "format": "int64",
            "example": 87070728050
          },
          "matricula": {
            "maxLength": 30,
            "minLength": 1,
            "type": "string",
            "description": "Matrícula do Trabalhador",
            "example": "MAT213"
          },
          "codigoInscricaoEmpregador": {
            "type": "integer",
            "description": "Tipo de Inscrição do Empregador",
            "format": "int32",
            "example": 1
          },
          "numeroInscricaoEmpregador": {
            "type": "integer",
            "description": "Número de Inscrição do Empregador",
            "format": "int64",
            "example": 66106660000160
          },
          "nomeTrabalhador": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string",
            "description": "Nome do Trabalhador",
            "example": "Trabalhador Fulano de tal"
          },
          "competenciaInicioDesconto": {
            "type": "integer",
            "description": "Competência de Início de Desconto no formato yyyyMM",
            "format": "int32",
            "example": 202501
          },
          "dataPrimeiroDesconto": {
            "type": "string",
            "description": "Data do primeiro desconto no formato ddMMyyyy",
            "format": "ddMMyyyy",
            "example": "01012020"
          },
          "dataInicioContrato": {
            "type": "string",
            "description": "Data de Início do Contrato no formato ddMMyyyy",
            "format": "ddMMyyyy",
            "example": "01012025"
          },
          "dataFimContrato": {
            "type": "string",
            "description": "Data Fim do Contrato no formato ddMMyyyy",
            "format": "ddMMyyyy",
            "example": "01012025"
          },
          "numeroParcelas": {
            "maximum": 999,
            "type": "integer",
            "description": "Número de Parcelas",
            "format": "int32",
            "example": 10
          },
          "valorParcela": {
            "type": "number",
            "description": "Valor da Parcela",
            "example": 100
          },
          "valorEmprestimo": {
            "type": "number",
            "description": "Valor do Empréstimo",
            "example": 1000
          },
