      "InfoContratoTrabalhadorRequest": {
        "required": [
          "codigoInscricaoEmpregador",
          "codigoSolicitante",
          "contratoEmprestimo",
          "cpfTrabalhador",
          "dataHoraAssinatura",
          "indicadorAnalfabetismo",
          "indicadorAssinaturaCertDigitalICPBrasil",
          "ip",
          "matricula",
          "numeroContrato",
          "numeroInscricaoEmpregador"
        ],
        "type": "object",
        "properties": {
          "codigoSolicitante": {
            "type": "integer",
            "description": "Código do Solicitante (CBC)",
            "format": "int32",
            "example": 997
          },
          "numeroContrato": {
            "type": "string",
            "description": "Número do Contrato",
            "example": "199712345678"
          },
          "cpfTrabalhador": {
            "type": "integer",
            "description": "CPF do Trabalhador",
            "format": "int64",
            "example": 87070728050
          },
          "matricula": {
            "maxLength": 30,
            "minLength": 1,
            "type": "string",
            "description": "Matrícula do Trabalhador",
            "example": "MAT-99999999999999213"
          },
          "codigoInscricaoEmpregador": {
            "type": "integer",
            "description": "Tipo de Inscrição do Empregador",
            "format": "int32",
            "example": 1
          },
          "numeroInscricaoEmpregador": {
            "type": "integer",
            "description": "Número de Inscrição do Empregador",
            "format": "int64",
            "example": 66106660000160
          },
          "contratoEmprestimo": {
            "type": "string",
            "description": "Cópia digital do contrato de empréstimo"
          },
          "indicadorAssinaturaCertDigitalICPBrasil": {
            "type": "boolean",
            "description": "Indicador de Certificacao Digital ICP Brasil"
          },
          "ip": {
            "pattern": "((^\\s*((([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5]))\\s*$)|(^\\s*((([0-9A-Fa-f]{1,4}:){7}([0-9A-Fa-f]{1,4}|:))|(([0-9A-Fa-f]{1,4}:){6}(:[0-9A-Fa-f]{1,4}|((25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)(\\.(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)){3})|:))|(([0-9A-Fa-f]{1,4}:){5}(((:[0-9A-Fa-f]{1,4}){1,2})|:((25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)(\\.(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)){3})|:))|(([0-9A-Fa-f]{1,4}:){4}(((:[0-9A-Fa-f]{1,4}){1,3})|((:[0-9A-Fa-f]{1,4})?:((25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)(\\.(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)){3}))|:))|(([0-9A-Fa-f]{1,4}:){3}(((:[0-9A-Fa-f]{1,4}){1,4})|((:[0-9A-Fa-f]{1,4}){0,2}:((25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)(\\.(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)){3}))|:))|(([0-9A-Fa-f]{1,4}:){2}(((:[0-9A-Fa-f]{1,4}){1,5})|((:[0-9A-Fa-f]{1,4}){0,3}:((25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)(\\.(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)){3}))|:))|(([0-9A-Fa-f]{1,4}:){1}(((:[0-9A-Fa-f]{1,4}){1,6})|((:[0-9A-Fa-f]{1,4}){0,4}:((25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)(\\.(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)){3}))|:))|(:(((:[0-9A-Fa-f]{1,4}){1,7})|((:[0-9A-Fa-f]{1,4}){0,5}:((25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)(\\.(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)){3}))|:)))(%.+)?\\s*$))",
            "type": "string",
            "description": "IP (Internet Protocol)"
          },
          "dataHoraAssinatura": {
            "type": "string",
            "description": "Data e Hora da Assinatura",
            "format": "ddMMyyyyHHmmss"
          },
          "indicadorAnalfabetismo": {
            "type": "boolean",
            "description": "Indicador de analfabetismo"
          },
          "documentoOficialComFotoFrente": {
            "type": "string",
            "description": "Imagem 2D em jpg, convertida para Base 64 - Frente"
          },
          "documentoOficialComFotoVerso": {
            "type": "string",
            "description": "Imagem 2D em jpg, convertida para Base 64 - Verso"
          },
          "registroBiometricoFacial": {
            "type": "string",
            "description": "Imagem 2D em jpg, convertida para Base 64"
          },
          "baseBiometrica": {
            "type": "string",
            "description": "Base Biométrica do Governo"
          },
          "score": {
            "type": "number",
            "description": "Score / Similaridade"
          },
          "indicadorValidacaoComDocOficial": {
            "type": "boolean",
            "description": "Indicador de validação a partir de documento oficial"
          },
          "latitude": {
            "type": "number",
            "description": "Latitude"
          },
          "longitude": {
            "type": "number",
            "description": "Longitude"
          },
          "dispositivo": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string",
            "description": "dispositivo"
          },
          "nsuContrato": {
            "maximum": 1000000000000000000,
            "type": "integer",
            "description": "NSU do Contrato",
            "format": "int64"
          },
          "tipoAutenticacao": {
            "type": "integer",
            "description": "Tipo de Autenticação",
            "format": "int32"
          }
        }
      },
