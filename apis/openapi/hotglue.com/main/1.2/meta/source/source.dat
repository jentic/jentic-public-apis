                                            },
                                            "description": {
                                                "type": "string",
                                                "example": "Sales records from your system"
                                            },
                                            "taps": {
                                                "type": "array",
                                                "items": {
                                                    "type": "string",
                                                    "example": "salesforce"
                                                }
                                            },
                                            "targets": {
                                                "type": "array",
                                                "items": {
                                                    "type": "string",
                                                    "example": "s3"
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "400",
                        "content": {
                            "application/json": {
                                "examples": {
