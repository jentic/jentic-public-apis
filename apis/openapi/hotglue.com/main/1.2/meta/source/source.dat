                    "200": {
                        "description": "200",
                        "content": {
                            "application/json": {
                                "examples": {
                                    "Result": {
                                        "value": {
                                            "ScheduleExpression": "cron(0 0 ? * SUN *)",
                                            "State": "DISABLED",
                                            "ScheduleJitterMinutes": 60,
                                            "ExtraArgs": {
                                                "override_start_date": "2000-01-01"
                                            }
                                        }
                                    }
                                },
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "ScheduleExpression": {
                                            "type": "string",
                                            "example": "cron(0 0 ? * SUN *)"
                                        },
                                        "State": {
                                            "type": "string",
                                            "example": "DISABLED"
                                        },
                                        "ScheduleJitterMinutes": {
                                            "type": [
                                                "integer",
                                                "null"
                                            ],
                                            "example": 60
                                        },
                                        "ExtraArgs": {
                                            "type": "object",
                                            "example": {
