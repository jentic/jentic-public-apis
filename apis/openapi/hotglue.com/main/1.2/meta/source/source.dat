                            "type": "string",
                            "example": "api"
                        },
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Presigned upload URL generated",
                        "content": {
                            "application/json": {
                                "examples": {
                                    "Result": {
                                        "value": {
                                            "presigned_url": "https://s3.amazonaws.com/example-bucket/example-key?X-Amz-Algorithm=AWS4-HMAC-SHA256&X-Amz-Credential=..."
