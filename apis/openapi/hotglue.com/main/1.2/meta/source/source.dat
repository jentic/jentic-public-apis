                        },
                        "required": true
                    },
                    {
                        "name": "count",
                        "in": "query",
                        "description": "Number of jobs to return (sorted chronologically)",
                        "schema": {
                            "type": "integer",
                            "format": "int32",
                            "default": 5
                        }
                    },
                    {
                        "name": "scheduled",
                        "in": "query",
                        "description": "Query for scheduled jobs only",
                        "schema": {
