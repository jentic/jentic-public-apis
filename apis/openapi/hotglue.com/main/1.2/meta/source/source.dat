            "get": {
                "summary": "Fetch jobs",
                "description": "Returns a list of job details for a specified tenant. Note that this endpoint does not return raw data fetched in jobs.",
                "operationId": "jobs-retrieve",
                "parameters": [
                    {
                        "name": "env_id",
                        "in": "path",
                        "description": "ID of environment",
                        "schema": {
                            "type": "string"
                        },
