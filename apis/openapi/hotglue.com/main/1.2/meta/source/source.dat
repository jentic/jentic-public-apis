        "/tenant/{env_id}/{tenant}": {
            "delete": {
                "summary": "Delete a tenant",
                "description": "Delete all of a tenants data and optionally revoke OAuth connections",
                "operationId": "tenants-delete",
                "parameters": [
                    {
