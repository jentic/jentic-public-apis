        },
        "description": "Comma-separated list of field names to return"
      },
      "filter": {
        "name": "filter",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string"
        },
        "description": "Filter expression (e.g., 'record_date:gte:2023-01-01,country:eq:Canada')"
      },
      "sort": {
        "name": "sort",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string"
        },
        "description": "Comma-separated list of fields to sort by (prefix with '-' for descending)"
      },
      "format": {
        "name": "format",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "enum": [
