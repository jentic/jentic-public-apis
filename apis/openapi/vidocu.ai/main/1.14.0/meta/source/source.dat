      "post": {
        "tags": [
          "Remix"
        ],
        "summary": "Create a remix",
        "description": "From a workspace video (videoId) or an external URL (videoUrl + durationSec). Creating doesn't analyze — call analyze next.\n\n**Scope:** `remixes:write`\n\n**Role permission:** `canCreate` (OAuth only — API keys carry full workspace permissions)",
        "operationId": "postV1Remixes",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "videoId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "videoUrl": {
                    "type": "string",
                    "format": "uri"
                  },
                  "durationSec": {
                    "type": "number",
                    "exclusiveMinimum": true,
                    "minimum": 0,
                    "maximum": 43200
                  },
                  "projectId": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Validation error",
