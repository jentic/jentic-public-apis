    "/v1/ai-media/stills": {
      "post": {
        "tags": [
          "Studio"
        ],
        "summary": "Generate AI stills",
        "description": "1-4 still frames for one shot, in the chosen style. Each still that succeeds is charged; a refused one costs nothing.\n\n**Scope:** `studio:write`\n\n**Role permission:** `canCreate` (OAuth only — API keys carry full workspace permissions)",
        "operationId": "postV1Ai-mediaStills",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "shot": {
                    "type": "object",
                    "properties": {
                      "subject": {
                        "type": "string",
                        "maxLength": 300
                      },
                      "action": {
                        "type": "string",
                        "maxLength": 300
                      },
                      "setting": {
                        "type": "string",
                        "maxLength": 300
                      },
                      "framing": {
                        "type": "string",
                        "maxLength": 300
                      },
                      "camera": {
                        "type": "string",
                        "maxLength": 300
                      },
                      "lighting": {
                        "type": "string",
                        "maxLength": 300
                      }
                    },
                    "additionalProperties": false,
                    "description": "One shot, as short phrases. Get one from POST /v1/ai-media/shot, or write it yourself."
                  },
                  "preset": {
                    "type": "string",
                    "enum": [
                      "documentary",
                      "studio",
                      "onSite",
                      "cinematic",
                      "isometric3d",
                      "flat2d",
                      "cartoon3d",
                      "storybook",
                      "claymation",
                      "whiteboard",
                      "classroom",
                      "brand"
                    ]
                  },
                  "styleNote": {
                    "type": "string",
                    "maxLength": 400,
                    "description": "Your own style words on top of the preset, e.g. \"navy coveralls, pastel colors\""
                  },
                  "aspectRatio": {
                    "type": "string",
                    "enum": [
                      "16:9",
                      "9:16"
                    ],
                    "description": "Default 16:9"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4,
                    "description": "Stills to generate, each charged. Default 1"
                  },
                  "referenceUrl": {
                    "type": "string",
                    "format": "uri",
                    "description": "An image in this workspace whose people and setting the stills should keep"
                  },
                  "studioProjectId": {
                    "type": "string"
                  }
                },
                "required": [
                  "shot"
                ],
                "additionalProperties": false
              }
            }
          }
        },
