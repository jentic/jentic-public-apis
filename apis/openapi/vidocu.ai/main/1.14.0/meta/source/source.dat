      "post": {
        "tags": [
          "Knowledge Center"
        ],
        "summary": "Create an article",
        "description": "**Scope:** `knowledge_base:write`\n\n**Role permission:** `canCreate` (OAuth only — API keys carry full workspace permissions)",
        "operationId": "postV1Knowledge-baseArticles",
        "requestBody": {
          "required": false,
