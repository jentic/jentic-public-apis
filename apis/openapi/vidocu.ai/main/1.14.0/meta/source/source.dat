      "patch": {
        "tags": [
          "Courses"
        ],
        "summary": "Update a course",
        "description": "Title, planner instructions, project folder, and the access + completion settings for the learner link. Modules and status are owned by the pipeline. Settings are merged, so a partial patch leaves the fields it does not name alone.\n\n**Scope:** `courses:write`\n\n**Role permission:** `canEdit` (OAuth only — API keys carry full workspace permissions)",
        "operationId": "patchV1CoursesId",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "userInstructions": {
                    "type": "string",
                    "maxLength": 5000
                  },
                  "projectId": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1
                  },
                  "settings": {
                    "type": "object",
                    "properties": {
                      "access": {
                        "type": "object",
                        "properties": {
                          "identity": {
                            "type": "string",
                            "enum": [
                              "anonymous",
                              "name",
                              "email_name",
                              "email_verified",
                              "auth"
                            ]
                          },
                          "openEnrollment": {
                            "type": "boolean"
                          },
                          "allowedEmailDomains": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 253
                            },
                            "maxItems": 50
                          },
                          "invitedEmails": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "format": "email"
                            },
                            "maxItems": 2000
                          },
                          "allowRoster": {
                            "type": "boolean"
                          }
                        },
                        "additionalProperties": false
                      },
                      "completion": {
                        "type": "object",
                        "properties": {
                          "rule": {
                            "type": "string",
                            "enum": [
                              "watch",
                              "watch_quiz",
                              "manual"
                            ]
                          },
                          "watchThresholdPct": {
                            "type": "integer",
                            "minimum": 10,
                            "maximum": 100
                          },
                          "sequential": {
                            "type": "boolean"
                          }
                        },
                        "additionalProperties": false
                      },
                      "trackProgress": {
                        "type": "boolean"
                      }
                    },
                    "additionalProperties": false
                  },
                  "accessCode": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 200
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Validation error",
            "content": {
