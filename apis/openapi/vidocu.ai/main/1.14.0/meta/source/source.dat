    "/v1/ai-media/clips": {
      "post": {
        "tags": [
          "Studio"
        ],
        "summary": "Animate a still into a clip",
        "description": "A 4, 6 or 8 second clip from a still, with generated ambient sound (place it at volume 0 for none). Usually takes under a minute: poll GET /v1/ai-media/:id. Charged when it completes.\n\n**Scope:** `studio:write`\n\n**Role permission:** `canCreate` (OAuth only — API keys carry full workspace permissions)",
        "operationId": "postV1Ai-mediaClips",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "stillId": {
                    "type": "string",
                    "description": "A completed still to animate (the usual path)"
                  },
                  "imageUrl": {
                    "type": "string",
                    "format": "uri",
                    "description": "Or any image file in this workspace"
                  },
                  "shot": {
                    "type": "object",
                    "properties": {
                      "subject": {
                        "type": "string",
                        "maxLength": 300
                      },
                      "action": {
                        "type": "string",
                        "maxLength": 300
                      },
                      "setting": {
                        "type": "string",
                        "maxLength": 300
                      },
                      "framing": {
                        "type": "string",
                        "maxLength": 300
                      },
                      "camera": {
                        "type": "string",
                        "maxLength": 300
                      },
                      "lighting": {
                        "type": "string",
                        "maxLength": 300
                      }
                    },
                    "additionalProperties": false,
                    "description": "Overrides the still's shot, field by field"
                  },
                  "preset": {
                    "type": "string",
                    "enum": [
                      "documentary",
                      "studio",
                      "onSite",
                      "cinematic",
                      "isometric3d",
                      "flat2d",
                      "cartoon3d",
                      "storybook",
                      "claymation",
                      "whiteboard",
                      "classroom",
                      "brand"
                    ]
                  },
                  "aspectRatio": {
                    "type": "string",
                    "enum": [
                      "16:9",
                      "9:16"
                    ]
                  },
                  "durationSec": {
                    "type": "number",
                    "description": "4, 6 or 8 seconds. Default 6"
                  },
                  "resolution": {
                    "type": "string",
