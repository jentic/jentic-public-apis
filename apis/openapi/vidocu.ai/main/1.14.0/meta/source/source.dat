      "patch": {
        "tags": [
          "Knowledge Center"
        ],
        "summary": "Update the knowledge base",
        "description": "Changing the slug changes the public URL — add a redirect for existing links.\n\n**Scope:** `knowledge_base:write`\n\n**Role permission:** `canEditSettings` (OAuth only — API keys carry full workspace permissions)",
        "operationId": "patchV1Knowledge-base",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "slug": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 80,
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                  },
                  "defaultLocale": {
                    "type": "string",
                    "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})?$"
                  },
                  "enabledLocales": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})?$"
                    },
                    "maxItems": 60
                  },
                  "visibility": {
                    "type": "string",
                    "enum": [
                      "public",
                      "gated"
                    ]
                  },
                  "access": {
                    "type": "object",
                    "properties": {
                      "openSignup": {
                        "type": "boolean",
                        "description": "true lets any email sign in. false limits sign-in to the lists below."
                      },
                      "allowedEmailDomains": {
                        "type": "array",
                        "items": {
                          "allOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "string",
                              "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$"
                            }
                          ]
                        },
                        "maxItems": 200,
                        "description": "Email domains with full access to every section, e.g. [\"acme.com\"]."
                      },
                      "explicitAllowedEmails": {
                        "type": "array",
                        "items": {
                          "allOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "string",
                              "pattern": "^[^@\\s]+@[a-z0-9-]+(\\.[a-z0-9-]+)+$"
                            }
                          ]
                        },
                        "maxItems": 500,
                        "description": "Individual addresses with full access to every section."
                      },
                      "authMethod": {
                        "type": "string",
                        "enum": [
                          "magic-link",
                          "vidocu"
                        ],
                        "description": "How readers prove who they are: an emailed link, or a Vidocu account."
                      },
                      "sharedSectionsRequireApproval": {
                        "type": "boolean",
                        "description": "When true, an article in a section shared with outside readers shows only while its package is approved and locked. Who may put an article in a section is the section's publishers list."
                      }
                    },
                    "additionalProperties": false,
                    "description": "Sign-in rules for a gated knowledge base. Fields you leave out are kept."
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 40
                        },
                        "color": {
                          "type": "string",
                          "pattern": "^#[0-9a-f]{6}$"
                        }
                      },
                      "required": [
                        "name",
                        "color"
                      ],
                      "additionalProperties": false
                    },
                    "maxItems": 50
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Missing scope (`insufficient_scope`), insufficient role (`insufficient_role`), or quota exhausted (`limit_exceeded`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded (60 req/min)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
