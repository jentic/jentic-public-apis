    "/v1/ai-media/shot": {
      "post": {
        "tags": [
          "Studio"
        ],
        "summary": "Plan an AI shot",
        "description": "Turns a description (and the narration it plays under) into an editable shot, plus warnings for what AI video does badly: readable text, logos, software screens, real people, exact steps. Free.\n\n**Scope:** `studio:write`\n\n**Role permission:** `canCreate` (OAuth only — API keys carry full workspace permissions)",
        "operationId": "postV1Ai-mediaShot",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "description": {
                    "type": "string",
                    "maxLength": 2000,
                    "description": "What the shot should show"
                  },
                  "narration": {
                    "type": "string",
                    "maxLength": 2000,
                    "description": "The narration the shot plays under"
                  },
                  "preset": {
                    "type": "string",
                    "enum": [
                      "documentary",
                      "studio",
                      "onSite",
                      "cinematic",
                      "isometric3d",
                      "flat2d",
                      "cartoon3d",
                      "storybook",
                      "claymation",
                      "whiteboard",
                      "classroom",
                      "brand"
                    ],
                    "description": "Visual style. Default documentary"
                  },
                  "styleNote": {
                    "type": "string",
                    "maxLength": 400,
                    "description": "Your own style words on top of the preset"
                  },
                  "current": {
                    "type": "object",
                    "properties": {
                      "subject": {
                        "type": "string",
                        "maxLength": 300
                      },
                      "action": {
                        "type": "string",
                        "maxLength": 300
                      },
                      "setting": {
                        "type": "string",
                        "maxLength": 300
                      },
                      "framing": {
                        "type": "string",
                        "maxLength": 300
                      },
                      "camera": {
                        "type": "string",
                        "maxLength": 300
                      },
                      "lighting": {
                        "type": "string",
                        "maxLength": 300
                      }
                    },
                    "additionalProperties": false,
                    "description": "Refine: the shot as it is now"
                  },
                  "change": {
                    "type": "string",
                    "maxLength": 300,
                    "description": "Refine: the change to make, e.g. \"darker, closer\""
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Missing scope (`insufficient_scope`), insufficient role (`insufficient_role`), or quota exhausted (`limit_exceeded`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded (60 req/min)",
            "content": {
              "application/json": {
