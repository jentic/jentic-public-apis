    "/v1/modules/planner/qualification": {
      "post": {
        "tags": [
          "Training Modules"
        ],
        "summary": "Withdraw or block a qualification",
        "description": "Takes a qualification away from one or more people, with a reason. `withdraw` lets them earn it back by passing again; `block` bars them from earning it again, and no later pass or sign-off lifts it. Recorded as a row rather than a delete, so the record keeps showing that the person was qualified and who took it away.\n\n**Scope:** `modules:write`\n\n**Role permission:** `canLock` (OAuth only — API keys carry full workspace permissions)",
        "operationId": "postV1ModulesPlannerQualification",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "moduleId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "emails": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "email"
                    },
                    "minItems": 1,
                    "maxItems": 200
                  },
                  "action": {
                    "type": "string",
                    "enum": [
                      "withdraw",
                      "block"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  }
                },
                "required": [
                  "moduleId",
                  "emails",
                  "action",
                  "reason"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Missing scope (`insufficient_scope`), insufficient role (`insufficient_role`), or quota exhausted (`limit_exceeded`)",
            "content": {
              "application/json": {
                "schema": {
