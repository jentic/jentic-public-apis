                "properties": {
                  "approvers": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1,
                    "maxItems": 20
                  },
                  "message": {
                    "type": "string",
                    "maxLength": 2000
