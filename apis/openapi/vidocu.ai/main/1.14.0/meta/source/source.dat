      "post": {
        "tags": [
          "Knowledge Center"
        ],
        "summary": "Create a section",
        "description": "**Scope:** `knowledge_base:write`\n\n**Role permission:** `canEdit` (OAuth only — API keys carry full workspace permissions)",
        "operationId": "postV1Knowledge-baseSections",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "slug": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 80,
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "thumbnailUrl": {
                    "type": "string",
                    "format": "uri",
                    "maxLength": 2048,
                    "description": "Publicly reachable image URL shown on the section's card. Square or 16:9 depending on the knowledge base's thumbnail setting."
                  },
                  "visibility": {
                    "type": "string",
                    "enum": [
                      "public",
                      "staff",
                      "customers"
                    ]
                  },
                  "parentId": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1,
                    "description": "Id of a top-level section to nest under. null (or omitted) makes this a top-level section. One level deep only."
                  },
                  "translations": {
                    "type": "object",
                    "additionalProperties": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "properties": {
                        "name": {
                          "type": "string",
                          "maxLength": 120
                        },
                        "description": {
                          "type": "string",
                          "maxLength": 500
                        }
                      },
                      "additionalProperties": false
                    },
                    "description": "Section name and description in other languages, keyed by locale code (e.g. {\"fr\": {\"name\": \"Premiers pas\"}}). Only the knowledge base's enabled, non-default locales. On update, locales you leave out are kept and null removes one. A missing field falls back to the main-language text."
                  },
                  "sharedWith": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "properties": {
                      "emailDomains": {
                        "type": "array",
                        "items": {
                          "allOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "string",
                              "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$"
                            }
                          ]
                        },
                        "maxItems": 200
                      },
                      "emails": {
                        "type": "array",
                        "items": {
                          "allOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "string",
                              "pattern": "^[^@\\s]+@[a-z0-9-]+(\\.[a-z0-9-]+)+$"
                            }
                          ]
                        },
                        "maxItems": 200
                      }
                    },
                    "additionalProperties": false,
                    "description": "Share a top-level section with outside readers on a gated knowledge base: they sign in and see only the sections shared with them. The knowledge base's own access list keeps full access. null or empty lists stop sharing. Sub-sections follow their parent and cannot be shared themselves."
                  },
                  "publishers": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "properties": {
                      "userIds": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        },
                        "maxItems": 500
                      }
                    },
                    "required": [
                      "userIds"
                    ],
                    "additionalProperties": false,
                    "description": "Restrict who may create, move or publish articles in this section to these workspace members (user ids). Owners and admins always may, so an empty list means owners and admins only. null removes the restriction. A sub-section without its own list follows its parent. Only owners and admins can read or change it."
                  }
                },
                "required": [
                  "name",
                  "slug"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Missing scope (`insufficient_scope`), insufficient role (`insufficient_role`), or quota exhausted (`limit_exceeded`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded (60 req/min)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
