404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}}}},"/companies":{"post":{"tags":["Companies"],"summary":"Create a company","description":"Creates a company. If the domain already exists within the organization, returns 200 with the existing company id (idempotent-style create).","operationId":"createCompany","x-required-scope":"companies:write","security":[{"ApiKeyHeader":[]},{"BearerAuth":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CompanyCreateRequest"}}}},"responses":{"200":{"description":"Company already exists in this organization; existing id returned","headers":{"X-RateLimit-Limit":{"$ref":"#/components/headers/XRateLimitLimit"},"X-RateLimit-Remaining":{"$ref":"#/components/headers/XRateLimitRemaining"},"X-RateLimit-Reset":{"$ref":"#/components/headers/XRateLimitReset"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CompanyIdSuccessResponse"}}}},"201":{"description":"Company created","headers":{"Location":{"$ref":"#/components/headers/LocationHeader"},"X-RateLimit-Limit":{"$ref":"#/components/headers/XRateLimitLimit"},"X-RateLimit-Remaining":{"$ref":"#/components/headers/XRateLimitRemaining"},"X-RateLimit-Reset":{"$ref":"#/components/headers/XRateLimitReset"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CompanyIdSuccessResponse"}}}},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"409":{"$ref":"#/components/responses/Error409"},"422":{"$ref":"#/components/responses/Error422"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}}}},"/interactions/{interactionId}":{"get":{"tags":["Interactions"],"summary":"Get an interaction by ID","operationId":"getInteraction","x-required-scope":"interactions:read","security":[{"ApiKeyHeader":[]},{"BearerAuth":[]}],"parameters