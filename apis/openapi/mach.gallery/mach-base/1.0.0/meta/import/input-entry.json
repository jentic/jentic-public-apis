                    "pattern": "^0x[0-9a-fA-F]{40}$",
                    "description": "Smart-contract address on Base mainnet."
                  },
                  "data": {
                    "type": "string",
                    "pattern": "^0x[0-9a-fA-F]*$",
                    "maxLength": 32770,
                    "description": "0x-prefixed ABI calldata for a read-only eth_call."
                  },
                  "block": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "integer",
                        "minimum": 0
                      }
                    ],
                    "description": "Base block selector: block number or tag such as latest, safe, finalized, pending or earliest."
                  }
                },
                "required": [
                  "to",
                  "data"
                ]
              },
              "example": {
                "to": "0x4200000000000000000000000000000000000006",
                "data": "0x",
                "block": "latest"
              }
            }
          }
        }
      }
