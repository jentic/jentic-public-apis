  "paths": {
    "/api/base/block-number": {
      "get": {
        "operationId": "getbase_block_number",
        "summary": "Get the current Base mainnet block number (latest chain height) for an autonomous agent.",
        "description": "Get the current Base mainnet block number (latest chain height) for an autonomous agent.",
        "tags": [
          "base",
          "blockchain",
          "block-height",
          "onchain",
          "rpc"
        ],
        "x-mach-price": "$0.005",
        "x-price-usd": "$0.005",
        "x-x402-network": "eip155:8453",
        "x-x402-payment": "USDC exact payment via x402 v2",
        "responses": {
          "200": {
            "description": "Paid result."
          },
          "402": {
            "description": "x402 payment required.",
            "headers": {
              "PAYMENT-REQUIRED": {
                "description": "Base64-encoded x402 v2 payment requirements.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "description": "Invalid or unsupported request."
          }
        }
      }
    },
