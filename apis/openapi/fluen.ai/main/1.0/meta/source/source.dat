ype":"object"}},{"name":"principal","in":"query","required":false,"style":"form","schema":{"type":"object"}},{"name":"endpointId","in":"path","description":"endpointId","required":true,"style":"simple","schema":{"type":"string"}}],"responses":{"204":{"description":"No Content"}},"security":[{"X-API-Key":[]}]},"patch":{"tags":["Webhook Endpoints"],"summary":"Update a webhook endpoint (url, eventTypes, label, isActive)","operationId":"updateUsingPATCH","parameters":[{"name":"authenticated","in":"query","required":false,"style":"form","schema":{"type":"boolean"}},{"name":"authorities[0].authority","in":"query","required":false,"style":"form","schema":{"type":"string"}},{"name":"credentials","in":"query","required":false,"style":"form","schema":{"type":"object"}},{"name":"details","in":"query","required":false,"style":"form","schema":{"type":"object"}},{"name":"principal","in":"query","required":false,"style":"form","schema":{"type":"object"}},{"name":"endpointId","in":"path","description":"endpointId","required":true,"style":"simple","schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/EndpointRequest"}}}},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"object"}}}}},"security":[{"X-API-Key":[]}]}},"/api/webhook-endpoints/{endpointId}/deliveries":{"get":{"tags":["Webhook Endpoints"],"summary":"Recent deliveries to this endpoint (newest first), for debugging","operationId":"deliveriesUsingGET","parameters":[{"name":"authenticated","in":"query","required":false,"style":"form","schema":{"type":"boolean"}},{"name":"authorities[0].authority","in":"query","required":false,"style":"form","schema":{"type":"string"}},{"name":"credentials","in":"query","required":false,"style":"form","schema":{"type":"object"}},{"name":"details","in":"query","required":false,"style":"form","schema":{"type":"object"}},{"name":"principal","in":"query","required":false,"style":"form","schema":{"type":"object"}},{