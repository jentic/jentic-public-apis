es[0].authority","in":"query","required":false,"style":"form","schema":{"type":"string"}},{"name":"credentials","in":"query","required":false,"style":"form","schema":{"type":"object"}},{"name":"details","in":"query","required":false,"style":"form","schema":{"type":"object"}},{"name":"principal","in":"query","required":false,"style":"form","schema":{"type":"object"}},{"name":"endpointId","in":"path","description":"endpointId","required":true,"style":"simple","schema":{"type":"string"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"object","additionalProperties":{"type":"object"}}}}}},"security":[{"X-API-Key":[]}]}},"/api/workspace":{"get":{"tags":["Workspaces"],"summary":"List all workspaces","description":"Returns a list of all workspaces where the current user is either an owner or a collaborator","operationId":"readWorkspaceListUsingGET","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/Workspace"}}}}}},"security":[{"X-API-Key":[]}]}},"/api/workspace/owned":{"get":{"tags":["Workspaces"],"summary":"List owned workspaces","description":"Returns a list of workspaces owned by the current user","operationId":"listOwnedWorkspacesUsingGET","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/Workspace"}}}}}},"security":[{"X-API-Key":[]}]}}},"components":{"schemas":{"BulkAddTermsDto":{"title":"BulkAddTermsDto","type":"object","properties":{"languageId":{"type":"string"},"terms":{"type":"array","items":{"type":"string"}}}},"BulkAddTranslationDto":{"title":"BulkAddTranslationDto","required":["mediaIds","translationLanguage"],"type":"object","properties":{"mediaIds":{"type":"array","description":"List of Media IDs to add translation to","items":{"type":"string"}},"translationLanguage":{"description":"The Translation Language to add","$ref":"#/components/schemas/LanguageSelectionDto"}}},"BurnIn":{"title":"BurnIn","type":"object","properties":{"backgroundColor":{"type":"string"},"backgroundFormat":{"type":"string","enum":["DROPSHADOW","LETTERBOX","NONE","OUTLINE"]},"backgroundOpacity":{"type":"integer","format":"int32"},"dateCreated":{"type":"string","format":"date-time"},"errorMessage":{"type":"string"},"etaSeconds":{"type":"integer","format":"int32"},"fontColor":{"type":"string"},"fontFace":{"type":"string"},"fontSize":{"type":"integer","format":"int32"},"framesRendered":{"type":"integer","format":"int32"},"id":{"type":"string"},"lastModified":{"type":"string","format":"date-time"},"progressPercent":{"type":"integer","format":"int32"},"status":{"type":"string","enum":["COMPLETE","ERROR","PROCESSING","PROCESSING_TRANSCODE"]},"videoFormat":{"type":"string","enum":["HIGH","HIGHEST","ORIGINAL","STANDARD"]}}},"CreateMediaDto":{"title":"CreateMediaDto","required":["fileName","selectedLanguages","workspaceId"],"type":"object","properties":{"captionPostEdit":{"type":"boolean","description":"Whether generated captions must be reviewed and approved in the web editor before translations start. Defaults to false for API requests: captions complete automatically and any requested translations start right away. Set true to keep the review workflow; the caption track then waits in POST_EDIT status and translations start once it is approved in the web editor.","example":false},"fileName":{"type":"string","description":"The file name. The media title will be derived from this file name, excluding its extension."},"importProvider":{"type":"string","description":"Cloud picker provider for this import (e.g. GOOGLE_DRIVE). Requires providerFileId and providerAccessToken."},"providerAccessToken":{"type":"string","description":"Short-lived provider access token for cloud picker imports. Used once to stream the file; never stored."},"providerFileId":{"type":"string","description":"Provider-side file ID for cloud picker imports"},"selectedLanguages":{"type":"array","description":"The list of languages and job types associated with them","items":{"$ref":"#/components/schemas/LanguageSelectionDto"}},"sourceUrl":{"type":"string","description":"A public URL to the source media file"},"workspaceId":{"type":"string","description":"The ID of the workspace where this media gets uploaded into"}}},"CreateMediaFromCaptionsDto":{"title":"CreateMediaFromCaptionsDto","required":["sourceLanguageId","srtContent","workspaceId"],"type":"object","properties":{"diarization":{"type":"string","description":"Speaker diarization style for the caption track (defaults to NONE)","enum":["DASH","LABEL","NONE"]},"maxCpl":{"type":"integer","description":"Max characters per line for the caption track (optional)","format":"int32"},"maxLpc":{"type":"integer","description":"Max lines per cue for the caption track (optional)","format":"int32"},"sourceLanguageId":{"type":"string","description":"The source language ID of the captions (e.g. 'en-US')"},"srtContent":{"type":"string","description":"The inline SRT content of the existing captions to import"},"title":{"type":"string","description":"Optional media title; defaults to 'Imported captions'"},"workspaceId":{"type":"string","description":"The workspace to create the media in"}}},"CreateUploadUrlDto":{"title":"CreateUploadUrlDto","required":["contentType","mediaId"],"type":"object","properties":{"contentType":{"type":"string","description":"The Content-Type of the file being uploaded, e.g. 'audio/mp4' or 'video/mp4'. The client MUST send this exact value as the Content-Type header on the PUT; it is baked into the signature and determines whether the encode pipeline runs the audio-only or full video template."},"mediaId":{"type":"string","description":"The id of an already-created media (still in UPLOADING) to upload the source for"}}},"DeliveryResponse":{"title":"DeliveryResponse","type":"object","properties":{"attemptCount":{"type":"integer","format":"int32"},"createdAt":{"type":"string","format":"date-time"},"eventId":{"type":"string"},"eventType":{"type":"string"},"id":{"type":"string"},"languageId":{"type":"string"},"lastAttemptAt":{"type":"string","format":"date-time"},"lastError":{"type":"string"},"lastResponseCode":{"type":"integer","format":"int32"},"mediaId":{"type":"string"},"mediaTitle":{"type":"string"},"nextAttemptAt":{"type":"string","format":"date-time"},"status":{"type":"string"},"trackId":{"type":"string"}}},"DownloadTracksDto":{"title":"DownloadTracksDto","type":"object","properties":{"diarization":{"type":"string","enum":["DASH","LABEL","NONE"]},"format":{"type":"string","enum":["DOCX","ITT","PDF","SBV","SRT","SSA","STL","TTML","TXT","VTT"]},"layout":{"type":"string","enum":["ONE_LINE_PER_CUE","PARAGRAPHS"]},"timestamps":{"type":"string","enum":["NONE","PARAGRAPH"]},"trackIds":{"type":"array","items":{"type":"string"}},"workspaceId":{"type":"string"}}},"EndpointRequest":{"title":"EndpointRequest","type":"object","properties":{"eventTypes":{"type":"array","description":"Event type codes to subscribe to","example":"[\"media.ready\", \"caption.completed\", \"translation.completed\"]","items":{"type":"string"}},"isActive":{"type":"boolean","description":"Update only: true re-enables a disabled endpoint (resets its failure counter), false pauses it","example":false},"label":{"type":"string","description":"Optional display label"},"url":{"type":"string","description":"HTTPS URL that will receive event POSTs","example":"https://hooks.example.com/fluen"},"workspaceId":{"type":"string","description":"Optional workspace id; when set, only events for media in this workspace are delivered"}}},"EndpointResponse":{"title":"EndpointResponse","type":"object","properties":{"consecutiveFailures":{"type":"integer","format":"int32"},"createdAt":{"type":"string","format":"date-time"},"disabledAt":{"type":"string","format":"date-time"},"disabledReason":{"type":"string"},"eventTypes":{"type":"array","items":{"type":"string"}},"id":{"type":"string"},"isActive":{"type":"boolean"},"label":{"type":"string"},"lastFailureAt":{"type":"string","format":"date-time"},"lastSuccessAt":{"type":"string","format":"date-time"},"secret":{"type":"string","description":"Signing secret for X-Fluen-Signature verification. Returned only once, on create and rotate-secret; store it securely."},"url":{"type":"string"},"workspaceId":{"type":"string"}}},"ImportTrackSrtDto":{"title":"ImportTrackSrtDto","required":["srtContent"],"type":"object","properties":{"srtContent":{"type":"string","description":"The inline SRT content that will replace the track's subtitles"}}},"Language":{"title":"Language","type":"object","properties":{"cps":{"type":"integer","description":"Maximum comfortable reading speed, in characters per second","format":"int32"},"displayName":{"type":"string","description":"The full language name"},"id":{"type":"string","description":"The language ID"},"localizedName":{"type":"string","description":"The localized language name"}}},"LanguageSelectionDto":{"title":"LanguageSelectionDto","type":"object","properties":{"languageId":{"type":"string","description":"The Language ID"},"type":{"type":"string","description":"The job type, whether it's a source language Caption or a target Translation","enum":["CAPTION","TRANSLATION"]}}},"Media":{"title":"Media","type":"object","properties":{"captionPostEdit":{"type":"boolean","description":"Whether or not the media requires a caption review or post-editing","example":false},"createdVia":{"type":"string","description":"Which surface created this media: WEB, API, or PREMIERE_PLUGIN. Null on media predating this field.","enum":["API","PREMIERE_PLUGIN","WEB"]},"dateCreated":{"type":"string","description":"The media creation date","format":"date-time"},"dateDeleted":{"type":"string","description":"The date this media was moved to Trash","format":"date-time"},"dateExpired":{"type":"string","description":"When set, the media's S3 video/audio files have been deleted; subtitle data remains available","format":"date-time"},"duration":{"type":"integer","description":"The media duration in milliseconds","format":"int32"},"errorMessage":{"type":"string","description":"The media processing error message, if present"},"hasMultipleLanguages":{"type":"boolean","description":"Whether the media contains multiple spoken languages (code-switching)","example":false},"id":{"type":"string","description":"The media ID"},"importedFromPremiere":{"type":"boolean","description":"True when this media was created through the Premiere plugin (either an audio export or a captions-only SRT import). The web app gates the 'imported from Premiere' player placeholder on this; regular web uploads (including web audio uploads) are false.","example":false},"language":{"description":"The media Source Language","$ref":"#/components/schemas/Language"},"sourceMediaAvailable":{"type":"boolean","description":"False when the media has no playable source file: either purged/expired, or an external captions-only item (e.g. an SRT imported via the Premiere plugin). The frontend renders these with the no-source path; file ops (waveform, proxy, burn-in, presign) skip them.","example":false},"sourceUrl":{"type":"string","description":"The URL of the original source file"},"speakerLabels":{"type":"string","description":"Speaker label names as JSON map, e.g. {\"0\": \"Speaker 1\", \"1\": \"John\"}"},"status":{"type":"string","description":"The current status of the media","enum":["ENCODED","ENCODING","ERROR","IN_QUEUE","UPLOADING"]},"title":{"type":"string","description":"The title of the media"},"tracks":{"type":"array","description":"The list of tracks associated with this media","items":{"$ref":"#/components/schemas/Track"}},"type":{"type":"string","description":"The media type (audio or video)","enum":["AUDIO","VIDEO"]},"user":{"description":"The user who added this media","$ref":"#/components/schemas/User"},"workspace":{"description":"The workspace associated to this media","$ref":"#/components/schemas/Workspace"}}},"PaginatedMediaResponse":{"title":"