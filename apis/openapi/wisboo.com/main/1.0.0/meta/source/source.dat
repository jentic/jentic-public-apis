{"openapi":"3.1.0","info":{"title":"Wisboo API","version":"1.0.0"},"paths":{"/v1/stores/{store_id}/users":{"get":{"operationId":"users_listUsers","summary":"List users","description":"Devuelve una lista paginada de usuarios básicos de la tienda. Los usuarios pueden filtrarse por `name` (Nombre completo) o `email`.","tags":["users"],"parameters":[{"name":"store_id","in":"path","description":"ID de tu tienda","required":true,"schema":{"type":"string"}},{"name":"page","in":"query","required":false,"schema":{"type":"integer"}},{"name":"size","in":"query","required":false,"schema":{"type":"integer"}},{"name":"name","in":"query","required":false,"schema":{"type":"string"}},{"name":"email","in":"query","required":false,"schema":{"type":"string","format":"email"}}],"responses":{"200":{"description":"Successful request","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Users_listUsers_Response_200"}}}}},"security":[{"BearerAuth":[]}]},"post":{"operationId":"users_createUser","summary":"Create user","description":"Crea un nuevo usuario en la tienda. El usuario se registra de inmediato sin enviar un email de confirmación.\n\n**Campos requeridos:** `email`, `name`, `last_name`\n\nSi ya existe una cuenta con el `email` indicado en la tienda, el request devuelve un error `422`.","tags":["users"],"parameters":[{"name":"store_id","in":"path","description":"ID de tu tienda","required":true,"schema":{"type":"string"}},{"name":"X-Idempotency-Key","in":"header","required":false,"schema":{"description":"Any type"}}],"responses":{"201":{"description":"Successful request","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Users_createUser_Response_201"}}}},"400":{"description":"Missing parameter","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateUserRequestBadRequestError"}}}},"401":{"description":"Invalid access token","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateUserRequestUnauthorizedError"}}}},"422":{"description":"Invalid email","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateUserRequestUnprocessableEntityError"}}}}},"requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"name":{"type":"string"},"last_name":{"type":"string"},"email":{"type":"string","format":"email"},"phone":{"type":"string"},"country":{"type":"string","description":"País del usuario en el estándar ISO 3166 Alpha-2. Ej. AR (Argentina), (CL) Chile."},"language":{"$ref":"#/components/schemas/V1StoresStoreIdUsersPostRequestBodyContentApplicationJsonSchemaLanguage","description":"Idioma del usuario, por defecto se asigna el idioma de la cuenta."},"external_id":{"type":"string","maxLength":255,"description":"ID del usuario en tu sistema."},"avatar":{"type":"string","format":"uri"},"custom_fields":{"$ref":"#/components/schemas/V1StoresStoreIdUsersPostRequestBodyContentApplicationJsonSchemaCustomFields","description":"Campos custom del usuario, estos corresponden a los definidos dentro de la tienda"}}}}}},"security":[{"BearerAuth":[]}]}},"/v1/stores/{store_id}/users/{id}":{"get":{"operationId":"users_getUser","summary":"Get user","description":"Retorna un usuario específico de la tienda identificado por su ID público.","tags":["users"],"parameters":[{"name":"store_id","in":"path","description":"ID de la tienda","required":true,"schema":{"type":"string"}},{"name":"id","in":"path","description":"ID del usuario","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful request","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Users_getUser_Response_200"}}}}},"security":[{"BearerAuth":[]}]},"put":{"operationId":"users_updateUser","summary":"Update user","description":"Actualiza los atributos del perfil de un usuario existente. Todos los campos son opcionales — solo se actualizan los que se incluyen en el request.\n\n**Nota:** El email no puede modificarse con este endpoint. Utilizá el endpoint **Actualizar email** para ese caso.","tags":["users"],"parameters":[{"name":"store_id","in":"path","description":"ID de la tienda","required":true,"schema":{"type":"string"}},{"name":"id","in":"path","description":"ID del usuario","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful request","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Users_updateUser_Response_200"}}}},"404":{"description":"User does not exist","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateUserRequestNotFoundError"}}}},"422":{"description":"Invalid parameters","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateUserRequestUnprocessableEntityError"}}}}},"requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"name":{"type":"string"},"last_name":{"type":"string"},"phone":{"type":"string"},"country":{"type":"string"},"language":{"type":"string"},"external_id":{"type":"string"},"avatar":{"oneOf":[{"description":"Any type"},{"type":"null"}]},"custom_fields":{"$ref":"#/components/schemas/V1StoresStoreIdUsersIdPutRequestBodyContentApplicationJsonSchemaCustomFields"}}}}}},"security":[{"BearerAuth":[]}]}},"/v1/stores/{store_id}/users/{id}/email":{"put":{"operationId":"users_updateUserEmail","summary":"Update user email","description":"Actualiza el email de un usuario. El cambio se aplica de inmediato — no se envía ningún email de confirmación a la dirección anterior ni a la nueva.\n\nDevuelve `200 OK` con cuerpo vacío en caso de éxito. Devuelve `422` si el email ya está en uso o es inválido.","tags":["users"],"parameters":[{"name":"store_id","in":"path","description":"ID de la cuenta","required":true,"schema":{"type":"string"}},{"name":"id","in":"path","description":"ID de usuario","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful request","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Users_updateUserEmail_Response_200"}}}},"400":{"description":"Missing email","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateUserEmailRequestBadRequestError"}}}},"422":{"description":"Invalid email","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateUserEmailRequestUnprocessableEntityError"}}}}},"requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"email":{"type":"string","format":"email"}}}}}},"security":[{"BearerAuth":[]}]}},"/v1/stores/{store_id}/users/{id}/magic_links":{"post":{"operationId":"users_generateMagicLink","summary":"Generate magic link","description":"Genera una URL de inicio de sesión de un solo uso para el usuario especificado. El link permite iniciar sesión directamente en el storefront de Wisboo sin necesidad de contraseña — ideal para flujos tipo SSO y redirecciones desde sistemas externos.\n\nEl token generado tiene validez máxima de 5 minutos y sólo puede ser usado una vez.","tags":["users"],"parameters":[{"name":"store_id","in":"path","required":true,"schema":{"type":"string"}},{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"201":{"description":"Successful request","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Users_generateMagicLink_Response_201"}}}}},"security":[{"BearerAuth":[]}]}},"/v1/stores/{store_id}/purchases":{"get":{"operationId":"purchases_listPurchases","summary":"List purchases","description":"Devuelve una lista paginada de compras de la tienda. Todos los filtros son opcionales y pueden combinarse entre sí.","tags":["purchases"],"parameters":[{"name":"store_id","in":"path","required":true,"schema":{"type":"string"}},{"name":"page","in":"query","required":false,"schema":{"type":"integer"}},{"name":"size","in":"query","required":false,"schema":{"type":"integer"}},{"name":"email","in":"query","description":"Email del usuario comprador","required":false,"schema":{"type":"string","format":"email"}},{"name":"product_id","in":"query","description":"ID de los productos asociados a la compra","required":false,"schema":{"type":"string"}},{"name":"user_id","in":"query","description":"ID de los usuarios asociados a la compra","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful request","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Purchases_listPurchases_Response_200"}}}}},"security":[{"BearerAuth":[]}]}},"/v1/stores/{store_id}/product_accesses":{"get":{"operationId":"productAccess_listProductAccesses","summary":"List product accesses","description":"Devuelve una lista paginada de accessos a productos, ordenadas por fecha de creación (más reciente primero).\n\nCada acceso incluye los datos del producto, usuario y métricas de progreso como fecha de inicio, fecha de finalización, nota y estado de aprobación (estos datos en caso de que el producto sea un curso).\n\nLos accesos pueden ser filtrados por ID de producto o ID del usuario.","tags":["productAccess"],"parameters":[{"name":"store_id","in":"path","description":"ID de la tienda","required":true,"schema":{"description":"Any type"}},{"name":"page","in":"query","description":"Página a consultar","required":false,"schema":{"type":"integer","minimum":1}},{"name":"size","in":"query","description":"Cantidad de items por página","required":false,"schema":{"type":"integer","minimum":1,"maximum":50}},{"name":"product_id[]","in":"query","description":"ID de productos para filtrar","required":false,"schema":{"type":"string"}},{"name":"user_id[]","in":"query","description":"ID de usuarios para filtrar","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful request","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Product_Access_listProductAccesses_Response_200"}}}}},"security":[{"BearerAuth":[]}]},"post":{"operationId":"productAccess_grantProductAccess","summary":"Grant product access","description":"Otorga acceso a un producto a un usuario específico sin requerir una compra.\n\nSi el producto es un **bundle**, el acceso a todos los productos incluidos en el bundle también se otorga automáticamente.\n\nDevuelve un error `422` con código `DUPLICATE_ERROR` si el usuario ya tiene acceso al producto.","tags":["productAccess"],"parameters":[{"name":"store_id","in":"path","description":"ID de la tienda","required":true,"schema":{"description":"Any type"}}],"responses":{"201":{"description":"Successful request","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Product_Access_grantProductAccess_Response_201"}}}},"400":{"description":"User ID is missing","content":{"application/json":{"schema":{"$ref":"#/components/schemas/GrantProductAccessRequestBadRequestError"}}}},"404":{"description":"Product does not exist","content":{"application/json":{"schema":{"$ref":"#/components/schemas/GrantProductAccessRequestNotFoundError"}}}}},"requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"user_id":{"type":"string"},"product_id":{"type":"string"}}}}}},"security":[{"BearerAuth":[]}]}},"/v1/stores/{store_id}/product_accesses/{id}":{"put":{"operationId":"productAccess_updateProductAccess","summary":"Update product access","description":"Permite actualizar la fecha tope de acceso o el status del acceso de un usuario a un producto.","tags":["productAccess"],"parameters":[{"name":"store_id","in":"path","description":"ID de la cuenta","required":true,"schema":{"type":"string"}},{"name":"id","in":"path","description":"ID del acceso","required":true,"schema":{"type":"string"}}],"responses":{"201":{"description":"Successful request","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Product_Access_updateProductAccess_Response_201"}}}},"404":{"description":"Record does not exist","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateProductAccessRequestNotFoundError"}}}}},"requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"status":{"$ref":"#/components/schemas/V1StoresStoreIdProductAccessesIdPutRequestBodyContentApplicationJsonSchemaStatus"},"access_due_date":{"type":["string","null"],"format":"date-time"}}}}}},"security":[{"BearerAuth":[]}]},"delete":{"operationId":"productAccess_revokeProductAccess","summary":"Revoke product access","description":"Revoca el acceso de un usuario a un producto específico. Una vez revocado, el usuario no podrá acceder al contenido del producto.\n\nDevuelve `204 No Content` en caso de éxito. Devuelve `404` si no existe un acceso con ese ID.","tags":["productAccess"],"parameters":[{"name":"store_id","in":"path","description":"ID de la cuenta","required":true,"schema":{"type":"string"}},{"name":"id","in":"path","description":"ID del acceso","required":true,"schema":{"type":"string"}}],"responses":{"204":{"description":"Successful request","content":{"application/json":{"schema":{"type":"object","properties":{}}}}},"404":{"description":"Product does not exist","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RevokeProductAccessRequestNotFoundError"}}}}},"requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{}}}}},"security":[{"BearerAuth":[]}]}},"/v1/stores/{store_id}/products":{"get":{"operationId":"products_listProducts","summary":"List products","description":"Devuelve una lista paginada de productos de la tienda. El filtro `name` busca coincidencias en el nombre del producto.","tags":["products"],"parameters":[{"name":"store_id","in":"path","description":"ID de la cuenta","required":true,"schema":{"type":"string"}},{"name":"page","in":"query","required":false,"schema":{"type":"integer"}},{"name":"size","in":"query","required":false,"schema":{"type":"integer"}},{"name":"product_type","in":"query","required":false,"schema":{"$ref":"#/components/schemas/V1StoresStoreIdProductsGetParametersProductType"}}],"responses":{"200":{"description":"Successful request","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Products_listProducts_Response_200"}}}}},"security":[{"BearerAuth":[]}]}},"/v1/stores/{store_id}/products/{id}":{"get":{"operationId":"products_getProduct","summary":"Get product","description":"Retorna un producto específico de la tienda identificado por su ID público.","tags":["products"],"parameters":[{"name":"store_id","in":"path","description":"ID de la cuenta","required":true,"schema":{"type":"string"}},{"name":"id","in":"path","description":"ID del producto (PRO-...)","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful request","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Products_getProduct_Response_200"}}}}},"security":[{"BearerAuth":[]}]}}},"tags":[{"name":"users"},{"name":"purchases"},{"name":"productAccess"},{"name":"products"}],"servers":[{"url":"https://api.wisboo.com","description":"https://api.wisboo.com"}],"components":{"schemas":{"V1StoresStoreIdUsersGetResponsesContentApplicationJsonSchemaDataItemsLanguage":{"type":"string","enum":["ES","PT","EN"],"title":"V1StoresStoreIdUsersGetResponsesContentApplicationJsonSchemaDataItemsLanguage"},"V1StoresStoreIdUsersGetResponsesContentApplicationJsonSchemaDataItemsCustomFields":{"type":"object","properties":{},"title":"V1StoresStoreIdUsersGetResponsesContentApplicationJsonSchemaDataItemsCustomFields"},"V1StoresStoreIdUsersGetResponsesContentApplicationJsonSchemaDataItems":{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"},"last_name":{"type":"string"},"email":{"type":"string","format":"email"},"created_at":{"type":"string","format":"date-time"},"country":{"type":"string","description":"País del usuario en formato ISO-SO 3166-1 alpha-2"},"phone":{"type":"string"},"external_id":{"type":"string"},"language":{"$ref":"#/components/schemas/V1StoresStoreIdUsersGetResponsesContentApplicationJsonSchemaDataItemsLanguage"},"avatar":{"type":"string"