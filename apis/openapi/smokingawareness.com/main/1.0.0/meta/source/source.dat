{
  "openapi": "3.0.0",
  "info": {
    "title": "Smoking Awareness Platform API",
    "description": "# Smoking Awareness Web Application API\n\n## Graduation Project 2026 - Egyptian E-Learning University\n\nThis API provides all backend services for the Smoking Awareness Platform including:\n- User Authentication & Profile Management\n- Cancer Risk Assessment & Nicotine Testing\n- Progress Tracking & Health Timeline\n- Educational Content & Awareness Materials\n- Seminar Management & Registration\n- Recovery Stories & Community\n- Doctor Directory & Reviews\n\n## Features\n- **15 Use Cases Implemented** (UC-001 to UC-015)\n- JWT Authentication\n- Role-based Access Control (User/Admin)\n- Real-time Progress Tracking\n- Interactive Health Milestones\n",
    "version": "1.0.0",
    "contact": {
      "name": "Development Team",
      "email": "dev@smokingawareness.com"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/eehaabporganization/GeneratedAPI_2026-03-12-0438/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.smokingawareness.com/api",
      "description": "Production Server"
    }
  ],
  "tags": [
    {
      "name": "Authentication",
      "description": "User registration and login (UC-001, UC-002)"
    },
    {
      "name": "User Profile",
      "description": "Profile management (UC-003)"
    },
    {
      "name": "Assessments",
      "description": "Cancer risk and nicotine tests (UC-007, UC-008)"
    },
    {
      "name": "Progress",
      "description": "Quit tracking and timeline (UC-009, UC-010)"
    },
    {
      "name": "Seminars",
      "description": "Seminar management and registration (UC-004, UC-005, UC-013)"
    },
    {
      "name": "Awareness",
      "description": "Educational content and body organs (UC-006)"
    },
    {
      "name": "Recovery Stories",
      "description": "Community stories and moderation (UC-004, UC-011, UC-015)"
    },
    {
      "name": "Doctors",
      "description": "Doctor directory and reviews (UC-012, UC-014)"
    },
    {
      "name": "Medical Centers",
      "description": "Treatment centers management (UC-012, UC-014)"
    }
  ],
  "paths": {
    "/auth/register": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "User Registration (UC-001)",
        "description": "Register a new user account with email and password",
        "operationId": "registerUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Registration successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error or email already exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "User Login (UC-002)",
        "description": "Authenticate user and return JWT token",
        "operationId": "loginUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/users/profile": {
      "get": {
        "tags": [
          "User Profile"
        ],
        "summary": "Get User Profile",
        "description": "Retrieve current user's profile information",
        "operationId": "getProfile",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Profile retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfileResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "User not found"
          }
        }
      },
      "put": {
        "tags": [
          "User Profile"
        ],
        "summary": "Update User Profile",
        "description": "Update user profile information",
        "operationId": "updateProfile",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProfileRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profile updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfileResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error"
          }
        }
      }
    },
    "/users/complete-profile": {
      "post": {
        "tags": [
          "User Profile"
        ],
        "summary": "Complete User Profile (UC-003)",
        "description": "Complete profile after registration with smoking data",
        "operationId": "completeProfile",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompleteProfileRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profile completed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfileResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error"
          }
        }
      }
    },
    "/assessments/cancer-risk": {
      "post": {
        "tags": [
          "Assessments"
        ],
        "summary": "Perform Cancer Risk Assessment (UC-008)",
        "description": "Calculate cancer risk based on smoking habits and family history",
        "operationId": "performCancerRiskAssessment",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CancerRiskRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Assessment completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CancerRiskResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      },
      "get": {
        "tags": [
          "Assessments"
        ],
        "summary": "Get Cancer Risk History",
        "description": "Retrieve user's cancer risk assessment history",
        "operationId": "getCancerRiskHistory",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "History retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CancerRiskResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/assessments/nicotine-test": {
      "post": {
        "tags": [
          "Assessments"
        ],
        "summary": "Perform Nicotine Addiction Test (UC-007)",
        "description": "Fagerström test for nicotine dependence",
        "operationId": "performNicotineTest",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NicotineTestRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Test completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NicotineTestResponse"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Assessments"
        ],
        "summary": "Get Nicotine Test History",
        "description": "Retrieve user's nicotine test history",
        "operationId": "getNicotineTestHistory",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "History retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/NicotineTestResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/progress": {
      "get": {
        "tags": [
          "Progress"
        ],
        "summary": "Track Quit Progress (UC-009)",
        "description": "Get current quit progress statistics",
        "operationId": "getProgress",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Progress retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProgressResponse"
                }
              }
            }
          },
          "404": {
            "description": "No quit date set"
          }
        }
      },
      "post": {
        "tags": [
          "Progress"
        ],
        "summary": "Set Quit Date",
        "description": "Set or update quit smoking date",
        "operationId": "setQuitDate",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "quitDate": {
                    "type": "string",
                    "format": "date-time",
                    "example": "2024-01-01T00:00:00Z"
                  }
                },
                "required": [
                  "quitDate"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Quit date set successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProgressResponse"
                }
              }
            }
          }
        }
      }
    },
    "/progress/timeline": {
      "get": {
        "tags": [
          "Progress"
        ],
        "summary": "View Quit Timeline (UC-010)",
        "description": "Get health recovery milestones and timeline",
        "operationId": "getQuitTimeline",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Timeline retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/HealthMilestoneDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/progress/health-age": {
      "get": {
        "tags": [
          "Progress"
        ],
        "summary": "Calculate Health Age",
        "description": "Calculate health age based on smoking data",
        "operationId": "calculateHealthAge",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Health age calculated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "healthAge": {
                      "type": "integer",
                      "description": "Calculated health age in years",
                      "example": 45
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "RegisterRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "StrongPassword123!"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "StrongPassword123!"
          }
        }
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "JWT token for authentication",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          },
          "expiresIn": {
            "type": "integer",
            "description": "Token expiration time in seconds",
            "example": 3600
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "Invalid credentials"
          }
        }
      },
      "UserProfileResponse": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "integer",
            "example": 123
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "user@example.com"
          },
          "fullName": {
            "type": "string",
            "example": "John Doe"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "User"
            ]
          },
          "smokingStatus": {
            "type": "string",
            "description": "Smoking status description",
            "example": "Former smoker"
          },
          "quitDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "example": "2023-06-01T00:00:00Z"
          }
        }
      },
      "UpdateProfileRequest": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "example": "John Doe"
          },
          "smokingStatus": {
            "type": "string",
            "example": "Current smoker"
          },
          "quitDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "example": "2024-01-01T00:00:00Z"
          }
        }
      },
      "CompleteProfileRequest": {
        "type": "object",
        "required": [
          "smokingStatus",
          "cigarettesPerDay",
          "yearsSmoking"
        ],
        "properties": {
          "smokingStatus": {
            "type": "string",
            "example": "Current smoker"
          },
          "cigarettesPerDay": {
            "type": "integer",
            "example": 10
          },
          "yearsSmoking": {
            "type": "integer",
            "example": 5
          }
        }
      },
      "CancerRiskRequest": {
        "type": "object",
        "required": [
          "smokingStatus",
          "familyHistory",
          "age"
        ],
        "properties": {
          "smokingStatus": {
            "type": "string",
            "example": "Current smoker"
          },
          "familyHistory": {
            "type": "boolean",
            "description": "Family history of cancer",
            "example": true
          },
          "age": {
            "type": "integer",
            "example": 40
          }
        }
      },
      "CancerRiskResponse": {
        "type": "object",
        "properties": {
          "riskScore": {
            "type": "number",
            "format": "float",
            "example": 0.75
          },
          "riskLevel": {
            "type": "string",
            "example": "High"
          },
          "recommendations": {
            "type": "string",
            "example": "Consider quitting smoking and regular screenings."
          },
          "assessedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2024-03-10T12:00:00Z"
          }
        }
      },
      "NicotineTestRequest": {
        "type": "object",
        "required": [
          "answers"
        ],
        "properties": {
          "answers": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            "description": "Answers to Fagerström test questions",
            "example": [
              1,
              2,
              0,
              1,
              3,
              2
            ]
          }
        }
      },
      "NicotineTestResponse": {
        "type": "object",
        "properties": {
          "score": {
            "type": "integer",
            "example": 6
          },
          "dependenceLevel": {
            "type": "string",
            "example": "Moderate"
          },
          "advice": {
            "type": "string",
            "example": "Consider counseling and nicotine replacement therapy."
          },
          "testedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2024-03-10T12:00:00Z"
          }
        }
      },
      "ProgressResponse": {
        "type": "object",
        "properties": {
          "quitDate": {
            "type": "string",
            "format": "date-time",
            "example": "2024-01-01T00:00:00Z"
          },
          "daysSinceQuit": {
            "type": "integer",
            "example": 68
          },
          "milestonesAchieved": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "24 hours smoke-free",
              "1 week smoke-free"
            ]
          },
          "currentHealthAge": {
            "type": "integer",
            "example": 42
          }
        }
      },
      "HealthMilestoneDto": {
        "type": "object",
        "properties": {
          "milestoneId": {
            "type": "integer",
            "example": 1
          },
          "title": {
            "type": "string",
            "example": "24 Hours Smoke-Free"
          },
          "description": {
            "type": "string",
            "example": "Carbon monoxide levels in your blood drop to normal."
          },
          "daysAfterQuit": {
            "type": "integer",
            "example": 1
          },
          "achieved": {
            "type": "boolean",
            "example": true
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}
