    "/watches": {
      "post": {
        "tags": [
          "Watches"
        ],
        "operationId": "createWatch",
        "summary": "Arm a standing watch (20 credits)",
        "description": "Registers a standing watch that POSTs the fact plus its evidence to your webhook when it fires. Active-subscription keys only; Starter arms 3 active watches and Pro or Alpha 10, counted across the account. GET and DELETE are free.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "coin",
                  "trigger",
                  "webhook_url"
                ],
                "properties": {
                  "coin": {
                    "type": "string",
                    "pattern": "^[A-Z0-9]{1,12}$",
                    "example": "BTC"
                  },
                  "trigger": {
                    "type": "string",
                    "enum": [
                      "radar_unusual",
                      "flag_fired",
                      "funding_band"
                    ]
                  },
                  "band": {
                    "type": "string",
                    "enum": [
                      "record high",
                      "record low",
                      "top 5%",
                      "bottom 5%"
                    ],
                    "description": "Required when trigger is funding_band, ignored otherwise."
                  },
                  "webhook_url": {
                    "type": "string",
                    "format": "uri",
                    "description": "HTTPS only. Resolved and checked against private address ranges at save time and again at send time."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "type": "object",
                      "description": "Endpoint-specific payload. Every field it carries is documented in llms-full.txt and returned by /discover."
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "invalid_coin, invalid_trigger or invalid_band",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "402": {
            "description": "Insufficient credits",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Active developer plan required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Watch limit reached",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
