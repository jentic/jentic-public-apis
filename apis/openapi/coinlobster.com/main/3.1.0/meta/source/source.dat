    "/mcp": {
      "servers": [
        {
          "url": "https://coinlobster.com",
          "description": "Free public surface (not under /api/ai/v1)"
        }
      ],
      "post": {
        "operationId": "mcpJsonRpc",
        "summary": "MCP server: JSON-RPC 2.0 over streamable HTTP (keyless and free-plan calls not billed; paid-plan calls metered)",
        "description": "The Model Context Protocol server over streamable HTTP. Stateless: every POST is a fresh session. Two URLs, same tools: https://coinlobster.com/mcp/connector signs the user in over OAuth (a free account is live), https://coinlobster.com/mcp is keyless (answers 30 minutes old). Registers 21 tools: coin_brief, market_now, whale_activity, whale_radar, market_screener, liquidations, traders, wallet, signals, situations, history, options, orderbook, news, sectors, big_catch, watch, my_alerts, watchlist_brief, my_access, coin_search. 41 older tool names still answer, each routed to the tool above that now owns it. whale_tape is a deprecated alias of whale_activity, still callable. All read-only except watch, which arms and removes alerts posted to the caller's webhook (Starter and up). my_access reports what the calling connection can see, the caps in force on it and what lifts each one; it is free and never spends credits. Keyless and free-plan calls are never billed: 100 calls a day without an account, 200 calls a day with a free account. The free plans answer BTC in full and any other coin as a headline with its price, 24h change and news, over the last 24 hours. A paid plan (Starter $15, Pro $29, Alpha $99 a month), as an OAuth-connected account or a cl_ key in X-API-Key, answers every coin in full; each successful tools/call then spends 20 to 100 credits, priced by workload, from the balance the website and REST API share. Discovery (initialize, tools/list, ping), failed calls and no-data answers cost nothing. Descriptive market data only, no forecast language.",
        "tags": [
          "free"
        ],
        "security": [],
        "x-tier": "free",
        "x-credits": "0 keyless or on the free plan; 20 to 100 per tools/call on a paid plan, priced by workload",
        "parameters": [
          {
            "name": "X-API-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Optional: an active-subscription API key lifts free caps to the subscription tier's fuller shape"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              },
              "examples": {
                "initialize": {
                  "value": {
                    "jsonrpc": "2.0",
                    "id": 1,
                    "method": "initialize",
                    "params": {
                      "protocolVersion": "2025-11-25",
                      "capabilities": {},
                      "clientInfo": {
                        "name": "example-client",
                        "version": "1.0"
                      }
                    }
                  }
                },
                "tools/call": {
                  "value": {
                    "jsonrpc": "2.0",
                    "id": 2,
                    "method": "tools/call",
                    "params": {
                      "name": "whale_trades",
                      "arguments": {
                        "coin": "BTC",
                        "limit": 20
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JSON-RPC 2.0 response (or an SSE stream, per Accept header)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "type": "object",
                      "description": "Endpoint-specific payload. Every field it carries is documented in llms-full.txt and returned by /discover."
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Origin not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit reached (Retry-After header set)",
            "content": {
              "application/json": {
                "schema": {
