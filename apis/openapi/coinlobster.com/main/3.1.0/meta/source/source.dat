    "/signals/{type}/{coin}": {
      "get": {
        "operationId": "getSignalHistoryByTypeAndCoin",
        "summary": "Get every historical firing of one signal type on one coin",
        "description": "Returns the full firing history for a single signal type on a single coin, verbatim ledger rows (never recomputed at read time), each with its fire-time snapshot and later outcomes.",
        "tags": [
          "analytics"
        ],
        "x-tier": "all",
        "x-credits": 30,
        "parameters": [
          {
            "name": "type",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "whale-spike",
                "funding-extreme",
                "squeeze-flip",
                "liq-cascade",
                "flow-divergence",
                "major-pctile",
                "major-block",
                "deriv-record"
              ]
            },
            "description": "Signal type code (underscore alert-rule aliases are also accepted)"
          },
          {
            "name": "coin",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Z0-9]{1,12}$"
            },
            "description": "Coin symbol, e.g. BTC"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 100,
              "maximum": 500
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Signal firing history, with meta.depth_note = 'fire-time rows, never backfilled; live since 2026-07-13'",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "type": "object",
                      "description": "Endpoint-specific payload. Every field it carries is documented in llms-full.txt and returned by /discover."
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Unknown signal type, or coin does not match ^[A-Z0-9]{1,12}$",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/whales/tape": {
      "get": {
        "operationId": "getWhaleTape",
        "summary": "Get the merged CEX + on-chain DEX whale tape",
        "description": "Returns merged CEX and on-chain DEX whale trades, newest first, each row tagged source: 'cex' or 'dex'. This is the full Pro-shape feed: no delay filter and no $1M floor. Hot window is ~7 days.",
        "tags": [
          "whales"
        ],
        "x-tier": "all",
        "x-credits": 30,
        "parameters": [
          {
            "name": "coin",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Filter by base coin symbol, e.g. BTC"
          },
          {
            "name": "source",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "cex",
                "dex",
                "all"
              ],
              "default": "all"
            }
          },
          {
            "name": "min_usd",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "default": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 100,
              "maximum": 500
            }
          },
          {
            "name": "since_ms",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "Only return trades at or after this epoch-ms timestamp"
          }
        ],
        "responses": {
          "200": {
            "description": "Whale trades array, with meta.depth_note = 'hot window ~7 days; rows exist since 2026-07-13 (CEX) / rolling 48h (DEX)'",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "type": "object",
                      "description": "Endpoint-specific payload. Every field it carries is documented in llms-full.txt and returned by /discover."
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/whales/flow-history": {
      "get": {
        "operationId": "getWhaleFlowHistory",
        "summary": "Get a coin's daily whale-flow history",
        "description": "Daily whale-flow series for one coin from the gold log: total, buy and sell USD per UTC day, oldest first. A day only appears when capture was verifiably up; the window grows as the log does (days exist since 2026-07-07). Costs 30 credits.",
        "tags": [
          "whales"
        ],
        "parameters": [
          {
            "name": "coin",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Coin symbol, e.g. BTC"
          }
        ],
        "responses": {
          "200": {
            "description": "Daily flow series: { coin, since_day, valid_days, as_of_ms, days: [{ date, total_usd, buy_usd, sell_usd }] }",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "type": "object",
                      "description": "Endpoint-specific payload. Every field it carries is documented in llms-full.txt and returned by /discover."
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "No logged history for this coin yet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "x-credits": 30,
        "x-tier": "all"
      }
    },
    "/whales/context": {
      "get": {
        "operationId": "getWhaleContext",
        "summary": "Get vs-own-history whale-flow context",
        "description": "Per-coin derived stats: rolling 24h flow as a multiple of the coin's own logged daily average, N-day high, buy share now vs 7d/30d, net 24h flow, plus market breadth (how many covered coins run hot). Windows are each coin's real logged days. Omit coin for the full covered map. Costs 20 credits.",
        "tags": [
          "whales"
        ],
        "parameters": [
          {
            "name": "coin",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Coin symbol, e.g. BTC; omit for all covered coins"
          }
        ],
        "responses": {
          "200": {
            "description": "Context stats: { as_of_ms, since_day, valid_days, breadth, coin?, stats?|coins? }. For a single coin that is permanently excluded by design (stablecoin or wrapped/staked asset, e.g. USDT or WBTC), this is still a 200: stats is null and the payload instead carries excluded: true, reason: \"stablecoin_or_wrapped\", and a human-readable message explaining why that coin never gets context. A coin merely below the coverage/volume gates (context not built up yet) is a 404 instead, not this shape.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "type": "object",
                      "description": "Endpoint-specific payload. Every field it carries is documented in llms-full.txt and returned by /discover."
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Coin below the coverage or volume gates (not yet enough logged history). A coin excluded by design instead returns 200 with stats: null -- see the 200 response above.",
