      "servers": [
        {
          "url": "https://coinlobster.com",
          "description": "Free public surface (not under /api/ai/v1)"
        }
      ]
    },
    "/api/public/liquidations": {
      "get": {
        "summary": "Market-wide liquidations",
        "description": "Every force-closed position across the market in one call. perp_liquidations combines the CEX futures venues we record with Hyperliquid (perp_liquidations.venues names the ones that reported in the window, and venue_coverage says whether that count is a declared list or what the window observed): 24h dollars and counts split long vs short, an hourly series so a cascade is locatable, top coins, and the biggest single event. named_liquidations lists the Hyperliquid wallets that were closed out, which no other venue publishes. lending_liquidations is a SEPARATE lane (an on-chain debt repaid and the collateral seized) and must never be added to the perp numbers. A long is force-closed by selling, so long dollars are sell-side pressure. The Hyperliquid share is a sample of that venue, not its full liquidation record, so perp totals are a floor.",
        "tags": [
          "Whales",
          "free"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "$ref": "#/components/schemas/LiquidationLane"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [],
        "x-credits": 0
      },
      "servers": [
        {
          "url": "https://coinlobster.com",
          "description": "Free public surface (not under /api/ai/v1)"
        }
      ]
    },
