{
  "openapi": "3.1.0",
  "info": {
    "title": "CoinLobster Crypto Data API",
    "description": "Real-time crypto whale tracker: live whale trades, whale alerts and smart money across 18 exchanges, plus on-chain DEX swaps, market data, scored trading signals and DeFi analytics. Everything runs on credits (10-50 per call): buy credit packs pay-per-request, or subscribe monthly for a cheaper credit allowance that refills each billing cycle (unused allowance does not roll over; packs never expire). Commercial use allowed on every paid plan. POST /register with your email to create a key and purchase credits or a plan via Stripe. Free, no-key endpoints and the MCP server (/mcp) are documented under the \"free\" tag. See /llms.txt for an LLM-readable overview.",
    "version": "3.1.0",
    "contact": {
      "name": "CoinLobster",
      "email": "info@coinlobster.com",
      "url": "https://coinlobster.com"
    },
    "x-pricing": {
      "model": "credits",
      "credit_packs": {
        "starter": {
          "price": "$10",
          "credits": 5000
        },
        "pro": {
          "price": "$49",
          "credits": 50000
        },
        "enterprise": {
          "price": "$199",
          "credits": 250000
        }
      },
      "cost_per_request": "10-50 credits depending on endpoint",
      "subscriptions": {
        "free": {
          "name": "Free",
          "price_monthly": "$0",
          "credits_per_month": 250,
          "custom_alerts": 1
        },
        "starter": {
          "name": "Starter",
          "price_monthly": "$15",
          "price_annual": "$150",
          "credits_per_month": 20000,
          "custom_alerts": 20,
          "buy_at": "https://coinlobster.com/pricing",
          "license": "Commercial use allowed."
        },
        "pro": {
          "name": "Pro",
          "price_monthly": "$29",
          "price_annual": "$290",
          "credits_per_month": 100000,
          "custom_alerts": 50,
          "buy_at": "https://coinlobster.com/pricing",
          "license": "Commercial use allowed."
        },
        "alpha": {
          "name": "Alpha",
          "price_monthly": "$99",
          "price_annual": "$990",
          "credits_per_month": 500000,
          "custom_alerts": 50,
          "buy_at": "https://coinlobster.com/pricing",
          "license": "Commercial use allowed."
        }
      },
      "subscription_note": "One plan covers the website, your AI (MCP) and this API on one shared credit balance. Plan credits refill each billing cycle and unused credits do not roll over. Credit packs never expire."
    },
    "x-llms-txt": "https://coinlobster.com/llms.txt",
    "x-llms-full-txt": "https://coinlobster.com/llms-full.txt",
    "x-agents-json": "https://coinlobster.com/.well-known/agents.json",
    "x-mcp-server": "https://coinlobster.com/mcp-server.json"
  },
  "servers": [
    {
      "url": "https://coinlobster.com/api/ai/v1",
      "description": "Production"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "account",
      "description": "Registration, key status, pricing, credit balance, and health check. No credit cost."
    },
    {
      "name": "market",
      "description": "Live price, combined orderbook, funding rates and open interest across 18 exchanges, plus liquidations from the venues that publish them."
    },
    {
      "name": "whales",
      "description": "Whale intelligence: merged CEX + on-chain DEX tape, the Smart Money Radar, and per-coin hourly flow buckets."
    },
    {
      "name": "analytics",
      "description": "Signal-ledger data: raw fired flag rows and per-type firing history, with fire-time price and later outcomes, never backfilled."
    },
    {
      "name": "news",
      "description": "AI-generated news summaries, raw headlines, and sentiment scoring."
    },
    {
      "name": "defi",
      "description": "DEX/DeFi trading summaries and top tokens by volume."
    },
    {
      "name": "free",
      "description": "No API key required. The public endpoints that back the CoinLobster web terminal, plus the MCP server at /mcp. Documented here even though they sit outside the /api/ai/v1 base (see each path's servers override)."
    },
    {
      "name": "Hyperliquid",
      "description": "Named-wallet whale data from Hyperliquid, the one venue whose public tape identifies the account on both sides of a fill."
    },
    {
      "name": "DeFi",
      "description": "On-chain DEX analytics across Ethereum, Base and Arbitrum."
    },
    {
      "name": "Watches",
      "description": "Standing watches that push to your webhook when they fire."
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "API key obtained via POST /register with email + credit pack purchase, or a key from an account on a monthly plan (Starter, Pro or Alpha, bought at https://coinlobster.com/pricing). Pass as: Authorization: Bearer cl_xxx... Every request deducts the endpoint's credit cost (10-50 credits); plan keys draw from a monthly allowance that refills each billing cycle."
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "Meta": {
        "type": "object",
        "description": "Present on every /api/ai/v1 response.",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "When this response was assembled, not when the data was measured."
          },
          "credits_used": {
            "type": "integer",
            "description": "Credits this call spent. Absent on free surfaces and on keyless calls."
          },
          "credits_remaining": {
            "type": "integer",
            "description": "Account balance after this call."
          },
          "deprecation": {
            "type": "string",
            "description": "Present when the request used a deprecated form, e.g. the key in the query string."
          }
        }
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "example": "missing_api_key"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "WhaleTrade": {
        "type": "object",
        "description": "One EXECUTED trade above the coin liquidity floor. Not a wallet transfer: it has a direction and a price.",
        "properties": {
          "tradeId": {
            "type": "string"
          },
          "pair": {
            "type": "string",
            "example": "BTC/USD"
          },
          "exchange": {
            "type": "string",
            "example": "Binance"
          },
          "price": {
            "type": "number"
          },
          "quantity_base": {
            "type": "number",
            "description": "Size in the base asset."
          },
          "quantity_quote": {
            "type": "number",
            "description": "Size in USD. This is the number to rank or sum on."
          },
          "isBuy": {
            "type": "boolean",
            "description": "true = the aggressor bought."
          },
          "timestamp": {
            "type": "integer",
            "description": "Milliseconds since epoch."
          }
        }
      },
      "RadarRow": {
        "type": "object",
        "description": "One coin in one window. `multiple` compares this window against the coin OWN trailing hours, so it is not comparable across coins.",
        "properties": {
          "coin": {
            "type": "string",
            "example": "SOL"
          },
          "buyUsd": {
            "type": "number"
          },
          "sellUsd": {
            "type": "number"
          },
          "netUsd": {
            "type": "number"
          },
          "totalUsd": {
            "type": "number"
          },
          "multiple": {
            "type": [
              "number",
              "null"
            ],
            "description": "How many times the coin own normal this window is. null when the baseline is too short to judge."
          },
          "z": {
            "type": "number"
          },
          "direction": {
            "type": "string",
            "enum": [
              "buy",
              "sell",
              "flat"
            ]
          },
          "venues": {
            "type": "integer",
            "description": "Distinct venues that contributed."
          },
          "unusual": {
            "type": "boolean"
          },
          "coldStart": {
            "type": "boolean",
            "description": "Not enough history to judge yet. Treat `multiple` as unreliable."
          },
          "lowCoverage": {
            "type": "boolean",
            "description": "The collector missed hours in this window."
          },
          "hoursOfHistory": {
            "type": "integer"
          },
          "recordHigh": {
            "type": "boolean",
            "description": "1h window only: this hour beats every completed hour in the baseline."
          },
          "hadDex": {
            "type": "boolean"
          },
          "hadHl": {
            "type": "boolean"
          },
          "hlInBaseline": {
            "type": "boolean",
            "description": "false means Hyperliquid dollars are held out of BOTH sides of `multiple` while its own coverage matures. They are still counted in the displayed flow."
          },
          "hlCoverageHours": {
            "type": "integer"
          },
          "namedWallets": {
            "type": "array",
            "description": "Accounts behind this flow, when the venue names them. Empty when the flow was anonymous CEX.",
            "items": {
              "type": "object",
              "properties": {
                "wallet": {
                  "type": "string"
                },
                "source": {
                  "type": "string",
                  "enum": [
                    "hl",
                    "dex"
                  ]
                },
                "buyUsd": {
                  "type": "number"
                },
                "sellUsd": {
                  "type": "number"
                },
                "path": {
                  "type": "string",
                  "description": "The page for this wallet. Never construct one yourself: hl and dex addresses have different pages."
                }
              }
            }
          },
          "sparkline": {
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        }
      },
      "LiquidationLane": {
        "type": "object",
        "description": "ONE lane. Perp and lending liquidations are different events and are never summed.",
        "properties": {
          "count": {
            "type": "integer"
          },
          "totalUsd": {
            "type": "number"
          },
          "longUsd": {
            "type": "number"
          },
          "shortUsd": {
            "type": "number"
          },
          "longSharePct": {
            "type": [
              "number",
              "null"
            ],
            "description": "null on an empty window. Never defaults to 50."
          }
        }
      },
      "FlagRow": {
        "type": "object",
        "description": "One signal-ledger firing, written at fire time and never backfilled. Outcomes are appended later.",
        "properties": {
          "type": {
            "type": "string",
            "example": "whale-spike"
          },
          "coin": {
            "type": "string"
          },
          "firedAt": {
            "type": "integer"
          },
          "price": {
            "type": "number",
            "description": "Price at fire time."
          },
          "outcomes": {
            "type": "object",
            "description": "Absent or partial until enough time has passed. Never inferred.",
            "properties": {
              "h24": {
                "type": "object",
                "properties": {
                  "ok": {
                    "type": "boolean",
                    "description": "false means the outcome could not be scored cleanly. Do not read `ret`."
                  },
                  "ret": {
                    "type": "number",
                    "description": "Fractional return, e.g. 0.012 = +1.2%."
                  }
                }
              }
            }
          }
        }
      },
      "DailyPoint": {
        "type": "object",
        "description": "One recorded day. The archive starts when recording started, so a short series is a coverage fact, not a quiet market.",
        "properties": {
          "d": {
            "type": "string",
            "example": "2026-08-01"
          },
          "avg": {
            "type": "number"
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "n": {
            "type": "integer",
            "description": "Observations behind this day."
          }
        }
      },
      "FundingRow": {
        "type": "object",
        "properties": {
          "exchange": {
            "type": "string"
          },
          "rate": {
            "type": "number",
            "description": "Fractional per interval, e.g. 0.0001 = 0.01%."
          },
          "nextRate": {
            "type": [
              "number",
              "null"
            ],
            "description": "Only where the venue publishes a prediction."
          },
          "timestamp": {
            "type": "integer"
          }
        }
      },
      "TokenRow": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string"
          },
          "chain": {
            "type": "string",
            "enum": [
              "ethereum",
              "base",
              "arbitrum"
            ]
          },
          "price_usd": {
            "type": "number"
          },
          "volume_24h_usd": {
            "type": "number"
          },
          "tvl_usd": {
            "type": "number"
          }
        }
      },
      "HyperliquidPosition": {
        "type": "object",
        "description": "Hyperliquid names the wallet on both sides of a fill, so a position is attributable to an account.",
        "properties": {
          "coin": {
            "type": "string"
          },
          "base": {
            "type": "string",
            "description": "Parsed symbol. A 1000-unit perp arrives as coin \"kPEPE\" with base \"PEPE\"."
          },
          "side": {
            "type": "string",
            "enum": [
              "long",
              "short"
            ]
          },
          "notionalUsd": {
            "type": "number"
          },
          "entryPx": {
            "type": "number"
          },
          "liquidationPx": {
            "type": [
              "number",
              "null"
            ]
          },
          "leverage": {
            "type": [
              "number",
              "null"
            ]
          },
          "unrealizedPnl": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    }
  },
  "paths": {
    "/discover": {
      "get": {
        "operationId": "discoverApi",
        "summary": "Discover API capabilities, pricing, and how to get started",
        "description": "No authentication required. Returns the full API catalog with all 24 data endpoints, pricing (credit packs and subscriptions), and step-by-step instructions for obtaining an API key. This is the entry point for AI agents discovering this API.",
        "security": [],
        "tags": [
          "account"
        ],
        "x-tier": "public",
        "x-credits": 0,
        "responses": {
          "200": {
            "description": "API discovery information including endpoints, pricing, and registration instructions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "type": "object",
                      "description": "Endpoint-specific payload. Every field it carries is documented in llms-full.txt and returned by /discover."
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/register": {
      "post": {
        "operationId": "registerApiKey",
        "summary": "Self-service API key registration (credit pack or subscription)",
        "description": "No authentication required. Creates an API key and returns a Stripe payment URL. After payment, poll GET /register/status?key_id=xxx to retrieve the activated key. Pass \"pack\" (starter $10/5,000 credits, pro $49/50,000 credits, enterprise $199/250,000 credits). Monthly plans (Starter, Pro, Alpha) are bought at https://coinlobster.com/pricing with a free account; a \"tier\" sent here returns that list. All 22 data endpoints are available on every plan; every request deducts the endpoint's credit cost, and plan credits refill each billing cycle.",
        "security": [],
        "tags": [
          "account"
        ],
        "x-tier": "public",
        "x-credits": 0,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "description": "Email address for the API key owner"
                  },
                  "label": {
                    "type": "string",
                    "description": "Optional label for this key (e.g. 'My Trading Bot')"
                  },
                  "pack": {
                    "type": "string",
                    "enum": [
                      "starter",
                      "pro",
                      "enterprise"
                    ],
                    "default": "starter",
                    "description": "Credit pack to purchase: starter ($10/5,000 credits), pro ($49/50,000 credits), enterprise ($199/250,000 credits). Mutually exclusive with tier."
                  },
                  "tier": {
                    "type": "string",
                    "description": "Retired. Monthly plans are bought at https://coinlobster.com/pricing (see info.x-pricing); a tier sent here is refused with the plans on sale. Mutually exclusive with pack."
                  }
                }
              },
              "example": {
                "email": "agent@example.com",
                "pack": "starter",
                "label": "My Trading Bot"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Pending API key created. Complete payment at the payment_url, then poll GET /register/status?key_id=xxx&poll_token=xxx (both returned here) to get your API key.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "key_id": {
                          "type": "string",
                          "description": "Key ID for polling status"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "pending_payment"
                          ]
                        },
                        "pack": {
                          "type": "object",
                          "properties": {
                            "name": {
                              "type": "string"
                            },
                            "credits": {
                              "type": "integer"
                            },
                            "price": {
                              "type": "string"
                            }
                          }
                        },
                        "tier": {
                          "type": "object",
                          "properties": {
                            "name": {
                              "type": "string"
                            },
                            "price_monthly": {
                              "type": "integer"
                            }
                          }
                        },
                        "payment_url": {
                          "type": "string",
                          "description": "Stripe Checkout URL: complete payment here"
                        },
                        "next_step": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid email, ambiguous billing (both pack and tier), or key limit reached",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/pricing": {
      "get": {
        "operationId": "getPricingInfo",
        "summary": "Get API credit pack and subscription pricing",
        "description": "No authentication required. Returns pay-per-request credit pack pricing, subscription tier pricing, and endpoint costs.",
        "security": [],
        "tags": [
          "account"
        ],
        "x-tier": "public",
        "x-credits": 0,
        "responses": {
          "200": {
            "description": "Credit pack pricing, subscription pricing, and endpoint cost information",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "type": "object",
                      "description": "Endpoint-specific payload. Every field it carries is documented in llms-full.txt and returned by /discover."
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/register/status": {
      "get": {
        "operationId": "getRegistrationStatus",
        "summary": "Check API key registration status after payment",
        "description": "No authentication required. Poll this endpoint after completing Stripe payment to get your activated API key. The API key is revealed here once, after payment succeeds.",
        "security": [],
        "tags": [
          "account"
        ],
        "x-tier": "public",
        "x-credits": 0,
        "parameters": [
          {
            "name": "key_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The key_id returned from POST /register"
          }
        ],
        "responses": {
          "200": {
            "description": "Key status: pending_payment or active (with API key)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "type": "object",
                      "description": "Endpoint-specific payload. Every field it carries is documented in llms-full.txt and returned by /discover."
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/credits/balance": {
      "get": {
        "operationId": "getCreditBalance",
        "summary": "Check your remaining credit balance",
        "description": "Returns your current credit balance, total credits used, total purchased, and total requests made. Plan keys see their rolling allowance balance here too.",
        "tags": [
          "account"
        ],
        "x-tier": "account",
        "x-credits": 0,
        "responses": {
          "200": {
            "description": "Credit balance and usage stats",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "type": "object",
                      "description": "Endpoint-specific payload. Every field it carries is documented in llms-full.txt and returned by /discover."
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/credits/purchase": {
      "post": {
        "operationId": "purchaseCredits",
        "summary": "Buy more API credits",
        "description": "Returns a Stripe Checkout URL to purchase additional credits. Choose starter ($10/5,000), pro ($49/50,000), or enterprise ($199/250,000). Works on any key, including plan keys that ran dry mid-cycle.",
        "tags": [
          "account"
        ],
        "x-tier": "account",
        "x-credits": 0,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "pack": {
                    "type": "string",
                    "enum": [
                      "starter",
                      "pro",
                      "enterprise"
                    ],
                    "default": "pro"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Checkout URL for credit purchase",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "type": "object",
                      "description": "Endpoint-specific payload. Every field it carries is documented in llms-full.txt and returned by /discover."
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/status": {
      "get": {
        "operationId": "getApiStatus",
