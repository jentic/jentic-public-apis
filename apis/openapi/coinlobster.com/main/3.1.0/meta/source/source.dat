    "/market/liquidations": {
      "get": {
        "operationId": "getRecentLiquidations",
        "summary": "Get recent liquidations across futures exchanges",
        "description": "Recent liquidation events for one pair with the long vs short breakdown. Same composer as the keyless MCP liquidations tool, so the answer is never thinner than the free one: the live feed is merged with the persisted recorded series (history_included says whether that happened), duplicates and zero-size rows are dropped, and window_minutes states the period the answer covers so a count of 0 is a bounded claim. long_liquidations and short_liquidations are event COUNTS; long_usd and short_usd carry the dollar split. A long is force-closed by selling, so sell-side events are long liquidations.",
        "tags": [
          "market"
        ],
        "x-tier": "all",
        "x-credits": 20,
        "parameters": [
          {
            "name": "pair",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "BTC/USD"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 50,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Liquidation events with aggregate stats",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "$ref": "#/components/schemas/LiquidationLane"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/analytics/signals": {
      "get": {
        "operationId": "getSignalLedgerFlags",
        "summary": "Get raw fired signal-ledger flags (whale spikes, funding extremes, squeeze flips, liquidation cascades, flow divergence, and more)",
        "description": "Returns raw fired flag rows from the signal ledger: fire-time price/magnitude snapshot plus later h1/h24/h72 price outcomes. Rows are logged live at fire time and never recomputed or reshaped at read time or backfilled. Descriptive history only, no forecast language.",
        "tags": [
          "analytics"
        ],
        "x-tier": "all",
        "x-credits": 50,
        "parameters": [
          {
            "name": "hours",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 48,
              "maximum": 168
            },
            "description": "Lookback window in hours"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 60,
              "maximum": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Fired signal-ledger rows, with meta.depth_note = 'fire-time rows, never backfilled; live since 2026-07-13' and meta.types listing the 8 flag type codes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/FlagRow"
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
