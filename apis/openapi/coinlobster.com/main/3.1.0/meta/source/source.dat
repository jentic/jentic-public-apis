    "/api/public/defi-liquidations": {
      "get": {
        "summary": "DeFi lending liquidations",
        "description": "Lending liquidations from Aave V3 on Ethereum, Arbitrum and Base. A third party repaid the debt and seized the collateral, so both wallets are named. Distinct from a perp liquidation and never summed with one. count and total_usd cover exactly the rows returned, and the window field states the period those rows span: it is a page sum, not a fixed 24h total. The 24h lending figure lives on /api/public/liquidations. Aave profitUSD is broken upstream and is never reported.",
        "tags": [
          "DeFi",
          "free"
        ],
        "parameters": [
          {
            "name": "chain",
            "in": "query",
