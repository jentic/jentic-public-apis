{
  "openapi": "3.1.0",
  "info": {
    "title": "ZOLEO API",
    "version": "1.0.0",
    "description": "Contract for the ZOLEO backend endpoints consumed by the Android App. The API is hosted on Global Alerting Platform (GAP) infrastructure with separate tenants for production and beta environments.\n",
    "license": {
      "name": "Roadpost",
      "url": "https://www.roadpost.com/"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/OSCARRODRIGUEZ_1/zoleo-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://api-gap-us-3.globalalerting.com/v2/6913",
      "description": "Production server (`X-GAPAPIKEY` required after initial registration)"
    },
    {
      "url": "https://api-gap-beta.globalalerting.com/v2/2264",
      "description": "Staging server"
    },
    {
      "url": "https://zoleo-api-us-3.globalalerting.com/v2/6913",
      "description": "AppDome hardened production registration gateway (requires `X-SECURITY-KEY` & `SECRET-TOKEN`)"
    },
    {
      "url": "https://zoleo-webapi-beta.globalalerting.com/v2/2264",
      "description": "AppDome hardened beta registration gateway (requires `X-VERIMATRIX-KEY` & `SECRET-TOKEN`)"
    }
  ],
  "tags": [
    {
      "name": "Registration",
      "description": "Registration and authentication endpoints."
    },
    {
      "name": "Device",
      "description": "Device management endpoints."
    },
    {
      "name": "Messaging",
      "description": "Messaging endpoints."
    },
    {
      "name": "Notifications",
      "description": "Notification endpoints."
    },
    {
      "name": "Weather",
      "description": "Weather endpoints."
    },
    {
      "name": "Geolocation",
      "description": "Geolocation endpoints."
    },
    {
      "name": "Administration",
      "description": "Administration endpoints."
    }
  ],
  "paths": {
    "/zoleosignup": {
      "post": {
        "operationId": "zoleosignup",
        "summary": "Device Registration",
        "description": "Multipurpose endpoint that issues registration, verification code, confirm phone number, and provision API keys for a device. The same path is used for change-number flows.\n**Case 1:** Initial sign up - {\n    FriendlyName: \"<string>\"\n    NotificationToken: \"<string>\"\n    PhoneNumber: \"<string>\"\n    PhoneType: \"<string>\"\n  }\n- Returns nothing\n**Case 2:** Phone number verification - {\n    FriendlyName: \"<string>\"\n    NotificationToken: \"<string>\"\n    PhoneNumber: \"<string>\"\n    PhoneType: \"<string>\"\n    Code: \"<string>\"\n  }\n\n- Returns {\n    DeviceId: \"<string>\"\n    ApiKey: \"<string>\"\n  }\n\n**Case 3:** Change phone number - {\n    DeviceId: \"<string>\"\n    PhoneNumber: \"<string>\"\n    PhoneType: \"<string>\"\n  }\n- Returns nothing\n**Case 4:** Change phone number verification - {\n    DeviceId: \"<string>\"\n    FriendlyName: \"<string>\"\n    NotificationToken: \"<string>\"\n    PhoneNumber: \"<string>\"\n    PhoneType: \"<string>\"\n    Code: \"<string>\"\n  }\n- Returns {\n    DeviceId: \"<string>\"\n    ApiKey: \"<string>\"\n  }\n",
        "tags": [
          "Device"
        ],
        "requestBody": {
          "required": true,
          "description": "Request body for device registration, phone number verification, or change-number flows.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignupRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success registration or verification.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/SignUpResponse"
                    },
                    {
                      "$ref": "#/components/schemas/VerifyPhoneNumberResponse"
                    }
                  ]
                },
                "examples": {
                  "signUpResponse": {
                    "summary": "Success sign up response (empty body)",
                    "value": null
                  },
                  "verifyPhoneNumberResponse": {
                    "$ref": "#/components/examples/verifyPhoneNumberResponse"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        },
        "security": [
          {
            "SecurityKey": []
          },
          {
            "RecaptchaToken": []
          }
        ]
      }
    },
