    "/zoleoforecast/{deviceId}/{latitude}/{longitude}": {
      "get": {
        "operationId": "getWeatherForecast",
        "summary": "Retrieve weather forecast for a device location",
        "description": "Retrieve weather forecast and current conditions for a specific device location.",
        "tags": [
          "Weather"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/DeviceId"
          },
          {
            "in": "path",
            "name": "latitude",
            "required": true,
            "example": 62.32664,
            "schema": {
              "type": "number",
              "format": "double"
            }
          },
          {
            "in": "path",
            "name": "longitude",
            "required": true,
            "example": -109.003953,
            "schema": {
              "type": "number",
              "format": "double"
            }
          },
          {
            "in": "query",
            "name": "language",
            "example": "en",
            "schema": {
              "type": "string",
              "default": "en"
            },
            "description": "ISO language code for localized summaries."
          }
        ],
        "responses": {
          "200": {
            "description": "Weather forecasts and current conditions.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WeatherResponse"
                },
                "examples": {
