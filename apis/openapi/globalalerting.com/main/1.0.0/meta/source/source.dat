    "/zoleo/{deviceId}/mtmessages/{messageId}": {
      "get": {
        "operationId": "getMtMessages",
        "summary": "Retrieve MT messages",
        "description": "Retrieve Mobile Terminated (MT) messages for a specific device.",
        "tags": [
          "Messaging"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/DeviceId"
          },
          {
            "in": "path",
            "name": "messageId",
            "required": true,
            "example": "2518496932919889999",
            "schema": {
              "type": "string"
            },
            "description": "Identifier of the last MT message received by the device. Use `0` to request all available messages.\n"
          }
        ],
        "responses": {
          "200": {
            "description": "MT messages grouped by chunk.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MTMessageResponse"
                  }
                },
                "examples": {
                  "mtMessagesExample": {
                    "$ref": "#/components/examples/mtMessagesResponse"
                  }
                }
              }
            }
          },
          "204": {
            "description": "No MT messages available"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        },
        "security": [
          {
            "GapApiKey": []
          }
        ]
      }
    },
    "/zoleo/{deviceId}/messages/{recipientAppId}": {
      "delete": {
        "operationId": "deleteConversationThread",
        "summary": "Delete conversation thread",
        "description": "Deletes all messages in a conversation",
        "tags": [
          "Messaging"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/DeviceId"
          },
          {
            "in": "path",
            "name": "recipientAppId",
            "description": "recipient app ID is either the phone number of the sender in the case of A2A or SMS,or the email address in the case of an email.\n",
            "required": true,
            "example": "+16471234567",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Conversation thread deleted successfully"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        },
        "security": [
          {
            "GapApiKey": []
          }
        ]
      }
    },
