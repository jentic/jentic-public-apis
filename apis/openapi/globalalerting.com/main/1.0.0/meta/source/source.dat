    "/devices/{deviceId}/momessages": {
      "get": {
        "operationId": "getMoMessages",
        "summary": "Retrieve MO messages",
        "description": "Retrieve a list of MO (Mobile Originated) messages for a specific device.",
        "tags": [
          "Messaging"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/DeviceId"
          },
          {
            "in": "query",
            "name": "$filter",
            "schema": {
              "type": "string"
            },
            "description": "Optional OData-style filter expression."
          },
          {
            "in": "query",
            "name": "orderby",
            "schema": {
              "type": "string"
            },
            "description": "Optional sort expression."
          }
        ],
        "responses": {
          "200": {
            "description": "List of MO messages.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MOMessageResponse"
                  }
                },
                "examples": {
                  "moMessagesResponse": {
                    "$ref": "#/components/examples/moMessagesResponse"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        },
        "security": [
          {
            "GapApiKey": []
          }
        ]
      },
      "post": {
        "operationId": "postMoMessages",
        "tags": [
          "Messaging"
        ],
        "summary": "Send one or more MO messages",
        "parameters": [
          {
            "$ref": "#/components/parameters/DeviceId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/MOMessageRequest"
                }
              },
              "examples": {
                "sendMoMessage": {
                  "$ref": "#/components/examples/sendMoMessageRequest"
                }
              }
            }
          }
        },
        "responses": {
