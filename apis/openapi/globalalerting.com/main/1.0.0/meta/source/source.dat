    "/devices/{deviceId}/{messageDirection}/{messageId}": {
      "delete": {
        "operationId": "deleteMessage",
        "summary": "Delete a specific message on the server",
        "description": "Delete a specific message on the server for a given device.",
        "tags": [
          "Messaging"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/DeviceId"
          },
          {
            "in": "path",
            "name": "messageDirection",
            "description": "(momessages|mtmessages)",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "momessages",
                "mtmessages"
              ]
            }
          },
          {
            "in": "path",
            "name": "messageId",
            "description": "The message identifier",
            "required": true,
            "example": "2518496932919889999",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Message deleted successfully"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        },
        "security": [
          {
            "GapApiKey": []
          }
        ]
      }
    },
