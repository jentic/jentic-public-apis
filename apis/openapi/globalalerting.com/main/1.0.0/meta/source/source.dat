    "/zoleocontactslookup": {
      "post": {
        "operationId": "lookupContacts",
        "summary": "Contacts lookup",
        "description": "Accepts a list of phone numbers and returns matching ZOLEO contacts.",
        "tags": [
          "Device"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContactsLookupRequest"
              },
              "examples": {
                "lookupRequest": {
                  "$ref": "#/components/examples/lookupRequest"
                }
              }
            }
          }
