omain. An unknown domain returns an empty page.","schema":{"example":"stripe.com","type":"string"}},{"name":"includeTotal","required":false,"in":"query","description":"Also return pagination.total, the number of records matching these filters across all pages. Costs no credits; adds a count query, so ask for it when you need the list size.","schema":{"example":true,"type":"boolean"}}],"responses":{"200":{"description":"Request accepted. The number of records returned may be lower than limit when credits or data run out.","content":{"application/json":{"schema":{"type":"object","required":["success","data","pagination","meta"],"properties":{"success":{"type":"boolean","enum":[true],"example":true},"data":{"type":"array","items":{"$ref":"#/components/schemas/PublicFundingEventResponseItem"}},"pagination":{"$ref":"#/components/schemas/PublicPagination"},"meta":{"$ref":"#/components/schemas/PublicResponseMeta"}}}}}},"400":{"description":"Invalid query parameter, body, or pagination cursor.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PublicErrorEnvelope"},"example":{"success":false,"error":{"code":"INVALID_INPUT","message":"limit must not be greater than 100"},"meta":{"requestId":"019e8a3c-9f0b-7c12-88ab-1d2e3f4a5b6c"}}}}},"401":{"description":"Missing, invalid, or disabled API key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PublicErrorEnvelope"},"example":{"success":false,"error":{"code":"UNAUTHORIZED","message":"Missing or invalid API key."},"meta":{"requestId":"019e8a3c-9f0b-7c12-88ab-1d2e3f4a5b6c"}}}}},"402":{"description":"Workspace has no credits available for the request.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PublicErrorEnvelope"},"example":{"success":false,"error":{"code":"PAYMENT_REQUIRED","message":"Workspace has no credits remaining. Top up to continue."},"meta":{"requestId":"019e8a3c-9f0b-7c12-88ab-1d2e3f4a5b6c"}}}}},"403":{"description":"Request blocked by abuse prevention policy.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PublicErrorEnvelope"},"example":{"success":false,"error":{"code":"FORBIDDEN","message":"Request blocked by abuse prevention policy."},"meta":{"requestId":"019e8a3c-9f0b-7c12-88ab-1d2e3f4a5b6c"}}}}},"429":{"description":"Rate limit exceeded for this workspace and plan.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PublicErrorEnvelope"},"example":{"success":false,"error":{"code":"TOO_MANY_REQUESTS","message":"Rate limit exceeded for this workspace and plan."},"meta":{"requestId":"019e8a3c-9f0b-7c12-88ab-1d2e3f4a5b6c"}}}}}},"security":[{"apiKey":[]}],"summary":"List funding events","tags":["funding-events"]}},"/v1/acquisitions":{"get":{"description":"Returns acquisition and merger events ordered by announcement date, newest first. Costs one credit per returned record.","operationId":"acquisitions_list","parameters":[{"name":"cursor","required":false,"in":"query","description":"Opaque pagination cursor returned as pagination.nextCursor.","schema":{"type":"string"}},{"name":"since","required":false,"in":"query","description":"Return events announced on or after this date (YYYY-MM-DD). ISO-8601 timestamps are also accepted.","schema":{"example":"2026-05-01","type":"string"}},{"name":"until","required":false,"in":"query","description":"Return events announced on or before this date (YYYY-MM-DD, inclusive). ISO-8601 timestamps are also accepted.","schema":{"example":"2026-05-30","type":"string"}},{"name":"limit","required":false,"in":"query","description":"Maximum records to return.","schema":{"minimum":1,"maximum":100,"default":20,"type":"number"}},{"name":"paymentType","required":false,"in":"query","description":"Payment type filters. Repeat the query key for multiple values.","schema":{"example":["cash","stock"],"type":"array","items":{"type":"string","enum":["cash","stock","mixed","undisclosed"]}}},{"name":"minAmountUsd","required":false,"in":"query","description":"