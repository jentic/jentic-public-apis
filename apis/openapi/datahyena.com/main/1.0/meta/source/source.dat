and Roller Manufacturing","Agriculture, Construction, Mining Machinery Manufacturing","Commercial and Service Industry Machinery Manufacturing","HVAC and Refrigeration Equipment Manufacturing","Metalworking Machinery Manufacturing","Engines and Power Transmission Equipment Manufacturing","Communications Equipment Manufacturing","Audio and Video Equipment Manufacturing","Measuring and Control Instrument Manufacturing","Magnetic and Optical Media Manufacturing","Electric Lighting Equipment Manufacturing","Household Appliance Manufacturing","Transportation Equipment Manufacturing","Motor Vehicle Parts Manufacturing","Household and Institutional Furniture Manufacturing","Office Furniture and Fixtures Manufacturing","Mattress and Blinds Manufacturing","Wholesale Motor Vehicles and Parts","Wholesale Furniture and Home Furnishings","Wholesale Photography Equipment and Supplies","Wholesale Computer Equipment","Wholesale Metals and Minerals","Wholesale Appliances, Electrical, and Electronics","Wholesale Hardware, Plumbing, Heating Equipment","Wholesale Machinery","Wholesale Recyclable Materials","Wholesale Luxury Goods and Jewelry","Wholesale Paper Products","Wholesale Drugs and Sundries","Wholesale Apparel and Sewing Supplies","Wholesale Footwear","Wholesale Food and Beverage","Wholesale Raw Farm Products","Wholesale Chemical and Allied Products","Wholesale Petroleum and Petroleum Products","Wholesale Alcoholic Beverages","Internet Marketplace Platforms","Retail Motor Vehicles","Retail Furniture and Home Furnishings","Retail Appliances, Electrical, and Electronic Equipment","Retail Building Materials and Garden Equipment","Food and Beverage Retail","Retail Health and Personal Care Products","Retail Gasoline","Retail Musical Instruments","Retail Books and Printed News","Retail Florists","Retail Office Supplies and Gifts","Retail Recyclable Materials & Used Merchandise","Online and Mail Order Retail","Rail Transportation","Ground Passenger Transportation","Urban Transit Services","Interurban and Rural Bus Services","Taxi and Limousine Services","School and Employee Bus Services","Shuttles and Special Needs Transportation Services","Pipeline Transportation","Sightseeing Transportation","Postal Services","Technology, Information and Media","Periodical Publishing","Book Publishing","Movies and Sound Recording","Sound Recording","Sheet Music Publishing","Radio and Television Broadcasting","Cable and Satellite Programming","Telecommunications Carriers","Satellite Telecommunications","Credit Intermediation","Savings Institutions","Loan Brokers","Securities and Commodity Exchanges","Investment Advice","Insurance Carriers","Insurance Agencies and Brokerages","Claims Adjusting, Actuarial Services","Funds and Trusts","Insurance and Employee Benefit Funds","Pension Funds","Trusts and Estates","Real Estate and Equipment Rental Services","Leasing Residential Real Estate","Real Estate Agents and Brokers","Equipment Rental Services","Consumer Goods Rental","Commercial and Industrial Equipment Rental","Professional Services","IT System Design Services","Marketing Services","Holding Companies","Industry Associations","Professional Organizations","Administrative and Support Services","Office Administration","Executive Search Services","Temporary Help Services","Telephone Call Centers","Collection Agencies","Security Guards and Patrol Services","Security Systems Services","Janitorial Services","Waste Collection","Waste Treatment and Disposal","Education","Secretarial Schools","Technical and Vocational Training","Cosmetology and Barber Schools","Flight Training","Fine Arts Schools","Sports and Recreation Instruction","Language Schools","Physicians","Dentists","Chiropractors","Optometrists","Physical, Occupational and Speech Therapists","Family Planning Centers","Outpatient Care Centers","Medical and Diagnostic Laboratories","Home Health Care Services","Ambulance Services","Hospitals","Nursing Homes and Residential Care Facilities","Services for the Elderly and Disabled","Community Services","Emergency and Relief Services","Vocational Rehabilitation Services","Child Day Care Services","Performing Arts and Spectator Sports","Theater Companies","Dance Companies","Circuses and Magic Shows","Sports Teams and Clubs","Racetracks","Museums","Historical Sites","Zoos and Botanical Gardens","Amusement Parks and Arcades","Golf Courses and Country Clubs","Skiing Facilities","Accommodation Services","Hotels and Motels","Bed-and-Breakfasts, Hostels, Homestays","Caterers","Mobile Food Services","Bars, Taverns, and Nightclubs","Repair and Maintenance","Vehicle Repair and Maintenance","Electronic and Precision Equipment Maintenance","Commercial and Industrial Machinery Maintenance","Reupholstery and Furniture Repair","Footwear and Leather Goods Repair","Personal and Laundry Services","Personal Care Services","Laundry and Drycleaning Services","Pet Services","Household Services","Health and Human Services","Public Health","Public Assistance Programs","Air, Water, and Waste Program Management","Conservation Programs","Housing and Community Development","Community Development and Urban Planning","Economic Programs","Military and International Affairs","Operations Consulting","Data Infrastructure and Analytics","Electrical Equipment Manufacturing","Wind Electric Power Generation","Wineries","Landscaping Services","Courts of Law","Correctional Institutions","Fire Protection","Housing Programs","Transportation Programs","Utilities Administration","Space Research and Technology","Oil Extraction","Natural Gas Extraction","Embedded Software Products","Mobile Computing Software Products","Desktop Computing Software Products","IT System Custom Software Development","IT System Operations and Maintenance","IT System Installation and Disposal","IT System Training and Support","IT System Data Services","IT System Testing and Evaluation","Internet News","Blogs","Interior Design","Social Networking Platforms","Business Intelligence Platforms","Business Content","Data Security Software Products","Mobile Gaming Apps","Internet Publishing","Media & Telecommunications","Blockchain Services","Retail Art Dealers","Renewable Energy Power Generation","Renewable Energy Equipment Manufacturing","Engineering Services","Services for Renewable Energy","Digital Accessibility Services","Accessible Hardware Manufacturing","Accessible Architecture and Design","Robot Manufacturing","Robotics Engineering","Surveying and Mapping Services","Retail Pharmacies","Climate Technology Product Manufacturing","Climate Data and Analytics","Alternative Fuel Vehicle Manufacturing","Smart Meter Manufacturing","Fuel Cell Manufacturing","Regenerative Design","unknown"]}}},{"name":"naicsCode","required":false,"in":"query","description":"NAICS 2022 code. Matches the code and everything beneath it, so \"51\" returns 5132 and 5173 as well. Sector ranges work too: \"31-33\" returns all manufacturing. Pass \"unknown\" for companies we could not classify.","schema":{"example":"5132","type":"string","enum":["11","111","1114","113","114","21","2111","212","22","2211","2213","23","236","2361","238","2382","31-33","311","3111","3115","3116","3117","3118","3121","3122","313","315","316","3162","321","322","3222","323","325","3253","3254","3255","3256","3261","327","3272","331","332","3323","3325","3328","3331","3332","3334","3341","3342","3343","3344","3345","335","3351","3352","3353","3359","336","3361","3363","3364","3365","3366","337","3372","3391","3399","42","4231","4233","4234","4235","4236","4238","4244","4245","4246","4247","4248","44-45","4411","4441","4451","4491","4561","4571","458","4591","4593","48-49","4811","482","483","484","485","4851","4853","4921","493","51","5121","5122","5131","5132","5161","5162","5173","519","5192","52","5221","5231","5239","5241","5242","53","5311","5312","532","5322","54","5411","5412","5413","5414","5415","5416","5417","5418","5419","5511","56","5613","5614","5615","5616","5617","562","5621","611","6111","6113","6114","6115","621","6213","6214","6215","6216","622","623","6241","6242","6244","71","7111","7112","7115","712","7132","7139","721","722","7225","81","811","8111","812","8121","8123","8129","813","8131","8132","8134","8139","92","9211","9221","9281","unknown"]}},{"name":"employeeCountBuckets","required":false,"in":"query","description":"LinkedIn employee count buckets (OR). Repeat the query key for multiple values. Use `unknown` to match companies with no headcount on file.","schema":{"example":["11-50","51-200"],"type":"array","items":{"type":"string","enum":["1-10","11-50","51-200","201-500","501-1000","1001-5000","5001-10000","10001+","unknown"]}}},{"name":"foundedYearMin","required":false,"in":"query","description":"Minimum founded year.","schema":{"minimum":0,"example":2015,"type":"number"}},{"name":"foundedYearMax","required":false,"in":"query","description":"Maximum founded year.","schema":{"minimum":0,"example":2026,"type":"number"}},{"name":"sort","required":false,"in":"query","description":"Sort order. \"prominence\" ranks by how notable a company is, from recent funding size and recency, acquisition activity and known people. Default \"recent\" is the delta-sync order and is what you want when paging the whole corpus.","schema":{"example":"prominence","type":"string","enum":["recent","prominence"]}},{"name":"order","required":false,"in":"query","description":"Direction for the prominence sort. Ignored when sort is \"recent\", which is always ascending so a delta sync never misses a row.","schema":{"example":"desc","type":"string","enum":["asc","desc"]}},{"name":"minFundingUsdLast12mo","required":false,"in":"query","description":"Only companies that raised at least this much (USD, not cents) in the last 12 months. Refreshed nightly.","schema":{"minimum":0,"example":10000000,"type":"number"}},{"name":"minKnownPeople","required":false,"in":"query","description":"Only companies with at least this many current known people on record.","schema":{"minimum":0,"example":3,"type":"number"}},{"name":"hasKnownFounder","required":false,"in":"query","description":"Only companies where a current founder is on record.","schema":{"example":true,"type":"boolean"}}],"responses":{"200":{"description":"Request accepted. The number of records returned may be lower than limit when credits or data run out.","content":{"application/json":{"schema":{"type":"object","required":["success","data","pagination","meta"],"properties":{"success":{"type":"boolean","enum":[true],"example":true},"data":{"type":"array","items":{"$ref":"#/components/schemas/PublicCompanyDto"}},"pagination":{"$ref":"#/components/schemas/PublicPagination"},"meta":{"$ref":"#/components/schemas/PublicResponseMeta"}}}}}},"400":{"description":"Invalid query parameter, body, or pagination cursor.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PublicErrorEnvelope"},"example":{"success":false,"error":{"code":"INVALID_INPUT","message":"limit must not be greater than 100"},"meta":{"requestId":"019e8a3c-9f0b-7c12-88ab-1d2e3f4a5b6c"}}}}},"401":{"description":"Missing, invalid, or disabled API key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PublicErrorEnvelope"},"example":{"success":false,"error":{"code":"UNAUTHORIZED","message":"Missing or invalid API key."},"meta":{"requestId":"019e8a3c-9f0b-7c12-88ab-1d2e3f4a5b6c"}}}}},"402":{"description":"Workspace has no credits available for the request.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PublicErrorEnvelope"},"example":{"success":false,"error":{"code":"PAYMENT_REQUIRED","message":"Workspace has no credits remaining. Top up to continue."},"meta":{"requestId":"019e8a3c-9f0b-7c12-88ab-1d2e3f4a5b6c"}}}}},"403":{"description":"Request blocked by abuse prevention policy.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PublicErrorEnvelope"},"example":{"success":false,"error":{"code":"FORBIDDEN","message":"Request blocked by abuse prevention policy."},"meta":{"requestId":"019e8a3c-9f0b-7c12-88ab-1d2e3f4a5b6c"}}}}},"429":{"description":"Rate limit exceeded for this workspace and plan.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PublicErrorEnvelope"},"example":{"success":false,"error":{"code":"TOO_MANY_REQUESTS","message":"Rate limit exceeded for this workspace and plan."},"meta":{"requestId":"019e8a3c-9f0b-7c12-88ab-1d2e3f4a5b6c"}}}}}},"security":[{"apiKey":[]}],"summary":"List companies","tags":["companies"]}},"/v1/companies/timeline":{"get":{"description":"Resolve one company by id, domain, name, or LinkedIn URL and return its timeline: firmographics, investors, and a chronological list of the event kinds in `include` (default all). Costs one credit per record returned (the company plus each event). Nothing is charged if no company matches.","operationId":"company_timeline_single","parameters":[{"name":"id","required":false,"in":"query","description":"Datahyena company id.","schema":{"type":"string"}},{"name":"domain","required":false,"in":"query","description":"Company domain, e.g. legora.com.","schema":{"example":"legora.com","type":"string"}},{"name":"name","required":false,"in":"query","description":"Company name.","schema":{"example":"Legora","type":"string"}},{"name":"linkedinUrl","required":false,"in":"query","description":"Company LinkedIn URL or handle.","schema":{"example":"https://www.linkedin.com/company/wearelegora","type":"string"}},{"name":"include","required":false,"in":"query","description":"Which event kinds to include. Defaults to all. Each pulled event costs one credit.","schema":{"type":"array","items":{"type":"string","enum":["funding","acquisitions","exec_moves"]}}}],"responses":{"200":{"description":"Item resolved. Returns the item and credit usage in meta.","content":{"application/json":{"schema":{"type":"object","required":["success","data","meta"],"properties":{"success":{"type":"boolean","enum":[true],"example":true},"data":{"$ref":"#/components/schemas/CompanyTimelineDto"},"meta":{"$ref":"#/components/schemas/PublicResponseMeta"}}}}}},"400":{"description":"Invalid query parameter, body, or pagination cursor.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PublicErrorEnvelope"},"example":{"success":false,"error":{"code":"INVALID_INPUT","message":"limit must not be greater than 100"},"meta":{"requestId":"019e8a3c-9f0b-7c12-88ab-1d2e3f4a5b6c"}}}}},"401":{"description":"Missing, invalid, or disabled API key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PublicErrorEnvelope"},"example":{"success":false,"error":{"code":"UNAUTHORIZED","message":"Missing or invalid API key."},"meta":{"requestId":"019e8a3c-9f0b-7c12-88ab-1d2e3f4a5b6c"}}}}},"402":{"description":"Workspace has no credits available for the request.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PublicErrorEnvelope"},"example":{"success":false,"error":{"code":"PAYMENT_REQUIRED","message":"Workspace has no credits remaining. Top up to continue."},"meta":{"requestId":"019e8a3c-9f0b-7c12-88ab-1d2e3f4a5b6c"}}}}},"403":{"description":"Request blocked by abuse prevention policy.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PublicErrorEnvelope"},"example":{"success":false,"error":{"code":"FORBIDDEN","message":"Request blocked by abuse prevention policy."},"meta":{"requestId":"019e8a3c-9f0b-7c12-88ab-1d2e3f4a5b6c"}}}}},"404":{"description":"No record matched the provided identifier.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PublicErrorEnvelope"},"example":{"success":false,"error":{"code":"NOT_FOUND","message":"Resource not found."},"meta":{"requestId":"019e8a3c-9f0b-7c12-88ab-1d2e3f4a5b6c"}}}}},"429":{"description":"Rate limit exceeded for this workspace and plan.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PublicErrorEnvelope"},"example":{"success":false,"error":{"code":"TOO_MANY_REQUESTS","message":"Rate limit exceeded for this workspace and plan."},"meta":{"requestId":"019e8a3c-9f0b-7c12-88ab-1d2e3f4a5b6c"}}}}}},"security":[{"apiKey":[]}],"summary":"Company timeline","tags":["companies"]},"post":{"description":"Resolve up to 25 companies and return each timeline. Costs one credit per record (company plus each included event) per resolved company. Companies are served in order until credits run out; the rest are marked skipped. Unresolved companies cost nothing.","operationId":"company_timeline_bulk","parameters":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CompanyTimelineBulkDto"}}}},"responses":{"200":{"description":"","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/CompanyTimelineBulkItemDto"}}}}},"400":{"description":"Invalid query parameter, body, or pagination cursor.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PublicErrorEnvelope"},"example":{"success":false,"error":{"code":"INVALID_INPUT","message":"limit must not be greater than 100"},"meta":{"requestId":"019e8a3c-9f0b-7c12-88ab-1d2e3f4a5b6c"}}}}},"401":{"description":"Missing, invalid, or disabled API key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PublicErrorEnvelope"},"example":{"success":false,"error":{"code":"UNAUTHORIZED","message":"Missing or invalid API key."},"meta":{"requestId":"019e8a3c-9f0b-7c12-88ab-1d2e3f4a5b6c"}}}}},"402":{"description":"Workspace has no credits available for the request.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PublicErrorEnvelope"},"example":{"success":false,"error":{"code":"PAYMENT_REQUIRED","message":"Workspace has no credits remaining. Top up to continue."},"meta":{"requestId":"019e8a3c-9f0b-7c12-88ab-1d2e3f4a5b6c"}}}}},"403":{"description":"Request blocked by abuse prevention policy.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PublicErrorEnvelope"},"example":{"success":false,"error":{"code":"FORBIDDEN","message":"Request blocked by abuse prevention policy."},"meta":{"requestId":"019e8a3c-9f0b-7c12-88ab-1d2e3f4a5b6c"}}}}},"429":{"description":"Rate limit exceeded for this workspace and plan.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PublicErrorEnvelope"},"example":{"success":false,"error":{"code":"TOO_MANY_REQUESTS","message":"Rate limit exceeded for this workspace and plan."},"meta":{"requestId":"019e8a3c-9f0b-7c12-88ab-1d2e3f4a5b6c"}}}}}},"security":[{"apiKey":[]}],"summary":"Company timelines (bulk)","tags":["companies"]}},"/v1/investors":{"get":{"description":"Search and filter investor records. Costs one credit per returned record.","operationId":"investors_list","parameters":[{"name":"cursor","required":false,"in":"query","description":"Opaque pagination cursor returned as pagination.nextCursor.","schema":{"type":"string"}},{"name":"since","required":false,"in":"query","description":"Return investors created or updated on or after this date (YYYY-MM-DD). ISO-8601 timestamps are also accepted.","schema":{"example":"2026-05-01","type":"string"}},{"name":"limit","required":false,"in":"query","description":"Maximum records to return.","schema":{"minimum":1,"maximum":100,"default":20,"type":"number"}},{"name":"search","required":false,"in":"query","description":"Keyword search over investor name and domain.","schema":{"example":"ventures","type":"string"}},{"name":"type","required":false,"in":"query","description":"Investor type filters. Accepts repeated query keys or comma-separated values.","schema":{"example":["vc","growth"],"type":"array","items":{"type":"string","enum":["vc","angel","cvc","pe","growth","accelerator","family_office","syndicate","unknown"]}}},{"name":"countries","required":false,"in":"query","description":"Headquarters country codes (OR). Repeat the query key for multiple values. Use `unknown` to match companies with no country on file.","schema":{"example":["US","GB"],"type":"array","items":{"type":"string","enum":["AD","AE","AF","AG","AI","AL","AM","AO","AR","AS","AT","AU","AW","AX","AZ","BA","BB","BD","BE","BF","BG","BH","BI","BJ","BL","BM","BN","BO","BQ","BR","BS","BT","BW","BY","BZ","CA","CD","CF","CG","CH","CI","CK","CL","CM","CN","CO","CR","CU","CV","CW","CY","CZ","DE","DJ","DK","DM","DO","DZ","EC","EE","EG","EH","ER","ES","ET","FI","FJ","FK","FM","FO","FR","GA","GB","GD","GE","GF","GG","GH","GI","GL","GM","GN","GP","GQ","GR","GT","GU","GW","GY","HK","HN","HR","HT","HU","ID","IE","IL","IM","IN","IQ","IR","IS","IT","JE","JM","JO","JP","KE","KG","KH","KI","KM","KN","KP","KR","KW","KY","KZ","LA","LB","LC","LI","LK","LR","LS","LT","LU","LV","LY","MA","MC","MD","ME","MF","MG","MH","MK","ML","MM","MN","MO","MP","MQ","MR","MS","MT","MU","MV","MW","MX","MY","MZ","NA","NC","NE","NG","NI","NL","NO","NP","NR","NU","NZ","OM","PA","PE","PF","PG","PH","PK","PL","PM","PR","PS","PT","PW","PY","QA","RE","RO","RS","RU","RW","SA","SB","SC","SD","SE","SG","SH","SI","SK","SL","SM","SN","SO","SR","SS","ST","SV","SX","SY","SZ","TC","TD","TG","TH","TJ","TK","TL","TM","TN","TO","TR","TT","TV","TW","TZ","UA","UG","US","UY","UZ","VA","VC","VE","VG","VI","VN","VU","WF","WS","YE","YT","ZA","ZM","ZW","unknown"]}}},{"name":"domain","required":false,"in":"query","description":"Exact investor domain.","schema":{"example":"example.vc","type":"string"}},{"name":"includeTotal","required":false,"in":"query","description":"Also return pagination.total, the number of records matching these filters across all pages. Costs no credits; adds a count query, so ask for it when you need the list size.","schema":{"example":true,"type":"boolean"}},{"name":"hasFirmographics","required":false,"in":"query","description":"Return only investors that have firmographics (a website domain and a known type). Individual angels and firms we could not identify are excluded.","schema":{"example":true,"type":"boolean"}},{"name":"minRoundUsd","required":false,"in":"query","description":"Return only investors that have participated in at least one round at or above this amount, in whole USD. Filters on what an investor has actually done rather than on how it is labelled.","schema":{"minimum":0,"example":20000000,"type":"number"}},{"name":"minRounds","required":false,"in":"query","description":"Return only investors that have participated in at least this many rounds.","schema":{"minimum":1,"example":3,"type":"number"}},{"name":"activeSince","required":false,"in":"query","description":"Return only investors whose most recent round was announced on or after this date (YYYY-MM-DD).","schema":{"example":"2025-08-01","type":"string"}},{"name":"investsIn","required":false,"in":"query","description":"Return only investors that have funded companies headquartered in these countries (OR). Filters on where an investor actually deploys rather than where it is registered, which is both a more useful question and far better covered: 40,692 investors have market data against 2,208 with an HQ country on file.","schema":{"example":["US"],"type":"array","items":{"type":"string","enum":["AD","AE","AF","AG","AI","AL","AM","AO","AR","AS","AT","AU","AW","AX","AZ","BA","BB","BD","BE","BF","BG","BH","BI","BJ","BL","BM","BN","BO","BQ","BR","BS","BT","BW","BY","BZ","CA","CD","CF","CG","CH","CI","CK","CL","CM","CN","CO","CR","CU","CV","CW","CY","CZ","DE","DJ","DK","DM","DO","DZ","EC","EE","EG","EH","ER","ES","ET","FI","FJ","FK","FM","FO","FR","GA","GB","GD","GE","GF","GG","GH","GI","GL","GM","GN","GP","GQ","GR","GT","GU","GW","GY","HK","HN","HR","HT","HU","ID","IE","IL","IM","IN","IQ","IR","IS","IT","JE","JM","JO","JP","KE","KG","KH","KI","KM","KN","KP","KR","KW","KY","KZ","LA","LB","LC","LI","LK","LR","LS","LT","LU","LV","LY","MA","MC","MD","ME","MF","MG","MH","MK","ML","MM","MN","MO","MP","MQ","MR","MS","MT","MU","MV","MW","MX","MY","MZ","NA","NC","NE","NG","NI","NL","NO","NP","NR","NU","NZ","OM","PA","PE","PF","PG","PH","PK","PL","PM","PR","PS","PT","PW","PY","QA","RE","RO","RS","RU","RW","SA","SB","SC","SD","SE","SG","SH","SI","SK","SL","SM","SN","SO","SR","SS","ST","SV","SX","SY","SZ","TC","TD","TG","TH","TJ","TK","TL","TM","TN","TO","TR","TT","TV","TW","TZ","UA","UG","US","UY","UZ","VA","VC","VE","VG","VI","VN","VU","WF","WS","YE","YT","ZA","ZM","ZW"]}}}],"responses":{"200":{"description":"Request accepted. The number of records returned may be lower than limit when credits or data run out.","content":{"application/json":{"schema":{"type":"object","required":["success","data","pagination","meta"],"properties":{"success":{"type":"boolean","enum":[true],"example":true},"data":{"type":"array","items":{"$ref":"#/components/schemas/PublicInvestorResponseItem"}},"pagination":{"$ref":"#/components/schemas/PublicPagination"},"meta":{"$ref":"#/components/schemas/PublicResponseMeta"}}}}}},"400":{"description":"Invalid query parameter, body, or pagination cursor.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PublicErrorEnvelope"},"example":{"success":false,"error":{"code":"INVALID_INPUT","message":"limit must not be greater than 100"},"meta":{"requestId":"019e8a3c-9f0b-7c12-88ab-1d2e3f4a5b6c"}}}}},"401":{"description":"Missing, invalid, or disabled API key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PublicErrorEnvelope"},"example":{"success":false,"error":{"code":"UNAUTHORIZED","message":"Missing or invalid API key."},"meta":{"requestId":"019e8a3c-9f0b-7c12-88ab-1d2e3f4a5b6c"}}}}},"402":{"description":"Workspace has no credits available for the request.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PublicErrorEnvelope"},"example":{"success":false,"error":{"code":"PAYMENT_REQUIRED","message":"Workspace has no credits remaining. Top up to continue."},"meta":{"requestId":"019e8a3c-9f0b-7c12-88ab-1d2e3f4a5b6c"}}}}},"403":{"description":"Request blocked by abuse prevention policy.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PublicErrorEnvelope"},"