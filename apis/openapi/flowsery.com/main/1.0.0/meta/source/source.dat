{"openapi":"3.0.3","info":{"title":"Flowsery Analytics Public API","version":"1.0.0","description":"REST API for reading Flowsery web analytics and writing conversion events. Read traffic, revenue and engagement for any date range, break it down by page, referrer, channel, campaign, country, device, browser or OS, pull a single visitor's full activity timeline, and record goals and payments from your own backend. Authenticate with `Authorization: Bearer <api-key>`. A website API key is scoped to one website; a workspace token spans every website in the account, in which case pass `websiteId` or `domain` to pick one. All monetary values are in the website currency, as major units. All timestamps are ISO 8601 UTC. Every response carries the RFC 9331 rate-limit fields so a client can pace itself instead of discovering the limit through a 429: `RateLimit-Policy`, `RateLimit-Limit`, `RateLimit-Remaining` and `RateLimit-Reset`, the seconds until the window rolls over. A 429 adds `Retry-After` with the same number of seconds. Limits are counted per API key."},"servers":[{"url":"https://analytics.flowsery.com/analytics/api/v1"}],"security":[{"bearerAuth":[]}],"tags":[{"name":"Reports","description":"Aggregated traffic and revenue metrics"},{"name":"Breakdowns","description":"Per-dimension visitor breakdowns"},{"name":"Issues","description":"Problems the AI found while analyzing session recordings"},{"name":"Visitors","description":"Individual visitor profiles and timelines"},{"name":"Events","description":"Server-side goal and payment tracking"},{"name":"Websites","description":"Websites reachable with this key"},{"name":"Workspaces","description":"Workspaces reachable with this key"}],"paths":{"/overview":{"get":{"operationId":"getOverview","summary":"Get headline metrics for a date range","description":"Visitors, sessions, bounce rate, average session duration, revenue and conversion rate for the window, as a single row.","tags":["Reports"],"parameters":[{"name":"websiteId","in":"query","required":false,"schema":{"type":"string"},"description":"Website to query. Optional when the API key is scoped to a single website; required for workspace tokens that span several."},{"name":"domain","in":"query","required":false,"schema":{"type":"string"},"description":"Alternative to `websiteId`: select the website by its domain."},{"name":"startAt","in":"query","required":false,"schema":{"type":"string","format":"date-time"},"description":"Start of the reporting window (ISO 8601). Defaults to 30 days ago."},{"name":"endAt","in":"query","required":false,"schema":{"type":"string","format":"date-time"},"description":"End of the reporting window (ISO 8601). Defaults to now."},{"name":"timezone","in":"query","required":false,"schema":{"type":"string"},"description":"IANA timezone used to bucket the results, e.g. `Europe/Berlin`. Defaults to the website timezone."},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","minimum":1,"maximum":1000,"default":100},"description":"Maximum rows to return. Defaults to 100."},{"name":"offset","in":"query","required":false,"schema":{"type":"integer","minimum":0,"default":0},"description":"Rows to skip before returning results."},{"name":"filter_country","in":"query","required":false,"schema":{"type":"string"},"description":"Keep only rows whose `country` matches this value."},{"name":"filter_region","in":"query","required":false,"schema":{"type":"string"},"description":"Keep only rows whose `region` matches this value."},{"name":"filter_city","in":"query","required":false,"schema":{"type":"string"},"description":"Keep only rows whose `city` matches this value."},{"name":"filter_device","in":"query","required":false,"schema":{"type":"string"},"description":"Keep only rows whose `device` matches this value."},{"name":"filter_browser","in":"query","required":false,"schema":{"type":"string"},"description":"Keep only rows whose `browser` matches this value."},{"name":"filter_os","in":"query","required":false,"schema":{"type":"string"},"description":"Keep only rows whose `os` matches this value."},{"name":"filter_referrer","in":"query","required":false,"schema":{"type":"string"},"description":"Keep only rows whose `referrer` matches this value."},{"name":"filter_ref","in":"query","required":false,"schema":{"type":"string"},"description":"Keep only rows whose `ref` matches this value."},{"name":"filter_source","in":"query","required":false,"schema":{"type":"string"},"description":"Keep only rows whose `source` matches this value."},{"name":"filter_via","in":"query","required":false,"schema":{"type":"string"},"description":"Keep only rows whose `via` matches this value."},{"name":"filter_utm_source","in":"query","required":false,"schema":{"type":"string"},"description":"Keep only rows whose `utm source` matches this value."},{"name":"filter_utm_medium","in":"query","required":false,"schema":{"type":"string"},"description":"Keep only rows whose `utm medium` matches this value."},{"name":"filter_utm_campaign","in":"query","required":false,"schema":{"type":"string"},"description":"Keep only rows whose `utm campaign` matches this value."},{"name":"filter_utm_term","in":"query","required":false,"schema":{"type":"string"},"description":"Keep only rows whose `utm term` matches this value."},{"name":"filter_utm_content","in":"query","required":false,"schema":{"type":"string"},"description":"Keep only rows whose `utm content` matches this value."},{"name":"filter_page","in":"query","required":false,"schema":{"type":"string"},"description":"Keep only rows whose `page` matches this value."},{"name":"filter_hostname","in":"query","required":false,"schema":{"type":"string"},"description":"Keep only rows whose `hostname` matches this value."},{"name":"filter_entry_page","in":"query","required":false,"schema":{"type":"string"},"description":"Keep only rows whose `entry page` matches this value."},{"name":"filter_channel","in":"query","required":false,"schema":{"type":"string"},"description":"Keep only rows whose `channel` matches this value."},{"name":"filter_goal","in":"query","required":false,"schema":{"type":"string"},"description":"Keep only rows whose `goal` matches this value."},{"name":"X-Workspace-Id","in":"header","required":false,"schema":{"type":"string"},"description":"The workspace to act in, for OAuth sign-ins that reach several workspaces. Take the id from `GET /workspaces`. Without it the call lands in the default workspace. A workspace the caller cannot reach answers 403 with `code: workspace_access_denied`. An API key belongs to one workspace: send its own id or leave the header out"}],"responses":{"200":{"description":"Headline metrics","content":{"application/json":{"schema":{"$ref":"#/components/schemas/OverviewResponse"}}}},"401":{"description":"Missing, invalid, expired or revoked API key or access token. `code: token_issuer_lost_access` means the member who created the API key was deactivated or lost access to the workspace: ask a workspace admin for a new key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"The credentials are valid but cannot be used here. `code: permission_denied`: the workspace role behind the API key or OAuth sign-in lacks `flowsery.write`; `role`, `keyRole` and `issuerRole` say which role fell short. `code: subscription_required`: the organization plan does not include API access. `code: workspace_access_denied`: `X-Workspace-Id` names a workspace the caller cannot reach, or an API key was sent to a workspace other than its own","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Website not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limit exceeded","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/timeseries":{"get":{"operationId":"getTimeseries","summary":"Get metrics bucketed over time","description":"The same metrics as /overview, bucketed by hour, day, week or month, plus totals across the whole window.","tags":["Reports"],"parameters":[{"name":"websiteId","in":"query","required":false,"schema":{"type":"string"},"description":"Website to query. Optional when the API key is scoped to a single website; required for workspace tokens that span several."},{"name":"domain","in":"query","required":false,"schema":{"type":"string"},"description":"Alternative to `websiteId`: select the website by its domain."},{"name":"startAt","in":"query","required":false,"schema":{"type":"string","format":"date-time"},"description":"Start of the reporting window (ISO 8601). Defaults to 30 days ago."},{"name":"endAt","in":"query","required":false,"schema":{"type":"string","format":"date-time"},"description":"End of the reporting window (ISO 8601). Defaults to now."},{"name":"timezone","in":"query","required":false,"schema":{"type":"string"},"description":"IANA timezone used to bucket the results, e.g. `Europe/Berlin`. Defaults to the website timezone."},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","minimum":1,"maximum":1000,"default":100},"description":"Maximum rows to return. Defaults to 100."},{"name":"offset","in":"query","required":false,"schema":{"type":"integer","minimum":0,"default":0},"description":"Rows to skip before returning results."},{"name":"filter_country","in":"query","required":false,"schema":{"type":"string"},"description":"Keep only rows whose `country` matches this value."},{"name":"filter_region","in":"query","required":false,"schema":{"type":"string"},"description":"Keep only rows whose `region` matches this value."},{"name":"filter_city","in":"query","required":false,"schema":{"type":"string"},"description":"Keep only rows whose `city` matches this value."},{"name":"filter_device","in":"query","required":false,"schema":{"type":"string"},"description":"Keep only rows whose `device` matches this value."},{"name":"filter_browser","in":"query","required":false,"schema":{"type":"string"},"description":"Keep only rows whose `browser` matches this value."},{"name":"filter_os","in":"query","required":false,"schema":{"type":"string"},"description":"Keep only rows whose `os` matches this value."},{"name":"filter_referrer","in":"query","required":false,"schema":{"type":"string"},"description":"Keep only rows whose `referrer` matches this value."},{"name":"filter_ref","in":"query","required":false,"schema":{"type":"string"},"description":"Keep only rows whose `ref` matches this value."},{"name":"filter_source","in":"query","required":false,"schema":{"type":"string"},"description":"Keep only rows whose `source` matches this value."},{"name":"filter_via","in":"query","required":false,"schema":{"type":"string"},"description":"Keep only rows whose `via` matches this value."},{"name":"filter_utm_source","in":"query","required":false,"schema":{"type":"string"},"description":"Keep only rows whose `utm source` matches this value."},{"name":"filter_utm_medium","in":"query","required":false,"schema":{"type":"string"},"description":"Keep only rows whose `utm medium` matches this value."},{"name":"filter_utm_campaign","in":"query","required":false,"schema":{"type":"string"},"description":"Keep only rows whose `utm campaign` matches this value."},{"name":"filter_utm_term","in":"query","required":false,"schema":{"type":"string"},"description":"Keep only rows whose `utm term` matches this value."},{"name":"filter_utm_content","in":"query","required":false,"schema":{"type":"string"},"description":"Keep only rows whose `utm content` matches this value."},{"name":"filter_page","in":"query","required":false,"schema":{"type":"string"},"description":"Keep only rows whose `page` matches this value."},{"name":"filter_hostname","in":"query","required":false,"schema":{"type":"string"},"description":"Keep only rows whose `hostname` matches this value."},{"name":"filter_entry_page","in":"query","required":false,"schema":{"type":"string"},"description":"Keep only rows whose `entry page` matches this value."},{"name":"filter_channel","in":"query","required":false,"schema":{"type":"string"},"description":"Keep only rows whose `channel` matches this value."},{"name":"filter_goal","in":"query","required":false,"schema":{"type":"string"},"description":"Keep only rows whose `goal` matches this value."},{"name":"interval","in":"query","required":false,"schema":{"type":"string","enum":["hour","day","week","month"],"default":"day"},"description":"Bucket size. Defaults to `day`."},{"name":"X-Workspace-Id","in":"header","required":false,"schema":{"type":"string"},"description":"The workspace to act in, for OAuth sign-ins that reach several workspaces. Take the id from `GET /workspaces`. Without it the call lands in the default workspace. A workspace the caller cannot reach answers 403 with `code: workspace_access_denied`. An API key belongs to one workspace: send its own id or leave the header out"}],"responses":{"200":{"description":"Time-bucketed metrics","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TimeseriesResponse"}}}},"401":{"description":"Missing, invalid, expired or revoked API key or access token. `code: token_issuer_lost_access` means the member who created the API key was deactivated or lost access to the workspace: ask a workspace admin for a new key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"The credentials are valid but cannot be used here. `code: permission_denied`: the workspace role behind the API key or OAuth sign-in lacks `flowsery.write`; `role`, `keyRole` and `issuerRole` say which role fell short. `code: subscription_required`: the organization plan does not include API access. `code: workspace_access_denied`: `X-Workspace-Id` names a workspace the caller cannot reach, or an API key was sent to a workspace other than its own","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Website not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limit exceeded","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/pages":{"get":{"operationId":"getPages","summary":"Break down visitors by page path","description":"Which pages visitors landed on, ordered by visitors.","tags":["Breakdowns"],"parameters":[{"name":"websiteId","in":"query","required":false,"schema":{"type":"string"},"description":"Website to query. Optional when the API key is scoped to a single website; required for workspace tokens that span several."},{"name":"domain","in":"query","required":false,"schema":{"type":"string"},"description":"Alternative to `websiteId`: select the website by its domain."},{"name":"startAt","in":"query","required":false,"schema":{"type":"string","format":"date-time"},"description":"Start of the reporting window (ISO 8601). Defaults to 30 days ago."},{"name":"endAt","in":"query","required":false,"schema":{"type":"string","format":"date-time"},"description":"End of the reporting window (ISO 8601). Defaults to now."},{"name":"timezone","in":"query","required":false,"schema":{"type":"string"},"description":"IANA timezone used to bucket the results, e.g. `Europe/Berlin`. Defaults to the website timezone."},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","minimum":1,"maximum":1000,"default":100},"description":"Maximum rows to return. Defaults to 100."},{"name":"offset","in":"query","required":false,"schema":{"type":"integer","minimum":0,"default":0},"description":"Rows to skip before returning results."},{"name":"filter_country","in":"query","required":false,"schema":{"type":"string"},"description":"Keep only rows whose `country` matches this value."},{"name":"filter_region","in":"query","required":false,"schema":{"type":"string"},"description":"Keep only rows whose `region` matches this v