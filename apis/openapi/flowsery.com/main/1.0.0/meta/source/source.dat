Id` names a workspace the caller cannot reach, or an API key was sent to a workspace other than its own","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Website not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limit exceeded","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/referrers":{"get":{"operationId":"getReferrers","summary":"Break down visitors by referrer","description":"Which sites sent the traffic, ordered by visitors.","tags":["Breakdowns"],"parameters":[{"name":"websiteId","in":"query","required":false,"schema":{"type":"string"},"description":"Website to query. Optional when the API key is scoped to a single website; required for workspace tokens that span several."},{"name":"domain","in":"query","required":false,"schema":{"type":"string"},"description":"Alternative to `websiteId`: select the website by its domain."},{"name":"startAt","in":"query","required":false,"schema":{"type":"string","format":"date-time"},"description":"Start of the reporting window (ISO 8601). Defaults to 30 days ago."},{"name":"endAt","in":"query","required":false,"schema":{"type":"string","format":"date-time"},"description":"End of the reporting window (ISO 8601). Defaults to now."},{"name":"timezone","in":"query","required":false,"schema":{"type":"string"},"description":"IANA timezone used to bucket the results, e.g. `Europe/Berlin`. Defaults to the website timezone."},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","minimum":1,"maximum":1000,"default":100},"description":"Maximum rows to return. Defaults to 100."},{"name":"offset","in":"query","required":false,"schema":{"type":"integer","minimum":0,"default":0},"description":"Rows to skip before returning results."},{"name":"filter_country","in":"query","required":false,"schema":{"type":"string"},"description":"Keep only rows whose `country` ma