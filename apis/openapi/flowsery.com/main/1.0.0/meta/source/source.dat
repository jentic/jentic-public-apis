acks it, on `permission_denied`"},"keyRole":{"type":"string","nullable":true,"description":"The role the API key carries, when an API key or OAuth sign-in was refused"},"issuerRole":{"type":"string","nullable":true,"description":"The current role of the member who created the API key"},"tokenType":{"type":"string","enum":["session","api_token","oauth"]}}},"Pagination":{"type":"object","properties":{"limit":{"type":"integer"},"offset":{"type":"integer"},"total":{"type":"integer","description":"Total rows matching the query, before paging."}},"required":["limit","offset","total"]},"BreakdownDimension":{"type":"string","enum":["device","page","entry_page","exit_link","hostname","referrer","channel","campaign","goal","country","region","city","browser","browser_version","os","os_version","utm_source","utm_medium","utm_campaign","utm_term","utm_content","ref","source","via","all_params"]},"Interval":{"type":"string","enum":["hour","day","week","month"]},"Overview":{"type":"object","properties":{"visitors":{"type":"integer"},"sessions":{"type":"integer"},"bounceRate":{"type":"number","description":"Percentage, 0-100."},"avgSessionDuration":{"type":"integer","description":"Seconds."},"avgEngagedTime":{"type":"integer","description":"Seconds of active engagement."},"revenue":{"type":"number"},"renewalRevenue":{"type":"number"},"refundedRevenue":{"type":"number"},"revenuePerVisitor":{"type":"number"},"conversionRate":{"type":"number","description":"Percentage, 0-100."},"kpiValue":{"type":"number","description":"The website’s chosen KPI for this window."},"kpiPerVisitor":{"type":"number"},"kpiConversionRate":{"type":"number"},"currency":{"type":"string","description":"ISO 4217 code."}}},"OverviewResponse":{"type":"object","properties":{"status":{"type":"string","enum":["success"]},"data":{"type":"array","items":{"$ref":"#/components/schemas/Overview"},"description":"Always exactly one row."}},"required":["status","data"]},"TimeseriesPoint":{"type":"object","properties":{"time