      "patch": {
        "operationId": "updateContactNote",
        "summary": "Update a contact note",
        "description": "Only the fields sent are changed. Sending `attachments` replaces the whole set — include the SparrowDesk urls of the attachments to keep.\n",
        "tags": [
          "Notes"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
