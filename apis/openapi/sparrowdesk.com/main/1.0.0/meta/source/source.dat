    "/conversations/{id}/replies": {
      "get": {
        "operationId": "listConversationReplies",
        "summary": "List all conversation replies",
        "tags": [
          "Conversations"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "description": "id of the conversation",
            "schema": {
              "type": "integer",
              "example": 123
            }
          },
          {
            "in": "query",
            "name": "starting_after",
            "required": false,
            "description": "Cursor for pagination",
            "schema": {
              "type": "string",
              "example": "eyJpZCI6Njc4OTIsImNyZWF0ZWRfYXQiOjE2NzI1MzEyMDB9"
            }
          },
          {
            "in": "query",
            "name": "per_page",
            "required": false,
            "description": "Number of replies per page (1–50, default 50)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "example": 50
            }
          },
          {
            "in": "query",
            "name": "type",
            "required": false,
            "description": "Filter by reply type (if not provided, returns all types)",
            "schema": {
              "type": "string",
              "enum": [
                "INTERNAL_NOTE",
                "REPLY"
              ],
              "example": "REPLY"
            }
          },
          {
            "in": "query",
            "name": "sort_order",
            "required": false,
            "description": "Sort order by sent_at (default desc)",
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ],
              "example": "desc"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Replies retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "example": "67890"
                          },
                          "type": {
                            "type": "string",
                            "enum": [
                              "REPLY",
                              "INTERNAL_NOTE"
                            ],
                            "example": "REPLY"
                          },
                          "body_html": {
                            "type": "string",
                            "example": "<p>Thank you for contacting us.</p>"
                          },
                          "body_text": {
                            "type": "string",
                            "example": "Thank you for contacting us."
                          },
                          "attachments": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "example": []
                          },
                          "author": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "integer",
                                "example": 123
                              },
                              "name": {
                                "type": "string",
                                "example": "Sarah Johnson"
                              },
                              "email": {
                                "type": "string",
                                "example": "sarah.johnson@company.com"
                              },
                              "phone": {
                                "type": "string",
                                "nullable": true,
                                "example": null
                              },
                              "type": {
                                "type": "string",
                                "enum": [
                                  "agent",
                                  "requestor"
                                ],
                                "example": "agent"
                              }
                            }
                          },
                          "sent_at": {
                            "type": "integer",
                            "example": 1672534800
                          },
                          "conversation_id": {
                            "type": "integer",
                            "example": 789
                          },
                          "brand_id": {
                            "type": "integer",
                            "example": 123
                          },
                          "account_id": {
                            "type": "integer",
                            "example": 456
                          }
                        }
                      }
                    },
                    "pages": {
                      "type": "object",
                      "properties": {
                        "per_page": {
                          "type": "integer",
                          "example": 50
                        },
                        "next_cursor": {
                          "type": "string",
                          "nullable": true,
                          "example": "eyJpZCI6Njc4OTIsImNyZWF0ZWRfYXQiOjE2NzI1MzEyMDB9"
                        },
                        "next_url": {
                          "type": "string",
                          "nullable": true,
                          "example": "https://api.sparrowdesk.com/conversations/123/replies?per_page=50&starting_after=eyJpZCI6Njc4OTIsImNyZWF0ZWRfYXQiOjE2NzI1MzEyMDB9"
                        }
                      }
                    },
                    "total_count": {
                      "type": "integer",
                      "example": 156
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Invalid query parameters"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Conversation not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Conversation not found"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Error retrieving conversation replies"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/imports/conversations/{id}/replies": {
      "post": {
        "operationId": "importConversationReply",
        "summary": "Import a conversation reply",
        "description": "Backdated, no notifications/workflows/SLA. [requires \"edit all tickets\" scope]",
        "tags": [
          "Conversation Reply Imports"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The SparrowDesk conversation id"
          },
          {
            "in": "header",
            "name": "x-import-source",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Optional label identifying the system the reply was imported from"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
