        "operationId": "retrieveContactField"
      },
      "patch": {
        "summary": "Update a contact field",
        "description": "Updates an existing contact field. Default fields cannot have their name changed or be deactivated.\n`field_options` is append-only — existing options cannot be removed or renamed, only new ones added (dropdown fields only).\nRequires \"manage contacts\" scope.\n",
        "tags": [
          "Contact Fields"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Contact field ID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Priority Tier"
                  },
                  "description": {
                    "type": "string",
                    "example": "Updated description"
                  },
                  "is_active": {
                    "type": "boolean",
                    "example": true
                  },
                  "field_options": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Appends new options to dropdown fields only",
                    "example": [
                      "Urgent"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Contact field updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer",
                          "example": 100000144
                        },
                        "name": {
                          "type": "string",
                          "example": "Priority Tier"
                        },
                        "type": {
                          "type": "string",
                          "example": "dropdown"
                        },
                        "internal_name": {
                          "type": "string",
                          "example": "priority_level"
                        },
                        "description": {
                          "type": "string",
                          "nullable": true,
                          "example": "Updated description"
                        },
                        "is_active": {
                          "type": "boolean",
                          "example": true
                        },
                        "is_default": {
                          "type": "boolean",
                          "example": false
                        },
                        "field_options": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "integer",
                                "example": 28
                              },
                              "name": {
                                "type": "string",
                                "example": "Urgent"
                              },
                              "position": {
                                "type": "integer",
                                "example": 5
                              },
                              "boolean_value": {
                                "type": "boolean",
                                "description": "Boolean fields only — the value this label stands for",
                                "example": true
                              }
                            }
                          }
                        },
                        "created_at": {
                          "type": "integer",
                          "description": "Unix timestamp",
                          "example": 1781455256
                        },
                        "updated_at": {
                          "type": "integer",
                          "description": "Unix timestamp",
                          "example": 1781455263
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request (e.g. updating name of default field, field_options on non-dropdown)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Cannot update name of a default contact field"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Contact field not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Contact field with id 999 not found"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Conflict - name already exists, or duplicate option name",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Field with name 'Priority Level' already exists"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Error while updating contact field"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "operationId": "updateContactField"
      }
    },
    "/bulk/contacts": {
      "post": {
        "operationId": "bulkCreateContacts",
        "summary": "Bulk create contacts",
        "description": "Create multiple contacts in a single request",
        "tags": [
          "Contacts"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "first_name": {
                      "type": "string",
                      "example": "John"
                    },
                    "last_name": {
                      "type": "string",
                      "example": "Doe"
                    },
                    "email": {
                      "type": "string",
                      "example": "john.doe@example.com"
                    },
                    "phone": {
                      "type": "string",
                      "example": "+1234567890"
                    },
                    "company_ids": {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      },
                      "example": [
                        123
                      ]
                    },
                    "custom_fields": {
                      "type": "object",
                      "example": {
                        "company_size": "51-200",
                        "job_title": "Software Engineer",
                        "lead_source": "website"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Contacts created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "job_id": {
                          "type": "string",
                          "example": "bulk-123456789"
                        },
                        "status": {
                          "type": "string",
                          "example": "processing"
                        },
                        "message": {
                          "type": "string",
                          "example": "Bulk contact creation job initiated"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Company not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Company not found"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "One or more contacts already exist",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "One or more contacts already exist"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Error creating contacts"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/bulk/status/{jobId}": {
      "get": {
        "operationId": "getBulkJobStatus",
        "summary": "Retrieve a bulk job",
        "description": "Retrieve the processing status of a bulk contact creation job",
        "tags": [
          "Contacts"
        ],
