    "/contacts": {
      "get": {
        "operationId": "listContacts",
        "summary": "List all contacts",
        "description": "Returns contacts for the authenticated account. Optional filters apply in addition to first-name search. Requires the \"view contacts\" scope.",
        "tags": [
          "Contacts"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "search",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Case-sensitive partial match on first name"
          },
          {
            "in": "query",
            "name": "requested_by_email",
            "required": false,
            "schema": {
              "type": "string",
              "format": "email"
            },
            "description": "Exact match on contact email"
          },
          {
            "in": "query",
            "name": "requested_by_phone",
            "required": false,
            "schema": {
              "type": "string",
              "example": "+14155552671"
            },
            "description": "Exact match on contact phone (E.164)"
          },
          {
            "in": "query",
            "name": "starting_after",
            "required": false,
            "description": "Cursor for pagination (only needed for subsequent pages)",
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "in": "query",
            "name": "per_page",
            "required": false,
            "description": "Number of items per page (1-100, default 25)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Contacts retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer"
                          },
                          "first_name": {
                            "type": "string"
                          },
                          "last_name": {
                            "type": "string",
                            "nullable": true
                          },
                          "full_name": {
                            "type": "string"
                          },
                          "email": {
                            "type": "string",
                            "format": "email",
                            "nullable": true
                          },
                          "phone": {
                            "type": "string",
                            "nullable": true
                          },
                          "language": {
                            "type": "string",
                            "nullable": true
                          },
                          "time_zone": {
                            "type": "string",
                            "nullable": true
                          },
                          "country": {
                            "type": "string",
                            "nullable": true
                          },
                          "region": {
                            "type": "string",
                            "nullable": true
                          },
                          "city": {
                            "type": "string",
                            "nullable": true
                          },
                          "active": {
                            "type": "boolean"
                          },
                          "unsubscribed": {
                            "type": "boolean"
                          },
                          "blocked": {
                            "type": "boolean"
                          },
                          "avatar": {
                            "type": "string",
                            "nullable": true
                          },
                          "companies": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "id": {
                                  "type": "integer"
                                },
                                "name": {
                                  "type": "string"
                                },
                                "domain": {
                                  "type": "string",
                                  "nullable": true
                                },
                                "logo": {
                                  "type": "string",
                                  "nullable": true
                                },
                                "phone": {
                                  "type": "string",
                                  "nullable": true
                                },
                                "address": {
                                  "type": "string",
                                  "nullable": true
                                },
                                "notes": {
                                  "type": "string",
                                  "nullable": true
                                }
                              }
                            }
                          },
                          "custom_fields": {
                            "type": "object"
                          },
                          "properties": {
                            "type": "object"
                          },
                          "created_at": {
                            "type": "integer",
                            "description": "Unix timestamp (seconds)"
                          },
                          "updated_at": {
                            "type": "integer",
                            "description": "Unix timestamp (seconds)"
                          },
                          "contact_note": {
                            "$ref": "#/components/schemas/EmbeddedNotes"
                          }
                        }
                      }
                    },
                    "pages": {
                      "type": "object",
                      "properties": {
                        "per_page": {
                          "type": "integer"
                        },
                        "next_cursor": {
                          "type": "string",
                          "nullable": true
                        },
                        "next_url": {
                          "type": "string",
                          "nullable": true
                        }
                      }
                    },
                    "total_count": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createContact",
        "summary": "Create a contact",
        "tags": [
          "Contacts"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "first_name"
                ],
                "properties": {
                  "first_name": {
                    "type": "string",
                    "example": "John"
                  },
                  "last_name": {
                    "type": "string",
                    "example": "Doe"
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "description": "Required if phone not provided",
                    "example": "john.doe@example.com"
                  },
                  "phone": {
                    "type": "string",
                    "description": "Required if email not provided",
                    "example": "+1234567890"
                  },
                  "company_ids": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    },
                    "example": [
                      123
                    ]
                  },
                  "custom_fields": {
                    "type": "object",
                    "example": {
                      "company_size": "51-200",
                      "job_title": "Software Engineer",
                      "lead_source": "website"
                    }
                  },
                  "contact_note": {
                    "type": "array",
                    "description": "Optional notes created under the new contact. Requires an API key bound to a member. A note that fails to create is skipped; the contact is still created and only the notes that succeeded are returned.",
                    "items": {
                      "type": "object",
                      "required": [
                        "description"
                      ],
                      "properties": {
                        "title": {
                          "type": "string",
                          "example": "Renewal call"
                        },
                        "description": {
                          "type": "string",
                          "example": "Discussed the annual renewal."
                        },
                        "attachments": {
                          "type": "array",
                          "maxItems": 20,
                          "items": {
                            "type": "object",
                            "required": [
                              "url"
                            ],
                            "properties": {
                              "url": {
                                "type": "string",
                                "format": "uri"
                              },
                              "file_name": {
                                "type": "string"
                              },
                              "content_type": {
                                "type": "string"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Contact created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer",
                          "example": 12345
                        },
                        "first_name": {
                          "type": "string",
                          "example": "John"
                        },
                        "last_name": {
                          "type": "string",
                          "nullable": true,
                          "example": "Doe"
                        },
                        "full_name": {
                          "type": "string",
                          "example": "John Doe"
                        },
                        "email": {
                          "type": "string",
                          "format": "email",
                          "nullable": true,
                          "example": "john.doe@example.com"
                        },
                        "phone": {
                          "type": "string",
                          "nullable": true,
                          "example": "+1234567890"
                        },
                        "language": {
                          "type": "string",
                          "nullable": true,
                          "example": null
                        },
                        "time_zone": {
                          "type": "string",
                          "nullable": true,
                          "example": null
                        },
                        "country": {
                          "type": "string",
                          "nullable": true,
                          "example": null
                        },
                        "region": {
                          "type": "string",
                          "nullable": true,
                          "example": null
                        },
                        "city": {
                          "type": "string",
                          "nullable": true,
                          "example": null
                        },
                        "active": {
                          "type": "boolean",
                          "example": true
                        },
                        "unsubscribed": {
                          "type": "boolean",
                          "example": false
                        },
                        "blocked": {
                          "type": "boolean",
                          "example": false
                        },
                        "avatar": {
                          "type": "string",
                          "nullable": true,
                          "example": null
                        },
                        "companies": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "integer"
                              },
                              "name": {
                                "type": "string"
                              },
                              "domain": {
                                "type": "string",
                                "nullable": true
                              },
                              "logo": {
                                "type": "string",
                                "nullable": true
                              },
                              "phone": {
                                "type": "string",
                                "nullable": true
                              },
                              "address": {
                                "type": "string",
                                "nullable": true
                              },
                              "notes": {
                                "type": "string",
                                "nullable": true
                              }
                            }
                          }
                        },
                        "custom_fields": {
                          "type": "object",
                          "example": {
                            "company_size": "51-200",
                            "job_title": "Software Engineer",
                            "lead_source": "website"
                          }
                        },
                        "properties": {
                          "type": "object",
                          "example": {
                            "initial_avatar_color": {
                              "backgroundColor": "linear-gradient(...)",
