    "/companies": {
      "get": {
        "operationId": "listCompanies",
        "summary": "List all companies",
        "tags": [
          "Companies"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "starting_after",
            "required": false,
            "description": "Cursor for pagination (only needed for subsequent pages)",
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "in": "query",
            "name": "per_page",
            "required": false,
            "description": "Number of items per page (1-100, default 25)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25,
              "nullable": true
            }
          },
          {
            "in": "query",
            "name": "domain",
            "required": false,
            "description": "Filter companies by exact domain, matched against any of the company's domains",
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "in": "query",
            "name": "name",
            "required": false,
            "description": "Filter companies by exact name",
            "schema": {
              "type": "string",
              "nullable": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Companies retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer"
                          },
                          "name": {
                            "type": "string"
                          },
                          "domains": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "domain": {
                            "type": "string",
                            "nullable": true,
                            "description": "First entry of domains."
                          },
                          "logo": {
                            "type": "string",
                            "nullable": true
                          },
                          "industry": {
                            "type": "string",
                            "nullable": true
                          },
                          "phone": {
                            "type": "string",
                            "nullable": true
                          },
                          "address": {
                            "type": "string",
                            "nullable": true
                          },
                          "notes": {
                            "type": "string",
                            "nullable": true
                          },
                          "other_details": {
                            "type": "object",
                            "additionalProperties": true,
                            "nullable": true
                          },
                          "total_contacts_linked": {
                            "type": "integer",
                            "description": "Number of active contacts linked to the company"
                          },
                          "created_at": {
                            "type": "integer",
                            "description": "Unix timestamp (seconds)"
                          },
                          "updated_at": {
                            "type": "integer",
                            "description": "Unix timestamp (seconds)"
                          },
                          "company_note": {
                            "$ref": "#/components/schemas/EmbeddedNotes"
                          }
                        }
                      }
                    },
                    "pages": {
                      "type": "object",
                      "properties": {
                        "per_page": {
                          "type": "integer"
                        },
                        "next_cursor": {
                          "type": "string",
                          "nullable": true
                        },
                        "next_url": {
                          "type": "string",
                          "nullable": true
                        }
                      }
                    },
                    "total_count": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Invalid query parameters"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Error while retrieving companies"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createCompany",
        "summary": "Create a company",
        "tags": [
          "Companies"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "domains": {
                    "type": "array",
                    "description": "Domains owned by the company. The first entry is the primary and is what the favicon and the domain field resolve to. A domain may belong to only one company per account.",
                    "items": {
                      "type": "string"
                    },
                    "example": [
                      "example.com",
                      "example.io"
                    ]
                  },
                  "domain": {
                    "type": "string",
                    "description": "Single-domain shorthand, equivalent to sending a one-item domains array. Ignored when domains is supplied."
                  },
                  "address": {
                    "type": "string"
                  },
                  "notes": {
                    "type": "string"
                  },
                  "company_note": {
                    "type": "array",
                    "description": "Optional notes created under the new company. Requires an API key bound to a member. A note that fails to create is skipped; the company is still created and only the notes that succeeded are returned.",
                    "items": {
                      "type": "object",
                      "required": [
                        "description"
                      ],
                      "properties": {
                        "title": {
                          "type": "string"
                        },
                        "description": {
                          "type": "string"
                        },
                        "attachments": {
                          "type": "array",
                          "maxItems": 20,
                          "items": {
                            "type": "object",
                            "required": [
                              "url"
                            ],
                            "properties": {
                              "url": {
                                "type": "string",
                                "format": "uri"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Company created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer"
                        },
                        "name": {
                          "type": "string"
                        },
                        "domains": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "domain": {
                          "type": "string",
                          "nullable": true,
                          "description": "First entry of domains."
                        },
                        "logo": {
                          "type": "string",
                          "nullable": true
                        },
                        "industry": {
                          "type": "string",
                          "nullable": true
                        },
                        "phone": {
                          "type": "string",
                          "nullable": true
                        },
                        "address": {
                          "type": "string",
                          "nullable": true
                        },
                        "notes": {
                          "type": "string",
                          "nullable": true
                        },
                        "other_details": {
                          "type": "object",
                          "additionalProperties": true,
                          "nullable": true
                        },
                        "total_contacts_linked": {
                          "type": "integer",
                          "description": "Number of active contacts linked to the company"
                        },
                        "created_at": {
                          "type": "integer",
                          "description": "Unix timestamp (seconds)"
                        },
                        "updated_at": {
                          "type": "integer",
                          "description": "Unix timestamp (seconds)"
                        },
                        "company_note": {
                          "$ref": "#/components/schemas/EmbeddedNotes"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Invalid request data"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "A company with the same name or domain already exists",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "enum": [
                            "Company with this name already exists",
                            "Company with this domain already exists"
                          ],
                          "example": "Company with this name already exists"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Error while creating company"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
