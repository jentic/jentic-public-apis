    "/members": {
      "get": {
        "operationId": "listMembers",
        "summary": "List all members",
        "tags": [
          "Members"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "starting_after",
            "required": false,
            "description": "Cursor for pagination (only needed for subsequent pages)",
            "schema": {
              "type": "string",
              "nullable": true
            },
            "examples": {
              "withCursor": {
                "value": "eyJjcmVhdGVkX2F0IjoiMjAyNS0wMS0xNVQwNjowMzowOS4zMThaIiwiaWQiOjEwMDAwMDA5Nn0=",
                "summary": "With pagination cursor"
              },
              "withoutCursor": {
                "summary": "First page (no cursor)"
              }
            }
          },
          {
            "in": "query",
            "name": "per_page",
            "required": false,
            "description": "Number of items per page (1-100, default 25)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25,
              "nullable": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved members list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer",
                            "example": 100000096
                          },
                          "email": {
                            "type": "string",
                            "example": "john.doe@example.com"
                          },
                          "first_name": {
                            "type": "string",
                            "example": "John"
                          },
                          "last_name": {
                            "type": "string",
                            "example": "Doe"
                          },
                          "phone": {
                            "type": "string",
                            "nullable": true,
                            "example": "+1234567890"
                          },
                          "profile_pic": {
                            "type": "string",
                            "nullable": true,
                            "example": "https://public.cdn.sparrowdesk.com/example.jpeg"
                          },
                          "is_copilot_seat_alloted": {
                            "type": "boolean",
                            "example": true
                          },
                          "verified": {
                            "type": "boolean",
                            "example": true
                          },
                          "role": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "integer",
                                "example": 100000153
                              },
                              "label": {
                                "type": "string",
                                "example": "Account Owner"
                              }
                            }
                          },
                          "teams": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "id": {
                                  "type": "integer",
                                  "example": 100000006
                                },
                                "label": {
                                  "type": "string",
                                  "example": "dev"
                                }
                              }
                            }
                          },
                          "created_at": {
                            "type": "integer",
                            "description": "Unix timestamp",
                            "example": 1672531200
                          }
                        }
                      }
                    },
                    "pages": {
                      "type": "object",
                      "properties": {
                        "per_page": {
                          "type": "integer",
                          "example": 25
                        },
                        "next_cursor": {
                          "type": "string",
                          "nullable": true,
                          "example": "eyJjcmVhdGVkX2F0IjoiMjAyNS0wMS0xNVQwNjowMzowOS4zMThaIiwiaWQiOjEwMDAwMDA5Nn0="
                        },
                        "next_url": {
                          "type": "string",
                          "nullable": true,
                          "example": "https://api.sparrowdesk.com/members?per_page=25&starting_after=eyJjcmVhdGVkX2F0IjoiMjAyNS0wMS0xNVQwNjowMzowOS4zMThaIiwiaWQiOjEwMDAwMDA5Nn0="
                        }
                      }
                    },
                    "total_count": {
                      "type": "integer",
                      "example": 156
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Invalid query parameters"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Resource not found"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "An error occurred while retrieving members"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/helpcenters": {
      "get": {
        "operationId": "listHelpCenters",
        "summary": "List all help centers",
        "tags": [
          "Help Centers"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "starting_after",
            "required": false,
            "description": "Cursor for pagination (only needed for subsequent pages)",
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "in": "query",
            "name": "per_page",
            "required": false,
            "description": "Number of items per page (1-100, default 30)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 30,
              "nullable": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated help centers for the authenticated account",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer",
                            "example": 994
                          },
                          "name": {
                            "type": "string",
                            "nullable": true,
                            "example": "Product help"
                          },
                          "status": {
                            "type": "string",
                            "nullable": true,
                            "example": "ACTIVE"
                          },
                          "access_type": {
                            "type": "string",
                            "nullable": true,
                            "example": "PUBLIC"
                          },
                          "favicon": {
                            "type": "string",
                            "nullable": true
                          },
                          "seo_title": {
                            "type": "string",
                            "nullable": true
                          },
                          "seo_description": {
                            "type": "string",
                            "nullable": true
                          },
                          "seo_image": {
                            "type": "string",
                            "nullable": true
                          },
                          "brand": {
                            "type": "object",
                            "nullable": true,
                            "properties": {
                              "id": {
                                "type": "integer",
                                "example": 1
                              },
                              "name": {
                                "type": "string",
                                "nullable": true,
                                "example": "Acme"
                              }
                            }
                          },
                          "domain": {
                            "type": "object",
                            "nullable": true,
                            "properties": {
                              "url": {
                                "type": "string",
                                "nullable": true,
                                "example": "support.acme.com"
                              },
                              "https": {
                                "type": "boolean",
                                "nullable": true,
                                "example": true
                              },
                              "active": {
                                "type": "boolean",
                                "nullable": true,
                                "example": true
                              },
                              "verified": {
                                "type": "boolean",
                                "nullable": true,
                                "example": true
                              }
                            }
                          },
                          "created_at": {
                            "type": "integer",
                            "nullable": true,
                            "description": "Unix timestamp (seconds)"
                          },
                          "updated_at": {
                            "type": "integer",
                            "nullable": true,
                            "description": "Unix timestamp (seconds)"
                          }
                        }
                      }
                    },
                    "pages": {
                      "type": "object",
                      "properties": {
                        "per_page": {
                          "type": "integer",
                          "example": 30
                        },
                        "next_cursor": {
                          "type": "string",
                          "nullable": true
                        },
                        "next_url": {
                          "type": "string",
                          "nullable": true
                        }
                      }
                    },
                    "total_count": {
                      "type": "integer",
                      "example": 2
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request (e.g. malformed starting_after cursor)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Invalid cursor"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden – missing scope or feature",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Missing required scope or product feature is not enabled for this account."
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "An unexpected error occurred while loading help centers."
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/conversations": {
      "get": {
        "operationId": "listConversations",
        "summary": "List all conversations",
        "tags": [
          "Conversations"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "starting_after",
            "required": false,
            "description": "Cursor for pagination (only needed for subsequent pages)",
            "schema": {
              "type": "string",
              "nullable": true
            },
            "examples": {
              "withCursor": {
                "value": "eyJpZCI6MTIzNDUsImNyZWF0ZWRfYXQiOjE2NzI1MzEyMDB9",
                "summary": "With pagination cursor"
              },
              "withoutCursor": {
                "summary": "First page (no cursor)"
              }
            }
          },
          {
            "in": "query",
            "name": "per_page",
            "required": false,
            "description": "Number of items per page (1-100, default 25)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "nullable": true
            }
          },
          {
            "in": "query",
            "name": "status",
            "required": false,
            "description": "Filter by conversation status",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "Open",
                  "Pending",
                  "Resolved",
                  "Closed"
                ]
              },
              "nullable": true
            }
          },
          {
            "in": "query",
            "name": "priority",
            "required": false,
            "description": "Filter by priority level",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "Low",
                  "Medium",
                  "High",
                  "Urgent"
                ]
              },
              "nullable": true
            }
          },
          {
            "in": "query",
            "name": "assigned_to_member_id",
            "required": false,
            "description": "Filter by assigned agent IDs",
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "nullable": true
            }
          },
          {
            "in": "query",
            "name": "assigned_to_team_id",
            "required": false,
            "description": "Filter by assigned team IDs",
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "nullable": true
            }
          },
          {
            "in": "query",
            "name": "brand_id",
            "required": false,
            "description": "Filter by brand IDs",
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "nullable": true
            }
          },
          {
            "in": "query",
            "name": "requested_by_id",
            "required": false,
            "description": "Filter by requester contact id(s). Omit (with no requested_by_company) to list all conversations. With requested_by_company, only requesters in both filters are returned (intersection).",
            "schema": {
              "type": "integer",
              "nullable": true
            }
          },
          {
            "in": "query",
            "name": "requested_by_company",
            "required": false,
            "description": "Filter by requester contact company id. Omit (with no requested_by_id) to list all conversations. With requested_by_id, only requesters matching both filters are returned (intersection).",
            "schema": {
              "type": "integer",
              "nullable": true
            }
          },
          {
            "in": "query",
            "name": "handled_by_ai_agent",
            "required": false,
            "description": "When omitted, no filter by AI handling. `true` — only conversations assigned to an AI agent. `false` — conversations handed off for human help,\nor where the assignee is not an AI agent.\n",
            "schema": {
              "type": "string",
              "enum": [
                true,
                false
              ],
              "nullable": true
            }
          },
          {
            "in": "query",
            "name": "search",
            "required": false,
            "description": "Search by subject, description, replies, or conversation ID. Use quotes for exact phrases.\n",
            "schema": {
              "type": "string",
              "maxLength": 250,
              "nullable": true
            }
          },
          {
            "in": "query",
            "name": "sort_by",
            "required": false,
            "description": "Field to sort by (default created_at)",
            "schema": {
              "type": "string",
              "enum": [
                "created_at",
                "updated_at"
              ],
              "nullable": true
            }
          },
          {
            "in": "query",
            "name": "sort_order",
            "required": false,
            "description": "Sort order (default desc)",
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ],
              "nullable": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Conversations retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer",
                            "example": 12345
                          },
                          "brand": {
                            "type": "string",
                            "example": "Support Brand"
                          },
                          "brand_id": {
                            "type": "integer",
                            "example": 12345
                          },
                          "source": {
                            "type": "string",
                            "example": "Mail"
                          },
                          "status": {
                            "type": "string",
                            "example": "Open"
                          },
                          "priority": {
                            "type": "string",
                            "example": "High"
                          },
                          "created_at": {
                            "type": "integer",
                            "example": 1672531200
                          },
                          "first_response_time": {
                            "type": "integer",
                            "nullable": true,
                            "example": 1672534800
                          },
                          "resolution_time": {
                            "type": "integer",
                            "nullable": true,
                            "example": null
                          },
                          "due": {
                            "type": "integer",
                            "nullable": true,
                            "example": 1672617600
                          },
                          "first_response_due": {
                            "type": "integer",
                            "nullable": true,
                            "example": 1672538400
                          },
                          "requested_by_email": {
                            "type": "string",
                            "format": "email",
                            "example": "customer@example.com"
                          },
                          "requested_by_phone": {
                            "type": "string",
                            "example": "+1415555267"
                          },
                          "requested_by_id": {
                            "type": "integer",
                            "example": 67890
                          },
                          "assigned_to_member_id": {
                            "type": "integer",
                            "nullable": true,
                            "example": 123
                          },
                          "assigned_to_team_id": {
                            "type": "integer",
                            "nullable": true,
                            "example": 456
                          },
                          "last_updated_at": {
                            "type": "integer",
                            "example": 1672535400
                          },
                          "subject": {
                            "type": "string",
                            "example": "Payment issue with order #12345"
                          },
                          "description_html": {
                            "type": "string",
                            "example": "<p>I'm having trouble with my payment...</p>"
                          },
                          "description_text": {
                            "type": "string",
                            "example": "I'm having trouble with my payment..."
                          },
                          "attachments": {
                            "type": "array",
                            "description": "URLs of attachments sent on the opening message",
                            "items": {
                              "type": "string"
                            },
                            "example": [
                              "https://cdn.example.com/receipt.pdf"
                            ]
                          },
                          "tags": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "id": {
                                  "type": "integer",
                                  "example": 1
                                },
                                "label": {
                                  "type": "string",
                                  "example": "billing"
                                }
                              }
                            }
                          },
                          "custom_fields": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "id": {
                                  "type": "integer",
                                  "example": 9250
                                },
                                "value": {
                                  "description": "Field value. A multi_select field reads back as its selected option names joined with \", \" in option order; its ordered option ids are in option_ids. A boolean field reads back as true or false.",
                                  "oneOf": [
                                    {
                                      "type": "string"
                                    },
                                    {
                                      "type": "number"
                                    },
                                    {
                                      "type": "boolean"
                                    },
                                    {
                                      "type": "array",
                                      "items": {
                                        "oneOf": [
                                          {
                                            "type": "string"
                                          },
                                          {
                                            "type": "number"
                                          }
                                        ]
                                      }
                                    }
                                  ],
                                  "example": "ORD-12345"
                                },
                                "option_ids": {
                                  "type": "array",
                                  "nullable": true,
                                  "description": "Ordered option ids of a multi_select selection; null for every other field type",
                                  "items": {
                                    "type": "integer"
                                  },
                                  "example": [
                                    7790,
                                    7791
                                  ]
                                }
                              }
                            }
                          },
                          "csat": {
                            "type": "object",
                            "properties": {
                              "score": {
                                "type": "integer",
                                "nullable": true,
                                "example": 4,
                                "description": "Numeric CSAT score submitted by the customer"
                              },
                              "sentiment": {
                                "type": "string",
                                "nullable": true,
                                "example": "positive",
                                "description": "Sentiment derived from the score: positive, neutral, or negative"
                              },
                              "feedback": {
                                "type": "string",
                                "nullable": true,
                                "example": "Great support experience!",
                                "description": "Free-text feedback submitted by the customer"
                              },
                              "scale": {
                                "type": "integer",
                                "nullable": true,
                                "example": 5,
                                "description": "The scale used for the CSAT survey (e.g. 5 or 10)"
                              }
                            }
                          },
                          "properties": {
                            "type": "object",
                            "properties": {
                              "request_language": {
                                "type": "string",
                                "example": "English"
                              },
                              "browser_timezone": {
                                "type": "string",
                                "example": "Asia/Calcutta"
                              },
                              "browser": {
                                "type": "string",
                                "example": "Chrome"
                              },
                              "device": {
                                "type": "string",
                                "example": "mac OS 10.15.7"
                              },
                              "ip_address": {
                                "type": "string",
                                "example": "192.168.1.1"
                              },
                              "country": {
                                "type": "string",
                                "example": "India"
                              },
                              "region": {
                                "type": "string",
                                "example": "Tamil Nadu > Chennai"
                              }
                            }
                          }
                        }
                      }
                    },
                    "pages": {
                      "type": "object",
                      "properties": {
                        "per_page": {
                          "type": "integer",
                          "example": 20
                        },
                        "next_cursor": {
                          "type": "string",
                          "nullable": true,
                          "example": "eyJpZCI6MTIzNDUsImNyZWF0ZWRfYXQiOjE2NzI1MzEyMDB9"
                        },
                        "next_url": {
                          "type": "string",
                          "nullable": true,
                          "example": "https://app.sparrowdesk.com/conversations?per_page=20&starting_after=eyJpZCI6MTIzNDUsImNyZWF0ZWRfYXQiOjE2NzI1MzEyMDB9"
                        }
                      }
                    },
                    "total_count": {
                      "type": "integer",
                      "example": 100
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Invalid query parameters"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Error retrieving conversations"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createConversation",
        "summary": "Create a conversation",
        "tags": [
          "Conversations"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "description",
                  "subject",
                  "requested_by"
                ],
                "properties": {
                  "description": {
                    "type": "string",
                    "description": "Opening message body (HTML). Inline images hosted on supported source platforms are fetched and re-hosted automatically, with their links rewritten."
                  },
                  "subject": {
                    "type": "string"
                  },
                  "priority": {
                    "type": "string",
                    "enum": [
                      "Low",
                      "Medium",
                      "High",
                      "Urgent"
                    ],
                    "description": "Priority level (defaults to Medium if not provided)"
                  },
                  "source": {
                    "type": "string",
                    "enum": [
                      "Mail",
                      "Call",
                      "API"
                    ],
                    "description": "Conversation source (defaults to Call if not provided)"
                  },
                  "brand_id": {
                    "type": "number",
                    "description": "Brand ID (defaults to account's default brand if not provided)"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "Open",
                      "Pending",
                      "Resolved",
                      "Closed"
                    ],
                    "description": "Status (defaults to Open if not provided)"
                  },
                  "requested_by": {
                    "type": "string",
                    "description": "Requested by email or phone number"
                  },
                  "requested_by_firstname": {
                    "type": "string",
                    "description": "First name applied to the requester contact only when it is created. If a contact with this email/phone already exists, it is reused and its name is not changed."
                  },
                  "requested_by_lastname": {
                    "type": "string",
                    "description": "Last name applied to the requester contact only when it is created (same create-only behaviour as requested_by_firstname)."
                  },
                  "assignee": {
                    "type": "string",
                    "format": "email"
                  },
                  "team_id": {
                    "type": "number"
                  },
                  "created_at": {
                    "type": "integer",
                    "description": "The time the conversation was created (epoch seconds). If not provided, the current time is used.",
                    "example": 1672531200
                  },
                  "resolved_at": {
                    "type": "integer",
                    "description": "The time the conversation was resolved (epoch seconds). Only allowed when status is Resolved or Closed, and must be >= created_at.",
                    "example": 1672617600
                  },
                  "skip_notifications": {
                    "type": "boolean",
                    "description": "Option to disable notifications when a Conversation is created. Defaults to false."
                  },
                  "custom_fields": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "internal_name",
                        "value"
                      ],
                      "properties": {
                        "internal_name": {
                          "type": "string"
                        },
                        "value": {
                          "description": "Field value. For multi_select fields, an array of option ids or option names (a single id/name is treated as a one-element array). For url fields, an http or https URL (max 2000 characters; a bare domain is saved with https://). For boolean fields, JSON true or false.",
                          "oneOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "boolean"
                            },
                            {
                              "type": "array",
                              "items": {
                                "oneOf": [
                                  {
                                    "type": "string"
                                  },
                                  {
                                    "type": "number"
                                  }
                                ]
                              }
                            }
                          ]
                        }
                      }
                    }
                  },
                  "tags": {
                    "type": "array",
                    "description": "Tag labels to attach to the conversation. Tags that don't exist are created. Also useful for recording the channel/origin (e.g. \"chat\", \"email\").",
                    "items": {
                      "type": "string"
                    }
                  },
                  "attachments": {
                    "type": "array",
                    "description": "Files fetched from these URLs and attached to the conversation's opening message. If a file can't be fetched, the conversation is still created and that file is skipped.",
                    "items": {
                      "type": "object",
                      "required": [
                        "url"
                      ],
                      "properties": {
                        "url": {
                          "type": "string",
                          "format": "uri",
                          "description": "Public URL the file is fetched from and re-hosted."
                        },
                        "file_name": {
                          "type": "string"
                        },
                        "content_type": {
                          "type": "string"
                        },
                        "size": {
                          "type": "integer",
                          "description": "Size in bytes."
                        },
                        "headers": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "string"
                          },
                          "description": "Optional headers sent when fetching the URL (e.g. auth)."
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Conversation created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer",
                          "example": 12345
                        },
                        "brand": {
                          "type": "string",
                          "example": "Support Brand"
                        },
                        "brand_id": {
                          "type": "integer",
                          "example": 1
                        },
                        "source": {
                          "type": "string",
                          "example": "Mail"
                        },
                        "status": {
                          "type": "string",
                          "example": "Open"
                        },
                        "priority": {
                          "type": "string",
                          "example": "High"
                        },
                        "created_at": {
                          "type": "integer",
                          "example": 1672531200
                        },
                        "first_response_time": {
                          "type": "integer",
                          "nullable": true,
                          "example": null
                        },
                        "resolution_time": {
                          "type": "integer",
                          "nullable": true,
                          "example": null
                        },
                        "due": {
                          "type": "integer",
                          "nullable": true,
                          "example": 1672617600
                        },
                        "first_response_due": {
                          "type": "integer",
                          "nullable": true,
                          "example": 1672538400
                        },
                        "requested_by_email": {
                          "type": "string",
                          "format": "email",
                          "example": "customer@example.com"
                        },
                        "requested_by_id": {
                          "type": "integer",
                          "example": 67890
                        },
                        "assigned_to_member_id": {
                          "type": "integer",
                          "nullable": true,
                          "example": 123
                        },
                        "assigned_to_team_id": {
                          "type": "integer",
                          "nullable": true,
                          "example": 456
                        },
                        "last_updated_at": {
                          "type": "integer",
                          "example": 1672535400
                        },
                        "subject": {
                          "type": "string",
                          "example": "Payment issue with order #12345"
                        },
                        "description_html": {
                          "type": "string",
                          "example": "<p>I'm having trouble with my payment...</p>"
                        },
                        "description_text": {
                          "type": "string",
                          "example": "I'm having trouble with my payment..."
                        },
                        "attachments": {
                          "type": "array",
                          "description": "URLs of attachments sent on the opening message",
                          "items": {
                            "type": "string"
                          },
                          "example": [
                            "https://cdn.example.com/receipt.pdf"
                          ]
                        },
                        "tags": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "integer",
                                "example": 1
                              },
                              "label": {
                                "type": "string",
                                "example": "billing"
                              }
                            }
                          },
                          "example": [
                            {
                              "id": 1,
                              "label": "billing"
                            },
                            {
                              "id": 2,
                              "label": "urgent"
                            }
                          ]
                        },
                        "custom_fields": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "integer",
                                "example": 9250
                              },
                              "value": {
                                "description": "Field value. A multi_select field reads back as its selected option names joined with \", \" in option order; its ordered option ids are in option_ids. A boolean field reads back as true or false.",
                                "oneOf": [
                                  {
                                    "type": "string"
                                  },
                                  {
                                    "type": "number"
                                  },
                                  {
                                    "type": "boolean"
                                  },
                                  {
                                    "type": "array",
                                    "items": {
                                      "oneOf": [
                                        {
                                          "type": "string"
                                        },
                                        {
                                          "type": "number"
                                        }
                                      ]
                                    }
                                  }
                                ],
                                "example": "ORD-12345"
                              },
                              "option_ids": {
                                "type": "array",
                                "nullable": true,
                                "description": "Ordered option ids of a multi_select selection; null for every other field type",
                                "items": {
                                  "type": "integer"
                                },
                                "example": [
                                  7790,
                                  7791
                                ]
                              }
                            }
                          },
                          "example": [
                            {
                              "id": 9250,
                              "value": "ORD-12345",
                              "option_ids": null
                            },
                            {
                              "id": 9260,
                              "value": "premium",
                              "option_ids": null
                            },
                            {
                              "id": 9270,
                              "value": "Bug, Billing",
                              "option_ids": [
                                7790,
                                7791
                              ]
                            }
                          ]
                        },
                        "properties": {
                          "type": "object",
                          "properties": {
                            "request_language": {
                              "type": "string",
                              "example": "English"
                            },
                            "browser_timezone": {
                              "type": "string",
                              "example": "Asia/Calcutta"
                            },
                            "browser": {
                              "type": "string",
                              "example": "Chrome"
                            },
                            "device": {
                              "type": "string",
                              "example": "mac OS 10.15.7"
                            },
                            "ip_address": {
                              "type": "string",
                              "example": "192.168.1.1"
                            },
                            "country": {
                              "type": "string",
                              "example": "India"
                            },
                            "region": {
                              "type": "string",
                              "example": "Tamil Nadu > Chennai"
                            },
                            "referral_url": {
                              "type": "string",
                              "example": "http://localhost:9091/"
                            },
                            "utm_source": {
                              "type": "string",
                              "example": ""
                            },
                            "utm_medium": {
                              "type": "string",
                              "example": ""
                            },
                            "utm_campaign": {
                              "type": "string",
                              "example": ""
                            },
                            "utm_content": {
                              "type": "string",
                              "example": ""
                            },
                            "utm_term": {
                              "type": "string",
                              "example": ""
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Invalid field values"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Error while creating conversation"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/conversations/with-replies": {
      "get": {
        "operationId": "listConversationsWithReplies",
        "summary": "List all conversations with replies",
        "description": "Conversation list uses the same filters and `starting_after` cursor as GET /conversations (`per_page` max 20).\nRoot `pages` / `total_count` apply to conversations only. Each row includes `replies` with the same shape as\nGET /conversations/{id}/replies (`data`, `pages`, `total_count`). Use `replies_per_page` (max 50),\n`replies_sort_order`, and `type` for the embedded reply page. For more replies on a row, call\nGET /conversations/{id}/replies with `starting_after` = `replies.pages.next_cursor`, or follow\n`replies.pages.next_url` when returned.\n",
        "tags": [
          "Conversations"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "starting_after",
            "required": false,
            "description": "Cursor for conversation list pagination",
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "in": "query",
            "name": "per_page",
            "required": false,
            "description": "Conversations per page (1–20, default 20)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            }
          },
          {
            "in": "query",
            "name": "replies_per_page",
            "required": false,
            "description": "Replies per conversation (1–50, default 50)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          {
            "in": "query",
            "name": "replies_sort_order",
            "required": false,
            "description": "Reply list sort by sent_at (default desc)",
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            }
          },
          {
            "in": "query",
            "name": "type",
            "required": false,
            "description": "Filter replies by type",
            "schema": {
              "type": "string",
              "enum": [
                "INTERNAL_NOTE",
                "REPLY"
              ]
            }
          },
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "in": "query",
            "name": "priority",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "in": "query",
            "name": "assigned_to_member_id",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            }
          },
          {
            "in": "query",
            "name": "assigned_to_team_id",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            }
          },
          {
            "in": "query",
            "name": "brand_id",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            }
          },
          {
            "in": "query",
            "name": "requested_by_id",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "handled_by_ai_agent",
            "required": false,
            "description": "Same as GET /conversations `handled_by_ai_agent`. Omitted — no filter by AI handling. `true` — only conversations assigned to an AI agent.\n`false` — conversations handed off for human help, or where the assignee is not an AI agent.\n",
            "schema": {
              "type": "string",
              "enum": [
                true,
                false
              ]
            }
          },
          {
            "in": "query",
            "name": "search",
            "required": false,
            "description": "Search by subject, description, replies, or conversation ID. Use quotes for exact phrases.\n",
            "schema": {
              "type": "string",
              "maxLength": 250
            }
          },
          {
            "in": "query",
            "name": "sort_by",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "created_at",
                "updated_at"
              ]
            }
          },
          {
            "in": "query",
            "name": "sort_order",
            "required": false,
            "description": "Sort order for the conversation list",
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Conversations with nested replies"
          },
          "400": {
            "description": "Bad request"
          },
          "404": {
            "description": "Conversation not found (while loading replies)"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/conversations/{id}": {
