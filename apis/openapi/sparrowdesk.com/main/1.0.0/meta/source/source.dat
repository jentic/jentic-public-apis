                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer",
                          "example": 100000144
                        },
                        "name": {
                          "type": "string",
                          "example": "Priority Level"
                        },
                        "type": {
                          "type": "string",
                          "example": "dropdown"
                        },
                        "internal_name": {
                          "type": "string",
                          "example": "priority_level"
                        },
                        "description": {
                          "type": "string",
                          "nullable": true,
                          "example": "Customer priority tier"
                        },
                        "is_active": {
                          "type": "boolean",
                          "example": true
                        },
                        "is_default": {
                          "type": "boolean",
                          "example": false
                        },
                        "field_options": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "integer",
                                "example": 24
                              },
                              "name": {
                                "type": "string",
                                "example": "Low"
                              },
                              "position": {
                                "type": "integer",
                                "example": 1
                              },
                              "boolean_value": {
                                "type": "boolean",
                                "description": "Boolean fields only — the value this label stands for",
                                "example": true
                              }
                            }
                          }
                        },
                        "created_at": {
                          "type": "integer",
                          "description": "Unix timestamp",
                          "example": 1781455256
                        },
