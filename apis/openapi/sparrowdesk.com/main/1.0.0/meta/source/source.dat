                              "published_articles_count": {
                                "type": "integer",
                                "nullable": true,
                                "example": 2
                              },
                              "is_last_level_sub_collection": {
                                "type": "boolean",
                                "nullable": true,
                                "example": true
                              },
                              "created_at": {
                                "type": "integer",
                                "nullable": true,
                                "description": "Unix timestamp (seconds)"
                              },
                              "updated_at": {
                                "type": "integer",
                                "nullable": true,
                                "description": "Unix timestamp (seconds)"
                              }
                            }
                          }
                        },
                        "articles": {
                          "type": "array",
                          "description": "Articles in this collection (lightweight summary, no body).",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "integer",
                                "example": 1001
                              },
                              "title": {
                                "type": "string",
                                "nullable": true,
                                "example": "Getting started"
                              },
                              "slug": {
                                "type": "string",
                                "nullable": true
                              },
                              "help_center_id": {
                                "type": "integer",
                                "nullable": true
                              },
                              "brand_id": {
                                "type": "integer",
                                "nullable": true
                              },
                              "position": {
                                "type": "string",
                                "nullable": true
                              },
                              "created_by": {
                                "type": "object",
                                "nullable": true,
                                "properties": {
                                  "id": {
                                    "type": "integer"
                                  },
                                  "name": {
                                    "type": "string",
                                    "nullable": true
                                  },
                                  "email": {
                                    "type": "string",
                                    "nullable": true
                                  }
                                }
                              },
                              "created_at": {
                                "type": "integer",
                                "nullable": true
                              },
                              "updated_at": {
                                "type": "integer",
                                "nullable": true
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden – missing scope or feature",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
