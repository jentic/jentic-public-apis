    "/imports/conversations/status/{jobId}": {
      "get": {
        "operationId": "getConversationImportJobStatus",
        "summary": "Retrieve a conversation import job",
        "tags": [
          "Conversation Imports"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "jobId",
            "required": true,
            "description": "The job id returned by the bulk-import endpoint",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Job status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Job not found"
          }
        }
      }
    },
    "/conversations/fields": {
      "get": {
        "operationId": "listConversationFields",
        "summary": "List all conversation fields",
        "description": "Retrieve a list of all conversation fields. For nested (hierarchical) fields the options are returned per level in `nested_fields`: each level's options link to the previous level's option via `parent_option_id` (null for level-1 options). Multi select fields return their options in `field_options` like dropdown fields.\n",
        "tags": [
          "Conversation Fields"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "starting_after",
            "schema": {
              "type": "string"
            },
            "description": "Cursor for pagination"
          },
          {
            "in": "query",
            "name": "per_page",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            },
            "description": "Number of fields to return"
          },
          {
            "in": "query",
            "name": "is_active",
            "schema": {
              "type": "boolean"
            },
            "description": "Filter by active status"
          },
          {
            "in": "query",
            "name": "is_default",
            "schema": {
              "type": "boolean"
            },
            "description": "Filter by default fields"
          }
        ],
        "responses": {
          "200": {
            "description": "Conversation fields retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer",
                            "example": 102
                          },
                          "name": {
                            "type": "string",
                            "example": "Priority Level"
                          },
                          "internal_name": {
                            "type": "string",
                            "example": "priority_level"
                          },
                          "type": {
                            "type": "string",
                            "example": "dropdown"
                          },
                          "description": {
                            "type": "string",
                            "example": "Priority level for tickets"
                          },
                          "is_active": {
                            "type": "boolean",
                            "example": true
                          },
                          "is_default": {
                            "type": "boolean",
                            "example": false
                          },
                          "is_mandatory_on_close": {
                            "type": "boolean",
                            "example": true
                          },
                          "field_options": {
                            "type": "array",
                            "description": "Options of a dropdown or multi_select field (empty for nested fields — see `nested_fields`)",
                            "items": {
                              "type": "object",
                              "properties": {
                                "id": {
                                  "type": "integer",
                                  "example": 1
                                },
                                "name": {
                                  "type": "string",
                                  "example": "Low"
                                },
                                "position": {
                                  "type": "integer",
                                  "example": 1
                                },
                                "boolean_value": {
                                  "type": "boolean",
                                  "description": "Boolean fields only — the value this label stands for",
                                  "example": true
                                }
                              }
                            }
                          },
                          "nested_fields": {
                            "type": "array",
                            "description": "Only for nested fields — one entry per level with that level's options; `parent_option_id` links an option to the previous level's option (null on level 1)",
                            "items": {
                              "type": "object",
                              "properties": {
                                "id": {
                                  "type": "integer",
                                  "example": 205
                                },
                                "name": {
                                  "type": "string",
                                  "example": "Category"
                                },
                                "internal_name": {
                                  "type": "string",
                                  "example": "nested_level_102_1"
                                },
                                "level": {
                                  "type": "integer",
                                  "example": 1
                                },
                                "parent_id": {
                                  "type": "integer",
                                  "description": "Previous level's id (the nested field's id for level 1)",
                                  "example": 102
                                },
                                "options": {
                                  "type": "array",
                                  "items": {
                                    "type": "object",
                                    "properties": {
                                      "id": {
                                        "type": "integer",
                                        "example": 11
                                      },
                                      "name": {
                                        "type": "string",
                                        "example": "Hardware"
                                      },
                                      "position": {
                                        "type": "integer",
                                        "example": 1
                                      },
                                      "parent_option_id": {
                                        "type": "integer",
                                        "nullable": true,
                                        "example": null
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          },
                          "created_at": {
                            "type": "integer",
                            "example": 1672531200
                          },
                          "updated_at": {
                            "type": "integer",
                            "example": 1672535400
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Error while fetching conversation field",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Error while fetching conversation field"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createConversationField",
        "summary": "Create a conversation field",
        "tags": [
          "Conversation Fields"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "type"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Product Version"
                  },
                  "internal_name": {
                    "type": "string",
                    "example": "product_version"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "single_line_text",
                      "multi_line_text",
                      "dropdown",
                      "number",
                      "date",
                      "email",
                      "nested",
                      "multi_select",
                      "url",
                      "boolean"
                    ],
                    "example": "single_line_text"
                  },
                  "description": {
                    "type": "string",
                    "example": "Version of the product the issue relates to"
                  },
                  "is_mandatory_on_close": {
                    "type": "boolean",
                    "example": true,
                    "default": false
                  },
                  "field_options": {
                    "type": "array",
                    "description": "Required for dropdown and multi_select fields; not allowed for nested or boolean fields. An option name repeated within the list is skipped (case-insensitive), keeping the first spelling.",
                    "items": {
                      "type": "string"
                    },
                    "example": [
                      "v1.0",
                      "v2.0",
                      "v3.0"
                    ]
                  },
                  "boolean_options": {
                    "type": "object",
                    "description": "Required for boolean fields, not allowed for other types — the labels shown for true and false (must differ, case-insensitive)",
                    "properties": {
                      "true_label": {
                        "type": "string",
                        "example": "Approved"
                      },
                      "false_label": {
                        "type": "string",
                        "example": "Rejected"
                      }
                    }
                  },
                  "levels": {
                    "type": "array",
                    "description": "Nested fields only — level names, top-down (max 3)",
                    "items": {
                      "type": "string"
                    },
                    "example": [
                      "Category",
                      "Sub category",
                      "Item"
                    ]
                  },
                  "choices": {
                    "type": "array",
                    "description": "Nested fields only — the option tree; nest deeper levels under `children` (depth must not exceed the number of levels)",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string",
                          "example": "Hardware"
                        },
                        "children": {
                          "type": "array",
                          "description": "Child choices (same shape, recursive)",
                          "items": {
                            "type": "object"
                          }
                        }
                      }
                    },
                    "example": [
                      {
                        "name": "Hardware",
                        "children": [
                          {
                            "name": "Laptop",
                            "children": [
                              {
                                "name": "Battery"
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Conversation field created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer",
                          "example": 103
                        },
                        "name": {
                          "type": "string",
                          "example": "Product Version"
                        },
                        "internal_name": {
                          "type": "string",
                          "example": "product_version"
                        },
                        "type": {
                          "type": "string",
                          "example": "single_line_text"
                        },
                        "description": {
                          "type": "string",
                          "example": "Version of the product the issue relates to"
                        },
                        "is_active": {
                          "type": "boolean",
                          "example": true
                        },
                        "is_default": {
                          "type": "boolean",
                          "example": false
                        },
                        "is_mandatory_on_close": {
                          "type": "boolean",
                          "example": false
                        },
                        "field_options": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "integer",
                                "example": 1
                              },
                              "name": {
                                "type": "string",
                                "example": "v1.0"
                              },
                              "position": {
                                "type": "integer",
                                "example": 1
                              },
                              "boolean_value": {
                                "type": "boolean",
                                "description": "Boolean fields only — the value this label stands for",
                                "example": true
                              }
                            }
                          }
                        },
                        "created_at": {
                          "type": "integer",
                          "example": 1672531200
                        },
                        "updated_at": {
                          "type": "integer",
                          "example": 1672531200
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request - field_options sent for a type that has no options",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "field_options can only be provided for dropdown or multi_select type fields"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Conflict - a field with the same name or internal name already exists",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Field with internal name 'priority_level' already exists"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable entity - validation error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "field_options are required for dropdown type fields"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Error creating conversation field"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/conversations/fields/{id}": {
      "get": {
        "operationId": "retrieveConversationField",
        "summary": "Retrieve a conversation field",
        "tags": [
          "Conversation Fields"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "description": "ID of the conversation field to retrieve",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Conversation field retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer",
                          "example": 102
                        },
                        "name": {
                          "type": "string",
                          "example": "Priority Level"
                        },
                        "internal_name": {
                          "type": "string",
                          "example": "priority_level"
                        },
                        "type": {
                          "type": "string",
                          "example": "dropdown"
                        },
                        "description": {
                          "type": "string",
                          "example": "Priority level for tickets"
                        },
                        "is_active": {
                          "type": "boolean",
                          "example": true
                        },
                        "is_default": {
                          "type": "boolean",
                          "example": false
                        },
                        "is_mandatory_on_close": {
                          "type": "boolean",
                          "example": true
                        },
                        "field_options": {
                          "type": "array",
                          "description": "Options of a dropdown or multi_select field (empty for nested fields — see `nested_fields`)",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "integer",
                                "example": 1
                              },
                              "name": {
                                "type": "string",
                                "example": "Low"
                              },
                              "position": {
                                "type": "integer",
                                "example": 1
                              },
                              "boolean_value": {
                                "type": "boolean",
                                "description": "Boolean fields only — the value this label stands for",
                                "example": true
                              }
                            }
                          }
                        },
                        "nested_fields": {
                          "type": "array",
                          "description": "Only for nested fields — one entry per level with that level's options; `parent_option_id` links an option to the previous level's option (null on level 1)",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "integer",
                                "example": 205
                              },
                              "name": {
                                "type": "string",
                                "example": "Category"
                              },
                              "internal_name": {
                                "type": "string",
                                "example": "nested_level_102_1"
                              },
                              "level": {
                                "type": "integer",
                                "example": 1
                              },
                              "parent_id": {
                                "type": "integer",
                                "description": "Previous level's id (the nested field's id for level 1)",
                                "example": 102
                              },
                              "options": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "id": {
                                      "type": "integer",
                                      "example": 11
                                    },
                                    "name": {
                                      "type": "string",
                                      "example": "Hardware"
                                    },
                                    "position": {
                                      "type": "integer",
                                      "example": 1
                                    },
                                    "parent_option_id": {
                                      "type": "integer",
                                      "nullable": true,
                                      "example": null
                                    }
                                  }
                                }
                              }
                            }
                          }
                        },
                        "created_at": {
                          "type": "integer",
                          "example": 1672531200
                        },
                        "updated_at": {
                          "type": "integer",
                          "example": 1672535400
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Conversation field not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Conversation field with id 999 not found"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Error while fetching conversation field",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Error while fetching conversation field"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "updateConversationField",
