                                    "type": "array",
                                    "items": {
                                      "oneOf": [
                                        {
                                          "type": "string"
                                        },
                                        {
                                          "type": "number"
                                        }
                                      ]
                                    }
                                  }
                                ],
                                "example": "ORD-12345"
                              },
                              "conversation_field_id": {
                                "type": "integer",
                                "example": 2771
                              },
                              "option_id": {
                                "type": "integer",
                                "example": 1817
                              },
                              "option_ids": {
                                "type": "array",
                                "nullable": true,
                                "description": "Ordered option ids of a multi_select selection; null for every other field type",
                                "items": {
                                  "type": "integer"
                                },
                                "example": [
                                  7790,
                                  7791
                                ]
                              }
                            }
                          }
                        },
                        "csat": {
                          "type": "object",
                          "properties": {
                            "score": {
                              "type": "integer",
                              "nullable": true,
                              "example": 4,
                              "description": "Numeric CSAT score submitted by the customer"
                            },
                            "sentiment": {
                              "type": "string",
                              "nullable": true,
                              "example": "positive",
                              "description": "Sentiment derived from the score: positive, neutral, or negative"
                            },
                            "feedback": {
                              "type": "string",
                              "nullable": true,
                              "example": "Great support experience!",
                              "description": "Free-text feedback submitted by the customer"
                            },
                            "scale": {
                              "type": "integer",
                              "nullable": true,
                              "example": 5,
                              "description": "The scale used for the CSAT survey (e.g. 5 or 10)"
                            }
                          }
                        },
                        "properties": {
                          "type": "object",
                          "properties": {
                            "request_language": {
                              "type": "string",
                              "example": "English"
                            },
                            "browser_timezone": {
                              "type": "string",
                              "example": "Asia/Calcutta"
                            },
                            "browser": {
                              "type": "string",
                              "example": "Chrome"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Invalid conversation ID"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Conversation not found",
