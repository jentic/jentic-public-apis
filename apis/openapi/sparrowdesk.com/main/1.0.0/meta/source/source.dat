    "/imports/conversations": {
      "post": {
        "operationId": "importConversation",
        "summary": "Import a conversation",
        "description": "Backdated, no notifications/workflows/SLA. [requires \"edit all tickets\" scope]",
        "tags": [
          "Conversation Imports"
        ],
        "parameters": [
          {
            "in": "header",
            "name": "x-import-source",
            "required": false,
            "description": "Optional label identifying the system the conversation was imported from",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "conversation"
                ],
                "properties": {
                  "conversation": {
                    "type": "object",
                    "required": [
                      "subject",
                      "requester",
                      "created_at",
                      "description_html"
                    ],
                    "properties": {
                      "external_id": {
                        "type": "string",
                        "maxLength": 255,
                        "description": "Caller-supplied id used for idempotency/deduplication."
                      },
                      "subject": {
                        "type": "string",
                        "minLength": 1
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "Open",
                          "Pending",
                          "Resolved",
                          "Closed"
                        ],
                        "default": "Open"
                      },
                      "priority": {
                        "type": "string",
                        "enum": [
                          "Low",
                          "Medium",
                          "High",
                          "Urgent"
                        ],
                        "default": "Medium"
                      },
                      "requester": {
                        "type": "object",
                        "description": "Requester identity. At least one of external_id, email, or phone must be provided (name alone is not enough).",
                        "properties": {
                          "external_id": {
                            "type": "string",
                            "maxLength": 255
                          },
                          "email": {
                            "type": "string",
                            "format": "email"
                          },
                          "phone": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string",
                            "description": "Optional; sets the contact's name only when the contact is created."
                          }
                        }
                      },
                      "assignee_email": {
                        "type": "string",
                        "format": "email",
                        "description": "Email of the agent the conversation was assigned to."
                      },
                      "team_id": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "brand_id": {
                        "type": "integer",
                        "minimum": 1,
                        "description": "Defaults to the account's default brand when omitted."
                      },
                      "tags": {
                        "type": "array",
                        "description": "Tags to attach; also records channel/origin (e.g. \"chat\", \"email\").",
                        "items": {
                          "type": "string"
                        }
                      },
                      "created_at": {
                        "type": "integer",
                        "description": "Unix epoch seconds. Must not be in the future. Backdates the conversation."
                      },
                      "resolved_at": {
                        "type": "integer",
                        "description": "Unix epoch seconds. Only allowed when status is Resolved or Closed. Must be >= created_at."
                      },
                      "description_html": {
                        "type": "string",
                        "minLength": 1,
                        "description": "The opening message body (HTML)."
                      },
                      "attachments": {
                        "type": "array",
                        "description": "Files fetched from these URLs and attached to the opening message.",
                        "items": {
                          "type": "object",
                          "required": [
                            "url"
                          ],
                          "properties": {
                            "url": {
                              "type": "string",
                              "format": "uri",
                              "description": "Public URL the file is fetched from and re-hosted."
                            },
                            "file_name": {
                              "type": "string"
                            },
                            "content_type": {
                              "type": "string"
                            },
                            "size": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "headers": {
                              "type": "object",
                              "additionalProperties": {
                                "type": "string"
                              },
                              "description": "Optional headers sent when fetching the URL (e.g. auth)."
                            }
                          }
                        }
                      },
                      "custom_fields": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": [
                            "field_id",
                            "value"
                          ],
                          "properties": {
                            "field_id": {
                              "type": "integer",
                              "minimum": 1,
                              "description": "Stable id of the conversation field (from GET /conversation-fields)."
                            },
                            "value": {
                              "oneOf": [
                                {
                                  "type": "string"
                                },
                                {
                                  "type": "number"
                                },
                                {
                                  "type": "boolean"
                                }
                              ],
                              "description": "Encoded by field type: text/textarea/email/url -> string, number -> number, date -> epoch seconds, dropdown -> option id, boolean -> true/false."
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Conversation imported",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Request body failed validation"
          }
        }
      }
    },
    "/imports/conversations/create_many": {
