      "patch": {
        "operationId": "updateConversation",
        "summary": "Update a conversation",
        "tags": [
          "Conversations"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "description": "Conversation id",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "subject": {
                    "type": "string"
                  },
                  "priority": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string"
                  },
                  "assignee": {
                    "type": "string",
                    "format": "email"
                  },
                  "team": {
                    "type": "string"
                  },
                  "custom_fields": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "internal_name": {
                          "type": "string"
                        },
                        "value": {
                          "description": "Field value. For multi_select fields, an array of option ids or option names (a single id/name is treated as a one-element array). For url fields, an http or https URL (max 2000 characters; a bare domain is saved with https://). For boolean fields, JSON true or false.",
                          "oneOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "boolean"
                            },
                            {
                              "type": "array",
                              "items": {
                                "oneOf": [
                                  {
                                    "type": "string"
                                  },
                                  {
                                    "type": "number"
                                  }
                                ]
                              }
                            }
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Conversation updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer",
                          "example": 12345
                        },
                        "brand": {
                          "type": "string",
                          "example": "Support Brand"
                        },
                        "brand_id": {
                          "type": "integer",
                          "example": 12345
                        },
                        "source": {
                          "type": "string",
                          "example": "Mail"
                        },
                        "status": {
                          "type": "string",
                          "example": "Open"
                        },
                        "priority": {
                          "type": "string",
                          "example": "High"
                        },
                        "created_at": {
                          "type": "integer",
                          "example": 1672531200
                        },
                        "first_response_time": {
                          "type": "integer",
                          "nullable": true,
                          "example": 1672534800
                        },
                        "resolution_time": {
                          "type": "integer",
                          "nullable": true,
                          "example": null
                        },
                        "due": {
                          "type": "integer",
                          "nullable": true,
                          "example": 1672617600
                        },
                        "first_response_due": {
                          "type": "integer",
                          "nullable": true,
                          "example": 1672538400
                        },
                        "requested_by_email": {
                          "type": "string",
                          "format": "email",
                          "example": "customer@example.com"
                        },
                        "requested_by_id": {
                          "type": "integer",
                          "example": 67890
                        },
                        "assigned_to_member_id": {
                          "type": "integer",
                          "nullable": true,
                          "example": 123
                        },
                        "assigned_to_team_id": {
                          "type": "integer",
                          "nullable": true,
                          "example": 456
                        },
                        "last_updated_at": {
                          "type": "integer",
                          "example": 1672535400
                        },
                        "subject": {
                          "type": "string",
                          "example": "Payment issue with order #12345"
                        },
                        "description_html": {
                          "type": "string",
                          "example": "<p>I'm having trouble with my payment...</p>"
                        },
                        "description_text": {
                          "type": "string",
                          "example": "I'm having trouble with my payment..."
                        },
                        "attachments": {
                          "type": "array",
                          "description": "URLs of attachments sent on the opening message",
                          "items": {
                            "type": "string"
                          },
                          "example": [
                            "https://cdn.example.com/receipt.pdf"
                          ]
                        },
                        "tags": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "integer",
                                "example": 1
                              },
                              "label": {
                                "type": "string",
                                "example": "billing"
                              }
                            }
                          }
                        },
                        "custom_fields": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "integer",
                                "example": 9250
                              },
                              "value": {
                                "description": "Field value. A multi_select field reads back as its selected option names joined with \", \" in option order; its ordered option ids are in option_ids. A boolean field reads back as true or false.",
                                "oneOf": [
                                  {
                                    "type": "string"
                                  },
                                  {
                                    "type": "number"
                                  },
                                  {
                                    "type": "boolean"
                                  },
                                  {
                                    "type": "array",
                                    "items": {
                                      "oneOf": [
                                        {
                                          "type": "string"
                                        },
                                        {
                                          "type": "number"
                                        }
                                      ]
                                    }
                                  }
                                ],
                                "example": "ORD-12345"
                              },
                              "option_ids": {
                                "type": "array",
                                "nullable": true,
                                "description": "Ordered option ids of a multi_select selection; null for every other field type",
                                "items": {
                                  "type": "integer"
                                },
                                "example": [
                                  7790,
                                  7791
                                ]
                              }
                            }
                          }
                        },
                        "properties": {
                          "type": "object",
                          "properties": {
                            "request_language": {
                              "type": "string",
                              "example": "English"
                            },
                            "browser_timezone": {
                              "type": "string",
                              "example": "Asia/Calcutta"
                            },
                            "browser": {
                              "type": "string",
                              "example": "Chrome"
                            },
                            "device": {
                              "type": "string",
                              "example": "mac OS 10.15.7"
                            },
                            "ip_address": {
                              "type": "string",
                              "example": "192.168.1.1"
                            },
                            "country": {
                              "type": "string",
                              "example": "India"
                            },
                            "region": {
                              "type": "string",
                              "example": "Tamil Nadu > Chennai"
                            },
                            "referral_url": {
                              "type": "string",
                              "example": "http://localhost:9091/"
                            },
                            "utm_source": {
                              "type": "string",
                              "example": ""
                            },
                            "utm_medium": {
                              "type": "string",
                              "example": ""
                            },
                            "utm_campaign": {
                              "type": "string",
                              "example": ""
                            },
                            "utm_content": {
                              "type": "string",
                              "example": ""
                            },
                            "utm_term": {
                              "type": "string",
                              "example": ""
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
