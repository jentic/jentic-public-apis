{
  "openapi": "3.0.0",
  "info": {
    "title": "SparrowDesk Developer API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://app.sparrowdesk.com/v1",
      "description": "SparrowDesk Developer API Host"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "token"
      }
    },
    "schemas": {
      "ReplyImportAttachment": {
        "type": "object",
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Publicly reachable URL of the attachment to fetch and store"
          },
          "file_name": {
            "type": "string"
          },
          "content_type": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Optional request headers used when fetching the attachment URL"
          }
        }
      },
      "ReplyImport": {
        "type": "object",
        "description": "A single historical reply. Either author_id or author_email must be provided to resolve the reply author.",
        "required": [
          "author_type",
          "html_body",
          "created_at"
        ],
        "properties": {
          "external_id": {
            "type": "string",
            "maxLength": 255,
            "description": "Caller-supplied id used for idempotency/deduplication"
          },
          "author_type": {
            "type": "string",
            "enum": [
              "agent",
              "requester"
            ]
          },
          "author_id": {
            "type": "integer",
            "minimum": 1,
            "description": "SparrowDesk author id (provide this or author_email)"
          },
          "author_email": {
            "type": "string",
            "format": "email",
            "description": "Author email, resolved to an author (provide this or author_id)"
          },
          "public": {
            "type": "boolean",
            "default": true,
            "description": "Whether the reply is public (false = internal note)"
          },
          "html_body": {
            "type": "string",
            "minLength": 1
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "ISO-8601 timestamp with offset. Must not be in the future."
          },
          "to": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "email"
            }
          },
          "cc": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "email"
            }
          },
          "bcc": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "email"
            }
          },
          "attachments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReplyImportAttachment"
            }
          }
        }
      },
      "EmbeddedNotes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer"
            },
            "title": {
              "type": "string",
              "nullable": true
            },
            "description": {
              "type": "string"
            },
            "attachments": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "integer"
                  },
                  "url": {
                    "type": "string"
                  },
                  "file_name": {
                    "type": "string"
                  },
                  "content_type": {
                    "type": "string"
                  },
                  "size": {
                    "type": "integer"
                  },
                  "status": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/zoona/start": {
      "post": {
        "operationId": "startZoonaConversation",
        "summary": "Start conversation",
        "tags": [
          "Zoona"
        ],
        "parameters": [
          {
            "in": "header",
            "name": "idempotency-key",
            "required": false,
            "description": "Optional idempotency key. Repeating the same key with an identical body returns the cached response for 5 minutes; a different body returns 409.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "message"
                ],
                "properties": {
                  "user": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "email": {
                        "type": "string",
                        "format": "email"
                      },
                      "attributes": {
                        "type": "object",
                        "additionalProperties": true
                      }
                    }
                  },
                  "session_token": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200,
                    "description": "Opaque session token returned by a previous /zoona/start call. Pass it to continue an existing session instead of starting a fresh one."
                  },
                  "message": {
                    "type": "object",
                    "required": [
                      "body"
                    ],
                    "properties": {
                      "body": {
                        "type": "string"
                      },
                      "timestamp": {
                        "type": "string",
                        "format": "date-time"
                      }
                    }
                  },
                  "metadata": {
                    "type": "object",
                    "additionalProperties": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Conversation accepted for processing",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "conversation_id": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "received_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "session_token": {
                      "type": "string",
                      "description": "Session token to reuse on subsequent /zoona/start calls to continue this session."
                    },
                    "identity_state": {
                      "type": "string",
                      "enum": [
                        "anonymous",
                        "identified"
                      ],
                      "description": "Whether the session is tied to an identified user (id/email supplied) or anonymous."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request body or missing API key context"
          },
          "401": {
            "description": "Missing or invalid bearer token"
          },
          "409": {
            "description": "Idempotency key was reused with a different body"
          },
          "422": {
            "description": "Request body failed validation"
          },
          "429": {
            "description": "Rate limit exceeded"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/zoona/reply": {
      "post": {
        "operationId": "sendZoonaReply",
        "summary": "Add reply",
        "tags": [
          "Zoona"
        ],
        "parameters": [
          {
            "in": "header",
            "name": "idempotency-key",
            "required": false,
            "description": "Optional idempotency key (same semantics as /zoona/start)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "conversation_id",
                  "message"
                ],
                "properties": {
                  "conversation_id": {
                    "type": "string"
                  },
                  "message": {
                    "type": "object",
                    "required": [
                      "body"
                    ],
                    "properties": {
                      "body": {
                        "type": "string"
                      },
                      "timestamp": {
                        "type": "string",
                        "format": "date-time"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Reply accepted for processing",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "conversation_id": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "received_at": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request body or missing API key context"
          },
          "401": {
            "description": "Missing or invalid bearer token"
          },
          "403": {
            "description": "API channel is not enabled for this agent"
          },
          "404": {
            "description": "Conversation not found"
          },
          "409": {
            "description": "Idempotency key was reused with a different body"
          },
          "422": {
            "description": "Request body failed validation"
          },
          "429": {
            "description": "Rate limit exceeded"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/webhooks": {
      "post": {
        "operationId": "createWebhookTarget",
        "summary": "Subscribe a webhook target",
        "description": "Registers an endpoint URL to receive deliveries for a supported event type. Requires the \"MANAGE_WEBHOOKS\" scope and the account's plan to include the Webhooks feature. The response's signing_secret is shown once and used to verify the X-Sparrowdesk-Signature header on each delivery.",
        "tags": [
          "Webhook Targets"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "endpoint_url",
                  "event_type"
                ],
                "properties": {
                  "endpoint_url": {
                    "type": "string",
                    "format": "uri",
                    "example": "https://hooks.zapier.com/hooks/standard/123456/abcdef/"
                  },
                  "event_type": {
                    "type": "string",
                    "example": "conversation.created"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Webhook target created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer"
                        },
                        "endpoint_url": {
                          "type": "string"
                        },
                        "event_type": {
                          "type": "string"
                        },
                        "enabled": {
                          "type": "boolean"
                        },
                        "created_at": {
                          "type": "integer"
                        },
                        "signing_secret": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid endpoint_url/event_type, or target limit reached",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listWebhookTargets",
        "summary": "List all webhook targets on the account",
        "description": "Returns every webhook target on the account, regardless of which credential created it.",
        "tags": [
          "Webhook Targets"
        ],
        "responses": {
          "200": {
            "description": "Webhook targets retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer"
                          },
                          "endpoint_url": {
                            "type": "string"
                          },
                          "event_type": {
                            "type": "string"
                          },
                          "enabled": {
                            "type": "boolean"
                          },
                          "created_at": {
                            "type": "integer"
                          }
                        }
                      }
                    },
                    "total_count": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/webhooks/{id}": {
      "delete": {
        "operationId": "deleteWebhookTarget",
        "summary": "Unsubscribe a webhook target",
        "description": "Any authenticated credential on the account can remove any webhook target, regardless of which credential created it.",
        "tags": [
          "Webhook Targets"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Webhook target removed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "success": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Webhook target not found (or not owned by the calling credential)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/tags": {
      "get": {
        "operationId": "listTags",
        "summary": "List all tags",
        "tags": [
          "Tags"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "starting_after",
            "required": false,
            "description": "Cursor for pagination (only needed for subsequent pages)",
            "schema": {
              "type": "string",
              "nullable": true
            },
            "examples": {
              "withCursor": {
                "value": "eyJjcmVhdGVkX2F0IjoiMjAyNS0wMS0xNVQwNjowMzowOS4zMThaIiwiaWQiOjEwMDAwMDA5Nn0=",
                "summary": "With pagination cursor"
              },
              "withoutCursor": {
                "summary": "First page (no cursor)"
              }
            }
          },
          {
            "in": "query",
            "name": "per_page",
            "required": false,
            "description": "Number of items per page (1-100, default 25)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25,
              "nullable": true
            }
          },
          {
            "in": "query",
            "name": "search",
            "required": false,
            "description": "Search tags by name",
            "schema": {
              "type": "string",
              "nullable": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved tags list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer",
                            "example": 100000001
                          },
                          "name": {
                            "type": "string",
                            "example": "bug"
                          },
                          "created_at": {
                            "type": "integer",
                            "description": "Unix timestamp",
                            "example": 1672531200
                          }
                        }
                      }
                    },
                    "pages": {
                      "type": "object",
                      "properties": {
                        "per_page": {
                          "type": "integer",
                          "example": 25
                        },
                        "next_cursor": {
                          "type": "string",
                          "nullable": true,
                          "example": "eyJjcmVhdGVkX2F0IjoiMjAyNS0wMS0xNVQwNjowMzowOS4zMThaIiwiaWQiOjEwMDAwMDA5Nn0="
                        },
                        "next_url": {
                          "type": "string",
                          "nullable": true,
                          "example": "https://api.sparrowdesk.com/tags?per_page=25&starting_after=eyJjcmVhdGVkX2F0IjoiMjAyNS0wMS0xNVQwNjowMzowOS4zMThaIiwiaWQiOjEwMDAwMDA5Nn0="
                        }
                      }
                    },
                    "total_count": {
                      "type": "integer",
                      "example": 156
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Invalid query parameters"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Resource not found"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "An error occurred while retrieving tags"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/contacts/{contactId}/notes": {
      "get": {
        "operationId": "listContactNotes",
        "summary": "List all contact notes",
        "tags": [
          "Notes"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "contactId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "starting_after",
            "required": false,
            "description": "Cursor from a previous response's pages.next_cursor",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "per_page",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Notes retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer",
                            "example": 1837
                          },
                          "contact_id": {
                            "type": "integer",
                            "nullable": true,
                            "example": 8821
                          },
                          "company_id": {
                            "type": "integer",
                            "nullable": true,
                            "example": null
                          },
                          "title": {
                            "type": "string",
                            "nullable": true,
                            "description": "Markdown. Not length limited.",
                            "example": "Renewal call"
                          },
                          "description": {
                            "type": "string",
                            "description": "Markdown. Limited to 10000 characters of prose; inline attachment references do not count towards that limit.\n",
                            "example": "Wants the annual plan. Sending the contract."
                          },
                          "source": {
                            "type": "string",
                            "enum": [
                              "manual",
                              "api"
                            ],
                            "example": "api"
                          },
                          "attachments": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "id": {
                                  "type": "integer",
                                  "example": 904
                                },
                                "url": {
                                  "type": "string",
                                  "example": "https://attachments.sparrowdesk.com/helpdesk-application/production/6f1c/note-attachments/contract.pdf"
                                },
                                "file_name": {
                                  "type": "string",
                                  "example": "contract.pdf"
                                },
                                "content_type": {
                                  "type": "string",
                                  "example": "application/pdf"
                                },
                                "size": {
                                  "type": "integer",
                                  "description": "Size in bytes",
                                  "example": 20481
                                },
                                "status": {
                                  "type": "string",
                                  "enum": [
                                    "UPLOADED",
                                    "PROCESSING",
                                    "READY",
                                    "FAILED",
                                    "MARKED_FOR_DELETION"
                                  ],
                                  "example": "READY"
                                }
                              }
                            }
                          },
                          "created_by": {
                            "type": "object",
                            "nullable": true,
                            "properties": {
                              "id": {
                                "type": "integer",
                                "example": 42
                              },
                              "name": {
                                "type": "string",
                                "nullable": true,
                                "example": "John Doe"
                              },
                              "email": {
                                "type": "string",
                                "nullable": true,
                                "example": "john.doe@example.com"
                              }
                            }
                          },
                          "last_updated_by": {
                            "type": "object",
                            "nullable": true,
                            "properties": {
                              "id": {
                                "type": "integer",
                                "example": 57
                              },
                              "name": {
                                "type": "string",
                                "nullable": true,
                                "example": "Jane Doe"
                              },
                              "email": {
                                "type": "string",
                                "nullable": true,
                                "example": "jane.doe@example.com"
                              }
                            }
                          },
                          "created_at": {
                            "type": "integer",
                            "description": "Unix timestamp",
                            "example": 1758537600
                          },
                          "updated_at": {
                            "type": "integer",
                            "description": "Unix timestamp",
                            "example": 1758537600
                          }
                        }
                      }
                    },
                    "pages": {
                      "type": "object",
                      "properties": {
                        "per_page": {
                          "type": "integer",
                          "example": 25
                        },
                        "next_cursor": {
                          "type": "string",
                          "description": "Absent on the last page",
                          "example": "eyJjcmVhdGVkX2F0IjoiMjAyNi0wOS0yMVQxMjowMDowMC4wMDBaIiwiaWQiOjE4MzZ9"
                        },
                        "next_url": {
                          "type": "string",
                          "description": "Absent on the last page",
                          "example": "https://api.sparrowdesk.com/v1/contacts/8821/notes?starting_after=eyJjcmVhdGVkX2F0IjoiMjAyNi0wOS0yMVQxMjowMDowMC4wMDBaIiwiaWQiOjE4MzZ9&per_page=25"
                        }
                      }
                    },
                    "total_count": {
                      "type": "integer",
                      "example": 128
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid cursor",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Invalid cursor"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Contact not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Contact not found"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Required"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Internal server error"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createContactNote",
        "summary": "Create a contact note",
        "tags": [
          "Notes"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "contactId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "description"
                ],
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "attachments": {
                    "type": "array",
                    "maxItems": 20,
                    "items": {
                      "type": "object",
                      "required": [
                        "url"
                      ],
                      "properties": {
                        "url": {
                          "type": "string",
                          "description": "Publicly reachable URL. The file is fetched server-side and re-hosted; the caller never uploads bytes. A URL already pointing at SparrowDesk storage is recognised and kept rather than fetched again, so a note can be edited by sending back what a GET returned.\n",
                          "example": "https://example.com/contract.pdf"
                        },
                        "file_name": {
                          "type": "string",
                          "example": "contract.pdf"
                        },
                        "content_type": {
                          "type": "string",
                          "example": "application/pdf"
                        },
                        "size": {
                          "type": "integer",
                          "example": 20481
                        },
                        "headers": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "string"
                          },
                          "description": "Sent when fetching the URL. Never returned.\n"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Note created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer",
                          "example": 1837
                        },
                        "contact_id": {
                          "type": "integer",
                          "nullable": true,
                          "example": 8821
                        },
                        "company_id": {
                          "type": "integer",
                          "nullable": true,
                          "example": null
                        },
                        "title": {
                          "type": "string",
                          "nullable": true,
                          "description": "Markdown. Not length limited.",
                          "example": "Renewal call"
                        },
                        "description": {
                          "type": "string",
                          "description": "Markdown. Limited to 10000 characters of prose; inline attachment references do not count towards that limit.\n",
                          "example": "Wants the annual plan. Sending the contract."
                        },
                        "source": {
                          "type": "string",
                          "enum": [
                            "manual",
                            "api"
                          ],
                          "example": "api"
                        },
                        "attachments": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "integer",
                                "example": 904
                              },
                              "url": {
                                "type": "string",
                                "example": "https://attachments.sparrowdesk.com/helpdesk-application/production/6f1c/note-attachments/contract.pdf"
                              },
                              "file_name": {
                                "type": "string",
                                "example": "contract.pdf"
                              },
                              "content_type": {
                                "type": "string",
                                "example": "application/pdf"
                              },
                              "size": {
                                "type": "integer",
                                "description": "Size in bytes",
                                "example": 20481
                              },
                              "status": {
                                "type": "string",
                                "enum": [
                                  "UPLOADED",
                                  "PROCESSING",
                                  "READY",
                                  "FAILED",
                                  "MARKED_FOR_DELETION"
                                ],
                                "example": "READY"
                              }
                            }
                          }
                        },
                        "created_by": {
                          "type": "object",
                          "nullable": true,
                          "properties": {
                            "id": {
                              "type": "integer",
                              "example": 42
                            },
                            "name": {
                              "type": "string",
                              "nullable": true,
                              "example": "John Doe"
                            },
                            "email": {
                              "type": "string",
                              "nullable": true,
                              "example": "john.doe@example.com"
                            }
                          }
                        },
                        "last_updated_by": {
                          "type": "object",
                          "nullable": true,
                          "properties": {
                            "id": {
                              "type": "integer",
                              "example": 57
                            },
                            "name": {
                              "type": "string",
                              "nullable": true,
                              "example": "Jane Doe"
                            },
                            "email": {
                              "type": "string",
                              "nullable": true,
                              "example": "jane.doe@example.com"
                            }
                          }
                        },
                        "created_at": {
                          "type": "integer",
                          "description": "Unix timestamp",
                          "example": 1758537600
                        },
                        "updated_at": {
                          "type": "integer",
                          "description": "Unix timestamp",
                          "example": 1758537600
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Description over the cap, attachment too large or of an unsupported type, attachment fetch failed, or the API key has no member attached\n",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Description must not exceed 10000 characters"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Contact not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Contact not found"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Invalid body",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Required"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Internal server error"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
