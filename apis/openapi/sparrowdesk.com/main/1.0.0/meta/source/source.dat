    "/contacts/fields": {
      "get": {
        "operationId": "listContactFields",
        "summary": "List all contact fields",
        "description": "Returns contact fields along with the IDs of their field options. Requires \"view contacts\" scope.",
        "tags": [
          "Contact Fields"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "starting_after",
            "schema": {
              "type": "string"
            },
            "description": "Cursor from previous response"
          },
          {
            "in": "query",
            "name": "per_page",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "in": "query",
            "name": "is_active",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "is_default",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Contact fields retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer",
                            "example": 100000144
                          },
                          "name": {
                            "type": "string",
                            "example": "Priority Level"
                          },
                          "type": {
                            "type": "string",
                            "example": "dropdown"
                          },
                          "internal_name": {
                            "type": "string",
                            "example": "priority_level"
                          },
                          "description": {
                            "type": "string",
                            "nullable": true,
                            "example": "Customer priority tier"
                          },
                          "is_active": {
                            "type": "boolean",
                            "example": true
                          },
                          "is_default": {
                            "type": "boolean",
                            "example": false
                          },
                          "field_options": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "id": {
                                  "type": "integer",
                                  "example": 24
                                },
                                "name": {
                                  "type": "string",
                                  "example": "Low"
                                },
                                "position": {
                                  "type": "integer",
                                  "example": 1
                                },
                                "boolean_value": {
                                  "type": "boolean",
                                  "description": "Boolean fields only — the value this label stands for",
                                  "example": true
                                }
                              }
                            }
                          },
                          "created_at": {
                            "type": "integer",
                            "description": "Unix timestamp",
                            "example": 1781455256
                          },
                          "updated_at": {
                            "type": "integer",
                            "description": "Unix timestamp",
                            "example": 1781455256
                          }
                        }
                      }
                    },
                    "pages": {
                      "type": "object",
                      "properties": {
                        "per_page": {
                          "type": "integer",
                          "example": 25
                        },
                        "next_cursor": {
                          "type": "string",
                          "nullable": true,
                          "example": "eyJjcmVhdGVkX2F0IjoiMjAyNS0wMS0xNVQwNjowMzowOS4zMThaIiwiaWQiOjEwMDAwMDA5Nn0="
                        },
                        "next_url": {
                          "type": "string",
                          "nullable": true,
                          "example": "https://api.sparrowdesk.com/contacts/fields?per_page=25&starting_after=eyJjcmVhdGVkX2F0IjoiMjAyNS0wMS0xNVQwNjowMzowOS4zMThaIiwiaWQiOjEwMDAwMDA5Nn0="
                        }
                      }
                    },
                    "total_count": {
                      "type": "integer",
                      "example": 12
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Invalid query parameters"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Error while fetching contact fields"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a contact field",
        "description": "Creates a new contact field. For dropdown type, `field_options` is required and each option is returned with its ID. For boolean type, `boolean_options` is required and its two labels are returned as options with `boolean_value`. Requires \"manage contacts\" scope.",
        "tags": [
          "Contact Fields"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "type"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Priority Level"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "text",
                      "singleLineText",
                      "multiLineText",
                      "number",
                      "multiselect",
                      "date",
                      "email",
                      "dropdown",
                      "url",
                      "boolean"
                    ],
                    "example": "dropdown"
                  },
                  "internal_name": {
                    "type": "string",
                    "description": "Auto-generated from name if not provided (snake_case)",
                    "example": "priority_level"
                  },
                  "description": {
                    "type": "string",
                    "example": "Customer priority tier"
                  },
                  "field_options": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Required for dropdown type",
                    "example": [
                      "Low",
                      "Medium",
                      "High"
                    ]
                  },
                  "boolean_options": {
                    "type": "object",
                    "description": "Required for boolean type, not allowed for other types — the labels shown for true and false (must differ, case-insensitive)",
                    "properties": {
                      "true_label": {
                        "type": "string",
                        "example": "Approved"
                      },
                      "false_label": {
                        "type": "string",
                        "example": "Rejected"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Contact field created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer",
                          "example": 100000144
                        },
                        "name": {
                          "type": "string",
                          "example": "Priority Level"
                        },
                        "type": {
                          "type": "string",
                          "example": "dropdown"
                        },
                        "internal_name": {
                          "type": "string",
                          "example": "priority_level"
                        },
                        "description": {
                          "type": "string",
                          "nullable": true,
                          "example": "Customer priority tier"
                        },
                        "is_active": {
                          "type": "boolean",
                          "example": true
                        },
                        "is_default": {
                          "type": "boolean",
                          "example": false
                        },
                        "field_options": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "integer",
                                "example": 24
                              },
                              "name": {
                                "type": "string",
                                "example": "Low"
                              },
                              "position": {
                                "type": "integer",
                                "example": 1
                              },
                              "boolean_value": {
                                "type": "boolean",
                                "description": "Boolean fields only — the value this label stands for",
                                "example": true
                              }
                            }
                          }
                        },
                        "created_at": {
                          "type": "integer",
                          "description": "Unix timestamp",
                          "example": 1781455256
                        },
                        "updated_at": {
                          "type": "integer",
                          "description": "Unix timestamp",
                          "example": 1781455256
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request - field_options provided for a non-dropdown type",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "field_options can only be provided for dropdown type fields"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Conflict - name and/or internal name already exists",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Field with internal name 'priority_level' already exists"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Error while creating contact field"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "operationId": "createContactField"
      }
    },
    "/contacts/fields/{id}": {
      "get": {
        "summary": "Get a contact field by ID",
        "description": "Retrieve a single contact field along with the IDs of its field options. Requires \"view contacts\" scope.",
        "tags": [
          "Contact Fields"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Contact field ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Contact field retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
