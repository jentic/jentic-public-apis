    "/collections": {
      "get": {
        "operationId": "listCollections",
        "summary": "List all collections",
        "tags": [
          "Collections"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "help_center_id",
            "required": true,
            "description": "ID of the help center",
            "schema": {
              "type": "integer",
              "example": 994
            }
          },
          {
            "in": "query",
            "name": "starting_after",
            "required": false,
            "description": "Cursor for pagination of top-level collections (only needed for subsequent pages)",
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "in": "query",
            "name": "per_page",
            "required": false,
            "description": "Number of top-level collections per page (1-100, default 30)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 30,
              "nullable": true
            }
          },
          {
            "in": "query",
            "name": "collection_id",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "When provided, returns only the direct child collections under this parent collection (paginated).\nWhen omitted, returns collections based on the `is_root` parameter.\n"
          },
          {
            "in": "query",
            "name": "is_root",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Controls which collections are returned when `collection_id` is not provided.\n`true` — returns only root-level collections (flat list, no sub-collections).\n`false` (default) — returns root collections each with their direct child collections nested inside a `sub_collections` array.\n"
          }
        ],
        "responses": {
          "200": {
            "description": "Collections for the given help center, wrapped in the standard data envelope.\n- **With `collection_id`**: direct child collections of that parent (flat). No `sub_collections` field.\n- **`is_root=true`**: only root-level collections. No `sub_collections` field.\n- **Default (`is_root=false`)**: root collections each with their direct `sub_collections` nested inside.\n",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer",
                            "example": 1201
                          },
                          "name": {
                            "type": "string",
                            "nullable": true,
                            "example": "Getting started"
                          },
                          "description": {
                            "type": "string",
                            "nullable": true,
                            "example": "Everything you need to get up and running."
                          },
                          "icon": {
                            "type": "string",
                            "nullable": true,
                            "example": "📘"
                          },
                          "slug": {
                            "type": "string",
                            "nullable": true,
                            "example": "getting-started"
                          },
                          "level": {
                            "type": "integer",
                            "nullable": true,
                            "description": "Nesting depth — 1 for root collections.",
                            "example": 1
                          },
                          "help_center_id": {
                            "type": "integer",
                            "nullable": true,
                            "example": 994
                          },
                          "brand_id": {
                            "type": "integer",
                            "nullable": true,
                            "example": 1
                          },
                          "parent_collection_id": {
                            "type": "integer",
                            "nullable": true,
                            "example": null
                          },
                          "root_collection_id": {
                            "type": "integer",
                            "nullable": true,
                            "example": null
                          },
                          "parent_collection": {
                            "type": "object",
                            "nullable": true,
                            "properties": {
                              "id": {
                                "type": "integer",
                                "example": 1200
                              },
                              "name": {
                                "type": "string",
                                "nullable": true,
                                "example": "Support"
                              },
                              "slug": {
                                "type": "string",
                                "nullable": true,
                                "example": "support"
                              }
                            }
                          },
                          "root_collection": {
                            "type": "object",
                            "nullable": true,
                            "properties": {
                              "id": {
                                "type": "integer",
                                "example": 1200
                              },
                              "name": {
                                "type": "string",
                                "nullable": true,
                                "example": "Support"
                              },
                              "slug": {
                                "type": "string",
                                "nullable": true,
                                "example": "support"
                              }
                            }
                          },
                          "position": {
                            "type": "string",
                            "nullable": true,
                            "description": "Fractional-index position for ordering.",
                            "example": "a4"
                          },
                          "subcollections_count": {
                            "type": "integer",
                            "nullable": true,
                            "example": 2
                          },
                          "articles_count": {
                            "type": "integer",
                            "nullable": true,
                            "example": 10
                          },
                          "published_articles_count": {
                            "type": "integer",
                            "nullable": true,
                            "example": 8
                          },
                          "is_last_level_sub_collection": {
                            "type": "boolean",
                            "nullable": true,
                            "example": false
                          },
                          "created_at": {
                            "type": "integer",
                            "nullable": true,
                            "description": "Unix timestamp (seconds)"
                          },
                          "updated_at": {
                            "type": "integer",
                            "nullable": true,
                            "description": "Unix timestamp (seconds)"
                          },
                          "sub_collections": {
                            "type": "array",
                            "description": "Direct child collections (same shape, without their own sub_collections). Present only in the default (is_root=false) mode.",
                            "items": {
                              "type": "object"
                            }
                          }
                        }
                      }
                    },
                    "pages": {
                      "type": "object",
                      "properties": {
                        "per_page": {
                          "type": "integer",
                          "example": 30
                        },
                        "next_cursor": {
                          "type": "string",
                          "nullable": true
                        },
                        "next_url": {
                          "type": "string",
                          "nullable": true
                        }
                      }
                    },
                    "total_count": {
                      "type": "integer",
                      "description": "Total number of top-level collections.",
                      "example": 3
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request (e.g. malformed starting_after cursor)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Invalid cursor"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden – missing scope or feature",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Missing required scope or product feature is not enabled for this account."
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation error (e.g. invalid help_center_id)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Invalid help_center_id"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "An unexpected error occurred while loading collections."
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createCollection",
        "summary": "Create a collection",
        "tags": [
          "Collections"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "help_center_id",
                  "brand_id"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Getting Started"
                  },
                  "description": {
                    "type": "string",
                    "example": "Introduction articles for new users"
                  },
                  "help_center_id": {
                    "type": "integer",
                    "example": 994
                  },
                  "brand_id": {
                    "type": "integer",
                    "example": 1
                  },
                  "parent_collection_id": {
                    "type": "integer",
                    "description": "Optional parent collection id — create a nested collection under this parent",
                    "example": 1200
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Collection created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer",
                          "example": 1201
                        },
                        "name": {
                          "type": "string",
                          "nullable": true,
                          "example": "Getting started"
                        },
                        "slug": {
                          "type": "string",
                          "nullable": true,
                          "example": "getting-started"
                        },
                        "help_center_id": {
                          "type": "integer",
                          "nullable": true,
                          "example": 994
                        },
                        "brand_id": {
                          "type": "integer",
                          "nullable": true,
                          "example": 1
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Business rule violation. Possible messages:\n- `Collections can only be nested up to 2 levels deep.`\n- `Parent collection not found.`\n- `The parent collection does not belong to the specified help center.`\n",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Collections can only be nested up to 2 levels deep."
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden – missing scope or feature",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Missing required scope or product feature is not enabled for this account."
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "name is required"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "An unexpected error occurred while creating the collection."
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
