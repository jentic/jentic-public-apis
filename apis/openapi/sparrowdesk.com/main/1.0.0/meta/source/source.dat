    },
    "/articles": {
      "get": {
        "operationId": "listArticles",
        "summary": "List all articles",
        "tags": [
          "Articles"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "help_center_id",
            "required": true,
            "description": "Help center id (from GET /helpcenters)",
            "schema": {
              "type": "integer",
              "example": 994
            }
          },
          {
            "in": "query",
            "name": "published",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "Include published articles. Omit all three status flags to include every lifecycle bucket."
          },
          {
            "in": "query",
            "name": "draft",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "Include draft and under-review articles."
          },
          {
            "in": "query",
            "name": "archived",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "Include archived articles."
          },
          {
            "in": "query",
            "name": "starting_after",
            "required": false,
            "description": "Cursor for pagination (only needed for subsequent pages)",
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "in": "query",
            "name": "per_page",
            "required": false,
            "description": "Number of items per page (1-100, default 30)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 30,
              "nullable": true
            }
          },
          {
            "in": "query",
            "name": "search",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Search title and body."
          },
          {
            "in": "query",
            "name": "collection_id",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "Restrict to a specific collection."
          }
        ],
        "responses": {
          "200": {
            "description": "Article list with pagination",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer",
                            "example": 1001
                          },
                          "title": {
                            "type": "string",
                            "nullable": true,
                            "example": "Getting started with SparrowDesk"
                          },
                          "slug": {
                            "type": "string",
                            "nullable": true,
                            "example": "getting-started-with-sparrowdesk"
                          },
                          "status": {
                            "type": "string",
                            "nullable": true,
                            "description": "Article lifecycle status",
                            "example": "PUBLISHED"
                          },
                          "draft_html_content": {
                            "type": "string",
                            "nullable": true,
                            "description": "Draft version body as HTML; null when there is no draft version.",
                            "example": "<p>Work in progress…</p>"
                          },
                          "published_html_content": {
                            "type": "string",
                            "nullable": true,
                            "description": "Published version body as HTML; null when the article has never been published.",
                            "example": "<p>Welcome to <strong>SparrowDesk</strong>.</p>"
                          },
                          "is_public": {
                            "type": "boolean",
                            "nullable": true,
                            "example": true
                          },
                          "is_archived": {
                            "type": "boolean",
                            "example": false
                          },
                          "help_center": {
                            "type": "object",
                            "nullable": true,
                            "properties": {
                              "id": {
                                "type": "integer",
                                "example": 994
                              },
                              "name": {
                                "type": "string",
                                "nullable": true,
                                "example": "Support"
                              }
                            }
                          },
                          "collection": {
                            "type": "object",
                            "nullable": true,
                            "properties": {
                              "id": {
                                "type": "integer",
                                "example": 1021
                              },
                              "name": {
                                "type": "string",
                                "nullable": true,
                                "example": "Basics"
                              }
                            }
                          },
                          "brand": {
                            "type": "object",
                            "nullable": true,
                            "properties": {
                              "id": {
                                "type": "integer",
                                "example": 1
                              },
                              "name": {
                                "type": "string",
                                "nullable": true,
                                "example": "Acme"
                              }
                            }
                          },
                          "created_by": {
                            "type": "object",
                            "nullable": true,
                            "properties": {
                              "id": {
                                "type": "integer",
                                "example": 5
                              },
                              "name": {
                                "type": "string",
                                "nullable": true,
                                "example": "Jane Doe"
                              },
                              "email": {
                                "type": "string",
                                "nullable": true,
                                "example": "jane@acme.com"
                              }
                            }
                          },
                          "last_updated_by": {
                            "type": "object",
                            "nullable": true,
                            "properties": {
                              "id": {
                                "type": "integer",
                                "example": 6
                              },
                              "name": {
                                "type": "string",
                                "nullable": true,
                                "example": "John Roe"
                              },
                              "email": {
                                "type": "string",
                                "nullable": true,
                                "example": "john@acme.com"
                              }
                            }
                          },
                          "published_at": {
                            "type": "integer",
                            "nullable": true,
                            "description": "Unix timestamp (seconds), null when not published",
                            "example": 1717236000
                          },
                          "created_at": {
                            "type": "integer",
                            "nullable": true,
                            "description": "Unix timestamp (seconds)",
                            "example": 1714557600
                          },
                          "updated_at": {
                            "type": "integer",
                            "nullable": true,
                            "description": "Unix timestamp (seconds)",
                            "example": 1717236000
                          }
                        }
                      }
                    },
                    "pages": {
                      "type": "object",
                      "properties": {
                        "per_page": {
                          "type": "integer",
                          "example": 30
                        },
                        "next_cursor": {
                          "type": "string",
                          "nullable": true
                        },
                        "next_url": {
                          "type": "string",
                          "nullable": true
                        }
                      }
                    },
                    "total_count": {
                      "type": "integer",
                      "example": 42
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request (e.g. malformed starting_after cursor)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Invalid cursor"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden – missing scope or feature",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Missing required scope or feature is not enabled"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Help center not found"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation error (e.g. missing help_center_id, or all status flags set to false)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Select at least one of published, draft, or archived (they cannot all be false)"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "An error occurred while retrieving articles"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createArticle",
        "summary": "Create an article",
        "tags": [
          "Articles"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "help_center_id",
                  "brand_id"
                ],
                "properties": {
                  "help_center_id": {
                    "type": "integer",
                    "example": 994
                  },
                  "brand_id": {
                    "type": "integer",
                    "example": 1
                  },
                  "title": {
                    "type": "string",
                    "example": "Getting started with SparrowDesk"
                  },
                  "content": {
                    "type": "string",
                    "description": "HTML content of the article, passed as a plain JSON string.\n\n**Supported tags:** `<p>`, `<h1>`–`<h6>`, `<ul>`, `<ol>`, `<li>`, `<a>`, `<strong>`, `<em>`, `<img>`, `<video>`, `<iframe>` (YouTube), `<table>`, `<code>`, `<blockquote>`\n\n**Images:** use `src` with an `https://` URL or a `data:image/...;base64,...` string.\n\n**YouTube:** embed iframes (`youtube.com/embed/ID`) are converted to native YouTube nodes.\n\n**Note:** `<script>` tags and event attributes (`onclick`, `onerror`, etc.) are stripped for security.\n",
                    "example": "<p>Welcome to <strong>SparrowDesk</strong>.</p><img src=\"https://cdn.example.com/hero.png\" alt=\"Hero\" />"
                  },
                  "publish": {
                    "type": "boolean",
                    "description": "When true, publishes the article after creating the draft. Requires collection_id and is_public.",
                    "example": false
                  },
                  "collection_id": {
                    "type": "integer",
                    "description": "Required when publish is true.",
                    "example": 1021
                  },
                  "is_public": {
                    "type": "boolean",
                    "description": "Required when publish is true. true = publicly visible, false = private.",
                    "example": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Article created as draft",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer",
                      "example": 1001
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "DRAFT",
                        "PUBLISHED"
                      ],
                      "example": "DRAFT"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden – missing scope or feature",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Missing required scope or feature is not enabled"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Invalid request body"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "An error occurred while creating the article"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/articles/{id}": {
      "put": {
        "operationId": "updateArticle",
        "summary": "Update an article",
        "tags": [
          "Articles"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "description": "Article id",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "example": "Updated: Getting started with SparrowDesk"
                  },
                  "content": {
                    "type": "string",
                    "description": "HTML content of the article, passed as a plain JSON string.\n\n**Supported tags:** `<p>`, `<h1>`–`<h6>`, `<ul>`, `<ol>`, `<li>`, `<a>`, `<strong>`, `<em>`, `<img>`, `<video>`, `<iframe>` (YouTube), `<table>`, `<code>`, `<blockquote>`\n\n**Images:** use `src` with an `https://` URL or a `data:image/...;base64,...` string.\n\n**YouTube:** embed iframes (`youtube.com/embed/ID`) are converted to native YouTube nodes.\n\n**Note:** `<script>` tags and event attributes (`onclick`, `onerror`, etc.) are stripped for security.\n",
                    "example": "<p>Updated content with <strong>new info</strong>.</p>"
                  },
                  "collection_id": {
                    "type": "integer",
                    "nullable": true,
                    "description": "Move to a different collection. Pass null to remove from collection.",
                    "example": 1022
                  },
                  "brand_id": {
                    "type": "integer",
                    "example": 1
                  },
                  "publish": {
                    "type": "boolean",
                    "description": "When true, publishes the draft after saving. Requires is_public.",
                    "example": false
                  },
                  "is_public": {
                    "type": "boolean",
                    "description": "Required when publish is true.",
                    "example": true
                  },
                  "ai_agent_enabled": {
                    "type": "boolean",
                    "description": "Enable or disable AI agent. Silently ignored without AI privilege.",
                    "example": false
                  },
                  "ai_copilot_enabled": {
                    "type": "boolean",
                    "description": "Enable or disable AI copilot. Silently ignored without AI privilege.",
                    "example": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Article updated (draft saved or published)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer",
                      "example": 1001
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "DRAFT",
                        "PUBLISHED"
                      ],
                      "example": "DRAFT"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden – missing scope or feature",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Missing required scope or feature is not enabled"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Article not found"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "is_public is required when publish is true"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "An error occurred while updating the article"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
