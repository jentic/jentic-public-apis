e":"user.total_number_visits|isnot|21"},"Exact match":{"description":"Exact match","value":"user.total_number_visits|is|12"}}},{"name":"criteriaTimeFilter","in":"query","description":"Time-based filter expression used to filter results by time field. Format: field|operator|value.\n\nAllowed fields (same as `timeField` parameter):\n- eventEsTimestamp : Last Seen\n- first_session_unix_timestamp : First Seen\n\nSupported operators:\n- exactly   → integer value (0 = Today, 1 = Yesterday)\n- lessthan  → integer value (e.g. 6 = last 7 days)\n- between   → date range in format dd/MM/yyyy-dd/MM/yyyy\n\nLocale settings are taken into account while interpreting dates and returning results.","required":false,"schema":{"type":"string"},"examples":{"Today":{"description":"Today","value":"eventEsTimestamp|exactly|0"},"Last 30 days":{"description":"Last 30 days","value":"eventEsTimestamp|lessthan|29"},"Yesterday":{"description":"Yesterday","value":"eventEsTimestamp|exactly|1"},"Last 7 days":{"description":"Last 7 days","value":"eventEsTimestamp|lessthan|6"},"Custom date range":{"description":"Custom date range","value":"eventEsTimestamp|between|04/11/2025-10/12/2025"}}},{"name":"criteriaFieldFilter","in":"query","description":"Field-based filter used to include leads based on field presence.\n\nFormat:\noperator|field1;field2\n\nAllowed operator:\n- hasanyvalue\n\nAllowed fields:\n- firstName\n- lastName\n- email\n\nMultiple fields can be provided using semicolons.","required":false,"schema":{"type":"string"},"examples":{"Has any value (email)":{"description":"Has any value (email)","value":"hasanyvalue|email"},"Has any value (first or last name)":{"description":"Has any value (first or last name)","value":"hasanyvalue|firstName;lastName"}}},{"name":"criteriaExitLinkFilter","in":"query","description":"Exit link filter used to include or exclude leads based on exit link values.\n\nFormat:\nfield|operator|value\n\nSupported operators:\n- contains\n- is\n- isnot\n- doesnotcontain\n\nMultiple values can be provided using semicolons.","required":false,"schema":{"type":"string"},"examples":{"Contains exit link":{"description":"Contains exit link","value":"exitLinkFilter|contains|leads"}}},{"name":"criteriaLeadscoreFilter","in":"query","description":"Minimum lead score threshold (optional). Only records with lead scores greater than the provided number (0–100) are returned.","required":false,"schema":{"maximum":100,"minimum":0,"type":"integer","format":"int32"}},{"name":"criteriaDisplayFilter","in":"query","description":"Display filter used to control which types of leads are returned.\n\nSupported values:\n- company\n- person\n- unidentified\n\nSelecting 'unidentified' returns leads that could not be identified as a company or a person.\n\nMultiple values can be provided using semicolons.","required":false,"schema":{"type":"string"},"examples":{"Person leads only":{"description":"Person leads only","value":"person"},"Company and unidentified leads":{"description":"Company and unidentified leads","value":"company;unidentified"},"All lead types":{"description":"All lead types","value":"company;person;unidentified"},"Company leads only":{"description":"Company leads only","value":"company"},"Unidentified leads":{"description":"Unidentified leads","value":"unidentified"}}},{"name":"timeField","in":"query","description":"Time field used for filtering.\n\nAllowed values:\n- eventEsTimestamp : Last Seen\n- first_session_unix_timestamp : First Seen","required":true,"schema":{"type":"string","default":"eventEsTimestamp","enum":["eventEsTimestamp","first_session_unix_timestamp"]}},{"name":"usePresetExclusionList","in":"query","description":"Use a preset exclusion list of criteria to exclude from result.","required":false,"schema":{"type":"string","enum":["use_id","last_most_likely_company","organizationName","organizationDomain"]},"examples":{"Exclude by use_id":{"description":"Exclude by use_id","value":"use_id"},"Exclude by multiple types":{"description":"Exclude by multiple types","value":"use_id,last_most_likely_company,organizationName,organizationDomain"}}},{"name":"dateFormat","in":"query","required":false,"schema":{"type":"string","default":"yyyy-MM-dd HH:mm:ss"}},{"name":"userId","in":"query","required":false,"schema":{"type":"integer","format":"int64"}},{"name":"separator","in":"query","description":"Specifies the delimiter used to separate columns in the generated CSV file.","required":false,"schema":{"type":"string","default":","}},{"name":"timeZone","in":"query","description":"Time zone used when parsing timestamps and evaluating time-based filters. \nIf not provided, the default time zone is Europe/Amsterdam.","required":false,"schema":{"type":"string","default":"Europe/Amsterdam"},"example":"Europe/Amsterdam"},{"name":"sortBy","in":"query","description":"Sort results by a specific field and direction.\n\nFormat:\nfield|direction\n\nAllowed fields:\n- lastEvent\n- _score\n\nAllowed directions:\n- asc\n- desc","required":false,"schema":{"type":"string"},"examples":{"Sort by time field (desc)":{"description":"Sort by time field (desc)","value":"lastEvent|desc"},"Sort by score field (desc)":{"description":"Sort by score field (desc)","value":"_score|desc"},"Sort by time field (asc)":{"description":"Sort by time field (asc)","value":"lastEvent|asc"},"Sort by score field (asc)":{"description":"Sort by score field (asc)","value":"_score|asc"}}},{"name":"additionalCsvFields","in":"query","description":"Comma-separated list of column identifiers to be included in the CSV export.\nThe order of the values determines the column order in the generated CSV.\n","required":false,"schema":{"type":"string"},"example":"eventEsTimestamp,organizationDomain,last_channel"}],"responses":{"400":{"description":"Bad Request: The request is invalid or malformed (missing/incorrect parameters).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1BadRequestResponse"}}}},"429":{"description":"Too Many Requests: Rate limit exceeded. The client has sent too many requests in a given time period","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RateLimitErrorResponse"}}}},"403":{"description":"Forbidden: The authenticated user does not have permission to access this resource.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1PermissionDenied"}}}},"409":{"description":"Conflict: The request could not be completed due to a resource state conflict.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1ConflictResponse"}}}},"404":{"description":"Not Found: The requested resource does not exist.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1NotFoundResponse"}}}},"500":{"description":"Interval Server Error: An unexpected error occurred on the server.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1InternalServerError"}}}},"402":{"description":"Payment Required: The client has exceeded credit limits.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1InternalServerError"}}}},"200":{"description":"CSV file generated successfully","headers":{"Content-Disposition":{"description":"Attachment filename","style":"simple","schema":{"type":"string","example":"attachment; filename=\"Target Audience.leadlist.20250417.+579720301.csv\""}},"nodata":{"description":"Indicates if CSV contains only headers without data rows. 'true' if no data, absent otherwise","style":"simple","schema":{"type":"string","example":true}}},"content":{"text/csv":{"schema":{"type":"string"}}}}}}},"/v1/leads/events":{"get":{"tags":["Leads"],"summary":"Retrieve Lead Events","description":"Returns all events associated with a specific session ID. Results can be optionally filtered by segment.","operationId":"getEvents","parameters":[{"name":"sessionId","in":"query","description":"Display data for the given sessionId. SessionId is a unique identifier of each session.","required":true,"schema":{"type":"string"}},{"name":"limit","in":"query","description":"The minimum number of records to be displayed in the output.<br/>Range : 1 - 100","required":true,"schema":{"maximum":100,"minimum":1,"type":"integer","format":"int32"}},{"name":"email","in":"query","description":"Email associated with the account","required":false,"schema":{"type":"string"}},{"name":"site","in":"query","description":"Dataset ID (site) for which events are retrieved","required":true,"schema":{"type":"string"}},{"name":"userId","in":"query","description":"UserId associated with email","required":false,"schema":{"type":"integer","format":"int64"}},{"name":"segmentId","in":"query","required":false,"schema":{"type":"integer","format":"int32"}}],"responses":{"400":{"description":"Bad Request: The request is invalid or malformed (missing/incorrect parameters).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1BadRequestResponse"}}}},"429":{"description":"Too Many Requests: Rate limit exceeded. The client has sent too many requests in a given time period","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RateLimitErrorResponse"}}}},"403":{"description":"Forbidden: The authenticated user does not have permission to access this resource.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1PermissionDenied"}}}},"409":{"description":"Conflict: The request could not be completed due to a resource state conflict.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1ConflictResponse"}}}},"404":{"description":"Not Found: The requested resource does not exist.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1NotFoundResponse"}}}},"500":{"description":"Interval Server Error: An unexpected error occurred on the server.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1InternalServerError"}}}},"402":{"description":"Payment Required: The client has exceeded credit limits.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1InternalServerError"}}}},"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/GetAllResponseMapStringObject"}}}}}}},"/v1/ip-lookup":{"get":{"tags":["Lookup API"],"summary":"IP Address Lookup","description":"Retrieve detailed information about an IP address, including organization, geolocation, ISP details, and metadata.\n\nReturned Data\nWhen a match is found, the following fields are returned:\n\nOrganization fields\n- ipDomain\n- ipOrganization\n\nGeo location fields\n- ipCountryName\n- ipCountryCode\n- ipRegionName\n- ipCity\n- ipSubContinent\n- ipLatitude\n- ipLongitude\n- ipTimezone\n\nIP address details\n- ipIsp\n- ipRange\n- ipUsageType\n\nMeta data\n- searchIp\n- searchResponseTimeMs","operationId":"lookupIp","parameters":[{"name":"ip","in":"query","description":"IP address to lookup (IPv4|IPv6 format)","required":true,"schema":{"type":"string"},"example":"8.8.8.8"},{"name":"datasetId","in":"query","description":"The dataset ID to associate with the operation’s credit. If not specified, a dataset linked to the account will be selected.","required":false,"schema":{"type":"string"}}],"responses":{"400":{"description":"Bad Request: The request is invalid or malformed (missing/incorrect parameters).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1BadRequestResponse"}}}},"429":{"description":"Too Many Requests: Rate limit exceeded. The client has sent too many requests in a given time period","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RateLimitErrorResponse"}}}},"403":{"description":"Forbidden: The authenticated user does not have permission to access this resource.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1PermissionDenied"}}}},"409":{"description":"Conflict: The request could not be completed due to a resource state conflict.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1ConflictResponse"}}}},"404":{"description":"Not Found: The requested resource does not exist.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1NotFoundResponse"}}}},"500":{"description":"Interval Server Error: An unexpected error occurred on the server.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1InternalServerError"}}}},"402":{"description":"Payment Required: The client has exceeded credit limits.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1InternalServerError"}}}},"200":{"description":"Successfully retrieved IP information","content":{"application/json":{"schema":{"$ref":"#/components/schemas/IpLookupDetails"},"examples":{"Success":{"description":"Success","value":{"ipRange":"193.8.9.0/24","ipCountryCode":"CH","ipCountryName":"Switzerland","ipSubContinent":"Western Europe","ipRegionName":"Basel-Stadt","ipCity":"Basel","ipLatitude":"47.5586","ipLongitude":"7.57401","ipTimezone":"Europe/Zurich","ipIsp":"BNP Paribas S.A.","ipOrganization":"BNP Paribas S.A.","ipDomain":"group.bnpparibas","ipUsageType":"COM","searchIp":"193.8.9.0","searchResponseTimeMs":165}}}}}}}}},"/v1/domain-lookup":{"get":{"tags":["Lookup API"],"summary":"Domain Lookup","description":"Retrieve organization details associated with a domain name. Provide a clean domain name (e.g., leadboxer.com) without protocol or www prefix.\n\nReturned Data\nWhen a match is found, the following fields are returned:\n\nOrganization core details\n- organizationName\n- organizationDomain\n- organizationDomainAliases\n- organizationType\n- organizationStatus\n- organizationSource\n- organizationReportDate\n\nOrganization description\n- organizationDescription\n- organizationDescriptionShort\n\nOrganization industry & size\n- organizationIndustryCode\n- organizationIndustryGroup\n- organizationIndustryName\n- organizationEmployeeCountRangeCode\n- organizationEmployeeCountRangeName\n\nOrganization address\n- organizationAddress.organizationStreetName\n- organizationAddress.organizationCity\n- organizationAddress.organizationState\n- organizationAddress.organizationPostalCode\n- organizationAddress.organizationCountry\n- organizationAddress.organizationCountryCode\n- organizationAddress.organizationPhone\n\nOrganization social links\n- organizationSocialLinks.organizationLinkedinUrl\n\nOrganization specialties\n- organizationSpecialties","operationId":"lookupDomain","parameters":[{"name":"domain","in":"query","description":"Domain name to lookup (e.g., leadboxer.com)","required":true,"schema":{"type":"string"},"example":"leadboxer.com"},{"name":"datasetId","in":"query","description":"The dataset ID to associate with the operation’s credit. If not specified, a dataset linked to the account will be selected.","required":false,"schema":{"type":"string"}}],"responses":{"400":{"description":"Bad Request: The request is invalid or malformed (missing/incorrect parameters).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1BadRequestResponse"}}}},"429":{"description":"Too Many Requests: Rate limit exceeded. The client has sent too many requests in a given time period","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RateLimitErrorResponse"}}}},"403":{"description":"Forbidden: The authenticated user does not have permission to access this resource.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1PermissionDenied"}}}},"409":{"description":"Conflict: The request could not be completed due to a resource state conflict.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1ConflictResponse"}}}},"404":{"description":"Not Found: The requested resource does not exist.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1NotFoundResponse"}}}},"500":{"description":"Interval Server Error: An unexpected error occurred on the server.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1InternalServerError"}}}},"402":{"description":"Payment Required: The client has exceeded credit limits.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1InternalServerError"}}}},"200":{"description":"Successfully retrieved organization information","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DomainOrganizationDetails"},"examples":{"Success":{"description":"Success","value":{"organizationAddress":{"organizationPostalCode":"1756","organizationCity":"Sofia","organizationState":"Sofia","organizationPhone":"+359 2 408 5888","organizationCountryCode":"BG","organizationStreetName":"Bulevard Sv. Kliment Ohridski 148","organizationCountry":"Bulgaria"},"organizationDescription":"Parcel Hive specializes in the design and production of high-quality, efficient, and visually appealing Smart Delivery Solutions. We offer a comprehensive, end-to-end service that encompasses everything from concept development to production, software integration, logistical deployment, installation services, and round-the-clock maintenance and support. Our commitment is to ensure our products remain current, efficient, and reliable. With the ambition to become the global leader in the delivery and maintenance of Automated Parcel Terminals, we continuously invest in innovation to not only meet but exceed industry standards. We provide scalable electronic lockers tailored to fit and serve a wide range of environments and needs. Our solutions are deployed in apartment complexes, retail locations, e-commerce hubs, office buildings, university campuses, amusement parks, and other high-traffic areas. Our smart storage compartments are crafted from high-quality, durable materials designed to withstand even the most challenging public environments. They offer secure, reliable storage with cutting-edge anti-theft technology to safeguard your business. CyberHive™—our proprietary software solution—is engineered to meet our customers' diverse needs. It is designed for multi-platform usage, delivering an efficient storage management system and remote support to ensure seamless operation.","organizationDescriptionShort":"Parcel Hive designs and produces high-quality, efficient Smart Delivery Solutions, specializing in smart parcel lockers.","organizationDomain":"parcelhive.net","organizationDomainAliases":["parcelhive.net"],"organizationEmployeeCountRangeCode":"E","organizationEmployeeCountRangeName":"201-500","organizationIndustryCode":"147","organizationIndustryGroup":"Manufacturing","organizationIndustryName":"Automation Machinery Manufacturing","organizationName":"Parcel Hive","organizationReportDate":"2025-10-14","organizationSocialLinks":{"organizationLinkedinUrl":"linkedin.com/company/parcel-hive"},"organizationSource":"GGL_PLC","organizationSpecialties":["Logistics Companies","click and collect","parcel locker","smart lockers","Refrigerated Lockers","parcel lockers","parcel terminals","B2B Terminals","City Terminals","Commercial Buildings Terminals","E-Commerce Terminals","Food Warmer Lockers","Fresh Lockers","Frozen Lockers","Hospital Terminals","Indoor Terminals","Key Keeper Locker","Outdoor Terminals","University Terminals","smart terminals","Retailers Terminals"],"organizationStatus":"OPERATIONAL","organizationType":"private"}}}}}}}}},"/v1/users/{userId}":{"delete":{"tags":["User Management"],"summary":"Delete User","description":"Removes a user from the account and revokes access to all associated resources.","operationId":"removeUser","parameters":[{"name":"userId","in":"path","description":"ID of the user to be removed from the account.","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"email","in":"query","description":"Email of the user performing the removal action.","required":true,"schema":{"type":"string"}}],"responses":{"400":{"description":"Bad Request: The request is invalid or malformed (missing/incorrect parameters).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1BadRequestResponse"}}}},"429":{"description":"Too Many Requests: Rate limit exceeded. The client has sent too many requests in a given time period","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RateLimitErrorResponse"}}}},"403":{"description":"Forbidden: The authenticated user does not have permission to access this resource.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1PermissionDenied"}}}},"409":{"description":"Conflict: The request could not be completed due to a resource state conflict.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1ConflictResponse"}}}},"404":{"description":"Not Found: The requested resource does not exist.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1NotFoundResponse"}}}},"500":{"description":"Interval Server Error: An unexpected error occurred on the server.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1InternalServerError"}}}},"402":{"description":"Payment Required: The client has exceeded credit limits.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1InternalServerError"}}}},"204":{"description":"User deleted successfully. No content returned."}}}},"/v1/datasets/{datasetId}":{"delete":{"tags":["Dataset Management"],"summary":"Remove Dataset","description":"Deletes the specified dataset from the account.","operationId":"removeDataset","parameters":[{"name":"datasetId","in":"path","required":true,"schema":{"type":"string"}},{"name":"email","in":"query","description":"Email associated with the account.","required":true,"schema":{"type":"string"}}],"responses":{"400":{"description":"Bad Request: The request is invalid or malformed (missing/incorrect parameters).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1BadRequestResponse"}}}},"429":{"description":"Too Many Requests: Rate limit exceeded. The client has sent too many requests in a given time period","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RateLimitErrorResponse"}}}},"403":{"description":"Forbidden: The authenticated user does not have permission to access this resource.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1PermissionDenied"}}}},"409":{"description":"Conflict: The request could not be completed due to a resource state conflict.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1ConflictResponse"}}}},"404":{"description":"Not Found: The requested resource does not exist.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1NotFoundResponse"}}}},"500":{"description":"Interval Server Error: An unexpected error occurred on the server.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1InternalServerError"}}}},"402":{"description":"Payment Required: The client has exceeded credit limits.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1InternalServerError"}}}},"204":{"description":"Dataset removed successfully. No content returned."}}}}},"components":{"schemas":{"RateLimitErrorResponse":{"type":"object","properties":{"timestamp":{"type":"integer","format":"int64","example":1765611454230},"status":{"type":"integer","format":"int32","example":429},"error":{"type":"string","example":"Too Many Requests"},"message":{"type":"string","example":"Rate limit exceeded. Please try again later."},"retryAfter":{"type":"integer","format":"int32","example":58},"limit":{"type":"integer","format":"int32","example":2},"remaining":{"type":"integer","format":"int32","example":0}},"description":"Rate limit exceeded error response"},"V1BadRequestResponse":{"type":"object","properties":{"type":{"type":"string","description":"A URI reference that identifies the problem type","example":"https://developers.leadboxer.com/docs/validation-error"},"title":{"type":"string","description":"A short, human-readable summary of the problem type","example":"The request is malformed or contains invalid data"},"status":{"type":"integer","description":"The HTTP status code","format":"int32","example":400},"detail":{"type":"string","description":"Human-readable explanation specific to this occurrence of the problem","example":"email must be a well-formed email address"},"instance":{"type":"string","description":"A URI reference that identifies the specific occurrence of the problem","example":"/v1/users/{userId}/name?email=johndoe.com"},"errors":{"type":"array","description":"Array of field-level validation errors","items":{"$ref":"#/components/schemas/ValidationError"}}}},"ValidationError":{"type":"object","properties":{"field":{"type":"string","description":"The name of the field that failed validation","example":"email"},"message":{"type":"string","description":"Human-readable error message for this specific field","example":"must be a well-formed email address"}},"description":"Array of field-level validation errors"},"V1PermissionDenied":{"type":"object","properties":{"type":{"type":"string","description":"A URI reference that identifies the problem type"},"title":{"type":"string","description":"A short, human-readable summary of the problem type"},"status":{"type":"integer","description":"The HTTP status code","format":"int32","example":403},"detail":{"type":"string","description":"Human-readable explanation specific to this occurrence of the problem"},"instance":{"type":"string","description":"A URI reference that identifies the specific occurrence of the problem"}}},"V1ConflictResponse":{"type":"object","properties":{"type":{"type":"string","description":"A URI reference that identifies the problem type"},"title":{"type":"string","description":"A short, human-readable summary of the problem type","example":"Resource already exist"},"status":{"type":"integer","description":"The HTTP status code","format":"int32","example":409},"detail":{"type":"string","description":"Human-readable explanation specific to this occurrence of the problem","example":"User with email: john.doe@examplecompany.com already exist"},"instance":{"type":"string","description":"A URI reference that identifies the specific occurrence of the problem","example":"/v1/users/?email=john.doe@examplecompany.com"}}},"V1NotFoundResponse":{"type":"object","properties":{"type":{"type":"string","description":"A URI reference that identifies the problem type"},"title":{"type":"string","description":"A short, human-readable summary of the problem type"},"status":{"type":"integer","description":"The HTTP status code","format":"int32","example":404},"detail":{"type":"string","description":"Human-readable explanation specific to this occurrence of the problem"},"instance":{"type":"string","description":"A URI reference that identifies the specific occurrence of the problem"}}},"V1InternalServerError":{"type":"object","properties":{"type":{"type":"string","description":"A URI reference that identifies the problem type"},"title":{"type":"string","description":"A short, human-readable summary of the problem type","example":"Internal Server Error"},"status":{"type":"integer","description":"The HTTP status code","format":"int32","example":500},"detail":{"type":"string","description":"Human-readable explanation specific to this occurrence of the problem","example":"An unexpected error occurred. Please contact support."},"instance":{"type":"string","description":"A URI reference that identifies the specific occurrence of the problem"}}},"ErrorVM":{"type":"object","properties":{"message":{"type":"string"},"description":{"type":"string"},"fieldErrors":{"type":"array","items":{"$ref":"#/components/schemas/FieldErrorVM"}}}},"FieldErrorVM":{"type":"object","properties":{"objectName":{"type":"string"},"field":{"type":"string"},"message":{"type":"string"}}},"ParameterizedErrorVM":{"type":"object","properties":{"message":{"type":"string"},"params":{"type":"array","items":{"type":"string"}}},"description":"Parameterized error response"},"UpdateUserName":{"required":["firstName","lastName"],"type":"object","properties":{"firstName":{"type":"string"},"lastName":{"type":"string"}},"description":"The new user name details."},"UpdateSegmentRequest":{"required":["accountId","emailView","notificationType","type"],"type":"object","properties":{"accountId":{"type":"string","description":"Leadboxer accountId."},"type":{"type":"string","description":"Set visibility of the segment.<br/><br/><b>Possible values:</b><br/><b>USER</b> : the segment will be private to user.<br/><b>ACCOUNT</b> : the segment will be shared across the users of the account.","example":"USER","enum":["USER","ACCOUNT"]},"textFilter":{"type":"string","description":"Text-based filter expression used to filter result fields.Format: field|operator|value. Multiple filters are comma-separated."},"numberFilter":{"type":"string","description":"Numeric filter expression used to filter results based on numeric fields. Format: field|operator|value. Multiple filters are comma-separated. Supported numeric operators include greaterthan, lessthan, is, isnot, between, and notbetween. The between and notbetween operators use the format min-max."},"timeFilter":{"type":"string","description":"Time-based filter expression used to filter results by time field. Format: field|operator|value.\n\nAllowed fields (same as `timeField` parameter):\n- eventEsTimestamp : Last Seen\n- first_session_unix_timestamp : First Seen\n\nSupported operators:\n- exactly   → integer value (0 = Today, 1 = Yesterday)\n- lessthan  → integer value (e.g. 6 = last 7 days)\n- between   → date range in format dd/MM/yyyy-dd/MM/yyyy\n\nLocale settings are taken into account while interpreting dates and returning results."},"fieldFilter":{"type":"string","description":"Field-based filter used to include leads based on field presence.\n\nFormat:\noperator|field1;field2\n\nAllowed operator:\n- hasanyvalue\n\nAllowed fields:\n- firstName\n- lastName\n- email\n\nMultiple fields can be provided using semicolons."},"exitLinkFilter":{"type":"string","description":"Exit link filter used to include or exclude leads based on exit link values.\n\nFormat:\nfield|operator|value\n\nSupported operators:\n- contains\n- is\n- isnot\n- doesnotcontain\n\nMultiple values can be provided using semicolons.","example":"exitLinkFilter|contains|leads"},"leadscoreFilter":{"maximum":100,"minimum":0,"type":"integer","description":"Filters leads based on given minimum leadscore.","format":"int32"},"displayFilter":{"type":"string","description":"Display filter used to control which types of leads are returned.\n\nSupported values:\n- company\n- person\n- unidentified\n\nSelecting 'unidentified' returns leads that could not be identified as a company or a person.\n\nMultiple values can be provided using semicolons."},"fromFilter":{"type":"string","description":"Filters leads based on specified from user"},"owner":{"type":"string","description":"Filters leads based on specified owner"},"hidden":{"type":"string","description":"Filters leads based on presetInclusionList"},"search":{"type":"string","description":"Keyword search","example":"*"},"emailView":{"type":"string","description":"Email view type.<br/>Possible values : NONE, LEAD, ACCOUNT<br/>","example":"LEAD","enum":["NONE","LEAD","ACCOUNT"]},"notificationType":{"type":"string","description":"Set notification frequency.<br/><br/><b>Possible values:</b><br/><b>NONE</b> : Do not send any notification.<br/><b>DAILY</b> : Send notification daily.<br/><b>WEEKLY</b> : Send notification weekly.","example":"DAILY","enum":["NONE","DAILY","WEEKLY"]},"notificationMailIds":{"type":"string","description":"List of comma separated email addresses for notification","example":"user1@example.com,user2@example.com"},"mailTemplate":{"type":"string","description":"Set headlines for the notification email","example":"Weekly Lead Summary"},"format":{"type":"string","description":"Format for the segment notification.<br/>Possible values : html, csv","example":"html"},"dayOfWeek":{"type":"integer","description":"Day of week on which weekly notification will be sent. Possible values include numbers from 1 to 7 (where 1 refers to Monday)","format":"int32","example":1},"additionalCsvFields":{"type":"string","description":"List of comma separated fields to be included in CSV","example":"email,companyName,jobTitle"},"sortBy":{"type":"string","description":"Field to sort result.<br/>Possible values :<br/><b>_score</b> : records will be sorted as per leadscore.<br/><b>lastEvent</b> : records will be sorted as per activity time.<br/>Default : _score","example":"_score"},"sortOrder":{"type":"string","description":"Sort order.<br/>Possible values : asc, desc<br/>Default : desc","example":"desc"},"viewType":{"type":"string","description":"View type.<br/>Possible values : B2B, B2C<br/>Default : B2B","example":"B2B"},"timeField":{"type":"string"},"list":{"type":"string"},"csvSetName":{"type":"string"}}},"UpdateSegmentUserRequest":{"required":["segmentId","userId"],"type":"object","properties":{"segmentId":{"type":"integer","description":"Leadboxer Segment.","format":"int32"},"userId":{"type":"integer","description":"Leadboxer userId","format":"int64"}}},"SegmentPreferenceRequest":{"required":["datasetId","segmentId"],"type":"object","properties":{"datasetId":{"type":"string","description":"Dataset ID for which you need to assign segment as default."},"segmentId":{"type":"integer","description":"Segment ID which you want to assign as default.","format":"int32"},"users":{"type":"array","description":"List of User IDs for whom you need to assign a segment as default.","items":{"type":"integer","description":"List of User IDs for whom you need to assign a segment as default.","format":"int64"}}}},"LeadTagsUpdateRequest":{"required":["datasetId","leadId","leadTags"],"type":"object","properties":{"datasetId":{"type":"string"},"leadId":{"type":"string"},"leadTags":{"type":"string"}}},"CustomTrackingDomainRequest":