{"openapi":"3.0.1","info":{"title":"Leadboxer API","description":"# LeadBoxer API Documentation\n\nHere you can find the technical documentation needed for using the LeadBoxer API, including the option to generate requests and review the outcomes.\n\n## Getting Started\n\nTo get started, please have a look at these pages that include introductions, use-cases, and additional information for the LeadBoxer API: [LeadBoxer API Documentation](https://docs.leadboxer.com/category/112-all)\n\nThese documents are intended for LeadBoxer CUSTOMERS that have a valid API license & Key. Please contact us before using the LeadBoxer API.\n\n## Warning\n\nPlease be aware that any actions you perform through this reference testing functionality will involve operations with your production data. To test your applications against some sandbox data, we recommend creating a new, separate LeadBoxer account for sandboxing purposes.\n\nThis API is under active maintenance, and we are constantly adding new functionality to this version.\n\n[**All requests to the API must be made over SSL (https, not http).**]","termsOfService":"https://www.leadboxer.com/resources/terms","contact":{"name":"Wart Fransen","url":"wart@leadboxer.com","email":"hello@leadboxer.com"},"license":{"name":"","url":"https://www.leadboxer.com/resources/privacy"},"version":"0.0.1"},"servers":[{"url":"https://api.leadboxer.com","description":"Production Server"}],"security":[{"ApiKeyAuth":[]}],"tags":[{"name":"User Management","description":"API endpoints for managing users within an account. These operations allow you to create users, update their basic information, manage invitations, retrieve their accessible datasets, and remove users when needed."},{"name":"LeadOperation","description":"Manage your Lead."},{"name":"Lookup API","description":"APIs for IP, Domain and Email lookup operations"},{"name":"Dataset Management","description":"Manage your datasets. Add, update, delete datasets from your account, configure preferences, and manage form tracking."},{"name":"Segments","description":"Manage your segments. Add, update, delete segments for your datasets etc."},{"name":"Segment Preference","description":"Defines and manages which segment is set as default for a given combination of User ID and Dataset ID.\nA user can have multiple segments under a dataset, but only one of them can be designated as the default at any time.\nThese APIs handle creation, retrieval, and updates of that default segment."},{"name":"Leads","description":"Get your top leads with fine grained filtering criteria."},{"name":"UserDatasets","description":"Manage access to your datasets. Associate/dissociate datasets with users etc."}],"paths":{"/v1/users/{userId}/name":{"put":{"tags":["User Management"],"summary":"Update User Name","description":"Updates the display name of an existing user.","operationId":"updateName","parameters":[{"name":"userId","in":"path","description":"Unique ID of the user to be updated.","required":true,"schema":{"type":"integer","format":"int64"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateUserName"}}},"required":true},"responses":{"400":{"description":"Bad Request: The request is invalid or malformed (missing/incorrect parameters).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1BadRequestResponse"}}}},"429":{"description":"Too Many Requests: Rate limit exceeded. The client has sent too many requests in a given time period","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RateLimitErrorResponse"}}}},"403":{"description":"Forbidden: The authenticated user does not have permission to access this resource.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1PermissionDenied"}}}},"409":{"description":"Conflict: The request could not be completed due to a resource state conflict.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1ConflictResponse"}}}},"404":{"description":"Not Found: The requested resource does not exist.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1NotFoundResponse"}}}},"500":{"description":"Interval Server Error: An unexpected error occurred on the server.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1InternalServerError"}}}},"402":{"description":"Payment Required: The client has exceeded credit limits.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1InternalServerError"}}}},"204":{"description":"User Name updated successfully. No content returned."}}}},"/v1/segments/{segmentId}":{"put":{"tags":["Segments"],"summary":"Update Existing Segment","description":"Update an existing segment with the given configuration. Use this endpoint to update filter criteria, email preferences etc.","operationId":"updateSegment","parameters":[{"name":"segmentId","in":"path","description":"Segment ID","required":true,"schema":{"type":"integer","format":"int32"}},{"name":"segmentName","in":"query","description":"Segment Name","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateSegmentRequest"}}},"required":true},"responses":{"400":{"description":"Bad Request: The request is invalid or malformed (missing/incorrect parameters).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1BadRequestResponse"}}}},"429":{"description":"Too Many Requests: Rate limit exceeded. The client has sent too many requests in a given time period","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RateLimitErrorResponse"}}}},"403":{"description":"Forbidden: The authenticated user does not have permission to access this resource.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1PermissionDenied"}}}},"409":{"description":"Conflict: The request could not be completed due to a resource state conflict.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1ConflictResponse"}}}},"404":{"description":"Not Found: The requested resource does not exist.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1NotFoundResponse"}}}},"500":{"description":"Interval Server Error: An unexpected error occurred on the server.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1InternalServerError"}}}},"402":{"description":"Payment Required: The client has exceeded credit limits.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1InternalServerError"}}}},"204":{"description":"Segment updated successfully. No content returned."}}},"delete":{"tags":["Segments"],"summary":"Delete Segment","description":"To delete specified segment.","operationId":"deleteSegment","parameters":[{"name":"segmentId","in":"path","description":"Segment ID","required":true,"schema":{"type":"integer","format":"int32"}}],"responses":{"400":{"description":"Bad Request: The request is invalid or malformed (missing/incorrect parameters).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1BadRequestResponse"}}}},"429":{"description":"Too Many Requests: Rate limit exceeded. The client has sent too many requests in a given time period","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RateLimitErrorResponse"}}}},"403":{"description":"Forbidden: The authenticated user does not have permission to access this resource.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1PermissionDenied"}}}},"409":{"description":"Conflict: The request could not be completed due to a resource state conflict.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1ConflictResponse"}}}},"404":{"description":"Not Found: The requested resource does not exist.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1NotFoundResponse"}}}},"500":{"description":"Interval Server Error: An unexpected error occurred on the server.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1InternalServerError"}}}},"402":{"description":"Payment Required: The client has exceeded credit limits.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1InternalServerError"}}}},"204":{"description":"Segment deleted successfully. No content returned."}}}},"/v1/segments/user":{"put":{"tags":["Segments"],"summary":"Update Segment User","description":"Updates the user associated with the segment, which allow that user to access the segment.","operationId":"updateSegmentUser","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateSegmentUserRequest"}}},"required":true},"responses":{"400":{"description":"Bad Request: The request is invalid or malformed (missing/incorrect parameters).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1BadRequestResponse"}}}},"429":{"description":"Too Many Requests: Rate limit exceeded. The client has sent too many requests in a given time period","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RateLimitErrorResponse"}}}},"403":{"description":"Forbidden: The authenticated user does not have permission to access this resource.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1PermissionDenied"}}}},"409":{"description":"Conflict: The request could not be completed due to a resource state conflict.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1ConflictResponse"}}}},"404":{"description":"Not Found: The requested resource does not exist.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1NotFoundResponse"}}}},"500":{"description":"Interval Server Error: An unexpected error occurred on the server.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1InternalServerError"}}}},"402":{"description":"Payment Required: The client has exceeded credit limits.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1InternalServerError"}}}},"204":{"description":"Segment User updated successfully. No content returned."}}}},"/v1/segment/preference":{"get":{"tags":["Segment Preference"],"summary":"Get Default Segment Users","description":"Get the list of User IDs for whom the specified segment is set as the default under the given Dataset ID.","operationId":"getUsersBySegmentIdAndDatasetId","parameters":[{"name":"email","in":"query","description":"Email associated with the account.","required":true,"schema":{"type":"string"}},{"name":"segmentId","in":"query","description":"Segment ID for which you want to retrieve the list of users who have this segment set as default.","required":true,"schema":{"type":"integer","format":"int32"}},{"name":"datasetId","in":"query","description":"Dataset ID under which the segment’s default users should be retrieved.","required":true,"schema":{"type":"string"}}],"responses":{"400":{"description":"Bad Request: The request is invalid or malformed (missing/incorrect parameters).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1BadRequestResponse"}}}},"429":{"description":"Too Many Requests: Rate limit exceeded. The client has sent too many requests in a given time period","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RateLimitErrorResponse"}}}},"403":{"description":"Forbidden: The authenticated user does not have permission to access this resource.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1PermissionDenied"}}}},"409":{"description":"Conflict: The request could not be completed due to a resource state conflict.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1ConflictResponse"}}}},"404":{"description":"Not Found: The requested resource does not exist.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1NotFoundResponse"}}}},"500":{"description":"Interval Server Error: An unexpected error occurred on the server.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1InternalServerError"}}}},"402":{"description":"Payment Required: The client has exceeded credit limits.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1InternalServerError"}}}},"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/GetAllResponseLong"}}}}}},"put":{"tags":["Segment Preference"],"summary":"Add/Update Default Segment for Users","description":"Sets the given Segment ID as the default segment for the provided list of User IDs under the specified Dataset ID.\nUsers included in the list will have their default segment added or updated accordingly.\nAny users not included in the list will have their existing default-segment association under this dataset removed.","operationId":"saveDefaultSegment","parameters":[{"name":"email","in":"query","description":"Email associated with the account.","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SegmentPreferenceRequest"}}},"required":true},"responses":{"400":{"description":"Bad Request: The request is invalid or malformed (missing/incorrect parameters).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1BadRequestResponse"}}}},"429":{"description":"Too Many Requests: Rate limit exceeded. The client has sent too many requests in a given time period","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RateLimitErrorResponse"}}}},"403":{"description":"Forbidden: The authenticated user does not have permission to access this resource.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1PermissionDenied"}}}},"409":{"description":"Conflict: The request could not be completed due to a resource state conflict.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1ConflictResponse"}}}},"404":{"description":"Not Found: The requested resource does not exist.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1NotFoundResponse"}}}},"500":{"description":"Interval Server Error: An unexpected error occurred on the server.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1InternalServerError"}}}},"402":{"description":"Payment Required: The client has exceeded credit limits.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1InternalServerError"}}}},"204":{"description":"Segment Preference updated successfully. No content returned."}}},"delete":{"tags":["Segment Preference"],"summary":"Remove Default Segment","description":"Remove Default Segment for the user with the given Email under the given Dataset ID.","operationId":"deleteDefaultSegment","parameters":[{"name":"email","in":"query","description":"Email associated with the account. Default Segment for this user under the given dataset will be removed.","required":true,"schema":{"type":"string"}},{"name":"datasetId","in":"query","description":"Dataset ID from which default segment is to be removed.","required":true,"schema":{"type":"string"}}],"responses":{"400":{"description":"Bad Request: The request is invalid or malformed (missing/incorrect parameters).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1BadRequestResponse"}}}},"429":{"description":"Too Many Requests: Rate limit exceeded. The client has sent too many requests in a given time period","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RateLimitErrorResponse"}}}},"403":{"description":"Forbidden: The authenticated user does not have permission to access this resource.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1PermissionDenied"}}}},"409":{"description":"Conflict: The request could not be completed due to a resource state conflict.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1ConflictResponse"}}}},"404":{"description":"Not Found: The requested resource does not exist.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1NotFoundResponse"}}}},"500":{"description":"Interval Server Error: An unexpected error occurred on the server.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1InternalServerError"}}}},"402":{"description":"Payment Required: The client has exceeded credit limits.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1InternalServerError"}}}},"204":{"description":"Default Segment removed successfully. No content returned."}}}},"/v1/management/lead-tags":{"put":{"tags":["LeadOperation"],"summary":"Update Lead Tags","description":"Adds or removes lead tags for a specified lead.","operationId":"updateLeadTags","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/LeadTagsUpdateRequest"}}},"required":true},"responses":{"400":{"description":"Bad Request: The request is invalid or malformed (missing/incorrect parameters).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1BadRequestResponse"}}}},"429":{"description":"Too Many Requests: Rate limit exceeded. The client has sent too many requests in a given time period","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RateLimitErrorResponse"}}}},"403":{"description":"Forbidden: The authenticated user does not have permission to access this resource.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1PermissionDenied"}}}},"409":{"description":"Conflict: The request could not be completed due to a resource state conflict.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1ConflictResponse"}}}},"404":{"description":"Not Found: The requested resource does not exist.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1NotFoundResponse"}}}},"500":{"description":"Interval Server Error: An unexpected error occurred on the server.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1InternalServerError"}}}},"402":{"description":"Payment Required: The client has exceeded credit limits.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1InternalServerError"}}}},"204":{"description":"Tags updated successfully. No content returned."}}}},"/v1/management/ctd/update":{"put":{"tags":["Custom Tracking Domains"],"summary":"Update Custom Tracking Domain by Dataset ID","description":"Update custom tracking domain entry for the given dataset Id and ctd.","operationId":"updatedCustomTrackingDomain","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CustomTrackingDomainRequest"}}},"required":true},"responses":{"400":{"description":"Bad Request: The request is invalid or malformed (missing/incorrect parameters).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1BadRequestResponse"}}}},"429":{"description":"Too Many Requests: Rate limit exceeded. The client has sent too many requests in a given time period","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RateLimitErrorResponse"}}}},"403":{"description":"Forbidden: The authenticated user does not have permission to access this resource.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1PermissionDenied"}}}},"409":{"description":"Conflict: The request could not be completed due to a resource state conflict.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1ConflictResponse"}}}},"404":{"description":"Not Found: The requested resource does not exist.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1NotFoundResponse"}}}},"500":{"description":"Interval Server Error: An unexpected error occurred on the server.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1InternalServerError"}}}},"402":{"description":"Payment Required: The client has exceeded credit limits.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1InternalServerError"}}}},"204":{"description":"Custom Tracking Domain updated successfully, no content returned."}}}},"/v1/management/assign-leads":{"put":{"tags":["LeadOperation"],"summary":"Assign Leads","description":"Assigns lead to a user.","operationId":"assignLeads","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/LeadAssignRequest"}}},"required":true},"responses":{"400":{"description":"Bad Request: The request is invalid or malformed (missing/incorrect parameters).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1BadRequestResponse"}}}},"429":{"description":"Too Many Requests: Rate limit exceeded. The client has sent too many requests in a given time period","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RateLimitErrorResponse"}}}},"403":{"description":"Forbidden: The authenticated user does not have permission to access this resource.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1PermissionDenied"}}}},"409":{"description":"Conflict: The request could not be completed due to a resource state conflict.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1ConflictResponse"}}}},"404":{"description":"Not Found: The requested resource does not exist.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1NotFoundResponse"}}}},"500":{"description":"Interval Server Error: An unexpected error occurred on the server.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1InternalServerError"}}}},"402":{"description":"Payment Required: The client has exceeded credit limits.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1InternalServerError"}}}},"204":{"description":"Assignee created/updated successfully. No content returned."}}}},"/v1/datasets/{datasetId}/name":{"put":{"tags":["Dataset Management"],"summary":"Update Dataset Name","description":"Updates the human-readable name of the specified dataset.","operationId":"updateDatasetName","parameters":[{"name":"humanName","in":"query","required":true,"schema":{"type":"string"}},{"name":"datasetId","in":"path","required":true,"schema":{"type":"string"}},{"name":"email","in":"query","description":"Email associated with the account.","required":true,"schema":{"type":"string"}}],"responses":{"400":{"description":"Bad Request: The request is invalid or malformed (missing/incorrect parameters).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1BadRequestResponse"}}}},"429":{"description":"Too Many Requests: Rate limit exceeded. The client has sent too many requests in a given time period","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RateLimitErrorResponse"}}}},"403":{"description":"Forbidden: The authenticated user does not have permission to access this resource.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1PermissionDenied"}}}},"409":{"description":"Conflict: The request could not be completed due to a resource state conflict.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1ConflictResponse"}}}},"404":{"description":"Not Found: The requested resource does not exist.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1NotFoundResponse"}}}},"500":{"description":"Interval Server Error: An unexpected error occurred on the server.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1InternalServerError"}}}},"402":{"description":"Payment Required: The client has exceeded credit limits.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1InternalServerError"}}}},"204":{"description":"Dataset name updated successfully. No content returned."}}}},"/v1/datasets/{datasetId}/form-tracking":{"put":{"tags":["Dataset Management"],"summary":"Update Form Tracking","description":"Updates the form tracking configuration for the specified dataset, including enabling/disabling tracking, IP masking, and form input attributes.","operationId":"updateFormTracking","parameters":[{"name":"formTracking","in":"query","required":true,"schema":{"type":"boolean"}},{"name":"partialFormTracking","in":"query","required":false,"schema":{"type":"boolean","default":false}},{"name":"contactEnrichment","in":"query","required":false,"schema":{"type":"boolean","default":false}},{"name":"allowIpMasking","in":"query","required":true,"schema":{"type":"boolean"}},{"name":"formInputAttribute","in":"query","required":true,"schema":{"type":"string"}},{"name":"datasetId","in":"path","required":true,"schema":{"type":"string"}},{"name":"email","in":"query","description":"Email associated with the account.","required":true,"schema":{"type":"string"}},{"name":"x-api-key","in":"header","required":true,"schema":{"type":"string"}}],"responses":{"400":{"description":"Bad Request: The request is invalid or malformed (missing/incorrect parameters).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1BadRequestResponse"}}}},"429":{"description":"Too Many Requests: Rate limit exceeded. The client has sent too many requests in a given time period","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RateLimitErrorResponse"}}}},"403":{"description":"Forbidden: The authenticated user does not have permission to access this resource.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1PermissionDenied"}}}},"409":{"description":"Conflict: The request could not be completed due to a resource state conflict.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1ConflictResponse"}}}},"404":{"description":"Not Found: The requested resource does not exist.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1NotFoundResponse"}}}},"500":{"description":"Interval Server Error: An unexpected error occurred on the server.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1InternalServerError"}}}},"402":{"description":"Payment Required: The client has exceeded credit limits.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1InternalServerError"}}}},"204":{"description":"Form Tracking updated successfully. No content returned."}}}},"/v1/users":{"post":{"tags":["User Management"],"summary":"Create or Associate User","description":"Creates a new user or associates an existing user with an account, depending on the provided data.","operationId":"addUser","parameters":[{"name":"email","in":"query","description":"Email associated with the account.","required":true,"schema":{"type":"string"}}],"requestBody":{"description":"Payload containing datasets and other user information.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AddUser"}}},"required":true},"responses":{"400":{"description":"Bad Request: The request is invalid or malformed (missing/incorrect parameters).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1BadRequestResponse"}}}},"429":{"description":"Too Many Requests: Rate limit exceeded. The client has sent too many requests in a given time period","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RateLimitErrorResponse"}}}},"403":{"description":"Forbidden: The authenticated user does not have permission to access this resource.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1PermissionDenied"}}}},"409":{"description":"Conflict: The request could not be completed due to a resource state conflict.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1ConflictResponse"}}}},"404":{"description":"Not Found: The requested resource does not exist.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1NotFoundResponse"}}}},"500":{"description":"Interval Server Error: An unexpected error occurred on the server.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1InternalServerError"}}}},"402":{"description":"Payment Required: The client has exceeded credit limits.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1InternalServerError"}}}},"204":{"description":"User created successfully. No content returned."}}}},"/v1/user-datasets":{"get":{"tags":["UserDatasets"],"summary":"Fetch User Datasets","description":"Retrieves the datasets associated with a user for the given account. This provides details about the user's datasets under their account.","operationId":"getUserDatasets_1","parameters":[{"name":"accountId","in":"query","description":"The unique identifier for the user's account.","required":true,"schema":{"type":"string"}},{"name":"email","in":"query","description":"The email address of the user for whom datasets are being fetched.","required":true,"schema":{"type":"string"}}],"responses":{"400":{"description":"Bad Request: The request is invalid or malformed (missing/incorrect parameters).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1BadRequestResponse"}}}},"429":{"description":"Too Many Requests: Rate limit exceeded. The client has sent too many requests in a given time period","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RateLimitErrorResponse"}}}},"403":{"description":"Forbidden: The authenticated user does not have permission to access this resource.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1PermissionDenied"}}}},"409":{"description":"Conflict: The request could not be completed due to a resource state conflict.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1ConflictResponse"}}}},"404":{"description":"Not Found: The requested resource does not exist.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1NotFoundResponse"}}}},"500