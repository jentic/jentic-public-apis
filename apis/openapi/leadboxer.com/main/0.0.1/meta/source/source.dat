 client has exceeded credit limits.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1InternalServerError"}}}},"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CustomTrackingDomainValidationResponse"}}}}}}},"/v1/management/ctd/add":{"post":{"tags":["Custom Tracking Domains"],"summary":"Add Custom Tracking Domain","description":"Adds a custom tracking domain to the dataset and triggers the certificate generation process. <br/><br/><b>Note:</b> This operation may take several minutes to complete.<br/><br/>The response indicates whether the request resulted in an error, completed successfully, or requires additional DNS configuration.","operationId":"addCustomTrackingDomain","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CustomTrackingDomainRequest"}}},"required":true},"responses":{"400":{"description":"Bad Request: The request is invalid or malformed (missing/incorrect parameters).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1BadRequestResponse"}}}},"429":{"description":"Too Many Requests: Rate limit exceeded. The client has sent too many requests in a given time period","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RateLimitErrorResponse"}}}},"403":{"description":"Forbidden: The authenticated user does not have permission to access this resource.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1PermissionDenied"}}}},"409":{"description":"Conflict: The request could not be completed due to a resource state conflict.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1ConflictResponse"}}}},"404":{"description":"Not Found: The requested resource does not exist.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1NotFoundResponse"}}}},"500":{"description":"Interval Server Error: An unexpected error occurred on the server.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1InternalServerError"}}}},"402":{"description":"Payment Required: The client has exceeded credit limits.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1InternalServerError"}}}},"200":{"description":"Indicates the result of adding a custom tracking domain.<br/>Response code 0 indicates success, while response code -1 indicates failure; details are provided in the responseMessage.","content":{"application/json":{"examples":{"Success":{"description":"Success","value":{"responseCode":0,"responseMessage":"Successfully added the track.example.com as the custom tracking domain."}},"Error":{"description":"Error","value":{"responseCode":-1,"responseMessage":"Something went wrong while adding ctd."}}}}}}}}},"/v1/email-lookup":{"get":{"tags":["Lookup API"],"summary":"Email Lookup (GET)","description":"Same as POST /v1/email-lookup, with the email and the optional hints as query parameters, for consistency with the IP and domain lookups. Prefer POST where possible: with GET the email address ends up in URLs, browser history and server logs. Available on every plan. Credits are only consumed when a profile is found.","operationId":"lookupEmailByQuery","parameters":[{"name":"email","in":"query","description":"Email address of the contact to enrich","required":true,"schema":{"type":"string"},"example":"jane.doe@leadboxer.com"},{"name":"firstName","in":"query","description":"First name of the contact (optional hint)","required":false,"schema":{"type":"string"}},{"name":"lastName","in":"query","description":"Last name of the contact (optional hint)","required":false,"schema":{"type":"string"}},{"name":"companyName","in":"query","description":"Name of the company the contact works for (optional hint)","required":false,"schema":{"type":"string"}},{"name":"companyDomain","in":"query","description":"Domain of the company the contact works for (optional hint)","required":false,"schema":{"type":"string"}},{"name":"datasetId","in":"query","description":"The dataset ID to associate with the operation’s credit. If not specified, a dataset linked to the account will be selected.","required":false,"schema":{"type":"string"}}],"responses":{"400":{"description":"Bad Request: The request is invalid or malformed (missing/incorrect parameters).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1BadRequestResponse"}}}},"429":{"description":"Too Many Requests: Rate limit exceeded. The client has sent too many requests in a given time period","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RateLimitErrorResponse"}}}},"403":{"description":"Forbidden: The authenticated user does not have permission to access this resource.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1PermissionDenied"}}}},"409":{"description":"Conflict: The request could not be completed due to a resource state conflict.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1ConflictResponse"}}}},"404":{"description":"Not Found: The requested resource does not exist.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1NotFoundResponse"}}}},"500":{"description":"Interval Server Error: An unexpected error occurred on the server.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1InternalServerError"}}}},"402":{"description":"Payment Required: The client has exceeded credit limits.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1InternalServerError"}}}},"200":{"description":"Successfully retrieved contact profile","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ContactProfileDetails"}}}}}},"post":{"tags":["Lookup API"],"summary":"Email Lookup","description":"Retrieve the professional profile of a contact by email address. Only the email is required; name and company are optional hints that improve matching. Available on every plan. Credits are only consumed when a profile is found.\n\nThe same lookup is also available as GET /v1/email-lookup?email=..., but POST is recommended because it keeps the email address out of URLs and server logs.\n\nReturned Data\nWhen a match is found, the following fields are returned:\n\nContact details\n- email\n- fullName\n- headline\n- linkedinUrl\n- seniority\n- jobFunction\n- location\n\nLanguages\n- languages[].name\n- languages[].proficiency\n\nExperience\n- experience[].title\n- experience[].companyName\n- experience[].startYear\n- experience[].endYear\n- experience[].current","operationId":"lookupEmail","parameters":[{"name":"datasetId","in":"query","description":"The dataset ID to associate with the operation’s credit. If not specified, a dataset linked to the account will be selected.","required":false,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ContactEnrichmentRequest"}}},"required":true},"responses":{"400":{"description":"Bad Request: The request is invalid or malformed (missing/incorrect parameters).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1BadRequestResponse"}}}},"429":{"description":"Too Many Requests: Rate limit exceeded. The client has sent too many requests in a given time period","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RateLimitErrorResponse"}}}},"403":{"description":"Forbidden: The authenticated user does not have permission to access this resource.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1PermissionDenied"}}}},"409":{"description":"Conflict: The request could not be completed due to a resource state conflict.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1ConflictResponse"}}}},"404":{"description":"Not Found: The requested resource does not exist.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1NotFoundResponse"}}}},"500":{"description":"Interval Server Error: An unexpected error occurred on the server.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1InternalServerError"}}}},"402":{"description":"Payment Required: The client has exceeded credit limits.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1InternalServerError"}}}},"200":{"description":"Successfully retrieved contact profile","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ContactProfileDetails"},"examples":{"Success":{"description":"Success","value":{"email":"jane.doe@leadboxer.com","fullName":"Jane Doe","headline":"Head of Marketing at LeadBoxer","linkedinUrl":"https://www.linkedin.com/in/janedoe","seniority":"Senior","jobFunction":"Marketing","location":"Amsterdam, North Holland, Netherlands","languages":[{"name":"English","proficiency":"Native or bilingual proficiency"}],"experience":[{"title":"Head of Marketing","companyName":"LeadBoxer","startYear":2021,"current":true}]}}}}}}}}},"/v1/datasets":{"post":{"tags":["Dataset Management"],"summary":"Add Dataset","description":"Creates a new dataset in the account and associates it with the specified users.","operationId":"addDataset","parameters":[{"name":"email","in":"query","description":"User email.","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AddDataset"}}},"required":true},"responses":{"400":{"description":"Bad Request: The request is invalid or malformed (missing/incorrect parameters).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1BadRequestResponse"}}}},"429":{"description":"Too Many Requests: Rate limit exceeded. The client has sent too many requests in a given time period","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RateLimitErrorResponse"}}}},"403":{"description":"Forbidden: The authenticated user does not have permission to access this resource.","content":{"application/json":{"schema":{"