period","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RateLimitErrorResponse"}}}},"403":{"description":"Forbidden: The authenticated user does not have permission to access this resource.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1PermissionDenied"}}}},"409":{"description":"Conflict: The request could not be completed due to a resource state conflict.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1ConflictResponse"}}}},"404":{"description":"Not Found: The requested resource does not exist.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1NotFoundResponse"}}}},"500":{"description":"Interval Server Error: An unexpected error occurred on the server.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1InternalServerError"}}}},"402":{"description":"Payment Required: The client has exceeded credit limits.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/V1InternalServerError"}}}},"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/GetAllResponseCreditGrantDTO"}}}}}}},"/v1/leads":{"get":{"tags":["Leads"],"summary":"Retrieve Leads","description":"Returns a list of leads in JSON format based on the provided filters and query parameters.","operationId":"users","parameters":[{"name":"site","in":"query","description":"The Dataset ID","required":true,"schema":{"type":"string"}},{"name":"search","in":"query","description":"Keyword or phrase to search across all searchable fields. Search is case-insensitive for text fields. Defaults to '*' to match all results.","required":false,"schema":{"type":"string","default":"*"}},{"name":"limit","in":"query","description":"No of rows to return in response.","required":false,"schema":{"type":"integer","format":"int32","default":50}},{"name":"locale","in":"query","description":"Locale for formatting the 'prettyLastEvent' field in response. Determines the language and regional formatting (e.g., dates, text) returned by the API.","required":false,"schema":{"type":"string","default":"en_US"},"example":"en_US"},{"name":"nextToken","in":"query","description":"Token returned after each request, used to fetch the next page of results. Each token is valid for 10 minutes.","required":false,"schema":{"type":"string"}},{"name":"criteriaTextFilter","in":"query","description":"Text-based filter expression used to filter result fields.Format: field|operator|value. Multiple filters are comma-separated.","required":false,"schema":{"type":"string"},"examples":{"Does not contain – organization name":{"description":"Does not contain – organization name","value":"organizationName.raw|doesnotcontain|Cirrus"},"Employee range with tag exclusion":{"description":"Employee range with tag exclusion","value":"organizationEmployeeCountRangeName.raw|is|51-200;201-500,lead_tags.raw|isnot|customer;competitor"},"Industry contains":{"description":"Industry contains","value":"organizationIndustryName.raw|contains|Computer Software"},"Is – single country":{"description":"Is – single country","value":"organizationCountry.raw|is|Denmark"},"URL exact match":{"description":"URL exact match","value":"original_url.raw|is|http://www.justpayy.com"},"Multiple filters combined":{"description":"Multiple filters combined","value":"organizationName.raw|contains|scuba equipment,last_country_name.raw|inregion|APAC,organizationIndustryName.raw|is|water sports"},"Complex real example":{"description":"Complex real example","value":"organizationName.raw|is|google trends boutech,last_country_name.raw|is|Philippines"},"In region":{"description":"In region","value":"last_country_name.raw|inregion|APAC"},"Is – multiple countries":{"description":"Is – multiple countries","value":"organizationCountry.raw|is|Sweden;Norway;Denmark"},"Contains – URL path":{"description":"Contains – URL path","value":"original_url.raw|contains|/solutions/clinicalkey"},"Contains – organization name":{"description":"Contains – organization name","value":"organizationName.raw|contains|bank"},"In category":{"description":"In category","value":"organizationIndustryName.raw|incategory|Construction"}}},{"name":"criteriaNumberFilter","in":"query","description":"Numeric filter expression used to filter results based on numeric fields. Format: field|operator|value. Multiple filters are comma-separated. Supported numeric operators include greaterthan, lessthan, is, isnot, between, and notbetween. The between and notbetween operators use the format min-max.","required":false,"schema":{"type":"string"},"examples":{"Between range":{"description":"Between range","value":"user.total_pages_viewed|between|10-50"},"Less than":{"description":"Less than","value":"user.total_number_visits|lessthan|50"},"Combined exclusion and range":{"description":"Combined exclusion and range","value":"user.total_number_visits|isnot|21,user.total_pages_viewed|between|10-100"},"Greater than":{"description":"Greater than","value":"user.total_number_visits|greaterthan|12"},"Not between range":{"description":"Not between range","value":"user.total_pages_viewed|notbetween|5-20"},"Multiple numeric filters":{"description":"Multiple numeric filters","value":"user.total_number_visits|greaterthan|12,user.total_pages_viewed|greaterthan|10"},"Not equal":{"description":"Not equal","value":"user.total_number_visits|isnot|21"},"Exact match":{"description":"Exact match","value":"user.total_number_visits|is|12"}}},{"name":"criteriaTimeFilter","in":"query","description":"Time-based filter expression used to filter results by time field. Format: field|operator|value.\n\nAllowed fields (same as `timeField` parameter):\n- eventEsTimestamp : Last Seen\n- first_session_unix_timestamp : First Seen\n\nSupported operators:\n- exactly   → integer value (0 = Today, 1 = Yesterday)\n- lessthan  → integer value (e.g. 6 = last 7 days)\n- between   → date range in format dd/MM/yyyy-dd/MM/yyyy\n\nLocale settings are taken into account while interpreting dates and returning results.","required":true,"schema":{"type":"string"},"examples":{"Today":{"description":"Today","value":"eventEsTimestamp|exactly|0"},"Last 30 days":{"description":"Last 30 days","value":"eventEsTimestamp|lessthan|29"},"Yesterday":{"description":"Yesterday","value":"eventEsTimestamp|exactly|1"},"Last 7 days":{"description":"Last 7 days","value":"eventEsTimestamp|lessthan|6"},"Custom date range":{"description":"Custom date range","value":"eventEsTimestamp|between|04/11/2025-10/12/2025"}}},{"name":"criteriaFieldFilter","in":"query","description":"Field-based filter used to include leads based on field presence.\n\nFormat:\noperator|field1;field2\n\nAllowed operator:\n- hasanyvalue\n\nAllowed fields:\n- firstName\n- lastName\n- email\n\nMultiple fields can be provided using semicolons.","required":false,"schema":{"type":"string"},"examples":{"Has any value (email)":{"description":"Has any value (email)","value":"hasanyvalue|email"},"Has any value (first or last name)":{"description":"Has any value (first or last name)","value":"hasanyvalue|firstName;lastName"}}},{"name":"criteriaExitLinkFilter","in":"query","description":"Exit link filter used to include or exclude leads based on exit link values.\n\nFormat:\nfield|operator|value\n\nSupported operators:\n- contains\n- is\n- isnot\n- doesnotcontain\n\nMultiple values can be provided using semicolons.","required":false,"schema":{"type":"string"},"examples":{"Contains exit link":{"description":"Contains exit link","value":"exitLinkFilter|contains|leads"}}},{"name":"criteriaLeadscoreFilter","in":"query","description":"Minimum lead score threshold (optional). Only records with lead scores greater than the provided number (0–100) are returned.","required":false,"schema":{"maximum":100,"minimum":0,"type":"integer","format":"int32"}},{"name":"criteriaDisplayFilter","in":"query","description":"Display filter used to control which types of leads are returned.\n\nSupported values:\n- company\n- person\n- unidentified\n\nSelecting 'unidentified' returns leads that could not be identified as a company or a person.\n\nMultiple values can be provided using semicolons.","required":false,"schema":{"type":"string"},"examples":{"Person leads only":{"description":"Person leads only","value":"person"},"Company and unidentified leads":{"description":"Company and unidentified leads","value":"company;unidentified"},"All lead types":{"description":"All lead types","value":"company;person;unidentified"},"Company leads only":{"description":"Company leads only","value":"company"},"Unidentified leads":{"description":"Unidentified leads","value":"unidentified"}}},{"name":"timeField","in":"query","description":"Time field used for filtering.\n\nAllowed values:\n- eventEsTimestamp : Last Seen\n- first_session_unix_timestamp : First Seen","required":true,"schema":{"type":"string","default":"eventEsTimestamp","enum":["eventEsTimestamp","first_session_unix_timestamp"]}},{"name":"usePresetExclusionList","in":"query","description":"Use a preset exclusion list of criteria to exclude from result.","required":false,"schema":{"type":"string","enum":["use_id","last_most_likely_company","organizationName","organizationDomain"]},"examples":{"Exclude by use_id":{"description":"Exclude by use_id","value":"use_id"},"Exclude by multiple types":{"description":"Exclude by multiple types","value":"use_id,last_most_likely_company,organizationName,organizationDomain"}}},{"name":"userId","in":"query","required":false,"schema":{"type":"integer","format":"int64"}},{"name":"timeZone","in":"query","description":"Time zone used when parsing timestamps and evaluating time-based filters. \nIf not provided, the default time zone is Europe/Amsterdam.","required":false,"schema":{"type":"string","default":"Europe/Amsterdam"},"example":"Europe/Amsterdam"},{"name":"sortBy","in":"query","description":"Sort results by a specific field and direction.\n\nFormat:\nfield|direction\n\nAllowed fields:\n- lastEvent\n- _s