{
  "openapi": "3.0.3",
  "info": {
    "title": "SustainMetrics Emission Factor API",
    "version": "1.0.0",
    "description": "18,000+ GHG emission factors from UK DEFRA, US EPA, ADEME Base Carbone (France) and Ember (193-country grid intensity), normalized behind one endpoint and one auth scheme. The underlying data is public (Open Government Licence / US public domain / Licence Ouverte v2.0 — see /methodology) — what this API adds is a single schema across four sources, category/scope/search filtering, and uptime. Free tier: 50 requests/day, no credit card.",
    "contact": { "email": "principlesofmik@gmail.com", "url": "https://www.sustainmetrics.net/docs" },
    "license": { "name": "Data licensing varies by source — see /methodology", "url": "https://www.sustainmetrics.net/methodology" }
  },
  "servers": [
    { "url": "https://www.sustainmetrics.net/api/v1", "description": "Production" }
  ],
  "security": [{ "apiKey": [] }],
  "tags": [{ "name": "factors", "description": "Emission factor lookup" }],
  "paths": {
    "/factors": {
      "get": {
        "operationId": "getFactors",
        "tags": ["factors"],
        "summary": "Query emission factors",
        "description": "Search and filter emission factors across DEFRA, EPA, ADEME and Ember. Pass source=list to get the catalogue of available sources and years instead of factor rows.",
        "parameters": [
          {
            "name": "source", "in": "query", "required": true,
            "schema": { "type": "string", "enum": ["defra", "epa", "ademe", "ember", "list"] },
            "description": "Data source, or \"list\" to enumerate available sources/years."
          },
          {
            "name": "year", "in": "query",
            "schema": { "type": "integer", "default": 2025 },
            "description": "Publication year. Availability depends on source: DEFRA 2023-2026, EPA 2023-2025, ADEME 2024 only, Ember 2025 only."
          },
          {
            "name": "scope", "in": "query",
            "schema": { "type": "string" },
            "description": "GHG Protocol scope filter, e.g. \"1\" or \"1,2\" (comma-separated). Matches \"Scope 1\", \"1\", etc."
          },
          {
            "name": "category", "in": "query",
            "schema": { "type": "string" },
            "description": "Free-text match against the factor's category hierarchy (levels.level_1..level_4) and activity name, e.g. \"fuels\", \"electricity\", \"waste\"."
          },
          {
            "name": "search", "in": "query",
            "schema": { "type": "string" },
            "description": "Free-text search across the entire factor record, e.g. \"natural gas\", \"aviation\"."
          },
          {
            "name": "limit", "in": "query",
            "schema": { "type": "integer", "default": 100, "maximum": 500 },
            "description": "Rows to return. Capped at 500 regardless of the value passed."
          },
          {
            "name": "offset", "in": "query",
            "schema": { "type": "integer", "default": 0 },
            "description": "Pagination offset."
          }
        ],
        "responses": {
          "200": {
            "description": "Matching factors, or the source/year catalogue when source=list.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FactorResponse" },
                "examples": {
                  "defraFuels": {
                    "summary": "DEFRA 2026, category=fuels",
                    "value": {
                      "source": "defra", "year": 2026, "total": 242, "count": 1, "offset": 0, "limit": 1,
                      "usage": { "calls_today": 3, "daily_limit": 50, "plan": "free" },
                      "data": [
                        {
                          "source": "UK DEFRA", "year": 2026, "id": "1_100_1000_15_1", "scope": "Scope 1",
                          "activity": "Fuels - Gaseous fuels - Butane",
                          "levels": { "level_1": "Fuels", "level_2": "Gaseous fuels", "level_3": "Butane", "level_4": null, "level_5": null },
                          "unit": "tonnes",
                          "factors": { "co2e": 3033.38067, "co2": 3029.26, "ch4": 2.52, "n2o": 1.60067 }
                        }
                      ]
                    }
                  },
                  "emberElectricity": {
                    "summary": "Ember 2025, single country grid intensity",
                    "value": {
                      "source": "ember", "year": 2025, "total": 1, "count": 1, "offset": 0, "limit": 1,
                      "usage": { "calls_today": 4, "daily_limit": 50, "plan": "free" },
                      "data": [
                        {
                          "activity": "Electricity: Afghanistan", "scope": "Scope 2", "source": "Ember", "year": 2024, "unit": "kWh",
                          "levels": { "level_1": "Electricity", "level_2": "Afghanistan", "level_3": "", "level_4": "" },
                          "factors": { "co2e": 0.13131, "co2": 0.13131 },
                          "meta": { "iso": "AFG", "continent": "Asia", "gco2_per_kwh": 131.31, "data_year": 2024 }
                        }
                      ]
                    }
                  },
                  "listSources": {
                    "summary": "source=list",
                    "value": {
                      "sources": {
                        "defra": { "years": [2023, 2024, 2025, 2026], "description": "UK DEFRA GHG Conversion Factors" },
                        "epa": { "years": [2023, 2024, 2025], "description": "US EPA GHG Emission Factors Hub" },
                        "ademe": { "years": [2024], "description": "ADEME Base Carbone (France)" },
                        "ember": { "years": [2025], "description": "Ember Global Electricity Grid Intensity (193 countries)" }
                      },
                      "usage": { "calls_today": 1, "limit": 50, "plan": "free" }
                    }
                  }
                }
              }
            }
          },
          "400": { "description": "Invalid or missing source.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": {
            "description": "Missing or invalid API key.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" },
              "example": { "error": "Missing API key", "hint": "Add X-API-Key header. Get your key at https://www.sustainmetrics.net/pricing" } } }
          },
          "404": { "description": "No data for the requested source/year combination.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "429": {
            "description": "Daily rate limit exceeded for your plan.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" },
              "example": { "error": "Rate limit exceeded", "limit": 50, "plan": "free", "resets_at": "midnight UTC", "upgrade": "https://www.sustainmetrics.net/pricing" } } }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey", "name": "X-API-Key", "in": "header",
        "description": "Free key from https://www.sustainmetrics.net/pricing — sm_ prefixed. 50 req/day on the free plan, 1,000/day Pro, 100,000/day Business."
      }
    },
    "schemas": {
      "FactorResponse": {
        "type": "object",
        "properties": {
          "source": { "type": "string" },
          "year": { "type": "integer" },
          "total": { "type": "integer", "description": "Total rows matching the filter, before pagination." },
          "count": { "type": "integer", "description": "Rows in this response." },
          "offset": { "type": "integer" },
          "limit": { "type": "integer" },
          "usage": {
            "type": "object",
            "properties": {
              "calls_today": { "type": "integer" },
              "daily_limit": { "type": "integer" },
              "plan": { "type": "string", "enum": ["free", "pro", "business"] }
            }
          },
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/EmissionFactor" } }
        }
      },
      "EmissionFactor": {
        "type": "object",
        "description": "The factors and unit fields differ by source — DEFRA/ADEME/Ember use a flat {co2e, co2, ch4, n2o} object, EPA uses per-fuel-property fields (heat_content, co2_factor_mmbtu, etc). levels.level_1..level_4 form the category hierarchy used by the category filter. Full per-source field reference: /methodology.",
        "properties": {
          "source": { "type": "string" },
          "year": { "type": "integer" },
          "scope": { "type": "string", "example": "Scope 1" },
          "activity": { "type": "string" },
          "levels": {
            "type": "object",
            "properties": {
              "level_1": { "type": "string" },
              "level_2": { "type": ["string", "null"] },
              "level_3": { "type": ["string", "null"] },
              "level_4": { "type": ["string", "null"] }
            }
          },
          "unit": { "description": "String for most sources; an object of per-property units for EPA." },
          "factors": { "type": "object", "description": "Numeric coefficients — shape depends on source, see description above." }
        },
        "additionalProperties": true
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": { "type": "string" },
          "hint": { "type": "string" },
          "detail": { "type": "string" }
        }
      }
    }
  }
}
