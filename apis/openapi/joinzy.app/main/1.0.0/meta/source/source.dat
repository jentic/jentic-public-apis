          "404": {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/responses.yaml#/NotFound"
          }
        }
      }
    },
    "/chats/{chatId}/messages": {
      "get": {
        "operationId": "getChatMessages",
        "summary": "Get chat messages",
        "description": "Returns chat messages with pagination and filtering by afterMessageId.",
        "parameters": [
          {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/parameters.yaml#/chatId"
          },
          {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/parameters.yaml#/afterMessageId"
          },
          {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/parameters.yaml#/limit"
          }
        ],
        "responses": {
          "200": {
            "description": "Chat messages",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/models/PaginatedMessages.yaml#/PaginatedMessages"
                },
                "examples": {
                  "chatPollingResponse": {
                    "value": {
                      "items": [
                        {
                          "id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                          "chatId": "1c6b147e-3f3a-4a1a-9f3a-2a3b4c5d6e7f",
                          "senderId": "2a7b158f-4e3b-4f2a-9b4a-3d5c6e7f8g9h",
                          "content": "Hello!",
                          "sentAt": "2024-06-01T12:00:00Z"
                        }
                      ],
                      "meta": {
                        "nextCursor": "eyJpZCI6IjM0NTY3OGZiZjY0In0="
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/responses.yaml#/Unauthorized"
          },
          "403": {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/responses.yaml#/Forbidden"
          },
          "404": {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/responses.yaml#/NotFound"
          }
        }
      },
      "post": {
        "operationId": "sendChatMessage",
        "summary": "Send a message to the chat",
        "description": "Sends a message to the chat.",
