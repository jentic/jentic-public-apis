                    "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/models/Chat.yaml#/Chat"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/responses.yaml#/Unauthorized"
          }
        }
      }
    },
    "/chats/{chatId}": {
      "get": {
        "operationId": "getChatById",
