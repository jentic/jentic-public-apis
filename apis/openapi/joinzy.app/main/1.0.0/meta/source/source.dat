    "/devices/push-token": {
      "post": {
        "operationId": "addPushToken",
        "summary": "Add device push token",
        "description": "Registers a device push token for notifications.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string"
                  },
                  "platform": {
                    "type": "string",
                    "enum": [
                      "ios",
                      "android"
                    ]
                  }
                },
                "required": [
                  "token",
                  "platform"
                ]
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Token added"
          },
          "400": {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/responses.yaml#/BadRequest"
          },
          "401": {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/responses.yaml#/Unauthorized"
          }
        }
      },
      "delete": {
        "operationId": "deletePushToken",
        "summary": "Delete device push token",
        "description": "Deletes a device push token by its token value.",
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": true,
            "description": "Device push token",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Token deleted"
          },
          "400": {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/responses.yaml#/BadRequest"
          },
          "401": {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/responses.yaml#/Unauthorized"
          }
        }
      }
    },
    "/media/upload": {
      "post": {
        "operationId": "uploadMedia",
        "summary": "Upload media file",
        "description": "Uploads a file with a specified destination (post, chat, event, club).",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  },
                  "purpose": {
                    "type": "string",
                    "enum": [
                      "post",
                      "chat",
                      "event",
                      "club"
                    ]
                  }
                },
                "required": [
                  "file",
                  "purpose"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "File uploaded",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string",
                      "format": "uri"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/responses.yaml#/BadRequest"
          },
          "401": {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/responses.yaml#/Unauthorized"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}