{
  "openapi": "3.0.3",
  "info": {
    "title": "Joinzy MVP API",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/deustech20/joinzy-mvp-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.joinzy.app/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/auth/email/request-otp": {
      "post": {
        "security": [],
        "operationId": "requestEmailOtp",
        "summary": "Request OTP by email",
        "description": "Sends a one-time password (OTP) to the specified email for authentication.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  }
                },
                "required": [
                  "email"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OTP sent successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  },
                  "example": {
                    "message": "OTP sent to the specified email"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/responses.yaml#/BadRequest"
          },
          "429": {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/responses.yaml#/TooManyRequests"
          }
        }
      }
    },
    "/auth/email/verify-otp": {
      "post": {
        "security": [],
        "operationId": "verifyEmailOtp",
        "summary": "Verify OTP by email",
        "description": "Verifies the one-time password (OTP) and returns a JWT token on successful authentication.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "otp": {
                    "type": "string",
                    "example": "123456"
                  }
                },
                "required": [
                  "email",
                  "otp"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authentication successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accessToken": {
                      "type": "string"
                    },
                    "refreshToken": {
                      "type": "string"
                    }
                  }
                },
                "examples": {
                  "authTokens": {
                    "value": {
                      "accessToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
                      "refreshToken": "dGhpcyBpcyBhIHJlZnJlc2ggdG9rZW4="
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/responses.yaml#/BadRequest"
          },
          "401": {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/responses.yaml#/Unauthorized"
          }
        }
      }
    },
    "/auth/password/login": {
      "post": {
        "security": [],
        "operationId": "loginWithPassword",
        "summary": "Log in with password",
        "description": "Authenticates a user with email and password.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string"
                  }
                },
                "required": [
                  "email",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accessToken": {
                      "type": "string"
                    },
                    "refreshToken": {
                      "type": "string"
                    }
                  }
                },
                "examples": {
                  "passwordLogin": {
                    "value": {
                      "accessToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
                      "refreshToken": "dGhpcyBpcyBhIHJlZnJlc2ggdG9rZW4="
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/responses.yaml#/BadRequest"
          },
          "401": {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/responses.yaml#/Unauthorized"
          }
        }
      }
    },
    "/auth/token/refresh": {
      "post": {
        "security": [],
        "operationId": "refreshToken",
        "summary": "Refresh token",
        "description": "Refreshes the JWT access token using a refresh token.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "refreshToken": {
                    "type": "string"
                  }
                },
                "required": [
                  "refreshToken"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token refreshed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accessToken": {
                      "type": "string"
                    },
                    "refreshToken": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/responses.yaml#/BadRequest"
          },
          "401": {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/responses.yaml#/Unauthorized"
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "operationId": "getCurrentUser",
        "summary": "Get current user",
        "description": "Returns information about the currently authenticated user.",
        "responses": {
          "200": {
            "description": "User information",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/models/User.yaml#/User"
                }
              }
            }
          },
          "401": {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/responses.yaml#/Unauthorized"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logoutUser",
        "summary": "Log out",
        "description": "Ends the user's session and invalidates their tokens.",
        "responses": {
          "204": {
            "description": "Logout successful"
          },
          "401": {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/responses.yaml#/Unauthorized"
          }
        }
      }
    },
    "/events": {
      "get": {
        "operationId": "getEvents",
        "summary": "Get list of events",
        "description": "Returns a list of events with filters and pagination.",
        "parameters": [
          {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/parameters.yaml#/q"
          },
          {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/parameters.yaml#/city"
          },
          {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/parameters.yaml#/categoryId"
          },
          {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/parameters.yaml#/startFrom"
          },
          {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/parameters.yaml#/startTo"
          },
          {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/parameters.yaml#/priceMin"
          },
          {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/parameters.yaml#/priceMax"
          },
          {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/parameters.yaml#/isFree"
          },
          {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/parameters.yaml#/language"
          },
          {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/parameters.yaml#/sort"
          },
          {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/parameters.yaml#/limit"
          },
          {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/parameters.yaml#/cursor"
          }
        ],
        "responses": {
          "200": {
            "description": "List of events",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/models/PaginatedEvents.yaml#/PaginatedEvents"
                },
                "examples": {
                  "listEvents": {
                    "value": {
                      "items": [
                        {
                          "id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                          "title": "Classical music concert",
                          "city": "Moscow",
                          "startAt": "2024-07-01T19:00:00Z",
                          "price": 1500.0,
                          "isFree": false,
                          "language": "ru"
                        }
                      ],
                      "meta": {
                        "nextCursor": "eyJpZCI6IjNmYTg1ZjY0In0=",
                        "total": 123
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/responses.yaml#/BadRequest"
          },
          "401": {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/responses.yaml#/Unauthorized"
          }
        }
      },
      "post": {
        "operationId": "createEvent",
        "summary": "Create event",
        "description": "Creates a new event (organizers only).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/models/Event.yaml#/Event"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Event created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/models/Event.yaml#/Event"
                }
              }
            }
          },
          "400": {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/responses.yaml#/BadRequest"
          },
          "401": {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/responses.yaml#/Unauthorized"
          },
          "403": {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/responses.yaml#/Forbidden"
          }
        }
      }
    },
    "/events/{eventId}": {
      "get": {
        "operationId": "getEventById",
        "summary": "Get event by ID",
        "description": "Returns event information by UUID.",
        "parameters": [
          {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/parameters.yaml#/eventId"
          }
        ],
        "responses": {
          "200": {
            "description": "Event information",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/models/Event.yaml#/Event"
                }
              }
            }
          },
          "401": {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/responses.yaml#/Unauthorized"
          },
          "404": {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/responses.yaml#/NotFound"
          }
        }
      },
      "patch": {
        "operationId": "updateEvent",
        "summary": "Update event",
        "description": "Updates event data (organizers only).",
        "parameters": [
          {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/parameters.yaml#/eventId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/models/Event.yaml#/Event"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Event updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/models/Event.yaml#/Event"
                }
              }
            }
          },
          "400": {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/responses.yaml#/BadRequest"
          },
          "401": {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/responses.yaml#/Unauthorized"
          },
          "403": {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/responses.yaml#/Forbidden"
          },
          "404": {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/responses.yaml#/NotFound"
          }
        }
      }
    },
    "/events/{eventId}/publish": {
      "post": {
        "operationId": "publishEvent",
        "summary": "Publish event",
        "description": "Publishes an event, making it visible to users (organizers only).",
        "parameters": [
          {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/parameters.yaml#/eventId"
          }
        ],
        "responses": {
          "204": {
            "description": "Event published"
          },
          "401": {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/responses.yaml#/Unauthorized"
          },
          "403": {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/responses.yaml#/Forbidden"
          },
          "404": {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/responses.yaml#/NotFound"
          }
        }
      }
    },
    "/events/{eventId}/cancel": {
      "post": {
        "operationId": "cancelEvent",
        "summary": "Cancel event",
        "description": "Cancels an event (organizers only). Cancelling an event grants a 100% refund.",
        "parameters": [
          {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/parameters.yaml#/eventId"
          }
        ],
        "responses": {
          "204": {
            "description": "Event cancelled"
          },
          "401": {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/responses.yaml#/Unauthorized"
          },
          "403": {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/responses.yaml#/Forbidden"
          },
          "404": {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/responses.yaml#/NotFound"
          }
        }
      }
    },
    "/events/{eventId}/attendees": {
      "get": {
        "operationId": "getEventAttendees",
        "summary": "Get event attendees list",
        "description": "Returns the event's list of attendees with pagination.",
        "parameters": [
          {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/parameters.yaml#/eventId"
          },
          {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/parameters.yaml#/limit"
          },
          {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/parameters.yaml#/cursor"
          }
        ],
        "responses": {
          "200": {
            "description": "List of attendees",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/models/PaginatedUsers.yaml#/PaginatedUsers"
                }
              }
            }
          },
          "401": {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/responses.yaml#/Unauthorized"
          },
          "404": {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/responses.yaml#/NotFound"
          }
        }
      }
    },
    "/events/{eventId}/attendees/{ticketId}/check-in": {
      "post": {
        "operationId": "checkInAttendee",
        "summary": "Check in an attendee at the event",
        "description": "Checks in an attendee with the given ticketId at the event (organizers only).",
        "parameters": [
          {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/parameters.yaml#/eventId"
          },
          {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/parameters.yaml#/ticketId"
          }
        ],
        "responses": {
          "204": {
            "description": "Attendee checked in"
          },
          "401": {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/responses.yaml#/Unauthorized"
          },
          "403": {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/responses.yaml#/Forbidden"
          },
          "404": {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/responses.yaml#/NotFound"
          }
        }
      }
    },
    "/orders": {
      "get": {
        "operationId": "getOrders",
        "summary": "Get list of orders",
        "description": "Returns the user's list of orders with pagination.",
        "parameters": [
          {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/parameters.yaml#/limit"
          },
          {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/parameters.yaml#/cursor"
          }
        ],
        "responses": {
          "200": {
            "description": "List of orders",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/models/PaginatedOrders.yaml#/PaginatedOrders"
                }
              }
            }
          },
          "401": {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/responses.yaml#/Unauthorized"
          }
        }
      },
      "post": {
        "operationId": "createOrder",
        "summary": "Create order",
        "description": "Creates a ticket order. An Idempotency-Key header is required.",
        "parameters": [
          {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/parameters.yaml#/idempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/models/Order.yaml#/Order"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Order created, initializing payment",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "order": {
                      "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/models/Order.yaml#/Order"
                    },
                    "paymentUrl": {
                      "type": "string",
                      "format": "uri"
                    }
                  }
                },
                "example": {
                  "order": {
                    "id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                    "status": "pending",
                    "totalAmount": 2500.0
                  },
                  "paymentUrl": "https://yookassa.ru/pay/123456"
                }
              }
            }
          },
          "400": {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/responses.yaml#/BadRequest"
          },
          "401": {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/responses.yaml#/Unauthorized"
          },
          "409": {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/responses.yaml#/Conflict"
          }
        }
      }
    },
    "/orders/guest": {
      "post": {
        "security": [],
        "operationId": "createGuestOrder",
        "summary": "Create guest order",
        "description": "Creates a guest ticket order. An Idempotency-Key header is required.",
        "parameters": [
          {
            "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/shared/parameters.yaml#/idempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/models/Order.yaml#/Order"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Guest order created, initializing payment",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "order": {
                      "$ref": "https://raw.githubusercontent.com/Rakzar777/api-specifications/main/joinzy/v1/models/Order.yaml#/Order"
                    },
                    "paymentUrl": {
                      "type": "string",
                      "format": "uri"
                    }
                  }
                },
                "example": {
                  "order": {
