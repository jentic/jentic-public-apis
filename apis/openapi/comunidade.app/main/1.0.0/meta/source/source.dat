    "/match/find": {
      "post": {
        "summary": "Executar algoritmo de match",
        "tags": [
          "match"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "selections"
                ],
                "properties": {
                  "selections": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/UserSelection"
                    },
                    "description": "Deve conter pelo menos:\n- 1 objective (obrigatorio)\n- 1+ communication tags (obrigatorio)\n- 1+ connection_type (obrigatorio)\n- beneficiaries (opcional)\n"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resultados do match",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MatchResults"
                }
              }
            }
          },
          "400": {
            "description": "Selecoes incompletas"
          }
        }
      }
    },
