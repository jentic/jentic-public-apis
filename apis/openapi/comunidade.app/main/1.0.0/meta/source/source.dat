{
  "openapi": "3.0.3",
  "info": {
    "title": "Comunidade API",
    "description": "API para plataforma de conexao entre OSCs e Empresas",
    "version": "1.0.0",
    "contact": {
      "name": "Bora Hub",
      "email": "api@borahub.com.br"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/VINICIUSNUNES137_1/comunidade-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.comunidade.app/v1",
      "description": "Producao"
    }
  ],
  "tags": [
    {
      "name": "auth",
      "description": "Autenticacao e Autorizacao"
    },
    {
      "name": "users",
      "description": "Gestao de Usuarios"
    },
    {
      "name": "organizations",
      "description": "Gestao de Organizacoes"
    },
    {
      "name": "invites",
      "description": "Sistema de Convites"
    },
    {
      "name": "posts",
      "description": "Feed da Comunidade"
    },
    {
      "name": "projects",
      "description": "Gestao de Projetos"
    },
    {
      "name": "events",
      "description": "Gestao de Eventos"
    },
    {
      "name": "chats",
      "description": "Sistema de Chat"
    },
    {
      "name": "match",
      "description": "Algoritmo de Conexoes"
    },
    {
      "name": "tags",
      "description": "Governanca de Tags"
    },
    {
      "name": "moderation",
      "description": "Moderacao de Conteudo"
    },
    {
      "name": "policies",
      "description": "Politicas da Comunidade"
    },
    {
      "name": "feed-tabs",
      "description": "Gestao de Abas do Feed"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token JWT obtido apos login"
      }
    },
    "schemas": {
      "UserRole": {
        "type": "string",
        "enum": [
          "ADMIN_COMUNIDADE",
          "MEMBRO"
        ]
      },
      "UserStatus": {
        "type": "string",
        "enum": [
          "active",
          "disabled",
          "pending_activation"
        ]
      },
      "ActivityStatus": {
        "type": "string",
        "enum": [
          "online",
          "away",
          "offline"
        ]
      },
      "ContactMode": {
        "type": "string",
        "enum": [
          "email_externo",
          "chat_interno"
        ]
      },
      "SocialLinks": {
        "type": "object",
        "properties": {
          "linkedin": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "instagram": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "twitter": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "website": {
            "type": "string",
            "format": "uri",
            "nullable": true
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "user-123"
          },
          "role": {
            "$ref": "#/components/schemas/UserRole"
          },
          "full_name": {
            "type": "string",
            "maxLength": 100,
            "example": "Rafael Costa"
          },
          "photo": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "banner_image": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "organization_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "mini_bio": {
            "type": "string",
            "maxLength": 500,
            "example": "Coordenador de projetos sociais"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "Educacao",
              "Mentoria",
              "Parcerias"
            ]
          },
          "contact_mode": {
            "$ref": "#/components/schemas/ContactMode"
          },
          "contact_value": {
            "type": "string",
            "nullable": true
          },
          "city_region": {
            "type": "string",
            "example": "Sao Paulo, SP"
          },
          "social_links": {
            "$ref": "#/components/schemas/SocialLinks"
          },
          "linkedin_url": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "website_url": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "availability_text": {
            "type": "string",
            "maxLength": 200,
            "nullable": true
          },
          "status": {
            "$ref": "#/components/schemas/UserStatus"
          },
          "activity_status": {
            "$ref": "#/components/schemas/ActivityStatus"
          },
          "last_active_at": {
            "type": "string",
            "format": "date-time"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "last_login_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "OrganizationType": {
        "type": "string",
        "enum": [
          "Empresa",
          "OSC"
        ]
      },
      "OrganizationCategory": {
        "type": "string",
        "enum": [
          "ONG",
          "Empresa",
          "Instituto",
          "Coletivo",
          "Governo",
          "Fundacao",
          "OSC"
        ]
      },
      "BrazilState": {
        "type": "string",
        "enum": [
          "AC",
          "AL",
          "AP",
          "AM",
          "BA",
          "CE",
          "DF",
          "ES",
          "GO",
          "MA",
          "MT",
          "MS",
          "MG",
          "PA",
          "PB",
          "PR",
          "PE",
          "PI",
          "RJ",
          "RN",
          "RS",
          "RO",
          "RR",
          "SC",
          "SP",
          "SE",
          "TO"
        ]
      },
      "MacroRegion": {
        "type": "string",
        "enum": [
          "Norte",
          "Nordeste",
          "Centro-Oeste",
          "Sudeste",
          "Sul"
        ]
      },
      "OrganizationLocation": {
        "type": "object",
        "required": [
          "headquarters_city",
          "headquarters_state"
        ],
        "properties": {
          "headquarters_city": {
            "type": "string",
            "example": "Sao Paulo"
          },
          "headquarters_state": {
            "$ref": "#/components/schemas/BrazilState"
          },
          "regions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MacroRegion"
            }
          },
          "states_by_region": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/BrazilState"
              }
            }
          }
        }
      },
      "OrganizationChannels": {
        "type": "object",
        "required": [
          "email"
        ],
        "properties": {
          "website": {
            "type": "string",
            "format": "uri"
          },
          "linkedin": {
            "type": "string",
            "format": "uri"
          },
          "instagram": {
            "type": "string",
            "format": "uri"
          },
          "twitter": {
            "type": "string",
            "format": "uri"
          },
          "youtube": {
            "type": "string",
            "format": "uri"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "whatsapp_groups": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      },
      "StructuredTags": {
        "type": "object",
        "required": [
          "o_que_fazemos"
        ],
        "properties": {
          "o_que_fazemos": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 3
          },
          "o_que_precisamos": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "o_que_oferecemos": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Organization": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "$ref": "#/components/schemas/OrganizationType"
          },
          "category": {
            "$ref": "#/components/schemas/OrganizationCategory"
          },
          "name": {
            "type": "string",
            "maxLength": 100,
            "description": "Campo bloqueado apos convite"
          },
          "short_description": {
            "type": "string",
            "maxLength": 500
          },
          "logo": {
            "type": "string",
            "format": "uri"
          },
          "banner_image": {
            "type": "string",
            "format": "uri"
          },
          "partnerships": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "is_institutional_partner": {
            "type": "boolean"
          },
          "is_master_account": {
            "type": "boolean"
          },
          "objective": {
            "type": "string",
            "description": "Objetivo principal da comunidade"
          },
          "structured_tags": {
            "$ref": "#/components/schemas/StructuredTags"
          },
          "location": {
            "$ref": "#/components/schemas/OrganizationLocation"
          },
          "channels": {
            "$ref": "#/components/schemas/OrganizationChannels"
          },
          "admin_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "profile_status": {
            "type": "string",
            "enum": [
              "incomplete",
              "complete"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "InviteStatus": {
        "type": "string",
        "enum": [
          "created",
          "sent",
          "used",
          "expired",
          "cancelled"
        ]
      },
      "Invite": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "invited_name": {
            "type": "string",
            "maxLength": 100
          },
          "invited_email": {
            "type": "string",
            "format": "email"
          },
          "organization": {
            "type": "string",
            "maxLength": 100
          },
          "token": {
            "type": "string",
            "description": "Token unico para o link de convite"
          },
          "created_by_admin_id": {
            "type": "string",
            "format": "uuid"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "sent_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "used_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "last_access_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "cancelled_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "cancelled_reason": {
            "type": "string",
            "maxLength": 500,
            "nullable": true
          },
          "status": {
            "$ref": "#/components/schemas/InviteStatus"
          },
          "invited_role": {
            "$ref": "#/components/schemas/UserRole"
          },
          "expires_in_days": {
            "type": "integer",
            "nullable": true,
            "enum": [
              7,
              15,
              30,
              60,
              null
            ]
          }
        }
      },
      "CreateInviteRequest": {
        "type": "object",
        "required": [
          "name",
          "email",
          "organization"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 255
          },
          "organization": {
            "type": "string",
            "maxLength": 100
          },
          "role": {
            "$ref": "#/components/schemas/UserRole",
            "default": "MEMBRO"
          },
          "expires_in_days": {
            "type": "integer",
            "enum": [
              7,
              15,
              30,
              60
            ],
            "nullable": true,
            "description": "null = sem expiracao"
          }
        }
      },
      "PostAttachmentType": {
        "type": "string",
        "enum": [
          "image",
          "video",
          "link"
        ]
      },
      "PostAttachment": {
        "type": "object",
        "required": [
          "type",
          "url"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "$ref": "#/components/schemas/PostAttachmentType"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "thumbnail": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "title": {
            "type": "string",
            "maxLength": 200,
            "nullable": true
          },
          "description": {
            "type": "string",
            "maxLength": 500,
            "nullable": true
          }
        }
      },
      "PostComment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "author_user_id": {
            "type": "string",
            "format": "uuid"
          },
          "text": {
            "type": "string",
            "maxLength": 2000
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "likes": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "replies": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PostComment"
            }
          }
        }
      },
      "ContentStatus": {
        "type": "string",
        "enum": [
          "active",
          "hidden_by_admin"
        ]
      },
      "Post": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "author_user_id": {
            "type": "string",
            "format": "uuid"
          },
          "body": {
            "type": "string",
            "maxLength": 5000
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "attachments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PostAttachment"
            },
            "maxItems": 10
          },
          "likes": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "comments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PostComment"
            }
          },
          "shares": {
            "type": "integer"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "flagged_count": {
            "type": "integer"
          },
          "flagged_by": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "status": {
            "$ref": "#/components/schemas/ContentStatus"
          },
          "is_pinned": {
            "type": "boolean"
          },
          "pinned_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "pinned_by_admin_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "context_tab": {
            "type": "string",
            "description": "Tag associada a aba do feed"
          }
        }
      },
      "CreatePostRequest": {
        "type": "object",
        "required": [
          "body"
        ],
        "properties": {
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 10
          },
          "attachments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PostAttachment"
            },
            "maxItems": 10
          },
          "context_tab": {
            "type": "string",
            "description": "Tag da aba/tema do post"
          }
        }
      },
      "ProjectStatus": {
        "type": "string",
        "enum": [
          "active",
          "archived",
          "cancelled",
          "completed",
          "hidden_by_admin"
        ]
      },
      "CommunicationTagWithContext": {
        "type": "object",
        "required": [
          "tag"
        ],
        "properties": {
          "tag": {
            "type": "string"
          },
          "context": {
            "type": "string",
            "maxLength": 200,
            "nullable": true
          }
        }
      },
      "ProjectBeneficiaryData": {
        "type": "object",
        "required": [
          "quantity",
          "tags"
        ],
        "properties": {
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        }
      },
      "ProjectGoal": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "indicator": {
            "type": "string",
            "maxLength": 100
          },
          "target": {
            "type": "number"
          },
          "current": {
            "type": "number"
          },
          "progress": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "completed": {
            "type": "boolean"
          }
        }
      },
      "ProjectCTAOptions": {
        "type": "object",
        "properties": {
          "accepts_investment": {
            "type": "boolean",
            "default": false
          },
          "accepts_partnership": {
            "type": "boolean",
            "default": false
          },
          "accepts_beneficiary": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "Project": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "created_by_user_id": {
            "type": "string",
            "format": "uuid"
          },
          "organization_id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "maxLength": 5000
          },
          "cover_image": {
            "type": "string",
            "format": "uri"
          },
          "logo": {
            "type": "string",
            "format": "uri"
          },
          "start_date": {
            "type": "string",
            "format": "date"
          },
          "end_date": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "what_we_do": {
            "type": "string",
            "maxLength": 1000
          },
          "what_we_do_tags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CommunicationTagWithContext"
            }
          },
          "what_we_need": {
            "type": "string",
            "maxLength": 1000
          },
          "what_we_need_tags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CommunicationTagWithContext"
            }
          },
          "what_we_offer": {
            "type": "string",
            "maxLength": 1000
          },
          "what_we_offer_tags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CommunicationTagWithContext"
            }
          },
          "objective": {
            "type": "string",
            "description": "Objetivo macro do projeto"
          },
          "direct_beneficiaries": {
            "$ref": "#/components/schemas/ProjectBeneficiaryData"
          },
          "indirect_beneficiaries": {
            "$ref": "#/components/schemas/ProjectBeneficiaryData"
          },
          "estimated_value": {
            "type": "number",
            "description": "Orcamento estimado em BRL"
          },
          "collected_value": {
            "type": "number",
            "description": "Valor arrecadado"
          },
          "income_generated_value": {
            "type": "number",
            "description": "Renda gerada pelo projeto"
          },
          "cta_options": {
            "$ref": "#/components/schemas/ProjectCTAOptions"
          },
          "goals": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProjectGoal"
            }
          },
          "gallery": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "maxItems": 20
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "$ref": "#/components/schemas/ProjectStatus"
          },
          "participants": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "flagged_count": {
            "type": "integer"
          },
          "flagged_by": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "region": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "target_audience": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "EventStatus": {
        "type": "string",
        "enum": [
          "active",
          "cancelled",
          "hidden_by_admin"
        ]
      },
      "EventAccessType": {
        "type": "string",
        "enum": [
          "public",
          "community"
        ]
      },
      "EventExternalRegistration": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
