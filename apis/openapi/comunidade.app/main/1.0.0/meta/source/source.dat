    "/events": {
      "get": {
        "summary": "Listar eventos",
        "tags": [
          "events"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/EventStatus"
            }
          },
          {
            "name": "access_type",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/EventAccessType"
            }
          },
          {
            "name": "created_by",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "start_after",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "start_before",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "is_online",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "tags",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de eventos",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Event"
                      }
                    },
                    "pagination": {
                      "$ref": "#/components/schemas/Pagination"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Criar evento",
        "tags": [
          "events"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "title",
                  "description",
                  "start_datetime",
                  "end_datetime",
                  "access_type"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 5000
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "start_datetime": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "end_datetime": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "location_text": {
                    "type": "string",
                    "maxLength": 500,
                    "description": "Obrigatorio se online_url for null"
                  },
                  "online_url": {
                    "type": "string",
                    "format": "uri",
                    "description": "Obrigatorio se location_text for null"
                  },
                  "access_type": {
                    "$ref": "#/components/schemas/EventAccessType"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Evento criado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            }
          }
        }
      }
    },
