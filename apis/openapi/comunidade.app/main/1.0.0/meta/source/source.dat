              "$ref": "#/components/schemas/ProjectStatus"
            }
          },
          {
            "name": "created_by",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "objective",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tags",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "region",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "target_audience",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "accepts_investment",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "accepts_partnership",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de projetos",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Project"
                      }
                    },
                    "pagination": {
                      "$ref": "#/components/schemas/Pagination"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Criar novo projeto",
        "tags": [
          "projects"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "title",
                  "description",
                  "objective",
                  "start_date",
                  "direct_beneficiaries"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 5000
                  },
                  "cover_image": {
                    "type": "string",
                    "format": "uri"
                  },
                  "logo": {
                    "type": "string",
                    "format": "uri"
                  },
                  "start_date": {
                    "type": "string",
                    "format": "date"
                  },
                  "end_date": {
                    "type": "string",
                    "format": "date"
                  },
                  "objective": {
                    "type": "string"
                  },
                  "what_we_do": {
                    "type": "string"
                  },
                  "what_we_do_tags": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/CommunicationTagWithContext"
                    }
                  },
                  "what_we_need": {
                    "type": "string"
                  },
                  "what_we_need_tags": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/CommunicationTagWithContext"
                    }
                  },
                  "what_we_offer": {
                    "type": "string"
                  },
                  "what_we_offer_tags": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/CommunicationTagWithContext"
                    }
                  },
                  "direct_beneficiaries": {
                    "$ref": "#/components/schemas/ProjectBeneficiaryData"
                  },
                  "indirect_beneficiaries": {
                    "$ref": "#/components/schemas/ProjectBeneficiaryData"
                  },
                  "estimated_value": {
                    "type": "number"
                  },
                  "cta_options": {
                    "$ref": "#/components/schemas/ProjectCTAOptions"
                  },
                  "goals": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/ProjectGoal"
                    }
                  },
                  "gallery": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uri"
                    }
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Projeto criado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            }
          }
        }
      }
    },
