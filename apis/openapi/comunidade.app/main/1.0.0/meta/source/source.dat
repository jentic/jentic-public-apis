          },
          "code": {
            "type": "string",
            "example": "VALIDATION_ERROR"
          },
          "details": {
            "type": "object",
            "additionalProperties": true,
            "nullable": true
          }
        }
      },
      "SuccessMessage": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  },
  "paths": {
    "/auth/login": {
      "post": {
        "summary": "Autenticar usuario com email e senha",
        "tags": [
          "auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 255,
                    "example": "usuario@organizacao.com.br"
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "minLength": 8,
                    "maxLength": 128,
                    "example": "SenhaSegura123!"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login bem-sucedido",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "user": {
                      "$ref": "#/components/schemas/User"
                    },
                    "token": {
                      "type": "string",
                      "description": "JWT token",
                      "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                    },
                    "refresh_token": {
                      "type": "string",
                      "example": "rt_abc123..."
                    },
                    "expires_in": {
                      "type": "integer",
                      "description": "Tempo de expiracao em segundos",
                      "example": 3600
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Credenciais invalidas",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Dados de entrada invalidos"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "Encerrar sessao do usuario",
        "tags": [
          "auth"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Logout bem-sucedido"
          },
          "401": {
            "description": "Token invalido ou expirado"
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "summary": "Renovar token de acesso",
        "tags": [
          "auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "refresh_token"
                ],
                "properties": {
                  "refresh_token": {
                    "type": "string",
                    "example": "rt_abc123..."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token renovado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string"
                    },
                    "expires_in": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/validate-invite": {
      "post": {
        "summary": "Validar token de convite",
        "tags": [
          "auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "token"
                ],
                "properties": {
                  "token": {
                    "type": "string",
                    "example": "abc123xyz"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resultado da validacao",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "valid": {
                      "type": "boolean"
                    },
                    "invite": {
                      "$ref": "#/components/schemas/Invite"
                    },
                    "error": {
                      "type": "string",
                      "enum": [
                        "not_found",
                        "expired",
                        "used",
                        "cancelled"
                      ],
                      "nullable": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "summary": "Registrar usuario via convite",
        "tags": [
          "auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "token",
                  "name",
                  "password",
                  "accept_terms",
                  "accept_privacy",
                  "tags"
                ],
                "properties": {
                  "token": {
                    "type": "string",
                    "description": "Token do convite",
                    "example": "abc123xyz"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 100,
                    "example": "Maria Silva Santos"
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "minLength": 8,
                    "maxLength": 128,
                    "description": "Min 8 caracteres, 1 maiuscula, 1 numero"
                  },
                  "accept_terms": {
                    "type": "boolean",
                    "description": "Aceite dos Termos de Uso (obrigatorio true)"
                  },
                  "accept_privacy": {
                    "type": "boolean",
                    "description": "Aceite da Politica de Privacidade (obrigatorio true)"
                  },
                  "tags": {
                    "type": "object",
                    "required": [
                      "o_que_fazemos"
                    ],
                    "properties": {
                      "o_que_fazemos": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "minItems": 3,
                        "description": "Minimo 3 tags obrigatorias"
                      },
                      "o_que_precisamos": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "o_que_oferecemos": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuario criado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": {
                      "$ref": "#/components/schemas/User"
                    },
                    "token": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Token invalido ou dados incompletos"
          },
          "409": {
            "description": "Email ja cadastrado"
          }
        }
      }
    },
    "/users": {
      "get": {
        "summary": "Listar usuarios da comunidade",
