          "409": {
            "description": "Ja existe aba com este nome"
          }
        }
      }
    },
    "/feed-tabs/{id}": {
      "patch": {
        "summary": "Atualizar aba (admin only)",
        "tags": [
          "feed-tabs"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-roles": [
          "ADMIN_COMUNIDADE"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 50
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "icon": {
                    "$ref": "#/components/schemas/FeedTabIcon"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Aba atualizada"
          }
        }
      },
      "delete": {
        "summary": "Excluir aba (admin only, apenas nao obrigatorias)",
        "tags": [
          "feed-tabs"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-roles": [
          "ADMIN_COMUNIDADE"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "posts_action"
                ],
                "properties": {
                  "posts_action": {
                    "type": "string",
                    "enum": [
                      "delete",
                      "transfer"
                    ],
                    "description": "O que fazer com os posts da aba"
                  },
                  "destination_tab_id": {
                    "type": "string",
                    "format": "uuid",
                    "description": "Obrigatorio se posts_action = transfer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Aba excluida"
          },
          "400": {
            "description": "Aba obrigatoria nao pode ser excluida"
          }
        }
      }
    },
