{
  "openapi": "3.1.0",
  "info": {
    "title": "Reka AI API",
    "version": "1.0.0",
    "x-jentic-source-url": "https://docs.reka.ai/openapi.json",
    "description": "Reka AI API for chat completions, model listing, and audio transcription."
  },
  "paths": {
    "/chat/completions": {
      "post": {
        "operationId": "create",
        "summary": "Chat",
        "tags": [
          "subpackage_chat"
        ],
        "responses": {
          "200": {
            "description": "Newest response from the model.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/chat_create_Response_200"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          }
        }
      }
    },
    "/models": {
      "get": {
        "operationId": "get",
        "summary": "Get Models",
        "description": "List models available to the user.",
        "tags": [
          "subpackage_models"
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Model"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/transcription_or_translation": {
      "post": {
        "operationId": "transcribe-or-translate",
        "summary": "Transcribe or translate audio",
        "description": "Transcribe audio to text, translate speech to another language, or generate translated audio output.\n\nThis endpoint supports multiple modes:\n- Transcription only: Convert speech to text with optional word-level timestamps\n- Translation: Translate audio from one language to another\n- Speech-to-speech translation: Generate translated audio output\n",
        "tags": [
          "subpackage_speech"
        ],
        "parameters": [
          {
            "name": "X-Api-Key",
            "in": "header",
            "description": "API key for authentication",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful transcription or translation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/speech_transcribe_or_translate_Response_200"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TranscribeOrTranslateRequestBadRequestError"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - invalid or missing API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TranscribeOrTranslateRequestUnauthorizedError"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TranscribeOrTranslateRequestInternalServerError"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "audio_url": {
                    "type": "string",
                    "description": "URL to the audio file or base64-encoded audio as data URI (data:audio/wav;base64,...)"
                  },
                  "sampling_rate": {
                    "type": "integer",
                    "default": 16000,
                    "description": "Audio sampling rate in Hz"
                  },
                  "target_language": {
                    "$ref": "#/components/schemas/V1TranscriptionOrTranslationPostRequestBodyContentApplicationJsonSchemaTargetLanguage",
                    "description": "Target language for translation"
                  },
                  "is_translate": {
                    "type": "boolean",
                    "default": false,
                    "description": "Set to true to indicate translation request"
                  },
                  "return_translation_audio": {
                    "type": "boolean",
                    "default": false,
                    "description": "If true, returns base64-encoded audio of the translated speech"
                  },
                  "temperature": {
                    "type": "number",
                    "format": "double",
                    "description": "Controls randomness in generation. Use 0.0 for deterministic output"
                  },
                  "max_tokens": {
                    "type": "integer",
                    "default": 1024,
                    "description": "Maximum number of tokens to generate"
                  }
                },
                "required": [
                  "audio_url",
                  "sampling_rate"
                ]
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "https://api.reka.ai/v1"
    }
  ],
  "components": {
    "schemas": {
      "TypedText": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "type": {
            "description": "Any type"
          }
        },
        "required": [
          "text",
          "type"
        ],
        "description": "Another way to specify a text message when you are sending multimodal input.\nYour content might look something like that:\n\n[\n    {\"type\": \"text\", \"text\":\"What is the image?\"},\n    {\"type\": \"image_url\", \"image_url\":\"https://...\"},\n    {\"type\": \"text\", \"text\":\"Ignore the image and just write a Python script\"}\n]",
        "title": "TypedText"
      },
      "MediaType": {
        "type": "string",
        "enum": [
          "image_url",
          "video_url",
          "audio_url",
          "pdf_url"
        ],
        "description": "The type of media.",
        "title": "MediaType"
      },
      "TypedMediaContent": {
        "type": "object",
        "properties": {
          "audio_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "image_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "pdf_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "$ref": "#/components/schemas/MediaType"
          },
          "video_url": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "type"
        ],
        "description": "In conjunction with MediaType this is used to enforce the\n{\"type\": \"image_url\", \"image_url\":\"https://...\"} spec.\n\nInvariant: exactly the `type` url is not None",
        "title": "TypedMediaContent"
      },
      "ChatMessageInputContentOneOf1Items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/TypedText"
          },
          {
            "$ref": "#/components/schemas/TypedMediaContent"
          }
        ],
        "title": "ChatMessageInputContentOneOf1Items"
      },
      "ChatMessageInputContent1": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/ChatMessageInputContentOneOf1Items"
        },
        "title": "ChatMessageInputContent1"
      },
      "ToolOutput": {
        "type": "object",
        "properties": {
          "output": {
            "type": "string"
          },
          "tool_call_id": {
            "type": "string"
          }
        },
        "required": [
          "output",
          "tool_call_id"
        ],
        "description": "Represents the output of a tool function call.\n\nAttributes:\n    tool_call_id (str): Unique identifier for the tool call.\n    output (str): The output generated by the tool function.",
        "title": "ToolOutput"
      },
      "ChatMessageInputContent2": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/ToolOutput"
        },
        "title": "ChatMessageInputContent2"
      },
      "ChatMessageInputContent": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "$ref": "#/components/schemas/ChatMessageInputContent1"
          },
          {
            "$ref": "#/components/schemas/ChatMessageInputContent2"
          }
        ],
        "title": "ChatMessageInputContent"
      },
      "ChatRole": {
        "type": "string",
        "enum": [
          "user",
          "assistant",
          "tool"
        ],
        "description": "What is the role of the particular turn. Supports turns from a person and\nthe model for now",
        "title": "ChatRole"
      },
      "ToolCallParameters": {
        "type": "object",
        "properties": {},
        "title": "ToolCallParameters"
      },
      "ToolCall": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "parameters": {
            "$ref": "#/components/schemas/ToolCallParameters"
          }
        },
        "required": [
          "id",
          "name",
          "parameters"
        ],
        "description": "Represents a call to a tool function.\n\nAttributes:\n    id (str): Unique identifier for the tool call.\n    name (str): Name of the tool function to be called.\n    parameters (JsonSchemaValue): Parameters to be passed to the tool function.",
        "title": "ToolCall"
      },
      "ChatMessage-Input": {
        "type": "object",
        "properties": {
          "content": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ChatMessageInputContent"
              },
              {
                "type": "null"
              }
            ]
          },
          "role": {
            "$ref": "#/components/schemas/ChatRole"
          },
          "tool_calls": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/ToolCall"
            }
          }
        },
        "required": [
          "role"
        ],
        "description": "A collection of pieces of content from a single entity (role).",
        "title": "ChatMessage-Input"
      },
      "ToolChoice": {
        "type": "string",
        "enum": [
          "auto",
          "tool",
          "none"
        ],
        "description": "Types of tool choices available.\nPossible values:\n    AUTO: Automatically choose the tool (including choosing to not use any tools provided).\n    TOOL: A specific tool must be chosen.\n    NONE: Do not use any tools provided.",
        "title": "ToolChoice"
      },
      "ToolParameters": {
        "type": "object",
        "properties": {},
        "title": "ToolParameters"
      },
      "Tool": {
        "type": "object",
        "properties": {
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "parameters": {
            "$ref": "#/components/schemas/ToolParameters"
          }
        },
        "required": [
          "name",
          "parameters"
        ],
        "description": "The whole tool specification that includes the name of the tool function,\na description, and the detailed input schema.\n\nAn example of a tool function that returns the temperature of a city in a given unit:\n{\n    \"name\": \"get_weather_in_unit\",\n    \"description\": \"Get the weather in a given location in the given unit.\",\n    \"parameters\": {\n        \"type\": \"object\",\n        \"properties\": {\n            \"location\": {\n                \"type\": \"string\",\n                \"description\": \"The city and state, e.g. San Francisco, CA\"\n            },\n            \"unit\": {\n                \"enum\": [\"c\", \"f\"],\n                \"description\": \"The unit of temperature, either 'c' (celsius) or 'f' (fahrenheit)\"\n            },\n        }\n        \"required\": [\"location\"]\n    }\n}",
        "title": "Tool"
      },
      "ChatRequest": {
        "type": "object",
        "properties": {
          "frequency_penalty": {
            "type": [
              "number",
              "null"
            ],
            "format": "double",
            "description": "Parameter which penalises tokens based on their frequency in the model's output so far. The larger the value, the higher the penalisation. 0.0 means no frequency penalty. Defaults to 0.0."
          },
          "max_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "description": "The maximum number of new tokens to be generated by the model. Note that this is limited by the model's context length. Defaults to 1024."
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChatMessage-Input"
            },
            "description": "List of messages specifying the conversation so far."
          },
          "model": {
            "type": "string",
            "description": "See [Available Models](/chat/models) for possible values."
          },
          "presence_penalty": {
            "type": [
              "number",
              "null"
            ],
            "format": "double",
            "description": "Parameter which penalises tokens based on whether they have appeared in the model's output so far. The larger the value, the higher the penalisation. 0.0 means no presence penalty. Defaults to 0.0."
          },
          "seed": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Random seed used for generations. The same value forces the model to sample the same output."
          },
          "stop": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "A list of stop strings used to control generation. If the model generates one of these, it will stop."
          },
          "stream": {
            "type": "boolean",
            "default": false,
            "description": "Set to true to enable streaming. See [Chat Streaming](/chat/overview#streaming)"
          },
          "temperature": {
            "type": [
              "number",
              "null"
            ],
            "format": "double",
            "description": "Positive number representing the temperature to use for generation. Higher values will make the output more unformly random or *creative*. 0.0 means greedy decoding. Defaults to 0.4."
          },
          "tool_choice": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ToolChoice"
              },
              {
                "type": "null"
              }
            ],
            "description": "Controls how the model may use the provided tools. Set to 'auto' to let the model decide whether or not to invoke a tool. Set to 'none' to disable tool use. Set to 'tool' to force the model to invoke a tool."
          },
          "tools": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/Tool"
            },
            "description": "List of tools the model has access to."
          },
          "top_k": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Parameter which forces the model to only consider the tokens with the `top_k` highest probabilities at the next step. Defaults to 1024."
          },
          "top_p": {
            "type": [
              "number",
              "null"
            ],
            "format": "double",
            "description": "Parameter used to do nucleus sampling, i.e. only consider tokens comprising the `top_p` probability of the next token's distribution. Defaults to 0.95."
          }
        },
        "required": [
          "messages",
          "model"
        ],
        "description": "Type that represents a chat request to Reka's apiserver.\n\nIt sets the context, decoding parameters, and requests a model\nto query.",
        "title": "ChatRequest"
      },
      "FinishReason": {
        "type": "string",
        "enum": [
          "stop",
          "length",
          "context"
        ],
        "description": "Enumeration which represents a reason of why the model stopped\ngenerating.\n\n- `stop` means the model generated a stop token\n\n- `length` means the model reached max_tokens number of tokens\n\n- `context` means the model reached its maximum context length",
        "title": "FinishReason"
      },
      "ChatMessageOutputContentOneOf1Items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/TypedText"
          },
          {
            "$ref": "#/components/schemas/TypedMediaContent"
          }
        ],
        "title": "ChatMessageOutputContentOneOf1Items"
      },
      "ChatMessageOutputContent1": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/ChatMessageOutputContentOneOf1Items"
        },
        "title": "ChatMessageOutputContent1"
      },
      "ChatMessageOutputContent2": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/ToolOutput"
        },
        "title": "ChatMessageOutputContent2"
      },
      "ChatMessageOutputContent": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "$ref": "#/components/schemas/ChatMessageOutputContent1"
          },
          {
            "$ref": "#/components/schemas/ChatMessageOutputContent2"
          }
        ],
        "title": "ChatMessageOutputContent"
      },
      "ChatMessage-Output": {
        "type": "object",
        "properties": {
          "content": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ChatMessageOutputContent"
              },
              {
                "type": "null"
              }
            ]
          },
          "role": {
            "$ref": "#/components/schemas/ChatRole"
          },
          "tool_calls": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/ToolCall"
            }
          }
        },
        "required": [
          "role"
        ],
        "description": "A collection of pieces of content from a single entity (role).",
        "title": "ChatMessage-Output"
      },
      "MessageResponse": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer"
          },
          "finish_reason": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/FinishReason"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "$ref": "#/components/schemas/ChatMessage-Output"
          }
        },
        "required": [
          "index",
          "message"
        ],
        "description": "Non-streaming response message type",
        "title": "MessageResponse"
      },
      "Usage": {
        "type": "object",
        "properties": {
          "input_tokens": {
            "type": "integer"
          },
          "output_tokens": {
            "type": "integer"
          }
        },
        "required": [
          "input_tokens",
          "output_tokens"
        ],
        "description": "Type representing usage metadata for a given request.",
        "title": "Usage"
      },
      "ChatResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "choices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MessageResponse"
            }
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          }
        },
        "required": [
          "id",
          "model",
          "choices",
          "usage"
        ],
        "description": "A chat response.",
        "title": "ChatResponse"
      },
      "ChatMessageChunkContentOneOf1Items": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/TypedText"
          },
          {
            "$ref": "#/components/schemas/TypedMediaContent"
          }
        ],
        "title": "ChatMessageChunkContentOneOf1Items"
      },
      "ChatMessageChunkContent1": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/ChatMessageChunkContentOneOf1Items"
        },
        "title": "ChatMessageChunkContent1"
      },
      "ChatMessageChunkContent2": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/ToolOutput"
        },
        "title": "ChatMessageChunkContent2"
      },
      "ChatMessageChunkContent": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "$ref": "#/components/schemas/ChatMessageChunkContent1"
          },
          {
            "$ref": "#/components/schemas/ChatMessageChunkContent2"
          }
        ],
        "title": "ChatMessageChunkContent"
      },
      "ChatMessageChunk": {
        "type": "object",
        "properties": {
          "content": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ChatMessageChunkContent"
              },
              {
                "type": "null"
              }
            ]
          },
          "role": {
            "$ref": "#/components/schemas/ChatRole"
          },
          "tool_calls": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/ToolCall"
            }
          }
        },
        "required": [
          "role"
        ],
        "description": "Type that represents a collection of turns from a single\nentity (role). This is the streaming version.",
        "title": "ChatMessageChunk"
      },
      "ChunkMessageResponse": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer"
          },
          "delta": {
            "$ref": "#/components/schemas/ChatMessageChunk"
          },
          "finish_reason": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/FinishReason"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "index",
          "delta"
        ],
        "description": "Streaming response message type",
        "title": "ChunkMessageResponse"
      },
      "ChunkChatResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "choices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChunkMessageResponse"
            }
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          }
        },
        "required": [
          "id",
          "model",
          "choices",
          "usage"
        ],
        "description": "Streaming specialisation of a chat response.",
        "title": "ChunkChatResponse"
      },
      "chat_create_Response_200": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/ChatResponse"
          },
          {
            "$ref": "#/components/schemas/ChunkChatResponse"
          }
        ],
        "title": "chat_create_Response_200"
      },
      "ValidationErrorLocItems": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          }
        ],
        "title": "ValidationErrorLocItems"
      },
      "ValidationError": {
        "type": "object",
        "properties": {
          "loc": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ValidationErrorLocItems"
            }
          },
          "msg": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "HTTPValidationError": {
        "type": "object",
        "properties": {
          "detail": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            }
          }
        },
        "title": "HTTPValidationError"
      },
      "Model": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "description": "Represents a model entry. A list of these is the response\nfrom the list models endpoints. Different users might have\npermissions to access different models.",
        "title": "Model"
      },
      "V1TranscriptionOrTranslationPostRequestBodyContentApplicationJsonSchemaTargetLanguage": {
        "type": "string",
        "enum": [
          "french",
          "spanish",
          "japanese",
          "chinese",
          "korean",
          "italian",
          "portuguese",
          "german"
        ],
        "description": "Target language for translation",
        "title": "V1TranscriptionOrTranslationPostRequestBodyContentApplicationJsonSchemaTargetLanguage"
      },
      "V1TranscriptionOrTranslationPostResponsesContentApplicationJsonSchemaTranscriptTranslationWithTimestampItems": {
        "type": "object",
        "properties": {
          "start": {
            "type": "number",
            "format": "double",
            "description": "Start time in seconds"
          },
          "end": {
            "type": "number",
            "format": "double",
            "description": "End time in seconds"
          },
          "transcript": {
            "type": "string",
            "description": "Transcribed word or phrase"
          }
        },
        "title": "V1TranscriptionOrTranslationPostResponsesContentApplicationJsonSchemaTranscriptTranslationWithTimestampItems"
      },
      "speech_transcribe_or_translate_Response_200": {
        "type": "object",
        "properties": {
          "transcript": {
            "type": "string",
            "description": "Transcribed text in the original language"
          },
          "translation": {
            "type": "string",
