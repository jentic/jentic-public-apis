{
  "openapi": "3.0.0",
  "info": {
    "title": "Pizza Tracker API",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/CenturyLink_APIs/edge-monitor/1.0.0"
  },
  "servers": [
    {
      "url": "https://pizza-tracker-beta.edgelab2.ctl.io",
      "description": "Beta testing environment"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "bearerToken": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health-check endpoint",
        "description": "Ping database and return 200 if it is alive. Server timestamp is printed in successful response.",
        "responses": {
          "200": {
            "description": "Database is alive and server timestamp is returned"
          }
        }
      }
    },
    "/scan": {
      "get": {
        "summary": "Database scanner",
        "parameters": [
          {
            "in": "query",
            "name": "json",
            "schema": {
              "type": "integer"
            },
            "default": 1
          }
        ],
        "description": "Max 1000 entries in database are scanned. Add &json=1 to return response in json format. Requires \"scan\" role.",
        "responses": {
          "200": {
            "description": "Database scan results"
          }
        }
      }
    },
    "/status": {
      "get": {
        "summary": "Transaction raw status log viewer",
        "parameters": [
          {
            "in": "query",
            "name": "tx_id",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "in": "query",
            "name": "json",
            "schema": {
              "type": "integer"
            },
            "default": 1
          }
        ],
        "description": "Shows raw logs of transaction. Add &json=1 to return response in json format. Requires \"status\" role and \"tx_id={tx_id}\" resource permissions.",
        "responses": {
          "200": {
            "description": "Raw logs of transaction"
          }
        }
      }
    },
    "/updates": {
      "get": {
        "summary": "Transaction update poller",
        "parameters": [
          {
            "in": "query",
            "name": "tx_id",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "in": "query",
            "name": "json",
            "schema": {
              "type": "integer"
            },
            "default": 1
          }
        ],
        "description": "Check last-updated timestamp for given transaction. Add &json=1 to return response in json format. Requires \"updates\" role and \"tx_id={tx_id}\" resource permissions.",
        "responses": {
          "200": {
            "description": "Last-updated timestamp of transaction"
          }
        }
      }
    },
    "/view": {
      "get": {
        "summary": "Pizza tracker iframe view",
        "parameters": [
          {
            "in": "query",
            "name": "tx_id",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "in": "query",
            "name": "json",
            "schema": {
              "type": "integer"
            },
            "default": 1
          },
          {
            "in": "query",
            "name": "matcher",
            "schema": {
              "type": "string"
            },
            "required": false,
            "default": "NetworkProvisioning"
          }
        ],
        "description": "Shows small iframe view for the pizza tracker. Add &json=1 to return response in json format. Requires \"view\" role and \"tx_id={tx_id}\" resource permissions.",
        "responses": {
          "200": {
            "description": "Pizza tracker iframe view"
          }
        }
      }
    },
    "/ingest": {
      "post": {
        "summary": "Ingest log data",
        "description": "Post log data separated by new-lines. Returns JSON result of the tx_id's processed. Requires \"ingest\" role.",
        "responses": {
          "201": {
            "description": "Log data processed successfully"
          }
        },
        "requestBody": {
          "content": {
            "text/plain": {
              "schema": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "/auth/issue-morpheus-user": {
      "post": {
        "summary": "Create a temporary token for users of Morpheus to use pizza-tracker",
        "description": "Should be called by the Morpheus integration plugin. Not by users. Form data contains \"name\", \"tx_id\", \"data\" fields, used to create the identity. Response tokens are given the \"updates\" and \"view\" roles on the \"tx_id={tx_id}\" resource. Requires \"morpheus\" role.",
        "responses": {
          "201": {
            "description": "Temporary token created successfully"
          }
        },
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "tx_id": {
                    "type": "string"
                  },
                  "data": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/external-id/morpheus": {
      "put": {
        "summary": "Create a mapping between an external id and a tx_id",
        "description": "Should be called by the Morpheus integration plugin. Not by users. Form data contains \"tx_id\" and \"morpheus_id\" fields. Requires \"morpheus\" role.",
        "responses": {
          "201": {
            "description": "Mapping created successfully"
          }
        },
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "tx_id": {
                    "type": "string"
                  },
                  "morpheus_id": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Retrieve mapping between an external id and a tx_id",
        "parameters": [
          {
            "in": "query",
            "name": "morpheus_id",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ],
        "description": "Should be called by the Morpheus integration plugin. Not by users. Returns JSON containing \"tx_id\". Requires \"morpheus\" role.",
        "responses": {
          "200": {
            "description": "JSON containing \"tx_id\"",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "tx_id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
