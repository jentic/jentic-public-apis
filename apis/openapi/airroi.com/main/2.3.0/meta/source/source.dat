            "$ref": "#/components/schemas/CalendarPricingMonthScopeAdjacentDay"
          },
          "december": {
            "$ref": "#/components/schemas/CalendarPricingMonthScopeAdjacentDay"
          }
        }
      },
      "CalendarPricingDateRangeAdjacentDay": {
        "allOf": [
          {
            "$ref": "#/components/schemas/CalendarPricingDateRangeBase"
          },
          {
            "type": "object",
