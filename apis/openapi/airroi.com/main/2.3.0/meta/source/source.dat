            "minimum": -90,
            "maximum": 90,
            "example": 34.052235
          },
          "longitude": {
            "type": "number",
            "format": "double",
            "description": "Longitude of the property location.",
            "minimum": -180,
            "maximum": 180,
            "example": -118.243683
          }
        }
