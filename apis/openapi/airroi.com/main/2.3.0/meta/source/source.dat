                "cleaning_fee": 350,
                "extra_guest_fee": 75
              },
              "ratings": {
                "num_reviews": 89,
                "rating_overall": 4.96,
                "rating_accuracy": 4.98,
                "rating_checkin": 4.97,
                "rating_cleanliness": 4.95,
                "rating_communication": 4.98,
                "rating_location": 5,
                "rating_value": 4.92
              },
              "performance_metrics": {
                "ttm_revenue": 285000,
                "ttm_avg_rate": 1250,
                "ttm_occupancy": 0.625,
                "ttm_adjusted_occupancy": 0.61,
                "ttm_revpar": 781.25,
                "ttm_adjusted_revpar": 762.5,
