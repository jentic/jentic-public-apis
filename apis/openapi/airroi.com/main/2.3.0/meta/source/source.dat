                "l90d_occupancy": 0.7,
                "l90d_adjusted_occupancy": 0.68,
                "l90d_revpar": 1050,
                "l90d_adjusted_revpar": 1020,
                "l90d_total_days": 90,
                "l90d_available_days": 88,
