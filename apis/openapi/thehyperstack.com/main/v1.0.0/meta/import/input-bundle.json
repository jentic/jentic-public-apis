{
  "openapi": "3.1.0",
  "info": {
    "title": "Hyperstack API",
    "description": "OpenAPI specification for Hyperstack credential-management REST API.",
    "contact": {
      "name": "Hyperstack",
      "url": "https://hyperstack.com",
      "email": "hello@thehyperstack.com"
    },
    "termsOfService": "https://thehyperstack.com/terms-and-conditions",
    "version": "v1.0.0",
    "x-jentic-source-url": "https://api.thehyperstack.com/openapi.yaml"
  },
  "servers": [
    {
      "url": "https://api.thehyperstack.com"
    }
  ],
  "paths": {
    "/v1/info": {
      "get": {
        "operationId": "info",
        "summary": "Platform status",
        "description": "Used for health checks.",
        "tags": [
          "Info"
        ],
        "responses": {
          "200": {
            "description": "Current platform status.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "success": {
                      "type": "boolean"
                    },
                    "account_name": {
                      "type": "string"
                    },
                    "account_id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth": {
      "post": {
        "operationId": "auth",
        "summary": "Verify API token",
        "description": "This endpoint is used to verify API tokens. If the token is valid, a 200 OK response is returned.  If the token is invalid, a 401 Unauthorized response is returned.",
        "tags": [
          "Auth"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Valid token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/group/new": {
      "post": {
        "operationId": "group_new",
        "summary": "Create credential group",
        "description": "This endpoint is used to create a new credential group. Credential groups are used to group credentials together.",
        "tags": [
          "Groups"
        ],
        "x-openai-isConsequential": true,
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GroupInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Group created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GroupResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/group/update/{group_key}": {
      "post": {
        "operationId": "group_update",
        "summary": "Update credential group",
        "description": "This endpoint is used to update an existing credential group.",
        "tags": [
          "Groups"
        ],
        "x-openai-isConsequential": true,
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "group_key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GroupInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/OK"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/group/view/{group_key}": {
      "get": {
        "description": "View credential-group details",
        "operationId": "group_view",
        "tags": [
          "Groups"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "group_key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Group details.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/GenericResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "title": {
                          "type": "string"
                        },
                        "description": {
                          "type": "string"
                        },
                        "tags": {
                          "type": "string"
                        },
                        "group_code": {
                          "type": "string"
                        },
                        "url": {
                          "type": "string",
                          "format": "uri"
                        },
                        "does_expire": {
                          "type": "boolean"
                        },
                        "validity": {
                          "type": "integer"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/groups/search": {
      "post": {
        "description": "Search credential groups",
        "operationId": "groups_search",
        "tags": [
          "Groups"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "keyword": {
                    "type": "string"
                  },
                  "page": {
                    "type": "integer"
                  },
                  "page_size": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/OK"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/groups/all": {
      "get": {
        "operationId": "groups_all",
        "summary": "List all credential groups",
        "description": "This endpoint is used to list all credential groups.",
        "tags": [
          "Groups"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/OK"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/credential/issue": {
      "post": {
        "description": "Issue credential",
        "operationId": "credential_issue",
        "tags": [
          "Credentials"
        ],
        "x-openai-isConsequential": true,
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CredentialInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Credential issued.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CredentialResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/credential/{document_id}/view": {
      "get": {
        "description": "View credential",
        "operationId": "credential_view",
        "tags": [
          "Credentials"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/OK"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/credential/{document_id}/update": {
      "post": {
        "description": "Update credential",
        "operationId": "credential_update",
        "tags": [
          "Credentials"
        ],
        "x-openai-isConsequential": true,
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "expiry": {
                    "type": "integer",
                    "description": "Unix timestamp"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/OK"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/credentials/search": {
      "post": {
        "description": "Search credentials",
        "operationId": "credentials_search",
        "tags": [
          "Credentials"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "group_key": {
                    "type": "string"
                  },
                  "recipient": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "email": {
                        "type": "string",
                        "format": "email"
                      }
                    }
                  },
                  "credential_key": {
                    "type": "string"
                  },
                  "start_date": {
                    "type": "string",
                    "format": "date"
                  },
                  "end_date": {
                    "type": "string",
                    "format": "date"
                  },
                  "custom_attributes": {
                    "type": "object"
                  },
                  "page": {
                    "type": "integer"
                  },
                  "page_size": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/OK"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/credentials/all": {
      "get": {
        "description": "List all credentials",
        "operationId": "credentials_all",
        "tags": [
          "Credentials"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/OK"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "GenericResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "error": {
            "type": "string"
          },
          "error_code": {
            "type": "string"
          }
        }
      },
      "GroupInput": {
        "type": "object",
        "required": [
          "title",
          "description"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "group_code": {
            "type": "string"
          },
          "does_expire": {
            "type": "boolean"
          },
          "validity": {
            "type": "integer"
          },
          "badge_template": {
            "type": "string"
          },
          "certificate_template": {
            "type": "string"
          },
          "blockchain": {
            "type": "boolean"
          }
        }
      },
      "GroupResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/GenericResponse"
          },
          {
            "type": "object",
            "properties": {
              "group_key": {
                "type": "string"
              }
            }
          }
        ]
      },
      "CredentialRecipient": {
        "type": "object",
        "required": [
          "name",
          "email"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "CredentialInput": {
        "type": "object",
        "required": [
          "recipient",
          "group_key"
        ],
        "properties": {
          "recipient": {
            "$ref": "#/components/schemas/CredentialRecipient"
          },
          "group_key": {
            "type": "string"
          },
          "custom_attributes": {
            "type": "object"
          }
        }
      },
      "CredentialResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/GenericResponse"
          },
          {
            "type": "object",
            "properties": {
              "document_id": {
                "type": "string"
              },
              "document_url": {
                "type": "string",
                "format": "uri"
              }
            }
          }
        ]
      }
    },
    "responses": {
      "OK": {
        "description": "Successful operation.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/GenericResponse"
            }
          }
        }
      },
      "BadRequest": {
        "description": "Validation or business-logic error.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Invalid or missing API key.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "externalDocs": {
    "description": "Hyperstack documentation",
    "url": "https://thehyperstack.com/docs"
  }
}