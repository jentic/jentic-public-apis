,"parameters":[{"name":"ticker","in":"query","required":true,"schema":{"type":"string"},"description":"US stock ticker, e.g. BA"},{"name":"metric","in":"query","required":false,"schema":{"type":"string"},"description":"Optional metric ID, e.g. revenue, netIncome, freeCashFlow; omit for the metric catalog and all financials."},{"name":"period","in":"query","required":false,"schema":{"type":"string"},"description":"Optional period basis; omit to keep all three bases separately."},{"name":"limit","in":"query","required":false,"schema":{"type":"integer"},"description":"Maximum observations per metric and basis, newest first (default 20)."},{"name":"format","in":"query","required":false,"schema":{"type":"string","enum":["json","csv"],"default":"json"},"description":"Response format. CSV requires a signed-in Founding Access account key."}],"security":[{"apiKey":[]}],"responses":{"200":{"description":"Structured result. Every payload carries an informational-purposes disclaimer; no Boothcheck house fair value, price target, or rating."},"401":{"description":"Missing or invalid API key for a keyed endpoint."},"404":{"description":"Ticker not covered or no data for this surface."},"429":{"description":"Rate limit reached for the key tier."}}}},"/financials/{ticker}":{"get":{"operationId":"get_financials_by_path","summary":"Company financials","description":"Consolidated SEC financial history: revenue, profit, cash flow, cash, debt and shares. Annual, discrete quarterly and trailing-twelve-month periods remain separate. Returns native currency, exact values, filing sources, derivation and missing-data reasons. A reported zero is preserved. Use this for questions such as Boeing total revenue, rather than searching narrative reports. Requires a signed-in Founding Access account API key (Authorization: Bearer bck_...).","parameters":[{"name":"ticker","in":"path","required":true,"schema":{"type":"string"},"description":"US ticker symbol."},{"name":"metric","in":"query","required":false,"schema":{"type":"string"},"description":"Optional metric ID, e.g. revenue, netIncome, freeCashFlow; omit for the metric catalog and all financials."},{"name":"period","in":"query","required":false,"schema":{"type":"string"},"description":"Optional period basis; omit to keep all three bases separately."},{"name":"limit","in":"query","required":false,"schema":{"type":"integer"},"description":"Maximum observations per metric and basis, newest first (default 20)."},{"name":"format","in":"query","required":false,"schema":{"type":"string","enum":["json","csv"],"default":"json"},"description":"Response format. CSV requires a signed-in Founding Access account key."}],"security":[{"apiKey":[]}],"responses":{"200":{"description":"Structured result. Every payload carries an informational-purposes disclaimer; no Boothcheck house fair value, price target, or rating."},"401":{"description":"Missing or invalid API key for a keyed endpoint."},"404":{"description":"Ticker not covered or no data for this surface."},"429":{"description":"Rate limit reached for the key tier."}}}},"/business":{"get":{"operationId":"get_business","summary":"Business revenue breakdown","description":"Source-aware annual business, product and geographic revenue breakdowns, consolidated reconciliation, and history where fiscal years are explicitly supported. Includes currency and coverage reasons. Complements the existing get_segments tool. Requires a signed-in Founding Access account API key (Authorization: Bearer bck_...).","parameters":[{"name":"ticker","in":"query","required":true,"schema":{"type":"string"},"description":"US stock ticker, e.g. BA"},{"name":"format","in":"query","required":false,"schema":{"type":"string","enum":["json","csv"],"default":"json"},"description":"Response format. CSV requires a signed-in Founding Access account key."}],"security":[{"apiKey":[]}],"responses":{"200":{"description":"Structured result. Every payload carries an informational-purposes disclaimer; no Boothch