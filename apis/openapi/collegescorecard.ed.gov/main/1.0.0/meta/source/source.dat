{
  "openapi": "3.0.3",
  "info": {
    "title": "College Scorecard API",
    "description": "U.S. Department of Education College Scorecard API providing data on higher education institutions including costs, graduation rates, student demographics, earnings outcomes, and admissions statistics.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://collegescorecard.ed.gov/data/documentation/",
    "x-jentic-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://api.data.gov/ed/collegescorecard/v1",
      "description": "College Scorecard API via api.data.gov gateway"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/schools": {
      "get": {
        "operationId": "listSchools",
        "summary": "Search and list schools",
        "description": "Returns a paginated list of schools matching the specified criteria. Supports filtering by any data field, geographic search by zip code, and field selection.",
        "parameters": [
          {
            "name": "api_key",
            "in": "query",
            "required": true,
            "description": "API key from api.data.gov (use DEMO_KEY for testing)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "school.name",
            "in": "query",
            "description": "Filter by school name (autocomplete, minimum 3 characters)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "school.state",
            "in": "query",
            "description": "Filter by state abbreviation (e.g., CA, NY)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "school.city",
            "in": "query",
            "description": "Filter by city name",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "school.degrees_awarded.predominant",
            "in": "query",
            "description": "Filter by predominant degree type (1=Certificate, 2=Associate, 3=Bachelor's, 4=Graduate)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "school.ownership",
            "in": "query",
            "description": "Filter by ownership type (1=Public, 2=Private nonprofit, 3=Private for-profit)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "school.region_id",
            "in": "query",
            "description": "Filter by region ID",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "school.region_id__not",
            "in": "query",
            "description": "Exclude schools in specific region",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "latest.student.size__range",
            "in": "query",
            "description": "Filter by student enrollment range (e.g., 1000..5000)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "latest.admissions.admission_rate.overall__range",
            "in": "query",
            "description": "Filter by admission rate range (e.g., 0.0..0.5)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "latest.cost.tuition.in_state__range",
            "in": "query",
            "description": "Filter by in-state tuition range",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "description": "Comma-separated list of fields to return (e.g., id,school.name,latest.cost.tuition.in_state)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Page number (zero-indexed)",
            "schema": {
              "type": "integer",
              "default": 0
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "description": "Records per page (max 100)",
            "schema": {
              "type": "integer",
              "default": 20,
              "maximum": 100
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Sort field with direction (e.g., latest.student.size:desc)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "zip",
            "in": "query",
            "description": "US zip code for geographic filtering (use with distance)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "distance",
            "in": "query",
            "description": "Distance in miles from zip code (use with zip)",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "all_programs_nested",
            "in": "query",
            "description": "Return all nested array items (v1.7+)",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "keys_nested",
            "in": "query",
            "description": "Return nested JSON objects instead of dotted strings (v1.7+)",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of matching schools",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SchoolsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - invalid API key"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
    "/schools.csv": {
      "get": {
        "operationId": "listSchoolsCsv",
        "summary": "Search and list schools (CSV format)",
        "description": "Returns matching schools in CSV format. Accepts the same parameters as the JSON endpoint.",
        "parameters": [
          {
            "name": "api_key",
            "in": "query",
            "required": true,
            "description": "API key from api.data.gov",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "description": "Comma-separated list of fields to return",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Page number (zero-indexed)",
            "schema": {
              "type": "integer",
              "default": 0
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "description": "Records per page (max 100)",
            "schema": {
              "type": "integer",
              "default": 20,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "CSV formatted school data",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "query",
        "name": "api_key",
        "description": "API key from api.data.gov. Register at https://api.data.gov/signup. Use DEMO_KEY for testing."
      }
    },
    "schemas": {
      "SchoolsResponse": {
        "type": "object",
        "properties": {
          "metadata": {
            "type": "object",
            "properties": {
              "total": {
                "type": "integer",
                "description": "Total number of matching records"
              },
              "page": {
                "type": "integer",
                "description": "Current page number"
              },
              "per_page": {
                "type": "integer",
                "description": "Records returned per page"
              }
            }
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/School"
            }
          }
        }
      },
      "School": {
        "type": "object",
        "description": "School record with nested data categories",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Unique school identifier (IPEDS UNITID)"
          },
          "school.name": {
            "type": "string",
            "description": "Institution name"
          },
          "school.city": {
            "type": "string"
          },
          "school.state": {
            "type": "string"
          },
          "school.zip": {
            "type": "string"
          },
          "school.school_url": {
            "type": "string"
          },
          "school.ownership": {
            "type": "integer",
            "description": "1=Public, 2=Private nonprofit, 3=Private for-profit"
          },
          "school.degrees_awarded.predominant": {
            "type": "integer",
            "description": "0=Not classified, 1=Certificate, 2=Associate, 3=Bachelor's, 4=Graduate"
          },
          "latest.student.size": {
            "type": "integer",
            "description": "Total enrollment"
          },
          "latest.admissions.admission_rate.overall": {
            "type": "number",
            "description": "Admission rate (0.0 to 1.0)"
          },
          "latest.cost.tuition.in_state": {
            "type": "number",
            "description": "In-state tuition"
          },
          "latest.cost.tuition.out_of_state": {
            "type": "number",
            "description": "Out-of-state tuition"
          },
          "latest.earnings.10_yrs_after_entry.median": {
            "type": "number",
            "description": "Median earnings 10 years after entry"
          },
          "latest.completion.rate_suppressed.overall": {
            "type": "number",
            "description": "Completion rate"
          },
          "latest.aid.median_debt_suppressed.overall": {
            "type": "number",
            "description": "Median debt at graduation"
          },
          "latest.student.retention_rate.overall.full_time": {
            "type": "number",
            "description": "Full-time retention rate"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "description": "Error code"
                },
                "message": {
                  "type": "string",
                  "description": "Error description"
                },
                "input": {
                  "type": "string",
                  "description": "Value that caused the error"
                },
                "parameter": {
                  "type": "string",
                  "description": "Parameter that caused the error"
                }
              }
            }
          }
        }
      }
    }
  }
}
