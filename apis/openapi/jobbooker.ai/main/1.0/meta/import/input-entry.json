{
  "openapi": "3.0.3",
  "info": {
    "title": "JobBooker API",
    "version": "1.0",
    "description": "JobBooker turns leads into booked jobs for home-service businesses: it answers a new lead in seconds in the owner's voice, keeps the conversation going, books the job on the calendar, keeps contacts and conversations in one place, and runs each stage's follow-through. This API is how lead sources and automation tools hand JobBooker a lead or a message and receive replies and alerts back; Yelp through Zapier is the first source. Every endpoint is authenticated with the business's API key, shown in the JobBooker dashboard under Settings, Connect. Send it in the x-jobbooker-key header.",
    "contact": {
      "name": "JobBooker support",
      "email": "propython88@gmail.com",
      "url": "https://jobbooker.ai/help/zapier"
    },
    "x-jentic-source-url": "https://jobbooker.ai/openapi.json"
  },
  "servers": [
    {
      "url": "https://jobbooker.ai"
    }
  ],
  "paths": {
    "/api/zapier/me": {
      "get": {
        "summary": "Test the API key",
        "description": "Returns the business the key belongs to. Zapier calls this when a connection is created, and uses business_name as the connection label.",
        "operationId": "me",
        "responses": {
          "200": {
            "description": "The business.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooMany"
          }
        }
      }
    },
    "/api/webhooks/zapier": {
      "post": {
        "summary": "Process a lead event",
        "description": "Hands JobBooker something that happened at a lead source (Yelp today): a new lead, a customer message, a message the business sent itself, or a shared phone number. JobBooker classifies it, writes the reply, and either pushes the reply through a Reply Ready subscription (then this returns 202 with accepted: true) or, when no subscription exists, returns the reply in the response. A new-lead event replayed for a lead that was already answered returns the earlier reply with duplicate: true. Limit: 60 requests per minute per business.",
        "operationId": "processEvent",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InboundEvent"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/InboundEvent"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Processed; the reply is in the response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProcessResult"
                }
              }
            }
          },
          "202": {
            "description": "Accepted; the reply will arrive through the Reply Ready subscription.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProcessResult"
                }
              }
            }
          },
          "400": {
            "description": "The body was not JSON or form data, or the event could not be read.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooMany"
          }
        }
      },
      "get": {
        "summary": "Describe the endpoint",
        "operationId": "describeWebhook",
        "security": [],
        "responses": {
          "200": {
            "description": "A one-line usage note."
          }
        }
      }
    },
    "/api/zapier/hooks": {
      "post": {
        "summary": "Subscribe a REST hook",
        "description": "Zapier calls this when a Zap using an instant trigger is turned on. The target must be a hooks.zapier.com URL. Subscribing the same URL and event twice returns the existing subscription. Limit: 30 per minute.",
        "operationId": "subscribeHook",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "target_url"
                ],
                "properties": {
                  "target_url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "event": {
                    "type": "string",
                    "enum": [
                      "reply_ready",
                      "owner_alert"
                    ],
                    "default": "reply_ready"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Subscribed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HookSubscription"
                }
              }
            }
          },
          "200": {
            "description": "Already subscribed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HookSubscription"
                }
              }
            }
          },
          "400": {
            "description": "Bad target URL or unknown event.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooMany"
          }
        }
      },
      "delete": {
        "summary": "Unsubscribe a REST hook",
        "description": "Zapier calls this when the Zap is turned off. Pass the subscription id, or the target_url.",
        "operationId": "unsubscribeHook",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "target_url": {
                    "type": "string",
                    "format": "uri"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Removed (or was not there)."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooMany"
          }
        }
      },
      "get": {
        "summary": "List subscriptions",
        "operationId": "listHooks",
        "responses": {
          "200": {
            "description": "The business's subscriptions.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/HookSubscription"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/zapier/hooks/sample": {
      "get": {
        "summary": "Sample payloads for the Zap editor",
        "description": "The last few replies (or, with ?event=owner_alert, a representative alert), shaped exactly like the live hook payloads, so a Zap can be built and tested before anything real has happened.",
        "operationId": "hookSamples",
        "parameters": [
          {
            "name": "event",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "reply_ready",
                "owner_alert"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sample items.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "$ref": "#/components/schemas/ReplyReadyPayload"
                      },
                      {
                        "$ref": "#/components/schemas/OwnerAlertPayload"
                      }
                    ]
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-jobbooker-key",
        "description": "The business's API key from Settings, Connect. The query parameter ?key= is also accepted."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "example": false
          },
          "error": {
            "type": "string"
          }
        }
      },
      "Me": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "business_id": {
            "type": "string"
          },
          "business_name": {
            "type": "string"
          },
          "yelp_business_id": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "InboundEvent": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "event": {
            "type": "string",
            "enum": [
              "new_lead",
              "consumer_message",
              "business_message",
              "phone_available"
            ],
            "default": "new_lead",
            "description": "What happened at the lead source. Omitted means a new lead."
          },
          "id": {
            "type": "string",
            "description": "The lead id from the lead source."
          },
          "business_id": {
            "type": "string",
            "description": "The business id at the lead source, if it has one."
          },
          "consumer_name": {
            "type": "string"
          },
          "job_names": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "survey_answers": {
            "description": "Yelp's survey answers, as an array or a JSON string.",
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              {
                "type": "string"
              }
            ]
          },
          "additional_info": {
            "type": "string"
          },
          "availability_status": {
            "type": "string",
            "example": "FLEXIBLE"
          },
          "availability_dates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "postal_code": {
            "type": "string"
          },
          "phone_number": {
            "type": "string",
            "description": "Set when the customer shared a number."
          },
          "attachments": {
            "type": "integer"
          },
          "attachment_urls": {
            "description": "Photo URLs, as an array or a comma-separated string.",
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "string"
              }
            ]
          },
          "link_to_reply_in_yelp": {
            "type": "string",
            "format": "uri"
          },
          "text": {
            "type": "string",
            "description": "The message text, for consumer_message and business_message events."
          },
          "message_id": {
            "type": "string"
          },
          "time_created": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ProcessResult": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "accepted": {
            "type": "boolean",
            "description": "Present when a Reply Ready subscription exists: the event was queued and the reply will arrive through that subscription."
          },
          "lead_id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "new_lead",
              "consumer_message",
              "business_message",
              "phone_available"
            ]
          },
          "should_reply": {
            "type": "boolean"
          },
          "reply": {
            "type": "string",
            "description": "The reply text, when it is returned in this response rather than pushed."
          },
          "status": {
            "type": "string",
            "enum": [
              "sent",
              "pending_approval",
              "skipped",
              "paused"
            ]
          },
          "urgency": {
            "type": "string",
            "enum": [
              "emergency",
              "high",
              "normal",
              "low"
            ]
          },
          "category": {
            "type": "string"
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "qualified": {
            "type": "boolean"
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mode": {
            "type": "string",
            "enum": [
              "ai",
              "template"
            ]
          },
          "latency_ms": {
            "type": "integer"
          },
          "delivery": {
            "type": "string"
          },
          "booked": {
            "type": "boolean"
          },
          "appointment": {
            "type": "string",
            "nullable": true
          },
          "duplicate": {
            "type": "boolean",
            "description": "true when a new-lead event was replayed for a lead already answered; nothing was sent again."
          }
        }
      },
      "HookSubscription": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "target_url": {
            "type": "string",
            "format": "uri"
          },
          "event": {
            "type": "string",
            "enum": [
              "reply_ready",
              "owner_alert"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ReplyReadyPayload": {
        "type": "object",
        "description": "Posted to the subscribed hooks.zapier.com URL whenever JobBooker sends a message to a lead: a first reply, a later reply, an approved draft, or a follow-up.",
        "properties": {
          "id": {
            "type": "string"
          },
          "lead_id": {
            "type": "string"
          },
          "yelp_lead_id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "response_content": {
            "type": "string",
            "description": "Same as text; named for Yelp's Create Message field."
          },
          "kind": {
            "type": "string",
            "enum": [
              "initial",
              "text",
              "follow_up"
            ]
          },
          "consumer_name": {
            "type": "string",
            "nullable": true
          },
          "business_name": {
            "type": "string"
          },
          "business_id": {
            "type": "string",
            "nullable": true
          },
          "sent_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "OwnerAlertPayload": {
        "type": "object",
        "description": "Posted to the subscribed hooks.zapier.com URL when the business owner should know something.",
        "properties": {
          "id": {
            "type": "string"
          },
          "event": {
            "type": "string",
            "enum": [
              "owner_alert"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "emergency",
              "hot_lead",
              "phone_shared",
              "draft_pending",
              "customer_replied_paused",
              "booked",
              "rescheduled",
              "automation",
              "task",
              "job_check"
            ]
          },
          "leadId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "body_original": {
            "type": "string",
            "description": "The customer's own words when body has been translated for the owner."
          },
          "urgency": {
            "type": "string"
          },
          "link": {
            "type": "string",
            "format": "uri",
            "description": "The conversation at the lead source, or the lead in JobBooker when the source gave no link."
          },
          "business": {
            "type": "string"
          },
          "to_phone": {
            "type": "string",
            "nullable": true
          },
          "to_email": {
            "type": "string",
            "nullable": true
          },
          "appointment_start": {
            "type": "string",
            "format": "date-time",
            "description": "On booked and rescheduled."
          },
          "appointment_end": {
            "type": "string",
            "format": "date-time"
          },
          "appointment_label": {
            "type": "string"
          },
          "previous_start": {
            "type": "string",
            "format": "date-time",
            "description": "On rescheduled: the slot the customer gave up."
          },
          "previous_end": {
            "type": "string",
            "format": "date-time"
          },
          "previous_label": {
            "type": "string"
          },
          "customer_name": {
            "type": "string",
            "nullable": true
          },
          "customer_phone": {
            "type": "string",
            "nullable": true
          },
          "customer_email": {
            "type": "string",
            "nullable": true
          },
          "customer_address": {
            "type": "string",
            "nullable": true
          },
          "notes": {
            "type": "string",
            "nullable": true
          },
          "sent_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing or invalid API key.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "TooMany": {
        "description": "Rate limited. Retry after the number of seconds in the Retry-After header.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "ApiKey": []
    }
  ],
  "x-webhooks": {
    "reply_ready": {
      "description": "POST to the subscribed URL. Body: ReplyReadyPayload. Sent when a message goes out to a lead.",
      "schema": {
        "$ref": "#/components/schemas/ReplyReadyPayload"
      }
    },
    "owner_alert": {
      "description": "POST to the subscribed URL. Body: OwnerAlertPayload. Sent when the owner should know something.",
      "schema": {
        "$ref": "#/components/schemas/OwnerAlertPayload"
      }
    }
  }
}