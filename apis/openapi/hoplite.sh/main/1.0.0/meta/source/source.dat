    "/api/projects/{id}/automations": {
      "get": {
        "security": [
          {
            "ApiKey": []
          },
          {
            "BearerApiKey": []
          }
        ],
        "operationId": "listAutomations",
        "tags": [
          "Automations"
        ],
        "summary": "List managed automations",
        "description": "List managed automations",
        "x-required-permission": "automation:read",
        "x-required-permissions": [
          "automation:read"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "const": true
                    },
                    "automations": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "modelId": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "triggers": {
                            "anyOf": [
                              {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "id": {
                                      "type": "string",
                                      "minLength": 1,
                                      "maxLength": 64
                                    },
                                    "triggerKind": {
                                      "type": "string",
                                      "enum": [
                                        "webhook",
                                        "schedule"
                                      ]
                                    },
                                    "eventKind": {
                                      "anyOf": [
                                        {
                                          "type": "string",
                                          "enum": [
                                            "github.pull_request.opened",
                                            "github.pull_request.closed",
                                            "github.pull_request.updated",
                                            "github.pull_request.merged",
                                            "github.pull_request.changes_requested",
                                            "github.check_run.failed",
                                            "sentry.issue",
                                            "linear.issue.created",
                                            "linear.issue.status_changed",
                                            "linear.issue.label_added",
                                            "slack.reaction.added",
                                            "slack.message.posted",
                                            "sazabi.issue.triggered",
                                            "sazabi.issue.resolved",
                                            "hoplite.thread.finished"
                                          ]
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ]
                                    },
                                    "schedule": {
                                      "anyOf": [
                                        {
                                          "oneOf": [
                                            {
                                              "type": "object",
                                              "properties": {
                                                "mode": {
                                                  "type": "string",
                                                  "const": "cron"
                                                },
                                                "expression": {
                                                  "type": "string",
                                                  "maxLength": 1000
                                                },
                                                "timezone": {
                                                  "type": "string",
                                                  "maxLength": 200
                                                }
                                              },
                                              "required": [
                                                "mode",
                                                "expression",
                                                "timezone"
                                              ]
                                            },
                                            {
                                              "type": "object",
                                              "properties": {
                                                "mode": {
                                                  "type": "string",
                                                  "const": "interval"
                                                },
                                                "intervalMs": {
                                                  "type": "number"
                                                }
                                              },
                                              "required": [
                                                "mode",
                                                "intervalMs"
                                              ]
                                            }
                                          ]
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ]
                                    },
                                    "conditions": {
                                      "anyOf": [
                                        {
                                          "type": "object",
                                          "properties": {
                                            "match": {
                                              "type": "string",
                                              "enum": [
                                                "all",
                                                "any"
                                              ]
                                            },
                                            "rules": {
                                              "maxItems": 20,
                                              "type": "array",
                                              "items": {
                                                "type": "object",
                                                "properties": {
                                                  "field": {
                                                    "type": "string",
                                                    "minLength": 1,
                                                    "maxLength": 200,
                                                    "pattern": "^[a-zA-Z0-9_-]+(?:\\.[a-zA-Z0-9_-]+)*$"
                                                  },
                                                  "operator": {
                                                    "type": "string",
                                                    "enum": [
                                                      "equals",
                                                      "not_equals",
                                                      "contains",
                                                      "not_contains",
                                                      "starts_with",
                                                      "ends_with",
                                                      "exists",
                                                      "not_exists",
                                                      "greater_than",
                                                      "less_than"
                                                    ]
                                                  },
                                                  "value": {
                                                    "type": "string",
                                                    "maxLength": 2000
                                                  }
                                                },
                                                "required": [
                                                  "field",
                                                  "operator",
                                                  "value"
                                                ],
                                                "additionalProperties": false
                                              }
                                            }
                                          },
                                          "required": [
                                            "match",
                                            "rules"
                                          ],
                                          "additionalProperties": false
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ]
                                    },
                                    "sentryBindingId": {
                                      "anyOf": [
                                        {
                                          "type": "string"
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ]
                                    },
                                    "sentryTriggerPolicy": {
                                      "anyOf": [
                                        {
                                          "type": "object",
                                          "properties": {
                                            "newIssues": {
                                              "default": true,
                                              "type": "boolean"
                                            },
                                            "regressions": {
                                              "default": true,
                                              "type": "boolean"
                                            },
                                            "levels": {
                                              "default": [],
                                              "type": "array",
                                              "items": {
                                                "type": "string",
                                                "enum": [
                                                  "fatal",
                                                  "error",
                                                  "warning",
                                                  "info",
                                                  "debug"
                                                ]
                                              }
                                            }
                                          }
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ]
                                    },
                                    "slack": {
                                      "anyOf": [
                                        {
                                          "type": "object",
                                          "properties": {
                                            "teamId": {
                                              "type": "string",
                                              "maxLength": 64
                                            },
                                            "channelIds": {
                                              "maxItems": 50,
                                              "type": "array",
                                              "items": {
                                                "type": "string",
                                                "pattern": "^[CG][A-Z0-9]+$"
                                              }
                                            },
