    "/api/threads/{id}/attachments/{artifactId}": {
      "get": {
        "security": [
          {
            "ApiKey": []
          },
          {
            "BearerApiKey": []
          }
        ],
        "operationId": "downloadThreadAttachment",
        "tags": [
          "Attachments"
        ],
        "summary": "Download a thread attachment",
        "description": "Returns Location with a short-lived signed storage URL. Fetch the Location without forwarding your Hoplite credential. With media=inline the response streams bytes instead.",
        "x-required-permission": "thread:read",
        "x-required-permissions": [
          "thread:read"
        ],
        "parameters": [
