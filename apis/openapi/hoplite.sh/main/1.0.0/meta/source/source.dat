            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "const": true
                    },
                    "detail": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string",
                          "enum": [
                            "You are out of credits",
                            "Your provider is out of credits",
                            "The Codex usage limit has been reached",
                            "Your provider's usage limit has been reached",
                            "Your ChatGPT plan doesn't include the selected model",
                            "The sandbox limit has been reached",
                            "Sorry, an error occurred",
                            "Access to the repository has been lost",
                            "The Hoplite assistant's daily usage limit has been reached",
