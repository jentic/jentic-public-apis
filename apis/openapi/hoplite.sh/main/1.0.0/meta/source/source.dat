    "/api/source-control/github/repositories": {
      "get": {
        "security": [
          {
            "ApiKey": []
          },
          {
            "BearerApiKey": []
          }
        ],
        "operationId": "listGitHubRepositories",
        "tags": [
          "Repositories"
        ],
        "summary": "List repositories",
        "description": "List repositories available to Hoplite through connected GitHub App installations.",
        "x-required-permission": "repo:read",
        "responses": {
          "200": {
            "description": "Connected repositories.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GitHubRepositoriesResponse"
                },
                "example": {
                  "ok": true,
                  "repositories": [
                    {
                      "id": "repo_987654321",
                      "fullName": "acme/storefront",
                      "defaultBranch": "main",
                      "private": true
                    }
                  ]
                }
              }
