{
  "openapi": "3.1.0",
  "info": {
    "title": "Hoplite API",
    "version": "1.0.0",
    "description": "Build your own cloud software factory with Hoplite. Compose managed agent execution, persistent workspaces, previews, approvals, and pull requests into your own application and workflows through one organization-scoped API.",
    "contact": {
      "name": "Hoplite",
      "url": "https://hoplite.sh"
    }
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "servers": [
    {
      "url": "https://api.hoplite.sh",
      "description": "Production"
    }
  ],
  "tags": [
    {
      "name": "Service accounts",
      "description": "Organization identities, permissions, and credential lifecycle."
    },
    {
      "name": "Repositories",
      "description": "Discover connected repositories, branches, and repository configuration."
    },
    {
      "name": "Projects",
      "description": "Create and configure projects and their repository bindings."
    },
    {
      "name": "Environment variables",
      "description": "Manage encrypted project environment variables."
    },
    {
      "name": "Models",
      "description": "Discover authorized models and execution capabilities."
    },
    {
      "name": "Threads",
      "description": "Create and manage conversations and their execution configuration."
    },
    {
      "name": "Messages",
      "description": "Read, append, and export thread conversations."
    },
    {
      "name": "Runs",
      "description": "Inspect execution state, activity, and failures; stop or retry work."
    },
    {
      "name": "Approvals",
      "description": "Read and resolve pending tool approvals."
    },
    {
      "name": "Workspaces",
      "description": "Inspect recovery options and recover a thread workspace."
    },
    {
      "name": "Diffs and checkpoints",
      "description": "Review code changes and restore saved workspace state."
    },
    {
      "name": "Attachments",
      "description": "Stage, confirm, and download thread attachments."
    },
    {
      "name": "Previews",
      "description": "Start managed previews for repository-backed threads and issue preview access."
    },
    {
      "name": "Pull requests",
      "description": "Create, inspect, and merge PRs and configure their review loops."
    },
    {
      "name": "Automations",
      "description": "Configure scheduled or webhook-triggered work and inspect executions."
    },
    {
      "name": "MCP servers",
      "description": "Manage external tool servers and their configuration."
    },
    {
      "name": "Events",
      "description": "Replay durable events and stream live progress."
    },
    {
      "name": "Webhooks",
      "description": "Manage event subscriptions, signing secrets, and deliveries."
    },
    {
      "name": "Operation receipts",
      "description": "Reconcile the outcome of idempotent API writes."
    },
    {
      "name": "Billing and usage",
      "description": "Read plan limits, credit balances, and usage attribution."
    },
    {
      "name": "System",
      "description": "Check service health and discover the available API capabilities."
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "tags": [
          "System"
        ],
        "summary": "Health check",
        "description": "Check whether the API process is responding. This lightweight endpoint does not require authentication and does not prove that every upstream dependency is ready.",
        "security": [],
        "responses": {
          "200": {
            "description": "The API process is healthy.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                },
                "example": {
                  "ok": true,
                  "service": "hoplite-api",
                  "version": "a1b2c3d"
                }
              }
            },
            "headers": {
              "x-request-id": {
                "description": "Request correlation ID.",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/source-control/github/installations": {
