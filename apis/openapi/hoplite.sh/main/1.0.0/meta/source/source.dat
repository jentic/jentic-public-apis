        ],
        "operationId": "getRunFailure",
        "tags": [
          "Runs"
        ],
        "summary": "Inspect run failure",
        "description": "Inspect run failure",
        "x-required-permission": "thread:read",
        "x-required-permissions": [
          "thread:read"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
