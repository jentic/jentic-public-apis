    "/api/threads/{id}/approvals/{approvalId}": {
      "post": {
        "security": [
          {
            "ApiKey": []
          },
          {
            "BearerApiKey": []
          }
        ],
        "operationId": "resolveToolApproval",
        "tags": [
          "Approvals"
        ],
        "summary": "Resolve a tool approval",
        "description": "Resolve a tool approval",
        "x-required-permission": "thread:update",
        "x-required-permissions": [
          "thread:update"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
