                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "isDraft": {
                            "type": "boolean"
                          },
                          "id": {
                            "type": "string"
                          },
                          "projectId": {
                            "type": "string"
                          },
                          "repoFullName": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "name": {
                            "type": "string"
                          },
                          "enabled": {
                            "type": "boolean"
                          },
                          "triggerKind": {
                            "type": "string",
                            "enum": [
                              "webhook",
                              "schedule"
                            ]
                          },
                          "schedule": {
                            "default": null,
                            "anyOf": [
                              {
                                "oneOf": [
                                  {
                                    "type": "object",
                                    "properties": {
                                      "mode": {
                                        "type": "string",
                                        "const": "cron"
                                      },
                                      "expression": {
                                        "type": "string",
                                        "maxLength": 1000
                                      },
                                      "timezone": {
                                        "type": "string",
                                        "maxLength": 200
                                      }
                                    },
                                    "required": [
                                      "mode",
                                      "expression",
                                      "timezone"
                                    ]
                                  },
                                  {
                                    "type": "object",
                                    "properties": {
                                      "mode": {
                                        "type": "string",
                                        "const": "interval"
                                      },
                                      "intervalMs": {
                                        "type": "number"
                                      }
                                    },
                                    "required": [
