                                  "anyOf": [
                                    {
                                      "type": "string"
                                    },
                                    {
                                      "type": "null"
                                    }
                                  ]
                                },
                                "status": {
                                  "type": "string"
                                }
                              },
                              "required": [
                                "kind",
                                "id"
                              ]
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "execution": {
                          "anyOf": [
                            {
                              "type": "object",
                              "properties": {
                                "threadId": {
                                  "type": "string"
                                },
                                "runId": {
                                  "type": "string"
                                },
                                "status": {
                                  "type": "string",
                                  "enum": [
                                    "queued",
                                    "running",
                                    "waiting",
                                    "completed",
                                    "failed",
                                    "cancelled"
                                  ]
                                },
                                "finishedAt": {
                                  "anyOf": [
