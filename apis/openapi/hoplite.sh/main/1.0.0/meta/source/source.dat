                  "example": 600
                }
              },
              "X-RateLimit-Remaining": {
                "description": "Requests remaining in the current rolling window.",
                "schema": {
                  "type": "integer",
                  "example": 599
                }
              },
              "X-RateLimit-Reset": {
                "description": "Unix timestamp when the current rolling window resets.",
