                "schema": {
                  "type": "integer",
                  "example": 600
                }
              },
              "X-RateLimit-Remaining": {
                "description": "Requests remaining in the current rolling window.",
                "schema": {
                  "type": "integer",
                  "example": 599
                }
              },
              "X-RateLimit-Reset": {
                "description": "Unix timestamp when the current rolling window resets.",
                "schema": {
                  "type": "integer",
                  "example": 1786320060
                }
              },
              "x-request-id": {
                "description": "Request correlation ID.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "description": "A required API dependency, including the rate limiter, is unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "ok": false,
                  "error": "rate_limit_unavailable"
                }
              }
            },
            "headers": {
              "RateLimit": {
                "description": "Current ingress policy, remaining requests, and seconds until reset, for example `\"ingress\";r=599;t=60`.",
                "schema": {
                  "type": "string"
                }
              },
              "RateLimit-Policy": {
                "description": "Ingress quota and window, for example `\"ingress\";q=600;qu=\"requests\";w=60`.",
                "schema": {
                  "type": "string"
                }
              },
              "X-RateLimit-Limit": {
                "description": "Maximum requests allowed in the current rolling window.",
                "schema": {
                  "type": "integer",
                  "example": 600
                }
              },
              "X-RateLimit-Remaining": {
                "description": "Requests remaining in the current rolling window.",
                "schema": {
                  "type": "integer",
                  "example": 599
                }
              },
              "X-RateLimit-Reset": {
                "description": "Unix timestamp when the current rolling window resets.",
                "schema": {
                  "type": "integer",
                  "example": 1786320060
                }
              },
              "x-request-id": {
                "description": "Request correlation ID.",
                "schema": {
                  "type": "string"
                }
              },
              "Retry-After": {
                "description": "Seconds until another request should be attempted.",
                "schema": {
                  "type": "integer",
                  "example": 60
                }
              },
              "X-Retry-After": {
                "description": "Legacy retry delay in seconds.",
                "schema": {
                  "type": "integer",
                  "example": 60
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Api-Key",
        "description": "An organization-scoped Hoplite API key beginning with hop_.",
        "x-permissions": [
          "automation:create",
          "automation:delete",
          "automation:read",
          "automation:run",
          "automation:update",
          "mcpServer:create",
          "mcpServer:delete",
          "mcpServer:read",
          "mcpServer:update",
          "modelKey:read",
          "project:create",
          "project:delete",
          "project:read",
          "project:update",
          "repo:read",
          "repo:update",
          "thread:create",
          "thread:read",
          "thread:retry",
          "thread:stop",
          "thread:update",
          "usage:read",
          "webhook:create",
          "webhook:delete",
          "webhook:read",
          "webhook:update"
        ]
      },
      "BearerApiKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "hop_…",
        "description": "The same Hoplite API key supplied as a Bearer credential.",
        "x-permissions": [
          "automation:create",
          "automation:delete",
          "automation:read",
          "automation:run",
          "automation:update",
          "mcpServer:create",
          "mcpServer:delete",
          "mcpServer:read",
          "mcpServer:update",
          "modelKey:read",
          "project:create",
          "project:delete",
          "project:read",
          "project:update",
          "repo:read",
          "repo:update",
          "thread:create",
          "thread:read",
          "thread:retry",
          "thread:stop",
          "thread:update",
          "usage:read",
          "webhook:create",
          "webhook:delete",
          "webhook:read",
          "webhook:update"
        ]
      },
      "SessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Secure-better-auth.session_token",
        "description": "Current owner/admin browser session. Credential management cannot be delegated to service accounts."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "ok",
          "error"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "type": "string",
            "description": "Stable, machine-readable error code."
          },
          "requestId": {
            "type": "string",
            "description": "Support correlation ID when included in the body. Every API response also carries x-request-id."
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "ok",
          "service",
          "version"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          },
          "service": {
            "type": "string",
            "const": "hoplite-api"
          },
          "version": {
            "type": [
              "string",
              "null"
            ],
            "description": "Deployed Git commit SHA when configured."
          }
        }
      },
      "GitHubRepository": {
        "type": "object",
        "required": [
          "id",
          "installationId",
          "repositoryId",
          "fullName",
          "defaultBranch",
          "private"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "installationId": {
            "type": "string"
          },
          "repositoryId": {
            "type": "integer"
          },
          "fullName": {
            "type": "string",
            "examples": [
              "acme/storefront"
            ]
          },
          "apiBaseUrl": {
            "type": "string"
          },
          "cloneUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "language": {
            "type": [
              "string",
              "null"
            ]
          },
          "framework": {
            "type": [
              "string",
              "null"
            ]
          },
          "defaultBranch": {
            "type": "string"
          },
          "private": {
            "type": "boolean"
          }
        }
      },
      "RepositoryRef": {
        "type": "object",
        "required": [
          "id",
          "fullName",
          "defaultBranch",
          "private"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "fullName": {
            "type": "string",
            "examples": [
              "acme/storefront"
            ]
          },
          "defaultBranch": {
            "type": "string"
          },
          "private": {
            "type": "boolean"
          }
        }
      },
      "GitHubInstallation": {
        "type": "object",
        "required": [
          "id",
          "installationId",
          "accountLogin",
          "accountType",
          "repositories"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "installationId": {
            "type": "integer"
          },
          "apiBaseUrl": {
            "type": "string"
          },
          "accountLogin": {
            "type": "string"
          },
          "accountType": {
            "type": "string"
          },
          "managementUrl": {
            "type": "string",
            "format": "uri"
          },
          "repositories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GitHubRepository"
            }
          }
        }
      },
      "GitHubInstallationsResponse": {
        "type": "object",
        "required": [
          "ok",
          "installations"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          },
          "installations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GitHubInstallation"
            }
          }
        }
      },
      "GitHubRepositoriesResponse": {
        "type": "object",
        "required": [
          "ok",
          "repositories"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          },
          "repositories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RepositoryRef"
            }
          }
        }
      },
      "BranchesResponse": {
        "type": "object",
        "required": [
          "ok",
          "branches"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          },
          "branches": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ProjectScript": {
        "type": "object",
        "required": [
          "enabled",
          "command"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "command": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "RepositoryInspection": {
        "type": "object",
        "required": [
          "framework",
          "settings"
        ],
        "properties": {
          "framework": {
            "type": [
              "string",
              "null"
            ]
          },
          "settings": {
            "type": "object",
            "required": [
              "path",
              "scripts",
              "previewPort",
              "invalid"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "previewPort": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "invalid": {
                "type": "boolean"
              },
              "scripts": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "setup": {
                    "$ref": "#/components/schemas/ProjectScript"
                  },
                  "run": {
                    "$ref": "#/components/schemas/ProjectScript"
                  },
                  "archive": {
                    "$ref": "#/components/schemas/ProjectScript"
                  }
                }
              }
            }
          }
        }
      },
      "RepositoryInspectionResponse": {
        "type": "object",
        "required": [
          "ok",
          "inspection"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          },
          "inspection": {
            "$ref": "#/components/schemas/RepositoryInspection"
          }
        }
      },
      "RepoRef": {
        "type": "object",
        "required": [
          "repoFullName"
        ],
        "properties": {
          "repoFullName": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "branch": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "LocalAgentExecutionTarget": {
        "type": "object",
        "required": [
          "bindingId",
          "hostId",
          "kind",
          "provider",
          "workspaceMode"
        ],
        "additionalProperties": false,
        "properties": {
          "bindingId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "hostId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "kind": {
            "type": "string",
            "const": "local"
          },
          "model": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 128
          },
          "provider": {
            "type": "string",
            "enum": [
              "codex",
              "claude"
            ]
          },
          "workspaceMode": {
            "type": "string",
            "enum": [
              "direct",
              "worktree"
            ]
          }
        }
      },
      "ProjectSandboxSpec": {
        "type": "object",
        "properties": {
          "defaultCpu": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "defaultMemoryGiB": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "maxCpu": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "maxDiskGiB": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "maxMemoryGiB": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "staffMaxCpu": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "staffMaxDiskGiB": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "staffMaxMemoryGiB": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "runtimeProfile": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "docker-compose",
              null
            ]
          }
        }
      },
      "Project": {
        "type": "object",
        "required": [
          "id",
          "name",
          "previewPort"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "taskCode": {
            "type": "string"
          },
          "repos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RepoRef"
            }
          },
          "githubInstallationId": {
            "type": "string"
          },
          "defaultBranch": {
            "type": [
              "string",
              "null"
            ]
          },
          "previewPort": {
            "type": "integer",
            "minimum": 3000,
            "maximum": 9999
          },
          "setupScript": {
            "type": [
              "string",
              "null"
            ]
          },
          "runScript": {
            "type": [
              "string",
              "null"
            ]
          },
          "archiveScript": {
            "type": [
              "string",
              "null"
            ]
          },
          "instructions": {
            "type": [
              "string",
              "null"
            ]
          },
          "defaultModel": {
            "type": [
              "string",
              "null"
            ]
          },
          "reasoningEffort": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "off",
              "none",
              "minimal",
              "low",
              "medium",
              "high",
              "xhigh",
              "max",
              null
            ]
          },
          "agentSpeed": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "standard",
              "fast",
              null
            ]
          },
          "prReviewAutofixDefault": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "sandboxSpec": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ProjectSandboxSpec"
              },
              {
                "type": "null"
              }
            ]
          },
          "framework": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateProjectRequest": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "defaultBranch": {
            "type": [
              "string",
              "null"
            ]
          },
          "repositoryId": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "pattern": "\\S"
          },
          "sourceControlConnectionId": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "baseBranch": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "pattern": "\\S"
          },
          "previewPort": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 3000,
                "maximum": 9999
              },
              {
                "type": "string",
                "pattern": "^[3-9][0-9]{3}$"
              }
            ],
            "description": "Preview port from 3000 to 9999. Numeric strings are accepted and normalized to an integer."
          },
          "setupScript": {
            "type": [
              "string",
              "null"
            ]
          },
          "runScript": {
            "type": [
              "string",
              "null"
            ]
          },
          "archiveScript": {
            "type": [
              "string",
              "null"
            ]
          },
          "instructions": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100000
          },
          "defaultModel": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "\\S"
          },
          "reasoningEffort": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "off",
              "none",
              "minimal",
              "low",
              "medium",
              "high",
              "xhigh",
              "max",
              null
            ]
          },
          "agentSpeed": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "standard",
              "fast",
              null
            ]
          },
          "prReviewAutofixDefault": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "clientOperationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "\\S"
          }
        }
      },
      "ProjectResponse": {
        "type": "object",
        "required": [
          "ok",
          "project"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          },
          "project": {
            "$ref": "#/components/schemas/Project"
          }
        }
      },
      "ProjectsResponse": {
        "type": "object",
        "required": [
          "ok",
          "projects"
        ],
        "properties": {
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "ok": {
            "type": "boolean",
            "const": true
          },
          "projects": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Project"
            }
          }
        }
      },
      "ThreadStatus": {
        "type": "string",
        "enum": [
          "queued",
          "running",
          "waiting",
          "blocked",
          "ready",
          "failed",
          "archived"
        ]
      },
      "ThreadTask": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "identifier": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "threadIndex": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      },
      "PullRequestChecksSummary": {
        "type": "object",
        "required": [
          "total",
          "succeeded",
          "failing",
          "running"
        ],
        "properties": {
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "succeeded": {
            "type": "integer",
            "minimum": 0
          },
          "failing": {
            "type": "integer",
            "minimum": 0
          },
          "running": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "PullRequestSummary": {
        "type": "object",
        "required": [
          "state",
          "draft",
          "mergeable",
          "checks",
          "checksAvailable",
          "commentsAvailable",
          "unresolvedCount"
        ],
        "properties": {
          "state": {
            "type": "string"
          },
          "draft": {
            "type": "boolean"
          },
          "mergeable": {
            "type": "string",
            "enum": [
              "mergeable",
              "conflicting",
              "unknown"
            ]
          },
          "mergeQueued": {
            "type": "boolean"
          },
          "checks": {
            "$ref": "#/components/schemas/PullRequestChecksSummary"
          },
          "checksAvailable": {
            "type": "boolean"
          },
          "commentsAvailable": {
            "type": "boolean"
          },
          "unresolvedCount": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "PullRequestReviewLoop": {
        "type": "object",
        "required": [
          "id",
          "threadId",
          "pullRequestId",
          "enabled",
          "autoMerge",
          "status",
          "passCount",
          "operationalRetryCount"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "threadId": {
            "type": "string"
          },
          "pullRequestId": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "autoMerge": {
            "type": "boolean"
          },
          "disabledBy": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "user",
              "system",
              null
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "disabled",
              "observing",
              "waiting_checks",
              "fixing",
              "finalizing",
              "ready",
              "blocked",
              "error"
            ]
          },
          "headSha": {
            "type": [
              "string",
              "null"
            ]
          },
          "lastProcessedHeadSha": {
            "type": [
              "string",
              "null"
            ]
          },
          "lastObservedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "waitUntil": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "lastFixRunId": {
            "type": [
              "string",
              "null"
            ]
          },
          "passCount": {
            "type": "integer",
            "minimum": 0
          },
          "operationalRetryCount": {
            "type": "integer",
            "minimum": 0
          },
          "lastErrorCode": {
            "type": [
              "string",
              "null"
            ]
          },
          "lastErrorMessage": {
            "type": [
              "string",
              "null"
            ]
          },
          "blockedReason": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PullRequest": {
        "type": "object",
        "required": [
          "number",
          "url",
          "repoFullName",
          "state"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "threadId": {
            "type": "string"
          },
          "number": {
            "type": "number"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "repoFullName": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "headRef": {
            "type": "string"
          },
          "headSha": {
            "type": "string"
          },
          "baseRef": {
            "type": "string"
          },
          "draft": {
            "type": "boolean"
          },
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "githubSummary": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/PullRequestSummary"
              },
              {
                "type": "null"
              }
            ]
          },
          "githubSummaryUpdatedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "reviewLoop": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/PullRequestReviewLoop"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "SentryIssueLink": {
        "type": "object",
        "required": [
          "issueId",
          "projectId",
          "projectSlug",
          "organizationSlug",
          "url"
        ],
        "properties": {
          "issueId": {
            "type": "string"
          },
          "shortId": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "level": {
            "type": [
              "string",
              "null"
            ]
          },
          "projectId": {
            "type": "string"
          },
          "projectSlug": {
            "type": "string"
          },
          "organizationSlug": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "Thread": {
        "type": "object",
        "required": [
          "id",
          "projectId",
          "status",
          "waitingOn",
          "blockedOn",
          "pendingWakeups",
          "tasks",
          "pullRequests"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "projectId": {
            "type": "string"
          },
          "modelId": {
            "type": [
              "string",
              "null"
            ]
          },
          "githubPullRequestNumber": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "$ref": "#/components/schemas/ThreadStatus"
          },
          "archivedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "initializationState": {
            "type": "string",
            "enum": [
              "accepted",
              "preparing",
              "completed",
              "failed",
              "cancelled"
            ]
          },
          "initializationPhase": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "provisioning_workspace",
              "resolving_repository",
              "allocating_sandbox",
              "fetching_repository",
              "configuring_workspace",
              "dispatching_run",
              null
            ]
          },
          "initializationAttemptCount": {
            "type": "integer",
            "minimum": 0
          },
          "initializationErrorCode": {
            "type": [
              "string",
              "null"
            ]
          },
          "initializationErrorMessage": {
            "type": [
              "string",
              "null"
            ]
          },
          "initializationUpdatedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "waitingOn": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "blockedOn": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pendingWakeups": {
            "type": "integer",
            "minimum": 0
          },
          "tasks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ThreadTask"
            }
          },
          "pullRequests": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PullRequest"
            }
          },
          "taskId": {
            "type": "string"
          },
          "taskIdentifier": {
            "type": [
              "string",
              "null"
            ]
          },
          "linearIssueUrl": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "primaryPullRequest": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/PullRequest"
              },
              {
                "type": "null"
              }
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "spendLimitMicros": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "titleVersion": {
            "type": "integer",
            "minimum": 0
          },
          "archiveVersion": {
            "type": "integer",
            "minimum": 0
          },
          "latestUserMessageAt": {
            "type": "string",
            "format": "date-time"
          },
          "workspaceStatus": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "preparing",
              "cancelled",
              "ready",
              "archived",
              "cleanup_pending",
              "error",
              null
            ]
          },
          "workspaceSetupStatus": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "pending",
              "running",
              "ready",
              "failed",
              null
            ]
          },
          "latestRunId": {
            "type": [
              "string",
              "null"
            ]
          },
          "sourceId": {
            "type": [
              "string",
              "null"
            ],
            "description": "Initial immutable Platform source, when source-backed."
          },
          "latestSourceId": {
            "type": [
              "string",
              "null"
            ],
            "description": "Latest successful immutable Platform source."
          },
          "runStartedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "runTurnStartedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Durable anchor for the admitted turn; unlike runStartedAt it spans compaction and follow-up runs."
          },
          "runStatus": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "queued",
              "running",
              "waiting",
              "completed",
              "failed",
              "cancelled",
              null
            ],
            "description": "Status of the latest run; distinguishes a genuinely queued run from a previous terminal run during the optimistic new-run window."
          },
          "runSteerable": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Whether the active run accepts same-run steering; false while a compact, repair, or foreign-workflow run holds the thread, so a follow-up would queue behind it. Null with no active run."
          },
          "stopRequestedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "runActiveDurationMs": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "runActiveDurationProvenance": {
            "description": "Whether the active duration was actively accounted, inherited from the legacy database default, or cannot be attributed during rollout.",
            "type": "string",
            "enum": [
              "accounted",
              "legacy_default",
              "unknown"
            ]
          },
          "runActiveSegmentStartedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "sentryIssue": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/SentryIssueLink"
              },
              {
                "type": "null"
              }
            ]
          },
          "createdByUserId": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdByAutomation": {
            "type": "boolean"
          },
          "participantUserIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "executionTarget": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/LocalAgentExecutionTarget"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "CreateThreadRequest": {
        "type": "object",
        "required": [
          "projectId",
          "prompt"
        ],
        "additionalProperties": false,
        "anyOf": [
          {
            "properties": {
              "prompt": {
                "type": "string",
                "pattern": "\\S"
              }
            }
          },
          {
            "required": [
              "initialAttachmentTickets"
            ],
            "properties": {
              "initialAttachmentTickets": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        ],
        "properties": {
          "spendLimitMicros": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "projectId": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "prompt": {
            "type": "string"
          },
          "executionTarget": {
            "$ref": "#/components/schemas/LocalAgentExecutionTarget"
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "sourcePullRequest": {
            "type": "object",
            "required": [
              "number",
              "repositoryId"
            ],
            "additionalProperties": false,
            "description": "The pull request this thread was opened from. The thread retains it as its source so later runs can address that pull request.",
            "properties": {
              "number": {
                "type": "integer",
                "minimum": 1
              },
              "repositoryId": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          },
          "autoMerge": {
            "type": "boolean",
            "description": "Override automatic PR merging for this thread. Omit the field to keep inheriting the organization's live default."
          },
          "forwardConversationAttachments": {
            "type": "boolean",
            "description": "Orchestrator requests only. Set false to keep files from the orchestrator conversation off the new thread. Omit to forward them."
          },
          "speed": {
            "type": "string",
            "enum": [
              "standard",
              "fast"
            ],
            "default": "standard"
          },
          "reasoning": {
            "type": "object",
            "required": [
              "mode"
            ],
            "additionalProperties": false,
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "off",
                  "none",
                  "minimal",
                  "low",
                  "medium",
                  "high",
                  "xhigh",
                  "max"
                ]
              }
            }
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          },
          "repos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RepoRef"
            }
          },
          "initialMessageId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "\\S"
          },
          "initialAttachmentTickets": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "\\S"
            }
          },
          "clientOperationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "\\S"
          }
        }
      },
      "AppendThreadMessageRequest": {
        "type": "object",
        "required": [
          "content"
        ],
        "properties": {
          "clientMessageId": {
            "type": "string",
            "minLength": 1
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "Model ID or connection route for this run. Takes precedence over metadata.model; validated against currently available models."
          },
          "attachments": {
            "type": "array",
            "maxItems": 10,
            "description": "Previously uploaded image artifacts to attach to this message.",
            "items": {
              "type": "object",
              "required": [
                "artifactId",
                "contentType"
              ],
              "additionalProperties": false,
              "properties": {
                "artifactId": {
                  "type": "string",
                  "minLength": 1
                },
                "contentType": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true,
            "description": "Optional message metadata. metadata.model is a supported Hoplite model ID, such as gpt-6-sol or claude-sonnet-5, that selects this message run's model.",
            "properties": {
              "model": {
                "type": "string",
                "minLength": 1,
                "description": "Supported Hoplite model ID for this message run."
              }
            }
          }
        }
      },
      "AppendThreadMessageResponse": {
        "type": "object",
        "required": [
          "ok",
          "message"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          },
          "message": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              }
            }
          },
          "idempotent": {
            "type": "boolean"
          },
          "queued": {
            "type": "boolean"
          },
          "run": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/RunSummary"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "RunSummary": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "CreateThreadResponse": {
        "type": "object",
        "required": [
          "ok",
          "thread"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          },
          "thread": {
            "$ref": "#/components/schemas/Thread"
          },
          "idempotent": {
            "type": "boolean"
          },
          "message": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Message"
              },
              {
                "type": "null"
              }
            ]
          },
          "run": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/RunSummary"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "ThreadResponse": {
        "type": "object",
        "required": [
          "ok",
          "thread"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          },
          "thread": {
            "$ref": "#/components/schemas/Thread"
          }
        }
      },
      "ThreadsResponse": {
        "type": "object",
        "required": [
          "ok",
          "threads",
          "hasMore",
          "nextCursor",
          "statusCounts",
          "totalCount"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          },
          "threads": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Thread"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "hasMore": {
            "type": "boolean"
          },
          "statusCounts": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "queued": {
                "type": "integer",
                "minimum": 0
              },
              "running": {
                "type": "integer",
                "minimum": 0
              },
              "waiting": {
                "type": "integer",
                "minimum": 0
              },
              "blocked": {
                "type": "integer",
                "minimum": 0
              },
              "ready": {
                "type": "integer",
                "minimum": 0
              },
              "failed": {
                "type": "integer",
                "minimum": 0
              },
              "archived": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "totalCount": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "UserSummary": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "image": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Message": {
        "type": "object",
        "required": [
          "id",
          "threadId",
          "role",
          "content",
          "createdAt",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "threadId": {
            "type": "string"
          },
          "runId": {
            "type": [
              "string",
              "null"
            ]
          },
          "queuedAfterRunId": {
            "type": [
              "string",
              "null"
            ]
          },
          "authorUserId": {
            "type": [
              "string",
              "null"
            ]
          },
          "author": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/UserSummary"
              },
              {
                "type": "null"
              }
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant",
              "system",
              "tool"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "chat",
              "thinking",
              "tool",
              "status"
            ]
          },
          "content": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "toolCallId": {
            "type": "string"
          },
          "toolName": {
            "type": "string"
          },
          "checkpointId": {
            "type": "string"
          },
          "metadata": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": true
          }
        }
      },
      "TranscriptAttachment": {
        "type": "object",
        "required": [
          "name",
          "contentType"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "contentType": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Signed public URL, present only when the organization allows public media. Expires at urlExpiresAt."
          },
          "urlExpiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TranscriptMessageEntry": {
        "type": "object",
        "required": [
          "type",
          "id",
          "role",
          "author",
          "createdAt",
          "content"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "const": "message"
          },
          "id": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ]
          },
          "author": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "content": {
            "type": "string"
          },
          "attachments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TranscriptAttachment"
            }
          }
        }
      },
      "TranscriptToolCallEntry": {
        "type": "object",
        "required": [
          "type",
          "id",
          "createdAt",
          "toolName",
          "label",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "const": "tool_call"
          },
          "id": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": "string",
            "format": "date-time"
          },
          "toolName": {
            "type": "string"
          },
          "label": {
            "type": "string",
            "description": "Human-readable one-liner matching the thread timeline, for example `Ran `pnpm test` (exit 0)`."
          },
          "status": {
            "type": "string",
            "enum": [
              "running",
              "completed",
              "failed",
              "rejected"
            ]
          },
          "input": {
            "type": "string",
            "description": "Redacted tool input; only present at the full level."
          },
          "output": {
            "type": "string",
            "description": "Redacted tool output; only present at the full level."
          },
          "error": {
            "type": "string"
          }
        }
      },
      "TranscriptThinkingEntry": {
        "type": "object",
        "required": [
          "type",
          "id",
          "createdAt",
          "content"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "const": "thinking"
          },
          "id": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "content": {
            "type": "string"
          }
        }
      },
      "TranscriptCompactionEntry": {
        "type": "object",
        "required": [
          "type",
          "id",
          "createdAt",
          "status",
          "summary"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "const": "compaction"
          },
          "id": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "failed"
            ]
          },
          "summary": {
            "type": "string",
            "description": "Model-context summary, explicitly marked so it is never mistaken for an answer."
          }
        }
      },
      "TranscriptModelEntry": {
        "type": "object",
        "required": [
          "type",
          "id",
          "createdAt",
          "modelId"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "const": "model"
          },
          "id": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "modelId": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "requestedModelId": {
            "type": "string",
            "description": "Present when the run resolved a different model than requested."
          }
        }
      },
      "TranscriptFailureEntry": {
        "type": "object",
        "required": [
          "type",
          "id",
          "createdAt",
          "code",
          "message"
        ],
        "additionalProperties": false,
        "properties": {
