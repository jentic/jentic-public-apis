    "/api/service-accounts": {
      "get": {
        "security": [
          {
            "SessionCookie": []
          }
        ],
        "operationId": "listServiceAccounts",
        "tags": [
          "Service accounts"
        ],
        "summary": "List service accounts",
        "description": "Requires a current owner/admin browser session.",
        "parameters": [
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
