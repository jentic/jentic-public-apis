    "/api/events/head": {
      "get": {
        "security": [
          {
            "ApiKey": []
          },
          {
            "BearerApiKey": []
          }
        ],
        "operationId": "getEventHead",
        "tags": [
          "Events"
        ],
        "summary": "Capture the event publication cursor",
        "description": "Capture this cursor before reading resource snapshots, then replay from it and deduplicate by event ID. Cursors are bound to the org and projectId/threadId/runId/types filters.",
        "x-required-permission": "thread:read",
        "x-required-permissions": [
          "thread:read"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "projectId",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "threadId",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "runId",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "types",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Comma-separated event types; reuse identical filters with the returned cursor."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "const": true
                    },
                    "cursor": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "ok",
                    "cursor"
                  ]
                },
                "example": {
                  "ok": true,
                  "cursor": "opaque-cursor"
                }
              }
            },
            "headers": {
              "RateLimit": {
                "description": "Current ingress policy, remaining requests, and seconds until reset, for example `\"ingress\";r=599;t=60`.",
