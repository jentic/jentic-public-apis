    "/api/source-control/github/repositories/{id}/inspect": {
      "get": {
        "security": [
          {
            "ApiKey": []
          },
          {
            "BearerApiKey": []
          }
        ],
        "operationId": "inspectGitHubRepository",
        "tags": [
          "Repositories"
        ],
        "summary": "Inspect a repository",
        "description": "Detect the repository's framework and read its versioned Hoplite sandbox settings before creating a project.",
        "x-required-permission": "repo:read",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The Hoplite repository ID.",
            "example": "repo_987654321",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Repository inspection result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RepositoryInspectionResponse"
                },
                "example": {
                  "ok": true,
                  "inspection": {
                    "framework": "turborepo",
                    "settings": {
                      "path": ".hoplite/settings.json",
                      "previewPort": 3000,
                      "invalid": false,
                      "scripts": {
                        "setup": {
                          "enabled": true,
                          "command": "pnpm install"
                        },
                        "run": {
                          "enabled": true,
                          "command": "pnpm dev"
                        },
                        "archive": {
                          "enabled": false,
                          "command": null
                        }
                      }
                    }
