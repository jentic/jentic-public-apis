              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "const": true
                    },
                    "accounts": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "orgId": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "permissions": {
                            "type": "object",
                            "properties": {
                              "project": {
                                "maxItems": 4,
                                "type": "array",
                                "items": {
                                  "type": "string",
                                  "enum": [
                                    "create",
                                    "read",
                                    "update",
                                    "delete"
                                  ]
                                }
                              },
                              "thread": {
                                "maxItems": 6,
                                "type": "array",
                                "items": {
                                  "type": "string",
                                  "enum": [
                                    "create",
                                    "read",
                                    "update",
                                    "delete",
                                    "stop",
                                    "retry"
                                  ]
                                }
                              },
                              "repo": {
                                "maxItems": 2,
                                "type": "array",
                                "items": {
                                  "type": "string",
                                  "enum": [
                                    "read",
                                    "update"
                                  ]
                                }
                              },
                              "mcpServer": {
                                "maxItems": 4,
                                "type": "array",
                                "items": {
                                  "type": "string",
                                  "enum": [
                                    "create",
                                    "read",
                                    "update",
                                    "delete"
                                  ]
                                }
                              },
                              "modelKey": {
                                "maxItems": 1,
                                "type": "array",
                                "items": {
                                  "type": "string",
                                  "enum": [
                                    "read"
                                  ]
                                }
                              },
                              "usage": {
                                "maxItems": 1,
                                "type": "array",
                                "items": {
                                  "type": "string",
                                  "enum": [
                                    "read"
                                  ]
                                }
                              },
                              "webhook": {
                                "maxItems": 4,
                                "type": "array",
                                "items": {
                                  "type": "string",
                                  "enum": [
                                    "create",
                                    "read",
                                    "update",
                                    "delete"
                                  ]
                                }
                              },
                              "automation": {
                                "maxItems": 5,
                                "type": "array",
                                "items": {
                                  "type": "string",
                                  "enum": [
                                    "create",
                                    "read",
                                    "update",
                                    "delete",
                                    "run"
                                  ]
                                }
                              }
