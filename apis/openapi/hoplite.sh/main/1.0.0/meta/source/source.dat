                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "latestSourceId": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "id": {
                          "type": "string"
                        },
                        "projectId": {
                          "type": "string"
                        },
                        "modelId": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "githubPullRequestNumber": {
                          "anyOf": [
                            {
                              "type": "integer",
                              "exclusiveMinimum": 0,
                              "maximum": 9007199254740991
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "title": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "status": {
                          "default": "queued",
                          "type": "string",
                          "enum": [
                            "queued",
                            "running",
                            "waiting",
                            "blocked",
                            "ready",
                            "failed",
                            "archived"
                          ]
                        },
                        "archivedAt": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "initializationState": {
                          "type": "string",
                          "enum": [
                            "accepted",
                            "preparing",
                            "completed",
                            "failed",
                            "cancelled"
                          ]
                        },
                        "initializationPhase": {
                          "anyOf": [
