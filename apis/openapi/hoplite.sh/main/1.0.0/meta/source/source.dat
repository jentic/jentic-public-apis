    "/api/threads/{id}/pr": {
      "post": {
        "security": [
          {
            "ApiKey": []
          },
          {
            "BearerApiKey": []
          }
        ],
        "operationId": "createPullRequest",
        "tags": [
          "Pull requests"
        ],
        "summary": "Create a pull request",
        "description": "Create a pull request",
        "x-required-permission": "thread:update",
        "x-required-permissions": [
          "thread:update"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "description": "Required for writes authenticated by a service credential and for service-account lifecycle writes. Other session writes may opt in. Reuse the key and payload for retries. Settled keys remain reserved for at least seven days; a transient 4xx releases its key. Changed payloads return 409. Match any legacy clientOperationId/clientMessageId in the body.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "title": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "body": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "draft": {
                    "type": "boolean"
                  },
                  "clientOperationId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  }
                }
              },
              "example": {
                "title": "Factory change",
                "draft": true
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "const": true
                    },
                    "pullRequest": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "threadId": {
                          "type": "string"
                        },
                        "number": {
                          "type": "number"
                        },
                        "url": {
                          "type": "string"
                        },
                        "repoFullName": {
                          "type": "string"
                        },
                        "state": {
                          "type": "string"
                        },
                        "headRef": {
                          "type": "string"
                        },
                        "headSha": {
                          "type": "string"
                        },
                        "baseRef": {
                          "type": "string"
                        },
                        "draft": {
                          "type": "boolean"
                        },
                        "version": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "githubSummary": {
                          "anyOf": [
                            {
                              "type": "object",
                              "properties": {
                                "state": {
                                  "type": "string"
                                },
                                "draft": {
                                  "default": false,
                                  "type": "boolean"
                                },
                                "mergeable": {
                                  "default": "unknown",
                                  "type": "string",
                                  "enum": [
                                    "mergeable",
                                    "conflicting",
                                    "unknown"
                                  ]
                                },
                                "mergeQueued": {
                                  "type": "boolean"
                                },
