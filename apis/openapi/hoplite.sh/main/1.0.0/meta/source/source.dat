              "completed",
              "failed",
              "interrupted"
            ]
          },
          "prompt": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "entries": {
            "type": "array",
            "description": "Nested child transcript; populated only at the full level when subagents are included.",
            "items": {
              "$ref": "#/components/schemas/TranscriptEntry"
            }
          }
        }
      },
