    "/api/threads": {
      "get": {
        "security": [
          {
            "ApiKey": []
          },
          {
            "BearerApiKey": []
          }
        ],
        "operationId": "listThreads",
        "tags": [
          "Threads"
        ],
        "summary": "List threads",
        "description": "List threads by recent user activity, newest first. Supply the opaque nextCursor value unchanged to continue pagination.",
        "x-required-permission": "thread:read",
        "parameters": [
          {
            "name": "projectId",
            "in": "query",
            "description": "Return threads from one project.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Return threads in one lifecycle status.",
            "schema": {
              "$ref": "#/components/schemas/ThreadStatus"
            }
          },
          {
            "name": "archived",
            "in": "query",
            "description": "Filter by archive state.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "q",
            "in": "query",
            "description": "Search thread titles.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Page size, from 1 to 100.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 100
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque cursor returned by the previous page.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of threads.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ThreadsResponse"
