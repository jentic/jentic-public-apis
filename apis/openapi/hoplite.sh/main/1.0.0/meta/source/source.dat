                                "checksAvailable": {
                                  "default": false,
                                  "type": "boolean"
                                },
                                "commentsAvailable": {
                                  "default": false,
                                  "type": "boolean"
                                },
                                "unresolvedCount": {
                                  "type": "integer",
                                  "minimum": 0,
