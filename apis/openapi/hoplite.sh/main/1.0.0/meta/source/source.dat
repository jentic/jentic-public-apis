    "/api/operations/{id}": {
      "get": {
        "security": [
          {
            "ApiKey": []
          },
          {
            "BearerApiKey": []
          }
        ],
        "operationId": "getApiOperation",
        "tags": [
          "Operation receipts"
        ],
        "summary": "Read a write receipt",
        "description": "Scoped to the organization and stable calling principal. Settled receipts are retained for at least seven days, after which their keys can be reused. Retrying an unsettled key reconciles it: a resource the first request created settles the receipt, and proven absence lets the same key dispatch again. This receipt records HTTP dispatch; a 202 result still requires reading its run or resource until the underlying work completes.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "const": true
                    },
                    "operation": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "operation": {
                          "type": "string"
                        },
                        "reconciliation": {
                          "anyOf": [
                            {
                              "type": "object",
                              "properties": {
                                "kind": {
                                  "type": "string"
                                },
                                "id": {
                                  "type": "string"
                                },
                                "threadId": {
                                  "type": "string"
                                },
