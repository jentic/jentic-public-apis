    "/api/threads/{id}/diff": {
      "get": {
        "security": [
          {
            "ApiKey": []
          },
          {
            "BearerApiKey": []
          }
        ],
        "operationId": "getThreadDiff",
        "tags": [
          "Diffs and checkpoints"
        ],
        "summary": "Read the managed workspace diff",
        "description": "Use mode=uncommitted, mode=base or mode=pr to select the diff projection.",
        "x-required-permission": "thread:read",
        "x-required-permissions": [
          "thread:read"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "mode",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "uncommitted",
                "base",
                "pr"
              ],
              "default": "uncommitted"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "const": true
                    },
                    "diff": {
                      "type": "object",
                      "properties": {
                        "threadId": {
                          "type": "string"
                        },
                        "mode": {
                          "type": "string",
                          "enum": [
                            "uncommitted",
                            "base",
                            "pr"
                          ]
                        },
                        "files": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "path": {
                                "type": "string"
                              },
                              "previousPath": {
                                "type": "string"
                              },
                              "state": {
                                "default": "modified",
                                "type": "string",
                                "enum": [
                                  "added",
                                  "modified",
                                  "deleted",
                                  "renamed",
                                  "copied",
                                  "unmerged",
                                  "unknown"
                                ]
                              },
                              "additions": {
                                "default": 0,
                                "type": "number"
                              },
                              "deletions": {
                                "default": 0,
                                "type": "number"
                              },
                              "patch": {
                                "default": "",
                                "type": "string"
                              },
                              "truncated": {
                                "type": "boolean"
                              },
                              "truncatedReason": {
                                "type": "string",
                                "enum": [
                                  "file_too_large",
                                  "snapshot_too_large",
                                  "binary",
                                  "generated"
                                ]
                              },
                              "byteSize": {
                                "type": "number"
                              },
                              "sha": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "path"
                            ]
                          }
                        },
                        "stats": {
                          "type": "object",
                          "properties": {
                            "files": {
                              "type": "number"
                            },
                            "additions": {
                              "type": "number"
                            },
                            "deletions": {
                              "type": "number"
                            }
                          },
                          "required": [
                            "files",
                            "additions",
                            "deletions"
                          ]
                        },
                        "source": {
                          "type": "string"
                        },
                        "effectiveMode": {
                          "type": "string",
                          "enum": [
                            "uncommitted",
                            "base",
                            "pr"
                          ]
                        },
                        "isFallback": {
                          "type": "boolean"
                        },
                        "unavailableReason": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "threadId",
                        "mode",
                        "files"
                      ]
                    }
                  },
                  "required": [
                    "ok",
                    "diff"
                  ]
                },
                "example": {
                  "ok": true,
                  "diff": {
                    "threadId": "thread_example",
                    "mode": "base",
                    "files": [
