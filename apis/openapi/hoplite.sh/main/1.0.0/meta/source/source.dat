    "/api/threads/{id}/attachments/presign": {
      "post": {
        "security": [
          {
            "ApiKey": []
          },
          {
            "BearerApiKey": []
          }
        ],
        "operationId": "presignThreadAttachment",
        "tags": [
          "Attachments"
        ],
        "summary": "Prepare a direct attachment upload",
        "description": "PUT the bytes to uploadUrl without Hoplite authentication and with the exact returned contentType, which may be normalized from the filename. Then confirm the signed ticket for an existing thread. Use id=initial and initialClientOperationId for a new thread; pass the ticket in initialAttachmentTickets when creating that thread.",
        "x-required-permission": "thread:update",
        "x-required-permissions": [
          "thread:update"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "projectId",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Required when id=initial for a project-restricted service account."
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "description": "Required for writes authenticated by a service credential and for service-account lifecycle writes. Other session writes may opt in. Reuse the key and payload for retries. Settled keys remain reserved for at least seven days; a transient 4xx releases its key. Changed payloads return 409. Match any legacy clientOperationId/clientMessageId in the body.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "filename": {
                    "type": "string",
                    "minLength": 1
                  },
                  "contentType": {
                    "type": "string",
                    "minLength": 1
                  },
                  "byteSize": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "width": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "height": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "initialClientOperationId": {
                    "type": "string"
                  }
                },
                "required": [
                  "filename",
                  "contentType",
                  "byteSize"
                ]
              },
              "example": {
                "filename": "requirements.txt",
                "contentType": "text/plain",
                "byteSize": 1024
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "const": true
                    },
                    "upload": {
                      "type": "object",
                      "properties": {
                        "artifactId": {
                          "type": "string"
                        },
                        "ticket": {
                          "type": "string"
                        },
                        "uploadUrl": {
                          "type": "string",
                          "format": "uri"
                        },
                        "contentType": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "artifactId",
                        "ticket",
                        "uploadUrl",
                        "contentType"
                      ]
                    }
                  },
                  "required": [
                    "ok",
                    "upload"
                  ]
                }
              }
            },
            "headers": {
              "RateLimit": {
                "description": "Current ingress policy, remaining requests, and seconds until reset, for example `\"ingress\";r=599;t=60`.",
