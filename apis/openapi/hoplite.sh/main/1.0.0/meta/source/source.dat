    "/api/threads/{id}/preview/access": {
      "get": {
        "security": [
          {
            "ApiKey": []
          },
          {
            "BearerApiKey": []
          }
        ],
        "operationId": "getThreadPreviewAccess",
        "tags": [
          "Previews"
        ],
        "summary": "Issue preview gateway access",
        "description": "Inspect the existing preview without starting it, then receive a fresh five-minute server-only gateway credential for its URL. Start the preview first with startThreadPreview. Supply frameOrigin as the exact HTTPS dashboard origin. Relay HTTP and WebSocket requests through your authenticated backend to preview.url with the credential in X-Hoplite-Preview-Token; never expose it to browsers. Project restrictions are enforced when access is issued; revoking a credential stops new grants but not an unexpired one.",
        "x-required-permission": "thread:read",
        "x-required-permissions": [
          "thread:read"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "frameOrigin",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri",
              "description": "Exact HTTPS dashboard origin, without a path or trailing slash."
            }
          },
          {
            "in": "query",
            "name": "name",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "port",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 3000,
              "maximum": 9999
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "const": true
                    },
                    "preview": {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "string",
                          "enum": [
                            "ready",
                            "unsupported",
                            "reconciling",
                            "blocked",
                            "starting",
                            "stopped",
                            "crashed",
                            "inactive"
                          ]
                        },
                        "name": {
                          "type": "string",
                          "minLength": 1
                        },
                        "port": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 65535
                        },
                        "reason": {
                          "type": "string"
                        },
                        "url": {
                          "type": "string",
                          "format": "uri"
                        },
                        "restart": {
                          "type": "object",
                          "properties": {
                            "launchId": {
                              "type": "string",
                              "minLength": 1
                            },
                            "runId": {
                              "type": "string",
                              "pattern": "^[a-f0-9]{16}$"
                            },
                            "runScriptSha256": {
                              "type": "string",
                              "pattern": "^[a-f0-9]{64}$"
                            }
                          },
                          "required": [
                            "launchId",
                            "runId",
                            "runScriptSha256"
                          ],
                          "additionalProperties": false
                        },
                        "gateway": {
                          "anyOf": [
                            {
                              "type": "object",
                              "properties": {
                                "header": {
                                  "type": "string",
                                  "const": "x-hoplite-preview-token"
                                },
                                "token": {
                                  "type": "string"
                                },
                                "expiresAt": {
                                  "type": "string",
                                  "format": "date-time",
                                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
                                }
                              },
                              "required": [
                                "header",
                                "token",
                                "expiresAt"
                              ]
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": [
                        "status",
                        "gateway"
                      ]
                    }
                  },
                  "required": [
                    "ok",
                    "preview"
                  ]
                },
                "example": {
                  "ok": true,
                  "preview": {
                    "status": "ready",
                    "name": "preview",
                    "port": 3000,
                    "url": "https://preview-token.preview.hoplite.sh/",
                    "gateway": {
                      "header": "x-hoplite-preview-token",
                      "token": "signed-gateway-token",
                      "expiresAt": "2026-09-22T10:05:00.000Z"
                    }
                  }
                }
              }
            },
            "headers": {
              "RateLimit": {
                "description": "Current ingress policy, remaining requests, and seconds until reset, for example `\"ingress\";r=599;t=60`.",
                "schema": {
                  "type": "string"
                }
              },
              "RateLimit-Policy": {
                "description": "Ingress quota and window, for example `\"ingress\";q=600;qu=\"requests\";w=60`.",
                "schema": {
                  "type": "string"
                }
              },
              "X-RateLimit-Limit": {
                "description": "Maximum requests allowed in the current rolling window.",
                "schema": {
                  "type": "integer",
                  "example": 600
                }
              },
              "X-RateLimit-Remaining": {
                "description": "Requests remaining in the current rolling window.",
                "schema": {
                  "type": "integer",
                  "example": 599
                }
              },
              "X-RateLimit-Reset": {
                "description": "Unix timestamp when the current rolling window resets.",
                "schema": {
                  "type": "integer",
                  "example": 1786320060
                }
              },
              "x-request-id": {
                "description": "Request correlation ID.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request. Validation responses include field paths.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "ok": false,
                  "error": "invalid_request"
                }
              }
            },
