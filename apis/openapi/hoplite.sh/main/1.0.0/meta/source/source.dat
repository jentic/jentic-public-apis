    "/api/threads/{id}/attachments/confirm": {
      "post": {
        "security": [
          {
            "ApiKey": []
          },
          {
            "BearerApiKey": []
          }
        ],
        "operationId": "confirmThreadAttachment",
        "tags": [
          "Attachments"
        ],
        "summary": "Persist a staged attachment",
        "description": "Existing threads redeem the ticket and return 201 with the persisted attachment. With id=initial and initialClientOperationId, returns 202 with attachment=null without validating or redeeming the ticket; pass it in initialAttachmentTickets when creating the thread to validate and persist the attachment.",
        "x-required-permission": "thread:update",
        "x-required-permissions": [
          "thread:update"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "projectId",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Required when id=initial for a project-restricted service account."
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "description": "Required for writes authenticated by a service credential and for service-account lifecycle writes. Other session writes may opt in. Reuse the key and payload for retries. Settled keys remain reserved for at least seven days; a transient 4xx releases its key. Changed payloads return 409. Match any legacy clientOperationId/clientMessageId in the body.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "ticket": {
                    "type": "string",
                    "minLength": 1
                  },
                  "width": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "height": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "initialClientOperationId": {
                    "type": "string"
                  }
                },
                "required": [
                  "ticket"
                ]
              },
              "example": {
                "ticket": "signed-upload-ticket"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "const": true
                    },
                    "attachment": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "contentType": {
                          "type": "string"
                        },
                        "byteSize": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "routeId": {
                          "type": "string"
                        },
                        "width": {
                          "type": "number"
                        },
                        "height": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "id",
                        "name",
                        "contentType",
                        "byteSize"
                      ]
                    }
                  },
                  "required": [
                    "ok",
                    "attachment"
                  ]
                }
              }
            },
            "headers": {
              "RateLimit": {
