    "/api/threads/{id}/pr/merge": {
      "post": {
        "security": [
          {
            "ApiKey": []
          },
          {
            "BearerApiKey": []
          }
        ],
        "operationId": "mergePullRequest",
        "tags": [
          "Pull requests"
        ],
        "summary": "Merge or enqueue the expected pull request head",
        "description": "Service-credential merges require a GitHub repository and expectedHeadSha for an atomic head check. Other source-control providers are unsupported for service-credential merges until they offer the same atomic guarantee.",
        "x-required-permission": "repo:update",
        "x-required-permissions": [
          "repo:update"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "description": "Required for writes authenticated by a service credential and for service-account lifecycle writes. Other session writes may opt in. Reuse the key and payload for retries. Settled keys remain reserved for at least seven days; a transient 4xx releases its key. Changed payloads return 409. Match any legacy clientOperationId/clientMessageId in the body.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "expectedHeadSha": {
                    "type": "string",
                    "pattern": "^[a-fA-F0-9]{40,64}$"
                  },
                  "mergeMethod": {
                    "default": "squash",
                    "type": "string",
                    "enum": [
                      "merge",
                      "squash",
                      "rebase"
                    ]
                  },
                  "commitTitle": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "commitMessage": {
                    "type": "string",
                    "maxLength": 65536
                  },
                  "clientOperationId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  }
                },
                "required": [
                  "expectedHeadSha"
                ],
                "additionalProperties": false
              },
              "example": {
                "expectedHeadSha": "0123456789012345678901234567890123456789",
                "mergeMethod": "squash"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "const": true
                    },
                    "mergeResult": {
                      "type": "object",
                      "properties": {
                        "merged": {
                          "type": "boolean"
                        },
                        "queued": {
                          "type": "boolean"
                        },
                        "sha": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "message": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": [
                        "merged"
                      ]
                    }
                  },
                  "required": [
                    "ok",
                    "mergeResult"
                  ]
                }
              }
            },
            "headers": {
              "RateLimit": {
                "description": "Current ingress policy, remaining requests, and seconds until reset, for example `\"ingress\";r=599;t=60`.",
                "schema": {
                  "type": "string"
                }
              },
              "RateLimit-Policy": {
                "description": "Ingress quota and window, for example `\"ingress\";q=600;qu=\"requests\";w=60`.",
                "schema": {
