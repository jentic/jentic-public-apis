                    "type": "string",
                    "minLength": 1,
                    "maxLength": 10000
                  },
                  "clientOperationId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  }
                },
                "required": [
                  "approved"
                ]
              },
              "example": {
                "approved": true
              }
            }
          }
        },
