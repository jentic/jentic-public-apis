                          "items": {
                            "type": "string"
                          }
                        },
                        "pendingWakeups": {
                          "default": 0,
                          "type": "number"
                        },
                        "tasks": {
                          "default": [],
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
