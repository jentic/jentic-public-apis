    "/api/events/stream": {
      "get": {
        "security": [
          {
            "ApiKey": []
          },
          {
            "BearerApiKey": []
          }
        ],
        "operationId": "streamPublicEvents",
        "tags": [
          "Events"
        ],
        "summary": "Stream public events and live drafts",
        "description": "Server-sent events. Resume with Last-Event-ID set to the SSE id field (the JSON event cursor), not the JSON event id. Deduplicate by JSON event id. With threadId, draft frames carry messageId, streamId and revision and replace earlier snapshots; draft.removed clears them. Draft frames have no event cursor or replay guarantee. Heartbeats arrive every 15 seconds, with authorization revalidated at each heartbeat.",
        "x-required-permission": "thread:read",
        "x-required-permissions": [
          "thread:read"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "projectId",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "threadId",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "runId",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "types",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Durable event and replaceable draft frames",
            "headers": {
              "x-request-id": {
                "description": "Request correlation ID.",
                "schema": {
                  "type": "string"
                }
              },
              "RateLimit": {
                "description": "Current ingress policy, remaining requests, and seconds until reset, for example `\"ingress\";r=599;t=60`.",
                "schema": {
                  "type": "string"
                }
              },
              "RateLimit-Policy": {
                "description": "Ingress quota and window, for example `\"ingress\";q=600;qu=\"requests\";w=60`.",
                "schema": {
