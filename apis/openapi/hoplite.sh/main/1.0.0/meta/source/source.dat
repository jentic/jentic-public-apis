      "post": {
        "security": [
          {
            "SessionCookie": []
          }
        ],
        "operationId": "createServiceAccount",
        "tags": [
          "Service accounts"
        ],
        "summary": "Create a service account",
        "description": "Requires a current owner/admin browser session. The credential is returned only once. Retrying returns its identity; rotate if the secret was lost.",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "description": "Required for writes authenticated by a service credential and for service-account lifecycle writes. Other session writes may opt in. Reuse the key and payload for retries. Settled keys remain reserved for at least seven days; a transient 4xx releases its key. Changed payloads return 409. Match any legacy clientOperationId/clientMessageId in the body.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "permissions": {
                    "type": "object",
                    "properties": {
                      "project": {
                        "maxItems": 4,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "create",
                            "read",
                            "update",
                            "delete"
                          ]
                        }
                      },
                      "thread": {
                        "maxItems": 6,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "create",
                            "read",
                            "update",
                            "delete",
                            "stop",
                            "retry"
                          ]
                        }
                      },
                      "repo": {
                        "maxItems": 2,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "read",
                            "update"
                          ]
                        }
                      },
                      "mcpServer": {
                        "maxItems": 4,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "create",
                            "read",
                            "update",
                            "delete"
                          ]
                        }
                      },
                      "modelKey": {
                        "maxItems": 1,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "read"
                          ]
                        }
                      },
                      "usage": {
                        "maxItems": 1,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "read"
                          ]
                        }
                      },
                      "webhook": {
                        "maxItems": 4,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "create",
                            "read",
                            "update",
                            "delete"
                          ]
                        }
                      },
                      "automation": {
                        "maxItems": 5,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "create",
                            "read",
                            "update",
                            "delete",
                            "run"
                          ]
                        }
                      }
                    },
                    "additionalProperties": false
                  },
                  "projectIds": {
                    "default": null,
                    "description": "Restricts resource access to these projects. Organization-wide repository discovery and billing are unavailable with project restrictions; repo:read alone does not enable discovery.",
                    "anyOf": [
                      {
                        "minItems": 1,
                        "maxItems": 100,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        }
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "name",
                  "permissions"
                ],
                "additionalProperties": false
              },
              "example": {
                "name": "Factory worker",
                "permissions": {
                  "project": [
                    "read"
                  ],
                  "thread": [
                    "create",
                    "read",
                    "update"
                  ]
                },
                "projectIds": [
                  "project_example"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "const": true
                    },
