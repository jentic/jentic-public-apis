        "type": "object",
        "required": [
          "id",
          "status",
          "createdAt",
          "entries"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "Run id, or `unattached` for messages that never joined a run."
