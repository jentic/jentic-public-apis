    "/api/threads/{id}/export": {
      "get": {
        "security": [
          {
            "ApiKey": []
          },
          {
            "BearerApiKey": []
          }
        ],
        "operationId": "exportThreadTranscript",
        "tags": [
          "Messages"
        ],
        "summary": "Export a thread transcript",
        "description": "Download a portable transcript of one thread at a chosen detail level. `messages` returns the conversation only; `activity` adds one human-readable line per tool call (no raw payloads); `full` adds redacted tool inputs and outputs, nested subagent transcripts, compaction summaries, model switches, and failures. JSON responses follow the versioned `TranscriptExport` schema; Markdown responses render the same document for people. Responses stream and are served as attachments. This endpoint has a dedicated per-caller budget of 30 exports per minute on top of the ingress rate limit.",
        "x-required-permission": "thread:read",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The Hoplite thread ID.",
            "example": "thr_01JQ7B",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "level",
            "in": "query",
            "description": "Detail level. Defaults to `messages`.",
            "schema": {
              "type": "string",
              "enum": [
                "messages",
                "activity",
                "full"
              ],
              "default": "messages"
            }
          },
          {
            "name": "format",
            "in": "query",
            "description": "Response format. Defaults to `markdown`.",
            "schema": {
              "type": "string",
              "enum": [
                "markdown",
                "json"
              ],
              "default": "markdown"
            }
          },
          {
            "name": "subagents",
            "in": "query",
            "description": "Whether `full` exports nest each subagent's own transcript. Ignored at other levels. Defaults to `true`.",
            "schema": {
              "type": "boolean",
              "default": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The transcript, as JSON (`format=json`) or Markdown (`format=markdown`), delivered with a `Content-Disposition: attachment` header.",
            "headers": {
              "RateLimit": {
                "description": "Current ingress policy, remaining requests, and seconds until reset, for example `\"ingress\";r=599;t=60`.",
                "schema": {
                  "type": "string"
                }
              },
              "RateLimit-Policy": {
                "description": "Ingress quota and window, for example `\"ingress\";q=600;qu=\"requests\";w=60`.",
                "schema": {
                  "type": "string"
                }
              },
              "X-RateLimit-Limit": {
                "description": "Maximum requests allowed in the current rolling window.",
                "schema": {
                  "type": "integer",
                  "example": 600
                }
              },
              "X-RateLimit-Remaining": {
                "description": "Requests remaining in the current rolling window.",
                "schema": {
                  "type": "integer",
                  "example": 599
                }
              },
              "X-RateLimit-Reset": {
                "description": "Unix timestamp when the current rolling window resets.",
                "schema": {
                  "type": "integer",
                  "example": 1786320060
                }
              },
              "x-request-id": {
                "description": "Request correlation ID.",
                "schema": {
                  "type": "string"
                }
              },
              "Content-Disposition": {
                "description": "Attachment filename derived from the thread title, for example `attachment; filename=\"add-checkout-analytics.md\"`.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TranscriptExport"
                },
                "example": {
                  "schemaVersion": 1,
                  "exportedAt": "2026-08-10T08:10:00.000Z",
                  "level": "activity",
                  "includeSubagents": true,
                  "thread": {
