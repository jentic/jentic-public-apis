    "/api/model-providers": {
      "get": {
        "security": [
          {
            "ApiKey": []
          },
          {
            "BearerApiKey": []
          }
        ],
        "operationId": "listModels",
        "tags": [
          "Models"
        ],
        "summary": "Discover authorized models and run capabilities",
        "description": "Service accounts use organization entitlements. A creator's personal model subscription is never inherited.",
        "x-required-permission": "modelKey:read",
        "x-required-permissions": [
          "modelKey:read"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "const": true
                    },
                    "modelConfigurationRevision": {
                      "type": "string"
                    },
                    "providers": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "provider": {
                            "type": "string",
                            "enum": [
                              "openai",
                              "anthropic",
                              "google",
                              "xai",
                              "deepseek",
                              "openrouter"
                            ]
                          },
                          "label": {
                            "type": "string"
                          },
                          "defaultModelId": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "provider",
                          "label",
                          "defaultModelId"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "runConfig": {
                      "type": "object",
                      "properties": {
                        "defaultModelId": {
                          "type": "string",
                          "minLength": 1
                        },
                        "defaultReasoning": {
                          "type": "string",
                          "enum": [
                            "off",
                            "none",
                            "minimal",
                            "low",
                            "medium",
                            "high",
                            "xhigh",
                            "max"
                          ]
                        },
                        "defaultSpeed": {
                          "type": "string",
                          "enum": [
                            "standard",
                            "fast"
                          ]
                        },
                        "defaultsVersion": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        "modelFallbackIds": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "freePlan": {
                          "type": "boolean"
                        },
                        "providerMappingsVersion": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        "reasoningOptions": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "enum": [
                              "off",
                              "none",
                              "minimal",
                              "low",
                              "medium",
                              "high",
                              "xhigh",
                              "max"
                            ]
                          }
                        },
                        "speedOptions": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "enum": [
                              "standard",
                              "fast"
                            ]
                          }
                        }
                      },
                      "required": [
                        "defaultModelId",
                        "defaultReasoning",
                        "defaultSpeed",
                        "defaultsVersion",
                        "modelFallbackIds",
                        "providerMappingsVersion",
                        "reasoningOptions",
                        "speedOptions"
                      ]
                    },
                    "models": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "provider": {
                            "type": "string"
                          },
                          "contextVariantOf": {
                            "type": "string"
                          },
                          "compatibleModelIds": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "requiredPlan": {
                            "type": "string",
                            "const": "pro"
                          },
                          "usageMultiplier": {
                            "type": "number"
                          },
                          "pricing": {
                            "type": "object",
                            "properties": {
                              "inputMicrosPerMTok": {
                                "type": "number"
                              },
                              "outputMicrosPerMTok": {
                                "type": "number"
                              }
                            },
                            "required": [
                              "inputMicrosPerMTok",
                              "outputMicrosPerMTok"
                            ]
                          },
                          "capabilities": {
                            "type": "object",
                            "properties": {
                              "contextWindowTokens": {
                                "type": "number"
                              },
                              "reasoningLevels": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                }
                              },
                              "supportsFast": {
                                "type": "boolean"
                              },
                              "supportsImages": {
                                "type": "boolean"
                              }
                            },
                            "required": [
                              "reasoningLevels",
                              "supportsFast"
                            ]
                          }
                        },
                        "required": [
                          "id",
                          "name",
                          "provider"
                        ]
                      }
                    }
                  },
