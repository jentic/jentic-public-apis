    "/api/service-accounts/{id}": {
      "patch": {
        "security": [
          {
            "SessionCookie": []
          }
        ],
        "operationId": "updateServiceAccount",
        "tags": [
          "Service accounts"
        ],
        "summary": "Restrict or disable a service account",
        "description": "Restrict or disable a service account",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "description": "Required for writes authenticated by a service credential and for service-account lifecycle writes. Other session writes may opt in. Reuse the key and payload for retries. Settled keys remain reserved for at least seven days; a transient 4xx releases its key. Changed payloads return 409. Match any legacy clientOperationId/clientMessageId in the body.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "permissions": {
                    "type": "object",
                    "properties": {
                      "project": {
                        "maxItems": 4,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "create",
                            "read",
                            "update",
                            "delete"
                          ]
                        }
                      },
                      "thread": {
                        "maxItems": 6,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "create",
                            "read",
                            "update",
                            "delete",
                            "stop",
                            "retry"
                          ]
                        }
                      },
                      "repo": {
                        "maxItems": 2,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "read",
                            "update"
                          ]
                        }
                      },
                      "mcpServer": {
                        "maxItems": 4,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "create",
                            "read",
                            "update",
                            "delete"
                          ]
                        }
                      },
                      "modelKey": {
                        "maxItems": 1,
                        "type": "array",
                        "items": {
