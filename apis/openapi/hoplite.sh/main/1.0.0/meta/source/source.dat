                                  "newIssues": {
                                    "default": true,
                                    "type": "boolean"
                                  },
                                  "regressions": {
                                    "default": true,
                                    "type": "boolean"
                                  },
                                  "levels": {
                                    "default": [],
                                    "type": "array",
                                    "items": {
                                      "type": "string",
                                      "enum": [
                                        "fatal",
                                        "error",
                                        "warning",
                                        "info",
                                        "debug"
                                      ]
                                    }
                                  }
                                }
                              },
                              {
                                "type": "null"
                              }
                            ]
