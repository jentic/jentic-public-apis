                                "type": "string",
                                "enum": [
                                  "create",
                                  "read",
                                  "update",
                                  "delete"
                                ]
                              }
                            },
                            "modelKey": {
                              "maxItems": 1,
                              "type": "array",
                              "items": {
                                "type": "string",
                                "enum": [
                                  "read"
                                ]
                              }
                            },
                            "usage": {
                              "maxItems": 1,
                              "type": "array",
                              "items": {
                                "type": "string",
                                "enum": [
                                  "read"
                                ]
                              }
                            },
                            "webhook": {
                              "maxItems": 4,
                              "type": "array",
                              "items": {
                                "type": "string",
                                "enum": [
                                  "create",
                                  "read",
                                  "update",
                                  "delete"
                                ]
