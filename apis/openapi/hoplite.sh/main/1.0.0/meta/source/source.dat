      "TranscriptSubagentEntry": {
        "type": "object",
        "required": [
          "type",
          "id",
          "createdAt",
          "name",
          "status",
          "entries"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "const": "subagent"
          },
          "id": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": "string",
