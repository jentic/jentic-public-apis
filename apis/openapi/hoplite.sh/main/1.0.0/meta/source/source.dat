                    },
                    "required": [
                      "action"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "action": {
                        "type": "string",
                        "const": "reset"
                      },
                      "acceptDataLoss": {
                        "type": "boolean",
                        "const": true
                      }
                    },
                    "required": [
                      "action",
                      "acceptDataLoss"
                    ]
