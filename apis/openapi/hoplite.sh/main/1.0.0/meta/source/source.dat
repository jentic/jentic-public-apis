                      "id": "thr_01JQ7B",
                      "projectId": "proj_01JQ75",
                      "title": "Add checkout analytics",
                      "status": "running",
                      "waitingOn": [],
                      "blockedOn": [],
                      "pendingWakeups": 0,
                      "tasks": [],
                      "pullRequests": []
                    }
                  ],
                  "hasMore": true,
                  "nextCursor": "eyJpZCI6InRocl8wMUpRN0IiLCJyZWNlbmN5QXQiOiIyMDI2...",
                  "statusCounts": {
                    "running": 1,
                    "ready": 12
                  },
                  "totalCount": 13
                }
              }
