                              "maxItems": 4,
                              "type": "array",
                              "items": {
                                "type": "string",
                                "enum": [
                                  "create",
                                  "read",
                                  "update",
                                  "delete"
                                ]
                              }
                            },
                            "thread": {
                              "maxItems": 6,
                              "type": "array",
                              "items": {
                                "type": "string",
                                "enum": [
                                  "create",
                                  "read",
                                  "update",
                                  "delete",
                                  "stop",
                                  "retry"
                                ]
                              }
                            },
                            "repo": {
                              "maxItems": 2,
                              "type": "array",
                              "items": {
                                "type": "string",
                                "enum": [
                                  "read",
                                  "update"
                                ]
                              }
                            },
                            "mcpServer": {
                              "maxItems": 4,
                              "type": "array",
                              "items": {
                                "type": "string",
                                "enum": [
                                  "create",
                                  "read",
                                  "update",
                                  "delete"
                                ]
                              }
                            },
                            "modelKey": {
                              "maxItems": 1,
                              "type": "array",
                              "items": {
                                "type": "string",
                                "enum": [
                                  "read"
                                ]
                              }
                            },
                            "usage": {
                              "maxItems": 1,
                              "type": "array",
                              "items": {
                                "type": "string",
                                "enum": [
                                  "read"
                                ]
                              }
                            },
                            "webhook": {
                              "maxItems": 4,
                              "type": "array",
                              "items": {
                                "type": "string",
                                "enum": [
                                  "create",
                                  "read",
                                  "update",
                                  "delete"
                                ]
                              }
                            },
                            "automation": {
                              "maxItems": 5,
                              "type": "array",
                              "items": {
                                "type": "string",
                                "enum": [
