                                "properties": {
                                  "accessToken": {
                                    "type": "string",
                                    "minLength": 1
                                  },
                                  "access_token": {
                                    "type": "string",
                                    "minLength": 1
                                  },
                                  "expires_at": {
                                    "type": "integer",
                                    "exclusiveMinimum": 0,
                                    "maximum": 9007199254740991
                                  },
                                  "expiresIn": {
                                    "type": "number",
                                    "exclusiveMinimum": 0
                                  },
                                  "expires_in": {
                                    "type": "number",
                                    "exclusiveMinimum": 0
