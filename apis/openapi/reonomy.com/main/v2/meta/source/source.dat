{
  "openapi": "3.0.0",
  "info": {
    "title": "Reonomy Property API (Core)",
    "description": "API for commercial real estate intelligence, focusing on search, resolve, and property details. Bulk feed functionality is excluded.",
    "version": "v2",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/universityofnewhaven/reonomy-property-api-core/v2"
  },
  "servers": [
    {
      "url": "https://api.reonomy.com/v2",
      "description": "Production Reonomy V2 API"
    }
  ],
  "components": {
    "securitySchemes": {
      "BasicAuth": {
        "type": "http",
        "scheme": "basic",
        "description": "HTTP Basic Authentication using a base64 encoded access token.\nThe token is created as base64(access_key:secret_key).\n"
      }
    },
    "schemas": {
      "PropertyIDSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The unique Reonomy ID for the property.",
            "example": "19cd94b6-0b51-543d-bfc1-3ed3205d13ae"
          },
          "location": {
            "type": "object",
            "properties": {
              "lat": {
                "type": "number",
                "format": "float",
                "description": "Property's latitude."
              },
              "lon": {
                "type": "number",
                "format": "float",
                "description": "Property's longitude."
              }
            }
          }
        }
      },
      "PropertyDetails": {
        "type": "object",
        "description": "Detailed information about a commercial property (basic, ownership, sales, etc.)",
        "properties": {
          "property_id": {
            "type": "string",
            "example": "19cd94b6-0b51-543d-bfc1-3ed3205d13ae"
          },
          "address_line1": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "basic": {
            "type": "object",
            "description": "Basic property information."
          },
          "sales": {
            "type": "array",
            "description": "Array of sales records.",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "SearchSettings": {
        "type": "object",
        "description": "Search criteria for filtering properties.",
        "properties": {
          "city": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of cities to search in.",
            "example": [
              "New York"
            ]
          },
          "state": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of states to search in (2-letter abbreviation).",
            "example": [
              "NY"
            ]
          },
          "building_area": {
            "type": "object",
            "properties": {
              "min": {
                "type": "number",
                "description": "Minimum building area in square feet."
              },
              "max": {
                "type": "number",
                "description": "Maximum building area in square feet."
              }
            },
            "example": {
              "min": 100000
            }
          }
        }
      },
      "ResolvePropertyInput": {
        "type": "object",
        "properties": {
          "address_line1": {
            "type": "string",
            "description": "Street address line 1.",
            "example": "123 Main St"
          },
          "city": {
            "type": "string",
            "description": "City name.",
            "example": "New Haven"
          },
          "state": {
            "type": "string",
            "description": "State abbreviation (e.g., CT).",
            "example": "CT"
          }
        }
      },
      "BulkPropertyDetailsRequest": {
        "type": "object",
        "required": [
          "property_ids",
          "detail_type"
        ],
        "properties": {
          "property_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 250,
            "description": "List of Reonomy property IDs to fetch.",
            "items": {
              "type": "string",
              "example": "19cd94b6-0b51-543d-bfc1-3ed3205d13ae"
            }
          },
          "detail_type": {
            "type": "array",
            "description": "Which detail sections to include.",
            "items": {
              "type": "string",
              "enum": [
                "basic",
                "taxes",
                "sales",
                "mortgages",
                "ownership",
                "tenants",
                "reported_owner"
              ]
            }
          },
          "filter_pii": {
            "type": "boolean",
            "description": "If true, personally identifiable information is filtered when available.",
            "default": false
          }
        }
      },
      "BulkPropertyDetailsItem": {
        "type": "object",
        "description": "One property’s details as returned by /property/bulk. This schema is intentionally permissive.",
        "properties": {
          "property_id": {
            "type": "string",
            "description": "Reonomy property ID",
            "example": "19cd94b6-0b51-543d-bfc1-3ed3205d13ae"
          },
          "active": {
            "type": "boolean"
          },
          "address_line1": {
            "type": "string",
            "example": "767 3RD AVE"
          },
          "city": {
            "type": "string",
            "example": "NEW YORK"
          },
          "state": {
            "type": "string",
            "example": "NY"
          },
          "zip5": {
            "type": "string",
            "example": "10017"
          },
          "apn": {
            "type": "string",
            "example": "1-1321-47"
          },
          "asset_category": {
            "type": "string",
            "example": "Office"
          },
          "year_built": {
            "type": "integer",
            "example": 1980
          },
          "year_renovated": {
            "type": "integer",
            "nullable": true
          },
          "building_area": {
            "type": "number",
            "example": 286212
          },
          "total_units": {
            "type": "integer",
            "example": 40
          },
          "location": {
            "type": "object",
            "properties": {
              "lat": {
                "type": "number"
              },
              "lon": {
                "type": "number"
              }
            }
          },
          "taxes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "year": {
                  "type": "integer",
                  "example": 2020
                },
                "amount": {
                  "type": "number",
                  "example": 4897807.08
                },
                "total_assessed_value": {
                  "type": "number",
                  "nullable": true
                },
                "total_market_value": {
                  "type": "number",
                  "nullable": true
                },
                "tax_rate": {
                  "type": "number",
                  "nullable": true
                },
                "tax_bill_link": {
                  "type": "string",
                  "format": "uri",
                  "nullable": true
                }
              }
            }
          },
          "sales": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sales_id": {
                  "type": "string"
                },
                "sale_date": {
                  "type": "string",
                  "format": "date",
                  "nullable": true
                },
                "recording_date": {
                  "type": "string",
                  "format": "date",
                  "nullable": true
                },
                "sale_amount": {
                  "type": "number",
                  "nullable": true
                },
                "document_type": {
                  "type": "string",
                  "nullable": true
                },
                "buyers": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "sellers": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "parcel_shape_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "paths": {
    "/search/summaries": {
      "post": {
        "summary": "Search for properties and retrieve property IDs and coordinates.",
        "operationId": "searchPropertiesSummaries",
        "security": [
          {
            "BasicAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "limit": {
                    "type": "integer",
                    "description": "Maximum number of results to return (up to 10,000).",
                    "default": 10
                  },
                  "settings": {
                    "$ref": "#/components/schemas/SearchSettings"
                  }
                },
                "required": [
                  "settings"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "List of matching property IDs and locations.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "count": {
                      "type": "integer",
                      "description": "Total number of properties matching the criteria."
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/PropertyIDSummary"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized request (Missing or invalid access token)."
          }
        }
      }
    },
    "/property/bulk": {
      "post": {
        "summary": "Get details for multiple properties (up to 250 per call) with coustmize details.",
        "description": "Returns detailed data for the requested property IDs. Choose the detail sections you need via `detail_type`.\nThis mirrors the Python example you provided.\n",
        "operationId": "getBulkPropertyDetails",
        "security": [
          {
            "BasicAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkPropertyDetailsRequest"
              },
              "examples": {
                "sample": {
                  "summary": "Basic + taxes + sales for one property",
                  "value": {
                    "property_ids": [
                      "19cd94b6-0b51-543d-bfc1-3ed3205d13ae"
                    ],
                    "detail_type": [
                      "basic",
                      "taxes",
                      "sales"
                    ],
                    "filter_pii": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Array of property detail objects (one per requested ID).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BulkPropertyDetailsItem"
                  }
                },
                "examples": {
                  "truncated": {
                    "value": [
                      {
                        "property_id": "19cd94b6-0b51-543d-bfc1-3ed3205d13ae",
                        "address_line1": "767 3RD AVE",
                        "city": "NEW YORK",
                        "state": "NY",
                        "asset_category": "Office",
                        "building_area": 286212,
                        "location": {
                          "lat": 40.75419967294353,
                          "lon": -73.97133902381856
                        },
                        "taxes": [
                          {
                            "year": 2020,
                            "amount": 4897807.08,
                            "total_assessed_value": 46772550
                          }
                        ],
                        "sales": [
                          {
                            "sale_date": "2017-12-27",
                            "recording_date": "2018-01-11",
                            "sale_amount": 0,
                            "document_type": "Deed"
                          }
                        ]
                      }
                    ]
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized request (Missing or invalid access token)."
          }
        }
      }
    }
  }
}
