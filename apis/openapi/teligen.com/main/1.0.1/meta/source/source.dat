{
  "openapi": "3.0.3",
  "info": {
    "title": "Teligen CAMARA API",
    "version": "1.0.1",
    "description": "# Introduction\n\nThe Teligen CAMARA API provides access to telecommunications network capabilities for fraud prevention and identity verification.\n\n## Key Features\n\n- **SIM Swap Detection**: Identify recent SIM card changes to prevent fraud\n- **Real-time Verification**: Instant responses for time-sensitive security decisions\n- **Enterprise-grade Security**: HMAC-based authentication\n",
    "contact": {
      "name": "Teligen API Support",
      "email": "api-support@teligen.com"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/developer-b89/Simswap/1.0.1"
  },
  "servers": [
    {
      "url": "https://api.teligen.com",
      "description": "Production Server"
    }
  ],
  "tags": [
    {
      "name": "SIM Swap",
      "description": "Detect SIM card changes to prevent fraud and account takeover attacks."
    }
  ],
  "security": [
    {
      "hmacAuth": []
    }
  ],
  "paths": {
    "/api/SimSwap/Post": {
      "post": {
        "tags": [
          "SIM Swap"
        ],
        "operationId": "checkSimSwap",
        "summary": "Check SIM Swap Status",
        "description": "Check if a SIM swap has occurred for a phone number within a specified time period.\n\n**Response Interpretation:**\n- `match: true` - SIM swap detected (potential fraud risk)\n- `match: false` - No SIM swap detected (lower risk)\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SimSwapRequest"
              },
              "example": {
                "phoneNumber": "+14155551234",
                "maxAge": 240
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimSwapResponse"
                },
                "examples": {
                  "swapDetected": {
                    "summary": "SIM swap detected",
                    "value": {
                      "success": true,
                      "messages": [
                        {
                          "code": "OK",
                          "message": "SIM swap check completed successfully"
                        }
                      ],
                      "result": {
                        "match": true,
                        "lastSimChange": "2025-01-25T14:30:00Z",
                        "age": 96,
                        "message": "SIM change detected within specified age",
                        "currentCarrier": "Verizon Wireless"
                      }
                    }
                  },
                  "noSwap": {
                    "summary": "No SIM swap detected",
                    "value": {
                      "success": true,
                      "messages": [
                        {
                          "code": "OK",
                          "message": "SIM swap check completed successfully"
                        }
                      ],
                      "result": {
                        "match": false,
                        "lastSimChange": "2024-06-15T09:00:00Z",
                        "age": 5400,
                        "message": "No SIM change detected within specified age",
                        "currentCarrier": "AT&T Mobility"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          },
          "403": {
            "description": "Access forbidden (IP not whitelisted or service access denied)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForbiddenError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "hmacAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Auth-Signature",
        "description": "## HMAC Authentication\n\nEvery request requires three headers:\n\n| Header | Description |\n|--------|-------------|\n| `X-Account-Sid` | Your account identifier |\n| `X-Auth-Nonce` | Unique random string (8-128 chars) |\n| `X-Auth-Signature` | `Base64(SHA256(AccountSid + Nonce + AuthToken))` |\n\n### Code Examples\n\n**Python**\n```python\nimport hashlib, base64, uuid\n\ndef get_headers(account_sid, auth_token):\n    nonce = str(uuid.uuid4())\n    data = account_sid + nonce + auth_token\n    signature = base64.b64encode(hashlib.sha256(data.encode()).digest()).decode()\n    return {\n        'X-Account-Sid': account_sid,\n        'X-Auth-Nonce': nonce,\n        'X-Auth-Signature': signature\n    }\n```\n\n**JavaScript**\n```javascript\nconst crypto = require('crypto');\n\nfunction getHeaders(accountSid, authToken) {\n    const nonce = crypto.randomUUID();\n    const signature = crypto.createHash('sha256')\n        .update(accountSid + nonce + authToken)\n        .digest('base64');\n    return {\n        'X-Account-Sid': accountSid,\n        'X-Auth-Nonce': nonce,\n        'X-Auth-Signature': signature\n    };\n}\n```\n"
      }
    },
    "schemas": {
      "SimSwapRequest": {
        "type": "object",
        "required": [
          "phoneNumber"
        ],
        "properties": {
          "phoneNumber": {
            "type": "string",
            "description": "Phone number in E.164 format",
            "example": "+14155551234"
          },
          "maxAge": {
            "type": "integer",
            "description": "Time window in hours to check (default 240 = 10 days)",
            "default": 240,
            "example": 240
          }
        }
      },
      "SimSwapResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "result": {
            "type": "object",
            "properties": {
              "match": {
                "type": "boolean",
                "description": "True if SIM swap detected within maxAge"
              },
              "lastSimChange": {
                "type": "string",
                "format": "date-time"
              },
              "age": {
                "type": "integer",
                "description": "Hours since last SIM change"
              },
              "message": {
                "type": "string"
              },
              "currentCarrier": {
                "type": "string"
              }
            }
          }
        }
      },
      "AuthError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "invalid_credentials"
          },
          "message": {
            "type": "string",
            "example": "Invalid AccountSid or signature."
          }
        }
      },
      "ForbiddenError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "ip_not_whitelisted"
          },
          "message": {
            "type": "string",
            "example": "Your IP address is not whitelisted for this account."
          }
        }
      }
    }
  }
}
