    "/orders/{orderId}/{subOrderId}/invoice": {
      "post": {
        "operationId": "InvoiceController_upload",
        "summary": "",
        "description": "Upload invoice(s) for the order of the merchant identified by `id`",
        "parameters": [
          {
            "name": "orderId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "subOrderId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "customerId",
            "required": false,
            "in": "query",
            "allowEmptyValue": true,
            "description": "ID of the customer (not for guest orders)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/FilesUploadDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The order-invoice PDF file uploaded and was saved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Invoice"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpExceptionDto"
                }
              }
            }
          },
          "415": {
            "description": "This endpoint accepts PDF files only",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpExceptionDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ]
      }
    },
    "/orders/{orderId}/invoice/{invoiceId}": {
      "get": {
        "operationId": "InvoiceController_getOneById",
        "summary": "",
        "description": "Get invoice record for order identified by `id`",
        "parameters": [
          {
            "name": "orderId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "invoiceId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Invoice"
                }
              }
            }
          },
          "400": {
            "description": "`id` parameter is not an UUID or missing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpExceptionDto"
                }
              }
            }
          },
          "404": {
            "description": "Invoice not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpExceptionDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ]
      },
      "delete": {
        "operationId": "InvoiceController_deleteOneById",
        "summary": "",
        "description": "Delete order-invoice of order identified by `id`",
        "parameters": [
          {
            "name": "orderId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "invoiceId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "The order-invoice has been successfully deleted"
          },
          "400": {
            "description": "`id` parameter is not an UUID or missing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpException"
                }
              }
            }
          },
          "404": {
            "description": "Invoice not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpException"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ]
      }
    },
    "/orders/{orderId}/invoice/{invoiceId}/file": {
      "get": {
        "operationId": "InvoiceController_getFileByInvoiceId",
        "summary": "",
        "description": "Download invoice file for invoice record",
        "parameters": [
          {
            "name": "orderId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "invoiceId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "application/json": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "`orderId` or `invoiceId` parameter is not an UUID or missing",
            "content": {
              "application/pdf": {
                "schema": {
                  "$ref": "#/components/schemas/HttpExceptionDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpExceptionDto"
                }
              }
            }
          },
          "404": {
            "description": "Invoice record not found",
            "content": {
