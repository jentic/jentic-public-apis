      "DiscountDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "productVariantBusinessId": {
            "type": "string"
          },
          "businessId": {
            "type": "string"
          },
          "categoryId": {
            "type": "string"
          },
          "available": {
            "$ref": "#/components/schemas/DateRangeDto"
          },
          "type": {
            "type": "string",
            "enum": [
              "PERCENTAGE",
              "FLAT"
            ]
          },
          "reference": {
            "type": "string",
            "enum": [
              "TYPE",
              "DISCOUNTED_NET_PRICE",
              "DISCOUNTED_GROSS_PRICE"
            ],
            "description": "\n    TYPE: percentage or flat was provided based on the chosen type, discountedNetPrices and discountedGrossPrice was calculated;\n    DISCOUNTED_NET_PRICE: discountedNetPrices was provided, percentage/flat and discountedGrossPrices was calculated;\n    DISCOUNTED_GROSS_PRICE: discountedGrossPrices was provided, percentage/flat and discountedNetPrices was calculated;\n    "
          },
          "percentage": {
            "type": "string",
            "description": "\n      This field is for admin and merchants. It is applied to or calculated from the current gross price based on the chosen reference.\n    "
          },
          "percentageCalculatedFromBase": {
            "type": "string",
            "description": "\n      This field is for customers. It is calculated from the base gross price.\n    "
          },
          "flat": {
            "description": "\n      This field is for admin and merchants. It is applied to or calculated from the current gross price based on the chosen reference.\n    ",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PriceDto"
            }
          },
          "flatCalculatedFromBase": {
            "description": "\n      This field is for customers. It is calculated from the base gross price.\n    ",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PriceDto"
            }
          },
          "baseNetPrices": {
            "description": "\n      Lowest net price on predefined duration.\n    ",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PriceDto"
            }
          },
          "baseGrossPrices": {
            "description": "\n      Lowest net price on predefined duration.\n    ",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PriceDto"
            }
          },
          "discountedNetPrices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PriceDto"
            }
          },
          "discountedGrossPrices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PriceDto"
            }
          }
        },
        "required": [
          "id",
          "productVariantBusinessId",
          "businessId",
          "categoryId",
          "available",
          "type",
          "reference"
        ]
      },
