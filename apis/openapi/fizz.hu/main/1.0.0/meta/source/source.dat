      "patch": {
        "operationId": "MerchantApiImportController_setNetPrices",
        "summary": "",
        "description": "Sets net prices field of a price list. If both `currency` and `amount` is given, it adds or updates the price. If only `currency` is given, price with given `currency` will be removed.",
