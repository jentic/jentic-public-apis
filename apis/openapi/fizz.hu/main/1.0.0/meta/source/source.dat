{
  "openapi": "3.0.0",
  "servers": [
    {
      "url": "https://merchant-api.demo.fizz.hu/api/v1/",
      "description": "Merchant environment"
    }
  ],
  "info": {
    "title": "Merchant API documentation",
    "version": "1.0.0",
    "description": "Swagger Documentation for OTP Marketplace Merchant API. IMPORTANT!!!! Please append 'businessId' query parameter for all requests, unless it is not required. Value for 'businessId' can be extracted from access_token's paylod from open_cart.businessId path",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/BRAZDAJOZSEF/merchant-api-documentation/1.0.0"
  },
  "paths": {
    "/product": {
      "get": {
        "operationId": "listProducts",
        "summary": "",
        "description": "List products matching the query.",
        "parameters": [
          {
            "name": "skip",
            "required": true,
            "in": "query",
            "schema": {
              "default": 0,
              "type": "number"
            }
          },
          {
            "name": "take",
            "required": true,
            "in": "query",
            "schema": {
              "default": 0,
              "type": "number"
            }
          },
          {
            "name": "sort",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "arrange",
            "required": false,
            "in": "query",
            "schema": {
              "enum": [
                "DESC",
                "ASC"
              ],
              "type": "string"
            }
          },
          {
            "name": "categoryId",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "searchTerm",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Product found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedProductDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ]
      }
    },
