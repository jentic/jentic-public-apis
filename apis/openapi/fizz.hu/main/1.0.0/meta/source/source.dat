    "/order/orders": {
      "get": {
        "operationId": "SubOrderController_merchantGetOrders",
        "summary": "",
        "description": "Can query Orders of a specific bussiness. Supports searching, pagination and sorting.",
        "parameters": [
          {
            "name": "businessId",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "customerId",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sortBy",
            "required": false,
            "in": "query",
            "schema": {
              "enum": [
                "orderBusinessId",
                "orderPlacedAt",
                "orderFinalizedAt",
                "trackingId",
                "businessName",
                "customerName",
                "grossTotalWithoutShippingInt",
                "numberOfItems",
                "status",
                "paymentStatus"
              ],
              "type": "string"
            }
          },
          {
            "name": "orderBy",
            "required": false,
            "in": "query",
            "schema": {
              "enum": [
                "asc",
                "desc"
              ],
              "type": "string"
            }
          },
          {
            "name": "pageSize",
            "required": false,
            "in": "query",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "search",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "orderStatus",
            "required": false,
            "in": "query",
            "schema": {
              "enum": [
                "COMPLETED",
                "IN_PROGRESS",
                "NEW",
                "CANCELLATION_REQUESTED",
                "FAILED_CANCELLATION",
                "CANCELLED_DUE_CUSTOMER",
                "CANCELLED_DUE_MERCHANT",
                "FAILED_PAYMENT",
                "FAILED_DELIVERY",
                "CLOSED_BY_INCIDENT",
                "SUBMITTED",
                "DELIVERED"
              ],
              "type": "string"
            }
          },
          {
            "name": "paymentStatus",
            "required": false,
            "in": "query",
            "schema": {
              "enum": [
                "PENDING",
                "PAID",
                "EXPIRED",
                "REFUSED",
                "CASH_PAYMENT",
                "UNSUCCESSFUL_PAYMENT",
                "REFUNDED",
                "WAITING_FOR_POS_CONTRIBUTION",
                "WAITING_FOR_POS_CANCELLATION",
                "WAITING_FOR_POS_REFUND"
              ],
              "type": "string"
            }
          },
          {
            "name": "orderPlacedAtGte",
