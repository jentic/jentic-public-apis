{
  "openapi": "3.1.0",
  "info": {
    "title": "AIMentionTracker API",
    "version": "1.0.0",
    "description": "The AI visibility platform to get recommended by AI.\n\nRead how often AI assistants name and cite your brand, and which sites they read instead of yours.\n\nTHREE RULES A CLIENT MUST CARRY, because ignoring them produces confidently wrong reports:\n\n1. `rate: null` means not enough answers yet (below min_sample 5), NOT zero.\n2. Engines are reported separately and never averaged. They disagree, so an average describes no real surface.\n3. An empty /alerts list does NOT mean nothing changed. Findings are suppressed when a move sits inside its own margin of error, which on a small plan is most real moves. GET /me returns the live thresholds.\n\nFailed collections are excluded from denominators rather than counted as absence, so our outages never read as your absence."
  },
  "servers": [
    {
      "url": "https://app.aimentiontracker.ai/api/v1"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "A key from app.aimentiontracker.ai/api-keys, shown once at creation. `Authorization: Bearer <key>` is accepted equivalently. Keys belong to the organisation, not to a person, so they survive that person leaving."
      }
    },
    "schemas": {
      "Rate": {
        "type": "object",
        "properties": {
          "present": {
            "type": "integer",
            "description": "Answers that named this brand."
          },
          "responses": {
            "type": "integer",
            "description": "Answers in the window. The denominator, always returned."
          },
          "rate": {
            "type": [
              "number",
              "null"
            ],
            "description": "present/responses to 3dp, or NULL below min_sample (5). Null means NOT ENOUGH ANSWERS YET and must never be rendered as 0% — doing so reports a collapse in visibility that did not happen."
          },
          "min_sample": {
            "type": "integer",
            "description": "The floor below which rate is null."
          }
        },
        "required": [
          "present",
          "responses",
          "rate",
          "min_sample"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "Stable machine-readable code. Branch on this, not the message."
              },
              "message": {
                "type": "string",
                "description": "Human-readable. Wording may change; the code will not."
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "BrandRef": {
        "type": "object",
        "description": "Which brand a response describes. Present in meta on every data endpoint.",
        "properties": {
          "id": {
            "type": "string",
            "description": "Pass as ?brand=."
          },
          "name": {
            "type": "string",
            "description": "Display name."
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "Engine": {
        "type": "object",
        "description": "One AI engine's numbers. NEVER average these together.",
        "properties": {
          "engine": {
            "type": "string",
            "description": "Stable slug, e.g. chatgpt. Use this for ?engine= filters."
          },
          "name": {
            "type": "string",
            "description": "Display name, e.g. ChatGPT."
          },
          "collection_method": {
            "type": "string",
            "description": "How this surface is read: api, scraper or serp."
          },
          "present": {
            "type": "integer",
            "description": "Answers that named this brand."
          },
          "responses": {
            "type": "integer",
            "description": "Answers in the window. The denominator, always returned."
          },
          "rate": {
            "type": [
              "number",
              "null"
            ],
            "description": "present/responses to 3dp, or NULL below min_sample (5). Null means NOT ENOUGH ANSWERS YET and must never be rendered as 0% — doing so reports a collapse in visibility that did not happen."
          },
          "min_sample": {
            "type": "integer",
            "description": "The floor below which rate is null."
          },
          "citations": {
            "type": "integer",
            "description": "Answers from this engine that cited the brand's own domain."
          },
          "avg_rank_when_named": {
            "type": [
              "number",
              "null"
            ],
            "description": "Mean position in the list WHEN NAMED. Null when never named."
          }
        },
        "required": [
          "engine",
          "name",
          "collection_method",
          "present",
          "responses",
          "rate",
          "min_sample"
        ]
      },
      "BrandVisibility": {
        "type": "object",
        "description": "One tracked brand, pooled across engines. The only place we pool.",
        "properties": {
          "name": {
            "type": "string",
            "description": "Brand name."
          },
          "role": {
            "type": "string",
            "enum": [
              "self",
              "competitor"
            ],
            "description": "Yours, or a rival."
          },
          "present": {
            "type": "integer",
            "description": "Answers that named this brand."
          },
          "responses": {
            "type": "integer",
            "description": "Answers in the window. The denominator, always returned."
          },
          "rate": {
            "type": [
              "number",
              "null"
            ],
            "description": "present/responses to 3dp, or NULL below min_sample (5). Null means NOT ENOUGH ANSWERS YET and must never be rendered as 0% — doing so reports a collapse in visibility that did not happen."
          },
          "min_sample": {
            "type": "integer",
            "description": "The floor below which rate is null."
          },
          "citations": {
            "type": "integer",
            "description": "Answers citing this brand's own domain."
          },
          "avg_rank_when_named": {
            "type": [
              "number",
              "null"
            ],
            "description": "Mean list position when named."
          },
          "framing": {
            "type": "object",
            "description": "How the brand was FRAMED where it appeared. Deliberately not called a sentiment score: it counts cue phrases, it does not grade tone.",
            "properties": {
              "classified": {
                "type": "integer",
                "description": "Mentions we could classify at all. The denominator here."
              },
              "recommended": {
                "type": "integer",
                "description": "Mentions framed as a recommendation."
              },
              "negative": {
                "type": "integer",
                "description": "Mentions framed negatively."
              }
            }
          }
        },
        "required": [
          "name",
          "role",
          "present",
          "responses",
          "rate",
          "min_sample"
        ]
      },
      "Brand": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The workspace public id. Pass as ?brand=."
          },
          "name": {
            "type": "string",
            "description": "Brand name."
          },
          "domain": {
            "type": [
              "string",
              "null"
            ],
            "description": "The brand's own domain, null before setup finishes."
          },
          "configured": {
            "type": "boolean",
            "description": "False means setup was never finished. Data endpoints return 404 brand_not_configured for one of these rather than a page of zeroes, which would read as measured absence."
          },
          "active_prompts": {
            "type": "integer",
            "description": "Prompts currently running for this brand."
          },
          "market": {
            "type": "object",
            "properties": {
              "location_code": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "DataForSEO location code."
              },
              "language_code": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "ISO language code."
              }
            }
          },
          "last_collected_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO timestamp of the most recent stored answer."
          }
        },
        "required": [
          "id",
          "name",
          "configured",
          "active_prompts"
        ]
      },
      "Mention": {
        "type": "object",
        "properties": {
          "brand": {
            "type": "string",
            "description": "Which tracked brand this refers to."
          },
          "role": {
            "type": "string",
            "enum": [
              "self",
              "competitor"
            ]
          },
          "mentioned": {
            "type": "boolean",
            "description": "False rows exist: we looked and it was absent."
          },
          "rank": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Position in the answer's list, 1-based. Null when unranked."
          },
          "count": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Times named in this one answer."
          },
          "framing": {
            "type": [
              "string",
              "null"
            ],
            "description": "recommended | neutral | negative | null when genuinely ambivalent."
          },
          "framing_signals": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "The cue phrases behind `framing`, so a judgement can be checked."
          },
          "snippet": {
            "type": [
              "string",
              "null"
            ],
            "description": "The verbatim sentence naming the brand. This is the evidence."
          }
        },
        "required": [
          "brand",
          "role",
          "mentioned"
        ]
      },
      "Citation": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "The cited page."
          },
          "domain": {
            "type": "string",
            "description": "Its host."
          },
          "rank": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Position in the engine's source list. That order IS the rank."
          },
          "title": {
            "type": [
              "string",
              "null"
            ],
            "description": "Page title where the engine supplied one."
          }
        },
        "required": [
          "url",
          "domain"
        ]
      },
      "Answer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Opaque public id, ans_<12>. Also the pagination cursor. Never an integer."
          },
          "engine": {
            "type": "string",
            "description": "Engine slug."
          },
          "collection_method": {
            "type": "string",
            "description": "api, scraper or serp."
          },
          "prompt": {
            "type": "string",
            "description": "The prompt that was asked. Called `prompt`, not `question`."
          },
          "answer": {
            "type": [
              "string",
              "null"
            ],
            "description": "The answer verbatim, markdown. Null when the engine returned none."
          },
          "outcome": {
            "type": "string",
            "enum": [
              "ok",
              "empty"
            ],
            "description": "'empty' is a REAL OBSERVATION: the engine answered and named nobody. It is in the denominator everywhere. Failed collections (error, timeout) are excluded entirely and never appear here."
          },
          "collected_at": {
            "type": "string",
            "description": "ISO timestamp."
          },
          "location_code": {
            "type": [
              "integer",
              "null"
            ],
            "description": "The market this was collected in."
          },
          "mentions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Mention"
            }
          },
          "citations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Citation"
            }
          }
        },
        "required": [
          "id",
          "engine",
          "prompt",
          "outcome",
          "collected_at",
          "mentions",
          "citations"
        ]
      },
      "Source": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string",
            "description": "Normalised host — www.example.com and example.com are one row."
          },
          "answers_citing_it": {
            "type": "integer",
            "description": "Answers in the window that cited this domain."
          },
          "answers_where_you_were_named": {
            "type": "integer",
            "description": "Of those, how many also named your brand."
          },
          "answers_citing_you_without_naming_you": {
            "type": "integer",
            "description": "The actionable number. A domain read on nine answers that named a competitor every time is a specific page to go and be on."
          }
        },
        "required": [
          "domain",
          "answers_citing_it",
          "answers_where_you_were_named",
          "answers_citing_you_without_naming_you"
        ]
      },
      "Alert": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Opaque public id, alr_<12>. Use it to dedupe across polls."
          },
          "kind": {
            "type": "string",
            "description": "Finding type, e.g. visibility_drop."
          },
          "title": {
            "type": "string",
            "description": "One line."
          },
          "detail": {
            "type": "string",
            "description": "The explanation, including the numbers behind it."
          },
          "facts": {
            "type": "object",
            "description": "The figures the finding was computed from."
          },
          "created_at": {
            "type": "string",
            "description": "ISO timestamp."
          },
          "read": {
            "type": "boolean",
            "description": "Whether it has been seen in the dashboard."
          }
        },
        "required": [
          "id",
          "kind",
          "title",
          "created_at",
          "read"
        ]
      },
      "Me": {
        "type": "object",
        "properties": {
          "organization": {
            "type": "object",
            "properties": {
              "name": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Organisation name."
              }
            }
          },
          "plan": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "trial | solo | starter | growth | agency."
              },
              "status": {
                "type": "string",
                "description": "Stripe subscription status."
              },
              "trial_ends_at": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "ISO timestamp, null when not trialling."
              },
              "prompts": {
                "type": "object",
                "properties": {
                  "used": {
                    "type": "integer",
                    "description": "Active prompts across the organisation."
                  },
                  "included": {
                    "type": "integer",
                    "description": "The plan's cap."
                  }
                }
              },
              "brands": {
                "type": "integer",
                "description": "Brands in the organisation."
              }
            }
          },
          "key": {
            "type": "object",
            "properties": {
              "scopes": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Granted to this key."
              },
              "available_scopes": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Every scope that exists, so 'not granted' is distinguishable from 'not real'."
              },
              "pinned_to_brand": {
                "type": "boolean",
                "description": "True when the key is bound to one brand. Such a key refuses any other ?brand=, and GET /brands returns only that one brand."
              }
            }
          },
          "brand": {
            "$ref": "#/components/schemas/BrandRef"
          },
          "rate_limit": {
            "type": "object",
            "properties": {
              "per_minute": {
                "type": "integer",
                "description": "Requests a minute. 300 on every plan."
              },
              "remaining": {
                "type": "integer",
                "description": "Left in the current minute."
              },
              "resets_in_seconds": {
                "type": "integer",
                "description": "Until the window rolls."
              }
            }
          },
          "reporting_rules": {
            "type": "object",
            "description": "NOT ADVISORY. A client that ignores these produces wrong reports.",
            "properties": {
              "min_sample": {
                "type": "integer",
                "description": "Below this many answers, rate is null."
              },
              "rate_null_means": {
                "type": "string",
                "description": "Plain-language restatement, for surfacing to an end user."
              },
              "engines_averaged": {
                "type": "boolean",
                "description": "Always false. Engines disagree; a mean describes no real surface."
              },
              "alerts": {
                "type": "object",
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "kinds": {
                    "type": [
                      "array",
                      "string"
                    ],
                    "items": {
                      "type": "string"
                    },
                    "description": "Array of requested kinds, or the string 'all' when none are set. Kinds: visibility_drop, visibility_rise, competitor_overtook, cited_not_named, negative_framing, engine_blackout."
                  },
                  "min_delta_points": {
                    "type": "integer",
                    "description": "Percentage points of change required to raise a finding."
                  },
                  "min_sample_each_side": {
                    "type": "integer",
                    "description": "Answers required on BOTH sides of the comparison."
                  },
                  "also_suppressed_below_statistical_noise": {
                    "type": "boolean",
                    "description": "Always true. Even a move clearing min_delta_points is suppressed if it sits inside a 95% CI on the difference of two proportions. Whichever bar is HIGHER wins."
                  },
                  "empty_list_means": {
                    "type": "string",
                    "description": "The honest phrasing for an empty /alerts response."
                  }
                }
              }
            }
          }
        },
        "required": [
          "organization",
          "plan",
          "key",
          "brand",
          "rate_limit",
          "reporting_rules"
        ]
      }
    }
  },
  "paths": {
    "/me": {
      "get": {
        "summary": "Who this key is, and the rules for reading the numbers",
        "description": "Call this first. The reporting_rules block is not advisory: it carries the sample floor and the live alert thresholds, which is the only way a client can tell 'no alerts' from 'nothing changed'.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Me"
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "generated_at": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "brand": {
                          "$ref": "#/components/schemas/BrandRef"
                        },
                        "note": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "required": [
                    "data",
                    "meta"
                  ]
                },
                "example": {
                  "data": {
                    "organization": {
                      "name": "Acme Inc"
                    },
                    "plan": {
                      "name": "growth",
                      "status": "active",
                      "trial_ends_at": null,
                      "prompts": {
                        "used": 7,
                        "included": 9
                      },
                      "brands": 2
                    },
                    "key": {
                      "scopes": [
                        "read"
                      ],
                      "available_scopes": [
                        "read",
                        "prompts:write",
                        "brands:write"
                      ],
                      "pinned_to_brand": false
                    },
                    "brand": {
                      "id": "wsp_zD6cssxGlJyF",
                      "name": "Acme"
                    },
                    "rate_limit": {
                      "per_minute": 300,
                      "remaining": 299,
                      "resets_in_seconds": 41
                    },
                    "reporting_rules": {
                      "min_sample": 5,
                      "rate_null_means": "not enough answers yet — NOT zero",
                      "engines_averaged": false,
                      "alerts": {
                        "enabled": true,
                        "kinds": "all",
                        "min_delta_points": 15,
                        "min_sample_each_side": 10,
                        "also_suppressed_below_statistical_noise": true,
                        "empty_list_means": "no change large enough to distinguish from noise at this sample size"
                      }
                    }
                  },
                  "meta": {
                    "generated_at": "2026-09-30T09:00:00.000Z"
                  }
                }
              }
            }
          },
          "400": {
            "description": "brand_required, or a cursor that does not belong to this brand.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed, revoked or expired key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "402": {
            "description": "The organisation has never subscribed, or the plan excludes the API.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "The key lacks the required scope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No such brand, or the brand has not finished setup.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded. Carries Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/brands": {
      "get": {
        "summary": "Every brand this key may read",
        "description": "The ids to pass as ?brand=. A pinned key sees only its own.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Brand"
                      }
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "generated_at": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "brand": {
                          "$ref": "#/components/schemas/BrandRef"
                        },
                        "note": {
                          "type": "string"
                        },
                        "pinned": {
                          "type": "boolean",
                          "description": "True when this key is bound to one brand."
                        }
                      }
                    }
                  },
                  "required": [
                    "data",
                    "meta"
                  ]
                },
                "example": {
                  "data": [
                    {
                      "id": "wsp_zD6cssxGlJyF",
                      "name": "Acme",
                      "domain": "acme.com",
                      "configured": true,
                      "active_prompts": 5,
                      "market": {
                        "location_code": 2840,
                        "language_code": "en"
                      },
                      "last_collected_at": "2026-09-30T04:12:00.000Z"
                    },
                    {
                      "id": "wsp_094oxa5e",
                      "name": "Acme Labs",
                      "domain": null,
                      "configured": false,
                      "active_prompts": 0,
                      "market": {
                        "location_code": 2840,
                        "language_code": "en"
                      },
                      "last_collected_at": null
                    }
                  ],
                  "meta": {
                    "generated_at": "2026-09-30T09:00:00.000Z",
                    "pinned": false,
                    "note": "Pass one of these ids as ?brand= on every other endpoint."
                  }
                }
              }
            }
          },
          "400": {
            "description": "brand_required, or a cursor that does not belong to this brand.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed, revoked or expired key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "402": {
            "description": "The organisation has never subscribed, or the plan excludes the API.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
