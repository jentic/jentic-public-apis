  "x-scopes": {
    "read": {
      "capability": "view_reports"
    },
    "prompts:write": {
      "capability": "manage_questions"
    },
    "brands:write": {
      "capability": "manage_brands"
    }
  },
  "x-error-codes": {
    "unauthorized": {
      "status": 401,
      "meaning": "No key, or a key that is malformed, revoked or expired.",
      "fix": "Create a key at /api-keys. Send it as X-API-Key or Authorization: Bearer."
    },
    "no_subscription": {
      "status": 402,
      "meaning": "This organisation has never had a plan.",
      "fix": "Choose a plan. A lapsed plan is not refused: if you have subscribed before, you keep read access to the answers you already own."
    },
    "api_not_on_plan": {
      "status": 402,
      "meaning": "This plan does not include API access.",
      "fix": "Every plan includes the API, so this should not occur in practice. If you see it, contact support."
    },
    "insufficient_scope": {
      "status": 403,
      "meaning": "The key was not granted the scope this endpoint needs.",
      "fix": "Mint a key with the required scope. Every current endpoint needs `read`."
    },
    "brand_required": {
      "status": 400,
      "meaning": "The organisation has several brands and the request did not say which.",
      "fix": "Pass ?brand=<id>. GET /brands lists them. Deliberately not defaulted: a silent default files one customer's numbers under another's."
    },
    "no_such_brand": {
      "status": 404,
      "meaning": "No brand with that id that this key may read.",
      "fix": "404 rather than 403 on purpose — a 403 would confirm the brand exists in somebody else's organisation."
    },
    "no_brand": {
      "status": 404,
      "meaning": "This organisation has no brand at all, or the brand a pinned key is bound to has been deleted.",
      "fix": "Finish setup in the dashboard. For a pinned key whose brand is gone, mint a new key."
    },
    "brand_not_configured": {
      "status": 404,
      "meaning": "The brand exists but setup was never finished, so there is nothing to report.",
      "fix": "404 rather than a page of zeroes, which would read as measured absence."
    },
    "bad_cursor": {
      "status": 400,
      "meaning": "The pagination cursor does not belong to this brand.",
      "fix": "Start again without a cursor. Not a silent restart from the top, which would produce undetectable duplicates."
    },
    "rate_limited": {
      "status": 429,
      "meaning": "Either the per-key quota of 300 requests a minute, or the per-address limit of 200 failed authentications an hour, which is applied before the key is checked. Retry-After says how long to wait.",
      "fix": "Back off using Retry-After. If you are seeing this with a key you believe is valid, it is the second cause: the key is being rejected."
    }
  },
  "x-rate-limit": {
    "per_minute": 300,
    "uniform_across_plans": true,
    "headers": [
      "X-RateLimit-Limit",
      "X-RateLimit-Remaining",
      "X-RateLimit-Reset"
    ]
  }
}
