openapi: 3.1.0
info:
  title: VoxApp API
  version: "1.0.0"
  summary: REST API for voice, chat, SMS, WhatsApp, and email orchestration.
  description: |
    The VoxApp Integration API lets you trigger calls and messages, manage contacts, fetch call results, and subscribe to webhook events from your own systems.

    All endpoints below live under `/api/v1` and are designed for server-to-server integration — they are what platforms like Zapier, Make, n8n, and custom backends use to drive VoxApp.

    ## Getting started

    1. Create an OAuth2 client in your VoxApp dashboard at [my.voxapp.com](https://my.voxapp.com/) under **Settings → Developers**.
    2. Use the **authorization code** flow if you're building a user-facing integration (Zapier-style), or **client credentials** if it's a backend-only integration.
    3. Include the access token on every request as `Authorization: Bearer <token>`.

    ## Scopes

    | Scope | Grants |
    |---|---|
    | `calls:read` | View call history and details |
    | `calls:write` | Trigger outbound and web calls, send SMS, create meetings |
    | `contacts:read` | View contacts |
    | `contacts:write` | Create and update contacts, send emails |
    | `assistants:read` | View assistants |
    | `webhooks:manage` | Create and manage webhook subscriptions |

    Default scopes if none requested: `calls:read`, `contacts:read`, `assistants:read`.

    ## Rate limits

    Most endpoints are rate-limited per-token. Limits are returned in standard `X-RateLimit-*` headers. If you exceed your limit you'll get an HTTP 429.

    ## Errors

    Errors are returned as JSON with an `error` or `message` key plus the standard HTTP status code. Validation failures return `422` with a `errors` object keyed by field name.

  contact:
    name: VoxApp Support
    url: https://voxapp.com/contact.html
  license:
    name: Proprietary

servers:
  - url: https://my.voxapp.com
    description: Production

security:
  - oauth2: []

tags:
  - name: Identity
    description: Confirm which user/tenant a token belongs to.
  - name: Actions
    description: Trigger calls, emails, SMS, and meeting links.
  - name: Resources
    description: Fetch calls, assistants, and batch status.
  - name: Contacts
    description: Create and update contact records.
  - name: Webhook subscriptions
    description: Subscribe to events delivered to your URLs (REST Hooks pattern).

paths:

  # ────────────────────────────────────────────────────────────
  # Identity
  # ────────────────────────────────────────────────────────────
  /api/v1/me:
    get:
      tags: [Identity]
      summary: Who am I?
      description: Returns the user and tenant the current token authenticates as. Typically used by Zapier/Make to verify a connection.
      responses:
        '200':
          description: Current identity
          content:
            application/json:
              schema: { $ref: '#/components/schemas/Identity' }

  # ────────────────────────────────────────────────────────────
  # Actions — write side
  # ────────────────────────────────────────────────────────────
  /api/v1/actions/call:
    post:
      tags: [Actions]
      summary: Start an outbound voice call
      description: |
        Triggers an outbound phone call from an assistant to a contact. Provide one of:
        - `contact_id` of an existing contact, or
        - `phone_number` directly, or
        - a `contact` object (will be resolved or created).
      security:
        - oauth2: [calls:write]
      requestBody:
        required: true
        content:
          application/json:
            schema: { $ref: '#/components/schemas/CallRequest' }
      responses:
        '201':
          description: Call queued
          content:
            application/json:
              schema: { $ref: '#/components/schemas/CallTriggerResponse' }
        '422': { $ref: '#/components/responses/ValidationError' }

  /api/v1/actions/web-call:
    post:
      tags: [Actions]
      summary: Create a web call link
      description: Creates a one-time URL that opens an in-browser voice call with the assistant. Optionally attach a contact for personalised context.
      security:
        - oauth2: [calls:write]
      requestBody:
        required: true
        content:
          application/json:
            schema: { $ref: '#/components/schemas/WebCallRequest' }
      responses:
        '201':
          description: Web call created
          content:
            application/json:
              schema: { $ref: '#/components/schemas/WebCallResponse' }
        '422': { $ref: '#/components/responses/ValidationError' }

  /api/v1/actions/sms:
    post:
      tags: [Actions]
      summary: Send an SMS
      description: Sends a single SMS using the assistant's SMS template. The assistant must have an SMS template configured.
      security:
        - oauth2: [calls:write]
      requestBody:
        required: true
        content:
          application/json:
            schema: { $ref: '#/components/schemas/SmsRequest' }
      responses:
        '202':
          description: SMS queued
          content:
            application/json:
              schema:
                type: object
                properties:
                  message: { type: string, example: SMS queued for delivery. }
                  sms_id: { type: string, format: uuid }
        '422': { $ref: '#/components/responses/ValidationError' }

  /api/v1/actions/email:
    post:
      tags: [Actions]
      summary: Send an email
      description: Sends a single email from the assistant to a contact. The contact must have an email address.
      security:
        - oauth2: [contacts:write]
      requestBody:
        required: true
        content:
          application/json:
            schema: { $ref: '#/components/schemas/EmailRequest' }
      responses:
        '202':
          description: Email queued
          content:
            application/json:
              schema:
                type: object
                properties:
                  message: { type: string, example: Email queued for delivery. }
        '422': { $ref: '#/components/responses/ValidationError' }

  /api/v1/actions/meeting:
    post:
      tags: [Actions]
      summary: Create a meeting link
      description: Returns a stable meeting URL for the assistant. The URL persists — calling again returns the same link.
      security:
        - oauth2: [calls:write]
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [assistant_id]
              properties:
                assistant_id: { type: string, format: uuid }
      responses:
        '200':
          description: Meeting link
          content:
            application/json:
              schema:
                type: object
                properties:
                  url: { type: string, format: uri, example: "https://my.voxapp.com/meet/abc123" }
                  token: { type: string, example: "abc123" }

  /api/v1/actions/batch-call:
    post:
      tags: [Actions]
      summary: Start a batch of outbound calls
      description: Queues up to 1,000 outbound calls in one request. Returns a `batch_id` you can poll via `/v1/batches/{id}`.
      security:
        - oauth2: [calls:write]
      requestBody:
        required: true
        content:
          application/json:
            schema: { $ref: '#/components/schemas/BatchCallRequest' }
      responses:
        '202':
          description: Batch queued
          content:
            application/json:
              schema: { $ref: '#/components/schemas/BatchAcceptedResponse' }
        '422': { $ref: '#/components/responses/ValidationError' }

  /api/v1/actions/batch-email:
    post:
      tags: [Actions]
      summary: Send a batch of emails
      description: Queues up to 1,000 emails in one request. Returns a `batch_id` you can poll via `/v1/email-batches/{id}`.
      security:
        - oauth2: [contacts:write]
      requestBody:
        required: true
        content:
          application/json:
            schema: { $ref: '#/components/schemas/BatchEmailRequest' }
      responses:
        '202':
          description: Batch queued
          content:
            application/json:
              schema: { $ref: '#/components/schemas/BatchAcceptedResponse' }
        '422': { $ref: '#/components/responses/ValidationError' }

  /api/v1/actions/batch-sms:
    post:
      tags: [Actions]
      summary: Send a batch of SMS messages
      description: Queues up to 1,000 SMS messages in one request. The assistant must have an SMS template. Returns a `batch_id` you can poll via `/v1/sms-batches/{id}`.
      security:
        - oauth2: [calls:write]
      requestBody:
        required: true
        content:
          application/json:
            schema: { $ref: '#/components/schemas/BatchSmsRequest' }
      responses:
        '202':
          description: Batch queued
          content:
            application/json:
              schema: { $ref: '#/components/schemas/BatchAcceptedResponse' }
        '422': { $ref: '#/components/responses/ValidationError' }

  # ────────────────────────────────────────────────────────────
  # Resources — read side
  # ────────────────────────────────────────────────────────────
  /api/v1/assistants:
    get:
      tags: [Resources]
      summary: List active assistants
      description: Returns all assistants in `active` status with full configuration detail.
      security:
        - oauth2: [assistants:read]
      responses:
        '200':
          description: List of assistants
          content:
            application/json:
              schema:
                type: object
                properties:
                  data:
                    type: array
                    items: { $ref: '#/components/schemas/Assistant' }

  /api/v1/assistants/{id}:
    get:
      tags: [Resources]
      summary: Get an assistant
      security:
        - oauth2: [assistants:read]
      parameters:
        - { name: id, in: path, required: true, schema: { type: string, format: uuid } }
      responses:
        '200':
          description: Assistant detail
          content:
            application/json:
              schema:
                type: object
                properties:
                  data: { $ref: '#/components/schemas/Assistant' }
        '404': { $ref: '#/components/responses/NotFound' }

  /api/v1/calls/{id}:
    get:
      tags: [Resources]
      summary: Get a call
      description: Returns the full record for a single call, including transcript, summary, structured output, sentiment, and recording URL when available.
      security:
        - oauth2: [calls:read]
      parameters:
        - { name: id, in: path, required: true, schema: { type: string, format: uuid } }
      responses:
        '200':
          description: Call detail
          content:
            application/json:
              schema:
                type: object
                properties:
                  data: { $ref: '#/components/schemas/Call' }
        '404': { $ref: '#/components/responses/NotFound' }

  /api/v1/batches/{id}:
    get:
      tags: [Resources]
      summary: Get a call batch
      security:
        - oauth2: [calls:read]
      parameters:
        - { name: id, in: path, required: true, schema: { type: string, format: uuid } }
      responses:
        '200':
          description: Batch status
          content:
            application/json:
              schema:
                type: object
                properties:
                  data: { $ref: '#/components/schemas/Batch' }
        '404': { $ref: '#/components/responses/NotFound' }

  /api/v1/email-batches/{id}:
    get:
      tags: [Resources]
      summary: Get an email batch
      security:
        - oauth2: [calls:read]
      parameters:
        - { name: id, in: path, required: true, schema: { type: string, format: uuid } }
      responses:
        '200':
          description: Batch status
          content:
            application/json:
              schema:
                type: object
                properties:
                  data: { $ref: '#/components/schemas/Batch' }
        '404': { $ref: '#/components/responses/NotFound' }

  /api/v1/sms-batches/{id}:
    get:
      tags: [Resources]
      summary: Get an SMS batch
      security:
        - oauth2: [calls:read]
      parameters:
        - { name: id, in: path, required: true, schema: { type: string, format: uuid } }
      responses:
        '200':
          description: Batch status
          content:
            application/json:
              schema:
                type: object
                properties:
                  data: { $ref: '#/components/schemas/Batch' }
        '404': { $ref: '#/components/responses/NotFound' }

  # ────────────────────────────────────────────────────────────
  # Contacts
  # ────────────────────────────────────────────────────────────
  /api/v1/zapier/contacts:
    get:
      tags: [Contacts]
      summary: List recent contacts
      description: Returns the 3 most-recently-created contacts. Used as a Zapier "sample" trigger.
      security:
        - oauth2: [contacts:read]
      responses:
        '200':
          description: Contacts
          content:
            application/json:
              schema:
                type: array
                items: { $ref: '#/components/schemas/Contact' }
    post:
      tags: [Contacts]
      summary: Create a contact
      description: Creates a new contact, deduplicated by `phone`, `email`, or `external_id`. Fires the `contact.created` webhook.
      security:
        - oauth2: [contacts:write]
      requestBody:
        required: true
        content:
          application/json:
            schema: { $ref: '#/components/schemas/ContactInput' }
      responses:
        '201':
          description: Contact created (or returned if matched)
          content:
            application/json:
              schema: { $ref: '#/components/schemas/Contact' }
        '422': { $ref: '#/components/responses/ValidationError' }

  /api/v1/zapier/contacts/{contact}:
    put:
      tags: [Contacts]
      summary: Update a contact
      security:
        - oauth2: [contacts:write]
      parameters:
        - { name: contact, in: path, required: true, schema: { type: string, format: uuid } }
      requestBody:
        required: true
        content:
          application/json:
            schema: { $ref: '#/components/schemas/ContactInput' }
      responses:
        '200':
          description: Contact updated
          content:
            application/json:
              schema: { $ref: '#/components/schemas/Contact' }
        '404': { $ref: '#/components/responses/NotFound' }
        '422': { $ref: '#/components/responses/ValidationError' }

  # ────────────────────────────────────────────────────────────
  # Zapier polling helpers
  # ────────────────────────────────────────────────────────────
  /api/v1/zapier/calls:
    get:
      tags: [Resources]
      summary: List recent completed calls (Zapier sample)
      description: Returns the 3 most-recent calls in `completed` or `failed` status. Powers Zapier's "New Call" trigger sample data.
      security:
        - oauth2: [calls:read]
      parameters:
        - name: assistant_id
          in: query
          required: false
          schema: { type: string, format: uuid }
          description: Optional filter by assistant.
      responses:
        '200':
          description: Calls
          content:
            application/json:
              schema:
                type: array
                items: { $ref: '#/components/schemas/Call' }

  /api/v1/zapier/structured-output:
    get:
      tags: [Resources]
      summary: List calls with structured output (Zapier sample)
      description: |
        Returns recent calls that have summary, structured_output, analysis, or form-submission data. The response includes flattened `output_*`, `form_*`, and `meta_*` keys for easier mapping in low-code tools.
      security:
        - oauth2: [calls:read]
      parameters:
        - name: assistant_id
          in: query
          required: false
          schema: { type: string, format: uuid }
      responses:
        '200':
          description: Calls with flattened output fields
          content:
            application/json:
              schema:
                type: array
                items: { $ref: '#/components/schemas/CallFlat' }

  /api/v1/zapier/call-response:
    get:
      tags: [Resources]
      summary: Look up a single call by id or source record
      security:
        - oauth2: [calls:read]
      parameters:
        - name: call_id
          in: query
          required: false
          schema: { type: string, format: uuid }
        - name: email_id
          in: query
          required: false
          schema: { type: string, format: uuid }
          description: Look up by `source_record_id` (e.g. the email id that triggered the call).
      responses:
        '200':
          description: Call with flattened output fields
          content:
            application/json:
              schema: { $ref: '#/components/schemas/CallFlat' }
        '404': { $ref: '#/components/responses/NotFound' }

  /api/v1/zapier/assistants:
    get:
      tags: [Resources]
      summary: List assistants (id + name only)
      description: Lean assistant list used by Zapier's dynamic dropdown for assistant selection.
      security:
        - oauth2: [assistants:read]
      responses:
        '200':
          description: Assistants
          content:
            application/json:
              schema:
                type: array
                items:
                  type: object
                  properties:
                    id: { type: string, format: uuid }
                    name: { type: string }

  # ────────────────────────────────────────────────────────────
  # Webhook subscriptions
  # ────────────────────────────────────────────────────────────
  /api/v1/hooks/subscribe:
    post:
      tags: [Webhook subscriptions]
      summary: Subscribe to a webhook event
      description: |
        Registers a URL to receive POST requests when the chosen event fires. Returns a `secret` used to verify the signature on incoming webhooks.

        See the `webhooks` section of this document for the available event names and example payloads.
      security:
        - oauth2: [webhooks:manage]
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [hookUrl, event]
              properties:
                hookUrl:
                  type: string
                  format: uri
                  description: HTTPS URL we'll POST events to.
                  example: "https://hooks.zapier.com/hooks/catch/12345/abcdef"
                event:
                  type: string
                  description: The event name. See the [Webhook events](#webhook-events) table.
                  enum: &events
                    - call.started
                    - call.completed
                    - call.failed
                    - call.signal_triggered
                    - email.queued
                    - email.sent
                    - email.failed
                    - sms.queued
                    - sms.sent
                    - sms.delivered
                    - sms.failed
                    - whatsapp.queued
                    - whatsapp.sent
                    - whatsapp.delivered
                    - whatsapp.read
                    - whatsapp.failed
                    - contact.created
                    - contact.updated
                    - assistant.updated
                    - credits.low
                    - credits.exhausted
                    - invoice.sent
                    - invoice.paid
                    - invoice.overdue
                    - widget_session.completed
                    - knowledge_base.source.processed
                    - knowledge_base.source.failed
                source:
                  type: string
                  description: Free-form tag for your records (e.g. `zapier`, `make`, `internal`).
                  example: zapier
                name:
                  type: string
                  description: Friendly label shown in the dashboard.
      responses:
        '201':
          description: Subscribed
          content:
            application/json:
              schema:
                type: object
                properties:
                  id: { type: string, format: uuid }
                  secret:
                    type: string
                    description: HMAC secret. Use this to verify the `X-VoxApp-Signature` header on incoming webhook requests.
                    example: "k7p2…64chars"

  /api/v1/hooks/{id}:
    delete:
      tags: [Webhook subscriptions]
      summary: Unsubscribe a webhook
      security:
        - oauth2: [webhooks:manage]
      parameters:
        - { name: id, in: path, required: true, schema: { type: string, format: uuid } }
      responses:
        '204': { description: Unsubscribed }
        '404': { $ref: '#/components/responses/NotFound' }

# ────────────────────────────────────────────────────────────
# Webhooks (events delivered TO your URL)
# ────────────────────────────────────────────────────────────
webhooks:
  call.completed:
    post:
      summary: A call has finished
      description: Fired when a call moves to `completed` or `failed`. Includes transcript, summary, structured output, sentiment, and recording URL when available.
      requestBody:
        content:
          application/json:
            schema: { $ref: '#/components/schemas/WebhookCallCompleted' }
      responses:
        '2XX': { description: Acknowledged }
  call.started:
    post:
      summary: A call has started
      requestBody:
        content:
          application/json:
            schema: { $ref: '#/components/schemas/WebhookCallStarted' }
      responses:
        '2XX': { description: Acknowledged }
  contact.created:
    post:
      summary: A contact was created
      requestBody:
        content:
          application/json:
            schema: { $ref: '#/components/schemas/WebhookContactCreated' }
      responses:
        '2XX': { description: Acknowledged }

# ────────────────────────────────────────────────────────────
# Components
# ────────────────────────────────────────────────────────────
components:
  securitySchemes:
    oauth2:
      type: oauth2
      description: |
        OAuth2 via Laravel Passport. Use the **authorization code** flow for user-facing integrations (Zapier, Make, n8n) and **client credentials** for backend-to-backend.

        Tokens expire after 30 days; refresh tokens last 90 days. Personal access tokens last 6 months.
      flows:
        authorizationCode:
          authorizationUrl: https://my.voxapp.com/oauth/authorize
          tokenUrl: https://my.voxapp.com/oauth/token
          refreshUrl: https://my.voxapp.com/oauth/token
          scopes:
            calls:read: View call history and details
            calls:write: Trigger outbound and web calls
            contacts:read: View contacts
            contacts:write: Create and update contacts, send emails
            assistants:read: View assistants
            webhooks:manage: Create and manage webhook subscriptions
        clientCredentials:
          tokenUrl: https://my.voxapp.com/oauth/token
          scopes:
            calls:read: View call history and details
            calls:write: Trigger outbound and web calls
            contacts:read: View contacts
            contacts:write: Create and update contacts, send emails
            assistants:read: View assistants
            webhooks:manage: Create and manage webhook subscriptions

  responses:
    ValidationError:
      description: Validation failed
      content:
        application/json:
          schema: { $ref: '#/components/schemas/ValidationErrorBody' }
    NotFound:
      description: Resource not found
      content:
        application/json:
          schema: { $ref: '#/components/schemas/Error' }

  schemas:
    Identity:
      type: object
      properties:
        id: { type: string, format: uuid }
        first_name: { type: string }
        last_name: { type: string }
        email: { type: string, format: email }
        tenant_id: { type: string, format: uuid }
        tenant_name: { type: string }

    ContactRef:
      type: object
      description: Embedded contact object (used when you'd rather pass the contact inline than look up its id).
      properties:
        first_name: { type: string, maxLength: 255 }
        last_name: { type: string, maxLength: 255 }
        email: { type: string, format: email, maxLength: 255 }
        phone: { type: string, maxLength: 20 }
        company: { type: string, maxLength: 255 }
        external_id: { type: string, maxLength: 255, description: Your system's id for this contact. Used for deduplication and back-linking. }
        external_source: { type: string, maxLength: 100, description: Which system external_id belongs to (e.g. hireme, jobadder). Defaults to the request's top-level source. }

    ContactInput:
      type: object
      required: [first_name]
      properties:
        first_name: { type: string, maxLength: 255 }
        last_name: { type: string, maxLength: 255 }
        email: { type: string, format: email, maxLength: 255 }
        phone: { type: string, maxLength: 50 }
        company: { type: string, maxLength: 255 }
        external_id: { type: string, maxLength: 255 }
        metadata:
          type: object
          additionalProperties: true
          description: Arbitrary key/value pairs stored on the contact. Merged on update — existing keys are preserved unless overwritten.

    Contact:
      type: object
      properties:
        id: { type: string, format: uuid }
        first_name: { type: string }
        last_name: { type: string }
        email: { type: string, format: email }
        phone: { type: string }
        company: { type: string }
        external_id: { type: string }
        metadata: { type: object, additionalProperties: true }
        created_at: { type: string, format: date-time }

    CallRequest:
      type: object
      required: [assistant_id]
      properties:
        assistant_id: { type: string, format: uuid }
        contact_id:
          type: string
          format: uuid
          description: "Existing contact id. Either this, `phone_number`, or a `contact.phone` is required."
        phone_number:
          type: string
          maxLength: 20
          description: "Phone number to call (E.164 format recommended)."
        contact: { $ref: '#/components/schemas/ContactRef' }
        context:
          type: string
          maxLength: 200000
          description: "Free-form context the assistant should know about this call."
        resume_url:
          type: string
          format: uri
          maxLength: 2048
          description: "Public link to the candidate's résumé (PDF, Word .docx, text or HTML, up to 15 MB). VoxApp downloads it, extracts the text and appends it to `context` under a \"Resume:\" heading. An unreadable link fails the request with a `resume_*` error code instead of starting a call without it."
        notes: { type: string, maxLength: 2000 }
        metadata: { type: object, additionalProperties: true }
        source:
          type: string
          maxLength: 50
          description: "Where this call originated (e.g. `zapier`, `hubspot`, your app name)."
        source_record_id:
          type: string
          maxLength: 255
          description: "The id of the originating record in your system (for back-linking)."

    CallTriggerResponse:
      type: object
      properties:
        id: { type: string, format: uuid }
        call_id:
          type: string
          format: uuid
          description: "Same value as `id`, included for client convenience."
        status:
          type: string
          example: queued
        assistant_id: { type: string, format: uuid }
        contact_id: { type: string, format: uuid }

    WebCallRequest:
      type: object
      required: [assistant_id]
      properties:
        assistant_id: { type: string, format: uuid }
        contact_id: { type: string, format: uuid }
        contact: { $ref: '#/components/schemas/ContactRef' }
        metadata: { type: object, additionalProperties: true }
        source: { type: string }
        source_record_id: { type: string }

    WebCallResponse:
      type: object
      properties:
        url: { type: string, format: uri, description: Single-use URL to open in a browser. }
        token: { type: string }
        assistant_id: { type: string, format: uuid }
        contact_id: { type: string, format: uuid }

    SmsRequest:
      type: object
      required: [assistant_id]
      properties:
        assistant_id: { type: string, format: uuid }
        contact_id: { type: string, format: uuid }
        phone_number: { type: string, maxLength: 20 }
        contact: { $ref: '#/components/schemas/ContactRef' }
        context: { type: string, maxLength: 200000 }
        resume_url:
          type: string
          format: uri
          maxLength: 2048
          description: "Public link to the candidate's résumé (PDF, Word .docx, text or HTML, up to 15 MB). VoxApp downloads it, extracts the text and appends it to `context` under a \"Resume:\" heading. An unreadable link fails the request with a `resume_*` error code instead of starting a call without it."
        metadata: { type: object, additionalProperties: true }
        source: { type: string, maxLength: 50 }
        source_record_id: { type: string, maxLength: 255 }

    EmailRequest:
      type: object
      required: [assistant_id]
      properties:
        assistant_id: { type: string, format: uuid }
        contact_id: { type: string, format: uuid }
        contact: { $ref: '#/components/schemas/ContactRef' }
        context: { type: string, maxLength: 200000 }
        resume_url:
          type: string
          format: uri
          maxLength: 2048
          description: "Public link to the candidate's résumé (PDF, Word .docx, text or HTML, up to 15 MB). VoxApp downloads it, extracts the text and appends it to `context` under a \"Resume:\" heading. An unreadable link fails the request with a `resume_*` error code instead of starting a call without it."
        metadata: { type: object, additionalProperties: true }
        source: { type: string, maxLength: 50 }
        source_record_id: { type: string, maxLength: 255 }

    BatchContactCall:
      type: object
      required: [phone]
      properties:
        phone: { type: string, maxLength: 20 }
        first_name: { type: string }
        last_name: { type: string }
        email: { type: string, format: email }
        company: { type: string }
        external_id: { type: string }
        context: { type: string, maxLength: 200000 }
        notes: { type: string, maxLength: 2000 }
        metadata: { type: object, additionalProperties: true }

    BatchContactEmail:
      type: object
      required: [email]
      properties:
        email: { type: string, format: email }
        first_name: { type: string }
        last_name: { type: string }
        phone: { type: string }
        company: { type: string }
        external_id: { type: string }
        context: { type: string, maxLength: 200000 }
        metadata: { type: object, additionalProperties: true }

    BatchContactSms:
      allOf:
        - $ref: '#/components/schemas/BatchContactCall'

    BatchCallRequest:
      type: object
      required: [assistant_id, contacts]
      properties:
        assistant_id: { type: string, format: uuid }
        contacts:
          type: array
          minItems: 1
          maxItems: 1000
          items: { $ref: '#/components/schemas/BatchContactCall' }
        source: { type: string }
        source_batch_id: { type: string }
        metadata: { type: object, additionalProperties: true, description: Batch-level metadata merged into each contact's metadata. }

    BatchEmailRequest:
      type: object
      required: [assistant_id, contacts]
      properties:
        assistant_id: { type: string, format: uuid }
        contacts:
          type: array
          minItems: 1
          maxItems: 1000
          items: { $ref: '#/components/schemas/BatchContactEmail' }
        source: { type: string }
        source_batch_id: { type: string }
        metadata: { type: object, additionalProperties: true }

    BatchSmsRequest:
      type: object
      required: [assistant_id, contacts]
      properties:
        assistant_id: { type: string, format: uuid }
        contacts:
          type: array
          minItems: 1
          maxItems: 1000
          items: { $ref: '#/components/schemas/BatchContactSms' }
        source: { type: string }
        source_batch_id: { type: string }
        metadata: { type: object, additionalProperties: true }

    BatchAcceptedResponse:
      type: object
      properties:
        batch_id: { type: string, format: uuid }
        total_count: { type: integer }
        status: { type: string, example: pending }

    Batch:
      type: object
      properties:
        id: { type: string, format: uuid }
        assistant_id: { type: string, format: uuid }
        status: { type: string, enum: [pending, processing, completed, failed, cancelled] }
        total_count: { type: integer }
        pending_count: { type: integer }
        completed_count: { type: integer }
        failed_count: { type: integer }
        source: { type: string }
        source_batch_id: { type: string }
        metadata: { type: object, additionalProperties: true }
        created_at: { type: string, format: date-time }
        updated_at: { type: string, format: date-time }

    Assistant:
      type: object
      properties:
        id: { type: string, format: uuid }
        name: { type: string }
        description: { type: string }
        status: { type: string, enum: [active, inactive, archived] }
        voice_provider: { type: string, example: elevenlabs }
        voice_id: { type: string }
        llm_provider: { type: string, example: openai }
        llm_model: { type: string, example: gpt-4o-realtime-preview }
        first_message: { type: string, description: Opening line the assistant speaks. }
        max_call_duration_seconds: { type: integer }
        has_structured_output: { type: boolean }

    Call:
      type: object
      properties:
        id: { type: string, format: uuid }
        assistant_id: { type: string, format: uuid }
        assistant_name: { type: string }
        contact_id: { type: string, format: uuid }
        contact_name: { type: string }
        first_name: { type: string }
        last_name: { type: string }
        contact_phone: { type: string }
        contact_email: { type: string, format: email }
        direction: { type: string, enum: [inbound, outbound, web] }
        status: { type: string, enum: [pending, in_progress, completed, failed] }
        duration_seconds: { type: integer }
        summary: { type: string, description: Plain-language summary of the conversation. }
        transcript: { type: string }
        sentiment: { type: string, enum: [positive, neutral, negative], nullable: true }
        structured_output:
          type: object
          additionalProperties: true
          description: Key/value extraction defined in the assistant's analysis plan.
        summary_pdf_url: { type: string, format: uri }
        recording_url: { type: string, format: uri }
        source: { type: string }
        source_record_id: { type: string }
        started_at: { type: string, format: date-time }
        ended_at: { type: string, format: date-time }
        created_at: { type: string, format: date-time }

    CallFlat:
      allOf:
        - $ref: '#/components/schemas/Call'
        - type: object
          description: |
            Same fields as `Call`, plus flattened keys for low-code tools:
            - `output_*` — keys from `structured_output` and `analysis` flattened to top level.
            - `form_*` — keys from any attached form submission.
            - `meta_*` — keys from `metadata`.
            - `contact_external_id` — convenience for back-linking.
          additionalProperties: true

    WebhookCallStarted:
      type: object
      properties:
        event: { type: string, example: call.started }
        timestamp: { type: string, format: date-time }
        call_id: { type: string, format: uuid }
        assistant_id: { type: string, format: uuid }
        assistant_name: { type: string }
        contact: { $ref: '#/components/schemas/ContactRef' }
        direction: { type: string, enum: [inbound, outbound, web] }
        status: { type: string }
        metadata: { type: object, additionalProperties: true }
        source: { type: string }
        source_record_id: { type: string }
        started_at: { type: string, format: date-time }

    WebhookCallCompleted:
      type: object
      properties:
        event: { type: string, example: call.completed }
        timestamp: { type: string, format: date-time }
        call_id: { type: string, format: uuid }
        assistant_id: { type: string, format: uuid }
        assistant_name: { type: string }
        contact: { $ref: '#/components/schemas/ContactRef' }
        direction: { type: string }
        status: { type: string }
        summary: { type: string }
        structured_output: { type: object, additionalProperties: true }
        sentiment: { type: string, nullable: true }
        transcript: { type: string }
        transcript_url: { type: string, format: uri }
        recording_url: { type: string, format: uri }
        summary_pdf_url: { type: string, format: uri }
        duration_seconds: { type: integer }
        metadata: { type: object, additionalProperties: true }
        source: { type: string }
        source_record_id: { type: string }
        started_at: { type: string, format: date-time }
        ended_at: { type: string, format: date-time }

    WebhookContactCreated:
      type: object
      properties:
        event: { type: string, example: contact.created }
        timestamp: { type: string, format: date-time }
        contact: { $ref: '#/components/schemas/Contact' }

    Error:
      type: object
      properties:
        error: { type: string, example: Resource not found. }

    ValidationErrorBody:
      type: object
      properties:
        message: { type: string, example: The given data was invalid. }
        errors:
          type: object
          description: Map of field name to validation messages.
          additionalProperties:
            type: array
            items: { type: string }
          example:
            assistant_id: ["The assistant id field is required."]
