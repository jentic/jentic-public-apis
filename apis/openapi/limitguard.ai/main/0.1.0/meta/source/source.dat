,"currency":"USD","amount":"0.11"},"protocols":[{"x402":{}}]},"responses":{"200":{"description":"Success","content":{"application/json":{"example":{"entity_id":"acme-ai","system_type":"trust_scoring","risk_level":"HIGH","readiness_score":14,"completed_items":1,"total_items":7,"gaps":[{"id":"data_governance","requirement":"Data governance and quality (Art. 10)"},{"id":"technical_docs","requirement":"Technical documentation (Art. 11)"}],"days_until_enforcement":0,"urgency":"critical","basis":"self_assessment","note":"Self-assessment: the score counts the completed_items you sent against the 7 EU AI Act high-risk obligations. entity_id is your label; nothing is looked up about it."}}}},"402":{"description":"Payment required. The x402 v2 challenge is in the base64 PAYMENT-REQUIRED header and the JSON body; pay and retry with PAYMENT-SIGNATURE, or send X-API-Key with prepaid balance.","headers":{"PAYMENT-REQUIRED":{"schema":{"type":"string"}}},"content":{"application/json":{"schema":{"type":"object","properties":{"x402Version":{"type":"integer"},"accepts":{"type":"array","items":{"type":"object"}},"error":{"type":"string"}}}}}}}}},"/v1/reputation/history/{id}":{"get":{"summary":"Get an entity's reputation score timeline","description":"Historical reputation trend data. Returns the trust score timeline with the decay applied at each point and an overall trend.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"},"description":"Entity hash identifier"}],"security":[{"ApiKey":[]},{}],"x-payment-info":{"price":{"mode":"fixed","currency":"USD","amount":"0.11"},"protocols":[{"x402":{}}]},"responses":{"200":{"description":"Success","content":{"application/json":{"example":{"history":[{"date":"2026-01-15","score":85},{"date":"2026-02-15","score":92}]}}}},"402":{"description":"Payment required. The x402 v2 challenge is in the base64 PAYMENT-REQUIRED header and the JSON body; pay and retry with PAYMENT-SIGNATURE, or send X-API-Key with prepaid balance