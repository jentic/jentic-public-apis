                "type": "integer",
                "example": 2105
              },
              "in_process": {
                "type": "integer",
                "example": 239
              },
              "completed": {
                "type": "integer",
                "example": 1866
              }
            }
          },
          "reports_by_subcategory": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "example": "Recolección de basura domiciliaria"
                },
                "generated": {
                  "type": "integer",
                  "example": 634
                },
                "in_process": {
                  "type": "integer",
                  "example": 26
                },
                "completed": {
                  "type": "integer",
                  "example": 608
                }
              }
            }
          },
          "reports_by_zone": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "example": "LOPEZ MATEOS"
                },
                "generated": {
                  "type": "integer",
                  "example": 201
                },
                "in_process": {
                  "type": "integer",
                  "example": 21
                },
                "completed": {
