            "type": "object",
            "$ref": "#/components/schemas/WaterTruckRequestMeta"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WaterTruckRequestData"
            }
          }
        }
      },
      "WaterTruckRequestMeta": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "example": 10
          },
          "page": {
            "type": "integer",
            "example": 0
          },
          "currentPage": {
            "type": "integer",
            "example": 1
          },
          "totalPages": {
            "type": "integer",
            "example": 1
          },
          "totalRequests": {
            "type": "integer",
            "example": 2
          },
          "countDataQuery": {
            "type": "integer",
            "example": 2
          },
          "groupedEntries": {
            "type": "integer",
            "example": 1
          }
        }
      },
      "WaterTruckRequestData": {
        "type": "object",
        "properties": {
          "Nombre proveedor": {
            "type": "string",
            "example": "Corve"
          },
          "Tipo proveedor": {
            "type": "string",
            "example": "Proveedor de servicios"
          },
          "Capacidad": {
            "type": "integer",
            "example": 20
          },
          "Número de placa": {
            "type": "string",
            "example": "HX4463A"
          },
          "solicitudes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "Fecha solicitud": {
                  "type": "string",
                  "format": "date-time",
                  "example": "2025-09-19T01:24:14.000Z"
                },
                "Fecha surtido": {
                  "type": "string",
                  "format": "date-time",
                  "example": "2025-09-19T15:01:20.000Z"
                },
                "Fecha entrega": {
                  "type": "string",
                  "format": "date-time",
                  "example": "2025-09-19T16:23:32.000Z"
                },
                "Tipo servicio": {
                  "type": "string",
                  "example": "casa"
                },
                "Volumen solicitado": {
                  "type": "number",
                  "example": 20
                },
                "Volumen entregado": {
                  "type": "number",
                  "example": 20
                },
                "Estatus": {
                  "type": "string",
                  "example": "Completado"
                }
              }
            }
          }
        }
      },
      "PublicSanitationResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "example": 200
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicSanitationData"
            }
          }
        }
      },
      "PublicSanitationData": {
        "type": "object",
        "properties": {
          "reports_general": {
            "type": "object",
