  "components": {
    "schemas": {
      "PartyRoleTypeRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the party role type. Must be unique in the system.",
            "example": "Client",
            "maxLength": 50
          },
          "description": {
            "type": "string",
            "nullable": true,
            "description": "Optional description of what this role type represents in business context",
            "example": "Standard client with basic access privileges",
            "maxLength": 256
          },
          "status": {
            "type": "integer",
            "description": "Status of the party role type:\n* 1 - Active (default)\n* 2 - Other status values\nPara crear se permite cualquier valor, pero siempre se guardará como 1.\nPara actualizar solo se permiten los valores 1 y 2.\n",
            "default": 1,
            "example": 1
          }
        },
        "required": [
          "name"
        ]
      },
      "PartyRoleTypeResponse": {
        "type": "object",
        "properties": {
          "party_role_type_id": {
            "type": "integer",
            "description": "Internal unique database identifier for the party role type",
            "example": 5
          },
          "public_id": {
            "type": "string",
            "description": "Public unique identifier for the party role type, used in API operations",
            "example": "prty_d1_a1b2c3d4e5",
            "maxLength": 36
          },
          "name": {
            "type": "string",
            "description": "Name of the party role type",
            "example": "Client",
            "maxLength": 50
          },
          "description": {
            "type": "string",
            "nullable": true,
            "description": "Description of the party role type and its purpose",
            "example": "Standard client with basic access privileges",
            "maxLength": 256
          },
          "status": {
            "type": "integer",
            "description": "Status del tipo de acuerdo:\n* 1 - Activo (por defecto)\n* 2 - Otro estado\nPara crear el status puede ser cualquier valor, pero se guardará como 1.\nPara modificar solo se permiten los valores 1 y 2.\n",
            "enum": [
              1,
              2
            ],
            "example": 1
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "ISO8601 timestamp when the party role type was created",
            "example": "2025-03-25T14:23:45Z"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "ISO8601 timestamp when the party role type was last updated",
            "example": "2025-03-25T14:23:45Z"
          }
        },
        "required": [
          "party_role_type_id",
          "public_id",
          "name",
          "status",
          "created_at",
          "updated_at"
        ]
      },
      "PartyRoleRequest": {
        "type": "object",
        "properties": {
          "name": {
