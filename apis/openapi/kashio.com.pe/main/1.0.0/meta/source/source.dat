  "info": {
    "title": "BRM Management System API",
    "description": "API for managing Customers, Agreements, Products and Parties with audit capabilities",
    "contact": {
      "name": "API Support",
      "email": "support@example.com"
    },
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/julesCO/brm-management-system-api/1.0.0"
