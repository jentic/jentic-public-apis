      "AddressRequest": {
        "type": "object",
        "properties": {
          "country_code": {
            "type": "string",
            "maxLength": 3,
            "description": "Country code (required, ISO format)",
            "example": "PER"
          },
          "region": {
            "type": "integer",
            "description": "Region ID (optional)",
            "nullable": true,
            "example": 1116
          },
          "state_province": {
            "type": "integer",
            "description": "State or province ID (optional)",
            "nullable": true,
            "example": 8096
          },
          "city": {
            "type": "integer",
            "description": "City ID (optional)",
            "nullable": true,
            "example": 6813
          },
          "locality": {
            "type": "string",
            "maxLength": 100,
            "description": "Locality name (optional)",
            "nullable": true,
            "example": "Lima"
          },
          "postcode": {
            "type": "string",
            "maxLength": 20,
            "description": "Postal code (optional)",
            "nullable": true,
            "example": "1010"
          },
          "street_type": {
            "type": "integer",
            "description": "Street type ID (optional)",
            "nullable": true,
            "example": 6081
          },
          "street_name": {
            "type": "string",
            "maxLength": 200,
            "description": "Street name (optional)",
            "nullable": true,
            "example": "san jose"
          },
          "street_number": {
            "type": "string",
            "maxLength": 20,
            "description": "Street number (optional)",
            "nullable": true,
            "example": "22"
          },
          "street_nr_suffix": {
            "type": "string",
            "maxLength": 20,
            "description": "Street number suffix (optional)",
            "nullable": true,
            "example": "sj"
          },
          "street_nr_last": {
            "type": "string",
            "maxLength": 20,
            "description": "Last street number (optional)",
            "nullable": true,
            "example": "123"
          },
          "street_nr_last_suffix": {
            "type": "string",
            "maxLength": 20,
            "description": "Last street number suffix (optional)",
            "nullable": true,
            "example": "123"
          },
          "geographic_location_id": {
            "type": "integer",
            "format": "int64",
            "description": "Geographic location ID (optional)",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "description": "Status of the address:\n* 1 - Active (default)\n* 2 - Inactive\nPara crear el status puede ser cualquier valor, pero se guardará como 1.\nPara modificar solo se permiten los valores 1 y 2.\n",
            "enum": [
              1,
              2
            ],
            "default": 1,
            "example": 1
          },
          "start_datetime": {
            "type": "string",
            "format": "date-time",
            "description": "Start date and time of the address (required)",
            "example": "2018-08-28T02:37:39.293Z"
          },
          "end_datetime": {
            "type": "string",
            "format": "date-time",
            "description": "End date and time of the address (optional)",
            "nullable": true,
            "example": "1997-11-26T03:32:57.815Z"
          },
          "party_id": {
            "type": "integer",
            "format": "int64",
            "description": "Party ID to associate with this address (optional)",
            "nullable": true,
            "example": 34
          },
          "external_reference_id": {
            "type": "string",
            "maxLength": 30,
            "description": "External reference ID for party address relationship (optional)",
            "nullable": true,
            "example": "23213"
          },
          "preferred": {
            "type": "boolean",
            "description": "Whether this is the preferred address for the party (optional)",
            "default": false,
            "example": true
          }
        },
        "required": [
          "country_code",
          "start_datetime"
        ]
      },
