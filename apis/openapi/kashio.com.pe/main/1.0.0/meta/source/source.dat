      "ContactMediumRequest": {
        "type": "object",
        "properties": {
          "contact_medium_type_id": {
            "type": "integer",
            "format": "int64",
            "description": "Contact medium type ID (required)"
          },
          "contact_medium_type_name": {
            "type": "string",
            "description": "Contact medium type name (optional, must match contact_medium_type_id if both provided)",
            "nullable": true
          },
          "email_address": {
            "type": "string",
            "format": "email",
            "maxLength": 50,
            "description": "Email address (required if contact_type is email)",
            "nullable": true
          },
          "number": {
            "type": "string",
            "maxLength": 25,
            "description": "Phone/mobile/fax number (required if contact_type is teléfono, móvil, or fax)",
            "nullable": true
          },
          "start_datetime": {
            "type": "string",
            "format": "date-time",
            "description": "Start date and time of the contact medium"
          },
          "end_datetime": {
            "type": "string",
            "format": "date-time",
            "description": "End date and time of the contact medium (optional)",
            "nullable": true
          },
          "geographic_address_id": {
            "type": "integer",
            "format": "int64",
            "description": "Geographic address ID (required). The party_id will be automatically obtained from this address."
          },
          "preferred": {
            "type": "boolean",
            "description": "Whether this is the preferred contact medium for the party",
            "default": false,
            "example": false
          },
          "binding_datetime": {
            "type": "string",
            "format": "date-time",
            "description": "Date and time when the contact medium was bound to the party (defaults to start_datetime if not provided)",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "description": "Status of the contact medium:\n* 1 - Active (default)\n* 2 - Inactive\nPara crear el status puede ser cualquier valor, pero se guardará como 1.\nPara modificar solo se permiten los valores 1 y 2.\n",
            "enum": [
              1,
              2
            ],
            "default": 1,
            "example": 1
          }
        },
        "required": [
          "geographic_address_id",
          "contact_medium_type_id",
          "start_datetime"
        ]
      },
