      "post": {
        "tags": [
          "Customer"
        ],
        "summary": "Create a new customer",
        "operationId": "create_customer",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "rank": {
                    "type": "number",
                    "format": "decimal",
                    "description": "Customer rank (0.00 to 99.99)",
                    "example": 4.7,
                    "default": 0.0
                  },
                  "status": {
                    "type": "integer",
                    "description": "Customer status (1=Active, 2=Inactive)",
                    "enum": [
                      1,
                      2
                    ],
                    "example": 1,
                    "default": 1
                  },
                  "name": {
                    "type": "string",
                    "description": "Party role name",
                    "example": "Customer Name"
                  },
                  "description": {
                    "type": "string",
                    "description": "Party role description",
                    "example": "Description of the customer"
                  },
                  "status_reason": {
                    "type": "string",
                    "description": "Reason for the current status",
                    "example": "New customer"
                  }
                },
                "required": [
                  "rank"
                ]
              },
              "examples": {
                "example-1": {
                  "value": {
                    "rank": 4.7,
                    "status": 1,
                    "name": "Juan Pérez",
                    "description": "Description of the customer",
                    "status_reason": "New customer"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "User created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                },
                "examples": {
                  "example-1": {
                    "value": {
                      "is_success": true,
                      "code": "Success",
                      "message": "Customer created successfully"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or invalid status (only values 1 and 2 are allowed)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "No authorized to access the resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        },
        "x-openapi-router-controller": "swagger_server.controllers.customer_controller"
      }
    },
