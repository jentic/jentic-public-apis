            "type": "object",
            "properties": {
              "total": {
                "type": "integer",
                "description": "Total number of items across all pages",
                "example": 42
              },
              "page": {
                "type": "integer",
                "description": "Current page number",
                "example": 1
              },
              "limit": {
                "type": "integer",
                "description": "Number of items per page",
                "example": 20
              },
              "total_pages": {
                "type": "integer",
                "description": "Total number of pages",
                "example": 3
              }
            }
          }
        },
        "required": [
          "pagination",
          "is_success",
          "message"
        ]
      },
      "RelationshipRequest": {
        "type": "object",
        "properties": {
          "from_party_role_id": {
            "type": "integer",
            "format": "int64"
          },
          "to_party_role_id": {
            "type": "integer",
            "format": "int64"
          },
          "relationship_type_id": {
            "type": "integer",
            "format": "int64",
            "description": "ID del tipo de relación. Si se envía, tiene prioridad sobre description. Si no se envía, se intentará resolver desde description o se usará el primer tipo activo por defecto.\n"
          },
          "description": {
            "type": "string",
            "description": "Descripción del tipo de relación. Si se envía y no viene relationship_type_id, se resolverá automáticamente el relationship_type_id correspondiente.\nValores disponibles: - \"Holding - Sucursal\" - \"Corporativo - Sucursal\" - \"Empleador - Empleado\" - \"Proveedor - Cliente\" - \"Matriz - Subsidiaria\"\n"
          }
        },
        "required": [
          "from_party_role_id",
          "to_party_role_id"
        ]
      },
      "RelationshipType": {
        "type": "integer",
        "enum": [
          1,
          2,
          3,
          4,
          5
        ],
        "description": "Tipo de relación:\n* 1 - Corporativo\n* 2 - Sucursal\n* 3 - Filial\n* 4 - Partner\n* 5 - Empleado\n",
        "example": 1
      },
      "RelationshipResponse": {
        "type": "object",
        "properties": {
          "party_relationship_id": {
            "type": "integer",
            "format": "int64",
            "description": "ID of the relationship in PartyRelationship table"
          },
          "party": {
            "$ref": "#/components/schemas/PartyData"
          },
          "type": {
            "type": "integer",
            "description": "Type of relationship (1=Corporativo, 2=Sucursal, 3=Filial, 4=Partner, 5=Empleado)"
          },
          "status": {
            "type": "integer",
            "description": "Status of the relationship"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the relationship was created"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the relationship was last updated"
          }
        },
        "required": [
          "party_relationship_id",
          "party",
          "type",
          "status",
          "created_at",
          "updated_at"
        ]
      },
      "PartyData": {
        "type": "object",
