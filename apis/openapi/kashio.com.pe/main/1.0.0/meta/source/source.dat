      "description": "Production server"
    }
  ],
  "tags": [
    {
      "name": "Customer",
      "description": "Customer management operations"
    },
    {
      "name": "Products",
      "description": "Products management operations"
    },
    {
      "name": "Agreements",
      "description": "Agreements management operations"
    },
    {
      "name": "Organizations",
      "description": "Organization management operations"
    },
    {
      "name": "Individuals",
      "description": "Individual management operations"
    },
    {
      "name": "PartyRoleTypes",
      "description": "Party Role Types define the roles that parties (customers, organizations, individuals) \ncan play in the system. These operations allow management of party role type definitions\nincluding creation, listing, updating, and deletion.\n"
    },
    {
      "name": "PartyRoles",
      "description": "Party Roles are the specific roles assigned to parties (customers, organizations, individuals)\nin the system. These operations allow management of party roles including creation, assignment,\nlisting, updating, and deletion.\n"
    },
    {
      "name": "Contacts",
      "description": "Contact management operations"
    },
    {
      "name": "Addresses",
      "description": "Address management operations"
    }
  ],
