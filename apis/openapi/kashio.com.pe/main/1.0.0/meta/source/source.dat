          "updated_at"
        ]
      },
      "ContactRequest": {
        "type": "object",
        "properties": {
          "contact_id": {
            "type": "integer",
            "format": "int64",
            "description": "Contact ID (optional, will be auto-generated if not provided)"
          },
          "party_id": {
            "type": "integer",
            "format": "int64",
            "description": "Party ID (required)"
          },
          "note": {
            "type": "string",
            "maxLength": 3000,
            "description": "Contact note",
            "nullable": true
          },
          "contact_type_id": {
            "type": "integer",
            "description": "Contact type ID",
            "nullable": true
          },
          "start_datetime": {
            "type": "string",
            "format": "date-time",
            "description": "Start date and time of the contact"
          },
          "end_datetime": {
            "type": "string",
            "format": "date-time",
            "description": "End date and time of the contact (optional)",
            "nullable": true
          },
          "state": {
            "type": "integer",
            "description": "Status of the contact:\n* 1 - Active (default)\n* 2 - Inactive\nPara crear el status puede ser cualquier valor, pero se guardará como 1.\nPara modificar solo se permiten los valores 1 y 2.\n",
            "enum": [
              1,
              2
            ],
            "default": 1,
            "example": 1
          }
        },
        "required": [
          "party_id",
          "start_datetime"
        ]
      },
