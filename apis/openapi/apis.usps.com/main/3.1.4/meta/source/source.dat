{
  "openapi": "3.0.1",
  "info": {
    "title": "NCOA Data Services",
    "description": "Contact Us: [USPS API Support](https://emailus.usps.com/s/usps-APIs) | [Terms of Service](https://about.usps.com/termsofuse.htm)\n\nThis API returns a list of new and old change of address records for a given person or business and address.\n\nThis user infromation guidelines on how to correctly use the NCOA Data Service API.\nIt enforces all prerequisites and validates required parameters based on the user's License Type.\n\n**Prerequisites for Using the NCOA Data Service API for Service Provider and Limited Service Provider**\n- All requests must follow the standard guidelines defined by the NCOA License Type.\n- **Service Provider** and **Limited Service Provider** licenses are identified by License IDs starting with **\"T\"** or **\"V\"**.\n- For any address lookup request, the following parameters are mandatory:\n    - **CRID**\n    - **LicenseId**\n    - **RequestType**\n    - **MailerListID** (required for Service Provider and Limited Service Provider license types)\n\n**MailerListID Requirement**\n- If this is your first time performing an address lookup, you must first create a **MailerListID**.\n- Refer to the API specification for the MailerListID definition and creation process.\n- Once a MailerListID has been created, you may proceed with address lookup operations.\n\n**Instructions**\nFollow these steps when interacting with the NCOA Data Service API:\n\n1. Determine the user's License Type.\n   - Check for the Service Provider , LicenseId begins with **\"T\"** or Limited Service Provider, LicenseId begins with **\"V\"**.\n\n2. For any address lookup request, ensure the API request provides:\n   - CRID\n   - LicenseId\n   - RequestType\n   - MailerListID (required for Service Provider and Limited Service Provider)\n\n3. If the user does not yet have a MailerListID:\n   - Instruction to create one first.\n   - Reference the MailerListID definition from the API specification.\n   - To add MailerListID, use the same API endpoint with the RequestType set to \"MailerInsert\" and include all required MailerList information in the request body.\n   - API does not allow address lookup until MailerListID is added into the system.\n\n4. Once all required parameters are present, Licensee can proceed with the address lookup request.\n\n**NOTE**: For address lookup, use the same API endpoint with the RequestType set to \"Search\" and include all required parameters in the request body.\n",
    "version": "3.1.4",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/NBURNSTEIN/ncoa-data-services/3.1.4"
  },
  "servers": [
    {
      "url": "https://apis.usps.com/ncoa-data-services/v3",
      "description": "Production Environment Endpoint"
    }
  ],
  "paths": {
    "/search": {
      "post": {
        "tags": [
          "Resources"
        ],
        "summary": "Returns a list of records for a persons change of address",
        "description": "Returns a list of records for a person's current and old addresses.",
        "operationId": "get-coa-records-search",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangeOfAddressSearchRequest"
              }
            },
            "application/xml": {
              "schema": {
                "$ref": "#/components/schemas/ChangeOfAddressSearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "A successful request is made and will return Change Of Address Records",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecordsResponse"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/RecordsResponse"
                }
              }
            }
          },
          "201": {
            "description": "A successful request is made and will return Mailer Inserted information",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MailerResponse"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/MailerResponse"
                }
              }
            }
          },
          "400": {
            "description": "Missing required fields in the request will result in a 400 response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized or invalid token is received in the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden response means this client doesn’t have the proper scope/role",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "404": {
            "description": "Indicates the endpoint was not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          },
          "500": {
            "description": "An error has occurred within the application.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            }
          }
        },
        "security": [
          {
            "OAuth": [
              "ncoa-data-services"
            ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ChangeOfAddressSearchRequest": {
        "title": "Change Of Address Search Request",
        "required": [
          "CRID",
          "licenseID",
          "requestType"
        ],
        "type": "object",
        "properties": {
          "CRID": {
            "title": "Customer ID from Cust Reg",
            "maxLength": 18,
            "nullable": true,
            "type": "string",
            "description": "ID used to identify Customers registered to use Web Service.  It represents a business at a location.",
            "example": "123456789"
          },
          "licenseID": {
            "title": "Customer NCOA+ License ID",
            "maxLength": 4,
            "nullable": true,
            "type": "string",
            "description": "License ID used to identify Customers with an NCOA+ license.",
            "example": "XAAA"
          },
          "requestType": {
            "title": "Customer NCOA+ requestType which represents either a Mailer Insert or a Search flag",
            "maxLength": 12,
            "nullable": true,
            "type": "string",
            "description": "RequestType indicates which action you want performed a MailerInsert or Search ",
            "example": "Search"
          },
          "mailerListID": {
            "maxLength": 16,
            "type": "string",
            "description": "Mailer List ID signifies the Customer/BALA/End User (List Owner) for whom the request is made.  BALA is a broker, agent, or list administrator.",
            "example": "QWERTY321"
          },
          "mailerList": {
            "title": "The Mailer List information",
            "type": "object",
            "description": "The object that hold all the properties for Mailer List information.",
            "properties": {
              "mailerCompany": {
                "maxLength": 255,
                "type": "string",
                "description": "Name of the Mailer Company",
                "example": "ABC Company",
                "nullable": true
              },
              "mailerID": {
                "maxLength": 9,
                "type": "string",
                "description": "Mailer ID Associated with License. Should be 6 or 9 digits, Numberic only. If you use a 9 digit number it must begin with the number 9.",
                "example": "123456",
                "nullable": true
              },
              "mailerNAICSCode": {
                "maxLength": 6,
                "type": "string",
                "description": "NAICS Code tied to nature of the work the company does",
                "example": "123456",
                "nullable": true
              },
              "mailerCompanyAddr": {
                "maxLength": 64,
                "type": "string",
                "description": "Mailer Company Address",
                "example": "225 N HUMPHREYS BLVD STE 501",
                "nullable": true
              },
              "mailerCompanyCity": {
                "maxLength": 28,
                "type": "string",
                "description": "Mailer Company City",
                "example": "MEMPHIS",
                "nullable": true
              },
              "mailerCompanyState": {
                "maxLength": 2,
                "type": "string",
                "description": "Mailer Company State",
                "example": "VA",
                "nullable": true
              },
              "mailerCompanyZIP": {
                "maxLength": 5,
                "type": "string",
                "description": "Mailer Company ZIP Code",
                "example": "38188",
                "nullable": true
              },
              "mailerCompanyAddon": {
                "maxLength": 4,
                "type": "string",
                "description": "Mailer Company Zip Code +4",
                "example": "0001",
                "nullable": true
              },
              "mailerCompanyUrb": {
                "maxLength": 28,
                "type": "string",
                "description": "Mailer Company Urbanization",
                "example": "URB FAIR OAKS",
                "nullable": true
              },
              "mailerCompanyPhone": {
                "maxLength": 10,
                "type": "string",
                "description": "Mailer Company Phone Number",
                "example": "9998675309",
                "nullable": true
              },
              "mailerCompanyUrl": {
                "maxLength": 255,
                "type": "string",
                "description": "Mailer Company Website",
                "example": "https://www.google.com",
                "nullable": true
              },
              "mailerContactName": {
                "maxLength": 255,
                "type": "string",
                "description": "Mailer Contact Name",
                "example": "USPS NCSC",
                "nullable": true
              },
              "mailerContactAddr": {
                "maxLength": 64,
                "type": "string",
                "description": "Mailer Contact Address",
                "example": "225 N HUMPHREYS BLVD STE 501",
                "nullable": true
              },
              "mailerContactCity": {
                "maxLength": 28,
                "type": "string",
                "description": "Mailer Contact City",
                "example": "MEMPHIS",
                "nullable": true
              },
              "mailerContactState": {
                "maxLength": 2,
                "type": "string",
                "description": "Mailer Contact State",
                "example": "VA",
                "nullable": true
              },
              "mailerContactZIP": {
                "maxLength": 5,
                "type": "string",
                "description": "Mailer Contact Zip Code",
                "example": "38188",
                "nullable": true
              },
              "mailerContactAddon": {
                "maxLength": 4,
                "type": "string",
                "description": "Mailer Contact Zip Code +4",
                "example": "0001",
                "nullable": true
              },
              "mailerContactUrb": {
                "maxLength": 28,
                "type": "string",
                "description": "Mailer Contact Urbanization",
                "example": "URB FAIR OAKS",
                "nullable": true
              },
              "mailerContactPhone": {
                "maxLength": 12,
                "type": "string",
                "description": "Mailer Contact Phone Number",
                "example": "9998675309",
                "nullable": true
              },
              "activeThroughDt": {
                "type": "string",
                "description": "The date through when a Mailer List is active",
                "example": "2026-09-30 00:00:00"
              },
              "balaMailerID": {
                "maxLength": 9,
                "type": "string",
                "description": "Bala Mailer ID",
                "example": "123456",
                "nullable": true
              },
              "balaNAICSCode": {
                "maxLength": 6,
                "type": "string",
                "description": "NAICS Code tied to nature of the work the company does",
                "example": "123456",
                "nullable": true
              },
              "balaCompanyName": {
                "maxLength": 255,
                "type": "string",
                "description": "bala Company Name",
                "example": "USPS NCSC",
                "nullable": true
              },
              "balaCompanyAddr": {
                "maxLength": 64,
                "type": "string",
                "description": "bala Company Address",
                "example": "225 N HUMPHREYS BLVD STE 501",
                "nullable": true
              },
              "balaCompanyCity": {
                "maxLength": 28,
                "type": "string",
                "description": "bala Company City",
                "example": "MEMPHIS",
                "nullable": true
              },
              "balaCompanyState": {
                "maxLength": 2,
                "type": "string",
                "description": "bala Company State",
                "example": "VA",
                "nullable": true
              },
              "balaCompanyZIP": {
                "maxLength": 5,
                "type": "string",
                "description": "bala Company Zip Code",
                "example": "38188",
                "nullable": true
              },
              "balaCompanyAddon": {
                "maxLength": 4,
                "type": "string",
                "description": "bala Company ZIP Code +4",
                "example": "0001",
                "nullable": true
              },
              "balaCompanyUrb": {
                "maxLength": 28,
                "type": "string",
                "description": "bala Company Urbanization",
                "example": "URB FAIR OAKS",
                "nullable": true
              },
              "balaCompanyPhone": {
                "maxLength": 12,
                "type": "string",
                "description": "bala Company Phone Number",
                "example": "9998675309",
                "nullable": true
              },
              "balaCompanyUrl": {
                "maxLength": 255,
                "type": "string",
                "description": "bala Company Website",
                "example": "https://www.google.com",
                "nullable": true
              },
              "balaContactName": {
                "maxLength": 255,
                "type": "string",
                "description": "bala Contact Name",
                "example": "USPS NCSC",
                "nullable": true
              },
              "balaContactAddr": {
                "maxLength": 64,
                "type": "string",
                "description": "bala Contact Address",
                "example": "225 N HUMPHREYS BLVD STE 501",
                "nullable": true
              },
              "balaContactCity": {
                "maxLength": 28,
                "type": "string",
                "description": "bala Contact City",
                "example": "MEMPHIS",
                "nullable": true
              },
              "balaContactState": {
                "maxLength": 2,
                "type": "string",
                "description": "bala Contact State",
                "example": "VA",
                "nullable": true
              },
              "balaContactZIP": {
                "maxLength": 5,
                "type": "string",
                "description": "bala Contact ZIP Code",
                "example": "38188",
                "nullable": true
              },
              "balaContactAddon": {
                "maxLength": 4,
                "type": "string",
                "description": "bala Contact Zip Code +4",
                "example": "0001",
                "nullable": true
              },
              "balaContactUrb": {
                "maxLength": 28,
                "type": "string",
                "description": "bala Contact Urbanization",
                "example": "URB FAIR OAKS",
                "nullable": true
              },
              "balaContactPhone": {
                "maxLength": 12,
                "type": "string",
                "description": "bala Contact Phone Number",
                "example": "9998675309",
                "nullable": true
              },
              "balaBrokerIndicator": {
                "maxLength": 1,
                "type": "string",
                "description": "Bala Broker Indicator denoting if bala information is present",
                "example": "N",
                "nullable": true,
                "default": "N"
              }
            }
          },
          "nameAddresses": {
            "title": "Name Addresses",
            "type": "array",
            "description": "List of Name Addresses to search in the batch",
            "items": {
              "$ref": "#/components/schemas/NameAddresses"
            }
          },
          "numberOfMonths": {
            "title": "Number of Months",
            "type": "integer",
            "minimum": 1,
            "maximum": 48,
            "description": "Number of Months for the request 1 THROUGH 48. Minimum of 1 month & Maximum of 48 months.",
            "example": 6
          }
        },
        "additionalProperties": false,
        "description": "User information to search for old and new address records"
      },
      "NameAddresses": {
        "title": "The Addressee information",
        "type": "object",
        "properties": {
          "fullName": {
            "maxLength": 66,
            "type": "string",
            "description": "COA Full Name (Prefix, First Name, Middle Name, Last Name, Suffix)",
            "example": "JOHNNY APPLESEED",
            "nullable": true
          },
          "streetAddress": {
            "$ref": "#/components/schemas/StreetAddress"
          },
          "lastline": {
            "maxLength": 42,
            "type": "string",
            "description": "City State ZIP Code&#8482;",
            "example": "Anytown PA 22222",
            "nullable": true
          },
          "urbanization": {
            "$ref": "#/components/schemas/Urbanization"
          },
          "recordID": {
            "maxLength": 50,
            "type": "string",
            "description": "ID/Keyline/etc – anything to identify the customer record",
            "example": "",
            "nullable": true
          }
        },
        "description": "The name and address of the user to search for."
      },
      "MailerResponse": {
        "title": "Mailer Response",
        "description": "Response back to the customer when Mailer List insert was created successfully",
        "type": "object",
        "properties": {
          "numberOfRecordsAdded": {
            "type": "integer",
            "description": "Number of Mailer records added.",
            "example": 1
          }
        }
      },
      "RecordsResponse": {
        "title": "Records Response",
        "type": "object",
        "properties": {
          "numberOfMonths": {
            "type": "integer",
            "maximum": 48,
            "minimum": 1,
            "description": "Number of months passed for MED for Change of Address",
            "example": 6
          },
          "recordCount": {
            "title": "Number of Records",
            "type": "integer",
            "minimum": 1,
            "maximum": 200,
            "description": "Number of Records in records Array returned to customer.",
            "example": 100
          },
          "COABeyondMonthsCount": {
            "title": "Number of Records outside requested number of Months",
            "type": "integer",
            "description": "Number of Records matched with a new address but outside requested number of Months.",
            "example": 100
          },
          "COAMatchCount": {
            "title": "Number of Records returning a new address",
            "type": "integer",
            "description": "Number of Records returning a new address (within requested number of Months).",
            "example": 100
          },
          "COANoMatchCount": {
            "title": "Number of Records returned with no COA",
            "type": "integer",
            "description": "Number of Records with no COA found on file.",
            "example": 100
          },
          "COAFoundCount": {
            "title": "Number of Records returned for matching COA but no new address",
            "type": "integer",
            "description": "Number of Records matched but no new address was available (e.g., MLNA, BCNO, new side wouldn't +4 code).",
            "example": 100
          },
          "COANotAllowedMatchCount": {
            "title": "Number of Records returned for COA match not allowed",
            "type": "integer",
            "description": "Number of Records returned for COA match not allowed (e.g., middle name mismatch, conflicting directions, etc).",
            "example": 100
          },
          "records": {
            "description": "Contains the records",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Records"
            }
          }
        },
        "description": "The Returned List of records"
      },
      "Records": {
        "description": "List of Records returned from found Old and New Address Information",
        "required": [
          "changeOfAddressInformation",
          "oldAddressInformation"
        ],
        "type": "object",
        "properties": {
          "changeOfAddressInformation": {
            "title": "Change Of Address",
            "required": [
              "beyondMonths",
              "returnCode",
              "recordCount",
              "COABeyondMonthsCount",
              "COAMatchCount",
              "COANoMatchCount",
              "COAFoundCount",
              "COANotAllowedMatchCount"
            ],
            "type": "object",
            "properties": {
              "errorCode": {
                "maxLength": 3,
                "type": "string",
                "description": "Processing Error Code",
                "example": ""
              },
              "errorDescription": {
                "maxLength": 255,
                "type": "string",
                "description": "Processing Error Description",
                "example": ""
              },
              "beyondMonths": {
                "maximum": 1,
                "type": "string",
                "description": "Change of address is beyond requested number of months.  New address will not be returned.",
                "example": "Y"
              },
              "returnCode": {
                "maxLength": 2,
                "type": "string",
                "description": "NCOA Return Code - status of match to NCOA.",
                "example": "A"
              },
              "moveEffectiveDate": {
                "type": "string",
                "format": "date",
                "description": "Change of address Move Effective Date: YYYY-MM-DD.",
                "example": "2022-05-05"
              },
              "moveType": {
                "type": "string",
                "enum": [
                  "B",
                  "F",
                  "I"
                ],
                "description": "Indicates the type of move Business (B), Family (F) or Individual (I).",
                "example": "F"
              },
              "origFullName": {
                "maxLength": 66,
                "type": "string",
                "description": "Change of Address Original Full Name",
                "example": "John Doe"
              },
              "matchedBusinessName": {
                "maxLength": 66,
                "type": "string",
                "description": "Returned result of the matched Business Name.",
                "example": "John"
              },
              "matchedFirstName": {
                "maxLength": 15,
                "type": "string",
                "description": "Returned result of the matched First Name.",
                "example": "John"
              },
              "matchedLastName": {
                "maxLength": 20,
                "type": "string",
                "description": "Returned result of the matched Last Name.",
                "example": "Doe"
              },
              "matchedSuffixName": {
                "maxLength": 6,
                "type": "string",
                "description": "Returned result of the matched Suffix Name.",
                "example": "JR"
              },
              "middleNameTwoChars": {
                "maxLength": 2,
                "type": "string",
                "description": "Returned result of the matched Middle Name,",
                "example": "CH"
              }
            },
            "description": "Information pertaining to the Change of address"
          },
          "oldAddressInformation": {
            "$ref": "#/components/schemas/AddressObject"
          },
          "newAddressInformation": {
            "$ref": "#/components/schemas/AddressObject"
          }
        }
      },
      "AddressObject": {
        "title": "Address Information",
        "required": [
          "address",
          "returnCode"
        ],
        "type": "object",
        "properties": {
          "returnCode": {
            "maxLength": 2,
            "type": "string",
            "description": "Address Matching Engine (AME) Return Code",
            "example": "31",
            "nullable": true
          },
          "footnotes": {
            "type": "string",
            "description": "The Address Matching Engine (AME) footnotes.",
            "nullable": true,
            "maxLength": 2
          },
          "address": {
            "description": "Contains the address",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/DomesticAddress"
              }
            ]
          },
          "carrierRoute": {
            "maxLength": 4,
            "type": "string",
            "description": "Carrier Route ID",
            "example": "C020",
            "nullable": true
          },
          "recordType": {
            "maxLength": 1,
            "type": "string",
            "description": "Record Type",
            "example": "S",
            "nullable": true
          },
          "DPVConfirmation": {
            "maxLength": 1,
            "type": "string",
            "description": "Delivery Point Verification (DPV&#174;) Return Code confirmation for address (Y/S/D/N)",
            "example": "Y",
            "nullable": true
          },
          "DPVBusiness": {
            "maxLength": 1,
            "type": "string",
            "description": "Address is a business (Y/N)",
            "example": "Y",
            "nullable": true
          },
          "DPVCMRA": {
            "maxLength": 1,
            "type": "string",
            "description": "Address is a Commercial Mail Receiving Agency (CMRA) (Y/N)",
            "example": "N",
            "nullable": true
          },
          "DPVDrop": {
            "maxLength": 1,
            "type": "string",
            "description": "Address is a drop - mail is dropped by USPS for further distribution (Y/N)",
            "example": "N",
            "nullable": true
          },
          "DPVEducational": {
            "maxLength": 1,
            "type": "string",
            "description": "Address is an Educational location (Y/N)",
            "example": "N",
            "nullable": true
          },
          "DPVDropCount": {
            "maxLength": 3,
            "type": "string",
            "description": "Drop Count - number of customers serviced where mail is dropped by USPS (001-999)",
            "example": "001",
            "nullable": true
          },
          "DPVLACS": {
            "maxLength": 1,
            "type": "string",
            "description": "Address is an old side LACS address (Y/N)",
            "example": "N",
            "nullable": true
          },
          "DPVNoDoorDelivery": {
            "maxLength": 1,
            "type": "string",
            "description": "No door delivery flag - for situations where door is not accessible (Y/N)",
            "example": "N",
            "nullable": true
          },
          "DPVNoStatReasonCode": {
            "maxLength": 2,
            "type": "string",
            "description": "Nostat reason code - 01-06 reasons that a delivery point is not counted for statistical purposes",
            "example": "06",
            "nullable": true
          },
          "DPVSeasonal": {
            "maxLength": 1,
            "type": "string",
            "description": "Address is seasonal - aka snowbird (Y/N)",
            "example": "N",
            "nullable": true
          },
          "DPVThrowback": {
            "maxLength": 1,
            "type": "string",
            "description": "Throwback Flag - mail is delivered to a PO Box instead of this address (Y/N)",
            "example": "N",
            "nullable": true
          },
          "DPVNoSecureLocation": {
            "maxLength": 1,
            "type": "string",
            "description": "No secure Location flag - address has been flagged as such",
            "example": "N",
            "nullable": true
          },
          "DPVVacant": {
            "maxLength": 1,
            "type": "string",
            "description": "Address is vacant (Y/N)",
            "example": "N",
            "nullable": true
          },
          "DPVNoStat": {
            "maxLength": 1,
            "type": "string",
            "description": "Nostat Flag - Not counted for statistical purposes (Y/N)",
            "example": "N",
            "nullable": true
          },
          "DPVNonDeliveryDaysFlag": {
            "maxLength": 1,
            "type": "string",
            "description": "Non-delivery days flag - If 'Y' there are day(s) that mail is not delivered.",
            "example": "N",
            "nullable": true
          },
          "DPVNonDeliveryDaysValues": {
            "maxLength": 255,
            "type": "string",
            "description": "Non-delivery days values - comma-delimited days that mail is not delivered.",
            "example": "Saturday,Sunday",
            "nullable": true
          },
          "DPVCurbDelivery": {
            "maxLength": 1,
            "type": "string",
            "description": "Address is Curb type of delivery (Y/N)",
            "example": "N",
            "nullable": true
          },
          "DPVNDCBUDelivery": {
            "maxLength": 1,
            "type": "string",
            "description": "Address is NDCBU type of delivery (Y/N)",
            "example": "N",
            "nullable": true
          },
          "DPVCentralBoxDelivery": {
            "maxLength": 1,
            "type": "string",
            "description": "Address is Central Box type of delivery (Y/N)",
            "example": "N",
            "nullable": true
          },
          "DPVOtherDelivery": {
            "maxLength": 1,
            "type": "string",
            "description": "Address is Other type of delivery (Y/N)",
            "example": "N",
            "nullable": true
          },
          "DPVDeliveryType": {
            "maxLength": 1,
            "type": "string",
            "description": "Address Delivery Type of 1 - 4",
            "example": "1",
            "nullable": true
          },
          "DPVEnhancedConfirmation": {
            "maxLength": 1,
            "type": "string",
            "description": "Enhanced DPV Confirmation Code - Indicates whether all the information needed to deliver to this address is present.",
            "example": "N",
            "nullable": true
          },
          "DPVFootnotes": {
            "maxLength": 10,
            "type": "string",
            "description": "DPV Footnotes",
            "example": "AABB",
            "nullable": true
          },
          "DPVPBSA": {
            "maxLength": 1,
            "type": "string",
            "description": "Indicates a PO Box Street Address (Y/N)",
            "example": "N",
            "nullable": true
          },
          "foreign1": {
            "maxLength": 37,
            "type": "string",
            "description": "International Freeform addresses - only valid for new addresses",
            "example": "",
            "nullable": true
          },
          "foreign2": {
            "maxLength": 37,
            "type": "string",
            "description": "International Freeform addresses - only valid for new addresses",
            "example": "",
            "nullable": true
          },
          "foreign3": {
            "maxLength": 59,
            "type": "string",
            "description": "International Freeform addresses - only valid for new addresses",
            "example": "",
            "nullable": true
          },
          "suiteLinkIndicator": {
            "maxLength": 2,
            "type": "string",
            "description": "SuiteLink Indicator - Flag to indicate if we matched in SuiteLink.",
            "example": "A",
            "nullable": true
          },
          "LACSLinkIndicator": {
            "maxLength": 1,
            "type": "string",
            "description": "LACSLink Indicator - Y/N flag to indicate whether a match is made in LACSLink&#174;.",
            "example": "",
            "nullable": true
          },
          "LACSLinkReturnCode": {
            "maxLength": 2,
            "type": "string",
            "description": "LACSLink Return Code - Flag to indicate if we matched in LACSLink.",
            "example": "",
            "nullable": true
          }
        },
        "description": "The Address Information of the request user."
      },
      "DomesticAddress": {
        "type": "object",
        "description": "Address fields for US locations",
        "properties": {
          "streetAddress": {
            "maxLength": 64,
            "type": "string",
            "description": "Primary and Secondary Address Information",
            "example": "123 Main Street",
            "nullable": true
          },
          "lastline": {
            "maxLength": 42,
            "type": "string",
            "description": "Return/Standardized City State ZIP Code&#8482;",
            "example": "Anytown, PA 22222",
            "nullable": true
          },
          "urbanization": {
            "$ref": "#/components/schemas/Urbanization"
          },
          "city": {
            "type": "string",
            "description": "City Name",
            "example": "MEMPHIS",
            "nullable": true,
            "maxLength": 28
          },
          "stateAbbr": {
            "maxLength": 2,
            "type": "string",
            "description": "State Abbreviation",
            "example": "TN",
            "nullable": true
          },
          "ZIPCode": {
            "pattern": "^\\d{5}$",
            "type": "string",
            "description": "Return/Standardize ZIP Code&#8482;",
            "example": "90210",
            "nullable": true,
            "maxLength": 5
          },
          "ZIPPlus4": {
            "pattern": "^\\d{4}$",
            "type": "string",
            "description": "This is the 4-digit component of the ZIP+4 code.",
            "example": "8697",
            "nullable": true,
            "maxLength": 4
          },
          "deliveryPoint": {
            "maxLength": 2,
            "type": "string",
            "description": "Return/Standardize Delivery Point",
            "example": "22",
            "nullable": true
          }
        }
      },
      "ErrorMessage": {
        "title": "Error",
        "type": "object",
        "properties": {
          "apiVersion": {
            "type": "string",
            "description": "The version of the API that was used and that raised the error."
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "The error status code that has been returned in response to the request."
              },
              "message": {
                "type": "string",
                "description": "A human-readable message describing the error."
              },
              "errors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "description": "The status code response returned to the client."
                    },
                    "code": {
                      "type": "string",
                      "description": "An internal subordinate code used for error diagnosis."
                    },
                    "title": {
                      "type": "string",
                      "description": "A human-readable title that identifies the error."
                    },
                    "detail": {
                      "type": "string",
                      "description": "A human-readable description of the error that occurred."
                    },
                    "source": {
                      "type": "object",
                      "properties": {
                        "parameter": {
                          "type": "string",
                          "description": "The input in the request which caused an error."
                        },
                        "example": {
                          "type": "string",
                          "description": "An example of a valid value for the input parameter."
                        }
                      },
                      "additionalProperties": true,
                      "description": "The element that is suspected of originating the error.  Helps to pinpoint the problem."
                    }
                  },
                  "additionalProperties": true
                }
              }
            },
            "additionalProperties": true,
            "description": "The high-level error that has occurred as indicated by the status code."
          }
        },
        "additionalProperties": true,
        "description": "Standard error message response."
      },
      "StreetAddress": {
        "maxLength": 64,
        "nullable": true,
        "type": "string",
        "description": "The number of a building along with the name of the road or street on which it is located."
      },
      "Urbanization": {
        "maxLength": 28,
        "type": "string",
        "description": "An area, sector, or residential development within a geographic area (typically used for addresses in Puerto Rico)",
        "nullable": true
      }
    },
    "securitySchemes": {
      "OAuth": {
        "type": "oauth2",
        "description": "The specified APIs accept an access token formatted as a JSON Web Token. The relative path to the OAuth2 version 3 API which supplies this access token is provided below for reference.",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "/oauth2/v3/token",
            "scopes": {
              "ncoa-data-services": "change of address"
            }
          },
          "authorizationCode": {
            "authorizationUrl": "/oauth2/v3/authorize",
            "tokenUrl": "/oauth2/v3/token",
            "scopes": {
              "ncoa-data-services": "national-change-of-address"
            }
          }
        }
      }
    }
  }
}
