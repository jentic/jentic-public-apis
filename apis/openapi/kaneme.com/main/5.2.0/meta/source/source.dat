es/TropDAppels"},"500":{"$ref":"#/components/responses/ErreurServeur"}}}},"/api/v1/verdict":{"post":{"operationId":"measureAuthorship","summary":"Mesure d’essai, sans compte : un texte contre trois textes de référence collés dans l’appel","tags":["Mesure"],"x-kaneme-credits":"0","x-kaneme-credit-meter":"voice","x-kaneme-required-scope":null,"x-kaneme-risk":"read","x-kaneme-mcp-tool":"measure_authorship","x-kaneme-timeout-seconds":60,"security":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"samples":{"type":"array","items":{"type":"string"},"description":"Exactement 3 textes de la personne, 100 mots minimum chacun. Varie les registres — trois fois le même contexte mesure le contexte, pas l’auteur."},"text":{"type":"string","description":"Texte à attribuer (50 mots minimum, 150 pour sortir de la confiance basse)."},"question":{"type":"string","enum":["human","author"],"description":"human = cette personne contre une IA ; author = cette personne contre un autre humain."}},"additionalProperties":{},"required":["samples","text"]}}}},"responses":{"200":{"description":"Succès.","headers":{"X-RateLimit-Limit":{"$ref":"#/components/headers/RateLimit"},"X-RateLimit-Window":{"$ref":"#/components/headers/RateWindow"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/PublicVerdict"}}}},"400":{"$ref":"#/components/responses/Invalide"},"404":{"$ref":"#/components/responses/Introuvable"},"429":{"$ref":"#/components/responses/TropDAppels"},"500":{"$ref":"#/components/responses/ErreurServeur"}}}},"/api/v1/observatory/signals":{"post":{"operationId":"readObservatorySignals","summary":"Lecture de l’Observatoire, sans compte ni crédit : passages à relire, leur critère et leur position (ni détecteur d’IA, ni preuve d’auteur)","tags":["Mesure"],"x-kaneme-credits":"0","x-kaneme-credit-meter":"voice","x-kaneme-required-scope":null,"x-kaneme-risk":"read","x-kaneme-mcp-tool":"read_observatory_signals","x-kaneme-timeout-seconds":15,"security":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"text":{"type":"string","description":"Texte à lire (12000 caractères au plus)."},"language":{"type":"string","enum":["fr","en"],"description":"Langue du texte. Absente, elle est détectée ; indéterminée, la lecture la demande."},"documentType":{"type":"string","enum":["general","social","article","email","report","marketing","documentation"],"description":"Type de texte, qui règle les conseils (défaut : general)."}},"additionalProperties":{},"required":["text"]}}}},"responses":{"200":{"description":"Succès.","headers":{"X-RateLimit-Limit":{"$ref":"#/components/headers/RateLimit"},"X-RateLimit-Window":{"$ref":"#/components/headers/RateWindow"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ObservatorySignals"}}}},"400":{"$ref":"#/components/responses/Invalide"},"404":{"$ref":"#/components/responses/Introuvable"},"429":{"$ref":"#/components/responses/TropDAppels"},"500":{"$ref":"#/components/responses/ErreurServeur"}}}},"/api/v1/generate":{"post":{"operationId":"generateInVoice","summary":"Kaneme écrit dans ta voix (coût dérivé du barème : draft, outline, section, challenge, bar-test, workflow)","tags":["Écriture"],"x-kaneme-credits":"3","x-kaneme-credit-meter":"voice","x-kaneme-required-scope":"voice:generate","x-kaneme-risk":"generate","x-kaneme-mcp-tool":"generate_in_voice","x-kaneme-timeout-seconds":60,"parameters":[{"name":"Idempotency-Key","in":"header","required":false,"schema":{"type":"string"},"description":"Rejouer le même appel avec la même clé rend le premier résultat sans re-débiter. Présent uniquement sur les opérations qui l’honorent réellement."}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"prompt":{"type":"string","description":"Ce qu’il faut écrire (max 24 000 caractères)."},"type":{"type":"string","enum":["draft","outline","section","challenge","bar-test","workflow"],"description":"Type de sortie."},"instruction":{"type":"string","description":"Consigne complémentaire (max 8 000 caractères)."},"format":{"type":"string","enum":["newsletter","linkedin_post","tweet_short","thread","tiktok_script","instagram","blog","marketing_page","academic_article","email","slack","internal_note","executive_communication"],"description":"Canal visé."},"profileId":{"type":"string","description":"Voix visée. Par défaut, la voix active du compte."},"projectId":{"type":"string","description":"Projet dont le contexte nourrit la génération."},"inspect":{"type":"boolean","description":"Joint le détail de ce qui a influencé la génération (voix, sous-voix, convictions, RAG…) avec le poids de chacun, jamais leur contenu. Sans coût."},"save":{"type":"boolean","description":"Range le texte produit dans l’espace de l’utilisateur, avec le format DE L’APPEL et provenance:\"ai\" (jamais surchargeable — une sortie IA n’est pas une ancre humaine). C’est ce qui donne au canal son corpus, donc sa sous-voix. Gratuit. Le rangement est best-effort : s’il échoue, la réponse porte saved:false et le texte reste rendu — ne relance pas la génération, elle est payée."},"title":{"type":"string","description":"Titre du document rangé (avec save). Sans lui, dérivé de la première ligne du texte."}},"additionalProperties":{},"required":["prompt"]},"example":{"prompt":"3 leçons de mon dernier projet client","type":"draft","format":"linkedin_post","save":true}}}},"responses":{"200":{"description":"Succès.","headers":{"X-RateLimit-Remaining":{"$ref":"#/components/headers/RateRemaining"},"X-RateLimit-Limit":{"$ref":"#/components/headers/RateLimit"},"X-RateLimit-Window":{"$ref":"#/components/headers/RateWindow"},"X-Request-Id":{"$ref":"#/components/headers/RequestId"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/GenerateResult"}}}},"400":{"$ref":"#/components/responses/Invalide"},"401":{"$ref":"#/components/responses/NonAutoris