alifient sa portée sans former un score composite."}}}}},"400":{"$ref":"#/components/responses/Invalide"},"401":{"$ref":"#/components/responses/NonAutorise"},"402":{"$ref":"#/components/responses/CreditsEpuises"},"404":{"$ref":"#/components/responses/Introuvable"},"409":{"$ref":"#/components/responses/Conflit"},"422":{"$ref":"#/components/responses/NonMesurable"},"429":{"$ref":"#/components/responses/TropDAppels"},"500":{"$ref":"#/components/responses/ErreurServeur"},"503":{"$ref":"#/components/responses/Indisponible"}}}},"/api/v1/compare":{"post":{"operationId":"compareTexts","summary":"Compare un texte à une référence FOURNIE (autre auteur collé, ou une autre voix)","tags":["Mesure"],"x-kaneme-credits":"3","x-kaneme-credit-meter":"voice","x-kaneme-required-scope":"voice:measure","x-kaneme-risk":"measure","x-kaneme-mcp-tool":"compare_texts","x-kaneme-timeout-seconds":60,"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"text":{"type":"string","description":"Texte à comparer."},"reference":{"type":"string","description":"Référence collée telle quelle."},"referenceProfileId":{"type":"string","description":"Ou l’id d’une voix servant de référence."},"question":{"default":"q1","description":"q1 = la voix de la référence contre celle de l’IA (défaut : q1) ; q2 = la même main que la référence plutôt qu’un autre humain, en bêta, mesuré seulement si on le demande. Aliases human/author acceptés.","type":"string","enum":["q1","q2","human","author"]}},"additionalProperties":{},"required":["text"]},"example":{"text":"Le texte à attribuer.","reference":"Un texte dont on est sûr qu’il vient de la personne de référence.","question":"q2"}}}},"responses":{"200":{"description":"Succès.","headers":{"X-RateLimit-Remaining":{"$ref":"#/components/headers/RateRemaining"},"X-RateLimit-Limit":{"$ref":"#/components/headers/RateLimit"},"X-RateLimit-Window":{"$ref":"#/components/headers/RateWindow"},"X-Request-Id":{"$ref":"#/components/heade