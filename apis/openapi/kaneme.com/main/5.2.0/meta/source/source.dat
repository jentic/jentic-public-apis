ption":"Projet concerné, pour le journal de la voix."},"documentId":{"type":"string","description":"Document concerné, pour le journal de la voix."},"sourceTitle":{"type":"string","description":"Intitulé lisible dans le journal."},"proposed":{"type":"string","description":"Le TEXTE que la machine avait proposé (avec « reject »). À envoyer avec `kept` : le signal de réécriture est dérivé serveur des deux textes, jamais reçu tout fait."},"kept":{"type":"string","description":"Le TEXTE remis à la place par l’auteur. Sans lui, `proposed` est ignoré."}},"additionalProperties":{},"required":["kind"]},"example":{"kind":"reject","format":"linkedin_post","proposed":"Le texte que la machine avait proposé.","kept":"Le texte que j’ai remis à la place."}}}},"responses":{"200":{"description":"Succès.","headers":{"X-RateLimit-Remaining":{"$ref":"#/components/headers/RateRemaining"},"X-RateLimit-Limit":{"$ref":"#/components/headers/RateLimit"},"X-RateLimit-Window":{"$ref":"#/components/headers/RateWindow"},"X-Request-Id":{"$ref":"#/components/headers/RequestId"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SignalRecorded"}}}},"400":{"$ref":"#/components/responses/Invalide"},"401":{"$ref":"#/components/responses/NonAutorise"},"402":{"$ref":"#/components/responses/CreditsEpuises"},"404":{"$ref":"#/components/responses/Introuvable"},"409":{"$ref":"#/components/responses/Conflit"},"422":{"$ref":"#/components/responses/NonMesurable"},"429":{"$ref":"#/components/responses/TropDAppels"},"500":{"$ref":"#/components/responses/ErreurServeur"},"503":{"$ref":"#/components/responses/Indisponible"}}}},"/api/v1/score":{"post":{"operationId":"scoreText","summary":"Relevé d’automatismes et écarts locaux — score historique, aucune probabilité d’attribution","tags":["Mesure"],"x-kaneme-credits":"0","x-kaneme-credit-meter":"voice","x-kaneme-required-scope":"voice:measure","x-kaneme-risk":"measure","x-kaneme-mcp-tool":"score_text","x-kaneme-timeout-seconds":15,"requestBody":{"