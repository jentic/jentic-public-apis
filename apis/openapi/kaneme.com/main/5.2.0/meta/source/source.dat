uired":["resourceType","resourceId","action","status","reversible","restorableDays","message"],"additionalProperties":{}}}},"required":["dryRun","results"],"additionalProperties":{}}},"securitySchemes":{"apiKey":{"type":"http","scheme":"bearer","description":"Clé d’API du compte, créée sur la page Connexions. En-tête : `Authorization: Bearer kaneme_…`. Les clés `frq_…` émises avant le changement de nom restent acceptées. C’est la voie MACHINE-À-MACHINE : un programme qui agit pour son propre compte. Ses portées sont choisies à la création ; les gestes sensibles restent décochés par défaut. Les clés historiques sans portées explicites conservent leur accès pour compatibilité. Pour qu’un agent agisse au nom d’un utilisateur, passer par le serveur MCP (`/api/mcp`), dont Kaneme émet les jetons OAuth."}},"responses":{"Invalide":{"description":"Requête invalide (champ manquant, borne dépassée, curseur illisible).","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string","description":"Compatibility alias for the localized message."},"message":{"type":"string","description":"Message in the verified account interface_locale; French when no account preference is available."},"code":{"type":"string","description":"Stable machine code, independent of message language (for example, invalid_input)."}},"required":["code","message"]}}}},"NonAutorise":{"description":"Clé absente, invalide ou révoquée.","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string","description":"Compatibility alias for the localized message."},"message":{"type":"string","description":"Message in the verified account interface_locale; French when no account preference is available."},"code":{"type":"string","description":"Stable machine code, independent of message language (for example, invalid_input)."}},"required":["code","message"]}}}},"CreditsEpuises":{"description":"Crédits insuffisants, OU surface non ouverte à ce compte. code = \"subscription_required\" : L’API et le MCP se paient en crédits, et ce compte n’en a plus. Recharge ton solde pour réactiver ta clé. code = \"credits_exhausted\" : lire `window` pour savoir quoi faire (recharger, attendre la période, demander à un admin de relever le budget, relever le plafond de la clé).","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string","description":"Compatibility alias for the localized message."},"message":{"type":"string","description":"Message in the verified account interface_locale; French when no account preference is available."},"code":{"type":"string","description":"Stable machine code, independent of message language (for example, invalid_input)."},"window":{"type":"string","enum":["balance","period","budget","api_key"],"description":"Présent quand code = \"credits_exhausted\". `balance` : solde vide, la suite est une recharge. `period` : ancien abonnement, le quota repart à la période suivante. `budget` : membre d’une équipe dont le budget mensuel est pris — un admin le relève ; recharger n’y change rien. `api_key` : la clé appelante a pris son plafond mensuel (réglé par son propriétaire dans Connexions) ; l’app et les autres clés continuent. `budget` et `api_key` repartent le 1er du mois (UTC)."},"meter":{"type":"string","description":"Compteur concerné (« voice »)."},"budget":{"type":"object","description":"Pour `window` = `budget` ou `api_key` : le plafond du mois et ce qui est déjà pris, en crédits.","properties":{"limit":{"type":"integer"},"used":{"type":"integer"}},"required":["limit","used"]}},"required":["error"]}}}},"TropDAppels":{"description":"Cadence dépassée (code « rate_limited »). La réponse porte X-RateLimit-Limit, X-RateLimit-Remaining, X-RateLimit-Window et Retry-After — attends la fenêtre indiquée : un retry immédiat la prolonge. Les plafonds appliqués sont dans x-kaneme-rate-limits. Quand le refus vient d’un plafond PAR OPÉRATION (générer, créer un document ou un projet, déposer une source), ces nombres sont ceux de CETTE opération, pas ceux de la surface.","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string","description":"Compatibility alias for the localized message."},"message":{"type":"string","description":"Message in the verified account interface_locale; French when no account preference is available."},"code":{"type":"string","description":"Stable machine code, independent of message language (for example, invalid_input)."}},"required":["code","message"]}}},"headers":{"Retry-After":{"schema":{"type":"integer"},"description":"Secondes à attendre. Ne part que sur un refus."},"X-RateLimit-Limit":{"$ref":"#/components/headers/RateLimit"},"X-RateLimit-Remaining":{"$ref":"#/components/headers/RateRemaining"},"X-RateLimit-Window":{"$ref":"#/components/headers/RateWindow"}}},"Introuvable":{"description":"Ressource introuvable.","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string","description":"Compatibility alias for the localized message."},"message":{"type":"string","description":"Message in the verified account interface_locale; French when no account preference is available."},"code":{"type":"string","description":"Stable machine code, independent of message language (for example, invalid_input)."}},"required":["code","message"]}}}},"Conflit":{"description":"Conflit d’état ou de clé d’idempotence.","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string","description":"Compatibility alias for the localized message."},"message":{"type":"string","description":"Message in the verified account interface_locale; French when no account preference is available."},"code":{"type":"string","description":"Stable machine code, independent of message language (for example, invalid_input)."}},"required":["code","message"]}}}},"NonMesurable":{"description":"Le moteur s’abstient ou le corpus est insuffisant.","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string","description":"Compatibility alias for the localized message."},"message":{"type":"string","description":"Message in the verified account interface_locale; French when no account preference is available."},"code":{"type":"string","description":"Stable machine code, independent of message language (for example, invalid_input)."}},"required":["code","message"]}}}},"ErreurServeur":{"description":"Erreur interne.","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string","description":"Compatibility alias for the localized message."},"message":{"type":"string","description":"Message in the verified account interface_locale; French when no account preference is available."},"code":{"type":"string","description":"Stable machine code, independent of message language (for example, invalid_input)."}},"required":["code","message"]}}}},"Indisponible":{"description":"Service ou compteur temporairement indisponible.","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string","description":"Compatibility alias for the localized message."},"message":{"type":"string","description":"Message in the verified account interface_locale; French when no account preference is available."},"code":{"type":"string","description":"Stable machine code, independent of message language (for example, invalid_input)."}},"required":["code","message"]}}}}},"headers":{"RateLimit":{"schema":{"type":"integer"},"description":"Appels autorisés par fenêtre, pour le plafond qui s’applique à cet appel."},"RateRemaining":{"schema":{"type":"integer"},"description":"Appels restants dans la fenêtre, au passage de la garde — le jeton de cette requête est déjà décompté."},"RateWindow":{"schema":{"type":"integer"},"description":"Durée de la fenêtre, en secondes."},"RequestId":{"schema":{"type":"string","format":"uuid"},"description":"Identifiant d