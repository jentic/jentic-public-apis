          },
          "text_addon": {
            "type": "string"
          },
          "signature": {
            "type": "string"
          },
          "attachment_file_names": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": null,
            "maxItems": 20,
            "nullable": true
          }
        },
        "type": "object"
      },
      "MailInlineImageResponse": {
        "properties": {
          "original_file_name": {
            "type": "string",
            "example": "photo.jpg"
          },
          "file_size": {
            "type": "integer"
          },
          "mime_type": {
            "type": "string"
          },
          "display_url": {
            "description": "Use this URL as src=\"\" in the email body HTML to display the inline image.",
            "type": "string",
            "example": "https://app.example.com/inline-image/display/42/abc123def/photo.jpg"
          }
        },
        "type": "object"
      },
      "MailTicketReferenceResponse": {
