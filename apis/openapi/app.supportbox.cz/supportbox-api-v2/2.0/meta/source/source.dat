            "type": "string",
            "example": "<message-id@example.com>",
            "nullable": true
          },
          "text": {
            "type": "string",
            "example": "Hello, how can I help you?",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "example": "2025-01-01 10:00:00"
          },
          "updated_at": {
            "type": "string",
            "example": "2025-01-01 11:00:00",
            "nullable": true
          },
