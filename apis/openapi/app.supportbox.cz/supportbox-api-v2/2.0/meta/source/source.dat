            "type": "string",
            "example": "sender@example.com",
            "nullable": true
          },
          "to": {
            "type": "string",
            "example": "recipient@example.com",
            "nullable": true
          },
          "cc": {
            "type": "string",
            "example": "cc@example.com",
            "nullable": true
          },
          "bcc": {
            "type": "string",
            "example": "bcc@example.com",
            "nullable": true
          },
          "reply_to": {
            "type": "string",
            "example": "replyto@example.com",
            "nullable": true
          },
