      "MailMessageType": {
        "type": "string",
        "enum": [
          "in",
          "in_3rd",
          "out_new",
          "out_reply",
          "out_autoreply",
          "out_forward",
          "memo"
        ]
      },
      "CreateMailTicketInput": {
        "required": [
          "text",
          "to",
          "from",
          "subject"
        ],
        "properties": {
          "parent_mail_ticket_id": {
            "type": "integer"
          },
          "type": {
            "$ref": "#/components/schemas/MailMessageType"
          },
          "text": {
            "type": "string"
          },
          "to": {
            "type": "string",
            "maxLength": 255
          },
          "from": {
            "type": "string",
            "maxLength": 255
          },
          "subject": {
            "type": "string",
            "maxLength": 255
          },
          "attachment_file_names": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": null,
            "maxItems": 20,
            "nullable": true
          }
        },
        "type": "object"
      },
      "MailTicketMessageCreateInput": {
        "required": [
          "text",
          "source_message_id",
          "to",
          "subject"
        ],
        "properties": {
          "type": {
            "$ref": "#/components/schemas/MailMessageType"
          },
