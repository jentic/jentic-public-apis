    "/api/rest/v2/files": {
      "post": {
        "tags": [
          "Files"
        ],
        "summary": "Upload a temporary file",
        "description": "Uploads a file and returns a temporary file ID. Use the ID in relevant input fields (e.g. attachment_file_names when creating a message). Unused files are deleted after 1 hour. Maximum file size is 64 MB.",
        "operationId": "post_public_api_v2.files.upload",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "File uploaded. Returns a temporary file ID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PendingFileResponse"
                }
              }
            }
          },
          "422": {
            "description": "No file provided, file is invalid, or file exceeds the maximum allowed size of 64 MB.",
            "content": {
              "application/json": {
                "schema": {
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Invalid authentication."
          }
        }
      }
    },
    "/api/rest/v2/tags": {
      "get": {
        "tags": [
          "Tags"
        ],
        "summary": "List tags",
        "operationId": "get_public_api_v2.tags.list",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 25,
              "maximum": 50,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tags collection.",
            "content": {
              "application/json": {
                "schema": {
                  "required": [
                    "items",
                    "pagination"
                  ],
                  "properties": {
