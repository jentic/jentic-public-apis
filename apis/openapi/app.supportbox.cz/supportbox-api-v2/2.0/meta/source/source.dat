{
  "openapi": "3.0.0",
  "info": {
    "title": "Supportbox API V2",
    "description": "Bearer token authenticated API v2 endpoints.",
    "version": "2.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/SupportBox/SupportBox-public/2.0"
  },
  "servers": [
    {
      "url": "https://app.supportbox.cz"
    }
  ],
  "paths": {
    "/api/rest/v2/mail-inline-images": {
      "post": {
        "tags": [
          "Files"
        ],
        "summary": "Upload a mail inline image",
        "description": "Uploads an inline image (gif/jpeg/png/webp) and returns its display URL. Use the URL as src=\"\" in the email body HTML when composing messages.",
        "operationId": "post_public_api_v2.mail.inline.images.upload",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Image uploaded. Returns its display URL.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MailInlineImageResponse"
                }
              }
            }
          },
          "422": {
            "description": "No file provided, file is empty, or file is not a supported image type (gif/jpeg/png/webp).",
            "content": {
              "application/json": {
                "schema": {
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Invalid authentication."
          }
        }
      }
    },
    "/api/rest/v2/mail-attachment/{fileName}/download": {
      "get": {
        "tags": [
          "Mail message attachments"
        ],
        "summary": "Download a mail message attachment",
        "operationId": "get_public_api_v2.mail.message.attachment.download",
        "parameters": [
          {
            "name": "fileName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "File content",
            "content": {
              "application/octet-stream": {}
            }
          },
          "401": {
            "description": "Invalid authentication."
          },
          "422": {
            "description": "Attachment not found."
          }
        }
      }
    },
    "/api/rest/v2/mail-messages": {
      "get": {
        "tags": [
          "Mail Messages"
        ],
        "summary": "List mail messages",
        "operationId": "get_public_api_v2.mail.messages.list",
        "parameters": [
          {
            "name": "filter[created_by][eq]",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "filter[created_by][neq]",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "filter[created_at][eq]",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "filter[created_at][gt]",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "filter[created_at][gte]",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "filter[created_at][lt]",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "filter[created_at][lte]",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "filter[mailbox_id][eq]",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "filter[mailbox_id][neq]",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "filter[sender_email][contains]",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "email"
            }
          },
          {
            "name": "filter[sender_email][eq]",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "email"
            }
          },
          {
            "name": "filter[sender_email][neq]",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "email"
            }
          },
          {
            "name": "filter[subject][contains]",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "filter[subject][eq]",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "filter[subject][neq]",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "filter[ticket_id][eq]",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "filter[ticket_id][neq]",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 25,
              "maximum": 50,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Mail messages collection.",
            "content": {
              "application/json": {
                "schema": {
                  "required": [
                    "items",
                    "pagination"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/MailMessageResponse"
                      }
                    },
                    "pagination": {
                      "$ref": "#/components/schemas/PaginationResponse"
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request input.",
            "content": {
              "application/json": {
                "schema": {
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Users query does not support filters."
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Invalid authentication."
          }
        }
      }
    },
    "/api/rest/v2/mail-tickets/{ticketId}/messages": {
      "get": {
        "tags": [
          "Mail Messages"
        ],
        "summary": "List mail ticket messages",
        "operationId": "get_public_api_v2.mail.ticket.messages.list",
        "parameters": [
          {
            "name": "ticketId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "\\d+"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 25,
              "maximum": 50,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Mail ticket messages collection.",
            "content": {
              "application/json": {
                "schema": {
                  "required": [
                    "items",
                    "pagination"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/MailMessageResponse"
                      }
                    },
                    "pagination": {
                      "$ref": "#/components/schemas/PaginationResponse"
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request input.",
            "content": {
              "application/json": {
                "schema": {
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Users query does not support filters."
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Invalid authentication."
          },
          "403": {
            "description": "Access to ticket denied."
          }
        }
      },
      "post": {
        "tags": [
          "Mail Messages"
        ],
        "summary": "Create ticket message",
        "operationId": "post_public_api_v2.mail.ticket.messages.create",
        "parameters": [
          {
            "name": "ticketId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "pattern": "\\d+"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MailTicketMessageCreateInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created ticket message.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MailMessageResponse"
                }
              }
            }
          },
          "201": {
            "description": "Created ticket message. Message sending failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MailMessageResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request input.",
            "content": {
              "application/json": {
                "schema": {
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Invalid request input."
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Invalid authentication."
          },
          "403": {
            "description": "Access to ticket denied."
          },
          "404": {
            "description": "Ticket was not found."
          }
        }
      }
    },
    "/api/rest/v2/mailboxes/{mailboxId}/messages": {
      "post": {
        "tags": [
          "Mail Tickets"
        ],
        "summary": "Create mail ticket",
        "operationId": "post_public_api_v2.mail.messages.create",
        "parameters": [
          {
            "name": "mailboxId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "pattern": "\\d+"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateMailTicketInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created mail ticket.",
            "content": {
              "application/json": {
                "schema": {
                  "required": [
                    "ticket",
                    "message"
                  ],
                  "properties": {
                    "ticket": {
                      "$ref": "#/components/schemas/MailTicketResponse"
                    },
                    "message": {
                      "$ref": "#/components/schemas/MailMessageResponse"
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "201": {
            "description": "Created mail ticket. Message sending failed.",
            "content": {
              "application/json": {
                "schema": {
                  "required": [
                    "ticket",
                    "message"
                  ],
                  "properties": {
                    "ticket": {
                      "$ref": "#/components/schemas/MailTicketResponse"
                    },
                    "message": {
                      "$ref": "#/components/schemas/MailMessageResponse"
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request input.",
            "content": {
              "application/json": {
                "schema": {
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Invalid type"
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Invalid authentication."
          },
          "403": {
            "description": "Access to mailbox denied."
          },
          "404": {
            "description": "Mailbox was not found."
          }
        }
      }
    },
    "/api/rest/v2/mail-tickets": {
      "get": {
        "tags": [
          "Mail Tickets"
        ],
        "summary": "List mail tickets",
        "operationId": "get_public_api_v2.mail.tickets.list",
        "parameters": [
          {
            "name": "filter[assigned_user_id][eq]",
            "in": "query",
            "required": false,
            "schema": {
              "description": "Use \"null\" to filter unassigned tickets.",
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "string",
                  "enum": [
                    "null"
                  ]
                }
              ]
            }
          },
          {
            "name": "filter[assigned_user_id][neq]",
            "in": "query",
            "required": false,
            "schema": {
              "description": "Use \"null\" to filter unassigned tickets.",
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "string",
                  "enum": [
                    "null"
                  ]
                }
              ]
            }
          },
          {
            "name": "filter[created_at][eq]",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "filter[created_at][gt]",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "filter[created_at][lt]",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "filter[folder_static_id][eq]",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "filter[folder_static_id][neq]",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "filter[id][eq]",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "filter[mailbox_id][eq]",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "filter[mailbox_id][neq]",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "filter[sender_email][eq]",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "email"
            }
          },
          {
            "name": "filter[sender_email][neq]",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "email"
            }
          },
          {
            "name": "filter[status][eq]",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "new",
                "pending",
                "resolved",
                "spam"
              ]
            }
          },
          {
            "name": "filter[status][neq]",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "new",
                "pending",
                "resolved",
                "spam"
              ]
            }
          },
          {
            "name": "filter[tag_id][eq]",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "filter[tag_id][neq]",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "filter[last_message_at][eq]",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "filter[last_message_at][gt]",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "filter[last_message_at][lt]",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 25,
              "maximum": 50,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Mail tickets collection.",
            "content": {
              "application/json": {
                "schema": {
                  "required": [
                    "items",
                    "pagination"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/MailTicketResponse"
                      }
                    },
                    "pagination": {
                      "$ref": "#/components/schemas/PaginationResponse"
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "422": {
            "description": "Invalid request input.",
            "content": {
              "application/json": {
                "schema": {
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Users query does not support filters."
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Invalid authentication."
          }
        }
      }
    },
