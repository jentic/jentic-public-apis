{"openapi":"3.0.3","info":{"title":"Formfeed","version":"1.0.0","description":"Generate PDFs and images from templates and JSON data, one API call per document.\n\nFormfeed renders HTML templates written in Jinja2, Liquid or Handlebars, Word and PowerPoint\ntemplates, ad-hoc HTML and public web pages, and merges, protects and watermarks PDFs. Rendering\nand storage run in the EU (Frankfurt). Guides, the TypeScript and Python SDKs and the CLI are\ndocumented at [docs.formfeed.dev](https://docs.formfeed.dev).\n\n**Authentication**: send an API key of your workspace as `Authorization: Bearer ff_live_…`, or in\nthe `X-API-Key` header. `ff_test_…` keys render for free. Keys are created in the\n[app](https://app.formfeed.dev/keys).\n\n**Errors** are RFC 9457 problem details with a stable `code`; each problem's `type` links to the\npage that explains it. **Idempotency**: send an `Idempotency-Key` header on every POST, and a retry\nwith the same key returns the first response instead of rendering and charging again.\n**Versioning**: the version is in the path, and changes within `/v1` are additive.\n","termsOfService":"https://formfeed.dev/legal/terms","contact":{"name":"Formfeed support","email":"support@formfeed.dev","url":"https://formfeed.dev"}},"externalDocs":{"description":"Guides, SDKs and the CLI","url":"https://docs.formfeed.dev"},"servers":[{"url":"https://api-eu.formfeed.dev/v1","description":"EU (Frankfurt), where every workspace renders and stores today"},{"url":"https://api.formfeed.dev/v1","description":"Routes to the workspace's region"},{"url":"https://api-us.formfeed.dev/v1","description":"Reserved for a US region, which is not open yet"}],"security":[{"bearerAuth":[]}],"tags":[{"name":"Renders","description":"Render PDFs and images from templates, HTML or URLs."},{"name":"Templates","description":"Manage templates and versions (templates as code)."},{"name":"Files","description":"Workspace assets such as images and fonts."},{"name":"Brand","description":"The organisation's brand kit: colours, fonts, logos and legal footer every template sees as `brand`."},{"name":"Partials","description":"Shared partials of the organisation, included by name from every template of the same engine."},{"name":"Webhooks","description":"Event delivery to your endpoints."},{"name":"Account","description":"Workspace, plan and usage."},{"name":"PDF tools","description":"Merge, protect, watermark and inspect PDFs."},{"name":"Compat","description":"Migration shim for apitemplate.io clients."}],"paths":{"/renders":{"post":{"tags":["Renders"],"operationId":"createRender","summary":"Create a render","description":"Renders a PDF or image from a stored template, ad-hoc HTML or a URL. Synchronous by default; set `mode` to `async` to receive a `202` and a webhook.","parameters":[{"$ref":"#/components/parameters/IdempotencyKey"},{"name":"output","in":"query","description":"Set to `binary` to receive the file instead of JSON.","schema":{"type":"string","enum":["json","binary"],"default":"json"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RenderRequest"},"examples":{"template":{"summary":"From a template","value":{"template":"invoice-de","data":{"invoice":{"number":"2026-0042"}},"output":"pdf"}},"html":{"summary":"Ad-hoc HTML","value":{"html":"<h1>Hello {{ name }}</h1>","engine":"liquid","data":{"name":"World"},"output":"png","settings":{"image":{"width":1200,"height":630}}}},"url":{"summary":"URL to PDF","value":{"url":"https://example.com/report","output":"pdf","settings":{"paper":{"format":"A4"}}}}}}}},"responses":{"200":{"description":"Render succeeded (sync).","headers":{"RateLimit-Limit":{"schema":{"type":"integer"},"description":"Requests per second allowed for the plan."},"RateLimit-Remaining":{"schema":{"type":"integer"},"description":"Requests left in the current window."},"RateLimit-Reset":{"schema":{"type":"integer"},"description":"Seconds until the bucket is full again."},"X-Units-Charged":{"schema":{"type":"number"},"description":"Units metered for this render."},"X-Units-Remaining":{"schema":{"type":"number"}},"X-Render-Region":{"schema":{"type":"string","enum":["eu","us","apac"]}},"X-Render-Engine":{"schema":{"type":"string"}},"X-Render-Deduplicated":{"schema":{"type":"boolean"},"description":"`true` when an identical request was served from the dedup cache at zero units."},"X-Formfeed-PDF-UA":{"schema":{"type":"string","enum":["conformant","not-conformant"]},"description":"Only with `output=binary` on a render that set `settings.pdf.ua`: what the validator said about the file. The JSON answer carries the same as `accessibility`."}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Render"}},"application/pdf":{"schema":{"type":"string","format":"binary"}},"image/png":{"schema":{"type":"string","format":"binary"}}}},"202":{"description":"Render queued: either `mode: async` was requested, or a synchronous render outlived the 60 second deadline and was handed to the background.","headers":{"Location":{"schema":{"type":"string","format":"uri"},"description":"URL of the render's result (`GET /renders/{id}/result`, with `output=binary` when the request asked for the file), which answers `202` until the render has finished."},"Retry-After":{"schema":{"type":"integer"},"description":"Seconds to wait before asking `Location` again."},"X-Render-Async-Fallback":{"schema":{"type":"boolean"},"description":"`true` when a synchronous request fell back to async."}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Render"}}}},"402":{"$ref":"#/components/responses/QuotaExceeded"},"422":{"$ref":"#/components/responses/Unprocessable"},"429":{"$ref":"#/components/responses/RateLimited"},"default":{"$ref":"#/components/responses/Problem"}}},"get":{"tags":["Renders"],"operationId":"listRenders","summary":"List renders","parameters":[{"name":"template","in":"query","schema":{"type":"string"}},{"name":"status","in":"query","schema":{"$ref":"#/components/schemas/RenderStatus"}},{"name":"environment","in":"query","schema":{"type":"string","enum":["live","test"]}},{"name":"since","in":"query","schema":{"type":"string","format":"date-time"}},{"name":"until","in":"query","schema":{"type":"string","format":"date-time"}},{"$ref":"#/components/parameters/Limit"},{"$ref":"#/components/parameters/Cursor"}],"responses":{"200":{"description":"Page of renders.","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/Render"}},"next_cursor":{"type":"string","nullable":true}}}}}},"default":{"$ref":"#/components/responses/Problem"}}}},"/renders/{id}":{"get":{"tags":["Renders"],"operationId":"getRender","summary":"Get a render","parameters":[{"$ref":"#/components/parameters/RenderId"}],"responses":{"200":{"description":"Render.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Render"}}}},"404":{"$ref":"#/components/responses/NotFound"},"default":{"$ref":"#/components/responses/Problem"}}}},"/renders/{id}/result":{"get":{"tags":["Renders"],"operationId":"getRenderResult","summary":"Wait for the result of a render","description":"The URL in the `Location` of a `202` from `POST /renders`. While the render is queued or rendering, the answer is `202` with the render, the same `Location` and a `Retry-After`. Once it has finished, the answer is what the synchronous request would have returned: the render, the file with `output=binary`, or the render's error as a problem with its `render_id`. Clients that follow a `202` on their own, such as Power Automate and Logic Apps, therefore wait for the document. The SDKs wait by polling `GET /renders/{id}` instead.","parameters":[{"$ref":"#/components/parameters/RenderId"},{"name":"output","in":"query","description":"Set to `binary` to receive the file instead of JSON.","schema":{"type":"string","enum":["json","binary"],"default":"json"}}],"responses":{"200":{"description":"The render has succeeded.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Render"}},"application/pdf":{"schema":{"type":"string","format":"binary"}},"image/png":{"schema":{"type":"string","format":"binary"}}}},"202":{"description":"The render is still queued or rendering.","headers":{"Location":{"schema":{"type":"string","format":"uri"},"description":"This URL again."},"Retry-After":{"schema":{"type":"integer"},"description":"Seconds to wait before asking again."}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Render"}}}},"404":{"$ref":"#/components/responses/NotFound"},"422":{"$ref":"#/components/responses/Unprocessable"},"default":{"$ref":"#/components/responses/Problem"}}}},"/renders/{id}/input":{"get":{"tags":["Renders"],"operationId":"getRenderInput","summary":"Get the request of a render","description":"The stored request of a render, as what renders it again: the template and version (or the HTML and engine, or the URL), the data, the locale and the options. Requests are kept only when the workspace turns on \"Keep render requests\" (off by default; 24 hours from Starter, 7 days from Pro); otherwise, and after the period, the answer is 410 `render_input_expired`. Passwords are never kept. Needs the `render:input` scope, which new keys do not have by default; every read is written to the audit log.","parameters":[{"$ref":"#/components/parameters/RenderId"}],"responses":{"200":{"description":"The stored request.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RenderInput"}}}},"404":{"$ref":"#/components/responses/NotFound"},"410":{"$ref":"#/components/responses/Problem"},"default":{"$ref":"#/components/responses/Problem"}}}},"/renders/{id}/outputs":{"delete":{"tags":["Renders"],"operationId":"deleteRenderOutputs","summary":"Delete stored outputs of a render","parameters":[{"$ref":"#/components/parameters/RenderId"}],"responses":{"204":{"description":"Outputs deleted."},"404":{"$ref":"#/components/responses/NotFound"},"default":{"$ref":"#/components/responses/Problem"}}}},"/renders/batch":{"post":{"tags":["Renders"],"operationId":"createBatch","summary":"Create a batch of renders","description":"Up to 1 000 renders in one job. Always asynchronous. Optional zip of all outputs.","parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["items"],"properties":{"template":{"type":"string","description":"Default template for all items."},"canary_key":{"type":"string","maxLength":200,"description":"Default `canary_key` for all items. Without one, every item of the batch lands on the same version of a channel with a canary."},"output":{"allOf":[{"$ref":"#/components/schemas/OutputFormat"}],"description":"Default `output` for all items; an item's own `output` wins. Without either, each item's template decides."},"items":{"type":"array","maxItems":1000,"items":{"$ref":"#/components/schemas/RenderRequest"}},"zip":{"type":"boolean","default":false},"webhook_url":{"type":"string","format":"uri","nullable":true},"webhook_secret":{"type":"string","minLength":16,"maxLength":200,"nullable":true,"description":"Signs the deliveries to `webhook_url` (same scheme as an endpoint secret). Write-only, never returned; without it those deliveries stay unsigned."},"meta":{"type":"object","additionalProperties":true}}}}}},"responses":{"202":{"description":"Job queued.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Job"}}}},"422":{"$ref":"#/components/responses/Unprocessable"},"default":{"$ref":"#/components/responses/Problem"}}}},"/jobs/{id}":{"get":{"tags":["Renders"],"operationId":"getJob","summary":"Get a batch job","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","example":"job_01J8ZK4M3Q"}}],"responses":{"200":{"description":"Job.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Job"}}}},"404":{"$ref":"#/components/responses/NotFound"},"default":{"$ref":"#/components/responses/Problem"}}}},"/templates":{"get":{"tags":["Templates"],"operationId":"listTemplates","summary":"List templates","parameters":[{"name":"kind","in":"query","schema":{"$ref":"#/components/schemas/TemplateKind"}},{"name":"engine","in":"query","schema":{"$ref":"#/components/schemas/Engine"}},{"name":"tag","in":"query","schema":{"type":"string"}},{"name":"q","in":"query","schema":{"type":"string"}},{"$ref":"#/components/parameters/Limit"},{"$ref":"#/components/parameters/Cursor"}],"responses":{"200":{"description":"Page of templates.","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/Template"}},"next_cursor":{"type":"string","nullable":true}}}}}},"default":{"$ref":"#/components/responses/Problem"}}},"post":{"tags":["Templates"],"operationId":"createTemplate","summary":"Create a template","description":"Creates a template with a first draft version. Requires the `template:write` scope.\n\nA Word or PowerPoint template (`kind` `docx` or `pptx`) is created from its file: send\n`multipart/form-data` with the file as `file` (up to 20 MB) and the other fields as form\nfields, objects (`settings`, `sample_data`, `data_schema`, `i18n`, `tags`) as JSON text. The\nfile is checked by its content and stored privately; `html`, `css`, `head` and `partials` do\nnot apply.\n\nWhere the plan limits the number of templates (five on Free), a template beyond it is\nrefused with `403 forbidden`, `feature: \"templates\"` and the plan's `limit`. Archived\ntemplates do not count.\n","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/TemplateCreate"}},"multipart/form-data":{"schema":{"allOf":[{"$ref":"#/components/schemas/TemplateCreate"},{"type":"object","required":["file"],"properties":{"file":{"type":"string","format":"binary","description":"The Word (DOCX) or PowerPoint (PPTX) file, up to 20 MB."}}}]}}}},"responses":{"201":{"description":"Created.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Template"}}}},"403":{"description":"The key lacks `template:write`, or the plan holds no further template.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}},"409":{"description":"Slug already exists.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}},"413":{"description":"File too large.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}},"415":{"description":"Not a Word or PowerPoint file of the template's kind.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}},"422":{"$ref":"#/components/responses/Unprocessable"},"default":{"$ref":"#/components/responses/Problem"}}}},"/templates/{id}":{"parameters":[{"$ref":"#/components/parameters/TemplateId"}],"get":{"tags":["Templates"],"operationId":"getTemplate","summary":"Get a template","responses":{"200":{"description":"Template.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Template"}}}},"404":{"$ref":"#/components/responses/NotFound"},"default":{"$ref":"#/components/responses/Problem"}}},"put":{"tags":["Templates"],"operationId":"updateTemplate","summary":"Update template metadata","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"name":{"type":"string"},"description":{"type":"string"},"tags":{"type":"array","items":{"type":"string"}}}}}}},"responses":{"200":{"description":"Updated.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Template"}}}},"404":{"$ref":"#/components/responses/NotFound"},"default":{"$ref":"#/components/responses/Problem"}}},"delete":{"tags":["Templates"],"operationId":"archiveTemplate","summary":"Archive a template","responses":{"204":{"description":"Archived."},"404":{"$ref":"#/components/responses/NotFound"},"default":{"$ref":"#/components/responses/Problem"}}}},"/templates/{id}/versions":{"parameters":[{"$ref":"#/components/parameters/TemplateId"}],"get":{"tags":["Templates"],"operationId":"listTemplateVersions","summary":"List versions","responses":{"200":{"description":"Versions, newest first.","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/TemplateVersion"}}}}}}},"default":{"$ref":"#/components/responses/Problem"}}},"post":{"tags":["Templates"],"operationId":"createTemplateVersion","summary":"Create a draft version","description":"For a Word or PowerPoint template, send `multipart/form-data` with a new `file` and the other\nfields as form fields (objects as JSON text), or JSON without a file to keep the latest\nversion's file and change data, schema or settings only.\n","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/TemplateVersionCreate"}},"multipart/form-data":{"schema":{"allOf":[{"$ref":"#/components/schemas/TemplateVersionCreate"},{"type":"object","properties":{"file":{"type":"string","format":"binary","description":"The new Word (DOCX) or PowerPoint (PPTX) file, up to 20 MB."}}}]}}}},"responses":{"201":{"description":"Draft created.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TemplateVersion"}}}},"422":{"$ref":"#/components/responses/Unprocessable"},"default":{"$ref":"#/components/responses/Problem"}}}},"/templates/{id}/versions/{which}":{"get":{"tags":["Templates"],"operationId":"getTemplateVersion","summary":"Get a version with its files","description":"`which` is `published`, `latest` (the draft the editor works on), a version number or the name of a release channel (its main version). The CLI pulls `latest` with `--draft` and `published` otherwise.","parameters":[{"$ref":"#/components/parameters/TemplateId"},{"name":"which","in":"path","required":true,"schema":{"type":"string","example":"published"}}],"responses":{"200":{"description":"Version with html, css, head, settings, sample data, schema and translations.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TemplateVersion"}}}},"404":{"$ref":"#/components/responses/NotFound"},"default":{"$ref":"#/components/responses/Problem"}}}},"/templates/{id}/versions/{which}/file":{"get":{"tags":["Templates"],"operationId":"downloadTemplateFile","summary":"Download the file of a Word or PowerPoint template","description":"`which` as for getting a version. Requires `template:read`. The file is served only here, never from the CDN.","parameters":[{"$ref":"#/components/parameters/TemplateId"},{"name":"which","in":"path","required":true,"schema":{"type":"string","example":"published"}}],"responses":{"200":{"description":"The file.","content":{"application/vnd.openxmlformats-officedocument.wordprocessingml.document":{"schema":{"type":"string","format":"binary"}},"application/vnd.openxmlformats-officedocument.presentationml.presentation":{"schema":{"type":"string","format":"binary"}}}},"404":{"$ref":"#/components/responses/NotFound"},"default":{"$ref":"#/components/responses/Problem"}}}},"/templates/{id}/versions/{number}/publish":{"post":{"tags":["Templates"],"operationId":"publishTemplateVersion","summary":"Publish a version","description":"Makes this version the one served by the API; the same as moving the `published` channel. The previously published version is archived and becomes the channel's `previous_version`. When both versions store a data schema and the new one breaks callers of the old one (a new required field, a narrower type, a removed enum value), the request answers 409 `schema_breaking_change` unless it sends `allow_breaking: true`. Renders pick the version up within a minute.","parameters":[{"$ref":"#/components/parameters/TemplateId"},{"name":"number","in":"path","required":true,"schema":{"type":"integer","minimum":1}}],"requestBody":{"required":false,"content":{"application/json":{"schema":{"type":"object","properties":{"allow_breaking":{"type":"boolean","default":false}}}}}},"responses":{"200":{"description":"Published; `schema_check` reports what changed.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TemplateVersion"}}}},"404":{"$ref":"#/components/responses/NotFound"},"409":{"$ref":"#/components/responses/Problem"},"default":{"$ref":"#/components/responses/Problem"}}}},"/templates/{id}/channels":{"get":{"tags":["Templates"],"operationId":"listTemplateChannels","summary":"List release channels","description":"`published` first, then the named channels, with the renders of the last 24 hours per version and the plan's allowance (`channels` per template besides published, `null` for unlimited, and whether canaries are allowed).","parameters":[{"$ref":"#/components/parameters/TemplateId"}],"responses":{"200":{"description":"Channels.","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/Channel"}},"limits":{"type":"object","properties":{"channels":{"type":"integer","nullable":true},"canary":{"type":"boolean"}}}}}}}},"404":{"$ref":"#/components/responses/NotFound"},"default":{"$ref":"#/components/responses/Problem"}}}},"/templates/{id}/channels/{name}":{"parameters":[{"$ref":"#/components/parameters/TemplateId"},{"name":"name","in":"path","required":true,"schema":{"type":"string","example":"staging"}}],"put":{"tags":["Templates"],"operationId":"setTemplateChannel","summary":"Create or move a channel","description":"Points the channel at `version`, optionally with a `canary` that receives `percent` of its renders (Pro and above). On `published` this publishes. The schema check of publishing applies to the main and the canary version. Starter allows 2 channels per template besides published, Pro and Business 10.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["version"],"properties":{"version":{"type":"integer","minimum":1},"canary":{"type":"object","nullable":true,"required":["version","percent"],"properties":{"version":{"type":"integer","minimum":1},"percent":{"type":"integer","minimum":1,"maximum":50}}},"allow_breaking":{"type":"boolean","default":false}}}}}},"responses":{"200":{"description":"Moved.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Channel"}}}},"201":{"description":"Created.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Channel"}}}},"403":{"$ref":"#/components/responses/Problem"},"409":{"$ref":"#/components/responses/Problem"},"422":{"$ref":"#/components/responses/Unprocessable"},"default":{"$ref":"#/components/responses/Problem"}}},"delete":{"tags":["Templates"],"operationId":"deleteTemplateChannel","summary":"Delete a channel","description":"Not for `published`. Refused with 409 `channel_in_use` while renders of the last hour used the channel, unless `force=true`.","parameters":[{"name":"force","in":"query","schema":{"type":"boolean","default":false}}],"responses":{"204":{"description":"Deleted."},"404":{"$ref":"#/components/responses/NotFound"},"409":{"$ref":"#/components/responses/Problem"},"default":{"$ref":"#/components/responses/Problem"}}}},"/templates/{id}/channels/{name}/promote":{"post":{"tags":["Templates"],"operationId":"promoteTemplateChannel","summary":"Promote the canary","description":"The canary version becomes the channel's main version and the canary is cleared.","parameters":[{"$ref":"#/components/parameters/TemplateId"},{"name":"name","in":"path","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"allow_breaking":{"type":"boolean","default":false}}}}}},"responses":{"200":{"description":"Promoted.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Channel"}}}},"404":{"$ref":"#/components/responses/NotFound"},"default":{"$ref":"#/components/responses/Problem"}}}},"/templates/{id}/channels/{name}/rollback":{"post":{"tags":["Templates"],"operationId":"rollbackTemplateChannel","summary":"Roll a channel back","description":"Returns the channel to `previous_version` and clears its canary. A second rollback returns to where the first started.","parameters":[{"$ref":"#/components/parameters/TemplateId"},{"name":"name","in":"path","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"allow_breaking":{"type":"boolean","default":false}}}}}},"responses":{"200":{"description":"Rolled back.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Channel"}}}},"404":{"$ref":"#/components/responses/NotFound"},"default":{"$ref":"#/components/responses/Problem"}}}},"/templates/{id}/schema":{"get":{"tags":["Templates"],"operationId":"getTemplateSchema","summary":"Get the data schema","description":"JSON Schema (draft 2020-12) describing the `data` object the template expects: the one stored with the published (or latest) version, or with the version `version` names, else one inferred from its sample data the way the editor does; 404 when the version has neither. With `format=make` the schema comes back as Make parameter definitions (one `data` collection, plus a `version` select listing the release channels when the template has any besides `published`), which the Make app loads as dynamic fields; a template with neither schema nor sample data then gets a single JSON field instead of a 404. With `format=swagger` it comes back as `{ \"schema\": … }` in the OpenAPI 2.0 dialect (one type per property, no `nullable` or `oneOf`, a label in `x-ms-summary`), which the Power Platform connector loads as dynamic fields; without schema or sample data that is an object without properties.","parameters":[{"$ref":"#/components/parameters/TemplateId"},{"name":"version","in":"query","description":"`published`, `latest`, a version number or the name of a release channel (its main version). Left out: the published version, else the latest.","schema":{"type":"string","example":"staging"}},{"name":"format","in":"query","description":"`json-schema` (default), `make` or `swagger`.","schema":{"type":"string","enum":["json-schema","make","swagger"],"default":"json-schema"}}],"responses":{"200":{"description":"JSON Schema, Make parameter definitions for `format=make`, or `{ schema }` for `format=swagger`.","content":{"application/schema+json":{"schema":{"type":"object","additionalProperties":true}},"application/json":{"schema":{"oneOf":[{"type":"array","items":{"type":"object","additionalProperties":true}},{"type":"object","required":["schema"],"properties":{"schema":{"type":"object","additionalProperties":true}}}]}}}},"404":{"$ref":"#/components/responses/NotFound"},"default":{"$ref":"#/components/responses/Problem"}}}},"/templates/{id}/validate":{"post":{"tags":["Templates"],"operationId":"validateTemplate","summary":"Validate a template with data","description":"Checks a template version and data without rendering: syntax and analysis of the body, header and footer, includes without a stored partial, errors that only happen when the template runs with the data, and the data against the stored data schema. For Word and PowerPoint templates the tags of the stored file are checked instead of HTML, and their diagnostics name the part and paragraph. Free; not metered. Problems with the template are diagnostics in a 200 response, not errors.","parameters":[{"$ref":"#/components/parameters/TemplateId"}],"requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"version":{"type":"string","default":"published","description":"`published`, `latest` (the newest draft), a version number or the name of a release channel (its main version)."},"data":{"type":"object","additionalProperties":true,"description":"The data to check. The version's sample data when left out."}}}}}},"responses":{"200":{"description":"Validation result.","content":{"application/json":{"schema":{"type":"object","required":["ok","template","diagnostics"],"properties":{"ok":{"type":"boolean","description":"`false` when at least one diagnostic is an error."},"template":{"type":"object","properties":{"id":{"type":"string","example":"tpl_01J8ZK4M3Q"},"slug":{"type":"string"},"version":{"type":"integer"}}},"diagnostics":{"type":"array","items":{"$ref":"#/components/schemas/Diagnostic"}}}}}}},"404":{"$ref":"#/components/responses/NotFound"},"default":{"$ref":"#/components/responses/Problem"}}}},"/files":{"get":{"tags":["Files"],"operationId":"listFiles","summary":"List workspace files","description":"The workspace file library: the images and PDFs templates reference by name. Newest first,\npaged with `cursor`. Needs `file:read`.\n","parameters":[{"$ref":"#/components/parameters/Limit"},{"$ref":"#/components/parameters/Cursor"},{"name":"prefix","in":"query","description":"Only names that start with this, so a folder like `brand/` can be listed on its own.","schema":{"type":"string","maxLength":200}}],"responses":{"200":{"description":"Files.","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/File"}},"next_cursor":{"type":"string","nullable":true}}}}}},"default":{"$ref":"#/components/responses/Problem"}}},"post":{"tags":["Files"],"operationId":"uploadFile","summary":"Upload a file","description":"Adds an image or a PDF to the workspace library and returns its CDN URL. A template reaches it\nwith `asset('logo.png')`, and relative image paths resolve against the same library.\n\nThe name is the address: uploading the same name replaces that file in place and answers 200\ninstead of 201, so every template that references it shows the new version without a change.\nNames are letters, digits, dot, dash, underscore and `/` for folders. Accepted types are PNG,\nJPEG, WebP, GIF, SVG, AVIF and PDF, up to 10 MB; a file whose bytes do not match its type is\nrefused. Organisation fonts are managed in the app, not here.\n\nThe library is served without a signature and cached at the edge for an hour, so a replacement\ntakes up to an hour to reach every viewer, and a deleted file can still be served for that\nlong. Do not put confidential documents in it. Needs `file:write`.\n","requestBody":{"required":true,"content":{"multipart/form-data":{"schema":{"type":"object","required":["file"],"properties":{"file":{"type":"string","format":"binary"},"name":{"type":"string","maxLength":200,"description":"The library name. Defaults to the uploaded file's name, cleaned up; a name given here must already be valid."}}}}}},"responses":{"200":{"description":"A file with this name was replaced.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/File"}}}},"201":{"description":"Uploaded.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/File"}}}},"413":{"description":"File too large.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}},"default":{"$ref":"#/components/responses/Problem"}}}},"/files/{id}":{"get":{"tags":["Files"],"operationId":"getFile","summary":"Read one file","description":"Metadata and URL of one library file. Needs `file:read`.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"File.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/File"}}}},"404":{"$ref":"#/components/responses/NotFound"},"default":{"$ref":"#/components/responses/Problem"}}},"delete":{"tags":["Files"],"operationId":"deleteFile","summary":"Delete a file","description":"Removes the file and its bytes. Templates that reference the name render a missing image\nafterwards, and the CDN may serve the file for up to an hour more. Needs `file:delete`.\n","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"204":{"description":"Deleted."},"404":{"$ref":"#/components/responses/NotFound"},"default":{"$ref":"#/components/responses/Problem"}}}},"/brand":{"get":{"tags":["Brand"],"operationId":"getBrand","summary":"Get the brand kit","description":"The organisation's brand kit as templates see it in the `brand` variable (`brand.colors.primary`,\n`brand.logo.primary`, `brand.legal_footer`), plus the page defaults new templates start from.\nEvery API render uses the current kit, and the assembled document carries its values as CSS\nvariables (`--brand-color-primary`, `--brand-font-heading`, `--brand-font-size`). Unset values are\n`null`. The kit is edited in the app; `formfeed brand pull` stores it for local previews.\nNeeds `template:read`.\n","responses":{"200":{"description":"Brand kit.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Brand"}}}},"default":{"$ref":"#/components/responses/Problem"}}}},"/partials":{"get":{"tags":["Partials"],"operationId":"listPartials","summary":"List shared partials","description":"The organisation's shared partials, without their source. A template includes one by name with\nits engine's syntax (`{% include \"letterhead\" %}` in Jinja2 and Liquid, `{{> letterhead}}`);\na partial of the template version with the same name wins. Renders always\nuse the current source. Needs `template:read`.\n","responses":{"200":{"description":"Shared partials, by name.","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/Partial"}}}}}}},"default":{"$ref":"#/components/responses/Problem"}}}},"/partials/{name}":{"parameters":[{"name":"name","in":"path","required":true,"description":"The partial's name.","schema":{"type":"string","pattern":"^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$","example":"letterhead"}}],"get":{"tags":["Partials"],"operationId":"getPartial","summary":"Get a shared partial","description":"One shared partial with its source. Needs `template:read`.","responses":{"200":{"description":"Partial with source.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Partial"}}}},"404":{"$ref":"#/components/responses/NotFound"},"default":{"$ref":"#/components/responses/Problem"}}},"put":{"tags":["Partials"],"operationId":"putPartial","summary":"Create or update a shared partial","description":"Creates the partial (201) or replaces its source, engine and description (200). Every template\nthat includes it renders with the new source from the next render on, without a new template\nversion. Send the `version` you last read as `base_version` to refuse the write with 409\n`conflict` when someone changed the partial in between; `formfeed partials push` does. The name\nis stored in lowercase; one that does not match the pattern is refused with 400. Sources up to\n256 KB; an organisation holds at most 200 shared partials, and creating one more is refused\nwith 400 `invalid_request` (`feature: \"partials\"`). Needs `template:write`.\n","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/PartialPut"}}}},"responses":{"200":{"description":"Updated.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Partial"}}}},"201":{"description":"Created.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Partial"}}}},"400":{"description":"Invalid name or body, or the organisation already holds 200 shared partials (`feature: \"partials\"`).","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}},"409":{"description":"`conflict`: `base_version` is not the current version. The problem carries the stored partial as `current` (`null` when it was deleted).","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}},"default":{"$ref":"#/components/responses/Problem"}}},"delete":{"tags":["Partials"],"operationId":"deletePartial","summary":"Delete a shared partial","description":"Removes the partial. Templates that still include it fail to render with a template error\nuntil the include is removed or a partial of that name exists again. Needs `template:write`.\n","responses":{"204":{"description":"Deleted."},"404":{"$ref":"#/components/responses/NotFound"},"default":{"$ref":"#/components/responses/Problem"}}}},"/auth/device":{"post":{"tags":["Account"],"operationId":"startDeviceLogin","summary":"Start a device authorisation","description":"Unauthenticated. The CLI calls this, shows `user_code`, and polls `/auth/device/token` until the person approves it in the app.","requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"client_name":{"type":"string","maxLength":100}}}}}},"responses":{"201":{"description":"Flow started.","content":{"application/json":{"schema":{"type":"object","properties":{"device_code":{"type":"string"},"user_code":{"type":"string","example":"ABCD-EFGH"},"verification_uri":{"type":"string","format":"uri"},"verification_uri_complete":{"type":"string","format":"uri"},"expires_in":{"type":"integer","example":600},"interval":{"type":"integer","example":5}}}}}},"default":{"$ref":"#/components/responses/Problem"}}}},"/auth/device/token":{"post":{"tags":["Account"],"operationId":"claimDeviceLogin","summary":"Poll a device authorisation","description":"Unauthenticated. Answers 202 while the request is pending and 200 with the API key once it is approved. The key is handed over exactly once.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["device_code"],"properties":{"device_code":{"type":"string"}}}}}},"responses":{"200":{"description":"Approved.","content":{"application/json":{"schema":{"type":"object","properties":{"api_key":{"type":"string","example":"ff_live_3f9c..."},"workspace":{"type":"object","properties":{"id":{"type":"string"},"slug":{"type":"string"},"name":{"type":"string"},"region":{"$ref":"#/components/schemas/Region"}}},"organization":{"type":"object","properties":{"id":{"type":"string"},"slug":{"type":"string"},"name":{"type":"string"}}}}}}}},"202":{"description":"Still waiting for approval.","content":{"application/json":{"schema":{"type":"object","properties":{"status":{"type":"string","enum":["pending"]},"interval":{"type":"integer"}}}}}},"default":{"$ref":"#/components/responses/Problem"}}}},"/account":{"get":{"tags":["Account"],"operationId":"getAccount","summary":"Get workspace and plan","responses":{"200":{"description":"Account.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Account"}}}},"default":{"$ref":"#/components/responses/Problem"}}}},"/usage":{"get":{"tags":["Account"],"operationId":"getUsage","summary":"Get usage for the current period","parameters":[{"name":"period","in":"query","description":"`current`, or `YYYY-MM` for the billing period that started in that month","schema":{"type":"string","default":"current"}}],"responses":{"200":{"description":"Usage.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Usage"}}}},"default":{"$ref":"#/components/responses/Problem"}}}},"/workspaces/{id}":{"delete":{"tags":["Account"],"operationId":"deleteWorkspace","summary":"Delete a workspace","description":"Deletes a workspace of the key's organisation, for example a per-branch preview workspace your\nCI created. The workspace disappears from the app and the API at once and its API keys are\nrevoked: the calling key stops working immediately when it deleted its own workspace, other\nkeys within a minute. Templates, renders, stored outputs and files are removed for good\nafter 30 days; there is no undo through the API. The slug can be used for a new workspace\nright away. The last workspace of an organisation is refused with 409 `last_workspace`.\nNeeds `workspace:delete`, which no key has by default.\n","parameters":[{"name":"id","in":"path","required":true,"description":"The workspace id (`workspace.id` of `GET /account`).","schema":{"type":"string","format":"uuid"}}],"responses":{"204":{"description":"Deleted."},"404":{"$ref":"#/components/responses/NotFound"},"409":{"description":"`last_workspace`: the organisation has no other workspace. Delete the organisation in the app instead.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}},"default":{"$ref":"#/components/responses/Problem"}}}},"/workspaces/{id}/storage":{"parameters":[{"name":"id","in":"path","required":true,"description":"The workspace id.","schema":{"type":"string","format":"uuid"}}],"get":{"tags":["Account"],"operationId":"getStorageConnection","summary":"Read the storage connection","description":"The bucket this workspace's outputs are copied to (bring your own storage, Pro plan and above),\nwith its deliveries of the last 24 hours. The secret is never returned, only the last four\ncharacters of the access key id. Owners and admins of the organisation, signed in to the app:\nno API key can manage a connection, and every storage route answers 403 to one.\n","responses":{"200":{"description":"The connection.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/StorageConnectionState"}}}},"404":{"$ref":"#/components/responses/NotFound"},"default":{"$ref":"#/components/responses/Problem"}}},"put":{"tags":["Account"],"operationId":"putStorageConnection","summary":"Connect a bucket","description":"Creates or replaces the workspace's connection. Formfeed writes the test object\n`<prefix>.formfeed/connection-test.txt` first, with the credentials in the request, and stores\nnothing unless that works: a wrong key or a missing bucket answers 422 `storage_test_failed`\nwith the provider's error. Formfeed only ever writes (`PutObject`); it never reads, lists or\ndeletes in the bucket. Leave out the credentials to keep the stored ones while the endpoint\nstays the same. From then on every output of the workspace (renders, batch items and zips,\nPDF tools, office renders) is copied to the bucket in the background; Formfeed keeps its own\ncopy for the workspace retention. Owners and admins in the app only.\n","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/StorageConnectionPut"}}}},"responses":{"200":{"description":"Replaced.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/StorageConnection"}}}},"201":{"description":"Connected.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/StorageConnection"}}}},"403":{"description":"An API key or a role other than owner and admin; `forbidden` with `feature: byo_storage` below the Pro plan.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}},"422":{"description":"`storage_test_failed`: the test object could not be written; `error` carries the provider's code.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}},"default":{"$ref":"#/components/responses/Problem"}}},"delete":{"tags":["Account"],"operationId":"deleteStorageConnection","summary":"Disconnect the bucket","description":"Removes the connection and its credentials. Deliveries still waiting end; objects already in the bucket stay there.","responses":{"204":{"description":"Disconnected."},"404":{"$ref":"#/components/responses/NotFound"},"default":{"$ref":"#/components/responses/Problem"}}}},"/workspaces/{id}/storage/test":{"post":{"tags":["Account"],"operationId":"testStorageConnection","summary":"Test the storage connection again","description":"Writes the test object with the stored credentials. A connection paused after five permanent\nfailures in a row resumes once this passes.\n","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"The test passed.","content":{"application/json":{"schema":{"type":"object","properties":{"ok":{"type":"boolean","example":true},"key":{"type":"string","example":"formfeed/.formfeed/connection-test.txt"},"connection":{"$ref":"#/components/schemas/StorageConnection"}}}}}},"409":{"description":"`storage_not_configured`: the workspace has no connection.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}},"422":{"description":"`storage_test_failed`, with the provider's `error` and the `connection`.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}},"default":{"$ref":"#/components/responses/Problem"}}}},"/workspaces/{id}/storage/redeliver":{"post":{"tags":["Account"],"operationId":"redeliverStorage","summary":"Deliver failed copies again","description":"Queues every failed delivery again whose output Formfeed still keeps, for one render, one\nbatch, a time range, or (with an empty body) all of them, to the connection's current bucket\nand key. Nothing is rendered again. At most 10 000 per call; `truncated` says whether more are\nwaiting. A paused connection answers 409 `conflict`: test it again first.\n","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"properties":{"render_id":{"type":"string","example":"rnd_7da09ab6cd9946b798c187c2a9350852"},"job_id":{"type":"string","example":"job_5f0c3b0a9d2e4c1b8a7f6e5d4c3b2a19"},"since":{"type":"string","format":"date-time"},"until":{"type":"string","format":"date-time"}}}}}},"responses":{"202":{"description":"Queued.","content":{"application/json":{"schema":{"type":"object","properties":{"requeued":{"type":"integer","example":42},"truncated":{"type":"boolean"}}}}}},"409":{"description":"`storage_not_configured`, or `conflict` while the connection is paused.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}},"default":{"$ref":"#/components/responses/Problem"}}}},"/pdf/merge":{"post":{"tags":["PDF tools"],"operationId":"mergePdf","summary":"Merge PDFs","description":"Joins the PDF outputs of earlier renders, in the order given, into a new PDF. The result is a\nrender of its own (it appears in the render log and `GET /renders/{id}`) and costs 0.5 units on\nlive keys. Sources are render ids of the same workspace whose output still exists; uploaded\nfiles come with the file library. Part of the Starter plan and above.\n","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["sources"],"properties":{"sources":{"type":"array","minItems":2,"maxItems":50,"items":{"type":"string","description":"Render id (`rnd_…`) of a succeeded PDF render, or a PDF of the workspace library by id (`fil_…`) or name."},"example":["rnd_7da09ab6cd9946b798c187c2a9350852","terms.pdf"]},"filename":{"type":"string","example":"bundle.pdf"},"expires_in":{"type":"integer","nullable":true},"access":{"type":"string","enum":["public","signed"]},"meta":{"type":"object","additionalProperties":true},"storage":{"allOf":[{"$ref":"#/components/schemas/StorageOption"}],"nullable":true}}}}}},"responses":{"200":{"description":"Merged render.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Render"}}}},"default":{"$ref":"#/components/responses/Problem"}}}},"/pdf/protect":{"post":{"tags":["PDF tools"],"operationId":"protectPdf","summary":"Password-protect a PDF","description":"Encrypts the PDF output of an earlier render with AES-256 into a new render (0.5 units on live\nkeys). `user_password` is needed to open the document; without it anyone can open it, but the\npermissions still apply. `permissions` lists what readers may do; everything not listed is\nforbidden. Protect last: an encrypted PDF cannot be merged or watermarked afterwards.\n","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["source"],"properties":{"source":{"type":"string","description":"Render id (`rnd_…`) of a succeeded PDF render."},"user_password":{"type":"string","maxLength":127,"description":"Needed to open the document."},"owner_password":{"type":"string","maxLength":127,"description":"Lifts the restrictions. A random one is used when omitted."},"permissions":{"type":"array","items":{"type":"string","enum":["print","copy","modify","annotate"]},"default":[]},"filename":{"type":"string"},"expires_in":{"type":"integer","nullable":true},"access":{"type":"string","enum":["public","signed"]},"meta":{"type":"object","additionalProperties":true},"storage":{"allOf":[{"$ref":"#/components/schemas/StorageOption"}],"nullable":true}}}}}},"responses":{"200":{"description":"Protected render.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Render"}}}},"default":{"$ref":"#/components/responses/Problem"}}}},"/pdf/convert":{"post":{"tags":["PDF tools"],"operationId":"convertOfficeToPdf","summary":"Convert an office document to PDF","description":"Converts a Word, Excel, PowerPoint, OpenDocument or RTF file into a PDF render (Starter plan and\nabove). Upload the file as `multipart/form-data`, or name the render of a Word or PowerPoint\ntemplate (output `docx` or `pptx`) as `source` in a JSON body. Accepted are DOCX, XLSX, PPTX, ODT, ODS, ODP, DOC, XLS, PPT, RTF and HTML, up to 20 MB;\nthe type is read from the file's content, not its name, so a \"save as web page\" export that\ncarries a `.doc` name converts as the HTML it is. Macro-enabled and password-protected\ndocuments are refused. The file is converted and not kept; the PDF is stored like any render.\n\nHTML is converted by LibreOffice, not by the render engine, and the converter loads nothing\nfrom the web: images and stylesheets the document links to stay empty. For HTML you control, a\nrender with an `html` source gives a better result.\n\nCosts follow the PDF rule: one unit per started five pages on live keys. Chain `/pdf/protect`,\n`/pdf/watermark` or `/pdf/merge` on the returned render id.\n\nFonts the document uses but neither embeds nor finds among the converter's fonts are replaced\nby metric-compatible ones (Carlito for Calibri, Caladea for Cambria, Liberation for Arial and\nTimes New Roman). Embed fonts in Word for an exact result.\n","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["source"],"properties":{"source":{"type":"string","description":"Render id (`rnd_…`) of a succeeded render whose output is `docx` or `pptx`."},"page_ranges":{"type":"string","maxLength":100,"pattern":"^\\d+(-\\d+)?(,\\d+(-\\d+)?)*$","example":"1-3,5"},"landscape":{"type":"boolean","default":false},"single_page_sheets":{"type":"boolean","default":false},"filename":{"type":"string"},"expires_in":{"type":"integer"},"access":{"type":"string","enum":["public","signed"]},"meta":{"type":"object","additionalProperties":true},"storage":{"allOf":[{"$ref":"#/components/schemas/StorageOption"}],"nullable":true}}}},"multipart/form-data":{"schema":{"type":"object","required":["file"],"properties":{"file":{"type":"string","format":"binary","description":"The document, up to 20 MB."},"page_ranges":{"type":"string","maxLength":100,"pattern":"^\\d+(-\\d+)?(,\\d+(-\\d+)?)*$","example":"1-3,5","description":"Pages to convert; all when omitted."},"landscape":{"type":"boolean","default":false,"description":"Landscape for spreadsheets and documents without their own page setup."},"single_page_sheets":{"type":"boolean","default":false,"description":"Each spreadsheet sheet on one page."},"filename":{"type":"string","description":"Name of the PDF; the uploaded name with `.pdf` when omitted."},"expires_in":{"type":"integer"},"access":{"type":"string","enum":["public","signed"]},"meta":{"type":"string","description":"A JSON object as text; returned with the render."},"storage":{"type":"string","description":"The `storage` option as JSON text: `false`, or `{\"key\": \"…\"}`."}}}}}},"responses":{"200":{"description":"Converted render.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Render"}}}},"413":{"description":"File too large.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}},"415":{"description":"Not an accepted office document.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}},"503":{"description":"The converter is busy; retry after `Retry-After` seconds.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}},"default":{"$ref":"#/components/responses/Problem"}}}},"/pdf/watermark":{"post":{"tags":["PDF tools"],"operationId":"watermarkPdf","summary":"Watermark a PDF","description":"Draws a text or an image diagonally across every page of the PDF output of an earlier render,\ninto a new render (0.5 units on live keys). The text is set in Noto Sans Bold, embedded in the\nfile, which covers Latin, Greek and Cyrillic letters; an image is a PNG or JPEG of the workspace\nfile library, scaled to 60 % of the page width. Pass `text` or `image`, not both.\n","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["source"],"properties":{"source":{"type":"string","description":"Render id (`rnd_…`) of a succeeded PDF render."},"text":{"type":"string","maxLength":200,"example":"COPY"},"image":{"type":"string","maxLength":200,"description":"Instead of `text`: a PNG or JPEG of the workspace library, by id (`fil_…`) or name."},"opacity":{"type":"number","minimum":0,"maximum":1,"default":0.2},"rotation":{"type":"number","default":-45,"description":"Degrees clockwise as in CSS; the default runs from bottom left to top right."},"color":{"type":"string","pattern":"^#?[0-9a-fA-F]{6}$","example":"#cc0000","description":"Hex colour; grey by default."},"filename":{"type":"string"},"expires_in":{"type":"integer","nullable":true},"access":{"type":"string","enum":["public","signed"]},"meta":{"type":"object","additionalProperties":true},"storage":{"allOf":[{"$ref":"#/components/schemas/StorageOption"}],"nullable":true}}}}}},"responses":{"200":{"description":"Watermarked render.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Render"}}}},"default":{"$ref":"#/components/responses/Problem"}}}},"/pdf/info":{"post":{"tags":["PDF tools"],"operationId":"pdfInfo","summary":"Inspect a PDF","description":"Page count, page sizes, encryption and metadata of the PDF output of an earlier render. Free on every plan; creates no render.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["source"],"properties":{"source":{"type":"string","description":"Render id (`rnd_…`)."}}}}}},"responses":{"200":{"description":"PDF info.","content":{"application/json":{"schema":{"type":"object","properties":{"source":{"type":"string"},"page_count":{"type":"integer"},"pages":{"type":"array","items":{"type":"object","properties":{"width_pt":{"type":"number"},"height_pt":{"type":"number"},"width_mm":{"type":"number"},"height_mm":{"type":"number"}}}},"encrypted":{"type":"boolean"},"metadata":{"type":"object","additionalProperties":true}}}}}},"default":{"$ref":"#/components/responses/Problem"}}}},"/webhooks":{"get":{"tags":["Webhooks"],"operationId":"listWebhooks","summary":"List webhook endpoints","responses":{"200":{"description":"Endpoints.","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/WebhookEndpoint"}}}}}}},"default":{"$ref":"#/components/responses/Problem"}}},"post":{"tags":["Webhooks"],"operationId":"createWebhook","summary":"Create a webhook endpoint","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/WebhookEndpointCreate"}}}},"responses":{"201":{"description":"Created. The `secret` is returned once.","headers":{"Location":{"description":"Absolute URL of the new endpoint, for `DELETE /webhooks/{id}`.","schema":{"type":"string","format":"uri"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/WebhookEndpoint"}}}},"default":{"$ref":"#/components/responses/Problem"}}}},"/webhooks/{id}":{"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","example":"whk_01J8ZK4M3Q"}}],"put":{"tags":["Webhooks"],"operationId":"updateWebhook","summary":"Update a webhook endpoint","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/WebhookEndpointCreate"}}}},"responses":{"200":{"description":"Updated.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WebhookEndpoint"}}}},"default":{"$ref":"#/components/responses/Problem"}}},"delete":{"tags":["Webhooks"],"operationId":"deleteWebhook","summary":"Delete a webhook endpoint","responses":{"204":{"description":"Deleted."},"default":{"$ref":"#/components/responses/Problem"}}}},"/webhooks/{id}/test":{"post":{"tags":["Webhooks"],"operationId":"testWebhook","summary":"Send a test event","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"202":{"description":"The test event is queued; the delivery log shows its outcome.","content":{"application/json":{"schema":{"type":"object","properties":{"queued":{"type":"boolean"}}}}}},"default":{"$ref":"#/components/responses/Problem"}}}},"/webhooks/listen":{"post":{"tags":["Webhooks"],"operationId":"startListenSession","summary":"Start a listen session","description":"What `formfeed listen` calls: a session that receives the workspace's webhook events like a registered endpoint and relays them over a WebSocket to the CLI, which forwards them to a local server. Deliveries are signed with the session's `secret`. Test-environment events only, unless `live` is set, which needs `webhook:manage`. The `websocket_url` is valid for 60 seconds; the session lives while a CLI is connected. At most three sessions per workspace; a new session of the same key or member ends its previous one. Needs `webhook:listen`.","requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"events":{"type":"array","items":{"type":"string","enum":["render.completed","render.failed","job.completed","job.failed","quota.warning","quota.exceeded","storage.delivered","storage.failed"]}},"live":{"type":"boolean","default":false}}}}}},"responses":{"201":{"description":"The session.","content":{"application/json":{"schema":{"type":"object","properties":{"id":{"type":"string","format":"uuid"},"secret":{"type":"string","example":"whsec_3f9c0b"},"events":{"type":"array","items":{"type":"string"}},"environments":{"type":"array","items":{"type":"string","enum":["live","test"]}},"expires_at":{"type":"string","format":"date-time"},"websocket_url":{"type":"string","format":"uri"}}}}}},"409":{"$ref":"#/components/responses/Problem"},"default":{"$ref":"#/components/responses/Problem"}}}},"/webhooks/listen/{id}":{"delete":{"tags":["Webhooks"],"operationId":"endListenSession","summary":"End a listen session","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"204":{"description":"Ended."},"404":{"$ref":"#/components/responses/NotFound"},"default":{"$ref":"#/components/responses/Problem"}}}},"/webhooks/events/{id}/resend":{"post":{"tags":["Webhooks"],"operationId":"resendWebhookEvent","summary":"Send an event again","description":"Sends a stored event (`evt_…`, delivered or not) again as a new delivery to a registered endpoint (`webhook:manage`) or a running listen session (`webhook:listen`).","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","example":"evt_4f0c2b"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["endpoint_id"],"properties":{"endpoint_id":{"type":"string","format":"uuid","description":"A registered endpoint or a listen session."}}}}}},"responses":{"202":{"description":"The delivery is queued.","content":{"application/json":{"schema":{"type":"object","properties":{"delivery_id":{"type":"string"},"event_id":{"type":"string"},"event":{"type":"string"},"endpoint_id":{"type":"string"}}}}}},"404":{"$ref":"#/components/responses/NotFound"},"410":{"$ref":"#/components/responses/Problem"},"default":{"$ref":"#/components/responses/Problem"}}}},"/compat/apitemplate/create-pdf":{"post":{"tags":["Compat"],"operationId":"compatApitemplateCreatePdf","summary":"apitemplate.io compatible create-pdf","description":"Accepts apitemplate.io's request and returns its response shape. Migration only; no new features.","parameters":[{"name":"template_id","in":"query","required":true,"schema":{"type":"string"}},{"name":"export_type","in":"query","schema":{"type":"string","enum":["file","json"],"default":"json"}}],"requestBody":{"content":{"application/json":{"schema":{"type":"object","additionalProperties":true}}}},"responses":{"200":{"$ref":"#/components/responses/CompatResponse"},"default":{"$ref":"#/components/responses/Problem"}}}},"/compat/apitemplate/create-image":{"post":{"tags":["Compat"],"operationId":"compatApitemplateCreateImage","summary":"apitemplate.io compatible create-image","description":"Accepts apitemplate.io's request and returns its response shape. Migration only.","parameters":[{"name":"template_id","in":"query","required":true,"schema":{"type":"string"}},{"name":"output_image_type","in":"query","schema":{"type":"string","enum":[1,2,"all"],"default":1},"description":"apitemplate.io image type flag (1 = jpeg, 2 = png, all = both)."}],"requestBody":{"content":{"application/json":{"schema":{"type":"object","additionalProperties":true}}}},"responses":{"200":{"$ref":"#/components/responses/CompatResponse"},"default":{"$ref":"#/components/responses/Problem"}}}},"/compat/apitemplate/create-pdf-from-html":{"post":{"tags":["Compat"],"operationId":"compatApitemplateCreatePdfFromHtml","summary":"apitemplate.io compatible create-pdf-from-html","description":"Accepts apitemplate.io's `body` (HTML), `css`, `data` and `settings` fields. Migration only.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"body":{"type":"string"},"css":{"type":"string"},"data":{"type":"object","additionalProperties":true},"settings":{"type":"object","additionalProperties":true}}}}}},"responses":{"200":{"$ref":"#/components/responses/CompatResponse"},"default":{"$ref":"#/components/responses/Problem"}}}},"/compat/apitemplate/create-pdf-from-url":{"post":{"tags":["Compat"],"operationId":"compatApitemplateCreatePdfFromUrl","summary":"apitemplate.io compatible create-pdf-from-url","description":"Accepts apitemplate.io's `url` and `settings` fields. Migration only.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["url"],"properties":{"url":{"type":"string","format":"uri"},"settings":{"type":"object","additionalProperties":true}}}}}},"responses":{"200":{"$ref":"#/components/responses/CompatResponse"},"default":{"$ref":"#/components/responses/Problem"}}}}},"components":{"securitySchemes":{"bearerAuth":{"type":"http","scheme":"bearer","bearerFormat":"API key","description":"API key from the workspace: `ff_live_…` or `ff_test_…`. Also accepted in the `X-API-Key` header."}},"parameters":{"IdempotencyKey":{"name":"Idempotency-Key","in":"header","required":false,"description":"Unique key per logical request; replays within 24 h return the original response.","schema":{"type":"string","maxLength":128}},"Limit":{"name":"limit","in":"query","schema":{"type":"integer","minimum":1,"maximum":100,"default":50}},"Cursor":{"name":"cursor","in":"query","schema":{"type":"string"}},"RenderId":{"name":"id","in":"path","required":true,"schema":{"type":"string","example":"rnd_01J8ZK4M3Q7X"}},"TemplateId":{"name":"id","in":"path","required":true,"description":"Template id (`tpl_…`) or slug.","schema":{"type":"string","example":"invoice-de"}}},"responses":{"Problem":{"description":"Error (RFC 9457 problem details).","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}},"NotFound":{"description":"Not found.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}},"Unprocessable":{"description":"Validation, template or data error. Template errors include `location`.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}},"QuotaExceeded":{"description":"Monthly units exhausted and no overage available.","content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}},"CompatResponse":{"description":"apitemplate.io shaped response.","content":{"application/json":{"schema":{"type":"object","properties":{"status":{"type":"string","example":"success"},"download_url":{"type":"string","format":"uri"},"download_url_png":{"type":"string","format":"uri","description":"create-image only."},"transaction_ref":{"type":"string"}}}}}},"RateLimited":{"description":"Rate limit exceeded.","headers":{"Retry-After":{"schema":{"type":"integer"}},"RateLimit-Limit":{"schema":{"type":"integer"}},"RateLimit-Remaining":{"schema":{"type":"integer"}},"RateLimit-Reset":{"schema":{"type":"integer"}}},"content":{"application/problem+json":{"schema":{"$ref":"#/components/schemas/Problem"}}}}},"schemas":{"Engine":{"type":"string","enum":["jinja2","liquid","handlebars"]},"TemplateKind":{"type":"string","enum":["pdf","image","docx","pptx"],"description":"`docx` and `pptx` templates are Word and PowerPoint files with tags in their text (Starter plan and above)."},"Region":{"type":"string","enum":["eu","us","apac"]},"RenderStatus":{"type":"string","enum":["queued","rendering","succeeded","failed"]},"OutputFormat":{"type":"string","enum":["pdf","png","jpg","webp","docx","pptx"],"description":"PDF and image templates, ad-hoc HTML and URLs produce `pdf`, `png`, `jpg` or `webp`; a `docx` template produces `docx` or `pdf`, a `pptx` template `pptx` or `pdf`."},"Problem":{"type":"object","required":["type","title","status"],"properties":{"type":{"type":"string","format":"uri","example":"https://docs.formfeed.dev/errors/template-syntax"},"title":{"type":"string","example":"Template syntax error"},"status":{"type":"integer","example":422},"detail":{"type":"string"},"code":{"type":"string","enum":["template_not_found","template_syntax_error","template_runtime_error","data_validation_error","navigation_failed","render_timeout","page_limit_exceeded","output_too_large","file_too_large","source_not_found","source_invalid","source_encrypted","tool_failed","file_type_unsupported","office_document_invalid","office_document_too_large","office_conversion_failed","office_unavailable","unsupported_in_office","test_output_unavailable","einvoice_data_invalid","einvoice_profile_unsupported","einvoice_display_mismatch","pdfa_conversion_failed","conformance_unavailable","pdfua_validation_failed","quota_exceeded","rate_limited","region_unavailable","worker_exhausted","invalid_request","unauthorized","forbidden","not_found","conflict","not_implemented","schema_breaking_change","channel_not_found","channel_name_invalid","channel_in_use","render_input_expired","listen_session_limit","listen_session_ended","last_workspace","storage_not_configured","storage_test_failed"]},"location":{"type":"object","nullable":true,"properties":{"line":{"type":"integer"},"column":{"type":"integer"},"file":{"type":"string","enum":["template","css","head","header","footer"]},"part":{"type":"string","example":"word/document.xml","description":"Office templates: the part of the file (document, header, footer, slide)."},"paragraph":{"type":"integer","description":"Office templates: the paragraph within the part, from 1."}}},"request_id":{"type":"string"},"errors":{"type":"array","description":"`data_validation_error`: every place where the data does not match the schema. `einvoice_data_invalid`, when the `_invoice` block itself is refused: every field that is missing or breaks a rule.","items":{"type":"object","properties":{"path":{"type":"string","nullable":true,"example":"data.invoice.number"},"message":{"type":"string","example":"data.invoice.number: must be string"},"rule":{"type":"string","description":"`einvoice_data_invalid` only: the rule of EN 16931 or of the French specifications the field breaks.","example":"BR-CO-15"}}}},"einvoice":{"description":"The report of a render whose e-invoice failed validation or the display check (`einvoice_data_invalid`, `pdfa_conversion_failed`, `einvoice_display_mismatch`); the same object the render carries as `einvoice`. Also on `pdfua_validation_failed` where the render made an e-invoice: the invoice was valid and its file failed PDF/UA-1.","allOf":[{"$ref":"#/components/schemas/Einvoice"}]},"accessibility":{"description":"The rules of PDF/UA-1 the file failed, each with the elements of the template it is about; the same object the render carries as `accessibility`. On `pdfua_validation_failed`, and on `einvoice_display_mismatch` where the render also set `settings.pdf.ua`.","allOf":[{"$ref":"#/components/schemas/Accessibility"}]},"index":{"type":"integer","description":"Batch requests only: the first item that failed."}}},"Diagnostic":{"type":"object","properties":{"severity":{"type":"string","enum":["error","warning","info"]},"message":{"type":"string"},"code":{"type":"string"},"location":{"type":"object","properties":{"line":{"type":"integer"},"column":{"type":"integer"}}},"path":{"type":"string","description":"Data errors only: where in the data, e.g. `data.invoice.lines[0].qty`."},"part":{"type":"string","description":"Word and PowerPoint templates only: the file part the tag is in, e.g. `word/document.xml` or `ppt/slides/slide2.xml`."},"paragraph":{"type":"integer","description":"Word and PowerPoint templates only: the 1-based paragraph in `part`, as the template page lists it."}}},"Settings":{"type":"object","description":"Rendering settings. Deep-merged over the template's settings. See the settings reference.","additionalProperties":true,"properties":{"paper":{"type":"object","properties":{"format":{"type":"string","example":"A4"},"width":{"type":"string","nullable":true},"height":{"type":"string","nullable":true},"landscape":{"type":"boolean","default":false}}},"margin":{"type":"object","properties":{"top":{"type":"string","example":"20mm"},"right":{"type":"string","example":"15mm"},"bottom":{"type":"string","example":"20mm"},"left":{"type":"string","example":"15mm"}}},"header":{"type":"object","description":"Printed across the whole page width inside the top margin.","properties":{"html":{"type":"string"},"height":{"type":"string"},"padding":{"type":"string","description":"CSS padding inside the header box; `0` for designs that run edge to edge.","default":"0 10mm"}}},"footer":{"type":"object","description":"Printed across the whole page width inside the bottom margin.","properties":{"html":{"type":"string"},"height":{"type":"string"},"padding":{"type":"string","description":"CSS padding inside the footer box; `0` for designs that run edge to edge.","default":"0 10mm"}}},"printBackground":{"type":"boolean","default":true},"scale":{"type":"number","default":1},"pdf":{"type":"object","description":"PDF output only: what the file says about itself, and its structure for assistive technology.","properties":{"metadata":{"type":"object","description":"The document properties. The title is what a PDF reader shows in its title bar and a screen reader announces first; PDF/UA-1 requires one.","properties":{"title":{"type":"string","example":"Rechnung RE-2026-0042"},"author":{"type":"string"},"subject":{"type":"string"},"keywords":{"type":"string"}}},"tagged":{"type":"boolean","default":false,"description":"Writes the structure tree (headings, lists, tables, links) a screen reader reads the document by."},"outline":{"type":"boolean","default":false,"description":"Writes bookmarks from the headings."},"ua":{"description":"Makes the file a PDF/UA-1 document (ISO 14289-1): tagged, repaired where the browser's output breaks the standard, and held against veraPDF's machine-checkable rules of PDF/UA-1. `true` is `{ \"check\": \"strict\" }`. The render carries the verdict as `accessibility`, and the file names itself PDF/UA-1 only when it passed. A passed check does not make a document accessible: alternative texts, reading order and contrast are in the template. Cannot be combined with `post.merge_after`, and is not available for Word and PowerPoint templates; each answers 400 `invalid_request`. With an e-invoice the file is a PDF/A-3b and a PDF/UA-1 document at once: both are checked in the file that is delivered, and the render carries both reports. `false` in a request switches off what the template declares.","nullable":true,"oneOf":[{"type":"boolean"},{"$ref":"#/components/schemas/PdfUaOptions"}]}}},"image":{"type":"object","properties":{"width":{"type":"integer","example":1200},"height":{"type":"integer","example":630},"deviceScaleFactor":{"type":"number","default":2},"format":{"type":"string","enum":["png","jpeg","webp"],"description":"Output of an image template when the request names no `output`. `jpg` is accepted as well."},"quality":{"type":"integer","minimum":1,"maximum":100},"fullPage":{"type":"boolean","default":false},"transparent":{"type":"boolean","default":false}}},"office":{"type":"object","description":"Word and PowerPoint templates. Page setup, margins, headers and footers come from the document; the Chromium settings above do not apply.","properties":{"output":{"type":"string","enum":["docx","pptx","pdf"],"description":"Output when the request names none; the template's own format without it."}}},"locale":{"type":"string","example":"de-DE"},"timezone":{"type":"string","example":"Europe/Berlin"},"currency":{"type":"string","example":"EUR"},"einvoice":{"description":"Makes the template an invoice template: every PDF rendered from it is a ZUGFeRD / Factur-X e-invoice built from the `_invoice` block of the data, as if the request said `post.einvoice`. A request's `settings.einvoice` and `post.einvoice` merge over it field by field; `post.einvoice: false` switches it off for one request. Image output of the same template is not affected.","nullable":true,"allOf":[{"$ref":"#/components/schemas/EinvoiceOptions"}]},"design":{"type":"object","additionalProperties":true,"description":"The visual editor's layers of an image template, stored with a version. Authoring data only: renders use the version's HTML and CSS, which the editor writes from it, and a render request's `design` is ignored. Kept as it is when you copy a version; at most 256 kB. See the visual editor guide."}}},"RenderRequest":{"type":"object","properties":{"template":{"type":"string","description":"Template id or slug. Omit when using `html` or `url`.","example":"invoice-de"},"version":{"type":"string","description":"`published` (default), the name of a release channel such as `staging`, `latest` (the draft the editor works on, test keys only) or a version number. Channels, `published` included, are cached for up to a minute; a channel with a canary sends its share of renders to the canary version, chosen by the Idempotency-Key so a retry lands on the same version. A draft renders as it is at that moment.","default":"published"},"html":{"type":"string","nullable":true,"description":"Ad-hoc HTML, max 5 MB."},"url":{"type":"string","format":"uri","nullable":true,"description":"Public URL to render."},"engine":{"allOf":[{"$ref":"#/components/schemas/Engine"}],"nullable":true,"description":"Engine for `html` sources; `null` disables templating."},"data":{"type":"object","additionalProperties":true,"description":"Data bound to the template."},"output":{"allOf":[{"$ref":"#/components/schemas/OutputFormat"}],"description":"Left out, the template decides: `pdf` for a template of kind `pdf`, `settings.image.format` (the request's, then the template's; `png` without one) for kind `image`, `settings.office.output` (else the template's own format) for kinds `docx` and `pptx`. Ad-hoc `html` and `url` render `pdf`. On the Free plan, test renders of `docx` and `pptx` templates may only request `pdf` (403 `test_output_unavailable`)."},"settings":{"$ref":"#/components/schemas/Settings"},"filename":{"type":"string","description":"May contain template expressions.","example":"invoice-{{ invoice.number }}.pdf"},"expires_in":{"type":"integer","nullable":true,"description":"Seconds until the output expires. `null` uses the workspace retention."},"access":{"type":"string","enum":["public","signed"],"default":"signed"},"mode":{"type":"string","enum":["sync","async"],"default":"sync"},"locale":{"type":"string","nullable":true,"description":"Overrides the template locale and selects the i18n dictionary."},"webhook_url":{"type":"string","format":"uri","nullable":true},"webhook_secret":{"type":"string","minLength":16,"maxLength":200,"nullable":true,"description":"Signs the deliveries to `webhook_url` (same scheme as an endpoint secret). Write-only, never returned; without it those deliveries stay unsigned."},"meta":{"type":"object","additionalProperties":true,"description":"Echoed in the response and webhooks."},"region":{"allOf":[{"$ref":"#/components/schemas/Region"}],"nullable":true},"dedupe":{"type":"boolean","default":true,"description":"Serve identical requests from the dedup cache at zero units."},"canary_key":{"type":"string","minLength":1,"maxLength":200,"nullable":true,"example":"customer-4711","description":"Decides the canary split of a channel: renders with the same value land on the same version, so one customer's documents look alike. Use an opaque id; it is not stored. Without it the Idempotency-Key decides, which keeps a retry on its version but splits separate renders independently."},"validate_data":{"type":"boolean","default":false,"description":"Checks `data` against the template's stored data schema before anything is rendered or counted; a mismatch answers 422 `data_validation_error` listing every error. Needs a template with a stored schema (400 otherwise). In a batch, nothing is queued unless every item that asks for it fits."},"post":{"type":"object","nullable":true,"description":"Post-processing of a PDF render, applied in the order merge, watermark, password (0.5 units\nper step on live keys; Starter plan and above), and the e-invoice, which is a step of its\nown (one unit; Starter plan and above; on the Free plan test renders make up to 20 a\nday with the test mark). An unknown step is refused, never skipped.\n","additionalProperties":false,"properties":{"einvoice":{"description":"Makes the PDF a ZUGFeRD / Factur-X e-invoice: a PDF/A-3b that carries the invoice as\nXML, built from the `_invoice` block of `data` and validated before the file is\ndelivered. A block that is missing or breaks a rule of EN 16931 answers 422\n`einvoice_data_invalid` before anything is rendered; a file that fails validation is\nnever delivered, and never replaced by a plain PDF. Not together with `password` (PDF/A\nforbids encryption), and never served from the dedup cache. With `settings.pdf.ua` the\nsame file is held to PDF/UA-1 as well, and the render carries `accessibility` beside\n`einvoice`. `false` switches off what the template's `settings.einvoice` declares, for\nthis request.\n","oneOf":[{"$ref":"#/components/schemas/EinvoiceOptions"},{"type":"boolean","enum":[false]}]},"merge_after":{"type":"array","minItems":1,"maxItems":49,"items":{"type":"string"},"description":"PDFs appended after this document, in order: render ids (`rnd_…`) of earlier renders, file ids (`fil_…`) or names of PDFs in the workspace library."},"watermark":{"type":"object","additionalProperties":false,"description":"Either a text or an image from the workspace library, not both.","properties":{"text":{"type":"string","maxLength":200},"image":{"type":"string","maxLength":200,"description":"A library file: its id (`fil_…`) or its name. PNG or JPEG."},"opacity":{"type":"number","minimum":0,"maximum":1,"default":0.2},"rotation":{"type":"number","default":-45,"description":"Degrees clockwise as in CSS."},"color":{"type":"string","pattern":"^#?[0-9a-fA-F]{6}$","description":"Hex colour of the text; ignored for an image."}}},"password":{"type":"object","additionalProperties":false,"properties":{"user":{"type":"string","maxLength":127,"description":"Needed to open the document."},"owner":{"type":"string","maxLength":127,"description":"Lifts the restrictions; random when omitted."},"permissions":{"type":"array","items":{"type":"string","enum":["print","copy","modify","annotate"]},"default":[]}}}}},"storage":{"allOf":[{"$ref":"#/components/schemas/StorageOption"}],"nullable":true}}},"Render":{"type":"object","required":["id","status","output","region","created_at"],"properties":{"id":{"type":"string","example":"rnd_01J8ZK4M3Q7X"},"status":{"$ref":"#/components/schemas/RenderStatus"},"output":{"$ref":"#/components/schemas/OutputFormat"},"download_url":{"type":"string","format":"uri","nullable":true},"expires_at":{"type":"string","format":"date-time","nullable":true},"bytes":{"type":"integer","nullable":true},"page_count":{"type":"integer","nullable":true},"units":{"type":"number","example":1},"region":{"$ref":"#/components/schemas/Region"},"environment":{"type":"string","enum":["live","test"]},"template":{"type":"object","nullable":true,"properties":{"id":{"type":"string","example":"tpl_01J8ZK4M3Q","description":"The id of the template as `GET /templates` returns it. A render request takes it as `template`."},"slug":{"type":"string"},"version":{"type":"integer"},"channel":{"type":"string","nullable":true,"description":"The release channel the version came from (`published` by default); null when the request named a version number or `latest`."},"canary":{"type":"boolean","description":"True when the channel's canary share picked this version."}}},"engine_version":{"type":"string","description":"Chromium build and engine package version, for reproducibility.","example":"chromium-140.0.7339.16/engine-1.4.0"},"template_checksum":{"type":"string","nullable":true},"output_sha256":{"type":"string","nullable":true},"deduplicated":{"type":"boolean"},"storage":{"allOf":[{"$ref":"#/components/schemas/StorageDelivery"}],"nullable":true},"einvoice":{"description":"The e-invoice of this render: what was made, what the validator said and whether the PDF shows what the XML states. Null for a render that made none. A failed render keeps it too, which is where it says why.","nullable":true,"allOf":[{"$ref":"#/components/schemas/Einvoice"}]},"accessibility":{"description":"What the validator said about the file as PDF/UA-1. Null unless the render set `settings.pdf.ua`. A strict render that failed keeps it too, which is where it names the rules.","nullable":true,"allOf":[{"$ref":"#/components/schemas/Accessibility"}]},"timings":{"type":"object","properties":{"queue_ms":{"type":"integer"},"compile_ms":{"type":"integer"},"render_ms":{"type":"integer"},"upload_ms":{"type":"integer"},"total_ms":{"type":"integer"}}},"error":{"allOf":[{"$ref":"#/components/schemas/Problem"}],"nullable":true},"meta":{"type":"object","additionalProperties":true},"created_at":{"type":"string","format":"date-time"},"completed_at":{"type":"string","format":"date-time","nullable":true}}},"EinvoiceOptions":{"type":"object","additionalProperties":false,"description":"What kind of e-invoice a render makes. Every field has a default, so `{}` asks for a Factur-X invoice in the EN 16931 profile.","properties":{"profile":{"type":"string","enum":["basic","en16931"],"default":"en16931","description":"`en16931` carries every field of the European standard; `basic` is the smallest profile that is an invoice on its own. Any other profile answers 422 `einvoice_profile_unsupported`."},"flavour":{"type":"string","enum":["factur-x","zugferd"],"default":"factur-x","description":"ZUGFeRD and Factur-X are one specification under two names, and the file is the same. The choice decides the name and release the render reports (`Factur-X 1.09` or `ZUGFeRD 2.5`)."},"xml":{"type":"string","enum":["embedded","both"],"default":"embedded","description":"`both` stores the XML as a file of its own beside the PDF, kept and deleted with it; the render links it as `einvoice.xml_url`."},"display_check":{"type":"string","enum":["warn","strict"],"default":"warn","description":"What happens when the PDF does not show a value of the XML (the invoice number, the totals): `warn` reports it in `einvoice.display.missing`, `strict` fails the render with 422 `einvoice_display_mismatch`."}}},"Einvoice":{"type":"object","properties":{"profile":{"type":"string","enum":["basic","en16931"]},"flavour":{"type":"string","enum":["factur-x","zugferd"]},"spec_version":{"type":"string","example":"1.09","description":"The release of the specification the file was written and validated for, under the name of `flavour`: Factur-X `1.09` is ZUGFeRD `2.5`."},"xml_url":{"type":"string","format":"uri","nullable":true,"description":"A signed link to the XML, when the render asked for `xml: both` and the file is still stored. The XML is inside the PDF either way."},"validation":{"type":"object","nullable":true,"description":"What the validator said about the file. Null only when the render failed before it ran.","properties":{"valid":{"type":"boolean","description":"No finding of severity `error`. A render succeeds only with a valid file."},"schematron":{"type":"string","description":"The rule set the XML was held to, as it names itself, and the validator that ran it.","example":"Factur-X 1.09.2 (Mustang 2.26.0)"},"pdfa":{"type":"string","nullable":true,"example":"PDF/A-3b","description":"The PDF/A flavour the file was checked against; null when validation ended at the XML."},"messages":{"type":"array","description":"At most 50, errors first.","items":{"$ref":"#/components/schemas/EinvoiceMessage"}},"truncated":{"type":"boolean","description":"Present and true when there were more findings than `messages` holds."}}},"display":{"type":"object","nullable":true,"description":"The display check: the values of the XML that were looked for in the text of the PDF, by their business term in EN 16931.","properties":{"checked":{"type":"array","items":{"type":"string"},"example":["BT-1","BT-109","BT-110","BT-112"]},"missing":{"type":"array","items":{"type":"string"},"example":[],"description":"The terms the PDF does not show. Zero amounts are not looked for."}}}}},"EinvoiceMessage":{"type":"object","properties":{"part":{"type":"string","enum":["xml","pdf"],"description":"Whether the finding is about the invoice XML or about the PDF/A file."},"severity":{"type":"string","enum":["error","warning"]},"rule":{"type":"string","nullable":true,"example":"BR-CO-25","description":"The rule: of EN 16931 (`BR-…`), of the syntax binding (`CII-SR-…`), a code of the XML schema (`cvc-…`), or the clause of PDF/A (`6.2.11.4.1-1`). Null where the validator names none."},"message":{"type":"string"},"location":{"type":"string","nullable":true,"description":"Where: an XPath into the XML (a line item always carries its index), a line and column for a finding of the XML schema, or the object of the PDF."}}},"PdfUaOptions":{"type":"object","additionalProperties":false,"description":"How a render with `pdf.ua` treats a file that fails validation.","properties":{"check":{"type":"string","enum":["strict","report"],"default":"strict","description":"`strict` fails the render with 422 `pdfua_validation_failed` and delivers nothing. `report` delivers the file without the PDF/UA identifier and reports `accessibility.conformant: false`."}}},"Accessibility":{"type":"object","description":"The verdict of the validator on the machine-checkable rules of PDF/UA-1, and no more than that: whether an alternative text describes its image or the reading order makes sense is not something a validator decides.","properties":{"standard":{"type":"string","enum":["PDF/UA-1"]},"check":{"type":"string","enum":["strict","report"]},"conformant":{"type":"boolean","description":"The file passed every rule the validator checks. Only then does it carry the PDF/UA identifier."},"validator":{"type":"string","example":"veraPDF 1.30.2","description":"The validator and its version. Its rule set moves between releases."},"rules":{"type":"object","properties":{"passed":{"type":"integer","example":106},"failed":{"type":"integer","example":0}}},"failures":{"type":"array","description":"The rules the file failed, at most 20.","items":{"$ref":"#/components/schemas/AccessibilityFailure"}},"warnings":{"type":"array","description":"What a reader will stumble over although no rule fails for it.","items":{"$ref":"#/components/schemas/AccessibilityWarning"}},"truncated":{"type":"boolean","description":"Present and true when more rules failed than `failures` holds."}}},"AccessibilityFailure":{"type":"object","properties":{"rule":{"type":"string","example":"7.4.2-1","description":"Clause and test number of the rule in veraPDF's PDF/UA-1 profile."},"code":{"type":"string","enum":["document-title","image-alt","figure-name","heading-order","table-rows","table-cell-empty","masked-text"],"description":"What in the template the rule is about, where the template check found it. Absent for a rule it has no finding for."},"count":{"type":"integer","description":"How many checks of the rule failed."},"message":{"type":"string","example":"This h3 follows an h1, so a heading level is skipped. Make it an h2 and size it with CSS.","description":"What to change in the template, else the validator's own description of the rule."},"elements":{"type":"array","description":"The start tags of the elements concerned, at most five.","items":{"type":"string"},"example":["<h3>"]}}},"AccessibilityWarning":{"type":"object","properties":{"code":{"type":"string","enum":["filtered-text","document-language","table-headers","link-name","generated-text","fixed-text","running-text"]},"count":{"type":"integer"},"elements":{"type":"array","description":"Start tags, or the text itself for `running-text` and `generated-text`; at most five.","items":{"type":"string"}}}},"Job":{"type":"object","properties":{"id":{"type":"string","example":"job_01J8ZK4M3Q"},"status":{"type":"string","enum":["queued","processing","completed","partially_failed","failed"]},"total":{"type":"integer"},"succeeded":{"type":"integer"},"failed":{"type":"integer"},"zip_url":{"type":"string","format":"uri","nullable":true},"storage":{"allOf":[{"$ref":"#/components/schemas/StorageDelivery"}],"nullable":true,"description":"The zip's copy in the workspace's own bucket; each item carries its own."},"items":{"type":"array","items":{"$ref":"#/components/schemas/Render"}},"meta":{"type":"object","additionalProperties":true},"created_at":{"type":"string","format":"date-time"},"completed_at":{"type":"string","format":"date-time","nullable":true}}},"Template":{"type":"object","properties":{"id":{"type":"string","example":"tpl_01J8ZK4M3Q"},"slug":{"type":"string","example":"invoice-de"},"name":{"type":"string"},"description":{"type":"string","nullable":true},"kind":{"$ref":"#/components/schemas/TemplateKind"},"engine":{"$ref":"#/components/schemas/Engine"},"tags":{"type":"array","items":{"type":"string"}},"published_version":{"type":"integer","nullable":true},"latest_version":{"type":"integer"},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"}}},"TemplateCreate":{"type":"object","required":["name","slug","kind","engine"],"description":"`html` is required for `pdf` and `image` templates.","properties":{"name":{"type":"string"},"slug":{"type":"string","pattern":"^[a-z0-9](?:[a-z0-9-]{1,62}[a-z0-9])?$"},"description":{"type":"string"},"kind":{"$ref":"#/components/schemas/TemplateKind"},"engine":{"$ref":"#/components/schemas/Engine"},"html":{"type":"string"},"css":{"type":"string"},"head":{"type":"string"},"settings":{"$ref":"#/components/schemas/Settings"},"sample_data":{"type":"object","additionalProperties":true},"data_schema":{"type":"object","additionalProperties":true,"nullable":true},"i18n":{"type":"object","additionalProperties":true,"nullable":true},"partials":{"type":"object","additionalProperties":{"type":"string"},"description":"Partials the template includes (`name` → source), as `formfeed templates push` collects them from the project's partials folder."},"tags":{"type":"array","items":{"type":"string"}},"publish":{"type":"boolean","default":false}}},"TemplateVersionCreate":{"type":"object","description":"`html` is required for `pdf` and `image` templates.","properties":{"html":{"type":"string"},"css":{"type":"string"},"head":{"type":"string"},"settings":{"$ref":"#/components/schemas/Settings"},"sample_data":{"type":"object","additionalProperties":true},"data_schema":{"type":"object","additionalProperties":true,"nullable":true},"i18n":{"type":"object","additionalProperties":true,"nullable":true},"partials":{"type":"object","additionalProperties":{"type":"string"},"description":"Partials the template includes (`name` → source), as `formfeed templates push` collects them from the project's partials folder."},"data_sets":{"type":"object","additionalProperties":true,"description":"Named sample data sets besides `sample_data` (`name` → data), as the editor shows them and `formfeed templates push` sends them from `data/*.json`. At most 50."},"change_note":{"type":"string"},"base_checksum":{"type":"string","description":"Checksum of the version this draft was based on; conflict (409) if the latest version differs."},"publish":{"type":"boolean","default":false},"allow_breaking":{"type":"boolean","default":false,"description":"With `publish`: publish although the data schema breaks callers of the published version (otherwise 409 `schema_breaking_change`)."}}},"SchemaChange":{"type":"object","required":["path","pointer","kind","breaking","message"],"properties":{"path":{"type":"string","example":"customer.email","description":"Dotted field path; `items[]` for array elements, empty for the data itself."},"pointer":{"type":"string","example":"/properties/customer/properties/email"},"kind":{"type":"string","enum":["field-added-required","field-added-optional","field-removed","field-became-required","field-became-optional","type-narrowed","type-widened","enum-values-removed","enum-values-added","enum-added","enum-removed","const-changed","constraint-tightened","constraint-relaxed","additional-properties-closed","additional-properties-opened","keyword-changed"]},"breaking":{"type":"boolean"},"message":{"type":"string","example":"\"customer.email\" is now required"}}},"SchemaCheck":{"type":"object","description":"The data schema of the version going live compared with the one callers use now. `stored`: both versions store a schema, and breaking changes refuse without `allow_breaking`. `inferred`: at least one has none, so schemas inferred from sample data were compared and the result is only a warning. `none`: nothing to compare.","required":["source","breaking","safe"],"properties":{"source":{"type":"string","enum":["stored","inferred","none"]},"breaking":{"type":"array","items":{"$ref":"#/components/schemas/SchemaChange"}},"safe":{"type":"array","items":{"$ref":"#/components/schemas/SchemaChange"}}}},"Channel":{"type":"object","required":["name","version","canary","previous_version","updated_at"],"properties":{"name":{"type":"string","example":"staging","description":"`published`, or 1 to 32 lowercase letters, digits and dashes starting with a letter."},"version":{"type":"integer","nullable":true,"description":"The version the channel renders; null for `published` before anything was published."},"canary":{"type":"object","nullable":true,"properties":{"version":{"type":"integer"},"percent":{"type":"integer","minimum":1,"maximum":50}}},"previous_version":{"type":"integer","nullable":true,"description":"The version before the last move; `rollback` returns to it."},"updated_at":{"type":"string","format":"date-time"},"usage_24h":{"type":"array","description":"Renders of the last 24 hours that came through this channel, per version (list only).","items":{"type":"object","properties":{"version":{"type":"integer"},"renders":{"type":"integer"},"failed":{"type":"integer"}}}},"schema_check":{"$ref":"#/components/schemas/SchemaCheck"}}},"TemplateVersion":{"type":"object","properties":{"id":{"type":"string"},"number":{"type":"integer"},"status":{"type":"string","enum":["draft","published","archived"]},"checksum":{"type":"string"},"change_note":{"type":"string","nullable":true},"html":{"type":"string"},"css":{"type":"string"},"head":{"type":"string"},"settings":{"$ref":"#/components/schemas/Settings"},"sample_data":{"type":"object","additionalProperties":true},"data_schema":{"type":"object","additionalProperties":true,"nullable":true},"i18n":{"type":"object","additionalProperties":true,"nullable":true},"partials":{"type":"object","additionalProperties":{"type":"string"},"description":"Partials the template includes (`name` → source), as `formfeed templates push` collects them from the project's partials folder."},"source_file":{"type":"object","nullable":true,"description":"Word and PowerPoint templates: the file of this version; download it from `/templates/{id}/versions/{which}/file`. Null for other kinds.","properties":{"sha256":{"type":"string"},"bytes":{"type":"integer"},"format":{"type":"string","enum":["docx","pptx"]}}},"created_at":{"type":"string","format":"date-time"},"published_at":{"type":"string","format":"date-time","nullable":true},"schema_check":{"$ref":"#/components/schemas/SchemaCheck"}}},"File":{"type":"object","properties":{"id":{"type":"string","example":"fil_5b0000000000400080000000000000a1"},"name":{"type":"string","example":"brand/logo.png"},"content_type":{"type":"string","example":"image/png"},"bytes":{"type":"integer"},"sha256":{"type":"string","description":"Hash of the stored bytes."},"url":{"type":"string","format":"uri","description":"CDN URL; the same URL `asset(name)` produces."},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time","description":"When the name was last replaced."}}},"Brand":{"type":"object","required":["version","name","colors","fonts","font_size","logo","legal_footer","page_defaults"],"properties":{"version":{"type":"integer","example":7,"description":"Grows with every change of the kit; renders record the version they used."},"name":{"type":"string","nullable":true,"example":"Fennlor Studio GmbH"},"colors":{"type":"object","additionalProperties":{"type":"string","example":"#0f766e"},"description":"Token → hex colour, e.g. `primary`, `accent`. Always an object.","example":{"primary":"#0f766e","accent":"#f59e0b"}},"fonts":{"type":"object","properties":{"heading":{"type":"string","nullable":true,"example":"Inter"},"body":{"type":"string","nullable":true,"example":"Source Serif 4"}}},"font_size":{"type":"string","nullable":true,"example":"10pt"},"logo":{"type":"object","description":"CDN URLs of the logos, served without a signature; a new logo gets a new URL.","properties":{"primary":{"type":"string","format":"uri","nullable":true},"inverse":{"type":"string","format":"uri","nullable":true},"mark":{"type":"string","format":"uri","nullable":true}}},"legal_footer":{"type":"string","nullable":true},"page_defaults":{"type":"object","description":"Paper and margins new templates start from in the app; renders do not apply them. `{}` when unset.","properties":{"paper":{"type":"object","properties":{"format":{"type":"string","example":"A4"},"landscape":{"type":"boolean"}}},"margin":{"type":"object","properties":{"top":{"type":"string","example":"20mm"},"right":{"type":"string","example":"15mm"},"bottom":{"type":"string","example":"20mm"},"left":{"type":"string","example":"15mm"}}}}},"updated_at":{"type":"string","format":"date-time","nullable":true}}},"Partial":{"type":"object","required":["name","engine","version","created_at","updated_at"],"properties":{"name":{"type":"string","example":"letterhead"},"engine":{"$ref":"#/components/schemas/Engine"},"description":{"type":"string","nullable":true},"version":{"type":"integer","example":3,"description":"Grows when the source or the engine changes."},"source":{"type":"string","description":"Only in `GET /partials/{name}` and `PUT` responses."},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"}}},"PartialPut":{"type":"object","required":["engine","source"],"properties":{"engine":{"$ref":"#/components/schemas/Engine"},"source":{"type":"string","maxLength":262144},"description":{"type":"string","maxLength":300,"nullable":true},"base_version":{"type":"integer","minimum":1,"description":"The version this change is based on; conflict (409) if the partial has a different version. Leave out to write unconditionally."}}},"RenderInput":{"type":"object","description":"The stored request of a render, as `GET /renders/{id}/input` returns it. Fields that do not apply are left out.","properties":{"render_id":{"type":"string","example":"rnd_01J8ZK4M3Q7X"},"template":{"type":"object","properties":{"id":{"type":"string","example":"tpl_01J8ZK4M3Q"},"slug":{"type":"string"},"version":{"type":"integer"},"channel":{"type":"string"}}},"html":{"type":"string","description":"Ad-hoc HTML renders."},"engine":{"$ref":"#/components/schemas/Engine"},"url":{"type":"string","format":"uri","description":"URL renders."},"data":{"type":"object","additionalProperties":true},"locale":{"type":"string"},"output":{"$ref":"#/components/schemas/OutputFormat"},"settings":{"type":"object","additionalProperties":true},"filename":{"type":"string"},"post":{"type":"object","additionalProperties":true,"description":"Post-processing without passwords."},"meta":{"type":"object","additionalProperties":true},"environment":{"type":"string","enum":["live","test"]},"created_at":{"type":"string","format":"date-time"}}},"StorageOption":{"description":"The copy for the workspace's own bucket (bring your own storage). Left out, every output is\ncopied under the connection's key template. `false` leaves this document out. `key` names its\nobject below the connection's prefix instead of the key template: relative, without `.` or `..`\nsegments, at most 1024 bytes; an existing object is overwritten. A render with its own key is\nnever answered from the dedup cache, and one without a connection answers 409\n`storage_not_configured`. In a batch, each item carries its own.\n","oneOf":[{"type":"boolean","enum":[false]},{"type":"object","additionalProperties":false,"properties":{"key":{"type":"string","maxLength":1024,"example":"invoices/2026/RE-1001.pdf"}}}]},"StorageDelivery":{"type":"object","description":"The output's copy in the workspace's own bucket; null when none applies (no connection, a\npaused one, `storage: false`, a test render the connection does not take). A synchronous\nresponse reports `pending`: the copy is made in the background, and `storage.delivered` or\n`storage.failed` follow as webhook events.\n","properties":{"status":{"type":"string","enum":["pending","delivered","failed"]},"bucket":{"type":"string","example":"fennlor-docs"},"key":{"type":"string","example":"formfeed/2026/09/rnd_7da09ab6cd9946b798c187c2a9350852/invoice.pdf"},"url":{"type":"string","nullable":true,"description":"The object below the connection's `public_base_url`; null without one."},"reason":{"type":"string","nullable":true,"enum":["permanent","rejected","exhausted","source_gone","connection_deleted","connection_paused","plan","workspace_deleted"],"description":"Why a delivery failed: the credentials or bucket (`permanent`), the object (`rejected`), retries used up (`exhausted`), the output expired first (`source_gone`), or the connection went away."},"error":{"allOf":[{"$ref":"#/components/schemas/StorageError"}],"nullable":true}}},"StorageError":{"type":"object","description":"The provider's answer, reduced: its code, the HTTP status and the first line of its message.","properties":{"code":{"type":"string","example":"AccessDenied"},"http_status":{"type":"integer","nullable":true,"example":403},"message":{"type":"string","example":"Access Denied"}}},"StorageConnectionPut":{"type":"object","required":["provider","bucket"],"properties":{"provider":{"type":"string","enum":["s3","r2","s3_compatible"],"description":"`s3_compatible` covers Hetzner, IONOS, Scaleway, Wasabi, Backblaze B2, MinIO and Google Cloud Storage (HMAC keys)."},"region":{"type":"string","example":"eu-central-1","description":"`s3`: the AWS region, from which the endpoint is derived. `s3_compatible`: the region the provider signs with (`us-east-1` when omitted)."},"account_id":{"type":"string","example":"0123456789abcdef0123456789abcdef","description":"`r2`: the Cloudflare account id."},"jurisdiction":{"type":"string","enum":["default","eu"],"default":"default","description":"`r2`: `eu` for a bucket in the EU jurisdiction."},"endpoint":{"type":"string","format":"uri","example":"https://fsn1.your-objectstorage.com","description":"`s3_compatible`: the service address, https only."},"force_path_style":{"type":"boolean","default":false,"description":"`s3_compatible`: address the bucket in the path instead of the host name."},"bucket":{"type":"string","example":"fennlor-docs"},"prefix":{"type":"string","example":"formfeed/","description":"Folder every key is written below; a trailing slash is added."},"key_template":{"type":"string","default":"{yyyy}/{mm}/{render_id}/{filename}","description":"Object key below the prefix, with `{workspace}`, `{template}`, `{environment}`, `{render_id}`, `{job_id}`, `{yyyy}`, `{mm}`, `{dd}` and `{filename}`. A placeholder without a value (`{template}` of an HTML render, `{render_id}` of a batch zip) drops its segment."},"environments":{"type":"array","items":{"type":"string","enum":["live","test"]},"default":["live"],"description":"Which renders are copied; test renders only when `test` is listed."},"public_base_url":{"type":"string","format":"uri","nullable":true,"example":"https://docs.fennlor.example","description":"Where you serve the bucket, https only; each delivery's `url` is built from it."},"access_key_id":{"type":"string","description":"Write-only. Needed for a new connection or a changed endpoint."},"secret_access_key":{"type":"string","description":"Write-only; never returned."}}},"StorageConnection":{"type":"object","properties":{"id":{"type":"string","format":"uuid"},"workspace_id":{"type":"string","format":"uuid"},"provider":{"type":"string","enum":["s3","r2","s3_compatible"]},"endpoint":{"type":"string","format":"uri"},"region":{"type":"string","nullable":true},"account_id":{"type":"string","nullable":true},"jurisdiction":{"type":"string","nullable":true,"enum":["default","eu"]},"bucket":{"type":"string"},"prefix":{"type":"string"},"force_path_style":{"type":"boolean"},"key_template":{"type":"string"},"environments":{"type":"array","items":{"type":"string","enum":["live","test"]}},"public_base_url":{"type":"string","nullable":true},"status":{"type":"string","enum":["active","paused"]},"paused_reason":{"type":"string","nullable":true,"enum":["failures","workspace_deleted","plan"],"description":"`failures`: five permanent failures in a row (test the connection again to resume); `plan`: the plan no longer includes bring your own storage."},"access_key_hint":{"type":"string","nullable":true,"example":"7QX2","description":"The last four characters of the access key id."},"last_tested_at":{"type":"string","format":"date-time","nullable":true},"last_error":{"allOf":[{"$ref":"#/components/schemas/StorageError"}],"nullable":true},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"}}},"StorageConnectionState":{"allOf":[{"$ref":"#/components/schemas/StorageConnection"},{"type":"object","properties":{"deliveries_24h":{"type":"object","properties":{"pending":{"type":"integer"},"delivered":{"type":"integer"},"failed":{"type":"integer"}}}}}]},"WebhookEndpointCreate":{"type":"object","required":["url","events"],"properties":{"url":{"type":"string","format":"uri"},"events":{"type":"array","items":{"type":"string","enum":["render.completed","render.failed","job.completed","job.failed","quota.warning","quota.exceeded","storage.delivered","storage.failed"]}},"environments":{"type":"array","description":"Render environments whose events the endpoint receives; both by default. Quota events are sent regardless.","items":{"type":"string","enum":["live","test"]},"default":["live","test"]},"description":{"type":"string"},"enabled":{"type":"boolean","default":true}}},"WebhookEndpoint":{"allOf":[{"$ref":"#/components/schemas/WebhookEndpointCreate"},{"type":"object","properties":{"id":{"type":"string","example":"whk_01J8ZK4M3Q"},"secret":{"type":"string","description":"Only returned on creation."},"created_at":{"type":"string","format":"date-time"}}}]},"Account":{"type":"object","properties":{"workspace":{"type":"object","properties":{"id":{"type":"string"},"slug":{"type":"string"},"name":{"type":"string"},"region":{"$ref":"#/components/schemas/Region"}}},"organization":{"type":"object","properties":{"id":{"type":"string"},"slug":{"type":"string"},"name":{"type":"string"}}},"plan":{"type":"object","properties":{"id":{"type":"string","example":"pro"},"name":{"type":"string"},"monthly_units":{"type":"integer"}}},"period":{"type":"object","properties":{"start":{"type":"string","format":"date-time"},"end":{"type":"string","format":"date-time"}}},"units":{"type":"object","properties":{"included":{"type":"integer"},"used":{"type":"number"},"overage_balance":{"type":"number"}}},"limits":{"type":"object","additionalProperties":true}}},"Usage":{"type":"object","properties":{"period":{"type":"string","example":"2026-09"},"included":{"type":"integer"},"used":{"type":"number"},"overage_used":{"type":"number"},"overage_balance":{"type":"number"},"daily":{"type":"array","items":{"type":"object","properties":{"date":{"type":"string","format":"date"},"units":{"type":"number"},"renders":{"type":"integer"}}}},"by_template":{"type":"array","items":{"type":"object","properties":{"template":{"type":"string"},"units":{"type":"number"}}}}}}}}}