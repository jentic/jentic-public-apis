{
  "openapi": "3.0.1",
  "info": {
    "title": "Admin Console API",
    "description": "Documentazione dell'API di Admin Console<br><br><strong>Per poter utilizzare queste API è necessario autenticarsi tramite OAuth 2.0 con flusso Client Credentials</strong>",
    "version": "1.0.2",
    "contact": {
      "name": "Vianova"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/fiberwide/admin-console-api/1.0.2"
  },
  "servers": [
    {
      "url": "https://adminconsole.domain.tld/api/v1"
    }
  ],
  "tags": [
    {
      "name": "Partners",
      "description": "Endpoint per gestire i partner"
    },
    {
      "name": "Customers",
      "description": "Endpoint per gestire i clienti"
    },
    {
      "name": "Companies",
      "description": "Endpoint generici per gestire le aziende (partner e clienti)"
    },
    {
      "name": "Users",
      "description": "Endpoint per gestire gli utenti"
    },
    {
      "name": "Roles",
      "description": "Endpoint per gestire i ruoli degli utenti"
    }
  ],
  "paths": {
    "/partners": {
      "get": {
        "summary": "Elenco dei partner",
        "description": "Questo metodo serve per recuperare l'elenco dei partner",
        "tags": [
          "Partners"
        ],
        "operationId": "GetPartners",
        "parameters": [
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PerPage"
          },
          {
            "$ref": "#/components/parameters/CompaniesSort"
          },
          {
            "$ref": "#/components/parameters/CompaniesFilter"
          },
          {
            "$ref": "#/components/parameters/CurrentCompany"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/PaginatedCompanies"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/Validation"
          },
          "5XX": {
            "$ref": "#/components/responses/Unexpected"
          }
        }
      },
      "post": {
        "summary": "Nuovo partner",
        "description": "Questo metodo serve per inserire un nuovo partner",
        "tags": [
          "Partners"
        ],
        "operationId": "CreatePartner",
        "parameters": [
          {
            "$ref": "#/components/parameters/CurrentCompany"
          }
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/CreateUpdatePartner"
        },
        "responses": {
          "201": {
            "$ref": "#/components/responses/Company"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/Validation"
          },
          "5XX": {
            "$ref": "#/components/responses/Unexpected"
          }
        }
      }
    },
    "/partners/{partnerId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/CurrentCompany"
        },
        {
          "in": "path",
          "name": "partnerId",
          "description": "L'ID del partner",
          "schema": {
            "type": "string",
            "format": "uuid"
          },
          "required": true
        }
      ],
      "get": {
        "summary": "Dettaglio di un partner",
        "description": "Questo metodo serve per recuperare il dettaglio di un partner",
        "tags": [
          "Partners"
        ],
        "operationId": "GetPartner",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Company"
          },
