  "components": {
    "parameters": {
      "CurrentCompany": {
        "name": "X-CURRENT-COMPANY-ID",
        "in": "header",
        "description": "L'ID dell'azienda sulla quale si vuole operare",
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "required": true
      },
      "Page": {
        "name": "page",
        "in": "query",
        "description": "Numero di pagina",
        "schema": {
          "type": "integer",
          "default": 1,
          "minimum": 1
        }
      },
      "PerPage": {
        "name": "per_page",
        "in": "query",
        "description": "Numero di elementi per pagina che si vogliono recuperare",
        "schema": {
          "type": "integer",
          "default": 10,
          "minimum": 1,
          "maximum": 100
        }
      },
      "CompaniesSort": {
        "name": "sort",
        "in": "query",
        "style": "form",
        "schema": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "business_name",
              "-business_name",
              "vat_number",
              "-vat_number",
              "tax_code",
              "-tax_code",
              "status",
              "-status"
            ]
          },
          "minItems": 1
        },
        "explode": false
      },
      "CompaniesFilter": {
        "name": "filter",
        "in": "query",
        "style": "deepObject",
        "explode": true,
        "schema": {
          "type": "object",
          "properties": {
            "search": {
              "type": "string"
            },
            "status": {
              "type": "string"
            }
          }
        }
      },
      "UsersSort": {
        "name": "sort",
        "in": "query",
        "style": "form",
        "schema": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "name",
              "-name",
              "surname",
              "-surname",
              "email",
              "-email",
              "created_at",
              "-created_at",
              "status",
              "-status"
            ]
          },
          "minItems": 1
        },
        "explode": false
