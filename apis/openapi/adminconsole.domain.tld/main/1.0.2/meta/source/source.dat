            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/Validation"
          },
          "5XX": {
            "$ref": "#/components/responses/Unexpected"
          }
        }
      },
      "put": {
        "summary": "Aggiornamento di un partner",
        "description": "Questo metodo serve per aggiornare i dati di un partner",
        "tags": [
          "Partners"
        ],
        "operationId": "UpdatePartner",
        "requestBody": {
          "$ref": "#/components/requestBodies/CreateUpdatePartner"
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Company"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/Validation"
          },
          "5XX": {
            "$ref": "#/components/responses/Unexpected"
          }
        }
      },
      "delete": {
        "summary": "Eliminazione di un partner",
        "description": "Questo metodo serve per eliminare un partner<br><strong>NB: questa operazione è possibile solo se il partner non ha clienti associati</strong>",
        "tags": [
          "Partners"
        ],
        "operationId": "DeletePartner",
        "responses": {
          "204": {
            "$ref": "#/components/responses/Deleted"
          },
          "400": {
            "$ref": "#/components/responses/PartnerWithCustomer"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "5XX": {
            "$ref": "#/components/responses/Unexpected"
          }
        }
      }
    },
