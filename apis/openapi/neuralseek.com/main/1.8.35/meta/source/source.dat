                    "description": "The input text to identify the language of"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "language": {
                      "type": "string",
                      "default": "",
                      "description": "The 2-character language code of the identified language."
                    },
                    "confidence": {
                      "type": "number",
                      "description": "The confidence of the language identification"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "apiKey": []
          }
        ]
      }
    },
