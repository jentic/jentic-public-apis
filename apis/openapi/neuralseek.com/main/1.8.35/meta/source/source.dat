                            "type": "string",
                            "default": "",
                            "description": "The sentence fragment"
                          }
                        }
                      }
                    },
                    "description": "Instead of a file upload you may pass sentence mappings"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        },
        "security": [
          {
            "apiKey": []
          }
        ]
      },
