{
  "openapi": "3.0.1",
  "info": {
    "title": "Hippo OpenAPI Spec",
    "description": "OpenAPI 3 Spec",
    "version": "5.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/CenturyLink_APIs/autom8-hippo-hiermdash/5.0.0"
  },
  "servers": [
    {
      "url": "https://hippo.it.savvis.net/",
      "description": "production"
    },
    {
      "url": "https://dl1rmhpoutdv01.it.savvis.net/",
      "description": "test"
    },
    {
      "url": "https://dl1rmhpoutdv01.it.savvis.net:8443/",
      "description": "dev"
    }
  ],
  "tags": [
    {
      "name": "Websource Change"
    },
    {
      "name": "Activity"
    },
    {
      "name": "Task"
    },
    {
      "name": "Subtask"
    }
  ],
  "security": [
    {
      "ApiToken": []
    }
  ],
  "paths": {
    "/api/changes": {
      "post": {
        "tags": [
          "Websource Change"
        ],
        "summary": "Create Websource Change",
        "operationId": "createWebSourceChange",
        "requestBody": {
          "$ref": "#/components/requestBodies/CreateWebsourceChange"
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebsourceChangeExtended"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    },
    "/api/changes/{changeId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/WebSourceChangeIdParam"
        }
      ],
      "get": {
        "tags": [
          "Websource Change"
        ],
        "summary": "Read Websource Change",
        "operationId": "readWebSourceChange",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebsourceChangeExtended"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "put": {
        "tags": [
          "Websource Change"
        ],
        "summary": "Update Websource Change",
        "operationId": "updateWebSourceChange",
        "requestBody": {
          "$ref": "#/components/requestBodies/UpdateWebsourceChange"
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Change CRQ000000123456 updated"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/changes/{changeId}/maintenanceobjects": {
      "parameters": [
        {
          "$ref": "#/components/parameters/WebSourceChangeIdParam"
        }
      ],
      "get": {
        "tags": [
          "Websource Change"
        ],
        "summary": "Get All Websource Change Maintenance Objects",
        "operationId": "getAllWebSourceChangeMaintenanceObjects",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MaintenanceObject"
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/activities": {
      "get": {
        "tags": [
          "Activity"
        ],
        "summary": "Get Activities",
        "operationId": "getAllActivities",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ActivityExtended"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Activity"
        ],
        "summary": "Create Activity",
        "operationId": "createActivity",
        "description": "A new activity",
        "requestBody": {
          "$ref": "#/components/requestBodies/CreateActivity"
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActivityExtended"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    },
    "/api/activities/{activityId}": {
      "get": {
        "tags": [
          "Activity"
        ],
        "summary": "Read Activity",
        "operationId": "getActivity",
        "parameters": [
          {
            "$ref": "#/components/parameters/ActivityIdParam"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActivityExtended"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "put": {
        "tags": [
          "Activity"
        ],
        "summary": "Update Activity",
        "operationId": "updateActivity",
        "parameters": [
          {
            "$ref": "#/components/parameters/ActivityIdParam"
          }
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/UpdateActivity"
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "activity CRQ000000123456 updated"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "delete": {
        "tags": [
          "Activity"
        ],
        "summary": "Delete Activity",
        "operationId": "deleteActivity",
        "parameters": [
          {
            "$ref": "#/components/parameters/ActivityIdParam"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Change deleted"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/activities/{activityId}/tasks": {
      "get": {
        "tags": [
          "Task"
        ],
        "summary": "All Tasks",
        "operationId": "getAllTasks",
        "parameters": [
          {
            "$ref": "#/components/parameters/ActivityIdParam"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TaskExtended"
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "post": {
        "tags": [
          "Task"
        ],
        "summary": "Create Task",
        "operationId": "createTask",
        "parameters": [
          {
            "$ref": "#/components/parameters/ActivityIdParam"
          }
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/CreateTask"
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskExtended"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/activities/{activityId}/subtasks": {
      "get": {
        "tags": [
          "Subtask"
        ],
        "summary": "All Subtasks for an activity",
        "operationId": "getAllActivityLevelSubtasks",
        "parameters": [
          {
            "$ref": "#/components/parameters/ActivityIdParam"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SubtaskExtended"
                  }
                },
                "example": {
                  "S639527DC3LB203": {
                    "type": "healthcheck",
                    "_id": "60f02cc311535c0011ddd421",
                    "id": "22143ad6-c017-40bf-bf09-2517726c2f32",
                    "title": "PREMAINTENANCE",
                    "started": "2021-07-15T12:40:35.554Z",
                    "updated": "2021-07-19T12:43:37.378Z",
                    "status": "Failed",
                    "activityId": "CRQ000000911911",
                    "activity_id": "60e60d2c96a7c900119b5a07",
                    "taskId": "S639527DC3LB203",
                    "hasOutput\"": true
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/activities/{activityId}/tasks/{taskId}": {
      "get": {
        "tags": [
          "Task"
        ],
        "summary": "Read Task",
        "operationId": "ReadTask",
        "parameters": [
          {
            "$ref": "#/components/parameters/ActivityIdParam"
          },
          {
            "$ref": "#/components/parameters/TaskIdParam"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskExtended"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "put": {
        "tags": [
          "Task"
        ],
        "summary": "Update Task",
        "operationId": "updateTask",
        "parameters": [
          {
            "$ref": "#/components/parameters/ActivityIdParam"
          },
          {
            "$ref": "#/components/parameters/TaskIdParam"
          }
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/UpdateTask"
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "task updated"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/activities/{activityId}/tasks/{taskId}/subtasks": {
      "get": {
        "tags": [
          "Subtask"
        ],
        "summary": "All Subtasks for a task",
        "operationId": "getAllSubtasks",
        "parameters": [
          {
            "$ref": "#/components/parameters/ActivityIdParam"
          },
          {
            "$ref": "#/components/parameters/TaskIdParam"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "allOf": [
                      {
                        "$ref": "#/components/schemas/SubtaskExtended"
                      },
                      {
                        "type": "object",
                        "properties": {
                          "activityId": {
                            "type": "string",
                            "example": "CRQ000000911911"
                          },
                          "activity_id": {
                            "type": "string",
                            "example": "60e60d2c96a7c900119b5a07"
                          },
                          "taskId": {
                            "type": "string",
                            "example": "S639527DC3LB203"
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "post": {
        "tags": [
          "Subtask"
        ],
        "summary": "Create Subtask",
        "operationId": "createSubtask",
        "parameters": [
          {
            "$ref": "#/components/parameters/ActivityIdParam"
          },
          {
            "$ref": "#/components/parameters/TaskIdParam"
          }
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/CreateSubtask"
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubtaskExtended"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/activities/{activityId}/tasks/{taskId}/subtasks/{subtaskId}": {
      "get": {
        "tags": [
          "Subtask"
        ],
        "summary": "Read Subtask",
        "operationId": "readSubtask",
        "parameters": [
          {
            "$ref": "#/components/parameters/ActivityIdParam"
          },
          {
            "$ref": "#/components/parameters/TaskIdParam"
          },
          {
            "$ref": "#/components/parameters/SubtaskIdParam"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubtaskWithOutput"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "put": {
        "tags": [
          "Subtask"
        ],
        "summary": "Update Subtask",
        "operationId": "updateSubtask",
        "parameters": [
          {
            "$ref": "#/components/parameters/ActivityIdParam"
          },
          {
            "$ref": "#/components/parameters/TaskIdParam"
          },
          {
            "$ref": "#/components/parameters/SubtaskIdParam"
          },
          {
            "name": "createWorkInfo",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Determines if a Remedy WorkInfo note should be created"
            },
            "allowEmptyValue": true
          }
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/UpdateSubtask"
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubtaskWithParsedOutput"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "ActivityIdParam": {
        "name": "activityId",
        "in": "path",
        "description": "Activity ID, VMAC Number or Remedy CRQ Number",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/ActivityId"
        },
        "example": "CRQ000000123456"
      },
      "SubtaskIdParam": {
        "name": "subtaskId",
        "in": "path",
        "description": "Activity Subtask Id",
        "required": true,
        "schema": {
          "type": "string",
          "example": "69bd7dca-491f-46f0-a639-40aa54545ea3"
        }
      },
      "TaskIdParam": {
        "name": "taskId",
        "in": "path",
        "description": "Activity Task Id",
        "required": true,
        "schema": {
          "type": "string",
          "example": "S639527DC3LB203"
        }
      },
      "WebSourceChangeIdParam": {
        "name": "changeId",
        "in": "path",
        "description": "Web Source Change Id",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/RemedyCrqNumber"
        },
        "example": "CRQ000000123456"
      }
    },
    "schemas": {
      "Activity": {
        "title": "Activity",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/ActivityId"
          },
          "type": {
            "$ref": "#/components/schemas/ActivityType"
          },
          "stage": {
            "$ref": "#/components/schemas/ActivityStage"
          },
          "status": {
            "$ref": "#/components/schemas/ActivityStatus"
          },
          "title": {
            "type": "string",
            "example": "HIERM-PS-Z-A-AcmeCorp - 21"
          },
          "errorsList": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": []
          },
          "warningsList": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": []
          }
        }
      },
      "ActivityExtended": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Activity"
          },
          {
            "type": "object",
            "properties": {
              "kueJob": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "example": []
              }
            }
          },
          {
            "type": "object",
            "properties": {
              "current": {
                "type": "boolean",
                "example": true
              }
            }
          },
          {
            "$ref": "#/components/schemas/_Standard_MongoProps"
          }
        ]
      },
      "ActivityId": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/RemedyCrqNumber"
          },
          {
            "$ref": "#/components/schemas/MongoId"
          },
          {
            "$ref": "#/components/schemas/LegacyChangeId"
          }
        ]
      },
      "ActivityStage": {
        "type": "string",
        "enum": [
          "Executing",
          "Finished",
          "Health Checking",
          "Setup",
          "Validation"
        ]
      },
      "ActivityStatus": {
        "type": "string",
        "enum": [
          "Failed",
          "Halt Initiated",
          "In Progress",
          "Setting Up",
          "Success",
          "Warning"
        ]
      },
      "ActivityType": {
        "type": "string",
        "enum": [
          "Execution",
          "Health Check"
        ]
      },
      "LegacyChangeId": {
        "type": "string",
        "pattern": "^G?\\d{6,}$",
        "example": "41772312"
      },
      "MaintenanceObject": {
        "title": "MaintenanceObject",
        "required": [
          "id"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "SERVER-01"
          },
          "alternateName": {
            "type": "string",
            "example": "DEVSQL07"
          }
        }
      },
      "MongoId": {
        "type": "string",
        "pattern": "^[0-9a-f]{24}$",
        "example": "5f74422ab99b310011a4c0f5"
      },
      "ParsedOutput": {
        "title": "Parsed Output",
        "required": [
          "error",
          "result",
          "header"
        ],
        "type": "object",
        "properties": {
          "error": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "example": []
          },
          "result": {
            "$ref": "#/components/schemas/ScriptData"
          },
          "header": {
            "$ref": "#/components/schemas/ScriptDataHeader"
          },
          "hasTransforms": {
            "type": "boolean",
            "example": false
          },
          "id": {
            "type": "boolean",
            "example": "S639527DC3LB203"
          }
        }
      },
      "RemedyCrqNumber": {
        "type": "string",
        "pattern": "^CRQ\\d{5,}$",
        "example": "CRQ000000123456"
      },
      "ScriptData": {
        "title": "Script Data",
        "type": "object",
        "example": [
          {
            "name": "In Sync",
            "detail": "PASS - Appliance is in sync",
            "created": "2020-09-30T08:31:39.621Z",
            "severity": "info"
          },
          {
            "name": "Reachable",
            "detail": "PASS - Appliance is reachable",
            "created": "2020-09-30T08:31:45.381Z",
            "severity": "info"
          }
        ]
      },
      "ScriptDataHeader": {
        "title": "Script Data Header",
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "example": "1.0.0"
          },
          "format": {
            "type": "string",
            "example": "json"
          },
          "name": {
            "type": "string",
            "example": "script.py"
          },
          "compressed": {
            "type": "boolean",
            "example": false
          },
          "multidevice": {
            "type": "boolean",
            "example": false
          }
        }
      },
      "Subtask": {
        "required": [
          "id"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "22143ad6-c017-40bf-bf09-2517726c2f32"
          },
          "output": {
            "type": "string",
            "example": "Executing some pretty sweet automation...DONE!\n"
          },
          "status": {
            "$ref": "#/components/schemas/SubtaskStatus"
          },
          "type": {
            "$ref": "#/components/schemas/SubtaskType"
          },
          "title": {
            "type": "string",
            "example": "PREMAINTENANCE"
          }
        }
      },
      "SubtaskExtended": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Subtask"
          },
          {
            "type": "object",
            "properties": {
              "hasOutput": {
                "type": "boolean",
                "example": true
              }
            }
          },
          {
            "$ref": "#/components/schemas/_Task_And_Subtask_MongoProps"
          }
        ]
      },
      "SubtaskStatus": {
        "type": "string",
        "enum": [
          "Success",
          "Warning",
          "Failed",
          "In Progress"
        ]
      },
      "SubtaskType": {
        "type": "string",
        "enum": [
          "healthcheck",
          "precheck",
          "execution",
          "postcheck",
          "validation"
        ]
      },
      "Task": {
        "required": [
          "id"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "S639527DC3LB203"
          },
          "status": {
            "$ref": "#/components/schemas/TaskStatus"
          },
          "stage": {
            "$ref": "#/components/schemas/TaskStage"
          },
          "progress": {
            "type": "string",
            "example": "Performing step 1/7..."
          }
        }
      },
      "TaskExtended": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Task"
          },
          {
            "$ref": "#/components/schemas/_Task_And_Subtask_MongoProps"
          }
        ]
      },
      "TaskStage": {
        "type": "string",
        "example": "Health Check"
      },
      "TaskStatus": {
        "type": "string",
        "enum": [
          "Not Started",
          "Skipped",
          "Success",
          "In Progress",
          "Failed",
          "Warning",
          "Queued"
        ]
      },
      "ScriptDataOutput": {
        "title": "Script Data Output",
        "type": "string",
        "example": "Executing some pretty sweet automation...DONE!\n~~~START~~~#VERSION:1.0.0#FORMAT:json#NAME:script.py#COMPRESSED:False#MULTIDEVICE:False#\n{\"_meta\": {\"schemaVersion\": \"http://hippo.it.savvis.net/schemas/AutomationScriptDataOutput/0.0.1\"}, \"created\": \"2021-07-15T12:39:00Z\", \"events\": [{\"detail\": \"PASS - Appliance is in sync\", \"name\": \"In Sync\", \"severity\": \"info\"}, {\"detail\": \"PASS - Appliance is reachable\", \"name\": \"Reachable\", \"severity\": \"info\"}], \"externalJob\": {\"id\": \"83fe6d9c-83d7-430a-8379-503d79071b38\", \"source\": \"Phoenix\"}}\n~~~END~~~\n"
      },
      "SubtaskWithParsedOutput": {
        "title": "Subtask (with parsed output)",
        "type": "object",
        "allOf": [
          {
            "$ref": "#/components/schemas/Subtask"
          },
          {
            "type": "object",
            "properties": {
              "output": {
                "type": "string",
                "example": "Executing some pretty sweet automation...DONE!"
              },
              "parsed": {
                "$ref": "#/components/schemas/ParsedOutput"
              }
            }
          },
          {
            "$ref": "#/components/schemas/_Task_And_Subtask_MongoProps"
          }
        ]
      },
      "SubtaskWithOutput": {
        "title": "Subtask (with output)",
        "type": "object",
        "allOf": [
          {
            "$ref": "#/components/schemas/Subtask"
          },
          {
            "type": "object",
            "properties": {
              "parsed": {
                "type": "object",
                "properties": {
                  "error": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    },
                    "example": []
                  },
                  "hasTransforms": {
                    "type": "boolean",
                    "example": false
                  },
                  "id": {
                    "type": "string",
                    "example": null
                  }
                }
              }
            }
          },
          {
            "$ref": "#/components/schemas/_Task_And_Subtask_MongoProps"
          }
        ]
      },
      "WebsourceChange": {
        "title": "WebsourceChange",
        "required": [
          "id",
          "maintenanceObjects"
        ],
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/RemedyCrqNumber"
          },
          "maintenanceObjects": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MaintenanceObject"
            }
          }
        }
      },
      "WebsourceChangeExtended": {
        "allOf": [
          {
            "$ref": "#/components/schemas/WebsourceChange"
          },
          {
            "$ref": "#/components/schemas/_Standard_MongoProps"
          }
        ]
      },
      "_Standard_MongoProps": {
        "type": "object",
        "properties": {
          "_id": {
            "$ref": "#/components/schemas/MongoId"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2020-09-30T08:31:39.621Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2020-09-30T08:32:15.661Z"
          },
          "__v": {
            "type": "number",
            "example": 0
          }
        }
      },
      "_Task_And_Subtask_MongoProps": {
        "type": "object",
        "properties": {
          "_id": {
            "$ref": "#/components/schemas/MongoId"
          },
          "started": {
            "type": "string",
            "format": "date-time",
            "example": "2020-09-30T08:31:39.621Z"
          },
          "updated": {
            "type": "string",
            "format": "date-time",
            "example": "2020-09-30T08:32:15.661Z"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ]
      }
    },
    "requestBodies": {
      "CreateActivity": {
        "description": "A new activity",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Activity"
            }
          }
        }
      },
      "CreateSubtask": {
        "description": "A new subtask",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Subtask"
            }
          }
        }
      },
      "CreateTask": {
        "description": "A new task",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Task"
            }
          }
        }
      },
      "CreateWebsourceChange": {
        "description": "A new web source change",
        "content": {
          "application/json": {
            "schema": {
              "required": [
                "id"
              ],
              "type": "object",
              "properties": {
                "id": {
                  "$ref": "#/components/schemas/RemedyCrqNumber"
                },
                "maintenanceObjects": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MaintenanceObject"
                  }
                }
              }
            }
          }
        }
      },
      "UpdateWebsourceChange": {
        "description": "Update a web source change",
        "content": {
          "application/json": {
            "schema": {
              "required": [
                "maintenanceObjects"
              ],
              "type": "object",
              "properties": {
                "maintenanceObjects": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MaintenanceObject"
                  }
                }
              }
            }
          }
        }
      },
      "UpdateActivity": {
        "description": "Updates to an activity",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Activity"
            },
            "example": {
              "stage": "Finished",
              "status": "Success"
            }
          }
        }
      },
      "UpdateTask": {
        "description": "Updates to a task",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Task"
            }
          }
        }
      },
      "UpdateSubtask": {
        "description": "Updates to a subtask",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "output": {
                  "$ref": "#/components/schemas/ScriptDataOutput"
                }
              }
            }
          }
        }
      }
    },
    "responses": {
      "NotFound": {
        "description": "The specified resource was not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "BadRequest": {
        "description": "The server cannot or will not process the request due to an apparent client error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "ApiToken": {
        "type": "apiKey",
        "in": "header",
        "name": "apikey"
      }
    }
  }
}
