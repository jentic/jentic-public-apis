{
  "openapi": "3.0.0",
  "info": {
    "description": "Hippo Jobqueue service",
    "version": "4.2.0",
    "title": "Hippo Jobqueue",
    "contact": {
      "email": "HIEreleasemanagementengineers@centurylink.com"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/CenturyLink_APIs/autom8-hippo-jobqueue/4.2.0"
  },
  "servers": [
    {
      "url": "https://hippo.it.savvis.net/",
      "description": "Production Hippo"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    },
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/jobs": {
      "get": {
        "summary": "Gets all jobs",
        "parameters": [
          {
            "in": "query",
            "name": "status",
            "schema": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/PhoenixJobStatus"
                },
                {
                  "$ref": "#/components/schemas/CamJobStatus"
                },
                {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "$ref": "#/components/schemas/PhoenixJobStatus"
                      },
                      {
                        "$ref": "#/components/schemas/CamJobStatus"
                      }
                    ]
                  }
                }
              ]
            }
          },
          {
            "in": "query",
            "name": "createdFrom",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Filter jobs by createdAt date. defaults to last 24h"
          },
          {
            "in": "query",
            "name": "createdTo",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Filter jobs by createdAt date. Defaults to now"
          },
          {
            "in": "query",
            "name": "kind",
            "description": "Filter jobs by kind",
            "schema": {
              "type": "string",
              "enum": [
                "cam",
                "phoenix"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Job"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a job",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Job"
              },
              "examples": {
                "camRequest": {
                  "summary": "CAM job request",
                  "value": {
                    "$ref": "./jobs/examples/CreateJob_CAM_RequestBody_Success_Example_1.json"
                  }
                },
                "phoenixRequest": {
                  "summary": "Phoenix job request",
                  "value": {
                    "$ref": "./jobs/examples/CreateJob_Phoenix_RequestBody_Success_Example_1.json"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "A job",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                },
                "examples": {
                  "camResponse": {
                    "summary": "CAM job response",
                    "value": {
                      "$ref": "./jobs/examples/CreateJob_CAM_ResponseBody_Success_Example_1.json"
                    }
                  },
                  "phoenixResponse": {
                    "summary": "Phoenix job response",
                    "value": {
                      "$ref": "./jobs/examples/CreateJob_Phoenix_ResponseBody_Success_Example_1.json"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/{id}": {
      "summary": "A single job",
      "parameters": [
        {
          "$ref": "#/components/parameters/jobIdParam"
        }
      ],
      "get": {
        "summary": "Gets a job by ID.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                },
                "example": {
                  "$ref": "./jobs/examples/GetJob_ResponseBody_Success_Example_1.json"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/jobs/{id}/callback": {
      "parameters": [
        {
          "$ref": "#/components/parameters/jobIdParam"
        }
      ],
      "post": {
        "summary": "Trigger job callback to signal external job completion",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompletionCallback"
              },
              "example": {
                "$ref": "./jobs/examples/CompletionCallback_RequestBody_Success_Example_1.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A phoenix job",
            "content": {
              "application/json": {
                "example": {
                  "$ref": "./jobs/examples/CompletionCallback_ResponseBody_Success_Example_1.json"
                }
              }
            }
          },
          "400": {
            "description": "Invalid callback request",
            "content": {
              "application/json": {
                "example": {
                  "$ref": "./jobs/examples/CompletionCallback_ResponseBody_Failure_Invalid_State.json"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      },
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "apikey"
      }
    },
    "schemas": {
      "JobId": {
        "type": "string",
        "readOnly": true,
        "description": "MongoID of job document"
      },
      "RemedyCrqNumber": {
        "type": "string",
        "description": "Remedy CRQ Number",
        "pattern": "^CRQ\\d{12}$"
      },
      "PhoenixJobStatus": {
        "type": "string",
        "enum": [
          "notStarted",
          "changeBeginQueued",
          "changeBeginRunning",
          "changeStarted",
          "externalExecutionStarted",
          "externalExecutionCompleted",
          "changeEndQueued",
          "changeEndRunning",
          "activityCompleted",
          "errored"
        ]
      },
      "CamJobStatus": {
        "type": "string",
        "enum": [
          "notStarted",
          "flowQueued",
          "scriptRunning",
          "completed",
          "errored"
        ]
      },
      "Job": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/PhoenixJob"
          },
          {
            "$ref": "#/components/schemas/CAMJob"
          }
        ],
        "discriminator": {
          "propertyName": "kind",
          "mapping": {
            "phoenix": "#/components/schemas/PhoenixJob",
            "cam": "#/components/schemas/CAMJob"
          }
        }
      },
      "BaseJob": {
        "type": "object",
        "properties": {
          "_id": {
            "$ref": "#/components/schemas/JobId"
          },
          "kind": {
            "type": "string",
            "enum": [
              "phoenix",
              "cam"
            ]
          },
          "createdBy": {
            "type": "string",
            "format": "email",
            "readOnly": true
          },
          "updatedBy": {
            "type": "string",
            "format": "email",
            "readOnly": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          }
        }
      },
      "CAMJob": {
        "allOf": [
          {
            "$ref": "#/components/schemas/BaseJob"
          },
          {
            "type": "object",
            "properties": {
              "callbackURL": {
                "type": "string",
                "format": "uri-reference"
              },
              "status": {
                "readOnly": true,
                "$ref": "#/components/schemas/CamJobStatus"
              },
              "serverName": {
                "description": "HPSA or CAM server to run the script against",
                "type": "string",
                "format": "hostname"
              },
              "scriptPath": {
                "description": "HPSA script id or CAM S3 blob reference",
                "type": "string"
              },
              "scriptParameters": {
                "description": "parameters to pass to the script",
                "type": "string"
              },
              "scriptLabel": {
                "description": "reported in the CAM interface against the execution. This is customer facing show needs to be reasonably clear.",
                "type": "string"
              },
              "trustAllRoots": {
                "description": "needed if the host in the callback url is using a self signed certificate",
                "type": "boolean",
                "default": false
              }
            },
            "required": [
              "callbackURL",
              "serverName",
              "scriptPath",
              "scriptParameters"
            ]
          }
        ]
      },
      "PhoenixJob": {
        "allOf": [
          {
            "$ref": "#/components/schemas/BaseJob"
          },
          {
            "type": "object",
            "properties": {
              "activityId": {
                "$ref": "#/components/schemas/RemedyCrqNumber"
              },
              "callbackUrl": {
                "type": "string",
                "format": "uri-reference"
              },
              "status": {
                "readOnly": true,
                "$ref": "#/components/schemas/PhoenixJobStatus"
              },
              "token": {
                "description": "Phoenix api token to use when starting Phoenix job",
                "type": "string",
                "writeOnly": true
              }
            },
            "required": [
              "activityId",
              "callbackUrl",
              "token"
            ]
          }
        ]
      },
      "CIResult": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^\\w[\\w-.]*$"
          },
          "status": {
            "type": "string",
            "enum": [
              "success",
              "warning",
              "failed"
            ]
          }
        }
      },
      "CompletionCallback": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "complete",
              "errored"
            ]
          },
          "errorMessage": {
            "type": "string"
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CIResult"
            }
          }
        },
        "required": [
          "status",
          "results"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ]
      }
    },
    "parameters": {
      "jobIdParam": {
        "name": "id",
        "in": "path",
        "description": "Job ID",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/JobId"
        }
      }
    },
    "responses": {
      "NotFound": {
        "description": "The specified resource was not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
