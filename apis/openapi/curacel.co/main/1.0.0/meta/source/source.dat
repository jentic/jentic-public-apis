                  },
                  "other_business_type": {
                    "type": "string",
                    "description": "The relationship between the enrollee and the principal enrollee."
                  },
                  "other_business_sector": {
                    "type": "string",
                    "description": "A base64 encoded image string."
                  },
                  "generate_credentials": {
                    "type": "boolean",
                    "description": "If true, a new user account would also be created for the with a temporary password. Credentials would be forwarded in a mail notification."
                  }
