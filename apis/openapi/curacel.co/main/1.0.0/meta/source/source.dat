                                  "nullable": true,
                                  "properties": {
                                    "id": {
                                      "type": "integer"
                                    },
                                    "provider": {
                                      "type": "object",
                                      "nullable": true,
                                      "properties": {
                                        "id": {
                                          "type": "integer"
                                        },
                                        "name": {
                                          "type": "string"
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Forbidden (feature not enabled for this Insurer/HMO)"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
