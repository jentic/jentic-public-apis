                                "type": "number",
                                "format": "double"
                              },
                              "approved_amount": {
                                "type": "number",
                                "format": "double",
                                "nullable": true
                              },
                              "co_payment_value": {
                                "type": "number",
                                "format": "double",
                                "nullable": true
                              },
                              "co_payment_amount": {
                                "type": "number",
                                "format": "double",
                                "nullable": true
