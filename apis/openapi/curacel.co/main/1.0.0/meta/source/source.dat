                  "status",
                  "hmo_plan_ids"
                ],
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "The name of the Client."
                  },
                  "phone": {
                    "type": "string",
                    "description": "The phone number of the Client."
                  },
                  "email": {
                    "type": "string",
                    "description": "The email address of the Client."
                  },
                  "address": {
                    "type": "string",
                    "description": "The address of the Client."
                  },
                  "city": {
                    "type": "string",
                    "description": "The city of the Client."
                  },
                  "selected_lga_id": {
                    "type": "integer",
                    "description": "The ID of the Local Government Area of the Client."
                  },
                  "selected_state_id": {
                    "type": "integer",
                    "description": "The ID of the State of the Client."
                  },
                  "selected_country_id": {
                    "type": "integer",
                    "description": "The ID of the Country of the Client."
                  },
