    "/confirmations/{confirmationId}": {
      "get": {
        "tags": [
          "Confirmation Emails",
          "Classic"
        ],
        "description": "Retrieve detailed information for a specific confirmation email",
        "operationId": "getConfirmation",
        "parameters": [
          {
            "name": "confirmationId",
            "in": "path",
            "description": "The ID of the confirmation email",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Confirmation email details retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfirmationDetailedApiDto"
                }
              }
            }
          },
          "400": {
            "description": "A confirmation email ID was not supplied"
          },
          "403": {
            "description": "The action was forbidden by permissions"
          },
          "404": {
            "description": "Invalid confirmation email ID was supplied"
          },
          "500": {
            "description": "Form not found or internal server error"
          }
        }
      },
      "put": {
        "tags": [
          "Confirmation Emails",
          "Classic"
        ],
        "description": "Update an existing confirmation email",
        "operationId": "updateConfirmationEmail",
        "parameters": [
          {
            "name": "confirmationId",
            "in": "path",
            "description": "The ID of the confirmation email",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "description": "Update confirmation email request data",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateConfirmationEmailInputApiDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Confirmation email updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfirmationDetailedApiDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request parameters"
          },
          "403": {
            "description": "Forbidden by form permissions"
          },
          "404": {
            "description": "Confirmation email not found"
          },
          "500": {
            "description": "Could not update the confirmation email"
          }
        }
      },
      "delete": {
        "tags": [
          "Confirmation Emails",
          "Classic"
        ],
        "description": "Delete a specific confirmation email",
        "operationId": "deleteConfirmationEmail",
        "parameters": [
          {
            "name": "confirmationId",
            "in": "path",
            "description": "The ID of the confirmation email",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Confirmation email deleted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfirmationEmailPreviewApiDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request parameters"
          },
          "403": {
            "description": "Forbidden by form permissions"
          },
          "404": {
            "description": "Confirmation email not found"
          },
          "500": {
            "description": "Could not delete the confirmation email"
          }
        }
      }
    },
