  "components": {
    "schemas": {
      "ActivationJourneyTemplateDto": {
        "description": "Template used in the user activation journey to help new users get started with form creation",
        "properties": {
          "id": {
            "description": "Template ID",
            "type": "string"
          },
          "title": {
            "description": "Template title",
            "type": "string"
          },
          "industry": {
            "description": "Industry categories this template is suitable for",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "department": {
            "description": "Department or functional areas this template is designed for",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "shortDescription": {
            "description": "Brief description of the template's purpose and use case",
            "type": "string"
          },
          "description": {
            "description": "Detailed description of the template including features and benefits",
            "type": "string"
          },
          "previewImgSrc": {
            "description": "URL to the template preview image",
            "type": "string"
          },
          "product": {
            "description": "Product type",
            "type": "string"
          },
          "staticTemplateImgSrc": {
            "description": "URL to the static template image used for display purposes",
            "type": "string"
          },
          "templateUrl": {
            "description": "URL to access or create a form from this template",
            "type": "string"
          }
        },
        "type": "object"
      },
      "ActivationJourneyTemplatesListingApiDto": {
        "description": "Collection of activation journey templates available to help users get started with form creation",
        "type": "object",
        "additionalProperties": {
          "$ref": "#/components/schemas/ActivationJourneyTemplateDto"
        }
      },
      "PrebuiltFormDetailedApiDto": {
        "title": "Prebuilt Form Details",
        "description": "Detailed information about a prebuilt form from Copilot",
        "properties": {
          "id": {
            "description": "The ID of the form",
            "type": "integer",
            "nullable": false
          },
          "name": {
            "description": "Name of the form",
            "type": "string",
            "nullable": false
          },
          "created": {
            "description": "Date when the form was created",
            "type": "string",
            "nullable": false
          },
          "updated": {
            "description": "Date when the form was last updated",
            "type": "string",
            "nullable": false
          },
          "db": {
            "description": "Database identifier",
            "type": "string",
            "nullable": true
          },
          "deleted": {
            "description": "Deletion timestamp",
            "type": "string",
            "nullable": true
          },
          "folder": {
            "description": "Folder ID containing the form",
            "type": "integer",
            "nullable": true
          },
          "numColumns": {
            "description": "Number of columns in the form layout",
            "type": "integer",
            "nullable": false
          },
          "progressMeter": {
            "description": "Whether the form has a progress meter",
            "type": "boolean",
            "nullable": false
          },
          "submissions": {
            "description": "Total number of submissions",
            "type": "integer",
            "nullable": false
          },
          "submissionsUnread": {
            "description": "Number of unread submissions",
            "type": "integer",
            "nullable": false
          },
          "viewkey": {
            "description": "Unique key used to view the form publicly without authentication",
            "type": "string",
            "nullable": true
          },
          "views": {
            "description": "Number of form views",
            "type": "integer",
            "nullable": false
          },
          "version": {
            "description": "Form version number",
            "type": "integer",
            "nullable": false
          },
          "language": {
            "description": "Form language",
            "type": "string",
            "nullable": false
          },
          "submissionsToday": {
            "description": "Number of submissions today",
            "type": "integer",
            "nullable": false
          },
          "lastSubmissionId": {
            "description": "ID of the last submission",
            "type": "integer",
            "nullable": true
          },
          "lastSubmissionTime": {
            "description": "Timestamp of the last submission",
            "type": "string",
            "nullable": true
          },
          "url": {
            "description": "URL to view the form",
            "type": "string",
            "nullable": false
          },
          "encrypted": {
            "description": "Whether the form data is encrypted for additional security",
            "type": "boolean",
            "nullable": false
          },
          "thumbnailUrl": {
            "description": "URL to form thumbnail",
            "type": "string",
            "nullable": true
          },
          "submitButtonTitle": {
            "description": "Title of the submit button",
            "type": "string",
            "nullable": true
          },
          "inactive": {
            "description": "Whether the form is inactive",
            "type": "boolean",
            "nullable": false
          },
          "timezone": {
            "description": "Form timezone",
            "type": "string",
            "nullable": true
          },
          "shouldDisplayOneQuestionAtATime": {
            "description": "Whether to display one question at a time",
            "type": "boolean",
            "nullable": false
          },
          "canAccess1qFeature": {
            "description": "Whether the user has access to the one-question-at-a-time display feature",
            "type": "boolean",
            "nullable": false
          },
          "isWorkflowForm": {
            "description": "Whether this is a workflow form",
            "type": "boolean",
            "nullable": false
          },
          "isWorkflowPublished": {
            "description": "Whether the workflow is published",
            "type": "boolean",
            "nullable": false
          },
          "hasApprovers": {
            "description": "Whether the form has approvers",
            "type": "boolean",
            "nullable": false
          },
          "editUrl": {
            "description": "URL to edit the form",
            "type": "string",
            "nullable": false
          },
          "dataUrl": {
            "description": "URL to view form data",
            "type": "string",
            "nullable": false
          },
          "summaryUrl": {
            "description": "URL to view form summary",
            "type": "string",
            "nullable": false
          },
          "permissions": {
            "description": "Numeric representation of the user's permission level for this form (higher numbers indicate greater permissions)",
            "type": "integer",
            "nullable": false
          },
          "canEdit": {
            "description": "Whether the user can edit this form",
            "type": "boolean",
            "nullable": false
          }
        },
        "type": "object"
      },
