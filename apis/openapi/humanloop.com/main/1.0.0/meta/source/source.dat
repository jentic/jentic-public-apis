        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/type_:EvaluationRunsResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/type_:HttpValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "evaluations_createRun",
        "summary": "Create Run",
        "description": "Create an Evaluation Run.\n\nOptionally specify the Dataset and version to be evaluated.\n\nHumanloop will automatically start generating Logs and running Evaluators where\n`orchestrated=true`. If you are generating Logs yourself, you can set `orchestrated=false`\nand then generate and submit the required Logs via the API.\n\nIf `dataset` and `version` are provided, you can set `use_existing_logs=True` to reuse existing Logs,\navoiding generating new Logs unnecessarily. Logs that are associated with the specified Version and have `source_datapoint_id`\nreferencing a datapoint in the specified Dataset will be associated with the Run.\n\nTo keep updated on the progress of the Run, you can poll the Run using\nthe `GET /evaluations/{id}/runs` endpoint and check its status.",
        "tags": [
          "Evaluations"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Unique identifier for Evaluation.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-API-KEY",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/type_:EvaluationRunResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/type_:HttpValidationError"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "dataset": {
                    "$ref": "#/components/schemas/type_evaluations:CreateRunRequestDataset",
                    "description": "Dataset to use in this Run."
                  },
                  "version": {
                    "$ref": "#/components/schemas/type_evaluations:CreateRunRequestVersion",
                    "description": "Version to use in this Run."
                  },
                  "orchestrated": {
                    "type": "boolean",
                    "default": true,
                    "description": "Whether the Run is orchestrated by Humanloop. If `True`, Humanloop will generate Logs for the Run; `dataset` and `version` must be provided. If `False`, a log for the Prompt/Tool should be submitted by the user via the API."
                  },
                  "use_existing_logs": {
                    "type": "boolean",
                    "default": false,
                    "description": "If `True`, the Run will be initialized with existing Logs associated with the Dataset and Version. If `False`, the Run will be initialized with no Logs. Can only be set to `True` when both `dataset` and `version` are provided."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/evaluations/{id}/runs/{run_id}": {
      "post": {
        "operationId": "evaluations_addExistingRun",
        "summary": "Add Existing Run",
        "description": "Add an existing Run to the specified Evaluation.\n\nThis is useful if you want to compare the Runs in this Evaluation with an existing Run\nthat exists within another Evaluation.",
