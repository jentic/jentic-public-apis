      "post": {
        "operationId": "evaluations_create",
        "summary": "Create Evaluation",
        "description": "Create an Evaluation.\n\nCreate a new Evaluation by specifying the File to evaluate, and a name\nfor the Evaluation.\nYou can then add Runs to this Evaluation using the `POST /evaluations/{id}/runs` endpoint.",
