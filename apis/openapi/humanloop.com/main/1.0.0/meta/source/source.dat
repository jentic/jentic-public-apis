      "post": {
        "operationId": "prompts_deserialize",
        "summary": "Deserialize",
        "description": "Deserialize a Prompt from the .prompt file format.\n\nThis returns a subset of the attributes required by a Prompt.\nThis subset is the bit that defines the Prompt version (e.g. with `model` and `temperature` etc)",
