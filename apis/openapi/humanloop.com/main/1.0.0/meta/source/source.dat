    "/agents/deserialize": {
      "post": {
        "operationId": "agents_deserialize",
        "summary": "Deserialize",
        "description": "Deserialize an Agent from the .agent file format.\n\nThis returns a subset of the attributes required by an Agent.\nThis subset is the bit that defines the Agent version (e.g. with `model` and `temperature` etc)",
        "tags": [
          "agents"
        ],
        "parameters": [
          {
