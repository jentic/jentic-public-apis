      "delete": {
        "operationId": "evaluations_removeRun",
        "summary": "Remove Run",
        "description": "Remove a Run from an Evaluation.\n\nThe Logs and Versions used in the Run will not be deleted.\nIf this Run is used in any other Evaluations, it will still be available in those Evaluations.",
        "tags": [
          "Evaluations"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Unique identifier for Evaluation.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "run_id",
            "in": "path",
            "description": "Unique identifier for Run.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-API-KEY",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/type_:HttpValidationError"
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "evaluations_updateEvaluationRun",
        "summary": "Update Evaluation Run",
        "description": "Update an Evaluation Run.\n\nSpecify `control=true` to use this Run as the control Run for the Evaluation.\nYou can cancel a running/pending Run, or mark a Run that uses external or human Evaluators as completed.",
        "tags": [
          "Evaluations"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Unique identifier for Evaluation.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "run_id",
            "in": "path",
            "description": "Unique identifier for Run.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-API-KEY",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/type_:EvaluationRunResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/type_:HttpValidationError"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "control": {
                    "type": "boolean",
                    "description": "If `True`, this Run will be used as the control in the Evaluation. Stats for other Runs will be compared to this Run. This will replace any existing control Run."
                  },
                  "status": {
                    "$ref": "#/components/schemas/type_:EvaluationStatus",
                    "description": "Used to set the Run to `cancelled` or `completed`. Can only be used if the Run is currently `pending` or `running`."
                  }
                }
              }
            }
          }
        }
      }
    },
