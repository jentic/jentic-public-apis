{
  "openapi": "3.0.3",
  "info": {
    "title": "Wompi Payments API",
    "description": "Colombian payment platform API by Wompi (Bancolombia). Supports card payments, Nequi, PSE, Bancolombia transfers, DaviPlata, and more. Provides tokenization, transaction creation, payment source management, and financial institution lookups.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://docs.wompi.co/en/docs/colombia/metodos-de-pago/"
  },
  "servers": [
    {
      "url": "https://production.wompi.co/v1",
      "description": "Production server"
    },
    {
      "url": "https://sandbox.wompi.co/v1",
      "description": "Sandbox server"
    }
  ],
  "paths": {
    "/tokens/cards": {
      "post": {
        "operationId": "tokenizeCard",
        "summary": "Tokenize a credit or debit card",
        "description": "Create a token representing a credit or debit card for use in transactions. The token replaces sensitive card data.",
        "tags": ["Tokenization"],
        "security": [
          {
            "publicKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CardTokenRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Card tokenized successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CardTokenResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid card data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid public key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/tokens/nequi": {
      "post": {
        "operationId": "tokenizeNequiAccount",
        "summary": "Create a Nequi account token",
        "description": "Create a token for a Nequi mobile wallet account. The token status begins as PENDING until the user approves the subscription in their Nequi app.",
        "tags": ["Tokenization"],
        "security": [
          {
            "publicKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NequiTokenRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Nequi token created (status PENDING)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NequiTokenResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid phone number",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid public key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/tokens/nequi/{nequi_token}": {
      "get": {
        "operationId": "getNequiTokenStatus",
        "summary": "Get Nequi token status",
        "description": "Check the approval status of a Nequi token subscription.",
        "tags": ["Tokenization"],
        "security": [
          {
            "publicKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "nequi_token",
            "in": "path",
            "required": true,
            "description": "Nequi token identifier",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Token status retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NequiTokenResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/tokens/bancolombia_transfer": {
      "post": {
        "operationId": "tokenizeBancolombiaAccount",
        "summary": "Create a Bancolombia transfer token",
        "description": "Create a token for Bancolombia transfer subscriptions. Returns an authorization URL if user approval is needed.",
        "tags": ["Tokenization"],
        "security": [
          {
            "publicKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BancolombiaTokenRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bancolombia token created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BancolombiaTokenResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/transactions": {
      "post": {
        "operationId": "createTransaction",
        "summary": "Create a payment transaction",
        "description": "Create a new payment transaction using a tokenized payment method. Supports cards, Nequi, PSE, Bancolombia transfers, and DaviPlata. An acceptance token is mandatory.",
        "tags": ["Transaction"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTransactionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Transaction created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid transaction request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid authentication",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/transactions/{transaction_id}": {
      "get": {
        "operationId": "getTransactionStatus",
        "summary": "Get transaction status",
        "description": "Retrieve the current status and details of a transaction. Use long polling to check until the transaction reaches a final state (APPROVED, DECLINED, VOIDED, or ERROR).",
        "tags": ["Transaction"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "transaction_id",
            "in": "path",
            "required": true,
            "description": "Unique transaction identifier",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Transaction details retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid transaction ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid authentication",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/pse/financial_institutions": {
      "get": {
        "operationId": "listPseFinancialInstitutions",
        "summary": "List PSE financial institutions",
        "description": "Retrieve the list of financial institutions available for PSE (bank transfer) payments in Colombia.",
        "tags": ["PSE"],
        "security": [
          {
            "publicKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Financial institutions list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FinancialInstitutionsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid public key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/payment_sources": {
      "post": {
        "operationId": "createPaymentSource",
        "summary": "Create a payment source",
        "description": "Create a reusable payment source from a token. Payment sources enable recurring or saved payment methods for a customer.",
        "tags": ["Payment Source"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePaymentSourceRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Payment source created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentSourceResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid authentication",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/payment_sources/{id}/void": {
      "put": {
        "operationId": "voidPaymentSource",
        "summary": "Void a payment source",
        "description": "Cancel a payment source subscription, changing its status to VOIDED. The source can no longer be used for transactions.",
        "tags": ["Payment Source"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Payment source identifier",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Payment source voided",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentSourceResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or source already voided",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid authentication",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Private API key used as Bearer token for server-side operations"
      },
      "publicKeyAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Public API key used as Bearer token for client-side tokenization"
      }
    },
    "schemas": {
      "CardTokenRequest": {
        "type": "object",
        "required": ["number", "cvc", "exp_month", "exp_year", "card_holder"],
        "properties": {
          "number": {
            "type": "string",
            "description": "Card number (13-19 digits)",
            "minLength": 13,
            "maxLength": 19
          },
          "cvc": {
            "type": "string",
            "description": "Card verification code (3-4 digits)",
            "minLength": 3,
            "maxLength": 4
          },
          "exp_month": {
            "type": "string",
            "description": "Expiration month (2 digits, e.g., 06)",
            "pattern": "^\\d{2}$"
          },
          "exp_year": {
            "type": "string",
            "description": "Expiration year (2 digits, e.g., 29)",
            "pattern": "^\\d{2}$"
          },
          "card_holder": {
            "type": "string",
            "description": "Cardholder full name"
          }
        }
      },
      "CardTokenResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "Token identifier"
              },
              "status": {
                "type": "string",
                "description": "Token status",
                "enum": ["CREATED"]
              },
              "brand": {
                "type": "string",
                "description": "Card brand (e.g., VISA, MASTERCARD)"
              },
              "name": {
                "type": "string",
                "description": "Cardholder name"
              },
              "last_four": {
                "type": "string",
                "description": "Last four digits of the card"
              },
              "bin": {
                "type": "string",
                "description": "Bank Identification Number (first 6 digits)"
              },
              "expires_at": {
                "type": "string",
                "format": "date-time",
                "description": "Token expiration timestamp"
              }
            }
          }
        }
      },
      "NequiTokenRequest": {
        "type": "object",
        "required": ["phone_number"],
        "properties": {
          "phone_number": {
            "type": "string",
            "description": "Nequi account phone number",
            "pattern": "^3\\d{9}$"
          }
        }
      },
      "NequiTokenResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "Token identifier"
              },
              "status": {
                "type": "string",
                "description": "Token status",
                "enum": ["PENDING", "APPROVED", "DECLINED"]
              },
              "phone_number": {
                "type": "string",
                "description": "Associated phone number"
              }
            }
          }
        }
      },
      "BancolombiaTokenRequest": {
        "type": "object",
        "required": ["redirect_url"],
        "properties": {
          "redirect_url": {
            "type": "string",
            "format": "uri",
            "description": "URL to redirect after authorization"
          },
          "authentication_type": {
            "type": "string",
            "description": "Authentication flow type",
            "enum": ["TOKEN", "TRANSACTION"]
          }
        }
      },
      "BancolombiaTokenResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "Token identifier"
              },
              "status": {
                "type": "string",
                "description": "Token status",
                "enum": ["PENDING", "APPROVED"]
              },
              "authorization_url": {
                "type": "string",
                "format": "uri",
                "description": "URL to redirect user for authorization"
              }
            }
          }
        }
      },
      "CreateTransactionRequest": {
        "type": "object",
        "required": ["amount_in_cents", "currency", "reference", "payment_method", "acceptance_token"],
        "properties": {
          "amount_in_cents": {
            "type": "integer",
            "description": "Transaction amount in cents (e.g., 1500000 for 15,000 COP)",
            "format": "int64"
          },
          "currency": {
            "type": "string",
            "description": "Currency code",
            "enum": ["COP"],
            "example": "COP"
          },
          "reference": {
            "type": "string",
            "description": "Unique merchant reference for the transaction"
          },
          "customer_email": {
            "type": "string",
            "format": "email",
            "description": "Customer email address"
          },
          "payment_method": {
            "type": "object",
            "description": "Payment method details (varies by type)",
            "properties": {
              "type": {
                "type": "string",
                "description": "Payment method type",
                "enum": ["CARD", "NEQUI", "PSE", "BANCOLOMBIA_TRANSFER", "DAVIPLATA"]
              },
              "token": {
                "type": "string",
                "description": "Payment token (for CARD type)"
              },
              "installments": {
                "type": "integer",
                "description": "Number of installments (for CARD type)"
              },
              "phone_number": {
                "type": "string",
                "description": "Phone number (for NEQUI type)"
              },
              "user_type": {
                "type": "integer",
                "description": "PSE user type (0=natural person, 1=legal entity)",
                "enum": [0, 1]
              },
              "user_legal_id_type": {
                "type": "string",
                "description": "PSE legal ID type (e.g., CC, NIT)"
              },
              "user_legal_id": {
                "type": "string",
                "description": "PSE legal ID number"
              },
              "financial_institution_code": {
                "type": "string",
                "description": "PSE financial institution code"
              },
              "payment_description": {
                "type": "string",
                "description": "PSE payment description"
              },
              "sandbox_status": {
                "type": "string",
                "description": "Sandbox testing status override",
                "enum": ["APPROVED", "DECLINED", "VOIDED", "ERROR"]
              }
            }
          },
          "payment_source_id": {
            "type": "integer",
            "description": "Saved payment source ID (alternative to payment_method)"
          },
          "acceptance_token": {
            "type": "string",
            "description": "Mandatory acceptance token for terms and conditions"
          },
          "recurrent": {
            "type": "boolean",
            "description": "Whether this is a recurring card-on-file transaction"
          },
          "signature": {
            "type": "string",
            "description": "SHA256 integrity signature"
          },
          "redirect_url": {
            "type": "string",
            "format": "uri",
            "description": "URL to redirect after PSE or Bancolombia payment"
          }
        }
      },
      "TransactionResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "Transaction identifier"
              },
              "status": {
                "type": "string",
                "description": "Transaction status",
                "enum": ["PENDING", "APPROVED", "DECLINED", "VOIDED", "ERROR"]
              },
              "amount_in_cents": {
                "type": "integer",
                "description": "Transaction amount in cents"
              },
              "currency": {
                "type": "string",
                "description": "Currency code"
              },
              "reference": {
                "type": "string",
                "description": "Merchant reference"
              },
              "payment_method_type": {
                "type": "string",
                "description": "Payment method type used"
              },
              "payment_method": {
                "type": "object",
                "description": "Payment method details",
                "properties": {
                  "type": {
                    "type": "string"
                  },
                  "extra": {
                    "type": "object",
                    "description": "Additional payment method details"
                  }
                }
              },
              "redirect_url": {
                "type": "string",
                "format": "uri",
                "description": "Redirect URL for PSE/Bancolombia payments"
              },
              "created_at": {
                "type": "string",
                "format": "date-time",
                "description": "Transaction creation timestamp"
              },
              "finalized_at": {
                "type": "string",
                "format": "date-time",
                "description": "Transaction finalization timestamp"
              }
            }
          }
        }
      },
      "FinancialInstitutionsResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "financial_institution_code": {
                  "type": "string",
                  "description": "Institution code for PSE transactions"
                },
                "financial_institution_name": {
                  "type": "string",
                  "description": "Institution display name"
                }
              }
            }
          }
        }
      },
      "CreatePaymentSourceRequest": {
        "type": "object",
        "required": ["type", "token", "customer_email", "acceptance_token"],
        "properties": {
          "type": {
            "type": "string",
            "description": "Payment source type",
            "enum": ["CARD", "NEQUI", "BANCOLOMBIA_TRANSFER", "DAVIPLATA"]
          },
          "token": {
            "type": "string",
            "description": "Token identifier from tokenization step"
          },
          "customer_email": {
            "type": "string",
            "format": "email",
            "description": "Customer email for the payment source"
          },
          "acceptance_token": {
            "type": "string",
            "description": "Terms acceptance token"
          }
        }
      },
      "PaymentSourceResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "description": "Payment source identifier"
              },
              "type": {
                "type": "string",
                "description": "Payment source type"
              },
              "status": {
                "type": "string",
                "description": "Payment source status",
                "enum": ["AVAILABLE", "VOIDED"]
              },
              "token": {
                "type": "string",
                "description": "Associated token"
              },
              "customer_email": {
                "type": "string",
                "description": "Customer email"
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "description": "Error type"
              },
              "reason": {
                "type": "string",
                "description": "Error reason"
              },
              "messages": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Detailed error messages"
              }
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Tokenization",
      "description": "Payment method tokenization (cards, Nequi, Bancolombia)"
    },
    {
      "name": "Transaction",
      "description": "Transaction creation and status queries"
    },
    {
      "name": "PSE",
      "description": "PSE bank transfer utilities"
    },
    {
      "name": "Payment Source",
      "description": "Saved payment source management"
    }
  ]
}