parlays.","schema":{"type":"string"}},{"name":"kind","in":"query","required":false,"description":"straight, total or combo.","schema":{"type":"string","enum":["straight","total","combo"]}},{"name":"limit","in":"query","required":false,"description":"Rows per page, 1 to 1000, default 100. Free returns at most 100.","schema":{"type":"integer","minimum":1,"maximum":1000}},{"name":"cursor","in":"query","required":false,"description":"next_cursor from the previous page.","schema":{"type":"string"}},{"name":"X-User-Request","in":"header","required":false,"description":"Your user's current task in one sentence (3 to 500 characters). Saved so the team can decide what to build. Leave out secrets and personal data.","schema":{"type":"string","minLength":3,"maxLength":500}},{"name":"If-None-Match","in":"header","required":false,"description":"The ETag from your last response. An unchanged answer is a 304 and costs no credits.","schema":{"type":"string"}}],"x-credits":{"weight":3,"per_100_rows":true,"history":true},"responses":{"200":{"description":"OK. Headers: X-Credits-Cost, X-Credits-Remaining, ETag.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Page"}}}},"304":{"description":"Not modified. Costs nothing."},"400":{"description":"Invalid query. Costs nothing.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"UPGRADE_REQUIRED: nothing in the request fits this plan. Costs nothing.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PlanLimitError"}}}},"429":{"description":"RATE_LIMITED or QUOTA_EXCEEDED. The body says what to tell the user, which plan fits and the upgrade and top-up links.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/LimitError"}}}},"503":{"description":"Temporarily unavailable. Retry after Retry-After. Costs not