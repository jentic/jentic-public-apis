m":1,"maximum":1000}},{"name":"cursor","in":"query","required":false,"description":"next_cursor from the previous page.","schema":{"type":"string"}},{"name":"X-User-Request","in":"header","required":false,"description":"Your user's current task in one sentence (3 to 500 characters). Saved so the team can decide what to build. Leave out secrets and personal data.","schema":{"type":"string","minLength":3,"maxLength":500}},{"name":"If-None-Match","in":"header","required":false,"description":"The ETag from your last response. An unchanged answer is a 304 and costs no credits.","schema":{"type":"string"}}],"x-credits":{"weight":3,"per_100_rows":true,"history":true},"responses":{"200":{"description":"OK. Headers: X-Credits-Cost, X-Credits-Remaining, ETag.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Page"}}}},"304":{"description":"Not modified. Costs nothing."},"400":{"description":"Invalid query. Costs nothing.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"UPGRADE_REQUIRED: nothing in the request fits this plan. Costs nothing.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PlanLimitError"}}}},"429":{"description":"RATE_LIMITED or QUOTA_EXCEEDED. The body says what to tell the user, which plan fits and the upgrade and top-up links.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/LimitError"}}}},"503":{"description":"Temporarily unavailable. Retry after Retry-After. Costs nothing.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/clv":{"get":{"operationId":"clv","summary":"Closing-line value","description":"Each outcome's opening and closing fair price before the start (kept permanently), the move between them and the result once graded. Send market_id, player, league or date. Costs 5 credits per 100 rows requested (limit). Errors and 304 cost nothing.","parameters":[{"name":"market_id","in":"query","required":false,"description":"Novig market id.","schema":{"type":"string"}},{"name":"player","in":"query","required":false,"description":"Player slug.","schema":{"type":"string"}},{"name":"league","in":"query","required":false,"description":"League code, such as NBA, NFL or NHL.","schema":{"type":"string"}},{"name":"date","in":"query","required":false,"description":"YYYY-MM-DD: markets starting that US Eastern day.","schema":{"type":"string","format":"date"}},{"name":"settled","in":"query","required":false,"description":"true: only graded markets.","schema":{"type":"boolean"}},{"name":"since","in":"query","required":false,"description":"ISO 8601 time. Free reads only the last 7 days; paid plans back to 2026-08-03.","schema":{"type":"string","format":"date-time"}},{"name":"until","in":"query","required":false,"description":"ISO 8601 time: markets starting at or before it.","schema":{"type":"string","format":"date-time"}},{"name":"limit","in":"query","required":false,"description":"Rows per page, 1 to 1000, default 50. Free returns at most 100.","schema":{"type":"integer","minimum":1,"maximum":1000}},{"name":"cursor","in":"query","required":false,"description":"next_cursor from the previous page.","schema":{"type":"string"}},{"name":"X-User-Request","in":"header","required":false,"description":"Your user's current task in one sentence (3 to 500 characters). Saved so the team can decide what to build. Leave out secrets and personal data.","schema":{"type":"string","minLength":3,"maxLength":500}},{"name":"If-None-Match","in":"header","required":false,"description":"The ETag from your last response. An unchanged answer is a 304 and costs no credits.","schema":{"type":"string"}}],"x-credits":{"weight":5,"per_100_rows":true,"history":true},"responses":{"200":{"description":"OK. Headers: X-Credits-Cost, X-Credits-Remaining, ETag.","content":{"appl