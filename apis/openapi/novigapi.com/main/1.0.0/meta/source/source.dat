omponents/schemas/Page"}}}},"304":{"description":"Not modified. Costs nothing."},"400":{"description":"Invalid query. Costs nothing.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"UPGRADE_REQUIRED: nothing in the request fits this plan. Costs nothing.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PlanLimitError"}}}},"429":{"description":"RATE_LIMITED or QUOTA_EXCEEDED. The body says what to tell the user, which plan fits and the upgrade and top-up links.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/LimitError"}}}},"503":{"description":"Temporarily unavailable. Retry after Retry-After. Costs nothing.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/bulk/csv":{"get":{"operationId":"bulk_csv","summary":"Bulk CSV export","description":"CSV of trades, line moves, results or daily bars, up to 10,000 rows per call. Production and Scale plans. Costs 10 credits per 100 rows requested (limit). Errors and 304 cost nothing.","parameters":[{"name":"dataset","in":"query","required":false,"description":"trades, line_moves, results or ohlc.","schema":{"type":"string","enum":["trades","line_moves","results","ohlc"]}},{"name":"market_id","in":"query","required":false,"description":"Novig market id.","schema":{"type":"string"}},{"name":"league","in":"query","required":false,"description":"League code, such as NBA, NFL or NHL.","schema":{"type":"string"}},{"name":"since","in":"query","required":false,"description":"ISO 8601 time. Free reads only the last 7 days; paid plans back to 2026-08-03.","schema":{"type":"string","format":"date-time"}},{"name":"date","in":"query","required":false,"description":"YYYY-MM-DD, for dataset=ohlc.","schema":{"type":"string"}},{"name":"limit","in":"query","required":false,"description":"Rows per page, 1 to 10000, default 1000. Free returns at most 100.","schema":{"type":"integer","minimum":1,"maximum":10000}},{"name":"cursor","in":"query","required":false,"description":"next_cursor from the previous page.","schema":{"type":"string"}},{"name":"X-User-Request","in":"header","required":false,"description":"Your user's current task in one sentence (3 to 500 characters). Saved so the team can decide what to build. Leave out secrets and personal data.","schema":{"type":"string","minLength":3,"maxLength":500}},{"name":"If-None-Match","in":"header","required":false,"description":"The ETag from your last response. An unchanged answer is a 304 and costs no credits.","schema":{"type":"string"}}],"x-credits":{"weight":10,"per_100_rows":true,"history":true},"responses":{"200":{"description":"OK. Headers: X-Credits-Cost, X-Credits-Remaining, ETag.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Page"}}}},"304":{"description":"Not modified. Costs nothing."},"400":{"description":"Invalid query. Costs nothing.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"UPGRADE_REQUIRED: nothing in the request fits this plan. Costs nothing.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PlanLimitError"}}}},"429":{"description":"RATE_LIMITED or QUOTA_EXCEEDED. The body says what to tell the user, which plan fits and the upgrade and top-up links.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/LimitError"}}}},"503":{"description":"Temporarily unavailable. Retry after Retry-After. Costs nothing.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/webhooks":{"get":{"operationId":"list_webhooks","summary":"List webhook endpoints","description":"Costs nothing.","responses":{"200":{"description":"OK"},"401":{"description":"Missing or invalid key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}},"post":{"operationId":"create_webhook","summary":"Create a webhook endpoint","description":"Production and Scale. Up to 5 endpoints. The secret is returned once. Each delivery is a POST with X-Webhook-Id, X-Webhook-Event, X-Webhook-Timestamp and X-Webhook-Signature: t=<unix>,v1=<hex HMAC-SHA256 of \"<t>.<raw body>\">. Failed deliveries retry with backoff for about 8 hours. Costs nothing.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["url","events"],"properties":{"url":{"type":"string","format":"uri","description":"A public https URL."},"events":{"type":"array","items":{"type":"string","enum":["line_move","steam","market_open","settle","edge"]}},"filters":{"type":"object","properties":{"league":{"type":"string"},"event_id":{"type":"string"},"market_id":{"type":"string"},"player":{"type":"string"},"min_delta_pp":{"type":"number","description":"Smallest line_move to send, default 2."}}}}}}}},"responses":{"201":{"description":"Created; the body carries the secret once."},"403":{"description":"UPGRADE_REQUIRED: nothing in the request fits this plan. Costs nothing.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PlanLimitError"}}}},"409":{"description":"Endpoint limit reached."},"422":{"description":"Invalid URL, events or filters."}}}},"/api/v1/webhooks/{id}":{"delete":{"operationId":"delete_webhook","summary":"Delete a webhook endpoint","parameters":[{"name":"id","in":"path","required":true,"description":"Webhook id.","schema":{"type":"string"}}],"responses":{"204":{"description":"Deleted"},"404":{"description":"Not found"}}}},"/api/v1/free/markets":{"get":{"operationId":"free_markets","summary":"Free delayed markets (no key)","security":[],"description":"Free delayed data, no key: real Novig markets across every league with bid, ask, last price, the no-vig fair price (fair_price, and fair per outcome), American and decimal odds, volume, open interest and last_update. The free set is the 40 most traded upcoming markets of each league (games and props in the next 7 days), about 3 to 6 minutes behind live, so rows trail live prices by up to about 13 minutes (as_of and delay_seconds say by how much). At most 50 rows a call; answers are edge cached for 5 minutes; 10 calls a minute and 200 a day per network address. No credits. For live prices and every market, send a free key to /api/v1/markets.","parameters":[{"name":"league","in":"query","required":false,"description":"League code or slug, such as NBA, NFL or la-liga. Omit for all leagues.","schema":{"type":"string"}},{"name":"market_id","in":"query","required":false,"description":"One Novig market id (it must be in the free set).","schema":{"type":"string"}},{"name":"market_type","in":"query","required":false,"description":"Market type code, such as MONEY, SPREAD, TOTAL or POINTS.","schema":{"type":"string"}},{"name":"q","in":"query","required":false,"description":"Words to match in the market, event, player or team.","schema":{"type":"string"}},{"name":"limit","in":"query","required":false,"description":"Rows, 1 to 50, default 25.","schema":{"type":"integer","minimum":1,"maximum":50}}],"responses":{"200":{"description":"OK. Edge cached; no credits.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/FreeMarkets"}}}},"400":{"description":"Invalid parameter.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"FREE_RATE_LIMITED: wait Retry-After seconds, or use a free key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"503":{"description":"Temporarily unavailable. Retry after Retry-After. Costs nothing.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/agent/signup":{"get":{"operationId":"agent_signup_document","summary":"How an agent signs its user up","description":"Self-describing JSON for the device-code signup. No key needed.","security":[],"responses":{"200":{"description":"OK"}}},"post":{"operationId":"start_agent_signup","summary":"Start an agent signup","security":[],"description":"Send what your user wants and why. Returns device_code, user_code and approval_url (/connect?code=): show approval_url to your user, who approves in one click (free, no card), then poll /api/v1/agent/token every 5 seconds. Codes last 15 minutes. No key needed and no credits.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["data_wanted","use_case"],"properties":{"data_wanted":{"type":"string"},"use_case":{"type":"string"},"found_us":{"type":"string"},"agent_found_us":{"type":"string"},"details":{"type":"object"},"agent":{"type":"string"}}}}}},"responses":{"200":{"description":"device_code, user_code, approval_url, interval and expires_in."},"404":{"description":"Agent signup is closed."},"422":{"description":"Invalid body."},"429":{"description":"Too many signups started this hour."}}}},"/api/v1/agent/token":{"post":{"operationId":"collect_agent_key","summary":"Collect the key after approval","security":[],"description":"Poll with device_code every 5 seconds. AUTHORIZATION_PENDING until the person approves; the key is returned once.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["device_code"],"properties":{"device_code":{"type":"string","description":"nvd_... from the signup."}}}}}},"responses":{"200":{"description":"api_key, shown once."},"400":{"description":"Pending, expired or already collected."}}}},"/api/v1/webhooks/{id}/test":{"post":{"operationId":"test_webhook","summary":"Send a test delivery","parameters":[{"name":"id","in":"path","required":true,"description":"Webhook id.","schema":{"type":"string"}}],"responses":{"202":{"description":"Queued; delivered within about a minute."},"404":{"description":"Not found"}}}}},"components":{"schemas":{"Watchlist":{"type":"object","additionalProperties":false,"required":["name","targets"],"properties":{"name":{"type":"string","description":"What this watchlist tracks"},"league":{"type":"string","description":"League code such as NFL or NBA"},"targets":{"type":"string","description":"Player names"},"move_threshold":{"type":"number","description":"Minimum price move in percentage points before an alert fires"}}},"Honesty":{"type":"object","description":"Every answer says how old its data is.","properties":{"observed_at":{"type":["string","null"],"format":"date-time","description":"When the oldest row in this answer was observed at Novig's public edge."},"source_age_seconds":{"type":["integer","null"]},"edge_cached":{"type":["boolean","null"],"description":"Whether any row came from Novig's edge cache (5 s for books and trades, 10 s for markets)."}}},"Meta":{"allOf":[{"$ref":"#/components/schemas/Honesty"},{"type":"object","properties":{"plan":{"type":"string"},"credits_charged":{"type":"integer"},"credits_remaining":{"type":"integer"},"credit_policy":{"type":"string"},"next_cursor":{"type":["string","null"]},"limit":{"type":"integer"},"count":{"type":"integer"},"plan_limit":{"$ref":"#/components/schemas/PlanLimit"},"usage_notice":{"type":"object"}}}]},"Page":{"type":"object","properties":{"data":{"type":"array","items":{"type":"object","additionalProperties":true}},"meta":{"$ref":"#/components/schemas/Meta"}}},"One":{"type":"object","properties":{"data":{"type":"object","additionalProperties":true},"meta":{"$ref":"#/components/schemas/Meta"}}},"FreeMarkets":{"type":"object","description":"The keyless free delayed tier.","properties":{"free_tier":{"const":true},"delayed":{"const":true},"as_of":{"type":["string","null"],"format":"date-time","description":"When the oldest row returned was last read from Novig."},"delay_seconds":{"type":["integer","null"]},"delayed_up_to_seconds":{"type":"integer"},"note":{"type":"string"},"count":{"type":"integer"},"total_matching":{"type":"integer"},"filters":{"type":"object"},"data":{"type":"array","items":{"type":"object","properties":{"market_id":{"type":"string"},"league":{"type":"string"},"description":{"type":"string"},"market_type":{"type":["string","null"]},"strike":{"type":["number","null"]},"starts_at":{"type":["string","null"],"format":"date-time"},"event":{"type":["string","null"]},"player":{"type":["string","null"]},"team":{"type":["string","null"]},"stat":{"type":["string","null"]},"status":{"type":["string","null"]},"volume":{"type":"number"},"open_interest":{"type":"number"},"fair_price":{"type":["number","null"],"description":"No-vig fair probability of the first outcome, from 0 to 1."},"outcomes":{"type":"array","items":{"type":"object","properties":{"name":{"type":"string"},"bid":{"type":["number","null"]},"ask":{"type":["number","null"]},"last":{"type":["number","null"]},"fair":{"type":["number","null"]},"american":{"type":["integer","null"]},"decimal":{"type":["number","null"]}}}},"last_update":{"type":"string","format":"date-time"},"url":{"type":["string","null"]}}}},"leagues":{"type":"array","items":{"type":"object","properties":{"code":{"type":"string"},"slug":{"type":"string"},"name":{"type":"string"},"markets":{"type":"integer"},"as_of":{"type":"string"}}}},"limits":{"type":"object"},"get_a_key":{"type":"object"},"docs":{"type":"string"},"openapi":{"type":"string"},"mcp":{"type":"string"}}},"Error":{"type":"object","properties":{"error":{"type":"object","properties":{"code":{"type":"string"},"message":{"type":"string"}},"required":["code","message"]}}},"PlanLimit":{"type":"object","properties":{"plan":{"type":"string"},"feature":{"type":"string"},"limit":{"type":"string"},"unlocks":{"type":"string"},"required_plan":{"type":"string"},"price_usd_per_month":{"type":"number"},"upgrade_url":{"type":"string"},"message":{"type":"string"}}},"PlanLimitError":{"type":"object","properties":{"error":{"allOf":[{"$ref":"#/components/schemas/PlanLimit"},{"type":"object","properties":{"code":{"const":"UPGRADE_REQUIRED"}}}]}}},"LimitError":{"type":"object","properties":{"error":{"type":"object","properties":{"code":{"type":"string","enum":["RATE_LIMITED","QUOTA_EXCEEDED"]},"message":{"type":"string"},"agent_next_step":{"type":"string"},"notify_user":{"type":"boolean"},"user_message":{"type":"string","description":"Show this to your user once, word for word."},"relay_id":{"type":"string"},"retry_policy":{"type":"string"},"retryable":{"type":"boolean"},"retry_after_seconds":{"type":"integer"},"repeated_query":{"type":"string"},"usage_unit":{"type":"string"},"credit_policy":{"type":"string"},"plan":{"type":"string"},"monthly_limit":{"type":"integer"},"minute_limit":{"type":"integer"},"remaining":{"type":"integer"},"required":{"type":"integer"},"reset_at":{"type":"string"},"upgrade_url":{"type":["string","null"]},"upgrade_options":{"type":"array","items":{"type":"object"}},"recommended_plan":{"type":["string","null"]},"value":{"type":"array","items":{"type":"string"}},"projected_monthly_credits":{"type":"integer"},"usage":{"type":"object","properties":{"since":{"type":["string","null"]},"used":{"type":"integer"},"unit":{"type":"string"},"blocked_calls":{"type":"integer"},"top_paths":{"type":"array","items":{"type":"object","properties":{"path":{"type":"string"},"calls":{"type":"integer"},"credits":{"type":"integer"}}}}}},"topup_url":{"type":"string","description":"Present while the credit top-up is on sale."},"topup":{"type":"object"},"feedback":{"type":"object"}}}}}},"securitySchemes":{"bearer":{"type":"http","scheme":"bearer"}}}}