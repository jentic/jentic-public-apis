{"openapi":"3.1.0","info":{"title":"Novig API API","version":"1.0.0","description":"Read-only Novig exchange data with names resolved, intraday line history, fair no-vig prices and line-move alerts, over REST, MCP and a live stream. No Novig account, no ID check, no request signing. Credits: 1 per 100 rows requested, times the endpoint weight; errors and 304 cost nothing. Stream: wss://stream.novigapi.com/v1/stream, 2 credits per 285 seconds connected. Independent. Not affiliated with, endorsed by or sponsored by Novig."},"servers":[{"url":"https://novigapi.com"}],"security":[{"bearer":[]}],"paths":{"/api/v1/watchlists":{"get":{"operationId":"listWatchlists","summary":"List Watchlists","description":"A saved set of players, teams or markets you want line-move alerts on.","parameters":[{"name":"limit","in":"query","schema":{"type":"integer","maximum":200}},{"name":"offset","in":"query","schema":{"type":"integer"}}],"responses":{"200":{"description":"OK"},"401":{"description":"Invalid key"},"429":{"description":"Rate or quota limit"}}},"post":{"operationId":"createWatchlist","summary":"Create a Watchlist","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Watchlist"}}}},"responses":{"201":{"description":"Created"},"402":{"description":"Record limit"},"422":{"description":"Invalid"}}}},"/api/v1/watchlists/{id}":{"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"get":{"operationId":"getWatchlist","summary":"Read a Watchlist","responses":{"200":{"description":"OK"},"404":{"description":"Not found"}}},"patch":{"operationId":"updateWatchlist","summary":"Update a Watchlist","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Watchlist"}}}},"responses":{"200":{"description":"OK"},"404":{"description":"Not found"}}},"delete":{"operationId":"deleteWatchlist","summary":"Delete a Watchlist","responses":{"204":{"description":"Deleted"},"404":{"description":"Not found"}}}},"/api/v1/onboarding":{"get":{"operationId":"getOnboardingQuestions","summary":"Onboarding questions","description":"The questions that finish setting up an account. No key needed; with a key the reply also carries the current answers. Costs no quota.","security":[],"responses":{"200":{"description":"OK"}}},"post":{"operationId":"answerOnboarding","summary":"Answer onboarding for your user","description":"Stores the answers exactly as the onboarding form does, marked as answered by an agent. Idempotent. Costs no quota.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["answers"],"properties":{"answers":{"type":"object","properties":{"data_wanted":{"type":"string","description":"What Novig data are you looking for?"},"use_case":{"type":"string","description":"What do you want to do with it?"},"found_us":{"type":"string","description":"How did you find us?"},"notes":{"type":"string","description":"Anything else we should know?"}},"required":["data_wanted","use_case"]},"client":{"type":"string","description":"Your name, such as Claude Code."}}}}}},"responses":{"200":{"description":"Saved"},"401":{"description":"Invalid key"},"422":{"description":"Invalid answers"},"429":{"description":"Too many answers this minute"}}}},"/api/v1/billing/cancel":{"get":{"operationId":"getSubscription","summary":"Subscription status and cancel reasons","description":"The account's subscription and the reasons a cancellation accepts. Costs no quota.","responses":{"200":{"description":"OK"},"401":{"description":"Invalid key"}}},"post":{"operationId":"cancelSubscription","summary":"Cancel the subscription at the end of the paid period","description":"Only when your user asks. A reason is required: ask your user why and never pick one for them. Costs no quota.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["reason"],"properties":{"reason":{"type":"string","enum":["got_what_i_needed","too_expensive","missing_data","reliability","not_using","switched","other"],"description":"got_what_i_needed: I got the data I needed; too_expensive: Too expensive; missing_data: Missing data or features I need; reliability: Errors or slow responses; not_using: Not using it enough; switched: Switched to another service; other: Something else"},"comment":{"type":"string","maxLength":500,"description":"Your user's own words. Required when reason is other."}}}}}},"responses":{"200":{"description":"Scheduled to cancel at period end"},"400":{"description":"CANCEL_REASON_REQUIRED: the reply lists the valid reasons"},"401":{"description":"Invalid key"},"404":{"description":"No active subscription"},"503":{"description":"Billing unavailable, nothing changed"}}},"delete":{"operationId":"keepSubscription","summary":"Keep the subscription (undo a scheduled cancel)","description":"Costs no quota.","responses":{"200":{"description":"Kept"},"401":{"description":"Invalid key"},"404":{"description":"No subscription"}}}},"/api/v1/markets":{"get":{"operationId":"markets","summary":"List markets","description":"Every Novig market with best bid, implied ask (1 minus the other side's best bid), last price, volume and open interest. Prices are probabilities from 0 to 1. Costs 1 credit per 100 rows requested (limit). Errors and 304 cost nothing.","parameters":[{"name":"league","in":"query","required":false,"description":"League code, such as NBA, NFL or NHL.","schema":{"type":"string"}},{"name":"event_id","in":"query","required":false,"description":"Novig event id.","schema":{"type":"string"}},{"name":"market_type","in":"query","required":false,"description":"Market type code.","schema":{"type":"string"}},{"name":"player","in":"query","required":false,"description":"Player slug, such as lebron-james.","schema":{"type":"string"}},{"name":"team","in":"query","required":false,"description":"Team slug.","schema":{"type":"string"}},{"name":"status","in":"query","required":false,"description":"Market status.","schema":{"type":"string","enum":["open","closed","settled","suspended","all"]}},{"name":"limit","in":"query","required":false,"description":"Rows per page, 1 to 1000, default 50. Free returns at most 100.","schema":{"type":"integer","minimum":1,"maximum":1000}},{"name":"cursor","in":"query","required":false,"description":"next_cursor from the previous page.","schema":{"type":"string"}},{"name":"X-User-Request","in":"header","required":false,"description":"Your user's current task in one sentence (3 to 500 characters). Saved so the team can decide what to build. Leave out secrets and personal data.","schema":{"type":"string","minLength":3,"maxLength":500}},{"name":"If-None-Match","in":"header","required":false,"description":"The ETag from your last response. An unchanged answer is a 304 and costs no credits.","schema":{"type":"string"}}],"x-credits":{"weight":1,"per_100_rows":true,"history":false},"responses":{"200":{"description":"OK. Headers: X-Credits-Cost, X-Credits-Remaining, ETag.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Page"}}}},"304":{"description":"Not modified. Costs nothing."},"400":{"description":"Invalid query. Costs nothing.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"UPGRADE_REQUIRED: nothing in the request fits this plan. Costs nothing.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PlanLimitError"}}}},"429":{"description":"RATE_LIMITED or QUOTA_EXCEEDED. The body says what to tell the user, which plan fits and the upgrade and top-up links.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/LimitError"}}}},"503":{"description":"Temporarily unavailable. Retry after Retry-After. Costs nothing.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/markets/{id}":{"get":{"operationId":"market","summary":"One market","description":"One market with its outcomes and current prices. Costs 1 credit. Errors and 304 cost nothing.","parameters":[{"name":"id","in":"path","required":true,"description":"Novig market id.","schema":{"type":"string"}},{"name":"X-User-Request","in":"header","required":false,"description":"Your user's current task in one sentence (3 to 500 characters). Saved so the team can decide what to build. Leave out secrets and personal data.","schema":{"type":"string","minLength":3,"maxLength":500}},{"name":"If-None-Match","in":"header","required":false,"description":"The ETag from your last response. An unchanged answer is a 304 and costs no credits.","schema":{"type":"string"}}],"x-credits":{"weight":1,"per_100_rows":false,"history":false},"responses":{"200":{"description":"OK. Headers: X-Credits-Cost, X-Credits-Remaining, ETag.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/One"}}}},"304":{"description":"Not modified. Costs nothing."},"400":{"description":"Invalid query. Costs nothing.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"UPGRADE_REQUIRED: nothing in the request fits this plan. Costs nothing.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PlanLimitError"}}}},"404":{"description":"Not found. Costs nothing.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"RATE_LIMITED or QUOTA_EXCEEDED. The body says what to tell the user, which plan fits and the upgrade and top-up links.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/LimitError"}}}},"503":{"description":"Temporarily unavailable. Retry after Retry-After. Costs nothing.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/events":{"get":{"operationId":"events","summary":"List events","description":"Novig events (games and fixtures) with league, teams, status and start time. Costs 1 credit per 100 rows requested (limit). Errors and 304 cost nothing.","parameters":[{"name":"league","in":"query","required":false,"description":"League code, such as NBA, NFL or NHL.","schema":{"type":"string"}},{"name":"status","in":"query","required":false,"description":"Event status.","schema":{"type":"string"}},{"name":"limit","in":"query","required":false,"description":"Rows per page, 1 to 1000, default 50. Free returns at most 100.","schema":{"type":"integer","minimum":1,"maximum":1000}},{"name":"cursor","in":"query","required":false,"description":"next_cursor from the previous page.","schema":{"type":"string"}},{"name":"X-User-Request","in":"header","required":false,"description":"Your user's current task in one sentence (3 to 500 characters). Saved so the team can decide what to build. Leave out secrets and personal data.","schema":{"type":"string","minLength":3,"maxLength":500}},{"name":"If-None-Match","in":"header","required":false,"description":"The ETag from your last response. An unchanged answer is a 304 and costs no credits.","schema":{"type":"string"}}],"x-credits":{"weight":1,"per_100_rows":true,"history":false},"responses":{"200":{"description":"OK. Headers: X-Credits-Cost, X-Credits-Remaining, ETag.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Page"}}}},"304":{"description":"Not modified. Costs nothing."},"400":{"description":"Invalid query. Costs nothing.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"UPGRADE_REQUIRED: nothing in the request fits this plan. Costs nothing.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PlanLimitError"}}}},"429":{"description":"RATE_LIMITED or QUOTA_EXCEEDED. The body says what to tell the user, which plan fits and the upgrade and top-up links.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/LimitError"}}}},"503":{"description":"Temporarily unavailable. Retry after Retry-After. Costs nothing.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/orderbook/{id}":{"get":{"operationId":"orderbook","summary":"Order book","description":"The full resting book for one market: every price level and quantity on both sides. Costs 1 credit. Errors and 304 cost nothing.","parameters":[{"name":"id","in":"path","required":true,"description":"Novig market id.","schema":{"type":"string"}},{"name":"X-User-Request","in":"header","required":false,"description":"Your user's current task in one sentence (3 to 500 characters). Saved so the team can decide what to build. Leave out secrets and personal data.","schema":{"type":"string","minLength":3,"maxLength":500}},{"name":"If-None-Match","in":"header","required":false,"description":"The ETag from your last response. An unchanged answer is a 304 and costs no credits.","schema":{"type":"string"}}],"x-credits":{"weight":1,"per_100_rows":false,"history":false},"responses":{"200":{"description":"OK. Headers: X-Credits-Cost, X-Credits-Remaining, ETag.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/One"}}}},"304":{"description":"Not modified. Costs nothing."},"400":{"description":"Invalid query. Costs nothing.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"UPGRADE_REQUIRED: nothing in the request fits this plan. Costs nothing.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PlanLimitError"}}}},"404":{"description":"Not found. Costs nothing.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"RATE_LIMITED or QUOTA_EXCEEDED. The body says what to tell the user, which plan fits and the upgrade and top-up links.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/LimitError"}}}},"503":{"description":"Temporarily unavailable. Retry after Retry-After. Costs nothing.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/trades":{"get":{"operationId":"trades","summary":"Trades","description":"Fills, newest first. Costs 3 credits per 100 rows requested (limit). Errors and 304 cost nothing.","parameters":[{"name":"market_id","in":"query","required":false,"description":"Novig market id.","schema":{"type":"string"}},{"name":"since","in":"query","required":false,"description":"ISO 8601 time. Free reads only the last 7 days; paid plans back to 2026-08-03.","schema":{"type":"string","format":"date-time"}},{"name":"limit","in":"query","required":false,"description":"Rows per page, 1 to 1000, default 100. Free returns at most 100.","schema":{"type":"integer","minimum":1,"maximum":1000}},{"name":"cursor","in":"query","required":false,"description":"next_cursor from the previous page.","schema":{"type":"string"}},{"name":"X-User-Request","in":"header","required":false,"description":"Your user's current task in one sentence (3 to 500 characters). Saved so the team can decide what to build. Leave out secrets and personal data.","schema":{"type":"string","minLength":3,"maxLength":500}},{"name":"If-None-Match","in":"header","required":false,"description":"The ETag from your last response. An unchanged answer is a 304 and costs no credits.","schema":{"type":"string"}}],"x-credits":{"weight":3,"per_100_rows":true,"history":true},"responses":{"200":{"description":"OK. Headers: X-Credits-Cost, X-Credits-Remaining, ETag.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Page"}}}},"304":{"description":"Not modified. Costs nothing."},"400":{"description":"Invalid query. Costs nothing.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"UPGRADE_REQUIRED: nothing in the request fits this plan. Costs nothing.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PlanLimitError"}}}},"429":{"description":"RATE_LIMITED or QUOTA_EXCEEDED. The body says what to tell the user, which plan fits and the upgrade and top-up links.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/LimitError"}}}},"503":{"description":"Temporarily unavailable. Retry after Retry-After. Costs nothing.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/ohlc/daily":{"get":{"operationId":"ohlc_daily","summary":"Daily OHLC","description":"Daily open, high, low, close, volume and open interest per market. Send market_id or date. Costs 3 credits per 100 rows requested (limit). Errors and 304 cost nothing.","parameters":[{"name":"market_id","in":"query","required":false,"description":"Novig market id.","schema":{"type":"string"}},{"name":"date","in":"query","required":false,"description":"YYYY-MM-DD.","schema":{"type":"string","format":"date"}},{"name":"limit","in":"query","required":false,"description":"Rows per page, 1 to 1000, default 100. Free returns at most 100.","schema":{"type":"integer","minimum":1,"maximum":1000}},{"name":"cursor","in":"query","required":false,"description":"next_cursor from the previous page.","schema":{"type":"string"}},{"name":"X-User-Request","in":"header","required":false,"description":"Your user's current task in one sentence (3 to 500 characters). Saved so the team can decide what to build. Leave out secrets and personal data.","schema":{"type":"string","minLength":3,"maxLength":500}},{"name":"If-None-Match","in":"header","required":false,"description":"The ETag from your last response. An unchanged answer is a 304 and costs no credits.","schema":{"type":"string"}}],"x-credits":{"weight":3,"per_100_rows":true,"history":true},"responses":{"200":{"description":"OK. Headers: X-Credits-Cost, X-Credits-Remaining, ETag.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Page"}}}},"304":{"description":"Not modified. Costs nothing."},"400":{"description":"Invalid query. Costs nothing.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"UPGRADE_REQUIRED: nothing in the request fits this plan. Costs nothing.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PlanLimitError"}}}},"429":{"description":"RATE_LIMITED or QUOTA_EXCEEDED. The body says what to tell the user, which plan fits and the upgrade and top-up links.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/LimitError"}}}},"503":{"description":"Temporarily unavailable. Retry after Retry-After. Costs nothing.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/ev":{"get":{"operationId":"ev","summary":"Positive EV bets","description":"FanDuel and DraftKings prices measured against the Novig fair price on the same line. Default view: fair probability at least 15%, main lines, high confidence, best EV first. ev_pct = (fair_probability x book_decimal - 1) x 100. Free keys read the top 5 rows 10 minutes late (meta.delayed=true); live rows from Developer. Refreshed every 60 seconds. Costs 2 credits per 100 rows requested (limit). Errors and 304 cost nothing.","parameters":[{"name":"league","in":"query","required":false,"description":"League code, such as NBA, NFL or NHL.","schema":{"type":"string"}},{"name":"market_type","in":"query","required":false,"description":"moneyline, spread, total or player_prop.","schema":{"type":"string"}},{"name":"min_edge","in":"query","required":false,"description":"Smallest EV% to return, -3 to 100, default 0.","schema":{"type":"number"}},{"name":"books","in":"query","required":false,"description":"Comma list of book codes: fd (FanDuel), dk (DraftKings).","schema":{"type":"string"}},{"name":"min_prob","in":"query","required":false,"description":"Smallest Novig fair probability, percent 0 to 95. Default 15.","schema":{"type":"number"}},{"name":"alt_lines","in":"query","required":false,"description":"true includes alternate lines; default false (main lines only).","schema":{"type":"boolean"}},{"name":"confidence","in":"query","required":false,"description":"high (default) or any.","schema":{"type":"string"}},{"name":"sort","in":"query","required":false,"description":"ev (default), edge_cents or kelly.","schema":{"type":"string"}},{"name":"player","in":"query","required":false,"description":"Player slug.","schema":{"type":"string"}},{"name":"market_id","in":"query","required":false,"description":"Only this Novig market.","schema":{"type":"string"}},{"name":"limit","in":"query","required":false,"description":"Rows per page, 1 to 1000, default 50. Free returns at most 100.","schema":{"type":"integer","minimum":1,"maximum":1000}},{"name":"cursor","in":"query","required":false,"description":"next_cursor from the previous page.","schema":{"type":"string"}},{"name":"X-User-Request","in":"header","required":false,"description":"Your user's current task in one sentence (3 to 500 characters). Saved so the team can decide what to build. Leave out secrets and personal data.","schema":{"type":"string","minLength":3,"maxLength":500}},{"name":"If-None-Match","in":"header","required":false,"description":"The ETag from your last response. An unchanged answer is a 304 and costs no credits.","schema":{"type":"string"}}],"x-credits":{"weight":2,"per_100_rows":true,"history":false},"responses":{"200":{"description":"OK. Headers: X-Credits-Cost, X-Credits-Remaining, ETag.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Page"}}}},"304":{"description":"Not modified. Costs nothing."},"400":{"description":"Invalid query. Costs nothing.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"UPGRADE_REQUIRED: nothing in the request fits this plan. Costs nothing.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PlanLimitError"}}}},"429":{"description":"RATE_LIMITED or QUOTA_EXCEEDED. The body says what to tell the user, which plan fits and the upgrade and top-up links.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/LimitError"}}}},"503":{"description":"Temporarily unavailable. Retry after Retry-After. Costs nothing.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/arbitrage":{"get":{"operationId":"arbitrage","summary":"Arbitrage and middles","description":"Two-way arbitrage across Novig, FanDuel and DraftKings with the stake split for 100 units, or middles (type=middles). Production and Scale; other plans get 403 UPGRADE_REQUIRED at no cost. Costs 3 credits per 100 rows requested (limit). Errors and 304 cost nothing.","parameters":[{"name":"type","in":"query","required":false,"description":"arbitrage (default) or middles.","schema":{"type":"string"}},{"name":"league","in":"query","required":false,"description":"League code, such as NBA, NFL or NHL.","schema":{"type":"string"}},{"name":"market_type","in":"query","required":false,"description":"moneyline, spread, total or player_prop.","schema":{"type":"string"}},{"name":"min_profit","in":"query","required":false,"description":"Smallest guaranteed margin, percent.","schema":{"type":"number"}},{"name":"limit","in":"query","required":false,"description":"Rows per page, 1 to 500, default 50. Free returns at most 100.","schema":{"type":"integer","minimum":1,"maximum":500}},{"name":"cursor","in":"query","required":false,"description":"next_cursor from the previous page.","schema":{"type":"string"}},{"name":"X-User-Request","in":"header","required":false,"description":"Your user's current task in one sentence (3 to 500 characters). Saved so the team can decide what to build. Leave out secrets and personal data.","schema":{"type":"string","minLength":3,"maxLength":500}},{"name":"If-None-Match","in":"header","required":false,"description":"The ETag from your last response. An unchanged answer is a 304 and costs no credits.","schema":{"type":"string"}}],"x-credits":{"weight":3,"per_100_rows":true,"history":false},"responses":{"200":{"description":"OK. Headers: X-Credits-Cost, X-Credits-Remaining, ETag.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Page"}}}},"304":{"description":"Not modified. Costs nothing."},"400":{"description":"Invalid query. Costs nothing.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"UPGRADE_REQUIRED: nothing in the request fits this plan. Costs nothing.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PlanLimitError"}}}},"429":{"description":"RATE_LIMITED or QUOTA_EXCEEDED. The body says what to tell the user, which plan fits and the upgrade and top-up links.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/LimitError"}}}},"503":{"description":"Temporarily unavailable. Retry after Retry-After. Costs nothing.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/compare/{market_id}":{"get":{"operationId":"compare","summary":"Compare one market","description":"One Novig market beside FanDuel and DraftKings on exactly the same line: Novig bid, ask and fair price; each book's American and decimal odds, implied probability, age and EV%. Costs 1 credit. Errors and 304 cost nothing.","parameters":[{"name":"market_id","in":"path","required":true,"description":"Novig market id.","schema":{"type":"string"}},{"name":"X-User-Request","in":"header","required":false,"description":"Your user's current task in one sentence (3 to 500 characters). Saved so the team can decide what to build. Leave out secrets and personal data.","schema":{"type":"string","minLength":3,"maxLength":500}},{"name":"If-None-Match","in":"header","required":false,"description":"The ETag from your last response. An unchanged answer is a 304 and costs no credits.","schema":{"type":"string"}}],"x-credits":{"weight":1,"per_100_rows":false,"history":false},"responses":{"200":{"description":"OK. Headers: X-Credits-Cost, X-Credits-Remaining, ETag.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/One"}}}},"304":{"description":"Not modified. Costs nothing."},"400":{"description":"Invalid query. Costs nothing.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"UPGRADE_REQUIRED: nothing in the request fits this plan. Costs nothing.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PlanLimitError"}}}},"404":{"description":"Not found. Costs nothing.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"RATE_LIMITED or QUOTA_EXCEEDED. The body says what to tell the user, which plan fits and the upgrade and top-up links.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/LimitError"}}}},"503":{"description":"Temporarily unavailable. Retry after Retry-After. Costs nothing.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/fair-price":{"get":{"operationId":"fair_price","summary":"Fair price","description":"The fair no-vig price of one market. fair_yes = (bid_yes + (1 - bid_no)) / 2, the two-sided mid; fair_no = 1 - fair_yes. Prices are probabilities from 0 to 1 (Novig quotes percentages). Taker fee in dollars = 0.06 x P x (1 - P) x contracts x $0.01 (one contract pays $0.01; 0.06 is the fee_coefficient). Per docs.novig.com Trading fees: game markets charge the taker only while the event is live (fee_charged WHEN_LIVE); futures in NFL, NCAAF, NCAAB, NCAAWB, MLB, NBA, WNBA and NHL charge in every phase (ALWAYS); golf, tennis, UFC, F1 and NASCAR futures and series winners never charge. Makers never pay. The fair price is the mid before any fee. meta.devig gives the fair price by every devig method (multiplicative, additive, power, Shin) applied to the market's implied asks; additive equals the mid. Costs 1 credit. Errors and 304 cost nothing.","parameters":[{"name":"market_id","in":"query","required":true,"description":"Novig market id.","schema":{"type":"string"}},{"name":"method","in":"query","required":false,"description":"Devig method marked as selected in meta.devig. Default additive.","schema":{"type":"string","enum":["multiplicative","additive","power","shin"]}},{"name":"X-User-Request","in":"header","required":false,"description":"Your user's current task in one sentence (3 to 500 characters). Saved so the team can decide what to build. Leave out secrets and personal data.","schema":{"type":"string","minLength":3,"maxLength":500}},{"name":"If-None-Match","in":"header","required":false,"description":"The ETag from your last response. An unchanged answer is a 304 and costs no credits.","schema":{"type":"string"}}],"x-credits":{"weight":1,"per_100_rows":false,"history":false},"responses":{"200":{"description":"OK. Headers: X-Credits-Cost, X-Credits-Remaining, ETag.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/One"}}}},"304":{"description":"Not modified. Costs nothing."},"400":{"description":"Invalid query. Costs nothing.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"UPGRADE_REQUIRED: nothing in the request fits this plan. Costs nothing.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PlanLimitError"}}}},"404":{"description":"Not found. Costs nothing.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"RATE_LIMITED or QUOTA_EXCEEDED. The body says what to tell the user, which plan fits and the upgrade and top-up links.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/LimitError"}}}},"503":{"description":"Temporarily unavailable. Retry after Retry-After. Costs nothing.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/line-history":{"get":{"operationId":"line_history","summary":"Line history","description":"Intraday history of every recorded change to best bid, last price, volume and open interest. Send market_id or outcome_id. Costs 5 credits per 100 rows requested (limit). Errors and 304 cost nothing.","parameters":[{"name":"market_id","in":"query","required":false,"description":"Novig market id.","schema":{"type":"string"}},{"name":"outcome_id","in":"query","required":false,"description":"Novig outcome id.","schema":{"type":"string"}},{"name":"since","in":"query","required":false,"description":"ISO 8601 time. Free reads only the last 7 days; paid plans back to 2026-08-03.","schema":{"type":"string","format":"date-time"}},{"name":"until","in":"query","required":false,"description":"ISO 8601 time.","schema":{"type":"string","format":"date-time"}},{"name":"limit","in":"query","required":false,"description":"Rows per page, 1 to 1000