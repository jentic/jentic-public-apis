      "PaymentRequestPayload": {
        "required": [
          "direction",
          "makerAction",
          "productId",
          "queueId",
          "status"
        ],
        "type": "object",
        "properties": {
          "productId": {
            "type": "string",
            "description": "Product ID",
            "example": "162943174"
          },
          "queueId": {
            "type": "string",
            "description": "Queue ID",
            "example": "32946"
          },
          "status": {
            "type": "string",
            "description": "Transaction status",
            "example": "TXIND"
          },
          "direction": {
            "type": "string",
            "description": "Payment direction",
            "example": "OUTWARD"
          },
          "makerAction": {
            "type": "string",
            "description": "Maker action",
            "example": "TXSUB"
          },
          "checkerAction": {
            "type": "string",
            "description": "Checker action",
            "example": "null"
          },
          "fieldData": {
            "$ref": "#/components/schemas/InitiateFieldData"
          },
          "bank_ENTITY_ID": {
            "type": "string"
          }
        },
        "description": "Complete payment request payload with all field data"
      },
      "ActionFieldData": {
        "type": "object",
        "properties": {
          "dfd_ST1_MD1_MKR_REMARKS_GRID": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MakerRemark"
            }
          },
          "dfd_PE_COM_CR_ACC_NO": {
            "type": "string"
          }
        },
        "description": "Schema for action field data"
      },
      "ActionRequestPayload": {
        "required": [
          "currentAction",
          "direction",
          "fieldData",
          "lastAction",
          "productId",
          "queueId",
          "txnStatus",
          "userName"
        ],
        "type": "object",
        "properties": {
          "productId": {
            "type": "string",
            "description": "Product ID",
            "example": "162943174"
          },
          "userName": {
            "type": "string",
            "description": "User name",
            "example": "ALICE"
          },
