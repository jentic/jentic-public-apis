{
  "openapi": "3.0.1",
  "info": {
    "title": "PSH Request Router API",
    "description": "Professional Payment Services Hub (PSH) Request Router API Documentation. This enterprise-grade microservice handles payment initiation requests, action events, and comprehensive payment processing workflows. It provides secure, scalable endpoints for payment transaction routing, queue management, and workflow automation in the Intellect Design Arena platform.",
    "termsOfService": "https://www.intellectdesign.com/terms",
    "contact": {
      "name": "PSH Request Router Development Team",
      "url": "https://www.intellectdesign.com/",
      "email": "support@intellectdesign.com"
    },
    "license": {
      "name": "Intellect Design Arena License",
      "url": "https://www.intellectdesign.com/terms"
    },
    "version": "25.1.0.1",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/KUMAR2S/psh-request-router-api/25.1.0.1"
  },
  "servers": [
    {
      "url": "https://api.intellectdesign.com/psh-request-router",
      "description": "Production Server"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
