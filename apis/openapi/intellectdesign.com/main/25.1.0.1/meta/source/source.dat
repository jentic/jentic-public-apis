    "/swagger/v01/initiate": {
      "post": {
        "tags": [
          "Swagger API"
        ],
        "summary": "Process payment request",
        "description": "Process a comprehensive payment request with all field data including transaction details, beneficiary info, and regulatory information",
        "operationId": "processPaymentRequest",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaymentRequestPayload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Invalid request payload",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "200": {
            "description": "Payment request processed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "500": {
            "description": "Error processing payment request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
