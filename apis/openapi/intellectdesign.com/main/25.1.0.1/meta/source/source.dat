          },
          "timestamp": {
            "type": "string"
          },
          "paymentReferenceNumbers": {
            "maxItems": 100,
            "minItems": 0,
            "type": "array",
            "items": {
              "maxLength": 35,
              "minLength": 0,
              "type": "string"
            }
          },
          "timestampValid": {
            "type": "boolean",
            "readOnly": true
          }
        }
      },
