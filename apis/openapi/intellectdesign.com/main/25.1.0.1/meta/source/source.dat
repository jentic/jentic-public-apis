    "/api/accept/initiate": {
      "post": {
        "tags": [
          "Accept API"
        ],
        "summary": "Initiate payment or case event",
        "description": "Accepts JSON payload to initiate a payment or case workflow (technical channel PSH_PMT_INITIATE_API).\nRule deriveInitiateDataEntityInput selects input type: INP_PMT_INITIATE_API (OutwardSinglePayment),\nINP_CASE_INITIATE_API (eventName-driven INITIATE events), or INP_INITIATE_PSH_RFP_TXN (RFP).\nRequest is validated (e.g. validateInstdAmount, validateMessageCategory) then processed via\nReceiveAPI (comp_group 2006) and may trigger InitiateEventDataPersistance, EventActionTrigger.\n",
        "operationId": "acceptInitiateEvent",
        "parameters": [
          {
            "name": "queryParams",
            "in": "query",
            "required": false,
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcceptInitiatePayload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Request accepted; event initiated per input type and EVENT_MASTER.",
            "content": {
              "application/json": {}
            }
          },
          "400": {
            "description": "Invalid request (e.g. validation failure)",
            "content": {
              "application/json": {}
            }
          },
          "500": {
            "description": "Processing error",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    },
    "/api/accept/action": {
      "post": {
        "tags": [
          "Accept API"
        ],
        "summary": "Process user action (maker/checker/auto-auth)",
        "description": "Accepts JSON payload for ActionEvent (mainEvent=ActionEvent, processingEvent=ReceiveAPI).\nComponent 20030 (ActionEvent) resolves action from QUEUE_ACTION_MASTER (queueId + currentAction + lastAction),\nperforms maker/checker/auto-auth using ACTION_ATTRIBUTES_MAPPING, updates state via TxnWriteService,\nand optionally publishes to technical_channel when technical_action=UPDATE_AND_ROUTE.\n",
        "operationId": "acceptActionEvent",
        "parameters": [
          {
            "name": "queryParams",
            "in": "query",
            "required": false,
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcceptActionPayload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Action processed; state/queue updated per QUEUE_ACTION_MASTER.",
            "content": {
              "application/json": {}
            }
          },
          "400": {
            "description": "Invalid request payload",
            "content": {
              "application/json": {}
            }
          },
          "500": {
            "description": "Error processing action",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    },
