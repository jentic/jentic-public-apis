                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "415": {
            "description": "Request rejected. No automatic purchase or retry of a song.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Request rejected. No automatic purchase or retry of a song.",
            "content": {
