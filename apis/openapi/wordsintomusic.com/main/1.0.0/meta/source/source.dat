  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Required: Bearer YOUR_WORDS_INTO_MUSIC_API_KEY. Create a key in your app Settings. This is separate from any RapidAPI gateway key."
      }
    },
    "schemas": {
      "SongInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "direction"
        ],
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "idea",
              "lyrics"
            ],
            "default": "idea"
          },
          "idea": {
            "type": "string",
            "maxLength": 2000,
            "default": ""
          },
          "lyrics": {
            "type": "string",
            "maxLength": 4000,
            "default": ""
          },
          "direction": {
            "type": "string",
            "maxLength": 400,
            "description": "Musical style, instruments, mood and vocal delivery."
          },
          "language": {
            "type": "string",
            "enum": [
              "en",
              "es",
              "de",
              "fr",
              "pt-BR"
            ],
            "default": "en"
          },
          "instrumental": {
            "type": "boolean",
            "default": false
          },
          "title": {
            "type": "string",
            "maxLength": 100,
            "default": ""
          },
          "duration": {
            "type": "integer",
            "minimum": 60,
            "maximum": 180,
            "default": 120
          }
        }
      },
      "Song": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "duration": {
            "type": "number"
          },
          "createdAt": {
            "type": "number",
            "description": "Unix milliseconds"
          },
          "favorite": {
            "type": "boolean"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Private library page. Requires the owner to sign in."
          },
          "lyrics": {
            "type": "string"
          }
        }
      }
    }
  },
  "externalDocs": {
    "url": "https://wordsintomusic.com/developers/",
    "description": "Quick start and CLI"
  }
}
