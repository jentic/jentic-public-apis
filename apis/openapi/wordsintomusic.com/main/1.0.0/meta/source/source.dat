    "/songs": {
      "get": {
        "operationId": "listSongs",
        "tags": [
          "Songs"
        ],
        "summary": "List your private song library",
        "description": "Requires songs:read. Newest first. Pass the returned cursor to retrieve the next page.",
        "responses": {
          "200": {
            "description": "Successful request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "songs": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Song"
                      }
                    },
                    "cursor": {
                      "type": "string",
                      "nullable": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Request rejected. No automatic purchase or retry of a song.",
