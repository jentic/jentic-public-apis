    "/jobs/{jobId}": {
      "get": {
        "operationId": "getSongJob",
        "tags": [
          "Songs"
        ],
        "summary": "Check generation status",
        "description": "Requires songs:read. Poll at least 15 seconds apart. A ready result contains the private song link. No public audio URL is exposed.",
        "responses": {
          "200": {
            "description": "Successful request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "jobId": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "ready",
                        "failed",
                        "needs-attention",
                        "saving",
                        "generating"
                      ]
                    },
                    "song": {
                      "$ref": "#/components/schemas/Song"
                    },
                    "nextCheckAfterSeconds": {
                      "type": "integer"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Request rejected. No automatic purchase or retry of a song.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Request rejected. No automatic purchase or retry of a song.",
            "content": {
