{
  "openapi": "3.0.3",
  "info": {
    "title": "Words into Music API",
    "version": "1.0.0",
    "description": "Create songs from ideas or lyrics using your existing Words into Music account. Sign up at https://wordsintomusic.com/create/ and create a key in https://wordsintomusic.com/app/settings/. API access has no separate subscription. Starting a song uses one existing song credit. Key holders can access their own private library. English, Spanish, German, French and Brazilian Portuguese are supported.",
    "contact": {
      "name": "Words into Music",
      "email": "contact@wordsintomusic.com",
      "url": "https://wordsintomusic.com/developers/"
    }
  },
  "servers": [
    {
      "url": "https://mcp.wordsintomusic.com/v1",
      "description": "Production API"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "tags": [
    {
      "name": "Account"
    },
    {
      "name": "Songs"
    }
  ],
  "paths": {
    "/account": {
      "get": {
        "operationId": "getAccountUsage",
        "tags": [
          "Account"
        ],
        "summary": "Check your available song credits",
        "description": "Requires account:read. No song credit cost.",
        "responses": {
          "200": {
            "description": "Successful request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "accountReference": {
                      "type": "string"
                    },
                    "availableSongs": {
                      "type": "integer"
                    },
                    "reservedSongs": {
                      "type": "integer"
                    },
                    "songCreditCost": {
                      "type": "integer"
                    },
                    "accountUrl": {
                      "type": "string"
                    },
                    "supportedLanguages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Request rejected. No automatic purchase or retry of a song.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Request rejected. No automatic purchase or retry of a song.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Request rejected. No automatic purchase or retry of a song.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "413": {
