    "/songs/{id}": {
      "get": {
        "operationId": "getSong",
        "tags": [
          "Songs"
        ],
        "summary": "Read one of your songs",
        "description": "Requires songs:read. Only songs owned by the API key account can be retrieved. Lyrics are opt-in.",
        "responses": {
          "200": {
            "description": "Successful request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Song"
