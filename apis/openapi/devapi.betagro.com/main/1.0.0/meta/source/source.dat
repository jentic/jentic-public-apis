                            },
                            "usern1": {
                              "type": "string",
                              "example": ""
                            },
                            "usern2": {
                              "type": "string",
                              "example": ""
                            },
                            "usert1": {
                              "type": "string",
                              "example": "11:00:00"
                            }
                          }
                        },
                        "example": [
                          {
                            "attribute": "/",
                            "equipment": "",
                            "functLoc": "",
                            "mic": "CHEM0001",
                            "operation": "0010",
