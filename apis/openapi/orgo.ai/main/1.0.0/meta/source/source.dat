        }
      }
    },
    "/api/v1/invoices": {
      "post": {
        "operationId": "createInvoice",
        "summary": "Invoice anyone for anything, paid into your connected bank account",
        "description": "Creates and finalizes a one-off invoice and answers with `url`, the Stripe page where your customer pays it (card). Nothing is sent: share `url`, or POST /api/v1/invoices/{id}/send to email it from your business name. Amounts are integer cents. Give `amount`, or `line_items` (then `amount` may be left out, or must equal their total). `customer` needs an email or a phone. `due_date` is a date (2026-11-01, due at the end of that day UTC) or unix seconds, within 365 days; without one the invoice is due 30 days after it is made. Every create needs an Idempotency-Key header (a UUID, new for each invoice): a retry with the same key within 24 hours answers with the same invoice instead of making a second one.\n\nMoney: a destination charge to your Stripe Connect account, made on its behalf, so the invoice, the payment page and the card statement carry your business name. Orgo keeps only what Stripe charges it for the invoice, the card fee (2.9% + 30¢) and the Invoicing fee (0.5%), as `orgo_fee`; `payout` is paid out to you. Needs Invoicing (every paid plan) and payouts set up in Settings → Invoicing. Use an account-wide API key.",
        "tags": [
          "invoices"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "A new key for each invoice, such as a UUID. Send the same key again only to retry that invoice.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 255
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateInvoice"
              },
              "example": {
                "amount": 120000,
                "currency": "usd",
                "description": "March security audit",
                "customer": {
                  "email": "ap@acme.com",
                  "name": "Acme Inc."
                },
                "due_date": "2026-11-01",
                "metadata": {
                  "project": "audit-2026-03"
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created and open. `url` is where the customer pays.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Invoice"
                }
              }
            }
          },
          "400": {
            "description": "Bad input (invalid_request, with `param`), no Idempotency-Key header (idempotency_key_required), or a malformed one (invalid_idempotency_key).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "amount must be at least 50 cents ($0.50).",
                  "code": "invalid_request",
                  "param": "amount"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated."
          },
          "403": {
            "description": "Invoicing is off for this account (UPGRADE_REQUIRED on Free, MANAGED_ACCOUNTS_DISABLED), or a workspace-scoped key."
          },
          "404": {
            "description": "workspace_id is not a workspace you can write to (workspace_not_found)."
          },
          "409": {
            "description": "Payouts are not set up yet (payouts_not_ready, with `connect_url`), or a request with this Idempotency-Key is still running (idempotency_in_progress).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Connect a bank account first, so you can be paid. Set up payouts in Settings → Invoicing.",
                  "code": "payouts_not_ready",
                  "connect_url": "https://www.orgo.ai/settings/invoicing"
                }
              }
            }
          },
          "422": {
            "description": "This Idempotency-Key was used for a different invoice (idempotency_key_reused), or the invoice it made was discarded (idempotency_key_spent). Use a new key."
          },
          "502": {
            "description": "Stripe did not answer (stripe_unavailable). Retry with the same Idempotency-Key."
          },
          "503": {
            "description": "Invoicing is not available yet (invoicing_unavailable), or the invoice could not be saved (invoice_not_saved; the error says whether to retry with a new or the same Idempotency-Key)."
          }
        }
      },
      "get": {
        "operationId": "listInvoices",
        "summary": "Your invoices, newest first",
        "description": "Read from Orgo’s record of your invoices, so a new invoice is here as soon as it is made. Statuses and amounts follow Stripe: they are updated on each of Stripe’s invoice events and whenever you read, send or void one, so a payment can take a few seconds to show here; GET /api/v1/invoices/{id} reads Stripe at once. Pass `next_cursor` back as `cursor` for the next page, with the same filters.",
        "tags": [
          "invoices"
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/InvoiceStatus"
            }
          },
          {
            "name": "workspace_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of invoices.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvoiceList"
                }
              }
            }
          },
          "400": {
            "description": "Bad status, workspace_id or cursor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated."
          },
          "403": {
            "description": "Invoicing is off for this account, or a workspace-scoped key."
          },
          "503": {
            "description": "Invoicing is not available yet (invoicing_unavailable)."
          }
        }
      }
    },
    "/api/v1/invoices/{id}": {
      "get": {
        "operationId": "getInvoice",
        "summary": "One invoice, with its current status (open, paid, void, uncollectible)",
        "tags": [
          "invoices"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/InvoiceId"
          }
        ],
        "responses": {
          "200": {
            "description": "The invoice.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Invoice"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated."
          },
          "404": {
            "description": "Not one of your invoices (invoice_not_found)."
          }
        }
      }
    },
    "/api/v1/invoices/{id}/send": {
      "post": {
        "operationId": "sendInvoice",
        "summary": "Email the invoice to the customer, from your business name",
        "description": "Sends again on a later call, so it is also the reminder, but at most once a minute: a second send within a minute, at the same time or as a retry, emails nothing and answers 409 invoice_recently_sent. Replies go to your account email.",
        "tags": [
          "invoices"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/InvoiceId"
          }
        ],
        "responses": {
          "200": {
            "description": "Sent. `last_sent_at` says when.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Invoice"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated."
          },
          "404": {
            "description": "Not one of your invoices (invoice_not_found)."
          },
          "409": {
            "description": "Already paid (invoice_paid), void (invoice_void), the customer has no email (no_customer_email, with `url` to share yourself), or it was emailed less than a minute ago (invoice_recently_sent, with `last_sent_at`)."
          },
          "502": {
            "description": "The email did not send (email_failed, with `url`). The invoice is still open, and you can send again at once."
          },
          "503": {
            "description": "Invoicing is not available yet (invoicing_unavailable)."
          }
        }
      }
    },
    "/api/v1/invoices/{id}/void": {
      "post": {
        "operationId": "voidInvoice",
        "summary": "Cancel an unpaid invoice; its page stops taking payment",
        "tags": [
          "invoices"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/InvoiceId"
          }
        ],
        "responses": {
          "200": {
            "description": "Void (voiding a void invoice answers the same).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Invoice"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated."
          },
          "404": {
            "description": "Not one of your invoices (invoice_not_found)."
          },
          "409": {
            "description": "Paid invoices cannot be voided (invoice_paid)."
          }
        }
      }
    },
    "/api/v1/support/ask": {
      "post": {
        "operationId": "askSupport",
        "summary": "Ask Orgo’s support agent a question about using Orgo",
        "description": "Orgo’s support agent, for programs such as coding agents setting Orgo up: it answers from Orgo’s docs, pricing and public pages (and the docs of Hermes Agent, OpenClaw, Claude Code and Codex) as markdown, with full URLs and copyable commands. Send `question`, or a conversation as `messages`; to follow up, send back the answer’s `messages` with the next `question`. Nothing is stored.\n\nWith an API key it also reads that account’s plan, billing status and computers (never keys, secrets, files or screens), and can hand the conversation to Orgo’s team, who reply to the account’s email (`handoff`). Without one it answers from the docs. It changes nothing. 30 questions an hour per account; 15 an hour per address without a key.\n\nWith a key, Orgo pays for 150,000 tokens a day per account (input, output and cache writes; resets at 00:00 UTC), then each answer comes out of the account’s credits at the usual AI rate. `allowance` says where it stands (also `GET /api/v1/support/allowance`); out of free tokens and credits is a `402`. The key’s own account pays, never another account. A key held to one workspace sees only that workspace’s computers and can’t hand off.",
        "tags": [
          "support"
        ],
        "security": [
          {
            "bearerApiKey": []
          },
          {}
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "question": {
                    "type": "string",
                    "maxLength": 4000,
                    "description": "The question. Added after `messages` when both are sent."
                  },
                  "messages": {
                    "type": "array",
                    "description": "The conversation so far, oldest first, ending on the user’s turn unless `question` is sent. The last 12 turns are read.",
                    "items": {
                      "type": "object",
                      "required": [
                        "role",
                        "content"
                      ],
                      "properties": {
                        "role": {
                          "type": "string",
                          "enum": [
                            "user",
                            "assistant"
                          ]
                        },
                        "content": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              },
              "example": {
                "question": "How do I give my computer a public URL?"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The answer.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "answer",
                    "links",
                    "handoff",
                    "allowance",
                    "messages"
                  ],
                  "properties": {
                    "answer": {
                      "type": "string",
                      "description": "Markdown: full URLs, code in fenced blocks with their language."
                    },
                    "links": {
                      "type": "array",
                      "description": "The pages the answer points to, in order.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "title": {
                            "type": "string"
                          },
                          "url": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "handoff": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "description": "Set when the agent handed the conversation to Orgo’s team, who reply to `email`.",
                      "properties": {
                        "status": {
                          "type": "string",
                          "enum": [
                            "sent"
                          ]
                        },
                        "email": {
                          "type": "string"
                        }
                      }
                    },
                    "allowance": {
                      "oneOf": [
                        {
                          "$ref": "#/components/schemas/SupportAllowance"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "description": "Today’s free support tokens after this answer. null without a key."
                    },
                    "messages": {
                      "type": "array",
                      "description": "The conversation including this answer: send it back with the next `question`.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "role": {
                            "type": "string"
                          },
                          "content": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "No question (`question_required`, `invalid_request`)."
          },
          "401": {
            "description": "A key was sent and is not valid."
          },
          "402": {
            "description": "Today’s free tokens are used and the credits can’t pay (`INSUFFICIENT_CREDITS`), or a managed account is at its monthly AI limit (`ACCOUNT_AI_LIMIT`). Add credits, or wait for `allowance.resets_at`.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string",
                      "enum": [
                        "INSUFFICIENT_CREDITS",
                        "ACCOUNT_AI_LIMIT"
                      ]
                    },
                    "allowance": {
                      "$ref": "#/components/schemas/SupportAllowance"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Too many questions this hour (Retry-After says when), or two already in flight for this account (`one_at_a_time`): wait for an answer."
          },
          "502": {
            "description": "The agent didn’t answer (`agent_failed`). Try again, or email contact@orgo.ai."
          },
          "503": {
            "description": "The agent is unavailable here."
          }
        }
      }
    },
    "/api/v1/support/allowance": {
      "get": {
        "operationId": "getSupportAllowance",
        "summary": "Today’s free support tokens",
        "description": "How many of the day’s free support agent tokens the account has left (150,000 a day: input, output and cache writes; resets at 00:00 UTC), whether answers now come out of its credits, and whether those can take another question. `allowance` is null without a key (questions without one are free, on the visitor limits).",
        "tags": [
          "support"
        ],
        "security": [
          {
            "bearerApiKey": []
          },
          {}
        ],
        "responses": {
          "200": {
            "description": "The allowance.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "allowance"
                  ],
                  "properties": {
                    "allowance": {
                      "oneOf": [
                        {
                          "$ref": "#/components/schemas/SupportAllowance"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "A key was sent and is not valid."
          },
          "503": {
            "description": "Couldn’t read it. Try again."
          }
        }
      }
    },
    "/api/v1/credits": {
      "post": {
        "operationId": "buyCreditsWithMpp",
        "summary": "Buy credits over the Machine Payments Protocol (MPP): an agent pays with no checkout page",
        "description": "Two requests, per MPP (https://mpp.dev). First send the body with your API key and no payment: the answer is `402` with one `WWW-Authenticate: Payment ...` challenge per way to pay (`method=\"stripe\"`: a Stripe Shared Payment Token from a card or Link wallet; `method=\"tempo\"`: USDC on Tempo, where offered). Pay one challenge and send the SAME request again with the credential in `Payment-Authorization: Payment <credential>` (your `Authorization: Bearer` key stays as it is). A challenge is signed by Orgo, bound to your account and this amount, and expires in 5 minutes; a credential is accepted once. MPP clients do this for you: `npx mppx <url> -H \"Authorization: Bearer $ORGO_API_KEY\" -J '{\"amount_usd\":10}'`, or `fetch` patched by `Mppx.create({ methods: [...] })` from `mppx/client`.\n\nCredits are added to the account that owns the key, one dollar of credit per dollar paid. Account-wide keys and signed-in sessions only. Over the limit of 20 requests a minute per key the answer is 429.\n\nNot every environment takes MPP: where it is off the answer is 503 `mpp_off`. A person can then buy credit from a Checkout link: `POST /api/credits/checkout {\"amount_cents\": 1000}` answers its `url`.",
        "tags": [
          "credits"
        ],
        "parameters": [
          {
            "name": "Payment-Authorization",
            "in": "header",
            "required": false,
            "description": "The MPP credential for one of the 402 challenges: `Payment <base64url>`. Omit it to get the challenges.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "amount_usd"
                ],
                "properties": {
                  "amount_usd": {
                    "type": "number",
                    "minimum": 0.5,
                    "maximum": 1000,
                    "multipleOf": 0.01,
                    "description": "Dollars of credit to buy, at most 2 decimals."
                  }
                }
              },
              "example": {
                "amount_usd": 10
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Paid and credited. The `Payment-Receipt` header carries the MPP receipt.",
            "headers": {
              "Payment-Receipt": {
                "description": "MPP receipt (base64url JSON: method, reference, status, timestamp).",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "credited_usd",
                    "balance_usd",
                    "receipt"
                  ],
                  "properties": {
                    "credited_usd": {
                      "type": "number"
                    },
                    "balance_usd": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "description": "The account’s credit balance after this top-up."
                    },
                    "receipt": {
                      "type": "object",
                      "properties": {
                        "method": {
                          "type": "string",
                          "enum": [
                            "stripe",
                            "tempo"
                          ]
                        },
                        "reference": {
                          "type": "string",
                          "description": "The Stripe PaymentIntent (pi_...) for a card, the transaction hash for Tempo."
                        }
                      }
                    },
                    "duplicate": {
                      "type": "boolean",
                      "description": "True when this payment had already been credited. Nothing was added again."
                    }
                  }
                },
                "example": {
                  "credited_usd": 10,
                  "balance_usd": 42.5,
                  "receipt": {
                    "method": "stripe",
                    "reference": "pi_3Q..."
                  }
                }
              }
            }
          },
          "202": {
            "description": "Paid, but the credit could not be written just now (credit_pending). It is added shortly; do not pay again."
          },
          "400": {
            "description": "invalid_amount or invalid_json.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated."
          },
          "402": {
            "description": "Payment required: no credential, or one that was refused (expired, used, for another account or amount). Pay a challenge from `WWW-Authenticate` and retry. A refused credential also carries an `application/problem+json` body.",
            "headers": {
              "WWW-Authenticate": {
                "description": "`Payment id=\"...\", realm=\"...\", method=\"stripe\", intent=\"charge\", request=\"<base64url>\", expires=\"...\", opaque=\"...\"`, one per way to pay.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "A workspace-scoped key (account_key_required) or a guest (account_required).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited (rate_limited). See Retry-After."
          },
          "503": {
            "description": "MPP is off in this environment (mpp_off). Use POST /api/credits/checkout for a Checkout link instead.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/chat/completions": {
      "post": {
        "operationId": "runComputerAgent",
        "summary": "Run an agent on a computer: OpenAI-shaped chat completions that drive the desktop",
        "description": "Sends the conversation to a model that operates the computer named by `computer_id` (clicks, types, runs commands) until it answers. The request and response follow OpenAI chat completions, plus `computer_id` and an `orgo` block, so the OpenAI SDKs work with base URL `https://www.orgo.ai/api/v1`. `messages[].content` is a string or OpenAI content parts (`text`, and `image_url` as an https or base64 data URL in user messages). Roles other than user and assistant are dropped, and the first remaining message must be from the user. With `stream: true` the answer arrives as `chat.completion.chunk` Server-Sent Events ending in `data: [DONE]`; only text streams, and the thread id is in the `X-Thread-Id` header. A stream that ends without a chunk carrying a `finish_reason` failed. Closing the connection stops the run at its next step; steps already taken are billed.\n\nA run takes up to 250 model steps. `max_steps` raises that, up to 500; it never lowers it. A run that reaches its limit finishes with `finish_reason: \"length\"`. Billed from AI credits by the workspace owner, unless you send your own Anthropic key in `x-anthropic-key` with an Anthropic-served model.",
        "tags": [
          "agent"
        ],
        "parameters": [
          {
            "name": "x-anthropic-key",
            "in": "header",
            "required": false,
            "description": "Your own Anthropic key. For an Anthropic-served model, the run uses it and is not billed to credits; other models ignore it.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "computer_id",
                  "messages"
                ],
                "properties": {
                  "computer_id": {
                    "type": "string",
                    "description": "The computer to drive (its id, or its instance id, which changes when the computer wakes from storage; prefer the id). It must be running."
                  },
                  "messages": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": [
                        "role",
                        "content"
                      ],
                      "properties": {
                        "role": {
                          "type": "string",
                          "description": "user or assistant. Other roles are accepted and dropped."
                        },
                        "content": {
                          "oneOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "array",
                              "items": {
                                "oneOf": [
                                  {
                                    "type": "object",
                                    "required": [
                                      "type",
                                      "text"
                                    ],
                                    "properties": {
                                      "type": {
                                        "const": "text"
                                      },
                                      "text": {
                                        "type": "string"
                                      }
                                    }
                                  },
                                  {
                                    "type": "object",
                                    "required": [
                                      "type",
                                      "image_url"
                                    ],
                                    "properties": {
                                      "type": {
                                        "const": "image_url"
                                      },
                                      "image_url": {
                                        "type": "object",
                                        "required": [
                                          "url"
                                        ],
                                        "properties": {
                                          "url": {
                                            "type": "string",
                                            "description": "https URL or base64 data URL (png, jpeg, gif, webp)."
                                          }
                                        }
                                      }
                                    }
                                  }
                                ]
                              }
                            }
                          ]
                        }
                      }
                    }
                  },
                  "model": {
                    "type": "string",
                    "description": "Leave it out to get Orgo’s recommended engine for the computer: `orgo-agent` (Computer Use) on Linux, Windows, macOS and iPhone computers, Claude Sonnet 5 on others or with your own Anthropic key. Name one to pin it.",
                    "enum": [
                      "orgo-agent",
                      "orgo-agent-opus-5.5",
                      "claude-sonnet-5",
                      "claude-opus-5.5",
                      "claude-opus-5",
                      "claude-opus-4.8",
                      "claude-sonnet-4.6",
                      "claude-opus-4.6"
                    ]
                  },
                  "stream": {
                    "type": "boolean",
                    "default": false
                  },
                  "thread_id": {
                    "type": "string",
                    "format": "uuid",
                    "description": "Continue a stored thread on this computer. Unknown ids start a new thread."
                  },
                  "max_steps": {
                    "type": "integer",
                    "minimum": 250,
                    "maximum": 500,
                    "default": 250,
                    "description": "Raise the step limit. Lower values are treated as 250."
                  }
                }
              },
              "example": {
                "model": "claude-sonnet-5",
                "computer_id": "a3bb189e-8bf9-3888-9912-ace4e6543002",
                "messages": [
                  {
                    "role": "user",
                    "content": "Open Firefox and find the weather in Paris."
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The final answer. With `stream: true`, an event stream instead.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "object": {
                      "type": "string",
                      "const": "chat.completion"
                    },
                    "created": {
                      "type": "integer"
                    },
                    "model": {
                      "type": "string"
                    },
                    "choices": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "usage": {
                      "type": "object",
                      "properties": {
                        "prompt_tokens": {
                          "type": "integer"
                        },
                        "completion_tokens": {
                          "type": "integer"
                        },
                        "total_tokens": {
                          "type": "integer"
                        }
                      }
                    },
                    "orgo": {
                      "type": "object",
                      "properties": {
                        "thread_id": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "steps": {
                          "type": "integer"
                        },
                        "cost_cents": {
                          "type": "integer"
                        },
                        "credit_balance_cents": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Bad input: missing_computer_id, invalid_model, invalid_messages (with `param`), empty_messages, invalid_message_order, invalid_json, model_unsupported_os, or context_overflow."
          },
          "401": {
            "description": "Invalid API key (invalid_api_key)."
          },
          "402": {
            "description": "Out of AI credits (credits_exhausted), or a managed account at its monthly AI limit (account_ai_limit)."
          },
          "403": {
            "description": "AI is turned off for this account."
          },
          "404": {
            "description": "The computer does not exist or is not yours (computer_not_found)."
          },
          "500": {
            "description": "The run failed (internal_error). Steps it took are billed."
          },
          "503": {
            "description": "The model is not available right now (model_not_configured)."
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "ComputerId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Computer id.",
        "schema": {
          "type": "string"
        }
      },
      "PublicUrlId": {
        "name": "urlId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "ServiceId": {
        "name": "serviceId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "ProjectId": {
        "name": "projectId",
        "in": "path",
        "required": true,
        "description": "Deploy project id.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "DeploymentId": {
        "name": "deploymentId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "InvoiceId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Invoice id (in_...).",
        "schema": {
          "type": "string",
          "pattern": "^in_[A-Za-z0-9]+$"
        }
      }
    },
    "schemas": {
      "SupportAllowance": {
        "type": "object",
        "required": [
          "free_daily",
          "free_left",
          "paying",
          "blocked",
          "resets_at"
        ],
        "properties": {
          "free_daily": {
            "type": "integer",
            "description": "Free support tokens a day: input, output and cache writes (cache reads are free)."
          },
          "free_left": {
            "type": "integer",
            "description": "Free tokens left today."
          },
          "paying": {
            "type": "boolean",
            "description": "Today’s free tokens are used: answers come out of the account’s credits. Never true for an account that isn’t charged (enterprise)."
          },
          "blocked": {
            "type": "boolean",
            "description": "Paying, and the credits can’t take another question (it would be a 402)."
          },
          "resets_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the free tokens come back (the next 00:00 UTC)."
          }
        }
      },
      "InvoiceStatus": {
        "type": "string",
        "enum": [
          "draft",
          "open",
          "paid",
          "void",
          "uncollectible"
        ]
      },
      "InvoiceLineItemInput": {
        "type": "object",
        "required": [
          "description",
          "unit_amount"
        ],
        "properties": {
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "unit_amount": {
            "type": "integer",
            "minimum": 1,
            "description": "Price of one, in cents."
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000,
            "default": 1
          }
        }
      },
      "CreateInvoice": {
        "type": "object",
        "required": [
          "description",
          "customer"
        ],
        "properties": {
          "amount": {
            "type": "integer",
            "minimum": 50,
            "maximum": 10000000,
            "description": "Total in cents. Required without line_items."
          },
          "currency": {
            "type": "string",
            "enum": [
              "usd"
            ],
            "default": "usd"
          },
          "description": {
            "type": "string",
            "maxLength": 1000,
            "description": "What it is for; shown on the invoice and in the email."
          },
          "line_items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "$ref": "#/components/schemas/InvoiceLineItemInput"
            }
          },
          "customer": {
            "type": "object",
            "description": "Who pays. An email or a phone is required.",
            "properties": {
              "email": {
                "type": "string",
                "format": "email"
              },
              "phone": {
                "type": "string",
                "example": "+15551234567"
              },
              "name": {
                "type": "string",
                "maxLength": 256
              }
            }
          },
          "due_date": {
            "oneOf": [
              {
                "type": "string",
                "description": "A date or date-time."
              },
              {
                "type": "integer",
                "description": "Unix seconds."
              }
            ]
          },
          "metadata": {
            "type": "object",
            "maxProperties": 20,
            "additionalProperties": {
              "type": "string",
              "maxLength": 500
            },
            "description": "Your own keys (not `type` or `orgo_*`), returned as sent."
          },
          "workspace_id": {
            "type": "string",
            "format": "uuid",
            "description": "Tag it with one of your workspaces, to filter the list by."
          }
        }
      },
      "Invoice": {
        "type": "object",
        "required": [
          "id",
          "status",
          "amount",
          "currency",
          "url",
          "created"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "in_1QxYz2AbCdEf"
          },
          "status": {
            "$ref": "#/components/schemas/InvoiceStatus"
          },
          "amount": {
            "type": "integer",
            "description": "Total, in cents."
          },
          "amount_paid": {
            "type": "integer"
          },
          "amount_remaining": {
            "type": "integer"
          },
          "currency": {
            "type": "string",
            "example": "usd"
          },
          "url": {
            "type": [
              "string",
              "null"
            ],
            "description": "Stripe’s hosted invoice page, where the customer pays."
          },
          "pdf_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "number": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "customer": {
            "type": "object",
            "properties": {
              "email": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "phone": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "line_items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "description": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "quantity": {
                  "type": "integer"
                },
                "unit_amount": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "amount": {
                  "type": "integer"
                }
              }
            }
          },
          "due_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "created": {
            "type": "string",
            "format": "date-time"
          },
          "paid_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "voided_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "last_sent_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "orgo_fee": {
            "type": "integer",
            "description": "Orgo’s fee in cents: Stripe’s card and Invoicing fees."
          },
          "payout": {
            "type": "integer",
            "description": "What reaches your bank when it is paid, in cents."
          },
          "workspace_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "example": {
          "id": "in_1QxYz2AbCdEf",
          "status": "open",
          "amount": 120000,
          "amount_paid": 0,
          "amount_remaining": 120000,
          "currency": "usd",
          "url": "https://invoice.stripe.com/i/acct_123/test_abc",
          "pdf_url": "https://pay.stripe.com/invoice/acct_123/test_abc/pdf",
          "number": "A1B2C3D4-0001",
          "description": "March security audit",
          "customer": {
            "email": "ap@acme.com",
            "phone": null,
            "name": "Acme Inc."
          },
          "line_items": [
            {
              "description": "March security audit",
              "quantity": 1,
              "unit_amount": 120000,
              "amount": 120000
            }
          ],
          "due_date": "2026-11-01T23:59:59.000Z",
          "created": "2026-10-07T18:00:00.000Z",
          "paid_at": null,
          "voided_at": null,
          "last_sent_at": null,
          "orgo_fee": 4110,
          "payout": 115890,
          "workspace_id": null,
          "metadata": {
            "project": "audit-2026-03"
          }
        }
      },
      "InvoiceList": {
        "type": "object",
        "required": [
          "invoices",
          "next_cursor"
        ],
        "properties": {
          "invoices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Invoice"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Pass as `cursor` for the next page; null on the last."
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        }
      },
      "PublicUrl": {
        "type": "object",
        "required": [
          "id",
          "url",
          "hostname",
          "label",
          "port",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "example": "https://cool-thing.orgo.dev"
          },
          "hostname": {
            "type": "string",
            "example": "cool-thing.orgo.dev"
          },
          "label": {
            "type": "string",
            "example": "cool-thing"
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PublicUrlList": {
        "type": "object",
        "required": [
          "enabled",
          "public_urls"
        ],
        "properties": {
          "enabled": {
            "type": "boolean",
            "description": "False where the feature is off or this computer cannot have public URLs."
          },
          "reason": {
            "type": "string",
            "description": "Why enabled is false for this computer, when that is the reason."
          },
          "base_domain": {
            "type": "string",
            "example": "orgo.dev"
          },
          "limit": {
            "type": "integer",
            "description": "Most public URLs this computer may have; negative means no cap."
          },
          "public_urls": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicUrl"
            }
          }
        }
      },
      "CreateComputer": {
        "type": "object",
        "required": [
          "workspace_id",
          "name"
        ],
        "properties": {
          "workspace_id": {
            "type": "string",
            "description": "The workspace to create it in (project_id is accepted too)."
          },
          "name": {
            "type": "string"
          },
          "os": {
            "type": "string",
            "enum": [
              "linux",
              "windows",
              "macos",
              "android",
              "ios"
            ],
            "default": "linux"
          },
          "ram": {
            "type": "integer",
            "enum": [
              4,
              8,
              10,
              16,
              32,
              64
            ],
            "default": 4,
            "description": "GB. macOS: 10 only, the default when omitted; anything else is refused with 400 MACOS_RAM_FIXED (contact us for more). Other systems: 4, 8, 16, 32 or 64 (default 4)."
          },
          "cpu": {
            "type": "number",
            "enum": [
              0.5,
              1,
              2,
              4,
              6,
              8,
              16
            ],
            "description": "vCPU. Omitted: 1 for 4 GB, else the vCPU of the ram’s size (8 GB: 2, 16 GB: 4, 32 GB: 6, 64 GB: 8). Above 6 (or ram 64) is set up on request: 403 CONTACT_US_FOR_SIZE unless the owner is on Enterprise or a negotiated plan past XL. Above 8 is refused with 403 PER_COMPUTER_CPU_CAP. macOS ignores it: the Mac sets the vCPU (8 on a Mac mini M4, 10 on an M6), so omit it."
          },
          "disk_size_gb": {
            "type": "integer",
            "minimum": 1,
            "description": "Omitted: the template’s disk, else the plan’s birth size."
          },
          "template_ref": {
            "type": "string",
            "description": "namespace/name@version"
          },
          "gpu": {
            "type": "string",
            "enum": [
              "2q",
              "4q"
            ],
            "description": "Linux only."
          },
          "resolution": {
            "type": "string",
            "description": "WIDTHxHEIGHTxDEPTH, e.g. 1280x720x24."
          }
        }
      },
      "CreatePublicUrl": {
        "type": "object",
        "required": [
          "port"
        ],
        "properties": {
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535,
            "not": {
              "enum": [
                22,
                3389,
                5900,
                6080,
                8080,
                9000
              ]
            }
          },
          "label": {
            "type": "string",
            "minLength": 3,
            "maxLength": 40,
            "pattern": "^[a-z0-9][a-z0-9-]{1,38}[a-z0-9]$"
          }
        }
      },
      "UpdatePublicUrl": {
        "type": "object",
        "required": [
          "port"
        ],
        "properties": {
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535,
            "not": {
              "enum": [
                22,
                3389,
                5900,
                6080,
                8080,
                9000
              ]
            }
          }
        }
      },
      "ComputerApp": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "command",
          "env",
          "secret_env_keys",
          "restart",
          "run_as",
          "enabled",
          "status",
          "applied"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "command",
              "deploy"
            ],
            "description": "deploy: the app of a deploy, changed from the deploy."
          },
          "deploy_project_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "command": {
            "type": "string"
          },
          "cwd": {
            "type": [
              "string",
              "null"
            ]
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "secret_env_keys": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Names of the secret variables. Their values are never returned."
          },
          "port": {
            "type": [
              "integer",
              "null"
            ]
          },
          "restart": {
            "type": "string",
            "enum": [
              "always",
              "on-failure",
              "no"
            ]
          },
          "run_as": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "running",
              "starting",
              "crashing",
              "stopped",
              "exited",
              "failed",
              "pending",
              "off",
              "unknown"
            ],
            "description": "pending: saved, not on the computer yet. crashing: it keeps exiting soon after it starts. failed: it could not be started."
          },
          "status_detail": {
            "type": [
              "string",
              "null"
            ],
            "description": "The process manager’s own words, e.g. \"pid 812, uptime 2:14:09\"."
          },
          "status_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "listening": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Something listens on port (null: no port, or the computer was not asked)."
          },
          "listening_publicly": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "It listens beyond 127.0.0.1, so a public URL reaches it."
          },
          "applied": {
            "type": "boolean",
            "description": "The computer has this version of the app."
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "public_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "The public URL on this port, where public URLs are on."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ComputerAppList": {
        "type": "object",
        "required": [
          "supported",
          "services"
        ],
        "properties": {
          "supported": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "description": "Why supported is false."
          },
          "computer": {
            "type": "string",
            "enum": [
              "running",
              "asleep",
              "stopped",
              "starting"
            ]
          },
          "live": {
            "type": "boolean",
            "description": "The states were read from the computer just now; false: last known."
          },
          "limit": {
            "type": "integer"
          },
          "services": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ComputerApp"
            }
          }
        }
      },
      "ComputerAppApply": {
        "type": "object",
        "required": [
          "state"
        ],
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "applied",
              "pending",
              "failed"
            ],
            "description": "pending: applied when the computer next runs, or on Orgo’s next try."
          },
          "error": {
            "type": "string"
          }
        }
      },
      "ComputerAppWrite": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ComputerApp"
          },
          {
            "type": "object",
            "properties": {
              "apply": {
                "$ref": "#/components/schemas/ComputerAppApply"
              }
            }
          }
        ]
      },
      "CreateComputerApp": {
        "type": "object",
        "required": [
          "name",
          "command"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
          },
          "command": {
            "type": "string",
            "maxLength": 4000
          },
          "cwd": {
            "type": [
              "string",
              "null"
            ],
            "description": "An absolute path. Default: the user’s home."
          },
          "port": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 65535
          },
          "restart": {
            "type": "string",
            "enum": [
              "always",
              "on-failure",
              "no"
            ],
            "default": "always"
          },
          "run_as": {
            "type": "string",
            "default": "root"
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "secret_env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "UpdateComputerApp": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
          },
          "command": {
            "type": "string",
            "maxLength": 4000
          },
          "cwd": {
            "type": [
              "string",
              "null"
            ]
          },
          "port": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 65535
          },
          "restart": {
            "type": "string",
            "enum": [
              "always",
              "on-failure",
              "no"
            ]
          },
          "run_as": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Replaces every plain variable."
          },
          "secret_env": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "null"
              ]
            },
            "description": "A value sets that secret, null removes it; others are kept."
          }
        }
      },
      "Deployment": {
        "type": "object",
        "required": [
          "id",
          "project_id",
          "trigger",
          "state",
          "branch"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "project_id": {
            "type": "string",
            "format": "uuid"
          },
          "trigger": {
            "type": "string",
            "enum": [
              "push",
              "manual",
              "rollback",
              "redeploy"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed",
              "cancelled",
              "superseded"
            ]
          },
          "phase": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "preparing",
              "cloning",
              "detecting",
              "installing",
              "building",
              "starting",
              "health_check",
              "live",
              null
            ]
          },
          "branch": {
            "type": "string"
          },
          "commit_sha": {
            "type": [
              "string",
              "null"
            ]
          },
          "commit_message": {
            "type": [
              "string",
              "null"
            ]
          },
          "commit_author": {
            "type": [
              "string",
              "null"
            ]
          },
          "framework": {
            "type": [
              "string",
              "null"
            ]
          },
          "error_code": {
            "type": [
              "string",
              "null"
            ],
            "description": "Failed: build_timeout, runner_lost, computer_not_running, github_token, clone_failed, detect_failed, install_failed, build_failed, docker_unavailable, start_failed, health_check_failed, release_gone, apply_failed."
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "rollback_of": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "current": {
            "type": "boolean",
            "description": "This deployment is the project’s live one. After a rollback it is the rollback, not the deployment it went back to."
          },
          "release_live": {
            "type": "boolean",
            "description": "Its release is the one live now, through this deployment or another of the same release (a rollback to it, or the one this rollback went back to). Nothing to roll back to or build again."
          },
          "can_rollback": {
            "type": "boolean",
            "description": "Its release is still on the computer and is not the one live now."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "started_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "finished_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "DeployProject": {
        "type": "object",
        "required": [
          "id",
          "name",
          "source",
          "repo",
          "branch",
          "port"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "description": "Also the name of the computer app that runs it."
          },
          "source": {
            "type": "string",
            "enum": [
              "github_app",
              "public"
            ]
          },
          "repo": {
            "type": "string",
            "example": "acme/web"
          },
          "repo_url": {
            "type": "string"
          },
          "installation_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "branch": {
            "type": "string"
          },
          "root_dir": {
            "type": "string"
          },
          "framework": {
            "type": "string",
            "enum": [
              "auto",
              "node",
              "python",
              "dockerfile",
              "compose",
              "static"
            ]
          },
          "detected_framework": {
            "type": [
              "string",
              "null"
            ]
          },
          "install_cmd": {
            "type": [
              "string",
              "null"
            ]
          },
          "build_cmd": {
            "type": [
              "string",
              "null"
            ]
          },
          "start_cmd": {
            "type": [
              "string",
              "null"
            ]
          },
          "port": {
            "type": "integer"
          },
          "health_path": {
            "type": "string"
          },
          "auto_deploy": {
            "type": "boolean"
          },
          "disabled": {
            "type": [
              "string",
              "null"
            ],
            "description": "Why pushes no longer deploy it."
          },
          "url": {
            "type": [
              "string",
              "null"
            ],
            "description": "Its public URL, made with its first live deploy where public URLs are on."
          },
          "app_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Its app (GET /api/computers/{id}/services)."
          },
          "env_keys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "current": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Deployment"
              },
              {
                "type": "null"
              }
            ]
          },
          "deployments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Deployment"
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "DeployProjectList": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "supported": {
            "type": "boolean"
          },
          "computer": {
            "type": "string",
            "enum": [
              "running",
              "asleep",
              "stopped",
              "starting"
            ]
          },
          "limit": {
            "type": "integer"
          },
          "github": {
            "type": "object",
            "properties": {
              "app": {
                "type": "boolean",
                "description": "This deployment has the Orgo GitHub App."
              },
              "workspace_id": {
                "type": "string"
              },
              "installations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "installation_id": {
                      "type": "string"
                    },
                    "account": {
                      "type": "string"
                    },
                    "account_type": {
                      "type": "string"
                    },
                    "suspended": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "projects": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DeployProject"
            }
          }
        }
      },
      "CreateDeployProject": {
        "type": "object",
        "properties": {
          "installation_id": {
            "type": "integer"
          },
          "repo_id": {
            "type": "integer"
          },
          "repo_url": {
            "type": "string",
            "example": "https://github.com/owner/name"
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
          },
          "branch": {
            "type": "string"
          },
          "root_dir": {
            "type": "string",
            "default": "."
          },
          "framework": {
            "type": "string",
            "enum": [
              "auto",
              "node",
              "python",
              "dockerfile",
              "compose",
              "static"
            ],
            "default": "auto"
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535,
            "default": 3000
          },
          "health_path": {
            "type": "string",
            "default": "/"
          },
          "install_cmd": {
            "type": [
              "string",
              "null"
            ]
          },
          "build_cmd": {
            "type": [
              "string",
              "null"
            ]
          },
          "start_cmd": {
            "type": [
              "string",
              "null"
            ]
          },
          "auto_deploy": {
            "type": "boolean",
            "default": true
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "deploy": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "UpdateDeployProject": {
        "type": "object",
        "properties": {
          "branch": {
            "type": "string"
          },
          "root_dir": {
            "type": "string"
          },
          "framework": {
            "type": "string",
            "enum": [
              "auto",
              "node",
              "python",
              "dockerfile",
              "compose",
              "static"
            ]
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "health_path": {
            "type": "string"
          },
          "install_cmd": {
            "type": [
              "string",
              "null"
            ]
          },
          "build_cmd": {
            "type": [
              "string",
              "null"
            ]
          },
          "start_cmd": {
            "type": [
              "string",
              "null"
            ]
          },
          "auto_deploy": {
            "type": "boolean"
          }
        }
      },
      "UpdateCustomDomain": {
        "type": "object",
        "required": [
          "target_port"
        ],
        "properties": {
          "target_port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535,
            "not": {
              "enum": [
                22,
                3389,
                5900,
                6080,
                8080,
                9000
              ]
            }
          }
        }
      },
      "DnsRecord": {
        "type": "object",
        "required": [
          "type",
          "name",
          "value"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "TXT",
              "CNAME",
              "A"
            ]
          },
          "name": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        }
      },
      "CustomDomain": {
        "type": "object",
        "required": [
          "id",
          "domain",
          "status",
          "target_port",
          "dns_records"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "domain": {
            "type": "string",
            "example": "app.example.com"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "verifying",
              "active",
              "failed",
              "disabled"
            ]
          },
          "target_port": {
            "type": "integer"
          },
          "verified_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "cert_status": {
            "type": "string",
            "enum": [
              "pending",
              "issued"
            ],
            "description": "issued once Orgo has let the domain get its HTTPS certificate, which happens on its first visit after it is active."
          },
          "dns": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/DnsRecord"
              },
              {
                "type": "null"
              }
            ],
            "description": "The TXT challenge alone, null once active. Kept for older clients."
          },
          "dns_records": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DnsRecord"
            },
            "description": "Every record to set: the TXT challenge, then a CNAME to the edge (an A record for an apex)."
          }
        }
      }
    },
    "securitySchemes": {
      "bearerApiKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Orgo API key",
        "description": "Create a key in the dashboard or via POST /api/keys, then send `Authorization: Bearer <key>`."
      }
    }
  },
  "tags": [
    {
      "name": "system"
    },
    {
      "name": "account"
    },
    {
      "name": "auth"
    },
    {
      "name": "workspaces"
    },
    {
      "name": "computers"
    },
    {
      "name": "public-urls",
      "description": "Share an app running on a computer: public URLs and custom domains."
    },
    {
      "name": "apps",
      "description": "Apps that run on a computer and come back by themselves after a reboot, a crash or a restore."
    },
    {
      "name": "deploys",
      "description": "Deploy a GitHub repository to a computer: built there on every push, served at its public URL."
    },
    {
      "name": "templates"
    },
    {
      "name": "invoices",
      "description": "Bill your own customers: one-off invoices paid into your connected bank account."
    },
    {
      "name": "credits",
      "description": "Buy AI and compute credits, including over the Machine Payments Protocol."
    },
    {
      "name": "agent",
      "description": "Run an AI agent that operates a computer."
    }
  ]
}