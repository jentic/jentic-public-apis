{
  "openapi": "3.0.3",
  "info": {
    "title": "New Kothon Mobile App API",
    "description": "## Overview\nREST API documentation for New Kothon Mobile Application backend services provided by MC (MIME Communications).\n\n## Authentication\nThe API uses two levels of authentication:\n1. **Device Authentication**: All requests require `X-Device-Auth` header\n2. **User Authentication**: Protected endpoints require JWT Bearer token in `Authorization` header\n\n## Base URL\n- Production: `https://gateway.mimebd.com`\n\n## Common Response Codes\n| Code | Description |\n|------|-------------|\n| 200 | Success |\n| 201 | Created (for payment) |\n| 400 | Bad Request - Invalid input |\n| 401 | Unauthorized - Invalid or missing token |\n| 403 | Forbidden - Access denied |\n| 404 | Not Found |\n| 500 | Internal Server Error |",
    "version": "1.0.0",
    "contact": {
      "name": "MIME Communications",
      "url": "https://mimebd.com",
      "email": "support@mimebd.com"
    },
    "license": {
      "name": "Proprietary",
      "url": "https://mimebd.com/terms"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/stardusttelecomltd/new-kothon-mobile-app-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://gateway.mimebd.com",
      "description": "Production Server"
    }
  ],
  "tags": [
    {
      "name": "Authentication",
      "description": "OTP-based authentication endpoints"
    },
    {
      "name": "Profile",
      "description": "User profile management endpoints"
    },
    {
      "name": "Balance",
      "description": "Balance and transaction management"
    },
    {
      "name": "Payment",
      "description": "bKash payment integration"
    }
  ],
  "components": {
    "securitySchemes": {
      "DeviceAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Device-Auth",
        "description": "Device authentication token (required for all endpoints)"
      },
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT access token received from Verify OTP endpoint"
      }
    },
    "schemas": {
      "SendOTPRequest": {
        "type": "object",
        "required": [
          "mobile_number"
        ],
        "properties": {
          "mobile_number": {
            "type": "string",
            "pattern": "^01[3-9]\\d{8}$",
            "minLength": 11,
            "maxLength": 11,
            "example": "01965493210",
            "description": "Bangladesh mobile number (11 digits). Must start with 01 followed by valid operator code (3-9)."
          }
        }
      },
      "VerifyOTPRequest": {
        "type": "object",
        "required": [
          "mobile_number",
          "otp"
        ],
        "properties": {
          "mobile_number": {
            "type": "string",
            "pattern": "^01[3-9]\\d{8}$",
            "minLength": 11,
            "maxLength": 11,
            "example": "01965493210",
            "description": "Mobile number used for OTP request"
          },
          "otp": {
            "type": "string",
            "pattern": "^\\d{6}$",
            "minLength": 6,
            "maxLength": 6,
            "example": "123456",
            "description": "6-digit OTP received via SMS"
          }
        }
      },
      "UpdateProfileRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "readOnly": true,
            "example": "MIME2564563",
            "description": "Auto-generated username (readonly). This field is included for reference but cannot be updated."
          },
          "mobile_number": {
            "type": "string",
            "pattern": "^01[3-9]\\d{8}$",
            "example": "01965493210",
            "description": "Mobile number (optional update)"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "abc_cust@gmail.com",
            "description": "User email address (optional)"
          },
          "fullname": {
            "type": "string",
            "minLength": 3,
            "maxLength": 100,
            "example": "ABC Customer",
            "description": "Full name as per NID (optional)"
          },
          "nid_number": {
            "type": "string",
            "pattern": "^\\d{10}$|^\\d{17}$",
            "example": "9846514564",
            "description": "National ID number (optional). Must be either 10 or 17 digits."
          },
          "dob": {
            "type": "string",
            "format": "date",
            "example": "1998-10-10",
            "description": "Date of birth in YYYY-MM-DD format (optional)"
          },
          "nid_selfy": {
            "type": "string",
            "format": "binary",
            "description": "Selfie image with NID (optional). Supported formats: JPEG, PNG. Max size: 5MB"
          },
          "nid_front": {
            "type": "string",
            "format": "binary",
            "description": "Front side of NID image (optional). Supported formats: JPEG, PNG. Max size: 5MB"
          },
          "nid_back": {
            "type": "string",
            "format": "binary",
            "description": "Back side of NID image (optional). Supported formats: JPEG, PNG. Max size: 5MB"
          }
        }
      },
      "CreatePaymentRequest": {
        "type": "object",
        "required": [
          "payer_reference",
          "amount"
        ],
        "properties": {
          "payer_reference": {
            "type": "string",
            "example": "MIME2564563",
            "description": "Username of the customer (mandatory). Used to identify the payer for the transaction."
          },
          "amount": {
            "type": "number",
            "format": "float",
            "minimum": 1,
            "example": 100,
            "description": "Payment amount in BDT (mandatory). Minimum value: 1 BDT"
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "example": "https://gateway.mimebd.com/api/bkash_pw/callback/",
            "description": "URL to receive payment callback (optional). If not provided, default callback URL will be used."
          },
          "intent": {
            "type": "string",
            "enum": [
              "sale",
              "authorization"
            ],
            "default": "sale",
            "example": "sale",
            "description": "Payment intent (optional). sale: Immediate capture, authorization: Authorize only"
          },
          "merchant_invoice_number": {
            "type": "string",
            "maxLength": 50,
            "example": "INV123456",
            "description": "Custom invoice number for tracking (optional)"
          }
        }
      },
      "SuccessResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "Success message"
          },
          "success": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "Error description"
          },
          "success": {
            "type": "boolean",
            "example": false
          }
        }
      },
      "SendOTPResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "OTP has been sent successfully to 01965493210",
            "description": "Success message with mobile number"
          },
          "success": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "ProfileInfo": {
        "type": "object",
        "description": "Complete user profile information",
        "properties": {
          "username": {
            "type": "string",
            "example": "MIME2564563",
            "description": "Auto-generated unique username"
          },
          "mobile_number": {
            "type": "string",
            "example": "01965493210",
            "description": "Registered mobile number"
          },
          "email": {
            "type": "string",
            "format": "email",
            "nullable": true,
            "example": "abc_cust@gmail.com",
            "description": "User email (null if not set)"
          },
          "did_number": {
            "type": "string",
            "example": "0964512456",
            "description": "DID (Direct Inward Dialing) number. Assigned by Sippy server for VoIP calls."
          },
          "sip_username": {
            "type": "string",
            "example": "0964512456",
            "description": "SIP username for VoIP authentication"
          },
          "sip_password": {
            "type": "string",
            "example": "xyz1234",
            "description": "SIP password for VoIP authentication"
          },
          "profile_status": {
            "type": "string",
            "enum": [
              "blocked",
              "unblocked"
            ],
            "example": "blocked",
            "description": "Profile verification status: blocked (Not verified, NID not submitted), unblocked (Verified, NID approved)"
          },
          "fullname": {
            "type": "string",
            "nullable": true,
            "example": "ABC customer",
            "description": "Full name as per NID"
          },
          "balance": {
            "type": "number",
            "format": "float",
            "example": 100,
            "description": "Current account balance in BDT"
          },
          "nid_number": {
            "type": "string",
            "nullable": true,
            "example": "9846514564",
            "description": "National ID number"
          },
          "dob": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "example": "1998-10-10",
            "description": "Date of birth"
          },
          "nid_selfy": {
            "type": "string",
            "format": "uri",
            "nullable": true,
            "example": "https://gateway.mimebd.com/api/kothon_new/media/nid_selfy987416566546514654.png",
            "description": "URL to selfie with NID image"
          },
          "nid_front": {
            "type": "string",
            "format": "uri",
            "nullable": true,
            "example": "https://gateway.mimebd.com/api/kothon_new/media/nid_front987416566046514654.png",
            "description": "URL to NID front image"
          },
          "nid_back": {
            "type": "string",
            "format": "uri",
            "nullable": true,
            "example": "https://gateway.mimebd.com/api/kothon_new/media/nid_back987416586546514654.png",
            "description": "URL to NID back image"
          }
        }
      },
      "VerifyOTPResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "OTP verified successfully",
            "description": "Verification status message"
          },
          "success": {
            "type": "boolean",
            "example": true
          },
          "access_token": {
            "type": "string",
            "example": "eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJ0b2tlbl90eXBlIjoiYWNjZXNzIiwiZXhwIjoxNzY2NjM4",
            "description": "JWT access token for authenticated requests. Include this in Authorization: Bearer <token> header."
          },
          "profile_info": {
            "$ref": "#/components/schemas/ProfileInfo"
          }
        }
      },
      "UpdateProfileResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Profile updated successfully"
          },
          "success": {
            "type": "boolean",
            "example": true
          },
          "profile_info": {
            "$ref": "#/components/schemas/ProfileInfo"
          }
        }
      },
      "GetBalanceResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Balance fetched successfully"
          },
          "balance": {
            "type": "number",
            "format": "float",
            "example": 150.5,
            "description": "Current account balance in BDT"
          },
          "success": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "Transaction": {
        "type": "object",
        "properties": {
          "tnx_id": {
            "type": "integer",
            "example": 56465,
            "description": "Unique transaction ID"
          },
          "date": {
            "type": "string",
            "format": "date",
            "example": "2025-12-15",
            "description": "Transaction date"
          },
          "amount": {
            "type": "number",
            "format": "float",
            "example": 20,
            "description": "Transaction amount in BDT"
          }
        }
      },
      "TransactionHistoryResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Balance Transaction fetched successfully"
          },
          "total_count": {
            "type": "integer",
            "example": 210,
            "description": "Total number of transactions"
          },
          "transaction": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Transaction"
            },
            "description": "List of transactions (paginated)"
          },
          "success": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "CreatePaymentResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "payment_id": {
            "type": "string",
            "example": "TR0011Xxxxxxxxxxx",
            "description": "bKash payment transaction ID"
          },
          "bkash_url": {
            "type": "string",
            "format": "uri",
            "example": "https://payment.bkash.com/?paymentId=TR0011Xxxxxxxxxxx...",
            "description": "Redirect URL for bKash payment page. Open this URL in WebView or browser for user to complete payment."
          },
          "merchant_invoice_number": {
            "type": "string",
            "example": "INV123456",
            "description": "Custom invoice number if provided"
          }
        }
      },
      "PaymentErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "Validation failed"
          },
          "details": {
            "type": "string",
            "example": "Amount must be at least 1 BDT"
          }
        }
      },
      "PaymentForbiddenResponse": {
        "type": "object",
        "properties": {
          "ErrorCode": {
            "type": "integer",
            "example": 403
          },
          "ErrorMsg": {
            "type": "string",
            "example": "Forbidden! Payment restricted for this customer"
          }
        }
      }
    }
  },
  "paths": {
    "/api/kothon_new/sent_otp/": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Send OTP",
        "description": "Send a 6-digit OTP to the provided mobile number via SMS.\n\n## Rate Limiting\n- **Daily Limit**: Maximum 5 OTP requests per mobile number per day\n- **OTP Expiry**: 5 minutes from generation\n\n## Flow\n1. User enters mobile number in the app\n2. App calls this endpoint\n3. OTP is sent via SMS to the mobile number\n4. User enters OTP in the app\n5. App calls Verify OTP endpoint",
        "operationId": "sendOTP",
        "security": [
          {
            "DeviceAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendOTPRequest"
              },
              "examples": {
                "valid_number": {
                  "summary": "Valid mobile number",
                  "value": {
                    "mobile_number": "01965493210"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OTP sent successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendOTPResponse"
                },
                "examples": {
                  "success": {
                    "summary": "Success response",
                    "value": {
                      "message": "OTP has been sent successfully to 01965493210",
                      "success": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid mobile number",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "invalid_number": {
                    "summary": "Invalid number format",
                    "value": {
                      "message": "Number is not valid",
                      "success": false
                    }
                  },
                  "daily_limit": {
                    "summary": "Daily limit exceeded",
                    "value": {
                      "message": "Daily OTP limit (5) exceeded for this number",
                      "success": false
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "server_error": {
                    "value": {
                      "message": "Internal server error: SMS gateway timeout",
                      "success": false
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/kothon_new/verify_otp/": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Verify OTP",
        "description": "Verify the OTP and authenticate the user.\n\n## Behavior\n- If OTP is valid and user is **new**: Creates subscriber in MC and Sippy, returns profile with `profile_status: blocked`\n- If OTP is valid and user **exists**: Returns existing profile info\n\n## New Subscriber Flow\n1. Validates OTP against stored value\n2. Creates subscriber in Sippy server (gets DID, SIP credentials)\n3. Creates profile in MC database with `profile_status: blocked`\n4. Generates JWT access token\n5. Returns profile info with credentials\n\n## Token Usage\nThe `access_token` must be included in all subsequent authenticated requests:\n```\nAuthorization: Bearer <access_token>\n```",
        "operationId": "verifyOTP",
        "security": [
          {
            "DeviceAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyOTPRequest"
              },
              "examples": {
                "valid_otp": {
                  "summary": "Valid OTP verification",
                  "value": {
                    "mobile_number": "01965493210",
                    "otp": "123456"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OTP verified successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyOTPResponse"
                },
                "examples": {
                  "new_profile": {
                    "summary": "New subscriber (blocked)",
                    "description": "Profile just created, NID verification pending",
                    "value": {
                      "message": "OTP verified successfully",
                      "success": true,
                      "access_token": "eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJ0b2tlbl90eXBlIjoiYWNjZXNzIiwiZXhwIjoxNzY2NjM4",
                      "profile_info": {
                        "username": "MIME2564563",
                        "mobile_number": "01965493210",
                        "email": "",
                        "did_number": "0964512456",
                        "sip_username": "0964512456",
                        "sip_password": "xyz1234",
                        "profile_status": "blocked",
                        "fullname": "",
                        "balance": 0,
                        "nid_number": null,
                        "dob": null,
                        "nid_selfy": null,
                        "nid_front": null,
                        "nid_back": null
                      }
                    }
                  },
                  "existing_profile": {
                    "summary": "Existing subscriber (unblocked)",
                    "description": "Profile already verified with NID",
                    "value": {
                      "message": "OTP verified successfully",
                      "success": true,
                      "access_token": "eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJ0b2tlbl90eXBlIjoiYWNjZXNzIiwiZXhwIjoxNzY2NjM4",
                      "profile_info": {
                        "username": "MIME2564563",
                        "mobile_number": "01965493210",
                        "email": "abc_cust@gmail.com",
                        "did_number": "0964512456",
                        "sip_username": "0964512456",
                        "sip_password": "xyz1234",
                        "profile_status": "unblocked",
                        "fullname": "ABC customer",
                        "balance": 100,
                        "nid_number": "9846514564",
                        "dob": "1998-10-10",
                        "nid_selfy": "https://gateway.mimebd.com/api/kothon_new/media/nid_selfy987416566546514654.png",
                        "nid_front": "https://gateway.mimebd.com/api/kothon_new/media/nid_front987416566046514654.png",
                        "nid_back": "https://gateway.mimebd.com/api/kothon_new/media/nid_back987416586546514654.png"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid or expired OTP",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "invalid_otp": {
                    "value": {
                      "message": "OTP is invalid or expired",
                      "success": false
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Mobile number not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "not_found": {
                    "value": {
                      "message": "Mobile number not found",
                      "success": false
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/kothon_new/update_profile/": {
      "post": {
        "tags": [
          "Profile"
        ],
        "summary": "Update Profile (NID Verification)",
        "description": "Update user profile with NID information and images.\n\n## Purpose\nThis endpoint is used for:\n1. **NID Verification**: Submit NID details to unblock the account\n2. **Profile Update**: Update personal information\n\n## NID Verification Flow\n1. User submits NID number, DOB, fullname, and NID images\n2. System validates NID information\n3. If valid, updates `profile_status` to `unblocked`\n4. Updates DID status in Sippy server to allow calls\n\n## File Upload\n- Use `multipart/form-data` content type\n- Supported image formats: JPEG, PNG\n- Maximum file size: 5MB per image\n\n## Required for Verification\nFor complete verification, submit:\n- `nid_number`\n- `dob`\n- `fullname`\n- `nid_selfy`\n- `nid_front`\n- `nid_back`",
        "operationId": "updateProfile",
        "security": [
          {
            "DeviceAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProfileRequest"
              },
              "encoding": {
                "nid_selfy": {
                  "contentType": "image/jpeg, image/png"
                },
                "nid_front": {
                  "contentType": "image/jpeg, image/png"
                },
                "nid_back": {
                  "contentType": "image/jpeg, image/png"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profile updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpdateProfileResponse"
                },
                "examples": {
                  "verified": {
                    "summary": "Profile verified and unblocked",
                    "value": {
                      "message": "Profile updated successfully",
                      "success": true,
                      "profile_info": {
                        "username": "MIME2564563",
                        "mobile_number": "01965493210",
                        "email": "abc_cust@gmail.com",
                        "did_number": "0964512456",
                        "sip_username": "0964512456",
                        "sip_password": "xyz1234",
                        "profile_status": "unblocked",
                        "fullname": "ABC Customer",
                        "balance": 0,
                        "nid_number": "9846514564",
                        "dob": "1998-10-10",
                        "nid_selfy": "https://gateway.mimebd.com/api/kothon_new/media/nid_selfy987416566546514654.png",
                        "nid_front": "https://gateway.mimebd.com/api/kothon_new/media/nid_front987416566046514654.png",
                        "nid_back": "https://gateway.mimebd.com/api/kothon_new/media/nid_back987416586546514654.png"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "invalid_nid": {
                    "value": {
                      "message": "Invalid request: NID number must be 10 or 17 digits",
                      "success": false
                    }
                  },
                  "invalid_dob": {
                    "value": {
                      "message": "Invalid request: Invalid date format for dob",
                      "success": false
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Invalid or missing token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Profile not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "not_found": {
                    "value": {
                      "message": "Profile not found for this mobile number",
                      "success": false
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/kothon_new/get_balance/": {
