    "/api/kothon_new/transaction_history/": {
      "get": {
        "tags": [
          "Balance"
        ],
        "summary": "Get Transaction History",
        "description": "Retrieve paginated balance transaction history.\n\n## Pagination\nUse query parameters for pagination:\n- `page`: Page number (default: 1)\n- `limit`: Items per page (default: 20, max: 100)",
        "operationId": "getTransactionHistory",
        "security": [
          {
            "DeviceAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Page number for pagination",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "example": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Number of items per page",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "example": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Transaction history fetched successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionHistoryResponse"
                },
                "examples": {
                  "success": {
                    "value": {
                      "message": "Balance Transaction fetched successfully",
                      "total_count": 210,
                      "transaction": [
                        {
                          "tnx_id": 56465,
                          "date": "2025-12-15",
                          "amount": 20
                        },
                        {
                          "tnx_id": 56464,
                          "date": "2025-12-14",
                          "amount": 100
                        }
                      ],
                      "success": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Profile not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/bkash_pw/create-payment-new/": {
      "post": {
        "tags": [
          "Payment"
        ],
        "summary": "Create bKash Payment",
        "description": "Create a bKash payment request for account top-up.\n\n## Payment Flow\n1. App calls this endpoint with amount\n2. Backend creates payment request with bKash\n3. Response includes `bkash_url`\n4. App opens `bkash_url` in WebView/browser\n5. User completes payment on bKash portal\n6. bKash calls callback URL automatically\n7. Backend credits balance to user account\n8. User is redirected back to app\n\n## Important Notes\n- Minimum payment amount: 1 BDT\n- No separate execute API call required\n- Callback is handled automatically by backend",
        "operationId": "createPayment",
        "security": [
          {
            "DeviceAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePaymentRequest"
              },
              "examples": {
                "basic": {
                  "summary": "Basic payment request",
                  "value": {
                    "payer_reference": "MIME2564563",
                    "amount": 100
                  }
                },
                "with_invoice": {
                  "summary": "Payment with custom invoice",
                  "value": {
                    "payer_reference": "MIME2564563",
                    "amount": 500,
                    "callback_url": "https://gateway.mimebd.com/api/bkash_pw/callback/",
                    "intent": "sale",
                    "merchant_invoice_number": "INV123456"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Payment created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatePaymentResponse"
                },
                "examples": {
                  "success": {
                    "value": {
                      "success": true,
                      "payment_id": "TR0011Xxxxxxxxxxx",
                      "bkash_url": "https://payment.bkash.com/?paymentId=TR0011Xxxxxxxxxxx...",
                      "merchant_invoice_number": "INV123456"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentErrorResponse"
                },
                "examples": {
                  "invalid_amount": {
                    "value": {
                      "error": "Validation failed",
                      "details": "Amount must be at least 1 BDT"
                    }
                  },
                  "missing_payer": {
                    "value": {
                      "error": "Validation failed",
                      "details": "payer_reference is required"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Payment restricted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentForbiddenResponse"
                },
                "examples": {
                  "restricted": {
                    "value": {
                      "ErrorCode": 403,
                      "ErrorMsg": "Forbidden! Payment restricted for this customer"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentErrorResponse"
                },
                "examples": {
                  "bkash_error": {
                    "value": {
                      "error": "Internal server error",
                      "details": "bKash gateway timeout"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
