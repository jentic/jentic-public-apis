{
  "openapi": "3.0.3",
  "info": {
    "title": "Zillow Property Data",
    "description": "Get detailed property data from Zillow. Search by city, ZIP code, street address, Zillow Property ID, or URL. Returns 50+ fields per property including Zestimates, tax history, school ratings, and comparable sales. Supports property-type and price-range filters, a per-plan limit on properties per request (Basic 5, Pro 10, Ultra 25, Mega 50), CSV export via GET /v1/results/{job_id}?format=csv, and a GET /v1/usage endpoint for client-side budget tracking against your monthly quota.",
    "version": "1.3.0",
    "contact": {
      "name": "APIllow Support",
      "url": "https://apillow.co",
      "email": "adam@bobbyseamoss.com"
    },
    "termsOfService": "https://apillow.co/terms.html",
    "x-logo": {
      "url": "https://apillow.co/assets/logo.png"
    }
  },
  "servers": [
    {
      "url": "https://api.apillow.co",
      "description": "Production"
    }
  ],
  "paths": {
    "/v1/results/{job_id}": {
      "get": {
        "summary": "Get Batch Results",
        "operationId": "getBatchResults",
        "description": "Retrieve results for a job. Every POST /v1/properties request is asynchronous: it returns a job_id with status \"processing\" immediately. Poll this endpoint every 10-15 seconds until status is \"complete\" or \"failed\" (each poll counts as a request). **Prefer `webhook_url` on the original request over polling** \u2014 you get one callback the moment the job finishes instead of running a poll loop.\n\n**CSV export**: add `?format=csv` to download the successful properties as a flat spreadsheet (one row per property, ~42 columns) once the job is complete. While the job is still processing or has failed, the JSON status is returned regardless of `format`, so existing poll loops keep working. Nested fields (price_history, tax_history, nearby_schools, comps) are emitted as JSON strings in single cells; feature lists are joined with \"; \".\n\n**Ownership**: results are only readable by the API key that submitted the job. Any other key gets 404, identical to an unknown job_id.",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Job ID returned from POST /v1/properties"
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "csv"
              ],
              "default": "json"
            },
            "description": "Response format. 'json' (default) returns the full structured response. 'csv' returns successful properties as a downloadable text/csv file once the job is complete."
          }
        ],
        "responses": {
          "200": {
            "description": "Job results. Content type is application/json by default, or text/csv when format=csv and the job is complete.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PropertyResponse"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Job not found, or found but submitted by a different API key"
          }
        }
      }
    },
    "/v1/properties": {
      "post": {
        "summary": "Get Property Data",
        "operationId": "getPropertyData",
        "description": "Get detailed property data from Zillow. Accepts five input types -- use any combination:\n\n- **search**: Free-text query like \"Los Angeles\" or \"Miami Beach FL\"\n- **zipcodes**: Array of US ZIP codes like [90210, 90211]\n- **zpids**: Array of Zillow Property IDs like [20794780]\n- **addresses**: Street addresses like \"123 Main St, City, ST 12345\"\n- **urls**: Zillow listing URLs or search page URLs\n\n**Filters** (all optional):\n- **type**: Listing status \u2014 sale, rent, sold, fsbo, all (default). Works on its own for zipcodes searches \u2014 no need to also set property_type.\n- **property_type**: house, condo, townhouse, land, apartment, manufactured, multi_family\n- **price_min** / **price_max**: Price range in USD, applied at the search level\n\n**Per-request limit**: Every request returns at most your plan's limit, for all input types: Basic 5, Pro 10, Ultra 25, Mega 50 properties. `max_items` above the limit is lowered to it; more addresses/zpids/urls than the limit returns 400. To cover more listings, split by ZIP code, property type, or price range and make one request per slice.\n\nAll requests are **async** for maximum speed. Returns a job_id instantly (under 100ms). Poll GET /v1/results/{job_id} every 10-15 seconds until status is complete, or set `webhook_url` to skip polling and get a callback when the job finishes. Results typically ready in 3-10 seconds for small batches, up to ~60s for 200+ properties. Results are only readable by the API key that submitted the job.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PropertyRequest"
              },
              "examples": {
                "searchByCity": {
                  "summary": "Search by city name",
                  "value": {
                    "search": "Los Angeles",
                    "type": "sale",
                    "max_items": 5
                  }
                },
                "searchByZipCode": {
                  "summary": "Search by ZIP code",
                  "value": {
                    "zipcodes": [
                      90210
                    ],
                    "type": "sale",
                    "max_items": 10
                  }
                },
                "getByZPID": {
                  "summary": "Get specific properties by ZPID",
                  "value": {
                    "zpids": [
                      20794780,
                      20637558
                    ]
                  }
                },
                "getByURL": {
                  "summary": "Get specific listing URLs",
                  "value": {
                    "urls": [
                      "https://www.zillow.com/homedetails/1735-N-Fuller-Ave-APT-425-Los-Angeles-CA-90046/20794780_zpid/"
                    ]
                  }
                },
                "searchURL": {
                  "summary": "Get listings from a Zillow search page",
                  "value": {
                    "urls": [
                      "https://www.zillow.com/beverly-hills-ca/"
                    ],
                    "type": "sale",
                    "max_items": 20
                  }
                },
                "getByAddress": {
                  "summary": "Look up by street address",
                  "value": {
                    "addresses": [
                      "22525 Shaker Blvd, Shaker Heights, OH 44122"
                    ]
                  }
                },
                "filterLandUnderPrice": {
                  "summary": "Filter to vacant land under $50,000",
                  "description": "Combines property_type and price_max for focused queries.",
                  "value": {
                    "zipcodes": [
                      80831,
                      80832
                    ],
                    "type": "sale",
                    "property_type": "land",
                    "price_max": 50000,
                    "max_items": 25
                  }
                },
                "condoPriceRange": {
                  "summary": "Condos between $200K and $500K",
                  "value": {
                    "search": "Miami Beach FL",
                    "type": "sale",
                    "property_type": "condo",
                    "price_min": 200000,
                    "price_max": 500000,
                    "max_items": 50
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Property data results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PropertyResponse"
                },
                "example": {
                  "job_id": "4a021afd-c429-45c7-b29a-941d55535c95",
                  "status": "complete",
                  "results": [
                    {
                      "url": "https://www.zillow.com/homedetails/1735-N-Fuller-Ave-APT-425-Los-Angeles-CA-90046/20794780_zpid/",
                      "success": true,
                      "zpid": 20794780,
                      "status_code": 200,
                      "attempts": 1,
                      "elapsed_seconds": 2.8,
                      "property": {
                        "zpid": 20794780,
                        "street_address": "1735 N Fuller Ave APT 425",
                        "city": "Los Angeles",
                        "state": "CA",
                        "zipcode": "90046",
                        "latitude": 34.10276,
                        "longitude": -118.34929,
                        "price": 379888,
                        "zestimate": 374200,
                        "rent_zestimate": 2206,
                        "bedrooms": 1,
                        "bathrooms": 1.0,
                        "living_area": 513,
                        "lot_size": 86449.0,
                        "year_built": 1974,
                        "property_type": "CONDO",
                        "home_status": "FOR_SALE",
                        "hoa_fee": 553.0,
                        "days_on_zillow": 7,
                        "page_view_count": 1502,
                        "favorite_count": 62,
                        "description": "Top Floor end unit condo in the heart of Hollywood Hills...",
                        "price_history": [
                          {
                            "date": "2026-03-27",
                            "event": "Listed for sale",
                            "price": 379888,
                            "source": "CRMLS"
                          },
                          {
                            "date": "2001-06-27",
                            "event": "Sold",
                            "price": 94500,
                            "source": "Public Record"
                          }
                        ],
                        "tax_history": [
                          {
                            "year": 2025,
                            "tax_paid": 1861.77,
                            "value": 142370
                          }
                        ],
                        "listing_agent": {
                          "name": "Lynn Fitzpatrick",
                          "phone": "925-548-4105",
                          "company": "Century 21 Masters"
                        },
                        "listing_broker": "Century 21 Masters",
                        "listing_owner": null,
                        "nearby_schools": [
                          {
                            "name": "Gardner Street Elementary",
                            "rating": 8,
                            "grades": "K-5",
                            "distance": 0.3
                          }
                        ],
                        "image_urls": [
                          "https://photos.zillowstatic.com/fp/00bc4fa350c74b1c9e668baa89df44f0-cc_ft_192.jpg"
                        ]
                      }
                    }
                  ],
                  "errors": []
                }
              }
            }
          },
          "400": {
            "description": "No valid input provided. Supply at least one of: urls, search, zpids, or zipcodes."
          },
          "401": {
            "description": "Invalid or missing API key"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
    "/v1/usage": {
      "get": {
        "summary": "Get Account Usage",
        "operationId": "getAccountUsage",
        "description": "Return the caller's current monthly usage, plan, and quota. Useful for client-side budget tracking and dashboards.\n\n**Calling this endpoint does not consume quota.** It reads your usage counter but never increments it, so it's safe to poll for client-side budget tracking. Standard per-plan rate limits still apply.\n\n**Reservation-inclusive counting**: `used_this_month` counts in-flight jobs at their submitted `max_items` and settles downward as jobs complete and unused portions are refunded. This matches the number the server uses internally to enforce the monthly limit.\n\n**Period**: Quota resets on the 1st of each calendar month (UTC). The response includes `billing_period_start` and `billing_period_end` so clients can render an accurate \"X days left in period\" indicator.\n\n**Overages**: Paid plans (Pro, Ultra, Mega) allow usage beyond `monthly_limit` and bill at `overage_rate_per_1k` per 1,000 additional requests. Free plans and grandfathered hard-capped accounts return `overage_rate_per_1k: null` and never exceed the limit.\n\nAuthentication is required but quota is **not** enforced on this endpoint -- you can always retrieve your own usage even after exceeding the monthly limit.",
        "responses": {
          "200": {
            "description": "Current usage and quota",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsageResponse"
                },
                "examples": {
                  "paidPlanWithOverages": {
                    "summary": "Ultra plan, mid-month, with overages",
                    "value": {
                      "plan": "ultra",
                      "monthly_limit": 10000,
                      "used_this_month": 10250,
                      "remaining": 0,
                      "overage_count": 250,
                      "overage_rate_per_1k": 5.0,
                      "billing_period_start": "2026-05-01T00:00:00+00:00",
                      "billing_period_end": "2026-06-01T00:00:00+00:00"
                    }
                  },
                  "freePlan": {
                    "summary": "Free plan with usage left",
                    "value": {
                      "plan": "free",
                      "monthly_limit": 50,
                      "used_this_month": 12,
                      "remaining": 38,
                      "overage_count": 0,
                      "overage_rate_per_1k": null,
                      "billing_period_start": "2026-05-01T00:00:00+00:00",
                      "billing_period_end": "2026-06-01T00:00:00+00:00"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing API key"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PropertyData": {
        "type": "object",
        "description": "Complete Zillow property data with 50+ fields",
        "properties": {
          "zpid": {
            "type": "integer",
            "description": "Zillow Property ID"
          },
          "url": {
            "type": "string",
            "description": "Canonical Zillow listing URL"
          },
          "street_address": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "zipcode": {
            "type": "string"
          },
          "latitude": {
            "type": "number"
          },
          "longitude": {
            "type": "number"
          },
          "price": {
            "type": "integer",
            "description": "Listing price in USD"
          },
          "last_sold_price": {
            "type": "integer",
            "description": "Last recorded sale price"
          },
          "last_sold_date": {
            "type": "string",
            "format": "date",
            "description": "Date of the last recorded sale (ISO YYYY-MM-DD). Sourced from Zillow's sale record, falling back to a Sold event in price history. Populated for essentially every property that has a last_sold_price."
          },
          "currency": {
            "type": "string",
            "default": "USD"
          },
          "zestimate": {
            "type": "integer",
            "description": "Zillow's estimated market value. Null for active listings (FOR_SALE, FOR_RENT, PENDING, CONTINGENT) \u2014 Zillow only exposes a Zestimate for sold/off-market homes. Use the price field for active listings."
          },
          "rent_zestimate": {
            "type": "integer",
            "description": "Zillow's estimated monthly rent"
          },
          "tax_assessed_value": {
            "type": "integer"
          },
          "bedrooms": {
            "type": "integer"
          },
          "bathrooms": {
            "type": "number"
          },
          "living_area": {
            "type": "integer",
            "description": "Interior square footage"
          },
          "lot_size": {
            "type": "number",
            "description": "Lot size in sqft"
          },
          "year_built": {
            "type": "integer"
          },
          "stories": {
            "type": "integer"
          },
          "property_type": {
            "type": "string",
            "description": "SINGLE_FAMILY, CONDO, TOWNHOUSE, MULTI_FAMILY, LOT, etc."
          },
          "home_status": {
            "type": "string",
            "description": "FOR_SALE, SOLD, FOR_RENT, OTHER"
          },
          "description": {
            "type": "string",
            "description": "Full listing description text"
          },
          "hoa_fee": {
            "type": "number",
            "description": "Monthly HOA fee"
          },
          "days_on_zillow": {
            "type": "integer"
          },
          "page_view_count": {
            "type": "integer",
            "description": "Total page views on Zillow"
          },
          "favorite_count": {
            "type": "integer",
            "description": "Times favorited on Zillow"
          },
          "price_history": {
            "type": "array",
            "description": "Historical price events",
            "items": {
              "type": "object",
              "properties": {
                "date": {
                  "type": "string"
                },
                "event": {
                  "type": "string",
                  "description": "Listed for sale, Sold, Price change, etc."
                },
                "price": {
                  "type": "integer"
                },
                "source": {
                  "type": "string"
                }
              }
            }
          },
          "tax_history": {
            "type": "array",
            "description": "Property tax records by year",
            "items": {
              "type": "object",
              "properties": {
                "year": {
                  "type": "integer"
                },
                "tax_paid": {
                  "type": "number"
                },
                "value": {
                  "type": "integer",
                  "description": "Assessed value"
                }
              }
            }
          },
          "listing_agent": {
            "type": "object",
            "description": "Listing agent contact information",
            "properties": {
              "name": {
                "type": "string"
              },
              "phone": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "company": {
                "type": "string"
              }
            }
          },
          "listing_broker": {
            "type": "string"
          },
          "listing_owner": {
            "type": "object",
            "nullable": true,
            "description": "For-sale-by-owner seller contact. Present only on active FSBO listings where Zillow shows the seller-provided phone; null otherwise, including every agent-listed, pending, and sold home. display_name is Zillow's generic \"Property Owner\" label, not the owner's name; the phone is what the seller gave Zillow, not verified ownership.",
            "properties": {
              "display_name": {
                "type": "string",
                "example": "Property Owner"
              },
              "phone": {
                "type": "string",
                "description": "Formatted NNN-NNN-NNNN",
                "example": "404-555-0142"
              }
            }
          },
          "nearby_schools": {
            "type": "array",
            "description": "Nearby schools with ratings",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "rating": {
                  "type": "integer",
                  "description": "Rating out of 10"
                },
                "level": {
                  "type": "string"
                },
                "grades": {
                  "type": "string",
                  "description": "e.g. K-5, 6-8, 9-12"
                },
                "distance": {
                  "type": "number",
                  "description": "Distance in miles"
                },
                "type": {
                  "type": "string"
                }
              }
            }
          },
          "comps": {
            "type": "array",
            "description": "Comparable homes (recently sold or currently for-sale nearby). No sold date is available on a comp; for a FOR_RENT comp, price is the monthly rent. To get sold dates and Zestimates for comps, fetch them in a separate request by their url (not zpid \u2014 zpid lookups take about twice as long).",
            "items": {
              "type": "object",
              "properties": {
                "zpid": {
                  "type": "integer"
                },
                "address": {
                  "type": "string"
                },
                "price": {
                  "type": "integer",
                  "description": "Sale price, list price, or monthly rent for a FOR_RENT comp"
                },
                "bedrooms": {
                  "type": "integer"
                },
                "bathrooms": {
                  "type": "number"
                },
                "living_area": {
                  "type": "integer"
                },
                "home_status": {
                  "type": "string",
                  "description": "e.g. RECENTLY_SOLD, FOR_SALE"
                },
                "url": {
                  "type": "string"
                },
                "latitude": {
                  "type": "number"
                },
                "longitude": {
                  "type": "number"
                }
              }
            }
          },
          "image_urls": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Property photo URLs"
          },
          "virtual_tour_url": {
            "type": "string"
          },
          "interior_features": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exterior_features": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scraped_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PropertyRequest": {
        "type": "object",
        "description": "Property data request. At least one input field is required (urls, search, addresses, zipcodes, or zpids).",
        "properties": {
          "urls": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 1000,
            "description": "Zillow URLs. Accepts both listing URLs (containing _zpid/) and search page URLs (e.g. zillow.com/los-angeles-ca/)."
          },
          "search": {
            "type": "string",
            "description": "Free-text search query. Examples: \"Los Angeles\", \"Miami Beach FL\", \"90210\""
          },
          "addresses": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Street addresses to look up. Each address must include a city and state, or a ZIP code \u2014 a bare street line such as \"766 Throne Dr\" matches many streets nationwide and will not resolve to a property. Example: [\"22525 Shaker Blvd, Shaker Heights, OH 44122\"]"
          },
          "zpids": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "Zillow Property IDs to look up directly."
          },
          "zipcodes": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "US ZIP codes to search for listings."
          },
          "type": {
            "type": "string",
            "enum": [
              "all",
              "sale",
              "fsbo",
              "rent",
              "sold"
            ],
            "default": "all",
            "description": "Filter by listing type."
          },
          "max_items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "default": 200,
            "description": "Maximum number of results to return. Lowered automatically to your plan's per-request limit for every input type: Basic 5, Pro 10, Ultra 25, Mega 50."
          },
          "webhook_url": {
            "type": "string",
            "description": "Optional public http(s) URL to receive a POST callback when the job finishes, instead of polling GET /v1/results. Must resolve to a public host (no loopback/private/link-local addresses); a non-public or non-http(s) URL is rejected with 400. Body: {job_id, status, result_count, error_count, results_url, completed_at} \u2014 results themselves are never included, fetch them from results_url. Headers: X-Apillow-Event: job.completed, User-Agent: apillow-webhook/1. Delivered on up to 3 attempts (immediately, +30s, +4min), 10s timeout each; any 2xx response counts as delivered; redirects are not followed. Delivery status is reported back on the job as webhook: {status, attempts, last_status, delivered_at}."
          },
          "property_type": {
            "type": "string",
            "enum": [
              "house",
              "condo",
              "townhouse",
              "land",
              "apartment",
              "manufactured",
              "multi_family"
            ],
            "description": "Filter results by property type. Applied at the Zillow search level so only matching types are scraped."
          },
          "price_min": {
            "type": "integer",
            "minimum": 0,
            "description": "Minimum price filter in USD. Applied at the Zillow search level."
          },
          "price_max": {
            "type": "integer",
            "minimum": 0,
            "description": "Maximum price filter in USD. Applied at the Zillow search level. Useful for finding properties under a budget cap."
          }
        }
      },
      "PropertyResponse": {
        "type": "object",
        "properties": {
          "job_id": {
            "type": "string",
            "description": "Unique job identifier"
          },
          "status": {
            "type": "string",
            "enum": [
              "complete",
              "processing",
              "failed"
            ],
            "description": "Job status. Poll /v1/results/{job_id} while status is \"processing\"."
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PropertyResult"
            },
            "description": "Successfully retrieved properties"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PropertyError"
            },
            "description": "Failed retrieval attempts with error details"
          },
          "webhook": {
            "type": "object",
            "nullable": true,
            "description": "Delivery status of the webhook_url notification, if one was submitted; null otherwise.",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "pending",
                  "delivered",
                  "failed"
                ]
              },
              "attempts": {
                "type": "integer"
              },
              "last_status": {
                "type": "integer",
                "nullable": true,
                "description": "HTTP status code of the most recent delivery attempt"
              },
              "delivered_at": {
                "type": "string",
                "format": "date-time",
                "nullable": true
              }
            }
          }
        }
      },
      "PropertyResult": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Zillow listing URL that was retrieved"
          },
          "success": {
            "type": "boolean"
          },
          "zpid": {
            "type": "integer",
            "description": "Zillow Property ID"
          },
          "status_code": {
            "type": "integer",
            "description": "HTTP status code from Zillow"
          },
          "attempts": {
            "type": "integer",
            "description": "Number of retry attempts"
          },
          "elapsed_seconds": {
            "type": "number",
            "description": "Time taken to retrieve this listing"
          },
          "property": {
            "$ref": "#/components/schemas/PropertyData"
          }
        }
      },
      "PropertyError": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "success": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "error": {
            "type": "string",
            "description": "Error message"
          },
          "attempts": {
            "type": "integer"
          },
          "status_code": {
            "type": "integer"
          }
        }
      },
      "UsageResponse": {
        "type": "object",
        "required": [
          "plan",
          "monthly_limit",
          "used_this_month",
          "remaining",
          "overage_count",
          "overage_rate_per_1k",
          "billing_period_start",
          "billing_period_end"
        ],
        "properties": {
          "plan": {
            "type": "string",
            "enum": [
              "free",
              "pro",
              "ultra",
              "mega"
            ],
            "description": "Current plan name."
          },
          "monthly_limit": {
            "type": "integer",
            "description": "Included monthly request quota for the plan."
          },
          "used_this_month": {
            "type": "integer",
            "description": "Current usage in the active billing period. Reservation-inclusive: in-flight jobs are counted at their submitted max_items and the number settles downward as jobs complete and unused portions are refunded."
          },
          "remaining": {
            "type": "integer",
            "description": "monthly_limit minus used_this_month, floored at 0. On paid plans, further requests beyond this are billed at overage_rate_per_1k."
          },
          "overage_count": {
            "type": "integer",
            "description": "Requests served beyond monthly_limit so far this period. 0 unless used_this_month > monthly_limit on a paid plan with overages enabled."
          },
          "overage_rate_per_1k": {
            "type": "number",
            "nullable": true,
            "description": "USD price per 1,000 overage requests. Null for free plans and grandfathered hard-capped accounts."
          },
          "billing_period_start": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 UTC start of the current quota period (1st of the calendar month)."
          },
          "billing_period_end": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 UTC end of the current quota period (1st of the next calendar month, exclusive)."
          }
        }
      }
    },
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Your APIllow API key. Get a free key at https://apillow.co (50 properties/month, no credit card)."
      }
    }
  },
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "externalDocs": {
    "description": "APIllow documentation",
    "url": "https://apillow.co/docs.html"
  }
}