            "CreateCustomerRequest": {
                "additionalProperties": false,
                "description": "Body for POST /v1/customers. external_id is the natural idempotency key —\nre-posting updates the existing customer (merge; an address replaces whole).",
                "properties": {
                    "external_id": {
                        "maxLength": 255,
                        "minLength": 1,
                        "title": "External Id",
                        "type": "string"
                    },
                    "name": {
                        "anyOf": [
                            {
                                "maxLength": 1024,
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null,
                        "title": "Name"
                    },
                    "email": {
                        "anyOf": [
                            {
                                "maxLength": 255,
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null,
                        "title": "Email"
                    },
                    "billing_address": {
                        "anyOf": [
                            {
                                "$ref": "#/components/schemas/AddressRequest"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null
                    },
                    "shipping_address": {
                        "anyOf": [
                            {
                                "$ref": "#/components/schemas/AddressRequest"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null
                    },
                    "tax_ids": {
                        "anyOf": [
                            {
                                "items": {
                                    "$ref": "#/components/schemas/CustomerTaxIdRequest"
                                },
                                "type": "array"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null,
                        "title": "Tax Ids"
                    },
                    "tax_exempt": {
                        "anyOf": [
                            {
                                "type": "boolean"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null,
                        "title": "Tax Exempt"
                    }
                },
                "required": [
                    "external_id"
                ],
                "title": "CreateCustomerRequest",
                "type": "object"
            },
            "CreateProductRequest": {
                "additionalProperties": false,
                "description": "Body for ``POST /v1/products``.\n\n``external_id`` is the caller's own product identifier and doubles as the\nnatural idempotency key: re-posting the same ``external_id`` updates the\nexisting product (merge — only the fields you send change).",
                "properties": {
                    "external_id": {
                        "maxLength": 255,
                        "minLength": 1,
                        "title": "External Id",
                        "type": "string"
                    },
                    "name": {
                        "anyOf": [
                            {
                                "maxLength": 1024,
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null,
                        "title": "Name"
                    },
                    "description": {
                        "anyOf": [
                            {
                                "maxLength": 4096,
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null,
                        "title": "Description"
                    },
                    "tax_code": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null,
                        "title": "Tax Code"
                    },
                    "active": {
                        "default": true,
                        "title": "Active",
                        "type": "boolean"
                    }
                },
                "required": [
                    "external_id"
                ],
                "title": "CreateProductRequest",
                "type": "object"
            },
            "CreateTransactionRequest": {
                "additionalProperties": false,
                "description": "Body for POST /v1/transactions. ``external_id`` is the natural\nidempotency key. ``customer_id`` / ``product_id`` / ``original_transaction_id``\nall reference the caller's own external ids (never Sphere PKs). The customer\nand each line's product are created if missing, and the inline detail here\n(``customer_name`` / ``customer_email`` / ``customer_tax_ids`` /\n``customer_tax_exempt`` / ``billing_address`` and each line's\n``product_name`` / ``product_tax_code``) is applied whenever sent — omitted\nfields keep the record's current value.",
                "properties": {
                    "external_id": {
                        "maxLength": 255,
                        "minLength": 1,
                        "title": "External Id",
                        "type": "string"
                    },
                    "type": {
                        "allOf": [
                            {
                                "$ref": "#/components/schemas/TypeEnum"
                            }
                        ],
                        "title": "Type"
                    },
                    "status": {
                        "allOf": [
                            {
                                "$ref": "#/components/schemas/CreateTransactionRequestStatusEnum"
                            }
                        ],
                        "title": "Status"
                    },
                    "currency": {
                        "description": "ISO 4217 currency code, e.g. USD.",
                        "maxLength": 3,
                        "minLength": 3,
                        "title": "Currency",
                        "type": "string"
                    },
                    "customer_id": {
                        "maxLength": 255,
                        "minLength": 1,
                        "title": "Customer Id",
                        "type": "string"
                    },
                    "finalized_on": {
                        "anyOf": [
                            {
                                "format": "date-time",
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null,
                        "title": "Finalized On"
                    },
                    "external_reference_number": {
                        "anyOf": [
                            {
                                "maxLength": 255,
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null,
                        "title": "External Reference Number"
                    },
                    "billing_address": {
                        "anyOf": [
                            {
                                "$ref": "#/components/schemas/AddressRequest"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null
                    },
                    "shipping_address": {
                        "anyOf": [
                            {
                                "$ref": "#/components/schemas/AddressRequest"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null
                    },
                    "line_items": {
                        "items": {
                            "$ref": "#/components/schemas/TransactionLineItemRequest"
                        },
                        "minItems": 1,
                        "title": "Line Items",
                        "type": "array"
                    },
                    "original_transaction_id": {
                        "anyOf": [
                            {
                                "maxLength": 255,
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null,
                        "title": "Original Transaction Id"
                    },
                    "description": {
                        "anyOf": [
                            {
                                "maxLength": 1024,
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null,
                        "title": "Description"
                    },
                    "customer_name": {
                        "anyOf": [
                            {
                                "maxLength": 1024,
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null,
                        "title": "Customer Name"
                    },
                    "customer_email": {
                        "anyOf": [
                            {
                                "maxLength": 255,
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null,
                        "title": "Customer Email"
                    },
                    "customer_tax_ids": {
                        "anyOf": [
                            {
                                "items": {
                                    "$ref": "#/components/schemas/CustomerTaxIdRequest"
                                },
                                "type": "array"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null,
                        "title": "Customer Tax Ids"
                    },
                    "customer_tax_exempt": {
                        "anyOf": [
                            {
                                "type": "boolean"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null,
                        "title": "Customer Tax Exempt"
                    }
                },
                "required": [
                    "external_id",
                    "type",
                    "status",
                    "currency",
                    "customer_id",
                    "line_items"
                ],
                "title": "CreateTransactionRequest",
                "type": "object"
            },
            "CreateTransactionRequestStatusEnum": {
                "enum": [
                    "pending",
                    "finalized"
                ],
                "type": "string"
            },
