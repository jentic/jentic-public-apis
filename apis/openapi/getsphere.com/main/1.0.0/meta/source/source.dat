{
    "openapi": "3.1.0",
    "info": {
        "title": "Sphere API",
        "version": "1.0.0"
    },
    "paths": {
        "/customers": {
            "post": {
                "operationId": "customers_create",
                "description": "Creates a customer, or merges into the existing one with the same external_id. Only the fields you send change; an address you send replaces the stored one in full.",
                "summary": "Create or update a customer",
                "tags": [
                    "Customers"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CreateCustomerRequest"
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/CreateCustomerRequest"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/CreateCustomerRequest"
                            }
                        }
                    },
                    "required": true
                },
                "security": [
                    {
                        "apiKeyAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/CustomerResponse"
                                }
                            }
                        },
                        "description": ""
                    },
                    "400": {
                        "description": "Validation error, keyed by the failing field."
                    },
                    "403": {
                        "description": "Missing, invalid, or inactive API key, or a key not provisioned for the Transaction API."
                    },
                    "429": {
                        "description": "Rate limit exceeded. Carries Retry-After and RateLimit-* headers."
                    }
                }
            }
        },
        "/customers/{external_id}": {
            "get": {
                "operationId": "customers_retrieve",
                "description": "Base for every public v1 endpoint (products, and customers/transactions\nlater) — named for the surface, not any one resource.",
                "summary": "Retrieve a customer",
                "parameters": [
                    {
                        "in": "path",
                        "name": "external_id",
                        "schema": {
                            "type": "string"
                        },
                        "description": "The external_id you assigned to the record.",
                        "required": true
                    }
                ],
                "tags": [
                    "Customers"
                ],
                "security": [
                    {
                        "apiKeyAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/CustomerResponse"
                                }
                            }
                        },
                        "description": ""
                    },
                    "403": {
                        "description": "Missing, invalid, or inactive API key, or a key not provisioned for the Transaction API."
                    },
                    "404": {
                        "description": "No record with that external_id."
                    },
                    "429": {
                        "description": "Rate limit exceeded. Carries Retry-After and RateLimit-* headers."
                    }
                }
            }
        },
        "/products": {
            "post": {
                "operationId": "products_create",
                "description": "Creates a product, or merges into the existing one with the same external_id. Assign a Sphere product tax code so the engine can determine taxability and rates. With an API key associated to a billing integration connection, external_id is that system's product idand the write updates the synced product in place.",
                "summary": "Create or update a product",
                "tags": [
                    "Products"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CreateProductRequest"
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/CreateProductRequest"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/CreateProductRequest"
                            }
                        }
                    },
                    "required": true
                },
                "security": [
                    {
                        "apiKeyAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProductResponse"
                                }
                            }
                        },
                        "description": ""
                    },
                    "400": {
                        "description": "Validation error, keyed by the failing field."
                    },
                    "403": {
                        "description": "Missing, invalid, or inactive API key."
                    },
                    "429": {
                        "description": "Rate limit exceeded. Carries Retry-After and RateLimit-* headers."
                    }
                }
            }
        },
        "/products/{external_id}": {
            "get": {
                "operationId": "products_retrieve",
                "description": "Base for every public v1 endpoint (products, and customers/transactions\nlater) — named for the surface, not any one resource.",
                "summary": "Retrieve a product",
                "parameters": [
                    {
                        "in": "path",
                        "name": "external_id",
                        "schema": {
                            "type": "string"
                        },
                        "description": "The external_id you assigned to the record.",
                        "required": true
                    }
                ],
                "tags": [
                    "Products"
                ],
                "security": [
                    {
                        "apiKeyAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProductResponse"
                                }
                            }
                        },
                        "description": ""
                    },
                    "403": {
                        "description": "Missing, invalid, or inactive API key."
                    },
                    "404": {
                        "description": "No record with that external_id."
                    },
                    "429": {
                        "description": "Rate limit exceeded. Carries Retry-After and RateLimit-* headers."
                    }
                }
            }
        },
        "/reports/filing_summary": {
            "get": {
                "operationId": "reports_filing_summary_retrieve",
                "description": "The Filing Summary report as JSON",
                "summary": "List filing summaries",
                "parameters": [
                    {
                        "in": "query",
                        "name": "end_date",
                        "schema": {
                            "type": "string",
                            "format": "date"
                        }
                    },
                    {
                        "in": "query",
                        "name": "start_date",
                        "schema": {
                            "type": "string",
                            "format": "date"
                        }
                    },
                    {
                        "in": "query",
                        "name": "tax_authority_key",
                        "schema": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                ],
                "tags": [
                    "Reports"
                ],
                "security": [
                    {
                        "apiKeyAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/FilingSummaryResponse"
                                }
                            }
                        },
                        "description": ""
                    },
                    "400": {
                        "description": "Validation error, keyed by the failing field."
                    },
                    "403": {
                        "description": "Missing, invalid, or inactive API key."
                    },
                    "429": {
                        "description": "Rate limit exceeded. Carries Retry-After and RateLimit-* headers."
                    }
                }
            }
        },
        "/stripe/calculate_invoice_tax": {
            "post": {
                "operationId": "stripe_calculate_invoice_tax_create",
                "description": "Calculates tax for a draft Stripe invoice and writes it onto the invoice's line items, replacing the sequence of Stripe calls you would otherwise make yourself. Hold the draft (auto_advance: false) before calling, and finalize it once this returns. Safe to retry: an invoice that already carries the same calculation comes back as unchanged.",
                "summary": "Add tax to a Stripe invoice",
                "tags": [
                    "Stripe"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CalculateStripeInvoiceTaxRequest"
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/CalculateStripeInvoiceTaxRequest"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/CalculateStripeInvoiceTaxRequest"
                            }
                        }
                    },
                    "required": true
                },
                "security": [
                    {
                        "apiKeyAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/StripeInvoiceTaxResponse"
                                }
                            }
                        },
                        "description": ""
                    },
                    "400": {
                        "description": "Validation error, keyed by the failing field."
                    },
                    "403": {
                        "description": "Missing, invalid, or inactive API key; the key is not on a Stripe connection enabled for Sphere tax calculation; or stripe_account_id does not match the key's account."
                    },
                    "404": {
                        "description": "No such invoice on the key's Stripe account."
                    },
                    "409": {
                        "description": "The invoice's current state rules out a tax write — it is no longer a draft, it has Stripe automatic tax or tax rates set, or it has no address to calculate from."
                    },
                    "429": {
                        "description": "Rate limit exceeded. Carries Retry-After and RateLimit-* headers."
                    }
                }
            }
        },
        "/stripe/checkout_sessions": {
            "post": {
                "operationId": "stripe_checkout_sessions_create",
                "description": "Send Stripe's Checkout parameters under stripe, and the buyer Sphere needs to price under sphere. Sphere calculates tax, expresses it as Tax Rate objects in your account, creates the Checkout Session with those rates and returns it. Redirect to url (hosted) or mount client_secret (embedded) exactly as you do today. When the session completes, call the complete endpoint (or let Sphere's webhook do it) so renewals are taxed by Sphere.",
                "summary": "Create a Stripe Checkout Session with Sphere tax applied",
                "tags": [
                    "Stripe"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CreateCheckoutSessionRequest"
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/CreateCheckoutSessionRequest"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/CreateCheckoutSessionRequest"
                            }
                        }
                    },
                    "required": true
                },
                "security": [
                    {
                        "apiKeyAuth": []
                    }
                ],
                "responses": {
                    "201": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/CheckoutSessionResponse"
                                }
                            }
                        },
                        "description": ""
                    },
                    "400": {
                        "description": "Validation error, keyed by the failing field."
                    },
                    "403": {
                        "description": "Missing/invalid API key, or Stripe account not enabled for Sphere tax."
                    },
                    "404": {
                        "description": "No such connected Stripe account."
                    },
                    "409": {
                        "description": "No address to calculate from, or Sphere could not calculate tax."
                    },
                    "502": {
                        "description": "Stripe refused the Checkout Session."
                    }
                }
            }
        },
        "/stripe/checkout_sessions/{external_id}/complete": {
            "post": {
                "operationId": "stripe_checkout_sessions_complete_create",
                "description": "Call from your checkout.session.completed handler. Removes the Sphere-managed Tax Rates from the new subscription's items (the first invoice keeps its tax) and stamps the first invoice with the calculation id. Safe to call more than once.",
                "summary": "Clean up after a bridge Checkout Session completes",
                "parameters": [
                    {
                        "in": "path",
                        "name": "external_id",
                        "schema": {
                            "type": "string"
                        },
                        "description": "The Stripe Checkout Session id, e.g. cs_test_a1B2c3.",
                        "required": true
                    }
                ],
                "tags": [
                    "Stripe"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CompleteCheckoutSessionRequest"
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/CompleteCheckoutSessionRequest"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/CompleteCheckoutSessionRequest"
                            }
                        }
                    }
                },
                "security": [
                    {
                        "apiKeyAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/CompleteCheckoutSessionResponse"
                                }
                            }
                        },
                        "description": ""
                    },
                    "403": {
                        "description": "Missing/invalid API key, or Stripe account not enabled for Sphere tax."
                    },
                    "404": {
                        "description": "No such connected account or Checkout Session."
                    },
                    "409": {
                        "description": "The session was not created by the Sphere bridge."
                    },
                    "502": {
                        "description": "Stripe refused the cleanup."
                    }
                }
            }
        },
        "/stripe/checkout_sessions/{external_id}/tax": {
            "post": {
                "operationId": "stripe_checkout_sessions_tax_create",
                "description": "One call for a merchant who builds their own session: Sphere reads the cart back off it, prices the buyer's address, and attaches the rates. The session must still be open. Nothing is stored.",
                "summary": "Add tax to a Stripe Checkout Session",
                "parameters": [
                    {
                        "in": "path",
                        "name": "external_id",
                        "schema": {
                            "type": "string"
                        },
                        "description": "The Stripe Checkout Session id, e.g. cs_test_a1B2c3.",
                        "required": true
                    }
                ],
                "tags": [
                    "Stripe"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CalculateStripeCheckoutSessionTaxRequest"
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/CalculateStripeCheckoutSessionTaxRequest"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/CalculateStripeCheckoutSessionTaxRequest"
                            }
                        }
                    },
                    "required": true
                },
                "security": [
                    {
                        "apiKeyAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/StripeCheckoutSessionTaxResponse"
                                }
                            }
                        },
                        "description": ""
                    },
                    "400": {
                        "description": "Validation error."
                    },
                    "403": {
                        "description": "Missing/invalid API key, or Stripe account not enabled for Sphere tax."
                    },
                    "404": {
                        "description": "No such account or session."
                    },
                    "409": {
                        "description": "The session is closed, or Sphere could not calculate tax for the address."
                    },
                    "502": {
                        "description": "Stripe refused the tax update."
                    }
                }
            }
        },
        "/transactions": {
            "post": {
                "operationId": "transactions_create",
                "description": "Create an invoice (type: debit) or a credit note (type: credit), as a pending draft or finalized in one call. A finalized request runs the tax engine and returns subtotal, tax and total. Re-posting the same external_id updates the transaction.",
                "summary": "Create a transaction",
                "tags": [
                    "Transactions"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CreateTransactionRequest"
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/CreateTransactionRequest"
                            }
                        },
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/CreateTransactionRequest"
                            }
                        }
                    },
                    "required": true
                },
                "security": [
                    {
                        "apiKeyAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/TransactionResponse"
                                }
                            }
                        },
                        "description": ""
                    },
                    "400": {
                        "description": "Validation error, keyed by the failing field."
                    },
                    "403": {
                        "description": "Missing, invalid, or inactive API key, or a key not provisioned for the Transaction API."
                    },
                    "429": {
                        "description": "Rate limit exceeded. Carries Retry-After and RateLimit-* headers."
                    }
                }
            }
        },
        "/transactions/{external_id}": {
            "get": {
                "operationId": "transactions_retrieve",
                "description": "Base for every public v1 endpoint (products, and customers/transactions\nlater) — named for the surface, not any one resource.",
                "summary": "Retrieve a transaction",
                "parameters": [
                    {
                        "in": "path",
                        "name": "external_id",
                        "schema": {
                            "type": "string"
                        },
                        "description": "The external_id you assigned to the record.",
                        "required": true
                    }
                ],
                "tags": [
                    "Transactions"
                ],
                "security": [
                    {
                        "apiKeyAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/TransactionResponse"
                                }
                            }
                        },
                        "description": ""
                    },
                    "403": {
                        "description": "Missing, invalid, or inactive API key, or a key not provisioned for the Transaction API."
                    },
                    "404": {
                        "description": "No record with that external_id."
                    },
                    "429": {
                        "description": "Rate limit exceeded. Carries Retry-After and RateLimit-* headers."
                    }
                }
            }
        },
        "/transactions/{external_id}/cancel": {
            "post": {
                "operationId": "transactions_cancel_create",
                "description": "Voids a transaction so it no longer contributes to your tax liability. No request body is needed, and the call is idempotent (re-cancelling returns the original cancelled_at).",
                "summary": "Cancel a transaction",
                "parameters": [
                    {
                        "in": "path",
                        "name": "external_id",
                        "schema": {
                            "type": "string"
                        },
                        "description": "The external_id you assigned to the record.",
                        "required": true
                    }
                ],
                "tags": [
                    "Transactions"
                ],
                "security": [
                    {
                        "apiKeyAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/CancelResponse"
                                }
                            }
                        },
                        "description": ""
                    },
                    "403": {
                        "description": "Missing, invalid, or inactive API key, or a key not provisioned for the Transaction API."
                    },
                    "404": {
                        "description": "No record with that external_id."
                    },
                    "429": {
                        "description": "Rate limit exceeded. Carries Retry-After and RateLimit-* headers."
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "Address": {
                "additionalProperties": false,
                "properties": {
                    "line1": {
                        "title": "Line1",
                        "type": "string"
                    },
                    "line2": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null,
                        "title": "Line2"
                    },
                    "city": {
                        "title": "City",
                        "type": "string"
                    },
                    "state": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null,
                        "title": "State"
                    },
                    "postal_code": {
                        "default": "",
                        "title": "Postal Code",
                        "type": "string"
                    },
                    "country": {
                        "maxLength": 2,
                        "minLength": 2,
                        "title": "Country",
                        "type": "string"
                    }
                },
                "required": [
                    "line1",
                    "city",
                    "country"
                ],
                "title": "Address",
                "type": "object"
            },
            "AddressRequest": {
                "additionalProperties": false,
                "description": "A postal address (billing or shipping).",
                "properties": {
                    "address1": {
                        "anyOf": [
                            {
                                "maxLength": 1024,
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null,
                        "title": "Address1"
                    },
                    "address2": {
                        "anyOf": [
                            {
                                "maxLength": 1024,
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null,
                        "title": "Address2"
                    },
                    "city": {
                        "anyOf": [
                            {
                                "maxLength": 255,
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null,
                        "title": "City"
                    },
                    "state": {
                        "anyOf": [
                            {
                                "maxLength": 255,
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null,
                        "title": "State"
                    },
                    "postal_code": {
                        "anyOf": [
                            {
                                "maxLength": 64,
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null,
                        "title": "Postal Code"
                    },
                    "country": {
                        "anyOf": [
                            {
                                "maxLength": 255,
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null,
                        "title": "Country"
                    }
                },
                "title": "AddressRequest",
                "type": "object"
            },
            "AddressResponse": {
                "description": "A postal address.",
                "properties": {
                    "address1": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null,
                        "title": "Address1"
                    },
                    "address2": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null,
                        "title": "Address2"
                    },
                    "city": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null,
                        "title": "City"
                    },
                    "state": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null,
                        "title": "State"
                    },
                    "postal_code": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null,
                        "title": "Postal Code"
                    },
                    "country": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null,
                        "title": "Country"
                    }
                },
                "title": "AddressResponse",
                "type": "object"
            },
            "CalculateStripeCheckoutSessionTaxRequest": {
                "additionalProperties": false,
                "description": "Retrofit tax onto a session the merchant made themselves. Nothing is stored.",
                "properties": {
                    "stripe_account_id": {
                        "anyOf": [
                            {
                                "pattern": "^acct_",
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null,
                        "title": "Stripe Account Id"
                    },
                    "billing_address": {
                        "$ref": "#/components/schemas/Address"
                    },
                    "shipping_address": {
                        "$ref": "#/components/schemas/Address"
                    },
                    "tax_ids": {
                        "items": {
                            "$ref": "#/components/schemas/CustomerTaxIdInput"
                        },
                        "title": "Tax Ids",
                        "type": "array"
