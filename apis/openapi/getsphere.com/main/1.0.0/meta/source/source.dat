            "TransactionLineItemRequest": {
                "additionalProperties": false,
                "description": "One line on a transaction. ``amount`` is a major-unit decimal (e.g.\n\"100.00\"); ``product_id`` is the caller's product external_id. The product is\ncreated if it doesn't exist, and ``product_name`` / ``product_tax_code``, when\nsent, are applied to it (created or existing) — omitted fields keep the\nproduct's current value. A product with no tax code is UNKNOWN.\n\n``quantity`` and ``unit_price`` are optional and carried through for the\ninvoice document only. ``amount`` stays the authoritative taxable total —\nthey are not cross-validated against it (discounts, tax-inclusive pricing,\nand rounding legitimately break quantity * unit_price == amount).",
                "properties": {
                    "external_id": {
                        "maxLength": 238,
                        "minLength": 1,
                        "title": "External Id",
                        "type": "string"
                    },
                    "product_id": {
                        "maxLength": 255,
                        "minLength": 1,
                        "title": "Product Id",
                        "type": "string"
                    },
                    "amount": {
                        "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                        "title": "Amount",
                        "type": "string"
                    },
                    "discount_amount": {
                        "default": "0",
                        "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                        "title": "Discount Amount",
                        "type": "string"
                    },
                    "quantity": {
                        "anyOf": [
                            {
                                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null,
                        "title": "Quantity"
                    },
                    "unit_price": {
                        "anyOf": [
                            {
                                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null,
                        "title": "Unit Price"
                    },
                    "description": {
                        "anyOf": [
                            {
                                "maxLength": 1024,
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null,
                        "title": "Description"
                    },
                    "tax_inclusive": {
                        "default": false,
                        "title": "Tax Inclusive",
                        "type": "boolean"
                    },
                    "product_name": {
                        "anyOf": [
                            {
                                "maxLength": 1024,
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null,
                        "title": "Product Name"
                    },
                    "product_tax_code": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "default": null,
                        "title": "Product Tax Code"
                    }
                },
                "required": [
                    "external_id",
                    "product_id",
                    "amount"
                ],
                "title": "TransactionLineItemRequest",
                "type": "object"
            },
            "TransactionResponse": {
                "description": "A transaction. subtotal, tax and total appear once finalized, and\noriginal_transaction_id only on credit notes.",
                "properties": {
