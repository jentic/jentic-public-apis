    "/api/register": {
      "post": {
        "summary": "註冊會員",
        "tags": [],
        "responses": {
          "200": {
            "description": "OK\nField | Type | Description\n---------|----------|---------\n status | varchar | 狀態\n message | varchar | 訊息\n apiToken | varchar | token code",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {}
                },
                "examples": {
                  "Example 1": {
                    "value": {
                      "status": "warning",
                      "message": "該Email已存在"
                    }
                  },
                  "Example 2": {
                    "value": {
                      "status": "warning",
                      "message": "該手機號碼已存在"
                    }
                  },
                  "Example 3": {
                    "value": {
                      "status": "success",
                      "message": "註冊成功",
                      "apiToken": "token code"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
