  "components": {
    "securitySchemes": {
      "mangiiKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "mangii_sk_",
        "description": "API key mangii_sk_<32 bytes base62>"
      }
    },
    "parameters": {
      "StoryId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "PanelId": {
        "name": "pid",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "headers": {
      "XRateLimitLimit": {
        "description": "Requests this key may make in the current minute bucket.",
        "schema": {
          "type": "integer"
        },
        "example": 60
      },
      "XRateLimitRemaining": {
        "description": "Requests left in the current minute bucket. Floored at 0, so a 429 always reports 0.",
        "schema": {
          "type": "integer"
        },
        "example": 59
      },
      "XRateLimitReset": {
        "description": "Unix seconds at the start of the next minute bucket, when the allowance rolls over.",
        "schema": {
          "type": "integer"
        },
        "example": 1755600120
      },
      "RetryAfter": {
        "description": "Seconds to wait before retrying. Always the full bucket width.",
        "schema": {
          "type": "integer"
        },
        "example": 60
      }
    },
    "responses": {
      "Error": {
        "description": "Uniform error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "IdempotencyCollision": {
        "description": "Idempotency-Key is already in flight (idempotency_in_progress — retry the same key) or was reused with a different body (idempotency_conflict — pick a new key).\n",
        "headers": {
          "X-RateLimit-Limit": {
            "$ref": "#/components/headers/XRateLimitLimit"
          },
          "X-RateLimit-Remaining": {
            "$ref": "#/components/headers/XRateLimitRemaining"
          },
          "X-RateLimit-Reset": {
            "$ref": "#/components/headers/XRateLimitReset"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "RateLimited": {
        "description": "Per-key rate limit exceeded for the current minute bucket. Every /v1 operation shares one per-key limiter, so any of them can return this.\n",
        "headers": {
          "X-RateLimit-Limit": {
            "$ref": "#/components/headers/XRateLimitLimit"
          },
          "X-RateLimit-Remaining": {
            "$ref": "#/components/headers/XRateLimitRemaining"
          },
          "X-RateLimit-Reset": {
            "$ref": "#/components/headers/XRateLimitReset"
          },
          "Retry-After": {
            "$ref": "#/components/headers/RetryAfter"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "type",
              "code",
              "message",
              "request_id"
            ],
            "properties": {
              "type": {
                "type": "string"
              },
              "code": {
                "type": "string",
                "enum": [
                  "invalid_key",
                  "insufficient_credits",
                  "budget_exceeded",
                  "content_blocked",
                  "gone",
                  "idempotency_conflict",
                  "idempotency_in_progress"
                ]
              },
              "message": {
                "type": "string"
              },
              "request_id": {
                "type": "string"
              },
              "buy_url": {
                "type": "string"
              }
            }
          }
        }
      },
      "Credits": {
        "type": "object",
        "required": [
          "weeklyCredits",
          "packCredits",
          "apiPackCredits"
        ],
        "properties": {
          "weeklyCredits": {
            "type": "integer"
          },
          "packCredits": {
            "type": "integer"
          },
          "apiPackCredits": {
            "type": "integer"
          },
          "spendableCredits": {
            "type": "integer",
            "description": "apiPackCredits plus current packCredits when hasEverPurchasedCredits is true. Later ad/referral grants on that pack pool also spend. Same pools useApiCredit spends."
          },
          "notes": {
            "type": "string",
            "description": "weeklyCredits is display-only and never spends on API/MCP. spendableCredits is apiPackCredits plus the current packCredits balance when hasEverPurchasedCredits is true. After a purchase, later grants into packCredits (including ad/referral) share that spendable pool. Never-purchased accounts cannot spend packCredits."
          }
        }
