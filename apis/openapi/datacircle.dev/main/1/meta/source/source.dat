                "description": "Media on the Services page."
              },
              "rating": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The services' rating."
              },
              "requestUrl": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The LinkedIn URL to request a proposal."
              },
              "servicesList": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "The services, e.g. `Business Consulting`."
              }
            },
            "required": [
              "description",
              "media",
              "rating",
              "requestUrl",
              "servicesList"
            ],
            "additionalProperties": false,
            "description": "The services the member offers (LinkedIn's Services page); `null` when none."
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "endorsements": {
                  "type": "string",
                  "description": "The endorsements as LinkedIn shows them, e.g. `51 endorsements`."
                },
                "name": {
                  "type": "string",
                  "description": "The skill."
                },
                "positions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Where the skill shows on the profile and who endorsed it, as LinkedIn words it, e.g. `Endorsed by 2 colleagues at Acme`."
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            },
            "description": "Every skill on the profile."
          },
          "topSkills": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "The skills the member put at the top of the profile."
          },
          "verified": {
            "type": "boolean",
            "description": "`true` when LinkedIn shows the member as verified."
          },
          "volunteering": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "cause": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "The cause, e.g. `Health`."
                },
                "description": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Its description, as written on the profile."
                },
                "duration": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "How long, as LinkedIn shows it."
                },
                "endDate": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "properties": {
                    "month": {
                      "type": "string",
                      "description": "The month, e.g. `Jun`."
                    },
                    "text": {
                      "type": "string",
                      "description": "The date as LinkedIn shows it."
                    },
                    "year": {
                      "type": "integer",
                      "description": "The year."
                    }
                  },
                  "required": [
                    "text"
                  ],
                  "additionalProperties": false,
                  "description": "When it ended; `text` is `Present` for a current one: `text` as LinkedIn shows it (e.g. `Jun 2010`), with `year` and `month` when LinkedIn gives them."
                },
                "organizationLinkedinUrl": {
                  "type": "string",
                  "description": "The organization's LinkedIn page."
                },
                "organizationName": {
                  "type": "string",
                  "description": "The organization."
                },
                "role": {
                  "type": "string",
                  "description": "The member's role."
                },
                "startDate": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "properties": {
                    "month": {
                      "type": "string",
                      "description": "The month, e.g. `Jun`."
                    },
                    "text": {
                      "type": "string",
                      "description": "The date as LinkedIn shows it."
                    },
                    "year": {
                      "type": "integer",
                      "description": "The year."
                    }
                  },
                  "required": [
                    "month",
                    "text",
                    "year"
                  ],
                  "additionalProperties": false,
                  "description": "When it started: `text` as LinkedIn shows it (e.g. `Jun 2010`), with `year` and `month` when LinkedIn gives them."
                }
              },
              "required": [
                "cause",
                "duration",
                "endDate",
                "organizationName",
                "role",
                "startDate"
              ],
              "additionalProperties": false
            },
            "description": "Volunteering."
          },
          "websites": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The websites listed on the profile."
          },
          "industry": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "id": {
                "type": "integer",
                "description": "LinkedIn's industry id."
              },
              "name": {
                "type": "string",
                "description": "The industry's name, e.g. `Philanthropic Fundraising Services`."
              }
            },
            "required": [
              "id",
              "name"
            ],
            "additionalProperties": false,
            "description": "The member's industry, as LinkedIn classifies it: its `id` and `name`."
          }
        },
        "required": [
          "about",
          "causes",
          "certifications",
          "connectionsCount",
          "courses",
          "coverPicture",
          "creator",
          "currentPosition",
          "education",
          "emails",
          "experience",
          "featured",
          "firstName",
          "followerCount",
          "headline",
          "hiring",
          "honorsAndAwards",
          "id",
          "influencer",
          "languages",
          "lastName",
          "linkedinUrl",
          "location",
          "memorialized",
          "moreProfiles",
          "multiLocaleHeadline",
          "objectUrn",
          "openToWork",
          "photo",
          "premium",
          "primaryLocale",
          "profileActions",
          "profileLocales",
          "profilePicture",
          "profileTopEducation",
          "projects",
          "publicIdentifier",
          "publications",
          "receivedRecommendations",
          "services",
          "skills",
          "topSkills",
          "volunteering"
        ],
        "additionalProperties": false,
        "description": "A LinkedIn profile, as HarvestAPI answers it."
      },
      "HarvestApiProfileResponse": {
        "type": "object",
        "properties": {
          "element": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/HarvestApiProfile"
              },
              {
                "type": "null"
              }
            ],
            "description": "The profile; `null` when HarvestAPI can't find it (`status` `404`) or refuses the request (`status` `400`)."
          },
          "cost": {
            "type": "number",
            "description": "What HarvestAPI billed for the call, e.g. `0.0037` for a profile, `0.0023` for a profile it can't find; on a stored answer, what the call that first fetched it was billed. Datacircle charges you the same amount in dollars (`datacircle_meta.cost_usd`, `0` on a stored answer)."
          },
          "entityId": {
            "type": [
              "string",
              "null"
            ],
            "description": "The profile's LinkedIn member id (`ACoAA…`), as `element.id`; `null` when not found."
          },
          "error": {
            "type": "string",
            "description": "HarvestAPI's message when `element` is `null`, e.g. `Profile not found`."
          },
          "free": {
            "type": "boolean",
            "description": "`true` when HarvestAPI didn't bill the call (a request it refuses)."
          },
          "originalQuery": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "description": "The profile URL HarvestAPI got."
              }
            },
            "required": [
              "url"
            ],
            "additionalProperties": false,
            "description": "The request HarvestAPI got."
          },
          "payments": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "What HarvestAPI billed, by name: `linkedinProfile` for a profile, `linkedinProfileShort` for a lookup that found nothing."
          },
          "query": {
            "type": "object",
            "properties": {
              "profileId": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The profile's LinkedIn member id (`ACoAA…`); `null` when not found."
              },
              "publicIdentifier": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The profile's slug, linkedin.com/in/<publicIdentifier>; `null` when not found."
              },
              "url": {
                "type": "string",
                "description": "The profile URL HarvestAPI read."
              }
            },
            "required": [
              "url"
            ],
            "additionalProperties": false,
            "description": "The request as HarvestAPI understood it: the `url` it read, with the `publicIdentifier` and `profileId` it resolved."
          },
          "retries": {
            "type": "integer",
            "description": "How many times HarvestAPI retried LinkedIn for this answer."
          },
          "status": {
            "type": "integer",
            "description": "HarvestAPI's own status, inside an HTTP `200`: `200` found, `404` not found, `400` a request it refuses."
          },
          "datacircle_meta": {
            "$ref": "#/components/schemas/DatacircleMeta"
          }
        },
        "required": [
          "cost",
          "element",
          "entityId",
          "originalQuery",
          "payments",
          "query",
          "retries",
          "status",
          "datacircle_meta"
        ],
        "additionalProperties": false,
        "description": "HarvestAPI's own answer to GET /linkedin/profile, minus `user` and `requestId` (our account with HarvestAPI), plus `datacircle_meta`."
      }
    }
  },
  "paths": {
    "/me/invites/": {
      "get": {
        "tags": [
          "Datacircle"
        ],
        "summary": "Get your invite link",
        "description": "Your invite link and how many people you invited signed up. What they unlock: `unlocks` and `unlocks_datasets` below, and [Files](/files).",
        "responses": {
          "200": {
            "description": "`{\"invite_url\": ..., \"signed_up_count\": 0, \"required_count\": 3, \"unlocks\": ..., \"unlocks_datasets\": [\"coop_up2data\", \"coop_harvestapi\", \"us_50m\"]}`",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "invite_url",
                    "signed_up_count",
                    "required_count",
                    "unlocks",
                    "unlocks_datasets"
                  ],
                  "properties": {
                    "invite_url": {
                      "type": "string",
                      "description": "Your own signup link: whoever signs up through it is your invitee."
                    },
                    "signed_up_count": {
                      "type": "integer",
                      "description": "How many people you invited have signed up and verified their email. People on your own email domain and deactivated accounts don't count."
                    },
                    "required_count": {
                      "type": "integer",
                      "description": "How many signed-up invitees unlock the files in `unlocks_datasets`."
                    },
                    "unlocks": {
                      "type": "string",
                      "description": "What reaching `required_count` unlocks, in words, and that $50 in funds added unlocks only the co-op file."
                    },
                    "unlocks_datasets": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "The `dataset`s in `GET /files/` that reaching `required_count` unlocks."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/me/api-key/reset/": {
      "post": {
        "tags": [
          "Datacircle"
        ],
        "summary": "Reset your API key",
        "description": "The old key stops working at once.",
        "responses": {
          "200": {
            "description": "`{\"api_key\": ...}`",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "api_key"
                  ],
                  "properties": {
                    "api_key": {
                      "type": "string",
                      "description": "Your new API key: send it as `Authorization: Token <api_key>`. The old one stopped working when this answered."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/balance/": {
      "get": {
        "tags": [
          "Datacircle"
        ],
        "summary": "Read the balance",
        "responses": {
          "200": {
            "description": "Balance split by kind",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Balance"
                }
              }
            }
          }
        }
      }
    },
    "/checkout/": {
      "post": {
        "tags": [
          "Datacircle"
        ],
        "summary": "Start a Stripe Checkout",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "amount_usd"
                ],
                "properties": {
                  "amount_usd": {
                    "description": "How much to add to your balance, in whole dollars.",
                    "type": "integer",
                    "minimum": 5,
                    "maximum": 10000
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "`{\"checkout_url\": ...}`: send the browser there",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "checkout_url"
                  ],
                  "properties": {
                    "checkout_url": {
                      "type": "string",
                      "description": "The Stripe Checkout page for this payment: open it, or hand it to a human to pay. The funds land in `funds_usd` once Stripe confirms the payment."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Amount not offered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "Stripe refused the checkout session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Payments are not configured on this server",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/files/": {
      "get": {
        "tags": [
          "Datacircle"
        ],
        "summary": "List files",
        "responses": {
          "200": {
            "description": "Every file with `is_unlocked` for this workspace",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/File"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/files/{file_id}/download-link/": {
      "post": {
        "tags": [
          "Datacircle"
        ],
        "summary": "Get a download link",
        "parameters": [
          {
            "name": "file_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "`{\"url\": ...}`, valid one hour",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "url",
                    "next_step"
                  ],
                  "properties": {
                    "url": {
                      "type": "string",
                      "description": "A signed download URL for the file, valid one hour. Fetch it as is, without your API key."
                    },
                    "next_step": {
                      "type": "object",
                      "required": [
                        "why",
                        "curls",
                        "docs_url"
                      ],
                      "properties": {
                        "why": {
                          "type": "string",
                          "description": "What the file holds and what your balance can pull for its rows."
                        },
                        "curls": {
                          "type": "array",
                          "description": "One ready-to-run call per provider. Keys never name a provider: providers come and go in the list.",
                          "items": {
                            "type": "object",
                            "required": [
                              "provider",
                              "curl"
                            ],
                            "properties": {
                              "provider": {
                                "type": "string",
                                "description": "The provider the call goes to, e.g. `up2data` or `harvestapi`."
                              },
                              "curl": {
                                "type": "string",
                                "description": "A ready-to-run curl, your API key filled in."
                              }
                            }
                          }
                        },
                        "docs_url": {
                          "type": "string",
                          "description": "Where Datacircle's docs are (a URL)."
                        }
                      },
                      "description": "What to do with the file next: pull the live LinkedIn profile behind any row, at the provider's cost."
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Not unlocked for this workspace: `error` says why, and how to unlock it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/profiles/enrich": {
      "post": {
        "tags": [
          "Up2Data"
        ],
        "summary": "Enrich one LinkedIn profile",
        "description": "Up2Data's own request (https://api.up2data.ai/v1/profiles/enrich), sent to api.datacircle.dev with your Datacircle key in `Authorization` and `X-Data-Provider: up2data`. Nothing else changes. $0.00125 per profile found (Up2Data's price, no markup).",
        "parameters": [
          {
            "name": "X-Data-Provider",
            "in": "header",
            "required": true,
            "description": "names the provider: `up2data`. With the host, the only change from the provider's own request.",
            "schema": {
              "type": "string",
              "enum": [
                "up2data"
              ],
              "default": "up2data"
            },
            "example": "up2data"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "url"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "description": "the profile's LinkedIn URL (`https://www.linkedin.com/in/williamhgates`); Up2Data refuses a bare public identifier with its own `400`"
                  },
                  "fields": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Restrict response to these top-level fields. Same cost. Listing followers_count or connections_count also opts into the extra scrape; listing skill_endorsements also opts into the full-skills scrape."
                  },
                  "with_followers_and_connections": {
                    "type": "boolean",
                    "default": false,
                    "description": "Include followers_count and connections_count. Off by default — those numbers are a second LinkedIn request, not part of the main profile scrape. Same price; extra latency.\n"
                  },
                  "with_full_skills_and_endorsements": {
                    "type": "boolean",
                    "default": false,
                    "description": "Return every skill LinkedIn exposes (up to LinkedIn's own 50-skill cap) plus skill_endorsements. Off by default — skills is capped at the first 20 without it, and this is a second LinkedIn request. Same price; extra latency.\n"
                  }
                },
                "additionalProperties": false
              },
              "example": {
                "url": "https://www.linkedin.com/in/williamhgates"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Up2Data's answer plus `datacircle_meta`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Up2DataEnrichResponse"
                },
                "example": {
                  "data": {
                    "url": "https://www.linkedin.com/in/williamhgates",
                    "full_name": "Bill Gates",
                    "first_name": "Bill",
                    "last_name": "Gates",
                    "public_identifier": "williamhgates",
                    "headline": "Chair, Gates Foundation and Founder, Breakthrough Energy",
                    "location": {
                      "city": "Seattle",
                      "region": "Washington",
                      "country": "United States",
                      "raw": "Seattle, Washington, United States"
                    },
                    "about": "Chair of the Gates Foundation. Founder of Breakthrough Energy. Co-founder of Microsoft. Voracious reader. Avid traveler. Active blogger.",
                    "urn": "urn:li:member:251749025",
                    "linkedin_id": "251749025",
                    "profile_urn": "urn:li:fsd_profile:ACoAAA8BYqEBCGLg_vT_ca6mMEqkpp9nVffJ3hc",
                    "positions": [
                      {
                        "title": "Co-chair",
                        "company": "Gates Foundation",
                        "company_url": "https://www.linkedin.com/company/gates-foundation",
                        "linkedin_id": "8736",
