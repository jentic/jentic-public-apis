{
  "openapi": "3.0.3",
  "info": {
    "title": "Pokemon TCG API",
    "version": "2.0",
    "description": "The Pokemon TCG API provides access to Pokemon Trading Card Game data including cards, sets, types, subtypes, supertypes, and rarities. Free to use, optional API key for higher rate limits.",
    "contact": {
      "url": "https://pokemontcg.io"
    },
    "x-jentic-source-url": "https://docs.pokemontcg.io/"
  },
  "servers": [
    {
      "url": "https://api.pokemontcg.io/v2",
      "description": "Pokemon TCG API v2"
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Api-Key",
        "description": "Optional API key for higher rate limits. Get one at https://dev.pokemontcg.io/"
      }
    },
    "schemas": {
      "Card": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "supertype": {
            "type": "string"
          },
          "subtypes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hp": {
            "type": "string"
          },
          "types": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "set": {
            "$ref": "#/components/schemas/SetBrief"
          },
          "number": {
            "type": "string"
          },
          "artist": {
            "type": "string"
          },
          "rarity": {
            "type": "string"
          },
          "nationalPokedexNumbers": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "images": {
            "type": "object",
            "properties": {
              "small": {
                "type": "string"
              },
              "large": {
                "type": "string"
              }
            }
          }
        }
      },
      "Set": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "series": {
            "type": "string"
          },
          "printedTotal": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          },
          "releaseDate": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          },
          "images": {
            "type": "object",
            "properties": {
              "symbol": {
                "type": "string"
              },
              "logo": {
                "type": "string"
              }
            }
          }
        }
      },
      "SetBrief": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "series": {
            "type": "string"
          },
          "printedTotal": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          },
          "releaseDate": {
            "type": "string"
          }
        }
      }
    }
  },
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/cards": {
      "get": {
        "summary": "Search Cards",
        "operationId": "searchCards",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Search query using Lucene-like syntax (e.g. name:pikachu)"
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 250,
              "maximum": 250
            }
          },
          {
            "name": "orderBy",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Field to sort by"
          },
          {
            "name": "select",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated fields to return"
          }
        ],
        "responses": {
          "200": {
            "description": "Cards list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Card"
                      }
                    },
                    "page": {
                      "type": "integer"
                    },
                    "pageSize": {
                      "type": "integer"
                    },
                    "count": {
                      "type": "integer"
                    },
                    "totalCount": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/cards/{id}": {
      "get": {
        "summary": "Get Card by ID",
        "operationId": "getCard",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Card details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Card"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/sets": {
      "get": {
        "summary": "Search Sets",
        "operationId": "searchSets",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "orderBy",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "select",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sets list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Set"
                      }
                    },
                    "page": {
                      "type": "integer"
                    },
                    "pageSize": {
                      "type": "integer"
                    },
                    "count": {
                      "type": "integer"
                    },
                    "totalCount": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/sets/{id}": {
      "get": {
        "summary": "Get Set by ID",
        "operationId": "getSet",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Set details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Set"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/types": {
      "get": {
        "summary": "Get All Types",
        "operationId": "getTypes",
        "responses": {
          "200": {
            "description": "Types list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/subtypes": {
      "get": {
        "summary": "Get All Subtypes",
        "operationId": "getSubtypes",
        "responses": {
          "200": {
            "description": "Subtypes list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/supertypes": {
      "get": {
        "summary": "Get All Supertypes",
        "operationId": "getSupertypes",
        "responses": {
          "200": {
            "description": "Supertypes list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/rarities": {
      "get": {
        "summary": "Get All Rarities",
        "operationId": "getRarities",
        "responses": {
          "200": {
            "description": "Rarities list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
