{
  "openapi": "3.1.0",
  "info": {
    "title": "Hastewire API",
    "version": "1.0.0",
    "summary": "AI text humanization and AI-content detection",
    "description": "REST API for humanizing AI-generated text and detecting AI-written content. Authenticate with an API key (Bearer token) created in your Hastewire dashboard (https://hastewire.com/ai-humanizer/account/api-keys). Requests are billed in cents against your prepaid credit balance: 1 credit = $0.01, humanization costs 1 credit per 20 words ($0.50 per 1,000 words) and detection 1 credit per 80 words ($0.125 per 1,000 words). Minimum top-up is $5. No subscription or plan upgrade is required. There are no official client SDKs, batch endpoints, webhooks or async endpoints.",
    "termsOfService": "https://hastewire.com/terms",
    "contact": {
      "name": "Hastewire Support",
      "url": "https://hastewire.com/contact",
      "email": "team@hastewire.com"
    },
    "x-jentic-source-url": "https://hastewire.com/openapi.json"
  },
  "servers": [
    {
      "url": "https://hastewire.com"
    }
  ],
  "paths": {
    "/api/v1/humanize": {
      "post": {
        "operationId": "humanizeText",
        "summary": "Humanize AI-generated text",
        "description": "Rewrites AI-generated text into natural, human-sounding prose while preserving meaning and formatting. Texts shorter than 4 words are returned unchanged at no cost.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "text"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "description": "The text to humanize (minimum 4 words)."
                  },
                  "style": {
                    "type": "string",
                    "enum": [
                      "standard",
                      "academic",
                      "reddit",
                      "formal"
                    ],
                    "default": "standard",
                    "description": "Writing style for the humanized output."
                  },
                  "language": {
                    "type": "string",
                    "description": "Output language, as a language name (e.g. \"French\") or locale code (en, es, pt, it, fr, de, ca, va). Unrecognized values fall back to English."
                  },
                  "strength": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 10,
                    "default": 5,
                    "description": "Humanization strength."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Humanization succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "humanized_text": {
                      "type": "string"
                    },
                    "text_score": {
                      "type": "number",
                      "description": "Overall AI-detection probability of the humanized output (0–1). Lower is more human."
                    },
                    "cost_in_cents": {
                      "type": "number"
                    },
                    "remaining_balance_cents": {
                      "type": "number",
                      "description": "Omitted on the free short-input short-circuit (see `message`), because nothing was billed."
                    },
                    "message": {
                      "type": "string",
                      "description": "Only present when the input was shorter than 4 words: the text is returned unchanged, cost_in_cents is 0, and no balance is debited."
                    },
                    "word_count": {
                      "type": "number",
                      "description": "Only present alongside `message` on the short-input short-circuit."
                    }
                  },
                  "required": [
                    "humanized_text",
                    "cost_in_cents"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid request (missing text, bad style/strength, malformed JSON).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "hint": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "hint": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "402": {
            "description": "Insufficient credit balance.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "required_cents": {
                      "type": "number"
                    },
                    "current_balance_cents": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "hint": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "Service temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "hint": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/detect": {
      "post": {
        "operationId": "detectAIText",
        "summary": "Detect AI-generated text",
        "description": "Analyzes text and returns AI-detection results, including sentence-level scoring.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "text"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "description": "The text to analyze."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Detection succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "description": "Detection result, including document- and sentence-level AI probability scores."
                    },
                    "cost_in_cents": {
                      "type": "number"
                    },
                    "remaining_balance_cents": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "data",
                    "cost_in_cents",
                    "remaining_balance_cents"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid request (missing text or malformed JSON).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "hint": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "hint": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "402": {
            "description": "Insufficient credit balance.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "required_cents": {
                      "type": "number"
                    },
                    "current_balance_cents": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "hint": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "Service temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "hint": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/status": {
      "get": {
        "operationId": "getApiStatus",
        "summary": "API service status",
        "description": "Public health endpoint (no authentication). Returns overall and per-service status, 7-day uptime, and infrastructure counts. Responds 503 when the platform is down.",
        "security": [],
        "parameters": [
          {
            "name": "deep",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "When true, actively re-checks all backend servers before reporting."
          }
        ],
        "responses": {
          "200": {
            "description": "Current service status.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "operational",
                        "degraded",
                        "down"
                      ]
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "uptime_percent_7d": {
                      "type": "number"
                    },
                    "services": {
                      "type": "object"
                    },
                    "infrastructure": {
                      "type": "object"
                    },
                    "ping": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Platform is down."
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "operationId": "getAccount",
        "summary": "Account behind the API key",
        "description": "Returns the authenticated account: prepaid balance in cents and USD, how many words that balance is worth at the current rates, the billing rates themselves, and metadata about the calling key. Free — this call is not billed.",
        "responses": {
          "200": {
            "description": "Account state.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "email": {
                      "type": "string"
                    },
                    "balance_cents": {
                      "type": "number"
                    },
                    "balance_usd": {
                      "type": "number"
                    },
                    "estimated_words_remaining": {
                      "type": "object",
                      "properties": {
                        "humanize": {
                          "type": "number"
                        },
                        "detect": {
                          "type": "number"
                        }
                      }
                    },
                    "rates": {
                      "type": "object",
                      "properties": {
                        "humanize_words_per_credit": {
                          "type": "number"
                        },
                        "detect_words_per_credit": {
                          "type": "number"
                        },
                        "credit_value_usd": {
                          "type": "number"
                        }
                      }
                    },
                    "api_key": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "created_at": {
                          "type": "string"
                        },
                        "last_used_at": {
                          "type": "string"
                        }
                      }
                    },
                    "active_api_keys": {
                      "type": "number"
                    },
                    "top_up_url": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "balance_cents",
                    "balance_usd",
                    "rates"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "hint": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/usage": {
      "get": {
        "operationId": "getUsage",
        "summary": "Billed usage for the account",
        "description": "Aggregated API usage across every key the account owns: request counts, cents charged and words processed, split by operation and bucketed by UTC day. Never returns the text of past requests. Free — this call is not billed.",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 365,
              "default": 30
            },
            "description": "Look-back window in days. Defaults to 30, capped at 365."
          }
        ],
        "responses": {
          "200": {
            "description": "Usage summary.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "period_days": {
                      "type": "number"
                    },
                    "since": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "total": {
                      "type": "object",
                      "properties": {
                        "requests": {
                          "type": "number"
                        },
                        "cost_cents": {
                          "type": "number"
                        },
                        "cost_usd": {
                          "type": "number"
                        },
                        "words": {
                          "type": "number"
                        }
                      }
                    },
                    "humanize": {
                      "type": "object",
                      "properties": {
                        "requests": {
                          "type": "number"
                        },
                        "cost_cents": {
                          "type": "number"
                        },
                        "words": {
                          "type": "number"
                        }
                      }
                    },
                    "detect": {
                      "type": "object",
                      "properties": {
                        "requests": {
                          "type": "number"
                        },
                        "cost_cents": {
                          "type": "number"
                        },
                        "words": {
                          "type": "number"
                        }
                      }
                    },
                    "daily": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "date": {
                            "type": "string"
                          },
                          "requests": {
                            "type": "number"
                          },
                          "cost_cents": {
                            "type": "number"
                          },
                          "words": {
                            "type": "number"
                          }
                        }
                      }
                    },
                    "balance_cents": {
                      "type": "number"
                    },
                    "truncated": {
                      "type": "boolean",
                      "description": "True when the row cap was hit and the window is only partially counted."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "hint": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "API key created at https://hastewire.com/ai-humanizer/account/api-keys, sent as \"Authorization: Bearer YOUR_API_KEY\"."
      }
    }
  },
  "security": [
    {
      "apiKey": []
    }
  ],
  "externalDocs": {
    "description": "Hastewire developer overview (pricing, auth, error semantics). Full reference at https://docs.hastewire.com",
    "url": "https://hastewire.com/developers"
  }
}