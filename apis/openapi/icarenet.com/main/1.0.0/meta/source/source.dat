{
  "openapi": "3.1.0",
  "info": {
    "title": "iCareNet EMS Auth & Events API",
    "version": "1.0.0",
    "description": "OpenAPI specification for EMS core flows: - Login (issue EMS token) - Get Event Types - Create Event\n",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/microZoal/icarenet-event-management-system-ems-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.icarenet.com",
      "description": "Production"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "EMS authentication"
    },
    {
      "name": "Event Types",
      "description": "View available event types"
    },
    {
      "name": "Events",
      "description": "Create events"
    }
  ],
  "paths": {
    "/api/ems/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Login to EMS",
        "description": "Validates an existing iCareNet user token and issues an EMS-scoped JWT token.\n",
        "operationId": "emsLogin",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmsLoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmsLoginSuccess"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/ems/event-types": {
      "get": {
        "tags": [
          "Event Types"
        ],
        "summary": "List event types",
        "description": "Returns active event types available for event creation.",
        "operationId": "listEventTypes",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Event types list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EventType"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/api/ems/events": {
      "post": {
        "tags": [
          "Events"
        ],
        "summary": "Create event (draft)",
        "description": "Creates a new event in DRAFT status. - Title is a single-language string. - Description supports Arabic and English. - Maps URL is optional.\n",
        "operationId": "createEvent",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EventCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Event created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "EMS-scoped JWT token"
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Unauthorized",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Forbidden",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "ValidationError": {
        "description": "Validation error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Conflict": {
        "description": "Conflict",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "InternalError": {
        "description": "Internal server error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "EmsLoginRequest": {
        "type": "object",
        "required": [
          "irId",
          "userToken"
        ],
        "properties": {
          "irId": {
            "type": "string"
          },
          "userToken": {
            "type": "string"
          }
        }
      },
      "EmsLoginSuccess": {
        "type": "object",
        "required": [
          "success",
          "emsToken",
          "tokenType",
          "expiresIn",
          "rank",
          "roles",
          "permissions",
          "capabilities"
        ],
        "properties": {
          "success": {
            "type": "boolean"
          },
          "emsToken": {
            "type": "string"
          },
          "tokenType": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "expiresIn": {
            "type": "integer"
          },
          "rank": {
            "$ref": "#/components/schemas/RankInfo"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "capabilities": {
            "$ref": "#/components/schemas/EmsCapabilities"
          }
        }
      },
      "RankInfo": {
        "type": "object",
        "required": [
          "code",
          "name"
        ],
        "properties": {
          "code": {
            "type": "string",
            "example": "MEMBER"
          },
          "name": {
            "type": "string",
            "example": "Member"
          }
        }
      },
      "EmsCapabilities": {
        "type": "object",
        "required": [
          "canCreateEvent",
          "canPublishEvent",
          "maxEventsPerMonth",
          "maxEventCapacity",
          "allowedEventTypes"
        ],
        "properties": {
          "canCreateEvent": {
            "type": "boolean"
          },
          "canPublishEvent": {
            "type": "boolean"
          },
          "maxEventsPerMonth": {
            "type": "integer"
          },
          "maxEventCapacity": {
            "type": "integer"
          },
          "allowedEventTypes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "EventType": {
        "type": "object",
        "required": [
          "id",
          "code",
          "nameAr",
          "nameEn",
          "requiresApproval"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "nameAr": {
            "type": "string"
          },
          "nameEn": {
            "type": "string"
          },
          "requiresApproval": {
            "type": "boolean"
          }
        }
      },
      "LocalizedDescription": {
        "type": "object",
        "required": [
          "ar",
          "en"
        ],
        "properties": {
          "ar": {
            "type": "string"
          },
          "en": {
            "type": "string"
          }
        }
      },
      "EventLocation": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "mapsUrl": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "EventCreateRequest": {
        "type": "object",
        "required": [
          "eventTypeId",
          "title",
          "description",
          "startAt",
          "endAt",
          "capacity",
          "location"
        ],
        "properties": {
          "eventTypeId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "$ref": "#/components/schemas/LocalizedDescription"
          },
          "startAt": {
            "type": "string",
            "format": "date-time"
          },
          "endAt": {
            "type": "string",
            "format": "date-time"
          },
          "capacity": {
            "type": "integer"
          },
          "location": {
            "$ref": "#/components/schemas/EventLocation"
          }
        }
      },
      "Event": {
        "type": "object",
        "required": [
          "id",
          "eventTypeId",
          "title",
          "description",
          "status",
          "startAt",
          "endAt",
          "capacity",
          "location"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "eventTypeId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "$ref": "#/components/schemas/LocalizedDescription"
          },
          "status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "PENDING_APPROVAL",
              "PUBLISHED"
            ]
          },
          "startAt": {
            "type": "string",
            "format": "date-time"
          },
          "endAt": {
            "type": "string",
            "format": "date-time"
          },
          "capacity": {
            "type": "integer"
          },
          "location": {
            "$ref": "#/components/schemas/EventLocation"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}
