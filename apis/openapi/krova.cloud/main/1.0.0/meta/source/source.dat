th","description":"OAuth 2.0 Device Authorization Grant (RFC 8628) for `krova login` — no API key required"},{"name":"Spaces","description":"Resolve the space an API key is scoped to"},{"name":"Cubes","description":"Create, list, manage Cubes"},{"name":"Domains"},{"name":"TCP mappings"},{"name":"Snapshots"},{"name":"Backups","description":"Portable .cube archives — list backups, download one as a single file, and share a copy with another space"},{"name":"Imports","description":"Customer-uploaded .cube archives — browser-direct multipart upload to S3, then provisioning"},{"name":"Webhooks","description":"Outbound HTTP callbacks for Cube events"}]}