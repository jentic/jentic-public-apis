{"openapi":"3.1.0","info":{"title":"LazyAds API","version":"1.0.0","description":"Programmatic access to campaigns, performance, creatives, competitors, account signals (pixels, conversion-event volume, audiences), server-side conversion events, and outbound webhooks. Every endpoint requires `Authorization: Bearer <api_key>` and a Growth, Scale, or Enterprise plan (BYOA and Starter keys work with the MCP server at https://mcp.lazyads.ai/mcp instead). Lazy Ads AI endpoints (`/campaigns/build`, `/chat`, `/competitors/ads`) additionally require an AI plan. Rate limits are per key per minute (Growth 100, Scale 500, Enterprise 1000) and returned in `X-RateLimit-*` headers. Agencies may scope a request to a client workspace with the `X-LazyAds-Client` header."},"servers":[{"url":"https://lazyads.ai/api/v1","description":"Production"}],"security":[{"bearerAuth":[]}],"components":{"securitySchemes":{"bearerAuth":{"type":"http","scheme":"bearer","description":"Use `Authorization: Bearer <api_key>`. Generate keys in Settings → API."}},"parameters":{"AgencyClient":{"name":"X-LazyAds-Client","in":"header","required":false,"schema":{"type":"string"},"description":"Agency mode: act inside a client workspace by client user id. Viewers get read-only access."}},"schemas":{"Error":{"type":"object","properties":{"error":{"type":"object","properties":{"message":{"type":"string"},"code":{"type":"string"},"status":{"type":"integer"}}}}},"Audience":{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"},"kind":{"type":"string","enum":["website_visitors","website_event","purchasers","leads","customer_list","engagement","app","lookalike","saved","other"]},"approximateSize":{"type":["integer","null"]},"retentionDays":{"type":["integer","null"]},"eventName":{"type":["string","null"]},"seedAudienceId":{"type":["string","null"]},"lookalikeRatio":{"type":["number","null"]},"status":{"type":["string","null"]},"createdByLazyAds":{"type":"boolean"}}},"ConversionEvent":{"type":"object","properties":{"id":{"type":"string"},"sourceId":{"type":["string","null"],"description":"Pixel / tag / conversion-action id."},"sourceName":{"type":["string","null"]},"eventName":{"type":"string"},"standardEvent":{"type":["string","null"]},"stage":{"type":"string","enum":["purchase","checkout","payment_info","add_to_cart","lead","registration","trial","subscribe","contact","schedule","application","search","view_content","page_view","app_install","custom"],"description":"Funnel stage of the event."},"count7d":{"type":["integer","null"]},"count30d":{"type":["integer","null"]},"weeklyVolume":{"type":["number","null"]},"value7d":{"type":["number","null"]},"isCustomConversion":{"type":"boolean"},"lastFiredAt":{"type":["string","null"],"format":"date-time"}}}},"responses":{"Unauthorized":{"description":"Missing or invalid API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"Forbidden":{"description":"Plan does not include this endpoint, key lacks the scope, or agency access denied","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"RateLimited":{"description":"Rate limit exceeded","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}},"paths":{"/campaigns":{"get":{"summary":"List campaigns","description":"Returns campaigns for the authenticated account with lifetime performance aggregates.","parameters":[{"name":"status","in":"query","schema":{"type":"string","enum":["draft","active","paused","completed","error"]}},{"name":"platform","in":"query","schema":{"type":"string","enum":["meta","google","tiktok","linkedin","reddit","apple","bing","chatgpt","snapchat"]}},{"name":"limit","in":"query","schema":{"type":"integer","default":50,"maximum":100}},{"name":"offset","in":"query","schema":{"type":"integer","default":0}}],"responses":{"200":{"description":"A list of campaigns with `pagination`"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"429":{"$ref":"#/components/responses/RateLimited"}}},"post":{"summary":"Create a draft campaign","description":"Creates a Lazy Ads campaign record in `draft` status (same as the dashboard). Publishing structure to the live platform happens through the MCP bridge (`create_manual_campaign`) or the AI builder. Requires a Starter+ AI plan on the account.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["platform","name"],"properties":{"platform":{"type":"string","enum":["meta","google","tiktok","linkedin","reddit","apple","bing","chatgpt","snapchat"]},"name":{"type":"string","maxLength":200},"objective":{"type":"string"},"dailyBudget":{"type":"number","description":"USD per day"},"totalBudget":{"type":"number","description":"USD lifetime cap"},"aiManaged":{"type":"boolean","default":true},"trackingEnabled":{"type":"boolean","default":true}}}}}},"responses":{"201":{"description":"The created campaign"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"}}}},"/campaigns/importable":{"get":{"summary":"List live campaigns you can import","description":"Campaigns on connected ad accounts, flagged `already_imported` when Lazy Ads has them. Same data as MCP `list_live_platform_campaigns`.","parameters":[{"name":"platform","in":"query","schema":{"type":"string"},"description":"Comma-separated platform filter, e.g. `meta,google`"}],"responses":{"200":{"description":"Importable campaigns plus `meta.connections` and `meta.errors`"}}}},"/campaigns/import":{"post":{"summary":"Import live campaigns into Lazy Ads","description":"Links platform campaigns into the unified dashboard and queues a worker job that pulls structure and daily stats. Tracking defaults on for Starter+; Management stays off unless requested. Same as MCP `import_platform_campaign`.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["campaigns"],"properties":{"campaigns":{"type":"array","minItems":1,"maxItems":50,"items":{"type":"object","required":["platform","platformCampaignId"],"properties":{"platform":{"type":"string","enum":["meta","google","tiktok","linkedin","reddit","apple","bing","chatgpt","snapchat"]},"platformCampaignId":{"type":"string"},"trackingEnabled":{"type":"boolean"},"aiManaged":{"type":"boolean"}}}}}}}}},"responses":{"200":{"description":"Nothing new to import"},"201":{"description":"Campaigns imported"},"404":{"description":"A campaign id was not found on the connected account"}}}},"/campaigns/{id}":{"get":{"summary":"Get a campaign","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Campaign detail with ad sets and ads"},"404":{"description":"Not found"}}},"patch":{"summary":"Update campaign name or end date","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"name":{"type":"string"},"endDate":{"type":"string","description":"YYYY-MM-DD"}}}}}},"responses":{"200":{"description":"Campaign updated"}}}},"/campaigns/{id}/pause":{"post":{"summary":"Pause a campaign","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Campaign paused"}}}},"/campaigns/{id}/resume":{"post":{"summary":"Resume a campaign","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Campaign resumed"}}}},"/campaigns/{id}/budget":{"post":{"summary":"Set a campaign daily budget","description":"Updates the LazyAds record and the live platform. Reddit applies the budget to each ad group.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["dailyBudgetUsd"],"properties":{"dailyBudgetUsd":{"type":"number"}}}}}},"responses":{"200":{"description":"Budget updated"}}}},"/campaigns/{id}/automation":{"post":{"summary":"Toggle Tracking and Management on a campaign","description":"Tracking feeds the dashboard and AI analysis; Management lets the Lazy Ads optimizer edit budgets, bids, and ads. Turning either on requires a Starter+ AI plan. Same as MCP `set_campaign_automation`.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"trackingEnabled":{"type":"boolean"},"aiManaged":{"type":"boolean"}}}}}},"responses":{"200":{"description":"Flags updated"},"403":{"$ref":"#/components/responses/Forbidden"}}}},"/campaigns/build/{taskId}":{"get":{"summary":"Poll an AI campaign build","description":"Returns the build task status (`running`, `completed`, `failed`) and output. Pass `?campaignId=` from the build response to include per-step progress. Same as MCP `get_campaign_build_status`.","parameters":[{"name":"taskId","in":"path","required":true,"schema":{"type":"string"}},{"name":"campaignId","in":"query","schema":{"type":"string"}}],"responses":{"200":{"description":"Build status"},"404":{"description":"Not found"}}}},"/campaigns/build":{"post":{"summary":"Start an AI campaign build","description":"Same options as the dashboard builder and MCP `build_ai_campaign`. One campaign is created per selected platform. Poll the returned `task_id` with `GET /campaigns/build/{taskId}`. Requires a Starter+ AI plan, completed onboarding, and a connected ad account.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"platform":{"type":"string","enum":["meta","google","tiktok","linkedin","reddit","apple","bing","chatgpt","snapchat"],"description":"Single platform. Prefer `platforms` for multi-platform builds."},"platforms":{"type":"array","items":{"type":"string","enum":["meta","google","tiktok","linkedin","reddit","apple","bing","chatgpt","snapchat"]},"minItems":1,"maxItems":9},"dailyBudgetUsd":{"type":"number","minimum":5,"maximum":100000},"skipCompetitorAnalysis":{"type":"boolean"},"confirmNotPolitical":{"type":"boolean","description":"LinkedIn EU political-advertising declaration."},"objectiveOverride":{"type":"string","enum":["OUTCOME_AWARENESS","OUTCOME_TRAFFIC","OUTCOME_ENGAGEMENT","OUTCOME_LEADS","OUTCOME_SALES","OUTCOME_APP_PROMOTION"]},"preferredCreativeIds":{"type":"array","items":{"type":"string"},"maxItems":50},"preferredPagePostId":{"type":"string","description":"Facebook Page post id (`PAGEID_POSTID`) to promote on Meta."},"socialContentIds":{"type":"array","items":{"type":"string"},"maxItems":20},"referenceCreativeIds":{"type":"array","items":{"type":"string"},"maxItems":8},"customInstructions":{"type":"string","maxLength":4000},"creativeMix":{"type":"string","enum":["ai_decide","images_only","videos_only","images_and_videos","existing"],"description":"ai_decide (default) lets Lazy Ads pick the better-performing format and reuse winning library creatives. existing reuses the library only."}}}}}},"responses":{"200":{"description":"A build is already running"},"201":{"description":"Build started (`task_id`, `campaign_id`, `builds`)"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"}}}},"/ads/{id}":{"patch":{"summary":"Update ad copy, destination URL / UTMs, or attach a creative","description":"Pushes headline/body/CTA/destination URL and Meta url_tags to the live platform when the API allows it. Published ads fail instead of writing Lazy Ads only. `creativeId` attaches a library creative (live swap only when a platform creative id already exists).","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"name":{"type":"string"},"headline":{"type":"string"},"body":{"type":"string"},"description":{"type":"string"},"callToAction":{"type":"string"},"destinationUrl":{"type":"string","format":"uri"},"urlTags":{"type":"string","description":"Meta url_tags query string without ?"},"creativeId":{"type":["string","null"]}}}}}},"responses":{"200":{"description":"Ad updated (`appliedOnPlatform` says whether Graph/Ads was written)"},"400":{"description":"Platform hard limit or invalid input"}}}},"/ads/{id}/pause":{"post":{"summary":"Pause an ad","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Ad paused on the platform"}}}},"/ads/{id}/resume":{"post":{"summary":"Resume an ad","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Ad resumed on the platform"}}}},"/ad-sets/{id}":{"patch":{"summary":"Rename an ad set or set its end date","description":"Live name updates on Meta, TikTok, LinkedIn, Snapchat, and ChatGPT. Live end dates on Meta and TikTok. Other platforms return 400 instead of a silent DB-only write.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"name":{"type":"string"},"endDate":{"type":"string","description":"YYYY-MM-DD"}}}}}},"responses":{"200":{"description":"Ad set updated"},"400":{"description":"Platform hard limit or invalid input"}}}},"/ad-sets/{id}/pause":{"post":{"summary":"Pause an ad set","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Ad set paused on the platform"}}}},"/ad-sets/{id}/resume":{"post":{"summary":"Resume an ad set","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Ad set resumed on the platform"}}}},"/ad-sets/{id}/targeting":{"post":{"summary":"Update ad set targeting","description":"Applies the fields the live platform can mutate (countries, age, interests, subreddits, etc.). Bing country targeting is additive.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["targeting"],"properties":{"targeting":{"type":"object"}}}}}},"responses":{"200":{"description":"Targeting updated"}}}},"/ad-sets/{id}/budget":{"post":{"summary":"Set an ad set daily budget","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["dailyBudgetUsd"],"properties":{"dailyBudgetUsd":{"type":"number"}}}}}},"responses":{"200":{"description":"Budget updated"}}}},"/ad-sets/{id}/bid":{"post":{"summary":"Set a manual ad-set bid (LinkedIn, TikTok, ChatGPT, Snapchat)","description":"Pass `null` on LinkedIn to revert to automatic bidding.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["bidUsd"],"properties":{"bidUsd":{"type":["number","null"]}}}}}},"responses":{"200":{"description":"Bid updated"}}}},"/ad-sets/{id}/keywords":{"post":{"summary":"Add search keywords","description":"Google, Bing, and Apple ad groups.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["keywords"],"properties":{"keywords":{"type":"array","items":{"type":"object","required":["text"],"properties":{"text":{"type":"string"},"matchType":{"type":"string","enum":["EXACT","PHRASE","BROAD"]}}}}}}}}},"responses":{"200":{"description":"Keywords added"}}}},"/ad-sets/{id}/optimization-event":{"post":{"summary":"Switch the conversion event a Meta ad set optimizes for","description":"Event graduation for a live Meta ad set (for example Lead → Purchase once purchases clear the learning threshold). Provide a Meta standard event (`customEventType`) or a custom conversion id (`customConversionId`). The event must exist on the account pixel; learning-volume and 14-day cooldown concerns are returned as `warnings` rather than blocking a user-directed change. Recorded in the Activity Log.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"customEventType":{"type":"string","enum":["PURCHASE","LEAD","COMPLETE_REGISTRATION","ADD_TO_CART","INITIATED_CHECKOUT","ADD_PAYMENT_INFO","CONTENT_VIEW","SEARCH","SUBSCRIBE","START_TRIAL","CONTACT","SCHEDULE","SUBMIT_APPLICATION","ADD_TO_WISHLIST","CUSTOMIZE_PRODUCT","DONATE","FIND_LOCATION","RATE","TUTORIAL_COMPLETION","LEVEL_ACHIEVED","ACHIEVEMENT_UNLOCKED","SPENT_CREDITS","SERVICE_BOOKING_REQUEST","MESSAGING_CONVERSATION_STARTED_7D","LISTING_INTERACTION","OTHER"]},"customConversionId":{"type":"string"},"reason":{"type":"string"}}}}}},"responses":{"200":{"description":"Optimization event updated","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"object","properties":{"adSetId":{"type":"string"},"campaignId":{"type":"string"},"optimizationEvent":{"type":"object"},"previous":{"type":["object","null"]},"weeklyVolume":{"type":["number","null"]},"warnings":{"type":"array","items":{"type":"string"}}}},"message":{"type":"string"}}}}}}}}},"/account-signals":{"get":{"summary":"Account signals: pixels, conversion events, audiences, and the AI plan","description":"One snapshot of what Lazy Ads sees on a connected ad account: pixels/tags with fire volume, conversion events with 7-day and 30-day counts, custom/lookalike/retargeting audiences with sizes, plus the deterministic event ladder (which event to optimize for now and when to graduate) and audience plan (exclusions, warm sets, lookalike seed, recommended audiences to create). This is the same input the AI campaign builder and optimizer use.","parameters":[{"name":"platform","in":"query","required":true,"schema":{"type":"string","enum":["meta","google","tiktok","linkedin","reddit","apple","bing","chatgpt","snapchat"]}}],"responses":{"200":{"description":"Account signals snapshot","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"object","properties":{"platform":{"type":"string"},"fetchedAt":{"type":"string","format":"date-time"},"capabilities":{"type":"object"},"pixelId":{"type":["string","null"]},"pixels":{"type":"array","items":{"type":"object"}},"conversionEvents":{"type":"array","items":{"$ref":"#/components/schemas/ConversionEvent"}},"audiences":{"type":"array","items":{"$ref":"#/components/schemas/Audience"}},"eventPlan":{"type":"object"},"audiencePlan":{"type":"object"},"warnings":{"type":"array","items":{"type":"string"}}}}}}}}},"412":{"description":"Platform is not connected"}}}},"/conversion-events":{"get":{"summary":"List pixel / tag conversion events with fire volume","description":"Pixels, tags, or conversion actions on the connected account with 7-day and 30-day counts, funnel stage, and the recommended optimization event plus graduation rule.","parameters":[{"name":"platform","in":"query","required":true,"schema":{"type":"string","enum":["meta","google","tiktok","linkedin","reddit","apple","bing","chatgpt","snapchat"]}}],"responses":{"200":{"description":"Conversion events","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"object","properties":{"platform":{"type":"string"},"pixelId":{"type":["string","null"]},"pixels":{"type":"array","items":{"type":"object"}},"conversionEvents":{"type":"array","items":{"$ref":"#/components/schemas/ConversionEvent"}},"eventPlan":{"type":"object"},"warnings":{"type":"array","items":{"type":"string"}}}}}}}}}}}},"/audiences":{"get":{"summary":"List custom, lookalike, and retargeting audiences","description":"Audiences on the connected ad account with approximate sizes, plus the audience plan Lazy Ads derives (exclusion ids, warm retargeting ids, lookalike seed, recommended audiences to create).","parameters":[{"name":"platform","in":"query","required":true,"schema":{"type":"string","enum":["meta","google","tiktok","linkedin","reddit","apple","bing","chatgpt","snapchat"]}}],"responses":{"200":{"description":"Audiences and plan","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"object","properties":{"platform":{"type":"string"},"capabilities":{"type":"object"},"audiences":{"type":"array","items":{"$ref":"#/components/schemas/Audience"}},"plan":{"type":"object"},"warnings":{"type":"array","items":{"type":"string"}}}}}}}}}}},"post":{"summary":"Create a first-party audience","description":"Creates a website-visitor, pixel-event, purchaser, lead, page-engagement, or lookalike audience on the connected ad account (Meta, TikTok, Snapchat, Google where the platform API allows it). An equivalent existing audience is returned instead of duplicating it (200); a new audience returns 201. Recorded in the Activity Log.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["platform","kind"],"properties":{"platform":{"type":"string","enum":["meta","google","tiktok","linkedin","reddit","apple","bing","chatgpt","snapchat"]},"kind":{"type":"string","enum":["website_visitors","website_event","purchasers","leads","engagement","lookalike"]},"eventName":{"type":"string","description":"Pixel event for website_event / purchasers / leads."},"retentionDays":{"type":"integer","description":"Membership window; platform default when omitted."},"seedAudienceId":{"type":"string","description":"Existing audience id to seed a lookalike."},"lookalikeRatio":{"type":"number","description":"Lookalike reach, 0.01–0.2 (1%–20%)."},"reason":{"type":"string"}}}}}},"responses":{"200":{"description":"An equivalent audience already existed and is returned"},"201":{"description":"Audience created","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"object","properties":{"platform":{"type":"string"},"created":{"type":"boolean"},"audience":{"$ref":"#/components/schemas/Audience"},"warnings":{"type":"array","items":{"type":"string"}}}},"message":{"type":"string"}}}}}},"400":{"description":"Unsupported kind for this platform, missing pixel/seed, or seed too small"}}}},"/performance":{"get":{"summary":"Get performance metrics","description":"Summary (impressions, clicks, conversions, spend, revenue, CTR, CPC, CPA, ROAS) plus a breakdown grouped by day, platform, or campaign.","parameters":[{"name":"start_date","in":"query","schema":{"type":"string","format":"date"}},{"name":"end_date","in":"query","schema":{"type":"string","format":"date"}},{"name":"platform","in":"query","schema":{"type":"string","enum":["meta","google","tiktok","linkedin","reddit","apple","bing","chatgpt","snapchat"]}},{"name":"campaign_id","in":"query","schema":{"type":"string"}},{"name":"group_by","in":"query","schema":{"type":"string","enum":["day","platform","campaign"],"default":"day"}}],"responses":{"200":{"description":"Performance summary and breakdown"}}}},"/creatives":{"get":{"summary":"List creatives","description":"Creative library with live lifetime ROAS/spend (rolled up from attached ads) and pre-launch predicted scores. Default sort is live performance (`sort_by=performance`).","parameters":[{"name":"type","in":"query","schema":{"type":"string","enum":["image","video","text"]}},{"name":"ai_generated","in":"query","schema":{"type":"boolean"}},{"name":"sort_by","in":"query","schema":{"type":"string","enum":["performance","lifetime_roas","created_at","performance_score","usage_count"]}},{"name":"order","in":"query","schema":{"type":"string","enum":["asc","desc"]}},{"name":"limit","in":"query","schema":{"type":"integer"}},{"name":"offset","in":"query","schema":{"type":"integer"}}],"responses":{"200":{"description":"Creative library with live and predicted scores"}}}},"/competitors":{"get":{"summary":"List tracked competitors","responses":{"200":{"description":"Competitors"}}},"post":{"summary":"Add a competitor","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["name"],"properties":{"name":{"type":"string","maxLength":200},"website_url":{"type":"string","format":"uri"}}}}}},"responses":{"201":{"description":"Created competitor"}}}},"/competitors/ads":{"get":{"summary":"Search competitor ads (Meta Ad Library)","description":"Requires a Starter+ AI plan.","parameters":[{"name":"q","in":"query","required":true,"schema":{"type":"string"}},{"name":"country","in":"query","schema":{"type":"string","default":"US","minLength":2,"maxLength":2}},{"name":"limit","in":"query","schema":{"type":"integer","default":25,"maximum":50}},{"name":"website","in":"query","schema":{"type":"string","format":"uri"},"description":"Pin results to one advertiser website"}],"responses":{"200":{"description":"Matching ads (`source`, `ads`, `public_url`)"},"403":{"$ref":"#/components/responses/Forbidden"}}}},"/connections":{"get":{"summary":"List platform connections","responses":{"200":{"description":"Connections"}}},"post":{"summary":"Connect ChatGPT","description":"Attach a ChatGPT account with an Ads Manager API key (`platform=chatgpt`, `api_key`). Other platforms connect through the dashboard OAuth or BYO-key cards.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["platform","api_key"],"properties":{"platform":{"type":"string","enum":["chatgpt"]},"api_key":{"type":"string","description":"ChatGPT Manager API key"}}}}}},"responses":{"200":{"description":"Connected ChatGPT account (tokens are never returned)"},"400":{"description":"Invalid platform or key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/notifications":{"get":{"summary":"List recent notifications","parameters":[{"name":"unread","in":"query","schema":{"type":"boolean"},"description":"`true` returns unread only"},{"name":"channel","in":"query","schema":{"type":"string"}},{"name":"type","in":"query","schema":{"type":"string"}},{"name":"since","in":"query","schema":{"type":"string","format":"date-time"}},{"name":"limit","in":"query","schema":{"type":"integer","default":50,"maximum":100}},{"name":"offset","in":"query","schema":{"type":"integer","default":0}}],"responses":{"200":{"description":"Notifications with `meta.unread_count` and `pagination`"}}}},"/activity":{"get":{"summary":"List user activity","description":"Credit charges and campaign, ad set, or ad changes. Newest first. Cursor pagination. Does not expose admin spend, model names, or token counts.","parameters":[{"name":"limit","in":"query","schema":{"type":"integer"}},{"name":"cursor","in":"query","schema":{"type":"string"}},{"name":"platform","in":"query","schema":{"type":"string"}},{"name":"campaignId","in":"query","schema":{"type":"string"}},{"name":"actor","in":"query","schema":{"type":"string","enum":["ai","user","mcp","api","system"]}},{"name":"creditsOnly","in":"query","schema":{"type":"boolean"}},{"name":"query","in":"query","schema":{"type":"string"},"description":"Search title, reason, action, or campaign name"}],"responses":{"200":{"description":"Activity events"}}}},"/chat":{"post":{"summary":"Chat with the LazyAds AI assistant","description":"One turn with the Lazy Ads assistant (it can read and act on your account). Requires a Starter+ AI plan and consumes AI credits. Reuse `conversation_id` to continue a thread.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["message"],"properties":{"message":{"type":"string","maxLength":4000},"conversation_id":{"type":"string"},"context":{"type":"string","enum":["dashboard_chat","strategy_review","settings"],"default":"dashboard_chat"}}}}}},"responses":{"200":{"description":"Assistant reply (`conversation_id`, `message`, `token_count`, `actions`)"},"403":{"$ref":"#/components/responses/Forbidden"}}}},"/events":{"post":{"summary":"Ingest first-party conversion events","description":"Batch of 1 to 100 server-side conversion events forwarded to Meta CAPI (and Google Enhanced Conversions when `googleConversionActionId` is set) with `eventId` deduplication against the browser pixel. Requires the `performance` scope.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["events"],"properties":{"events":{"type":"array","minItems":1,"maxItems":100,"items":{"type":"object","required":["eventName","eventId"],"properties":{"eventName":{"type":"string","maxLength":60,"description":"e.g. Purchase, Lead"},"eventId":{"type":"string","maxLength":200,"description":"Shared with the pixel for dedup"},"eventTime":{"type":"integer","description":"Unix seconds"},"eventSourceUrl":{"type":"string","format":"uri"},"value":{"type":"number"},"currency":{"type":"string","minLength":3,"maxLength":3},"orderId":{"type":"string"},"fbclid":{"type":"string"},"fbp":{"type":"string"},"gclid":{"type":"string"},"ttclid":{"type":"string"},"user":{"type":"object","description":"Hashed server-side before forwarding","properties":{"email":{"type":"string","format":"email"},"phone":{"type":"string"},"firstName":{"type":"string"},"lastName":{"type":"string"},"city":{"type":"string"},"state":{"type":"string"},"zip":{"type":"string"},"country":{"type":"string","maxLength":2},"externalId":{"type":"string"}}}}}},"googleConversionActionId":{"type":"string","maxLength":40}}}}}},"responses":{"200":{"description":"Events accepted"}}}},"/webhooks":{"get":{"summary":"List webhook subscriptions","description":"Returns the REST Hook subscriptions registered for the authenticated key.","responses":{"200":{"description":"Subscription list"}}},"post":{"summary":"Subscribe to webhook events (REST Hook)","description":"Registers an HTTPS URL to receive signed event deliveries. Used by Zapier/n8n. Returns the signing secret once.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["url"],"properties":{"url":{"type":"string","format":"uri","description":"HTTPS target URL"},"events":{"type":"array","items":{"type":"string","enum":["campaign.built","campaign.launched","campaign.budget_adjusted","creative.ready","optimization.action_taken"]},"description":"Event types to subscribe to. Defaults to all."},"description":{"type":"string"}}}}}},"responses":{"201":{"description":"Subscription created (includes secret)"}}},"delete":{"summary":"Unsubscribe by id or url","parameters":[{"name":"id","in":"query","schema":{"type":"string"}},{"name":"url","in":"query","schema":{"type":"string"}}],"responses":{"200":{"description":"Subscription removed"}}}},"/webhooks/{id}":{"delete":{"summary":"Unsubscribe a webhook by id","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Subscription removed"}}}},"/webhooks/events":{"get":{"summary":"List webhook event types with sample payloads","description":"Powers Zapier/n8n trigger selection and field mapping.","responses":{"200":{"description":"Event catalog with samples"}}}}},"x-webhooks":{"description":"Outbound webhook events. See /docs/webhooks for signature verification.","events":["campaign.built","campaign.launched","campaign.budget_adjusted","creative.ready","optimization.action_taken"]}}