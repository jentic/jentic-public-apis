{
  "openapi": "3.0.0",
  "info": {
    "description": "Service API for Söderberg & Partners",
    "version": "1.0.0",
    "title": "Söderberg & Partners API2",
    "termsOfService": "http://swagger.io/terms/",
    "contact": {
      "email": "goo@thinc.no"
    },
    "license": {
      "name": "Apache 2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/SP_Bafo/Medlemdata/1.0.0"
  },
  "tags": [
    {
      "name": "InWork-NOTREADY",
      "description": "Soon to be ready"
    },
    {
      "name": "Medlem",
      "description": "Send medlemdata"
    },
    {
      "name": "Token",
      "description": "Hent token"
    }
  ],
  "paths": {
    "/Customers/updateMembers": {
      "post": {
        "tags": [
          "Medlem"
        ],
        "description": "Max 10000 medlemmer",
        "operationId": "updateMembers",
        "parameters": [
          {
            "name": "Authentication",
            "in": "header",
            "description": "Bearer ..Token.. (hentes fra endepunkt Token)",
            "required": true,
            "schema": {
              "type": "string",
              "format": ""
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "members": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/medlem"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/respons"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid ID supplied"
          },
          "404": {
            "description": "Medlem ikke funnet"
          }
        }
      }
    },
    "/Token": {
      "get": {
        "tags": [
          "Token"
        ],
        "summary": "Returns a token for use when calling other endpoints",
        "description": "",
        "operationId": "",
        "parameters": [
          {
            "name": "Authentication",
            "in": "header",
            "description": "Bearer ..clientSecret...",
            "required": true,
            "schema": {
              "type": "string",
              "format": ""
            }
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/token"
                }
              }
            }
          },
          "400": {
            "description": "Invalid ID supplied"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "token": {
        "type": "object",
        "properties": {
          "Token": {
            "type": "string",
            "description": "Benyttes som token ved kall mot endepunkt"
          },
          "Expires": {
            "type": "string",
            "format": "date-time",
            "description": "Token utgår"
          }
        }
      },
      "medlem": {
        "type": "object",
        "properties": {
          "medlemsnr": {
            "type": "integer"
          },
          "etternavn": {
            "type": "string"
          },
          "fornavn": {
            "type": "string"
          },
          "adresse1": {
            "type": "string"
          },
          "adresse2": {
            "type": "string"
          },
          "adresse3": {
            "type": "string"
          },
          "adresse4": {
            "type": "string"
          },
          "postnr": {
            "type": "string"
          },
          "poststed": {
            "type": "string"
          },
          "land": {
            "type": "string"
          },
          "kategori": {
            "type": "string"
          },
          "underkategori": {
            "type": "string"
          },
          "arbeidssted": {
            "type": "string"
          },
          "kjonn": {
            "type": "string"
          },
          "tlfarbeid": {
            "type": "string"
          },
          "tlfprivat": {
            "type": "string"
          },
          "mobil": {
            "type": "string"
          },
          "epostarbeid": {
            "type": "string"
          },
          "epostprivat": {
            "type": "string"
          },
          "fdato": {
            "type": "string",
            "format": "date",
            "description": "Født dato"
          },
          "pnr": {
            "type": "integer",
            "description": "person nummer"
          },
          "fodselsnr": {
            "type": "integer"
          },
          "dnr": {
            "type": "integer",
            "description": "D-nummer"
          },
          "innmeldt": {
            "type": "string",
            "format": "date"
          },
          "utmeldt": {
            "type": "string",
            "format": "date"
          },
          "bedtutmeldt": {
            "type": "boolean"
          },
          "bedtslettet": {
            "type": "string",
            "format": "date"
          },
          "forsikringskode": {
            "type": "string"
          },
          "forsikringsdato": {
            "type": "string",
            "format": "date"
          },
          "dodaar": {
            "type": "string"
          },
          "stillingsprosent": {
            "type": "integer",
            "description": "Stillingsprosent (heltall)"
          },
          "samtykker": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/samtykker"
            }
          }
        }
      },
      "medlem (nytt)": {
        "allOf": [
          {
            "$ref": "#/components/schemas/medlem"
          },
          {
            "type": "object",
            "required": [
              "medlemsnr",
              "fornavn",
              "etternavn",
              "fdato",
              "postnr"
            ]
          }
        ]
      },
      "medlem (oppdater)": {
        "allOf": [
          {
            "$ref": "#/components/schemas/medlem"
          },
          {
            "type": "object",
            "required": [
              "medlemsnr"
            ]
          }
        ]
      },
      "adresser": {
        "type": "object",
        "properties": {
          "adresse1": {
            "type": "string"
          },
          "adresse2": {
            "type": "string"
          },
          "adresse3": {
            "type": "string"
          },
          "adresse4": {
            "type": "string"
          }
        }
      },
      "samtykker": {
        "type": "object",
        "properties": {
          "samtykketype": {
            "type": "string"
          },
          "samtykke": {
            "type": "boolean"
          },
          "samtykkedato": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "respons": {
        "type": "object",
        "properties": {
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "lest": {
            "type": "integer"
          },
          "nye": {
            "type": "integer"
          },
          "endret": {
            "type": "integer"
          },
          "reinnmeldt": {
            "type": "integer"
          },
          "utmeldt": {
            "type": "integer"
          },
          "prosessert": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/prosessert"
            }
          }
        }
      },
      "prosessert": {
        "type": "object",
        "properties": {
          "medlemnr": {
            "type": "integer"
          },
          "aksjonskode": {
            "type": "integer",
            "description": "1 NyttMedlem, 2 EndreMedlem, 3 Reinnmeldt, 4 UtmeldtMedlem, 5 Feil"
          },
          "statusOk": {
            "type": "boolean"
          },
          "melding": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/melding"
            }
          }
        }
      },
      "melding": {
        "type": "object",
        "properties": {
          "feltnavn": {
            "type": "string"
          },
          "melding": {
            "type": "string"
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "https://apinop.soderbergpartners.com/web/v1",
      "description": "Produksjons environment"
    },
    {
      "url": "https://apinop-prep.soderbergpartners.com/web/v1",
      "description": "Test environment"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ]
}
