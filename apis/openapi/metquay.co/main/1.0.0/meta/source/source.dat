  "components": {
    "securitySchemes": {
      "apiAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Customer": {
        "type": "object",
        "required": [
          "companyName",
          "companyCode",
          "workspaceCode"
        ],
        "properties": {
          "parentCompanyCode": {
            "type": "string",
            "example": "M3",
            "description": "Parent Company Code"
          },
          "companyCode": {
            "type": "string",
            "example": "D1",
            "description": "Unique number for the customer. If it is not given, then the metquay will auto genarate a unique number."
          },
          "isInactive": {
            "type": "boolean",
            "example": false,
            "description": "false for active customers. false to make a customer in active"
          },
          "companyName": {
            "type": "string",
            "example": "Darth Vadar Test",
            "description": "Customer Name"
          },
          "email": {
            "type": "string",
            "example": "jack.whitman@bresatech.com",
            "description": "Customer email"
          },
          "website": {
            "type": "string",
            "example": "http://www.espn.com",
            "description": "Customer website"
          },
          "paymentMethod": {
            "type": "string",
            "example": "Cash",
            "description": "Payment Method"
          },
          "phone": {
            "type": "string",
            "example": "91 88 77 66 55",
            "description": "Phone"
          },
          "mobile": {
            "type": "string",
            "example": "91 88 77 66 55",
            "description": "Phone"
          },
          "other": {
            "type": "string",
            "example": "91 88 77 66 55",
            "description": "Phone"
          },
          "activateAlerts": {
            "type": "boolean",
            "example": false,
            "description": "true to activate alerts for the customer."
          },
          "workspaceCode": {
            "type": "string",
            "example": "USA",
            "description": "Created workspace Code"
          },
          "hasBillingAddress": {
            "type": "boolean",
            "example": true,
            "description": "true if customer the address is Billing."
          },
          "billingAddr1": {
            "type": "string",
            "example": "123 Corporate Blvd",
            "description": "Address Line 1"
          },
          "billingAddr2": {
            "type": "string",
            "example": "Suite 500",
            "description": "Address Line 2"
          },
          "billingCity": {
            "type": "string",
            "example": "Metropolis",
            "description": "City"
          },
          "billingState": {
            "type": "string",
            "example": "California",
            "description": "State"
          },
          "billingZip": {
            "type": "string",
            "example": "94304"
          },
          "billingCountry": {
            "type": "string",
            "example": "USA"
          },
          "billingPhone1": {
            "type": "string",
            "example": "91 88 77 66 55",
            "description": "Billing Phone1"
          },
          "billingPhone2": {
            "type": "string",
            "example": "91 88 77 66 55",
            "description": "Billing Phone2"
          },
          "hasShippingAddress": {
            "type": "boolean",
            "example": true,
            "description": "true if customer the address is shipping."
          },
          "shippingAddr1": {
            "type": "string",
            "example": "123 Corporate Blvd",
            "description": "Address Line 1"
          },
          "shippingAddr2": {
            "type": "string",
            "example": "Suite 500",
            "description": "Address Line 2"
          },
          "shippingCity": {
            "type": "string",
            "example": "Metropolis",
            "description": "City"
          },
          "shippingState": {
            "type": "string",
            "example": "California",
            "description": "State"
          },
          "shippingZip": {
            "type": "string",
            "example": "94304"
          },
          "shippingCountry": {
            "type": "string",
            "example": "USA"
          },
          "customerSpecificRequirements": {
            "type": "string",
            "example": "Deliver between 9 AM - 5 PM. Signature required upon delivery.",
            "description": "Customer Specific Requirement"
          },
          "recordCreatedBy": {
            "type": "string",
            "example": "admin",
            "description": "Create by user name"
          },
          "recordCreatedDate": {
            "type": "string",
            "format": "date-time",
            "example": "2025-07-01 09:00:00",
            "description": "Created date"
          },
          "recordModifiedBy": {
            "type": "string",
            "example": "admin",
            "description": "Create by user name"
          },
          "recordModifiedDate": {
            "type": "string",
            "format": "date-time",
            "example": "2025-07-01 09:00:00",
            "description": "Last modified date"
          },
          "fax": {
            "type": "string",
            "example": "+1-646-555-0191",
            "description": "Fax number of the customer"
          },
          "notes": {
            "type": "string",
            "example": "Preferred customer with monthly recurring orders.",
            "description": "Notes about the customer"
          },
          "shortName": {
            "type": "string",
            "example": "QNova",
            "description": "Short name for the customer"
          },
          "isTaxable": {
            "type": "boolean",
            "example": true,
            "description": "True if the customer is taxable"
          },
          "taxCode": {
            "type": "string",
            "example": "001",
            "description": "Tax code applied to the customer"
          },
          "openingBalance": {
            "type": "number",
            "example": 250000.0,
            "description": "Opening balance of the customer"
          },
          "openingBalanceDate": {
            "type": "string",
            "format": "date",
            "example": "2025-01-01",
            "description": "Date of opening balance"
          }
        }
      },
      "CustomerInstrument": {
        "type": "object",
        "required": [
          "name",
          "companyId",
          "serialNo",
          "calibrationFrequency",
          "calibrationFrequencySpan",
          "workspaceCode"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "CP113-PN PRESSURE TRANSMITTER",
            "description": "Instrument name"
          },
          "companyId": {
            "type": "string",
            "example": "D1",
            "description": "Customer Id."
          },
          "serialNo": {
            "type": "string",
            "example": "SN-MQ-17-4",
            "description": "Serial number of instrument"
          },
          "tagNo": {
            "type": "string",
            "example": "TB",
            "description": "Tag number of instrument."
          },
          "make": {
            "type": "string",
            "example": "KIMO",
            "description": "Make."
          },
          "model": {
            "type": "string",
            "example": "MPR-500",
            "description": "Model."
          },
          "range": {
            "type": "string",
            "example": 1000,
            "description": "Range."
          },
          "instrumentCategoryName": {
            "type": "string",
            "example": "Appareil",
            "description": "Category"
          },
          "calibrationFrequency": {
            "type": "string",
            "example": 1,
            "description": "Calibration expiry frequency"
          },
          "calibrationFrequencySpan": {
            "type": "string",
            "example": "DAY/WEEK/MONTH/YEAR",
            "description": "Calibration Frequency Span can be DAY, WEEK, MONTH, YEAR"
          },
          "instrumentStatus": {
            "type": "string",
            "example": "RECEIVED/DELIVERED/ARCHIVED/CALIBRATED,etc",
            "description": "Instrument Status"
          },
          "lastReceivedDate": {
            "type": "string",
            "format": "date-time",
            "example": "11/06/2024 22:34:00",
            "description": "Last Received Date of instrument"
          },
          "lastDeliveredDate": {
            "type": "string",
            "format": "date-time",
            "example": "12/06/2024 22:34:00",
            "description": "Last Delivered Date of instrument"
          },
          "workspaceCode": {
            "type": "string",
            "example": "USA",
            "description": "created workspace code."
          }
        }
      },
      "InstrumentCategory": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "Thermometer",
            "description": "Instrument category name. The value should be unique."
          },
          "description": {
            "type": "string",
            "example": null,
            "description": "Instrument category description"
          },
          "createdBy": {
            "type": "string",
            "example": "admin",
            "description": "Create by user name"
          },
          "createdDate": {
            "type": "string",
            "format": "date-time",
            "example": "06-21-2021 22:34:00",
            "description": "Created date"
          },
          "lastModifiedDate": {
            "type": "string",
            "format": "date-time",
            "example": "06-21-2021 22:34:00",
            "description": "Last modified date"
          }
        }
      },
      "Work": {
        "type": "object",
        "required": [
          "customerInstrumentId"
        ],
        "properties": {
          "customerInstrumentId": {
            "type": "integer",
            "example": 1,
            "description": "Numeric ID of customer instrument in metquay. The value must be a number greater than 1 and a customer instrument must be present with the given ID in metquay."
          },
          "inDate": {
            "type": "string",
            "format": "date-time",
            "example": "06-21-2021 22:34:00",
            "description": "In date of work"
          },
          "accreditation": {
            "type": "boolean",
            "example": true,
            "description": "true for accredited work. false for non accredited work"
          },
          "complianceRequired": {
            "type": "boolean",
            "example": false,
            "description": "true if compliance required for the work. false otherwise"
          },
          "siteJob": {
            "type": "boolean",
            "example": false,
            "description": "true for on site work. false otherwise"
          },
          "outsource": {
            "type": "boolean",
            "example": false,
            "description": "true for sub con work. false otherwise"
          },
          "customerSpecificRequirements": {
            "type": "string",
            "example": "specific requirement",
            "description": "customer specific requirement for the work"
          },
          "scope": {
            "type": "string",
            "example": "scope",
            "description": "scope for the work"
          },
          "certificateAddress": {
            "type": "string",
            "example": "customer address",
            "description": "Address to be shown in the certificate"
          },
          "remarks": {
            "type": "string",
            "example": "customer",
            "description": "Remarks for the work"
          },
          "workFlowType": {
            "type": "string",
            "example": "Calibration",
            "description": "Calibration for calibration workflow, Testing for testing workflow and Evaluation for evaluation workflow"
          },
          "deliveryDate": {
            "type": "string",
            "format": "date-time",
            "example": "06-21-2021 22:34:00",
            "description": "Delivery date for the work"
          },
          "salesOrderNo": {
            "type": "string",
            "example": "SO/2021/6",
            "description": "Sales order number for the work"
          },
          "createdBy": {
            "type": "string",
            "example": "admin",
            "description": "Create by user name"
          },
          "createdDate": {
            "type": "string",
            "format": "date-time",
            "example": "06-21-2021 22:34:00",
            "description": "Created date"
          },
          "lastModifiedDate": {
            "type": "string",
            "format": "date-time",
            "example": "06-21-2021 22:34:00",
            "description": "Last modified date"
          },
          "workspaceCode": {
            "type": "string",
            "example": "WS1",
            "description": "Workspace code of the work"
          },
          "subConDetails": {
            "type": "string",
            "example": "Calibration work subcontracted to TechLabs Instruments on urgent basis.",
            "description": "Additional details for subcontracted work."
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "CreatedResponse": {
        "type": "object",
        "properties": {
          "metquayId": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "metquayId"
        ]
      }
    }
  }
}
