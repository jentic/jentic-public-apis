      "get": {
        "summary": "XML autorizado",
        "description": "Devolve o XML do documento, exatamente como veio da SEFAZ. Quando `xml_completo_disponivel` é `true`, é o XML completo autorizado; quando é `false`, devolve o XML de **resumo** (o nome do arquivo em `Content-Disposition` termina em `-resumo.xml` para não haver confusão). Responde `409 xml_indisponivel` quando o documento existe mas não há nenhum dos dois, e `404` só quando o documento não existe nesta empresa. Custo: 2 unidades quando há arquivo para baixar; 1 quando a requisição falha antes disso.\n\nO corpo é servido como `application/octet-stream`, com o nome do arquivo em `Content-Disposition`. Não use o `Content-Type` para decidir se deve fazer o parse: trate o corpo como XML sempre. O motivo é que a borda da infraestrutura reescreve respostas declaradas como `application/xml`.",
        "tags": [
          "Documentos"
        ],
        "security": [
          {
            "chaveApi": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "`id` (UUID) devolvido na listagem **ou** a chave de acesso do documento. Os dois resolvem para o mesmo documento: se o seu sistema já tem a chave, use a chave direto, sem buscar o UUID antes.",
            "schema": {
              "type": "string"
            },
            "example": "35260112345678000195550010000000011123456782"
          }
        ],
        "responses": {
          "200": {
            "description": "Bytes do XML (completo ou de resumo, conforme disponível).",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "Parâmetro inválido ou cursor corrompido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "401": {
            "description": "Chave ausente, inválida, revogada ou expirada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "403": {
            "description": "Escopo insuficiente ou plano sem acesso via API.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "404": {
            "description": "Documento não encontrado nesta empresa.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "409": {
            "description": "O documento existe, mas não há XML disponível (nem o resumo).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "429": {
            "description": "Limite de requisições excedido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        }
      }
    },
    "/v1/notas/{id}/pdf": {
      "get": {
        "summary": "PDF do documento (DANFE ou DANFSe)",
        "description": "Gera o PDF de representação do documento: DANFE para NF-e e NFC-e, DANFSe para NFS-e. Exige o XML completo (`xml_completo_disponivel: true`); documento só com resumo responde `409 xml_indisponivel`, que **não é definitivo** em nota recebida — o XML completo é liberado após a manifestação do destinatário (veja \"Como o XML completo é liberado\"). `404` só quando o documento não existe nesta empresa. Custo: 10 unidades quando o PDF é gerado; 1 quando a requisição falha antes da geração.",
        "tags": [
          "Documentos"
        ],
        "security": [
          {
            "chaveApi": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "`id` (UUID) devolvido na listagem **ou** a chave de acesso do documento. Os dois resolvem para o mesmo documento: se o seu sistema já tem a chave, use a chave direto, sem buscar o UUID antes.",
            "schema": {
              "type": "string"
            },
            "example": "35260112345678000195550010000000011123456782"
          }
        ],
        "responses": {
          "200": {
            "description": "PDF gerado.",
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "Parâmetro inválido ou cursor corrompido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "401": {
            "description": "Chave ausente, inválida, revogada ou expirada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "403": {
            "description": "Escopo insuficiente ou plano sem acesso via API.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "404": {
            "description": "Documento não encontrado nesta empresa.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "409": {
            "description": "O documento existe, mas só tem o resumo: sem XML completo não há PDF.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "429": {
            "description": "Limite de requisições excedido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        }
      }
    },
    "/v1/notas/exportacoes": {
      "post": {
        "summary": "Criar exportação em lote",
        "description": "Exporta XML e/ou PDF de vários documentos de uma vez, num ZIP com `manifesto.csv`. A seleção usa os mesmos filtros de `GET /v1/notas` (campo `filtros`, que exige um período fechado: `data_ref_de`+`data_ref_ate`, `data_emissao_de`+`data_emissao_ate` ou `data_criacao_de`+`data_criacao_ate`) ou uma lista explícita (`ids`). Entrega `arquivo` (padrão): assíncrona, responde `202` com um job para acompanhar. Entrega `direta`: síncrona, só XML e até 50 documentos, com o ZIP no corpo da resposta (`200`). Veja a seção \"Exportação em lote\". Custo: 20 unidades (`arquivo`) ou 10 (`direta`); requisição que falha na validação custa 1.",
        "tags": [
          "Exportações"
        ],
        "security": [
          {
            "chaveApi": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CriarExportacao"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Entrega `direta`: o ZIP vem no corpo da resposta.",
            "content": {
              "application/zip": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "202": {
            "description": "Entrega `arquivo`: exportação aceita. Acompanhe em `GET /v1/notas/exportacoes/{id}` (o header `Location` aponta para lá).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Exportacao"
                }
              }
            }
          },
          "400": {
            "description": "Parâmetro inválido ou cursor corrompido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "401": {
            "description": "Chave ausente, inválida, revogada ou expirada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "403": {
            "description": "Escopo insuficiente ou plano sem acesso via API.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "409": {
            "description": "Já existe uma exportação em andamento para esta empresa.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "422": {
            "description": "O pedido casa com documentos demais para o limite, ou com nenhum.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "429": {
            "description": "Limite de requisições por minuto, ou de exportações em 24 horas.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Listar exportações",
        "description": "As exportações mais recentes da empresa, com status e contadores. A listagem não traz `url` de download: consulte a exportação específica para receber o link.",
