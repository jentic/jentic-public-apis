    "/v1/notas/exportacoes/{id}": {
      "get": {
        "summary": "Status de uma exportação",
        "description": "Situação do job e, quando `concluida`, o link de download em `url` (válido por 1 hora; consulte de novo para receber outro). Enquanto `pendente`/`processando`, a resposta traz `Retry-After: 5`: respeite-o no polling.",
        "tags": [
