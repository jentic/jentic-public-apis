    "/v1/notas/{id}": {
      "get": {
        "summary": "Detalhe de uma nota",
        "description": "Busca um documento por `id` ou por chave de acesso. Devolve mais campos que a listagem (destinatário, natureza da operação, protocolo de autorização, finalidade) e aceita blocos opcionais via `incluir=tributos,referencias,etiquetas,duplicatas,cfop`.",
        "tags": [
          "Notas"
        ],
        "security": [
          {
            "chaveApi": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "`id` (UUID) devolvido na listagem **ou** a chave de acesso do documento. Os dois resolvem para o mesmo documento: se o seu sistema já tem a chave, use a chave direto, sem buscar o UUID antes.",
            "schema": {
              "type": "string"
            },
            "example": "35260112345678000195550010000000011123456782"
          },
          {
            "schema": {
              "type": "string",
              "description": "Blocos opcionais a incluir na resposta, separados por vírgula: `incluir=tributos,etiquetas`. Bloco não pedido não aparece na resposta. Valores aceitos: tributos, referencias, etiquetas, duplicatas, cfop."
            },
            "required": false,
            "description": "Blocos opcionais a incluir na resposta, separados por vírgula: `incluir=tributos,etiquetas`. Bloco não pedido não aparece na resposta. Valores aceitos: tributos, referencias, etiquetas, duplicatas, cfop.",
            "name": "incluir",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Documento encontrado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotaDetalhe"
                }
              }
