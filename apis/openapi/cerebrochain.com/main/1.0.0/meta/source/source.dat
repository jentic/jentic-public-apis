{"openapi":"3.1.0","info":{"title":"CerebroChain Supply Chain & Market Data API","version":"1.0.0","description":"Supply chain AI, warehouse optimization, logistics intelligence, real-time crypto/stock/forex data. Credit-based pricing at $0.001/credit.","contact":{"url":"https://cerebrochain.com"}},"servers":[{"url":"https://cerebrochain.com/api"}],"paths":{"/bot-marketplace/register":{"post":{"summary":"Register a bot and get an API key. Requires a signed-in CerebroChain account (Bearer JWT); the 1,000 trial credits are granted once per workspace.","operationId":"registerBot","security":[{"bearerAuth":[]}],"requestBody":{"content":{"application/json":{"schema":{"type":"object","required":["botName"],"properties":{"botName":{"type":"string"}}}}}},"responses":{"201":{"description":"Bot registered"}}}},"/bot-marketplace/credits/deposit":{"post":{"summary":"Deposit USDC for credits (bot-native)","operationId":"depositCredits","requestBody":{"content":{"application/json":{"schema":{"type":"object","required":["txHash"],"properties":{"txHash":{"type":"string"},"network":{"type":"string","enum":["base","polygon"]}}}}}},"responses":{"200":{"description":"Credits added"}},"security":[{"apiKey":[]}]}},"/bot/data/market/crypto":{"get":{"summary":"Real-time crypto prices via CoinGecko ($0.001)","operationId":"cryptoData","security":[{"apiKey":[]}],"parameters":[{"name":"symbol","in":"query","schema":{"type":"string"}}],"responses":{"200":{"description":"Market data"},"402":{"description":"Payment required"}}}},"/bot/data/market/forex":{"get":{"summary":"Forex rates via AlphaVantage ($0.001)","operationId":"forexData","security":[{"apiKey":[]}],"responses":{"200":{"description":"Forex rates"},"402":{"description":"Payment required"}}}},"/bot/data/logistics/rates":{"get":{"summary":"Shipping rates via Shippo ($0.005)","operationId":"shippingRates","security":[{"apiKey":[]}],"responses":{"200":{"description":"Rate quotes"},"402":{"description":"Payment required"}}}},"/bot/intelligence/basic":{"get":{"summary":"Basic market intelligence ($0.001)","operationId":"basicIntel","security":[{"apiKey":[]}],"responses":{"200":{"description":"Intelligence report"},"402":{"description":"Payment required"}}}},"/bot/intelligence/premium":{"get":{"summary":"Premium AI market analysis ($0.01)","operationId":"premiumIntel","security":[{"apiKey":[]}],"responses":{"200":{"description":"Premium analysis"},"402":{"description":"Payment required"}}}},"/bot/compute/inference":{"post":{"summary":"AI inference compute ($0.05)","operationId":"aiInference","security":[{"apiKey":[]}],"responses":{"200":{"description":"Inference result"},"402":{"description":"Payment required"}}}}},"components":{"securitySchemes":{"apiKey":{"type":"apiKey","in":"header","name":"X-API-Key","description":"Bot API key from /bot-marketplace/register"},"bearerAuth":{"type":"http","scheme":"bearer","bearerFormat":"JWT","description":"CerebroChain account token. Required to register a bot — sign up at https://app.cerebrochain.com/register."}}}}