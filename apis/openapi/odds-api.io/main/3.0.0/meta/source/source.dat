      "controllers.SettlementResponse": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "integer",
            "example": 74919888
          },
          "sport": {
            "type": "string",
            "example": "Football"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "live",
              "awaiting_result",
              "settled",
              "cancelled"
            ],
            "example": "settled"
          },
          "final": {
            "type": "boolean",
            "description": "True when you can stop polling this event.",
            "example": true
          },
          "settledAt": {
            "type": "string",
            "format": "date-time",
            "description": "When we recorded the final state. Omitted when unknown.",
            "example": "2026-10-04T19:02:11Z"
          },
          "scores": {
            "allOf": [
              {
                "$ref": "#/components/schemas/dto.Score"
              }
            ],
            "description": "Present only for settled events with a usable score."
          }
        }
      },
      "controllers.SettlementsResponse": {
        "type": "object",
        "properties": {
          "settlements": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/controllers.SettlementResponse"
            }
          },
          "notFound": {
            "type": "array",
            "description": "Event ids we have never seen.",
            "items": {
              "type": "string"
            },
            "example": [
              "999"
            ]
          }
        }
      },
      "controllers.GradeSelectionRequest": {
        "type": "object",
        "required": [
          "eventId",
          "market"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "description": "Your own id for the bet, echoed back. At most 64 characters.",
            "example": "bet-1"
          },
          "eventId": {
            "description": "Event id, as a number or a numeric string.",
            "oneOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "example": 74919888
          },
          "market": {
            "type": "string",
            "description": "Market name as served on /odds, for example ML, Spread, Totals HT, Corners Totals, Player Props.",
            "example": "Spread"
          },
          "side": {
            "type": "string",
            "description": "home, away, draw, over, under, yes, no, odd, even, 1x, 12, x2, none, neither, or an HT/FT pair such as draw/home. Leave it out when the label carries the bet: correct scores, Winning Margin, goal counts, highest scoring half, Home/Away Team Exact Goals (or send that market's own team), and First/Last Match Corner when the label is 1 or 2. Correct Score and Set Betting also take the score itself as side (\"2-1\") instead of a label.",
            "example": "home"
          },
          "hdp": {
            "type": "number",
            "description": "The line as served on /odds. Handicaps are stated for the home side. Required on handicap, totals, corners, bookings and player prop markets.",
            "example": -0.25
          },
          "label": {
            "type": "string",
            "description": "Row label as served. Required for Player Props (\"Arike Ogunbowale (Assists)\") and labelled markets: Home/Away Team Exact Goals (\"Arsenal - 2 Goals\"), Correct Score (\"2-1\"), Winning Margin (\"2 (1)\"), goal counts (\"3+ Goals\") and Highest Scoring Half (\"2nd Half\"). First/Last Match Corner also take \"1\" or \"2\".",
            "example": "Arike Ogunbowale (Assists)"
          },
          "tieRule": {
            "type": "string",
            "enum": [
              "lose",
              "void"
            ],
            "description": "What a level score does to a moneyline bet in sports where books differ. Ignored where a fixed rule applies."
          }
        }
      },
      "controllers.GradeRequest": {
        "type": "object",
        "required": [
          "selections"
        ],
        "properties": {
          "selections": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/controllers.GradeSelectionRequest"
            }
          }
        }
      },
      "settlement.Basis": {
        "type": "object",
        "description": "The score the verdict was computed from. Only on graded score markets.",
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "regulation",
              "full_game",
              "match_result",
              "first_half",
              "second_half",
              "first_period",
              "period_2",
              "period_3",
              "period_4",
              "period_5",
              "games",
              "map_1",
              "map_2",
              "map_3",
              "map_4",
              "map_5"
            ],
            "example": "regulation"
          },
          "home": {
            "type": "integer",
            "example": 3
          },
          "away": {
            "type": "integer",
            "example": 2
          }
        }
      },
      "controllers.GradeResponse": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "example": "bet-1"
          },
          "eventId": {
            "type": "integer",
            "example": 74919888
          },
          "result": {
            "type": "string",
            "enum": [
              "won",
              "lost",
              "void",
              "half_won",
              "half_lost",
              "pending",
              "ungradeable"
            ],
            "example": "won"
          },
          "reason": {
            "type": "string",
            "nullable": true,
            "description": "Null for won, lost, half_won and half_lost. Always set otherwise.",
            "enum": [
              "push",
              "event_cancelled",
              "event_not_started",
              "event_live",
              "awaiting_result",
              "awaiting_stats",
              "event_not_found",
              "unsupported_market",
              "invalid_side",
              "invalid_line",
              "invalid_label",
              "incomplete_score",
              "ambiguous_tie",
              "player_not_matched",
              "stats_unavailable",
              "result_unavailable",
              null
            ],
            "example": null
          },
          "final": {
            "type": "boolean",
            "description": "True when you can stop polling this selection.",
            "example": true
          },
          "basis": {
            "$ref": "#/components/schemas/settlement.Basis"
          }
        }
      },
      "controllers.GradesResponse": {
        "type": "object",
        "properties": {
          "grades": {
            "type": "array",
            "description": "One grade per selection, in the order sent.",
            "items": {
              "$ref": "#/components/schemas/controllers.GradeResponse"
            }
          }
        }
      },
      "dto.OutrightDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 1001
          },
          "name": {
            "type": "string",
            "example": "World Wide Technology Championship 2026"
          },
          "date": {
            "type": "string",
            "format": "date-time",
            "description": "Scheduled start of the first round"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "live",
              "settled",
              "cancelled"
            ]
          },
          "sport": {
            "$ref": "#/components/schemas/dto.Sport"
          },
          "league": {
            "$ref": "#/components/schemas/dto.League"
          },
          "bookmakerCount": {
            "type": "integer",
            "description": "How many bookmakers you can request in /outrights/odds currently price this outright: any bookmaker with a current price for at least one golfer counts.",
            "example": 40
          }
        }
      },
      "dto.OutrightRunner": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "example": "Ben Griffin"
          },
          "participantId": {
            "type": "integer",
            "format": "int64",
            "description": "Participant id from /participants",
            "example": 991291386379
          },
          "odds": {
            "type": "string",
            "description": "Decimal back price (Winner and Top N markets)",
            "example": "16.129"
          },
          "layOdds": {
            "type": "string",
            "description": "Decimal lay price on exchanges and prediction markets (Winner and Top N markets)",
            "example": "18.182"
          },
          "yes": {
            "type": "string",
            "description": "Decimal price that the golfer makes the cut (Make Cut)",
            "example": "1.149"
          },
          "no": {
            "type": "string",
            "description": "Decimal price that the golfer misses the cut (Make Cut)",
            "example": "6.667"
          },
          "layYes": {
            "type": "string",
            "description": "Lay price of yes on exchanges (Make Cut)",
            "example": "1.16"
          },
          "layNo": {
            "type": "string",
            "description": "Lay price of no on exchanges (Make Cut)",
            "example": "7.00"
          }
        }
      },
      "dto.OutrightMarketDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "Winner",
              "Top 5",
              "Top 5 (Incl. Ties)",
              "Top 10",
              "Top 10 (Incl. Ties)",
              "Top 20",
              "Top 20 (Incl. Ties)",
              "Make Cut"
            ],
            "description": "Top N settles boundary ties under dead-heat rules; Top N (Incl. Ties) pays boundary ties in full. The two are separate markets."
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When a price in this market last changed"
          },
          "odds": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/dto.OutrightRunner"
            }
          }
        }
      },
      "dto.OutrightOddsResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 1001
          },
          "name": {
            "type": "string",
            "example": "World Wide Technology Championship 2026"
          },
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "live",
              "settled",
              "cancelled"
            ]
          },
          "sport": {
            "$ref": "#/components/schemas/dto.Sport"
          },
          "league": {
            "$ref": "#/components/schemas/dto.League"
          },
          "bookmakers": {
            "type": "object",
            "description": "Markets per bookmaker name",
            "additionalProperties": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/dto.OutrightMarketDto"
              }
            }
          }
        }
      },
      "dto.OutrightResultRow": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "example": "Andrew Novak"
          },
          "participantId": {
            "type": "integer",
            "format": "int64",
            "example": 991570904131
          },
          "position": {
            "type": "integer",
            "nullable": true,
            "description": "Final position; shared by tied golfers; null for cut, withdrawn and disqualified",
            "example": 1
          },
          "tied": {
            "type": "boolean"
          },
          "madeCut": {
            "type": "boolean",
            "nullable": true,
            "description": "null when the event has no cut, or the golfer withdrew before round 1"
          },
          "status": {
            "type": "string",
            "enum": [
              "finished",
              "cut",
              "withdrawn",
              "disqualified"
            ]
          }
        }
      },
      "dto.OutrightResultsResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 1000
          },
          "name": {
            "type": "string",
            "example": "Mexico Open 2026"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "live",
              "settled",
              "cancelled"
            ]
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/dto.OutrightResultRow"
            }
          },
          "winners": {
            "type": "object",
            "description": "Participant ids that won each market (Winner, Top 5/10/20, Top 5/10/20 (Incl. Ties), Make Cut). Top N and Top N (Incl. Ties) list the same golfers. Empty until settled. Make Cut is absent on events without a cut",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "int64"
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "query",
        "name": "apiKey",
        "description": "Your Odds-API.io API key, sent as the apiKey query parameter. Get one at https://odds-api.io/pricing."
      }
    }
  }
}
