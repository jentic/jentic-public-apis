    "/bookmakers/selected/clear": {
      "put": {
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "description": "Remove all selected bookmakers for the authenticated user. Rate limited to once every 12 hours; the cooldown may be shorter for newly created accounts.",
