      "dto.EsportsDto": {
        "type": "object",
        "description": "Present on esports events only",
        "properties": {
          "game": {
            "allOf": [
              {
                "$ref": "#/components/schemas/dto.Sport"
              }
            ],
            "description": "The game being played, e.g. {\"name\": \"Valorant\", \"slug\": \"valorant\"}"
          },
          "league": {
            "allOf": [
              {
                "$ref": "#/components/schemas/dto.League"
              }
            ],
            "description": "Parent league (VCT, LCK, LEC). Its slug stays the same across the league's splits and stages."
          },
          "region": {
            "description": "Region of the tournament: Western Europe, Eastern Europe, North America, South America, Asia, Oceania or Middle East. Omitted when unknown.",
            "type": "string",
