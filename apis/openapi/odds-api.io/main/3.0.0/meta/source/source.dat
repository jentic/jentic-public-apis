              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/controllers.ErrorResponse"
                }
              }
            }
          }
        },
        "x-mint": {
          "metadata": {
            "description": "List outright tournaments with the number of bookmakers pricing each. Golf first: PGA Tour, DP World Tour, LIV Golf and the majors."
          }
        }
      }
    },
