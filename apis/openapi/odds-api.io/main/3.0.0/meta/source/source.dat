    "/odds/summary": {
      "get": {
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "description": "Best, average, median, worst and margin-free fair price per market line across bookmakers, for odds comparison pages. A bookmaker counts only while its prices are updating (a change within 5 minutes before kickoff, 60 seconds live). Exchanges are reported separately. Available on Growth plans and above. Free, Solo and Starter plans receive a sample response with demo set to true and an X-OddsAPI-Demo: true header.",
        "tags": [
          "Odds"
        ],
        "summary": "Get Odds Summary",
        "parameters": [
          {
            "description": "API key for authentication",
            "name": "apiKey",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Event ID",
            "name": "eventId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "\"123456\""
          },
          {
            "description": "Comma-separated market names, case-insensitive (default ML,Spread,Totals, max 20)",
            "name": "markets",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "main (default) returns each ladder market's main line; all returns every line priced by at least 3 bookmakers",
            "name": "lines",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Restrict the summary to these bookmakers. Each must be in your selected bookmakers",
            "name": "bookmakers",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Add the best exchange back price per outcome in a separate exchanges block",
            "name": "includeExchanges",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/controllers.EventSummary"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/controllers.ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/controllers.ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/controllers.ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/controllers.ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/controllers.ErrorResponse"
                }
              }
            }
          }
        },
        "x-mint": {
          "metadata": {
            "description": "Best, average, median, worst and margin-free fair price per market line across bookmakers for one event, for odds comparison pages. Growth plans and up."
          }
        }
      }
    },
