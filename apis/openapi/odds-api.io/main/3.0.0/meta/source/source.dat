    "/outrights": {
      "get": {
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "description": "Lists outright (futures) tournaments for a sport, sorted by start date. bookmakerCount is how many bookmakers you can request in /outrights/odds currently price each one, counting any bookmaker with a current price for at least one golfer. Golf is the first sport. The default list covers the whole season, so later tournaments show bookmakerCount 0 until bookmakers price them; filter by league to narrow it. Part of the Outrights add-on on paid plans.",
        "tags": [
          "Outrights"
        ],
        "summary": "List Outrights",
        "parameters": [
          {
            "description": "API key for authentication",
            "name": "apiKey",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "example": "golf",
            "description": "Sport name or slug",
            "name": "sport",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "example": "pga-tour",
            "description": "League slug: pga-tour, dp-world-tour, liv-golf or majors",
            "name": "league",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "example": "pending,live",
            "description": "Comma-separated statuses: pending, live, settled, cancelled. Default: pending,live",
