{
  "openapi": "3.0.0",
  "x-origin": [
    {
      "url": "https://api.odds-api.io/v3/docs/doc.json",
      "format": "swagger",
      "version": "2.0",
      "converter": {
        "url": "https://github.com/mermade/oas-kit",
        "version": "7.0.8"
      }
    }
  ],
  "info": {
    "description": "Odds-API.io is a powerful sports betting odds comparison API, providing real-time data from 450+ bookmakers across 34 sports with near zero latency.\n\n- 450+ bookmakers supported\n- 34 sports including Football, Basketball, Tennis, Esports and more\n- Real-time odds with close to zero latency\n- Pre-match & In-play odds coverage\n- 99.9% uptime for reliability",
    "title": "Odds-API.io - Real-Time Sports Betting Odds API (v3)",
    "contact": {},
    "version": "3.0.0"
  },
  "paths": {
    "/arbitrage-bets": {
      "get": {
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "description": "Returns prematch arbitrage opportunities where every leg uses one of the specified bookmakers, sorted by profit margin (highest first). Opportunities are refreshed every few seconds and removed as soon as the prices move or the match starts. Margins and stakes use prices after exchange fees, and stakes respect the limits bookmakers report, so totalStake can be below 1000. By default only the best combination per event, market and line is returned; set allCombinations=true for every combination.",
        "tags": [
          "Arbitrage Bets"
        ],
        "summary": "Get arbitrage betting opportunities",
        "parameters": [
          {
            "description": "API key for authentication",
            "name": "apiKey",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "example": "\"Bet365,SingBet\"",
            "description": "Comma-separated list of bookmakers (e.g. Bet365,SingBet)",
            "name": "bookmakers",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "example": "football",
            "description": "Filter by sport name or slug (e.g. Football or football)",
            "name": "sport",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "example": "england-premier-league",
            "description": "Filter by league slug (e.g. england-premier-league). Requires sport to also be set.",
            "name": "league",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "example": "ML,Spread,Totals",
            "description": "Comma-separated market names to keep, case-insensitive (max 40)",
            "name": "markets",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "example": 1.5,
            "description": "Minimum profitMargin in percent, between 0 and 100 (e.g. 1.5 for 1.5%)",
            "name": "minProfit",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },
          {
            "example": false,
            "description": "Return every bookmaker combination per event, market and line instead of only the best one (default false)",
            "name": "allCombinations",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "example": 50,
            "description": "Maximum number of results (default 50, max 500)",
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "example": true,
            "description": "Include event details",
            "name": "includeEventDetails",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/dto.ArbitrageOpportunity"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/controllers.ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/controllers.ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/controllers.ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found (unknown league for the sport)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/controllers.ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/controllers.ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/bookmakers": {
      "get": {
        "description": "Fetch a list of supported bookmakers with their current status. `status` is `ok`, `degraded` (no odds update for 60+ minutes) or `down` (no odds update for 3+ hours on a book with 100+ active matches). Odds from a `down` bookmaker are left out of every odds endpoint and removed over the WebSocket until it recovers. `reason` is null when `ok`. For a `degraded` or `down` bookmaker it is `maintenance` (the bookmaker is temporarily offline on its side, such as an announced maintenance; a `degraded` bookmaker in maintenance still has its odds served) or `unavailable` (we temporarily have no fresh odds from this bookmaker).",
        "tags": [
          "Bookmakers"
        ],
        "summary": "Get Bookmakers",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/models.Bookmaker"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/controllers.ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/controllers.ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/controllers.ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/controllers.ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/controllers.ErrorResponse"
                }
              }
            }
          }
        },
        "x-mint": {
          "metadata": {
            "description": "List every bookmaker you can query through Odds-API.io, from sportsbooks to exchanges and prediction markets, with each bookmaker's name, active flag and live feed status."
          }
        },
        "security": []
      }
    },
