              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/controllers.ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/controllers.ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/controllers.ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/controllers.ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/controllers.ErrorResponse"
                }
              }
            }
          }
        },
        "x-mint": {
          "metadata": {
            "description": "Get prematch odds movements for one market line from one bookmaker: opening price, latest price and recent changes, for a fixed set of tracked bookmakers."
          }
        }
      }
    },
    "/odds/multi": {
      "get": {
        "description": "Returns odds comparison for up to 10 events from selected bookmakers (counts as only 1 request).",
        "tags": [
          "Odds"
        ],
        "summary": "Get Odds for Multiple Events",
        "parameters": [
          {
            "description": "API key for authentication",
            "name": "apiKey",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Comma-separated list of up to 10 Event IDs",
            "name": "eventIds",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Comma-separated list of bookmaker names (max 30)",
            "name": "bookmakers",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Comma-separated market names to keep, case-insensitive (max 40)",
            "name": "markets",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "example": "ML,Spread,Totals"
          },
          {
            "example": true,
            "description": "Set to true to get the current WebSocket sequence number in the `X-OddsAPI-Seq` response header. Pass it as `lastSeq` when you open or reopen the WebSocket, so updates after this snapshot are replayed.",
            "name": "includeSeq",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "X-OddsAPI-Seq": {
                "description": "Current WebSocket sequence number. Sent when `includeSeq=true`.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/controllers.EventResponse"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/controllers.ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/controllers.ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/controllers.ErrorResponse"
                }
              }
            }
          }
        },
        "x-mint": {
          "metadata": {
            "description": "Get odds for up to 10 events from your chosen bookmakers in one call, counted as a single request, with the same markets as the single-event odds endpoint."
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/odds/updated": {
      "get": {
        "description": "Returns updated event odds for a specific bookmaker since a given UNIX timestamp (max 90 seconds old). The response is a delta: each event carries only the market groups whose `updatedAt` is at or after `since`, and an event with no changed market group is omitted entirely. Merge responses by event and market name; a market that is absent has not changed, and a withdrawn market is not signalled here (re-read the event with `/odds`, or use the WebSocket feed).",
        "tags": [
          "Odds"
        ],
        "summary": "Get updated event odds since a given timestamp",
        "parameters": [
          {
            "description": "API key for authentication",
            "name": "apiKey",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Unix timestamp (max 90 seconds old)",
            "name": "since",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "description": "Bookmaker name (e.g. Bet365). The response uses the same name; `bookmaker=Bet365` also returns a `Bet365 (no latency)` key, as `/odds/multi` does.",
            "name": "bookmaker",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Sport name (e.g. Football)",
            "name": "sport",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Max events to return (default and maximum 10000)",
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            }
          },
          {
            "description": "Comma-separated market names to keep, case-insensitive (max 40). Required from 19 October 2026: a call without it, or where none of the names exist, returns 400. Valid names: /v3/markets?sport=<sport>",
            "name": "markets",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "example": "ML,Spread,Totals"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "X-Server-Time": {
                "description": "Unix seconds captured on the server just before the query ran",
                "schema": {
                  "type": "integer"
                }
              },
              "X-Next-Since": {
                "description": "Value to pass as `since` on the next call. X-Server-Time minus 10 seconds when the response was not truncated by `limit`, so odds that become visible a few seconds after they were stamped are not skipped (the overlap can re-send recent updates; merge them by event and market); otherwise the unix-second floor of the last returned event's `updated_at`. Accepted as `since` while it is no more than 100 seconds old, so drain truncated pages promptly",
                "schema": {
                  "type": "integer"
                }
              },
              "X-Unknown-Markets": {
                "description": "Requested market names that do not exist, when some but not all are unknown",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/controllers.EventResponse"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/controllers.ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/controllers.ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/controllers.ErrorResponse"
                }
              }
            }
          }
        },
        "x-mint": {
          "metadata": {
            "description": "Get odds from one bookmaker for events updated since a UNIX timestamp up to 90 seconds old, so you can poll for changes instead of refetching every event."
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
