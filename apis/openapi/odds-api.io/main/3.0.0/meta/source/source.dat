    "/outrights/results": {
      "get": {
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "description": "Returns final positions and the winners of each market for one outright. results and winners are empty until the outright is settled. Tied golfers share a position with tied true, so a Top N list can be longer than N; Top N and Top N (Incl. Ties) list the same golfers and differ only in how a boundary tie is paid. madeCut is null on events without a cut, and Make Cut is then absent from winners. Part of the Outrights add-on on paid plans.",
        "tags": [
          "Outrights"
        ],
        "summary": "Get Outright Results",
        "parameters": [
          {
            "description": "API key for authentication",
            "name": "apiKey",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "example": 1000,
            "description": "Outright id from /outrights",
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/dto.OutrightResultsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/controllers.ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/controllers.ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Outrights add-on required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/controllers.ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Outright not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/controllers.ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/controllers.ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/controllers.ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/controllers.ErrorResponse"
                }
              }
            }
          }
        },
        "x-mint": {
          "metadata": {
            "description": "Final tournament results with positions, ties, made cut and the winners of each outright market."
          }
        }
      }
    },
    "/settlements": {
      "get": {
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "description": "Returns the settlement record for up to 50 events: status, whether the result is final, and the final scores. Every id gets an answer, including cancelled and not yet resulted events. Paid plans only.",
        "tags": [
          "Settlement"
        ],
        "summary": "Get Settlements",
        "parameters": [
          {
            "description": "API key for authentication",
            "name": "apiKey",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "example": "74919888,73722728",
            "description": "Comma-separated event ids (1 to 50)",
            "name": "eventIds",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/controllers.SettlementsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/controllers.ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/controllers.ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Paid plans only",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/controllers.ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/controllers.ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/controllers.ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Storage unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/controllers.ErrorResponse"
                }
              }
            }
          }
        },
        "x-mint": {
          "metadata": {
            "description": "Get the settlement record for up to 50 events: status, whether the result is final and the final scores, including cancelled events. Paid plans only."
          }
        }
      }
    },
    "/settlements/grade": {
      "post": {
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "description": "Grades up to 50 bet selections against final results. Each selection is the event id, market name, side and, where the market has one, the line (hdp) and label exactly as served on /odds. Returns won, lost, void, half_won, half_lost, pending or ungradeable per selection, with a reason for void, pending and ungradeable answers (reason is null for won, lost, half_won and half_lost). Paid plans only.",
        "tags": [
          "Settlement"
        ],
        "summary": "Grade Selections",
        "parameters": [
          {
            "description": "API key for authentication",
            "name": "apiKey",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "description": "Selections to grade. At most 64 KB.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/controllers.GradeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/controllers.GradesResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/controllers.ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/controllers.ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Paid plans only",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/controllers.ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/controllers.ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/controllers.ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Storage unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/controllers.ErrorResponse"
                }
              }
            }
          }
        },
        "x-mint": {
          "metadata": {
            "description": "Grade up to 50 bet selections against final results and get won, lost, void, half won, half lost, pending or ungradeable for each one. Paid plans only."
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "https://api.odds-api.io/v3"
    }
  ],
  "components": {
    "schemas": {
      "controllers.ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "Error message"
          }
        }
      },
      "controllers.EventResponse": {
        "type": "object",
        "properties": {
          "away": {
            "type": "string"
          },
          "awayId": {
            "type": "integer"
          },
          "bookmakerIds": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "bookmakers": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/dto.MultiMarketDto"
              }
            }
          },
          "date": {
            "type": "string"
          },
          "home": {
            "type": "string"
          },
          "homeId": {
            "type": "integer"
          },
          "id": {
            "type": "integer"
          },
          "league": {
            "$ref": "#/components/schemas/controllers.League"
          },
          "scores": {
            "$ref": "#/components/schemas/dto.Score"
          },
          "sport": {
            "$ref": "#/components/schemas/controllers.Sport"
          },
          "status": {
            "description": "Whether the match is under way: pending, live, settled or cancelled. Can read live before the listed start, or while /events still lists the event as pending. A pending event never carries in-play prices.",
            "type": "string"
          },
          "urls": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "controllers.HandicapMovement": {
        "type": "object",
        "properties": {
          "away": {
            "type": "number"
          },
          "draw": {
            "type": "number"
          },
          "hdp": {
            "type": "string"
          },
          "home": {
            "type": "number"
          },
          "max": {
            "type": "integer"
          },
          "timestamp": {
            "type": "integer"
          }
        }
      },
      "controllers.HandicapMovementsResponse": {
        "type": "object",
        "properties": {
          "bookmaker": {
            "type": "string"
          },
          "eventid": {
            "type": "string"
          },
          "latest": {
            "$ref": "#/components/schemas/controllers.HandicapMovement"
          },
          "movements": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/controllers.HandicapMovement"
            }
          },
          "opening": {
            "$ref": "#/components/schemas/controllers.HandicapMovement"
          }
        }
      },
      "controllers.League": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Premier League"
          },
          "slug": {
            "type": "string",
            "example": "premier-league"
          }
        }
      },
      "controllers.LeagueResponse": {
        "type": "object",
        "properties": {
          "eventsCount": {
            "type": "integer",
            "example": 32
          },
          "name": {
            "type": "string",
            "example": "England - Premier League"
          },
          "slug": {
            "type": "string",
            "example": "england-premier-league"
          }
        }
      },
      "controllers.MarketInfo": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Spread",
            "description": "Market name, as it appears in /odds responses."
          },
          "shape": {
            "type": "string",
            "enum": [
              "moneyline",
              "line",
              "outcomes",
              "yesno",
              "labelled"
            ],
            "example": "line",
            "description": "How to parse the odds. `moneyline`: home/away (+draw on 3-way markets). `line`: one entry per line, with hdp and over/under or home/away. `outcomes`: fixed outcomes (1X/12/X2, odd/even, home/away/none, home/away/neither). `yesno`: yes/no prices. `labelled`: one price per label (\"2-1\", \"1st Half\", a player name)."
          },
          "period": {
            "type": "string",
            "enum": [
              "match",
              "first-half",
              "second-half",
              "quarter",
              "set",
              "game",
              "inning"
            ],
            "example": "match",
            "description": "Which part of the event the market covers."
          },
          "prematch": {
            "type": "boolean",
            "example": true,
            "description": "Offered pre-match."
          },
          "live": {
            "type": "boolean",
            "example": true,
            "description": "Offered in-play."
          }
        }
      },
      "controllers.MarketsResponse": {
        "type": "object",
        "properties": {
          "sport": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "example": "Football"
              },
              "slug": {
                "type": "string",
                "example": "football"
              }
            }
          },
          "markets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/controllers.MarketInfo"
            }
          }
        }
      },
      "controllers.Sport": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Football"
          },
          "slug": {
            "type": "string",
            "example": "football"
          }
        }
      },
      "controllers.SportResponse": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Football"
          },
          "slug": {
            "type": "string",
            "example": "football"
          }
        }
      },
      "dto.ArbitrageLeg": {
        "type": "object",
        "properties": {
          "bookmaker": {
            "type": "string",
            "example": "Bet365"
          },
          "bookmakerFixtureId": {
            "type": "string",
            "description": "The bookmaker's own event id, when known. Not present on every response."
          },
          "href": {
            "type": "string",
            "description": "Link to the event on the bookmaker, or \"N/A\" when none is known.",
            "example": "https://www.bet365.com/..."
          },
          "odds": {
            "type": "string",
            "description": "Decimal odds",
            "example": "2.08"
          },
          "netOdds": {
            "type": "string",
            "description": "Price after exchange fees (for example exchange commission or prediction-market taker fees). Only present when fees apply; profitMargin, impliedProbability and optimalStakes use this price.",
            "example": "2.026"
          },
          "maxStake": {
            "type": "number",
            "description": "Stake limit reported by the bookmaker for this price, when known. optimalStakes never exceed it.",
            "example": 250
          },
          "oddsUpdatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Last time we wrote this bookmaker price. May be absent.",
            "example": "2026-10-21T09:40:12Z"
          },
          "side": {
            "type": "string",
            "enum": [
              "home",
              "away",
              "draw",
              "over",
              "under"
            ],
            "example": "home"
          }
        }
      },
      "dto.ArbitrageOpportunity": {
        "type": "object",
        "properties": {
          "event": {
            "description": "Only included if includeEventDetails=true",
            "allOf": [
              {
                "$ref": "#/components/schemas/dto.EventInfo"
              }
            ]
          },
          "eventId": {
            "type": "integer",
            "example": 123456
          },
          "firstSeenAt": {
            "type": "string",
            "format": "date-time",
            "description": "When this combination first appeared",
            "example": "2026-10-20T18:30:02Z"
          },
          "id": {
            "type": "string",
            "description": "{eventId}-{market}[-{hdp}] followed by {bookmaker}-{side} for each leg",
            "example": "123456-ML-Bet365-home-SingBet-away"
          },
          "impliedProbability": {
            "type": "number",
            "description": "Sum of 1/odds across the legs, using netOdds where fees apply; below 1 for an arbitrage",
            "example": 0.9758
          },
          "legs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/dto.ArbitrageLeg"
            }
          },
          "market": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "example": "Spread"
              },
              "hdp": {
                "type": "number",
                "description": "Line for Spread and Totals markets; omitted when the market has no line",
                "example": -1.5
              }
            }
          },
          "optimalStakes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/dto.OptimalStake"
            }
          },
          "profitMargin": {
            "type": "number",
            "description": "Margin at the quoted prices after exchange fees, as a percentage of totalStake (2.48 means 2.48%)",
            "example": 2.48
          },
          "totalStake": {
            "type": "number",
            "description": "1000, or less when a leg's maxStake caps the split; scale optimalStakes to your bankroll",
            "example": 1000
          },
          "updatedAt": {
            "type": "string",
            "description": "Last time the opportunity was confirmed",
            "example": "2026-10-20T18:42:11Z"
          }
        }
      },
      "dto.BookmakerOdds": {
        "type": "object",
        "properties": {
          "away": {
            "type": "string"
          },
          "awayDirectLink": {
            "type": "string"
          },
          "draw": {
            "type": "string"
          },
          "drawDirectLink": {
            "type": "string"
          },
          "hdp": {
            "type": "string"
          },
          "home": {
            "type": "string"
          },
          "homeDirectLink": {
            "type": "string"
          },
          "href": {
            "type": "string"
          }
        }
      },
      "dto.ClockDto": {
        "type": "object",
        "description": "Live match-clock state for in-play events. minute/playedSeconds are extrapolated server-side from the live feed and only advance while running is true.",
        "properties": {
          "minute": {
            "type": "integer",
            "example": 67,
            "description": "Current match minute"
          },
          "playedSeconds": {
            "type": "integer",
            "example": 4023,
            "description": "Seconds of play elapsed"
          },
          "period": {
            "type": "integer",
            "example": 2,
            "description": "Current period number"
          },
          "running": {
            "type": "boolean",
            "example": true,
            "description": "Whether the clock is currently running"
          },
          "statusDetail": {
            "type": "string",
            "example": "2nd half",
            "description": "Human-readable phase of play"
          },
          "serve": {
            "type": "string",
            "enum": [
              "home",
              "away"
            ],
            "description": "Current server (tennis, table tennis, volleyball)"
          },
          "injuryTime": {
            "type": "integer",
            "example": 4,
            "description": "Announced injury/stoppage time in minutes (football)"
          },
          "periodStartedAt": {
            "type": "integer",
            "example": 1792170000,
            "description": "Unix timestamp (seconds) when the current period started. Sent only when the feed has no played clock (for example ice hockey games with basic coverage), never alongside playedSeconds. Wall time, not game time: a stopped clock makes the elapsed wall time longer than the time played, so never treat it as playedSeconds. Omitted when the value is missing, in the future, or more than 3 hours old. Also present in WebSocket clock snapshots."
          }
        }
      },
      "dto.DroppingOddsEntry": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "integer",
            "example": 69455182
          },
          "event": {
            "$ref": "#/components/schemas/dto.DroppingOddsEvent"
          },
          "market": {
            "$ref": "#/components/schemas/dto.Market"
          },
          "betSide": {
            "type": "string",
            "enum": [
              "home",
              "away",
              "over",
              "under"
            ],
            "example": "home"
          },
          "odds": {
            "$ref": "#/components/schemas/dto.DroppingOddsMovement"
          },
          "lastMovedAt": {
            "type": "integer",
            "nullable": true,
            "description": "Unix milliseconds timestamp of last odds movement",
            "example": 1775851240182
          },
          "updatedAt": {
            "type": "integer",
            "description": "Unix milliseconds timestamp of last pipeline update",
            "example": 1775854172851
          }
        }
      },
      "dto.DroppingOddsEvent": {
        "type": "object",
        "properties": {
          "home": {
            "type": "string",
            "example": "Arsenal"
          },
          "away": {
            "type": "string",
            "example": "Bournemouth"
          },
          "date": {
            "type": "string",
            "description": "ISO 8601 date",
            "example": "2026-04-12T15:00:00.000Z"
          },
          "sport": {
            "$ref": "#/components/schemas/dto.Sport"
          },
          "league": {
            "$ref": "#/components/schemas/dto.League"
          }
        }
      },
      "dto.DroppingOddsMovement": {
        "type": "object",
        "properties": {
          "opening": {
            "type": "number",
            "description": "Opening odds value",
            "example": 2.05
          },
          "current": {
            "type": "number",
            "description": "Current odds value",
            "example": 1.52
          },
          "drop": {
            "$ref": "#/components/schemas/dto.OddsDrop"
          }
        }
      },
      "dto.EventInfo": {
        "type": "object",
        "properties": {
          "away": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "home": {
            "type": "string"
          },
          "league": {
            "type": "string"
          },
          "sport": {
            "type": "string"
          }
        }
      },
      "dto.EventValueBet": {
        "type": "object",
        "properties": {
          "betSide": {
            "type": "string"
          },
          "bookmaker": {
            "type": "string"
          },
          "bookmakerOdds": {
            "$ref": "#/components/schemas/dto.BookmakerOdds"
          },
          "event": {
            "$ref": "#/components/schemas/dto.EventInfo"
          },
          "eventId": {
            "type": "integer"
          },
          "expectedValue": {
            "type": "number",
            "description": "Bookmaker odds / fair odds x 100. 100 is the fair price; 103.42 means a 3.42% edge (edge in percent = expectedValue - 100). Values below 100 are a negative edge.",
            "example": 103.42
          },
          "expectedValueUpdatedAt": {
            "type": "string",
            "description": "Last time the expected value or the sharp limit increased. Not a freshness signal."
          },
          "firstSeenAt": {
            "type": "string",
            "format": "date-time",
            "description": "When this value bet first appeared."
          },
          "bookmakerOddsUpdatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Last time this bookmaker price was written. May be absent."
          },
          "id": {
            "type": "string"
          },
          "market": {
            "$ref": "#/components/schemas/dto.MarketResult"
          }
        }
      },
      "dto.League": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          }
        }
      },
      "dto.Market": {
        "type": "object",
        "properties": {
          "hdp": {
            "type": "number"
          },
          "label": {
            "type": "string",
            "description": "Player name for player prop markets (e.g. \"Carlos Baleba\"). Only present on player prop entries."
          },
          "name": {
            "type": "string"
          }
        }
      },
      "dto.MarketResult": {
        "type": "object",
        "properties": {
          "away": {
            "type": "string"
          },
          "draw": {
            "type": "string"
          },
          "hdp": {
            "type": "number"
          },
          "home": {
            "type": "string"
          },
          "max": {
            "type": "number"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "dto.MultiMarketDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "odds": {
            "type": "array",
            "items": {
