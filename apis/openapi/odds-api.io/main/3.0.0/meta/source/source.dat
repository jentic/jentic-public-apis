      "dto.EsportsFormatDto": {
        "type": "object",
        "properties": {
          "type": {
            "description": "bestOf or firstTo",
            "type": "string",
            "example": "bestOf"
          },
          "games": {
            "description": "Number of games: 3 for a best of 3",
            "type": "integer",
            "example": 3
          }
        }
      },
      "dto.Sport": {
        "type": "object",
        "properties": {
