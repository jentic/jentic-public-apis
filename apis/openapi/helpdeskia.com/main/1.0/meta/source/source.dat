{
  "openapi": "3.0.4",
  "info": {
    "title": "Helpdesk IA API",
    "description": "API para gerenciamento de tickets do sistema Helpdesk IA.  \nPermite criação, consulta, atualização e verificação de tickets, além do envio de comentários e anexos.\n\nTodas as requisições exigem dois cabeçalhos de autenticação:\n- **Token-1**: Identificador do cliente.\n- **Token-2**: Chave de sessão ou assinatura do cliente.\n\nO sistema automatiza a triagem e resposta de chamados, integrando-se a módulos de IA para priorização e análise semântica.",
    "version": "1.0",
    "contact": {
      "name": "Suporte Helpdesk IA",
      "email": "suporte@helpdeskia.com"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/pathtech-86b/helpDesk-PathTech/1.0"
  },
  "servers": [
    {
      "url": "https://api.helpdeskia.com",
      "description": "API de Produção"
    }
  ],
  "tags": [
    {
      "name": "tickets",
      "description": "Operações relacionadas a tickets do Helpdesk."
    },
    {
      "name": "comments",
      "description": "Envio de comentários e atualizações de tickets."
    },
    {
      "name": "solutions",
      "description": "Consulta de soluções sugeridas pela IA."
    }
  ],
  "paths": {
    "/api/tickets": {
      "post": {
        "tags": [
          "tickets"
        ],
        "summary": "Cria um novo ticket.",
        "description": "Cria um novo ticket no sistema e retorna o objeto completo.",
        "operationId": "createTicket",
        "security": [
          {
            "ApiTokens": []
          }
        ],
        "requestBody": {
          "required": true,
          "description": "Objeto Ticket a ser criado.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Ticket"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ticket criado com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ticket"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos."
          },
          "401": {
            "description": "Falha de autenticação."
          },
          "default": {
            "description": "Erro inesperado."
          }
        }
      },
      "get": {
        "tags": [
          "tickets"
        ],
        "summary": "Lista todos os tickets.",
        "description": "Retorna uma lista paginada de tickets disponíveis.",
        "operationId": "listTickets",
        "security": [
          {
            "ApiTokens": []
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de tickets retornada com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Ticket"
                  }
                }
              }
            }
          },
          "default": {
            "description": "Erro inesperado."
          }
        }
      }
    },
    "/api/tickets/{protocol}": {
      "get": {
        "tags": [
          "tickets"
        ],
        "summary": "Obtém detalhes de um ticket.",
        "description": "Retorna o ticket correspondente ao protocolo informado.",
        "operationId": "getTicketByProtocol",
        "security": [
          {
            "ApiTokens": []
          }
        ],
        "parameters": [
          {
            "name": "protocol",
            "in": "path",
            "required": true,
            "description": "Código de protocolo do ticket.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ticket encontrado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ticket"
                }
              }
            }
          },
          "404": {
            "description": "Ticket não encontrado."
          }
        }
      },
      "patch": {
        "tags": [
          "tickets"
        ],
        "summary": "Atualiza informações de um ticket.",
        "description": "Atualiza parcialmente um ticket existente e retorna o objeto atualizado.",
        "operationId": "updateTicket",
        "security": [
          {
            "ApiTokens": []
          }
        ],
        "parameters": [
          {
            "name": "protocol",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Código de protocolo do ticket."
          }
        ],
        "requestBody": {
          "description": "Campos do ticket a serem atualizados.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Ticket"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ticket atualizado com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ticket"
                }
              }
            }
          },
          "404": {
            "description": "Ticket não encontrado."
          }
        }
      }
    },
    "/api/tickets/check": {
      "post": {
        "tags": [
          "tickets"
        ],
        "summary": "Verifica tickets existentes.",
        "description": "Retorna uma lista de tickets com base nas informações fornecidas (e-mail e/ou protocolo).",
        "operationId": "checkTickets",
        "security": [
          {
            "ApiTokens": []
          }
        ],
        "requestBody": {
          "description": "Objeto de verificação contendo protocolo e/ou e-mail.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Info"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tickets correspondentes encontrados.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Ticket"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Nenhum ticket encontrado."
          }
        }
      }
    },
    "/api/tickets/{protocol}/comments": {
      "post": {
        "tags": [
          "comments"
        ],
        "summary": "Envia um comentário para um ticket.",
        "description": "Adiciona um novo comentário a um ticket e retorna a lista atualizada de tickets relacionados.",
        "operationId": "addComment",
        "security": [
          {
            "ApiTokens": []
          }
        ],
        "parameters": [
          {
            "name": "protocol",
            "in": "path",
            "required": true,
            "description": "Protocolo do ticket a ser comentado.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "description": "Comentário a ser adicionado.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Comment"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Comentário adicionado com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Ticket"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Ticket não encontrado."
          }
        }
      }
    },
    "/api/solutions": {
      "get": {
        "tags": [
          "solutions"
        ],
        "summary": "Lista soluções sugeridas.",
        "description": "Retorna uma lista de soluções sugeridas pela IA com base em tickets e histórico de atendimento.",
        "operationId": "listSolutions",
        "security": [
          {
            "ApiTokens": []
          }
        ],
        "responses": {
          "200": {
            "description": "Soluções retornadas com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Ticket"
                  }
                }
              }
            }
          },
          "default": {
            "description": "Erro inesperado."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiTokens": {
        "type": "apiKey",
        "in": "header",
        "name": "Token-1",
        "description": "Token primário de autenticação."
      },
      "ApiTokens2": {
        "type": "apiKey",
        "in": "header",
        "name": "Token-2",
        "description": "Token secundário de autenticação."
      }
    },
    "schemas": {
      "Attachment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "att-001"
          },
          "filename": {
            "type": "string",
            "example": "erro_log.txt"
          },
          "url": {
            "type": "string",
            "example": "https://cdn.helpdeskia.com/uploads/erro_log.txt"
          },
          "uploadedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2025-10-21T15:32:00Z"
          }
        }
      },
      "Comment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "com-001"
          },
          "text": {
            "type": "string",
            "example": "O sistema apresentou erro de autenticação ao logar."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2025-10-21T13:00:00Z"
          },
          "createdBy": {
            "type": "string",
            "example": "rafael.bahia"
          },
          "attachments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Attachment"
            }
          }
        }
      },
      "Ticket": {
        "type": "object",
        "required": [
          "protocol",
          "name",
          "email",
          "category",
          "description",
          "status",
          "isPublic"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "tic-001"
          },
          "protocol": {
            "type": "string",
            "example": "ABC123456"
          },
          "name": {
            "type": "string",
            "example": "Rafael Bahia"
          },
          "email": {
            "type": "string",
            "example": "rafael@empresa.com"
          },
          "category": {
            "type": "string",
            "example": "Erro de sistema"
          },
          "description": {
            "type": "string",
            "example": "Aplicativo travando ao salvar o ticket."
          },
          "status": {
            "type": "string",
            "example": "open",
            "enum": [
              "open",
              "in_progress",
              "resolved",
              "closed"
            ]
          },
          "attachments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Attachment"
            }
          },
          "comments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Comment"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2025-10-20T10:30:00Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2025-10-21T12:45:00Z"
          },
          "closedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "isPublic": {
            "type": "boolean",
            "example": true
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string",
              "example": "erro,login"
            }
          },
          "assignedTo": {
            "type": "string",
            "example": "user-123"
          }
        }
      },
      "Info": {
        "type": "object",
        "properties": {
          "protocol": {
            "type": "string",
            "example": "ABC123456"
          },
          "email": {
            "type": "string",
            "example": "rafael@empresa.com"
          }
        }
      }
    }
  }
}
