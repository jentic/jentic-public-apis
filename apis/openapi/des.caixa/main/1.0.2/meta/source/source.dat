          "content": {
            "*/*": {
              "schema": {
                "$ref": "#/components/schemas/Manutencao"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Sua transação foi recebida com sucesso para processamento na Caixa Econômica Federal. Verificar status do protocolo para confirmar o resultado da operação.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Protocolo"
                }
              }
            }
          },
          "400": {
            "description": "4.Número de CPF inválido.<br /> 5.Existe uma Operação Fiduciária em andamento. Tente mais tarde.<br /> 10.Operação não permitida antes de <DD-MM-AAAA>.<br /> 13.Operação não permitida por pendência no processo de pagamento de saque-aniversário.<br /> 19.Para Tipo de Operação Amortização um ou mais períodos deverão ser preenchidos.<br /> 20.Para Tipo de Operação Quitação nenhum período deverá ser preenchido.<br /> 22.Operação cancelada.<br /> 23.Garantia transferida para a Instituição Fiduciária <CNPJ_FORMATADO> em <DD/MM/YYYY>.<br /> 24.Manutenção não permitida.<br /> 25.Manutenção não permitida antes de <DD/MM/YYYY>.<br /> 26.Uma ou mais datas de previsão não constam na Operação informada.<br /> 32.Valor da Amortização deve ser maior que zero.<br /> 33.Valor da Amortização superior ao saldo da operação para o exercício.<br /> 38.Identificador da Solicitação inválido.",
            "content": {
              "application/json": {
                "schema": {
