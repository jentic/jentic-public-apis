              }
            }
          },
          "500": {
            "description": "3.Ocorreu um erro inesperado. Tente novamente mais tarde.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                }
              }
            }
          }
        },
        "security": [
          {
            "Intranet": [
              "operacao_fiduciaria"
            ]
          },
          {
            "Internet": [
              "operacao_fiduciaria"
            ],
            "APIKey": []
          }
        ]
      },
      "put": {
        "tags": [
          "Manutenção da Garantia"
        ],
        "summary": "Permite a Instituição Fiduciária realizar, junto ao Agente Operador do FGTS, amortização ou quitação dos valores de saque aniversário do Trabalhador reservados como garantia para uma operação fiduciária.",
        "description": "Atualizar a manutenção da garantia (amortização ou quitação) da reserva de valores do FGTS através do Identificador da Solicitação.",
        "parameters": [
