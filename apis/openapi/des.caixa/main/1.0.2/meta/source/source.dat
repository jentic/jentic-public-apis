    "/v1/trabalhadores/{cpf}/solicitacoes-reserva/{identificadorSolicitacao}/protocolos": {
      "get": {
        "tags": [
          "Consultar Protocolos por Identificador"
        ],
        "summary": "Permite a Instituição Fiduciária consultar, junto ao Agente Operador do FGTS, todos os protocolos de transações de reserva, amortização, quitação e cancelamento relacionados ao identificador de solicitação. O protocolo é um número fornecido pela Caixa Econômica Federal que garante que a transação foi recepcionada e será processada. O resultado do processamento deve ser confirmado pela Instituição Fiduciária no campo statusProtocolo.",
        "description": "Consultar os protocolos através do identificador da solicitação.",
        "parameters": [
          {
            "name": "cpf",
            "in": "path",
            "description": "CPF do Trabalhador (sem formatação).",
            "required": true,
            "schema": {
              "maxLength": 11,
              "minLength": 11,
              "type": "string"
            }
          },
          {
            "name": "identificadorSolicitacao",
            "in": "path",
            "description": "Identificador da Solicitação.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "apikey",
            "in": "header",
            "description": "Secret da aplicação fornecido pela Caixa Econômica Federal para consumo da API.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Consulta realizada com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListaDeProtocolo"
                }
              }
            }
          },
          "400": {
            "description": "4.Número de CPF inválido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                }
              }
            }
          },
          "401": {
            "description": "1.Usuário não autenticado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                }
              }
            }
          },
          "404": {
            "description": "30.Nenhum resultado encontrado para a consulta solicitada.<br /> 38.Identificador da Solicitação inválido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                }
              }
            }
          },
          "500": {
            "description": "3.Ocorreu um erro inesperado. Tente novamente mais tarde.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                }
              }
            }
          }
        },
        "security": [
          {
            "Intranet": [
              "operacao_fiduciaria"
            ]
          },
          {
            "Internet": [
              "operacao_fiduciaria"
            ],
            "APIKey": []
          }
        ]
      }
    },
    "/v1/trabalhadores/{cpf}/simulador-solicitacoes-reserva": {
      "get": {
        "tags": [
          "Simulador de Solicitação da Reserva"
        ],
        "summary": "Permite a Instituição Fiduciária obter, junto ao Agente Operador do FGTS, o valor de FGTS do Trabalhador necessário para garantir o valor da reserva para um exercício.",
        "description": "Consultar o Valor de FGTS do Trabalhador necessário para garantir a reserva de um exercício.",
        "parameters": [
          {
            "name": "cpf",
            "in": "path",
            "description": "CPF do Trabalhador (sem formatação).",
            "required": true,
            "schema": {
              "maxLength": 11,
              "minLength": 11,
              "type": "string"
            }
          },
          {
            "name": "exercicioRepasse",
            "in": "query",
            "description": "Exercício referente ao ano da data prevista de repasse a Instituição Fiduciária. Formato AAAA deve ser maior ou igual ao exercício da data corrente.",
            "required": true,
            "schema": {
              "minimum": 2020,
              "maxLength": 4,
              "minLength": 4,
              "type": "integer"
            }
          },
          {
            "name": "valorReserva",
            "in": "query",
            "description": "Valor da reserva. Deve ser maior que zero. ",
            "required": true,
            "schema": {
              "minimum": 0.01,
              "type": "number",
              "format": "currency"
            }
          },
          {
            "name": "apikey",
            "in": "header",
            "description": "Secret da aplicação fornecido pela Caixa Econômica Federal para consumo da API.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sua transação foi recebida com sucesso para processamento na Caixa Econômica Federal. Verificar status do protocolo para confirmar o resultado da operação.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValoresFGTSGarantia"
                }
              }
            }
          },
          "400": {
            "description": "4.Número de CPF inválido.<br /> 5.Existe uma Operação Fiduciária em andamento. Tente mais tarde.<br /> 9.Trabalhador não possui adesão ao saque aniversário vigente na data corrente.<br /> 10.Operação não permitida antes de <DD-MM-AAAA>.<br /> 11.Não é possível realizar a operação para o CPF informado.<br /> 13.Operação não permitida por pendência no processo de pagamento de saque-aniversário.<br /> 18.Trabalhador com solicitação de retorno para saque rescisão, que deve ser cancelada pelo mesmo para possibilitar a solicitação de garantia.<br /> 34.Valor da reserva deve ser maior que zero.<br /> 39.Exercício do repasse deve ser informado.<br /> 41.Exercício do repasse deve ser maior ou igual ao exercício da data corrente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                }
              }
            }
          },
          "401": {
            "description": "1.Usuário não autenticado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                }
              }
            }
          },
          "403": {
            "description": "6.Instituição Fiduciária sem convênio vigente para a modalidade de Operação Fiduciária.<br /> 7.Instituição Fiduciária não possui autorização para o Trabalhador para Operação Fiduciária.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                }
              }
            }
          },
          "404": {
            "description": "8.Trabalhador informado não possui contas de FGTS.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                }
              }
            }
          },
          "500": {
            "description": "3.Ocorreu um erro inesperado. Tente novamente mais tarde.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                }
              }
            }
          }
        },
        "security": [
          {
            "Intranet": [
              "operacao_fiduciaria"
            ]
          },
          {
            "Internet": [
              "operacao_fiduciaria"
            ],
            "APIKey": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Saldo": {
        "required": [
          "cpfTrabalhador",
          "dataSaldo",
          "qtdPedidos"
        ],
        "type": "object",
        "properties": {
          "cpfTrabalhador": {
            "maxLength": 11,
            "minLength": 11,
            "type": "string",
            "description": "CPF do Trabalhador (sem formatação)."
          },
          "dataSaldo": {
            "pattern": "dd/MM/yyyy",
            "type": "string",
            "description": "Data de apuração do saldo"
          },
          "existeSaldoDesconsiderado": {
            "type": "boolean",
            "description": "Identifica se o trabalhador possui valores de FGTS que não foram considerados no cálculo do saldo total, pois não estão disponíveis para uso."
          },
          "qtdPedidos": {
            "type": "integer",
            "description": "Quantidade de pedidos de garantia ativos para o trabalhador."
          },
          "periodos": {
            "type": "array",
            "description": "Lista dos Períodos com seus respectivos valores disponíveis para reserva.",
            "items": {
              "$ref": "#/components/schemas/Periodo"
            }
          }
        },
        "description": "Valores de FGTS disponíveis para uso como garantia em operações fiduciárias."
      },
      "Periodo": {
        "required": [
          "dataRepasse",
          "valor"
        ],
        "type": "object",
        "properties": {
          "dataRepasse": {
            "pattern": "dd/MM/yyyy",
            "type": "string",
            "description": "Data Prevista de Repasse a Instituição Fiduciária."
          },
          "valor": {
            "type": "number",
            "description": "Valor da Reserva ou da Amortização.",
            "format": "currency"
          }
        },
        "description": "Valores da Reserva ou da Amortização por Período."
      },
      "PeriodoAtualizado": {
        "required": [
          "dataRepasse",
          "valorAtualizado",
          "valorOriginal"
        ],
        "type": "object",
        "properties": {
          "dataRepasse": {
            "pattern": "dd/MM/yyyy",
            "type": "string",
            "description": "Data Prevista de Repasse a Instituição Fiduciária."
          },
          "statusPeriodo": {
            "type": "integer",
            "description": "Identifica a situação atual do valor reservado como garantia junto ao Agente Operador<br /> 1. Garantida: A reserva dos valores para aquele período está garantida e o repasse será efetuado na data prevista.<br /> 2. Quitada: Os valores de reserva previstos na operação foram devolvidos para a conta do trabalhador, pois o Agente Financeiro informou que a operação foi Quitada.<br /> 3. Cancelada: Os valores de reserva previstos na operação foram devolvidos para a conta do trabalhador, pois o Agente Financeiro informou que a operação foi Cancelada. O registro dessa informação foi concluído com sucesso.<br /> 4. Pago: Os valores de reserva previstos na operação foram retirados da conta do trabalhador e repassados ao Agente Financeiro na data prevista de repasse.<br /> 5. Em processo de pagamento: s valores de reserva previstos na operação estão sendo retirados da conta do trabalhador para serem repassados ao Agente Financeiro.<br /> 6. Em processamento: A reserva dos valores para aquele período está em processamento.<br /> 7. Não acatado: A reserva dos valores para aquele período não foi acatada.<br /> 8. Em processo de cancelamento: Os valores de reserva previstos na operação estão sendo devolvidos para a conta do trabalhador, pois o Agente Financeiro informou que a operação foi Cancelada. O registro desta informação ainda está sendo processado.<br /> 9. Pagamento cancelado - não realizado por indício de fraude: Os valores de reserva previstos na operação foram interceptados da conta do trabalhador para evitar um repasse indevido ao Agente Financeiro. O repasse não foi realizado por indício de fraude."
          },
          "valorOriginal": {
            "type": "number",
            "description": "Valor da Reserva Original.",
            "format": "currency"
          },
          "valorAtualizado": {
            "type": "number",
            "description": "Valor da Reserva Atualizado.",
            "format": "currency"
          }
        },
        "description": "Valores da Reserva por Período atualizados."
      },
      "Reserva": {
        "required": [
          "periodos",
          "tipoOperacao"
        ],
        "type": "object",
        "properties": {
          "identificadorSolicitacao": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string",
            "description": "Identificador da Solicitação da Reserva. Identificação que será utilizada pelo ente externo para realizar a reserva de valores do saldo do trabalhador."
          },
          "tipoOperacao": {
            "type": "number",
            "description": "Tipo de Operação fiduciária referente a solicitação de reserva que deve ser:<br /> 1 - Cessão Fiduciária <br /> 2 - Alienação Fiduciária."
          },
          "periodos": {
            "type": "array",
            "description": "Lista dos Períodos com seus respectivos valores para reserva.",
            "items": {
              "$ref": "#/components/schemas/Periodo"
            }
          }
        },
        "description": "Informações da Solicitação de Reserva."
      },
      "ReservaAtualizada": {
        "required": [
          "cpfTrabalhador",
          "dataHoraPedido",
          "identificadorSolicitacao",
          "periodos",
          "tipoOperacao"
        ],
        "type": "object",
        "properties": {
          "identificadorSolicitacao": {
            "type": "string",
            "description": "Identificador da Solicitação do Pedido."
          },
          "cpfTrabalhador": {
            "maxLength": 11,
            "minLength": 11,
            "type": "string",
            "description": "CPF do Trabalhador (sem formatação)."
          },
          "dataHoraPedido": {
            "type": "string",
            "description": "Data Hora do Pedido no formato <dd/mm/AAAA HH:MM:SS>."
          },
          "tipoOperacao": {
            "type": "number",
            "description": "Tipo de Operação fiduciária referente a solicitação de reserva que deve ser: <br /> 1 - Cessão Fiduciária <br /> 2 - Alienação Fiduciária."
          },
          "periodos": {
            "type": "array",
            "description": "Lista dos Períodos com seus respectivos valores da reserva original e atualizado.",
            "items": {
              "$ref": "#/components/schemas/PeriodoAtualizado"
            }
          }
        }
      },
      "Manutencao": {
        "required": [
          "tipoOperacao"
        ],
        "type": "object",
        "properties": {
          "tipoOperacao": {
            "type": "number",
            "description": "Tipo de Operação fiduciária referente a solicitação de reserva que deve ser: <br /> 1 - Amortização <br /> 2 - Quitação."
          },
          "periodos": {
            "type": "array",
            "description": "Lista dos Períodos com seus respectivos valores da Amortização.",
            "items": {
              "$ref": "#/components/schemas/Periodo"
            }
          }
        },
        "description": "Informações sobre a Manutenção da Garantia."
      },
      "ListaDeProtocolo": {
        "type": "object",
        "properties": {
          "protocolos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Protocolo"
            }
          }
        },
        "description": "Relação de protocolos emitidos pela Caixa Econômica Federal associada ao identificador da solicitação."
      },
      "Protocolo": {
        "required": [
          "detalheProtocolo",
          "numeroProtocolo",
          "statusProtocolo"
        ],
        "type": "object",
        "properties": {
          "numeroProtocolo": {
            "type": "integer",
            "description": "Protocolo da transação fornecido pela Caixa Econômica Federal."
          },
          "statusProtocolo": {
            "type": "integer",
            "description": "Status do processamento da transação:<br /> 1 - Acatado. Sua transação foi processada com sucesso.<br /> 2 - Em Processamento.<br /> 3 - Não Acatado. Sua transação foi processada com erro. Tente novamente."
          },
          "detalheProtocolo": {
            "$ref": "#/components/schemas/Referencia"
          }
        },
        "description": "O protocolo é um número fornecido pela Caixa Econômica Federal que garante que a transação foi recepcionada e será processada. O resultado do processamento deve ser confirmado pela Instituição Fiduciária no campo         statusProtocolo."
      },
      "DetalheProtocolo": {
        "required": [
          "cpfTrabalhador",
          "dataHoraPedido",
          "identificadorSolicitacao",
          "numeroProtocolo",
          "statusProtocolo",
          "tipoPedido"
        ],
        "type": "object",
        "properties": {
          "numeroProtocolo": {
            "type": "integer",
            "description": "Protocolo da transação/pedido fornecido pela Caixa Econômica Federal."
          },
          "statusProtocolo": {
            "type": "number",
            "description": "Status do processamento da transação:<br /> 1 - Acatado. Sua  transação foi processada com sucesso.<br /> 2 - Em Processamento.<br /> 3 - Não Acatado. Sua transação foi processada com erro. Tente novamente."
          },
          "tipoPedido": {
            "type": "number",
            "description": "Tipo do Pedido solicitado, pode ser:<br /> 1 - Solicitação de Reserva <br /> 2 - Cancelamento da Solicitação de Reserva <br /> 3 - Manutenção da Garantia da Reserva."
          },
          "dataHoraPedido": {
            "type": "string",
            "description": "Data Hora do Pedido no formato <dd/mm/AAAA HH:MM:SS>."
          },
          "identificadorSolicitacao": {
            "type": "string",
            "description": "Identificador da Solicitação do Pedido."
          },
          "cpfTrabalhador": {
            "maxLength": 11,
            "minLength": 11,
            "type": "string",
            "description": "CPF do Trabalhador (sem formatação)."
          },
          "tipoOperacao": {
            "type": "number",
            "description": "Para Solicitação de Reserva o Tipo de Operação pode ser:<br /> 1 - Cessão Fiduciária <br /> 2 - Alienação Fiduciária.<br /> Para Manutenção da Garantia de Reserva pode ser:<br /> 1 - Amortização <br /> 2 - Quitação."
          },
          "periodos": {
            "type": "array",
            "description": "Lista dos Períodos com seus respectivos valores para reserva.",
            "items": {
              "$ref": "#/components/schemas/Periodo"
            }
          }
        },
        "description": "O protocolo é um número fornecido pela Caixa Econômica Federal que garante que a transação foi recepcionada e será processada. O resultado do processamento deve ser confirmado pela Instituição Fiduciária no campo statusProtocolo."
      },
      "Mensagem": {
        "required": [
          "codigo",
          "descricao"
        ],
        "type": "object",
        "properties": {
          "codigo": {
            "type": "integer",
            "description": "Código do erro."
          },
          "descricao": {
            "type": "string",
            "description": "Descrição do erro."
          }
        }
      },
      "Referencia": {
        "required": [
          "href",
          "rel"
        ],
        "type": "object",
        "properties": {
          "href": {
            "type": "string",
            "description": "caminho a ser utilizado para o detalhamento."
          },
          "rel": {
            "type": "string",
            "description": "Descritivo do Detalhamento."
          }
        }
      },
      "ValoresFGTSGarantia": {
        "required": [
          "cpfTrabalhador"
        ],
        "type": "object",
        "properties": {
          "cpfTrabalhador": {
            "maxLength": 11,
            "minLength": 11,
            "type": "string",
            "description": "CPF do Trabalhador (sem formatação)."
          },
          "valorAtualGarantiaRetido": {
            "type": "number",
            "description": "Valor atual de FGTS do trabalhador que se encontra retido para garantir as operações fiduciárias realizadas para o trabalhador.",
            "format": "currency"
          },
          "valorGarantiaComplementar": {
            "type": "number",
            "description": "Valor de FGTS que será retido caso a operação fiduciária  informada seja realizada, para complementar a garantia atual.",
            "format": "currency"
          },
          "valorGarantiaReserva": {
            "type": "number",
            "description": "Valor de FGTS do trabalhador necessário para garantir a operação de reserva informada.",
            "format": "currency"
          }
        },
        "description": "Valores de FGTS para Garantia."
      }
    },
    "securitySchemes": {
      "APIKey": {
        "description": "API Key do sistema que está chamando esta API.",
        "in": "header",
        "name": "APIKey",
        "type": "apiKey"
      },
      "Intranet": {
        "description": "Tokens emitidos pelo realm INTRANET",
        "flows": {
          "clientCredentials": {
            "refreshUrl": "https://login.des.caixa/auth/realms/intranet/protocol/openid-connect/token",
            "scopes": {
              "operacao_fiduciaria": "Permite reservar os valores de saque aniversário disponíveis para um determinado trabalhador."
            },
            "tokenUrl": "https://login.des.caixa/auth/realms/intranet/protocol/openid-connect/token"
          }
        },
        "type": "oauth2"
      },
      "Internet": {
        "description": "Tokens emitidos pelo realm INTERNET",
        "flows": {
          "clientCredentials": {
            "refreshUrl": "https://logindes.caixa.gov.br/auth/realms/internet/protocol/openid-connect/token",
            "scopes": {
              "operacao_fiduciaria": "Permite reservar os valores de saque aniversário disponíveis para um determinado trabalhador."
            },
            "tokenUrl": "https://logindes.caixa.gov.br/auth/realms/internet/protocol/openid-connect/token"
          }
        },
        "type": "oauth2"
      }
    }
  }
}
