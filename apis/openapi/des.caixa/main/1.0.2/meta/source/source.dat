    "/v1/protocolos/{numeroProtocolo}": {
      "get": {
        "tags": [
          "Consultar Protocolo"
        ],
        "summary": "Permite a Instituição Fiduciária consultar, junto ao Agente Operador do FGTS, as informações da transação referente ao protocolo informado. O protocolo é um número fornecido pela Caixa Econômica Federal que garante que a transação foi recepcionada e será processada. O resultado do processamento deve ser confirmado pela Instituição Fiduciária no campo statusProtocolo.",
        "description": "Consultar as informações da transação através do número do protocolo.",
        "parameters": [
          {
            "name": "numeroProtocolo",
