{
  "openapi": "3.0.1",
  "info": {
    "title": "API FGTS - Operação Fiduciária",
    "description": "Esta API permite as Instituições Fiduciárias reservarem, junto ao Agente Operador do FGTS, os valores de saque aniversário disponíveis para um determinado trabalhador, como garantia para realizarem operações fiduciárias. \n\n As informações trafegadas pela API são de nível II, confidenciais/restritas. \n\n Timeout no API Manager: 2000 milissegundos. \n\n Rate Limit: 5 chamadas/seg.  \n\n Equipe de desenvolvimento responsável: CESOA230 - FG013 - Comunidade Fundos de Governo - SIDFG \n\n Equipe Gestora Negocial (Dono do Produto): GETRA06 \n\n Nº do RTC de Validação do swagger: 21263833 \n\n Documentação auxiliar da API: disponível no RDNG no painel do Projeto SIDFG, caminho SIDFG > Visão de Sistema > Detalhamento Funcional de História de Usuário\n\n# Authentication\n\n<!-- ReDoc-Inject: <security-definitions> -->",
    "termsOfService": "https://api.caixa/terms",
    "contact": {
      "email": "cesoa230@caixa.gov.br"
    },
    "version": "1.0.2",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/MIGUELMANRUBIA/api-fgts-operacao-fiduciaria/1.0.2"
  },
  "servers": [
    {
      "url": "https://api.des.caixa:8443/fgts/operacao-fiduciaria"
    }
  ],
  "paths": {
    "/v1/trabalhadores/{cpf}/saldos-disponiveis": {
      "get": {
        "tags": [
          "Consultar Saldo Disponível"
        ],
        "summary": "Permite a Instituição Fiduciária consultar, junto ao Agente Operador do FGTS, o valor disponível de saque aniversário previsto para o Trabalhador, por período.",
        "description": "Consultar o Saldo disponível por período.",
        "parameters": [
          {
            "name": "cpf",
            "in": "path",
            "description": "CPF do Trabalhador (sem formatação).",
            "required": true,
            "schema": {
              "maxLength": 11,
              "minLength": 11,
              "type": "string"
            }
          },
          {
            "name": "quantidade_periodos",
            "in": "query",
            "description": "Número referente a quantidade máxima de períodos/exercícios de saque aniversário do FGTS a serem retornados da consulta. Caso preenchido, deverá ser maior que zero.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "apikey",
            "in": "header",
            "description": "Secret da aplicação fornecido pela Caixa Econômica Federal para consumo da API.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Consulta realizada com sucesso. Trabalhador possui saldo disponível que permite realizar Operações Fiduciárias.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Saldo"
                }
              }
            }
          },
          "204": {
            "description": "Consulta realizada com sucesso. Trabalhador NÃO possui saldo disponível que permita realizar Operações Fiduciárias.",
            "content": {}
          },
          "400": {
            "description": "2.Quantidade de Períodos deve ser maior que zero.<br /> 4.Número de CPF inválido.<br /> 5.Existe uma Operação Fiduciária em andamento. Tente mais tarde.<br /> 9.Trabalhador não possui adesão ao saque aniversário vigente na data corrente.<br /> 10.Operação não permitida antes de <DD-MM-AAAA>.<br /> 11.Não é possível realizar a operação para o CPF informado.<br /> 13.Operação não permitida por pendência no processo de pagamento de saque-aniversário.<br /> 18.Trabalhador com solicitação de retorno para saque rescisão, que deve ser cancelada pelo mesmo para possibilitar a solicitação de garantia.<br /> 35.Mudanças cadastrais na conta do FGTS foram realizadas, que impedem a contratação. Entre em contato com o setor de FGTS da CAIXA.<br /> 40.Foi identificado falta de dados cadastrais na conta do FGTS que impedem a contratação. Entre em contato com o setor de FGTS da Caixa.<br /> 47.Quantidade de exercícios superior a quantidade máxima permitida para a operação.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                }
              }
            }
          },
          "401": {
            "description": "1.Usuário não autenticado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                }
              }
            }
          },
          "403": {
            "description": "6.Instituição Fiduciária sem convênio vigente para a modalidade de Operação Fiduciária.<br /> 7.Instituição Fiduciária não possui autorização do Trabalhador para Operação Fiduciária.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                }
              }
            }
          },
          "404": {
            "description": "8.Trabalhador informado não possui contas de FGTS.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                }
              }
            }
          },
          "500": {
            "description": "3.Ocorreu um erro inesperado. Tente novamente mais tarde.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                }
              }
            }
          }
        },
        "security": [
          {
            "Intranet": [
              "operacao_fiduciaria"
            ]
          },
          {
            "Internet": [
              "operacao_fiduciaria"
            ],
            "APIKey": []
          }
        ]
      }
    },
    "/v1/trabalhadores/{cpf}/solicitacoes-reserva": {
      "post": {
        "tags": [
          "Solicitação da Reserva"
        ],
        "summary": "Permite a Instituição Fiduciária efetivar, junto ao Agente Operador do FGTS, uma reserva de valores do saque aniversário do Trabalhador como garantia para realização de uma operação fiduciária.",
        "description": "Incluir uma solicitação de reserva de valores do saque aniversário do FGTS.",
        "parameters": [
          {
            "name": "cpf",
            "in": "path",
            "description": "CPF do Trabalhador (sem formatação).",
            "required": true,
            "schema": {
              "maxLength": 11,
              "minLength": 11,
              "type": "string"
            }
          },
          {
            "name": "apikey",
            "in": "header",
            "description": "Secret da aplicação fornecido pela Caixa Econômica Federal para consumo da API.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Body para solicitar reserva dos valores FGTS.",
          "content": {
            "*/*": {
              "schema": {
                "$ref": "#/components/schemas/Reserva"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Sua transação foi recebida com sucesso para processamento na Caixa Econômica Federal. Verificar status do protocolo para confirmar o resultado da operação.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Protocolo"
                }
              }
            }
          },
          "400": {
            "description": "4.Número de CPF inválido.<br /> 5.Existe uma Operação Fiduciária em andamento. Tente mais tarde.<br /> 9.Trabalhador não possui adesão ao saque aniversário vigente na data corrente.<br /> 10.Operação não permitida antes de <DD-MM-AAAA>.<br /> 11.Não é possível realizar a operação para o CPF informado.<br /> 12.Trabalhador não possui saldo disponível para Operação Fiduciária.<br /> 13.Operação não permitida por pendência no processo de pagamento de saque-aniversário.<br /> 14.Existe uma solicitação de garantia com o mesmo número identificador.<br /> 15.Trabalhador não possui adesão ao saque aniversário para o período informado.<br /> 16.Uma ou mais datas de previsão do saque informadas não conferem com as previstas no sistema.<br /> 17.Valor da alienação/cessão superior ao valor disponível para o trabalhador.<br /> 18.Trabalhador com solicitação de retorno para saque rescisão, que deve ser cancelada pelo mesmo para possibilitar a solicitação de garantia.<br /> 34.Valor da reserva deve ser maior que zero.<br /> 35.Mudanças cadastrais na conta do FGTS foram realizadas, que impedem a contratação. Entre em contato com o setor de FGTS da CAIXA.<br /> 37.Trabalhador não possui saldo suficiente para a garantia necessária.<br /> 38.Identificador da Solicitação inválido.<br /> 40.Foi identificado falta de dados cadastrais na conta do FGTS que impedem a contratação. Entre em contato com o setor de FGTS da Caixa.<br /> 47.Quantidade de exercícios superior a quantidade máxima permitida para a operação.<br /> 48.Valor da reserva menor que o valor mínimo permitido por operação.<br /> 51.Valor da reserva maior que valor máximo permitido para a operação.<br /> 52.Trabalhador já possui quantidade máxima permitida de operação de reserva em um ou mais exercícios informados.<br /> 53.Trabalhador já possui o valor máximo permitido para reserva em um ou mais exercícios informados.<br /> 54.Considerando o pedido de reserva solicitado, o valor total de reserva de um ou mais exercícios informados ficará superior ao valor máximo permitido por exercício.<br /> 55.Um ou mais exercícios informados estão fora do limite permitido para a operação.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                }
              }
            }
          },
          "401": {
            "description": "1.Usuário não autenticado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                }
              }
            }
          },
          "403": {
            "description": "6.Instituição Fiduciária sem convênio vigente para a modalidade de Operação Fiduciária.<br /> 7.Instituição Fiduciária não possui autorização para o Trabalhador para Operação Fiduciária.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                }
              }
            }
          },
          "404": {
            "description": "8.Trabalhador informado não possui contas de FGTS.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                }
              }
            }
          },
          "500": {
            "description": "3.Ocorreu um erro inesperado. Tente novamente mais tarde.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                }
              }
            }
          }
        },
        "x-codegen-request-body-name": "Reserva",
        "security": [
          {
            "Intranet": [
              "operacao_fiduciaria"
            ]
          },
          {
            "Internet": [
              "operacao_fiduciaria"
            ],
            "APIKey": []
          }
        ]
      }
    },
    "/v1/trabalhadores/{cpf}/solicitacoes-reserva/{identificadorSolicitacao}": {
      "get": {
        "tags": [
          "Consultar Valor Reservado"
        ],
        "summary": "Permite a Instituição Fiduciária consultar, junto ao Agente Operador do FGTS, os valores reservados em seu nome nas contas do FGTS do Trabalhador, como garantia de operações fiduciárias. Os valores estarão atualizados, de acordo com amortizações e quitações ocorridas ao longo da operação.",
        "description": "Consultar as informações de reserva através do identificador da solicitação.",
        "parameters": [
          {
            "name": "cpf",
            "in": "path",
            "description": "CPF do Trabalhador (sem formatação).",
            "required": true,
            "schema": {
              "maxLength": 11,
              "minLength": 11,
              "type": "string"
            }
          },
          {
            "name": "identificadorSolicitacao",
            "in": "path",
            "description": "Identificador da Solicitação.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "apikey",
            "in": "header",
            "description": "Secret da aplicação fornecido pela Caixa Econômica Federal para consumo da API.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Consulta realizada com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReservaAtualizada"
                }
              }
            }
          },
          "400": {
