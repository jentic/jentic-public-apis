{
  "openapi": "3.0.3",
  "info": {
    "title": "Sanity Activity Log API",
    "version": "v2021-02-01",
    "license": {
      "name": "Sanity Terms of Service",
      "url": "https://www.sanity.io/legal/tos"
    },
    "description": "Use the Activity Log API to retrieve activity events for Sanity\norganizations, projects, users, and related resources.\n\nRequests use a version path: `/v2021-02-01`, any later date in the\nform `/vYYYY-MM-DD`, or `/vX`, which all behave the same. Results are returned\nin reverse chronological order by `timestamp`.\n",
    "x-jentic-source-url": "https://www.sanity.io/docs/api/openapi/activity-log?format=json"
  },
  "servers": [
    {
      "url": "https://api.sanity.io"
    }
  ],
  "paths": {
    "/v2021-02-01/activity": {
      "get": {
        "tags": [
          "Activity"
        ],
        "operationId": "getActivityLogEvents",
        "summary": "Get activity log events",
        "description": "Returns activity log events matching the supplied filters.\n\nRequests only return events for organizations and projects that the\nauthenticated user can access.\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/actorId"
          },
          {
            "$ref": "#/components/parameters/userId"
          },
          {
            "$ref": "#/components/parameters/projectId"
          },
          {
            "$ref": "#/components/parameters/organizationId"
          },
          {
            "$ref": "#/components/parameters/action"
          },
          {
            "$ref": "#/components/parameters/jsonLimit"
          },
          {
            "$ref": "#/components/parameters/offset"
          },
          {
            "$ref": "#/components/parameters/startTime"
          },
          {
            "$ref": "#/components/parameters/endTime"
          }
        ],
        "responses": {
          "200": {
            "description": "Activity log events.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ActivityEvent"
                  }
                },
                "examples": {
                  "singleEvent": {
                    "summary": "Single activity event",
                    "value": [
                      {
                        "id": "ale-mock-id",
                        "version": "mock-version",
                        "actorId": "mock-actor-id",
                        "actorName": "mock-actor-name",
                        "actorEmail": "actor@example.com",
                        "action": "mock-action",
                        "timestamp": "1977-05-25T00:00:00Z",
                        "description": "mock-description",
                        "correlationId": "mock-correlation-id",
                        "metadata": {
                          "key": "key-value",
                          "mock-key": "mock-key-value"
                        },
                        "userId": "mock-user-id",
                        "userName": "mock-user-name",
                        "userEmail": "user@example.com",
                        "projectId": "mock-project-id",
                        "projectDisplayName": "mock-display-name",
                        "organizationId": "mock-organization-id",
                        "organizationDisplayName": "mock-organization-display-name",
                        "transactionId": "mock-transaction-id",
                        "documentId": "mock-document-id",
                        "datasetName": "mock-dataset-name"
                      }
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    },
    "/v2021-02-01/activity/export/csv": {
      "get": {
        "tags": [
          "Activity"
        ],
        "operationId": "exportActivityLogEventsCsv",
        "summary": "Export activity log events as CSV",
        "description": "Returns a CSV export of activity log events matching the supplied\nfilters.\n\nCSV headers are sorted alphabetically. Metadata keys appear as dynamic\n`metadata.<key>` columns when present in the returned events.\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/actorId"
          },
          {
            "$ref": "#/components/parameters/userId"
          },
          {
            "$ref": "#/components/parameters/projectId"
          },
          {
            "$ref": "#/components/parameters/organizationId"
          },
          {
            "$ref": "#/components/parameters/action"
          },
          {
            "$ref": "#/components/parameters/csvLimit"
          },
          {
            "$ref": "#/components/parameters/offset"
          },
          {
            "$ref": "#/components/parameters/startTime"
          },
          {
            "$ref": "#/components/parameters/endTime"
          }
        ],
        "responses": {
          "200": {
            "description": "CSV activity log export.",
            "headers": {
              "Content-Disposition": {
                "description": "Attachment filename for the generated CSV export.",
                "schema": {
                  "type": "string",
                  "example": "attachment;filename=activity_feed_events_2026-06-09.csv"
                }
              }
            },
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                },
                "examples": {
                  "eventsCsv": {
                    "summary": "CSV activity event export",
                    "value": "action,actorEmail,actorId,actorName,correlationId,datasetName,description,documentId,id,metadata.key,metadata.mock-key,organizationDisplayName,organizationId,projectDisplayName,projectId,timestamp,transactionId,userEmail,userId,userName,version\nmock-action,mock-actor-email,mock-actor-id,mock-actor-name,mock-correlation-id,mock-dataset-name,mock-description,mock-document-id,ale-mock-id,key-value,mock-key-value,mock-organization-display-name,mock-organization-id,mock-display-name,mock-project-id,1977-05-25T00:00:00Z,mock-transaction-id,mock-user-email,mock-user-id,mock-user-name,mock-version\n"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Sanity API token, sent as `Authorization: Bearer <token>`. Results only include activity the token's user can access."
      }
    },
    "responses": {
      "BadRequest": {
        "description": "The request includes an unrecognized filter, a duplicate single-value\nfilter, or an unparsable filter value, or the `Authorization` header\nis malformed. The API gateway rejects malformed `Authorization`\nheaders before they reach the Activity Log API, so those errors use\nthe gateway error format.\n",
        "content": {
          "application/json": {
            "schema": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                {
                  "$ref": "#/components/schemas/GatewayErrorResponse"
                }
              ]
            },
            "examples": {
              "duplicateLimit": {
                "summary": "Duplicate filter",
                "value": {
                  "code": 400,
                  "status": "Bad Request",
                  "message": "duplicate parameter: limit"
                }
              },
              "malformedAuthorizationHeader": {
                "summary": "Malformed Authorization header (gateway)",
                "value": {
                  "error": "Bad Request",
                  "statusCode": 400,
                  "message": "Invalid authorization header - please double-check token"
                }
              }
            }
          }
        }
      },
      "Unauthorized": {
        "description": "The token is missing or invalid, or the request filters by a\n`projectId` or `organizationId` the token can't access. The API\ngateway rejects invalid tokens before they reach the Activity Log API,\nso those errors use the gateway error format.\n",
        "content": {
          "application/json": {
            "schema": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                {
                  "$ref": "#/components/schemas/GatewayErrorResponse"
                }
              ]
            },
            "examples": {
              "unauthorized": {
                "summary": "Missing token or inaccessible filter",
                "value": {
                  "code": 401,
                  "status": "Unauthorized",
                  "message": "Unauthorized"
                }
              },
              "invalidToken": {
                "summary": "Invalid token (gateway)",
                "value": {
                  "message": "Session not found",
                  "statusCode": 401,
                  "error": "Unauthorized",
                  "errorCode": "SIO-401-ANF"
                }
              }
            }
          }
        }
      },
      "InternalServerError": {
        "description": "Activity Log could not complete the request.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "examples": {
              "internalServerError": {
                "value": {
                  "code": 500,
                  "status": "Internal Server Error",
                  "message": "Internal Server Error"
                }
              }
            }
          }
        }
      },
      "ServiceUnavailable": {
        "description": "Request timed out or was canceled.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "examples": {
              "serviceUnavailable": {
                "value": {
                  "code": 503,
                  "status": "Service Unavailable",
                  "message": "Service Unavailable"
                }
              }
            }
          }
        }
      }
    },
    "parameters": {
      "actorId": {
        "name": "actorId",
        "in": "query",
        "description": "Actor user ID. Use the literal value `null` to match events whose actor ID is null.",
        "schema": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "style": "form",
        "explode": true
      },
      "action": {
        "name": "action",
        "in": "query",
        "description": "Activity action. Repeat the query parameter to match any of several actions.",
        "schema": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "style": "form",
        "explode": true,
        "example": [
          "organization.name.edit"
        ]
      },
      "userId": {
        "name": "userId",
        "in": "query",
        "description": "Target user ID. Repeat the query parameter to match any of several users.",
        "schema": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "style": "form",
        "explode": true
      },
      "projectId": {
        "name": "projectId",
        "in": "query",
        "description": "Target project ID. Repeat the query parameter to match any of several projects. Filtering by a project the token can't access returns `401`.",
        "schema": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "style": "form",
        "explode": true
      },
      "organizationId": {
        "name": "organizationId",
        "in": "query",
        "description": "Target organization ID. Repeat the query parameter to match any of\nseveral organizations. On its own, `organizationId` matches only\norganization-level events, not activity in the organization's projects.\nTo get project activity, filter by `projectId`, or omit both\n`organizationId` and `projectId` to get all activity the token can\naccess. Combined with `projectId`, events must match both filters.\nFiltering by an organization the token can't access returns `401`.\n",
        "schema": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "style": "form",
        "explode": true
      },
      "jsonLimit": {
        "name": "limit",
        "in": "query",
        "description": "Maximum number of JSON events to return. Values above `100` are capped to `100`.",
        "schema": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 10
        },
        "example": 50
      },
      "csvLimit": {
        "name": "limit",
        "in": "query",
        "description": "Maximum number of CSV events to export. If omitted, defaults to\n`10000`. Values above `50000` are capped to `50000`. Explicit values\nless than or equal to `10` use the CSV default of `10000`.\n",
        "schema": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 10000
        },
        "example": 5000
      },
      "offset": {
        "name": "offset",
        "in": "query",
        "description": "Number of matching events to skip.",
        "schema": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "startTime": {
        "name": "startTime",
        "in": "query",
        "description": "Include events with `timestamp` greater than or equal to this RFC3339 timestamp.",
        "schema": {
          "type": "string",
          "format": "date-time"
        },
        "example": "2025-05-01T00:00:00Z"
      },
      "endTime": {
        "name": "endTime",
        "in": "query",
        "description": "Include events with `timestamp` less than or equal to this RFC3339 timestamp.",
        "schema": {
          "type": "string",
          "format": "date-time"
        },
        "example": "2025-11-25T23:59:59Z"
      }
    },
    "schemas": {
      "ActivityEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "actorId",
          "actorName",
          "actorEmail",
          "action",
          "timestamp",
          "description",
          "correlationId",
          "metadata",
          "userId",
          "userName",
          "userEmail",
          "projectId",
          "projectDisplayName",
          "organizationId",
          "organizationDisplayName",
          "transactionId",
          "documentId",
          "datasetName"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Activity event ID.",
            "example": "ale-mock-id"
          },
          "version": {
            "type": "string",
            "description": "Event schema/API version.",
            "example": "mock-version"
          },
          "actorId": {
            "type": "string",
            "nullable": true,
            "description": "Actor user ID, `sanity-system`, or null for anonymous actors.",
            "example": "mock-actor-id"
          },
          "actorName": {
            "type": "string",
            "nullable": true,
            "description": "Actor display name when known.",
            "example": "mock-actor-name"
          },
          "actorEmail": {
            "type": "string",
            "nullable": true,
            "format": "email",
            "description": "Actor email address when known.",
            "example": "mock-actor-email@example.com"
          },
          "action": {
            "type": "string",
            "description": "Activity action.",
            "example": "mock-action"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Time at which the activity occurred.",
            "example": "1977-05-25T00:00:00Z"
          },
          "description": {
            "type": "string",
            "description": "Human-readable activity description.",
            "example": "mock-description"
          },
          "correlationId": {
            "type": "string",
            "nullable": true,
            "description": "Correlation ID for related events.",
            "example": "mock-correlation-id"
          },
          "metadata": {
            "type": "object",
            "description": "Activity metadata key-value pairs. An empty object when the event has no metadata.",
            "additionalProperties": {
              "type": "string"
            },
            "example": {
              "key": "key-value",
              "mock-key": "mock-key-value"
            }
          },
          "userId": {
            "type": "string",
            "nullable": true,
            "description": "Target user ID.",
            "example": "mock-user-id"
          },
          "userName": {
            "type": "string",
            "nullable": true,
            "description": "Target user display name.",
            "example": "mock-user-name"
          },
          "userEmail": {
            "type": "string",
            "nullable": true,
            "format": "email",
            "description": "Target user email address.",
            "example": "mock-user-email@example.com"
          },
          "projectId": {
            "type": "string",
            "nullable": true,
            "description": "Target project ID.",
            "example": "mock-project-id"
          },
          "projectDisplayName": {
            "type": "string",
            "nullable": true,
            "description": "Target project display name.",
            "example": "mock-display-name"
          },
          "organizationId": {
            "type": "string",
            "nullable": true,
            "description": "Target organization ID.",
            "example": "mock-organization-id"
          },
          "organizationDisplayName": {
            "type": "string",
            "nullable": true,
            "description": "Target organization display name.",
            "example": "mock-organization-display-name"
          },
          "transactionId": {
            "type": "string",
            "nullable": true,
            "description": "Transaction ID for document-related events.",
            "example": "mock-transaction-id"
          },
          "documentId": {
            "type": "string",
            "nullable": true,
            "description": "Target document ID.",
            "example": "mock-document-id"
          },
          "datasetName": {
            "type": "string",
            "nullable": true,
            "description": "Target dataset name.",
            "example": "mock-dataset-name"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "status",
          "message"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32",
            "example": 400
          },
          "status": {
            "type": "string",
            "example": "Bad Request"
          },
          "message": {
            "type": "string",
            "example": "duplicate parameter: limit"
          }
        }
      },
      "GatewayErrorResponse": {
        "type": "object",
        "description": "Error returned by the API gateway for malformed or invalid tokens.",
        "additionalProperties": false,
        "required": [
          "statusCode",
          "error",
          "message"
        ],
        "properties": {
          "statusCode": {
            "type": "integer",
            "format": "int32",
            "example": 401
          },
          "error": {
            "type": "string",
            "example": "Unauthorized"
          },
          "message": {
            "type": "string",
            "example": "Session not found"
          },
          "errorCode": {
            "type": "string",
            "example": "SIO-401-ANF"
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Activity",
      "description": "Retrieve activity log events."
    }
  ]
}