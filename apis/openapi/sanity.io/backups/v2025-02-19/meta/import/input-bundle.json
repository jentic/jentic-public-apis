{
  "openapi": "3.1.1",
  "info": {
    "title": "Backups HTTP Endpoint",
    "version": "v2025-02-19",
    "description": "Interact with your backups.\n",
    "x-jentic-source-url": "https://www.sanity.io/docs/api/openapi/backups?format=json"
  },
  "servers": [
    {
      "url": "https://api.sanity.io/{apiVersion}/projects/{projectId}",
      "description": "Sanity API base URL",
      "variables": {
        "projectId": {
          "default": "projectId",
          "description": "Project ID"
        },
        "apiVersion": {
          "default": "v2025-02-19",
          "description": "API version"
        }
      }
    }
  ],
  "paths": {
    "/datasets/{datasetName}/settings/backups": {
      "parameters": [
        {
          "name": "datasetName",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          },
          "description": "Name of the dataset"
        }
      ],
      "put": {
        "summary": "Enable or disable backups",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BackupSettings"
              },
              "example": {
                "enabled": true
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Successfully updated backup settings"
          },
          "400": {
            "description": "The request body is invalid, or the project's plan doesn't include backups: `Your current plan does not include the backups feature`."
          },
          "401": {
            "description": "The request has no valid session, or the user is missing the `update` grant on `sanity.project.datasets`: `User is missing required grant sanity.project.datasets/update to perform this operation`."
          },
          "404": {
            "description": "The project or dataset doesn't exist (`Project not found` or `Dataset not found`), or the API version is earlier than `v2024-02-21`."
          }
        }
      }
    },
    "/datasets/{datasetName}/backups": {
      "parameters": [
        {
          "name": "datasetName",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          },
          "description": "Name of the dataset"
        }
      ],
      "get": {
        "summary": "List backups",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 10,
              "minimum": 1,
              "maximum": 100
            },
            "description": "Max number of backups returned. The response contains the most recent backups, ordered oldest first."
          },
          {
            "name": "after",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Only return backups created on or after this date (`YYYY-MM-DD`). Matched against the date in the backup ID."
          },
          {
            "name": "before",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Only return backups created before this date (`YYYY-MM-DD`). Backups from this date are excluded. Matched against the date in the backup ID."
          }
        ],
        "responses": {
          "200": {
            "description": "List of backups",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BackupList"
                },
                "example": {
                  "backups": [
                    {
                      "id": "2024-02-02-19083f95-1741-4e29-997a-76b56c773e24",
                      "createdAt": "2024-02-02T14:13:06Z"
                    }
                  ],
                  "limit": 20
                }
              }
            }
          },
          "400": {
            "description": "`limit` isn't an integer from 1 to 100, or `after` or `before` isn't a `YYYY-MM-DD` date. The `message` field describes the problem, for example `limit must be between 1 and 100`."
          },
          "401": {
            "description": "The request has no valid session, the user isn't a member of the project, or the user is missing the `update` grant on `sanity.project`. A project ID that doesn't exist also returns 401. The body is `{\"code\": 401, \"message\": \"Unauthorized\"}`, with no detail about which check failed."
          },
          "404": {
            "description": "The dataset doesn't exist, or the API version is earlier than `v2024-02-21`."
          }
        }
      }
    },
    "/datasets/{datasetName}/backups/{backupId}": {
      "get": {
        "summary": "Get a backup",
        "description": "This endpoint is primarily designed for use through the Sanity CLI `sanity backups download` command, which handles paging, downloading all files, and constructing a tarball in the format expected by `sanity datasets import`.\n",
        "parameters": [
          {
            "name": "datasetName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Name of the dataset"
          },
          {
            "name": "backupId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID of the backup"
          },
          {
            "name": "nextCursor",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "The `nextCursor` value from the previous page's response. Omit it to fetch the first page."
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1000,
              "minimum": 1,
              "maximum": 1000
            },
            "description": "Max number of files returned per page"
          }
        ],
        "responses": {
          "200": {
            "description": "Backup details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Backup"
                },
                "example": {
                  "createdAt": "2023-12-12T06:03:01Z",
                  "totalFiles": 1021,
                  "files": [
                    {
                      "name": "document1",
                      "url": "https://storage.googleapis.com/example-bucket/document1?X-Goog-Algorithm=GOOG4-RSA-SHA256&X-Goog-Credential=example%40example-project.iam.gserviceaccount.com%2F20181026%2Fus-central1%2Fstorage%2Fgoog4_request&X-Goog-Date=20181026T181309Z&X-Goog-Expires=86400&X-Goog-SignedHeaders=host&X-Goog-",
                      "type": "document"
                    }
                  ],
                  "nextCursor": "MTAwMA=="
                }
              }
            }
          },
          "400": {
            "description": "`limit` isn't an integer from 1 to 1000, or `nextCursor` is invalid or points past the last file."
          },
          "401": {
            "description": "The request has no valid session, the user isn't a member of the project, or the user is missing the `update` grant on `sanity.project`. A project ID that doesn't exist also returns 401. The body is `{\"code\": 401, \"message\": \"Unauthorized\"}`, with no detail about which check failed."
          },
          "404": {
            "description": "The dataset or backup doesn't exist, or the API version is earlier than `v2024-02-21`."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "BackupSettings": {
        "type": "object",
        "required": [
          "enabled"
        ],
        "properties": {
          "enabled": {
            "type": "boolean",
            "description": "Enable or disable backups"
          }
        }
      },
      "BackupList": {
        "type": "object",
        "required": [
          "backups",
          "limit"
        ],
        "properties": {
          "backups": {
            "type": "array",
            "description": "The most recent backups, up to `limit`, ordered oldest first.",
            "items": {
              "type": "object",
              "required": [
                "id",
                "createdAt"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "description": "The backup ID, in the format `YYYY-MM-DD-<uuid>`. The date is the day the backup was created."
                },
                "createdAt": {
                  "type": "string",
                  "format": "date-time",
                  "description": "When the backup was created"
                }
              }
            }
          },
          "limit": {
            "type": "integer",
            "description": "The `limit` used for the request. This is the default of 10 if you didn't pass one."
          }
        }
      },
      "Backup": {
        "type": "object",
        "required": [
          "createdAt",
          "totalFiles",
          "files",
          "nextCursor"
        ],
        "properties": {
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "totalFiles": {
            "type": "integer",
            "description": "Total number of files in the backup, across all pages."
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "description": "Signed download URL. It expires 24 hours after the request."
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "document",
                    "image",
                    "file"
                  ]
                }
              }
            }
          },
          "nextCursor": {
            "type": "string",
            "description": "Cursor for the next page of files. Pass it as the `nextCursor` query parameter. An empty string means there are no more pages."
          }
        }
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ]
}