{
  "openapi": "3.0.0",
  "info": {
    "title": "Usage API",
    "description": "### Overview\n\nThroughout this document the terms `{resourceType}` and `{resourceId}` are used to refer to the resource that the API request is being applied to.\n\n- `{resourceType}` is one of `project`, `media-library`, `organization` or `context`.\n- `{resourceId}` is the ID of the resource that the API request is being applied to. For `context`, this is the owning organization's ID.\n",
    "contact": {
      "name": "Sanity",
      "url": "https://sanity.io"
    },
    "version": "v2026-09-01"
  },
  "servers": [
    {
      "url": "https://api.sanity.io",
      "description": "Production environment"
    }
  ],
  "tags": [
    {
      "name": "Resources",
      "description": "Get resource usage."
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "resourceTypeParam": {
        "name": "resourceType",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "enum": [
            "project",
            "media-library",
            "organization",
            "context"
          ]
        },
        "description": "Type of the resource that we are querying for. Any other value is rejected with a 400.",
        "example": "organization"
      },
      "resourceIdParam": {
        "name": "resourceId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "ID of the resource (project, media library, organization or context) that we are querying for. For `context`, use the owning organization's ID.",
        "example": "or0Bc1hcJ"
      },
      "metricParam": {
        "name": "metrics",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string"
        },
        "description": "Comma-separated list of metrics that we want to get in the response.",
        "example": "apicdnrequests,documents,assets"
      },
      "dateParam": {
        "name": "date",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "format": "date"
        },
        "description": "Date for which to fetch the snapshot, in ISO format (e.g. 2017-09-14). Defaults to today's date."
      },
      "fromParam": {
        "name": "from",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "format": "date"
        },
        "description": "Date from which to fetch history, in ISO format (e.g. 2017-09-14). Defaults to 30 days before today. Will not be aligned with period, so make sure it is set to the first day in the period if this is required."
      },
      "toParam": {
        "name": "to",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "format": "date"
        },
        "description": "Date up to which to fetch history, in ISO format (e.g. 2017-09-14). Defaults to today's date. Will not be aligned with period, so make sure it is set to the last day in the period if this is required."
      },
      "historyPeriodParam": {
        "name": "period",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "enum": [
            "day",
            "month",
            "year"
          ]
        },
        "description": "Period for which to aggregate usage, valid values are `day`, `month`, and `year`. Defaults to `month`. The requested range is limited by the period: `day` accepts at most 90 days between `from` and `to`, `month` at most 24 calendar months, and `year` is unlimited. Exceeding the limit is rejected with a 400."
      },
      "periodParam": {
        "name": "period",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "enum": [
            "day",
            "month",
            "year"
          ]
        },
        "description": "Billing period for which to fetch the snapshot, valid values are day, month, year. Defaults to month. Example: date=2017-09-14 with period=month will return usage from 2017-09-01 to 2017-09-14, while the same date with period=year will return usage from 2017-01-01 to 2017-09-14 (defaults to snapshotPeriod=startOfPeriod)."
      },
      "cumulativeParam": {
        "name": "cumulative",
        "in": "query",
        "required": false,
        "schema": {
          "type": "boolean"
        },
        "description": "If true, calculate cumulative usage (running total) for counter type metrics instead of the usage within each individual period. Defaults to false."
      },
      "cumulativePeriodParam": {
        "name": "cumulative_period",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "enum": [
            "day",
            "month",
            "year",
            "forever"
          ]
        },
        "description": "Period after which the cumulative usage will reset to 0. E.g. cumulative usage with `period=day` and `cumulative_period=month` will calculate cumulative total within each. The period is locked to the calendar. Defaults to forever."
      },
      "snapshotPeriodParam": {
        "name": "snapshotPeriod",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "enum": [
            "startOfPeriod",
            "previousPeriod"
          ]
        },
        "description": "Accepts previousPeriod and startOfPeriod. If snapshotPeriod is set to previousPeriod, then a snapshot period will be used strictly. Example: with date=2017-09-14, period=month and snapshotPeriod=previousPeriod will return usage from 2017-08-15 to 2017-09-14, while the same date with period=year and snapshotPeriod=previousPeriod will return usage from 2016-09-15 to 2017-09-14. Defaults to startOfPeriod"
      },
      "scopeParam": {
        "name": "scope",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "enum": [
            "user"
          ]
        },
        "description": "Scope level for grouping usage metrics. Currently only 'user' is supported.",
        "example": "user"
      }
    },
    "responses": {
      "badRequest": {
        "description": "Bad request."
      },
      "forbidden": {
        "description": "Session is missing required permissions or has the wrong type."
      },
      "resourceNotFound": {
        "description": "Resource not found."
      },
      "unauthorized": {
        "description": "Session is not authenticated."
      }
    },
    "schemas": {
      "ResourceHistory": {
        "title": "ResourceHistory",
        "type": "object",
        "properties": {
          "resourceType": {
            "type": "string",
            "example": "organization"
          },
          "resourceId": {
            "type": "string",
            "example": "or0Bc1hcJ"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ResourceHistoryPeriod"
            }
          }
        }
      },
      "ResourceHistoryPeriod": {
        "title": "ResourceHistoryPeriod",
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "description": "Start of the aggregation period, formatted according to the requested period (e.g. 2024-11-05 for day, 2024-11 for month, 2024 for year).",
            "example": "2024-11"
          },
          "metrics": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            },
            "description": "Map of metric names to their aggregated value for this period.",
            "example": {
              "apirequests": 563,
              "agent-actions": 563
            }
          },
          "cumulative": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            },
            "description": "Map of metric names to their running total for counter metrics. Only present when cumulative=true was requested.",
            "example": {
              "apirequests": 1126,
              "agent-actions": 1126
            }
          }
        }
      },
      "ResourceSnapshot": {
        "title": "ResourceSnapshot",
        "type": "object",
        "properties": {
          "resourceType": {
            "type": "string",
            "example": "organization"
          },
          "resourceId": {
            "type": "string",
            "example": "or0Bc1hcJ"
          },
          "usage": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            },
            "description": "Map of metric names to their value for the snapshot period. Values can be fractional.",
            "example": {
              "apirequests": 14,
              "standard-function-gb-seconds": 12.01
            }
          },
          "timestamps": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "format": "date-time",
              "nullable": true
            },
            "description": "Map of metric names to the latest timestamp recorded in the period, or null when the metric has no data.",
            "example": {
              "apirequests": "2025-02-13T00:00:00Z",
              "users": null
            }
          }
        }
      },
      "ScopedResourceSnapshot": {
        "title": "ScopedResourceSnapshot",
        "type": "object",
        "properties": {
          "resourceType": {
            "type": "string",
            "example": "organization"
          },
          "resourceId": {
            "type": "string",
            "example": "or0Bc1hcJ"
          },
          "scope": {
            "type": "string",
            "example": "user"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScopedSnapshotEntity"
            }
          }
        }
      },
      "ScopedSnapshotEntity": {
        "title": "ScopedSnapshotEntity",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Identifier of the scoped entity (e.g., user ID)",
            "example": "user-123"
          },
          "usage": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            },
            "description": "Map of metric names to their values",
            "example": {
              "content-agent-queries": 150,
              "content-agent-actions": 45
            }
          },
          "timestamps": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "format": "date-time",
              "nullable": true
            },
            "description": "Map of metric names to their last recorded timestamps",
            "example": {
              "content-agent-queries": "2024-12-12T13:48:25.727Z",
              "content-agent-actions": "2024-12-12T12:30:00.000Z"
            }
          }
        }
      },
      "ScopedResourceHistory": {
        "title": "ScopedResourceHistory",
        "type": "object",
        "properties": {
          "resourceType": {
            "type": "string",
            "example": "organization"
          },
          "resourceId": {
            "type": "string",
            "example": "or0Bc1hcJ"
          },
          "scope": {
            "type": "string",
            "example": "user"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScopedHistoryPoint"
            }
          }
        }
      },
      "ScopedHistoryPoint": {
        "title": "ScopedHistoryPoint",
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "description": "Period for the history point",
            "example": "2024-11"
          },
          "usage": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScopedHistoryEntity"
            }
          }
        }
      },
      "ScopedHistoryEntity": {
        "title": "ScopedHistoryEntity",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Identifier of the scoped entity (e.g., user ID)",
            "example": "user-123"
          },
          "metrics": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            },
            "description": "Map of metric names to their values for this period",
            "example": {
              "content-agent-queries": 50,
              "content-agent-actions": 15
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v2026-09-01/usage/{resourceType}/{resourceId}/snapshot": {
      "get": {
        "summary": "Get resource usage snapshot",
        "description": "Returns resource usage snapshot for a specific resource.",
        "operationId": "getResourceSnapshot",
        "tags": [
          "Resources"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/resourceTypeParam"
          },
          {
            "$ref": "#/components/parameters/resourceIdParam"
          },
          {
            "$ref": "#/components/parameters/metricParam"
          },
          {
            "$ref": "#/components/parameters/dateParam"
          },
          {
            "$ref": "#/components/parameters/periodParam"
          },
          {
            "$ref": "#/components/parameters/snapshotPeriodParam"
          }
        ],
        "responses": {
          "200": {
            "description": "Resource usage snapshot for the requested period.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResourceSnapshot"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Resource not found"
          }
        }
      }
    },
    "/v2026-09-01/usage/{resourceType}/{resourceId}/history": {
      "get": {
        "summary": "Get resource usage history",
        "description": "Returns resource usage history for a specific resource.",
        "operationId": "getResourceHistory",
        "tags": [
          "Resources"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/resourceTypeParam"
          },
          {
            "$ref": "#/components/parameters/resourceIdParam"
          },
          {
            "$ref": "#/components/parameters/metricParam"
          },
          {
            "$ref": "#/components/parameters/fromParam"
          },
          {
            "$ref": "#/components/parameters/toParam"
          },
          {
            "$ref": "#/components/parameters/historyPeriodParam"
          },
          {
            "$ref": "#/components/parameters/cumulativeParam"
          },
          {
            "$ref": "#/components/parameters/cumulativePeriodParam"
          }
        ],
        "responses": {
          "200": {
            "description": "Resource usage history, wrapped in a resource envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResourceHistory"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Resource not found"
          }
        }
      }
    },
    "/v2026-09-01/usage/{resourceType}/{resourceId}/{scope}/snapshot": {
      "get": {
        "summary": "Get scoped resource usage snapshot",
        "description": "Returns resource usage snapshot grouped by scope (e.g., per-user usage within an organization). User-scoped metrics exist only for organizations: `content-agent-queries`, `content-agent-actions`, `content-agent-queries-ai-usage`, `content-agent-actions-ai-usage`, `ai-usage`, `embeddings-writes` and `embeddings-reads`. Other metrics and resource types return no scoped data.",
        "operationId": "getScopedResourceSnapshot",
        "tags": [
          "Resources"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/resourceTypeParam"
          },
          {
            "$ref": "#/components/parameters/resourceIdParam"
          },
          {
            "$ref": "#/components/parameters/scopeParam"
          },
          {
            "$ref": "#/components/parameters/metricParam"
          },
          {
            "$ref": "#/components/parameters/dateParam"
          },
          {
            "$ref": "#/components/parameters/periodParam"
          },
          {
            "$ref": "#/components/parameters/snapshotPeriodParam"
          }
        ],
        "responses": {
          "200": {
            "description": "Scoped usage snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScopedResourceSnapshot"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Resource not found"
          }
        }
      }
    },
    "/v2026-09-01/usage/{resourceType}/{resourceId}/{scope}/history": {
      "get": {
        "summary": "Get scoped resource usage history",
        "description": "Returns resource usage history grouped by scope (e.g., per-user usage history within an organization). User-scoped metrics exist only for organizations: `content-agent-queries`, `content-agent-actions`, `content-agent-queries-ai-usage`, `content-agent-actions-ai-usage`, `ai-usage`, `embeddings-writes` and `embeddings-reads`. Other metrics and resource types return no scoped data.",
        "operationId": "getScopedResourceHistory",
        "tags": [
          "Resources"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/resourceTypeParam"
          },
          {
            "$ref": "#/components/parameters/resourceIdParam"
          },
          {
            "$ref": "#/components/parameters/scopeParam"
          },
          {
            "$ref": "#/components/parameters/metricParam"
          },
          {
            "$ref": "#/components/parameters/fromParam"
          },
          {
            "$ref": "#/components/parameters/toParam"
          },
          {
            "$ref": "#/components/parameters/historyPeriodParam"
          }
        ],
        "responses": {
          "200": {
            "description": "Scoped usage history",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScopedResourceHistory"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Resource not found"
          }
        }
      }
    }
  }
}