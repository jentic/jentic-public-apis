{
  "openapi": "3.1.0",
  "info": {
    "title": "CDN Cache Purge API",
    "version": "v1",
    "description": "Purge cached dataset query results or one dataset image or file from Sanity's CDN.\n\nSelf-service cache purging must be enabled for the project. Authenticate with a user or robot token that has permission to update project datasets. The Administrator and Developer roles include this permission.\n\nSee [Purge CDN caches](https://www.sanity.io/docs/content-lake/purge-cdn-caches) for usage, completion guarantees, and rate limits."
  },
  "servers": [
    {
      "url": "https://api.sanity.io",
      "description": "Sanity API"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Error identifier. Each response description lists its possible codes."
          },
          "message": {
            "type": "string",
            "description": "A description of the error, in English."
          }
        }
      },
      "RateLimitError": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string",
            "example": "API rate limit exceeded"
          }
        }
      },
      "google.protobuf.Timestamp": {
        "type": "string",
        "format": "date-time",
        "examples": [
          "2026-09-17T12:00:00Z"
        ],
        "description": "A UTC timestamp in RFC 3339 format."
      },
      "io.sanity.cdninvalidator.v1.PurgeDatasetAssetRequest": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "examples": [
              "abcd1234"
            ],
            "title": "project_id",
            "description": "The project that owns the dataset."
          },
          "datasetName": {
            "type": "string",
            "examples": [
              "production"
            ],
            "title": "dataset_name",
            "description": "The dataset the asset belongs to."
          },
          "assetId": {
            "type": "string",
            "examples": [
              "image-0123456789abcdef0123456789abcdef01234567-2000x1500-jpg"
            ],
            "title": "asset_id",
            "description": "The asset document's `_id` or an asset reference's `_ref`. Use `image-<sha1>-<width>x<height>-<format>` or `file-<sha1>-<extension>`."
          }
        },
        "title": "PurgeDatasetAssetRequest",
        "additionalProperties": false
      },
      "io.sanity.cdninvalidator.v1.PurgeDatasetAssetResponse": {
        "type": "object",
        "properties": {
          "purgeId": {
            "type": "string",
            "examples": [
              "3IVr59ieR2PO95KgrJzbF50HTtl"
            ],
            "title": "purge_id",
            "description": "An opaque identifier for the accepted purge. Include it when contacting support."
          },
          "acceptedAt": {
            "examples": [
              "2026-09-17T12:00:00Z"
            ],
            "title": "accepted_at",
            "description": "Acceptance time in UTC. The two-hour completion commitment starts here.",
            "$ref": "#/components/schemas/google.protobuf.Timestamp"
          }
        },
        "title": "PurgeDatasetAssetResponse",
        "additionalProperties": false
      },
      "io.sanity.cdninvalidator.v1.PurgeDatasetRequest": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "examples": [
              "abcd1234"
            ],
            "title": "project_id",
            "description": "The project that owns the dataset."
          },
          "datasetName": {
            "type": "string",
            "examples": [
              "production"
            ],
            "title": "dataset_name",
            "description": "The dataset whose cached query results will be purged."
          }
        },
        "title": "PurgeDatasetRequest",
        "additionalProperties": false
      },
      "io.sanity.cdninvalidator.v1.PurgeDatasetResponse": {
        "type": "object",
        "properties": {
          "purgeId": {
            "type": "string",
            "examples": [
              "01a087fd-624f-7023-a345-ec1818a481d4:1"
            ],
            "title": "purge_id",
            "description": "An opaque identifier shared by requests joining the same pending purge batch. Include it when contacting support."
          },
          "acceptedAt": {
            "examples": [
              "2026-09-17T12:00:00Z"
            ],
            "title": "accepted_at",
            "description": "Acceptance time for this request in UTC, including when it joins a pending batch. The two-hour completion commitment starts here.",
            "$ref": "#/components/schemas/google.protobuf.Timestamp"
          }
        },
        "title": "PurgeDatasetResponse",
        "additionalProperties": false
      }
    },
    "responses": {
      "MethodNotAllowed": {
        "description": "* `method_not_allowed`: use POST for this endpoint.",
        "headers": {
          "Allow": {
            "schema": {
              "type": "string",
              "example": "POST"
            },
            "example": "POST"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "code": "method_not_allowed",
              "message": "method not allowed"
            }
          }
        }
      },
      "RateLimited": {
        "description": "The project's request limit has been reached. Wait for Retry-After seconds before retrying.",
        "headers": {
          "Retry-After": {
            "description": "Seconds to wait before retrying.",
            "schema": {
              "type": "integer"
            }
          },
          "RateLimit-Limit": {
            "description": "Request limit for this operation's time window.",
            "schema": {
              "type": "integer"
            }
          },
          "RateLimit-Remaining": {
            "description": "Requests remaining in the current window.",
            "schema": {
              "type": "integer"
            }
          },
          "RateLimit-Reset": {
            "description": "Seconds until the current window resets.",
            "schema": {
              "type": "integer"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/RateLimitError"
            },
            "example": {
              "message": "API rate limit exceeded"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "A user or robot token with permission to update project datasets. Keep the token private."
      }
    }
  },
  "paths": {
    "/v1/projects/{project_id}/datasets/{dataset_name}/assets/{asset_id}/purges": {
      "post": {
        "summary": "Purge one dataset image or file",
        "description": "Purges all cached representations of one dataset image or file. Send a POST with an empty body.",
        "operationId": "purgeDatasetAsset",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "The project that owns the dataset.",
            "required": true,
            "schema": {
              "type": "string",
              "examples": [
                "abcd1234"
              ],
              "title": "project_id"
            }
          },
          {
            "name": "dataset_name",
            "in": "path",
            "description": "The dataset the asset belongs to.",
            "required": true,
            "schema": {
              "type": "string",
              "examples": [
                "production"
              ],
              "title": "dataset_name"
            }
          },
          {
            "name": "asset_id",
            "in": "path",
            "description": "The asset document's `_id` or an asset reference's `_ref`. Use `image-<sha1>-<width>x<height>-<format>` or `file-<sha1>-<extension>`.",
            "required": true,
            "schema": {
              "type": "string",
              "examples": [
                "image-0123456789abcdef0123456789abcdef01234567-2000x1500-jpg"
              ],
              "title": "asset_id"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "The request was durably accepted. The purge runs in the background.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/io.sanity.cdninvalidator.v1.PurgeDatasetAssetResponse"
                }
              }
            }
          },
          "400": {
            "description": "* `invalid_request`: the request body, asset ID, project ID, or dataset name is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "code": "invalid_request",
                  "message": "asset ID \"file-abc\" is not a dataset image or file ID; expected image-<40 hex characters>-<width>x<height>-<format> or file-<40 hex characters>-<extension>"
                }
              }
            }
          },
          "401": {
            "description": "* `unauthenticated`: the credentials are missing, invalid, or expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "code": "unauthenticated",
                  "message": "invalid credentials"
                }
              }
            }
          },
          "403": {
            "description": "* `invalid_principal_type`: a user or robot token is required.\n* `insufficient_permissions`: the caller lacks permission to purge this dataset.\n* `feature_not_included_in_plan`: self-service cache purging is unavailable for the project.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "code": "insufficient_permissions",
                  "message": "not authorized to purge this dataset"
                }
              }
            }
          },
          "404": {
            "description": "* `not_found`: no endpoint matches the requested URL.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "code": "not_found",
                  "message": "no endpoint matches the requested URL"
                }
              }
            }
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "503": {
            "description": "* `service_unavailable`: the request could not be completed. Retry with backoff.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "code": "service_unavailable",
                  "message": "the request could not be completed"
                }
              }
            }
          }
        }
      }
    },
    "/v1/projects/{project_id}/datasets/{dataset_name}/purges": {
      "post": {
        "summary": "Purge cached query responses for one dataset",
        "description": "Purges cached GROQ and GraphQL query results for one dataset. Send a POST with an empty body.",
        "operationId": "purgeDataset",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "The project that owns the dataset.",
            "required": true,
            "schema": {
              "type": "string",
              "examples": [
                "abcd1234"
              ],
              "title": "project_id"
            }
          },
          {
            "name": "dataset_name",
            "in": "path",
            "description": "The dataset whose cached query results will be purged.",
            "required": true,
            "schema": {
              "type": "string",
              "examples": [
                "production"
              ],
              "title": "dataset_name"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "The request was durably accepted. The purge runs in the background.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/io.sanity.cdninvalidator.v1.PurgeDatasetResponse"
                }
              }
            }
          },
          "400": {
            "description": "* `invalid_request`: the project ID or dataset name is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "* `unauthenticated`: the credentials are missing, invalid, or expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "* `invalid_principal_type`: a user or robot token is required.\n* `insufficient_permissions`: the caller lacks permission to purge this dataset.\n* `feature_not_included_in_plan`: self-service cache purging is unavailable for the project.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "* `not_found`: no endpoint matches the requested URL.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "503": {
            "description": "* `service_unavailable`: acceptance could not be confirmed. A purge may still execute after a timeout or 503. Allow up to 30 seconds for confirmation and retry with backoff.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  }
}