      "patch": {
        "summary": "Update a comment",
        "description": "Changes the message, status or anchor. `status` and `anchor` apply to the whole thread: the comment and all its replies change in one mutation. Editing `message` sets `lastEditedAt`. Only top-level comments that target a field can be anchored.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "description": "New comment body as Portable Text. Sets `lastEditedAt`.",
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "_type": {
                          "type": "string"
                        },
                        "children": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "_type": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "_type"
                            ],
                            "additionalProperties": {}
                          }
                        }
                      },
                      "required": [
                        "_type",
                        "children"
                      ],
                      "additionalProperties": {}
                    }
                  },
                  "status": {
                    "description": "`open` or `resolved`. Applies to the whole thread.",
                    "type": "string",
                    "enum": [
                      "open",
                      "resolved"
                    ]
                  },
                  "anchor": {
                    "description": "Where in `path` the comment is anchored, as on create. `null` removes the anchor, leaving a field-level comment.",
                    "anyOf": [
                      {
                        "oneOf": [
                          {
                            "type": "object",
                            "properties": {
                              "type": {
                                "type": "string",
                                "enum": [
                                  "portable-text"
                                ]
                              },
                              "start": {
                                "type": "object",
                                "properties": {
                                  "_key": {
                                    "type": "string",
                                    "minLength": 1
                                  },
                                  "offset": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 9007199254740991
                                  }
                                },
                                "required": [
                                  "_key",
                                  "offset"
                                ]
                              },
                              "end": {
                                "type": "object",
                                "properties": {
                                  "_key": {
                                    "type": "string",
                                    "minLength": 1
                                  },
                                  "offset": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 9007199254740991
                                  }
                                },
                                "required": [
                                  "_key",
                                  "offset"
                                ]
                              },
                              "fieldValue": {
                                "minItems": 1,
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "_type": {
                                      "type": "string"
                                    },
                                    "_key": {
                                      "type": "string",
                                      "minLength": 1
                                    }
                                  },
                                  "required": [
                                    "_type",
                                    "_key"
                                  ],
                                  "additionalProperties": {}
                                },
                                "description": "Portable Text covering the anchor (at least from start to end `_key`). When set, resolves the selection without fetching the source document. The full field also works."
                              }
                            },
                            "required": [
                              "type",
                              "start",
                              "end"
                            ]
                          }
                        ],
                        "description": "Where in `path` the comment is anchored. `portable-text`: `path` is a Portable Text field, and each point has `_key` (a block in that field) and `offset` (character position in its plain text)."
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "range": {
                    "description": "Deprecated, use `anchor`.",
                    "deprecated": true,
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "start": {
                            "type": "object",
                            "properties": {
                              "_key": {
                                "type": "string",
                                "minLength": 1
                              },
                              "offset": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 9007199254740991
                              }
                            },
                            "required": [
                              "_key",
                              "offset"
                            ]
                          },
                          "end": {
                            "type": "object",
                            "properties": {
                              "_key": {
                                "type": "string",
                                "minLength": 1
                              },
                              "offset": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 9007199254740991
                              }
                            },
                            "required": [
                              "_key",
                              "offset"
                            ]
                          }
                        },
                        "required": [
                          "start",
                          "end"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "fieldValue": {
                    "description": "Deprecated, use `anchor.fieldValue`.",
                    "deprecated": true,
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "_type": {
                          "type": "string"
                        },
                        "_key": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "_type",
                        "_key"
                      ],
                      "additionalProperties": {}
                    }
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "dataset",
                "canvas"
              ]
            },
            "in": "query",
            "name": "resourceType",
            "required": true,
            "description": "Kind of resource the comment belongs to: `dataset` for a document in a project dataset, `canvas` for a Canvas document."
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "in": "query",
            "name": "resourceId",
            "required": true,
            "description": "Id of the resource: `projectId.dataset` for `dataset`, the canvas id for `canvas`. Must not contain `:`."
          },
          {
