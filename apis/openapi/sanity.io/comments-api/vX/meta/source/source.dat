{
  "openapi": "3.1.0",
  "info": {
    "title": "Sanity Collaboration API",
    "description": "Create, update and delete comments and their reactions in the organization store that owns a resource. Reads are the query and listen endpoints, which the gateway serves from the organization store, not this service. `vX` is unstable and can change without notice.",
    "version": "vX"
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Your Sanity token, sent as `Authorization: Bearer <token>`. Comments are attributed to the token’s user."
      }
    },
    "schemas": {}
  },
  "paths": {
    "/vX/collaboration/comments/query": {
      "get": {
        "summary": "Query comments",
        "description": "Runs a GROQ query against the comments of a resource. The gateway serves it from the organization store, not this service, and it behaves like the standard query endpoint.",
        "externalDocs": {
          "description": "Query endpoint",
          "url": "https://www.sanity.io/docs/http-reference/query"
        },
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "description": "GROQ query over the resource’s comments. Pass each query parameter as its own `$name=<JSON value>`, for example `$documentId=\"article-1\"`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "organizationId",
            "in": "query",
            "required": true,
            "description": "Organization that owns the resource and its comment store.",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "resourceType",
            "in": "query",
            "required": true,
            "description": "Kind of resource the comment belongs to: `dataset` for a document in a project dataset, `canvas` for a Canvas document.",
            "schema": {
              "type": "string",
              "enum": [
                "dataset",
                "canvas"
              ]
            }
          },
          {
            "name": "resourceId",
            "in": "query",
            "required": true,
            "description": "Id of the resource: `projectId.dataset` for `dataset`, the canvas id for `canvas`. Must not contain `:`.",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "The query result.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "description": "Whatever the query returns."
                    }
                  },
                  "required": [
                    "result"
                  ]
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Query comments with a request body",
        "description": "Runs a GROQ query against the comments of a resource. The gateway serves it from the organization store, not this service, and it behaves like the standard query endpoint. Use it when the query and parameters don't fit in a URL.",
        "externalDocs": {
          "description": "Query endpoint",
          "url": "https://www.sanity.io/docs/http-reference/query"
        },
        "parameters": [
          {
            "name": "organizationId",
            "in": "query",
            "required": true,
            "description": "Organization that owns the resource and its comment store.",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "resourceType",
            "in": "query",
            "required": true,
            "description": "Kind of resource the comment belongs to: `dataset` for a document in a project dataset, `canvas` for a Canvas document.",
            "schema": {
              "type": "string",
              "enum": [
                "dataset",
                "canvas"
              ]
            }
          },
          {
            "name": "resourceId",
            "in": "query",
            "required": true,
            "description": "Id of the resource: `projectId.dataset` for `dataset`, the canvas id for `canvas`. Must not contain `:`.",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string",
                    "description": "GROQ query over the resource’s comments."
                  },
                  "params": {
                    "type": "object",
                    "description": "Query parameters by name, without the `$`. For example `{\"documentId\": \"article-1\"}`."
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "The query result.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "description": "Whatever the query returns."
                    }
                  },
                  "required": [
                    "result"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/vX/collaboration/comments/listen": {
      "get": {
        "summary": "Listen for comment changes",
        "description": "Streams changes to the comments a GROQ query matches, as server-sent events. The gateway serves it from the organization store, not this service, and it behaves like the standard listen endpoint, including its options such as `includeResult` and `visibility`.",
        "externalDocs": {
          "description": "Listen endpoint",
          "url": "https://www.sanity.io/docs/http-reference/listen"
        },
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "description": "GROQ query over the resource’s comments. Pass each query parameter as its own `$name=<JSON value>`, for example `$documentId=\"article-1\"`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "organizationId",
            "in": "query",
            "required": true,
            "description": "Organization that owns the resource and its comment store.",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "resourceType",
            "in": "query",
            "required": true,
            "description": "Kind of resource the comment belongs to: `dataset` for a document in a project dataset, `canvas` for a Canvas document.",
            "schema": {
              "type": "string",
              "enum": [
                "dataset",
                "canvas"
              ]
            }
          },
          {
            "name": "resourceId",
            "in": "query",
            "required": true,
            "description": "Id of the resource: `projectId.dataset` for `dataset`, the canvas id for `canvas`. Must not contain `:`.",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "An event stream of `welcome`, `mutation` and other listen events.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/vX/collaboration/comments": {
      "post": {
        "summary": "Create a comment",
        "description": "Creates a top-level comment on `target`, or a reply when `parentCommentId` is set. A reply inherits its parent’s target, status and `threadId`, so don’t send `target` or `threadId` with it. Replies to a reply are rejected with 400. Top-level comments start as `open`.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "_id": {
                    "description": "`_id` for the comment. Server-generated if omitted.",
                    "type": "string",
                    "minLength": 1
                  },
                  "target": {
                    "description": "What the comment targets. Required when `parentCommentId` is not set.",
                    "type": "object",
                    "properties": {
                      "documentId": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[^:]+$",
                        "description": "Id of the document the comment is on, for example `drafts.article-1`, without the resource prefix. Must not contain `:`."
                      },
                      "documentType": {
                        "type": "string",
                        "minLength": 1,
                        "description": "`_type` of that document."
                      },
                      "documentRevisionId": {
                        "description": "Revision of the document the comment was written against.",
                        "type": "string"
                      },
                      "path": {
                        "description": "Field the comment is on, for example `body`. Required with `anchor`. Omit it for a document-level comment.",
                        "type": "string",
                        "minLength": 1
                      },
                      "anchor": {
                        "description": "Where in `path` the comment is anchored.",
                        "anyOf": [
                          {
                            "oneOf": [
                              {
                                "type": "object",
                                "properties": {
                                  "type": {
                                    "type": "string",
                                    "enum": [
                                      "portable-text"
                                    ]
                                  },
                                  "start": {
                                    "type": "object",
                                    "properties": {
                                      "_key": {
                                        "type": "string",
                                        "minLength": 1
                                      },
                                      "offset": {
                                        "type": "integer",
                                        "minimum": 0,
                                        "maximum": 9007199254740991
                                      }
                                    },
                                    "required": [
                                      "_key",
                                      "offset"
                                    ]
                                  },
                                  "end": {
                                    "type": "object",
                                    "properties": {
                                      "_key": {
                                        "type": "string",
                                        "minLength": 1
                                      },
                                      "offset": {
                                        "type": "integer",
                                        "minimum": 0,
                                        "maximum": 9007199254740991
                                      }
                                    },
                                    "required": [
                                      "_key",
                                      "offset"
                                    ]
                                  },
                                  "fieldValue": {
                                    "minItems": 1,
                                    "type": "array",
                                    "items": {
                                      "type": "object",
                                      "properties": {
                                        "_type": {
                                          "type": "string"
                                        },
                                        "_key": {
                                          "type": "string",
                                          "minLength": 1
                                        }
                                      },
                                      "required": [
                                        "_type",
                                        "_key"
                                      ],
                                      "additionalProperties": {}
                                    },
                                    "description": "Portable Text covering the anchor (at least from start to end `_key`). When set, resolves the selection without fetching the source document. The full field also works."
                                  }
                                },
                                "required": [
                                  "type",
                                  "start",
                                  "end"
                                ]
                              }
                            ],
                            "description": "Where in `path` the comment is anchored. `portable-text`: `path` is a Portable Text field, and each point has `_key` (a block in that field) and `offset` (character position in its plain text)."
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "range": {
                        "description": "Deprecated, use `anchor`.",
                        "deprecated": true,
                        "anyOf": [
                          {
                            "type": "object",
                            "properties": {
                              "start": {
                                "type": "object",
                                "properties": {
                                  "_key": {
                                    "type": "string",
                                    "minLength": 1
                                  },
                                  "offset": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 9007199254740991
                                  }
                                },
                                "required": [
                                  "_key",
                                  "offset"
                                ]
                              },
                              "end": {
                                "type": "object",
                                "properties": {
                                  "_key": {
                                    "type": "string",
                                    "minLength": 1
                                  },
                                  "offset": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 9007199254740991
                                  }
                                },
                                "required": [
                                  "_key",
                                  "offset"
                                ]
                              }
                            },
                            "required": [
                              "start",
                              "end"
                            ]
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "fieldValue": {
                        "description": "Deprecated, use `anchor.fieldValue`.",
                        "deprecated": true,
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "_type": {
                              "type": "string"
                            },
                            "_key": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": [
                            "_type",
                            "_key"
                          ],
                          "additionalProperties": {}
                        }
                      }
                    },
                    "required": [
                      "documentId",
                      "documentType"
                    ]
                  },
                  "parentCommentId": {
                    "description": "When set, creates a reply to this comment.",
                    "type": "string",
                    "minLength": 1
                  },
                  "threadId": {
                    "description": "`threadId` for a top-level comment. Server-generated if omitted. Not allowed on replies — replies inherit the parent's `threadId`.",
                    "type": "string",
                    "minLength": 1
                  },
                  "message": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "_type": {
                          "type": "string"
                        },
                        "children": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "_type": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "_type"
                            ],
                            "additionalProperties": {}
                          }
                        }
                      },
                      "required": [
                        "_type",
                        "children"
                      ],
                      "additionalProperties": {}
                    },
                    "description": "Comment body as Portable Text."
                  },
                  "context": {
                    "description": "Free-form metadata stored as-is on the comment.",
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {}
                  }
                },
                "required": [
                  "message"
                ]
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "dataset",
                "canvas"
              ]
            },
            "in": "query",
            "name": "resourceType",
            "required": true,
            "description": "Kind of resource the comment belongs to: `dataset` for a document in a project dataset, `canvas` for a Canvas document."
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "in": "query",
            "name": "resourceId",
            "required": true,
            "description": "Id of the resource: `projectId.dataset` for `dataset`, the canvas id for `canvas`. Must not contain `:`."
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "in": "query",
            "name": "organizationId",
            "required": true,
            "description": "Organization that owns the resource and its comment store."
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "transactionId",
            "required": false,
            "description": "Transaction id for the store mutation. Set it to recognize your own write when it comes back through a listener."
          },
          {
            "schema": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[\\w.+-]+$"
            },
            "in": "query",
            "name": "clientVersion",
            "required": false,
            "description": "Version of the calling `@sanity/client`, for telemetry."
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "The mutation result: `transactionId` and one `results` entry per document changed (a thread change includes every reply).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "transactionId": {
                      "type": "string"
                    },
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "operation": {
                            "type": "string",
                            "enum": [
                              "create",
                              "update",
                              "delete",
                              "none"
                            ]
                          },
                          "document": {
                            "type": "object",
                            "propertyNames": {
                              "type": "string"
                            },
                            "additionalProperties": {}
                          }
                        },
                        "required": [
                          "id"
                        ],
                        "additionalProperties": {}
                      }
                    }
                  },
                  "required": [
                    "transactionId",
                    "results"
                  ],
                  "additionalProperties": {},
                  "description": "The mutation result: `transactionId` and one `results` entry per document changed (a thread change includes every reply)."
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid: it failed schema validation or breaks a rule such as replying to a reply. `message` says which.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "code": {
                      "description": "Machine-readable error code, when there is one.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "statusCode",
                    "error",
                    "message"
                  ],
                  "additionalProperties": {},
                  "description": "The request is invalid: it failed schema validation or breaks a rule such as replying to a reply. `message` says which."
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired bearer token.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "code": {
                      "description": "Machine-readable error code, when there is one.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "statusCode",
                    "error",
                    "message"
                  ],
                  "additionalProperties": {},
                  "description": "Missing, invalid or expired bearer token."
                }
              }
            }
          },
          "403": {
            "description": "The token’s user can’t write comments on this resource.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "code": {
                      "description": "Machine-readable error code, when there is one.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "statusCode",
                    "error",
                    "message"
                  ],
                  "additionalProperties": {},
                  "description": "The token’s user can’t write comments on this resource."
                }
              }
            }
          },
          "404": {
            "description": "The comment or resource was not found, or the resource is not in the organization.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "code": {
                      "description": "Machine-readable error code, when there is one.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "statusCode",
                    "error",
                    "message"
                  ],
                  "additionalProperties": {},
                  "description": "The comment or resource was not found, or the resource is not in the organization."
                }
              }
            }
          },
          "503": {
            "description": "The organization store or a dependency isn’t available yet. Retry later.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "code": {
                      "description": "Machine-readable error code, when there is one.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "statusCode",
                    "error",
                    "message"
                  ],
                  "additionalProperties": {},
                  "description": "The organization store or a dependency isn’t available yet. Retry later."
                }
              }
            }
          }
        }
      }
    },
    "/vX/collaboration/comments/{id}": {
      "delete": {
        "summary": "Delete a comment and all its replies",
        "description": "Deletes the comment and its replies in one mutation. Idempotent: deleting a comment that doesn’t exist returns 200 with empty `results`, not 404.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "dataset",
                "canvas"
              ]
            },
            "in": "query",
            "name": "resourceType",
            "required": true,
            "description": "Kind of resource the comment belongs to: `dataset` for a document in a project dataset, `canvas` for a Canvas document."
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "in": "query",
            "name": "resourceId",
            "required": true,
            "description": "Id of the resource: `projectId.dataset` for `dataset`, the canvas id for `canvas`. Must not contain `:`."
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "in": "query",
            "name": "organizationId",
            "required": true,
            "description": "Organization that owns the resource and its comment store."
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "transactionId",
            "required": false,
            "description": "Transaction id for the store mutation. Set it to recognize your own write when it comes back through a listener."
          },
          {
            "schema": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[\\w.+-]+$"
            },
            "in": "query",
            "name": "clientVersion",
            "required": false,
            "description": "Version of the calling `@sanity/client`, for telemetry."
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true,
            "description": "`_id` of the comment."
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "The mutation result: `transactionId` and one `results` entry per document changed (a thread change includes every reply).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "transactionId": {
                      "type": "string"
                    },
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "operation": {
                            "type": "string",
                            "enum": [
                              "create",
                              "update",
                              "delete",
                              "none"
                            ]
                          },
                          "document": {
                            "type": "object",
                            "propertyNames": {
                              "type": "string"
                            },
                            "additionalProperties": {}
                          }
                        },
                        "required": [
                          "id"
                        ],
                        "additionalProperties": {}
                      }
                    }
                  },
                  "required": [
                    "transactionId",
                    "results"
                  ],
                  "additionalProperties": {},
                  "description": "The mutation result: `transactionId` and one `results` entry per document changed (a thread change includes every reply)."
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid: it failed schema validation or breaks a rule such as replying to a reply. `message` says which.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
