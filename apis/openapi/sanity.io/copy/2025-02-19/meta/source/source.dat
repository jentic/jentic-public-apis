{
  "openapi": "3.1.1",
  "info": {
    "title": "Copy HTTP Endpoint",
    "version": "2025-02-19",
    "description": "The Copy API, also known as Cloud Clone, lets you make a copy of an existing dataset. It offers an alternative to exporting and importing a dataset.\n"
  },
  "servers": [
    {
      "url": "https://api.sanity.io/{apiVersion}",
      "description": "Parameterized base URL",
      "variables": {
        "apiVersion": {
          "default": "v2025-02-19",
          "description": "API version"
        }
      }
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/projects/{projectId}/datasets/{dataset}/copy": {
      "put": {
        "summary": "Copy",
        "operationId": "copyDataset",
        "description": "The Copy API, also known as Cloud Clone, lets you make a copy of an existing dataset.\nIt offers an alternative to exporting and importing a dataset.\nThis feature is also [available in the CLI](https://www.sanity.io/docs/content-lake/how-to-use-cloud-clone-for-datasets).\nAll requests to this endpoint must be [authenticated](https://www.sanity.io/docs/content-lake/http-auth).\n\n### Check the status of the copy operation\nYou can check the status of the copy operation by making a request to the [Jobs API](https://www.sanity.io/docs/http-reference/jobs) with the returned `jobId`.\n\n### Content releases in the copy\nUnless you set `skipContentReleases`, content releases and their document versions are copied to the target dataset. Scheduled releases are unscheduled in the copy: they arrive with the `active` state and without a `publishAt` time.\n\n### Paid feature\nThis feature is part of our Advanced Dataset Management offering on the enterprise plan. Contact us if you need this feature and want to discuss this plan.\n",
        "parameters": [
          {
            "in": "path",
            "name": "projectId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "dataset",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "targetDataset"
                ],
                "additionalProperties": false,
                "properties": {
                  "targetDataset": {
                    "type": "string",
                    "pattern": "^[a-z0-9][-_a-z0-9]+$",
                    "maxLength": 64,
                    "description": "The name of the new dataset. Must adhere to the [dataset naming requirements](https://www.sanity.io/docs/content-lake/datasets).\n",
                    "example": "production-copy"
                  },
                  "skipHistory": {
                    "type": "boolean",
                    "default": false,
                    "description": "If true, it skips document history while copying the dataset. This can reduce copy time on datasets with a large edit history. [Check the retention period](https://www.sanity.io/docs/user-guides/history-experience) to find out how long a dataset's history is kept.\n"
                  },
                  "skipContentReleases": {
                    "type": "boolean",
                    "default": false,
                    "description": "If true, content releases aren't copied. This skips both the release documents and the document versions that belong to them. Copied releases count against your organization's release quota.\n"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Returns details about the new copy job. Use the `jobId` with the [Jobs API](https://www.sanity.io/docs/http-reference/jobs) to check the status.\n",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "datasetName": {
                      "type": "string",
                      "description": "The name of the source dataset.\n",
                      "example": "production"
                    },
                    "message": {
                      "type": "string",
                      "description": "A message indicating the status of the copy operation.\n",
                      "example": "Starting copying dataset production to production-copy..."
                    },
                    "aclMode": {
                      "type": "string",
                      "description": "The ACL mode of the source dataset.\n",
                      "example": "public"
                    },
                    "jobId": {
                      "type": "string",
                      "description": "The ID of the job that is running the copy operation.\n",
                      "example": "jacsfsmnxp"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid, or the project's plan doesn't include the Advanced Dataset Management feature.\n\n- The request body fails validation: `targetDataset` is missing or doesn't match the dataset naming requirements, or the body contains a field this endpoint doesn't accept. The response includes a `validation` object describing the failure.\n- The plan doesn't include the feature. The error message is \"Your current plan does not include the advanced dataset management feature\".\n",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "The request has no valid token, or the token lacks the `create` grant on `sanity.project.datasets`. A missing grant returns 401, not 403, with `code` set to `missing_grant`.\n",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "402": {
            "description": "The project has reached its dataset quota. The error message is \"Quota exceeded\" or \"Overage quota exceeded\". The quota is checked before the source dataset, so a project at its quota gets this error even if the source dataset doesn't exist.\n",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "The project or the source dataset doesn't exist. The error message is \"Project not found\" or \"Source dataset not found\".\n",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "A copy job from this source dataset to `targetDataset` is already running, or a dataset named `targetDataset` already exists. The error message is \"Job already in progress. Job ID: <jobId>\" or \"A dataset with this name already exists\".\n",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "The copy job couldn't be started. The error message is \"Could not initiate the dataset copying\".\n",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/projects/{projectId}/datasets/copy": {
      "get": {
        "summary": "List copy jobs",
        "operationId": "listCopyJobs",
        "description": "Lists the dataset copy jobs for a project, newest first. The CLI uses this endpoint for `sanity dataset copy --list`.\n\nThe token needs the `read` grant on the `sanity.project.datasets` permission. Listing jobs doesn't require the Advanced Dataset Management feature.\n\nTo follow a single job, use the [Jobs API](https://www.sanity.io/docs/http-reference/jobs) with its `id`.\n",
        "parameters": [
          {
            "in": "path",
            "name": "projectId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 10
            },
            "description": "The maximum number of jobs to return. Use a value of 255 or less: larger values wrap around, so `300` returns at most 44 jobs and `256` returns every job.\n"
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "description": "The number of jobs to skip, for paging through results. Use a value of 255 or less: larger values wrap around, so `256` starts from the first job again.\n"
          },
          {
            "in": "query",
            "name": "state",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "A comma-separated list of job states to filter by. Valid states are `pending`, `running`, `completed`, `failed`, `terminating`, and `terminated`.\n",
            "example": "pending,running"
          }
        ],
        "responses": {
          "200": {
            "description": "Returns an array of copy jobs, newest first.\n",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CopyJob"
                  }
                }
              }
            }
          },
          "400": {
            "description": "A query parameter is invalid: `limit` is outside 1–1000, `offset` is negative, or the request includes a query parameter this endpoint doesn't accept. The response includes a `validation` object describing the failure.\n",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "The request has no valid token, or the token lacks the `read` grant on `sanity.project.datasets`. A missing grant returns 401, not 403, with `code` set to `missing_grant`.\n",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "The project doesn't exist, or the job list couldn't be fetched. The error message is \"Project not found\" or \"Could not get a list of the dataset copy jobs\". An unrecognized `state` value also returns the second message.\n",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "integer",
            "description": "The HTTP status code.",
            "example": 404
          },
          "error": {
            "type": "string",
            "description": "The HTTP status text.",
            "example": "Not Found"
          },
          "message": {
            "type": "string",
            "description": "A description of the error.",
            "example": "Source dataset not found"
          },
          "code": {
            "type": "string",
            "description": "A machine-readable error code. Present on some errors, such as `missing_grant` on 401 responses.\n"
          },
          "validation": {
            "type": "object",
            "description": "Details about which part of the request failed validation. Present on 400 validation errors.\n"
          }
        }
      },
      "CopyJob": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The job ID. Use it with the Jobs API to check the job's status.",
            "example": "jacsfsmnxp"
          },
          "state": {
            "type": "string",
            "enum": [
              "pending",
              "running",
              "completed",
              "failed",
              "terminating",
              "terminated"
            ],
            "description": "The current state of the job.",
            "example": "completed"
          },
          "authors": {
            "type": "array",
            "description": "The IDs of the users who started the job. Jobs started by Sanity's own services list `service`.\n",
            "items": {
              "type": "string"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-20T12:00:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-20T12:20:00.000Z"
          },
          "sourceDataset": {
            "type": "string",
            "description": "The name of the dataset being copied.",
            "example": "production"
          },
          "targetDataset": {
            "type": "string",
            "description": "The name of the new dataset.",
            "example": "production-copy"
          },
          "withHistory": {
            "type": "boolean",
            "description": "Whether the copy includes document history. This is `false` when the job was started with `skipHistory: true`.\n",
            "example": true
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}