{
  "openapi": "3.1.0",
  "info": {
    "title": "Sanity Content Agent API",
    "description": "The Content Agent API allows you to integrate Content Agent into your own applications via HTTP.\nIt uses Server-Sent Events (SSE) for streaming responses, fully compatible with the Vercel AI SDK.\n",
    "version": "1.0.0",
    "contact": {
      "name": "Sanity Support",
      "url": "https://www.sanity.io/contact"
    },
    "license": {
      "name": "Proprietary",
      "url": "https://www.sanity.io/legal/terms"
    }
  },
  "servers": [
    {
      "url": "https://api.sanity.io/vX/agent",
      "description": "Production API (preview)"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Chat",
      "description": "Conversational endpoints with thread management"
    },
    {
      "name": "Prompt",
      "description": "Stateless prompt endpoints"
    }
  ],
  "paths": {
    "/{organizationId}/threads/{threadId}": {
      "post": {
        "operationId": "chat",
        "summary": "Send a chat message",
        "description": "Send a message to the agent and receive a streaming response.\nThis endpoint manages conversation threads and persists message history.\n",
        "tags": [
          "Chat"
        ],
        "parameters": [
          {
            "name": "organizationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "description": "Your Sanity organization ID",
            "example": "abc123"
          },
          {
            "name": "threadId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "description": "Unique identifier for the conversation thread",
            "example": "my-conversation-thread"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              },
              "examples": {
                "basic": {
                  "summary": "Basic chat request",
                  "value": {
                    "messages": [
                      {
                        "role": "user",
                        "content": "What blog posts do I have?"
                      }
                    ]
                  }
                },
                "withConfig": {
                  "summary": "Chat with configuration",
                  "value": {
                    "messages": [
                      {
                        "role": "user",
                        "content": "Show me all draft posts"
                      }
                    ],
                    "config": {
                      "capabilities": {
                        "read": true,
                        "write": false
                      },
                      "filter": {
                        "read": "_type == 'post'"
                      }
                    }
                  }
                },
                "withFeatureOverrides": {
                  "summary": "Chat with feature overrides",
                  "value": {
                    "messages": [
                      {
                        "role": "user",
                        "content": "Show me all blog posts"
                      }
                    ],
                    "config": {
                      "capabilities": {
                        "read": true,
                        "write": false,
                        "features": {
                          "webSearch": false
                        }
                      }
                    }
                  }
                },
                "withUserContext": {
                  "summary": "Chat with user message context",
                  "value": {
                    "messages": [
                      {
                        "role": "user",
                        "content": "Help me write a new blog post"
                      }
                    ],
                    "config": {
                      "instruction": "You are a helpful content assistant.",
                      "userMessageContext": {
                        "slack-channel": "#marketing",
                        "user-role": "editor"
                      },
                      "capabilities": {
                        "read": true,
                        "write": true
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Streaming response",
            "headers": {
              "Content-Type": {
                "schema": {
                  "type": "string",
                  "example": "text/event-stream"
                }
              },
              "X-Vercel-AI-Data-Stream": {
                "schema": {
                  "type": "string",
                  "example": "v1"
                }
              }
            },
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "Server-Sent Events stream following Vercel AI Data Stream Protocol"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                },
                "description": "JSON response when stream is false"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/prompt": {
      "post": {
        "operationId": "prompt",
        "summary": "Send a one-shot prompt",
        "description": "Stateless one-shot prompt endpoint. No thread management or message persistence.\nIdeal for simple, single-turn interactions.\n",
        "tags": [
          "Prompt"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PromptRequest"
              },
              "examples": {
                "basic": {
                  "summary": "Basic prompt request",
                  "value": {
                    "organizationId": "abc123",
                    "message": "Summarize my latest blog posts",
                    "config": {
                      "capabilities": {
                        "read": true,
                        "write": false
                      }
                    }
                  }
                },
                "withInstructions": {
                  "summary": "Prompt with custom instructions",
                  "value": {
                    "organizationId": "abc123",
                    "message": "List all authors",
                    "config": {
                      "capabilities": {
                        "read": true,
                        "write": false
                      }
                    },
                    "instructions": "Format the response as a numbered list"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Streaming response",
            "headers": {
              "Content-Type": {
                "schema": {
                  "type": "string",
                  "example": "text/event-stream"
                }
              },
              "X-Vercel-AI-Data-Stream": {
                "schema": {
                  "type": "string",
                  "example": "v1"
                }
              }
            },
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "Server-Sent Events stream following Vercel AI Data Stream Protocol"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Sanity authentication token"
      }
    },
    "schemas": {
      "ChatRequest": {
        "type": "object",
        "required": [
          "messages"
        ],
        "properties": {
          "messages": {
            "type": "array",
            "minItems": 1,
            "description": "Array of message objects",
            "items": {
              "$ref": "#/components/schemas/Message"
            }
          },
          "application": {
            "$ref": "#/components/schemas/Application"
          },
          "config": {
            "$ref": "#/components/schemas/Config"
          },
          "stream": {
            "type": "boolean",
            "default": true,
            "description": "Enable or disable streaming responses"
          },
          "format": {
            "type": "string",
            "enum": [
              "markdown",
              "directives"
            ],
            "default": "markdown",
            "description": "Controls how directives in the response are formatted.\n- markdown (default): Directives are resolved server-side into standard markdown (e.g., links with titles).\n- directives: Raw directive syntax is preserved (e.g., `::document{id=\"doc-id\"}`), useful for clients that render custom UI components.\n"
          }
        }
      },
      "PromptRequest": {
        "type": "object",
        "required": [
          "organizationId",
          "message"
        ],
        "properties": {
          "organizationId": {
            "type": "string",
            "minLength": 1,
            "description": "Your Sanity organization ID",
            "example": "abc123"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000,
            "description": "The prompt message",
            "example": "Summarize my latest blog posts"
          },
          "config": {
            "$ref": "#/components/schemas/Config"
          },
          "instructions": {
            "type": "string",
            "description": "Custom instructions for the agent",
            "example": "Be concise and use bullet points"
          },
          "format": {
            "type": "string",
            "enum": [
              "markdown",
              "directives"
            ],
            "default": "markdown",
            "description": "Controls how directives in the response are formatted.\n- markdown (default): Directives are resolved server-side into standard markdown.\n- directives: Raw directive syntax is preserved for clients that render custom UI.\n"
          }
        }
      },
      "Message": {
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant",
              "system"
            ],
            "description": "The role of the message sender"
          },
          "content": {
            "type": "string",
            "description": "The message content"
          },
          "id": {
            "type": "string",
            "description": "Optional unique identifier for the message"
          },
          "name": {
            "type": "string",
            "description": "Optional name for the message sender"
          }
        }
      },
      "Application": {
        "type": "object",
        "description": "Target Sanity application configuration",
        "properties": {
          "key": {
            "type": "string",
            "description": "Application key in format \"projectId.datasetName\"",
            "example": "abc123.production"
          },
          "resource": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "Resource ID in format \"projectId.datasetName\"",
                "example": "abc123.production"
              },
              "type": {
                "type": "string",
                "enum": [
                  "dataset"
                ],
                "description": "Resource type"
              }
            }
          },
          "intentBaseUrl": {
            "type": "string",
            "format": "uri",
            "description": "Base URL for the Sanity Studio",
            "example": "https://your-studio.sanity.studio"
          },
          "bundleVersion": {
            "type": "string",
            "description": "Bundle version"
          },
          "name": {
            "type": "string",
            "description": "Application name"
          },
          "title": {
            "type": "string",
            "description": "Application title"
          },
          "schemaDescriptorId": {
            "type": "string",
            "description": "Schema descriptor ID"
          }
        }
      },
      "Config": {
        "type": "object",
        "description": "Agent configuration. Controls behavior, capabilities, and document access.\n",
        "properties": {
          "instruction": {
            "type": "string",
            "description": "Custom instruction string to include in the system prompt",
            "example": "You are a helpful content assistant."
          },
          "userMessageContext": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Key-value pairs appended to each user message as XML tags.\nEach key becomes an XML tag with the value as content.\nExample: { \"slack-channel\": \"#marketing\" } renders as <slack-channel>#marketing</slack-channel>\n",
            "example": {
              "slack-channel": "#marketing",
              "user-role": "editor"
            }
          },
          "capabilities": {
            "$ref": "#/components/schemas/Capabilities"
          },
          "filter": {
            "$ref": "#/components/schemas/Filter"
          },
          "perspectives": {
            "$ref": "#/components/schemas/Perspectives"
          }
        }
      },
      "Capabilities": {
        "type": "object",
        "description": "Agent capabilities that control what operations are allowed.\nEach capability can be a boolean or an object with a preset.\n",
        "properties": {
          "read": {
            "$ref": "#/components/schemas/Capability"
          },
          "write": {
            "$ref": "#/components/schemas/Capability"
          },
          "features": {
            "$ref": "#/components/schemas/FeatureOverrides"
          }
        },
        "example": {
          "read": true,
          "write": false
        }
      },
      "FeatureOverrides": {
        "type": "object",
        "description": "Explicit feature overrides applied on top of capability-derived defaults.\nWhen not specified, features use values derived from read/write capability presets.\n",
        "properties": {
          "webSearch": {
            "type": "boolean",
            "description": "Override web search availability.\nBy default, web search is enabled when read capability is 'standard'.\n"
          }
        }
      },
      "Capability": {
        "oneOf": [
          {
            "type": "boolean",
            "description": "true = standard preset, false = disabled"
          },
          {
            "$ref": "#/components/schemas/CapabilityPreset"
          }
        ],
        "description": "A capability can be:\n- true: Full access (standard preset)\n- false: No access\n- { preset: 'minimal' | 'standard' }: Explicit preset selection\n"
      },
      "CapabilityPreset": {
        "type": "object",
        "required": [
          "preset"
        ],
        "properties": {
          "preset": {
            "type": "string",
            "enum": [
              "minimal",
              "standard"
            ],
            "description": "For read capability:\n- minimal: Basic queries only (no bulk document analysis)\n- standard: All read tools including bulk analysis\n\nFor write capability:\n- minimal: Basic mutations only (no bulk mutations)\n- standard: All write tools including bulk mutations\n"
          }
        }
      },
      "Filter": {
        "type": "object",
        "description": "GROQ filter expressions for document access control",
        "properties": {
          "read": {
            "type": "string",
            "description": "GROQ boolean expression for document visibility.\nDocuments matching this filter are visible to the agent.\n",
            "example": "_type in ['post', 'author']"
          },
          "write": {
            "type": "string",
            "description": "GROQ boolean expression for mutation permissions.\nDocuments matching this filter can be mutated.\n",
            "example": "_type == 'post'"
          }
        }
      },
      "Perspectives": {
        "type": "object",
        "description": "Perspective locking configuration.\nControls which document perspectives the agent can read from and write to.\nValues are Sanity perspective IDs: 'drafts', 'published', 'raw', or release/bundle IDs.\n",
        "properties": {
          "read": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Allowed read perspectives. When set, query tools can only use these perspectives.\nIf the agent tries to use a disallowed perspective, the request is rejected with an error.\n",
            "example": [
              "drafts",
              "published"
            ]
          },
          "write": {
            "type": "string",
            "description": "The write perspective. When set, new documents are created in this perspective\nand mutations are restricted to documents whose ID matches it.\n",
            "example": "drafts"
          }
        }
      },
      "ChatResponse": {
        "type": "object",
        "description": "JSON response when streaming is disabled",
        "properties": {
          "text": {
            "type": "string",
            "description": "The agent's response text"
          },
          "applicationKey": {
            "type": "string",
            "description": "The application key used for this conversation"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "Error type",
            "example": "Invalid request"
          },
          "details": {
            "type": "string",
            "description": "Human-readable error description",
            "example": "Request body validation failed"
          },
          "issues": {
            "type": "array",
            "description": "Validation issues (when applicable)",
            "items": {
              "$ref": "#/components/schemas/ValidationIssue"
            }
          }
        }
      },
      "ValidationIssue": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Error code",
            "example": "invalid_type"
          },
          "path": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Path to the invalid field",
            "example": [
              "messages"
            ]
          },
          "message": {
            "type": "string",
            "description": "Error message",
            "example": "Required"
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Bad Request - Request validation failed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "error": "Invalid request",
              "details": "Request body validation failed",
              "issues": [
                {
                  "code": "invalid_type",
                  "path": [
                    "messages"
                  ],
                  "message": "Required"
                }
              ]
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Unauthorized - Missing or invalid authentication token",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "error": "Unauthorized",
              "details": "Missing authorization token"
            }
          }
        }
      },
      "InternalServerError": {
        "description": "Internal Server Error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "error": "Internal Server Error",
              "details": "An unexpected error occurred"
            }
          }
        }
      }
    }
  }
}