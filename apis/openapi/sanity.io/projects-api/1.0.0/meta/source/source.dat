{
  "openapi": "3.1.1",
  "info": {
    "title": "Sanity Projects API",
    "description": "Manage your Sanity projects.\n\nFor role and permission management, use the [Access API](https://www.sanity.io/docs/http-reference/access-api).\n",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.sanity.io/{apiVersion}",
      "description": "Sanity API base URL",
      "variables": {
        "apiVersion": {
          "default": "v2021-06-07",
          "description": "API version"
        }
      }
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/projects": {
      "get": {
        "summary": "List all projects",
        "operationId": "listProjects",
        "description": "Returns a list of all projects you are a member of.",
        "parameters": [
          {
            "name": "includeMembers",
            "in": "query",
            "required": false,
            "description": "Whether to include project members in the response.",
            "schema": {
              "type": "boolean",
              "default": true
            }
          },
          {
            "name": "includeFeatures",
            "in": "query",
            "required": false,
            "description": "Whether to include project features in the response.",
            "schema": {
              "type": "boolean",
              "default": true
            }
          },
          {
            "name": "organizationId",
            "in": "query",
            "required": false,
            "description": "Only return projects that belong to this organization.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "onlyExplicitMembership",
            "in": "query",
            "required": false,
            "description": "Only return projects where you have explicit project membership.",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "includeOrganizationProjects",
            "in": "query",
            "required": false,
            "description": "Also return projects you can read through your organization membership. Ignored when `onlyExplicitMembership` is `true`.",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "includeOnlyCreatedProjects",
            "in": "query",
            "required": false,
            "description": "Only return projects you created.",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A list of projects.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Project"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a project",
        "operationId": "createProject",
        "description": "Creates a new Sanity project.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProjectCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Project created successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            }
          }
        }
      }
    },
    "/projects/{projectId}": {
      "get": {
        "summary": "Retrieve a project",
        "operationId": "retrieveProject",
        "description": "Returns the details of a specific project by ID.",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The unique ID of the project."
          },
          {
            "name": "includeMembers",
            "in": "query",
            "required": false,
            "description": "Whether to include project members in the response.",
            "schema": {
              "type": "boolean",
              "default": true
            }
          },
          {
            "name": "includeFeatures",
            "in": "query",
            "required": false,
            "description": "Whether to include project features in the response.",
            "schema": {
              "type": "boolean",
              "default": true
            }
          },
          {
            "name": "includeOrganization",
            "in": "query",
            "required": false,
            "description": "Whether to include the project's organization in the response.",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Project details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Update a project",
        "operationId": "updateProject",
        "description": "Updates a specific project by ID.",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The unique ID of the project."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProjectUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Project updated successfully. Returns the updated project.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete a project",
        "operationId": "deleteProject",
        "description": "Deletes a specific project by ID.",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The unique ID of the project."
          }
        ],
        "responses": {
          "200": {
            "description": "Project deleted successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "deleted": {
                      "type": "boolean",
                      "example": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/projects/{projectId}/cors": {
      "parameters": [
        {
          "name": "projectId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "description": "The unique ID of the project."
          }
        }
      ],
      "get": {
        "summary": "List all CORS entries",
        "description": "Returns a list of all CORS origins for a specific project.",
        "operationId": "listCORSEntries",
        "responses": {
          "200": {
            "description": "A list of CORS entries.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CORSEntry"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a CORS entry",
        "description": "Adds a new CORS origin for a project.",
        "operationId": "createCORSEntry",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CORSEntryCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "CORS entry created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CORSEntry"
                }
              }
            }
          },
          "400": {
            "description": "The origin is invalid, for example because it includes a path. Setting `origin` to `*` with `allowCredentials: true` fails with `A blanket wildcard origin \"*\" cannot allow credentials. Set allowCredentials to false, or use a specific origin.`\n"
          },
          "409": {
            "description": "The origin already exists for the project. The request fails with `Duplicate origin already exists for this project`.\n"
          }
        }
      }
    },
    "/projects/{projectId}/cors/{id}": {
      "parameters": [
        {
          "name": "projectId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "description": "The unique ID of the project."
          }
        },
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "description": "The unique ID of the CORS entry."
          }
        }
      ],
      "delete": {
        "summary": "Delete a CORS entry",
        "operationId": "deleteCORSEntry",
        "description": "Deletes a specific CORS origin for a project.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer"
                    },
                    "deleted": {
                      "type": "boolean",
                      "example": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/projects/{projectId}/datasets": {
      "get": {
        "summary": "List all datasets available to the project",
        "description": "Returns a list of all datasets for the project.",
        "operationId": "listDatasets",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "includeStats",
            "in": "query",
            "required": false,
            "description": "Include statistics for each dataset in a `stats` field. Any value turns this on, including `false`, so omit the parameter to leave statistics out.\n",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "datasetProfile",
            "in": "query",
            "required": false,
            "description": "Only return datasets with this dataset profile.",
            "schema": {
              "type": "string",
              "enum": [
                "content",
                "comments",
                "lastSeenInStudio",
                "connection"
              ]
            }
          },
          {
            "name": "addonFor",
            "in": "query",
            "required": false,
            "description": "Only return add-on datasets for the dataset with this name. If no dataset has this name, the request fails with `Dataset \"<name>\" not found`.\n",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Dataset"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/projects/{projectId}/datasets/{name}": {
      "parameters": [
        {
          "name": "projectId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "name",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "delete": {
        "summary": "Delete a dataset",
        "description": "Deletes a specific dataset by name.",
        "operationId": "deleteDataset",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "deleted": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Create a dataset",
        "description": "Creates a new dataset in the project.",
        "operationId": "createDataset",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "aclMode": {
                    "type": "string",
                    "enum": [
                      "public",
                      "private",
                      "custom"
                    ],
                    "default": "public",
                    "description": "The ACL mode to set for the new dataset. Defaults to public.\nSetting `private` requires the private datasets feature, and `custom` requires the third-party login feature. Otherwise, the request fails with `ACL mode \"<mode>\" not allowed for this project`.\n",
                    "example": "public"
                  },
                  "description": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "A description of the dataset.\n"
                  },
                  "embeddings": {
                    "description": "The settings for the embeddings index for the dataset.\n",
                    "type": "object",
                    "required": [
                      "enabled"
                    ],
                    "properties": {
                      "enabled": {
                        "type": "boolean",
                        "description": "Whether the embeddings index is enabled for the dataset. Required when you include `embeddings`.\n"
                      },
                      "projection": {
                        "type": "string",
                        "maxLength": 5000,
                        "description": "The GROQ projection that defines which fields to include in the embeddings index.\nIf you don't include a projection, we process the entire document JSON into a less verbose format and embed all of it.\nExample: \"{title, author}\" or \"{...}\" for all fields\n",
                        "example": "{title, author}"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "datasetName": {
                      "type": "string"
                    },
                    "aclMode": {
                      "type": "string"
                    },
                    "description": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "datasetProfile": {
                      "type": "string",
                      "description": "Only returned on API version v2023-11-13 or later."
                    },
                    "addonFor": {
                      "type": "string",
                      "description": "Only returned on API version v2023-11-13 or later."
                    },
                    "features": {
                      "type": "array",
                      "description": "Only returned on API version v2023-11-13 or later.",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "The request is invalid. For example, including `embeddings` when embeddings aren't available for your organization fails with `Dataset embeddings are not available for this organization`.\n"
          }
        }
      },
      "patch": {
        "summary": "Update a dataset",
        "description": "Updates a specific dataset in the project.",
        "operationId": "updateDataset",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "aclMode": {
                    "type": "string",
                    "enum": [
                      "public",
                      "private",
                      "custom"
                    ],
                    "description": "The ACL mode to set for the dataset. Omit to keep the current mode.\nSetting `private` requires the private datasets feature, and `custom` requires the third-party login feature. Otherwise, the request fails with `ACL mode \"<mode>\" not allowed for this project`.\n",
                    "example": "public"
                  },
                  "description": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "A description of the dataset. Set to `null` to clear it.\n"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "datasetName": {
                      "type": "string"
                    },
                    "aclMode": {
                      "type": "string"
                    },
                    "description": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/projects/{projectId}/datasets/{name}/copy": {
      "put": {
        "summary": "Copy a dataset",
        "description": "Copies a dataset to a new dataset.\nThis feature is part of Advanced Dataset Management, available on the Enterprise plan. Without it, the request fails with `Your current plan does not include the advanced dataset management feature`.\n",
        "operationId": "copyDataset",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "description": "The unique ID of the project.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "path",
            "required": true,
            "description": "The name of the dataset to copy.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "targetDataset"
                ],
                "properties": {
                  "targetDataset": {
                    "type": "string",
                    "description": "The name of the new dataset to create.\n"
                  },
                  "skipHistory": {
                    "type": "boolean",
                    "default": false,
                    "description": "If true, revision history is not copied, which will usually result in a much faster copy.\nIf false or omitted, revision history is copied to targetDataset.\n"
                  },
                  "skipContentReleases": {
                    "type": "boolean",
                    "default": false,
                    "description": "If true, content release documents are not copied to targetDataset.\n"
                  },
                  "aclMode": {
                    "type": "string",
                    "deprecated": true,
                    "description": "Deprecated. The API accepts this field for backward compatibility but ignores it.\n"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "datasetName": {
                      "type": "string",
                      "description": "The name of the source dataset.",
                      "example": "production"
                    },
                    "message": {
                      "type": "string",
                      "example": "Starting copying dataset production to production-copy..."
                    },
                    "aclMode": {
                      "type": "string",
                      "description": "The ACL mode of the source dataset.",
                      "example": "public"
                    },
                    "jobId": {
                      "type": "string",
                      "description": "The ID of the copy job. Use it with the Jobs API to check the status of the copy."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/projects/{projectId}/datasets/copy": {
      "get": {
        "summary": "List copy jobs history",
        "description": "Lists the dataset copy jobs for the project.\n",
        "operationId": "listCopyJobsHistory",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "description": "The unique ID of the project.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "Start position in list.",
            "schema": {
              "type": "integer",
              "default": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Number of items to return.",
            "schema": {
              "type": "integer",
              "default": 10,
              "minimum": 1,
              "maximum": 1000
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "description": "Comma separated list of job states.",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "pending",
                  "running",
                  "completed",
                  "terminating",
                  "terminated",
                  "failed"
                ]
              },
              "default": []
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "example": "123456"
                      },
                      "state": {
                        "type": "string",
                        "example": "pending"
                      },
                      "createdAt": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2021-01-01T00:00:00Z"
                      },
                      "updatedAt": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2021-01-01T00:00:00Z"
                      },
                      "sourceDataset": {
                        "type": "string",
                        "example": "my-dataset"
                      },
                      "targetDataset": {
                        "type": "string",
                        "example": "my-dataset-copy"
                      },
                      "withHistory": {
                        "type": "boolean",
                        "description": "Whether the copy included document history."
                      },
                      "authors": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "example": "user_123"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/projects/{projectId}/features": {
      "get": {
        "summary": "List active features for the project",
        "description": "Returns a list of active features for the project.",
        "operationId": "listFeatures",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "description": "The unique ID of the project.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "example": "privateDataset"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/projects/{projectId}/permissions": {
      "get": {
        "summary": "List your permissions for the project",
        "description": "Returns the legacy permissions for your project role, such as `manageProject` or `readAll`.\nThe list is based on the original fixed project roles (Administrator, Write, and Read), not on the current roles system, so it doesn't reflect everything your role allows. Members with other roles, such as Developer, Contributor, or custom roles, and organization members without project membership, get an empty array.\n",
        "operationId": "listPermissions",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "description": "The unique ID of the project.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "example": [
                    "manageProject",
                    "manageUsers",
                    "manageCors",
                    "readAll"
                  ],
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/projects/{projectId}/users/{userId}": {
      "get": {
        "summary": "Retrieve a user",
        "description": "Returns a list of details for the user.\n",
        "operationId": "retrieveUser",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "description": "The unique ID of the project.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "description": "The project user ID, which starts with `p`. Global user IDs, which start with `g`, are rejected.\nTo fetch several users, pass a comma-separated list of IDs. The response is then an array.\n",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "sanityUserId": {
                      "type": "string"
                    },
                    "projectId": {
                      "type": "string"
                    },
                    "displayName": {
                      "type": "string"
                    },
                    "familyName": {
                      "type": "string"
                    },
                    "givenName": {
                      "type": "string"
                    },
                    "middleName": {
                      "type": "string"
                    },
                    "imageUrl": {
                      "type": "string"
                    },
                    "email": {
                      "type": "string"
                    },
                    "createdAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "updatedAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/projects/{projectId}/tokens": {
      "get": {
        "summary": "List tokens for the project",
        "description": "Returns a list of tokens for the project.\n\nThis endpoint does not reveal the actual token, only details about the token.\n",
        "operationId": "listTokens",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "description": "The unique ID of the project.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "label": {
                        "type": "string"
                      },
                      "projectUserId": {
                        "type": "string"
                      },
                      "createdAt": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "roles": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "name": {
                              "type": "string"
                            },
                            "title": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a new token for the project",
        "description": "Creates a new token for the project.\nTo manage tokens with the newer Access API, see the [Access API reference](https://www.sanity.io/docs/http-reference/access-api).\n",
        "operationId": "createToken",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "description": "The unique ID of the project.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sendNotification",
            "in": "query",
            "required": false,
            "description": "Whether to email the project's administrators about the new token. You can only set it to false within five minutes of creating the project. Otherwise, the request fails with `Cannot skip token notification`.\n",
            "schema": {
              "type": "boolean",
              "default": true
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "label"
                ],
                "oneOf": [
                  {
                    "required": [
                      "roleName"
                    ]
                  },
                  {
                    "required": [
                      "roleNames"
                    ]
                  }
                ],
                "properties": {
                  "label": {
                    "type": "string",
                    "description": "A descriptive label for your token. This can help you identify it later so you know where it's being used.\nThe label must be unique within the project.\n"
                  },
                  "roleName": {
                    "type": "string",
                    "description": "The permissions to assign your token. These will vary by plan. On a Free plan, roleName must be viewer, editor, or deploy-studio.\nProvide either roleName or roleNames.\n"
                  },
                  "roleNames": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    },
                    "description": "The names of the roles to assign your token. Provide either roleName or roleNames.\n"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "key": {
                      "type": "string"
                    },
                    "projectUserId": {
                      "type": "string"
                    },
                    "roles": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "title": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "A role can't be assigned to tokens, such as `administrator`. The request fails with `Role \"<title>\" can't be assigned to robot users`.\n"
          },
          "403": {
            "description": "`sendNotification` is `false` more than five minutes after the project was created. The request fails with `Cannot skip token notification`.\n"
          },
          "404": {
            "description": "A role doesn't exist in the project. The request fails with `Role \"<name>\" not found`.\n"
          },
          "409": {
            "description": "A token with the same label already exists in the project. The request fails with `Token with same label already exists`.\n"
          }
        }
      }
    },
    "/projects/{projectId}/tokens/{tokenId}": {
      "delete": {
        "summary": "Delete a token for the project",
        "description": "Deletes a token for the project.\n",
        "operationId": "deleteToken",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "description": "The unique ID of the project.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tokenId",
            "in": "path",
            "required": true,
            "description": "The unique ID of the token.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "deleted": {
                      "type": "boolean"
                    },
                    "id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/projects/{projectId}/datasets/{name}/tags": {
      "get": {
        "description": "Returns a list of tags for the dataset.\n",
        "operationId": "listTags",
        "summary": "List tags for a dataset",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "description": "The unique ID of the project.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "path",
            "required": true,
            "description": "The name of the dataset.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "title": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/projects/{projectId}/tags": {
      "get": {
        "summary": "List tags for the project",
        "operationId": "listProjectTags",
        "description": "Returns a list of tags for the project.\nEach tag's `datasets` list is empty unless you have read access to the project's datasets.\n",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "description": "The unique ID of the project.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Tag"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a new tag for the project",
        "operationId": "createTag",
        "description": "Creates a new tag for the project.\nDatasets cannot be assigned at tag creation. To assign a tag to a dataset, use `PUT /projects/{projectId}/datasets/{datasetName}/tags/{tagIdentifier}`.\nRequires a project plan that includes advanced roles management.\n",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "description": "The unique ID of the project.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTag"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Tag"
                }
              }
            }
          }
        }
      }
    },
    "/projects/{projectId}/tags/{tagIdentifier}": {
      "get": {
        "summary": "Retrieve a tag",
        "operationId": "retrieveTag",
        "description": "Returns a tag by name.\nThe `datasets` list is empty unless you have read access to the project's datasets.\n",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "description": "The unique ID of the project.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tagIdentifier",
            "in": "path",
            "required": true,
            "description": "The name of the tag.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Tag"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Update a tag by identifier",
        "description": "Updates a tag by identifier.\nYou can update the title, description, and metadata. A tag can't be renamed: sending a different `name` fails with a 400 error.\nRequires a project plan that includes advanced roles management.\n",
        "operationId": "updateTag",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "description": "The unique ID of the project.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tagIdentifier",
            "in": "path",
            "required": true,
            "description": "The name of the tag.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateTag"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Tag"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete a tag by identifier",
        "description": "Deletes a tag by identifier.\nThe tag must not be assigned to any datasets. Otherwise, the request fails with a 422 error: `Tag is applied to a dataset`.\nRequires a project plan that includes advanced roles management.\n",
        "operationId": "deleteTag",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "description": "The unique ID of the project.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tagIdentifier",
            "in": "path",
            "required": true,
            "description": "The name of the tag.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "deleted": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "The tag is assigned to one or more datasets. Remove it from them first.\n"
          }
        }
      }
    },
    "/projects/{projectId}/datasets/{datasetName}/tags/{tagIdentifier}": {
      "put": {
        "description": "Assigns a tag to a dataset.\nRequires a project plan that includes advanced roles management.\n",
        "summary": "Assign a tag to a dataset",
        "operationId": "assignTagToDataset",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "description": "The unique ID of the project.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "datasetName",
            "in": "path",
            "required": true,
            "description": "The name of the dataset.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tagIdentifier",
            "in": "path",
            "required": true,
            "description": "The name of the tag.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "OK"
          }
        }
      },
      "delete": {
        "summary": "Remove a tag from a dataset",
        "description": "Removes a tag from a dataset.\nRequires a project plan that includes advanced roles management.\n",
        "operationId": "removeTagFromDataset",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "description": "The unique ID of the project.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "datasetName",
            "in": "path",
            "required": true,
            "description": "The name of the dataset.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tagIdentifier",
            "in": "path",
            "required": true,
            "description": "The name of the tag.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "deleted": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/projects/{projectId}/datasets/{name}/settings/embeddings": {
      "parameters": [
        {
          "name": "projectId",
          "in": "path",
          "required": true,
          "description": "The unique ID of the project.",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "name",
          "in": "path",
          "required": true,
          "description": "The name of the dataset.",
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "description": "Returns the settings for the embeddings index for a dataset.\n",
        "summary": "Get embeddings index settings for a dataset",
        "operationId": "getEmbeddingsIndexSettings",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmbeddingsSettingsResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "description": "Updates the settings for the embeddings index for a dataset.\n",
        "summary": "Update embeddings index settings for a dataset",
        "operationId": "updateEmbeddingsIndexSettings",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "enabled"
                ],
                "properties": {
                  "enabled": {
                    "type": "boolean",
                    "description": "Whether to enable the embeddings index for the dataset."
                  },
                  "projection": {
                    "type": "string",
                    "maxLength": 5000,
                    "description": "The GROQ projection that defines which fields to include in the embeddings index.\nIf you don't include a projection, we process the entire document JSON into a less verbose format and embed all of it.\nExample: \"{title, author}\" or \"{...}\" for all fields\n",
                    "example": "{title, author}"
                  }
                }
              },
              "examples": {
                "enableEmbeddings": {
                  "summary": "Enable embeddings index for a dataset",
                  "description": "Enables the embeddings index for a dataset.\n",
                  "value": {
                    "enabled": true,
                    "projection": "{title, author}"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The change was applied synchronously, for example when disabling embeddings. Returns an empty object.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "202": {
            "description": "The change is being applied in the background, for example when enabling embeddings. Returns an empty object. Check progress with the GET endpoint.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Enabling embeddings fails with `Enabling embeddings on existing datasets is coming soon. To try embeddings today, create a new dataset with embeddings enabled.` when embeddings aren't available for the dataset. This applies to some datasets created before March 1, 2026, and to datasets in organizations where embeddings aren't enabled.\n"
          },
          "409": {
            "description": "Another embeddings update is still running for the dataset. The request fails with `An embeddings update is already in progress for this dataset`.\n"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Project": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "studioHost": {
            "type": [
              "string",
              "null"
            ],
            "deprecated": true,
            "description": "This field is deprecated. Use the /user-applications API instead."
          },
          "organizationId": {
            "type": [
              "string",
              "null"
            ]
          },
          "metadata": {
            "type": "object",
            "properties": {
              "color": {
                "type": "string"
              }
            }
          },
          "isBlocked": {
            "type": "boolean"
          },
          "isDisabled": {
            "type": "boolean"
          },
          "isDisabledByUser": {
            "type": "boolean"
          },
          "activityFeedEnabled": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "members": {
            "type": "array",
            "description": "Only included when `includeMembers` is `true`.",
            "items": {
              "$ref": "#/components/schemas/ProjectMember"
            }
          },
          "features": {
            "type": "array",
            "description": "Only included when `includeFeatures` is `true`.",
            "items": {
              "type": "string"
            }
          },
          "organization": {
            "type": "object",
            "description": "The project's organization. Only included when retrieving a single project with `includeOrganization` set to `true`."
          }
        }
      },
      "CreateTag": {
        "type": "object",
        "required": [
          "name",
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "description": "The title of the tag.\n"
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][-\\w]{1,20}$",
            "description": "The name of the tag. It starts with a lowercase letter or digit, followed by 1 to 20 letters, digits, hyphens, or underscores. You can't rename a tag after you create it.\n"
          },
          "description": {
            "type": "string",
            "description": "The description of the tag.\n"
          },
          "metadata": {
            "type": "object",
            "description": "A set of additional configuration options\n",
            "properties": {
              "tone": {
                "type": "string",
                "enum": [
                  "default",
                  "primary",
                  "positive",
                  "caution",
                  "critical",
                  "transparent"
                ],
                "description": "The color of your tag.\n"
              }
            }
          }
        }
      },
      "Tag": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "metadata": {
            "type": "object",
            "properties": {
              "tone": {
                "type": "string",
                "enum": [
                  "default",
                  "primary",
                  "positive",
                  "caution",
                  "critical",
                  "transparent"
                ]
              }
            }
          },
          "datasets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "aclMode": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "UpdateTag": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "The title of the tag.\n"
          },
          "description": {
            "type": "string",
            "description": "The description of the tag.\n"
          },
          "metadata": {
            "type": "object",
            "description": "A set of additional configuration options\n",
            "properties": {
              "tone": {
                "type": "string",
                "enum": [
                  "default",
                  "primary",
                  "positive",
                  "caution",
                  "critical",
                  "transparent"
                ],
                "description": "The color of your tag.\n"
              }
            }
          }
        }
      },
      "ProjectCreate": {
        "type": "object",
        "required": [
          "displayName"
        ],
        "properties": {
          "displayName": {
            "type": "string",
            "maxLength": 80,
            "example": "My Project",
            "description": "The display name of the project.\n"
          },
          "organizationId": {
            "type": "string",
            "example": "oAbC123xyz",
            "description": "Assign the created project to the specified organization. The organization to which organizationId belongs must already exist and you must have sufficient permissions to assign a project to the organization. If omitted, a new organization is created for you and the project is assigned to it.\n"
          },
          "id": {
            "type": "string",
            "minLength": 5,
            "maxLength": 16,
            "example": "wefsadfj",
            "description": "A preferred ID for the project, 5 to 16 characters. It is converted to lowercase.\n"
          },
          "metadata": {
            "type": "object",
            "properties": {
              "color": {
                "type": "string",
                "example": "#000000"
              },
              "externalStudioHost": {
                "type": "string",
                "deprecated": true,
                "description": "This field is deprecated. Use the /user-applications API instead.",
                "example": "https://my-project.my-domain.com"
              }
            }
          },
          "studioHost": {
            "type": "string",
            "deprecated": true,
            "description": "This field is deprecated. Use the /user-applications API instead."
          },
          "createDefaultCorsOrigin": {
            "type": "boolean",
            "default": true,
            "description": "Whether to create a default localhost CORS origin for the project.\n  \n"
          }
        }
      },
      "ProjectUpdate": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string"
          },
          "studioHost": {
            "type": "string",
            "deprecated": true,
            "description": "Your studio hostname for deployment on Sanity's hosted service: https://<hostname>.sanity.studio/.\nThis field is deprecated. Use the /user-applications API instead.\n",
            "example": "my-project"
          },
          "metadata": {
            "type": "object",
            "properties": {
              "color": {
                "type": "string",
                "description": "The color of the project.\n",
                "example": "#000000"
              },
              "externalStudioHost": {
                "type": "string",
                "deprecated": true,
                "description": "The external studio hostname for deployment on a custom domain.\nThis field is deprecated. Use the /user-applications API instead.\n",
                "example": "https://my-project.my-domain.com"
              }
            }
          },
          "isDisabledByUser": {
            "type": "boolean"
          },
          "activityFeedEnabled": {
            "type": "boolean"
          }
        }
      },
      "ProjectMember": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "deprecated": true,
            "description": "The member's legacy role. Only returned in the create project response and on API versions before v2021-06-07. Use `roles` instead.\n",
            "example": "administrator"
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Role"
            }
          },
          "isCurrentUser": {
            "type": "boolean",
            "description": "Whether this member is you. Not included in the create project response."
          },
          "isRobot": {
            "type": "boolean",
            "description": "Whether this member is a token rather than a person. Not included in the create project response."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Role": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "CORSEntry": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "origin": {
            "type": "string"
          },
          "allowCredentials": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CORSEntryCreate": {
        "type": "object",
        "required": [
          "origin"
        ],
        "properties": {
          "origin": {
            "type": "string",
            "description": "The origin to allow, including the protocol. It can't include a path. Use `*` to allow all origins.\n",
            "example": "https://www.example.com"
          },
          "allowCredentials": {
            "type": "boolean",
            "default": false,
            "description": "Whether to allow authenticated requests from this origin. Can't be `true` when `origin` is `*`.\n"
          }
        }
      },
      "Dataset": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "aclMode": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "description": "Only included when the dataset has a description."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdByUserId": {
            "type": "string"
          },
          "addonFor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Only returned on API version v2023-11-13 or later."
          },
          "datasetProfile": {
            "type": "string",
            "description": "Only returned on API version v2023-11-13 or later."
          },
          "features": {
            "type": "array",
            "description": "Only returned on API version v2023-11-13 or later.",
            "items": {
              "type": "string"
            }
          },
          "stats": {
            "type": "object",
            "description": "Dataset statistics. Only included when you set `includeStats`."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                }
              }
            }
          },
          "embeddings": {
            "type": "object",
            "description": "Only included when embeddings are configured.",
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "projection": {
                "type": "string"
              }
            }
          }
        }
      },
      "EmbeddingsSettingsResponse": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "projection": {
            "type": "string",
            "description": "The GROQ projection that defines which fields to include in the embeddings index.\nIf you don't include a projection, we process the entire document JSON into a less verbose format and embed all of it.\nExample: \"{title, author}\" or \"{...}\" for all fields\n",
            "example": "{title, author}"
          },
          "status": {
            "description": "The status of the embeddings index. `disabled` when embeddings are off, `unknown` when the status couldn't be fetched, and otherwise `ready`, `updating`, or `error`.\n",
            "type": "string",
            "example": "updating",
            "enum": [
              "ready",
              "updating",
              "error",
              "disabled",
              "unknown"
            ]
          }
        }
      }
    }
  }
}