{
  "openapi": "3.1.1",
  "info": {
    "title": "Live HTTP Endpoint",
    "version": "2025-02-19",
    "description": "The sync tag invalidation API that underlies the Live Content API\n"
  },
  "servers": [
    {
      "url": "https://{projectId}.api.sanity.io/{apiVersion}",
      "description": "Sanity API base URL. The API CDN (`apicdn.sanity.io`) does not serve this endpoint.",
      "variables": {
        "projectId": {
          "default": "projectId",
          "description": "Project ID"
        },
        "apiVersion": {
          "default": "v2025-02-19",
          "description": "API version. The minimum is v2021-03-25."
        }
      }
    }
  ],
  "security": [
    {},
    {
      "BearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "SSEMessage": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The position in the stream"
          },
          "event": {
            "type": "string",
            "enum": [
              "welcome",
              "restart",
              "message",
              "error",
              "goaway"
            ],
            "description": "The type of SSE message"
          },
          "data": {
            "type": "object",
            "description": "The message payload"
          }
        }
      }
    }
  },
  "paths": {
    "/data/live/events/{dataset}": {
      "get": {
        "summary": "Stream sync tag invalidation events",
        "description": "Streams sync tags on published documents as they become invalid. This is a live API adhering to the Server-Sent Events standard.\nThe same stream is also available at `https://api.sanity.io/{apiVersion}/projects/{projectId}/datasets/{dataset}/live/events`.\n",
        "parameters": [
          {
            "name": "dataset",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The dataset to stream events from. The dataset name is not validated. A dataset that doesn't exist returns a `welcome` event and then no further events."
          },
          {
            "name": "includeAllDocuments",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Set to `true` to include version, draft, and system document changes. Only the exact value `true` enables this. Requests made with this parameter require a valid API token. Use a token with the lowest access role you can, such as Viewer."
          },
          {
            "name": "includeDrafts",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Equivalent to `includeAllDocuments`. This is the parameter `@sanity/client` sends when you call `client.live.events({includeDrafts: true})`. The API also accepts `includeAllVersions=true` with the same effect."
          },
          {
            "name": "waitFor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "function"
              ]
            },
            "description": "Set to `function` to delay events until a configured [Sync Tag Invalidate Function](https://www.sanity.io/docs/functions/sync-tag-function-quickstart) has processed them. Ignored when `includeAllDocuments` or `includeDrafts` is `true`."
          },
          {
            "name": "last-event-id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "An optional start event ID (\"position\").\nIf provided, it must be a previously returned event ID. The stream will continue with the next event following this position.\nIf not given, the stream starts at the end. Only new tags are returned.\nIf the ID is not usable, the stream sends a `restart` event and starts at the end. A malformed ID gets the `restart` event as its first message. A valid ID that is older than the stream's retention gets a `welcome` event first, followed by `restart`.\n"
          },
          {
            "name": "lastEventId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Query parameter alternative to the `last-event-id` header, used when the header is not set. Some EventSource polyfills use it because a custom header triggers a CORS preflight request."
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully started streaming operation.\nThe examples show events as an EventSource client parses them. On the wire, tag messages have no `event:` line and arrive as the default `message` type, and `welcome` and `restart` events carry `data: {}`.\nTags are batched over a window of about one second, with up to 1,000 tags in a single message.\nWhen no other events are sent, the server sends an empty comment line (`: `) as a keep-alive about every 30 seconds.\nA `goaway` event is sent in place of `welcome` when the connection is refused, and the server then closes the connection. Its `data.reason` is either `connection limit reached` or `server shutting down`. A stream that is already open closes without an event when the server shuts down.\n",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/SSEMessage"
                },
                "examples": {
                  "welcome": {
                    "value": {
                      "id": "MXxhYVlRejdGZUpPMA",
                      "event": "welcome"
                    }
                  },
                  "restart": {
                    "value": {
                      "id": "MXxhYVlRejdGZUpPMA",
                      "event": "restart"
                    }
                  },
                  "tags": {
                    "value": {
                      "id": "MXxhYVlRejdGZUpPMA",
                      "event": "message",
                      "data": {
                        "tags": [
                          "tag1",
                          "tag2"
                        ]
                      }
                    }
                  },
                  "error": {
                    "value": {
                      "event": "error",
                      "data": {
                        "status": 500,
                        "message": "Stream ended unexpectedly"
                      }
                    }
                  },
                  "goaway": {
                    "value": {
                      "id": "MXxhYVlRejdGZUpPMA",
                      "event": "goaway",
                      "data": {
                        "reason": "connection limit reached"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "The API version is earlier than v2021-03-25.",
            "content": {
              "application/json": {
                "example": {
                  "message": "This API is not available for this version"
                }
              }
            }
          },
          "401": {
            "description": "The request sent an invalid API token, or set `includeAllDocuments` or `includeDrafts` to `true` without an API token.\nAn invalid token is rejected on every request, including requests for published content only.\n",
            "content": {
              "application/json": {
                "examples": {
                  "missingToken": {
                    "summary": "includeAllDocuments without a token",
                    "value": {
                      "message": "Unauthorized"
                    }
                  },
                  "invalidToken": {
                    "summary": "Invalid or expired token",
                    "value": {
                      "message": "Session not found",
                      "error": "Unauthorized",
                      "errorCode": "SIO-401-ANF",
                      "statusCode": 401
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "The request came from a browser origin that isn't in the project's CORS origins.",
            "content": {
              "application/json": {
                "example": {
                  "error": "Forbidden",
                  "message": "CORS Origin not allowed",
                  "statusCode": 403
                }
              }
            }
          },
          "404": {
            "description": "The request was sent to the API CDN (`apicdn.sanity.io`) instead of the API.",
            "content": {
              "application/json": {
                "example": {
                  "message": "Streaming sync tag invalidation events only supported via API, not APICDN"
                }
              }
            }
          },
          "406": {
            "description": "The Accept header doesn't allow text/event-stream. Requests without an Accept header are accepted.",
            "content": {
              "application/json": {
                "example": {
                  "message": "Unsupported content type"
                }
              }
            }
          },
          "500": {
            "description": "The server failed to start the stream.",
            "content": {
              "application/json": {
                "example": {
                  "message": "Internal error"
                }
              }
            }
          }
        }
      }
    }
  }
}