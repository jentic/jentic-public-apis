{
  "info": {
    "title": "Functions API",
    "version": "X",
    "x-jentic-source-url": "https://www.sanity.io/docs/api/openapi/functions-api?format=json"
  },
  "openapi": "3.0.0",
  "servers": [
    {
      "description": "Production External API",
      "url": "https://api.sanity.io"
    }
  ],
  "components": {
    "securitySchemes": {
      "Bearer": {
        "description": "Sanity API session token",
        "scheme": "bearer",
        "type": "http"
      }
    },
    "schemas": {
      "Function": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/SyncTagInvalidateFunction"
          },
          {
            "$ref": "#/components/schemas/DocumentFunction"
          },
          {
            "$ref": "#/components/schemas/MediaFunction"
          },
          {
            "$ref": "#/components/schemas/ScheduleFunction"
          },
          {
            "$ref": "#/components/schemas/QueueFunction"
          },
          {
            "$ref": "#/components/schemas/PubSubFunction"
          },
          {
            "$ref": "#/components/schemas/DurableFunction"
          }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "sanity.function.sync-tag-invalidate": "#/components/schemas/SyncTagInvalidateFunction",
            "sanity.function.document": "#/components/schemas/DocumentFunction",
            "sanity.function.media-library.asset": "#/components/schemas/MediaFunction",
            "sanity.function.cron": "#/components/schemas/ScheduleFunction",
            "sanity.function.queue": "#/components/schemas/QueueFunction",
            "sanity.function.pubsub": "#/components/schemas/PubSubFunction",
            "sanity.function.durable": "#/components/schemas/DurableFunction"
          }
        }
      },
      "SyncTagInvalidateFunction": {
        "type": "object",
        "properties": {
          "deletedAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time",
            "description": "Date resource was deleted",
            "example": "2021-07-01T12:00:00.000Z"
          },
          "displayName": {
            "type": "string",
            "nullable": true,
            "minLength": 3,
            "description": "The human-readable name of the function",
            "example": "Log Sweeper"
          },
          "id": {
            "type": "string",
            "minLength": 10,
            "description": "The ID of the resource",
            "example": "abcd123456"
          },
          "memory": {
            "type": "number",
            "minimum": 128,
            "maximum": 10240,
            "default": 1024,
            "description": "Memory allocated to function",
            "example": 256
          },
          "name": {
            "type": "string",
            "nullable": true,
            "minLength": 3,
            "description": "The unique name of the blueprint resource",
            "example": "log-sweeper"
          },
          "resourceId": {
            "type": "string",
            "nullable": true,
            "minLength": 8,
            "description": "Resource ID",
            "example": "24s6f8sr"
          },
          "resourceType": {
            "type": "string",
            "nullable": true,
            "enum": [
              "project",
              "organization",
              null
            ],
            "description": "Type of resource (i.e. project or organization)",
            "example": "project"
          },
          "robotId": {
            "type": "string",
            "nullable": true,
            "minLength": 7,
            "description": "Robot Token ID",
            "example": "g-qS7j8qb0uvL4",
            "externalDocs": {
              "description": "Sanity Access API - Robots",
              "url": "https://www.sanity.io/docs/reference/http/access#tag/robots"
            }
          },
          "runtime": {
            "type": "string",
            "enum": [
              "node",
              "nodejs22.x",
              "nodejs24.x"
            ],
            "default": "nodejs24.x",
            "description": "Runtime for function",
            "example": "nodejs24.x"
          },
          "status": {
            "type": "string",
            "enum": [
              "unassigned",
              "assigned",
              "pending-create",
              "pending-update",
              "failed-create",
              "failed-update",
              "failed-delete",
              "deleted",
              "disabled"
            ],
            "description": "State of function",
            "example": "assigned"
          },
          "storage": {
            "type": "number",
            "minimum": 512,
            "maximum": 10240,
            "default": 512,
            "description": "Ephemeral storage allocated to function in MB",
            "example": 512
          },
          "timeout": {
            "type": "number",
            "minimum": 1,
            "maximum": 900,
            "default": 10,
            "description": "Timeout for function in seconds",
            "example": 60
          },
          "type": {
            "type": "string",
            "enum": [
              "sanity.function.sync-tag-invalidate"
            ]
          },
          "url": {
            "type": "string",
            "nullable": true,
            "description": "Function invocation URL",
            "example": "https://my-function-123456-uc.a.run.app"
          },
          "contentSub": {
            "anyOf": [
              {
                "type": "object",
                "properties": {},
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "createdAt": {
                    "type": "string"
                  },
                  "destination": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "functions"
                        ]
                      }
                    },
                    "default": {
                      "type": "functions"
                    },
                    "required": [
                      "type"
                    ]
                  },
                  "disabled": {
                    "type": "boolean",
                    "default": false
                  },
                  "event": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "apiVersion": {
                            "type": "string"
                          },
                          "filter": {
                            "type": "string"
                          },
                          "on": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "enum": [
                                "create",
                                "update",
                                "delete"
                              ]
                            },
                            "minItems": 1
                          },
                          "projection": {
                            "type": "string"
                          },
                          "type": {
                            "type": "string",
                            "enum": [
                              "documentChange"
                            ]
                          }
                        },
                        "required": [
                          "on",
                          "type"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "enum": [
                              "syncTagInvalidate"
                            ]
                          }
                        },
                        "required": [
                          "type"
                        ]
                      }
                    ]
                  },
                  "filter": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "projectId": {
                            "type": "string"
                          },
                          "resourceType": {
                            "type": "string",
                            "enum": [
                              "dataset"
                            ]
                          }
                        },
                        "required": [
                          "projectId",
                          "resourceType"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "resourceId": {
                            "type": "string"
                          },
                          "resourceType": {
                            "type": "string",
                            "enum": [
                              "dataset"
                            ]
                          }
                        },
                        "required": [
                          "resourceId",
                          "resourceType"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "resourceId": {
                            "type": "string"
                          },
                          "resourceType": {
                            "type": "string",
                            "enum": [
                              "media-library"
                            ]
                          }
                        },
                        "required": [
                          "resourceId",
                          "resourceType"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "resourceId": {
                            "type": "string"
                          },
                          "resourceType": {
                            "type": "string",
                            "enum": [
                              "canvas"
                            ]
                          }
                        },
                        "required": [
                          "resourceId",
                          "resourceType"
                        ]
                      }
                    ]
                  },
                  "id": {
                    "type": "string"
                  },
                  "updatedAt": {
                    "type": "string"
                  }
                },
                "required": [
                  "event",
                  "filter",
                  "id"
                ]
              }
            ],
            "default": {}
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Date resource was created",
            "example": "2021-07-01T12:00:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Date resource was last updated",
            "example": "2021-07-01T12:00:00.000Z"
          }
        },
        "required": [
          "deletedAt",
          "displayName",
          "id",
          "memory",
          "name",
          "resourceId",
          "resourceType",
          "robotId",
          "runtime",
          "status",
          "storage",
          "timeout",
          "type",
          "url",
          "createdAt",
          "updatedAt"
        ]
      },
