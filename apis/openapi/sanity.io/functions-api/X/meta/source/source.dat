                            "type": "string"
                          },
                          "resourceType": {
                            "type": "string",
                            "enum": [
                              "canvas"
                            ]
                          }
                        },
                        "required": [
                          "resourceId",
                          "resourceType"
                        ]
                      }
                    ]
                  },
                  "id": {
                    "type": "string"
                  },
                  "updatedAt": {
                    "type": "string"
                  }
                },
                "required": [
                  "event",
                  "filter",
                  "id"
                ]
              }
            ],
            "default": {}
          },
          "durableTimeout": {
            "type": "number",
            "nullable": true,
            "minimum": 60,
            "maximum": 31536000,
            "default": 86400,
            "description": "Total Durable function timeout, from start of execution to finish, including sleep time",
            "example": 86400
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Date resource was created",
            "example": "2021-07-01T12:00:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Date resource was last updated",
            "example": "2021-07-01T12:00:00.000Z"
          }
        },
        "required": [
          "deletedAt",
          "displayName",
          "id",
          "memory",
          "name",
          "resourceId",
          "resourceType",
          "robotId",
          "runtime",
          "status",
          "storage",
          "timeout",
          "type",
          "url",
          "createdAt",
          "updatedAt"
        ]
      },
      "FunctionCreateInput": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/DocumentFunctionCreateInput"
          },
          {
            "$ref": "#/components/schemas/MediaFunctionCreateInput"
          }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "sanity.function.document": "#/components/schemas/DocumentFunctionCreateInput",
            "sanity.function.media-library.asset": "#/components/schemas/MediaFunctionCreateInput"
          }
        }
      },
      "DocumentFunctionCreateInput": {
        "type": "object",
        "properties": {
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "default": {},
            "description": "Environment variables for function",
            "example": {
              "key": "value"
            }
          },
          "memory": {
            "type": "number",
            "minimum": 128,
            "maximum": 10240,
            "default": 1024,
            "description": "Memory allocated to function",
            "example": 256
          },
          "runtime": {
            "type": "string",
            "enum": [
              "node",
              "nodejs22.x",
              "nodejs24.x"
            ],
            "default": "nodejs24.x",
            "description": "Runtime for function",
            "example": "nodejs24.x"
          },
          "storage": {
            "type": "number",
            "minimum": 512,
            "maximum": 10240,
            "default": 512,
            "description": "Ephemeral storage allocated to function in MB",
            "example": 512
          },
          "timeout": {
            "type": "number",
            "minimum": 1,
            "maximum": 900,
            "default": 10,
            "description": "Timeout for function in seconds",
            "example": 60
          },
          "displayName": {
            "type": "string",
            "minLength": 3,
            "description": "The human-readable name of the function",
            "example": "Log Sweeper"
          },
          "name": {
            "type": "string",
            "minLength": 3,
            "description": "The unique name of the blueprint resource",
            "example": "log-sweeper"
          },
          "robotToken": {
            "type": "string",
            "minLength": 1,
            "description": "Robot Token supplied by the user",
            "example": "s.RobotsClientToken.abcdefg1234567",
            "externalDocs": {
              "description": "Sanity Access API - Robots",
              "url": "https://www.sanity.io/docs/http-reference/access-api#createRobot"
            }
          },
          "source": {
            "type": "string",
            "description": "Base64 encoded zip file",
            "example": ""
          },
          "project": {
            "type": "string",
            "minLength": 8,
            "description": "Resource ID",
            "example": "24s6f8sr"
          },
          "rule": {
            "type": "object",
            "properties": {
              "filter": {
                "type": "string",
                "default": "",
                "description": "GROQ query filter; only the string contents between the `*[` and `]` portion of the query",
                "example": "_type == 'movie' && releaseYear >= 1979",
                "externalDocs": {
                  "description": "Blueprint Configuration file reference",
                  "url": "https://www.sanity.io/docs/specifications/blueprint-config#k17951eb0347d"
                }
              },
              "includeDrafts": {
                "type": "boolean",
                "default": false,
                "description": "Whether changes to draft documents should trigger an event",
                "example": true,
                "externalDocs": {
                  "description": "Blueprint Configuration file reference",
                  "url": "https://www.sanity.io/docs/specifications/blueprint-config#k17951eb0347d"
                }
              },
              "on": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "publish",
                    "create",
                    "update",
                    "delete"
                  ]
                },
                "minItems": 1,
                "default": [
                  "publish"
                ],
                "description": "Events to trigger function",
                "example": [
                  "publish"
                ],
                "externalDocs": {
                  "description": "Blueprint Configuration file reference",
                  "url": "https://www.sanity.io/docs/specifications/blueprint-config#k17951eb0347d"
                }
              },
              "projection": {
                "type": "string",
                "default": "",
                "description": "GROQ query projection",
                "example": "{title, director}",
                "externalDocs": {
                  "description": "Blueprint Configuration file reference",
                  "url": "https://www.sanity.io/docs/specifications/blueprint-config#k17951eb0347d"
                }
              },
              "includeAllVersions": {
                "type": "boolean",
                "default": false,
                "description": "Whether changes to version documents (part of a Content Release bundle) should trigger an event",
                "example": true,
                "externalDocs": {
                  "description": "Blueprint Configuration file reference",
                  "url": "https://www.sanity.io/docs/specifications/blueprint-config#k17951eb0347d"
                }
              },
              "resource": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "dataset"
                    ]
                  }
                },
                "required": [
                  "id",
                  "type"
                ],
                "description": "Document function event source specifying events from which dataset should trigger functions",
                "externalDocs": {
                  "description": "Blueprint Configuration file reference",
                  "url": "https://www.sanity.io/docs/specifications/blueprint-config#resource-b2b84aa09d00"
                }
              }
            },
            "required": [
              "on"
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "sanity.function.document"
            ]
          }
        },
        "required": [
          "name",
          "source",
          "type"
        ]
      },
