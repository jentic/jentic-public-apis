      "ArcAppUpdateInput": {
        "type": "object",
        "properties": {
          "blueprintResources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BlueprintResource"
            },
            "description": "Array of Blueprint Resources"
          },
          "blueprintStackId": {
            "type": "string",
            "minLength": 10,
            "description": "We need to update the `blueprintStackId` to the new format. Making this optional for now as not to reject updates.",
            "example": "1234567890"
          },
          "currentResources": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ArcAppFunctionUpdateInput"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 3,
                          "description": "The unique name of the blueprint resource",
                          "example": "log-sweeper"
                        }
                      },
                      "required": [
                        "name"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "runtime": {
                          "type": "string",
                          "enum": [
                            "node",
                            "nodejs22.x",
                            "nodejs24.x"
                          ],
                          "default": "nodejs24.x",
                          "description": "Runtime for function",
                          "example": "nodejs24.x"
                        }
                      }
                    }
                  ]
                },
                {
                  "$ref": "#/components/schemas/SyncTagInvalidateFunctionCreateInput"
                },
                {
                  "$ref": "#/components/schemas/DocumentFunctionCreateInput"
                },
                {
                  "$ref": "#/components/schemas/MediaFunctionCreateInput"
                },
                {
                  "$ref": "#/components/schemas/ScheduleFunctionCreateInput"
                },
                {
                  "$ref": "#/components/schemas/QueueFunctionCreateInput"
                },
                {
                  "$ref": "#/components/schemas/PubSubFunctionCreateInput"
                },
                {
                  "$ref": "#/components/schemas/DurableFunctionCreateInput"
                }
              ]
            },
            "minItems": 1,
            "description": "Array of functions currently comprising the arc app; enables rollback during failed deploys if provided"
          },
          "resources": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ArcAppFunctionUpdateInput"
                    },
                    {
