              "node",
              "nodejs22.x",
              "nodejs24.x"
            ]
          }
        },
        "required": [
          "name",
          "type"
        ]
      },
      "DurableFunctionUpdateInput": {
        "type": "object",
        "properties": {
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "default": {},
            "description": "Environment variables for function",
            "example": {
              "key": "value"
            }
          },
          "memory": {
            "type": "number",
            "minimum": 128,
            "maximum": 10240,
            "default": 1024,
            "description": "Memory allocated to function",
            "example": 256
          },
          "storage": {
            "type": "number",
            "minimum": 512,
            "maximum": 10240,
            "default": 512,
            "description": "Ephemeral storage allocated to function in MB",
            "example": 512
          },
          "displayName": {
            "type": "string",
            "minLength": 3,
            "description": "The human-readable name of the function",
            "example": "Log Sweeper"
          },
          "name": {
            "type": "string",
            "minLength": 3,
            "description": "The unique name of the blueprint resource",
            "example": "log-sweeper"
          },
          "robotToken": {
            "type": "string",
            "minLength": 1,
            "description": "Robot Token supplied by the user",
            "example": "s.RobotsClientToken.abcdefg1234567",
            "externalDocs": {
              "description": "Sanity Access API - Robots",
              "url": "https://www.sanity.io/docs/http-reference/access-api#createRobot"
            }
          },
          "source": {
            "type": "string",
            "description": "Base64 encoded zip file",
            "example": ""
          },
          "durableTimeout": {
            "type": "number",
            "minimum": 60,
            "maximum": 31536000,
            "default": 86400,
            "description": "Total Durable function timeout, from start of execution to finish, including sleep time",
            "example": 86400
          },
          "project": {
            "type": "string",
            "minLength": 8,
            "description": "Resource ID",
            "example": "24s6f8sr"
          },
          "rule": {
            "$ref": "#/components/schemas/ContentLakeEventSource"
          },
          "timeout": {
            "type": "number",
            "minimum": 60,
            "maximum": 900,
            "default": 60,
            "description": "Execution timeout for Durable function in seconds; sleep time is not counted",
            "example": 60
          },
          "type": {
            "type": "string",
            "enum": [
              "sanity.function.durable"
            ]
          },
          "runtime": {
            "type": "string",
            "enum": [
              "node",
              "nodejs22.x",
              "nodejs24.x"
            ]
          }
        },
        "required": [
          "type"
        ]
      },
      "ArcAppUpdateInputFile": {
        "type": "object",
        "properties": {
          "blueprintResources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BlueprintResource"
            },
            "description": "Array of Blueprint Resources"
          },
          "blueprintStackId": {
            "type": "string",
            "minLength": 10,
            "description": "We need to update the `blueprintStackId` to the new format. Making this optional for now as not to reject updates.",
            "example": "1234567890"
          },
          "currentResources": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ArcAppFunctionUpdateInput"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 3,
                          "description": "The unique name of the blueprint resource",
                          "example": "log-sweeper"
                        }
                      },
                      "required": [
                        "name"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "runtime": {
                          "type": "string",
                          "enum": [
                            "node",
                            "nodejs22.x",
                            "nodejs24.x"
                          ],
                          "default": "nodejs24.x",
                          "description": "Runtime for function",
                          "example": "nodejs24.x"
                        }
                      }
                    }
                  ]
                },
                {
                  "$ref": "#/components/schemas/SyncTagInvalidateFunctionCreateInput"
                },
                {
                  "$ref": "#/components/schemas/DocumentFunctionCreateInput"
                },
                {
                  "$ref": "#/components/schemas/MediaFunctionCreateInput"
                },
                {
                  "$ref": "#/components/schemas/ScheduleFunctionCreateInput"
                },
                {
                  "$ref": "#/components/schemas/QueueFunctionCreateInput"
                },
                {
                  "$ref": "#/components/schemas/PubSubFunctionCreateInput"
                },
                {
                  "$ref": "#/components/schemas/DurableFunctionCreateInput"
                }
              ]
            },
            "minItems": 1,
            "description": "Array of functions currently comprising the arc app; enables rollback during failed deploys if provided"
          },
          "resources": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ArcAppFunctionUpdateInput"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 3,
                          "description": "The unique name of the blueprint resource",
                          "example": "log-sweeper"
                        }
                      },
                      "required": [
                        "name"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "runtime": {
                          "type": "string",
                          "enum": [
                            "node",
                            "nodejs22.x",
                            "nodejs24.x"
                          ],
                          "default": "nodejs24.x",
                          "description": "Runtime for function",
                          "example": "nodejs24.x"
                        }
                      }
                    }
                  ]
                },
                {
                  "$ref": "#/components/schemas/SyncTagInvalidateFunctionCreateInput"
                },
                {
                  "$ref": "#/components/schemas/DocumentFunctionCreateInput"
                },
                {
                  "$ref": "#/components/schemas/MediaFunctionCreateInput"
                },
                {
                  "$ref": "#/components/schemas/ScheduleFunctionCreateInput"
                },
                {
                  "$ref": "#/components/schemas/QueueFunctionCreateInput"
                },
                {
                  "$ref": "#/components/schemas/PubSubFunctionCreateInput"
                },
                {
                  "$ref": "#/components/schemas/DurableFunctionCreateInput"
                }
              ]
            },
            "minItems": 1,
            "description": "Array of desired functions to include in the arc app"
          }
        },
        "required": [
          "blueprintResources",
          "resources"
        ]
      },
      "DurableFunctionExecution": {
        "allOf": [
          {
            "$ref": "#/components/schemas/DurableFunctionExecutionBase"
          },
          {
            "type": "object",
            "properties": {
              "config": {
                "$ref": "#/components/schemas/DurableFunctionExecutionConfig"
              },
              "error": {
                "nullable": true
              },
              "executionDataIncluded": {
                "type": "boolean"
              },
              "inputPayload": {
                "nullable": true
              },
              "result": {
                "nullable": true
              },
              "version": {
                "type": "string"
              }
            },
            "required": [
              "config",
              "executionDataIncluded",
              "version"
            ]
          }
        ]
      },
      "DurableFunctionExecutionConfig": {
        "type": "object",
        "properties": {
          "executionTimeout": {
            "type": "number",
            "minimum": 1,
            "maximum": 31622400,
            "description": "How long the durable can run for, in seconds, from the moment an execution begins"
          }
        }
      },
      "DurableFunctionExecutionBase": {
        "type": "object",
        "properties": {
          "endTimestamp": {
            "type": "number"
          },
          "executionId": {
            "type": "string",
            "description": "Durable Function execution ID.",
            "example": "1%2Fdurable-execution%2Fa5f104bf-8f98-4c43-a275-c47cd0e55c91%2F721704c1-73ae-3004-95fa-f472e130fb15"
          },
          "executionName": {
            "type": "string"
          },
          "startTimestamp": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "RUNNING",
              "SUCCEEDED",
              "FAILED",
              "TIMED_OUT",
              "STOPPED"
            ]
          }
        },
        "required": [
          "executionId",
          "executionName",
          "startTimestamp",
          "status"
        ]
      },
      "DurableFunctionExecutions": {
        "type": "object",
        "properties": {
          "executions": {
            "type": "array",
            "items": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/DurableFunctionExecutionBase"
                },
                {
                  "type": "object",
                  "properties": {
                    "functionArn": {
                      "type": "string",
                      "description": "Unique identifier for an AWS resource",
                      "example": "aws:lambda:us-east-1:305104952970:function:Stack5lig74o699ProjectY7h-TestFunction1EventLambda-o7QI6wIKfpIr"
                    }
                  },
                  "required": [
                    "functionArn"
                  ]
                }
              ]
            }
          }
        },
        "required": [
          "executions"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/{apiV}/functions/{functionId}/logs": {
      "get": {
        "description": "By default, this route returns a list of the last 100 log entries. To get a different set of items, you can use the offset and limit parameters in the query string of the GET request.",
        "summary": "Retrieve function logs",
        "tags": [
          "Functions"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "example": "vX"
            },
            "required": true,
            "name": "apiV",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 10,
              "description": "The ID of the resource",
              "example": "abcd123456"
            },
            "required": true,
            "description": "The ID of the resource",
            "name": "functionId",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "description": "Durable Function execution ID.",
              "example": "1%2Fdurable-execution%2Fa5f104bf-8f98-4c43-a275-c47cd0e55c91%2F721704c1-73ae-3004-95fa-f472e130fb15"
            },
            "required": false,
            "description": "Durable Function execution ID.",
            "name": "executionId",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "default": "true",
              "description": "Set to \"false\" to omit the \"Message sent to queue\" system log entries emitted when a message is enqueued for a queue function.",
              "example": "false"
            },
            "required": false,
            "description": "Set to \"false\" to omit the \"Message sent to queue\" system log entries emitted when a message is enqueued for a queue function.",
            "name": "includeQueueSysLogs",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "default": "100",
              "description": "The maximum number of logs to retrieve.",
              "example": "100"
            },
            "required": false,
            "description": "The maximum number of logs to retrieve.",
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "default": "0",
              "description": "The offset, from the last log entry, to begin retrieval.",
              "example": "100"
            },
            "required": false,
            "description": "The offset, from the last log entry, to begin retrieval.",
            "name": "offset",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 8,
              "description": "Resource ID",
              "example": "24s6f8sr"
            },
            "required": true,
            "description": "Resource ID",
            "name": "x-sanity-scope-id",
            "in": "header"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "project",
                "organization"
              ],
              "description": "Type of resource (i.e. project or organization)",
              "example": "project"
            },
            "required": true,
            "description": "Type of resource (i.e. project or organization)",
            "name": "x-sanity-scope-type",
            "in": "header"
          }
        ],
        "responses": {
          "200": {
            "description": "Logs retrieve",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "limit": {
                      "type": "number",
                      "example": 1
                    },
                    "logs": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "attempt": {
                            "type": "integer",
                            "description": "Optional Durable step attempt positive number, if the log came from a Durable step operation",
                            "example": 1
                          },
                          "executionId": {
                            "type": "string",
                            "description": "Durable Function execution ID.",
                            "example": "1%2Fdurable-execution%2Fa5f104bf-8f98-4c43-a275-c47cd0e55c91%2F721704c1-73ae-3004-95fa-f472e130fb15"
                          },
                          "level": {
                            "type": "string",
                            "nullable": true,
                            "enum": [
                              "DEBUG",
                              "TRACE",
                              "FATAL",
                              "INFO",
                              "WARN",
                              "ERROR",
                              null
                            ]
                          },
                          "message": {
                            "type": "string",
                            "example": "This is probably something important"
                          },
                          "operationId": {
                            "type": "string",
                            "description": "Optional unique Durable step ID, if the log came from a Durable step operation",
                            "example": "c81e728d9d4c2f63"
                          },
                          "operationName": {
                            "type": "string",
                            "description": "Optional non-unique Durable step name, if the log came from a named Durable step operation",
                            "example": "flip-coin"
                          },
                          "requestId": {
                            "type": "string",
                            "example": "c19d92ea-f3c1-4fc1-a2a4-7d7e08527584"
                          },
                          "time": {
                            "type": "string",
                            "format": "date-time",
                            "example": "2025-10-09T10:50:09.486Z"
                          }
                        },
                        "required": [
                          "message",
                          "requestId",
                          "time"
                        ]
                      }
                    },
                    "next": {
                      "type": "string",
                      "example": "/vX/functions/123456/logs?limit=1&offset=2"
                    },
                    "offset": {
                      "type": "number",
                      "example": 1
                    },
                    "prev": {
                      "type": "string",
                      "example": "/vX/functions/123456/logs?limit=1&offset=0"
                    }
                  },
                  "required": [
                    "limit",
                    "logs",
                    "offset"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "details": {
                      "nullable": true
                    },
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error",
                    "message"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "details": {
                      "nullable": true
                    },
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error",
                    "message"
                  ]
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "details": {
                      "nullable": true
                    },
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error",
                    "message"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Function not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "details": {
                      "nullable": true
                    },
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error",
                    "message"
                  ]
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "details": {
                      "nullable": true
                    },
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error",
                    "message"
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "details": {
                      "nullable": true
                    },
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error",
                    "message"
                  ]
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete logs for a function",
        "tags": [
          "Functions"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "example": "vX"
            },
            "required": true,
            "name": "apiV",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 10,
              "description": "The ID of the resource",
              "example": "abcd123456"
            },
            "required": true,
