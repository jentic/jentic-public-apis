    "/{apiV}/functions/{functionId}/logs/stream": {
      "get": {
        "summary": "Stream function logs",
        "tags": [
          "Functions"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "example": "vX"
            },
            "required": true,
            "name": "apiV",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 10,
              "description": "The ID of the resource",
              "example": "abcd123456"
            },
            "required": true,
            "description": "The ID of the resource",
            "name": "functionId",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "format": "date-time",
              "description": "ISO 8601 timestamp to stream from, exclusive. Defaults to the newest entry at connect time, so only new logs are sent. Ignored when `Last-Event-ID` is present.",
              "example": "2025-10-09T10:50:09.486Z"
            },
            "required": false,
            "description": "ISO 8601 timestamp to stream from, exclusive. Defaults to the newest entry at connect time, so only new logs are sent. Ignored when `Last-Event-ID` is present.",
            "name": "after",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "default": "true",
              "description": "Set to \"false\" to omit the \"Message sent to queue\" system log entries emitted when a message is enqueued for a queue function.",
              "example": "false"
            },
            "required": false,
            "description": "Set to \"false\" to omit the \"Message sent to queue\" system log entries emitted when a message is enqueued for a queue function.",
            "name": "includeQueueSysLogs",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 8,
              "description": "Resource ID",
              "example": "24s6f8sr"
            },
            "required": true,
            "description": "Resource ID",
            "name": "x-sanity-scope-id",
            "in": "header"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "project",
                "organization"
              ],
              "description": "Type of resource (i.e. project or organization)",
              "example": "project"
            },
            "required": true,
            "description": "Type of resource (i.e. project or organization)",
            "name": "x-sanity-scope-type",
            "in": "header"
          }
        ],
        "responses": {
          "200": {
            "description": "Stream of logs",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "string",
                      "description": "JSON array of log entries"
                    },
                    "event": {
                      "type": "string",
                      "enum": [
                        "logs",
                        "ping"
                      ]
                    },
                    "id": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "data",
                    "event"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "details": {
                      "nullable": true
                    },
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error",
                    "message"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "details": {
                      "nullable": true
                    },
                    "error": {
                      "type": "string"
