            "example": "Log Sweeper"
          },
          "name": {
            "type": "string",
            "minLength": 3,
            "description": "The unique name of the blueprint resource",
            "example": "log-sweeper"
          },
          "robotToken": {
            "type": "string",
            "minLength": 1,
            "description": "Robot Token supplied by the user",
            "example": "s.RobotsClientToken.abcdefg1234567",
            "externalDocs": {
              "description": "Sanity Access API - Robots",
              "url": "https://www.sanity.io/docs/http-reference/access-api#createRobot"
            }
          },
          "source": {
            "type": "string",
            "description": "Base64 encoded zip file",
            "example": ""
          },
          "rule": {
            "$ref": "#/components/schemas/ContentLakeEventSource"
          },
          "type": {
            "type": "string",
            "enum": [
              "sanity.function.queue"
            ]
          },
          "concurrency": {
            "type": "integer",
            "minimum": 1
          },
          "debounce": {
            "type": "object",
            "nullable": true,
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^(context|event)(\\.[A-Za-z_$][\\w$]*)+$"
              },
              "maxWindow": {
                "type": "integer",
                "minimum": 1,
                "maximum": 86400
              },
              "window": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1800
              }
            },
            "required": [
              "window"
            ],
            "description": "Collapse bursts of events for the same key into one invocation. The function is invoked once per quiet period with the most recent event; earlier events in the window are dropped, not batched.",
            "example": {
              "key": "event.data.documentId",
              "maxWindow": 300,
              "window": 60
            }
          },
          "fifo": {
            "type": "boolean"
          },
          "maxAttempts": {
            "type": "integer",
            "nullable": true,
            "minimum": 1,
            "maximum": 100,
            "description": "Total delivery attempts. `1` delivers a message once and never retries, `3` delivers it once and retries twice. Omit or send `null` for redelivery until the queue retention period expires.",
            "example": 3
          },
          "project": {
            "type": "string",
            "minLength": 8,
            "description": "Resource ID",
            "example": "24s6f8sr"
          }
        },
        "required": [
          "name",
          "source",
          "type",
          "concurrency",
          "fifo"
        ]
      },
