{
  "openapi": "3.1.1",
  "info": {
    "title": "History HTTP Endpoint",
    "version": "2025-02-19",
    "description": "The History API lets you request document revisions by a timestamp or a revision ID. To read transactions for a document, you must have read access to the document's current version. If your document is in a private dataset you must be authenticated.\n"
  },
  "servers": [
    {
      "url": "https://{projectId}.api.sanity.io/{apiVersion}",
      "description": "Sanity API base URL",
      "variables": {
        "projectId": {
          "default": "projectId",
          "description": "Project ID"
        },
        "apiVersion": {
          "default": "v2025-02-19",
          "description": "API version"
        }
      }
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/data/history/{dataset}/documents/{documentId}": {
      "get": {
        "summary": "Get a document revision",
        "operationId": "getRevision",
        "description": "Returns a document as it was at a point in the past. This endpoint behaves the same as the `/doc` endpoint. It applies the current access control to every revision of the document.\n\nNote: Current Access Control means if you're able to access the document today, you'll be able to access all the previous revisions of the document.\n",
        "parameters": [
          {
            "in": "path",
            "name": "dataset",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "documentId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "revision",
            "description": "The revision ID (_rev) to fetch. Mutually exclusive with `time` and `lastRevision`.\n",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "time",
            "description": "Time to fetch the document at. Mutually exclusive with `lastRevision` and `revision`.\n",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "in": "query",
            "name": "lastRevision",
            "description": "If true, only the last revision will be returned, or the last state before deletion for a deleted document.\nMutually exclusive with `time` and `revision`.\n",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the document revision.\n\nNote: The timestamp is matched against the time of the transaction in the backend, and not the timestamps in the document. In most cases these will align, but if you have imported documents with the timestamps already set, there will be a discrepancy. \n",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "documents": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "_id": {
                            "type": "string",
                            "description": "The document ID",
                            "example": "123456"
                          },
                          "_createdAt": {
                            "type": "string",
                            "format": "date-time",
                            "description": "The date and time the document was created.",
                            "example": "2021-01-01T00:00:00Z"
                          },
                          "_updatedAt": {
                            "type": "string",
                            "format": "date-time",
                            "description": "The date and time the document was last updated.",
                            "example": "2021-01-01T00:00:00Z"
                          },
                          "_rev": {
                            "type": "string",
                            "description": "The revision ID (_rev) of the document.",
                            "example": "123456"
                          },
                          "_type": {
                            "type": "string",
                            "description": "The type of the document.",
                            "example": "article"
                          },
                          "additionalProperties": true
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/data/history/{dataset}/transactions": {
      "get": {
        "summary": "Get all transactions",
        "operationId": "getTransactions",
        "description": "Returns an NDJSON (Newline Delimited JSON) containing transactions for all documents. **Using with `limit` is highly recommended.**\n",
        "parameters": [
          {
            "in": "path",
            "name": "dataset",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/excludeContent"
          },
          {
            "$ref": "#/components/parameters/fromTime"
          },
          {
            "$ref": "#/components/parameters/toTime"
          },
          {
            "$ref": "#/components/parameters/fromTransaction"
          },
          {
            "$ref": "#/components/parameters/toTransaction"
          },
          {
            "$ref": "#/components/parameters/authors"
          },
          {
            "$ref": "#/components/parameters/reverse"
          },
          {
            "$ref": "#/components/parameters/limit"
          },
          {
            "$ref": "#/components/parameters/effectFormat"
          },
          {
            "$ref": "#/components/parameters/includeIdentifiedDocumentsOnly"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/ndjson": {
                "schema": {
                  "type": "string",
                  "format": "binary",
                  "description": "An NDJSON payload containing the transactions for the given document IDs.\n",
                  "example": "{\"id\":\"mXlLqCPElh7uu0wm84cjks\",\"timestamp\":\"2019-05-28T17:16:43.151928Z\",\"author\":\"pDYrmFKn7\",\"mutations\":[{\"create\":{\"_id\":\"b8b866a5-3546-47de-a15d-de149d058b06\",\"_rev\":\"mXlLqCPElh7uu0wm84cjks\"}},{\"delete\":{\"id\":\"drafts.b8b866a5-3546-47de-a15d-de149d058b06\",\"purge\":false}}],\"documentIDs\":[\"b8b866a5-3546-47de-a15d-de149d058b06\",\"drafts.b8b866a5-3546-47de-a15d-de149d058b06\"]}\n{\"id\":\"mXlLqCPElh7uu0wm84ckxR\",\"timestamp\":\"2019-05-28T17:18:39.223739Z\",\"author\":\"pDYrmFKn7\",\"mutations\":[{\"patch\":{\"id\":\"b8b866a5-3546-47de-a15d-de149d058b06\",\"ifRevisionID\":\"mXlLqCPElh7uu0wm84cjks\"}},{\"createOrReplace\":{\"_id\":\"b8b866a5-3546-47de-a15d-de149d058b06\",\"_rev\":\"mXlLqCPElh7uu0wm84cjks\"}},{\"delete\":{\"id\":\"drafts.b8b866a5-3546-47de-a15d-de149d058b06\",\"purge\":false}}],\"documentIDs\":[\"b8b866a5-3546-47de-a15d-de149d058b06\",\"drafts.b8b866a5-3546-47de-a15d-de149d058b06\"]}\n{\"id\":\"3wHuOovAQT3V1vksbN2QtG\",\"timestamp\":\"2019-06-11T13:06:02.028674Z\",\"author\":\"psb9Tdtwv\",\"mutations\":[{\"delete\":{\"id\":\"b8b866a5-3546-47de-a15d-de149d058b06\",\"purge\":false}},{\"delete\":{\"id\":\"drafts.b8b866a5-3546-47de-a15d-de149d058b06\",\"purge\":false}}],\"documentIDs\":[\"b8b866a5-3546-47de-a15d-de149d058b06\"]}\n"
                }
              }
            }
          }
        }
      }
    },
    "/data/history/{dataset}/transactions/{documentIds}": {
      "get": {
        "summary": "Get the transactions for a list of documents",
        "operationId": "getTransactionsForDocuments",
        "description": "Returns an NDJSON (Newline Delimited JSON) containing transactions for the given document ids.\n",
        "parameters": [
          {
            "in": "path",
            "name": "dataset",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "documentIds",
            "required": true,
            "schema": {
              "type": "string",
              "description": "A comma separated list of document ids. If omitted, the transactions for all documents will be returned. Use with `limit` is highly recommended if omitting document ids.\n",
              "example": "123456,789012"
            }
          },
          {
            "$ref": "#/components/parameters/excludeContent"
          },
          {
            "$ref": "#/components/parameters/fromTime"
          },
          {
            "$ref": "#/components/parameters/toTime"
          },
          {
            "$ref": "#/components/parameters/fromTransaction"
          },
          {
            "$ref": "#/components/parameters/toTransaction"
          },
          {
            "$ref": "#/components/parameters/authors"
          },
          {
            "$ref": "#/components/parameters/reverse"
          },
          {
            "$ref": "#/components/parameters/limit"
          },
          {
            "$ref": "#/components/parameters/effectFormat"
          },
          {
            "$ref": "#/components/parameters/includeIdentifiedDocumentsOnly"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/ndjson": {
                "schema": {
                  "type": "string",
                  "format": "binary",
                  "description": "An NDJSON payload containing the transactions for the given document IDs.\n",
                  "example": "{\"id\":\"mXlLqCPElh7uu0wm84cjks\",\"timestamp\":\"2019-05-28T17:16:43.151928Z\",\"author\":\"pDYrmFKn7\",\"mutations\":[{\"create\":{\"_id\":\"b8b866a5-3546-47de-a15d-de149d058b06\",\"_rev\":\"mXlLqCPElh7uu0wm84cjks\"}},{\"delete\":{\"id\":\"drafts.b8b866a5-3546-47de-a15d-de149d058b06\",\"purge\":false}}],\"documentIDs\":[\"b8b866a5-3546-47de-a15d-de149d058b06\",\"drafts.b8b866a5-3546-47de-a15d-de149d058b06\"]}\n{\"id\":\"mXlLqCPElh7uu0wm84ckxR\",\"timestamp\":\"2019-05-28T17:18:39.223739Z\",\"author\":\"pDYrmFKn7\",\"mutations\":[{\"patch\":{\"id\":\"b8b866a5-3546-47de-a15d-de149d058b06\",\"ifRevisionID\":\"mXlLqCPElh7uu0wm84cjks\"}},{\"createOrReplace\":{\"_id\":\"b8b866a5-3546-47de-a15d-de149d058b06\",\"_rev\":\"mXlLqCPElh7uu0wm84cjks\"}},{\"delete\":{\"id\":\"drafts.b8b866a5-3546-47de-a15d-de149d058b06\",\"purge\":false}}],\"documentIDs\":[\"b8b866a5-3546-47de-a15d-de149d058b06\",\"drafts.b8b866a5-3546-47de-a15d-de149d058b06\"]}\n{\"id\":\"3wHuOovAQT3V1vksbN2QtG\",\"timestamp\":\"2019-06-11T13:06:02.028674Z\",\"author\":\"psb9Tdtwv\",\"mutations\":[{\"delete\":{\"id\":\"b8b866a5-3546-47de-a15d-de149d058b06\",\"purge\":false}},{\"delete\":{\"id\":\"drafts.b8b866a5-3546-47de-a15d-de149d058b06\",\"purge\":false}}],\"documentIDs\":[\"b8b866a5-3546-47de-a15d-de149d058b06\"]}\n"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "excludeContent": {
        "in": "query",
        "name": "excludeContent",
        "required": true,
        "description": "Must be `true`. Transaction responses never include document contents. Requests without `excludeContent=true`, or with `excludeContent=false`, return a `403` permission error.\n",
        "schema": {
          "type": "boolean"
        }
      },
      "fromTime": {
        "in": "query",
        "name": "fromTime",
        "description": "Only include transactions from this timestamp onwards.\n",
        "schema": {
          "type": "string",
          "format": "date-time",
          "example": "2021-01-01T00:00:00Z"
        }
      },
      "toTime": {
        "in": "query",
        "name": "toTime",
        "description": "Only include transactions up to this timestamp.\n",
        "schema": {
          "type": "string",
          "format": "date-time",
          "example": "2021-01-01T00:00:00Z"
        }
      },
      "fromTransaction": {
        "in": "query",
        "name": "fromTransaction",
        "description": "Only include transactions from this Transaction ID (or Revision ID) onwards.\n",
        "schema": {
          "type": "string",
          "example": "mXlLqCPElh7uu0wm84cjks"
        }
      },
      "toTransaction": {
        "in": "query",
        "name": "toTransaction",
        "description": "Only include transactions up to this Transaction ID (or Revision ID).\n",
        "schema": {
          "type": "string",
          "example": "mXlLqCPElh7uu0wm84cjks"
        }
      },
      "authors": {
        "in": "query",
        "name": "authors",
        "description": "Only include transactions by these authors.\n",
        "schema": {
          "type": "string",
          "description": "A comma separated list of author IDs.\n",
          "example": "pDYrmFKn7,psb9Tdtwv"
        }
      },
      "reverse": {
        "in": "query",
        "name": "reverse",
        "description": "Return the transactions in reverse order.\n",
        "schema": {
          "type": "boolean",
          "default": false
        }
      },
      "limit": {
        "in": "query",
        "name": "limit",
        "description": "Limit the number of transactions returned.\n",
        "schema": {
          "type": "integer"
        }
      },
      "effectFormat": {
        "in": "query",
        "name": "effectFormat",
        "description": "The format of the effect. Uses [mendoza](https://www.sanity.io/blog/mendoza), a super efficient format for expressing differences between JSON documents.\n",
        "schema": {
          "type": "string",
          "default": "mendoza"
        }
      },
      "includeIdentifiedDocumentsOnly": {
        "in": "query",
        "name": "includeIdentifiedDocumentsOnly",
        "description": "Only include the documents that are part of the document IDs list.\n",
        "schema": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}