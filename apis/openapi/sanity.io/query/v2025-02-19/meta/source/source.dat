{
  "openapi": "3.1.1",
  "info": {
    "title": "Query API",
    "version": "v2025-02-19",
    "description": "The Query API lets you query Sanity Content Lake with GROQ.\n\nYou can also send queries to the CDN endpoint for edge-cached results:\nhttps://{projectId}.apicdn.sanity.io/v{YYYY-MM-DD}/data/query/{dataset}\n\nThe CDN only serves the `published` and `raw` perspectives. Send queries that use drafts or release perspectives to the API endpoint.\n\nWhile you can use the HTTP API endpoint directly, we recommend using a client library if you can.\n"
  },
  "servers": [
    {
      "url": "https://{projectId}.api.sanity.io/{apiVersion}",
      "description": "Sanity API base URL",
      "variables": {
        "projectId": {
          "default": "projectId",
          "description": "Project ID"
        },
        "apiVersion": {
          "default": "v2025-02-19",
          "description": "API version"
        }
      }
    },
    {
      "url": "https://{projectId}.apicdn.sanity.io/{apiVersion}",
      "description": "Sanity API CDN base URL (edge-cached results, `published` and `raw` perspectives only)",
      "variables": {
        "projectId": {
          "default": "projectId",
          "description": "Project ID"
        },
        "apiVersion": {
          "default": "v2025-02-19",
          "description": "API version"
        }
      }
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "parameters": {
      "Explain": {
        "name": "explain",
        "in": "query",
        "schema": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "enum": [
                "only"
              ]
            }
          ]
        },
        "description": "Whether to include the query execution plan as plain text in an `explain` field. Set to `only` to return the plan without running the query; `result` is then `null`."
      },
      "ResultSourceMap": {
        "name": "resultSourceMap",
        "in": "query",
        "schema": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "enum": [
                "withKeyArraySelector"
              ]
            }
          ]
        },
        "description": "If true, the response includes a `resultSourceMap` field with content source map metadata. Set to `withKeyArraySelector` to use `_key`-based array selectors in source paths."
      },
      "Perspective": {
        "name": "perspective",
        "in": "query",
        "schema": {
          "type": "string",
          "default": "published"
        },
        "description": "Runs the query against the selected perspective:\n* `drafts`: Query runs as if all draft documents and changes were published.\n* `published`: Query runs as if no draft documents or changes exist.\n* `raw`: Query runs without distinguishing between drafts, release versions, or published documents.\n* Release stack: A comma-separated list of release IDs, optionally including `drafts`, to create a custom perspective. Earlier entries take precedence. The list can contain up to 200 entries. Requires API version `v2025-02-19` or later; earlier versions return a 400 error.\n\nDefaults to `published` in API version `v2025-02-19` and later. Earlier API versions default to `raw`.\n\nThe CDN endpoint only accepts `published` and `raw`. Any other perspective returns a 400 error.\n\nFor POST requests, pass `perspective` as a URL query parameter. The request body doesn't accept it.\n"
      },
      "Tag": {
        "name": "tag",
        "in": "query",
        "schema": {
          "type": "string"
        },
        "description": "Request tags are values assigned to API and CDN requests that can be used to filter and aggregate log data within request logs from your Sanity Content Lake. Learn more in the request tags documentation."
      },
      "ReturnQuery": {
        "name": "returnQuery",
        "in": "query",
        "schema": {
          "type": "boolean",
          "default": true
        },
        "description": "If false, the response will not include the submitted query"
      },
      "CacheMode": {
        "name": "cacheMode",
        "in": "query",
        "schema": {
          "type": "string",
          "enum": [
            "noStale"
          ]
        },
        "description": "Set to `noStale` to disable stale-while-revalidate on CDN responses. Use it for live queries that must not serve stale data after the cache expires."
      },
      "LastLiveEventId": {
        "name": "lastLiveEventId",
        "in": "query",
        "schema": {
          "type": "string"
        },
        "description": "The ID of the last event received from the Live Content API. The CDN uses it to serve a response that is at least as fresh as that event."
      }
    },
    "schemas": {
      "QueryResponse": {
        "type": "object",
        "properties": {
          "ms": {
            "type": "number",
            "description": "Server-side processing time"
          },
          "query": {
            "type": "string",
            "description": "Submitted query. Omitted when `returnQuery` is false."
          },
          "result": {
            "description": "Query result (can be any valid JSON value)"
          },
          "syncTags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "explain": {
            "type": "string",
            "description": "Query execution plan as plain text. Only present when `explain` is set."
          },
          "resultSourceMap": {
            "type": "object",
            "description": "Content source map metadata for the result. Only present when `resultSourceMap` is set."
          }
        }
      },
      "QueryError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "query": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "start": {
                "type": "integer"
              },
              "end": {
                "type": "integer"
              },
              "type": {
                "type": "string",
                "description": "Error type, such as `queryParseError`, `httpBadRequest`, `httpInvalidQueryParamsError`, `httpInvalidRequestBody`, or `validationError`."
              },
              "bodyTruncated": {
                "type": "boolean",
                "description": "Present on `httpInvalidRequestBody` errors."
              }
            }
          }
        }
      },
      "NotFoundError": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "integer"
          },
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Bad request, such as a query syntax error, an invalid parameter value, or a perspective the CDN doesn't serve",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/QueryError"
            },
            "examples": {
              "queryParseError": {
                "value": {
                  "error": {
                    "query": "*[",
                    "description": "expected ']' following expression",
                    "start": 1,
                    "end": 2,
                    "type": "queryParseError"
                  }
                }
              },
              "cdnPerspective": {
                "value": {
                  "error": {
                    "description": "\"perspective\" is not allowed for CDN requests",
                    "type": "httpInvalidQueryParamsError"
                  }
                }
              }
            }
          }
        }
      },
      "NotFound": {
        "description": "Dataset not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/NotFoundError"
            },
            "example": {
              "statusCode": 404,
              "error": "Dataset not found",
              "message": "Dataset \"production\" not found for project ID \"projectId\""
            }
          }
        }
      }
    }
  },
  "security": [
    {},
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/data/query/{dataset}": {
      "parameters": [
        {
          "name": "dataset",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          },
          "description": "Dataset name"
        }
      ],
      "get": {
        "summary": "Query using GET method",
        "description": "The basic query API endpoint. Some browsers and proxies limit URL length. Send queries longer than 11 KB as a POST; `@sanity/client` switches to POST when the encoded query string reaches 11,264 characters.\n\nNote: When a document is not found, GROQ still evaluates to a value. Thus, you don't get 404 errors through this endpoint.\nSome examples:\n* `*[_id == \"missing\"]` results in `[]`\n* `count(*[_type == \"typoType\"])` results in `0`\n* `*[_id == \"missing\"][0]` results in `null`\n* `*[_id == \"missing\"][0].someProp` also results in `null`\n",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The GROQ query itself",
            "example": "*[_type == 'movie']"
          },
          {
            "$ref": "#/components/parameters/Explain"
          },
          {
            "$ref": "#/components/parameters/ResultSourceMap"
          },
          {
            "$ref": "#/components/parameters/Perspective"
          },
          {
            "$ref": "#/components/parameters/Tag"
          },
          {
            "$ref": "#/components/parameters/ReturnQuery"
          },
          {
            "$ref": "#/components/parameters/CacheMode"
          },
          {
            "$ref": "#/components/parameters/LastLiveEventId"
          },
          {
            "name": "$-prefixed",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "GROQ queries may also use parameters. In the query these will be prefixed by a dollar sign. Submit each parameter as a URL parameter with a JSON-encoded value, for example `$language=\"es\"`. An unquoted string value returns a 400 error."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful query response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryResponse"
                },
                "examples": {
                  "arrayResult": {
                    "value": {
                      "ms": 12,
                      "query": "*[_type == 'movie']",
                      "result": [
                        {
                          "_id": "movie1",
                          "title": "Inception"
                        }
                      ],
                      "syncTags": [
                        "s1:hil1xQ"
                      ]
                    }
                  },
                  "singleDocument": {
                    "value": {
                      "ms": 8,
                      "query": "*[_id == 'movie1'][0]",
                      "result": {
                        "_id": "movie1",
                        "title": "Inception"
                      },
                      "syncTags": [
                        "s1:hil1xQ"
                      ]
                    }
                  },
                  "countResult": {
                    "value": {
                      "ms": 5,
                      "query": "count(*[_type == 'movie'])",
                      "result": 1,
                      "syncTags": [
                        "s1:hil1xQ"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "post": {
        "summary": "Query using POST method",
        "description": "Use POST for long queries or large parameter values. `@sanity/client` sends queries as a POST when the encoded query string reaches 11,264 characters.\nQueries sent using the POST method will also be cached on the CDN.\n\nThe request body only accepts `query`, `params`, and `returnQuery`. Pass other options, such as `perspective`, `explain`, `resultSourceMap`, and `tag`, as URL query parameters. Unknown body fields return a 400 error.\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/Explain"
          },
          {
            "$ref": "#/components/parameters/ResultSourceMap"
          },
          {
            "$ref": "#/components/parameters/Perspective"
          },
          {
            "$ref": "#/components/parameters/Tag"
          },
          {
            "$ref": "#/components/parameters/ReturnQuery"
          },
          {
            "$ref": "#/components/parameters/CacheMode"
          },
          {
            "$ref": "#/components/parameters/LastLiveEventId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "query": {
                    "type": "string",
                    "description": "The GROQ query"
                  },
                  "params": {
                    "type": "object",
                    "description": "The params-part is optional. You don't use the $-prefixes when submitting as json"
                  },
                  "returnQuery": {
                    "type": "boolean",
                    "default": true,
                    "description": "If false, the response will not include the submitted query"
                  }
                },
                "required": [
                  "query"
                ]
              },
              "examples": {
                "basicQuery": {
                  "value": {
                    "query": "*[_type == 'movie']"
                  }
                },
                "queryWithParams": {
                  "value": {
                    "query": "*[_type == 'movie' && language == $language]",
                    "params": {
                      "language": "es"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful query response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    }
  }
}