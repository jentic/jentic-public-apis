      "Permission": {
        "title": "Permission",
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/PermissionType"
          },
          "actions": {
            "$ref": "#/components/schemas/PermissionActions"
          },
          "name": {
            "type": "string",
            "description": "The name of the permission. This is the unique identifier for the resource.",
            "example": "legal-documents"
          },
          "title": {
            "type": "string",
            "description": "The human-readable title of the permission.",
            "example": "Permission for \"Legal\" Folder"
          },
          "description": {
            "type": "string",
            "description": "The description of the permission.",
            "example": "Permission for \"Legal\" Folder"
          },
          "resourceType": {
            "type": "string",
            "description": "The resource the permission applies to.",
            "example": "project"
          },
          "resourceId": {
            "type": "string",
            "description": "The resource ID the permission applies to.",
            "example": "c7ja4siy"
          },
          "ownerOrganizationId": {
            "type": "string",
            "description": "The organization ID the permission applies to. Used for wildcard permissions where the resourceId is `*`.",
            "example": "or0Bc1hcJ"
          },
          "isCustom": {
            "type": "boolean",
            "description": "Whether the permission is a custom (user-created) permission or a system-provided one.",
            "example": false
          },
          "params": {
            "type": "object",
            "description": "The parameters for the permission. This is a key-value map of the permission's configuration.",
            "example": {
              "filter": "*[_type == \"legal\"]"
            }
          }
        },
        "required": [
          "type",
          "name",
          "title",
          "resourceType",
          "resourceId"
        ]
      },
      "Role": {
        "title": "Role",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "administrator"
          },
          "title": {
            "type": "string",
            "example": "Administrator"
          },
          "description": {
            "type": "string",
            "example": "Administrators can manage billing details, legal contacts, organization users, and manage project ownership."
          },
          "isCustom": {
            "type": "boolean",
            "example": false
          },
          "resourceType": {
            "type": "string",
            "example": "organization"
          },
          "resourceId": {
            "type": "string",
            "example": "or0Bc1hcJ"
          },
          "appliesToUsers": {
            "type": "boolean",
            "example": true
          },
          "appliesToRobots": {
            "type": "boolean",
            "example": true
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "$ref": "#/components/schemas/PermissionType"
                },
                "action": {
                  "$ref": "#/components/schemas/PermissionAction"
                },
                "name": {
                  "type": "string",
                  "description": "The name of the permission.",
                  "example": "legal-documents"
                },
                "params": {
                  "type": "object",
                  "description": "The parameters for the permission. This is a key-value map of the permission's configuration.",
                  "example": {
                    "dataset": "development"
                  }
                }
              }
            }
          }
        },
        "required": [
          "name",
          "title",
          "resourceType",
          "resourceId",
          "appliesToUsers",
          "appliesToRobots",
          "permissions"
        ]
      },
      "Membership": {
        "type": "object",
        "properties": {
          "addedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2024-01-15T12:15:30Z"
          },
          "resourceType": {
            "type": "string",
            "example": "project"
          },
          "resourceId": {
            "type": "string",
            "example": "c7ja4siy"
          },
          "roleNames": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "administrator",
              "editor"
            ]
          },
          "lastSeenAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "example": "2024-01-15T12:15:30Z",
            "description": "For project memberships, the latest recorded authenticated request to that project, including clients other than Studio. Updated by an hourly import when it succeeds, so it may lag if imports are delayed. Null or omitted means no activity was recorded, not that the project was unused. Not set for organization memberships.\n"
          },
          "resourceUserId": {
            "type": [
              "string",
              "null"
            ],
            "description": "An alternative ID for the user in the resource. Only present for project memberships. That is, a user can be assigned to multiple projects, and each project will have a different resourceUserId to reference the same user.",
            "example": "projectUserId123"
          }
        },
        "required": [
          "resourceType",
          "resourceId",
          "roleNames"
        ]
      },
      "Memberships": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Membership"
        }
      },
      "User": {
        "title": "User",
        "type": "object",
        "properties": {
          "sanityUserId": {
            "type": "string",
            "example": "gDdcnv42e"
          },
          "profile": {
            "$ref": "#/components/schemas/UserProfile"
          },
          "memberships": {
            "$ref": "#/components/schemas/Memberships"
          }
        },
        "required": [
          "sanityUserId",
          "profile",
          "memberships"
        ]
      },
      "Request": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "request-id"
          },
          "status": {
            "type": "string",
            "example": "pending"
          },
          "resourceId": {
            "type": "string",
            "example": "project-id"
          },
          "resourceType": {
            "type": "string",
            "example": "project"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2024-07-10T12:00:00Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2024-07-10T12:00:00Z"
          },
          "updatedByUserId": {
            "type": "string",
            "example": "admin-id"
          },
          "requestedByUserId": {
            "type": "string",
            "example": "user-id"
          },
          "note": {
            "type": "string",
            "example": "Text describing the reason of the request."
          },
          "requestedByUserProfile": {
            "$ref": "#/components/schemas/UserProfile"
          },
          "type": {
            "$ref": "#/components/schemas/RequestType"
          },
          "requestedRole": {
            "type": "string",
            "example": "editor"
          }
        },
        "required": [
          "id",
          "status",
          "resourceId",
          "resourceType",
          "createdAt",
          "requestedByUserId"
        ]
      },
      "ResourceType": {
        "type": "string",
        "enum": [
          "organization",
          "project",
          "media-library",
          "canvas",
          "dashboard",
          "view",
          "knowledge-base"
        ],
        "example": "project",
        "description": "Resources are entities that can be managed and accessed through the\nAccess API.\n"
      },
      "Robot": {
        "type": "object",
        "description": "A robot is a service account that can be used to authenticate with the API.",
        "properties": {
          "id": {
            "type": "string",
            "description": "The unique identifier for the robot.",
            "readOnly": true
          },
          "tokenId": {
            "type": "string",
            "description": "The unique identifier for the active token.",
            "readOnly": true
          },
          "label": {
            "type": "string",
            "description": "A human-readable label for the robot."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "The creation date of the robot.",
            "readOnly": true
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the active token expires.",
            "readOnly": true
          },
          "lastSeenAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the robot was last used at the resource this request is scoped to. Updated about once an hour. Omitted if no use has been recorded since its current token was issued.\n",
            "readOnly": true
          },
          "managedBy": {
            "type": "object",
            "readOnly": true,
            "description": "The resource this token was created under. When this is an organization but the token is listed under a project, the token was created via the organization and should be managed there. Omitted for legacy tokens whose origin can't be determined.\n",
            "properties": {
              "resourceType": {
                "type": "string",
                "example": "organization"
              },
              "resourceId": {
                "type": "string",
                "example": "oeMyOrg"
              }
            },
            "required": [
              "resourceType",
              "resourceId"
            ]
          },
          "memberships": {
            "$ref": "#/components/schemas/Memberships"
          }
        },
        "required": [
          "id",
          "label",
          "createdAt",
          "memberships"
        ]
      },
      "RobotWithToken": {
        "type": "object",
        "allOf": [
          {
            "$ref": "#/components/schemas/Robot"
          }
        ],
        "properties": {
          "token": {
            "type": "string",
            "description": "The secret token for the robot. This value is returned only when\nthe token is created or rotated and cannot be retrieved again.\n",
            "readOnly": true
          }
        },
        "required": [
          "token"
        ]
      },
      "Invite": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/InviteStatus"
          },
          "resourceType": {
            "$ref": "#/components/schemas/ResourceType"
          },
          "resourceId": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "description": "The email address of the invitee. Only present if the invite is still pending.\n"
          },
          "inviterType": {
            "$ref": "#/components/schemas/InviterType"
          },
          "inviterId": {
            "type": "string",
            "description": "The ID of the user or service that created the invite. Only present if the invite was created by a user.\n"
          },
          "inviteeId": {
            "type": "string",
            "description": "The ID of the user that accepted the invite. Only present if the invite has been accepted.\n"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "status",
          "resourceType",
          "resourceId",
          "role",
          "inviterType",
          "createdAt",
          "updatedAt"
        ]
      },
      "InviteEligibility": {
        "type": "object",
        "properties": {
          "eligible": {
            "type": "boolean",
            "description": "Whether the current session passes the invite entry gate. `true`\nmeans the accept action may be offered. Note this reflects the SAML\nentry gate only: an eligible session can still be rejected at accept\ntime for other reasons (e.g. email-ownership validation).\n"
          },
          "reason": {
            "type": "string",
            "enum": [
              "resource-not-available",
              "saml-enforced"
            ],
            "description": "Present only when `eligible` is `false`, explaining why.\n- `resource-not-available`: the invited project/organization is not\n  available.\n- `saml-enforced`: the invited organization enforces SAML and the\n  session was not authenticated against that organization's identity\n  provider.\n"
          },
          "redirectUrl": {
            "type": "string",
            "description": "When not eligible with reason `saml-enforced`, the URL to send the\nuser to so they can log in through the organization's identity\nprovider. May be absent if the login URL could not be resolved.\n"
          }
        },
        "required": [
          "eligible"
        ]
      },
      "AccessRequestState": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "eligible",
              "saml-required",
              "resource-not-available",
              "requests-disabled",
              "already-member",
              "pending",
              "recently-declined",
              "saml-roles-managed",
              "temporarily-unavailable"
            ],
            "description": "Tells a client what to show before the user requests access. This is\nguidance, not permission. Creating the request and approving it run\nthe final checks, so do not assume a request will succeed.\n\nThe user can act on these results:\n- `eligible`: the client may offer the option to request access.\n- `saml-required`: normally, none of the user's linked SSO identities\n  matches an enabled provider for the organization. Send the user to\n  `redirectUrl` when present. If provider lookup failed, this state\n  can appear without a URL and does not confirm an identity match.\n\nThese results explain why the client should not offer a new request:\n- `resource-not-available`: the project or organization is not\n  available.\n- `requests-disabled`: the organization does not allow access\n  requests.\n- `already-member`: the user already has a directly assigned role on\n  this resource. An organization role implied by a project role does\n  not count as direct organization membership here.\n- `pending`: the user already has a pending request. `requestId`\n  identifies it.\n- `recently-declined`: the user's request was declined within the\n  last two weeks.\n- `saml-roles-managed`: the user has no directly assigned project\n  role, and a linked SSO provider is set to assign mapped project\n  roles on login. When `redirectUrl` is present, clients may offer\n  it to help the user sign in again through that provider. Signing\n  in does not guarantee a mapped role or access.\n- `temporarily-unavailable`: the service cannot currently advise a\n  request action.\n"
          },
          "redirectUrl": {
            "type": "string",
            "example": "https://www.sanity.io/login/sso/acme?origin=https%3A%2F%2Fwww.sanity.io%2Fmanage%2Fproject%2Fabc123",
            "description": "Present for `saml-required` when a login URL can be resolved, or for\n`saml-roles-managed` when the matched mapped provider supplies its\nlogin URL. Clients may offer it as a way to sign in; it may open a\nconfirmation page before the identity provider. A supplied\n`returnQuery` can be carried through login, but a return to the\nprevious page is not guaranteed. Signing in does not guarantee a\nmapped role or access.\n"
          },
          "providerName": {
            "type": "string",
            "description": "Present for `saml-roles-managed` when the provider has a name."
          },
          "requestId": {
            "type": "string",
            "description": "Present for `pending` and identifies the existing request."
          }
        },
        "required": [
          "state"
        ]
      },
      "InviteStatus": {
        "type": "string",
        "enum": [
          "pending",
          "accepted",
          "revoked"
        ]
      },
      "InviterType": {
        "type": "string",
        "enum": [
          "user",
          "service"
        ]
      },
      "UserProfile": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "familyName": {
            "type": "string"
          },
          "givenName": {
            "type": "string"
          },
          "middleName": {
            "type": [
              "string",
              "null"
            ]
          },
          "imageUrl": {
            "type": "string",
            "format": "uri"
          },
          "provider": {
            "type": "string"
          },
          "tosAcceptedAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "isCurrentUser": {
            "type": "boolean"
          },
          "providerId": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "displayName",
          "email",
          "provider",
          "createdAt"
        ]
      },
      "RequestType": {
        "type": "string",
        "enum": [
          "access",
          "role"
        ],
        "example": "access",
        "description": "The type of request."
      },
      "PaginatedResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Cursor to get the next page of results, `null` if there are no more results."
          }
        },
        "required": [
          "data",
          "nextCursor"
        ]
      },
      "UserPermission": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "The name of the permission.",
            "example": "sanity-project-members"
          },
          "type": {
            "type": "string",
            "description": "The type of the permission.",
            "example": "sanity.project.members"
          },
          "action": {
            "$ref": "#/components/schemas/PermissionAction",
            "example": "read"
          },
          "resourceType": {
            "$ref": "#/components/schemas/ResourceType",
            "example": "project"
          },
          "resourceId": {
            "type": "string",
            "example": "project-id"
          },
          "params": {
            "type": "object",
            "description": "The parameters for the permission. This is a key-value map of the permission's configuration.",
            "example": {
              "dataset": "development"
            }
          }
        },
        "required": [
          "name",
          "action",
          "resourceType",
          "resourceId"
        ]
      }
    },
    "requestBodies": {
      "CreateRobotRequestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "description": "A human-readable label for the robot.",
                  "example": "My Robot"
                },
                "expiresAt": {
                  "type": "string",
                  "format": "date-time",
                  "description": "When the token should expire.",
                  "example": "2030-01-01T00:00:00.000Z"
                },
                "memberships": {
                  "$ref": "#/components/schemas/Memberships"
                }
              },
              "required": [
                "label",
                "memberships"
              ]
            }
          }
        }
      },
      "CreateInviteRequestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "email": {
                  "type": "string"
                },
                "role": {
                  "type": "string"
                },
                "callbackUrl": {
                  "type": "string",
                  "format": "uri",
                  "description": "Where to send the invitee after they accept, such as `https://www.sanity.io/@oAbc/context`. Must be on the Sanity website (`https://www.sanity.io` or `https://sanity.io`)."
                }
              },
              "required": [
                "email",
                "role"
              ]
            }
          }
        }
      },
      "RoleRequestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "example": "Custom Role"
                },
                "name": {
                  "type": "string",
                  "pattern": "^[a-z0-9-_]+$",
                  "example": "custom-role"
                },
                "description": {
                  "type": "string",
                  "default": "",
                  "example": "Custom role for project"
                },
                "appliesToUsers": {
                  "type": "boolean",
                  "default": true
                },
                "appliesToRobots": {
                  "type": "boolean",
                  "default": true
                },
                "permissions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "description": "The name of the permission.",
                        "example": "legal-documents"
                      },
                      "action": {
                        "$ref": "#/components/schemas/PermissionAction"
                      },
                      "params": {
                        "type": "object",
                        "description": "The parameters for the permission. This is a key-value map of the permission's configuration.",
                        "example": {
                          "dataset": "development"
                        }
                      }
                    }
                  }
                }
              },
              "required": [
                "title",
                "name",
                "resourceType",
                "resourceId",
                "appliesToUsers",
                "appliesToRobots",
                "permissions"
              ]
            }
          }
        }
      },
      "PermissionRequestBody": {
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "type": {
                  "$ref": "#/components/schemas/PermissionType"
                },
                "name": {
                  "type": "string",
                  "description": "The name of the permission resource. A unique identifier for a permission.",
                  "example": "legal-documents"
                },
                "title": {
                  "type": "string",
                  "description": "A human-readable title of the permission resource. This is used for display purposes.",
                  "example": "Permission for \"Legal\" Folder"
                },
                "description": {
                  "type": "string",
                  "description": "The description of the permission resource.",
                  "example": "Permission for \"Legal\" Folder"
                },
                "config": {
                  "type": "object",
                  "description": "Some permissions allow for additional configuration when used with document permissions. Accepts a groq filter or a dataset name.",
                  "example": {
                    "filter": "*[_type == 'legal']"
                  }
                }
              },
              "required": [
                "type",
                "name",
                "title",
                "description"
              ]
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v2025-07-11/access/{resourceType}/{resourceId}/permissions": {
      "get": {
        "summary": "Get Permissions.",
        "description": "Gets the available permissions within the scope of a resource. These permissions can be applied to roles and are used to determine user/robot access to resources. <br /> <br /> Requires permission: `sanity.{resourceType}.roles.read`\n",
        "operationId": "getPermissions",
        "tags": [
          "Permissions"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/resourceTypeParam"
          },
          {
            "$ref": "#/components/parameters/resourceIdParam"
          },
          {
            "$ref": "#/components/parameters/cursorParam"
          },
          {
            "$ref": "#/components/parameters/limitParam"
          }
        ],
        "responses": {
          "200": {
            "description": "A paginated list of permission resources for the resource",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/PaginatedResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Permission"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Resource not found"
          }
        }
      },
      "post": {
        "summary": "Create a permission.",
        "description": "Creates a custom permission on a resource. <br /> <br /> Requires permission: `sanity.{resourceType}.roles.create` <br /> Requires feature: `advancedRolesManagement` <br /> <br /> See Example. It creates a permission to allow a user to read legal documents in project `c7ja4siy` and dataset `production`.\n",
        "operationId": "createPermission",
        "tags": [
          "Permissions"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/resourceTypeParam"
          },
          {
            "$ref": "#/components/parameters/resourceIdParam"
          }
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/PermissionRequestBody"
        },
        "responses": {
          "201": {
            "description": "Permission resource created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Permission"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/v2025-07-11/access/{resourceType}/{resourceId}/permissions/{permissionName}": {
      "get": {
        "summary": "Get a permission",
        "description": "Gets a permission for a resource by name. Requires permission\n  - `sanity.{resourceType}.roles.read`\n",
        "operationId": "getPermission",
        "tags": [
          "Permissions"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/resourceTypeParam"
          },
          {
            "$ref": "#/components/parameters/resourceIdParam"
          },
          {
            "$ref": "#/components/parameters/permissionNameParam"
          }
        ],
        "responses": {
          "200": {
            "description": "The permission resource for the resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Permission"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Resource not found"
          }
        }
      },
      "put": {
        "summary": "Update a permission",
        "description": "Updates a permission for a resource. Requires permission\n  - `sanity.{resourceType}.roles.update`\nRequires feature:\n  - `advancedRolesManagement`\n",
        "operationId": "updatePermission",
        "tags": [
          "Permissions"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/resourceTypeParam"
          },
          {
            "$ref": "#/components/parameters/resourceIdParam"
          },
          {
            "$ref": "#/components/parameters/permissionNameParam"
          }
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/PermissionRequestBody"
        },
        "responses": {
          "200": {
            "description": "Permission resource updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Permission"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Resource not found"
          }
        }
      },
      "delete": {
        "summary": "Delete a permission",
        "description": "Deletes a specific permission for a resource. Can only be used with custom permissions. Requires permission\n  - `sanity.{resourceType}.roles.delete`\nRequires feature:\n  - `advancedRolesManagement`\n",
        "operationId": "deletePermission",
        "tags": [
          "Permissions"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/resourceTypeParam"
          },
          {
            "$ref": "#/components/parameters/resourceIdParam"
          },
          {
            "$ref": "#/components/parameters/permissionNameParam"
          }
        ],
        "responses": {
          "200": {
            "description": "Permission deleted successfully"
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Resource not found"
          }
        }
      }
    },
    "/v2025-07-11/access/{resourceType}/{resourceId}/user-permissions/me": {
      "get": {
        "summary": "Get current user permissions.",
        "description": "Gets current user permissions within scope of a resource. These permissions can be applied to roles and are used to determine user/robot access to resources.\n",
        "operationId": "getUserPermissions",
        "tags": [
          "Permissions"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/resourceTypeParam"
          },
          {
            "$ref": "#/components/parameters/resourceIdParam"
          },
          {
            "$ref": "#/components/parameters/cursorParam"
          },
          {
            "$ref": "#/components/parameters/limitParam"
          }
        ],
        "responses": {
          "200": {
            "description": "A paginated list of permissions for all resources the current user has access to",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/PaginatedResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/UserPermission"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v2025-07-11/access/{resourceType}/{resourceId}/users": {
      "get": {
        "summary": "List all users of a resource and their assigned roles.",
        "description": "Retrieve a list of all users of a resource along with their assigned roles. When the resourceType is `organization`, this endpoint will return users of projects owned by the organization. Requires permission\n  - `sanity.{resourceType}.members.read`\n",
        "operationId": "getUsers",
        "tags": [
          "Users"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/resourceTypeParam"
          },
          {
            "$ref": "#/components/parameters/resourceIdParam"
          },
          {
            "$ref": "#/components/parameters/cursorParam"
          },
          {
            "$ref": "#/components/parameters/limitParam"
          },
          {
            "$ref": "#/components/parameters/includeImpliedRolesParam"
          },
          {
            "name": "sortBy",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Field by which to sort result. Currently supports field 'displayName'",
            "example": "displayName"
          },
          {
            "name": "orderBy",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "In which order to list results",
            "example": "desc"
          },
          {
            "name": "email",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Filter results based on `email` match"
          },
          {
            "name": "displayName",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Filter results based on `displayName` match"
          }
        ],
        "responses": {
          "200": {
            "description": "A paginated list of resource users and their assigned roles",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/PaginatedResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/User"
                          }
                        },
                        "totalCount": {
                          "type": "integer",
                          "description": "Total number of users available",
                          "example": 1
                        }
                      },
                      "required": [
                        "totalCount"
                      ]
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Resource not found"
          }
        }
      }
    },
    "/v2025-07-11/access/organization/{resourceId}/users/roles/default": {
      "put": {
        "summary": "Apply organization default role to all users.",
        "tags": [
          "Users"
        ],
        "description": "Add default role to all resource users. Limited to Organization. Requires permission\n  - `sanity.organization.members.update`\n",
        "operationId": "addDefaultRoleToUsers",
        "parameters": [
          {
            "$ref": "#/components/parameters/resourceIdParam"
          }
        ],
        "responses": {
          "201": {
            "description": "Roles assigned to the resource users"
          },
          "400": {
            "description": "Invalid input"
          },
          "404": {
            "description": "Resource not found"
          }
        }
      }
    },
    "/v2025-07-11/access/{resourceType}/{resourceId}/users/{sanityUserId}": {
      "get": {
        "summary": "Get user and roles.",
        "description": "Get the users for a single user of a resource. Requires permission - `sanity.{resourceType}.members.read`",
        "operationId": "getUser",
        "tags": [
          "Users"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/resourceTypeParam"
          },
          {
            "$ref": "#/components/parameters/resourceIdParam"
          },
          {
            "$ref": "#/components/parameters/sanityUserIdParam"
          },
          {
            "$ref": "#/components/parameters/includeImpliedRolesParam"
          }
        ],
        "responses": {
          "200": {
            "description": "Get resource user and their roles.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "404": {
            "description": "Resource not found"
          }
        }
      },
      "delete": {
        "summary": "Remove a user from a resource.",
        "description": "This removes all roles. If the resourceType is `organization`, this will also remove the user from all projects owned by the organization. Requires permission\n  - `sanity.{resourceType}.members.delete`\n",
        "operationId": "removeUser",
        "tags": [
          "Users"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/resourceTypeParam"
          },
          {
            "$ref": "#/components/parameters/resourceIdParam"
          },
          {
            "$ref": "#/components/parameters/sanityUserIdParam"
          }
        ],
        "responses": {
          "200": {
            "description": "User removed from the resource"
          },
          "400": {
            "description": "Invalid input"
          },
          "404": {
            "description": "Resource not found"
          }
        }
      }
    },
    "/v2025-07-11/access/{resourceType}/{resourceId}/users/me": {
      "delete": {
        "summary": "Remove own user from a resource.",
        "description": "This removes the currently authenticated user from the given resource. If the resourceType is `organization`, this will also remove the user from all projects owned by the organization. This is a specific route which does not require resource permissions, since users should be able to remove themselves from resources without requiring an administrator to intervene for them.\n",
        "operationId": "removeOwnUser",
        "tags": [
          "Users"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/resourceTypeParam"
          },
          {
            "$ref": "#/components/parameters/resourceIdParam"
          }
        ],
        "responses": {
          "200": {
            "description": "User removed from the resource"
          },
          "400": {
            "description": "Invalid input"
          },
          "404": {
            "description": "Resource not found"
          }
        }
      }
    },
    "/v2025-07-11/access/{resourceType}/{resourceId}/users/{sanityUserId}/roles": {
      "put": {
        "summary": "Replace the role set for a user.",
        "description": "Replace the role set for a user on a resource. The supplied `roleNames` become the user's complete role set: missing roles are added, extra roles are removed. The list must contain at least one role: at least one role must remain assigned at all times. Roles are assigned before extras are revoked so the user never momentarily drops to zero roles.\nA single composite `members.role.replace` activity event is emitted per call (no per-role events).\nRequires permission\n  - `sanity.{resourceType}.members.update`\n",
        "operationId": "replaceRolesForUser",
        "tags": [
          "Users"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/resourceTypeParam"
          },
          {
            "$ref": "#/components/parameters/resourceIdParam"
          },
          {
            "$ref": "#/components/parameters/sanityUserIdParam"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "roleNames"
                ],
                "properties": {
                  "roleNames": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User's role set updated"
          },
          "400": {
            "description": "Invalid input"
          },
          "403": {
            "description": "Forbidden (admin required for restricted roles)"
          },
          "404": {
            "description": "Resource not found"
          },
          "409": {
            "description": "Role assignments are managed via SAML"
          }
        }
      }
    },
    "/v2025-07-11/access/{resourceType}/{resourceId}/users/{sanityUserId}/roles/{roleName}": {
      "put": {
        "summary": "Add a role to a user.",
        "description": "Add a role to a user. Requires permission\n  - `sanity.{resourceType}.members.update`\n",
        "operationId": "addRoleToUser",
        "tags": [
          "Users"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/resourceTypeParam"
          },
          {
            "$ref": "#/components/parameters/resourceIdParam"
          },
          {
            "$ref": "#/components/parameters/sanityUserIdParam"
          },
          {
            "$ref": "#/components/parameters/roleNameParam"
          }
        ],
        "responses": {
          "201": {
            "description": "Role assigned to the user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "404": {
            "description": "Resource not found"
          },
          "409": {
            "description": "Role assignments are managed via SAML"
          }
        }
      },
      "delete": {
        "summary": "Remove a role from a user in a resource.",
        "description": "You cannot remove the last role from a user. You must have at least one role assigned to a user. Requires permission\n  - `sanity.{resourceType}.members.update`\n",
        "operationId": "removeRoleFromUser",
        "tags": [
          "Users"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/resourceTypeParam"
          },
          {
            "$ref": "#/components/parameters/resourceIdParam"
          },
          {
            "$ref": "#/components/parameters/sanityUserIdParam"
          },
          {
            "$ref": "#/components/parameters/roleNameParam"
          }
        ],
        "responses": {
          "200": {
            "description": "Role removed from user"
          },
          "400": {
            "description": "Invalid input"
          },
          "404": {
            "description": "Resource not found"
          },
          "409": {
            "description": "Role assignments are managed via SAML"
          }
        }
      }
    },
    "/v2025-07-11/access/{resourceType}/{resourceId}/roles": {
      "get": {
        "summary": "List roles assignable to a user on this resource.",
        "description": "Requires permission\n  - `sanity.{resourceType}.roles.read`\n",
        "operationId": "getRoles",
        "tags": [
          "Roles"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/resourceTypeParam"
          },
          {
            "$ref": "#/components/parameters/resourceIdParam"
          },
          {
            "$ref": "#/components/parameters/includeChildrenParam"
          },
          {
            "$ref": "#/components/parameters/cursorParam"
          },
          {
            "$ref": "#/components/parameters/limitParam"
          },
          {
            "$ref": "#/components/parameters/includeImpliedRolesParam"
          }
        ],
        "responses": {
          "200": {
            "description": "A paginated list of roles for a resource",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/PaginatedResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Role"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a role",
        "description": "Requires permission:\n  - `sanity.{resourceType}.roles.create`\nRequires feature:\n  - `advancedRolesManagement`\n",
        "operationId": "createRole",
        "tags": [
          "Roles"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/resourceTypeParam"
          },
          {
            "$ref": "#/components/parameters/resourceIdParam"
          }
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/RoleRequestBody"
        },
        "responses": {
          "201": {
            "description": "Role created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Role"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Resource not found"
          }
        }
      }
    },
    "/v2025-07-11/access/{resourceType}/{resourceId}/roles/{roleName}": {
      "get": {
        "summary": "Get a role",
        "description": "Requires permission\n  - `sanity.{resourceType}.roles.read`\n",
        "operationId": "getRole",
