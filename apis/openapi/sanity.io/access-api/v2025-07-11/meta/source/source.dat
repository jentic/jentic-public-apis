            "$ref": "#/components/parameters/inviteStatus"
          },
          {
            "$ref": "#/components/parameters/resourceTypeParam"
          },
          {
            "$ref": "#/components/parameters/cursorParam"
          },
          {
            "$ref": "#/components/parameters/limitParam"
          }
        ],
        "responses": {
          "200": {
            "description": "A paginated list of invites",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/PaginatedResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Invite"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/forbidden"
          },
          "404": {
            "$ref": "#/components/responses/resourceNotFound"
          }
        }
      }
    },
    "/v2025-07-11/access/{resourceType}/{resourceId}/invites": {
      "get": {
        "tags": [
          "Invites"
        ],
        "operationId": "getInvites",
        "summary": "Get invites",
        "description": "Retrieves a list of invites for the specified resource.\n\nOnly pending invites are retrieved by default. Use the optional `status`\nparameter to change the filter behavior. You can select multiple\nstatuses by repeating the parameter.\n\n### Children invites\n\nBy default, only invites for the specified resource are returned. Use the\noptional `includeChildren` parameter to include invites for children\nresources as well. This only applies to `organization` resources.\n\n### Authorization\n\nThis endpoint requires an authenticated user session with the following\npermissions:\n- `sanity.{resourceType}.members.read`\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/resourceTypeParam"
          },
          {
            "$ref": "#/components/parameters/resourceIdParam"
          },
          {
            "$ref": "#/components/parameters/inviteStatus"
          },
          {
            "$ref": "#/components/parameters/includeChildrenParam"
          },
          {
            "$ref": "#/components/parameters/cursorParam"
          },
          {
            "$ref": "#/components/parameters/limitParam"
          }
        ],
        "responses": {
          "200": {
            "description": "A paginated list of invites",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/PaginatedResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Invite"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/forbidden"
          },
          "404": {
            "$ref": "#/components/responses/resourceNotFound"
          }
        }
      },
      "post": {
        "tags": [
          "Invites"
        ],
        "operationId": "createInvite",
        "summary": "Create invite",
        "description": "Creates an invite for the specified resource.\n\nThe invitee will receive an email with a link to accept the invite.\n\nEach invitee can only receive one invite per resource and role.\nAttempting to create an invite using a non-existent role, or a role that\ncannot be granted to users will result in a Bad Request error.\n\n### Unavailable resources\n\nIf the underlying resource is unavailable then a Bad Request error will\nbe returned. A common example of an unavailable resource is a project\nthat is blocked or archived.\n\n### Authorization\n\nThis endpoint requires an authenticated user session with the following\npermissions:\n- `sanity.{resourceType}.members.invite`\n\nAdditionally, only administrators can invite other administrators.\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/resourceTypeParam"
          },
          {
            "$ref": "#/components/parameters/resourceIdParam"
          }
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/CreateInviteRequestBody"
        },
        "responses": {
          "201": {
            "description": "Invite created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Invite"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/badRequest"
          },
          "401": {
            "$ref": "#/components/responses/unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/forbidden"
          },
          "404": {
            "$ref": "#/components/responses/resourceNotFound"
          }
        }
      }
    },
    "/v2025-07-11/access/{resourceType}/{resourceId}/invites/{inviteId}": {
      "delete": {
        "tags": [
          "Invites"
        ],
        "operationId": "revokeInvite",
        "summary": "Revoke invite",
        "description": "Revokes an invite.\n\nAttempting to revoke an invite that has already been accepted or revoked\nwill result in a Bad Request error.\n\n### Authorization\n\nThis endpoint requires an authenticated user session with the following\npermissions:\n- `sanity.{resourceType}.members.invite`\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/resourceTypeParam"
          },
          {
            "$ref": "#/components/parameters/resourceIdParam"
          },
          {
            "$ref": "#/components/parameters/inviteId"
          }
        ],
        "responses": {
          "204": {
            "description": "Invite revoked."
          },
          "400": {
            "$ref": "#/components/responses/badRequest"
          },
          "401": {
            "$ref": "#/components/responses/unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/forbidden"
          },
          "404": {
            "description": "Resource or invite not found."
          }
        }
      }
    },
    "/v2025-07-11/access/{resourceType}/{resourceId}/invites/token/{inviteToken}": {
      "get": {
        "tags": [
          "Invites"
        ],
        "operationId": "getInviteByToken",
        "summary": "Get invite",
        "description": "Retrieves an invite using its token.\n\n### Authorization\n\nThis endpoint does not require authentication.\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/resourceTypeParam"
          },
          {
            "$ref": "#/components/parameters/resourceIdParam"
          },
          {
            "$ref": "#/components/parameters/inviteToken"
          }
        ],
        "responses": {
          "200": {
            "description": "Invite found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Invite"
                }
              }
            }
          },
          "404": {
            "description": "Resource or invite not found."
          }
        }
      }
    },
    "/v2025-07-11/access/{resourceType}/{resourceId}/invites/token/{inviteToken}/accept": {
      "post": {
        "tags": [
          "Invites"
        ],
        "operationId": "acceptInvite",
        "summary": "Accept invite",
        "description": "Accepts an invite using its token.\n\nAttempting to accept an invite that is already accepted or revoked will\nresult in a Bad Request error.\n\nOnce the invite has been accepted, the user will have access to the\nresource with the role assigned as part of the invitation.\n\n> **Access is propagated internally and may take a up to a few minutes to\n> be fully available across all systems.**\n\n### Unavailable resources\n\nIf the underlying resource is unavailable then a Bad Request error will\nbe returned. A common example of an unavailable resource is a project\nthat is blocked or archived.\n\n### Member quota\n\nSome resources have a limit on the number of members. If accepting an\ninvite would go over this limit, then a Payment Required error is\nreturned.\n\n### Authorization\n\nThis endpoint requires an authenticated user session.\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/resourceTypeParam"
          },
          {
            "$ref": "#/components/parameters/resourceIdParam"
          },
          {
            "$ref": "#/components/parameters/inviteToken"
          }
        ],
        "responses": {
          "204": {
            "description": "Invite accepted."
          },
          "400": {
            "$ref": "#/components/responses/badRequest"
          },
          "401": {
            "$ref": "#/components/responses/unauthorized"
          },
          "402": {
            "description": "Resource reached its allowed number of members."
          },
          "403": {
            "$ref": "#/components/responses/forbidden"
          },
          "404": {
            "description": "Resource or invite not found."
          }
        }
      }
    },
    "/v2025-07-11/access/{resourceType}/{resourceId}/invites/token/{inviteToken}/eligibility": {
      "get": {
        "tags": [
          "Invites"
        ],
        "operationId": "checkInviteEligibility",
        "summary": "Check invite eligibility",
        "description": "Preflight check for the invite-acceptance page: reports whether the\ncurrent session passes the invite entry gate, without mutating anything.\n\nWhen the invited organization enforces SAML and the session was not\nauthenticated against that organization's identity provider, the\nresponse is `eligible: false` with `reason: saml-enforced` and a\n`redirectUrl` pointing at the organization's login page. Clients should\nredirect there instead of offering the accept action.\n\nThis is a preflight for the SAML entry gate only. `eligible: true` does\nnot guarantee the accept will succeed: the accept path may still reject\nthe session for other reasons (e.g. email-ownership validation).\n\n### Authorization\n\nThis endpoint requires an authenticated user session.\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/resourceTypeParam"
          },
          {
            "$ref": "#/components/parameters/resourceIdParam"
          },
          {
            "$ref": "#/components/parameters/inviteToken"
          },
          {
            "name": "returnQuery",
            "in": "query",
            "required": false,
            "description": "The caller's own query string, URL-encoded as a single value. It is\ncarried through to the login page so the user returns to the invite\nafter authenticating.\n",
            "schema": {
              "type": "string"
            },
            "example": "origin=https%3A%2F%2Fwww.sanity.io%2Fmanage%2Finvite%2Fabc123"
          }
        ],
        "responses": {
          "200": {
            "description": "Eligibility resolved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InviteEligibility"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/badRequest"
          },
          "401": {
            "$ref": "#/components/responses/unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/forbidden"
          },
          "404": {
            "description": "Resource not found, or no invite matches the token for this resource."
          }
        }
      }
    },
    "/v2025-07-11/access/{resourceType}/{resourceId}/robots": {
      "get": {
        "tags": [
          "Robots"
        ],
        "operationId": "getRobots",
        "summary": "Get robots with access to this resource",
        "description": "Retrieves a list of robots that have access to the specified resource.\n\n### Access to children resources\n\nBy default, this endpoint returns robots that have at least one role on\nthe specified resource. Use the optional `includeChildren` parameter to\ninclude robots that have a role on children resources as well. This\nonly applies to `organization` resources.\n\n### Authorization\n\nThis endpoint requires an authenticated user session with the following\npermissions:\n- `sanity.{resourceType}.tokens.read`\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/resourceTypeParam"
          },
          {
            "$ref": "#/components/parameters/resourceIdParam"
          },
          {
            "$ref": "#/components/parameters/includeChildrenParam"
          },
          {
            "$ref": "#/components/parameters/cursorParam"
          },
          {
            "$ref": "#/components/parameters/limitParam"
          }
        ],
        "responses": {
          "200": {
            "description": "A paginated list of robots",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/PaginatedResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Robot"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/badRequest"
          },
          "401": {
            "$ref": "#/components/responses/unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/resourceNotFound"
          }
        }
      },
      "post": {
        "tags": [
          "Robots"
        ],
        "operationId": "createRobot",
        "summary": "Create robot and associated token",
        "description": "Creates a robot with the specified role grants and returns its secret\ntoken.\n\nOnly the specified resource and its children resources can be specified\nin the role grants. The robot will not have access to other resources.\n\n### Secret token\n\nThe secret token is returned only once and cannot be retrieved again.\nIf it is compromised, the token holder can replace it through the\nself-service rotate endpoint. If it is lost, create a replacement robot\nand delete this one.\n\n### Email notifications\n\nFor project robots, an email notification is sent to all project administrators\nby default when a robot is created. This can be disabled by setting\n`sendNotification=false`, but only for projects created within the last 5 minutes.\n\n### Authorization\n\nThis endpoint requires an authenticated user session with the following\npermissions:\n- `sanity.{resourceType}.tokens.create`\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/resourceTypeParam"
          },
          {
            "$ref": "#/components/parameters/resourceIdParam"
          },
          {
            "name": "sendNotification",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true
            },
            "description": "Whether to send email notification to administrators when creating project robots.\nOnly applies to project resource types. Can be set to false for projects created within the last 5 minutes.\n",
            "example": true
          }
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/CreateRobotRequestBody"
        },
        "responses": {
          "201": {
            "description": "Robot created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RobotWithToken"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/badRequest"
          },
          "401": {
            "$ref": "#/components/responses/unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/resourceNotFound"
          }
        }
      }
    },
    "/v2025-07-11/access/{resourceType}/{resourceId}/robots/{robotId}": {
      "get": {
        "tags": [
          "Robots"
        ],
        "operationId": "getRobot",
        "summary": "Get robot metadata",
        "description": "Retrieves a robot using its unique identifier.\n\nIt's not possible to retrieve a robot token.\n\n### Authorization\n\nThis endpoint requires an authenticated user session with the following\npermissions:\n- `sanity.{resourceType}.tokens.read`\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/resourceTypeParam"
          },
          {
            "$ref": "#/components/parameters/resourceIdParam"
          },
          {
            "$ref": "#/components/parameters/robotIdParam"
          }
        ],
        "responses": {
          "200": {
            "description": "Robot found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Robot"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/badRequest"
          },
          "401": {
            "$ref": "#/components/responses/unauthorized"
          },
          "404": {
            "description": "Resource or robot not found."
          }
        }
      },
      "put": {
        "tags": [
          "Robots"
        ],
        "operationId": "updateRobot",
        "summary": "Update robot token",
        "description": "Updates the expiry date for a robot token.\n\n### Authorization\n\nThis endpoint requires an authenticated user session with the following\npermissions:\n- `sanity.{resourceType}.tokens.create`\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/resourceTypeParam"
          },
          {
            "$ref": "#/components/parameters/resourceIdParam"
          },
          {
            "$ref": "#/components/parameters/robotIdParam"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "expiresAt": {
                    "type": "string",
                    "format": "date-time",
                    "description": "When the robot token should expire.",
                    "example": "2030-01-01T00:00:00.000Z"
                  }
                },
                "required": [
                  "expiresAt"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Robot token expiry updated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Robot"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/badRequest"
          },
          "401": {
            "$ref": "#/components/responses/unauthorized"
          },
          "404": {
            "description": "Resource, robot, or token not found."
          }
        }
      },
      "delete": {
        "tags": [
          "Robots"
        ],
        "operationId": "deleteRobot",
        "summary": "Revoke robot token and delete robot",
        "description": "Permanently revokes the robot's active token and deletes the robot.\nAfter this operation succeeds, the token can no longer authenticate.\n\n### Authorization\n\nThis endpoint requires an authenticated session with the following\npermissions:\n- `sanity.{resourceType}.tokens.delete`\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/resourceTypeParam"
          },
          {
            "$ref": "#/components/parameters/resourceIdParam"
          },
          {
            "$ref": "#/components/parameters/robotIdParam"
          }
        ],
        "responses": {
          "204": {
            "description": "Robot token revoked and robot deleted."
          },
          "400": {
            "$ref": "#/components/responses/badRequest"
          },
          "401": {
            "$ref": "#/components/responses/unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/forbidden"
          },
          "404": {
            "description": "Resource or robot not found."
          }
        }
      }
    },
    "/v2025-07-11/access/robots/me": {
      "delete": {
        "tags": [
          "Robots"
        ],
        "operationId": "revokeCurrentRobotToken",
        "summary": "Revoke current robot token",
        "description": "Revokes the robot token supplied in the `Authorization` header and\ndeletes its associated robot. No resource or robot identifier is\nrequired.\n\nFor a robot token the operation is idempotent: once the first\ncall has deleted the robot, cleared its roles and invalidated its\nsessions, a subsequent call is still `204`.\n\nThis endpoint is rate limited. See the `429` response for details.\n",
        "security": [
          {
            "robotTokenAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Robot token revoked, or the robot was already revoked."
          },
          "400": {
            "$ref": "#/components/responses/badRequest"
          },
          "401": {
            "description": "No token was presented."
          },
          "403": {
            "description": "The token does not belong to a robot."
          },
          "429": {
            "$ref": "#/components/responses/tooManyRequests"
          }
        }
      }
    },
    "/v2025-07-11/access/robots/me/rotate": {
      "post": {
        "tags": [
          "Robots"
        ],
        "operationId": "rotateCurrentRobotToken",
        "summary": "Rotate current robot token",
        "description": "Replaces the robot token supplied in the `Authorization` header while\npreserving the robot, its roles, and the token's expiration. No\nresource or robot identifier is required.\n\nThere is no overlap period. After this operation succeeds, the previous\ntoken is revoked and clients must use the new token. The new secret is\nreturned only in this response and cannot be retrieved again.\n\nRotation replaces exactly the token that authenticated the request.\n\nThis endpoint is rate limited. See the `429` response for details.\n",
        "security": [
          {
            "robotTokenAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Robot token rotated.",
            "headers": {
              "Cache-Control": {
                "description": "Prevents caching of the one-time token secret.",
                "schema": {
                  "type": "string",
                  "example": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RobotWithToken"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/badRequest"
          },
          "401": {
            "description": "The presented token is not valid: it identifies no active robot or no live session, for example because the robot was already revoked or the session was destroyed by a concurrent revoke or rotate. Unlike revocation, rotation is not idempotent — there is no token left to replace, so clients should re-authenticate with their current token."
          },
          "403": {
            "description": "The token does not belong to a robot."
          },
          "429": {
            "$ref": "#/components/responses/tooManyRequests"
          },
          "502": {
            "description": "Sanity Functions could not verify or update the managed token."
          }
        }
      }
    },
    "/v2025-07-11/access/{resourceType}/{resourceId}/user-permissions/me/check": {
      "get": {
        "tags": [
          "Permissions"
        ],
        "operationId": "checkUserPermissions",
        "summary": "Check if current user has specified permissions",
        "description": "Checks if the current user has the specified permissions for the given resource.\nReturns an object mapping each requested permission to a boolean indicating whether the user has that permission.\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/resourceTypeParam"
          },
          {
            "$ref": "#/components/parameters/resourceIdParam"
          },
          {
            "name": "permissions",
            "in": "query",
            "required": true,
            "description": "An array of permissions to check",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "example": [
                "sanity.project.members.read",
                "sanity.project.members.invite"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Map of permissions to whether the user has them",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "boolean"
                      },
                      "example": {
                        "sanity.project.members.read": true,
                        "sanity.project.members.invite": false
                      }
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/badRequest"
          },
          "401": {
            "$ref": "#/components/responses/unauthorized"
          }
        }
      }
    }
  }
}