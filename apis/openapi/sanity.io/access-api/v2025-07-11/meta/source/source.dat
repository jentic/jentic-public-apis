          "sanity.knowledge-base",
          "sanity.knowledge-base.entries",
          "sanity.knowledge-base.issues",
          "sanity.knowledge-base.instructions",
          "sanity.media-library",
          "sanity.media-library.aspects",
          "sanity.media-library.asset-instances",
          "sanity.media-library.asset-management",
          "sanity.media-library.assets",
          "sanity.media-library.members",
          "sanity.media-library.signed-url",
          "sanity.media-library.hierarchy",
          "sanity.media-library.roles",
          "sanity.media-library.document.filter",
          "sanity.organization",
