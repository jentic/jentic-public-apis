{
  "openapi": "3.1.1",
  "info": {
    "title": "Embeddings Index API",
    "description": "The Embeddings Index API allows you to create, manage, and query embeddings indexes for semantic search in your Sanity project. [Learn more about embeddings indexes](https://www.sanity.io/docs/embeddings-index-api-overview).\n\nEmbeddings Index API is currently in beta. Features and behavior may change without notice.\nEmbeddings Index API is available to projects on the Growth plan and above.\n\nNote: Using this feature requires Sanity to send data to OpenAI and Pinecone to store vector interpretations of documents.\n\nKnown limitations:\n- Creating an embeddings index for very large datasets can be slow\n- The Embeddings Index HTTP API rate limit depends on the OpenAI rate limit, which sets a cap for the HTTP API at about 8,000 tokens per minute\n- The embeddings-index API does not support dataset aliases - you must use the real dataset name in all requests\n",
    "version": "v2024-06-24",
    "x-jentic-source-url": "https://www.sanity.io/docs/api/openapi/embeddings-index?format=json"
  },
  "servers": [
    {
      "url": "https://{projectId}.api.sanity.io/{apiVersion}",
      "description": "Embeddings Index API base URL",
      "variables": {
        "apiVersion": {
          "default": "vX",
          "description": "API version"
        },
        "projectId": {
          "default": "your-project-id",
          "description": "Sanity project ID"
        }
      }
    }
  ],
  "paths": {
    "/embeddings-index/{dataset}": {
      "parameters": [
        {
          "name": "dataset",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          },
          "description": "The name of the dataset to use for the request"
        }
      ],
      "get": {
        "summary": "Get all embeddings indexes",
        "description": "Retrieve a list of all embeddings indexes for the specified dataset",
        "deprecated": true,
        "responses": {
          "200": {
            "description": "The list of embeddings indexes was successfully retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "status": {
                        "type": "string",
                        "enum": [
                          "active"
                        ]
                      },
                      "indexName": {
                        "type": "string"
                      },
                      "projectId": {
                        "type": "string"
                      },
                      "dataset": {
                        "type": "string"
                      },
                      "projection": {
                        "type": "string"
                      },
                      "filter": {
                        "type": "string"
                      },
                      "createdAt": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "updatedAt": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "failedDocumentCount": {
                        "type": "integer"
                      },
                      "startDocumentCount": {
                        "type": "integer"
                      },
                      "remainingDocumentCount": {
                        "type": "integer"
                      },
                      "webhookId": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "The target dataset doesn't exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create an embeddings index",
        "description": "Create a new embeddings index for an existing dataset in a Sanity project",
        "deprecated": true,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "projection",
                  "filter",
                  "indexName"
                ],
                "properties": {
                  "indexName": {
                    "type": "string",
                    "description": "The name of the embeddings index you want to create"
                  },
                  "projection": {
                    "type": "string",
                    "description": "The GROQ projection that defines which fields to include in the embeddings index.\nIf you don't include a projection, we process the entire document JSON into a less verbose format and embed all of it.\nExample: \"{title, author}\" or \"{...}\" for all fields\n"
                  },
                  "filter": {
                    "type": "string",
                    "description": "The GROQ filter that defines which documents to include in the embeddings index.\nThe filter must be a valid GROQ filter without the square brackets that wrap the value assigned to _type.\nExample: \"_type=='movie'\" or \"_type in ['article', 'blogPost']\"\n"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The embeddings index was successfully created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateEmbeddingsIndexResponse"
                }
              }
            }
          },
          "400": {
            "description": "The target dataset doesn't exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Invalid or missing bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "statusCode": 401,
                    "message": "Unauthorized"
                  }
                }
              }
            }
          },
          "429": {
            "description": "Too many requests - Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": {
                    "statusCode": 429,
                    "message": "Rate limit exceeded"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/embeddings-index/{dataset}/{indexName}": {
      "parameters": [
        {
          "name": "dataset",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          },
          "description": "The name of the dataset associated with the index"
        },
        {
          "name": "indexName",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          },
          "description": "The name of the embeddings index"
        }
      ],
      "get": {
        "summary": "Get an embeddings index",
        "description": "Retrieve a specific embeddings index for an existing database in a Sanity project",
        "deprecated": true,
        "responses": {
          "200": {
            "description": "The embeddings index was successfully retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmbeddingsIndex"
                }
              }
            }
          },
          "400": {
            "description": "The target dataset doesn't exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "The requested embeddings index doesn't exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete an embeddings index",
        "description": "Delete a specific embeddings index for an existing database in a Sanity project",
        "deprecated": true,
        "responses": {
          "200": {
            "description": "The embeddings index was successfully deleted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmbeddingsIndex"
                }
              }
            }
          },
          "400": {
            "description": "The target dataset doesn't exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "The requested embeddings index doesn't exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/embeddings-index/query/{dataset}/{indexName}": {
      "parameters": [
        {
          "name": "dataset",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          },
          "description": "The name of the dataset where you want to query the embeddings index"
        },
        {
          "name": "indexName",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          },
          "description": "The name of the embeddings index you want to query"
        }
      ],
      "post": {
        "summary": "Query an embeddings index",
        "description": "Query an embeddings index to retrieve documents that are closely related to the input query",
        "deprecated": true,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "query"
                ],
                "properties": {
                  "query": {
                    "type": "string",
                    "description": "The text string used to query the embeddings index"
                  },
                  "maxResults": {
                    "type": "integer",
                    "default": 10,
                    "description": "Max. number of results to return for each request"
                  },
                  "filter": {
                    "type": "object",
                    "description": "Optional filter to refine search results by document type.\nThis allows you to limit the search to specific document types, which can be useful when you have multiple document types in your index.\nYou can specify either a single document type as a string or an array of document types.\n",
                    "properties": {
                      "type": {
                        "oneOf": [
                          {
                            "type": "string",
                            "description": "A single document type to filter by",
                            "example": "movie"
                          },
                          {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "description": "An array of document types to filter by",
                            "example": [
                              "movie",
                              "tvShow",
                              "documentary"
                            ]
                          }
                        ],
                        "description": "Filter results to include only documents of the specified type(s)"
                      }
                    }
                  }
                }
              },
              "example": {
                "query": "sci-fi adventure with cowboys and aliens",
                "maxResults": 10,
                "filter": {
                  "type": [
                    "summary",
                    "synopsis",
                    "userReview"
                  ]
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The query was successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryEmbeddingsIndexResponse"
                }
              }
            }
          },
          "400": {
            "description": "The target dataset doesn't exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "The queried embeddings index doesn't exist or the query returns no relevant matches",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Bearer token authentication"
      }
    },
    "schemas": {
      "EmbeddingsIndex": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "active"
            ]
          },
          "indexName": {
            "type": "string"
          },
          "projectId": {
            "type": "string"
          },
          "dataset": {
            "type": "string"
          },
          "projection": {
            "type": "string"
          },
          "filter": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "failedDocumentCount": {
            "type": "integer"
          },
          "startDocumentCount": {
            "type": "integer"
          },
          "remainingDocumentCount": {
            "type": "integer"
          },
          "webhookId": {
            "type": "string"
          }
        },
        "example": {
          "status": "active",
          "indexName": "embeddings-index-movies",
          "projectId": "ab2cdefg",
          "dataset": "my-movies",
          "projection": "{...}",
          "filter": "_type=='movie'",
          "createdAt": "2023-09-15T12:27:55Z",
          "updatedAt": "2023-09-15T12:28:21Z",
          "failedDocumentCount": 0,
          "startDocumentCount": 19,
          "remainingDocumentCount": 0,
          "webhookId": "abcdefghI7jKKl1P"
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "statusCode": {
                "type": "integer"
              },
              "message": {
                "type": "string"
              }
            }
          }
        },
        "example": {
          "error": {
            "statusCode": 400,
            "message": "Dataset not found"
          }
        }
      },
      "CreateEmbeddingsIndexResponse": {
        "type": "object",
        "required": [
          "status",
          "message",
          "index"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "message": {
            "type": "string"
          },
          "index": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "pending"
                ]
              },
              "indexName": {
                "type": "string"
              },
              "projectId": {
                "type": "string"
              },
              "dataset": {
                "type": "string"
              },
              "projection": {
                "type": "string"
              },
              "filter": {
                "type": "string"
              },
              "createdAt": {
                "type": "string",
                "format": "date-time"
              },
              "updatedAt": {
                "type": "string",
                "format": "date-time"
              },
              "failedDocumentCount": {
                "type": "integer"
              },
              "startDocumentCount": {
                "type": "integer"
              },
              "remainingDocumentCount": {
                "type": "integer"
              },
              "webhookId": {
                "type": "string"
              }
            }
          }
        },
        "example": {
          "status": "ok",
          "message": "Index created. Documents enqueued for indexing.",
          "index": {
            "status": "pending",
            "indexName": "embeddings-index-movies",
            "projectId": "ab2cdefg",
            "dataset": "my-movies",
            "projection": "{...}",
            "filter": "_type=='movie'",
            "createdAt": "2023-09-15T12:27:55Z",
            "updatedAt": "2023-09-15T12:27:55Z",
            "failedDocumentCount": 0,
            "startDocumentCount": 19,
            "remainingDocumentCount": 19,
            "webhookId": "abcdefghI7jKKl1P"
          }
        }
      },
      "QueryEmbeddingsIndexResponse": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "score",
            "value"
          ],
          "properties": {
            "score": {
              "type": "number",
              "description": "Relevance score between 0 and 1"
            },
            "value": {
              "type": "object",
              "required": [
                "documentId",
                "type"
              ],
              "properties": {
                "documentId": {
                  "type": "string",
                  "format": "uuid",
                  "description": "The UUID of the matching document"
                },
                "type": {
                  "type": "string",
                  "description": "The type of the matching document"
                }
              }
            }
          }
        },
        "example": [
          {
            "score": 1,
            "value": {
              "documentId": "85803a29-fe3f-44ba-9c0f-9a40239fd735",
              "type": "synopsis"
            }
          }
        ]
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ]
}