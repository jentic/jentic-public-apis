{
  "openapi": "3.1.1",
  "info": {
    "title": "Listen HTTP Endpoint",
    "version": "2025-02-19",
    "description": "Use the listen endpoint to receive events whenever documents are modified. This endpoint follows the server-sent events protocol using the MIME type `text/event-stream`. The backend holds the connection open and streams events as they occur for any documents matching the GROQ query.\nIn most cases, you should use the [Live Content API](https://www.sanity.io/docs/http-reference/live) instead for new projects.\n"
  },
  "servers": [
    {
      "url": "https://{projectId}.api.sanity.io/{apiVersion}",
      "description": "Sanity API base URL",
      "variables": {
        "projectId": {
          "default": "projectId",
          "description": "Project ID"
        },
        "apiVersion": {
          "default": "v2025-02-19",
          "description": "API version"
        }
      }
    }
  ],
  "security": [
    {},
    {
      "BearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Optional for public datasets. Required to receive events for drafts, versions, or documents in private datasets."
      }
    },
    "schemas": {
      "SSEMessage": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "A unique ID for this event. Treat it as an opaque string. For `mutation` events, it starts with the transaction ID and the document ID (`transactionId#documentId`) and may be followed by `@` and an encoded stream position. When `enableResume` is true, send the last ID you received as the `Last-Event-ID` header to resume from that event."
          },
          "event": {
            "type": "string",
            "enum": [
              "welcome",
              "welcomeback",
              "reset",
              "mutation",
              "channelError",
              "disconnect"
            ],
            "description": "The type of SSE message"
          },
          "data": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MutationEvent"
              },
              {
                "type": "object",
                "description": "The payload for other event types."
              }
            ],
            "description": "The message payload. For `disconnect` events, `reason` is `error` after a `channelError`, or `forced by provider` when the listener was removed on the server."
          }
        },
        "examples": [
          {
            "name": "welcome",
            "value": {
              "event": "welcome",
              "id": "w#w@PV9raxj9b7a5XxZvMSwFWjYCHSQ",
              "data": {
                "listenerName": "Ua6BR3GwQ14cnZXrgwCdsF"
              }
            }
          },
          {
            "name": "welcomeback",
            "value": {
              "event": "welcomeback",
              "id": "w#w@PV9TaBj9b7a5XxZvMSwFWnRa3Og",
              "data": {
                "listenerName": "a4h9CCMcZeRP5QcyiFjQyh"
              }
            }
          },
          {
            "name": "reset",
            "value": {
              "event": "reset",
              "data": {
                "listenerName": "a4h9CCMcZeRP5QcyiFjQyh"
              }
            }
          },
          {
            "name": "mutation",
            "value": {
              "event": "mutation",
              "id": "pzeuul-awl-b69-ij3-g8862vgf3#drafts.38123cba-286c-45a0-a6d1-3cc4dc43748a",
              "data": {
                "eventId": "pzeuul-awl-b69-ij3-g8862vgf3#drafts.38123cba-286c-45a0-a6d1-3cc4dc43748a",
                "documentId": "drafts.38123cba-286c-45a0-a6d1-3cc4dc43748a",
                "transactionId": "pzeuul-awl-b69-ij3-g8862vgf3",
                "transition": "update",
                "identity": "pJNdYiKyA",
                "mutations": [],
                "previousRev": "08p48x-bog-ro2-8sh-brvd69hcd",
                "resultRev": "pzeuul-awl-b69-ij3-g8862vgf3",
                "timestamp": "2017-11-22T10:24:01.801339Z",
                "visibility": "transaction",
                "transactionCurrentEvent": 1,
                "transactionTotalEvents": 1,
                "messageDispatchedAt": "2017-11-22T10:24:01.812744Z"
              }
            }
          },
          {
            "name": "channelError",
            "value": {
              "event": "channelError",
              "data": {
                "error": {
                  "description": "unexpected end-of-file, expected expression",
                  "end": 7,
                  "query": "*[_id==",
                  "start": 7,
                  "type": "queryParseError"
                }
              }
            }
          },
          {
            "name": "disconnect",
            "value": {
              "event": "disconnect",
              "data": {
                "reason": "error"
              }
            }
          }
        ]
      },
      "MutationEvent": {
        "type": "object",
        "description": "The `data` payload of a `mutation` event.",
        "properties": {
          "eventId": {
            "type": "string",
            "description": "The same value as the event's `id`."
          },
          "documentId": {
            "type": "string"
          },
          "transactionId": {
            "type": "string"
          },
          "transition": {
            "type": "string",
            "enum": [
              "update",
              "appear",
              "disappear"
            ],
            "description": "Whether the document was updated and still matches the query, started matching it, or stopped matching it."
          },
          "identity": {
            "type": "string",
            "description": "The ID of the user or token that made the change."
          },
          "mutations": {
            "type": "array",
            "description": "The mutations applied to the document. Omitted when `includeMutations` is false.",
            "items": {
              "type": "object"
            }
          },
          "result": {
            "type": "object",
            "description": "The document after the change. Only included when `includeResult` is true."
          },
          "previous": {
            "type": "object",
            "description": "The document before the change. Only included when `includePreviousRevision` is true."
          },
          "previousRev": {
            "type": "string"
          },
          "resultRev": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "visibility": {
            "type": "string",
            "enum": [
              "transaction",
              "query"
            ],
            "description": "The visibility the event was actually delivered with."
          },
          "effects": {
            "type": "object",
            "description": "Mendoza patches (`apply` and `revert`) describing the change. Only included when `effectFormat` is `mendoza`."
          },
          "transactionCurrentEvent": {
            "type": "integer",
            "description": "The position of this event among the events generated by the same transaction, starting at 1."
          },
          "transactionTotalEvents": {
            "type": "integer",
            "description": "The total number of events generated by the transaction. Use it with `transactionCurrentEvent` to tell when you've received every event from a transaction."
          },
          "messageDispatchedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the backend dispatched the event."
          }
        }
      },
      "HTTPError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "statusCode": {
            "type": "integer"
          },
          "errorCode": {
            "type": "string"
          }
        }
      }
    }
  },
  "paths": {
    "/data/listen/{dataset}": {
      "get": {
        "summary": "Stream document mutation events",
        "description": "Streams events whenever documents matching the GROQ query are modified. This is a live API adhering to the server-sent events standard.\n\nThe server sends a `:` comment every 15 seconds to keep the connection alive. It closes the connection after about four hours, and when it restarts, without sending a `disconnect` event. Reconnect when the connection closes, and use `enableResume` to avoid missing events in between.\n\nAuthentication errors return an HTTP error before the stream starts: `400` for a malformed `Authorization` header and `401` for an invalid token. Any other error arrives as events on the stream, not as an HTTP status code. The response status is `200`, followed by a `channelError` event and a `disconnect` event. In most cases, `data.error` is an object with a `description` and a `type`, and the `disconnect` event has the reason `error`. A dataset that doesn't exist is the exception: `data.error` is the string `Dataset not found`, with the details in `data.message`, and the `disconnect` event has no data. Error descriptions you might see include:\n\n- `unexpected end-of-file, expected expression` (type `queryParseError`, the exact text varies): the `query` parameter isn't valid GROQ.\n- `no query` (type `queryParseError`): the `query` parameter is missing.\n- `Unknown query parameter \"NAME\"` (type `httpUnknownQueryStringParameters`): the request includes a parameter the endpoint doesn't accept.\n- `invalid listener visibility \"VALUE\"` (type `validationError`): `visibility` isn't `transaction` or `query`.\n- `Invalid effectFormat specified: VALUE` (type `validationError`): `effectFormat` isn't `mendoza`.\n- `Invalid includeAllVersions specified: VALUE` (type `validationError`): `includeAllVersions` isn't a boolean.\n- `Invalid listener resume token: REASON` (type `validationError`): `enableResume` is true and the last event ID isn't a valid event ID.\n- `Max listener limit exceeded at N`: the dataset already has the maximum number of concurrent listeners.\n",
        "parameters": [
          {
            "name": "dataset",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The dataset to stream events from"
          },
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The GROQ query used to filter the events. Only the top-level filter portion of the query is used. Anything else, including projection, subqueries, slicing, or aggregation, is ignored."
          },
          {
            "name": "$-params",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Any $-prefixed parameters to include in the GROQ query."
          },
          {
            "name": "includeResult",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Include the resulting document in addition to the changes. The HTTP API defaults to false. The `listen()` method in `@sanity/client` sends true unless you set `includeResult` to false."
          },
          {
            "name": "includePreviousRevision",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Include the document as it looked before the change."
          },
          {
            "name": "includeMutations",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true
            },
            "description": "Include the mutations applied as part of the transaction."
          },
          {
            "name": "visibility",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "transaction",
                "query"
              ],
              "default": "transaction"
            },
            "description": "Specifies whether events should be sent as soon as a transaction has been committed (transaction, default), or only after they are available for queries (query). Note that this is best-effort, and listeners with query may in certain cases (notably with deferred transactions) receive events that are not yet visible to queries. The visibility event field indicates the actual visibility."
          },
          {
            "name": "evs_preamble",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Send a prolog of 2056 no-op characters for compatibility with older browsers. Any value, including false, enables it."
          },
          {
            "name": "effectFormat",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "mendoza"
              ]
            },
            "description": "If set to the only allowed value mendoza, an additional field effects is included in the returned payload with mutation effects in the Mendoza specification."
          },
          {
            "name": "includeAllVersions",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Set to true to also receive events for version documents (IDs that start with `versions.`). Draft documents are included without this parameter, if the request's token can read them. Requires API version 2025-02-19 or later; earlier API versions ignore this parameter."
          },
          {
            "name": "enableResume",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Set to true to let a reconnecting listener resume where it left off. Send the ID of the last event you received in the `Last-Event-ID` header or the `lastEventId` parameter. If the listener can resume, the stream starts with a `welcomeback` event followed by the events you missed. If it can't, you receive a `reset` or `welcome` event instead, and should refetch your local state. An invalid ID returns the error `Invalid listener resume token`."
          },
          {
            "name": "lastEventId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "The ID of the last event you received. Used to resume when `enableResume` is true. Ignored when the `Last-Event-ID` header is set."
          },
          {
            "name": "Last-Event-ID",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "The ID of the last event you received. Used to resume when `enableResume` is true. Takes precedence over the `lastEventId` parameter."
          },
          {
            "name": "tag",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "A request tag that identifies the listener request in logs."
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully started streaming operation. Errors after this point arrive as `channelError` events.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/SSEMessage"
                },
                "examples": {
                  "welcome": {
                    "value": {
                      "event": "welcome",
                      "id": "w#w@PV9raxj9b7a5XxZvMSwFWjYCHSQ",
                      "data": {
                        "listenerName": "Ua6BR3GwQ14cnZXrgwCdsF"
                      }
                    }
                  },
                  "welcomeback": {
                    "value": {
                      "event": "welcomeback",
                      "id": "w#w@PV9TaBj9b7a5XxZvMSwFWnRa3Og",
                      "data": {
                        "listenerName": "a4h9CCMcZeRP5QcyiFjQyh"
                      }
                    }
                  },
                  "reset": {
                    "value": {
                      "event": "reset",
                      "data": {
                        "listenerName": "a4h9CCMcZeRP5QcyiFjQyh"
                      }
                    }
                  },
                  "mutation": {
                    "value": {
                      "event": "mutation",
                      "id": "pzeuul-awl-b69-ij3-g8862vgf3#drafts.38123cba-286c-45a0-a6d1-3cc4dc43748a",
                      "data": {
                        "eventId": "pzeuul-awl-b69-ij3-g8862vgf3#drafts.38123cba-286c-45a0-a6d1-3cc4dc43748a",
                        "documentId": "drafts.38123cba-286c-45a0-a6d1-3cc4dc43748a",
                        "transactionId": "pzeuul-awl-b69-ij3-g8862vgf3",
                        "transition": "update",
                        "identity": "pJNdYiKyA",
                        "mutations": [],
                        "previousRev": "08p48x-bog-ro2-8sh-brvd69hcd",
                        "resultRev": "pzeuul-awl-b69-ij3-g8862vgf3",
                        "timestamp": "2017-11-22T10:24:01.801339Z",
                        "visibility": "transaction",
                        "transactionCurrentEvent": 1,
                        "transactionTotalEvents": 1,
                        "messageDispatchedAt": "2017-11-22T10:24:01.812744Z"
                      }
                    }
                  },
                  "channelError": {
                    "value": {
                      "event": "channelError",
                      "data": {
                        "error": {
                          "description": "unexpected end-of-file, expected expression",
                          "end": 7,
                          "query": "*[_id==",
                          "start": 7,
                          "type": "queryParseError"
                        }
                      }
                    }
                  },
                  "datasetNotFound": {
                    "value": {
                      "event": "channelError",
                      "data": {
                        "error": "Dataset not found",
                        "statusCode": 404,
                        "message": "Dataset \"production\" not found for project ID \"projectId\""
                      }
                    }
                  },
                  "disconnect": {
                    "value": {
                      "event": "disconnect",
                      "data": {
                        "reason": "error"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "The `Authorization` header is malformed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPError"
                },
                "example": {
                  "error": "Bad Request",
                  "message": "Invalid authorization header - please double-check token",
                  "statusCode": 400
                }
              }
            }
          },
          "401": {
            "description": "The token is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPError"
                },
                "example": {
                  "message": "Session not found",
                  "error": "Unauthorized",
                  "statusCode": 401,
                  "errorCode": "SIO-401-ANF"
                }
              }
            }
          }
        }
      }
    }
  }
}