{
  "openapi": "3.1.1",
  "info": {
    "title": "Jobs HTTP Endpoint",
    "version": "2021-06-07",
    "description": "The Jobs API lets you monitor processes running inside Sanity's infrastructure, such as dataset copy jobs.\n",
    "x-jentic-source-url": "https://www.sanity.io/docs/api/openapi/jobs?format=json"
  },
  "servers": [
    {
      "url": "https://api.sanity.io/{apiVersion}",
      "description": "Sanity API base URL",
      "variables": {
        "apiVersion": {
          "default": "v2021-06-07",
          "description": "API version"
        }
      }
    }
  ],
  "paths": {
    "/jobs/{jobId}": {
      "get": {
        "summary": "Job status",
        "operationId": "jobStatus",
        "description": "Get the status of a job.\n",
        "parameters": [
          {
            "in": "path",
            "name": "jobId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the status of the job.\n",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "state": {
                      "type": "string",
                      "enum": [
                        "pending",
                        "running",
                        "completed",
                        "failed",
                        "terminating",
                        "terminated"
                      ]
                    },
                    "authors": {
                      "type": "array",
                      "description": "An array of author IDs.\n",
                      "items": {
                        "type": "string"
                      }
                    },
                    "created_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "updated_at": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "example": {
                    "id": "jacsfsmnxp",
                    "state": "running",
                    "authors": [
                      "gWkL8m2Xp"
                    ],
                    "created_at": "2021-01-01T00:00:00.000Z",
                    "updated_at": "2021-01-01T00:00:00.000Z"
                  }
                }
              }
            }
          },
          "400": {
            "description": "The job couldn't be found, or the request was invalid.\n",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "statusCode": 400,
                  "error": "Bad Request",
                  "message": "Could not get job status"
                }
              }
            }
          },
          "401": {
            "description": "The request isn't authenticated.\n",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "statusCode": 401,
                  "error": "Unauthorized",
                  "message": "A valid session is required for this endpoint"
                }
              }
            }
          },
          "500": {
            "description": "The job service failed to return the job.\n",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "statusCode": 500,
                  "error": "Internal Server Error",
                  "message": "An internal server error occurred"
                }
              }
            }
          }
        }
      }
    },
    "/jobs/{jobId}/listen": {
      "get": {
        "summary": "Listen for job updates",
        "operationId": "jobListen",
        "description": "Each job has a `/listen` endpoint that lets you monitor its status programmatically. While you're listening, the endpoint sends event data at intervals with updates on the status of your job.\n\nThe stream sends the following events. The `data` of each event is a JSON object.\n\n- `welcome`: The first event on the stream. Contains a `listener_id`.\n- `job`: Contains the job's `job_id`, `state`, and `progress` (0 to 100). When the job reaches a terminal state (`completed`, `failed`, `terminating`, or `terminated`), the endpoint sends a final `job` event with `progress` set to `100` and closes the stream.\n- `channel_error`: Sent when an error occurs, such as an unknown job ID, or when the stream has been open for 12 hours. Contains an `error` message.\n- `disconnect`: Sent after `channel_error`, before the stream closes. Contains a `reason`.\n\nAfter the stream opens, the endpoint reports errors as events, not as HTTP status codes. If the job is deleted while you're listening, the stream closes without sending an event.\n",
        "parameters": [
          {
            "in": "path",
            "name": "jobId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Streams job status events.\n",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                },
                "example": "event: welcome\ndata: {\"listener_id\":\"ladaicdbdo\"}\n\nevent: job\ndata: {\"job_id\":\"jacsfsmnxp\",\"state\":\"running\",\"progress\":60}\n\nevent: job\ndata: {\"job_id\":\"jacsfsmnxp\",\"state\":\"completed\",\"progress\":100}\n"
              }
            }
          },
          "401": {
            "description": "The request isn't authenticated.\n",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "statusCode": 401,
                  "error": "Unauthorized",
                  "message": "A valid session is required for this endpoint"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "integer"
          },
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ]
}