{
  "openapi": "3.0.3",
  "info": {
    "title": "Mobile Operations",
    "version": "1.1.0",
    "description": "API para processar operações em MSISDNs (Cancelar/Migrar) e, opcionalmente, mudar a plataforma de destino (Pos/Controle).\nO payload de resposta replica os campos enviados e, em cada item de MSISDN, adiciona o objeto \"Status\" com:\n- \"Status\": Sucesso | Erro\n- \"Erros\": lista de mensagens (vazia quando Sucesso)\n",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/ChiaratoSoftware/mobile-operations/1.1.0"
  },
  "servers": [
    {
      "url": "https://api.suaempresa.com/v1"
    }
  ],
  "paths": {
    "/mobile-operations/acoes": {
      "post": {
        "summary": "Executa operações em lote para MSISDNs",
        "operationId": "executarOperacoesMsisdn",
        "tags": [
          "Operações"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PayloadOperacoes"
              },
              "examples": {
                "exemploRequisicao": {
                  "summary": "Exemplo de payload de requisição",
                  "value": {
                    "BAN": "123456789",
                    "MSISDN Novo Titular": "5511998765432",
                    "MSISDN": [
                      {
                        "MSISDN": "5511987654321",
                        "Operação": "Cancelar",
                        "PlataformaDestino": "Pos"
                      },
                      {
                        "MSISDN": "5511976543210",
                        "Operação": "Migrar",
                        "PlataformaDestino": "Controle"
                      },
                      {
                        "MSISDN": "5511965432109",
                        "Operação": "Migrar",
                        "PlataformaDestino": "Pos"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Todas as operações processadas (podendo haver sucessos e/ou erros por item)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RetornoOperacoes"
                },
                "examples": {
                  "exemploSucessoParcial": {
                    "summary": "Itens com sucesso e com erro",
                    "value": {
                      "BAN": "123456789",
                      "MSISDN Novo Titular": "5511998765432",
                      "MSISDN": [
                        {
                          "MSISDN": "5511987654321",
                          "Operação": "Cancelar",
                          "PlataformaDestino": "Pos",
                          "Status": {
                            "Status": "Sucesso",
                            "Erros": []
                          }
                        },
                        {
                          "MSISDN": "5511976543210",
                          "Operação": "Migrar",
                          "PlataformaDestino": "Controle",
                          "Status": {
                            "Status": "Erro",
                            "Erros": [
                              "Falha X",
                              "Falha Y"
                            ]
                          }
                        },
                        {
                          "MSISDN": "5511965432109",
                          "Operação": "Migrar",
                          "PlataformaDestino": "Pos",
                          "Status": {
                            "Status": "Sucesso",
                            "Erros": []
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Erro de validação do payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                },
                "examples": {
                  "payloadInvalido": {
                    "value": {
                      "codigo": "REQ-400",
                      "mensagem": "Campo 'MSISDN Novo Titular' deve conter apenas dígitos"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Não autorizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "PayloadOperacoes": {
        "type": "object",
        "required": [
          "BAN",
          "MSISDN Novo Titular",
          "MSISDN"
        ],
        "additionalProperties": false,
        "properties": {
          "BAN": {
            "type": "string",
            "minLength": 1,
            "description": "Identificador de conta/contrato (Billing Account Number)"
          },
          "MSISDN Novo Titular": {
            "type": "string",
            "description": "Número MSISDN do novo titular (somente dígitos)",
            "pattern": "^[0-9]+$"
          },
          "MSISDN": {
            "type": "array",
            "minItems": 1,
            "description": "Lista de operações por MSISDN",
            "items": {
              "$ref": "#/components/schemas/ItemOperacao"
            }
          }
        }
      },
      "ItemOperacao": {
        "type": "object",
        "required": [
          "MSISDN",
          "Operação",
          "PlataformaDestino"
        ],
        "additionalProperties": false,
        "properties": {
          "MSISDN": {
            "type": "string",
            "description": "Número MSISDN (somente dígitos, com ou sem DDI/DDD)",
            "pattern": "^[0-9]+$"
          },
          "Operação": {
            "type": "string",
            "description": "Tipo da operação a executar",
            "enum": [
              "Cancelar",
              "Migrar"
            ]
          },
          "PlataformaDestino": {
            "type": "string",
            "description": "Plataforma de destino",
            "enum": [
              "Pos",
              "Controle"
            ]
          }
        }
      },
      "StatusOperacao": {
        "type": "object",
        "required": [
          "Status",
          "Erros"
        ],
        "additionalProperties": false,
        "properties": {
          "Status": {
            "type": "string",
            "description": "Resultado da operação para o MSISDN",
            "enum": [
              "Sucesso",
              "Erro"
            ]
          },
          "Erros": {
            "type": "array",
            "description": "Lista de mensagens de falha (vazia quando Status=Sucesso)",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ItemOperacaoComStatus": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ItemOperacao"
          },
          {
            "type": "object",
            "required": [
              "Status"
            ],
            "properties": {
              "Status": {
                "$ref": "#/components/schemas/StatusOperacao"
              }
            }
          }
        ]
      },
      "RetornoOperacoes": {
        "type": "object",
        "required": [
          "BAN",
          "MSISDN Novo Titular",
          "MSISDN"
        ],
        "additionalProperties": false,
        "properties": {
          "BAN": {
            "type": "string",
            "minLength": 1,
            "description": "Identificador de conta/contrato (Billing Account Number)"
          },
          "MSISDN Novo Titular": {
            "type": "string",
            "description": "Número MSISDN do novo titular (somente dígitos)",
            "pattern": "^[0-9]+$"
          },
          "MSISDN": {
            "type": "array",
            "description": "Lista de operações por MSISDN com resultados",
            "items": {
              "$ref": "#/components/schemas/ItemOperacaoComStatus"
            }
          }
        }
      },
      "Erro": {
        "type": "object",
        "required": [
          "codigo",
          "mensagem"
        ],
        "properties": {
          "codigo": {
            "type": "string"
          },
          "mensagem": {
            "type": "string"
          }
        }
      }
    }
  }
}
