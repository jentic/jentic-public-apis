      "parentContracts": {
        "description": "Array de contrato-pai (um para cada produto)",
        "type": "object",
        "required": [
          "parentContractCode",
          "contractStartDate",
          "contractBillingDestination",
          "contractDeltaRevenue",
          "contractBreachFeeFlag",
          "contractEndDate"
        ],
        "properties": {
          "parentContractCode": {
            "type": "string",
            "description": "ID do contrato.",
            "example": "VES-3 UNV202500122"
          },
          "contractStartDate": {
            "type": "string",
            "format": "date",
            "description": "Data de in\u00edcio do contrato.",
            "example": "23-09-2025"
          },
          "contractBillingDestination": {
            "type": "string",
            "description": "Processo de faturamento a ser utilizado: \u00b7 C - Claro \u00b7 N - Nextel meses",
            "example": "C"
          },
          "contractBillingRetentionFlag": {
            "type": "boolean",
            "description": "Indica que h\u00e1 reten\u00e7\u00e3o de faturamento.",
            "example": false
          },
          "contractRetroactiveChargeFlag ": {
            "type": "boolean",
            "description": "Indica se as cobran\u00e7as ser\u00e3o emitidas mesmo que a data da fatura original j\u00e1 tenha passado.",
            "example": true
          },
          "contractSpecialProjectId": {
            "type": "string",
            "description": "Id do projeto especial.",
            "example": "S-123"
          },
          "contractDeltaRevenue": {
            "type": "number",
            "format": "double",
            "description": "Receita Delta em R$.",
            "example": "35345.23"
          },
          "contractBillingRetentionReason": {
            "type": "string",
            "description": "Motivo da reten\u00e7\u00e3o de cobran\u00e7a",
            "example": "Contrato Governamental."
          },
          "contractBreachFeeFlag": {
            "type": "boolean",
            "description": "Flag para indicar se taxa \u00e9 aplic\u00e1vel em caso de descumprimento do contrato.",
            "example": true
          },
          "contractEndDate": {
            "type": "string",
            "format": "date",
            "description": "Data de t\u00e9rmino do contrato.",
            "example": "22-09-2030"
          }
        }
      }
    },
