      "422": {
        "description": "Unprocessable Entity - Identify business errors that can be detailed according to backend system rules. The possible values are: \n  * API-CPQQUOTES-001: Erro de neg\u00f3cio.  \n  * API-CPQQUOTES-002: ID do canal de distribui\u00e7\u00e3o incorreto.\n  * API-CPQQUOTES-003: Valor n\u00e3o correspondente ao padr\u00e3o. \n  * API-CPQQUOTES-004: Erro de valida\u00e7\u00e3o - sfdcCustomerId \u00e9 nulo.\n  * API-CPQQUOTES-005: Erro na valida\u00e7\u00e3o de par\u00e2metro.\n  * API-CPQQUOTES-006: Agregado N\u00e3o Encontrado.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/error"
            },
            "examples": {
              "UnprocessableEntity": {
                "value": {
                  "apiVersion": "1;2025-02-21",
                  "transactionId": "Id-12312414231",
                  "error": {
                    "httpCode": "422",
                    "errorCode": "API-CPQQUOTES-001",
                    "message": "Unprocessable Entity",
                    "detailedMessage": "Transa\u00e7\u00e3o solicitada \u00e9 Inv\u00e1lida para Status de PENDING_APROVAL.",
                    "link": {
                      "rel": "related",
                      "href": "https://api.claro.com.br/docs"
                    }
                  }
                }
              },
              "IncorrectDistribution": {
                "value": {
                  "apiVersion": "1;2025-02-21",
                  "transactionId": "Id-12312414231",
                  "error": {
                    "httpCode": "422",
                    "errorCode": "API-CPQQUOTES-002",
                    "message": "Unprocessable Entity",
                    "detailedMessage": "Id do canal de distribui\u00e7\u00e3o inexistente.",
                    "link": {
                      "rel": "related",
                      "href": "https://api.claro.com.br/docs"
                    }
                  }
                }
              },
              "BackendFault": {
                "value": {
                  "apiVersion": "1;2025-02-21",
                  "transactionId": "Id-12312414231",
                  "error": {
                    "httpCode": "422",
                    "errorCode": "API-CPQQUOTES-003",
                    "message": "Unprocessable Entity",
                    "detailedMessage": "O valor n\u00e3o corresponde ao padr\u00e3o (por exemplo, \"quoteItem[0].action\").",
                    "link": {
                      "rel": "related",
                      "href": "https://api.claro.com.br/docs"
                    }
                  }
                }
              },
              "ValidationError": {
                "value": {
                  "apiVersion": "1;2025-02-21",
                  "transactionId": "Id-12312414231",
                  "error": {
                    "httpCode": "422",
                    "errorCode": "API-CPQQUOTES-004",
                    "message": "Unprocessable Entity",
                    "detailedMessage": "Erro de valida\u00e7\u00e3o - sfdcCustomerId \u00e9 nulo.",
                    "link": {
                      "rel": "related",
                      "href": "https://api.claro.com.br/docs"
                    }
                  }
                }
              },
              "ValidParameterError": {
                "value": {
                  "apiVersion": "1;2025-02-21",
