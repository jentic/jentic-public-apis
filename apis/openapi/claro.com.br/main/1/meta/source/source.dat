      },
      "siteAddressStreetNrs": {
        "description": "N\u00famero do endere\u00e7o.",
        "type": "string",
        "example": "11036"
      },
      "siteAddressAcronymStateOrProvinces": {
        "description": "Abreviatura de unidade federativa",
        "type": "string",
        "example": "S\u00e3o Paulo"
      },
      "siteAddressStreetTypes": {
        "description": "Descri\u00e7\u00e3o do tipo de rua (ex. Avenida, Rua, Estrada, etc.)",
        "type": "string",
        "example": "Avenida"
      },
      "siteAddressNeighborhoods": {
        "description": "Vizinhan\u00e7a",
        "type": "string",
        "example": "Jardim Guanabara"
      },
      "siteAddressLocalitions": {
        "description": "Nome da Cidade",
        "type": "string",
        "example": "Jundia\u00ed"
      },
      "siteLatitudes": {
        "description": "Latitude do endere\u00e7o",
        "type": "string",
        "example": "46.9767407"
      },
      "siteIds": {
        "description": "Identifica\u00e7\u00e3o do local \"A\"",
        "type": "string",
        "example": "65446"
      },
      "siteAddressLandmarks": {
        "description": "Descri\u00e7\u00e3o do ponto de refer\u00eancia",
        "type": "string",
        "example": "Aero Club of Jundia\u00ed"
      },
      "siteLongitudes": {
        "description": "Longitude do endere\u00e7o",
        "type": "string",
        "example": "23.1895253"
      },
      "contractCustomerFinal": {
        "description": "Nome do cliente final. O valor deste par\u00e2metro descreve o nome do cliente que \u00e9 espec\u00edfico para uma localiza\u00e7\u00e3o. Deve ser recebido do RADAR",
        "type": "string",
        "example": "Jo\u00e3o Jos\u00e9 da Silva"
      },
      "patchRequest": {
        "description": "Request de cria\u00e7\u00e3o de um novo cliente sob a Organiza\u00e7\u00e3o Empresarial informada",
        "type": "object",
        "required": [
          "data",
          "id"
        ],
        "properties": {
          "data": {
            "properties": {
              "id": {
                "description": "N\u00famero de Identifica\u00e7\u00e3o da Cota\u00e7\u00e3o da Netcracker",
                "type": "string",
                "example": "4rffr3434yg"
              },
              "extendedParameters": {
                "required": [
                  "Skips"
                ],
                "properties": {
                  "skips": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/skips"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "patchResponse": {
        "type": "object",
        "properties": {
          "apiVersion": {
            "$ref": "#/components/schemas/apiVersion"
          },
          "transactionId": {
            "$ref": "#/components/schemas/transactionId"
          },
          "data": {
            "properties": {
              "href": {
                "description": "atributo em refer\u00eancia \u00e0 cota\u00e7\u00e3o",
                "type": "string",
                "example": "https://public-gateway-cpq-int1.claro-cpq.managed.netcracker.cloud/quote-tmf-service/quoteManagement/quote/3953a502-c313-4c7c-a583-0d999abc84ff"
              },
              "id": {
                "description": "Identificador exclusivo da Cota\u00e7\u00e3o.",
                "type": "string",
                "example": "3953a502-c313-4c7c-a583-0d999abc84ff"
              },
              "expirationDate": {
                "description": "Data em que a Cota\u00e7\u00e3o expira",
                "type": "string",
                "format": "date-time",
                "example": "2022-12-20T09:02:25.176027Z"
              },
              "version": {
                "description": "Vers\u00e3o da cota\u00e7\u00e3o (por exemplo, se o cliente rejeitou a cota\u00e7\u00e3o, mas as negocia\u00e7\u00f5es ainda abrem, uma nova vers\u00e3o da cota\u00e7\u00e3o \u00e9 gerenciada)",
                "type": "string",
                "example": "42"
              },
              "number": {
                "description": "N\u00famero sequencial da Cota\u00e7\u00e3o.",
                "type": "string",
                "example": "348"
              },
              "description": {
                "description": "Descri\u00e7\u00e3o da Cota\u00e7\u00e3o.",
                "type": "string",
                "example": "Created via iFrame"
              },
              "category": {
                "description": "Usado para categorizar a Cota\u00e7\u00e3o de uma perspectiva de neg\u00f3cios que pode ser \u00fatil para o sistema CRM (nome da Categoria do Cliente).",
                "type": "string",
                "example": "Empresas"
              },
              "state": {
                "description": "Estado da cota\u00e7\u00e3o. Atualizavel por via API dedicada.",
                "type": "string",
                "example": "PENDING_APPROVAL"
              },
              "quoteDate": {
                "description": "Data e hora em que a cota\u00e7\u00e3o foi criada.",
                "type": "string",
                "example": "2022-12-20T09:02:25.176027Z"
              },
              "validFor": {
                "description": "O per\u00edodo durante a Cota\u00e7\u00e3o, ofertas e pre\u00e7os s\u00e3o v\u00e1lidos\n Cont\u00e9m os seguintes atributos: \n\u00b7  startDateTime;\n\u00b7  endDateTime.\nendDateTime \u00e9 o \u00fanico atributo pass\u00edvel de atualiza\u00e7\u00e3o.\n",
                "properties": {
                  "startDateTime": {
                    "description": "Date and time when the Quote was created.",
                    "type": "string",
                    "format": "startDateTime",
                    "example": "2022-12-20T09:02:25.176027Z"
                  },
                  "endDateTime": {
                    "description": "Date and time when the Quote was created.",
                    "type": "string",
                    "format": "endDateTime",
                    "example": "2022-12-20T09:02:25.176027Z"
                  }
                }
              },
              "relatedParties": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/relatedParties"
                }
              },
              "quoteItems": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/quoteItems"
                }
              },
              "quoteTotalPrices": {
                "description": "Representa o pre\u00e7o total da cota\u00e7\u00e3o.",
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/quoteTotalPrices"
                }
              },
              "customerCategory": {
                "type": "string",
                "description": "Identificador exclusivo da categoria do Cliente.",
                "example": "b8f6b060-2ac9-4836-91ba-d3b471a71743"
              },
              "customerId": {
                "type": "string",
                "description": "Identificador \u00fanico do cliente.",
                "example": "521069f3-c58e-4a4d-b1aa-29ecfef005aa"
              },
              "distributionChannelId": {
                "type": "string",
                "description": "Identificador exclusivo do Canal de Distribui\u00e7\u00e3o atrav\u00e9s do qual a Cota\u00e7\u00e3o foi criada.",
                "example": "95b3451d-afaa-4961-9f2b-5370416f99bd"
              },
              "initialDistributionChannelId": {
                "type": "string",
                "description": "ID de um Canal de Distribui\u00e7\u00e3o usado durante a cria\u00e7\u00e3o de cota\u00e7\u00f5es. O valor \u00e9 definido uma vez e nunca alterado durante o ciclo de vida da Cota\u00e7\u00e3o.",
                "example": "95b3451d-afaa-4961-9f2b-5370416f99bd"
              },
              "newMSA": {
                "type": "boolean",
                "description": "Este sinalizador \u00e9 usado para especificar que a Cota\u00e7\u00e3o serve como base para cria\u00e7\u00e3o e aceita\u00e7\u00e3o de um novo MSA.",
                "example": false
              },
              "distributionChannelName": {
                "type": "string",
                "description": "Nome do Canal de Distribui\u00e7\u00e3o atrav\u00e9s do qual a Cota\u00e7\u00e3o foi criada.",
                "example": "Canal Direto"
              },
              "name": {
                "type": "string",
                "description": "Nome da Cota\u00e7\u00e3o.",
                "example": "Quote #391"
              },
              "opportunityIds": {
                "type": "string",
                "description": "Identificador \u00fanico da Oportunidade.",
                "example": "OOOi0001114Q0mCAEE"
              },
              "revision": {
                "type": "string",
                "description": "Atributo \u00e9 usado para marcar a Cota\u00e7\u00e3o em andamento. \u00c9 incrementado em caso de altera\u00e7\u00f5es na Cota\u00e7\u00e3o ap\u00f3s a submiss\u00e3o.",
                "example": "0"
              },
              "updatedWhen": {
                "type": "string",
                "description": "Data e hora da atualiza\u00e7\u00e3o da cota\u00e7\u00e3o.",
                "example": "2022-03-22T17:54:58.045341Z",
                "format": "date-time"
              },
              "overrideMode": {
                "type": "string",
                "description": "Indica que tipo de pre\u00e7o \u00e9 substitu\u00edvel (GROSS ou NET).",
                "example": "GROSS",
                "enum": [
                  "GROSS",
                  "NET"
                ]
              },
              "approvalLevel": {
                "type": "string",
                "description": "N\u00edvel de aprova\u00e7\u00e3o para a Cota\u00e7\u00e3o.",
                "example": "0"
              },
              "placeRefs": {
                "description": "Local descrito por refer\u00eancia ou por valor vinculado a uma entidade espec\u00edfica.",
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/placeRefs"
                }
              },
              "extendedParameters": {
                "$ref": "#/components/schemas/extendedParameters"
              },
              "marketRefs": {
                "description": "Representa mercados relacionados.",
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/marketRefs"
                }
              },
              "geographicSiteGroups": {
                "description": "Representa mercados relacionados.",
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/geographicSiteGroups"
                }
              }
            }
          }
        }
      },
