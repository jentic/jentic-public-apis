                  "$ref": "#/components/schemas/placeRefsSite"
                }
              }
            }
          }
        }
      },
      "priceAlteration": {
        "description": "\u00c9 uma quantia, geralmente em dinheiro, que modifica o pre\u00e7o cobrado por um item do pedido.",
        "type": "object",
        "properties": {
          "id": {
            "description": "Identificador \u00fanico da Altera\u00e7\u00e3o de Pre\u00e7o. Caso a Altera\u00e7\u00e3o de Pre\u00e7o seja iniciada a partir de um Produto, o Id \u00e9 selecionado automaticamente na Altera\u00e7\u00e3o de Pre\u00e7o.\n\n Nota: Pode ser fornecido na solicita\u00e7\u00e3o no formato de UUID.\n",
            "type": "string",
            "example": "76bc51c7-be09-4d18-b468-c9e9b5388553"
          },
          "name": {
            "description": "Nome da altera\u00e7\u00e3o de pre\u00e7o do item do pedido",
            "type": "string",
            "example": "Aparelho Comodato - Desconto 100% Automatico"
          },
          "priceType": {
            "description": "Uma categoria que descreve o pre\u00e7o, como recorrente, \u00fanico e uso",
            "type": "string",
            "example": "NRC"
          },
          "durationUnits": {
            "description": "Unidades de dura\u00e7\u00e3o do aplicativo de promo\u00e7\u00e3o, por exemplo Dia, Semana, M\u00eas, Trimestre, Ano",
            "type": "string",
            "example": "MONTH",
            "enum": [
              "Day",
              "Week",
              "Month",
              "Quarter",
              "Year"
            ]
          },
          "priority": {
            "description": "N\u00edvel de prioridade para aplicar esta altera\u00e7\u00e3o entre todas as altera\u00e7\u00f5es definidas no pre\u00e7o do item do pedido.",
            "type": "integer",
            "example": 0
          },
          "validFor": {
            "description": "Per\u00edodo durante a Altera\u00e7\u00e3o de Pre\u00e7o \u00e9 v\u00e1lido\n\u00b7  startDateTime;\n\u00b7  endDateTime.                           \n",
            "properties": {
              "startDateTime": {
                "description": "Data e hora de in\u00edcio.",
                "type": "string",
                "format": "startDateTime",
                "example": "2022-12-20T09:02:25.176027Z"
              },
              "endDateTime": {
                "description": "Data e hora final.",
                "type": "string",
                "format": "endDateTime",
                "example": "2022-12-20T09:02:25.176027Z"
              }
            }
          },
          "price": {
            "properties": {
              "taxIncludedAmount": {
                "description": "All taxes included amount",
                "type": "string",
                "example": "5.00"
              },
              "dutyFreeAmount": {
                "description": "All taxes excluded amount",
                "type": "string",
                "example": "3.37"
              },
              "taxRate": {
                "description": "Tax rate",
                "type": "number",
                "format": "float",
                "example": 48.26896
              },
              "overridden": {
                "description": "Sinalizador indica se o pre\u00e7o \u00e9 ou n\u00e3o substitu\u00eddo (definido como True se overiddenValue for fornecido)",
                "type": "boolean",
                "example": false
              },
              "priceValueRef": {
                "description": "Identificador exclusivo do pre\u00e7o do Cat\u00e1logo de Ofertas de Produtos:\n \u00b7 Para pre\u00e7o em QuotePrice, priceValueRef = Price Key Id e depende de QuotePrice.priceType\n \u00b7 Para pre\u00e7o em PriceAlteration, priceValueRef = ID da a\u00e7\u00e3o de promo\u00e7\u00e3o no cat\u00e1logo de ofertas de produtos\n",
                "type": "string",
                "example": "c6cfcb57-ad61-47e9-88ce-6da10f8ece29"
              },
              "prodOfferingPriceTaxAlterationId": {
                "description": "Identificador \u00fanico do envolvimento fiscal",
                "type": "string",
                "example": "0e1d1803-8a83-4656-bb7b-5d7605e99b04"
              },
              "valueBasePriceExcludingTax": {
                "description": "Pre\u00e7o Base/Valor Absoluto da Promo\u00e7\u00e3o excluindo impostos",
                "type": "string",
                "example": "3.372250"
              },
              "valueBasePriceExcludingTaxRounded": {
                "description": "Base Price/Promotion Absolute Value rounded value excluding taxes",
                "type": "string",
                "example": "3.37"
              },
              "valueBasePriceIncludingTax": {
                "description": "Pre\u00e7o Base/Promo\u00e7\u00e3o Valor absoluto incluindo impostos",
                "type": "string",
                "example": 5
              },
              "valueBasePriceIncludingTaxRounded": {
                "description": "Pre\u00e7o base/promo\u00e7\u00e3o Valor arredondado absoluto incluindo impostos",
                "type": "string",
                "example": "5.00"
              },
              "valueExcludingTax": {
                "description": "Valor do pre\u00e7o excluindo impostos",
                "type": "string",
                "example": "3.372250"
              },
              "valueExcludingTaxRounded": {
                "description": "Valor arredondado do pre\u00e7o sem impostos",
                "type": "string",
                "example": "3.37"
              },
              "valueIncludingTax": {
                "description": "Valor do pre\u00e7o incluindo impostos",
                "type": "string",
                "example": 5
              },
              "valueIncludingTaxRounded": {
                "description": "Valor arredondado do pre\u00e7o incluindo impostos",
                "type": "string",
                "example": "5.00"
              },
              "valueSubTotalPriceExcludingTax": {
                "description": "Pre\u00e7o subtotal do item de cota\u00e7\u00e3o excluindo impostos",
                "type": "string",
                "example": "3.372250"
              },
              "valueSubTotalPriceExcludingTaxRounded": {
                "description": "Pre\u00e7o subtotal arredondado do item de cota\u00e7\u00e3o excluindo impostos",
                "type": "string",
                "example": "3.37"
              },
              "valueSubTotalPriceIncludingTax": {
                "description": "Pre\u00e7o subtotal do item de cota\u00e7\u00e3o, incluindo impostos",
                "type": "string",
                "example": "5"
              },
              "valueSubTotalPriceIncludingTaxRounded": {
                "description": "Pre\u00e7o do item de cota\u00e7\u00e3o subtotal arredondado, incluindo impostos",
                "type": "string",
                "example": "5.00"
              }
            }
          },
          "priceAlteration": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/priceAlteration"
            }
          },
          "productOfferingPrice": {
            "type": "object",
            "properties": {
              "id": {
                "description": "Identificador do Pre\u00e7o da Oferta do Produto (ID do Padr\u00e3o de Promo\u00e7\u00e3o)",
                "type": "string",
                "example": "76bc51c7-be09-4d18-b468-c9e9b5388553"
              },
              "name": {
                "description": "Nome do pre\u00e7o da oferta do produto (PromotionPattern.name)",
                "type": "string",
                "example": "Aparelho Comodato - Desconto 100% Automatico"
              }
            }
          },
          "action": {
            "description": "Atributo descritivo da a\u00e7\u00e3o (add/disconnect/null/dash)",
            "type": "string",
            "example": "ADD",
            "enum": [
              "add",
              "disconnect",
              null,
              "dash"
            ]
          },
          "applicationMode": {
            "description": "Par\u00e2metro indica se uma promo\u00e7\u00e3o \u00e9 aplicada automaticamente ou manualmente a partir do Cat\u00e1logo de Ofertas de Produtos",
            "type": "string",
            "example": "Automatic"
          },
          "applied": {
            "description": "A bandeira que reflete se a Promo\u00e7\u00e3o foi aplicada ou n\u00e3o",
            "type": "boolean",
            "example": true
          },
          "promotionId": {
            "description": "xxxxxx",
            "type": "string",
            "example": "11d66417-f8e2-4d0a-8955-822ea2bfddcd"
          },
          "solo": {
            "description": "Par\u00e2metro do Cat\u00e1logo de Ofertas de Produtos que indica onde esta Promo\u00e7\u00e3o \u00e9 compat\u00edvel ou n\u00e3o com outras",
            "type": "boolean",
            "example": false
          }
        }
      },
      "patchStatesRequest": {
        "description": "Request de cria\u00e7\u00e3o de um novo cliente sob a Organiza\u00e7\u00e3o Empresarial informada",
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "required": [
              "quoteId",
              "sourceState",
              "targetState"
            ],
            "properties": {
              "quoteId": {
                "description": "N\u00famero de Identifica\u00e7\u00e3o da Cota\u00e7\u00e3o da Netcracker",
                "type": "string",
                "example": "907ec52a-8032-4db7-8415-4a2f5ea21f2e"
              },
              "stateChangeReason": {
                "description": "Motivo da mudan\u00e7a do Status da Cota\u00e7\u00e3o. Exemplo \u2013 \u201cAprovar cota\u00e7\u00e3o\u201d",
                "type": "string",
                "example": "sample Approve Quote"
              },
              "sourceState": {
                "description": "Status atual da Cota\u00e7\u00e3o. Exemplo \u2013 \u201cENTERING\u201d",
                "type": "string",
                "example": "IN_PROGRESS"
              },
              "targetState": {
                "description": "Novo Status da Cota\u00e7\u00e3o. Exemplo \u2013 \u201cPENDING_APPROVAL\u201d",
                "type": "string",
                "example": "PENDING_APPROVAL"
              }
            }
          }
        }
      },
      "patchStatesResponse": {
        "type": "object",
        "properties": {
          "apiVersion": {
            "$ref": "#/components/schemas/apiVersion"
          },
          "transactionId": {
            "$ref": "#/components/schemas/transactionId"
          },
          "data": {
            "properties": {
              "href": {
                "description": "Atributo de referencia \u00e0 conta\u00e7\u00e3o.",
                "type": "string",
                "example": "https://public-gateway-cpq-int1.claro-cpq.managed.netcracker.cloud/quote-tmf-service/quoteManagement/quote/3953a502-c313-4c7c-a583-0d999abc84ff"
              },
              "id": {
                "description": "Identificador exclusivo da Cota\u00e7\u00e3o.",
                "type": "string",
                "example": "3953a502-c313-4c7c-a583-0d999abc84ff"
              },
              "expirationDate": {
                "description": "Data em que a Cota\u00e7\u00e3o expira",
                "type": "string",
                "format": "date-time",
                "example": "2022-12-20T09:02:25.176027Z"
              },
              "version": {
                "description": "Vers\u00e3o da cota\u00e7\u00e3o (por exemplo, se o cliente rejeitou a cota\u00e7\u00e3o, mas as negocia\u00e7\u00f5es ainda abrem, uma nova vers\u00e3o da cota\u00e7\u00e3o \u00e9 gerenciada)",
                "type": "string",
                "example": "42"
              },
              "number": {
                "description": "N\u00famero sequencial da Cota\u00e7\u00e3o.",
                "type": "string",
                "example": "348"
              },
              "description": {
                "description": "Atributo que representa a descri\u00e7\u00e3o da cota\u00e7\u00e3o.",
                "type": "string",
                "example": "Created via iFrame"
              },
              "category": {
                "description": "Usado para categorizar a Cota\u00e7\u00e3o de uma perspectiva de neg\u00f3cios que pode ser \u00fatil para o sistema CRM (nome da Categoria do Cliente).",
                "type": "string",
                "example": "X"
              },
              "state": {
                "description": "Estado da cota\u00e7\u00e3o. Patchable via API dedicada.",
                "type": "string",
                "example": "PENDING_APPROVAL"
              },
              "quoteDate": {
                "description": "Data e hora em que a cota\u00e7\u00e3o foi criada.",
                "type": "string",
                "format": "date-time",
                "example": "2022-12-20T09:02:25.176027Z"
              },
              "validFor": {
                "description": "O per\u00edodo durante a Cota\u00e7\u00e3o, ofertas e pre\u00e7os s\u00e3o v\u00e1lidos\n Cont\u00e9m os seguintes atributos: \n\u00b7  startDateTime;\n\u00b7  endDateTime.\nendDateTime \u00e9 o \u00fanico atributo pass\u00edvel de atualiza\u00e7\u00e3o.\n",
                "properties": {
                  "startDateTime": {
                    "description": "Data e hora em que a cota\u00e7\u00e3o foi criada.",
                    "type": "string",
                    "format": "startDateTime",
                    "example": "2022-12-20T09:02:25.176027Z"
                  },
                  "endDateTime": {
                    "description": "Data e hora em que a cota\u00e7\u00e3o foi criada.",
                    "type": "string",
                    "format": "endDateTime",
                    "example": "2022-12-20T09:02:25.176027Z"
                  }
                }
              },
              "relatedParties": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/relatedParties"
                }
              },
              "quoteItems": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/quoteItems"
                }
              },
              "quoteTotalPrices": {
                "description": "Representa o pre\u00e7o total da cota\u00e7\u00e3o.",
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/quoteTotalPrices"
                }
              },
              "customerCategory": {
                "type": "string",
                "description": "Identificador exclusivo da categoria do Cliente.",
                "example": "b8f6b060-2ac9-4836-91ba-d3b471a71743"
              },
              "customerId": {
                "type": "string",
                "description": "Identificador \u00fanico do cliente.",
                "example": "521069f3-c58e-4a4d-b1aa-29ecfef005aa"
              },
              "distributionChannelId": {
                "type": "string",
                "description": "Identificador exclusivo do Canal de Distribui\u00e7\u00e3o atrav\u00e9s do qual a Cota\u00e7\u00e3o foi criada.",
                "example": "95b3451d-afaa-4961-9f2b-5370416f99bd"
              },
              "initialDistributionChannelId": {
                "type": "string",
                "description": "ID de um Canal de Distribui\u00e7\u00e3o usado durante a cria\u00e7\u00e3o de cota\u00e7\u00f5es. O valor \u00e9 definido uma vez e nunca alterado durante o ciclo de vida da Cota\u00e7\u00e3o.",
                "example": "95b3451d-afaa-4961-9f2b-5370416f99bd"
              },
              "distributionChannelName": {
                "type": "string",
                "description": "Nome do Canal de Distribui\u00e7\u00e3o atrav\u00e9s do qual a Cota\u00e7\u00e3o foi criada.",
                "example": "Canal Direto"
              },
              "name": {
                "type": "string",
                "description": "Atributo informativo do nome da Cota\u00e7\u00e3o.",
                "example": "Quote #391"
              },
              "opportunityIds": {
                "type": "string",
                "description": "Identificador \u00fanico da Oportunidade.",
                "example": "OOOi0001114Q0mCAEE"
              },
              "revision": {
                "type": "string",
                "description": "Atributo \u00e9 usado para marcar a Cota\u00e7\u00e3o em andamento. \u00c9 incrementado em caso de altera\u00e7\u00f5es na Cota\u00e7\u00e3o ap\u00f3s a submiss\u00e3o.",
                "example": "0"
              },
              "updatedWhen": {
                "type": "string",
                "format": "date-time",
                "description": "Data e hora da atualiza\u00e7\u00e3o da cota\u00e7\u00e3o.",
                "example": "2022-03-22T17:54:58.045341Z"
              },
              "overrideMode": {
                "type": "string",
                "description": "Indica que tipo de pre\u00e7o \u00e9 substitu\u00edvel (GROSS ou NET).",
                "example": "GROSS",
                "enum": [
                  "GROSS",
                  "NET"
                ]
              },
              "approvalLevel": {
                "type": "string",
                "description": "N\u00edvel de aprova\u00e7\u00e3o para a Cota\u00e7\u00e3o.",
                "example": "0"
              },
              "placeRefs": {
                "description": "Local descrito por refer\u00eancia ou por valor vinculado a uma entidade espec\u00edfica.",
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/placeRefs"
                }
              },
              "extendedParameters": {
                "$ref": "#/components/schemas/extendedParameters"
              },
              "marketRefs": {
                "description": "Representa mercados relacionados.",
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/marketRefs"
                }
              },
              "geographicSiteGroups": {
                "description": "xxxxxxx",
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/geographicSiteGroups"
                }
              }
            }
          }
