      "originOpportunities": {
        "description": "Origem da Oportunidade determina a lista de ofertas-alvo a serem exibidas de acordo com o cen\u00e1rio de vendas.",
        "type": "string",
        "example": "Aquisi\u00e7\u00e3o",
        "enum": [
          "Aquisi\u00e7\u00e3o",
          "Aquisi\u00e7\u00e3o do mesmo",
          "Renova\u00e7\u00e3o",
          "Altera\u00e7\u00e3o",
          "Reposi\u00e7\u00e3o de Aparelhos Governo"
        ]
      },
      "quoteIds": {
