      "placeRefsSite": {
        "description": "Estrutura que cont\u00e9m os locais de instala\u00e7\u00e3o enviados durante a cria\u00e7\u00e3o/abertura do or\u00e7amento.",
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Place ref id",
            "example": "896bcdac-fa2b-5368-4387-18cff27a3a23"
          },
          "extendedParameters": {
            "type": "object",
            "properties": {
              "siteName": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "Nome do Site",
                  "example": [
                    "Jabaquara"
                  ]
                }
              },
              "siteCnlCode": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "Sigla CNL do endere\u00e7o de instala\u00e7\u00e3o.",
                  "example": [
                    "SPO"
                  ]
                }
              },
              "siteCnlAcronym": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "C\u00f3digo CNL do local de instala\u00e7\u00e3o",
                  "example": [
                    "SPO123"
                  ]
                }
              },
              "siteDocumentCnpj": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "CNPJ do local de instala\u00e7\u00e3o.",
                  "example": [
                    "12481670000156"
                  ]
                }
              },
              "siteMunicipalSubscription": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "Inscri\u00e7\u00e3o Municipal do local de instala\u00e7\u00e3o.",
                  "example": [
                    "24986160"
                  ]
                }
              },
              "siteStateSubscription": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "Inscri\u00e7\u00e3o Estadual do local de instala\u00e7\u00e3o.",
                  "example": [
                    "041234567"
                  ]
                }
              },
              "billingChargingCleAccount": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "Conta CLE, relacionada \u00e0 conta de cobran\u00e7a (conta + sub-conta CLE).",
                  "example": [
                    "123450002"
                  ]
                }
              },
              "billingChargingCnpj": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "CNPJ, relacionado do endere\u00e7o de cobran\u00e7a.",
                  "example": [
                    "44976580000122"
                  ]
                }
              },
              "billingDueDate": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "Data de vencimento da fatura. Esta data deve estar entre os dias 1 e 31 (dia do m\u00eas).",
                  "example": [
                    "10"
                  ]
                }
              },
              "billingFullAddress": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "Endere\u00e7o de cobran\u00e7a completo.",
                  "example": [
                    "Alameda Santos, 1945, Sobreloja H, S\u00e3o Paulo, SP"
                  ]
                }
              },
              "dischargeSapCode": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "C\u00f3digo descarga SAP.",
                  "example": [
                    "C-12356"
                  ]
                }
              },
              "sapStation": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "Esta\u00e7\u00e3o SAP.",
                  "example": [
                    "SAP-2356"
                  ]
                }
              },
              "osSap": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "OS SAP",
                  "example": [
                    "OS-98765"
                  ]
                }
              }
            }
          }
        }
      },
