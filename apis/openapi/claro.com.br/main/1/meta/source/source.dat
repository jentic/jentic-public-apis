        "description": "Determinam a Hierarquia de Vendas Respons\u00e1veis no processo de vendas para fornecer ofertas especiais. Uso de par\u00e2metro para fins de Elegibilidade de POC.",
        "type": "string",
        "example": "LESULCONNE"
      },
      "verticals": {
        "description": "\u00c9 a \u00e1rea de atua\u00e7\u00e3o da empresa (vis\u00e3o do grupo econ\u00f4mico).",
        "type": "string",
        "example": "EDUCA\u00c7\u00c3O"
      },
      "nationalBoards": {
        "description": "Determinam a Hierarquia de Vendas Respons\u00e1veis no processo de vendas para fornecer ofertas especiais. Uso de par\u00e2metro para fins de Elegibilidade de POC.",
        "type": "string",
        "example": "VES-96"
      },
      "segments": {
        "description": "segments identifica o mercado no sistema GAIA.",
        "type": "string",
        "example": "GOVERNO"
      },
      "technicalcontactNames": {
        "description": "Nome do contato para o cliente.",
        "type": "string",
        "example": "Marcos Paulo Serra"
      },
      "projectDescriptions": {
        "description": "Descri\u00e7\u00e3o do projeto em Salesforce.",
        "type": "string",
        "example": "PORTIF\u00d3LIO"
      },
      "portes": {
        "description": "Identifica o tamanho e a classifica\u00e7\u00e3o da empresa.",
        "type": "string",
        "example": "GR TOP1"
      },
      "contactPhoneNumbers": {
        "description": "Telefone do contato",
        "type": "string",
        "example": "11987654321"
      },
      "projectIds": {
        "description": "ID do projeto em GAIA",
        "type": "string",
        "example": "150606616"
      },
      "gol": {
        "description": "Parte da Receita referente ao servi\u00e7o GOL. O valor \u00e9 definido pelo CPQ durante a precifica\u00e7\u00e3o.",
        "type": "string",
        "example": "8.00"
      },
      "marketRefs": {
        "description": "Representa mercados relacionados.",
        "type": "object",
        "properties": {
          "marketId": {
            "description": "Identificador \u00fanico do Mercado.",
            "type": "string",
            "example": "a6f945a2-5552-4a89-bca4-4e7e5ed1e01b"
          },
          "marketName": {
            "description": "Nome do Mercado.",
            "type": "string",
            "example": "Brasil"
          }
        }
      },
      "geographicSiteGroups": {
        "description": "Representa um cont\u00eainer com o link para locais atribu\u00eddos ao item de cota\u00e7\u00e3o espec\u00edfico.",
        "type": "object",
        "properties": {
          "id": {
            "description": "Atributo gerado por NC.",
            "type": "string",
            "example": "a6f945a2-5552-4a89-bca4-4e7e5ed1e01b"
          },
          "name": {
            "description": "Atributo gerado por NC.",
            "type": "string",
            "example": "b7eb1fe3-a552-42bf-9cab-50af5bf5d933:a6f945a2-5552-4a89-bca4-4e7e5ed1e01b"
          },
          "marketId": {
            "description": "Atributo de link para o mercado .",
            "type": "string",
            "example": "b7eb1fe3-a552-42bf-9cab-50af5bf5d933:a6f945a2-5552-4a89-bca4-4e7e5ed1e01b"
          },
          "numberOfGeographicSites": {
            "description": "Valor dos locais atribu\u00eddos para o item de cota\u00e7\u00e3o relacionado.",
            "type": "string",
            "example": 1
          },
          "externalId": {
            "description": "Atributo dom mesmo valor que o \u201cid\u201d.",
            "type": "string",
            "example": "b7eb1fe3-a552-42bf-9cab-50af5bf5d933:a6f945a2-5552-4a89-bca4-4e7e5ed1e01b"
          },
          "extendedParameters": {
            "description": "Estrutura que cont\u00e9m par\u00e2metros espec\u00edficos adicionais",
            "type": "object",
            "properties": {
              "locationIds": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/locationIds"
                }
              },
              "availabilities": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/availabilities"
                }
              }
            }
          }
        }
      },
      "locationIds": {
        "description": "Matriz de IDs para locais atribu\u00eddos a um item de cota\u00e7\u00e3o relacionado",
        "type": "string",
        "example": "7fb28c07-54c4-4636-b9d7-77a0594a5afb"
      },
      "availabilities": {
        "description": "Matriz de IDs para locais atribu\u00eddos a um item de cota\u00e7\u00e3o relacionado. Sempre \u201con-net\u201d",
        "type": "string",
        "example": "on-net"
      },
      "siteAddressStreetNames": {
        "description": "Nome da rua.",
        "type": "string",
        "example": "Ant\u00f4nio Pincinato"
      },
      "siteAddressPostcodes": {
        "description": "C\u00f3digo postal.",
        "type": "string",
        "example": "13211-771"
      },
      "siteAddressComplements": {
        "description": "Complemento do endere\u00e7o.",
        "type": "string",
