  "components": {
    "securitySchemes": {
      "BasicAuth": {
        "type": "http",
        "scheme": "basic"
      },
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      },
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      },
      "OAuth2": {
        "type": "oauth2",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "/oauth2/v1/token",
            "scopes": {}
          }
        }
      }
    },
    "schemas": {
      "apiVersion": {
        "description": "Retorna sempre a vers\u00e3o major, minor e corre\u00e7\u00f5es da API efetivamente consumida. \n<br>O formato \u00e9 \u201cvers\u00e3o major.vers\u00e3o minor.corre\u00e7\u00f5es\u201d. Exemplo: \"apiVersion: 2.1.12;2021-05-14\". \n<br>Quando a vers\u00e3o major n\u00e3o \u00e9 solicitada, a vers\u00e3o contratada pelo cliente \u00e9 retornada. Quando n\u00e3o h\u00e1 restri\u00e7\u00e3o de contrata\u00e7\u00e3o, retorna a \u00faltima dispon\u00edvel.\n<br>Refer\u00eancia: https://semver.org/lang/pt-BR/",
        "type": "string",
        "example": "1;2025-02-21"
      },
      "transactionId": {
        "description": "Retorna o identificador de rastreabilidade de transa\u00e7\u00e3o gerado pela API. Caso o identificador foi fornecido pelo cliente, o mesmo \u00e9 colocado sem altera\u00e7\u00e3o.",
        "type": "string",
        "example": "26210a02-b77f-472c-882f-e8d24883b2ec"
      },
      "error": {
        "description": "Objeto retornado na ocorr\u00eancia de algum erro (4xx/5xx).",
        "required": [
          "apiVersion",
          "transactionId",
          "error"
        ],
        "type": "object",
        "properties": {
          "apiVersion": {
            "$ref": "#/components/schemas/apiVersion"
          },
          "transactionId": {
            "$ref": "#/components/schemas/transactionId"
          },
          "error": {
            "type": "object",
            "properties": {
              "httpCode": {
                "type": "string",
                "description": "C\u00f3digo de erro HTTP"
              },
              "errorCode": {
                "type": "string",
                "description": "C\u00f3digo de erro interno da API no formato. Ex.: API-3566. Esse c\u00f3digo poder\u00e1 ser utilizado internamente pelo cliente para mapeamento customizado da mensagem de erro."
              },
              "message": {
                "type": "string",
                "description": "Mensagem de erro resumida"
              },
              "detailedMessage": {
                "type": "string",
                "description": "Mensagem de erro detalhada."
              },
              "link": {
                "type": "object",
                "description": "Objeto para conter o link para a p\u00e1gina com a documenta\u00e7\u00e3o detalhada dos c\u00f3digos e descri\u00e7\u00f5es dos erros no API Portal\n",
                "properties": {
                  "rel": {
                    "type": "string",
                    "enum": [
                      "related"
                    ],
                    "description": "Para referenciar a p\u00e1gina de erros do API portal ser\u00e1 utilizada a sem\u00e2ntica \u201crelated\u201d nesse cen\u00e1rio"
                  },
                  "href": {
                    "type": "string",
                    "description": "URL completa do recurso"
                  }
                }
              }
            }
          }
        },
        "xml": {
          "name": "xml"
        }
      },
      "searchQuoteResponse": {
        "type": "object",
        "required": [
          "apiVersion",
          "transactionId",
          "data"
        ],
        "properties": {
          "apiVersion": {
            "$ref": "#/components/schemas/apiVersion"
          },
          "transactionId": {
            "$ref": "#/components/schemas/transactionId"
          },
          "data": {
            "type": "array",
            "description": "Estrutura de retorno com dados da cota\u00e7\u00e3o.",
            "items": {
              "$ref": "#/components/schemas/quoteItem"
            }
          }
        }
      },
      "quoteItem": {
        "description": "Dados da cota\u00e7\u00e3o",
        "required": [
          "href",
          "id",
          "version",
          "state",
          "quoteDate",
          "name"
        ],
        "properties": {
          "href": {
            "type": "string",
            "description": "Referencia a cota\u00e7\u00e3o.",
            "example": "https://public-gateway-cpq-int1.claro-cpq.managed.netcracker.cloud/quote-tmf-service/quoteManagement/quote/3953a502-c313-4c7c-a583-0d999abc84ff"
          },
          "id": {
            "description": "Identificador \u00fanico da Cota\u00e7\u00e3o.",
            "type": "string",
            "example": "3680ac68-2968-4e05-be5d-8d1405ccf1e1"
          },
          "version": {
            "description": "N\u00famero da vers\u00e3o da cota\u00e7\u00e3o.",
            "type": "string",
            "example": "410"
          },
          "state": {
            "description": "Estado da cota\u00e7\u00e3o.",
            "type": "string",
            "example": "ENTERING"
          },
          "quoteDate": {
            "description": "Data e hora em que a cota\u00e7\u00e3o foi criada.",
            "type": "string",
            "format": "date-time",
            "example": "2021-11-15T14:07:54.339286Z"
          },
          "name": {
            "description": "Nome da cota\u00e7\u00e3o.",
            "type": "string",
            "example": "Quote #348"
          },
          "extendedParameters": {
            "description": "O atributo cont\u00e9m par\u00e2metros adicionais para o cen\u00e1rio de vendas.",
            "type": "object",
            "properties": {
              "finalApprovalInfos": {
                "type": "array",
                "items": {
                  "description": "Estrutura das informa\u00e7\u00f5es de aprova\u00e7\u00e3o definidas no CPQ usando regras de aprova\u00e7\u00f5es",
                  "properties": {
                    "finalApprovalLevel": {
                      "description": "N\u00edvel de aprova\u00e7\u00e3o definida no CPQ usando regras de aprova\u00e7\u00e3o.",
                      "type": "number",
                      "example": 1
                    }
                  }
                }
              }
            }
          }
        }
      },
      "quoteItemSite": {
        "description": "Dados da cota\u00e7\u00e3o",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Id do quote item",
            "example": [
              "8a88d2c3-4e13-4c9e-91fd-58944c2c6673"
            ]
          },
          "extendedParameters": {
            "description": "O atributo cont\u00e9m par\u00e2metros adicionais para o cen\u00e1rio de vendas.",
            "type": "object",
            "properties": {
              "parentContractCode": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "ID do contrato, referencia o extendedParameters.parentContracts[].parentContractCode",
                  "example": [
                    "VES-3 UNV202500122"
                  ]
                }
              }
            }
          },
          "subAction": {
            "type": "string",
            "description": "Sub-a\u00e7\u00e3o a ser executada neste item da cota\u00e7\u00e3o durante o cancelamento em voo:\n\n\u2022\tROLLBACK\nPara maiores informa\u00e7\u00f5es de quando enviar esse parametro, verifique o document CPQ: CLBR1-DI-CPQ-008 - Cancelamento em voo\n",
            "example": "ROLLBACK"
          }
        }
      },
      "createQuoteResponse": {
        "type": "object",
        "description": "Identifica\u00e7\u00e3o do novo cliente, conta financeira e canal de pagamento que foram criados",
        "required": [
          "apiVersion",
          "transactionId",
          "data"
        ],
        "properties": {
          "apiVersion": {
            "$ref": "#/components/schemas/apiVersion"
          },
          "transactionId": {
            "$ref": "#/components/schemas/transactionId"
          },
          "data": {
            "properties": {
              "href": {
                "type": "string",
                "description": "Referencia a cota\u00e7\u00e3o.",
                "example": "https://public-gateway-cpq-int1.claro-cpq.managed.netcracker.cloud/quote-tmf-service/quoteManagement/quote/977d47ff-bffe-4221-ba35-9356d6cfe5d7"
              },
              "id": {
                "type": "string",
                "description": "Identificador \u00fanico da cota\u00e7\u00e3o.",
                "example": "977d47ff-bffe-4221-ba35-9356d6cfe5d7"
              },
              "expirationDate": {
                "type": "string",
                "description": "A data em que a Cota\u00e7\u00e3o expira.",
                "example": "2022-04-19T09:11:56.273205Z"
              },
              "version": {
                "type": "string",
                "description": "Vers\u00e3o da Cota\u00e7\u00e3o (por exemplo, se o cliente rejeitou a Cota\u00e7\u00e3o, mas as negocia\u00e7\u00f5es ainda abrem uma nova vers\u00e3o da Cota\u00e7\u00e3o \u00e9 gerenciada).",
                "example": "159"
              },
              "number": {
                "type": "string",
                "description": "N\u00famero sequencial da Cota\u00e7\u00e3o.",
                "example": "331"
              },
              "description": {
                "type": "string",
                "description": "Descri\u00e7\u00e3o da Cota\u00e7\u00e3o.",
                "example": "Created via iFrame"
              },
              "category": {
                "type": "string",
                "description": "Usado para categorizar a Cota\u00e7\u00e3o a partir de uma perspectiva de neg\u00f3cio que pode ser \u00fatil para o sistema CRM (nome da Categoria cliente).",
                "example": "Empresas"
              },
              "state": {
                "type": "string",
                "description": "Estado da cota\u00e7\u00e3o.",
                "example": "IN_PROGRESS"
              },
              "quoteDate": {
                "type": "string",
                "format": "DateTime",
                "description": "Data e hora quando a Cota\u00e7\u00e3o foi criada.",
                "example": "2022-01-19T09:11:56.273205Z"
              },
              "validFor": {
                "$ref": "#/components/schemas/validFor"
              },
              "relatedParties": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/relatedParties"
                }
              },
              "quoteItems": {
                "description": "Entidade que representa uma oferta de produtos na cota\u00e7\u00e3o.",
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/quoteItems"
                }
              },
              "quoteTotalPrices": {
                "description": "Representa o pre\u00e7o total da cota\u00e7\u00e3o.",
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/quoteTotalPrices"
                }
              },
              "customerCategory": {
                "type": "string",
                "description": "Identificador exclusivo da categoria do Cliente.",
                "example": "b8f6b060-2ac9-4836-91ba-d3b471a71743"
              },
              "customerId": {
                "type": "string",
                "description": "Identificador \u00fanico do cliente.",
                "example": "521069f3-c58e-4a4d-b1aa-29ecfef005aa"
              },
              "distributionChannelId": {
                "type": "string",
                "description": "Identificador exclusivo do Canal de Distribui\u00e7\u00e3o atrav\u00e9s do qual a Cota\u00e7\u00e3o foi criada.",
                "example": "95b3451d-afaa-4961-9f2b-5370416f99bd"
              },
              "initialDistributionChannelId": {
                "type": "string",
                "description": "ID de um Canal de Distribui\u00e7\u00e3o usado durante a cria\u00e7\u00e3o de cota\u00e7\u00f5es. O valor \u00e9 definido uma vez e nunca alterado durante o ciclo de vida da Cota\u00e7\u00e3o.",
                "example": "95b3451d-afaa-4961-9f2b-5370416f99bd"
              },
              "distributionChannelName": {
                "type": "string",
                "description": "Nome do Canal de Distribui\u00e7\u00e3o atrav\u00e9s do qual a Cota\u00e7\u00e3o foi criada.",
                "example": "Canal Direto"
              },
              "name": {
                "type": "string",
                "description": "Nome da Cota\u00e7\u00e3o.",
                "example": "Quote #391"
              },
              "opportunityIds": {
                "type": "string",
                "description": "Identificador \u00fanico da Oportunidade.",
                "example": "OOOi0001114Q0mCAEE"
              },
              "revision": {
                "type": "string",
                "description": "Atributo \u00e9 usado para marcar a Cota\u00e7\u00e3o em andamento. \u00c9 incrementado em caso de altera\u00e7\u00f5es na Cota\u00e7\u00e3o ap\u00f3s a submiss\u00e3o.",
                "example": "0"
              },
              "updatedWhen": {
                "type": "string",
                "format": "DateTime",
                "description": "Data e hora da atualiza\u00e7\u00e3o da cota\u00e7\u00e3o.",
                "example": "2022-03-22T17:54:58.045341Z"
              },
              "overrideMode": {
                "type": "string",
                "description": "Indica que tipo de pre\u00e7o \u00e9 substitu\u00edvel (GROSS ou NET).",
                "example": "GROSS",
                "enum": [
                  "GROSS",
                  "NET"
                ]
              },
              "approvalLevel": {
                "type": "string",
                "description": "N\u00edvel de aprova\u00e7\u00e3o para a Cota\u00e7\u00e3o.",
                "example": "0"
              },
              "placeRefs": {
                "description": "Local descrito por refer\u00eancia ou por valor vinculado a uma entidade espec\u00edfica.",
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/placeRefs"
                }
              },
              "extendedParameters": {
                "$ref": "#/components/schemas/extendedParameters"
              },
              "marketRefs": {
                "description": "Representa mercados relacionados.",
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/marketRefs"
                }
              },
              "geographicSiteGroups": {
                "description": "Representa mercados relacionados.",
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/geographicSiteGroups"
                }
              }
            }
          }
        }
      },
      "validFor": {
        "description": "O per\u00edodo durante a Cota\u00e7\u00e3o, ofertas e pre\u00e7os s\u00e3o v\u00e1lidos",
        "type": "object",
        "properties": {
          "startDateTime": {
            "description": "Data Inicial a Cota\u00e7\u00e3o, ofertas e pre\u00e7os s\u00e3o v\u00e1lidos.",
            "type": "string",
            "example": "2022-01-19T09:11:56.273205Z"
          },
          "endDateTime": {
            "description": "Data Final a Cota\u00e7\u00e3o, ofertas e pre\u00e7os s\u00e3o v\u00e1lidos",
            "type": "string",
            "example": "2022-04-19T09:11:56.273205Z"
          }
        }
      },
      "relatedParties": {
        "properties": {
          "id": {
            "description": "Identificador \u00fanico da Parte Relacionada.",
            "type": "string",
            "example": "76bc51c7-be09-4d18-b468-c9e9b5388553"
          },
          "role": {
            "description": "Papel da Parte Relacionada",
            "type": "string",
            "example": "Customer"
          }
        }
      },
      "quoteItems": {
        "properties": {
          "id": {
            "description": "Identificador exclusivo do Item de cota\u00e7\u00e3o. Caso o Item de Cota\u00e7\u00e3o seja iniciado a partir de um Produto, o Id \u00e9 selecionado automaticamente do Produto.\n\n Nota: Pode ser fornecido na solicita\u00e7\u00e3o no formato de UUID.\n",
            "example": "76bc51c7-be09-4d18-b468-c9e9b5388553"
          },
          "state": {
            "description": "Estado do Item de Cota\u00e7\u00e3o, por exemplo:\n \u00b7  OPEN\n \u00b7  QUALIFIED\n \u00b7  NOT_QUALIFIED\n \u00b7  COMPLETED\n",
            "type": "string",
            "example": "QUALIFIED",
            "enum": [
              "OPEN",
              "QUALIFIED",
              "NOT_QUALIFIED",
              "COMPLETED"
            ]
          },
          "quantity": {
            "description": "Indica a quantidade do Produto a ser cotado.\n Valor inicial = 1\n",
            "type": "integer",
            "example": "1"
          },
          "amount": {
            "description": "O valor do multiplicador que define se o Item de Cota\u00e7\u00e3o seria transformado em v\u00e1rias Inst\u00e2ncias de Produto na conclus\u00e3o do Processamento de Cota\u00e7\u00e3o\n Valor inicial = 1             \n",
            "type": "integer",
            "example": "1"
          },
          "action": {
            "description": "A\u00e7\u00e3o a ser executada neste Item de Cota\u00e7\u00e3o, por exemplo:\n\u00b7  ADD\n\u00b7  MODIFY\n\u00b7  DISCONNECT\n\u00b7  DASH           \n",
            "type": "string",
            "example": "ADD",
            "enum": [
              "ADD",
              "MODIFY",
              "DISCONNECT",
              "DASH"
            ]
          },
          "productOffering": {
            "type": "object",
            "properties": {
              "id": {
                "description": "Identificador \u00fanico da Oferta de Produto.",
                "type": "string",
                "example": "12ea696c-f3f0-4c56-885f-503ec66a7066"
              },
              "name": {
                "description": "Nome da Oferta de Produto",
                "type": "string",
                "example": "10MB Telemetria Individual (CAT-M)"
              }
            }
          },
          "quoteItemPrices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/quoteItemPrices"
            }
          },
          "product": {
            "$ref": "#/components/schemas/product"
          },
          "parentQuoteItemId": {
            "description": "Identificador exclusivo do item de cota\u00e7\u00e3o pai.\n\nNota: Pode ser fornecido na solicita\u00e7\u00e3o no formato de UUID para especificar a hierarquia necess\u00e1ria dos itens de cota\u00e7\u00e3o.\n",
            "type": "string",
            "example": "340a27c5-4d5f-49ab-830c-4ebacad414d0"
          },
          "quoteItemType": {
            "description": "Indica o tipo base (classe) do Item de Cota\u00e7\u00e3o.",
            "type": "string",
            "example": "Product offering"
          },
          "rootQuoteItemId": {
            "description": "Identificador exclusivo do item de cota\u00e7\u00e3o raiz.",
            "type": "string",
            "example": "340a27c5-4d5f-49ab-830c-4ebacad414d0"
          },
          "marketId": {
            "description": "Identificador \u00fanico do Mercado.",
            "type": "string",
            "example": "a6f945a2-5552-4a89-bca4-4e7e5ed1e01b"
          },
          "distributionChannelId": {
            "description": "Identificador exclusivo do Canal de Distribui\u00e7\u00e3o atrav\u00e9s do qual a Cota\u00e7\u00e3o foi criada.",
            "type": "string",
            "example": "95b3451d-afaa-4961-9f2b-5370416f99bd"
          },
          "availabilityCheckResult": {
            "description": "Armazena o resultado da verifica\u00e7\u00e3o de disponibilidade.",
            "type": "string",
            "example": "AVAILABLE"
          },
          "approvalLevel": {
            "description": "N\u00edvel de aprova\u00e7\u00e3o do Item de Cota\u00e7\u00e3o.",
            "type": "string",
            "example": "0"
          },
          "extendedParameters": {
            "description": "O atributo cont\u00e9m par\u00e2metros adicionais da entidade e mostra o estado da verifica\u00e7\u00e3o de viabilidade.",
            "type": "object",
            "properties": {
              "states": {
                "description": "Estado da Verifica\u00e7\u00e3o de Viabilidade (FC - Feasibility Check)",
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/states"
                }
              }
            }
          },
          "creationTime": {
            "description": "Tempo de cria\u00e7\u00e3o.",
            "type": "string",
            "example": "2022-03-22T16:28:59.399064Z"
          },
          "geographicSiteGroupId": {
            "description": "No n\u00edvel de item de cota\u00e7\u00e3o o parametro em quest\u00e3o, \u00e9 uma string \u00fanica com id para o \"geographicSiteGroup.",
            "type": "string",
            "example": "636f5931-a56c-4750-9445-d703385cb578"
          }
        }
      },
      "quoteItemPrices": {
        "properties": {
          "priceType": {
            "description": "Tipo de pre\u00e7o, por exemplo:\n\u00b7  RC\n\u00b7  NRC\n\u00b7  Total RC\n\u00b7  Total NRC\n\u00b7  Total RC Reduction\n\u00b7  Total NRC Reduction\n\u00b7  Total RC Tax\n\u00b7  Total NRC Tax\n\u00b7  Total Deactivation Fee\n\u00b7  Total Deactivation Fee Tax\n",
            "type": "string",
            "example": "RC",
            "enum": [
              "RC",
              "NRC",
              "Total RC",
              "Total NRC",
              "Total RC Reduction",
              "Total NRC Reduction",
              "Total RC Tax",
              "Total NRC Tax",
              "Total Deactivation Fee",
              "Total Deactivation Fee Tax"
            ]
          },
          "recurringChargePeriod": {
            "description": "Per\u00edodo de cobran\u00e7a dos encargos recorrentes, por exemplo:\n\u00b7  Day\n\u00b7  Week\n\u00b7  Month\n\u00b7  Quarter\n\u00b7  Year\nNota: o atributo deve ser preenchido apenas para quoteItemPrices (pre\u00e7o unit\u00e1rio)\n",
            "type": "string",
            "example": "Month",
            "enum": [
              "Day",
              "Week",
              "Month",
              "Quarter",
              "Year"
            ]
          },
          "name": {
            "description": "Nome do Pre\u00e7o do Item de Cota\u00e7\u00e3o.\n \u00b7 para Pre\u00e7o Unit\u00e1rio -%Nome da Especifica\u00e7\u00e3o do Componente de Pre\u00e7o%\n \u00b7 para Total por Local, Produto ou Cota\u00e7\u00e3o - Total RC/NRC por Local, Produto ou Cota\u00e7\u00e3o\n",
            "type": "string",
            "example": "Montlhy Charge Price"
          },
          "price": {
            "properties": {
              "taxIncludedAmount": {
                "description": "Todos os impostos inclu\u00eddos valor",
                "type": "string",
                "example": "5.00"
              },
              "dutyFreeAmount": {
                "description": "Valor de todos os impostos exclu\u00eddos",
                "type": "string",
                "example": "3.37"
              },
              "overridden": {
                "description": "O sinalizador indica se o pre\u00e7o \u00e9 ou n\u00e3o substitu\u00eddo (definido como True se overiddenValue for fornecido)",
                "type": "boolean",
                "example": false
              },
              "taxRate": {
                "description": "Atributo para taxa de imposto",
                "type": "number",
                "format": "float",
                "example": 48.26896
              },
              "deltaPercentage": {
                "description": "Porcentagem de desconto aplicado na oferta ",
                "type": "string",
                "example": "- 73,76 %"
              },
              "priceValueRef": {
                "description": "Identificador exclusivo do pre\u00e7o do Cat\u00e1logo de Ofertas de Produtos:\n \u00b7 Para pre\u00e7o em QuotePrice, priceValueRef = Price Key Id e depende de QuotePrice.priceType\n \u00b7 Para pre\u00e7o em PriceAlteration, priceValueRef = ID da a\u00e7\u00e3o de promo\u00e7\u00e3o no cat\u00e1logo de ofertas de produtos\n",
                "type": "string",
                "example": "c6cfcb57-ad61-47e9-88ce-6da10f8ece29"
              },
              "prodOfferingPriceTaxAlterationId": {
                "description": "Identificador \u00fanico do envolvimento fiscal",
                "type": "string",
                "example": "0e1d1803-8a83-4656-bb7b-5d7605e99b04"
              },
              "valueBasePriceExcludingTax": {
                "description": "Pre\u00e7o Base/Valor Absoluto da Promo\u00e7\u00e3o excluindo impostos",
                "type": "string",
                "example": "3.372250"
              },
              "valueBasePriceExcludingTaxRounded": {
                "description": "Pre\u00e7o base/valor absoluto da promo\u00e7\u00e3o valor arredondado excluindo impostos",
                "type": "string",
                "example": "3.37"
              },
              "valueBasePriceIncludingTax": {
                "description": "Pre\u00e7o Base/Promo\u00e7\u00e3o Valor absoluto incluindo impostos",
                "type": "string",
                "example": 5
              },
              "valueBasePriceIncludingTaxRounded": {
                "description": "Pre\u00e7o base/promo\u00e7\u00e3o Valor arredondado absoluto incluindo impostos",
                "type": "string",
                "example": "5.00"
              },
              "valueExcludingTax": {
                "description": "Valor do pre\u00e7o excluindo impostos",
                "type": "string",
                "example": "3.372250"
              },
              "valueExcludingTaxRounded": {
                "description": "Valor arredondado do pre\u00e7o sem impostos",
                "type": "string",
                "example": "3.37"
              },
              "valueIncludingTax": {
                "description": "Valor do pre\u00e7o incluindo impostos",
                "type": "string",
                "example": 5
              },
              "valueIncludingTaxRounded": {
                "description": "Valor arredondado do pre\u00e7o incluindo impostos",
                "type": "string",
                "example": "5.00"
              },
              "valueSubTotalPriceExcludingTax": {
                "description": "Pre\u00e7o subtotal do item de cota\u00e7\u00e3o excluindo impostos",
                "type": "string",
                "example": "3.372250"
              },
              "valueSubTotalPriceExcludingTaxRounded": {
                "description": "Pre\u00e7o subtotal arredondado do item de cota\u00e7\u00e3o excluindo impostos",
                "type": "string",
                "example": "3.37"
              },
              "valueSubTotalPriceIncludingTax": {
                "description": "Pre\u00e7o subtotal do item de cota\u00e7\u00e3o, incluindo impostos",
                "type": "string",
                "example": "5"
              },
              "valueSubTotalPriceIncludingTaxRounded": {
                "description": "Pre\u00e7o do item de cota\u00e7\u00e3o subtotal arredondado, incluindo impostos",
                "type": "string",
                "example": "5.00"
              }
            }
          },
          "priceComponentSpecificationRef": {
            "description": "Identificador exclusivo da Especifica\u00e7\u00e3o do Componente de Pre\u00e7o.\n\n Nota: o atributo deve ser preenchido apenas para quoteItemPrices (unit price).\n",
            "type": "string",
            "example": "7b71c6bf-2b69-416e-b7e3-f14c738df04d"
          },
          "priceSpecificationType": {
            "description": "Especifica\u00e7\u00e3o do tipo de pre\u00e7o (Nome da Especifica\u00e7\u00e3o do Componente de Pre\u00e7o), por exemplo:\n\u00b7  Activation fee\n\u00b7  Deactivation fee\n\u00b7  Recurrent fee\n\u00b7  Usage fee\nObserva\u00e7\u00e3o: o atributo deve ser preenchido apenas para quoteItemPrices (pre\u00e7o unit\u00e1rio).\n",
            "type": "string",
            "example": "Montlhy Charge Price"
          },
          "priceCurrency": {
            "description": "Moeda do pre\u00e7o do Cat\u00e1logo de Ofertas de Produtos.",
            "type": "string",
            "example": "BRL"
          }
        }
      },
      "product": {
        "description": "Descri\u00e7\u00e3o dos produtos em cota\u00e7\u00e3o.",
        "type": "object",
        "properties": {
          "name": {
            "description": "Nome do produto em cota\u00e7\u00e3o.",
            "type": "string",
            "example": "10MB Telemetria Individual (CAT-M) #1"
          },
          "characteristics": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/characteristics"
            }
          },
          "productSpecification": {
            "$ref": "#/components/schemas/productSpecification"
          }
        }
      },
      "characteristics": {
        "description": "Entidade que representa caracter\u00edstica da Oferta de Produtos",
        "type": "object",
        "properties": {
          "id": {
            "description": "Exibindo o o n\u00famero \u00fanico da Caracter\u00edstica.",
            "type": "string",
            "example": "a4718558-fcaf-4c3d-a6d8-d0063575f655"
          },
          "name": {
            "description": "Exibindo o nome da Caracter\u00edstica.",
            "type": "string",
            "example": "Plataforma do Produto"
          },
          "values": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/values"
            }
          },
          "rawValues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/rawValues"
            }
          },
          "visible": {
            "description": "Atributo reflete a visibilidade da Caracter\u00edstica na interface do usu\u00e1rio.",
            "type": "string",
            "example": "false"
          }
        }
      },
      "values": {
        "description": "Exibindo valor (s) da Caracter\u00edstica para a lista.",
        "type": "string",
        "example": "Mobilidade"
      },
      "rawValues": {
        "description": "Valor bruto da Caracter\u00edstica.",
        "type": "string",
        "example": "Mobilidade"
      },
      "productSpecification": {
        "description": "Referencia da especifica\u00e7\u00e3o do produto.",
        "type": "object",
        "properties": {
          "id": {
            "description": "Identificador exclusivo da Especifica\u00e7\u00e3o do Produto.",
            "type": "string",
            "example": "b0082535-403f-46d2-9d5e-d0db6b5c6725"
          },
          "version": {
            "description": "Vers\u00e3o da Especifica\u00e7\u00e3o do Produto.",
            "type": "string",
            "example": "0.2"
          },
          "name": {
            "description": "Nome da Especifica\u00e7\u00e3o do Produto.",
            "type": "string",
            "example": "Claro Cat-M (PS)"
          }
        }
      },
      "quoteTotalPrices": {
        "description": "Representa o pre\u00e7o total da cota\u00e7\u00e3o.",
        "type": "object",
        "properties": {
          "priceType": {
            "description": "Uma categoria que descreve o pre\u00e7o como recorrente.",
            "type": "string",
            "example": "Total NRC"
          },
          "name": {
            "type": "string",
            "description": "Nome da categoria que descreve o pre\u00e7o como recorrente.",
            "example": "Total NRC by Quote"
          },
          "price": {
            "description": "A entidade que cont\u00e9m valores de pre\u00e7o.",
            "type": "object",
            "properties": {
              "taxIncludedAmount": {
                "type": "string",
                "description": "Todos os impostos inclu\u00eddos somam.",
                "example": "0.00"
              },
              "dutyFreeAmount": {
                "type": "string",
                "description": "Todos os impostos exclu\u00eddos.",
                "example": "0.00"
              },
              "valueExcludingTaxRounded": {
                "type": "string",
                "description": "Pre\u00e7o arredondado excluindo impostos.",
                "example": "0.00"
              },
              "valueIncludingTaxRounded": {
                "type": "string",
                "description": "Pre\u00e7o arredondado, incluindo impostos.",
                "example": "0.00"
              }
            }
          },
          "priceCurrency": {
            "description": "Moeda do pre\u00e7o do Cat\u00e1logo de Ofertas de Produtos.",
            "type": "string",
            "example": "BRL"
          }
        }
      },
      "placeRefs": {
        "description": "Um local relacionado define um local descrito por refer\u00eancia ou por valor vinculado a uma entidade espec\u00edfica.",
        "type": "object",
        "properties": {
          "id": {
            "description": "Identificador \u00fanico do local relacionado.",
            "type": "string",
            "example": "7fb28c07-54c4-4636-b9d7-77a0594a5afb"
          },
          "name": {
            "description": "Nome do local relacionado.",
            "type": "string",
            "example": "Home"
          },
          "role": {
            "description": "Fun\u00e7\u00e3o do local relacionado.",
            "type": "string",
            "example": "customerLocation"
          },
          "addedToTheQuote": {
            "description": "Flag que indica se a fun\u00e7\u00e3o \u00e9 adicionado ou n\u00e3o \u00e0 Cota\u00e7\u00e3o",
            "type": "boolean",
            "example": true
          },
          "address": {
            "description": "Endere\u00e7o do local relacionado.",
            "type": "string",
            "example": "Av Ant\u00f4nio Pincinato 11036, Jundia\u00ed, Jardim Guanabara"
          },
          "externalId": {
            "description": "Identificador externo do local a partir do sistema mestre.",
            "type": "string",
            "example": "1234567891"
          },
          "marketId": {
            "description": "Identificador \u00fanico da \u00e1rea geogr\u00e1fica \u00e0 qual este Lugar pertence.",
