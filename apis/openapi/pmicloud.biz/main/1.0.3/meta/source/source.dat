{
  "openapi": "3.0.2",
  "externalDocs": {
    "url": "https://wiki.app.pconnect.biz/display/DCXLYLT/DCX+MAE+-++Architecture+and+Design",
    "description": "Confluence documentation on Voucher API - Documentation on Confluence to be provided"
  },
  "servers": [
    {
      "url": "https://voucher-api.aws.pmicloud.biz/",
      "description": "Prod API"
    }
  ],
  "info": {
    "title": "Voucher API",
    "version": "1.0.3",
    "contact": {
      "email": "Zuleyha.Yildiz@pmi.com",
      "name": "Zuleyha Yildiz"
    },
    "description": "The Voucher REST API enables seamless integration with our voucher code providers by offering a robust set of endpoints to validate and burn codes.\n\n## Key Concepts of Voucher \n\n## Voucher\n#### A voucher is a digital or physical token that represents a predefined value or entitlement, which can be redeemed for goods, services, or discounts. It is often:Issued by a brand or retailer. Linked to a specific value (e.g., €10 off, free product). Redeemable under certain conditions (e.g., expiry date, minimum purchase).A voucher is typically unique, trackable, and validated before redemption—making it ideal for QR code-based loyalty programs.\n\n## Redemption \n\n#### The act of using a voucher to claim its benefit. Redemption rules determine how and when a voucher can be used.\n\n## Expiration Date \n\n#### The date after which the voucher becomes invalid and can no longer be redeemed.\n\n## Usage Tracking \n\n#### Monitoring how often and by whom a voucher is used, useful for analytics and fraud prevention.\n\n## Status \n\n#### Indicates the current state of a voucher: active, redeemed, expired, or disabled.\n---\n## Authentication\nOur API uses OAuth 2.0 for authentication. You will need to acquire an access token to interact with any endpoints.\n\n1. Obtain an Access Token\nYou can get an access token by following our OAuth 2.0 authorization flow.\n[Link to authorization guide].\n\n2. Use Access Token\nInclude the access token in the Authorization header for all API requests:\nAuthorization: Bearer {access_token}\n---\n## Rate Limiting\n#### We enforce a rate limit of 200 requests per minute per client. When you approach the limit, you'll receive a 429 Too Many Requests response.\n---\n## Service Level Agreement (SLA) for Response Time:\n1. **95% of requests** to all endpoints will return within **100ms**.\n2. **99% of requests** will return within **200ms**.\n3. We aim to keep response times under **500ms** even under heavy load, though this may vary during traffic spikes.\n---\n## Changelog\nv1.0.0 (2025-10-21)\n1. Initial release.\n---\n",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/infosys-ae0/Voucher-API/1.0.3"
  },
  "paths": {
    "/vouchers/{code}/status": {
      "get": {
        "summary": "Validate the code",
        "description": "This API enpoint checks the validity of code against the defined set of rules (like valid, unused, and eligible) by connecting to the appropriate code provider.",
        "parameters": [
          {
            "name": "X-ApplicationId",
            "in": "header",
            "required": true,
            "description": "Identifier (LeanIX Id) of the application from which call is originated from.",
            "schema": {
              "type": "string",
              "example": "LX07929"
            }
          },
          {
            "name": "X-Channel",
            "in": "header",
            "required": true,
            "description": "Identifier of the channel from which call is originated from.",
            "schema": {
              "type": "string",
              "example": "WEBSITE OR CEF OR DIRECTRETAIL OR INDIRECTRETAIL OR INDIRECTRETAILSR"
            }
          },
          {
            "name": "consumerId",
            "in": "header",
            "required": true,
            "description": "Gigya id fetched from DCX CIAM",
            "schema": {
              "type": "string",
              "example": "a6e128552ec5461f97275479b59b6ce5"
            }
          },
          {
            "name": "codeType",
            "in": "header",
            "required": true,
            "description": "Specify the code format (e.g., QR, UPC, PMI Internal Voucher, External Voucher)",
            "schema": {
              "type": "string",
              "example": "QR"
            }
          },
          {
            "name": "code",
            "in": "path",
            "required": true,
            "description": "Code printed on product to be validated to gain access",
            "schema": {
              "type": "string",
              "example": "euh8274uerhw8924ui94dgd3gwwdg22yw"
            }
          },
          {
            "name": "country",
            "in": "header",
            "required": true,
            "description": "Identifier of the country specified in the standard ISO code format.",
            "schema": {
              "type": "string",
              "example": "ID"
            }
          },
          {
            "name": "category",
            "in": "header",
            "required": false,
            "description": "Product category. P1 for HnB (e.g., IQOS), P4 for Vape products (e.g., VEEV), P5 for Oral products (e.g., ZYN)",
            "schema": {
              "type": "string",
              "example": "P1"
            }
          },
          {
            "name": "Accept-Language",
            "in": "header",
            "description": "The header advertises which languages the client is able to understand, and which locale variant is preferred. (By languages, we mean natural languages, such as English, and not programming languages.)",
            "schema": {
              "type": "string",
              "example": "fr-CH"
            }
          }
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CodeValidationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "example": {
                  "message": "Invalid input, missing parameters, malformed request."
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "example": {
                  "message": "Missing or invalid authentication token."
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "example": {
                  "message": "Authenticated but not allowed to perform the action."
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "example": {
                  "message": "Code or resource not found."
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "example": {
                  "message": "Code already redeemed or in use."
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "example": {
                  "message": "Valid request format but semantically incorrect (e.g., expired voucher)."
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "example": {
                  "message": "Unexpected server-side error."
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "example": {
                  "message": "Temporary server overload or maintenance."
                }
              }
            }
          }
        }
      }
    },
    "/vouchers/{code}/redeem": {
      "put": {
        "summary": "Redeem the code",
        "description": "This API enpoint helps in redeem the code  by connecting to the appropriate code provider.",
        "parameters": [
          {
            "name": "X-ApplicationId",
            "in": "header",
            "required": true,
            "description": "Identifier (LeanIX Id) of the application from which call is originated from.",
            "schema": {
              "type": "string",
              "example": "LX07929"
            }
          },
          {
            "name": "X-Channel",
            "in": "header",
            "required": true,
            "description": "Identifier of the channel from which call is originated from.",
            "schema": {
              "type": "string",
              "example": "WEBSITE OR CEF OR DIRECTRETAIL OR INDIRECTRETAIL OR INDIRECTRETAILSR"
            }
          },
          {
            "name": "consumerId",
            "in": "header",
            "required": true,
            "description": "Gigya id fetched from DCX CIAM",
            "schema": {
              "type": "string",
              "example": "a6e128552ec5461f97275479b59b6ce5"
            }
          },
          {
            "name": "codeType",
            "in": "header",
            "required": true,
            "description": "Specify the code format (e.g., QR, UPC, Internal Voucher, External Voucher)",
            "schema": {
              "type": "string",
              "example": "QR"
            }
          },
          {
            "name": "code",
            "in": "path",
            "required": true,
            "description": "Code printed on product to be validated to gain access",
            "schema": {
              "type": "string",
              "example": "euh8274uerhw8924ui94dgd3gwwdg22yw"
            }
          },
          {
            "name": "country",
            "in": "header",
            "required": true,
            "description": "Identifier of the country specified in the standard ISO code format.",
            "schema": {
              "type": "string",
              "example": "ID"
            }
          },
          {
            "name": "category",
            "in": "header",
            "required": false,
            "description": "Product category. P1 for HnB (e.g., IQOS), P4 for Vape products (e.g., VEEV), P5 for Oral products (e.g., ZYN)",
            "schema": {
              "type": "string",
              "example": "P1"
            }
          },
          {
            "name": "Accept-Language",
            "in": "header",
            "description": "The header advertises which languages the client is able to understand, and which locale variant is preferred. (By languages, we mean natural languages, such as English, and not programming languages.)",
            "schema": {
              "type": "string",
              "example": "fr-CH"
            }
          }
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CodeRedemptionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "example": {
                  "message": "Invalid input, missing parameters, malformed request."
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "example": {
                  "message": "Missing or invalid authentication token."
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "example": {
                  "message": "Authenticated but not allowed to perform the action."
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "example": {
                  "message": "Code or resource not found."
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "example": {
                  "message": "Code already redeemed or in use."
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "example": {
                  "message": "Valid request format but semantically incorrect (e.g., expired voucher)."
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "example": {
                  "message": "Unexpected server-side error."
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "example": {
                  "message": "Temporary server overload or maintenance."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "CodeValidationResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Code sent for validation",
            "example": "euh8274uerhw8924ui94dgd3gwwdg22yw"
          },
          "codeType": {
            "type": "string",
            "description": "Specify the code format (e.g., QR, UPC, PMI Internal Voucher, External Voucher)",
            "example": "QR"
          },
          "country": {
            "type": "string",
            "description": "Identifier of the country specified in the standard ISO code format.",
            "example": "ID"
          },
          "status": {
            "type": "string",
            "description": "Status of the code",
            "example": "active or redeemed or expired or disabled."
          },
          "message": {
            "type": "string",
            "description": "To offer business-friendly reason in case of code is not valid.",
            "example": "Code is invalid or already redeemed."
          }
        }
      },
      "CodeRedemptionResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Code sent for redemption",
            "example": "euh8274uerhw8924ui94dgd3gwwdg22yw"
          },
          "codeType": {
            "type": "string",
            "description": "Specify the code format (e.g., QR, UPC, PMI Internal Voucher, External Voucher)",
            "example": "QR"
          },
          "consumerId": {
            "type": "string",
            "description": "Gigya id fetched from DCX CIAM",
            "example": "a6e128552ec5461f97275479b59b6ce5"
          },
          "country": {
            "type": "string",
            "description": "Identifier of the country specified in the standard ISO code format.",
            "example": "ID"
          },
          "status": {
            "type": "string",
            "description": "Status of the redemption",
            "example": "Redeemed or Not redeemed."
          },
          "message": {
            "type": "string",
            "description": "To offer business-friendly reason in case of code is not valid.",
            "example": "Code is invalid or already redeemed."
          }
        }
      }
    }
  }
}
