    },
    "termsOfService": "",
    "title": "Q8-KPNWE-Cutover",
    "version": "1.1.0",
    "x-ibm-name": "api-cutover",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/KOLESNYKGANNA/cut/1.1.0"
  },
  "servers": [
