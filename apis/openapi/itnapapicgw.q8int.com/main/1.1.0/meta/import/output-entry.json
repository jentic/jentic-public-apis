                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "not found"
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "unsupported media type"
          },
          "429": {
