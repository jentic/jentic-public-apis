      "url": "https://itnapapicgw.q8int.com/kpnwe/api-int/api/cutover/v1"
    }
  ],
  "paths": {
    "/cutovers": {
      "post": {
        "parameters": [
          {
            "description": "Unique identifier of the request",
            "in": "header",
            "name": "X-Request-Id",
            "required": false,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "description": "Correlation Id",
            "in": "header",
            "name": "X-Correlation-Id",
            "required": false,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "description": "Receiver Id",
            "in": "header",
            "name": "X-Receiver-Id",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Sender Id",
            "in": "header",
            "name": "X-Sender-Id",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "The request has been accepted."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "The value of one or more request parameters is not valid."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "unauthorized"
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "unsupported media type"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "too many requests"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "internal server error"
          }
        },
        "tags": [
          "cutover-controller"
        ],
        "operationId": "createNewCutoverUsingPOST",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Cutover"
              }
            }
          },
          "description": "cutover information",
          "required": true
        },
        "summary": "create new Cutover"
      }
    },
    "/health": {
      "get": {
        "responses": {
          "200": {
