:{"url":{"type":"string"},"plan":{"type":"string"}}}}}},"400":{"description":"Invalid plan","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"Already on that plan","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"503":{"description":"Billing not enabled","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/languages":{"get":{"tags":["Evaluate"],"operationId":"listLanguages","summary":"Input languages the prebuilt rule sets were tested in, with the date and size of the test","security":[],"responses":{"200":{"description":"Languages","content":{"application/json":{"schema":{"type":"object","properties":{"input_languages":{"type":"string"},"response_language":{"type":"string"},"tested":{"type":"array","items":{"type":"object","properties":{"code":{"type":"string"},"name":{"type":"string"},"native_name":{"type":"string"},"checks":{"type":"integer"},"matched_expected":{"type":"integer"}}}},"test":{"type":"object"}}}}}}}}},"/api/v1/plans":{"get":{"tags":["Billing"],"operationId":"listPlans","summary":"Public plan catalog with limits and prices","security":[],"responses":{"200":{"description":"Plans","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PlanCatalog"}}}}}}},"/api/v1/billing":{"get":{"tags":["Billing"],"operationId":"getBilling","summary":"Current plan, limit and subscription status","responses":{"200":{"description":"Billing status","content":{"application/json":{"schema":{"$ref":"#/components/schemas/BillingStatus"}}}},"401":{"description":"Missing or invalid API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}},"delete":{"tags":["Billing"],"operationId":"cancelSubscription","summary":"Cancel at the end of the current period","responses":{"200":{"description":"Scheduled","content":{"application/json":{"schema":{"type":"object","properties":{"plan":{"type":"string"},"cancels_at":{"type":["string","null"]},"subscription_status":{"type":"string"}}}}}},"401":{"description":"Missing or invalid API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"No active subscription","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"503":{"description":"Billing not enabled","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/billing/checkout":{"post":{"tags":["Billing"],"operationId":"createCheckout","summary":"Hosted Stripe Checkout URL for a person to complete","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["plan"],"properties":{"plan":{"type":"string","enum":["starter","growth","scale"]},"success_url":{"type":"string","format":"uri"},"cancel_url":{"type":"string","format":"uri"}}}}}},"responses":{"201":{"description":"Checkout session","content":{"application/json":{"schema":{"type":"object","properties":{"url":{"type":"string","format":"uri"},"plan":{"type":"string"},"expires_in_seconds":{"type":"integer"}}}}}},"400":{"description":"Invalid plan or URLs","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"Already subscribed; use subscribe or portal","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"503":{"description":"Billing not enabled","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/billing/subscribe":{"post":{"tags":["Billing"],"operationId":"subscribe","summary":"Subscribe or switch plans with no browser","description":"New subscriptions need a Stripe payment method id (pm_...), created with Stripe.js, a Stripe test token, or an agent payment provider. Switching an existing subscription needs only the plan and is prorated. Returns 202 with payment_url when the bank requires an extra confirmation step.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["plan"],"properties":{"plan":{"type":"string","enum":["starter","growth","scale"]},"payment_method":{"type":"string","pattern":"^pm_[A-Za-z0-9]+$"}}}}}},"responses":{"201":{"description":"Active","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SubscribeResponse"}}}},"202":{"description":"Requires action","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SubscribeResponse"}}}},"400":{"description":"Validation error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"402":{"description":"Payment method rejected","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"Already on that plan","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"503":{"description":"Billing not enabled","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/billing/credits/checkout":{"post":{"tags":["Billing"],"operationId":"createCreditCheckout","summary":"One-time Checkout for a prepaid credit pack (card or stablecoin)","description":"Credits are spent after the day's plan allowance is used and never expire. Packs: small (10,000 for $19), medium (100,000 for $149), large (1,000,000 for $999). Evaluate responses carry X-Credits-Remaining and X-Quota-Source: credits when credits are used.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["pack"],"properties":{"pack":{"type":"string","enum":["small","medium","large"]},"success_url":{"type":"string","format":"uri"},"cancel_url":{"type":"string","format":"uri"}}}}}},"responses":{"201":{"description":"Checkout session","content":{"application/json":{"schema":{"type":"object","properties":{"url":{"type":"string","format":"uri"},"pack":{"type":"string"},"credits":{"type":"integer"},"price_usd":{"type":"number"},"expires_in_seconds":{"type":"integer"}}}}}},"400":{"description":"Invalid pack or URLs","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"503":{"description":"Billing not enabled","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/x402/evaluate":{"post":{"tags":["Evaluate"],"operationId":"x402Evaluate","summary":"Evaluate and pay per call in USDC (x402), no account needed","security":[],"x-payment-info":{"price":{"mode":"fixed","currency":"USD","amount":"0.002000"},"protocols":[{"x402":{}}]},"description":"Same body and response as POST /api/v1/evaluate. Without an X-PAYMENT header the response is 402 with x402 payment requirements. Sign them with an x402 client and resend; settlement happens only after a successful evaluation. The response adds a `paid` object.","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/EvaluateRequest"}}}},"responses":{"200":{"description":"Verdict","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Evaluation"}}}},"400":{"description":"Invalid input","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"402":{"description":"Payment required (x402 requirements in the body)"},"429":{"description":"Capacity exhausted","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"502":{"description":"Evaluation engine error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/x402/execute":{"post":{"tags":["Evaluate"],"operationId":"x402Execute","summary":"The same paid evaluation, called as {service, params} (MoltsPay form)","security":[],"x-payment-info":{"price":{"mode":"fixed","currency":"USD","amount":"0.002000"},"protocols":[{"x402":{}}]},"requestBody":{"required":false,"content":{"application/json":{"schema":{"type":"object","properties":{"service":{"type":"string","enum":["evaluate"]},"params":{"$ref":"#/components/schemas/EvaluateRequest"}}}}}},"responses":{"200":{"description":"Verdict, also under `result`","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Evaluation"}}}},"400":{"description":"Invalid input","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"402":{"description":"Payment required"}}}},"/api/v1/atlas/lookup/sample":{"get":{"tags":["Atlas"],"operationId":"atlasLookupSample","summary":"A free preview of the lookup: the live answer for one fixed User-Agent. Unmetered","security":[],"responses":{"200":{"description":"Lookup result for the sample input","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AtlasLookup"}}}}}}},"/api/x402/atlas/lookup":{"get":{"tags":["Atlas"],"operationId":"x402AtlasLookup","summary":"Identify a User-Agent and pay per lookup in USDC (x402), no account needed","security":[],"x-payment-info":{"price":{"mode":"fixed","currency":"USD","amount":"0.001000"},"protocols":[{"x402":{}}]},"parameters":[{"name":"user_agent","in":"query","required":true,"schema":{"type":"string","maxLength":2000}}],"responses":{"200":{"description":"Lookup result","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AtlasLookup"}}}},"400":{"description":"user_agent missing or too long","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"402":{"description":"Payment required"}}}},"/api/v1/beacon":{"get":{"tags":["Beacon"],"operationId":"beaconOverview","summary":"What Beacon checks, what it costs, and how to call it","security":[],"responses":{"200":{"description":"Overview","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/api/v1/beacon/sample":{"get":{"tags":["Beacon"],"operationId":"beaconSample","summary":"A real report, free: the check of overwing.ai itself, refreshed daily","security":[],"responses":{"200":{"description":"Report","content":{"application/json":{"schema":{"$ref":"#/components/schemas/BeaconReport"}}}},"503":{"description":"The sample has not been generated yet","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/beacon/checks":{"post":{"tags":["Beacon"],"operationId":"beaconStart","summary":"Start a check. Free. With a key the status address answers with the full report and the check is saved to that organization's dashboard; with no key it answers with the summary","security":[{},{"bearerAuth":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["url"],"properties":{"url":{"type":"string","maxLength":500,"description":"The site to check: a domain or an https URL. Public sites on the default port only"}}},"example":{"url":"example.com"}}}},"responses":{"201":{"description":"Started; the check runs when status_url is first asked for","content":{"application/json":{"schema":{"type":"object","properties":{"id":{"type":"string"},"url":{"type":"string"},"status":{"type":"string","const":"queued"},"price_usd":{"type":"number","const":0},"access":{"type":"string","enum":["full","summary"],"description":"What status_url will answer with for this caller"},"status_url":{"type":"string"},"report_url":{"type":"string"},"saved_to_dashboard":{"type":"boolean"},"next":{"type":"string"},"full_report":{"type":"object","description":"Present with no key: how to open the full report"}}}}}},"400":{"description":"url is missing or not a public https address","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"A key was sent and is not valid","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"The site did not answer","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"The daily limit of free checks is spent: 5 per address with no key, 30 per organization with one","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/beacon/checks/{id}":{"get":{"tags":["Beacon"],"operationId":"beaconReport","summary":"The report for a check, as JSON or markdown, inline or as a file. The first request runs the check. With a key, the full report; with no key, the summary of a free check (\"access\" says which). A check paid over x402 is open in full to whoever holds its id","security":[{},{"bearerAuth":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","pattern":"^bcn_[A-Za-z0-9_-]{16}$"}},{"name":"format","in":"query","schema":{"type":"string","enum":["json","md"],"default":"json"},"description":"md returns the report as a markdown document. Accept: text/markdown does the same"},{"name":"download","in":"query","schema":{"type":"string","enum":["1"]},"description":"Send the report as a file (Content-Disposition: attachment)"}],"responses":{"200":{"description":"The full report (access: full), or with no key the summary of a free check (access: summary): the same fields without checks, with the first of top_fixes, plus counts and full_report","content":{"application/json":{"schema":{"$ref":"#/components/schemas/BeaconReport"}}}},"202":{"description":"Running; ask again in a few seconds (Retry-After)"},"401":{"description":"A key was sent and is not valid","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"No such check","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/beacon/saved":{"get":{"tags":["Beacon"],"operationId":"beaconListSaved","summary":"Reports this organization has saved to its dashboard, newest first","responses":{"200":{"description":"Saved reports","content":{"application/json":{"schema":{"type":"object","properties":{"saved":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"url":{"type":"string"},"status":{"type":"string"},"score":{"type":["integer","null"]},"verdict":{"type":["string","null"]},"checked_at":{"type":["string","null"]},"saved_at":{"type":"string"},"report":{"type":"string"},"page":{"type":"string"}}}}}}}}},"401":{"description":"Missing or invalid API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"The key's scope does not allow this","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/beacon/saved/{id}":{"put":{"tags":["Beacon"],"operationId":"beaconSave","summary":"Save a report to this organization's dashboard. Holding the report's id is what allows it","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Saved"},"401":{"description":"Missing or invalid API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"No such check","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}},"delete":{"tags":["Beacon"],"operationId":"beaconUnsave","summary":"Remove a report from the dashboard. The report stays readable at its address","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Removed"},"401":{"description":"Missing or invalid API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Not saved","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/preflight":{"get":{"tags":["Preflight"],"operationId":"preflightOverview","summary":"What Preflight checks, the policy fields, the reason codes, the guarantee and how to call it","security":[],"responses":{"200":{"description":"Overview","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/api/v1/preflight/checks":{"post":{"tags":["Preflight"],"operationId":"preflightCheck","summary":"Check one unsigned Solana transaction against a policy before an agent signs it. Counts as one evaluation; a check that cannot be made is not counted","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/PreflightRequest"},"example":{"transaction":"<base64 serialized transaction>","policy":{"wallet":"<the wallet that signs>","max_sol_out":0.05,"allowed_programs":["11111111111111111111111111111111"]}}}}},"responses":{"200":{"description":"The verdict: allow or refuse, with every reason","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PreflightVerdict"}}}},"400":{"description":"transaction or policy is missing or malformed","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Daily allowance reached and no prepaid credits left","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"502":{"description":"The Solana node could not be reached; no verdict was given","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"503":{"description":"Preflight is not enabled on this deployment","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/preflight/checks/{id}":{"get":{"tags":["Preflight"],"operationId":"preflightVerdict","summary":"The public record of one verdict and of every transaction reported against it. Never the wallet, the amounts or the transaction","security":[],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"The verdict as published","content":{"application/json":{"schema":{"type":"object"}}}},"404":{"description":"No such verdict","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/preflight/checks/{id}/reports":{"post":{"tags":["Preflight"],"operationId":"preflightReport","summary":"Report the transaction that landed after a verdict. The answer (miss or not_a_miss) is read from the chain and published. No key","security":[],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["signature"],"properties":{"signature":{"type":"string","description":"The landed transaction's signature in base58"}}}}}},"responses":{"200":{"description":"The outcome","content":{"application/json":{"schema":{"type":"object","properties":{"outcome":{"type":"string","enum":["miss","not_a_miss"]},"why":{"type":["string","null"]},"covered":{"type":"boolean"}}}}}},"400":{"description":"signature is not a transaction signature","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"No such verdict","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Too many reports from this address today","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"502":{"description":"The Solana node could not be reached; nothing was recorded","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/preflight/record":{"get":{"tags":["Preflight"],"operationId":"preflightRecord","summary":"The public record: counts, every miss, the latest verdicts, and what the guarantee's reserve holds","security":[],"responses":{"200":{"description":"The record","content":{"application/json":{"schema":{"type":"object"}}}},"503":{"description":"The record is not available right now","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/x402/preflight":{"post":{"tags":["Preflight"],"operationId":"x402Preflight","summary":"Check one unsigned Solana transaction and pay $0.01 in USDC (x402), no account","security":[],"x-payment-info":{"price":{"mode":"fixed","currency":"USD","amount":"0.010000"},"protocols":[{"x402":{}}]},"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/PreflightRequest"}}}},"responses":{"200":{"description":"The verdict","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PreflightVerdict"}}}},"400":{"description":"transaction or policy is missing or malformed; not charged","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"402":{"description":"Payment required"},"502":{"description":"The Solana node could not be reached; not charged","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/x402/beacon":{"get":{"tags":["Beacon"],"operationId":"x402Beacon","summary":"Check whether a site is reachable by agents and pay $1 in USDC (x402), no account","security":[],"x-payment-info":{"price":{"mode":"fixed","currency":"USD","amount":"1.000000"},"protocols":[{"x402":{}}]},"parameters":[{"name":"url","in":"query","required":true,"schema":{"type":"string","maxLength":500},"description":"The site to check: a domain or an https URL"}],"responses":{"200":{"description":"Report","content":{"application/json":{"schema":{"$ref":"#/components/schemas/BeaconReport"}}}},"400":{"description":"url is missing or not a public https address","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"402":{"description":"Payment required"},"422":{"description":"The site did not answer; not charged","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/x402/atlas/report":{"get":{"tags":["Atlas"],"operationId":"x402AtlasReport","summary":"The full Agent Consumers report as Markdown, paid once in USDC (x402)","security":[],"x-payment-info":{"price":{"mode":"fixed","currency":"USD","amount":"9.000000"},"protocols":[{"x402":{}}]},"responses":{"200":{"description":"Markdown","content":{"text/markdown":{"schema":{"type":"string"}}}},"402":{"description":"Payment required"}}}},"/api/v1/billing/portal":{"post":{"tags":["Billing"],"operationId":"createPortal","summary":"Stripe customer portal URL (invoices, cards, cancel)","requestBody":{"required":false,"content":{"application/json":{"schema":{"type":"object","properties":{"return_url":{"type":"string","format":"uri"}}}}}},"responses":{"201":{"description":"Portal session","content":{"application/json":{"schema":{"type":"object","properties":{"url":{"type":"string","format":"uri"}}}}}},"401":{"description":"Missing or invalid API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"No billing account yet","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"503":{"description":"Billing not enabled","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/health":{"get":{"tags":["Meta"],"operationId":"health","summary":"Liveness","security":[],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"type":"object","properties":{"status":{"type":"string"},"service":{"type":"string"},"version":{"type":"string"},"timestamp":{"type":"string","format":"date-time"}}}}}}}}},"/api/v1/openapi.json":{"get":{"tags":["Meta"],"operationId":"openapi","summary":"This document","security":[],"responses":{"200":{"description":"OpenAPI 3.1 document"}}}}},"components":{"securitySchemes":{"bearerAuth":{"type":"http","scheme":"bearer","bearerFormat":"ow_live_<32 hex>","description":"API key from the dashboard, from POST /api/v1/api-keys, or from POST /api/v1/signup (one call, no browser). A key has a scope: full (every endpoint) or evaluate (POST evaluate and evaluate/batch, GET rule-sets, me, usage and the Atlas reads; everything else answers 403). Give agents an evaluate key."}},"schemas":{"Error":{"type":"object","required":["error"],"properties":{"error":{"type":"string","description":"Human-readable message"}}},"Verdict":{"type":"string","enum":["pass","fail","review"],"description":"fail: a rule's fail condition matched. review: a rule's confidence was below its review threshold and nothing failed. pass: otherwise."},"QuestionType":{"type":"string","enum":["choice","score","noul"]},"PreflightRequest":{"type":"object","required":["transaction","policy"],"properties":{"transaction":{"type":"string","maxLength":2000,"description":"The serialized Solana transaction in base64, legacy or v0, signed or not. Signatures are ignored"},"policy":{"type":"object","required":["wallet"],"additionalProperties":false,"properties":{"wallet":{"type":"string","description":"The address to protect. It must sign the transaction"},"max_sol_out":{"type":"number","minimum":0,"description":"Required unless max_sol_out_lamports is given. The most SOL the transaction may take from the wallet, fees included"},"max_sol_out_lamports":{"type":["integer","string"],"description":"The same limit as a whole number of lamports"},"max_token_out":{"type":"object","additionalProperties":{"type":["integer","string"]},"description":"Atomic units that may leave, by mint. A mint not listed may not leave at all"},"min_token_in":{"type":"object","additionalProperties":{"type":["integer","string"]},"description":"Atomic units that must arrive, by mint"},"allowed_programs":{"type":"array","items":{"type":"string"},"description":"When given, every program the transaction runs, top-level or inner, must be listed"},"allow_delegation":{"type":"boolean","default":false,"description":"Whether a spending approval on the wallet's token accounts is acceptable"}}}}},"PreflightVerdict":{"type":"object","properties":{"id":{"type":"string"},"decision":{"type":"string","enum":["allow","refuse"],"description":"The one field to branch on. Sign only on allow"},"reasons":{"type":"array","items":{"type":"object","properties":{"code":{"type":"string"},"detail":{"type":"string"}}},"description":"Every reason to refuse. Empty on an allow. Codes are listed at GET /api/v1/preflight"},"effects":{"type":["object","null"],"description":"What the simulation says would happen to the wallet: sol_out_lamports, token_out, token_in (atomic units as strings, by mint) and control changes. Null when it could not be simulated"},"programs":{"type":"array","items":{"type":"string"},"description":"Every program the transaction would run"},"digest":{"type":"string","description":"sha256 of the message with its blockhash zeroed"},"slot":{"type":["integer","null"]},"covered":{"type":"boolean","description":"Whether the guarantee applies: an allow made only of programs Overwing names"},"decided_at":{"type":"string","format":"date-time"},"valid_for_seconds":{"type":"integer","description":"A verdict covers a transaction that lands within this many seconds"},"receipt":{"type":"object","description":"The published payload, its hash, and an Ed25519 signature over the hash"},"record_url":{"type":"string"}}},"BeaconReport":{"type":"object","properties":{"id":{"type":"string"},"url":{"type":"string"},"host":{"type":"string"},"scanned_at":{"type":"string","format":"date-time"},"score":{"type":"integer","minimum":0,"maximum":100},"verdict":{"type":"string","enum":["yes","partly","no"],"description":"Is the product reachable by agents"},"summary":{"type":"string"},"categories":{"type":"array","items":{"type":"object","properties":{"key":{"type":"string","enum":["find","read","use"]},"title":{"type":"string"},"question":{"type":"string"},"answer":{"type":"string","enum":["yes","partly","no"]},"points":{"type":"integer"},"max":{"type":"integer"}}}},"checks":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"category":{"type":"string","enum":["find","read","use"]},"title":{"type":"string"},"status":{"type":"string","enum":["pass","warn","fail"]},"points":{"type":"integer"},"max":{"type":"integer"},"detail":{"type":"string","description":"What was found"},"fix":{"type":"string","description":"What to change. Absent when the check passed"},"evidence":{"type":"string","description":"The address that was read"}}}},"top_fixes":{"type":"array","items":{"type":"object","properties":{"check":{"type":"string"},"fix":{"type":"string"},"gain":{"type":"integer","description":"Points the fix is worth"}}}},"judged":{"type":"boolean","description":"False when the model judgments could not be made; their checks are then left out"},"duration_ms":{"type":"integer"},"requests":{"type":"integer"}}},"KeyScope":{"type":"string","enum":["full","evaluate"],"default":"full","description":"full: every endpoint. evaluate: run checks and read rule sets, usage and Atlas data; cannot read stored evaluations, change rule sets, manage keys, webhooks, billing or Tower, or delete anything"},"OrgSettings":{"type":"object","properties":{"org_id":{"type":"string"},"name":{"type":"string"},"plan":{"type":"string"},"store_inputs":{"type":"boolean"},"retention_days":{"type":["integer","null"]}}},"EvaluateRequest":{"type":"object","required":["input","rule_set"],"properties":{"input":{"type":"string","maxLength":100000,"description":"The LLM output (or any text) to evaluate. The input can be in any language the model reads. Tested on 2026-09-29 in Spanish, Portuguese, French, German, Japanese, Chinese (Simplified), Korean, Arabic and Hindi: 7 checks in each, and every verdict matched the English one. A small test, not a benchmark: the texts were written by a model and have not been reviewed by native speakers. Responses are in English whatever the input language."},"rule_set":{"type":"string","description":"Rule set slug. Prebuilt: content-safety (toxicity, PII, self-harm, sexual content, severity) and outbound-message (adds unauthorized_pii and confidential_leak, and reads the context object)"},"metadata":{"type":"object","additionalProperties":true,"description":"Opaque context echoed back and stored with the evaluation"},"context":{"type":"object","additionalProperties":true,"description":"Structured facts about the situation, passed to the model as state next to the text so rules can reference them: e.g. { recipient: \"known customer\", channel: \"email\", owns_contact_info: true }. Max 8 KB."},"store":{"type":"boolean","description":"False runs the check without keeping the input text or the context: the record holds the verdict, scores and metadata only. It cannot turn storage back on when the organization has store_inputs off (PATCH /api/v1/org). The response header X-Input-Stored says which happened."}}},"RuleResult":{"type":"object","required":["rule","type","answer","probability","confidence","verdict","action"],"properties":{"rule":{"type":"string"},"action":{"type":"string","enum":["block","redact","review"],"description":"The rule's declared action: what to do when this rule fails"},"type":{"$ref":"#/components/schemas/QuestionType"},"answer":{"oneOf":[{"type":"string"},{"type":"number"},{"type":"boolean"}],"description":"choice: selected option; score: position on the level scale (may be fractional); noul: boolean"},"probability":{"type":"number","minimum":0,"maximum":1},"confidence":{"type":"number","minimum":0,"maximum":1},"verdict":{"$ref":"#/components/schemas/Verdict"}}},"Evaluation":{"type":"object","required":["id","verdict","recommended_action","aggregate_score","confidence","latency_ms","results"],"properties":{"id":{"type":"string","example":"eval_aBcDeFgHiJkLmNoP"},"verdict":{"$ref":"#/components/schemas/Verdict"},"recommended_action":{"type":"string","enum":["block","redact","review","allow"],"description":"One word to act on, derived from the failed rules' actions: block if an