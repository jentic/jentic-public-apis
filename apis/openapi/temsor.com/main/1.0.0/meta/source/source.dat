 id:** `pbx_whisper_suggest`\n\nIn the GET form every field is a query parameter; object and array fields are JSON-encoded.","operationId":"pbx_whisper_suggest_get","responses":{"200":{"description":"Success","headers":{"RateLimit-Policy":{"$ref":"#/components/headers/RateLimitPolicy"},"RateLimit":{"$ref":"#/components/headers/RateLimit"},"X-RateLimit-Limit":{"$ref":"#/components/headers/XRateLimitLimit"},"X-RateLimit-Remaining":{"$ref":"#/components/headers/XRateLimitRemaining"},"X-RateLimit-Reset":{"$ref":"#/components/headers/XRateLimitReset"}},"content":{"application/json":{"schema":{"type":"object","properties":{"ok":{"const":true},"data":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"call_id":{"type":"string"},"partial_text":{"type":"string"},"cards":{"maxItems":3,"type":"array","items":{"type":"object","properties":{"type":{"type":"string","enum":["promise","fact"]},"title":{"type":"string"},"body":{"type":"string"},"call_id":{"type":"string"},"source_id":{"type":"string"},"status":{"type":"string"},"kind":{"type":"string"},"relevance":{"type":"number"},"from_partial":{"type":"boolean"}},"required":["type","title","body","call_id","source_id","relevance"],"additionalProperties":false}},"count":{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991},"latency_ms":{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991},"mock":{"type":"boolean"},"partial_index":{"type":"boolean"},"partial_preferred":{"type":"boolean"},"lab_latency_ms":{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991},"note":{"type":"string"}},"required":["call_id","partial_text","cards","count","latency_ms","mock","note"],"additionalProperties":false},"meta":{"type":"object","properties":{"credits":{"type":"integer"},"cached":{"type":"boolean"},"requestId":{"type":"string"},"durationMs":{"type":"integer"}}}},"required":["ok","data"]}}}},"400":{"$ref":"#/components/responses/Error"},"401":{"$ref":"#/components/responses/Error"},"402":{"$ref":"#/components/responses/Error"},"429":{"$ref":"#/components/responses/RateLimited"}},"parameters":[{"name":"call_id","in":"query","required":true,"description":"Active call id for agent UI context.","schema":{"type":"string","minLength":1,"maxLength":64,"description":"Active call id for agent UI context."}},{"name":"partial_text","in":"query","required":false,"description":"Partial transcript / utterance text (no live speech recognition).","schema":{"default":"","description":"Partial transcript / utterance text (no live speech recognition).","type":"string","maxLength":2000}}]}},"/v1/phone/validate":{"post":{"tags":["Validation"],"summary":"Validates and normalises any phone number to E.164, with structural checks for every country calling code.","description":"For signup and checkout flows that need to store one canonical form and reject typos early. Any common input (spaces, dashes, brackets, 00 or + prefix, a stray national trunk zero) comes back as E.164 plus national notation, with the country resolved from the calling code. Numbers without an international prefix use `defaultCountry` (US when omitted), so (415) 555-0134 and +1 415 555 0134 store the same.\n\nOne thing this endpoint deliberately does not claim: the current mobile operator. Numbers are portable in most markets, so a prefix says where a number was first allocated, not where it lives today. Competing APIs report the prefix owner as \"the operator\" and customers pick SMS routes on that basis. Where we know the original allocation we return it as `originallyAllocatedTo` with the caveat attached, because a confident wrong answer costs more than an honest gap. Countries without a full numbering plan here are validated structurally and say so in `warnings`.\n\n**Credits per call:** 1 · **Operation id:** `phone_validate`","operationId":"phone_validate","responses":{"200":{"description":"Success","headers":{"RateLimit-Policy":{"$ref":"#/components/headers/RateLimitPolicy"},"RateLimit":{"$ref":"#/components/headers/RateLimit"},"X-RateLimit-Limit":{"$ref":"#/components/headers/XRateLimitLimit"},"X-RateLimit-Remaining":{"$ref":"#/components/headers/XRateLimitRemaining"},"X-RateLimit-Reset":{"$ref":"#/components/headers/XRateLimitReset"}},"content":{"application/json":{"schema":{"type":"object","properties":{"ok":{"const":true},"data":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"input":{"type":"string"},"valid":{"type":"boolean"},"reason":{"anyOf":[{"type":"string"},{"type":"null"}]},"e164":{"anyOf":[{"type":"string"},{"type":"null"}]},"national":{"anyOf":[{"type":"string"},{"type":"null"}]},"countryCode":{"anyOf":[{"type":"string"},{"type":"null"}]},"country":{"anyOf":[{"type":"string"},{"type":"null"}]},"lineType":{"type":"string","enum":["mobile","fixed","toll-free","fixed-rate","premium","short","unknown"]},"turkey":{"anyOf":[{"type":"object","properties":{"areaCode":{"anyOf":[{"type":"string"},{"type":"null"}]},"province":{"anyOf":[{"type":"string"},{"type":"null"}]},"originallyAllocatedTo":{"anyOf":[{"type":"string"},{"type":"null"}]},"portabilityNotice":{"anyOf":[{"type":"string"},{"type":"null"}]}},"required":["areaCode","province","originallyAllocatedTo","portabilityNotice"],"additionalProperties":false},{"type":"null"}]},"warnings":{"type":"array","items":{"type":"string"}}},"required":["input","valid","reason","e164","national","countryCode","country","lineType","turkey","warnings"],"additionalProperties":false},"meta":{"type":"object","properties":{"credits":{"type":"integer"},"cached":{"type":"boolean"},"requestId":{"type":"string"},"durationMs":{"type":"integer"}}}},"required":["ok","data"]}}}},"400":{"$ref":"#/components/responses/Error"},"401":{"$ref":"#/components/responses/Error"},"402":{"$ref":"#/components/responses/Error"},"429":{"$ref":"#/components/responses/RateLimited"}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"phone":{"type":"string","minLength":4,"maxLength":30,"description":"Phone number in any common format."},"defaultCountry":{"description":"ISO 3166-1 alpha-2 country to assume when the number has no international prefix. Defaults to US.","type":"string","minLength":2,"maxLength":2}},"required":["phone"]}}}}},"get":{"tags":["Validation"],"summary":"Validates and normalises any phone number to E.164, with structural checks for every country calling code.","description":"For signup and checkout flows that need to store one canonical form and reject typos early. Any common input (spaces, dashes, brackets, 00 or + prefix, a stray national trunk zero) comes back as E.164 plus national notation, with the country resolved from the calling code. Numbers without an international prefix use `defaultCountry` (US when omitted), so (415) 555-0134 and +1 415 555 0134 store the same.\n\nOne thing this endpoint deliberately does not claim: the current mobile operator. Numbers are portable in most markets, so a prefix says where a number was first allocated, not where it lives today. Competing APIs report the prefix owner as \"the operator\" and customers pick SMS routes on that basis. Where we know the original allocation we return it as `originallyAllocatedTo` with the caveat attached, because a confident wrong answer costs more than an honest gap. Countries without a full numbering plan here are validated structurally and say so in `warnings`.\n\n**Credits per call:** 1 · **Operation id:** `phone_validate`\n\nIn the GET form every field is a query parameter; object and array fields are JSON-encoded.","operationId":"phone_validate_get","responses":{"200":{"description":"Success","headers":{"RateLimit-Policy":{"$ref":"#/components/headers/RateLimitPolicy"},"RateLimit":{"$ref":"#/components/headers/RateLimit"},"X-RateLimit-Limit":{"$ref":"#/components/headers/XRateLimitLimit"},"X-RateLimit-Remaining":{"$ref":"