{"openapi":"3.1.0","info":{"title":"NamingSignal API","version":"0.2.0-preview","description":"Evidence-first naming brief, generation, domain/namespace checking, ranking, and finalist research. Registry not-found is a likely-unregistered signal, not a purchase guarantee; trademark output is preliminary research only. Errors always use the {error, code, retryable} envelope; rate-limited responses add Retry-After, retryAfterSeconds, and resetAt."},"externalDocs":{"description":"Public developer quickstart, key management, and agent setup prompt","url":"https://namingsignal.com/developers/docs"},"servers":[{"url":"https://namingsignal.com/"}],"security":[{"bearerAuth":[]}],"paths":{"/api/v1/health":{"get":{"operationId":"getHealth","summary":"Read provider readiness and applied policy limits","description":"Public. Returns apiVersion, authentication configuration, provider states, applied limits including the Naming Credit schedule, and safeguard flags. Does not run live TLD canaries.","security":[],"responses":{"200":{"description":"Provider readiness, limits, and the monthly credit schedule.","headers":{"X-Name-Ledger-API-Version":{"description":"Always v1 on API envelope responses.","schema":{"type":"string"}}},"content":{"application/json":{"schema":{"type":"object","required":["ok","apiVersion"],"properties":{"ok":{"type":"boolean"},"apiVersion":{"type":"string","const":"v1"},"service":{"type":"string"},"checkedAt":{"type":"string","format":"date-time"},"authentication":{"type":"object","additionalProperties":true},"providers":{"type":"object","additionalProperties":true},"limits":{"type":"object","additionalProperties":true},"safeguards":{"type":"object","additionalProperties":true}},"additionalProperties":true}}}}}}},"/api/v1/brief":{"post":{"operationId":"compileBrief","summary":"Compile bounded project context into an editable naming brief","description":"Provide pasted text, one public HTTPS URL, or both. Pasted/uploaded text uses the deterministic compiler; a URL-only request may use bounded evidence-grounded model inference with deterministic fallback (fallback: true plus a stable fallbackReason). URL imports are metered (import operation) and SSRF-checked.","parameters":[{"name":"Idempotency-Key","in":"header","required":false,"description":"Unique 8-128 character key. Retries of the same key and body within the current server instance replay the stored response (Idempotency-Replayed: true) instead of re-running and re-charging. Memory-local, not a durable cross-instance guarantee.","schema":{"type":"string","minLength":8,"maxLength":128}},{"name":"X-Name-Ledger-Sprint","in":"header","required":false,"description":"Keep one 8-128 character value across generation, ranking, and research calls of one sprint so they share a bounded provider-cost budget. Memory-local.","schema":{"type":"string","minLength":8,"maxLength":128}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","description":"At least one of text or url is required.","properties":{"text":{"type":"string","description":"Pasted prompt, README, or description. Bounded by MAX_IMPORT_BYTES (250,000 characters by default); larger inputs return 413."},"url":{"type":"string","maxLength":2048,"description":"One public HTTPS page or public GitHub repository URL."},"source":{"type":"string","maxLength":200,"default":"pasted text","description":"Human-readable provenance label."}}}}}},"responses":{"200":{"description":"Editable brief with import preview and provenance.","headers":{"X-Name-Ledger-API-Version":{"description":"Always v1 on API envelope responses.","schema":{"type":"string"}},"Idempotency-Replayed":{"description":"true when this response was replayed from the instance-local idempotency cache.","schema":{"type":"string","enum":["true","false"]}}},"content":{"application/json":{"schema":{"type":"object","required":["brief","preview","usage"],"properties":{"brief":{"$ref":"#/components/schemas/ProjectBrief"},"preview":{"type":"object","description":"Bounded safe text preview with byte/token counts, warnings, secret/injection finding counts, compiler and model identifiers, and source list.","additionalProperties":true},"fallback":{"type":"boolean"},"fallbackReason":{"type":"string"},"compiler":{"type":"string"},"model":{"type":"string"},"usage":{"$ref":"#/components/schemas/Usage"},"privacy":{"type":"object","additionalProperties":true},"quota":{"type":"object","description":"Present only when a URL import consumed credits.","additionalProperties":true}},"additionalProperties":true}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"description":"The public URL to import was not found upstream (import error envelope).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"413":{"$ref":"#/components/responses/PayloadTooLarge"},"415":{"$ref":"#/components/responses/UnsupportedMediaType"},"422":{"description":"The URL import was rejected (for example unsafe redirect, unsupported content, or blocked target).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"$ref":"#/components/responses/RateLimited"},"500":{"$ref":"#/components/responses/InternalError"},"502":{"description":"The upstream fetch for a URL import failed. The error code identifies the import failure; retryable is true when a retry can help.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"503":{"$ref":"#/components/responses/ServiceUnavailable"},"504":{"$ref":"#/components/responses/Timeout"}}}},"/api/v1/generate":{"post":{"operationId":"generateCandidates","summary":"Generate 4-50 candidates for one bounded batch","description":"Metered: 1 generation credit unit plus one domain_check unit per candidate when checkPrimaryDomain is true. Runs a parallel creative model ensemble with bounded per-model budgets and a deterministic fallback that is always labeled via fallback/fallbackReason.","parameters":[{"name":"Idempotency-Key","in":"header","required":false,"description":"Unique 8-128 character key. Retries of the same key and body within the current server instance replay the stored response (Idempotency-Replayed: true) instead of re-running and re-charging. Memory-local, not a durable cross-instance guarantee.","schema":{"type":"string","minLength":8,"maxLength":128}},{"name":"X-Name-Ledger-Sprint","in":"header","required":false,"description":"Keep one 8-128 character value across generation, ranking, and research calls of one sprint so they share a bounded provider-cost budget. Memory-local.","schema":{"type":"string","minLength":8,"maxLength":128}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["brief"],"properties":{"brief":{"$ref":"#/components/schemas/ProjectBrief"},"count":{"type":"integer","minimum":4,"maximum":50,"default":24},"tlds":{"type":"array","minItems":1,"maxItems":5,"default":["com"],"items":{"type":"string","minLength":2,"maxLength":24,"pattern":"^[a-z0-9-]+$"},"description":"Lowercase TLD labels without a leading dot."},"checkPrimaryDomain":{"type":"boolean","default":true,"description":"Batch-check the first TLD for every candidate."},"excludedNames":{"type":"array","maxItems":500,"items":{"type":"string","minLength":2,"maxLength":32},"description":"Names from earlier rounds that must not repeat."},"iteration":{"type":"object","description":"Optional founder feedback for a non-duplicate feedback round.","required":["feedback"],"properties":{"feedback":{"type":"string","minLength":1,"maxLength":2000},"likedNames":{"type":"array","maxItems":30,"items":{"type":"string","minLength":2,"maxLength":32}},"dislikedNames":{"type":"array","maxItems":30,"items":{"type":"string","minLength":2,"maxLength":32}}}}}}}}},"responses":{"200":{"description":"Candidates in four named veins with provider/fallback metadata and optional primary-domain evidence.","headers":{"X-Name-Ledger-API-Version":{"description":"Always v1 on API envelope responses.","schema":{"type":"string"}},"Idempotency-Replayed":{"description":"true when this response was replayed from the instance-local idempotency cache.","schema":{"type":"string","enum":["true","false"]}},"X-RateLimit-Limit":{"description":"Monthly Naming Credit allowance. Sent on successful metered responses, not on 429s.","schema":{"type":"integer"}},"X-RateLimit-Remaining":{"description":"Naming Credits remaining this UTC calendar month.","schema":{"type":"integer"}},"X-RateLimit-Reset":{"description":"ISO 8601 instant when the monthly credit allowance resets.","schema":{"type":"string","format":"date-time"}},"X-RateLimit-Policy":{"description":"Machine-readable policy string, e.g. \"10000;period=calendar-month-utc;unit=naming-credit\".","schema":{"type":"string"}},"X-Naming-Credits-Charged":{"description":"Credits charged by this request.","schema":{"type":"integer"}},"X-Naming-Credits-Remaining":{"description":"Credits remaining after this request.","schema":{"type":"integer"}},"X-Naming-Credits-Unlimited":{"description":"True when the authenticated account is exempt from monthly credit enforcement. A large numeric balance is still returned for clients that only understand numeric quota headers.","schema":{"type":"string","enum":["true"]}}},"content":{"application/json":{"schema":{"type":"object","required":["candidates","fallback","usage","quota"],"properties":{"candidates":{"type":"array","items":{"$ref":"#/components/schemas/Candidate"}},"fallback":{"type":"boolean"},"fallbackReason":{"type":"string"},"provider":{"type":"string"},"model":{"type":"string"},"modelTrace":{"type":"array","items":{"type":"object","additionalProperties":true}},"primaryTldChecked":{"type":["string","null"]},"domainInterpretation":{"type":"string"},"usage":{"$ref":"#/components/schemas/Usage"},"quota":{"$ref":"#/components/schemas/Quota"},"sprintBudget":{"type":"object","additionalProperties":true}},"additionalProperties":true}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"413":{"$ref":"#/components/responses/PayloadTooLarge"},"415":{"$ref":"#/components/responses/UnsupportedMediaType"},"429":{"$ref":"#/components/responses/RateLimited"},"500":{"$ref":"#/components/responses/InternalError"},"502":{"description":"The creative provider failed in a way that is not eligible for the deterministic fallback.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"503":{"$ref":"#/components/responses/ServiceUnavailable"},"504":{"$ref":"#/components/responses/Timeout"}}}},"/api/v1/check":{"post":{"operationId":"checkNames","summary":"Check and score names within the domain-combination request cap","description":"Metered: one domain_check unit per name x TLD combination. Accepts 1-100 distinct names and up to 5 TLDs subject to names x TLDs <= 150 (MAX_DOMAIN_COMBINATIONS_PER_CHECK). Exact namespace automation is bounded; oversized batches degrade namespaces explicitly to unknown via boundedDegradation instead of failing.","parameters":[{"name":"Idempotency-Key","in":"header","required":false,"description":"Unique 8-128 character key. Retries of the same key and body within the current server instance replay the stored response (Idempotency-Replayed: true) instead of re-running and re-charging. Memory-local, not a durable cross-instance guarantee.","schema":{"type":"string","minLength":8,"maxLength":128}},{"name":"X-Name-Ledger-Sprint","in":"header","required":false,"description":"Keep one 8-128 character value across generation, ranking, and research calls of one sprint so they share a bounded provider-cost budget. Memory-local.","schema":{"type":"string","minLength":8,"maxLength":128}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["names"],"properties":{"names":{"type":"array","minItems":1,"maxItems":100,"items":{"type":"string","minLength":2,"maxLength":64,"pattern":"^[\\p{L}\\p{N}][\\p{L}\\p{N} '&.-]*$"}},"tlds":{"type":"array","minItems":1,"maxItems":5,"default":["com","io","dev"],"items":{"type":"string","minLength":2,"maxLength":24,"pattern":"^[a-z0-9-]+$"},"description":"Lowercase TLD labels without a leading dot."},"includeNamespaces":{"type":"boolean","default":true},"context":{"type":"object","description":"Optional whitelisted scoring context: brief, category, channels, preferredTld, competitorNames, saturatedRoots, founderResonance (0-100). riskSignals are rejected because registry evidence is server-owned.","additionalProperties":true}}}}}},"responses":{"200":{"description":"Per-name domain evidence, optional namespace states, transparent scores, and interpretation guidance.","headers":{"X-Name-Ledger-API-Version":{"description":"Always v1 on API envelope responses.","schema":{"type":"string"}},"Idempotency-Replayed":{"description":"true when this response was replayed from the instance-local idempotency cache.","schema":{"type":"string","enum":["true","false"]}},"X-RateLimit-Limit":{"description":"Monthly Naming Credit allowance. Sent on successful metered responses, not on 429s.","schema":{"type":"integer"}},"X-RateLimit-Remaining":{"description":"Naming Credits remaining this UTC calendar month.","schema":{"type":"integer"}},"X-RateLimit-Reset":{"description":"ISO 8601 instant when the monthly credit allowance resets.","schema":{"type":"string","format":"date-time"}},"X-RateLimit-Policy":{"description":"Machine-readable policy string, e.g. \"10000;period=calendar-month-utc;unit=naming-credit\".","schema":{"type":"string"}},"X-Naming-Credits-Charged":{"description":"Credits charged by this request.","schema":{"type":"integer"}},"X-Naming-Credits-Remaining":{"description":"Credits remaining after this request.","schema":{"type":"integer"}},"X-Naming-Credits-Unlimited":{"description":"True when the authenticated account is exempt from monthly credit enforcement. A large numeric balance is still returned for clients that only understand numeric quota headers.","schema":{"type":"string","enum":["true"]}}},"content":{"application/json":{"schema":{"type":"object","required":["results","usage","quota"],"properties":{"results":{"type":"array","items":{"$ref":"#/components/schemas/Candidate"}},"result":{"$ref":"#/components/schemas/Candidate","description":"Convenience copy of results[0], present only for single-name requests."},"usage":{"$ref":"#/components/schemas/Usage"},"quota":{"$ref":"#/components/schemas/Quota"},"cache":{"type":"object","additionalProperties":true},"boundedDegradation":{"type":["object","null"],"additionalProperties":true},"interpretation":{"type":"object","additionalProperties":true},"limitsApplied":{"type":"object","additionalProperties":true}},"additionalProperties":true}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"413":{"$ref":"#/components/responses/PayloadTooLarge"},"415":{"$ref":"#/components/responses/UnsupportedMediaType"},"422":{"description":"The request expands to more name x TLD combinations than the limit (code domain_batch_limit). Check the primary TLD in bulk, then run secondary TLDs on survivors.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"$ref":"#/components/responses/RateLimited"},"500":{"$ref":"#/components/responses/InternalError"},"503":{"$ref":"#/components/responses/ServiceUnavailable"},"504":{"$ref":"#/components/responses/Timeout"}}}},"/api/v1/rank":{"post":{"operationId":"rankDomainSurvivors","summary":"Rank 2-30 domain survivors with an independent model and bounded fallback","description":"Metered: 1 ranking credit unit. Returns an independent editorial order. If both configured ranking models fail, the deterministic score order is returned and labeled fallbackReason: deterministic_ranking_used; the route still responds 200.","parameters":[{"name":"Idempotency-Key","in":"header","required":false,"description":"Unique 8-128 character key. Retries of the same key and body within the current server instance replay the stored response (Idempotency-Replayed: true) instead of re-running and re-charging. Memory-local, not a durable cross-instance guarantee.","schema":{"type":"string","minLength":8,"maxLength":128}},{"name":"X-Name-Ledger-Sprint","in":"header","required":false,"description":"Keep one 8-128 character value across generation, ranking, and research calls of one sprint so they share a bounded provider-cost budget. Memory-local.","schema":{"type":"string","minLength":8,"maxLength":128}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["brief","candidates"],"properties":{"brief":{"$ref":"#/components/schemas/ProjectBrief"},"candidates":{"type":"array","minItems":2,"maxItems":30,"description":"Distinct domain survivors.","items":{"type":"object","required":["name"],"properties":{"name":{"type":"string","minLength":2,"maxLength":32,"pattern":"^[\\p{L}\\p{N}][\\p{L}\\p{N} '&.-]*$"},"rationale":{"type":"string","maxLength":240},"score":{"type":"object","properties":{"overall":{"type":"number","minimum":0,"maximum":100}}},"domains":{"type":"array","maxItems":5,"items":{"type":"object","required":["domain","status"],"properties":{"domain":{"type":"string","maxLength":80},"status":{"type":"string","maxLength":40}}}}}}}}}}}},"responses":{"200":{"description":"Independent editorial ranking with rationale, strength, concern, verdict, and penalty per survivor.","headers":{"X-Name-Ledger-API-Version":{"description":"Always v1 on API envelope responses.","schema":{"type":"string"}},"Idempotency-Replayed":{"description":"true when this response was replayed from the instance-local idempotency cache.","schema":{"type":"string","enum":["true","false"]}},"X-RateLimit-Limit":{"description":"Monthly Naming Credit allowance. Sent on successful metered responses, not on 429s.","schema":{"type":"integer"}},"X-RateLimit-Remaining":{"description":"Naming Credits remaining this UTC calendar month.","schema":{"type":"integer"}},"X-RateLimit-Reset":{"description":"ISO 8601 instant when the monthly credit allowance resets.","schema":{"type":"string","format":"date-time"}},"X-RateLimit-Policy":{"description":"Machine-readable policy string, e.g. \"10000;period=calendar-month-utc;unit=naming-credit\".","schema":{"type":"string"}},"X-Naming-Credits-Charged":{"description":"Credits charged by this request.","schema":{"type":"integer"}},"X-Naming-Credits-Remaining":{"description":"Credits remaining after this request.","schema":{"type":"integer"}},"X-Naming-Credits-Unlimited":{"description":"True when the authenticated account is exempt from monthly credit enforcement. A large numeric balance is still returned for clients that only understand numeric quota headers.","schema":{"type":"string","enum":["true"]}}},"content":{"application/json":{"schema":{"type":"object","required":["ranking","fallback","usage","quota"],"properties":{"ranking":{"type":"array","items":{"type":"object","required":["name","rank"],"properties":{"name":{"type":"string"},"rank":{"type":"integer","minimum":1},"rationale":{"type":"string"},"strength":{"type":"string"},"concern":{"type":"string"},"verdict":{"type":"string"},"penalty":{"type":"number"}},"additionalProperties":true}},"fallback":{"type":"boolean"},"fallbackReason":{"type":"string"},"provider":{"type":"string"},"modelTrace":{"type":"array","items":{"type":"object","additionalProperties":true}},"usage":{"$ref":"#/components/schemas/Usage"},"quota":{"$ref":"#/components/schemas/Quota"},"sprintBudget":{"type":"object","additionalProperties":true}},"additionalProperties":true}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"413":{"$ref":"#/components/responses/PayloadTooLarge"},"415":{"$ref":"#/components/responses/UnsupportedMediaType"},"429":{"$ref":"#/components/responses/RateLimited"},"500":{"$ref":"#/components/responses/InternalError"},"503":{"$ref":"#/components/responses/ServiceUnavailable"},"504":{"$ref":"#/components/responses/Timeout"}}}},"/api/v1/research":{"post":{"operationId":"researchFinalists","summary":"Research one to three finalists with explicit unknowns and manual actions","description":"Metered: one research credit unit per finalist. Returns namespaces, source-backed namesake evidence when the search provider is configured, risk signals, and manual verification links. Search-provider absence is a labeled degraded state, never a clear result.","parameters":[{"name":"Idempotency-Key","in":"header","required":false,"description":"Unique 8-128 character key. Retries of the same key and body within the current server instance replay the stored response (Idempotency-Replayed: true) instead of re-running and re-charging. Memory-local, not a durable cross-instance guarantee.","schema":{"type":"string","minLength":8,"maxLength":128}},{"name":"X-Name-Ledger-Sprint","in":"header","required":false,"description":"Keep one 8-128 character value across generation, ranking, and research calls of one sprint so they share a bounded provider-cost budget. Memory-local.","schema":{"type":"string","minLength":8,"maxLength":128}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["names"],"properties":{"names":{"type":"array","minItems":1,"maxItems":3,"items":{"type":"string","minLength":2,"maxLength":64,"pattern":"^[\\p{L}\\p{N}][\\p{L}\\p{N} '&.-]*$"}},"brief":{"$ref":"#/components/schemas/ProjectBrief"},"tlds":{"type":"array","minItems":1,"maxItems":5,"default":["com","io","dev","app"],"items":{"type":"string","minLength":2,"maxLength":24,"pattern":"^[a-z0-9-]+$"},"description":"Lowercase TLD labels without a leading dot."}}}}}},"responses":{"200":{"description":"Per-finalist evidence, classified namesake sources, risk signals, and evidence-state definitions.","headers":{"X-Name-Ledger-API-Version":{"description":"Always v1 on API envelope responses.","schema":{"type":"string"}},"Idempotency-Replayed":{"description":"true when this response was replayed from the instance-local idempotency cache.","schema":{"type":"string","enum":["true","false"]}},"X-RateLimit-Limit":{"description":"Monthly Naming Credit allowance. Sent on successful metered responses, not on 429s.","schema":{"type":"integer"}},"X-RateLimit-Remaining":{"description":"Naming Credits remaining this UTC calendar month.","schema":{"type":"integer"}},"X-RateLimit-Reset":{"description":"ISO 8601 instant when the monthly credit allowance resets.","schema":{"type":"string","format":"date-time"}},"X-RateLimit-Policy":{"description":"Machine-readable policy string, e.g. \"10000;period=calendar-month-utc;unit=naming-credit\".","schema":{"type":"string"}},"X-Naming-Credits-Charged":{"description":"Credits charged by this request.","schema":{"type":"integer"}},"X-Naming-Credits-Remaining":{"description":"Credits remaining after this request.","schema":{"type":"integer"}},"X-Naming-Credits-Unlimited":{"description":"True when the authenticated account is exempt from monthly credit enforcement. A large numeric balance is still returned for clients that only understand numeric quota headers.","schema":{"type":"string","enum":["true"]}}},"content":{"application/json":{"schema":{"type":"object","required":["results","usage","quota"],"properties":{"results":{"type":"array","items":{"$ref":"#/components/schemas/Candidate"}},"usage":{"$ref":"#/components/schemas/Usage"},"quota":{"$ref":"#/components/schemas/Quota"},"cache":{"type":"object","additionalProperties":true},"researchProvider":{"type":"string"},"sprintBudget":{"type":"object","additionalProperties":true},"evidenceStates":{"type":"object","additionalProperties":true},"disclaimer":{"type":"string"}},"additionalProperties":true}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"413":{"$ref":"#/components/responses/PayloadTooLarge"},"415":{"$ref":"#/components/responses/UnsupportedMediaType"},"429":{"$ref":"#/components/responses/RateLimited"},"500":{"$ref":"#/components/responses/InternalError"},"503":{"$ref":"#/components/responses/ServiceUnavailable"},"504":{"$ref":"#/components/responses/Timeout"}}}},"/api/v1/account/usage":{"get":{"operationId":"getAccountUsage","summary":"Read the calling account's credit balance and recent activity","description":"Accepts the same credentials as the workflow routes: a same-origin Clerk session or a user-owned API key in the Authorization Bearer header. Always returns only the authenticated caller's own usage.","responses":{"200":{"description":"Plan, credit balance, per-operation usage, daily usage, recent activity, and billing status for the calling account.","headers":{"X-Name-Ledger-API-Version":{"description":"Always v1 on API envelope responses.","schema":{"type":"string"}}},"content":{"application/json":{"schema":{"type":"object","required":["plan","creditBalance","usage"],"properties":{"plan":{"type":"string"},"period":{"type":"string"},"creditBalance":{"type":"object","additionalProperties":true},"usage":{"type":"array","items":{"type":"object","additionalProperties":true}},"dailyUsage":{"type":"array","items":{"type":"object","additionalProperties":true}},"recentActivity":{"type":"array","items":{"type":"object","additionalProperties":true}},"namingProjects":{"type":"object","additionalProperties":true},"account":{"type":"object","additionalProperties":true},"billing":{"type":"object","additionalProperties":true}},"additionalProperties":true}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"429":{"$ref":"#/components/responses/RateLimited"},"500":{"$ref":"#/components/responses/InternalError"},"503":{"$ref":"#/components/responses/ServiceUnavailable"}}}},"/mcp":{"post":{"operationId":"mcpStreamableHttp","summary":"Remote Model Context Protocol endpoint (Streamable HTTP, stateless)","description":"MCP JSON-RPC over Streamable HTTP, not a REST route. Send JSON-RPC messages with Content-Type: application/json and Accept: application/json, text/event-stream. Responses stream as Server-Sent Events (including notifications/progress during long naming sprints) or plain JSON. Stateless: no Mcp-Session-Id is issued and GET/DELETE return 405. Requires a NamingSignal user API key as the Authorization Bearer token; every tool call is authenticated, metered, and rate-limited by the /api/v1 routes it invokes with that key. Tools: compile_project_brief, create_naming_sprint, check_names, analyze_candidates, get_purchase_links.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","description":"A single JSON-RPC 2.0 message or a batch array.","additionalProperties":true}}}},"responses":{"200":{"description":"JSON-RPC response, streamed as text/event-stream or returned as application/json.","content":{"text/event-stream":{"schema":{"type":"string"}},"application/json":{"schema":{"type":"object","additionalProperties":true}}}},"400":{"description":"Invalid JSON or invalid JSON-RPC message (JSON-RPC error body).","content":{"application/json":{"schema":{"type":"object","additionalProperties":true}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"405":{"description":"GET and DELETE are not supported by this stateless endpoint.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"406":{"description":"The Accept header must include both application/json and text/event-stream.","content":{"application/json":{"schema":{"type":"object","additionalProperties":true}}}},"415":{"description":"Content-Type must be application/json.","content":{"application/json":{"schema":{"type":"object","additionalProperties":true}}}}}}}},"components":{"securitySchemes":{"bearerAuth":{"type":"http","scheme":"bearer","description":"A user-owned NamingSignal API key created after sign-in at /developers. Same-origin web calls may use the Clerk session instead. Revoked, expired, or subject-mismatched keys return 401; verifier outages return 503 rather than failing open."}},"responses":{"BadRequest":{"description":"Invalid JSON, a non-object body, or a field outside its documented bounds (codes such as invalid_json, invalid_request, untrusted_risk_signals).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"Unauthorized":{"description":"Missing, invalid, revoked, or expired credential (codes authentication_required, api_key_inactive). Create a user API key at /developers and send it as the Authorization Bearer header.","headers":{"WWW-Authenticate":{"schema":{"type":"string"}},"X-Name-Ledger-API-Version":{"description":"Always v1 on API envelope responses.","schema":{"type":"string"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"Forbidden":{"description":"The credential is valid but not a user-owned key (code user_api_key_required); organization keys are rejected.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"PayloadTooLarge":{"description":"The request body, a text field, or the scoring context exceeds its byte limit (codes request_too_large, unsafe_import, invalid_request).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"UnsupportedMediaType":{"description":"Content-Type must be application/json (code unsupported_media_type).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"RateLimited":{"description":"The per-minute burst limit or the monthly Naming Credit allowance was exceeded. The body adds retryAfterSeconds and resetAt; the Retry-After header is always present. X-RateLimit-* headers appear on successful metered responses, not on this response.","headers":{"Retry-After":{"schema":{"type":"integer"},"description":"Seconds to wait before retrying."},"X-Name-Ledger-API-Version":{"description":"Always v1 on API envelope responses.","schema":{"type":"string"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"InternalError":{"description":"Unexpected failure (code internal_error). No provider details or credentials are leaked.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"ServiceUnavailable":{"description":"Authentication or key verification is temporarily unavailable (codes authentication_unavailable, api_key_verification_unavailable). The API fails closed; retryable is true.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"Timeout":{"description":"The request did not finish before the server timeout (code request_timeout, HTTP 504; retryable). URL imports can also surface upstream 504 import errors.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}},"schemas":{"Error":{"type":"object","description":"Stable error envelope used by every non-2xx API response.","required":["error","code","retryable"],"properties":{"error":{"type":"string","description":"Safe human-readable message; never includes keys or raw provider bodies."},"code":{"type":"string","description":"Stable machine-readable code."},"retryable":{"type":"boolean"},"retryAfterSeconds":{"type":"integer","minimum":0,"description":"Present on 429 responses."},"resetAt":{"type":"string","format":"date-time","description":"Present on 429 responses."}}},"ProjectBrief":{"type":"object","description":"Editable naming brief. Unknown fields are rejected loosely (extra fields are ignored, not stored); string and list bounds are enforced.","required":["product"],"properties":{"product":{"type":"string","minLength":1,"maxLength":4000},"primaryUser":{"type":"string","maxLength":1000},"pain":{"type":"string","maxLength":1000},"outcome":{"type":"string","maxLength":1000},"mechanism":{"type":"string","maxLength":1000},"platform":{"type":"array","maxItems":20,"items":{"type":"string","maxLength":200}},"acquisitionChannels":{"type":"array","maxItems":20,"items":{"type":"string","maxLength":200}},"brandTone":{"type":"array","maxItems":20,"items":{"type":"string","maxLength":200}},"futureExpansion":{"type":"string","maxLength":1000},"domainRequirements":{"type":"array","maxItems":20,"items":{"type":"string","maxLength":200}},"avoid":{"type":"array","maxItems":20,"items":{"type":"string","maxLength":200}},"uncertainties":{"type":"array","maxItems":20,"items":{"type":"string","maxLength":200}},"evidence":{"type":"array","maxItems":12,"items":{"type":"object","required":["source","excerpt"],"properties":{"source":{"type":"string","maxLength":300},"excerpt":{"type":"string","maxLength":1000},"field":{"type":"string","enum":["product","primaryUser","pain","outcome","mechanism","futureExpansion","avoid"]}}}}}},"Usage":{"type":"object","description":"Per-request provider accounting: call/token/search counters, estimated and (when the provider reports it) actual USD, cache hits, retries, failures, and latencyMs. Exact counters vary by route.","additionalProperties":true},"Quota":{"type":"object","description":"Naming Credit accounting for the calling account after this request: limit, remaining, resetAt (UTC calendar month), and creditsCharged. Mirrored in the X-RateLimit-* and X-Naming-Credits-* response headers.","additionalProperties":true},"Candidate":{"type":"object","description":"A named candidate with optional vein, rationale, transparent score (overall plus hardBlockers), per-TLD domain evidence objects (status, provider, checkedAt, manualUrl, evidence), namespace states, and risk signals depending on the route.","required":["name"],"properties":{"name":{"type":"string"},"vein":{"type":"string"},"rationale":{"type":"string"},"score":{"type":"object","additionalProperties":true},"domains":{"type":"array","items":{"type":"object","additionalProperties":true}},"namespaces":{"type":"array","items":{"type":"object","additionalProperties":true}},"riskSignals":{"type":"array","items":{"type":"object","additionalProperties":true}},"evidence":{"type":"array","items":{"type":"object","additionalProperties":true}}},"additionalProperties":true}}}}