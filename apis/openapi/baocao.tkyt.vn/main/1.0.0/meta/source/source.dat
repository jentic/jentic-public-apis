  "servers": [
    {
      "url": "https://baocao.tkyt.vn/bc23",
      "description": "Production server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Payload": {
        "type": "object",
        "required": [
          "credentials",
          "id",
          "baocao23Data"
        ],
        "properties": {
          "credentials": {
            "type": "object",
            "$ref": "#/components/schemas/Credentials"
          },
          "baocao23Data": {
            "type": "object",
            "$ref": "#/components/schemas/baocao23Data"
          }
        }
      },
      "Credentials": {
        "type": "object",
        "properties": {
          "program": {
            "type": "string",
            "enum": [
              "BAOCAO"
            ],
            "example": "BAOCAO"
          }
        },
        "required": [
          "program",
          "token"
        ]
      },
      "baocao23Data": {
        "type": "object",
        "properties": {
          "DU_LIEU": {
            "type": "object",
            "$ref": "#/components/schemas/DU_LIEU"
          }
        },
        "required": [
          "TTC"
        ]
      },
      "DU_LIEU": {
        "type": "object",
        "properties": {
          "A6": {
            "type": "object",
            "$ref": "#/components/schemas/A6"
          }
        }
      },
      "A6": {
        "type": "object",
        "required": [
          "NGAY_DKKT_TU_PHAP",
          "NGAY_SINH",
          "DON_VI",
          "HO_TEN",
          "GIOI_TINH",
          "DAN_TOC"
        ],
        "properties": {
          "NGAY_DKKT_TU_PHAP": {
            "type": "string",
            "format": "yyyy/MM/dd",
            "example": "2024/04/03"
          },
          "HO_TEN": {
            "type": "string",
            "example": "Nguyễn Văn A"
          },
          "GIOI_TINH": {
            "type": "string",
            "enum": [
              "M - Nam",
              "F - Nữ"
            ],
            "example": "M"
          },
          "NGAY_SINH": {
            "type": "string",
            "format": "yyyy/MM/dd",
            "example": "2024/04/03"
          },
          "LOAI_GTTT": {
            "type": "string",
            "enum": [
              "1 - Mã định danh/CCCD/CMT",
              "2 - Hộ chiếu",
              "3 - Khác (ghi rõ)",
              "4 - Không có giấy tờ tuỳ thân"
            ],
            "example": 1
          },
          "SO_GTTT": {
            "type": "string",
            "example": "0123456789"
          },
          "DIA_CHI": {
            "type": "string",
            "example": ""
          },
          "NGHE_NGHIEP": {
            "type": "string",
            "example": "Nông"
          },
          "DAN_TOC": {
            "type": "string",
            "enum": [
              "1 - Kinh",
              "2 - Tày",
              "3 - Thái",
              "4 - Hoa",
              "5 - Khơ-me",
              "6 - Mường",
              "7 - Nùng",
              "8 - Mông",
              "9 - Dao",
              "10 - Gia-rai",
              "11 - Ngái",
              "12 - Ê-đê",
              "13 - Ba na",
              "14 - Xơ-Đăng",
              "15 - Sán Chay",
              "16 - Cơ-ho",
              "17 - Chăm",
              "18 - Sán Dìu",
              "19 - Hrê",
              "20 - Mnông",
              "21 - Ra-glai",
              "22 - Xtiêng",
              "23 - Bru-Vân Kiều",
              "24 - Thổ",
              "25 - Giáy",
              "26 - Cơ-tu",
              "27 - Gié Triêng",
              "28 - Mạ",
              "29 - Khơ-mú",
              "30 - Co",
              "31 - Tà-ôi",
              "32 - Chơ-ro",
              "33 - Kháng",
              "34 - Xinh-mun",
              "35 - Hà Nhì",
              "36 - Chu ru",
              "37 - Lào",
              "38 - La Chí",
              "39 - La Ha",
              "40 - Phù Lá",
              "41 - La Hủ",
              "42 - Lự",
              "43 - Lô Lô",
              "44 - Chứt",
              "45 - Mảng",
              "46 - Pà Thẻn",
              "47 - Co Lao",
              "48 - Cống",
              "49 - Bố Y",
              "50 - Si La",
              "51 - Pu Péo",
              "52 - Brâu",
              "53 - Ơ Đu",
              "54 - Rơ măm",
              "55 - Người nước ngoài",
              "99 - Không rõ"
            ],
            "example": "1"
          },
          "NGAY_TV_TU_PHAP": {
            "type": "string",
            "format": "yyyy/MM/dd",
            "example": "2024/04/03"
          },
          "NOI_TV_TU_PHAP": {
            "type": "string",
            "example": "Bênh viện"
          },
          "NOI_DKKT": {
            "type": "string",
            "example": "UBND"
          },
          "NNTV_TU_PHAP": {
            "type": "string",
            "example": "Lao"
          },
          "TINH_TRANG_DKKT": {
            "type": "string",
            "enum": [
              "1 - Đã đăng ký",
              "2 - Chưa đăng ký"
            ],
            "example": 1
          },
          "MOI_LIEN_HE_NGUOI_CCTT": {
            "type": "string",
            "example": "Vợ"
          },
          "TEN_NGUOI_CCTT": {
            "type": "string",
            "example": "Nguyễn Thị C"
          },
          "SDT_NGUOI_CCTT": {
            "type": "string",
            "example": "0904123456"
          },
          "DON_VI": {
            "type": "string",
            "example": 16732
          }
        }
      },
      "Job": {
        "type": "object",
        "properties": {
          "response": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  200,
                  500
                ],
                "examples": [
                  200,
                  500
                ]
              },
              "message": {
                "type": "string",
                "enum": [
                  "Tạo mới thành công",
                  "Tạo mới thất bại",
                  "Cập nhật thành công",
                  "Cập nhật thất bại"
                ],
                "example": "Tạo mới thành công"
              }
            }
          },
          "completedAt": {
            "type": "string",
            "example": "2024-04-28T10:43:52.505+07:00"
          },
          "category": {
            "type": "string"
          },
          "level": {
            "type": "string"
          }
        }
      }
    }
  },
  "paths": {
    "/api/v1/import": {
      "post": {
        "summary": "1.1 Đẩy dữ liệu",
        "tags": [
          "Đẩy dữ liệu A6 vào hệ thống báo cáo thống kê y tế"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "**1. Payload**\n  ```\n  {\n    \"credentials\": {\n      \"program\": \"BAOCAO\"\n    },\n      \"baocao23Data\": [\n        \"DU_LIEU\": {\n          \"A6\": {\n            \"NGAY_DKKT_TU_PHAP\": \"2024/04/03\",\n            \"HO_TEN\": \"Nguyễn Văn A\",\n            \"GIOI_TINH\": \"M\",\n            \"NGAY_SINH\": \"2024/04/03\",\n            \"LOAI_GTTT\": \"1\",\n            \"SO_GTTT\": \"123456789\",\n            \"DIA_CHI\": \"\",\n            \"NGHE_NGHIEP\": \"Nông\",\n            \"DAN_TOC\": \"1\",\n            \"NGAY_TV_TU_PHAP\": \"2024/04/03\",\n            \"NOI_TV_TU_PHAP\": \"Bênh viện\",\n            \"NOI_DKKT\": \"UBND\",\n            \"NNTV_TU_PHAP\": \"Lao\",\n            \"MOI_LIEN_HE_NGUOI_CCTT\": \"Vợ\",\n            \"TEN_NGUOI_CCTT\": \"Nguyễn Thị C\",\n            \"SDT_NGUOI_CCTT\": \"904123456\"\n          }\n      }\n    ]\n  }\n  ```\n  + *Ghi chú:*\n      + token: trường access_token Lấy từ https://auth.ngsp.nhic.vn/oauth2/token\n      + Đối tượng baocao23Data được mô tả trong phần schema của api này và tài liệu danh mục([link](https://docs.google.com/spreadsheets/d/1lJzfzJgw38j0DfqvAbkKTm6YnvcKVA6cflkSiHBvMDA/edit?usp=sharing))*\n      + Những trường không có dữ liệu có thể được loại bỏ ra khỏi ra khỏi nội dung của đối tượng baocao23Data.\n  \n**2. Kết quả trả về**\n\n+ Thành công\n   + pID: UID Lần đẩy dữ liệu hiện tại\n   + jobReference: Đường dẫn kết quả đẩy dữ liệu\n  \n    ```\n     {\n       \"pID\": \"64b21aa495479b0b5de677b4\"\n       \"jobReference\": \"https://baocao.tkyt.vn/bc/api/v1/job?pID=64b21aa495479b0b5de677b4\"\n      }\n    ```\n   + *Ghi chú: Bên đẩy dữ liệu lưu lại bản ghi kèm pID phục vụ cho việc tra soát dữ liệu giữa 2 bên khi có lỗi.*\n    \n   \n  \n+ Kiểm tra tính hợp lệ bản ghi lỗi\n  + validate: Danh sách chi tiết các lỗi hợp lệ\n  ```\n    {\n      \"validate\": {\n          \"baocao23Data.0.DU_LIEU.A6.GIOI_TINH\": \"Chỉ hỗ trợ các option sau: M,F. Vui lòng kiểm tra lại dữ liệu đầu vào: 1\",\n          \"baocao23Data.0.DU_LIEU.A6.NGAY_DKKT_TU_PHAP\": \"Định dạng yêu cầu yyyy-MM-dd. Vui lòng kiểm tra lại dữ liệu đầu vào: 2024-02-30\"\n      }\n  }\n  ```\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Payload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "validate": {
                      "type": "object",
                      "description": "Kiểm tra lại data",
                      "example": {
                        "baocao23Data.0.DU_LIEU.A6.GIOI_TINH": "Chỉ hỗ trợ các option sau M, F. Vui lòng kiểm tra lại dữ liệu đầu vào 1",
                        "baocao23Data.0.DU_LIEU.A6.NGAY_DKKT_TU_PHAP Định dạng yêu cầu yyyy-MM-dd. Vui lòng kiểm tra lại dữ liệu đầu vào": "2024-02-30"
                      }
                    },
                    "jobReference": {
                      "type": "string",
                      "example": "https://baocao.tkyt.vn/bc/api/v1/job?pID=64b21aa495479b0b5de677b4",
                      "description": "Api kiểm tra tình trạng import các bản ghi"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/job": {
      "get": {
        "summary": "1.2 Kiểm tra tình trạng đẩy dữ liệu",
        "tags": [
          "Đẩy dữ liệu A6 vào hệ thống báo cáo thống kê y tế"
        ],
        "description": "**1. Parameters**\n  + pId: UID Lần đẩy dữ liệu\n  \n**2. Kết quả trả về**\n- Bản ghi đầu trong danh sách mô tả thời gian bắt đầu đẩy dữ liệu.\n- Các bản ghi ở giữa mô tả chi tiết đối tượng và kết quả tạo mới, cập nhật.\n    + response.code: 200.\n    + response.message: Tạo mới thành công.\n- Bản ghi cuối trong danh sách mô tả thời gian đẩy dữ liệu hoàn tất.\n```\n    {\n      [\n        {\n            \"completedAt\": \"2023-07-15T04:03:48.824+00:00\",\n            \"category\": \"IMPORT_JOB\",\n            \"level\": \"INFO\",\n            \"response\": \"Job started\"\n        },\n        {\n          \"completedAt\": \"2023-07-15T04:03:49.923+00:00\",\n          \"category\": \"IMPORT_JOB\",\n          \"level\": \"INFO\",\n          \"response\": {\n              \"status\": 200,\n              \"message\": \"Cập nhật thành công\",\n          } \n        },\n        {\n          \"completedAt\": \"2023-07-15T04:03:54.020+00:00\",\n          \"category\": \"IMPORT_JOB\",\n          \"level\": \"INFO\",\n          \"response\": \"Import completed!\"\n        }\n    }\n```\n",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Job"
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "pID",
            "in": "query",
            "required": true,
            "description": "UID Lần đẩy dữ liệu",
            "example": "64b21aa495479b0b5de677b4",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}
