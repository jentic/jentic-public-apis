                "type": "string"
              },
              "idempotency_key": {
                "type": "string"
              }
            }
          },
          "created": {
            "type": "integer"
          },
          "livemode": {
            "type": "boolean"
          }
        }
      },
      "EventList": {
        "allOf": [
          {
            "$ref": "#/components/schemas/PaginatedList"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            }
          }
        ]
      },
      "WebhookEndpoint": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "we_1234567890"
          },
          "object": {
            "type": "string",
            "enum": [
              "webhook_endpoint"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "enabled_events": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "enabled",
              "disabled"
            ]
          },
          "created": {
            "type": "integer"
          }
        }
      },
      "WebhookEndpointWithSecret": {
        "allOf": [
          {
            "$ref": "#/components/schemas/WebhookEndpoint"
          },
          {
            "type": "object",
            "properties": {
              "secret": {
                "type": "string",
                "description": "Webhook secret (solo visible una vez)"
              }
            }
          }
        ]
      },
      "WebhookEndpointList": {
        "allOf": [
          {
            "$ref": "#/components/schemas/PaginatedList"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/WebhookEndpoint"
                }
              }
            }
          }
        ]
      },
      "CreateWebhookEndpointRequest": {
        "type": "object",
        "required": [
          "url",
          "enabled_events"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "enabled_events": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "*",
                "payment.succeeded",
                "payment.failed",
                "payment.pending",
                "invoice.generated",
                "refund.created",
                "refund.succeeded",
                "checkout.session.completed",
                "checkout.session.expired"
              ]
            }
          },
          "description": {
            "type": "string"
          }
        }
      },
      "UpdateWebhookEndpointRequest": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "enabled_events": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "enabled",
              "disabled"
            ]
          }
        }
      },
      "File": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "file_1234567890"
          },
          "object": {
            "type": "string",
            "enum": [
              "file"
            ]
          },
          "filename": {
            "type": "string"
          },
          "purpose": {
            "type": "string",
            "enum": [
              "invoice_pdf",
              "report_export",
              "logo",
              "import_data"
            ]
          },
          "size": {
            "type": "integer",
            "description": "Tamaño en bytes"
          },
          "type": {
            "type": "string",
            "description": "MIME type"
          },
          "url": {
            "type": "string",
            "description": "URL firmada para descarga"
          },
          "expires_at": {
            "type": "integer"
          },
          "created": {
            "type": "integer"
          }
        }
      },
      "FileList": {
        "allOf": [
          {
            "$ref": "#/components/schemas/PaginatedList"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/File"
                }
              }
            }
          }
        ]
      }
    }
