{
  "openapi": "3.1.0",
  "info": {
    "title": "Morelos Pago API",
    "version": "1.0.0",
    "description": "API REST del ecosistema de pagos digitales para el Gobierno del Estado de Morelos.\n\n## Autenticación\n\nLa API utiliza API Keys para autenticación. Incluye tu key en el header `Authorization`:\n\n```\nAuthorization: Bearer sk_live_xxxxxxxxxx\n```\n\n### Tipos de API Keys\n\n| Tipo | Prefijo | Uso |\n|------|---------|-----|\n| Publishable | `pk_` | Frontend, SDK |\n| Secret | `sk_` | Backend, operaciones sensibles |\n| Restricted | `rk_` | Scopes limitados |\n\n## Ambientes\n\n| Ambiente | URL Base |\n|----------|----------|\n| Producción | `https://api.morelospago.gob.mx/v1` |\n| Sandbox | `https://api.sandbox.morelospago.gob.mx/v1` |\n\n## Convenciones\n\n- Montos en **centavos** (ej: `$100.00 MXN` = `10000`)\n- Fechas en formato **ISO 8601** con timezone UTC\n- IDs con prefijos identificadores (ej: `pi_`, `cs_`, `inv_`)\n- Paginación con cursor (`starting_after`, `ending_before`)\n",
    "contact": {
      "name": "Soporte API Morelos Pago",
      "email": "soporte-api@morelospago.gob.mx",
      "url": "https://docs.morelospago.gob.mx"
    },
    "license": {
      "name": "Propietaria",
      "url": "https://morelospago.gob.mx/terminos"
    },
    "x-logo": {
      "url": "https://morelospago.gob.mx/logo.png"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/pai-b17/morelos-pago-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.morelospago.gob.mx/v1",
      "description": "Producción"
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "Endpoints de salud y estado del sistema"
    },
    {
      "name": "Checkout Sessions",
      "description": "Sesiones de checkout para pagos"
    },
    {
      "name": "Payment Intents",
      "description": "Intenciones de pago"
    },
    {
      "name": "Refunds",
      "description": "Reembolsos de pagos"
    },
    {
      "name": "Products",
      "description": "Catálogo de conceptos de pago"
    },
    {
      "name": "Prices",
      "description": "Precios de conceptos"
    },
    {
      "name": "Invoices",
      "description": "Pólizas de pago (comprobantes)"
    },
    {
      "name": "Organizations",
      "description": "Organizaciones consumidoras de la API"
    },
    {
      "name": "API Keys",
      "description": "Gestión de API keys"
    },
    {
      "name": "Users",
      "description": "Usuarios del dashboard"
    },
    {
      "name": "Departments",
      "description": "Dependencias gubernamentales"
    },
    {
      "name": "Reports",
      "description": "Reportes y analytics"
    },
    {
      "name": "Reconciliation",
      "description": "Conciliación de pagos"
    },
    {
      "name": "Events",
      "description": "Eventos del sistema"
    },
    {
      "name": "Webhook Endpoints",
      "description": "Configuración de webhooks"
    },
    {
      "name": "Files",
      "description": "Archivos y documentos"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health check",
        "description": "Verifica que el servicio está operativo",
        "operationId": "healthCheck",
        "security": [],
        "responses": {
          "200": {
            "description": "Servicio operativo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Readiness check",
        "description": "Verifica que el servicio está listo para recibir tráfico",
        "operationId": "readinessCheck",
        "security": [],
        "responses": {
          "200": {
            "description": "Servicio listo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            }
          },
          "503": {
            "description": "Servicio no listo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            }
          }
        }
      }
    },
    "/status": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Estado del sistema",
        "description": "Información detallada del estado de todos los componentes",
        "operationId": "systemStatus",
        "responses": {
          "200": {
            "description": "Estado del sistema",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemStatus"
                }
              }
            }
          }
        }
      }
    },
    "/checkout/sessions": {
      "post": {
        "tags": [
          "Checkout Sessions"
        ],
        "summary": "Crear sesión de checkout",
        "description": "Crea una nueva sesión de checkout para procesar un pago.\n\nLa sesión expira después de 24 horas si no se completa.\n",
        "operationId": "createCheckoutSession",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCheckoutSessionRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Sesión creada exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckoutSession"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "get": {
        "tags": [
          "Checkout Sessions"
        ],
        "summary": "Listar sesiones de checkout",
        "description": "Lista todas las sesiones de checkout de la organización",
        "operationId": "listCheckoutSessions",
        "parameters": [
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/StartingAfter"
          },
          {
            "$ref": "#/components/parameters/EndingBefore"
          },
          {
            "name": "status",
            "in": "query",
            "description": "Filtrar por estado",
            "schema": {
              "type": "string",
              "enum": [
                "open",
                "complete",
                "expired"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de sesiones",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckoutSessionList"
                }
              }
            }
          }
        }
      }
    },
    "/checkout/sessions/{session_id}": {
      "get": {
        "tags": [
          "Checkout Sessions"
        ],
        "summary": "Obtener sesión de checkout",
        "description": "Obtiene los detalles de una sesión de checkout específica",
        "operationId": "getCheckoutSession",
        "parameters": [
          {
            "$ref": "#/components/parameters/SessionId"
          },
          {
            "$ref": "#/components/parameters/Expand"
          }
        ],
        "responses": {
          "200": {
            "description": "Detalles de la sesión",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckoutSession"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/checkout/sessions/{session_id}/expire": {
      "post": {
        "tags": [
          "Checkout Sessions"
        ],
        "summary": "Expirar sesión de checkout",
        "description": "Expira manualmente una sesión de checkout abierta",
        "operationId": "expireCheckoutSession",
        "parameters": [
          {
            "$ref": "#/components/parameters/SessionId"
          }
        ],
        "responses": {
          "200": {
            "description": "Sesión expirada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckoutSession"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    },
    "/payment_intents": {
      "post": {
        "tags": [
          "Payment Intents"
        ],
        "summary": "Crear PaymentIntent",
        "description": "Crea una intención de pago.\n\nUn PaymentIntent guía el flujo de pago desde la creación hasta la captura.\n",
        "operationId": "createPaymentIntent",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePaymentIntentRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "PaymentIntent creado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentIntent"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Payment Intents"
        ],
        "summary": "Listar PaymentIntents",
        "description": "Lista todos los PaymentIntents de la organización",
        "operationId": "listPaymentIntents",
        "parameters": [
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/StartingAfter"
          },
          {
            "$ref": "#/components/parameters/EndingBefore"
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "requires_payment_method",
                "requires_confirmation",
                "requires_action",
                "processing",
                "succeeded",
                "canceled"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de PaymentIntents",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentIntentList"
                }
              }
            }
          }
        }
      }
    },
    "/payment_intents/{payment_intent_id}": {
      "get": {
        "tags": [
          "Payment Intents"
        ],
        "summary": "Obtener PaymentIntent",
        "operationId": "getPaymentIntent",
        "parameters": [
          {
            "$ref": "#/components/parameters/PaymentIntentId"
          },
          {
            "$ref": "#/components/parameters/Expand"
          }
        ],
        "responses": {
          "200": {
            "description": "Detalles del PaymentIntent",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentIntent"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Payment Intents"
        ],
        "summary": "Actualizar PaymentIntent",
        "operationId": "updatePaymentIntent",
        "parameters": [
          {
            "$ref": "#/components/parameters/PaymentIntentId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdatePaymentIntentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "PaymentIntent actualizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentIntent"
                }
              }
            }
          }
        }
      }
    },
    "/payment_intents/{payment_intent_id}/confirm": {
      "post": {
        "tags": [
          "Payment Intents"
        ],
        "summary": "Confirmar PaymentIntent",
        "description": "Confirma y procesa el pago",
        "operationId": "confirmPaymentIntent",
        "parameters": [
          {
            "$ref": "#/components/parameters/PaymentIntentId"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmPaymentIntentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "PaymentIntent confirmado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentIntent"
                }
              }
            }
          }
        }
      }
    },
    "/payment_intents/{payment_intent_id}/capture": {
      "post": {
        "tags": [
          "Payment Intents"
        ],
        "summary": "Capturar PaymentIntent",
        "description": "Captura un pago previamente autorizado",
        "operationId": "capturePaymentIntent",
        "parameters": [
          {
            "$ref": "#/components/parameters/PaymentIntentId"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "amount_to_capture": {
                    "type": "integer",
                    "description": "Monto a capturar en centavos (opcional, default es el total)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Pago capturado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentIntent"
                }
              }
            }
          }
        }
      }
    },
    "/payment_intents/{payment_intent_id}/cancel": {
      "post": {
        "tags": [
          "Payment Intents"
        ],
        "summary": "Cancelar PaymentIntent",
        "operationId": "cancelPaymentIntent",
        "parameters": [
          {
            "$ref": "#/components/parameters/PaymentIntentId"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "cancellation_reason": {
                    "type": "string",
                    "enum": [
                      "duplicate",
                      "fraudulent",
                      "requested_by_customer",
                      "abandoned"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "PaymentIntent cancelado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentIntent"
                }
              }
            }
          }
        }
      }
    },
    "/refunds": {
      "post": {
        "tags": [
          "Refunds"
        ],
        "summary": "Crear reembolso",
        "description": "Crea un reembolso para un PaymentIntent completado",
        "operationId": "createRefund",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRefundRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Reembolso creado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refund"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Refunds"
        ],
        "summary": "Listar reembolsos",
        "operationId": "listRefunds",
        "parameters": [
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/StartingAfter"
          },
          {
            "name": "payment_intent",
            "in": "query",
            "description": "Filtrar por PaymentIntent ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de reembolsos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefundList"
                }
              }
            }
          }
        }
      }
    },
    "/refunds/{refund_id}": {
      "get": {
        "tags": [
          "Refunds"
        ],
        "summary": "Obtener reembolso",
        "operationId": "getRefund",
        "parameters": [
          {
            "$ref": "#/components/parameters/RefundId"
          }
        ],
        "responses": {
          "200": {
            "description": "Detalles del reembolso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refund"
                }
              }
            }
          }
        }
      }
    },
    "/refunds/{refund_id}/cancel": {
      "post": {
        "tags": [
          "Refunds"
        ],
        "summary": "Cancelar reembolso",
        "description": "Cancela un reembolso pendiente",
        "operationId": "cancelRefund",
        "parameters": [
          {
            "$ref": "#/components/parameters/RefundId"
          }
        ],
        "responses": {
          "200": {
            "description": "Reembolso cancelado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Refund"
                }
              }
            }
          }
        }
      }
    },
    "/products": {
      "get": {
        "tags": [
          "Products"
        ],
        "summary": "Listar productos",
        "description": "Lista todos los conceptos de pago disponibles",
        "operationId": "listProducts",
        "parameters": [
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/StartingAfter"
          },
          {
            "name": "active",
            "in": "query",
            "description": "Filtrar por estado activo",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "department_id",
            "in": "query",
            "description": "Filtrar por dependencia",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de productos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductList"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Products"
        ],
        "summary": "Crear producto",
        "operationId": "createProduct",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProductRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Producto creado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          }
        }
      }
    },
    "/products/{product_id}": {
      "get": {
        "tags": [
          "Products"
        ],
        "summary": "Obtener producto",
        "operationId": "getProduct",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProductId"
          }
        ],
        "responses": {
          "200": {
            "description": "Detalles del producto",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Products"
        ],
        "summary": "Actualizar producto",
        "operationId": "updateProduct",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProductId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProductRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Producto actualizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          }
        }
      }
    },
    "/prices": {
      "get": {
        "tags": [
          "Prices"
        ],
        "summary": "Listar precios",
        "operationId": "listPrices",
        "parameters": [
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "name": "product",
            "in": "query",
            "description": "Filtrar por producto",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "active",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de precios",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PriceList"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Prices"
        ],
        "summary": "Crear precio",
        "operationId": "createPrice",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePriceRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Precio creado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Price"
                }
              }
            }
          }
        }
      }
    },
    "/prices/{price_id}": {
      "get": {
        "tags": [
          "Prices"
        ],
        "summary": "Obtener precio",
        "operationId": "getPrice",
        "parameters": [
          {
            "$ref": "#/components/parameters/PriceId"
          }
        ],
        "responses": {
          "200": {
            "description": "Detalles del precio",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Price"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Prices"
        ],
        "summary": "Actualizar precio",
        "operationId": "updatePrice",
        "parameters": [
          {
            "$ref": "#/components/parameters/PriceId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
