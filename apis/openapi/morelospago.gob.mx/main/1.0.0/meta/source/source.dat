      "post": {
        "tags": [
          "Invoices"
        ],
        "summary": "Anular póliza",
        "description": "Anula una póliza emitida (requiere motivo)",
        "operationId": "voidInvoice",
        "parameters": [
          {
            "$ref": "#/components/parameters/InvoiceId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "reason"
                ],
                "properties": {
                  "reason": {
                    "type": "string",
                    "description": "Motivo de anulación"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Póliza anulada",
            "content": {
