          }
        }
      }
    },
    "/webhook_endpoints/{webhook_endpoint_id}": {
      "get": {
        "tags": [
          "Webhook Endpoints"
        ],
        "summary": "Obtener webhook endpoint",
        "operationId": "getWebhookEndpoint",
        "parameters": [
          {
            "$ref": "#/components/parameters/WebhookEndpointId"
          }
        ],
        "responses": {
          "200": {
            "description": "Detalles del endpoint",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookEndpoint"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Webhook Endpoints"
        ],
        "summary": "Actualizar webhook endpoint",
        "operationId": "updateWebhookEndpoint",
        "parameters": [
          {
            "$ref": "#/components/parameters/WebhookEndpointId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateWebhookEndpointRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Endpoint actualizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookEndpoint"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Webhook Endpoints"
        ],
        "summary": "Eliminar webhook endpoint",
        "operationId": "deleteWebhookEndpoint",
        "parameters": [
          {
            "$ref": "#/components/parameters/WebhookEndpointId"
          }
        ],
        "responses": {
          "200": {
            "description": "Endpoint eliminado"
          }
        }
      }
    },
    "/webhook_endpoints/{webhook_endpoint_id}/test": {
      "post": {
        "tags": [
          "Webhook Endpoints"
        ],
        "summary": "Enviar evento de prueba",
        "operationId": "testWebhookEndpoint",
        "parameters": [
          {
            "$ref": "#/components/parameters/WebhookEndpointId"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "event_type": {
                    "type": "string",
                    "default": "payment.succeeded"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Evento de prueba enviado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "response_code": {
                      "type": "integer"
                    },
                    "response_time_ms": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/files": {
      "get": {
        "tags": [
          "Files"
        ],
        "summary": "Listar archivos",
        "operationId": "listFiles",
        "parameters": [
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "name": "purpose",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "invoice_pdf",
                "report_export",
                "logo"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de archivos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileList"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Files"
        ],
        "summary": "Subir archivo",
        "operationId": "uploadFile",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file",
                  "purpose"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  },
                  "purpose": {
                    "type": "string",
                    "enum": [
                      "logo",
                      "import_data"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Archivo subido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/File"
                }
              }
            }
          }
        }
      }
    },
    "/files/{file_id}": {
      "get": {
        "tags": [
          "Files"
        ],
        "summary": "Obtener archivo",
        "operationId": "getFile",
        "parameters": [
          {
            "name": "file_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Metadatos del archivo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/File"
                }
              }
            }
          }
        }
      }
    },
    "/files/{file_id}/download": {
      "get": {
        "tags": [
          "Files"
        ],
        "summary": "Descargar archivo",
        "operationId": "downloadFile",
        "parameters": [
          {
            "name": "file_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirección a URL firmada"
          }
        }
      }
    },
    "/webhooks/stripe": {
      "post": {
        "tags": [
          "Webhook Endpoints"
        ],
        "summary": "Webhook de Stripe",
        "description": "Recibe eventos de Stripe (no llamar directamente)",
        "operationId": "stripeWebhook",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Evento recibido"
          },
          "400": {
            "description": "Firma inválida"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "API Key de Morelos Pago.\n\nFormato: `Bearer sk_live_xxxxxxxxxx`\n"
      }
    },
    "parameters": {
      "Limit": {
        "name": "limit",
        "in": "query",
        "description": "Número máximo de resultados (1-100, default 10)",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 10
        }
      },
      "StartingAfter": {
        "name": "starting_after",
        "in": "query",
        "description": "Cursor para paginación (ID del último elemento)",
        "schema": {
          "type": "string"
        }
      },
      "EndingBefore": {
        "name": "ending_before",
        "in": "query",
        "description": "Cursor para paginación inversa",
        "schema": {
          "type": "string"
        }
      },
      "Expand": {
        "name": "expand[]",
        "in": "query",
        "description": "Campos a expandir",
        "schema": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "style": "form",
        "explode": true
      },
      "SessionId": {
        "name": "session_id",
        "in": "path",
        "required": true,
        "description": "ID de la sesión de checkout",
        "schema": {
          "type": "string",
          "pattern": "^cs_[a-zA-Z0-9]+$"
        }
      },
      "PaymentIntentId": {
        "name": "payment_intent_id",
        "in": "path",
        "required": true,
        "description": "ID del PaymentIntent",
        "schema": {
          "type": "string",
          "pattern": "^pi_[a-zA-Z0-9]+$"
        }
      },
      "RefundId": {
        "name": "refund_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^re_[a-zA-Z0-9]+$"
        }
      },
      "ProductId": {
        "name": "product_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^prod_[a-zA-Z0-9]+$"
        }
      },
      "PriceId": {
        "name": "price_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^price_[a-zA-Z0-9]+$"
        }
      },
      "InvoiceId": {
        "name": "invoice_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^inv_[a-zA-Z0-9]+$"
        }
      },
      "DepartmentId": {
        "name": "department_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^dept_[a-zA-Z0-9]+$"
        }
      },
      "OrganizationId": {
        "name": "organization_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^org_[a-zA-Z0-9]+$"
        }
      },
      "ApiKeyId": {
        "name": "api_key_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^ak_[a-zA-Z0-9]+$"
        }
      },
      "UserId": {
        "name": "user_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^usr_[a-zA-Z0-9]+$"
        }
      },
      "WebhookEndpointId": {
        "name": "webhook_endpoint_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^we_[a-zA-Z0-9]+$"
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Solicitud inválida",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "No autorizado",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Prohibido",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "Recurso no encontrado",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "RateLimited": {
        "description": "Límite de solicitudes excedido",
        "headers": {
          "Retry-After": {
            "schema": {
              "type": "integer"
            },
            "description": "Segundos hasta que se pueda reintentar"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "type",
              "message"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "validation_error",
                  "authentication_error",
                  "authorization_error",
                  "not_found_error",
                  "card_declined",
                  "rate_limit_error",
                  "api_error"
                ],
                "description": "Tipo de error"
              },
              "code": {
                "type": "string",
                "description": "Código específico del error"
              },
              "message": {
                "type": "string",
                "description": "Mensaje descriptivo"
              },
              "param": {
                "type": "string",
                "description": "Parámetro que causó el error"
              },
              "request_id": {
                "type": "string",
                "description": "ID de la solicitud para soporte"
              }
            }
          }
        }
      },
      "PaginatedList": {
        "type": "object",
        "properties": {
          "object": {
            "type": "string",
            "enum": [
              "list"
            ]
          },
          "has_more": {
            "type": "boolean"
          },
          "total_count": {
            "type": "integer"
          },
          "url": {
            "type": "string"
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ReadyResponse": {
        "type": "object",
        "properties": {
          "ready": {
            "type": "boolean"
          },
          "checks": {
            "type": "object",
            "properties": {
              "database": {
                "type": "boolean"
              },
              "nats": {
                "type": "boolean"
              },
              "redis": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "SystemStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "operational",
              "degraded",
              "outage"
            ]
          },
          "version": {
            "type": "string"
          },
          "services": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "operational",
                    "degraded",
                    "outage"
                  ]
                }
              }
            }
          }
        }
      },
      "CheckoutSession": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "cs_1234567890"
          },
          "object": {
            "type": "string",
            "enum": [
              "checkout.session"
            ]
          },
          "amount": {
            "type": "integer",
            "description": "Monto en centavos"
          },
          "currency": {
            "type": "string",
            "default": "MXN"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "complete",
              "expired"
            ]
          },
          "payment_status": {
            "type": "string",
            "enum": [
              "unpaid",
              "paid",
              "no_payment_required"
            ]
          },
          "customer": {
            "$ref": "#/components/schemas/Customer"
          },
          "line_items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LineItem"
            }
          },
          "payment_intent": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/components/schemas/PaymentIntent"
              }
            ],
            "x-expandable": true
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "url": {
            "type": "string",
            "description": "URL del checkout hospedado"
          },
          "success_url": {
            "type": "string"
          },
          "cancel_url": {
            "type": "string"
          },
          "expires_at": {
            "type": "integer",
            "description": "Timestamp Unix de expiración"
          },
          "created": {
            "type": "integer"
          },
          "livemode": {
            "type": "boolean"
          }
        }
      },
      "CheckoutSessionList": {
        "allOf": [
          {
            "$ref": "#/components/schemas/PaginatedList"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/CheckoutSession"
                }
              }
            }
          }
        ]
      },
      "CreateCheckoutSessionRequest": {
        "type": "object",
        "required": [
          "line_items",
          "success_url"
        ],
        "properties": {
          "line_items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "price",
                "quantity"
              ],
              "properties": {
                "price": {
                  "type": "string",
                  "description": "ID del Price"
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "customer_email": {
            "type": "string",
            "format": "email"
          },
          "customer": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string",
                "format": "email"
              },
              "phone": {
                "type": "string"
              }
            }
          },
          "success_url": {
            "type": "string",
            "format": "uri"
          },
          "cancel_url": {
            "type": "string",
            "format": "uri"
          },
          "payment_method_types": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "card",
                "oxxo",
                "spei"
              ]
            }
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "expires_at": {
            "type": "integer"
          }
        }
      },
      "PaymentIntent": {
        "type": "object",
