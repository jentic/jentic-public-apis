        "parameters": [
          {
            "name": "reconciliation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Detalles de conciliación",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Reconciliation"
                }
              }
            }
          }
        }
      }
    },
    "/reconciliation/{reconciliation_id}/resolve": {
      "post": {
        "tags": [
          "Reconciliation"
        ],
        "summary": "Resolver discrepancia",
        "operationId": "resolveReconciliation",
        "parameters": [
          {
            "name": "reconciliation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "resolution",
                  "notes"
                ],
                "properties": {
                  "resolution": {
                    "type": "string",
                    "enum": [
                      "match_confirmed",
                      "duplicate_voided",
                      "refund_issued",
                      "manual_adjustment"
                    ]
                  },
                  "notes": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Discrepancia resuelta",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Reconciliation"
                }
              }
            }
          }
        }
      }
    },
    "/reconciliation/trigger": {
      "post": {
        "tags": [
          "Reconciliation"
        ],
        "summary": "Ejecutar conciliación manual",
        "description": "Dispara el proceso de conciliación para una fecha específica",
        "operationId": "triggerReconciliation",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "date"
                ],
                "properties": {
                  "date": {
                    "type": "string",
                    "format": "date"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Conciliación iniciada",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "job_id": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/events": {
      "get": {
