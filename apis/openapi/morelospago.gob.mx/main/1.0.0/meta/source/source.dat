                  "$ref": "#/components/schemas/WebhookEndpointList"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Webhook Endpoints"
        ],
        "summary": "Crear webhook endpoint",
        "operationId": "createWebhookEndpoint",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateWebhookEndpointRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Endpoint creado",
