    "/invoices": {
      "get": {
        "tags": [
          "Invoices"
        ],
        "summary": "Listar pólizas",
        "description": "Lista todas las pólizas de pago generadas",
        "operationId": "listInvoices",
        "parameters": [
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/StartingAfter"
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "draft",
                "issued",
                "paid",
                "void"
              ]
            }
          },
          {
            "name": "created[gte]",
            "in": "query",
            "description": "Filtrar por fecha de creación >= (timestamp Unix)",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "created[lte]",
            "in": "query",
            "description": "Filtrar por fecha de creación <= (timestamp Unix)",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de pólizas",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvoiceList"
                }
              }
            }
          }
        }
      }
    },
