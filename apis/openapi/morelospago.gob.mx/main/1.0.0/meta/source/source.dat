            }
          }
        }
      }
    },
    "/invoices/verify/{folio}": {
      "get": {
        "tags": [
          "Invoices"
        ],
        "summary": "Verificar póliza por folio",
        "description": "Verifica la autenticidad de una póliza usando su folio",
        "operationId": "verifyInvoice",
        "security": [],
        "parameters": [
          {
            "name": "folio",
            "in": "path",
            "required": true,
            "description": "Folio de la póliza (ej. POL-2026-000001)",
            "schema": {
              "type": "string",
              "pattern": "^POL-\\d{4}-\\d{6}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Información de verificación",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvoiceVerification"
                }
              }
            }
          },
          "404": {
            "description": "Folio no encontrado"
          }
        }
      }
    },
