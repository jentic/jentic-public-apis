{"openapi":"3.1.0","info":{"title":"Asin API","version":"0.0.1","description":"Track Amazon prices and products: a watchlist checked on schedule, with price history and alerts. Authenticate with a personal API key from your account (Bearer token). Each price check of a tracked product costs 1 credit; a product checked daily uses about 30 credits a month. Failed checks are refunded. The same key works with the MCP server at /api/mcp and the Chrome extension."},"externalDocs":{"description":"Documentation","url":"https://www.asin.dev/docs"},"servers":[{"url":"https://www.asin.dev/api/v1"}],"tags":[{"name":"Watchlist","description":"The products you track, checked on their schedule."},{"name":"Amazon data","description":"Search Amazon and read any product's offers and shared price history."},{"name":"Account","description":"Your plan and your credits."}],"security":[{"bearerAuth":[]}],"paths":{"/account":{"get":{"operationId":"getAccount","tags":["Account"],"summary":"Plan and remaining credits","description":"Your plan, the credits left (monthly allowance and packs), how many products you track and the credits they use per month.","responses":{"200":{"description":"Account","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Account"},"example":{"plan":"basic","plan_name":"Starter","credits":29588,"renews_at":"2026-12-01T09:12:44.000Z","products":42,"product_limit":50000,"fastest_interval_minutes":60,"monthly_credits":1260,"manage_url":"https://www.asin.dev/app"}}}},"401":{"description":"unauthorized: The API key is missing, revoked or invalid.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"500":{"description":"generic: Unexpected error on our side. Retry in a moment.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/search":{"get":{"operationId":"searchAmazon","tags":["Amazon data"],"summary":"Search Amazon","description":"Amazon search results (up to 60, sponsored included), to find the ASIN of a product. Free, limited to 30 searches per hour.","parameters":[{"name":"query","in":"query","required":true,"description":"Keywords","schema":{"type":"string"},"example":"wireless earbuds"},{"name":"marketplace","in":"query","description":"Amazon store, e.g. com for amazon.com","schema":{"type":"string","enum":["com","co.uk","de","fr","it","es","ca","co.jp","com.br","com.mx","in"],"default":"com","description":"Amazon store, e.g. com for amazon.com"},"example":"com"}],"responses":{"200":{"description":"Results","content":{"application/json":{"schema":{"type":"object","required":["results"],"properties":{"results":{"type":"array","items":{"$ref":"#/components/schemas/SearchResult"}}}},"example":{"results":[{"asin":"B09DFCB66S","title":"Wireless Earbuds, Bluetooth 5.3, Noise Cancelling","image":"https://m.media-amazon.com/images/I/…jpg","price":79.99,"currency":"USD","rating":4.4,"reviews_count":12873}]}}}},"400":{"description":"invalid_option: A setting isn't valid: marketplace (com, co.uk, de, fr, it, es, ca, co.jp, com.br, com.mx, in), filter, interval_minutes (5, 30, 60, 360, 720, 1440), target_price, alert_on_drop or paused. Also when the body isn't a JSON object, a required argument is missing, or the product to check is paused.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"unauthorized: The API key is missing, revoked or invalid.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"rate_limited: More than 30 searches or 600 history or offers reads in an hour, too many reads of Amazon at once, or too many different products read today: 200 a day on the free plan, 1,000 with a credit pack, then 1,000 with Starter, 3,000 with Pro, 10,000 with Business. Histories, offers and new watchlist entries count, once per product; your watchlist and the products already read today stay available. Retry later, or after midnight UTC for the daily limit.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"500":{"description":"generic: Unexpected error on our side. Retry in a moment.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"502":{"description":"amazon_unavailable: Amazon couldn't be read right now (GET /search, GET /offers). Nothing is charged; retry in a moment.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/offers":{"get":{"operationId":"getOffers","tags":["Amazon data"],"summary":"Offers already known","description":"Who sells the product and at what price, as last read, cheapest first, with Amazon's own price and the cheapest new and used offers (used is only known for Amazon's own outlet). Free: this never reads Amazon or spends a credit. When nobody read this product's offers yet, the list is empty and fetched_at is null: POST /offers reads them.","parameters":[{"name":"asin","in":"query","required":true,"description":"10-character ASIN","schema":{"type":"string","pattern":"^[A-Za-z0-9]{10}$","description":"10-character ASIN"},"example":"B09DFCB66S"},{"name":"marketplace","in":"query","description":"Amazon store, e.g. com for amazon.com","schema":{"type":"string","enum":["com","co.uk","de","fr","it","es","ca","co.jp","com.br","com.mx","in"],"default":"com","description":"Amazon store, e.g. com for amazon.com"},"example":"com"}],"responses":{"200":{"description":"Offers","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Offers"},"example":{"asin":"B09DFCB66S","marketplace":"com","currency":"USD","fetched_at":"2026-11-03T08:00:12.441Z","charged":false,"amazon_price":79.99,"lowest_new_price":74.5,"lowest_used_price":61.2,"offers":[{"seller":"Amazon Resale","seller_id":null,"price":61.2,"amazon":false,"fulfilled_by_amazon":false,"used":true,"delivery_time":"Friday, November 6","delivery_price":"FREE"},{"seller":"Example Audio Store","seller_id":"A10IJ5BG4OYOQ1","price":74.5,"amazon":false,"fulfilled_by_amazon":true,"used":false,"delivery_time":"Friday, November 6","delivery_price":"FREE"},{"seller":"Amazon","seller_id":null,"price":79.99,"amazon":true,"fulfilled_by_amazon":false,"used":false,"delivery_time":"Thursday, November 5","delivery_price":"FREE"}]}}}},"400":{"description":"invalid_product: product is neither a 10-character ASIN nor an Amazon product link, or asin isn't a 10-character ASIN. invalid_option: A setting isn't valid: marketplace (com, co.uk, de, fr, it, es, ca, co.jp, com.br, com.mx, in), filter, interval_minutes (5, 30, 60, 360, 720, 1440), target_price, alert_on_drop or paused. Also when the body isn't a JSON object, a required argument is missing, or the product to check is paused.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"unauthorized: The API key is missing, revoked or invalid.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"rate_limited: More than 30 searches or 600 history or offers reads in an hour, too many reads of Amazon at once, or too many different products read today: 200 a day on the free plan, 1,000 with a credit pack, then 1,000 with Starter, 3,000 with Pro, 10,000 with Business. Histories, offers and new watchlist entries count, once per product; your watchlist and the products already read today stay available. Retry later, or after midnight UTC for the daily limit.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"500":{"description":"generic: Unexpected error on our side. Retry in a moment.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}},"post":{"operationId":"fetchOffers","tags":["Amazon data"],"summary":"Read every offer from Amazon","description":"Reads the offers on Amazon for 1 credit, refunded if it doesn't answer. A read made in the last 3 hours, by anyone, is returned instead, for free (charged: false). The answer is the same as GET /offers.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["asin"],"properties":{"asin":{"type":"string","pattern":"^[A-Za-z0-9]{10}$","description":"10-character ASIN"},"marketplace":{"type":"string","enum":["com","co.uk","de","fr","it","es","ca","co.jp","com.br","com.mx","in"],"default":"com","description":"Amazon store, e.g. com for amazon.com"},"refresh":{"type":"boolean","default":false,"description":"Read Amazon again unless the last read is under 5 minutes old (1 credit)"}}},"example":{"asin":"B09DFCB66S","marketplace":"com"}}}},"responses":{"200":{"description":"Offers","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Offers"},"example":{"asin":"B09DFCB66S","marketplace":"com","currency":"USD","fetched_at":"2026-11-03T08:00:12.441Z","charged":true,"amazon_price":79.99,"lowest_new_price":74.5,"lowest_used_price":61.2,"offers":[{"seller":"Amazon Resale","seller_id":null,"price":61.2,"amazon":false,"fulfilled_by_amazon":false,"used":true,"delivery_time":"Friday, November 6","delivery_price":"FREE"},{"seller":"Example Audio Store","seller_id":"A10IJ5BG4OYOQ1","price":74.5,"amazon":false,"fulfilled_by_amazon":true,"used":false,"delivery_time":"Friday, November 6","delivery_price":"FREE"},{"seller":"Amazon","seller_id":null,"price":79.99,"amazon":true,"fulfilled_by_amazon":false,"used":false,"delivery_time":"Thursday, November 5","delivery_price":"FREE"}]}}}},"400":{"description":"invalid_product: product is neither a 10-character ASIN nor an Amazon product link, or asin isn't a 10-character ASIN. invalid_option: A setting isn't valid: marketplace (com, co.uk, de, fr, it, es, ca, co.jp, com.br, com.mx, in), filter, interval_minutes (5, 30, 60, 360, 720, 1440), target_price, alert_on_drop or paused. Also when the body isn't a JSON object, a required argument is missing, or the product to check is paused.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"unauthorized: The API key is missing, revoked or invalid.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"402":{"description":"insufficient_credits: Reading Amazon now (POST /offers) costs 1 credit and the balance is empty. email_not_verified: The account's email isn't confirmed yet, so it has no credits to read Amazon with.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"product_not_found: Amazon has no product for this ASIN on this marketplace (POST /offers). Refunded.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"rate_limited: More than 30 searches or 600 history or offers reads in an hour, too many reads of Amazon at once, or too many different products read today: 200 a day on the free plan, 1,000 with a credit pack, then 1,000 with Starter, 3,000 with Pro, 10,000 with Business. Histories, offers and new watchlist entries count, once per product; your watchlist and the products already read today stay available. Retry later, or after midnight UTC for the daily limit.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"500":{"description":"generic: Unexpected error on our side. Retry in a moment.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"502":{"description":"amazon_unavailable: Amazon couldn't be read right now (GET /search, GET /offers). Nothing is charged; retry in a moment.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/history":{"get":{"operationId":"getAsinHistory","tags":["Amazon data"],"summary":"Price history of any ASIN","description":"Every price Asin read for an ASIN on a marketplace over the period, whoever tracks it, oldest first, with the lowest, highest and average of those prices. A history of more than 5000 points is thinned evenly, keeping its first and last point. Free, limited to 600 reads per hour: no credit is used and nothing is read from Amazon, so an ASIN nobody tracked yet has an empty history.","parameters":[{"name":"asin","in":"query","required":true,"description":"10-character ASIN","schema":{"type":"string","pattern":"^[A-Za-z0-9]{10}$","description":"10-character ASIN"},"example":"B09DFCB66S"},{"name":"marketplace","in":"query","description":"Amazon store, e.g. com for amazon.com","schema":{"type":"string","enum":["com","co.uk","de","fr","it","es","ca","co.jp","com.br","com.mx","in"],"default":"com","description":"Amazon store, e.g. com for amazon.com"},"example":"com"},{"name":"days","in":"query","description":"History period in days","schema":{"type":"integer","minimum":1,"maximum":730,"default":90,"description":"History period in days"},"example":"30"}],"responses":{"200":{"description":"History of the ASIN","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AsinHistory"},"example":{"asin":"B09DFCB66S","marketplace":"com","currency":"USD","lowest_price":74.5,"highest_price":99.99,"average_price":84.83,"history":[{"price":99.99,"in_stock":true,"coupon":null,"seller":"Amazon","checked_at":"2026-10-01T09:30:35.002Z"},{"price":74.5,"in_stock":true,"coupon":"Save 5%","seller":"Example Audio Store","checked_at":"2026-10-24T08:00:10.913Z"},{"price":79.99,"in_stock":true,"coupon":null,"seller":"Amazon","checked_at":"2026-11-03T08:00:12.441Z"}]}}}},"400":{"description":"invalid_product: product is neither a 10-character ASIN nor an Amazon product link, or asin isn't a 10-character ASIN. invalid_option: A setting isn't valid: marketplace (com, co.uk, de, fr, it, es, ca, co.jp, com.br, com.mx, in), filter, interval_minutes (5, 30, 60, 360, 720, 1440), target_price, alert_on_drop or paused. Also when the body isn't a JSON object, a required argument is missing, or the product to check is paused.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"unauthorized: The API key is missing, revoked or invalid.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"rate_limited: More than 30 searches or 600 history or offers reads in an hour, too many reads of Amazon at once, or too many different products read today: 200 a day on the free plan, 1,000 with a credit pack, then 1,000 with Starter, 3,000 with Pro, 10,000 with Business. Histories, offers and new watchlist entries count, once per product; your watchlist and the products already read today stay available. Retry later, or after midnight UTC for the daily limit.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"500":{"description":"generic: Unexpected error on our side. Retry in a moment.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/products":{"get":{"operationId":"listProducts","tags":["Watchlist"],"summary":"List tracked products","description":"Your watchlist, newest first, with each product's latest state and its recent prices (trend). Filter with asin (and marketplace) to know if a product is tracked, or with filter to get the same lists as the app's tabs.","parameters":[{"name":"asin","in":"query","description":"Only this ASIN","schema":{"type":"string","pattern":"^[A-Za-z0-9]{10}$","description":"10-character ASIN"},"example":"B09DFCB66S"},{"name":"marketplace","in":"query","description":"Only this Amazon store","schema":{"type":"string","enum":["com","co.uk","de","fr","it","es","ca","co.jp","com.br","com.mx","in"],"description":"Only this Amazon store"}},{"name":"filter","in":"query","description":"Only the products of one of the app's watchlist filters. all: Every tracked product (default). drops: Cheaper now than when the product was added. target: At or below its target price. out_of_stock: No offer at the last check. attention: The last check didn't go through (last_error is set): no credits, not found or Amazon unavailable. paused: Paused by you: not checked, not charged.","schema":{"type":"string","enum":["all","drops","target","out_of_stock","attention","paused"],"default":"all","description":"Only the products of one of the app's watchlist filters. all: Every tracked product (default). drops: Cheaper now than when the product was added. target: At or below its target price. out_of_stock: No offer at the last check. attention: The last check didn't go through (last_error is set): no credits, not found or Amazon unavailable. paused: Paused by you: not checked, not charged."}},{"name":"page","in":"query","description":"Page number","schema":{"type":"integer","minimum":1,"default":1}},{"name":"limit","in":"query","description":"Products per page","schema":{"type":"integer","minimum":1,"maximum":100,"default":20}}],"responses":{"200":{"description":"Products","content":{"application/json":{"schema":{"type":"object","required":["products","total","page"],"properties":{"products":{"type":"array","items":{"$ref":"#/components/schemas/Product"}},"total":{"type":"integer"},"page":{"type":"integer"}}},"example":{"products":[{"product_id":"8f0b3c7e-2a4d-4e51-9c1a-6d2f1b9e7a30","asin":"B09DFCB66S","marketplace":"com","url":"https://www.amazon.com/dp/B09DFCB66S","title":"Wireless Earbuds, Bluetooth 5.3, Noise Cancelling","image":"https://m.media-amazon.com/images/I/…jpg","brand":"Example Audio","currency":"USD","price":79.99,"first_price":99.99,"lowest_price":74.5,"highest_price":99.99,"in_stock":true,"stock":"In Stock","coupon":null,"seller":"Amazon","best_sellers_rank":"#152 in Electronics","target_price":70,"alert_on_drop":true,"interval_minutes":1440,"status":"active","last_error":null,"found_on":[],"checking":false,"last_checked_at":"2026-11-03T08:00:12.441Z","next_check_at":"2026-11-04T08:00:12.441Z","created_at":"2026-10-01T09:30:31.120Z","trend":[99.99,74.5,79.99]}],"total":1,"page":1}}}},"400":{"description":"invalid_product: product is neither a 10-character ASIN nor an Amazon product link, or asin isn't a 10-character ASIN. invalid_option: A setting isn't valid: marketplace (com, co.uk, de, fr, it, es, ca, co.jp, com.br, com.mx, in), filter, interval_minutes (5, 30, 60, 360, 720, 1440), target_price, alert_on_drop or paused. Also when the body isn't a JSON object, a required argument is missing, or the product to check is paused.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"unauthorized: The API key is missing, revoked or invalid.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"500":{"description":"generic: Unexpected error on our side. Retry in a moment.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}},"post":{"operationId":"trackProduct","tags":["Watchlist"],"summary":"Track a product","description":"Adds an ASIN, an Amazon link or a short link (amzn.to, a.co…) to your watchlist. The first check runs in the background within seconds (checking is true until then): poll GET /products/{id}, or send wait: true to get the answer once it's done (up to 45 seconds). Each price check of a tracked product costs 1 credit; a product checked daily uses about 30 credits a month. Without credits the product is added and its first check waits. What Amazon answers shows on the product (last_error), never as an error here. Adding a product you already track returns it unchanged, with status 200.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["product"],"properties":{"product":{"type":"string","description":"ASIN (B09DFCB66S) or Amazon product link"},"marketplace":{"type":"string","enum":["com","co.uk","de","fr","it","es","ca","co.jp","com.br","com.mx","in"],"default":"com","description":"Amazon store, e.g. com for amazon.com. A product link sets it on its own."},"target_price":{"type":["number","null"],"description":"Email the owner when the price goes at or below this amount. null removes it."},"interval_minutes":{"type":"integer","enum":[5,30,60,360,720,1440],"default":1440,"description":"Minutes between two checks (1440 = daily). Checks faster than daily need a plan or a credit pack: every 60 minutes with a pack or Starter, 30 with Pro, 5 with Business."},"wait":{"type":"boolean","default":false,"description":"Answer once the first check is done (up to 45 seconds)"}}},"example":{"product":"B09DFCB66S","marketplace":"com","target_price":70,"wait":true}}}},"responses":{"200":{"description":"Already tracked: the product as it is, unchanged","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Product"},"example":{"product_id":"8f0b3c7e-2a4d-4e51-9c1a-6d2f1b9e7a30","asin":"B09DFCB66S","marketplace":"com","url":"https://www.amazon.com/dp/B09DFCB66S","title":"Wireless Earbuds, Bluetooth 5.3, Noise Cancelling","image":"https://m.media-amazon.com/images/I/…jpg","brand":"Example Audio","currency":"USD","price":79.99,"first_price":99.99,"lowest_price":74.5,"highest_price":99.99,"in_stock":true,"stock":"In Stock","coupon":null,"seller":"Amazon","best_sellers_rank":"#152 in Electronics","target_price":70,"alert_on_drop":true,"interval_minutes":1440,"status":"active","last_error":null,"found_on":[],"checking":false,"last_checked_at":"2026-11-03T08:00:12.441Z","next_check_at":"2026-11-04T08:00:12.441Z","created_at":"2026-10-01T09:30:31.120Z"}}}},"201":{"description":"Tracked product","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Product"},"example":{"product_id":"8f0b3c7e-2a4d-4e51-9c1a-6d2f1b9e7a30","asin":"B09DFCB66S","marketplace":"com","url":"https://www.amazon.com/dp/B09DFCB66S","title":"Wireless Earbuds, Bluetooth 5.3, Noise Cancelling","image":"https://m.media-amazon.com/images/I/…jpg","brand":"Example Audio","currency":"USD","price":79.99,"first_price":99.99,"lowest_price":74.5,"highest_price":99.99,"in_stock":true,"stock":"In Stock","coupon":null,"seller":"Amazon","best_sellers_rank":"#152 in Electronics","target_price":70,"alert_on_drop":true,"interval_minutes":1440,"status":"active","last_error":null,"found_on":[],"checking":false,"last_checked_at":"2026-11-03T08:00:12.441Z","next_check_at":"2026-11-04T08:00:12.441Z","created_at":"2026-10-01T09:30:31.120Z"}}}},"400":{"description":"invalid_product: product is neither a 10-character ASIN nor an Amazon product link, or asin isn't a 10-character ASIN. unsupported_marketplace: The link is from an Amazon store that isn't supported (supported: com, co.uk, de, fr, it, es, ca, co.jp, com.br, com.mx, in). invalid_option: A setting isn't valid: marketplace (com, co.uk, de, fr, it, es, ca, co.jp, com.br, com.mx, in), filter, interval_minutes (5, 30, 60, 360, 720, 1440), target_price, alert_on_drop or paused. Also when the body isn't a JSON object, a required argument is missing, or the product to check is paused.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"unauthorized: The API key is missing, revoked or invalid.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"paid_option: Checks faster than daily need a plan or a credit pack: every 60 minutes with a pack or Starter, 30 with Pro, 5 with Business. product_limit: The account tracks as many products as its plan allows (50 on the free plan).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"},"example":{"error":{"code":"product_limit","message":"You've reached your plan's product limit. The free plan tracks up to 50 products."}}}}},"500":{"description":"generic: Unexpected error on our side. Retry in a moment.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/products/{id}":{"get":{"operationId":"getProduct","tags":["Watchlist"],"summary":"Get a product and its price history","description":"The product's latest state and every price read of the period, oldest first. The history covers every read of this ASIN on this marketplace, including those made before you added it, so a product added today can come with months of prices; created_at says when you added it. A history of more than 5000 points is thinned evenly, keeping its first and last point.","parameters":[{"name":"id","in":"path","required":true,"description":"product_id returned when the product was added","schema":{"type":"string","format":"uuid"},"example":"8f0b3c7e-2a4d-4e51-9c1a-6d2f1b9e7a30"},{"name":"days","in":"query","description":"History period in days","schema":{"type":"integer","minimum":1,"maximum":730,"default":90,"description":"History period in days"},"example":"30"}],"responses":{"200":{"description":"Product with history","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProductWithHistory"},"example":{"product_id":"8f0b3c7e-2a4d-4e51-9c1a-6d2f1b9e7a30","asin":"B09DFCB66S","marketplace":"com","url":"https://www.amazon.com/dp/B09DFCB66S","title":"Wireless Earbuds, Bluetooth 5.3, Noise Cancelling","image":"https://m.media-amazon.com/images/I/…jpg","brand":"Example Audio","currency":"USD","price":79.99,"first_price":99.99,"lowest_price":74.5,"highest_price":99.99,"in_stock":true,"stock":"In Stock","coupon":null,"seller":"Amazon","best_sellers_rank":"#152 in Electronics","target_price":70,"alert_on_drop":true,"interval_minutes":1440,"status":"active","last_error":null,"found_on":[],"checking":false,"last_checked_at":"2026-11-03T08:00:12.441Z","next_check_at":"2026-11-04T08:00:12.441Z","created_at":"2026-10-01T09:30:31.120Z","history":[{"price":99.99,"in_stock":true,"coupon":null,"seller":"Amazon","checked_at":"2026-10-01T09:30:35.002Z"},{"price":74.5,"in_stock":true,"coupon":"Save 5%","seller":"Example Audio Store","checked_at":"2026-10-24T08:00:10.913Z"},{"price":79.99,"in_stock":true,"coupon":null,"seller":"Amazon","checked_at":"2026-11-03T08:00:12.441Z"}]}}}},"401":{"description":"unauthorized: The API key is missing, revoked or invalid.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"not_found: No tracked product with this id on your account, or no such endpoint.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"500":{"description":"generic: Unexpected error on our side. Retry in a moment.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}},"patch":{"operationId":"updateProduct","tags":["Watchlist"],"summary":"Change alerts and checks","description":"Target price, drop alerts, check interval, or pause. Send only what changes.","parameters":[{"name":"id","in":"path","required":true,"description":"product_id returned when the product was added","schema":{"type":"string","format":"uuid"},"example":"8f0b3c7e-2a4d-4e51-9c1a-6d2f1b9e7a30"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"target_price":{"type":["number","null"],"description":"Email the owner when the price goes at or below this amount. null removes it."},"interval_minutes":{"type":"integer","enum":[5,30,60,360,720,1440],"default":1440,"description":"Minutes between two checks (1440 = daily). Checks faster than daily need a plan or a credit pack: every 60 minutes with a pack or Starter, 30 with Pro, 5 with Business."},"alert_on_drop":{"type":"boolean","description":"Email when the price drops or the product is back in stock"},"paused":{"type":"boolean","description":"Stop checking (and charging) for now; false resumes"}}},"example":{"target_price":65,"interval_minutes":360}}}},"responses":{"200":{"description":"Product","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Product"},"example":{"product_id":"8f0b3c7e-2a4d-4e51-9c1a-6d2f1b9e7a30","asin":"B09DFCB66S","marketplace":"com","url":"https://www.amazon.com/dp/B09DFCB66S","title":"Wireless Earbuds, Bluetooth 5.3, Noise Cancelling","image":"https://m.media-amazon.com/images/I/…jpg","brand":"Example Audio","currency":