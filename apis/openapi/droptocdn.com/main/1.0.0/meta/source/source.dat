{"openapi":"3.1.0","info":{"title":"DropToCDN API","version":"1.0.0","description":"Upload files to CDN with a single POST request. Get instant public URLs. All endpoints require an API key unless noted otherwise. Create a key in Dashboard → Settings."},"servers":[{"url":"https://api.droptocdn.com/v1"}],"security":[{"apiKeyAuth":[]}],"paths":{"/files":{"security":[{"apiKeyAuth":[]}],"post":{"summary":"Upload a file","operationId":"uploadFile","security":[{"apiKeyAuth":[]}],"description":"Requires a valid API key sent as `Authorization: Bearer dtc_...`. Create one in Dashboard → Settings. Files are linked to your account and count toward your plan quota.","requestBody":{"required":true,"content":{"multipart/form-data":{"schema":{"type":"object","required":["file"],"properties":{"file":{"type":"string","format":"binary"},"retention_days":{"type":"integer","default":7,"description":"How long to keep the file, in days. Ignored on plans without custom retention (Free). Defaults to plan retention if omitted (7 days on Free)."},"never_expire":{"type":"boolean","default":false,"description":"Set true to skip expiration. Paid plans only."}}}}}},"responses":{"201":{"description":"File uploaded","content":{"application/json":{"schema":{"$ref":"#/components/schemas/FileResponse"}}}},"400":{"description":"Invalid request or blocked file type (executables, scripts, and web pages are not allowed — use POST /pages for HTML)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"401":{"description":"Missing or invalid API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"403":{"description":"Quota exceeded or plan limit reached","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}},"get":{"summary":"List your files","operationId":"listFiles","security":[{"apiKeyAuth":[]}],"description":"Requires a valid API key sent as `Authorization: Bearer dtc_...`. Create one in Dashboard → Settings. Returns files in your account, newest first. Paginate with `cursor` (recommended) or `page` — use one, not both.","parameters":[{"name":"limit","in":"query","schema":{"type":"integer","minimum":1,"maximum":100,"default":20},"description":"Maximum number of files per page (default 20, max 100)."},{"name":"cursor","in":"query","schema":{"type":"string"},"description":"Cursor from a previous response's `next_cursor`. Default pagination mode. Do not combine with `page`."},{"name":"page","in":"query","schema":{"type":"integer","minimum":1,"default":1},"description":"1-based page number (offset mode). Jump to any page; response includes `total`. Do not combine with `cursor`."}],"responses":{"200":{"description":"Paginated file list","content":{"application/json":{"schema":{"$ref":"#/components/schemas/FileListResponse"}}}},"400":{"description":"Invalid cursor, page, or limit","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"401":{"description":"Missing or invalid API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/files/{id}":{"security":[{"apiKeyAuth":[]}],"get":{"summary":"Get file information","operationId":"getFile","security":[{"apiKeyAuth":[]}],"description":"Requires a valid API key sent as `Authorization: Bearer dtc_...`. Create one in Dashboard → Settings. Returns metadata for a file you own.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"File metadata","content":{"application/json":{"schema":{"$ref":"#/components/schemas/FileResponse"}}}},"401":{"description":"Missing or invalid API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"403":{"description":"Not your file","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"404":{"description":"File not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}},"delete":{"summary":"Delete a file","operationId":"deleteFile","security":[{"apiKeyAuth":[]}],"description":"Requires a valid API key sent as `Authorization: Bearer dtc_...`. Create one in Dashboard → Settings. Permanently deletes a file you own.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"204":{"description":"Deleted"},"401":{"description":"Missing or invalid API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"403":{"description":"Not your file","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"404":{"description":"File not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/pages":{"security":[{"apiKeyAuth":[]}],"post":{"summary":"Publish HTML as a public web page","operationId":"publishPage","security":[{"apiKeyAuth":[]}],"description":"Requires a valid API key sent as `Authorization: Bearer dtc_...`. Create one in Dashboard → Settings. Publishes HTML content as a hosted page with a CDN URL.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["html"],"properties":{"html":{"type":"string"},"retention_days":{"type":"integer","default":7,"description":"How long to keep the page, in days. Ignored on plans without custom retention (Free). Defaults to plan retention if omitted (7 days on Free)."},"never_expire":{"type":"boolean","default":false,"description":"Set true to skip expiration. Paid plans only."}}}}}},"responses":{"201":{"description":"Page published","content":{"application/json":{"schema":{"type":"object","properties":{"id":{"type":"string"},"url":{"type":"string","format":"uri"},"expires_at":{"type":"string","nullable":true}}}}}},"401":{"description":"Missing or invalid API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"403":{"description":"Quota exceeded or plan limit reached","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}}},"components":{"securitySchemes":{"apiKeyAuth":{"type":"apiKey","in":"header","name":"Authorization","description":"API key from Dashboard → Settings. Send as `Authorization: Bearer dtc_...`"}},"schemas":{"ErrorResponse":{"type":"object","description":"Returned for every 4xx and 5xx response. `error` and `message` carry the same human-readable text; branch on `code`.","required":["error","code","message","status","hint","docs"],"additionalProperties":false,"properties":{"error":{"type":"string","description":"Human-readable summary of what went wrong."},"code":{"type":"string","description":"Stable machine-readable identifier, e.g. `not_found`, `unauthorized`, `quota_exceeded`."},"message":{"type":"string","description":"Same text as `error`."},"status":{"type":"integer","description":"HTTP status code."},"hint":{"type":"string","description":"How to resolve the error."},"docs":{"type":"string","format":"uri","description":"Link to the API documentation."}}},"FileResponse":{"type":"object","properties":{"id":{"type":"string"},"url":{"type":"string","format":"uri"},"expires_at":{"type":"string","nullable":true},"size":{"type":"integer"},"mime_type":{"type":"string"},"original_name":{"type":"string"}}},"FileListResponse":{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/FileResponse"}},"has_more":{"type":"boolean"},"next_cursor":{"type":"string","nullable":true},"page":{"type":"integer","description":"Present when paginating with the `page` query param."},"limit":{"type":"integer","description":"Present when paginating with the `page` query param."},"total":{"type":"integer","description":"Total file count. Present when paginating with the `page` query param."}}}}}}