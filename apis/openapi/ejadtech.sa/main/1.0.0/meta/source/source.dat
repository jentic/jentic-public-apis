  "paths": {
    "/api/emanifest/create_vehicle_activities": {
      "post": {
        "tags": [
          "1. Master Data"
        ],
        "summary": "Create Vehicle Activities",
        "description": "Extract vehicles activities from the current system",
        "operationId": "createVehicleActivities",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer",
                      "example": 8001
                    },
                    "name": {
                      "type": "string",
                      "example": "نقل النفايات الخطرة"
                    }
                  },
                  "required": [
                    "id",
                    "name"
                  ]
                },
                "example": [
                  {
                    "id": 8001,
                    "name": "نقل النفايات الخطرة"
                  },
                  {
                    "id": 8002,
                    "name": "نقل النفايات الطبية"
                  },
                  {
                    "id": 8003,
                    "name": "نقل النفايات الصناعية"
                  },
                  {
                    "id": 8004,
                    "name": "نقل النفايات البلدية"
                  },
                  {
                    "id": 8005,
                    "name": "نقل المواد القابلة لإعادة التدوير"
                  },
                  {
                    "id": 8006,
                    "name": "نقل نفايات البناء والهدم"
                  }
                ]
              },
              "examples": {
                "Create Vehicle Activities": {
                  "value": [
                    {
                      "id": 8001,
                      "name": "نقل النفايات الخطرة"
                    },
                    {
                      "id": 8002,
                      "name": "نقل النفايات الطبية"
                    },
                    {
                      "id": 8003,
                      "name": "نقل النفايات الصناعية"
                    },
                    {
                      "id": 8004,
                      "name": "نقل النفايات البلدية"
                    },
                    {
                      "id": 8005,
                      "name": "نقل المواد القابلة لإعادة التدوير"
                    },
                    {
                      "id": 8006,
                      "name": "نقل نفايات البناء والهدم"
                    }
                  ]
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        }
      }
    },
