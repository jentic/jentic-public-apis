    "/api/emanifest/create_drivers": {
      "post": {
        "tags": [
          "3. Fleet Management"
        ],
        "summary": "Create Drivers",
        "description": "Extract drivers from current system. Note: driver_license_attachment should be base64 encoded binary data",
        "operationId": "createDrivers",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "city": {
                      "type": "string",
                      "example": "Riyadh"
                    },
                    "company_driver_id": {
                      "type": "integer",
                      "example": 1001
                    },
                    "cr_national_number": {
                      "type": "string",
                      "example": "1234567890"
                    },
                    "create_date": {
                      "type": "string",
                      "example": "2024-01-10 08:00:00"
                    },
                    "driver_license_attachment": {
                      "type": "string",
                      "example": "license_base64"
                    },
                    "driver_license_expiry_date": {
                      "type": "string",
                      "example": "2026-12-31"
                    },
                    "email": {
                      "type": "string",
                      "example": "ahmed.ali@example.com"
                    },
                    "id": {
                      "type": "integer",
                      "example": 7001
                    },
                    "mobile": {
                      "type": "string",
                      "example": "+966507771111"
                    },
                    "name": {
                      "type": "string",
                      "example": "Ahmed Ali Mohammed"
                    },
                    "write_date": {
                      "type": "string",
                      "example": "2024-01-10 08:00:00"
                    }
                  },
                  "required": [
                    "id",
                    "name",
                    "company_driver_id",
                    "cr_national_number",
                    "driver_license_expiry_date",
                    "email",
                    "mobile",
                    "create_date"
                  ]
                },
                "example": [
                  {
                    "city": "Riyadh",
                    "company_driver_id": 1001,
                    "cr_national_number": "1234567890",
                    "create_date": "2024-01-10 08:00:00",
                    "driver_license_attachment": "license_base64",
                    "driver_license_expiry_date": "2026-12-31",
                    "email": "ahmed.ali@example.com",
