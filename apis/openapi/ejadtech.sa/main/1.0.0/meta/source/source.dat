    "/api/emanifest/create_emanifest_certificates": {
      "post": {
        "tags": [
          "4. Transactional Data"
        ],
        "summary": "Create eManifest Certificates",
        "description": "Add certificate to list of manifests. finalized_certificate should be base64 encoded binary data",
        "operationId": "createEmanifestCertificates",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "file_name": {
                      "type": "string",
                      "example": "certificate_EM-2024-0001.pdf"
                    },
                    "finalized_certificate": {
                      "type": "string",
                      "example": "base64_encoded_pdf_here"
                    },
                    "manifest_id": {
                      "type": "integer",
                      "example": 17001
                    }
                  },
                  "required": [
                    "file_name",
                    "finalized_certificate",
                    "manifest_id"
                  ]
                },
                "example": [
                  {
                    "file_name": "certificate_EM-2024-0001.pdf",
                    "finalized_certificate": "base64_encoded_pdf_here",
                    "manifest_id": 17001
                  }
                ]
              },
              "examples": {
                "Create eManifest Certificates": {
                  "value": [
                    {
                      "file_name": "certificate_EM-2024-0001.pdf",
                      "finalized_certificate": "base64_encoded_pdf_here",
                      "manifest_id": 17001
                    }
                  ]
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        }
      }
    },
    "/api/emanifest/get_states": {
      "get": {
        "tags": [
          "Reference Data"
        ],
        "summary": "Get States List",
        "description": "Get list of available state names in Saudi Arabia. Use these values for state_id field in partner creation APIs",
        "operationId": "getStatesList",
        "responses": {
          "200": {
            "description": ""
          }
        }
      }
    },
    "/api/emanifest/get_process_activities": {
      "get": {
        "tags": [
          "Reference Data"
        ],
        "summary": "Get Process Activities",
        "description": "Get transport document workflow states. Values: create_document, beneficiary_request, vehicle_driver_selection, driver_handover, shipment_loading, shipment_unloading, transporter_reject, receiver_reject",
        "operationId": "getProcessActivities",
        "responses": {
          "200": {
            "description": ""
          }
        }
      }
    },
    "/api/emanifest/get_token": {
      "get": {
        "tags": [
          "Reference Data"
        ],
        "summary": "GetToken",
        "description": "GetToken",
        "operationId": "gettoken",
        "responses": {
          "200": {
            "description": ""
          }
        }
      }
    }
