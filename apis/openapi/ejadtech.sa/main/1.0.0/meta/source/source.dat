    "/api/emanifest/create_transporter_companies": {
      "post": {
        "tags": [
          "2. Partners & Entities"
        ],
        "summary": "Create Transporter Companies",
        "description": "Extract transporter companies from the current system",
        "operationId": "createTransporterCompanies",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
