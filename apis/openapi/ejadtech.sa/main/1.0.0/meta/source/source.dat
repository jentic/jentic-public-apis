    "/api/emanifest/create_waste_types": {
      "post": {
        "tags": [
          "1. Master Data"
        ],
        "summary": "Create Waste Types",
        "description": "Extract all waste types with container type relationships",
        "operationId": "createWasteTypes",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "Container_type_ids": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "example": 1
                      },
                      "example": [
                        1,
                        2
                      ]
                    },
                    "id": {
                      "type": "integer",
                      "example": 1
                    },
                    "name": {
                      "type": "string",
                      "example": "نفايات سائلة"
                    }
                  },
                  "required": [
                    "id",
                    "name",
                    "Container_type_ids"
                  ]
                },
                "example": [
                  {
                    "Container_type_ids": [
                      1,
                      2
                    ],
                    "id": 1,
                    "name": "نفايات سائلة"
                  },
                  {
                    "Container_type_ids": [
                      3,
                      4,
                      5
                    ],
                    "id": 2,
                    "name": "نفايات صلبة"
                  },
                  {
                    "Container_type_ids": [
                      6
                    ],
                    "id": 3,
                    "name": "نفايات غازية"
                  }
                ]
              },
              "examples": {
                "Create Waste Types": {
                  "value": [
                    {
                      "Container_type_ids": [
                        1,
                        2
                      ],
                      "id": 1,
                      "name": "نفايات سائلة"
                    },
                    {
                      "Container_type_ids": [
                        1,
                        2
                      ],
                      "id": 2,
                      "name": "نفايات صلبة"
                    },
                    {
                      "Container_type_ids": [
                        1
                      ],
                      "id": 3,
                      "name": "نفايات غازية"
                    }
                  ]
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        }
      }
    },
    "/api/emanifest/create_waste_classifications": {
      "post": {
        "tags": [
          "1. Master Data"
        ],
        "summary": "Create Waste Classifications Level 1",
        "description": "Extract all waste classification types with hierarchical structure",
        "operationId": "createWasteClassificationsLevel1",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "H01-01-01"
                    },
                    "create_date": {
                      "type": "string",
                      "example": "2024-01-01 08:00:00"
                    },
                    "id": {
                      "type": "integer",
                      "example": 11201
                    },
                    "level": {
                      "type": "string",
                      "enum": [
                        "first",
                        "second",
                        "third"
                      ],
                      "example": "third"
                    },
                    "name": {
                      "type": "string",
                      "example": "أحماض"
                    },
                    "parent_id": {
                      "type": "integer",
                      "example": 11101
                    },
                    "waste_status": {
                      "type": "string",
                      "example": "liquid",
                      "enum": [
                        "liquid",
                        "solid",
                        "gase"
                      ]
                    },
                    "waste_type": {
                      "type": "string",
                      "example": "hazardous",
                      "enum": [
                        "hazardous",
                        "non_hazardous"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "name",
                    "waste_type",
                    "waste_status",
                    "level",
                    "code"
                  ]
                },
                "example": [
                  {
                    "code": "H01-01-01",
                    "create_date": "2024-01-01 08:00:00",
                    "id": 11201,
                    "level": "third",
                    "name": "أحماض",
                    "parent_id": 11101,
                    "waste_status": "solid",
                    "waste_type": "hazardous"
                  },
                  {
                    "code": "H01-01-02",
                    "create_date": "2024-01-01 08:00:00",
                    "id": 11202,
                    "level": "third",
                    "name": "قواعد",
                    "parent_id": 11101,
                    "waste_status": "solid",
                    "waste_type": "hazardous"
                  },
                  {
                    "code": "H01-02-01",
                    "create_date": "2024-01-01 08:00:00",
                    "id": 11203,
                    "level": "third",
                    "name": "زيوت مستعملة",
                    "parent_id": 11102,
                    "waste_status": "solid",
                    "waste_type": "hazardous"
                  },
                  {
                    "code": "H01-02-01",
                    "create_date": "2024-01-01 08:00:00",
                    "id": 11204,
                    "level": "third",
                    "name": "زيوت مستعملة 222",
                    "parent_id": 11104,
                    "waste_status": "solid",
                    "waste_type": "hazardous"
                  }
                ]
              },
              "examples": {
                "Create Waste Classifications Level 1": {
                  "value": [
                    {
                      "code": "H01",
                      "create_date": "2024-01-01 08:00:00",
                      "id": 1,
                      "level": "first",
                      "name": "نفايات خطرة",
                      "parent_id": null,
                      "waste_status": "liquid",
                      "waste_type": "hazardous"
                    },
                    {
                      "code": "H01-01",
                      "create_date": "2024-01-01 08:00:00",
                      "id": 2,
                      "level": "first",
                      "name": "نفايات كيميائية",
                      "parent_id": null,
                      "waste_status": "liquid",
                      "waste_type": "hazardous"
                    }
                  ]
                },
                "Create Waste Classifications Level 2": {
                  "value": [
                    {
                      "code": "H01",
                      "create_date": "2024-01-01 08:00:00",
                      "id": 111,
                      "level": "second",
                      "name": "نفايات خطرة",
                      "parent_id": 1,
                      "waste_status": "liquid",
                      "waste_type": "hazardous"
                    },
                    {
                      "code": "H01-01",
                      "create_date": "2024-01-01 08:00:00",
                      "id": 2222,
                      "level": "second",
                      "name": "نفايات كيميائية",
                      "parent_id": 2,
                      "waste_status": "liquid",
                      "waste_type": "hazardous"
                    }
                  ]
                },
                "Create Waste Classifications Level 3": {
                  "value": [
                    {
                      "code": "H01-01-01",
                      "create_date": "2024-01-01 08:00:00",
                      "id": 11201,
                      "level": "third",
                      "name": "أحماض",
                      "parent_id": 111,
                      "waste_status": "solid",
                      "waste_type": "hazardous"
                    },
                    {
                      "code": "H01-01-02",
                      "create_date": "2024-01-01 08:00:00",
                      "id": 11202,
                      "level": "third",
                      "name": "قواعد",
                      "parent_id": 2222,
                      "waste_status": "solid",
                      "waste_type": "hazardous"
                    },
                    {
                      "code": "H01-02-01",
                      "create_date": "2024-01-01 08:00:00",
                      "id": 11203,
                      "level": "third",
                      "name": "زيوت مستعملة",
                      "parent_id": 2222,
                      "waste_status": "solid",
                      "waste_type": "hazardous"
                    },
                    {
                      "code": "H01-02-01",
                      "create_date": "2024-01-01 08:00:00",
                      "id": 11204,
                      "level": "third",
                      "name": "زيوت مستعملة 222",
                      "parent_id": 111,
                      "waste_status": "solid",
                      "waste_type": "hazardous"
                    }
                  ]
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        }
      }
    },
