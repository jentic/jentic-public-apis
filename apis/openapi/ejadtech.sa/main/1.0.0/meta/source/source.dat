                    "waste_material_status": {
                      "type": "string",
                      "example": "01"
                    },
                    "waste_producer": {
                      "type": "integer",
                      "example": 3001
                    },
                    "waste_types": {
                      "type": "integer",
                      "example": 12001
                    },
                    "write_date": {
                      "type": "string",
                      "example": "2024-05-01 09:00:00"
                    }
                  },
                  "required": [
                    "id",
                    "name",
                    "Classification_level1",
                    "Classification_level2",
