    "/api/emanifest/create_emanifest_requests": {
      "post": {
        "tags": [
          "4. Transactional Data"
        ],
        "summary": "Create eManifest Requests",
        "description": "Extract eManifest requests from the current system. Process activity values: create_document, beneficiary_request, vehicle_driver_selection, driver_handover, shipment_loading, shipment_unloading, transporter_reject, receiver_reject",
        "operationId": "createEmanifestRequests",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "Classification_level1": {
                      "type": "integer",
                      "example": 11001
                    },
                    "Classification_level2": {
                      "type": "integer",
                      "example": 11101
                    },
                    "Classification_level3": {
                      "type": "integer",
                      "example": 11201
                    },
                    "actual_amount": {
                      "type": "number",
                      "example": 4000
                    },
                    "actual_amount_uom_id": {
                      "type": "integer",
                      "example": 15001
                    },
                    "additional_explanation": {
                      "type": "string",
                      "example": "تنظف معالجة خاصة"
                    },
                    "container_types": {
                      "type": "integer",
                      "example": 13001
                    },
                    "create_date": {
                      "type": "string",
                      "example": "2024-05-01 09:00:00"
                    },
                    "driver_id": {
                      "type": "integer",
                      "example": 7001
                    },
                    "facility_co": {
                      "type": "integer",
                      "example": 5001
                    },
                    "id": {
                      "type": "integer",
                      "example": 17008
                    },
                    "latitude": {
                      "type": "number",
                      "example": 24.7136
                    },
                    "longitude": {
                      "type": "number",
                      "example": 46.7382
                    },
                    "name": {
                      "type": "string",
                      "example": "NH-01-08-22-0493"
                    },
                    "no_of_containers": {
                      "type": "number",
                      "example": 10
                    },
                    "partner_id": {
                      "type": "integer",
                      "example": 2003
                    },
                    "process_activity_id": {
                      "type": "string",
                      "example": "shipment_unloading",
                      "enum": [
                        "create_document",
                        "beneficiary_request",
                        "vehicle_driver_selection",
                        "driver_handover",
                        "shipment_loading",
                        "shipment_unloading",
                        "transporter_reject",
                        "receiver_reject"
                      ]
                    },
                    "project_licence_number": {
                      "type": "string",
                      "example": "PL-2024-001"
                    },
                    "request_state": {
                      "type": "string",
                      "example": "wip",
                      "enum": [
                        "wip",
                        "refuse",
                        "done"
                      ]
                    },
                    "request_waste_source": {
                      "type": "string",
                      "example": "excavation",
                      "enum": [
                        "excavation",
                        "construction"
                      ]
                    },
                    "state": {
                      "type": "string",
                      "example": "done"
                    },
                    "sub_classification": {
                      "type": "string",
                      "example": "01",
                      "enum": [
                        "01"
                      ]
                    },
                    "transport_reject_img": {
                      "type": "string",
                      "example": ""
                    },
                    "transporter_co": {
                      "type": "integer",
                      "example": 2003
                    },
                    "truck_id": {
                      "type": "integer",
                      "example": 10001
                    },
                    "wasteUOM": {
                      "type": "integer",
                      "example": 15001
                    },
                    "waste_amount": {
                      "type": "number",
                      "example": 5000
                    },
                    "waste_classification": {
                      "example": 11001,
                      "anyOf": [
                        {
                          "type": "number",
                          "example": 11001
                        },
                        {
                          "type": "string",
