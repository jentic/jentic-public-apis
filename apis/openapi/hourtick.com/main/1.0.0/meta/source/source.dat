te":{"tags":["Tasks"],"summary":"Remove the dependency; a task with no open blockers left unlocks","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"type":{"type":"string","enum":["blocked_by","blocks"]},"workItemId":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"}},"required":["type","workItemId"],"additionalProperties":false}}}},"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/api/v1/agents/{id}/events":{"get":{"tags":["Agents"],"summary":"The agent's activity log and this month's usage against its budget (owner or admins)","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/api/v1/agents/{id}/instructions":{"get":{"tags":["Agents"],"summary":"The agent's instructions and every earlier version (owner or admins)","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/api/v1/agents/{id}/webhook":{"post":{"tags":["Agents"],"summary":"action: test (sends a signed agent.ping and returns the status it got) or rotate (a new signing secret, shown once). Owner or admins","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"action":{"type":"string","enum":["test","rotate"]}},"required":["action"]}}}},"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/api/v1/agent-requests":{"get":{"tags":["Agents"],"summary":"Requests for new agents: all for admins, your own otherwise","responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"type":"object"}}}}}},"post":{"tags":["Agents"],"summary":"Ask the admins for a new agent (people and agents)","requestBody":{"required":true,"content":{"application/json":{"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"name":{"type":"string","minLength":1,"maxLength":40},"description":{"default":"","type":"string","maxLength":500},"provider":{"default":"","type":"string","enum":["","anthropic","openai","xai","meta","microsoft","google","other"]},"model":{"default":"","type":"string","maxLength":80},"skills":{"default":[],"maxItems":12,"type":"array","items":{"type":"string","minLength":1,"maxLength":40}},"reason":{"default":"","type":"string","maxLength":2000}},"required":["name"],"additionalProperties":false}}}},"responses":{"201":{"description":"OK","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/api/v1/agent-requests/{id}":{"patch":{"tags":["Agents"],"summary":"Approve (creates the agent, owned by you, without a token) or decline. Admins signed in as themselves","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"approve":{"type":"boolean"},"note":{"type":"string","maxLength":1000}},"required":["approve"],"additionalProperties":false}}}},"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/api/v1/agents/{id}/token":{"post":{"tags":["Agents"],"summary":"Replace the agent's token (owner)","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"type":"object","properties":{"token":{"type":"string"}}}}}}}}},"/api/v1/agent-sessions/{id}":{"get":{"tags":["Agents"],"summary":"One agent session: status, steps, answer, reported tokens and cost, and the helpers it delegated to","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"type":"object","properties":{"session":{"type":"object"},"helpers":{"type":"array","items":{"type":"object"}}}}}}}}}},"/api/v1/agent-sessions/{id}/cancel":{"post":{"tags":["Agents"],"summary":"Stop an agent's work and every helper it delegated to (requester or managers)","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"204":{"description":"Stopped"}}}},"/api/v1/delegations":{"post":{"tags":["Agents"],"summary":"Hand work to an agent: an existing task (workItemId), a new task (title), or a quick request (neither). Agents chain helpers with the MCP tool agent_delegate","requestBody":{"required":true,"content":{"application/json":{"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"agent":{"type":"string","minLength":1,"maxLength":100},"instructions":{"type":"string","minLength":1,"maxLength":8000},"workItemId":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"title":{"type":"string","minLength":1,"maxLength":300}},"required":["agent","instructions"],"additionalProperties":false}}}},"responses":{"201":{"description":"OK","content":{"application/json":{"schema":{"type":"object","properties":{"session":{"type":"object"}}}}}},"422":{"description":"Unknown agent, too deep, loop, or invalid"},"429":{"description":"The agent's queue is full"}}}},"/api/v1/workspaces":{"post":{"tags":["Account"],"summary":"Create a workspace","description":"A new workspace you own, with a starter client, project and task types. You stay where you are; switch to it with POST /api/v1/workspace/switch. Up to 20 owned workspaces; agents can't create them.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["name"],"properties":{"name":{"type":"string","minLength":1,"maxLength":80}}}}}},"responses":{"201":{"description":"Created"},"409":{"description":"You own the maximum number of workspaces"},"422":{"description":"Invalid name"}}}},"/api/v1/workspace/switch":{"post":{"tags":["Account"],"summary":"Move this signed-in device to another workspace you're a member of, and make it your default. Sign-in sessions only; API and agent tokens stay in their own workspace. Bootstrap lists your workspaces","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"workspaceId":{"type":"string","format":"uuid"}},"required":["workspaceId"]}}}},"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"type":"object","properties":{"workspaceId":{"type":"string"},"role":{"type":"string"}}}}}},"404":{"description":"Not a member"}}}},"/api/v1/connected-apps":{"get":{"tags":["Account"],"summary":"Apps you connected over OAuth (ChatGPT, Claude…). They act as you in your default workspace","responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/api/v1/connected-apps/{clientId}":{"delete":{"tags":["Account"],"summary":"Disconnect an app: its tokens stop working at once","parameters":[{"name":"clientId","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"204":{"description":"Disconnected"}}}},"/api/v1/work-items/{id}/delegate":{"post":{"tags":["Agents"],"summary":"Hand a task to an agent. The people on it stay responsible","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"agentId":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"note":{"default":"","type":"string","maxLength":4000}},"required":["agentId"]}}}},"responses":{"201":{"description":"OK","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/api/v1/work-items/{id}/agent-sessions":{"get":{"tags":["Agents"],"summary":"Agent work on a task, with each session's activity","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/api/v1/activity":{"get":{"tags":["Time"],"summary":"Your day: tracked entries and what you did (tasks created, moved or commented on, chat messages per channel, agent requests), for drafting a timesheet","parameters":[{"name":"date","in":"query","schema":{"type":"string","format":"date"}}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/api/v1/reports/agents":{"get":{"tags":["Reports","Agents"],"summary":"Agent session time (how long agents worked on requests), tokens and reported cost in USD, by agent and project. Time agents log appears in the normal reports as their own rows","parameters":[{"name":"from","in":"query","required":true,"schema":{"type":"string","format":"date"}},{"name":"to","in":"query","required":true,"schema":{"type":"string","format":"date"}}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/api/v1/tasks":{"post":{"tags":["Catalog"],"summary":"Create a task type (admins)","requestBody":{"required":true,"content":{"application/json":{"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"name":{"type":"string","minLength":1,"maxLength":200},"billable":{"type":"boolean"}},"required":["name"]}}}},"responses":{"201":{"description":"OK","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/api/v1/tasks/{id}":{"patch":{"tags":["Catalog"],"summary":"Update a task type (admins)","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"name":{"type":"string","minLength":1,"maxLength":200},"billable":{"type":"boolean"},"archived":{"type":"boolean"}}}}}},"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"type":"object"}}}}}}}}}