Deleted"}}}},"/api/v1/work-items/{id}/checklist":{"post":{"tags":["Tasks"],"summary":"Add a checklist item","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"title":{"type":"string","minLength":1,"maxLength":500}},"required":["title"]}}}},"responses":{"201":{"description":"OK","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/api/v1/work-items/{id}/checklist/{itemId}":{"patch":{"tags":["Tasks"],"summary":"Tick, rename or move a checklist item","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"itemId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"title":{"type":"string","minLength":1,"maxLength":500},"done":{"type":"boolean"},"position":{"type":"number"}}}}}},"responses":{"204":{"description":"Saved"}}},"delete":{"tags":["Tasks"],"summary":"Remove a checklist item","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"itemId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"204":{"description":"Deleted"}}}},"/api/v1/work-items/{id}/attachments":{"post":{"tags":["Tasks"],"summary":"Upload a file (multipart/form-data, field `file`, up to 25 MB). Link it by posting a comment with its id","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"required":true,"content":{"multipart/form-data":{"schema":{"type":"object","properties":{"file":{"type":"string","format":"binary"}},"required":["file"]}}}},"responses":{"201":{"description":"OK","content":{"application/json":{"schema":{"type":"object"}}}},"402":{"description":"This month's usage is used up; uploads pause until the 1st"},"413":{"description":"File too large"}}}},"/api/v1/attachments/{id}":{"get":{"tags":["Tasks"],"summary":"Redirects to a 5-minute signed URL. Images, PDFs, video, audio and text preview inline; everything else downloads. `?download=1` forces a download","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"302":{"description":"Signed URL"}}},"delete":{"tags":["Tasks"],"summary":"Delete a file (uploader or managers)","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"204":{"description":"Deleted"}}}},"/api/v1/task-views":{"get":{"tags":["Tasks"],"summary":"Your saved Tasks views (personal)","responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"type":"object"}}}}}},"post":{"tags":["Tasks"],"summary":"Save a view: people, agents, projects, clients and labels (any-of; `none` for unset), search and layout","requestBody":{"required":true,"content":{"application/json":{"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"name":{"type":"string","minLength":1,"maxLength":60},"filters":{"type":"object","properties":{"people":{"maxItems":100,"type":"array","items":{"type":"string","minLength":1,"maxLength":100}},"agents":{"maxItems":100,"type":"array","items":{"type":"string","minLength":1,"maxLength":100}},"projects":{"maxItems":100,"type":"array","items":{"type":"string","minLength":1,"maxLength":100}},"clients":{"maxItems":100,"type":"array","items":{"type":"string","minLength":1,"maxLength":100}},"labels":{"maxItems":50,"type":"array","items":{"type":"string","maxLength":40}},"q":{"type":"string","maxLength":200},"layout":{"type":"string","enum":["board","list"]}},"additionalProperties":false}},"required":["name","filters"]}}}},"responses":{"201":{"description":"OK","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/api/v1/task-views/{id}":{"patch":{"tags":["Tasks"],"summary":"Rename, move or update a view's filters","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"name":{"type":"string","minLength":1,"maxLength":60},"filters":{"type":"object","properties":{"people":{"maxItems":100,"type":"array","items":{"type":"string","minLength":1,"maxLength":100}},"agents":{"maxItems":100,"type":"array","items":{"type":"string","minLength":1,"maxLength":100}},"projects":{"maxItems":100,"type":"array","items":{"type":"string","minLength":1,"maxLength":100}},"clients":{"maxItems":100,"type":"array","items":{"type":"string","minLength":1,"maxLength":100}},"labels":{"maxItems":50,"type":"array","items":{"type":"string","maxLength":40}},"q":{"type":"string","maxLength":200},"layout":{"type":"string","enum":["board","list"]}},"additionalProperties":false},"position":{"type":"number"}}}}}},"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"type":"object"}}}}}},"delete":{"tags":["Tasks"],"summary":"Delete a view","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"204":{"description":"Deleted"}}}},"/api/v1/usage":{"get":{"tags":["Billing"],"summary":"Usage this month and the plan's limit, in bytes (1 GB = 10^9): stored data (database share and files) plus data in and out since the 1st","responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"type":"object","properties":{"dbBytes":{"type":"integer"},"fileBytes":{"type":"integer"},"usedBytes":{"type":"integer"},"limitBytes":{"type":"integer"},"measuredAt":{"type":["integer","null"]}}}}}}}}},"/api/v1/billing/storage":{"put":{"tags":["Billing"],"summary":"Set extra GB on Pro ($10/GB per month; admins). More is charged pro rata right away","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"extraGb":{"type":"integer","minimum":0,"maximum":1000}},"required":["extraGb"]}}}},"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"type":"object"}}}},"409":{"description":"Not on Pro"}}}},"/api/v1/chat/channels":{"get":{"tags":["Chat"],"summary":"Your channels and DMs with unread and mention counts. `?browse` adds public channels you haven't joined","responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"type":"object"}}}}}},"post":{"tags":["Chat"],"summary":"Create a channel (name is slugged; private channels need `memberIds`)","requestBody":{"required":true,"content":{"application/json":{"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"name":{"type":"string","minLength":1,"maxLength":60},"topic":{"type":"string","maxLength":250},"isPrivate":{"type":"boolean"},"memberIds":{"maxItems":500,"type":"array","items":{"type":"string","minLength":1,"maxLength":100}}},"required":["name"],"additionalProperties":false}}}},"responses":{"201":{"description":"OK","content":{"application/json":{"schema":{"type":"object"}}}},"409":{"description":"Name taken"}}}},"/api/v1/chat/channels/{id}":{"patch":{"tags":["Chat"],"summary":"Rename, set the topic or archive","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"name":{"type":"string","minLength":1,"maxLength":60},"topic":{"type":"string","maxLength":250},"archived":{"type":"boolean"}},"additionalProperties":false}}}},"responses":{"204":{"description":"Saved"}}}},"/api/v1/chat/channels/{id}/join":{"post":{"tags":["Chat"],"summary":"Join a public channel","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"204":{"description":"Joined"}}}},"/api/v1/search":{"get":{"tags":["Account"],"summary":"Search the workspace (the ⌘K palette)","description":"Tasks (by number, e.g. `#12`, or title), your own time entries (notes, project, task type), projects, clients, people and the channels you can see. A few of each, best matches first.","parameters":[{"name":"q","in":"query","required":true,"schema":{"type":"string","maxLength":100}}],"responses":{"200":{"description":"{ tasks, entries, projects, clients, people, channels }"}}}},"/api/v1/gifs":{"get":{"tags":["Chat"],"summary":"GIFs for the chat picker (Powered by GIPHY)","description":"Trending when `q` is empty, otherwise a search (rated G). Post one as a message body of `![title](url#WxH)`; only GIPHY media URLs render as images. 503 when the server has no GIPHY key.","parameters":[{"name":"q","in":"query","schema":{"type":"string","maxLength":50}},{"name":"offset","in":"query","schema":{"type":"integer","minimum":0}}],"responses":{"200":{"description":"Up to 24 GIFs: id, title, preview (+ size), url (+ width, height)"},"503":{"description":"GIFs aren't set up"}}}},"/api/v1/chat/channels/{id}/preferences":{"patch":{"tags":["Chat"],"summary":"Your preferences for a channel","description":"`muteAll: true` stops `@all` from mentioning you in this channel. Direct mentions still reach you.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["muteAll"],"properties":{"muteAll":{"type":"boolean"}}}}}},"responses":{"204":{"description":"Saved"}}}},"/api/v1/chat/channels/{id}/leave":{"post":{"tags":["Chat"],"summary":"Leave a channel","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"204":{"description":"Left"}}}},"/api/v1/chat/channels/{id}/members":{"post":{"tags":["Chat"],"summary":"Add people and agents","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"userIds":{"default":[],"maxItems":500,"type":"array","items":{"type":"string","minLength":1,"maxLength":100}},"agentIds":{"default":[],"maxItems":50,"type":"array","items":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"}}}}}}},"responses":{"204":{"description":"Added"}}}},"/api/v1/chat/channels/{id}/read":{"post":{"tags":["Chat"],"summary":"Mark the channel read","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"204":{"description":"Read"}}}},"/api/v1/chat/channels/{id}/messages":{"get":{"tags":["Chat"],"summary":"50 top-level messages, newest last, with `refs`. `?before=<messageId>` pages back; `?thread=<messageId>` returns a whole thread","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"before","in":"query","schema":{"type":"string","format":"uuid"}},{"name":"thread","in":"query","schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"type":"object"}}}}}},"post":{"tags":["Chat"],"summary":"Post a message (`parentId` replies in a thread; `attachmentIds` links uploaded files). Mentioning an agent queues a session","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","pr