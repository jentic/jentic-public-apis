cope (scopeClientIds, scopeProjectIds), readOnly, budgetUsdMonth, budgetHoursMonth, expiresAt, paused, canCreateCatalog. Owner or admin: instructions (each change is a version), webhookUrl, webhookFormat (hourtick or github_dispatch), webhookAuthorization. Agents can't change agents. Setting a new webhook returns its signing secret once","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"name":{"type":"string","minLength":1,"maxLength":40},"description":{"type":"string","maxLength":500},"disabled":{"type":"boolean"},"provider":{"type":"string","enum":["","anthropic","openai","xai","meta","microsoft","google","other"]},"model":{"type":"string","maxLength":80},"skills":{"maxItems":12,"type":"array","items":{"type":"string","minLength":1,"maxLength":40}},"access":{"type":"string","enum":["everyone","restricted"]},"allowedRoles":{"maxItems":4,"type":"array","items":{"type":"string","enum":["owner","admin","manager","member"]}},"allowedUserIds":{"maxItems":500,"type":"array","items":{"type":"string","minLength":1,"maxLength":100}},"canCreateCatalog":{"type":"boolean"},"scopeClientIds":{"maxItems":200,"type":"array","items":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"}},"scopeProjectIds":{"maxItems":500,"type":"array","items":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"}},"readOnly":{"type":"boolean"},"budgetUsdMonth":{"anyOf":[{"type":"number","minimum":0,"maximum":1000000},{"type":"null"}]},"budgetHoursMonth":{"anyOf":[{"type":"number","