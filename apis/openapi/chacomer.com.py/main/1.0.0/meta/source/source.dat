                        "type": "string",
                        "example": "773610"
                      },
                      "commerce_name": {
                        "type": "string",
                        "example": "COMAGRO SAE"
                      },
                      "branch_name": {
                        "type": "string",
                        "example": "COMAGRO SAE"
                      },
                      "created_at": {
                        "type": "string",
