{
  "openapi": "3.0.0",
  "info": {
    "title": "Admin360 API",
    "version": "1.0.0",
    "description": "API for Admin360 system, handling authentication and short-term reservation details.",
    "contact": {
      "name": "",
      "url": ""
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/hertzphilippines/Admin360/1.0.0"
  },
  "servers": [
    {
      "url": "https://staging.api.exclusivecars.ph",
      "description": "Staging environment"
    }
  ],
  "paths": {
    "/api/hertz_services/v1/admin360/shortterm/reservations/{transaction_number}": {
      "get": {
        "summary": "Get short-term reservation details",
        "description": "Retrieve reservation, driver, vehicle, and billing details",
        "operationId": "getReservationDetails",
        "parameters": [
          {
            "name": "transaction_number",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "ST20250501-1001"
            }
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Reservation details retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReservationResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized. Please contact the administrator for support."
          },
          "404": {
            "description": "Reservation not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ReservationResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "reservation_details": {
                "type": "object",
                "properties": {
                  "transaction_number": {
                    "type": "string",
                    "example": "ST20250501-1001"
                  },
                  "reservation_status": {
                    "type": "string",
                    "example": "completed"
                  },
                  "company_name": {
                    "type": "string",
                    "example": "ABC Company Ltd."
                  },
                  "booking_source": {
                    "type": "string",
                    "example": null
                  },
                  "client": {
                    "type": "string",
                    "example": "Juan Pedro"
                  },
                  "brand": {
                    "type": "string",
                    "example": "Hertz"
                  },
                  "service": {
                    "type": "string",
                    "example": "CAR HIRE"
                  },
                  "start_datetime": {
                    "type": "string",
                    "example": "2025-01-01 10:00:00"
                  },
                  "end_datetime": {
                    "type": "string",
                    "example": "2025-01-03 18:00:00"
                  },
                  "pickup": {
                    "type": "string",
                    "example": "Manila CITY"
                  },
                  "dropoff": {
                    "type": "string",
                    "example": "MAKATI CITY"
                  },
                  "routes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "location": {
                    "type": "string",
                    "example": "MNL2293"
                  },
                  "reference_number": {
                    "type": "string",
                    "example": "REF-001"
                  },
                  "purchase_order_number": {
                    "type": "string",
                    "example": "PO-001"
                  },
                  "total_amount": {
                    "type": "number",
                    "example": 0
                  },
                  "paid": {
                    "type": "boolean",
                    "example": false
                  }
                }
              },
              "driver_details": {
                "type": "object",
                "properties": {
                  "driver_name": {
                    "type": "string",
                    "example": "John Peter"
                  },
                  "contact_numbers": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "example": [
                      "09999999999"
                    ]
                  }
                }
              },
              "vehicle_details": {
                "type": "object",
                "properties": {
                  "plate_number": {
                    "type": "string",
                    "example": "NIPLATE"
                  },
                  "conduction_sticker": {
                    "type": "string",
                    "example": "SAMPLE-CS"
                  },
                  "vehicle_model": {
                    "type": "string",
                    "example": "TERRA 2.5 L 4X2 EL DSL AT"
                  },
                  "vehicle_brand": {
                    "type": "string",
                    "example": "NISSAN Manufacturer"
                  },
                  "vehicle_type": {
                    "type": "string",
                    "example": "FULLSIZE SUV"
                  },
                  "vehicle_color": {
                    "type": "string",
                    "example": "Black"
                  },
                  "vehicle_production_year": {
                    "type": "string",
                    "example": "2024"
                  }
                }
              },
              "billing_details": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "billing_status": {
                      "type": "string",
                      "example": "billed"
                    },
                    "invoice_number": {
                      "type": "string",
                      "example": "SI1234"
                    },
                    "invoice_date": {
                      "type": "string",
                      "example": "2025-01-10"
                    },
                    "rental_agreement_number": {
                      "type": "string",
                      "example": "RA001"
                    },
                    "po_number": {
                      "type": "string",
                      "example": "PO-001"
                    },
                    "series_number": {
                      "type": "string",
                      "example": "SR-001"
                    },
                    "billing_period_from": {
                      "type": "string",
                      "example": "2025-01-01"
                    },
                    "billing_period_to": {
                      "type": "string",
                      "example": "2025-01-03"
                    },
                    "discount_amount": {
                      "type": "number",
                      "example": 0
                    },
                    "total_revenue_amount": {
                      "type": "number",
                      "example": 30000
                    },
                    "charges": {
                      "type": "object",
                      "properties": {
                        "gross_rental_amount": {
                          "type": "number",
                          "example": 22000
                        },
                        "overtime_charge": {
                          "type": "number",
                          "example": 2000
                        },
                        "fuel_charge": {
                          "type": "number",
                          "example": 3000
                        },
                        "toll_charge": {
                          "type": "number",
                          "example": 0
                        },
                        "meals_charge": {
                          "type": "number",
                          "example": 0
                        },
                        "parking_charge": {
                          "type": "number",
                          "example": 0
                        },
                        "lodging_charge": {
                          "type": "number",
                          "example": 0
                        },
                        "admin_charge": {
                          "type": "number",
                          "example": 0
                        },
                        "delivery_pull_out_charge": {
                          "type": "number",
                          "example": 0
                        },
                        "load_allowance_charge": {
                          "type": "number",
                          "example": 0
                        },
                        "driver_allowance_charge": {
                          "type": "number",
                          "example": 0
                        },
                        "cdw_charge": {
                          "type": "number",
                          "example": 0
                        },
                        "super_cover_protection_charge": {
                          "type": "number",
                          "example": 0
                        },
                        "repairs_and_damages_charge": {
                          "type": "number",
                          "example": 0
                        },
                        "airport_charge": {
                          "type": "number",
                          "example": 0
                        },
                        "one_way_charge": {
                          "type": "number",
                          "example": 0
                        },
                        "marine_insurance_charge": {
                          "type": "number",
                          "example": 0
                        },
                        "out_of_hours_charge": {
                          "type": "number",
                          "example": 0
                        },
                        "carwash_cost": {
                          "type": "number",
                          "example": 0
                        },
                        "gps_navigation_charge": {
                          "type": "number",
                          "example": 0
                        },
                        "child_seat_amount": {
                          "type": "number",
                          "example": 0
                        },
                        "wifi_charge": {
                          "type": "number",
                          "example": 0
                        },
                        "upselling_charge": {
                          "type": "number",
                          "example": 0
                        },
                        "early_return_charge": {
                          "type": "number",
                          "example": 0
                        },
                        "other_charges": {
                          "type": "number",
                          "example": 0
                        }
                      }
                    },
                    "vat_details": {
                      "type": "object",
                      "properties": {
                        "vat_type": {
                          "type": "string",
                          "example": "exc_vat"
                        },
                        "vat_value": {
                          "type": "number",
                          "example": 0
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
