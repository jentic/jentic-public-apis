    "/v1/gates/suggestions": {
      "post": {
        "tags": ["Gates"],
        "summary": "Get The Architect's model + config suggestions for a gate",
        "description": "**Use when:** caller wants The Architect to analyze recent traffic for a gate and suggest model or configuration changes that would improve cost or quality\n\nRuns The Architect — Verlon's optimization agent — against a natural-language gate description and returns concrete suggestions (model, parameters, fallback chain, rationale). Caller controls the cost/latency/quality weighting via the optional `costWeight`/`latencyWeight`/`qualityWeight` fields (defaults to balanced 0.33/0.33/0.34). Optional `availableProviders` constrains the suggestion to a subset of providers.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-use-when": "caller wants The Architect to analyze recent traffic for a gate and suggest model or configuration changes that would improve cost or quality",
