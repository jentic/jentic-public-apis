    "/v1/gates/:id/provider-key": {
      "put": {
        "tags": ["Gates"],
        "summary": "Pin or unpin a gate's BYOK key",
        "description": "**Use when:** caller wants this gate to serve on a specific BYOK key instead of the provider default (or to clear that pin)\n\nPins the gate to a specific BYOK key (`providerKeyId`) or clears the pin (`null`). A pinned gate keeps serving on its key through provider-default rotations. A pin whose key is later deactivated, deleted, or belongs to a different provider than the serving model falls through to the provider default at request time — pinning never breaks a gate.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
