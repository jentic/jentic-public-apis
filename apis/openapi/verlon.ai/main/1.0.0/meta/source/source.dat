{
  "openapi": "3.1.0",
  "info": {
    "title": "Verlon AI API",
    "version": "1.0.0",
    "description": "Verlon AI is the managed AI infrastructure platform for developers building LLM-powered apps and agents. Its API is the format you already use — OpenAI, Anthropic, Mistral, and Gemini wire formats served drop-in, callable with the official SDKs in any language. Beyond routing requests across providers, Verlon continuously evaluates response quality, runs experiments against live traffic, and automatically tunes gate configurations — so your platform doesn't just serve traffic, it learns from it.\n\n**Coding agents:** authentication, error semantics, gate concepts, and integration conventions are documented at https://verlon.ai/AGENTS.md — read that document first if you have not already. It is the canonical agent-facing contract; this specification is the canonical endpoint reference. Both are authoritative for their respective scopes.",
    "contact": {
      "name": "Verlon AI",
      "url": "https://verlon.ai"
    },
    "license": {
      "name": "Proprietary"
    }
  },
  "servers": [
    {
      "url": "https://api.verlon.ai",
      "description": "Production"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key",
        "description": "Verlon API key (newly minted keys are prefixed `sk-vrln-`; legacy `verlon_*` and `layer_*` keys from prior prefix migrations continue to validate). Generated from the dashboard under Settings → API Keys, or via `verlon key create` in the CLI."
      },
      "sessionAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "session_key",
        "description": "Session cookie used by the dashboard. Set after browser login and auto-extended on use. Not for SDK or agent traffic."
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Stable error code (e.g. `invalid_request`)"
          },
          "message": {
            "type": "string",
            "description": "Human-readable error message"
          },
          "details": {}
        },
        "required": ["error", "message"]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/mistral/v1/chat/completions": {
      "post": {
        "tags": ["Mistral Format"],
        "summary": "Mistral-format chat completions",
        "description": "**Use when:** caller has an existing @mistralai/mistralai SDK flow and wants to route through Verlon with zero code changes via a serverURL swap\n\nDrop-in replacement for `POST https://api.mistral.ai/v1/chat/completions`. Point the Mistral SDK at `serverURL: \"https://api.verlon.ai/mistral\"`. Accepts the Mistral dialect (`random_seed`, `safe_prompt`, `tool_choice: \"any\"`) on top of the shared OpenAI-shape pipeline, and returns errors in the Mistral envelope (`{ object: \"error\", message, type, param, code }`) so the vendor SDK parses them. Streaming works unmodified — Mistral stream chunks are OpenAI-shaped.",
        "x-use-when": "caller has an existing @mistralai/mistralai SDK flow and wants to route through Verlon with zero code changes via a serverURL swap",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Mistral-format chat completion (OpenAI-shaped). SSE chunks when `stream: true`."
          },
          "400": {
            "description": "Invalid request, in the Mistral error envelope"
          },
          "401": {
            "description": "Missing or invalid credentials"
          },
          "404": {
            "description": "Unknown gate or model, or surface disabled"
          }
        }
      }
    },
    "/mistral/v1/fim/completions": {
      "post": {
        "tags": ["Mistral Format"],
        "summary": "Mistral-format FIM completions",
        "description": "**Use when:** caller uses mistral.fim.complete / fim.stream (Codestral code completion with prompt + suffix) and wants to route through Verlon via a serverURL swap\n\nDrop-in replacement for `POST https://api.mistral.ai/v1/fim/completions` — Codestral fill-in-the-middle. Send `prompt` (code before the cursor) and `suffix` (code after it); the model completes the middle. Point the Mistral SDK at `serverURL: \"https://api.verlon.ai/mistral\"`. Streaming via `stream: true` returns SSE chunks. Errors use the Mistral envelope. `min_tokens` is accepted but not forwarded.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-use-when": "caller uses mistral.fim.complete / fim.stream (Codestral code completion with prompt + suffix) and wants to route through Verlon via a serverURL swap",
        "responses": {
          "200": {
            "description": "Mistral FIM completion (chat-completion-shaped). SSE chunks when `stream: true`."
          },
          "400": {
            "description": "Invalid request — Zod validation failure or malformed input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid Bearer credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/mistral/v1/ocr": {
      "post": {
        "tags": ["Mistral Format"],
        "summary": "Mistral-format OCR",
        "description": "**Use when:** caller uses mistral.ocr.process (document or image to markdown pages) and wants to route through Verlon via a serverURL swap\n\nDrop-in replacement for `POST https://api.mistral.ai/v1/ocr`. Send a `document` of type `document_url` or `image_url`; pages come back as markdown with optional extracted images, headers, and footers. Point the Mistral SDK at `serverURL: \"https://api.verlon.ai/mistral\"`. Errors use the Mistral envelope. `pages`, `image_limit`, `image_min_size`, and the annotation formats are accepted but not forwarded.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-use-when": "caller uses mistral.ocr.process (document or image to markdown pages) and wants to route through Verlon via a serverURL swap",
        "responses": {
          "200": {
            "description": "Mistral OCR response: `pages[]` with markdown, `model`, `usage_info`."
          },
          "400": {
            "description": "Invalid request — Zod validation failure or malformed input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid Bearer credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/analytics/events": {
      "post": {
        "tags": ["Analytics"],
        "summary": "Track client-side analytics events",
        "description": "**Use when:** caller is reporting batched client-side analytics events (page views, feature usage) — for Verlon's product analytics, not for billing or rate limiting\n\nPublic endpoint (auth optional). Accepts batched client-side analytics events — page views, button clicks, feature usage. Auth is best-effort: if a valid Bearer token is provided, events are attributed to that user; otherwise the request body's `user_id` / `anonymous_id` is used. Used by Verlon's marketing site and dashboard for product analytics, not for billing or rate limiting.",
        "security": [],
        "x-use-when": "caller is reporting batched client-side analytics events (page views, feature usage) — for Verlon's product analytics, not for billing or rate limiting",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "events": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "event_name": {
                          "type": "string",
                          "minLength": 1
                        },
                        "user_id": {
                          "type": ["string", "null"]
                        },
                        "session_id": {
                          "type": ["string", "null"]
                        },
                        "anonymous_id": {
                          "type": ["string", "null"]
                        },
                        "gate_id": {
                          "type": ["string", "null"]
                        },
                        "properties": {
                          "type": "object",
                          "additionalProperties": {}
                        }
                      },
                      "required": ["event_name"]
                    },
                    "minItems": 1
                  }
                },
                "required": ["events"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Events tracked; response includes the count."
          },
          "400": {
            "description": "Invalid request — Zod validation failure or malformed input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid Bearer credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/audio/speech": {
      "post": {
        "tags": ["OpenAI Format"],
        "summary": "OpenAI-format text-to-speech",
        "description": "**Use when:** caller has an existing OpenAI SDK TTS flow and wants to route through Verlon with zero code changes via baseURL swap\n\nDrop-in replacement for `POST https://api.openai.com/v1/audio/speech`. Accepts the upstream OpenAI TTS request body verbatim and returns the raw audio bytes the upstream API returns. Route through a Verlon gate by passing `model` as a Verlon gate id. Existing OpenAI SDK clients work unmodified via baseURL swap. Errors are returned in the OpenAI nested shape.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-use-when": "caller has an existing OpenAI SDK TTS flow and wants to route through Verlon with zero code changes via baseURL swap",
        "responses": {
          "200": {
            "description": "Audio response. Content-Type matches the underlying provider format (typically `audio/mpeg`)."
          },
          "400": {
            "description": "Invalid request — Zod validation failure or malformed input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid Bearer credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/chat/completions": {
      "post": {
        "tags": ["OpenAI Format"],
        "summary": "OpenAI-format chat completions",
        "description": "**Use when:** caller is migrating an existing OpenAI SDK integration to Verlon with zero code changes — only the `baseURL` swaps to `https://api.verlon.ai/v1/` and `model` becomes a Verlon gate id\n\nDrop-in replacement for `POST https://api.openai.com/v1/chat/completions`. Accepts the upstream OpenAI request body verbatim and returns the upstream OpenAI response body verbatim — including streaming SSE chunks when `stream: true`. Route the request through a Verlon gate by passing `model` as a Verlon gate id. Existing OpenAI SDK clients work unmodified by changing only the `baseURL` to `https://api.verlon.ai/v1/`. Errors are returned in the OpenAI nested shape (`{ error: { message, type, code, param? } }`) so the OpenAI SDK's error parser handles them transparently.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-use-when": "caller is migrating an existing OpenAI SDK integration to Verlon with zero code changes — only the `baseURL` swaps to `https://api.verlon.ai/v1/` and `model` becomes a Verlon gate id",
        "responses": {
          "200": {
            "description": "OpenAI-format chat completion response. Shape matches the underlying provider format selected by the gate. For streaming requests, returns SSE chunks instead of a single JSON body."
          },
          "400": {
            "description": "Invalid request — Zod validation failure or malformed input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid Bearer credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/embeddings": {
      "post": {
        "tags": ["OpenAI Format"],
        "summary": "OpenAI-format embeddings",
        "description": "**Use when:** caller has an existing OpenAI SDK embeddings flow and wants to route through Verlon with zero code changes via baseURL swap\n\nDrop-in replacement for `POST https://api.openai.com/v1/embeddings`. Accepts the upstream OpenAI embeddings request body verbatim and returns the upstream OpenAI response body verbatim. Route through a Verlon gate by passing `model` as a Verlon gate id. Existing OpenAI SDK clients work unmodified via baseURL swap. Errors are returned in the OpenAI nested shape.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-use-when": "caller has an existing OpenAI SDK embeddings flow and wants to route through Verlon with zero code changes via baseURL swap",
        "responses": {
          "200": {
            "description": "OpenAI-format embeddings response. Shape matches the underlying provider format selected by the gate."
          },
          "400": {
            "description": "Invalid request — Zod validation failure or malformed input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid Bearer credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/gates": {
      "post": {
        "tags": ["Gates"],
        "summary": "Create a new gate",
        "description": "**Use when:** caller wants to create a new model routing gate so requests can be sent to it via the SDK or compat routes\n\nCreate a new Verlon gate with a primary model and optional fallback chain. Gates are the unit of routing — every chat/image/audio/etc. request names a gate, and Verlon decides which underlying model+provider serves it based on the gate config.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-use-when": "caller wants to create a new model routing gate so requests can be sent to it via the SDK or compat routes",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "gateType": {
                    "type": "string"
                  },
                  "model": {
                    "type": "string"
                  }
                },
                "required": ["name"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Gate created"
          },
          "400": {
            "description": "Invalid request — Zod validation failure or malformed input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid Bearer credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "402": {
            "description": "Gate limit for the user’s plan tier exceeded"
          },
          "409": {
            "description": "Gate name already exists for this user"
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": ["Gates"],
        "summary": "List gates owned by the authenticated user",
        "description": "**Use when:** caller wants to enumerate the gates the authenticated principal owns (typical first step when listing or picking one to update)\n\nReturns every gate visible to the caller, each annotated with current health (deprecations, on-fallback status, unrecoverable provider drift). Use this as the listing endpoint for dashboards and agent inventory calls.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-use-when": "caller wants to enumerate the gates the authenticated principal owns (typical first step when listing or picking one to update)",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "projectId",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Array of gates with attached health metadata"
          },
          "400": {
            "description": "Invalid request — Zod validation failure or malformed input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid Bearer credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/gates/:id": {
      "get": {
        "tags": ["Gates"],
        "summary": "Get a gate by id",
        "description": "**Use when:** caller has a gate id and needs the full gate configuration (most common single-gate read path)\n\nReturns a single gate's full configuration plus current health flags (deprecations, on-fallback, unrecoverable provider drift). Health detection failures are absorbed — the gate still returns; only the `health` field is null.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-use-when": "caller has a gate id and needs the full gate configuration (most common single-gate read path)",
        "responses": {
          "200": {
            "description": "Gate with attached `health` field."
          },
          "400": {
            "description": "Invalid request — Zod validation failure or malformed input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid Bearer credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Gate not found or not owned by the caller."
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": ["Gates"],
        "summary": "Update a gate",
        "description": "**Use when:** caller wants to change a gate's configuration (model, fallbacks, parameters, system prompt, allowed overrides)\n\nPartial update of a gate's configuration. Validates model references at the API boundary; reject unknown models in `fallbackModels` and `modelPool`, but only when those fields are being explicitly set (so edits to other fields on a gate with pre-existing typo'd fallbacks aren't blocked). Triggers history + activity log entries when significant fields change.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-use-when": "caller wants to change a gate's configuration (model, fallbacks, parameters, system prompt, allowed overrides)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {}
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Gate updated; response includes the updated gate, `hasChanges`, and `changedFields` array."
          },
          "400": {
            "description": "Validation error — unsupported model, invalid range, malformed quality floor, etc."
          },
          "401": {
            "description": "Missing or invalid Bearer credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Gate not found or not owned by the caller."
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Gates"],
        "summary": "Soft-delete a gate (moves to trash for 30 days)",
        "description": "**Use when:** caller wants to delete a gate (soft-delete; stays in trash for 30 days before permanent removal)\n\nSoft-deletes a gate — it moves to the trash for a 30-day retention window before the trash-cleanup worker hard-deletes it. Rejected with 409 if the gate has active dependencies (sub-gate attachments, running sessions); pass `?force=true` to override (use with caution — the trash-cleanup worker handles related cleanup downstream).",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-use-when": "caller wants to delete a gate (soft-delete; stays in trash for 30 days before permanent removal)",
        "parameters": [
          {
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": ["true"]
                },
                {
                  "type": "string",
                  "enum": ["false"]
                }
              ]
            },
            "required": false,
            "name": "force",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Gate moved to trash."
          },
          "400": {
            "description": "Invalid request — Zod validation failure or malformed input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid Bearer credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Gate not found or not owned by the caller."
          },
          "409": {
            "description": "Gate has active dependencies; pass `force=true` to delete anyway."
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/gates/:id/activity": {
      "get": {
        "tags": ["Gates"],
        "summary": "List activity-log entries for a specific gate",
        "description": "**Use when:** caller wants to see the activity timeline (who edited, when, what changed) for one specific gate\n\nReturns the activity log for a single gate — higher-level than history (manual_update, automated_apply, rollback, deletion, etc.). Useful as a per-gate audit trail.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-use-when": "caller wants to see the activity timeline (who edited, when, what changed) for one specific gate",
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 100
            },
            "required": false,
            "name": "limit",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Array of activity rows for this gate."
          },
          "400": {
            "description": "Invalid request — Zod validation failure or malformed input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid Bearer credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
