          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "costWeight": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      }
                    ]
                  },
                  "latencyWeight": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      }
                    ]
                  },
                  "qualityWeight": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      }
                    ]
                  },
                  "availableProviders": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "enableDescriptionEnhancement": {
                    "type": "boolean"
                  },
                  "taskType": {
                    "type": "string"
                  }
                },
                "required": ["description"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Architect suggestion bundle: recommended config + rationale + alternatives."
          },
          "400": {
            "description": "Invalid request — Zod validation failure or malformed input",
            "content": {
