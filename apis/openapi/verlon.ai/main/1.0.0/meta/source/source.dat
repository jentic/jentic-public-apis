    "/v1beta/models/{model}:countTokens": {
      "post": {
        "tags": ["Google Format"],
        "summary": "Gemini-format token counting",
        "description": "**Use when:** caller uses the Gemini SDK countTokens flow against the Verlon drop-in endpoint\n\nDrop-in replacement for `POST .../v1beta/models/{model}:countTokens`. Returns an estimated `totalTokens`. The count is an estimate: gates route to arbitrary providers whose tokenizers differ, so exact provider token counts are only known at completion time.",
        "x-use-when": "caller uses the Gemini SDK countTokens flow against the Verlon drop-in endpoint",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "model",
            "in": "path",
            "required": true,
            "description": "The model to generate with — a Gemini model id (`gemini-2.5-pro`), a Verlon gate id, or `<gate-id>/<task>` to pin a task on an agent gate.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Estimated token count: `{ totalTokens: number }`."
          },
          "400": {
            "description": "Invalid request — malformed or missing fields"
          },
          "401": {
            "description": "Missing or invalid credentials"
          },
          "404": {
            "description": "Unknown gate, model, or unsupported method"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/v1beta/models/{model}:generateContent": {
      "post": {
        "tags": ["Google Format"],
        "summary": "Gemini-format content generation",
        "description": "**Use when:** caller has an existing Google Gemini SDK generateContent flow and wants to route through Verlon with zero code changes via a baseUrl swap\n\nDrop-in replacement for `POST https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent`. Accepts the upstream Gemini request body verbatim and returns the upstream Gemini response body verbatim. Authenticate with `x-goog-api-key` (or `?key=`) carrying a Verlon API key. Errors are returned in the Google envelope (`{ error: { code, message, status } }`) so the `@google/genai` error parser handles them transparently.",
        "x-use-when": "caller has an existing Google Gemini SDK generateContent flow and wants to route through Verlon with zero code changes via a baseUrl swap",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "model",
            "in": "path",
            "required": true,
            "description": "The model to generate with — a Gemini model id (`gemini-2.5-pro`), a Verlon gate id, or `<gate-id>/<task>` to pin a task on an agent gate.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Gemini-format `GenerateContentResponse`. Shape matches the underlying provider format selected by the gate."
          },
          "400": {
            "description": "Invalid request — malformed or missing fields"
          },
          "401": {
            "description": "Missing or invalid credentials"
          },
          "404": {
            "description": "Unknown gate, model, or unsupported method"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
