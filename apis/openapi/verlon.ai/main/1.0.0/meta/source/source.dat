              "schema": {
                "type": "object",
                "properties": {
                  "messages": {
                    "type": "array",
                    "items": {},
                    "minItems": 1
                  },
                  "gateId": {
                    "type": "string"
                  },
                  "gate": {},
                  "quickTest": {
                    "type": "boolean"
                  }
                },
                "required": ["messages"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Per-model test results (primary + optional fallback array)."
          },
          "400": {
