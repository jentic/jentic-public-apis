    "/v1/gates/:id/default": {
      "post": {
        "tags": ["Gates"],
        "summary": "Make this gate its connector's default for new connections",
        "description": "**Use when:** caller wants `verlon connect` (and other connector setup flows) to resolve to this gate when no gate is named — the interactive picker pre-highlights it and non-interactive connects use it outright\n\nMarks this gate as the user's default for its connector (e.g. claude-code). At most one default exists per connector; setting a new one atomically unsets the previous. Rejected for `connector: 'sdk'` gates — nothing connects to an sdk gate, so a default is meaningless there.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-use-when": "caller wants `verlon connect` (and other connector setup flows) to resolve to this gate when no gate is named — the interactive picker pre-highlights it and non-interactive connects use it outright",
        "responses": {
          "200": {
            "description": "The updated gate, `isConnectDefault: true`."
          },
          "400": {
            "description": "Gate is an sdk gate — not a connector surface."
          },
          "401": {
            "description": "Missing or invalid Bearer credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Gate not found or not owned by the caller."
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Gates"],
        "summary": "Stop this gate being its connector's default",
        "description": "**Use when:** caller wants new connections to go back to asking (or creating) instead of resolving to this gate\n\nClears the default mark from this gate. Idempotent — clearing a gate that is not the default succeeds with `changed: false`.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-use-when": "caller wants new connections to go back to asking (or creating) instead of resolving to this gate",
        "responses": {
          "200": {
            "description": "`{ changed }` — whether a default was cleared."
          },
          "400": {
            "description": "Invalid request — Zod validation failure or malformed input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid Bearer credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Gate not found or not owned by the caller."
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
