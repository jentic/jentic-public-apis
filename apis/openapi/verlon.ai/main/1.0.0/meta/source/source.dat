    "/v3/traces": {
      "get": {
        "tags": ["Traces"],
        "summary": "List agent traces",
        "description": "**Use when:** caller wants to browse recorded agent runs (traces), optionally filtered to one agent gate, a status, or a session label\n\nPaginated list of traces — one row per bounded agent run. A trace groups every span of the run (LLM generations, tool executions, nested sub-agents). Filter by `gateId`, `status` (`active`, `completed`, `incomplete`, `error`), or `sessionLabel` (the caller-supplied conversation id).",
        "security": [
          {
            "bearerAuth": []
          }
        ],
