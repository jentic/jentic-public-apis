          },
          "lastModifiedDateUTC": {
            "type": "string",
            "format": "date-time",
            "description": "The tracked link�s most recent modification date and time in UTC."
          }
        }
      },
      "SMSCampaignGetTrackedLinksResponse": {
        "type": "object",
        "properties": {
          "campaignId": {
            "type": "integer",
            "description": "The id of the SMS campaign for which tracked link information was requested.",
            "example": 12345
          },
          "trackedLinks": {
            "type": "array",
