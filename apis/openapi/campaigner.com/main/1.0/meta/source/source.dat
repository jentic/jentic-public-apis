                "schema": {
                  "$ref": "#/components/schemas/ApiErrorRateLimitExceeded"
                }
              }
            }
          },
          "500": {
            "description": "Internal error while processing the request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/email/v1/campaign/{id}/recipients": {
      "put": {
        "operationId": "emailv1campaignidrecipients_put",
        "tags": [
          "email"
        ],
        "summary": "Set recipients to Email campaign",
        "description": "This API call allows you to assign mailing list(s) and/or dynamic segments as recipients to an existing  email campaign from your Campaigner account. You can also assign exclusion lists or suppression lists using this API call.\n",
        "security": [
          {
            "IntegrationKey": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The id of the Email campaign that you want to set the recipient to.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "$ref": "#/components/parameters/XAccountId"
          }
        ],
        "x-codeSamples": [
          {
            "lang": "curl",
            "source": "curl -X PUT \\\n  https://api.campaigner.com/email/v1/campaign/12345/recipients \\\n  -H 'Content-Type: application/json' \\\n  -H 'IntegrationKey: YOUR_API_KEY_HERE' \\\n  -H 'X-Account-Id: 123456' \\\n  -d '{\n       \"sendToAllContacts\": false,\n       \"listIds\": [\n         12345,\n         23456\n       ],\n       \"exclusionListIds\":[\n         75674,\n         89844\n       ],\n       \"suppressionListIds\":[\n         31314,\n         63463\n       ]\n     }'"
          }
        ],
        "requestBody": {
          "description": "Email campaign set recipients request body format.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailCampaignSetRecipientsModel"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "If setting recipients to Email campaign is successful it returns No Content\n"
          },
          "400": {
            "description": "Invalid request due to several potential reasons:\n- If the API request with email campaign status is invalid\n- If the API request does not specify either sendToAllContacts or listIds\n- If the API request has sendToAllContacts set to true and also provides listIds\n- If the API request specifies invalid list id(s)\n- If the API request specifies the same mailing list or dynamic segment id multiple times as a recipient in the listIds node\n- If the API request specifies the same mailing list or dynamic segment id in both the listIds node and the exclusionListIds node\n- If the API request specifies invalid exclusion list id(s)\n- If the API request specifies the same mailing list or dynamic segment id multiple times as an exclusion list\n- If the API request specifies invalid suppression list id(s)\n- If the API request specifies the same suppression list id multiple times as a suppression list\n",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                },
                "examples": {
                  "Campaign invalid status": {
                    "value": {
                      "response_code": 126,
                      "response_message": "Email Campaign is in scheduled and cannot be updated",
                      "response_details": "Cannot set recipients for email campaign."
                    }
                  },
                  "Missing Parameter": {
                    "value": {
                      "response_code": 107,
                      "response_message": "Invalid request. You need to specify sendToAllContacts or listIds",
                      "response_details": "Email campaign has no recipients to set"
                    }
                  },
                  "Parameter is inappropriate": {
                    "value": {
                      "response_code": 50,
                      "response_message": "listIds is inappropriate.",
                      "response_details": "You cannot specify listIds when sendToAllContacts is set to true"
                    }
                  },
                  "Recipient's List id is invalid": {
                    "value": {
                      "response_code": 109,
                      "response_message": "Invalid id: 24343",
                      "response_details": "No mailing list or dynamic segment with that id on the account"
                    }
                  },
                  "Recipient's List ids specified multiple times": {
                    "value": {
                      "response_code": 119,
                      "response_message": "Cannot execute requested operation. Please refer to response_details for more information.",
                      "response_details": "'You cannot specify same list id: 43434 as a recipient and as an exclusion list for this email campaign'            "
                    }
                  },
                  "Property Name Repeats within the Single Parent Object": {
                    "value": {
                      "response_code": 113,
                      "response_message": "You cannot repeat: sendToAllContacts in the API request",
                      "response_details": ""
                    }
                  },
                  "Request is empty": {
                    "value": {
                      "response_code": 120,
                      "response_message": "Invalid request. There is nothing to update.",
                      "response_details": ""
                    }
                  },
                  "Parameter name is invalid in the request": {
                    "value": {
                      "response_code": 121,
                      "response_message": "Invalid parameter: isTest",
                      "response_details": ""
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "If Integration Key supplied for the API call with any Campaigner account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError_InvalidIntegrationKey"
                }
              }
            }
          },
          "403": {
            "description": "Unauthorized due to several potential reasons:\n- Account is inactive\n- Integration key is invalid or inactive\n- Account does not have a feature enabled\n- Subaccount is inactive or is not under the master account with integration key\n",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError_FeatureDisabled"
                }
              }
            }
          },
          "404": {
            "description": "If the email campaign does not exist for the associated account",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError_ContactNotInAccountError"
                },
                "examples": {
                  "Campaign id is invalid": {
                    "value": {
                      "response_code": 109,
                      "response_message": "Invalid id: 12345",
                      "response_details": "Email Campaign Id: 12345 does not exist on the account"
                    }
                  },
                  "Campaign cannot be set with recipients": {
                    "value": {
                      "response_code": 109,
                      "response_message": "Invalid id: 123456",
                      "response_details": "Email Campaign Id: 123456 does not exist on the account or cannot have recipients set"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Too many requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorRateLimitExceeded"
                }
              }
            }
          },
          "500": {
            "description": "Internal error while processing the request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/email/v1/campaign/{id}/schedule": {
      "post": {
        "operationId": "emailv1campaignidschedule_post",
        "tags": [
          "email"
        ],
        "summary": "Schedule email campaign with required values",
        "security": [
          {
            "IntegrationKey": []
          }
        ],
        "description": "Schedule an existing Email campaign in the specified account.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The id of the email campaign that you want to specify a schedule for.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "$ref": "#/components/parameters/XAccountId"
          }
        ],
        "requestBody": {
          "description": "Json object for specifying which email campaign properties to schedule the campaign.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScheduleEmailCampaignRequest"
              }
            }
          }
        },
        "x-codeSamples": [
          {
            "lang": "curl",
            "source": "curl -X POST \\\n  https://api.campaigner.com/email/v1/campaign/9876543/schedule \\\n  -H 'Content-Type: application/json' \\\n  -H 'IntegrationKey: YOUR_API_KEY_HERE' \\\n  -H 'X-Account-Id: 123456' \\\n  -d '{    \n\t\t\"recurringSchedulingOptions\" : \n\t\t{\n\t\t\t\"repeatEvery\" : {\n\t\t\t\t\"number\" : 1,\n\t\t\t\t\"frequency\" : \"Weeks\",\n\t\t\t\t\"weeklyRepeatOn\" : [\n\t\t\t\t\t\"Monday\",\n\t\t\t\t\t\"Friday\"\n\t\t\t\t],\n\t\t\t},\t\t\t\n\t\t    \"stopSendingOptions\" : {\n\t\t      \"endOnUTC\" : \"2019-12-31T10:00\",\n\t\t    }        \n\t\t}\n  }'"
          }
        ],
        "responses": {
          "204": {
            "description": "If Email campaign schedule is successful it returns No Content\n"
          },
          "400": {
            "description": "Invalid request due to several potential reasons:\n- If the email campaign ID in the API request is invalid\n- If the email campaign status in the API request is invalid\n- If the API request does not include a sending schedule for the email campaign\n- If the API request does not clearly indicate whether the email campaign should be scheduled for one-time or recurring sending\n- If the API request does not include a sending schedule for a one-time email campaign send\n- If the API request specifies both an immediate send and a future send for a one-time campaign\n- If the sendOnUTC value for a one-time email campaign send in the API request is invalid\n- If the sendOnUTC value for a one-time email campaign send in the API request is not in the correct date format\n- If the sendOnUTC value for a one-time email campaign send in the API request is a non-existing date/time\n- If recurringSchedulingOptions is set, repeatEvery is required\n- If recurringSchedulingOptions.repeatEvery is set, frequency is required and must be one of: Days, Weeks, Months, or Years (case-insensitive)\n- If recurringSchedulingOptions is set, startSendingOn is required for the recurring schedule\n- If the startSendingOn value for a recurring schedule in the API request is invalid\n- If the startSendingOn value for a recurring schedule in the API request is not in the correct date format\n- If the startSendingOn value for a recurring schedule in the API request is not a valid date\n- If recurringSchedulingOptions is set, sendAtUTC is required for the recurring schedule\n- If the sendAtUTC value for a recurring schedule in the API request is invalid\n- If the sendAtUTC value for a recurring schedule in the API request is not in the correct time format (HH:MM)\n- If the sendAtUTC value for a recurring schedule in the API request is not a valid time\n- If the API request specifies both endOnUTC and afterNumberOfOccurrences, only one may be provided to indicate when to stop sending for a recurring schedule\n- If the endOnUTC value for a recurring schedule in the API request is in the past\n- If the endOnUTC value for a recurring schedule in the API request is not in the correct date format\n- If the endOnUTC value for a recurring schedule in the API request is the same as or earlier than the startSendingOn value\n- If the endOnUTC value for a recurring schedule in the API request is invalid\n- If the account associated with the API request is flagged as abusive\n- If the email campaign HTML or text content contains invalid merge fields\n- If the email campaign HTML or text content contains invalid characters\n",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                },
                "examples": {
                  "Campaign has no message content set": {
                    "value": {
                      "response_code": 126,
                      "response_message": "Email Campaign is in create status and cannot be updated",
                      "response_details": "Cannot set schedule for email campaign as campaign has no message content set."
                    }
                  },
                  "Campaign invalid status": {
                    "value": {
                      "response_code": 126,
                      "response_message": "Email Campaign is in create status and cannot be updated",
                      "response_details": "Cannot set schedule for email campaign as campaign has no recipients set."
                    }
                  },
                  "Parameter is inappropriate": {
                    "value": {
                      "response_code": 50,
                      "response_message": "OneTimeSchedulingOptions is inappropriate.",
                      "response_details": "Email campaign cannot be set for both: one time sending and recurring sending. Please set only one of: oneTimeSchedulingOptions or recurringSchedulingOptions"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "If Integration Key supplied for the API call with any Campaigner account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError_InvalidIntegrationKey"
                }
              }
            }
          },
          "403": {
            "description": "Unauthorized due to several potential reasons:\n- Account is inactive\n- Integration key is invalid or inactive\n- Account does not have a feature enabled\n- Subaccount is inactive or is not under the master account with integration key\n",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError_FeatureDisabled"
                }
              }
            }
          },
          "404": {
            "description": "If the contact does not exist for the associated account",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError_ContactNotInAccountError"
                },
                "examples": {
                  "Campaign does not exist": {
                    "value": {
                      "response_code": 109,
                      "response_message": "Invalid id: 12345",
                      "response_details": "'Email Campaign Id: 12345 does not exist on the account'"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Too many requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorRateLimitExceeded"
                }
              }
            }
          },
          "500": {
            "description": "Internal error while processing the request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      },
