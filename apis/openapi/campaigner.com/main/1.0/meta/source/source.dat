      "EmailCampaignSetRecipientsModel": {
        "type": "object",
        "properties": {
          "sendToAllContacts": {
            "type": "boolean",
            "nullable": true,
            "description": "Set this to true to send the email campaign to all eligible contacts in the account. You can either include this node or the listIds node, but not both.\n",
            "default": false
          },
          "listIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "nullable": true
            },
            "description": "The list of mailing list ids and/or dynamic segment ids that you want to send the email campaign to.  You can either include this node or the sendToAllContacts node, but not both.\n",
            "example": [
              12345,
              23456
            ]
          },
          "exclusionListIds": {
            "type": "array",
            "nullable": true,
            "items": {
              "type": "integer"
            },
            "description": "The list of mailing list ids and/or dynamic segment ids that you want to use as exclusion lists for the email campaign.  Any contacts included in the lists you specify here and that are also included in the recipient lists you specify in the  listIds parameter will not be sent a copy of the email campaign.\n",
            "example": [
              75674,
              89844
            ]
          },
          "suppressionListIds": {
            "type": "array",
            "nullable": true,
            "items": {
              "type": "integer"
            },
            "description": "The list of suppression list ids that you want to use as exclusion lists for the email campaign. Contacts in suppression lists will not be sent a copy of the email campaign.\n",
            "example": [
              31314,
              63463
            ]
          }
        }
      },
      "RepeatEverySchedulingOptionsForEmail": {
        "description": "Object containing all recurrence frequency details.",
        "type": "object",
        "nullable": false,
        "properties": {
          "number": {
            "type": "integer",
            "nullable": true,
            "description": "In conjunction with the frequency parameter, specifies how frequently the campaign should be sent."
          },
          "frequency": {
            "type": "string",
            "nullable": true,
            "description": "In conjunction with the number parameter, specifies how frequently the campaign should be sent."
          }
        },
        "additionalProperties": false,
        "example": {
          "number": 1,
          "frequency": "Weeks"
        }
      },
      "RecurringSchedulingOptionsForEmail": {
        "description": "Object containing all details to set a recurring sending schedule.",
        "type": "object",
        "nullable": true,
        "properties": {
          "repeatEvery": {
            "$ref": "#/components/schemas/RepeatEverySchedulingOptionsForEmail"
          },
          "startSendingOn": {
            "type": "string",
            "nullable": true,
            "description": "Start the specified recurrence on this date. Please note that the campaign's first send date/time may not be on the exact date specified here; the campaign will begin sending as of this date, but according to the recurring  schedule details you specified. If this parameter is omitted from the request, the current date will be used by default.\n",
            "example": "2027-11-25"
          },
          "sendAtUTC": {
            "type": "string",
            "nullable": true,
            "description": "Send the campaign at this UTC time (24 hour clock). Each time the campaign is sent, it will be sent at the time you specify here. If this parameter is omitted from the request, the current time will be used by default.\n",
            "example": "14:00"
          },
          "stopSendingOptions": {
            "$ref": "#/components/schemas/StopSendingOptions"
          }
        },
        "additionalProperties": false
      },
      "ScheduleEmailCampaignRequest": {
        "type": "object",
        "properties": {
          "oneTimeSchedulingOptions": {
            "$ref": "#/components/schemas/OneTimeSchedulingOptions"
          },
          "recurringSchedulingOptions": {
            "$ref": "#/components/schemas/RecurringSchedulingOptionsForEmail"
          }
        },
        "additionalProperties": false
      },
      "EmailCampaignSendsResponse": {
        "type": "object",
        "description": "An object that contains information about an individual send.",
        "properties": {
          "id": {
            "description": "The send's id.",
            "type": "integer",
            "format": "int32"
          },
          "status": {
            "description": "The send's status.",
            "type": "string",
            "nullable": false,
            "enum": [
              "Sent",
              "Failed"
            ]
          },
          "sentDateUTC": {
            "description": "The date/time, in UTC, when the send occurred.",
            "type": "string",
            "format": "date-time"
          },
          "totalEmailsSent": {
            "description": "The total number of emails sent thus far.",
            "type": "int32",
            "nullable": false
          },
          "totalEmailsDelivered": {
            "description": "The total number of emails that have been successfully delivered (i.e. that have not bounced) thus far.",
            "type": "int32",
            "nullable": false
          },
          "totalHardBounced": {
            "description": "The total number of emails that have thus far hard bounced.",
            "type": "int32",
            "nullable": false,
            "example": 1796
          },
          "totalSoftBounced": {
            "description": "The total number of emails that have thus far soft bounced.",
            "type": "int32",
            "nullable": false,
            "example": 1796
          },
          "totalOpens": {
            "description": "The total number of non-unique opens that have been recorded thus far.",
            "type": "int32",
            "nullable": false
          },
          "totalClicks": {
            "description": "The total number of non-unique link clicks that have been recorded thus far.",
            "type": "int32",
            "nullable": false
          },
          "totalConversions": {
            "description": "The total number of non-unique conversions that have been recorded thus far.",
            "type": "int32",
            "nullable": false
          },
          "totalReplies": {
            "description": "The total number of non-unique replies that have been recorded thus far.",
            "type": "int32",
            "nullable": false
          },
          "totalUnsubscribes": {
            "description": "The total number of non-unique unsubscribes that have been recorded thus far.",
            "type": "int32",
            "nullable": false
          },
          "totalComplaints": {
            "description": "The total number of non-unique complaints that have been recorded thus far.",
            "type": "int32",
            "nullable": false
          },
          "totalSubscribes": {
            "description": "The total number of subscribes that have been recorded thus far.",
            "type": "int32",
            "nullable": false
          }
        },
        "additionalProperties": false
      },
      "EmailCampaignGetSendsResponse": {
        "type": "object",
        "properties": {
          "pageSize": {
            "type": "integer",
            "description": "The requested page size.",
            "example": 10
          },
          "pageNumber": {
            "type": "integer",
            "description": "The current page number for which data is being returned.",
            "example": 1
          },
          "totalPages": {
            "type": "integer",
            "description": "The total number of pages it will take to download information about all of the sends based on the specified page size.",
            "example": 24
          },
          "totalRecords": {
            "type": "integer",
            "description": "The total number of sends for which data will be downloaded.",
            "example": 237
          },
          "campaignSends": {
            "type": "array",
            "description": "Array of objects that each contain information about an individual send.",
            "items": [
              {
                "$ref": "#/components/schemas/EmailCampaignSendsResponse"
              }
            ]
          }
        },
        "additionalProperties": false,
