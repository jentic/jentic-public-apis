      "SmsCampaignGetAllResponse": {
        "type": "object",
        "description": "An object that contains information about an individual SMS campaign.",
        "properties": {
          "id": {
            "description": "The SMS campaign's id.",
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "description": "The SMS campaign's name.",
            "type": "string",
            "nullable": false
          },
          "status": {
            "description": "The SMS campaign's current status.",
            "type": "string",
            "nullable": false,
            "enum": [
              "Draft",
              "Incomplete",
              "Scheduled",
              "Sending",
              "Sent",
              "Scheduled Recurring",
              "Partially Sent",
              "Scheduled Workflow",
              "Reserved"
            ]
          },
          "createdDateUTC": {
            "description": "The date/time in UTC that the SMS campaign was created.",
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "lastModifiedDateUTC": {
            "description": "The date/time in UTC that the SMS campaign was last updated.",
            "type": "date-time",
            "nullable": false
          },
          "sendFrom": {
            "description": "Returns the Sender Name or the Sender Id that the SMS campaign is set to come from.",
            "type": "string",
            "nullable": false
          },
          "includeUnsubscribeMessage": {
            "description": "Returns true if the SMS campaign is set to automatically include an unsubscribe message in the SMS message content.",
            "type": "boolean",
            "example": true
          },
          "trackAllLinkClicks": {
            "description": "Returns true if link clicks for this SMS campaign are tracked.",
            "type": "boolean",
            "example": false
          },
          "shortenURLs": {
            "description": "Returns true if URLs included in the SMS message content are set to be automatically shortened. Please note that all URLs are automatically shortened when the trackAllLinkClicks is set to true.",
            "type": "boolean",
            "example": false
          },
          "isWorkflowCampaign": {
            "description": "Returns true if the SMS campaign is set to be used as part of a workflow, otherwise returns false.",
            "type": "boolean",
            "example": true
          }
        },
        "additionalProperties": false
      },
      "GetAllSMSCampaignResponse": {
        "type": "object",
        "properties": {
          "pageSize": {
            "type": "integer",
            "description": "The requested page size.",
            "example": 10
          },
          "pageNumber": {
            "type": "integer",
            "description": "The current page number for which data is being returned.",
            "example": 1
          },
          "totalPages": {
            "type": "integer",
            "description": "The total number of pages it will take to download information about all of the  SMS campaigns based on the specified page size.",
            "example": 24
          },
          "totalRecords": {
            "type": "integer",
            "description": "The total number of SMS campaigns for which data will be downloaded.",
            "example": 237
          },
          "smsCampaigns": {
            "type": "array",
            "description": "Array of objects that each contain information about an individual SMS campaign.",
            "items": [
              {
                "$ref": "#/components/schemas/SmsCampaignGetAllResponse"
              }
            ]
          }
        },
        "additionalProperties": false,
        "example": {
          "pageSize": 2,
          "pageNumber": 1,
          "totalRecords": 28,
          "totalPages": 14,
          "smsCampaigns": [
            {
              "id": 456999796,
              "name": "Erica Davis Scholarship (DEVO)",
              "status": "Sent",
              "createdDateUTC": "2018-05-30T16:16:01",
              "lastModifiedDateUTC": "2019-06-19T16:31:21",
              "sendFrom": "Hays Travel",
              "includeUnsubscribeMessage": true,
              "trackAllLinkClicks": true,
              "shortenURLs": true,
              "isWorkflowCampaign": false
            },
            {
              "id": 75686585,
              "name": "Welcome Email",
              "status": "Reserved",
              "createdDateUTC": "2018-05-30T16:16:01",
              "lastModifiedDateUTC": "2019-06-12T16:31:21",
              "sendFrom": "Hays Travel",
              "includeUnsubscribeMessage": true,
              "trackAllLinkClicks": true,
              "shortenURLs": true,
              "isWorkflowCampaign": true
            }
          ]
        }
      },
