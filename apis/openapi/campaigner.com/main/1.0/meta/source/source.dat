    "/sms/v1/campaign/{id}/sends": {
      "get": {
        "operationId": "smsv1campaignidsends_get",
        "tags": [
          "sms"
        ],
        "summary": "Get Sends for specific SMS campaign",
        "security": [
          {
            "IntegrationKey": []
          }
        ],
        "description": "Download basic information and statistics for the individual sends of a particular SMS campaign in the  specified account, with the option to filter the sends by a specific time frame.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The id of the Sms camapign whose information sneds detail being retrieved.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "sentOnOrBeforeUTC",
            "in": "query",
            "description": "Return information for all sends that occurred on or before this UTC date. Date supplied must be formatted as follows: YYYY-MM-DD",
            "schema": {
              "type": "string"
            },
            "example": "2023-03-23"
          },
          {
            "name": "sentOnOrAfterUTC",
            "in": "query",
            "description": "Return information for all sends that occurred on or after this UTC date. Date supplied must be formatted as follows: YYYY-MM-DD",
            "schema": {
              "type": "string"
            },
            "example": "2023-08-09"
          },
          {
            "name": "pageSize",
            "in": "query",
            "description": "Return number of item per page.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 10,
              "maximum": 1000
            }
          },
          {
            "name": "pageNumber",
            "in": "query",
            "description": "Return data for specific page number.",
            "schema": {
              "type": "integer",
              "default": 1,
              "format": "int32"
            }
          }
        ],
        "x-codeSamples": [
          {
            "lang": "curl",
            "source": "curl -X GET \\\n  'https://api.campaigner.com/sms/v1/campaign/220145/sends?sentOnOrBeforeUTC=2023-03-23&sentOnOrAfterUTC=2023-03-26&pageNumber=2&pageSize=5' \\\n  -H 'IntegrationKey: YOUR_API_KEY_HERE' \\\n  -H 'X-Account-Id: 123456'"
          }
        ],
        "responses": {
          "200": {
            "description": "If SMS campaign Get Sends is successful it returns OK\n",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetSendsSMSCampaignResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request due to several potential reasons:\n- sentOnOrBeforeUTC set to a date that is not in correct date format\n- sentOnOrBeforeUTC set to a non-existing date/time\n- sentOnOrBeforeUTC set to a value which is in the future\n- sentOnOrAfterUTC set to a date that is not in correct date format\n- sentOnOrAfterUTC set to a non-existing date/time\n- sentOnOrAfterUTC set to a value which is in the future\n",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                },
                "examples": {
                  "sentOnOrBeforeUTC set invalid date format": {
                    "value": {
                      "response_code": 111,
                      "response_message": "Invalid value: 01-01-1934.",
                      "response_details": "'sentOnOrBeforeUTC value should be a UTC value specified in format: YYYY-MM-DD'"
                    }
                  },
                  "sentOnOrBeforeUTC set non-existing date": {
                    "value": {
                      "response_code": 111,
                      "response_message": "Invalid value: 1934-09-31.",
                      "response_details": "'sentOnOrBeforeUTC value is not a valid datetime value'"
                    }
                  },
                  "sentOnOrBeforeUTC set in future date": {
                    "value": {
                      "response_code": 111,
                      "response_message": "Invalid value: 2026-09-25.",
                      "response_details": "'sentOnOrBeforeUTC value is a future date'"
                    }
                  },
                  "sentOnOrAfterUTC set invalid date format": {
                    "value": {
                      "response_code": 111,
                      "response_message": "Invalid value: 01-01-1934.",
                      "response_details": "'sentOnOrAfterUTC value should be a UTC value specified in format: YYYY-MM-DD'"
                    }
                  },
                  "sentOnOrAfterUTC set non-existing date": {
                    "value": {
                      "response_code": 111,
                      "response_message": "Invalid value: 1934-09-31.",
                      "response_details": "'sentOnOrAfterUTC value is not a valid datetime value'"
                    }
                  },
                  "sentOnOrAfterUTC set in future date": {
                    "value": {
                      "response_code": 111,
                      "response_message": "Invalid value: 2026-09-25.",
                      "response_details": "'sentOnOrAfterUTC value is a future date'"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "If Integration Key supplied for the API call with any Campaigner account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError_InvalidIntegrationKey"
                }
              }
            }
          },
          "403": {
            "description": "Unauthorized due to several potential reasons:\n- Account is inactive\n- Integration key is invalid or inactive\n- Account does not have a feature enabled\n- Subaccount is inactive or is not under the master account with integration key\n",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError_FeatureDisabled"
                }
              }
            }
          },
          "404": {
            "description": "If Campaign Id value specified in the API request is invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                },
                "examples": {
                  "Campaign Id specified is invalid": {
                    "value": {
                      "response_code": 109,
                      "response_message": "Invalid id: 220145.",
                      "response_details": "'SMS Campaign Id: 220145 does not exist on the account.'"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Too many requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorRateLimitExceeded"
                }
              }
            }
          },
          "500": {
            "description": "Internal error while processing the request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse_SmsCampaign"
                },
                "example": {
                  "response_code": 119,
                  "response_message": "Cannot execute requested operation. Please refer to response_details for more information.",
                  "response_details": "Internal Error. Please retry."
                }
              }
            }
          }
        }
      }
