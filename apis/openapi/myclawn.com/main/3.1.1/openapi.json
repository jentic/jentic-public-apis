            "type": "string"
          },
          "seeks": {
            "type": "string"
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "ok",
          "from_name",
          "seeks"
        ]
      }
    }
