  "webhooks": {
    "paymentLinkPaid": {
      "post": {
        "summary": "payment_link.paid",
        "description": "Sent when a payment link receives its funds on-chain. Verify the X-PW-Signature header.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Event"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Return 2xx within 5s to acknowledge."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "pk_live_ / pk_test_",
        "description": "Pass your secret API key as a bearer token. Write operations are additionally HMAC-signed via X-PW-Signature."
      }
    },
    "parameters": {
      "PathId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 25
        }
      },
      "StartingAfter": {
        "name": "starting_after",
        "in": "query",
        "schema": {
          "type": "string"
        },
        "description": "A resource id; returns the page after it."
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "schema": {
          "type": "string"
        },
        "description": "A unique key to make this write safely retryable for 24 hours."
      }
    },
    "responses": {
      "Error": {
        "description": "Error response.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Amount": {
        "type": "string",
        "description": "A decimal amount as a string, e.g. \"250.00\".",
        "example": "250.00"
      },
      "List": {
        "type": "object",
        "properties": {
          "object": {
            "type": "string",
            "const": "list"
          },
          "has_more": {
            "type": "boolean"
          },
          "data": {
            "type": "array",
            "items": {}
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "param": {
                "type": "string"
              },
              "request_id": {
                "type": "string"
              }
            }
          }
        }
      },
      "PaymentLinkCreate": {
        "type": "object",
        "required": [
          "amount",
          "asset"
        ],
        "properties": {
          "amount": {
            "$ref": "#/components/schemas/Amount"
          },
          "asset": {
            "type": "string",
            "enum": [
              "USDT",
              "USDC"
            ]
          },
          "reference": {
            "type": "string",
            "maxLength": 128
          },
          "expires_in": {
            "type": "integer",
            "default": 3600
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "PaymentLink": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "object": {
            "type": "string",
            "const": "payment_link"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "paid",
              "expired",
              "cancelled"
            ]
          },
          "amount": {
            "$ref": "#/components/schemas/Amount"
          },
          "asset": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "address": {
            "type": "string"
          },
          "reference": {
            "type": "string"
          },
          "tx_hash": {
            "type": "string"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "paid_at": {
            "type": "string",
            "format": "date-time"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Account": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "object": {
            "type": "string",
            "const": "account"
          },
          "currency": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "pending",
              "review"
            ]
          },
          "holder_name": {
            "type": "string"
          },
          "account_number": {
            "type": "string"
          },
          "routing_number": {
            "type": "string"
          },
          "bank_address": {
            "type": "string"
          },
          "balance": {
            "$ref": "#/components/schemas/Amount"
          }
        }
      },
      "ConvertQuoteCreate": {
        "type": "object",
        "required": [
          "from_asset",
          "to_asset",
          "from_amount"
        ],
        "properties": {
          "from_asset": {
            "type": "string"
          },
          "to_asset": {
            "type": "string"
          },
          "from_amount": {
            "$ref": "#/components/schemas/Amount"
          }
        }
      },
      "ConvertQuote": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "object": {
            "type": "string",
            "const": "quote"
          },
          "from_asset": {
            "type": "string"
          },
          "to_asset": {
            "type": "string"
          },
          "from_amount": {
            "$ref": "#/components/schemas/Amount"
          },
          "to_amount": {
            "$ref": "#/components/schemas/Amount"
          },
          "rate": {
            "type": "string"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ConversionCreate": {
        "type": "object",
        "properties": {
          "from_asset": {
            "type": "string"
          },
          "to_asset": {
            "type": "string"
          },
          "from_amount": {
            "$ref": "#/components/schemas/Amount"
          },
          "quote_id": {
            "type": "string"
          }
        }
      },
      "Conversion": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "object": {
            "type": "string",
            "const": "conversion"
          },
          "status": {
            "type": "string",
            "enum": [
              "filled",
              "pending",
              "failed"
            ]
          },
          "from_asset": {
            "type": "string"
          },
          "to_asset": {
            "type": "string"
          },
          "from_amount": {
            "$ref": "#/components/schemas/Amount"
          },
          "to_amount": {
            "$ref": "#/components/schemas/Amount"
          },
          "rate": {
            "type": "string"
          },
          "fee": {
            "$ref": "#/components/schemas/Amount"
          }
        }
      },
      "BuyQuoteCreate": {
        "type": "object",
        "required": [
          "fiat",
          "asset",
          "fiat_amount"
        ],
        "properties": {
          "fiat": {
            "type": "string"
          },
          "asset": {
            "type": "string"
          },
          "fiat_amount": {
            "$ref": "#/components/schemas/Amount"
          }
        }
      },
      "BuyQuote": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "object": {
            "type": "string",
            "const": "buy_quote"
          },
          "fiat_amount": {
            "$ref": "#/components/schemas/Amount"
          },
          "asset_amount": {
            "$ref": "#/components/schemas/Amount"
          },
          "rate": {
            "type": "string"
          },
          "fee": {
            "$ref": "#/components/schemas/Amount"
          }
        }
      },
      "BuyOrderCreate": {
        "type": "object",
        "required": [
          "fiat",
          "asset",
          "fiat_amount"
        ],
        "properties": {
          "fiat": {
            "type": "string"
          },
          "asset": {
            "type": "string"
          },
          "fiat_amount": {
            "$ref": "#/components/schemas/Amount"
          },
          "quote_id": {
            "type": "string"
          }
        }
      },
      "BuyOrder": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "object": {
            "type": "string",
            "const": "buy_order"
          },
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "pending",
              "failed"
            ]
          },
          "fiat": {
            "type": "string"
          },
          "fiat_amount": {
            "$ref": "#/components/schemas/Amount"
          },
          "asset": {
            "type": "string"
          },
          "asset_amount": {
            "$ref": "#/components/schemas/Amount"
          },
          "rate": {
            "type": "string"
          },
          "fee": {
            "$ref": "#/components/schemas/Amount"
          }
        }
      },
      "Balance": {
        "type": "object",
        "properties": {
          "asset": {
            "type": "string"
          },
          "available": {
            "$ref": "#/components/schemas/Amount"
          },
          "on_hold": {
            "$ref": "#/components/schemas/Amount"
          }
        }
      },
      "Transaction": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "object": {
            "type": "string",
            "const": "transaction"
          },
          "type": {
            "type": "string",
            "enum": [
              "deposit",
              "payout",
              "conversion",
              "payment"
            ]
          },
          "asset": {
            "type": "string"
          },
          "amount": {
            "$ref": "#/components/schemas/Amount"
          },
          "status": {
            "type": "string"
