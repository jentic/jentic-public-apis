{
  "openapi": "3.1.0",
  "info": {
    "title": "PinkWallet API",
    "version": "2026-07-11",
    "summary": "Payments, multi-currency accounts, and conversion over a clean REST API.",
    "description": "Programmatic access to the same rails that power the PinkWallet app. All amounts are decimal strings; all timestamps are ISO-8601 in UTC. Responses are normalised by the PinkWallet Orchestration Layer and never expose an underlying banking or liquidity provider.",
    "contact": {
      "name": "PinkWallet Developer Support",
      "url": "https://api.pinkwallet.com"
    },
    "x-jentic-source-url": "https://api.pinkwallet.com/openapi.json"
  },
  "servers": [
    {
      "url": "https://api.pinkwallet.com/v1",
      "description": "Production"
    },
    {
      "url": "https://api.pinkwallet.com/sandbox/v1",
      "description": "Sandbox (pk_test_ keys)"
    }
  ],
  "paths": {
    "/payment_links": {
      "post": {
        "tags": [
          "Payment Links"
        ],
        "operationId": "createPaymentLink",
        "summary": "Create a payment link",
        "description": "Generate a shareable link that collects a USDT or USDC payment on-chain.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaymentLinkCreate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The created payment link.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentLink"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "get": {
        "tags": [
          "Payment Links"
        ],
        "operationId": "listPaymentLinks",
        "summary": "List payment links",
        "parameters": [
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/StartingAfter"
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "pending",
                "paid",
                "expired",
                "cancelled"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A paginated list of payment links.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/List"
                    },
                    {
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/PaymentLink"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/payment_links/{id}": {
      "get": {
        "tags": [
          "Payment Links"
        ],
        "operationId": "retrievePaymentLink",
        "summary": "Retrieve a payment link",
        "parameters": [
          {
            "$ref": "#/components/parameters/PathId"
          }
        ],
        "responses": {
          "200": {
            "description": "The payment link.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentLink"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/payment_links/{id}/cancel": {
      "post": {
        "tags": [
          "Payment Links"
        ],
        "operationId": "cancelPaymentLink",
        "summary": "Cancel a payment link",
        "parameters": [
          {
            "$ref": "#/components/parameters/PathId"
          }
        ],
        "responses": {
          "200": {
            "description": "The cancelled payment link.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentLink"
                }
              }
            }
          },
          "402": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/accounts": {
      "get": {
        "tags": [
          "Bank Accounts"
