      "LoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "이메일",
            "default": "test1@aible.co.kr"
          },
          "password": {
            "type": "string",
            "description": "비밀번호",
            "default": "aible123!@#"
          }
        }
      },
      "ApiResponseLoginResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
