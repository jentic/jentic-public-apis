      "ProductResponse": {
        "type": "object",
        "properties": {
          "idx": {
            "type": "integer",
            "description": "상품 IDX",
            "format": "int64"
          },
          "productCode": {
            "type": "string",
            "description": "상품 코드",
            "example": "HSL04R"
          },
          "productName": {
            "type": "string",
            "description": "상품명"
          },
          "productImagePath": {
            "type": "string",
            "description": "상품 이미지 경로 (S3 Key)"
          },
          "imageUrl": {
            "type": "string",
            "description": "상품 이미지 URL (Presigned URL, 15분 유효)"
          },
          "productDetail": {
            "type": "string",
            "description": "상품 상세 설명"
          },
          "taxType": {
            "type": "string",
            "description": "과세 구분",
            "enum": [
              "TAX",
              "FREE",
              "ZERO"
            ]
          },
          "taxTypeDescription": {
            "type": "string",
            "description": "과세 구분 설명"
          },
          "taxRate": {
            "type": "number",
            "description": "세율 (%)"
          },
          "supplyPrice": {
            "type": "integer",
            "description": "공급가액 (원)",
            "format": "int32"
          },
          "vatPrice": {
            "type": "integer",
            "description": "부가세 (원)",
            "format": "int32"
          },
          "totalPrice": {
            "type": "integer",
            "description": "합계금액 (원)",
            "format": "int32"
          },
          "saleYn": {
            "type": "boolean",
            "description": "판매 여부"
          },
          "displayOrder": {
            "type": "integer",
            "description": "노출 순서",
            "format": "int32"
          },
          "creDttm": {
            "type": "string",
            "description": "생성 일시",
            "format": "date-time"
          },
          "updDttm": {
            "type": "string",
            "description": "수정 일시",
            "format": "date-time"
          }
        },
        "description": "상품 응답"
      },
      "ApiResponseProductResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
