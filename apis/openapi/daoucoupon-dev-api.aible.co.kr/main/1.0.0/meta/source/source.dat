{
  "openapi": "3.0.1",
  "info": {
    "title": "Aible Core API",
    "description": "치매 진단 시스템 API 문서",
    "contact": {
      "name": "Aible Development Team",
      "url": "https://aible.co.kr",
      "email": "dev@aible.co.kr"
    },
    "license": {
      "name": "Private License",
      "url": "https://aible.co.kr/license"
    },
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/YSMH100/aible-core-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://daoucoupon-dev-api.aible.co.kr",
      "description": "서버"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "hmac-test",
      "description": "HMAC 서명 검증 테스트"
    },
    {
      "name": "records",
      "description": "레코드(녹음 파일) 관리 API"
    },
    {
      "name": "auth",
      "description": "인증 관련 API"
    },
    {
      "name": "product",
      "description": "상품 조회 API"
    },
    {
      "name": "coupons",
      "description": "쿠폰 관리 API (사용자)"
    },
    {
      "name": "user",
      "description": "사용자 관련 API"
    },
    {
      "name": "subjects",
      "description": "진단 대상자 관리 API"
    },
    {
      "name": "diagnoses",
      "description": "진단 관리 API"
    }
  ],
  "paths": {
    "/api/v1/subjects": {
      "post": {
        "tags": [
          "subjects"
        ],
        "summary": "진단 대상자 생성",
        "description": "새로운 진단 대상자를 생성합니다",
        "operationId": "createSubject",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubjectCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseSubjectResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/records": {
      "post": {
        "tags": [
          "records"
        ],
        "summary": "레코드 생성",
        "description": "S3에 업로드된 레코드를 등록합니다. 반드시 /upload-url API로 S3에 업로드한 후 받은 s3Key를 전달해야 합니다. 워크플로우: 1) /upload-url로 URL 받기 → 2) S3에 업로드 → 3) 이 API로 레코드 등록",
        "operationId": "createRecord",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecordCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseRecordResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/records/upload-url": {
      "post": {
        "tags": [
          "records"
        ],
        "summary": "레코드 업로드 URL 생성",
        "description": "클라이언트가 S3에 직접 업로드할 수 있는 Presigned PUT URL을 생성합니다. 진단 생성 후에 레코드를 업로드할 수 있습니다. 생성된 uploadUrl로 PUT 요청하여 파일을 업로드한 후, s3Key를 사용하여 레코드를 생성하세요.",
        "operationId": "getRecordUploadUrl",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecordUploadUrlRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseRecordUploadUrlResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/hmac-test/echo": {
      "post": {
        "tags": [
          "hmac-test"
        ],
        "summary": "HMAC 검증 테스트 (POST)",
        "description": "HMAC 서명 검증이 필요한 POST 테스트 엔드포인트입니다. Request Body도 서명에 포함됩니다.",
        "operationId": "echoPost",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": {
                  "type": "object"
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseMapStringObject"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/diagnoses": {
      "post": {
        "tags": [
          "diagnoses"
        ],
        "summary": "진단 생성",
        "description": "새로운 진단을 생성합니다 (기본 상태: PENDING, taskSet 자동 조회)",
        "operationId": "createDiagnosis",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DiagnosisCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseDiagnosisResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/diagnoses/{diagnosisIdx}/analyze": {
      "post": {
        "tags": [
          "diagnoses"
        ],
        "summary": "AI 분석 완료",
        "description": "녹음 완료 후 AI 분석을 수행하고 결과를 업데이트합니다",
        "operationId": "completeAndAnalyze",
        "parameters": [
          {
            "name": "diagnosisIdx",
            "in": "path",
            "description": "진단 ID",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseDiagnosisResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/coupons/{couponIdx}/reserve": {
      "post": {
        "tags": [
          "coupons"
        ],
        "summary": "쿠폰 예약",
        "description": "진단 시작 시 쿠폰을 예약합니다. VERIFIED → RESERVED",
        "operationId": "reserveCoupon",
        "parameters": [
          {
            "name": "couponIdx",
            "in": "path",
            "description": "쿠폰 IDX",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReserveCouponRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseCouponResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/coupons/{couponIdx}/release": {
      "post": {
        "tags": [
          "coupons"
        ],
        "summary": "쿠폰 예약 해제",
        "description": "진단 취소 시 쿠폰 예약을 해제합니다. RESERVED → VERIFIED. RESERVED 상태의 coupon_usage에서 diagnosisIdx를 자동으로 조회합니다.",
        "operationId": "releaseCoupon",
        "parameters": [
          {
            "name": "couponIdx",
            "in": "path",
            "description": "쿠폰 IDX",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseCouponResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/coupons/search": {
      "post": {
        "tags": [
          "coupons"
        ],
        "summary": "쿠폰 조회 (다우 API)",
        "description": "쿠폰번호로 다우 API를 통해 쿠폰 정보를 조회합니다. 등록 전 검증용입니다.",
        "operationId": "searchCoupon",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CouponSearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseCouponDaouSearchResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/coupons/register": {
      "post": {
        "tags": [
          "coupons"
        ],
        "summary": "쿠폰 등록",
        "description": "쿠폰번호를 검증 후 내 쿠폰으로 등록합니다.",
        "operationId": "registerCoupon",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CouponRegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseCouponResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/coupons/cancel": {
      "post": {
        "tags": [
          "coupons"
        ],
        "summary": "쿠폰 취소",
        "description": "사용된 쿠폰을 취소 처리합니다. 다우 API를 호출합니다. USED → VERIFIED. couponIdx로 USED 상태인 사용 이력 중 가장 최근 것을 조회하여 취소합니다.",
        "operationId": "cancelCoupon",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserCouponCancelRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseCouponResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/coupons/approve": {
      "post": {
        "tags": [
          "coupons"
        ],
        "summary": "쿠폰 승인 (사용)",
        "description": "진단 완료 시 쿠폰을 사용 처리합니다. 다우 API를 호출합니다. RESERVED → USED. couponIdx로 RESERVED 상태인 사용 이력을 조회하여 승인합니다.",
        "operationId": "approveCoupon",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserCouponApproveRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseCouponResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/auth/signup": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "회원가입",
        "description": "초대 기반 회원가입 (기존 Business 참여) - 토큰 없음, 로그인 별도 필요",
        "operationId": "signUp",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignUpRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseSignUpResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/session": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "진단 세션 발급 (D010)",
        "description": "HMAC 인증된 고객사가 자사 사용자를 위한 진단 세션 토큰을 발급받음. JWT Session Token이 포함된 프론트엔드 진입 URL을 반환합니다.",
        "operationId": "createSession",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseSessionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/session/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "세션 토큰 로그인",
        "description": "프론트엔드가 받은 60초짜리 세션 토큰을 검증하고 실제 사용할 액세스 토큰을 발급받음. 세션 토큰에 포함된 정보로 Member/Subject/Diagnosis를 생성하고 JWT 토큰을 발급합니다.",
        "operationId": "loginWithSession",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionLoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseSessionLoginResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "토큰 갱신",
        "description": "Refresh Token으로 Access Token 갱신",
        "operationId": "refresh",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseTokenResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/oauth/token": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "OAuth 토큰 교환",
        "description": "OAuth 로그인 성공 후 받은 임시 코드를 JWT 토큰으로 교환합니다. 임시 코드는 60초간 유효하며 1회만 사용 가능합니다.",
        "operationId": "exchangeOAuthToken",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OAuthTokenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseSessionLoginResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "로그아웃",
        "description": "로그아웃 처리 (Refresh Token 파기 + Access Token 블랙리스트 등록)",
        "operationId": "logout",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseVoid"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "로그인",
        "description": "이메일과 비밀번호로 로그인",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseLoginResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/me/password": {
      "patch": {
        "tags": [
          "user"
        ],
        "summary": "비밀번호 변경",
        "description": "현재 비밀번호 확인 후 새 비밀번호로 변경 (로그인 필요)",
        "operationId": "changePassword",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseString"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/subjects/{subjectIdx}/anonymize": {
      "patch": {
        "tags": [
          "subjects"
        ],
        "summary": "진단 대상자 비식별 처리",
        "description": "진단 대상자의 개인정보를 비식별 처리합니다 (이름 마스킹: 홍길동 → 홍**)",
        "operationId": "anonymizeDiagnosisSubject",
        "parameters": [
          {
            "name": "subjectIdx",
            "in": "path",
            "description": "진단 대상자 ID",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseSubjectResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/diagnoses/{diagnosisIdx}/recording/start": {
      "patch": {
        "tags": [
          "diagnoses"
        ],
        "summary": "녹음 시작",
        "description": "진단 녹음을 시작합니다 (PENDING → RECORDING)",
        "operationId": "startRecording",
        "parameters": [
          {
            "name": "diagnosisIdx",
            "in": "path",
            "description": "진단 ID",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseDiagnosisResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/records/me": {
      "get": {
        "tags": [
