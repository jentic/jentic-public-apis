            "example": "https://saas-front.aible.co.kr/auth/session?accessToken=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          }
        },
        "description": "진단 세션 발급 응답"
      },
      "SessionLoginRequest": {
        "required": [
          "sessionToken"
        ],
        "type": "object",
        "properties": {
          "sessionToken": {
            "type": "string",
            "description": "세션 토큰 (60초 유효)",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          }
        },
        "description": "세션 토큰 로그인 요청"
