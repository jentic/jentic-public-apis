      "SignUpRequest": {
        "required": [
          "agreedTermsIdxList",
          "businessIdx",
          "email",
          "password",
          "userName"
        ],
        "type": "object",
        "properties": {
          "businessIdx": {
            "type": "integer",
            "description": "회사 ID",
            "format": "int64",
            "default": 1
          },
          "email": {
            "type": "string",
            "description": "이메일",
            "default": "test1@aible.co.kr"
          },
          "password": {
            "maxLength": 20,
            "minLength": 8,
            "pattern": "^(?=.*[a-zA-Z])(?=.*\\d)[A-Za-z\\d@$!%*?&#_-]{8,20}$",
            "type": "string",
            "description": "비밀번호",
            "default": "aible123!@#"
          },
          "userName": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string",
            "description": "유저 이름",
            "default": "홍길동"
          },
          "phoneNumber": {
            "pattern": "^01[0-9]-?\\d{3,4}-?\\d{4}$",
            "type": "string",
            "description": "휴대폰 번호",
            "default": "010-1234-5678"
          },
          "userGender": {
            "type": "string",
            "description": "성별",
            "default": "M",
            "enum": [
              "M",
              "F"
            ]
          },
          "userBirth": {
            "pattern": "^\\d{6}$",
            "type": "string",
            "description": "생년월일",
            "default": "961222"
          },
          "userAddress": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string",
            "description": "주소",
            "default": "서울 영등포구 국회대로70길 18"
          },
          "userAddressDetail": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string",
            "description": "주소 상세",
            "default": "905호 (07777)"
          },
          "agreedTermsIdxList": {
            "type": "array",
            "description": "약관 동의 목록",
            "items": {
              "type": "integer",
              "description": "약관 동의 목록",
              "format": "int64"
            },
            "default": [
              0,
              1,
              2
            ]
          }
        }
      },
