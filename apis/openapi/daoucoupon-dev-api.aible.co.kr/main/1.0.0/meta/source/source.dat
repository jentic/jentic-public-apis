      "MeResponse": {
        "type": "object",
        "properties": {
          "memberIdx": {
            "type": "integer",
            "description": "회원 식별자",
            "format": "int64",
            "example": 1
          },
          "email": {
            "type": "string",
            "description": "이메일",
            "example": "user@example.com"
          },
          "userName": {
            "type": "string",
            "description": "회원 이름",
            "example": "홍길동"
          },
          "businessIdx": {
            "type": "integer",
            "description": "소속 Business 식별자",
            "format": "int64",
            "example": 1
          },
          "roles": {
            "type": "array",
            "description": "권한 목록",
            "example": [
              "ADMIN",
              "USER"
            ],
            "items": {
              "type": "string",
              "description": "권한 목록",
              "example": "[\"ADMIN\",\"USER\"]"
            }
          }
        },
        "description": "현재 로그인한 회원 정보"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "description": "JWT 토큰을 입력하세요 (Bearer 접두사 제외)",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
