{
  "openapi": "3.0.3",
  "info": {
    "title": "ScrapeGraph AI API",
    "description": "AI-powered web scraping API. Extract structured data from websites using natural language prompts, convert pages to markdown, search and extract data, and crawl websites with AI.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://docs.scrapegraphai.com/",
    "x-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://api.scrapegraphai.com",
      "description": "Production API"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/v1/smartscraper": {
      "post": {
        "operationId": "startSmartscraper",
        "summary": "Start SmartScraper",
        "description": "Start an AI-powered extraction job for a webpage using a natural language prompt.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SmartScraperRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Scraping job started",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SmartScraperResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error"
          }
        }
      }
    },
    "/v1/smartscraper/{request_id}": {
      "get": {
        "operationId": "getSmartscraperStatus",
        "summary": "Get SmartScraper Status",
        "description": "Get the status and results of a SmartScraper request.",
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The request ID returned from the start endpoint"
          }
        ],
        "responses": {
          "200": {
            "description": "SmartScraper status and results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SmartScraperResponse"
                }
              }
            }
          },
          "404": {
            "description": "Request not found"
          }
        }
      }
    },
    "/v1/markdownify": {
      "post": {
        "operationId": "startMarkdownify",
        "summary": "Start Markdownify",
        "description": "Convert a webpage into clean, readable Markdown format.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MarkdownifyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Markdownify job started",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarkdownifyResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error"
          }
        }
      }
    },
    "/v1/markdownify/{request_id}": {
      "get": {
        "operationId": "getMarkdownifyStatus",
        "summary": "Get Markdownify Status",
        "description": "Get the status and results of a Markdownify request.",
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Markdownify status and results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarkdownifyResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/searchscraper": {
      "post": {
        "operationId": "startSearchscraper",
        "summary": "Start SearchScraper",
        "description": "Search the web and extract data using AI based on a natural language query.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchScraperRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "SearchScraper job started",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchScraperResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error"
          }
        }
      }
    },
    "/v1/searchscraper/{request_id}": {
      "get": {
        "operationId": "getSearchscraperStatus",
        "summary": "Get SearchScraper Status",
        "description": "Get the status and results of a SearchScraper request.",
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "SearchScraper status and results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchScraperResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/crawl": {
      "post": {
        "operationId": "startCrawl",
        "summary": "Start Crawl",
        "description": "Start an AI-powered web crawl with extraction or markdown conversion.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["website_url"],
                "properties": {
                  "website_url": {
                    "type": "string",
                    "description": "The starting URL to crawl"
                  },
                  "user_prompt": {
                    "type": "string",
                    "description": "Natural language description of what to extract"
                  },
                  "output_schema": {
                    "type": "object",
                    "description": "JSON schema for structuring results"
                  },
                  "headers": {
                    "type": "object",
                    "description": "Custom HTTP headers"
                  },
                  "stealth": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enable anti-detection techniques (+4 credits)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Crawl job started",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "task_id": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": ["queued", "processing", "completed", "failed"]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/crawl/{task_id}": {
      "get": {
        "operationId": "getCrawlResult",
        "summary": "Get Crawl Result",
        "description": "Get the status and results of a crawl task.",
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Crawl result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/credits": {
      "get": {
        "operationId": "getCredits",
        "summary": "Get Credits",
        "description": "Check account credit balance and usage metrics.",
        "responses": {
          "200": {
            "description": "Credit balance information",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "remaining_credits": {
                      "type": "number"
                    },
                    "total_credits_used": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/feedback": {
      "post": {
        "operationId": "submitFeedback",
        "summary": "Submit Feedback",
        "description": "Submit feedback with ratings and comments for a request.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "request_id": {
                    "type": "string"
                  },
                  "rating": {
                    "type": "integer"
                  },
                  "comment": {
                    "type": "string"
                  }
                },
                "required": ["request_id", "rating"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Feedback submitted"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "SGAI-APIKEY",
        "description": "ScrapeGraph AI API key"
      }
    },
    "schemas": {
      "SmartScraperRequest": {
        "type": "object",
        "required": ["user_prompt"],
        "properties": {
          "user_prompt": {
            "type": "string",
            "description": "Natural language description of what information to extract"
          },
          "website_url": {
            "type": "string",
            "description": "The webpage URL to scrape"
          },
          "website_html": {
            "type": "string",
            "description": "Raw HTML content (max 2MB)"
          },
          "website_markdown": {
            "type": "string",
            "description": "Raw Markdown content (max 2MB)"
          },
          "output_schema": {
            "type": "object",
            "description": "JSON schema for structuring results"
          },
          "headers": {
            "type": "object",
            "description": "Custom HTTP headers"
          },
          "total_pages": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 1,
            "description": "Enable pagination"
          },
          "number_of_scrolls": {
            "type": "integer",
            "minimum": 0,
            "maximum": 50,
            "default": 0,
            "description": "Infinite scroll handling"
          },
          "cookies": {
            "type": "object",
            "description": "Authentication and session cookies"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Browser interaction steps before extraction"
          },
          "mock": {
            "type": "boolean",
            "default": false,
            "description": "Enable mock mode for testing"
          },
          "plain_text": {
            "type": "boolean",
            "default": false,
            "description": "Return plain text instead of JSON"
          },
          "stealth": {
            "type": "boolean",
            "default": false,
            "description": "Bypass bot protection (+4 credits)"
          }
        }
      },
      "SmartScraperResponse": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["queued", "processing", "completed", "failed"]
          },
          "website_url": {
            "type": "string"
          },
          "user_prompt": {
            "type": "string"
          },
          "result": {
            "type": "object",
            "description": "Extracted data following the output schema"
          },
          "error": {
            "type": "string"
          }
        }
      },
      "MarkdownifyRequest": {
        "type": "object",
        "required": ["website_url"],
        "properties": {
          "website_url": {
            "type": "string",
            "description": "The webpage URL to convert"
          },
          "headers": {
            "type": "object",
            "description": "Custom HTTP headers"
          },
          "stealth": {
            "type": "boolean",
            "default": false,
            "description": "Enable anti-detection techniques (+4 credits)"
          }
        }
      },
      "MarkdownifyResponse": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["queued", "processing", "completed", "failed"]
          },
          "website_url": {
            "type": "string"
          },
          "result": {
            "type": "string",
            "nullable": true,
            "description": "Converted markdown content"
          },
          "error": {
            "type": "string"
          }
        }
      },
      "SearchScraperRequest": {
        "type": "object",
        "required": ["user_prompt"],
        "properties": {
          "user_prompt": {
            "type": "string",
            "description": "Search query or question"
          },
          "output_schema": {
            "type": "object",
            "description": "JSON schema for structuring results"
          },
          "headers": {
            "type": "object",
            "description": "Custom HTTP headers"
          },
          "mock": {
            "type": "boolean",
            "default": false
          },
          "stealth": {
            "type": "boolean",
            "default": false
          },
          "time_range": {
            "type": "string",
            "enum": ["past_hour", "past_24_hours", "past_week", "past_month", "past_year"],
            "description": "Filter results by date range"
          }
        }
      },
      "SearchScraperResponse": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["queued", "processing", "completed", "failed"]
          },
          "user_prompt": {
            "type": "string"
          },
          "result": {
            "type": "object"
          },
          "reference_urls": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "URLs used as references"
          },
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}
