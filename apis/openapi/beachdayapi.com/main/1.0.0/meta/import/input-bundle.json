{
  "openapi": "3.0.3",
  "info": {
    "title": "Beach Day API",
    "version": "1.0.0",
    "description": "Beach Day API aggregates beach data, water quality, tides, weather, rules, and amenities. This spec reflects the publicly documented Django REST API.",
    "contact": {
      "name": "Beach Day API",
      "url": "https://beachdayapi.com"
    },
    "license": {
      "name": "Commercial API License",
      "url": "https://beachdayapi.com/terms/"
    },
    "x-jentic-source-url": "https://beachdayapi.com/en/openapi.json"
  },
  "servers": [
    {
      "url": "https://beachdayapi.com/v1",
      "description": "Production"
    }
  ],
  "paths": {
    "/health/": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health check",
        "description": "Unauthenticated endpoint that returns a simple OK payload.",
        "security": [],
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Service is healthy.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "example": {
                  "status": "ok",
                  "service": "Beach Day API"
                }
              }
            }
          }
        }
      }
    },
    "/beaches/": {
      "get": {
        "tags": [
          "Beaches"
        ],
        "summary": "List beaches",
        "description": "Search and list beaches. Supports offset/limit pagination (default: 100 results, max: 500).",
        "operationId": "listBeaches",
        "parameters": [
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Filter by state code, for example CA, FL, HI, or AU-NSW."
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Filter by country name (e.g., 'Croatia', 'Greece', 'Thailand', 'French Polynesia', 'New Caledonia', 'Fiji', 'Samoa', 'Tonga', 'New Zealand'). Case-insensitive."
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Search beaches by name (case-insensitive, e.g. 'Malibu')."
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0
            },
            "description": "Number of results to skip (default: 0)."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 100,
              "maximum": 500
            },
            "description": "Max results per page (default: 100, max: 500)."
          }
        ],
        "responses": {
          "200": {
            "description": "Beach list.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BeachListResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "402": {
            "description": "Not enough credits.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/beaches/{id}/": {
      "get": {
        "tags": [
          "Beaches"
        ],
        "summary": "Get beach detail",
        "description": "Returns a beach record plus the latest stored condition data, rules, and amenities.",
        "operationId": "getBeachDetail",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Beach ID."
          }
        ],
        "responses": {
          "200": {
            "description": "Beach detail.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BeachDetail"
                },
                "example": {
                  "id": 1,
                  "name": "Venice Beach",
                  "state": "CA",
                  "county": "Los Angeles",
                  "city": "Los Angeles",
                  "latitude": 33.985,
                  "longitude": -118.4695,
                  "description": "Popular Los Angeles beach with boardwalk access.",
                  "nearest_buoy_id": "46025",
                  "nearest_tide_station": "9410660",
                  "beach_day_score": 82,
                  "water_quality": {
                    "grade": "A",
                    "advisory": false,
                    "source": "LA County Public Health",
                    "updated": "2026-06-24T08:00:00Z"
                  },
                  "weather": {
                    "temp_f": 74,
                    "condition": "clear",
                    "uv_index": 8,
                    "wind_speed_mph": 6,
                    "humidity_pct": 68,
                    "precipitation_in": 0
                  },
                  "ocean_conditions": {
                    "water_temp_f": 66,
                    "wave_height_ft": 2.4,
                    "rip_current_risk": "moderate"
                  },
                  "rules": [
                    {
                      "category": "dogs",
                      "status": "restricted",
                      "notes": "Allowed on leash before 10am."
                    },
                    {
                      "category": "alcohol",
                      "status": "prohibited",
                      "notes": "No alcohol on the beach."
                    }
                  ],
                  "amenities": [
                    {
                      "category": "lifeguard",
                      "available": true,
                      "hours": "9am-6pm",
                      "notes": "Seasonal staffed towers."
                    },
                    {
                      "category": "restrooms",
                      "available": true,
                      "hours": "",
                      "notes": "Public restrooms near the boardwalk."
                    }
                  ],
                  "country": "United States"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "402": {
            "description": "Not enough credits.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Beach not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
