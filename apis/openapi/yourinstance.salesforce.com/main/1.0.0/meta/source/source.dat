{
  "openapi": "3.0.3",
  "info": {
    "title": "Salesforce Product API",
    "version": "1.0.0",
    "description": "API to fetch a Product record from Salesforce.",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/self-784-a46/Product_API/1.0.0"
  },
  "servers": [
    {
      "url": "https://yourInstance.salesforce.com/services/data/v63.0"
    }
  ],
  "paths": {
    "/sobjects/Product2/{productId}": {
      "get": {
        "summary": "Get Product2 record by Id",
        "operationId": "getProductById",
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "01tdL00000VY7I9QAL"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product2"
                }
              }
            }
          },
          "404": {
            "description": "Product not found"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Product2": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string"
          },
          "Name": {
            "type": "string"
          },
          "ProductCode": {
            "type": "string"
          },
          "Description": {
            "type": "string",
            "nullable": true
          },
          "IsActive": {
            "type": "boolean"
          },
          "Family": {
            "type": "string",
            "nullable": true
          },
          "ProductClass": {
            "type": "string",
            "nullable": true
          }
        },
        "example": {
          "Id": "01tdL00000VY7I9QAL",
          "Name": "GenWatt Diesel 1000kW",
          "ProductCode": "GC1060",
          "IsActive": true,
          "ProductClass": "Simple"
        }
      }
    }
  }
}
