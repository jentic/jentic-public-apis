        "tags": [
          "Auth API's"
        ],
        "summary": "Register API",
        "description": "Register API",
        "operationId": "registerApi",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "admin@webgarh.com"
                  },
                  "name": {
                    "type": "string",
                    "example": "Admin User"
                  },
                  "password": {
                    "type": "string",
                    "example": "webgarh@123"
                  }
                }
              },
              "examples": {
                "Register API": {
                  "value": {
                    "email": "admin@webgarh.com",
                    "name": "Admin User",
                    "password": "webgarh@123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        }
      }
    },
