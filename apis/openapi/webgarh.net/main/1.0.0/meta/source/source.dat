    "/api/template-text-areas/create": {
      "post": {
        "tags": [
          "Template Text Area API's"
        ],
        "summary": "Create Template Text Area",
        "description": "Create Template Text Area",
        "operationId": "createTemplateTextArea",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "template_id": {
                    "type": "string",
                    "example": "6156f854-78fb-4969-8a1f-ecdece933e89"
                  },
                  "textAreas": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "fontSize": {
                          "type": "number",
                          "example": 50
                        },
                        "height": {
                          "type": "number",
                          "example": 56.5
                        },
                        "text": {
                          "type": "string",
                          "example": "test 1"
                        },
                        "uu_id": {
                          "type": "number",
                          "example": 347943990839408
                        },
                        "width": {
                          "type": "number",
                          "example": 335
                        },
                        "x": {
                          "type": "number",
                          "example": 77.5
                        },
                        "y": {
                          "type": "number",
                          "example": 75.8125
                        }
                      }
                    },
                    "example": [
                      {
                        "fontSize": 50,
                        "height": 56.5,
                        "text": "test 1",
                        "uu_id": 347943990839408,
                        "width": 335,
                        "x": 77.5,
                        "y": 75.8125
                      },
                      {
                        "fontSize": 50,
                        "height": 56.5,
                        "text": "test 2",
                        "uu_id": 737937893297971,
                        "width": 298,
                        "x": 960.5,
                        "y": 70.8125
                      }
                    ]
                  }
                }
              },
              "examples": {
                "Create Template Text Area": {
                  "value": {
                    "template_id": "6156f854-78fb-4969-8a1f-ecdece933e89",
                    "textAreas": [
                      {
                        "fontSize": 50,
                        "height": 56.5,
                        "text": "test 1",
                        "uu_id": 347943990839408,
                        "width": 335,
                        "x": 77.5,
                        "y": 75.8125
                      },
                      {
                        "fontSize": 50,
                        "height": 56.5,
                        "text": "test 2",
                        "uu_id": 737937893297971,
                        "width": 298,
                        "x": 960.5,
                        "y": 70.8125
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
