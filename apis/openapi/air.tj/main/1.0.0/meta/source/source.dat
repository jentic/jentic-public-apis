{
  "openapi": "3.0.3",
  "info": {
    "title": "Sanatorium API - Пациенты Регистрация & Авторизация",
    "description": "API для регистрации и авторизации пациентов через мобильное приложение.\nПациенты регистрируются используя номер телефона и пароль.\n",
    "version": "1.0.0",
    "contact": {
      "name": "Backend Development Team"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/zindustries/AirSanatorium/1.0.0"
  },
  "servers": [
    {
      "url": "https://apisanatorium.air.tj/api",
      "description": "Production server"
    }
  ],
  "tags": [
    {
      "name": "Authentication",
      "description": "Patient authentication endpoints"
    },
    {
      "name": "Patients",
      "description": "Patient management and reference data"
    }
  ],
  "paths": {
    "/auth/patient/register": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Register a new patient",
        "description": "Создает нового пациента в системе. Номер телефона должен быть уникальным. Email опционален.\n",
        "operationId": "registerPatient",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatientRegistrationRequest"
              },
              "examples": {
                "minimal": {
                  "summary": "Minimal registration",
                  "value": {
                    "surname": "Иванов",
                    "first_name": "Иван",
                    "phone": "+992123456789",
                    "password": "password123",
                    "password_confirmation": "password123"
                  }
                },
                "full": {
                  "summary": "Full registration",
                  "value": {
                    "surname": "Иванов",
                    "first_name": "Иван",
                    "middle_name": "Иванович",
                    "phone": "+992123456789",
                    "email": "ivan@example.com",
                    "password": "password123",
                    "password_confirmation": "password123",
                    "date_of_birth": "1990-01-15",
                    "gender": "male",
                    "marital_status": "single",
                    "workplace": "ООО Компания",
                    "guest_type": "standard",
                    "emergency_contact_name": "Петров Петр",
                    "emergency_contact_phone": "+992987654321",
                    "document_type": "passport_tj",
                    "document_series": "A1234567",
                    "document_number": "12345678",
                    "registration_address": "г. Душанбе, ул. Примерная, д. 1",
                    "source": "Mobile App"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Registration successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegistrationResponse"
                },
                "example": {
                  "message": "Registration successful",
                  "data": {
                    "patient": {
                      "id": 1,
                      "surname": "Иванов",
                      "first_name": "Иван",
                      "middle_name": "Иванович",
                      "full_name": "Иванов Иван Иванович",
                      "phone": "+992123456789",
                      "date_of_birth": "1990-01-15",
                      "age": 34,
                      "gender": "male",
                      "marital_status": "single",
                      "workplace": "ООО Компания",
                      "guest_type": "standard",
                      "emergency_contact": {
                        "name": "Петров Петр",
                        "phone": "+992987654321"
                      },
                      "document": {
                        "type": "passport_tj",
                        "series": "A1234567",
                        "number": "12345678"
                      },
                      "registration_address": "г. Душанбе, ул. Примерная, д. 1",
                      "cashback_balance": 0,
                      "is_active": true
                    },
                    "user": {
                      "id": 1,
                      "email": "ivan@example.com",
                      "user_type": "patient",
                      "user_type_display": "Пациент",
                      "name": "Иванов Иван Иванович",
                      "is_active": true,
                      "is_patient": true,
                      "last_login_at": null,
                      "created_at": "2026-01-26T12:00:00.000000Z"
                    }
                  },
                  "token": "eyJ0eXAiOiJKV1QiLCJhbGc..."
                }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                },
                "examples": {
                  "phone_taken": {
                    "summary": "Phone already taken",
                    "value": {
                      "message": "Validation errors",
                      "errors": {
                        "phone": [
                          "The phone has already been taken."
                        ]
                      }
                    }
                  },
                  "password_mismatch": {
                    "summary": "Password confirmation mismatch",
                    "value": {
                      "message": "Validation errors",
                      "errors": {
                        "password": [
                          "The password confirmation does not match."
                        ]
                      }
                    }
                  },
                  "invalid_guest_type": {
                    "summary": "Invalid guest type",
                    "value": {
                      "message": "Validation errors",
                      "errors": {
                        "guest_type": [
                          "The selected guest type is invalid."
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/patient/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Login patient",
        "description": "Авторизует пациента в системе используя номер телефона и пароль.\n",
        "operationId": "loginPatient",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatientLoginRequest"
              },
              "example": {
                "phone": "+992123456789",
                "password": "password123"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                },
                "example": {
                  "message": "Login successful",
                  "data": {
                    "patient": {
                      "id": 1,
                      "surname": "Иванов",
                      "first_name": "Иван",
                      "middle_name": "Иванович",
                      "full_name": "Иванов Иван Иванович",
                      "phone": "+992123456789",
                      "date_of_birth": "1990-01-15",
                      "age": 34,
                      "gender": "male",
                      "marital_status": "single",
                      "workplace": "ООО Компания",
                      "guest_type": "standard",
                      "emergency_contact": {
                        "name": "Петров Петр",
                        "phone": "+992987654321"
                      },
                      "document": {
                        "type": "passport_tj",
                        "series": "A1234567",
                        "number": "12345678"
                      },
                      "registration_address": "г. Душанбе, ул. Примерная, д. 1",
                      "cashback_balance": 0,
                      "is_active": true
                    },
                    "user": {
                      "id": 1,
                      "email": "ivan@example.com",
                      "user_type": "patient",
                      "user_type_display": "Пациент",
                      "name": "Иванов Иван Иванович",
                      "is_active": true,
                      "is_patient": true,
                      "last_login_at": "2026-01-26T12:00:00.000000Z",
                      "created_at": "2026-01-26T11:00:00.000000Z"
                    }
                  },
                  "token": "eyJ0eXAiOiJKV1QiLCJhbGc..."
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "message": "Invalid credentials"
                }
              }
            }
          },
          "403": {
            "description": "Account deactivated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "message": "Account is deactivated"
                }
              }
            }
          }
        }
      }
    },
    "/patients/guest-types": {
      "get": {
        "tags": [
          "Patients"
        ],
        "summary": "Get available guest types",
        "description": "Получить доступные типы гостей",
        "operationId": "getGuestTypes",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/GuestTypeOption"
                      }
                    }
                  }
                },
                "example": {
                  "data": [
                    {
                      "value": "standard",
                      "label": "Стандартный"
                    },
                    {
                      "value": "corporate",
                      "label": "Корпоративный"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/patients/reference-data": {
      "get": {
        "tags": [
          "Patients"
        ],
        "summary": "Get all reference data",
        "description": "Получить все справочные данные включая:\n- Типы документов\n- Семейное положение\n- Типы гостей\n- Пол\n",
        "operationId": "getReferenceData",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "description": "Reference data object containing all available options"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "После успешной регистрации или авторизации, вы получите `token`.\nИспользуйте этот токен для всех последующих запросов к защищенным endpoints.\nФормат: `Authorization: Bearer {token}`\n"
      }
    },
    "schemas": {
      "PatientRegistrationRequest": {
        "type": "object",
        "required": [
          "surname",
          "first_name",
          "phone",
          "password",
          "password_confirmation"
        ],
        "properties": {
          "surname": {
            "type": "string",
            "description": "Фамилия пациента",
            "example": "Иванов"
          },
          "first_name": {
            "type": "string",
            "description": "Имя пациента",
            "example": "Иван"
          },
          "middle_name": {
            "type": "string",
            "nullable": true,
            "description": "Отчество пациента",
            "example": "Иванович"
          },
          "phone": {
            "type": "string",
            "maxLength": 20,
            "description": "Номер телефона (уникальный, максимум 20 символов)",
            "example": "+992123456789"
          },
          "email": {
            "type": "string",
            "format": "email",
            "nullable": true,
            "description": "Email адрес (опционально)",
            "example": "ivan@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 6,
            "description": "Пароль (минимум 6 символов)",
            "example": "password123"
          },
          "password_confirmation": {
            "type": "string",
            "description": "Подтверждение пароля (должен совпадать с password)",
            "example": "password123"
          },
          "date_of_birth": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "description": "Дата рождения (формат: YYYY-MM-DD)",
            "example": "1990-01-15"
          },
          "gender": {
            "type": "string",
            "enum": [
              "male",
              "female",
              "other"
            ],
            "nullable": true,
            "description": "Пол",
            "example": "male"
          },
          "marital_status": {
            "type": "string",
            "enum": [
              "single",
              "married",
              "divorced",
              "widowed"
            ],
            "nullable": true,
            "description": "Семейное положение",
            "example": "single"
          },
          "workplace": {
            "type": "string",
            "nullable": true,
            "description": "Место работы",
            "example": "ООО Компания"
          },
          "guest_type": {
            "type": "string",
            "enum": [
              "standard",
              "corporate"
            ],
            "default": "standard",
            "nullable": true,
            "description": "Тип гостя. По умолчанию: `standard`.\nРазрешены только: `standard` или `corporate`\n",
            "example": "standard"
          },
          "emergency_contact_name": {
            "type": "string",
            "nullable": true,
            "description": "Имя контактного лица для экстренной связи",
            "example": "Петров Петр"
          },
          "emergency_contact_phone": {
            "type": "string",
            "nullable": true,
            "description": "Телефон контактного лица для экстренной связи",
            "example": "+992987654321"
          },
          "document_type": {
            "type": "string",
            "enum": [
              "passport_tj",
              "id_card_tj",
              "passport_foreign"
            ],
            "nullable": true,
            "description": "Тип документа",
            "example": "passport_tj"
          },
          "document_series": {
            "type": "string",
            "nullable": true,
            "description": "Серия документа",
            "example": "A1234567"
          },
          "document_number": {
            "type": "string",
            "nullable": true,
            "description": "Номер документа",
            "example": "12345678"
          },
          "registration_address": {
            "type": "string",
            "nullable": true,
            "description": "Адрес регистрации",
            "example": "г. Душанбе, ул. Примерная, д. 1"
          },
          "source": {
            "type": "string",
            "nullable": true,
            "description": "Источник регистрации (например: Mobile App)",
            "example": "Mobile App"
          }
        }
      },
      "PatientLoginRequest": {
        "type": "object",
        "required": [
          "phone",
          "password"
        ],
        "properties": {
          "phone": {
            "type": "string",
            "description": "Номер телефона",
            "example": "+992123456789"
          },
          "password": {
            "type": "string",
            "description": "Пароль",
            "example": "password123"
          }
        }
      },
      "Patient": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "surname": {
            "type": "string",
            "example": "Иванов"
          },
          "first_name": {
            "type": "string",
            "example": "Иван"
          },
          "middle_name": {
            "type": "string",
            "nullable": true,
            "example": "Иванович"
          },
          "full_name": {
            "type": "string",
            "example": "Иванов Иван Иванович"
          },
          "phone": {
            "type": "string",
            "example": "+992123456789"
          },
          "date_of_birth": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "example": "1990-01-15"
          },
          "age": {
            "type": "integer",
            "nullable": true,
            "example": 34
          },
          "gender": {
            "type": "string",
            "enum": [
              "male",
              "female",
              "other"
            ],
            "nullable": true,
            "example": "male"
          },
          "marital_status": {
            "type": "string",
            "enum": [
              "single",
              "married",
              "divorced",
              "widowed"
            ],
            "nullable": true,
            "example": "single"
          },
          "workplace": {
            "type": "string",
            "nullable": true,
            "example": "ООО Компания"
          },
          "guest_type": {
            "type": "string",
            "enum": [
              "standard",
              "corporate"
            ],
            "example": "standard"
          },
          "emergency_contact": {
            "type": "object",
            "nullable": true,
            "properties": {
              "name": {
                "type": "string",
                "example": "Петров Петр"
              },
              "phone": {
                "type": "string",
                "example": "+992987654321"
              }
            }
          },
          "document": {
            "type": "object",
            "nullable": true,
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "passport_tj",
                  "id_card_tj",
                  "passport_foreign"
                ],
                "example": "passport_tj"
              },
              "series": {
                "type": "string",
                "example": "A1234567"
              },
              "number": {
                "type": "string",
                "example": "12345678"
              }
            }
          },
          "registration_address": {
            "type": "string",
            "nullable": true,
            "example": "г. Душанбе, ул. Примерная, д. 1"
          },
          "cashback_balance": {
            "type": "number",
            "format": "float",
            "example": 0
          },
          "is_active": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "email": {
            "type": "string",
            "format": "email",
            "nullable": true,
            "example": "ivan@example.com"
          },
          "user_type": {
            "type": "string",
            "example": "patient"
          },
          "user_type_display": {
            "type": "string",
            "example": "Пациент"
          },
          "name": {
            "type": "string",
            "example": "Иванов Иван Иванович"
          },
          "is_active": {
            "type": "boolean",
            "example": true
          },
          "is_patient": {
            "type": "boolean",
            "example": true
          },
          "last_login_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "example": "2026-01-26T12:00:00.000000Z"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-01-26T12:00:00.000000Z"
          }
        }
      },
      "RegistrationResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Registration successful"
          },
          "data": {
            "type": "object",
            "properties": {
              "patient": {
                "$ref": "#/components/schemas/Patient"
              },
              "user": {
                "$ref": "#/components/schemas/User"
              }
            }
          },
          "token": {
            "type": "string",
            "description": "JWT token for authentication",
            "example": "eyJ0eXAiOiJKV1QiLCJhbGc..."
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Login successful"
          },
          "data": {
            "type": "object",
            "properties": {
              "patient": {
                "$ref": "#/components/schemas/Patient"
              },
              "user": {
                "$ref": "#/components/schemas/User"
              }
            }
          },
          "token": {
            "type": "string",
            "description": "JWT token for authentication",
            "example": "eyJ0eXAiOiJKV1QiLCJhbGc..."
          }
        }
      },
      "GuestTypeOption": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "enum": [
              "standard",
              "corporate"
            ],
            "example": "standard"
          },
          "label": {
            "type": "string",
            "example": "Стандартный"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Invalid credentials"
          }
        }
      },
      "ValidationErrorResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Validation errors"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "example": {
              "phone": [
                "The phone has already been taken."
              ],
              "password": [
                "The password confirmation does not match."
              ]
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}
