{
  "openapi": "3.0.0",
  "info": {
    "title": "MOMAH Map Services API",
    "description": "API specification for the MOMRAH Map GL services, vector tiles, and static assets used by the Ministry of Municipal Rural Affairs and Housing (Saudi Arabia).\nThis schema covers the JS API entry point, style configurations, vector tile requests, and static style resources.\n",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/wedosolutions/Maps/1.0.0"
  },
  "servers": [
    {
      "url": "https://moi-proxy.momah.gov.sa",
      "description": "Production Proxy Server"
    }
  ],
  "paths": {
    "/api/js/v1": {
      "get": {
        "summary": "MapGL JS API Entry Point",
        "description": "Fetches the primary JavaScript library for initializing the MapGL environment. \nNote: This endpoint does not require an API key.\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/HostHeader"
          },
          {
            "name": "X-Language",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "en",
              "enum": [
                "en",
                "ar"
              ]
            },
            "description": "Language preference for the API responses."
          },
          {
            "name": "Accept",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "default": "application/json"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of the JS API script or configuration.",
            "content": {
              "application/javascript": {
                "schema": {
                  "type": "string"
                }
              },
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "version": {
                      "type": "string"
                    },
                    "baseUrl": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/rtl-plugin.js": {
      "get": {
        "summary": "RTL Support Plugin",
        "description": "Fetches the JavaScript plugin required for Right-to-Left (RTL) text rendering (essential for Arabic).",
        "parameters": [
          {
            "$ref": "#/components/parameters/HostHeader"
          }
        ],
        "responses": {
          "200": {
            "description": "RTL Plugin Script",
            "content": {
              "application/javascript": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/style/style.json": {
      "get": {
        "summary": "Mapbox GL Style Specification",
        "description": "Fetches the Mapbox GL compatible style JSON containing layers, sources, and glyph definitions.",
        "parameters": [
          {
            "$ref": "#/components/parameters/HostHeader"
          }
        ],
        "responses": {
          "200": {
            "description": "Style JSON file",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "version": {
                      "type": "integer"
                    },
                    "sources": {
                      "type": "object"
                    },
                    "layers": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/vector/v2/ald": {
      "get": {
        "summary": "Vector Tiles (AL D)",
        "description": "Fetches vector data tiles for a specific zoom and coordinate.",
        "parameters": [
          {
            "$ref": "#/components/parameters/HostHeader"
          },
          {
            "name": "ts",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "web_immersive"
          },
          {
            "name": "x",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "example": 20633
          },
          {
            "name": "y",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "example": 18707
          },
          {
            "name": "z",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "example": 15
          }
        ],
        "responses": {
          "200": {
            "description": "Binary PBF/MVT Vector Tile",
            "content": {
              "application/x-protobuf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    },
    "/vector/vt": {
      "get": {
        "summary": "Generic Vector Tile Service",
        "description": "Fetches vector tiles using a protobuf-encoded request string and API key.",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/HostHeader"
          },
          {
            "name": "r",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Protobuf-encoded tile request."
          },
          {
            "name": "ts",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "web"
          },
          {
            "name": "key",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "example": "28ed92f1-de4b-4060-b159-2dc19e9b8bf5",
            "description": "The API Key for authentication."
          },
          {
            "name": "appId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "empty"
          },
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "ar",
                "en"
              ]
            },
            "example": "ar"
          },
          {
            "name": "s",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "example": "696c84b8-1ca6-418f-bc0c-a4b68e761e00"
          }
        ],
        "responses": {
          "200": {
            "description": "Vector Tile Data",
            "content": {
              "application/vnd.mapbox-vector-tile": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    },
    "/map-styles/{path}": {
      "get": {
        "summary": "Map Style Resources",
        "description": "Fetches static assets such as SVGs, sprites, or patterns used in the map styles. \nSupports multiple path segments (e.g., styles/default/asset.svg).\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/HostHeader"
          },
          {
            "name": "path",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "styles/default/noise-b0fe02807a5eeb9958b0b432b26ecad51c356b7c023675335362a36e65f403aa.svg",
            "description": "The full path to the resource under the /map-styles/ directory."
          }
        ],
        "responses": {
          "200": {
            "description": "Map Style Asset (SVG, Image, or JSON)",
            "content": {
              "image/svg+xml": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "HostHeader": {
        "name": "Host",
        "in": "header",
        "required": true,
        "description": "The domain name of the server (and potentially the port number). Must not be blank.",
        "schema": {
          "type": "string",
          "minLength": 1,
          "example": "moi-proxy.momah.gov.sa"
        }
      }
    },
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "query",
        "name": "key",
        "description": "API Key authentication using the 'key' query parameter."
      }
    }
  },
  "security": [
    {
      "ApiKeyAuth": []
    }
  ]
}
