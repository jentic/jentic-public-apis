          "type": "object",
          "properties": {
            "phoneNum": {
              "type": "string",
              "pattern": "^(\\+){0,1}\\d{10,15}$"
            },
            "type": {
              "description": "[BN] : [Beeper Number] [CP] : [Cellular Phone Number] [FX] : [Fax Number] [HF] : [Home Facsimile Number] [HP] : [Home Phone Number] [NP] : [Evening Phone Number] [PC] : [Personal Cellular Number] [TE] : [Telephone (With Unknown Type)] [VM] : [Voice Mail] [WC] : [Work Cellular Number] [WF] : [Work Fax Number] [WP] : [Business Phone Number]",
