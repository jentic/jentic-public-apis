      "taskIntegrationResponseSchema": {
        "title": "Task Integration Response Json Schema",
        "description": "This schema defines the APIs response format",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri-reference",
            "description": " This will help identify the problem type"
          },
          "title": {
            "type": "string",
            "description": "A short, human-readable summary of the problem type"
          },
          "detail": {
            "type": "string",
            "description": "A human-readable explanation specific to this occurrence of the problem."
          },
          "status": {
            "type": "integer",
            "description": "Http Response code",
            "minimum": 100,
            "maximum": 599
          },
          "instance": {
            "type": "string",
            "format": "uri-reference",
            "description": "ErrorId reference that identifies the specific occurrence of the problem"
          },
          "errors": {
            "type": "array",
            "description": "This is to populate list of errors.",
            "items": {
              "type": "object",
              "properties": {
                "detail": {
                  "type": "string",
                  "description": "A human-readable explanation specific to this occurrence of the problem."
                },
                "pointer": {
                  "type": "string",
                  "description": "This is to populate JSON pointer to the applicable property."
                }
              },
              "required": [
                "detail"
              ]
            }
          },
          "warnings": {
            "type": "array",
            "description": "This is to populate list of warnings.",
            "items": {
              "type": "object",
              "properties": {
                "detail": {
                  "type": "string",
                  "description": "A human-readable explanation specific to this occurrence of the problem."
                },
                "pointer": {
                  "type": "string",
                  "description": "This is to populate JSON pointer to the applicable property."
                }
              },
              "required": [
                "detail"
              ]
            }
          }
        }
      },
      "taskIntegrationStatusChangeSchema": {
        "title": "Task Integration Assignment Status Change Schema",
        "type": "object",
        "minProperties": 1,
        "additionalProperties": false,
        "required": [
          "statusChangeOperation"
        ],
        "properties": {
          "statusChangeOperation": {
            "description": "[Cancel]",
            "enum": [
              "Cancel"
            ]
          },
          "reasonCode": {
            "description": "Supported Values: [CYCLE_TIME_EXCEEDED]  [INVALID_DAMAGE_DETAILS]  [POSSIBLE_TOTAL_LOSS]  [POOR_PHOTO_QUALITY]  [SYSTEM_ERROR]  [OTHER]",
            "type": "string"
          },
          "notes": {
            "description": "Notes to be added when the reasonCode is set to OTHER",
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "OAuth2.0": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header"
      }
    }
  }
}
