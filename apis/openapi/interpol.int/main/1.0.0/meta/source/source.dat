{
  "openapi": "3.0.3",
  "info": {
    "title": "Interpol Red Notice API",
    "description": "Public API for querying Interpol Red Notices. Provides access to information about individuals wanted by Interpol member countries, including personal details and associated images.",
    "version": "1.0.0",
    "contact": {
      "name": "INTERPOL",
      "url": "https://www.interpol.int"
    },
    "x-jentic-source-url": "https://ws-public.interpol.int/notices/v1/red",
    "x-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://ws-public.interpol.int",
      "description": "Interpol Public Web Services"
    }
  ],
  "paths": {
    "/notices/v1/red": {
      "get": {
        "operationId": "getRedNotices",
        "summary": "Search and list Red Notices",
        "description": "Returns a paginated list of Interpol Red Notices with optional filtering by various criteria.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Page number for pagination",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "resultPerPage",
            "in": "query",
            "description": "Number of results per page",
            "schema": {
              "type": "integer",
              "default": 20
            }
          },
          {
            "name": "forename",
            "in": "query",
            "description": "First name of the wanted person",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "query",
            "description": "Last name of the wanted person",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "nationality",
            "in": "query",
            "description": "Nationality of the wanted person (two-letter country code)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ageMin",
            "in": "query",
            "description": "Minimum age of the wanted person",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "ageMax",
            "in": "query",
            "description": "Maximum age of the wanted person",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "sexId",
            "in": "query",
            "description": "Sex of the wanted person",
            "schema": {
              "type": "string",
              "enum": [
                "M",
                "F"
              ]
            }
          },
          {
            "name": "arrestWarrantCountryId",
            "in": "query",
            "description": "Country that issued the arrest warrant (two-letter country code)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "freeText",
            "in": "query",
            "description": "Free text search",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of Red Notices",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total": {
                      "type": "integer"
                    },
                    "query": {
                      "type": "object"
                    },
                    "_embedded": {
                      "type": "object",
                      "properties": {
                        "notices": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/RedNotice"
                          }
                        }
                      }
                    },
                    "_links": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/notices/v1/red/{entityId}": {
      "get": {
        "operationId": "getRedNoticeById",
        "summary": "Get a specific Red Notice by entity ID",
        "description": "Returns detailed information about a specific Red Notice identified by its entity ID.",
        "parameters": [
          {
            "name": "entityId",
            "in": "path",
            "required": true,
            "description": "The unique entity identifier for the Red Notice",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Red Notice details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RedNoticeDetail"
                }
              }
            }
          },
          "404": {
            "description": "Red Notice not found"
          }
        }
      }
    },
    "/notices/v1/red/{entityId}/images": {
      "get": {
        "operationId": "getRedNoticeImages",
        "summary": "Get images associated with a Red Notice",
        "description": "Returns a collection of images (photos) associated with a specific Red Notice.",
        "parameters": [
          {
            "name": "entityId",
            "in": "path",
            "required": true,
            "description": "The unique entity identifier for the Red Notice",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Collection of images",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "_embedded": {
                      "type": "object",
                      "properties": {
                        "images": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "picture_id": {
                                "type": "string"
                              },
                              "_links": {
                                "type": "object"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Red Notice not found"
          }
        }
      }
    },
    "/notices/v1/yellow": {
      "get": {
        "operationId": "getYellowNotices",
        "summary": "Search and list Yellow Notices",
        "description": "Returns a paginated list of Interpol Yellow Notices (missing persons).",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Page number for pagination",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "resultPerPage",
            "in": "query",
            "description": "Number of results per page",
            "schema": {
              "type": "integer",
              "default": 20
            }
          },
          {
            "name": "forename",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "nationality",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sexId",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "M",
                "F"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of Yellow Notices"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RedNotice": {
        "type": "object",
        "properties": {
          "entity_id": {
            "type": "string"
          },
          "forename": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "date_of_birth": {
            "type": "string"
          },
          "nationalities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "_links": {
            "type": "object"
          }
        }
      },
      "RedNoticeDetail": {
        "type": "object",
        "properties": {
          "entity_id": {
            "type": "string"
          },
          "forename": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "date_of_birth": {
            "type": "string"
          },
          "place_of_birth": {
            "type": "string"
          },
          "nationalities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sex_id": {
            "type": "string"
          },
          "country_of_birth_id": {
            "type": "string"
          },
          "distinguishing_marks": {
            "type": "string"
          },
          "weight": {
            "type": "number"
          },
          "height": {
            "type": "number"
          },
          "eyes_colors_id": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hairs_id": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "arrest_warrants": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "issuing_country_id": {
                  "type": "string"
                },
                "charge": {
                  "type": "string"
                }
              }
            }
          },
          "_links": {
            "type": "object"
          }
        }
      }
    }
  },
  "security": []
}
