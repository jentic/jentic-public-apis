{
  "openapi": "3.0.3",
  "info": {
    "title": "Woocommerce Customers API",
    "version": "1",
    "description": "API privada para registro y gesti\u00f3n de clientes en WordPress (WooCommerce).\n\n## Autenticaci\u00f3n\n\nTodas las solicitudes requieren el header: **X-API-KEY**\n\nEl valor corresponde a la constante `WCRA_BACKEND_API_KEY`\ndefinida en el archivo `wp-config.php` del backend de WordPress.\n\n```php\ndefine('WCRA_BACKEND_API_KEY', '********');\n```\n\n### Errores de autenticaci\u00f3n\n- **403**: API Key inv\u00e1lida o ausente\n- **429**: L\u00edmite de 20 requests por minuto excedido\n",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/hukagency-aeb/WoocommerceCustomerAPI/1"
  },
  "servers": [
    {
      "url": "https://tu-dominio.com/wp-json",
      "description": "WordPress REST API"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-KEY",
        "description": "API Key definida en el backend de WordPress mediante la constante\n`WCRA_BACKEND_API_KEY` en el archivo `wp-config.php`.\n"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "error": {
            "type": "string",
            "example": "invalid_request"
          },
          "message": {
            "type": "string",
            "example": "Error message"
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": [
          "rem_id",
          "email"
        ],
        "properties": {
          "rem_id": {
            "type": "string",
            "description": "Identificador \u00fanico externo (REM)"
          },
          "phone_number": {
            "type": "string"
          },
          "first_name": {
            "type": "string"
          },
          "last_name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "RegisterSuccessResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "type": "object",
            "properties": {
              "user_id": {
                "type": "integer",
                "example": 123
              },
              "jwt": {
                "type": "string",
                "description": "JSON Web Token generado para el cliente",
                "example": "eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..."
              }
            }
          }
        }
      },
      "UpdateCustomerRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "first_name": {
            "type": "string"
          },
          "last_name": {
            "type": "string"
          },
          "phone_number": {
            "type": "string"
          }
        }
      },
      "StatusRequest": {
        "type": "object",
        "required": [
          "enabled"
        ],
        "properties": {
          "enabled": {
            "type": "boolean",
            "description": "true habilita la cuenta, false la deshabilita",
            "example": true
          }
        }
      },
      "StatusSuccessResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "type": "object",
            "properties": {
              "user_id": {
                "type": "integer",
                "example": 123
              },
              "status": {
                "type": "string",
                "example": "enabled"
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/wcra/v1/customers/register": {
      "post": {
        "tags": [
          "Customers"
        ],
        "summary": "Registrar o recuperar cliente",
        "description": "Registra un cliente nuevo o devuelve uno existente si el `rem_id`\nya est\u00e1 registrado.  \nEn ambos casos se genera un **JWT**.\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              },
              "example": {
                "rem_id": "string",
                "phone_number": "string",
                "first_name": "string",
                "last_name": "string",
                "email": "info@wohuk.com"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cliente registrado o existente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterSuccessResponse"
                }
              }
            }
          },
          "400": {
            "description": "Error de validaci\u00f3n",
            "content": {
              "application/json": {
                "examples": {
                  "email_required": {
                    "value": {
                      "success": false,
                      "error": "email_required",
                      "message": "Email is required"
                    }
                  },
                  "rem_required": {
                    "value": {
                      "success": false,
                      "error": "rem_required",
                      "message": "rem_id is required"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "API Key inv\u00e1lida",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "error": "forbidden",
                  "message": "Invalid API key"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit excedido",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "error": "rate_limited",
                  "message": "Too many requests"
                }
              }
            }
          },
          "500": {
            "description": "Error interno",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "error": "db_user_error",
                  "message": "The user could not be created."
                }
              }
            }
          }
        }
      }
    },
    "/wcra/v1/customers/{id}": {
      "put": {
        "tags": [
          "Customers"
        ],
        "summary": "Actualizar datos del cliente",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "example": 123
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCustomerRequest"
              },
              "example": {
                "first_name": "string",
                "last_name": "string",
                "phone_number": "string"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cliente actualizado",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "message": "Updated client"
                }
              }
            }
          },
          "404": {
            "description": "Cliente no encontrado",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "error": "not_found",
                  "message": "Client not found"
                }
              }
            }
          },
          "403": {
            "description": "API Key inv\u00e1lida"
          }
        }
      }
    },
    "/wcra/v1/customers/{id}/status": {
      "patch": {
        "tags": [
          "Customers"
        ],
        "summary": "Activar o desactivar cliente",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "example": 123
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StatusRequest"
              },
              "example": {
                "enabled": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Estado actualizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusSuccessResponse"
                }
              }
            }
          },
          "400": {
            "description": "Campo requerido faltante",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "error": "invalid_request",
                  "message": "The enabled field is required."
                }
              }
            }
          },
          "404": {
            "description": "Cliente no encontrado",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "error": "not_found",
                  "message": "Client not found"
                }
              }
            }
          }
        }
      }
    }
  }
}