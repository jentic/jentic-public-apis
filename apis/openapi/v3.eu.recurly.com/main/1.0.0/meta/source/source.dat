{
  "openapi": "3.0.3",
  "info": {
    "title": "Voyager_Recurly",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/marriott-ee7/voyager_recurly/1.0.0"
  },
  "servers": [
    {
      "url": "https://v3.eu.recurly.com"
    }
  ],
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    }
  },
  "paths": {
    "/accounts": {
      "get": {
        "summary": "Accounts",
        "description": "Retrieve a list of accounts.",
        "operationId": "accounts",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/vnd.recurly.v2021-02-25": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "object": {
                      "type": "string"
                    },
                    "has_more": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "code": {
                            "type": "string"
                          },
                          "email": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "basicAuth": []
          }
        ]
      }
    },
    "/invoices": {
      "get": {
        "summary": "Invoice",
        "description": "Retrieve invoices for a specific account.",
        "operationId": "invoice",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/vnd.recurly.v2021-02-25": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "object": {
                      "type": "string"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "number": {
                            "type": "string"
                          },
                          "total": {
                            "type": "number",
                            "format": "float"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "basicAuth": []
          }
        ]
      }
    },
    "/subscriptions": {
      "get": {
        "summary": "Subscription",
        "description": "### Retrieve Subscriptions for an Account\nThis endpoint retrieves a list of subscriptions associated with a specific account identified by `account_id`.\n",
        "operationId": "subscription",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/vnd.recurly.v2021-02-25": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "object": {
                      "type": "string"
                    },
                    "has_more": {
                      "type": "boolean"
                    },
                    "next": {
                      "type": "string"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "uuid": {
                            "type": "string"
                          },
                          "state": {
                            "type": "string"
                          },
                          "currency": {
                            "type": "string"
                          },
                          "total": {
                            "type": "number",
                            "format": "float"
                          },
                          "created_at": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "updated_at": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "account": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string"
                              },
                              "code": {
                                "type": "string"
                              },
                              "email": {
                                "type": "string"
                              },
                              "first_name": {
                                "type": "string"
                              },
                              "last_name": {
                                "type": "string"
                              }
                            }
                          },
                          "plan": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string"
                              },
                              "code": {
                                "type": "string"
                              },
                              "name": {
                                "type": "string"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "basicAuth": []
          }
        ]
      }
    }
  }
}
