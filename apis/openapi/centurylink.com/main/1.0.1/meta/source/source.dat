{
  "swagger": "2.0",
  "info": {
    "description": "This API allow users to retrieve information about Fulfilment Request originated in Salesforce Marvel. This Swagger describes the API in ESP, since direct connection to Salesforce will not be supported",
    "version": "1.0.1",
    "title": "Fulfillment Request",
    "contact": {
      "email": "vlocity@CenturyLink.com"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/CenturyLink_APIs/AUTOPILOT-adapter-vlocity/1.0.1"
  },
  "host": "api-dev2.centurylink.com",
  "basePath": "/Customer/v1/Ordering",
  "schemes": [
    "https"
  ],
  "paths": {
    "/vlocityFulfilmentRequest/{fulfilmentRequestId}/items": {
      "get": {
        "tags": [
          "fulfilmentRequest"
        ],
        "summary": "Get fulfilment request (FR) data and its associated fullfilment request line items (FRL)",
        "description": "Returns detail for a single fulfillment order",
        "operationId": "getFulfillmentRequestById",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "fulfilmentRequestId",
            "in": "path",
            "description": "18 digitis Salesforce ID of the fulfillment Request",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "schema": {
              "$ref": "#/definitions/FulfillmentRequest"
            }
          },
          "400": {
            "description": "Invalid fulfillment request ID supplied",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "404": {
            "description": "Fulfillment Request not found",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "500": {
            "description": "Unexpected Error",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "security": [
          {
            "AppKey": []
          },
          {
            "Digest": []
          },
          {
            "DigestTime": []
          }
        ]
      }
    }
  },
  "securityDefinitions": {
    "AppKey": {
      "type": "apiKey",
      "name": "X-Application-Key",
      "in": "header"
    },
    "Digest": {
      "type": "apiKey",
      "name": "X-Digest",
      "in": "header"
    },
    "DigestTime": {
      "type": "apiKey",
      "name": "X-Digest-Time",
      "in": "header"
    }
  },
  "definitions": {
    "Product": {
      "type": "object",
      "description": "This entity holds information about the product been fufiled",
      "properties": {
        "name": {
          "type": "string",
          "example": "LynkGroup Technical Product",
          "description": "Friendly Name of the Product"
        },
        "id": {
          "type": "string",
          "example": "01t3F000003vFwRQAU",
          "description": "18 digit Saleforce unique identifier of the product"
        },
        "code": {
          "type": "string",
          "example": "SVC_LynkGroup",
          "description": "Product unique identifier to be shared between systems"
        }
      },
      "required": [
        "id",
        "name",
        "code"
      ]
    },
    "Related": {
      "type": "object",
      "description": "This entity holds reference to another Fulfilment Request",
      "properties": {
        "name": {
          "type": "string",
          "description": "Friendly identifier of the fulfilment request in Vlocity/Salesforce",
          "example": "FR0000048"
        },
        "id": {
          "type": "string",
          "description": "18 digit Salesforce identifier of the fulfilment request in Vlocity/Salesforce",
          "example": "aRC2h000000DDB0GAM"
        },
        "mainProduct": {
          "$ref": "#/definitions/Product"
        }
      },
      "required": [
        "id",
        "name",
        "mainProduct"
      ]
    },
    "Rate": {
      "type": "object",
      "properties": {
        "upperBound": {
          "type": "number",
          "format": "decimal",
          "description": "Upper limit of a usage range, if null there is no upper limit",
          "example": 240
        },
        "ratePerUnit": {
          "type": "number",
          "format": "decimal",
          "description": "Charge per unit of mesure of the usage range",
          "example": 5.34
        },
        "rateDescritpion": {
          "type": "string",
          "description": "Description of the usage range",
          "example": "1000Mbps Tier 1"
        }
      },
      "required": [
        "ratePerUnit",
        "rateDescritpion"
      ]
    },
    "BillingAccount": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "18 digit Salesforce Id of the Billing Account"
        },
        "name": {
          "type": "string",
          "description": "Frindely name of the Billing Account sourced from Account Management"
        },
        "billingAccountNumber": {
          "type": "string",
          "description": "Kenan Identifier of the Billing Account"
        }
      }
    },
    "ServiceAccount": {
      "type": "object",
      "description": "This entity is returned to services based on a location",
      "properties": {
        "id": {
          "type": "string",
          "description": "18 digit Salesforce Id of the Service Account",
          "example": "a451h22222CaSzEEE"
        },
        "name": {
          "type": "string",
          "description": "Frindely name of the Site/Service Location sourced from GLM",
          "example": "FLOOR 2 ROOM 1"
        },
        "glmPLId": {
          "type": "string",
          "description": "GLM Site identifier associated to the service account",
          "example": "PL0000293239"
        },
        "glmSLId": {
          "description": "GLM Service Location identifier associated to the service account",
          "type": "string",
          "example": "SL0000343552"
        }
      }
    },
    "Attribute": {
      "type": "object",
      "description": "This entity represent a single comercial or technical attribute",
      "properties": {
        "label": {
          "type": "string",
          "description": "Frindely name of the Attribute",
          "example": [
            "Port Speed",
            "Fulfil Date"
          ]
        },
        "code": {
          "type": "string",
          "description": "Unique Identifier of the Attribute",
          "example": [
            "ATT_Port_Speed",
            "ATT_Fulfil_Date"
          ]
        },
        "value": {
          "type": "string",
          "description": "Value associated to the Attribute",
          "example": [
            "1 Gbps",
            "2019-10-18T14:58:11.047Z"
          ]
        }
      }
    },
    "AttributeCategory": {
      "type": "object",
      "description": "This entity represent a group of attributes",
      "properties": {
        "label": {
          "type": "string",
          "enum": [
            "Customer Info",
            "Dates",
            "Charges",
            "Additional Site"
          ]
        },
        "attributes": {
          "type": "array",
          "description": "List of Attributes",
          "items": {
            "$ref": "#/definitions/Attribute"
          }
        }
      }
    },
    "Customer": {
      "type": "object",
      "description": "This entity represent the customer associated the order that originated the fulfilment Request",
      "properties": {
        "name": {
          "type": "string",
          "description": "Account name in salesforce that the order is associated",
          "example": "ACME Company"
        },
        "customerId": {
          "type": "string",
          "description": "BizOrg Id",
          "example": "1-ABCDER"
        },
        "id": {
          "type": "string",
          "description": "salesforce record id of the account in green field org",
          "example": "abb2h000000DDB0SSS"
        }
      }
    },
    "FulfilmentRequestItem": {
      "type": "object",
      "properties": {
        "usageRates": {
          "type": "array",
          "description": "List of usage rates if the service has usage based charges",
          "items": {
            "$ref": "#/definitions/Rate"
          }
        },
        "serviceAlias": {
          "type": "string",
          "description": "Network service alias",
          "example": "CV/CMLD/23435"
        },
        "serviceAccount": {
          "$ref": "#/definitions/ServiceAccount"
        },
        "mainOrderLineItemId": {
          "description": "Main order line item that gave origin to the fulfilment Request",
          "type": "string"
        },
        "productInstanceId": {
          "type": "string",
          "description": "Unique Frindely Identifier for the associated service, visible to the customer",
          "example": "VLC012345"
        },
        "product": {
          "$ref": "#/definitions/Product",
          "description": "Main Technical product associated to the Fufilment Request Item"
        },
        "id": {
          "type": "string",
          "description": "18 digit Salesforce Id of the Fufilment Request Item",
          "example": "aO91h000000CaSzCAK"
        },
        "name": {
          "type": "string",
          "description": "Salesforce  Frindely  Name of the Fufilment Request Item",
          "example": "FRL012345"
        },
        "billingAccount": {
          "$ref": "#/definitions/BillingAccount"
        },
        "attributeCategories": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AttributeCategory"
          }
        },
        "action": {
          "type": "string",
          "description": "Indicate the action performed over the service: Add (New Service), Cancel (Cancel previos action associated to the same order), Disconnect (Disconnect an existing service), Modify (change on attributes od existing service, No Change (no action performed).",
          "enum": [
            "Add",
            "Cancel",
            "Disconnect",
            "Modify",
            "No Change"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "mainOrderLineItemId",
        "product",
        "attributeCategories",
        "action"
      ]
    },
    "FulfillmentRequest": {
      "type": "object",
      "properties": {
        "related": {
          "type": "array",
          "description": "Related Fulfilment Requests that were previous executed as part of Vlocity orchestration plan",
          "items": {
            "$ref": "#/definitions/Related"
          }
        },
        "previous": {
          "$ref": "#/definitions/Related"
        },
        "customer": {
          "$ref": "#/definitions/Customer"
        },
        "name": {
          "type": "string",
          "description": "Salesforce  Frindely  Name of the Fufilment Request",
          "example": "FR12345"
        },
        "id": {
          "type": "string",
          "example": "aRC1h0000004CB0GAM"
        },
        "items": {
          "type": "array",
          "description": "List of Fulfilment Request Items that are part of the parent Fulfiment Request",
          "items": {
            "$ref": "#/definitions/FulfilmentRequestItem"
          }
        },
        "orderId": {
          "type": "string",
          "description": "Salesforce 18 digit unique identifier of the order record in salesforce",
          "example": "abch0000004CB0XXX"
        }
      },
      "required": [
        "id",
        "name",
        "customer",
        "items",
        "orderId"
      ]
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "httpStatusCode": {
          "type": "integer",
          "description": "HTTP reponse code",
          "example": 400
        },
        "code": {
          "type": "string",
          "description": "System Code that represents the error",
          "example": "400003"
        },
        "message": {
          "type": "string",
          "description": "System message that describe in high level the exception reason",
          "example": "Invalid fulfillment request ID supplied"
        },
        "detail": {
          "type": "string",
          "description": "System message that describe in more detail the exception reason",
          "example": "Fulfilment Id {fulfilmentRequestId} Invalid fulfillment request ID supplied"
        }
      },
      "required": [
        "httpStatusCode",
        "message"
      ]
    }
  }
}
