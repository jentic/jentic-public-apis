{
  "openapi": "3.0.3",
  "info": {
    "title": "WHO Global Health Observatory OData API",
    "description": "OData-based API for accessing the World Health Organization Global Health Observatory data. Provides access to health indicators, dimension values, and statistical data across countries and regions.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://www.who.int/data/gho/info/gho-odata-api",
    "x-jentic-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://ghoapi.azureedge.net/api",
      "description": "WHO GHO OData API"
    }
  ],
  "paths": {
    "/Indicator": {
      "get": {
        "operationId": "listIndicators",
        "summary": "List all available health indicators",
        "tags": [
          "Indicators"
        ],
        "parameters": [
          {
            "name": "$filter",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "OData filter expression (e.g., contains(IndicatorName,'malaria') or IndicatorName eq 'Life expectancy')"
          },
          {
            "name": "$select",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated fields to return"
          },
          {
            "name": "$top",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Limit number of results"
          },
          {
            "name": "$orderby",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Sort results (e.g., 'IndicatorName asc')"
          }
        ],
        "responses": {
          "200": {
            "description": "List of indicators",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Indicator"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/{indicatorCode}": {
      "get": {
        "operationId": "getIndicatorData",
        "summary": "Get data for a specific indicator",
        "tags": [
          "Data"
        ],
        "parameters": [
          {
            "name": "indicatorCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Indicator code (e.g., 'WHOSIS_000001' for life expectancy)"
          },
          {
            "name": "$filter",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "OData filter (e.g., SpatialDim eq 'USA' and TimeDim ge 2010)"
          },
          {
            "name": "$select",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Fields to return"
          },
          {
            "name": "$top",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Limit results"
          },
          {
            "name": "$orderby",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Sort expression"
          }
        ],
        "responses": {
          "200": {
            "description": "Indicator data values",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/DataValue"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Indicator not found"
          }
        }
      }
    },
    "/Dimension": {
      "get": {
        "operationId": "listDimensions",
        "summary": "List all available dimensions",
        "tags": [
          "Dimensions"
        ],
        "responses": {
          "200": {
            "description": "List of dimensions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Dimension"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/DIMENSION/{dimensionCode}/DimensionValues": {
      "get": {
        "operationId": "getDimensionValues",
        "summary": "Get values for a specific dimension",
        "tags": [
          "Dimensions"
        ],
        "parameters": [
          {
            "name": "dimensionCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Dimension code (e.g., 'COUNTRY', 'REGION', 'SEX', 'AGEGROUP')"
          },
          {
            "name": "$filter",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "OData filter expression"
          },
          {
            "name": "$select",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Fields to select"
          },
          {
            "name": "$top",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Limit results"
          },
          {
            "name": "$orderby",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Sort expression"
          }
        ],
        "responses": {
          "200": {
            "description": "Dimension values",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/DimensionValue"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Dimension not found"
          }
        }
      }
    }
  },
