{
  "openapi": "3.0.3",
  "info": {
    "title": "Message Streaming APIs",
    "version": "1.0",
    "description": "Provides the means for an API client to post messages, such as events, to a Kafka topic for downstream consumers.",
    "contact": {
      "name": "Mike Muller",
      "email": "mmuller@shoprite.co.za"
    },
    "x-logo": {
      "url": ""
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/MAKOMANES_1/message-streaming-apis/1.0"
  },
  "servers": [
    {
      "url": "https://api.shoprite.com/datastreaming/",
      "description": "Shoprite data streaming APIs"
    }
  ],
  "paths": {
    "/messages/publishSingle": {
      "summary": "",
      "description": "",
      "post": {
        "requestBody": {
          "description": "Publishes a single in a single submission, to one or more (topic + partition) combinations. 'Round robin', 'message key', and 'partition number' partitioning strategies can be used here.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/publishSingleMessage"
              }
            }
          },
          "required": true
        },
        "tags": [
          "kafka",
          "kafka message streaming",
          "single message"
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/httpResponse"
                }
              }
            },
            "description": ""
          }
        },
        "operationId": "publishSingle",
        "summary": "Posts a single message (as multiples or as a specified batch to sticky partitions) to one or more specified (topic + partion) combinations. Should no partitioning be defined, the default will be 'round robin'.",
        "description": "Posts a single message to one or more specified (topic + partion) combinations. Multiple topics are used where the source message will be transformed before being published, e.g. where the content must be desensitised for a group of consumers."
      }
    },
    "/messages/publishMultiple": {
      "summary": "",
      "description": "",
      "post": {
        "requestBody": {
          "description": "Publishes multiple messages in a single submission, to one or more (topic + partition) combinations. 'Round robin', 'message key', 'sticky' (for batched messages) and 'partition number' partitioning strategies can be used here.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/publishMultipleMessages"
              }
            }
          },
          "required": true
        },
        "tags": [
          "kafka",
          "kafka message streaming",
          "multiple messages",
          "batched messages"
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/httpResponse"
                }
              }
            },
            "description": ""
          }
        },
        "operationId": "postBatchMessages",
        "summary": "Posts multiple messages (as multiples or as a specified batch to sticky partitions) to one or more specified (topic + partion) combinations. Should no partitioning be defined, the default will be 'round robin'.",
        "description": "Posts multiple messages (as multiples or as a specified batch to sticky partitions) to one or more specified (topic + partion) combinations. Multiple topics are used where the source message will be transformed before being published, e.g. where the content must be desensitised for a group of consumers."
      }
    }
  },
  "components": {
    "schemas": {
      "publishMessage": {
        "discriminator": {
          "propertyName": "publishVolume"
        },
        "description": "The must-inherit definition of posting a (Kafka) message to an API functioning as a Kafka producer proxy.",
        "required": [
          "contractID",
          "interfaceIdentifier",
          "publishVolume"
        ],
        "type": "object",
        "properties": {
          "contractID": {
            "format": "uuid",
            "description": "Functions as a proprietary form of an API key",
            "type": "string"
          },
          "interfaceIdentifier": {
            "description": "The interface identifier, as described in the architecture modelling repository, i.e. ARIS and SolDoc",
            "type": "string"
          },
          "publishVolume": {
            "enum": [
              "publishSingleMessage",
              "publishMultipleMessages",
              "publishBatchMessages"
            ],
            "type": "string"
          }
        }
      },
      "publishSingleMessage": {
        "description": "Publish a single in a single submission, to one or more (topic + partition). 'Round robin', 'message key', and 'partition number' partitioning strategies can be used here.",
        "required": [
          "message"
        ],
        "type": "object",
        "allOf": [
          {
            "$ref": "#/components/schemas/publishMessage"
          },
          {
            "type": "object"
          }
        ],
        "properties": {
          "message": {
            "$ref": "#/components/schemas/message"
          }
        }
      },
      "publishMultipleMessages": {
        "description": "Publish multiple messages in a single submission, to one or more (topic + partition). 'Round robin', 'message key', and 'partition number' partitioning strategies can be used here.",
        "required": [
          "messages"
        ],
        "type": "object",
        "allOf": [
          {
            "$ref": "#/components/schemas/publishMessage"
          },
          {
            "type": "object"
          }
        ],
        "properties": {
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/message"
            }
          }
        }
      },
      "publishBatchMessages": {
        "description": "Publish multiple messages as a batch, using a sticky partitioning strategy, to one or more (topic + partition).",
        "required": [
          "batchReference"
        ],
        "type": "object",
        "allOf": [
          {
            "$ref": "#/components/schemas/publishMultipleMessages"
          },
          {
            "type": "object"
          }
        ],
        "properties": {
          "batchReference": {
            "format": "uuid",
            "description": "Denotes a common batch reference for messages published to a topic using a sticky partioning strategy. The value of stickyPartition.batchReference must be the same as this property value and for all messages published to a given topic + partion combination",
            "type": "string"
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/message"
            }
          }
        }
      },
      "message": {
        "description": "The message that will be posted to a given Kafka topic.",
        "type": "object",
        "properties": {
          "targets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/messageTarget"
            }
          },
          "contentType": {
            "description": "The type of content in the message payload, as per MIME content types.",
            "type": "string",
            "example": "text/html, application/json, text/csv, text/calendar."
          },
          "content": {
            "$ref": "#/components/schemas/messageContent"
          }
        }
      },
      "messageContent": {
        "required": [
          "encoding",
          "payload"
        ],
        "type": "object",
        "properties": {
          "encoding": {
            "description": "The encoding of the contents of the message. Note: binary content must be base64 encoded.",
            "enum": [
              "UTF-8",
              "UTF-16",
              "base64"
            ],
            "type": "string"
          },
          "payload": {
            "description": "The contents which will be posted in the (Kafka) message. Note: Kafka has a default limit of 1MB per message",
            "type": "string"
          }
        }
      },
      "messageTarget": {
        "description": "The target topic + partition to which the (Kafka) message will be posted to.",
        "required": [
          "topic",
          "partition"
        ],
        "type": "object",
        "properties": {
          "topic": {
            "description": "The name of the topic to which the message will be posted to.",
            "type": "string"
          },
          "partition": {
            "$ref": "#/components/schemas/partition",
            "description": "The partion to which this message will be posted to within the given topic."
          }
        }
      },
      "partitionTarget": {
        "discriminator": {
          "propertyName": "targetType"
        },
        "description": "The partition target (type + identifier)",
        "required": [
          "targetType"
        ],
        "type": "object",
        "properties": {
          "targetType": {
            "enum": [
              "messageKeyTarget",
              "partitionNumberTarget"
            ],
            "type": "string"
          }
        }
      },
      "messageKeyTarget": {
        "required": [
          "messageKey"
        ],
        "type": "object",
        "allOf": [
          {
            "$ref": "#/components/schemas/partitionTarget"
          },
          {
            "type": "object"
          }
        ],
        "properties": {
          "messageKey": {
            "type": "string"
          }
        }
      },
      "partitionNumberTarget": {
        "required": [
          "partitionNumber"
        ],
        "type": "object",
        "allOf": [
          {
            "$ref": "#/components/schemas/partitionTarget"
          },
          {
            "type": "object"
          }
        ],
        "properties": {
          "partitionNumber": {
            "default": 0,
            "minimum": 0,
            "type": "integer"
          }
        }
      },
      "partition": {
        "discriminator": {
          "propertyName": "type"
        },
        "description": "The partition to which the message will be assigned to for a given topic.",
        "required": [
          "type"
        ],
        "type": "object",
        "properties": {
          "type": {
            "default": "roundRobinPartition",
            "enum": [
              "roundRobinPartition",
              "messageKeyPartition",
              "numberedPartition",
              "stickyPartition"
            ],
            "type": "string"
          }
        }
      },
      "messagekeyPartition": {
        "required": [
          "target"
        ],
        "type": "object",
        "allOf": [
          {
            "$ref": "#/components/schemas/partition"
          },
          {
            "type": "object"
          }
        ],
        "properties": {
          "target": {
            "$ref": "#/components/schemas/messageKeyTarget"
          }
        }
      },
      "numberedPartition": {
        "required": [
          "target"
        ],
        "type": "object",
        "allOf": [
          {
            "$ref": "#/components/schemas/partition"
          },
          {
            "type": "object"
          }
        ],
        "properties": {
          "target": {
            "$ref": "#/components/schemas/partitionNumberTarget"
          }
        }
      },
      "stickyPartition": {
        "required": [
          "batchReference",
          "target"
        ],
        "type": "object",
        "allOf": [
          {
            "$ref": "#/components/schemas/partition"
          },
          {
            "type": "object"
          }
        ],
        "properties": {
          "batchReference": {
            "format": "uuid",
            "description": "Denotes a common batch reference for messages published to a topic using a sticky partioning strategy. The value of publishBatchMessages.batchReference must be the same as this property value and for all messages published to a given topic + partion combination",
            "type": "string"
          },
          "target": {
            "$ref": "#/components/schemas/partitionTarget"
          }
        }
      },
      "httpResponse": {
        "required": [
          "type",
          "title",
          "status",
          "response",
          "requestId",
          "serverTime"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "number"
          },
          "response": {
            "$ref": "#/components/schemas/responseMessage"
          },
          "requestId": {
            "format": "uuid",
            "type": "string"
          },
          "serverTime": {
            "type": "string"
          }
        }
      },
      "responseMessage": {
        "required": [
          "message",
          "success"
        ],
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "success": {
            "type": "boolean"
          }
        }
      }
    },
    "securitySchemes": {
      "BasicAuth": {
        "scheme": "basic",
        "type": "http",
        "description": "Example:  > Authorization: Basic ZGVtbzpwQDU1dzByZA =="
      }
    },
    "headers": {},
    "responses": {},
    "parameters": {}
  },
  "security": [
    {
      "BasicAuth": []
    }
  ],
  "tags": [
    {
      "name": "kafka",
      "description": "Kafka"
    },
    {
      "name": "kafka message streaming",
      "description": "kafka message streaming"
    },
    {
      "name": "single message",
      "description": "Publish a single message to Kafka"
    },
    {
      "name": "batched messages",
      "description": "Publish batched messages to Kafka"
    },
    {
      "name": "multiple messages",
      "description": "Post multiple messages to Kafka in a single API call"
    }
  ],
  "externalDocs": {
    "description": "The API definition IFS, as per SolDoc.",
    "url": "https://soldoc.shoprite.com/datastreaming/definitions"
  }
}
