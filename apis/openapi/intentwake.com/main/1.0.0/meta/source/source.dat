{"openapi":"3.1.0","info":{"title":"IntentWake API","version":"1.0.0","description":"Customer API for batch lookups, intent taxonomy, list management, wallet visibility, and usage summaries. Fixed 60-second windows allow 60 requests per client IP per API service; every matched request consumes that service's IP budget. After authentication, key budgets allow 120 read-endpoint requests, 60 non-billed mutation-endpoint requests, and 30 requests to the billed batch-lookup endpoint per API key. The effective allowance is whichever independent IP or key budget is exhausted first. IP and key buckets use separate bounded pools; 429 responses include Retry-After. Limiter state is per daemon process and resets on restart."},"servers":[{"url":"https://api.intentwake.com"}],"paths":{"/api/v1/intent-taxonomy":{"get":{"operationId":"getIntentTaxonomy","summary":"Fetch the customer-safe intent taxonomy.","security":[{"bearerAuth":[]}],"x-required-scopes":["lookup","lists:monitoring"],"x-required-scope-mode":"any","responses":{"200":{"description":"Intent taxonomy returned.","content":{"application/json":{"schema":{}}}},"429":{"description":"Rate limit exceeded.","headers":{"Retry-After":{"description":"Seconds until the current rate-limit window resets.","schema":{"type":"integer","minimum":1}}},"content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string","const":"rate_limit_exceeded"},"message":{"type":"string","const":"Rate limit exceeded. Try again later."}},"required":["error","message"],"additionalProperties":false}}}},"default":{"description":"Error response.","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string"},"message":{"type":"string"}},"required":["error","message"],"additionalProperties":true}}}}}}},"/api/v1/lookups/batch":{"post":{"operationId":"batchLookup","summary":"Look up batches of email identifiers across requested services.","security":[{"bearerAuth":[]}],"x-required-scopes":["look