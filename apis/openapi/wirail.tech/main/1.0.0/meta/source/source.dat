{
  "openapi": "3.0.0",
  "servers": [
    {
      "description": "Wirail REST API",
      "url": "https://api.wirail.tech"
    }
  ],
  "info": {
    "description": "Wirail REST API Documentation updated. The wirail.rest.api from WiRail owner is deprecated",
    "version": "1.0.0",
    "title": "Wirail REST API",
    "contact": {
      "email": "wirail@wirail.it",
      "name": "Wirail"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/wirail-d25/wirail.rest.api/1.0.0"
  },
  "tags": [
    {
      "name": "login",
      "description": "Login Service"
    },
    {
      "name": "asset",
      "description": "Asset Service"
    },
    {
      "name": "job",
      "description": "Job Service"
    },
    {
      "name": "sensordata",
      "description": "SensorData Service"
    }
  ],
  "paths": {
    "/login/user/login": {
      "post": {
        "tags": [
          "login"
        ],
        "summary": "login into the system using Wirail's credentials",
        "responses": {
          "200": {
            "description": "Authentication successful"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CredentialItem"
              }
            }
          },
          "description": "Credentials to post"
        }
      }
    },
    "/login/client/profile": {
      "get": {
        "tags": [
          "login"
        ],
        "summary": "get user profile info",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserItem"
                }
              }
            }
          },
          "400": {
            "description": "User does not exist"
          },
          "401": {
            "description": "JWT token is missing or invalid"
          }
        }
      }
    },
