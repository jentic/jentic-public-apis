  "components": {
    "responses": {
      "UnauthorizedError": {
        "description": "JWT token is missing or invalid"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "AssetItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "object",
            "properties": {
              "timestamp": {
                "type": "integer",
                "example": 123456789
              },
              "date": {
                "type": "string",
                "example": "1970-01-00T00:00:00.000+00:00"
              }
            }
          },
          "numberPlate": {
            "type": "string",
            "example": 123123123123
          },
          "isOn": {
            "type": "boolean",
            "example": true
          },
          "listEnabledOp": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "date": {
                  "type": "string",
                  "example": "1970-01-00T00:00:00.000+00:00"
                },
                "username": {
                  "type": "string",
                  "example": "example@example.it"
                },
                "isOn": {
                  "type": "boolean",
                  "example": true
                }
              }
            }
          },
          "type": {
            "type": "string",
            "example": "Asset Type"
          },
          "isEnabled": {
            "type": "boolean",
            "example": true
          },
          "isConnected": {
            "type": "boolean",
            "example": false
          },
          "hubID": {
            "type": "string",
            "example": 123123123123123
          },
          "wirailID": {
            "type": "string",
            "example": "C1-000"
          },
          "imei": {
            "type": "string",
            "example": 123123123123123
          },
          "companyID": {
            "type": "string",
            "example": "Company ID"
          },
          "clientCompany": {
            "type": "string",
            "example": "Company Client"
          },
          "serviceCompany": {
