                  "results_url": "/api/v1/proxy-check/jobs/cj_7f1c0e5a4b3d4f0e9a2c6b8d1e3f5a70/results"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input. The body names the field and the accepted set."
          },
          "401": {
            "description": "Missing or invalid API key."
          },
          "429": {
            "description": "Rate limited. Retry after the delay in the response."
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      },
      "delete": {
        "operationId": "check-jobs-cancel",
        "summary": "Cancel a job",
        "description": "Stops a queued or running job. What it already answered stays downloadable until it expires, so cancelling a long run is a fine way to say \"that is enough of these\". A job that has already finished answers `409`; the lines it did not get to are not refunded.",
        "tags": [
          "Proxy checker API"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-API-Key",
            "in": "query",
            "required": true,
            "description": "Your hpx_ key.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input. The body names the field and the accepted set."
          },
          "401": {
            "description": "Missing or invalid API key."
          },
          "429": {
