                "schema": {
                  "type": "object"
                },
                "example": {
                  "deposit_id": "rpay_cmt9x2k1a0001",
                  "status": "paid",
                  "provider": "heleket",
                  "method": "crypto",
                  "amount_cents": 2500,
                  "received_cents": 2500,
                  "credited_cents": 2500,
                  "pay_url": null,
                  "created_at": "2026-09-04T09:12:41+00:00",
                  "settled_at": "2026-09-04T09:20:03+00:00"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input. The body names the field and the accepted set."
          },
          "401": {
            "description": "Missing or invalid API key."
          },
          "429": {
            "description": "Rate limited. Retry after the delay in the response."
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/api/v1/usage": {
      "get": {
        "operationId": "partner-usage-customer",
        "summary": "A customer's bandwidth history",
        "description": "With `X-Reseller-Customer-Id`, the named customer's traffic from the meter: one row per day and one per plan over the last `days` days (1 to 365, default 30). `gbUsed` is what was consumed that day; `null` means no reading exists for that day (a plan's first day, or a gap) and is never zero, and `unknownDays` counts those. Each day also carries `gbTotal` (the caps of the plans measured that day) and `gbLeft` (what they still held at the day's last reading), so how much a customer had and how much is left is a history, not a snapshot. Each plan line carries its cap, the meter at the last reading (`gbUsedEnd`) and `gbLeft`. Narrow to one plan with `plan_id`. What they bought is on [`GET /orders`](/docs/proxy-api/orders); this is what they used. Readings land every 30 minutes, one pass after the plan's own figures are synced, so a plan bought in the last hour may have no row yet; for a live figure read the plan itself (`GET /plans/{id}`).",
        "tags": [
          "Reseller API: act as your customers"
        ],
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "description": "Window in days, 1 to 365. Default 30.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "plan_id",
            "in": "query",
            "required": false,
            "description": "One plan only.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "days": 7,
                  "gbUsed": 3.42,
                  "unknownDays": 1,
                  "daily": [
                    {
                      "day": "2026-09-01",
                      "gbUsed": null,
                      "gbTotal": 10,
                      "gbLeft": 9.1,
                      "plans": 1,
                      "unknown": 1,
                      "meterResets": 0
                    },
                    {
                      "day": "2026-09-02",
                      "gbUsed": 1.2,
                      "gbTotal": 10,
                      "gbLeft": 7.9,
                      "plans": 1,
                      "unknown": 0,
                      "meterResets": 0
                    }
                  ],
                  "plans": [
                    {
                      "planId": "plan_…",
                      "product": "residential-premium",
                      "productName": "Residential Premium",
                      "label": null,
                      "gbUsed": 3.42,
                      "daysKnown": 6,
                      "unknownDays": 1,
                      "gbTotal": 10,
                      "gbUsedEnd": 4.3,
                      "gbLeft": 5.7
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid input. The body names the field and the accepted set."
          },
          "401": {
            "description": "Missing or invalid API key."
          },
          "429": {
            "description": "Rate limited. Retry after the delay in the response."
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/api/v1/store/usage": {
      "get": {
        "operationId": "partner-usage-store",
        "summary": "Your whole store's bandwidth",
        "description": "Account-level (no customer header): what all your customers used per day beside what you sold per day, per product, and the ten customers that used the most, over the last `days` days. `gb_used` is the meter, `gb_sold` is GB on paid orders by the day they were paid, `gb_total` and `gb_left` are what the measured plans had and still held at the day's last reading; the four are never mixed into one number. `unknown_days` counts plan-days without a reading. Readings land every 30 minutes, one pass after each plan's own figures are synced. Snake_case like the other account-level doors.",
        "tags": [
          "Reseller API: act as your customers"
        ],
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "description": "Window in days, 1 to 365. Default 30.",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "days": 30,
                  "totals": {
                    "gb_used": 41.2,
                    "gb_sold": 120,
                    "gb_total": 300,
                    "gb_left": 212.6,
                    "unknown_days": 3,
                    "plans": 17
                  },
                  "daily": [
                    {
                      "day": "2026-09-04",
                      "gb_used": 1.4,
                      "gb_total": 300,
                      "gb_left": 212.6,
                      "gb_sold": 10,
                      "plans": 17,
                      "unknown": 0,
                      "meter_resets": 0
                    }
                  ],
                  "products": [
                    {
                      "product": "residential-premium",
                      "product_name": "Residential Premium",
                      "gb_used": 30.1,
                      "plans": 9,
                      "unknown_days": 1,
                      "gb_sold": 80,
                      "orders": 12
                    }
                  ],
                  "customers": [
                    {
                      "external_id": "user-4021",
                      "label": "Ali",
                      "gb_used": 14.2,
                      "plans": 2
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid input. The body names the field and the accepted set."
          },
          "401": {
            "description": "Missing or invalid API key."
          },
          "429": {
            "description": "Rate limited. Retry after the delay in the response."
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/api/v1/customers": {
      "get": {
        "operationId": "partner-customers-list",
        "summary": "List your customers",
        "description": "Every customer on your account, newest first, with identity and credit, the read your backend reconciles against. This is an **account-level** call: send it **without** the `X-Reseller-Customer-Id` header (naming a customer here is refused with a `400` telling you to drop the header).",
        "tags": [
          "Reseller API: act as your customers"
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Page size, 1 to 200. Default 50.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "Rows to skip. Default 0.",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "customers": [
                    {
                      "externalId": "user-4021",
                      "label": "Alex M.",
                      "contactEmail": "alex@example.com",
                      "creditCents": 2500,
                      "createdAt": "2026-08-23T15:02:11+00:00",
                      "lastSeenAt": "2026-08-23T16:40:03+00:00"
                    },
                    {
