            "description": "Your hpx_ key.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "description": "Default ndjson. txt is the working proxies only; csv carries a header row.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "only",
            "in": "query",
            "required": false,
            "description": "Drop the dead rows (txt does this anyway).",
            "schema": {
              "type": "string"
            }
          }
        ],
