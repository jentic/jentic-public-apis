                  "type": "object"
                },
                "example": {
                  "customer": {
                    "externalId": "user-4021",
                    "label": "Alex M.",
                    "contactEmail": "alex@example.com",
                    "creditCents": 2500,
                    "createdAt": "2026-08-23T15:02:11+00:00",
                    "lastSeenAt": "2026-08-23T16:40:03+00:00"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input. The body names the field and the accepted set."
