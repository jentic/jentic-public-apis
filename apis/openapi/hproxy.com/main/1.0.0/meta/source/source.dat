          "401": {
            "description": "Missing or invalid API key."
          },
          "429": {
            "description": "Rate limited. Retry after the delay in the response."
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/api/v1/customer/contact": {
      "put": {
        "operationId": "partner-customer-contact",
        "summary": "Attach their identity",
        "description": "Set the customer's email and your display name for them, ideally right after your own signup flow, so your customer book, your business dashboard and our support all see a person instead of an opaque id. Each field: **omitted = unchanged, empty string = cleared, value = set**. We never send mail to this address; it is identity, not a channel.",
        "tags": [
          "Reseller API: act as your customers"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "customer": {
                    "externalId": "user-4021",
                    "label": "Alex M.",
                    "contactEmail": "alex@example.com",
                    "creditCents": 2500,
                    "createdAt": "2026-08-23T15:02:11+00:00",
                    "lastSeenAt": "2026-08-23T16:40:03+00:00"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input. The body names the field and the accepted set."
          },
          "401": {
            "description": "Missing or invalid API key."
          },
          "429": {
            "description": "Rate limited. Retry after the delay in the response."
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "description": "The customer's email address. Stored lowercased. Empty string clears it."
                  },
                  "label": {
                    "type": "string",
                    "description": "Your display name for them, 1 to 120 characters. Empty string clears it."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/customer/credit": {
      "put": {
        "operationId": "partner-customer-credit",
        "summary": "Credit or revoke their balance",
        "description": "Move store credit on the named customer, from your own backend: **grant** when they paid you, **revoke** for a refund on your side or a correction. Amounts are whole cents at your retail prices; one movement is at most $5,000. Send your own `request_id` for every movement (your payment id, your refund id): a repeat with the same id answers `409 already_applied` instead of moving the credit twice, so a retry is always safe. A revoke larger than what is left is refused (`revoke_exceeds_credit`) and names the remaining figure. Requires the `X-Reseller-Customer-Id` header.",
        "tags": [
          "Reseller API: act as your customers"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "customer": {
                    "externalId": "user-4021",
                    "label": "Alex M.",
                    "contactEmail": "alex@example.com",
                    "creditCents": 5000,
                    "createdAt": "2026-08-23T15:02:11+00:00",
                    "lastSeenAt": "2026-08-23T16:40:03+00:00"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input. The body names the field and the accepted set."
          },
          "401": {
            "description": "Missing or invalid API key."
          },
          "429": {
            "description": "Rate limited. Retry after the delay in the response."
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "amount_cents": {
                    "type": "integer",
                    "description": "Positive whole cents at your prices."
                  },
                  "direction": {
                    "type": "string",
                    "description": "\"grant\" or \"revoke\"."
                  },
                  "request_id": {
                    "type": "string",
                    "description": "Your id for this movement, one per intent, 1 to 100 characters."
                  },
                  "note": {
                    "type": "string",
                    "description": "Shown on your statement, up to 200 characters."
                  }
                },
                "required": [
                  "amount_cents",
                  "direction",
                  "request_id"
                ]
              }
            }
          }
        }
      }
    },
    "/api/v1/deposits/{id}": {
      "get": {
        "operationId": "partner-deposit-get",
        "summary": "Read one of your customers' payments",
        "description": "The state of a deposit your storefront created, for your own backend to show \"payment received\". `status` is `awaiting_payment`, `paid`, `paid_over`, `underpaid`, `expired`, `cancelled`, `failed`, `locked` (held by the gateway; nothing credited) or `needs_review`. `credited_cents` is what landed on the customer's store credit. Account-level: no customer header needed, and only your own deposits resolve.",
        "tags": [
          "Reseller API: act as your customers"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
