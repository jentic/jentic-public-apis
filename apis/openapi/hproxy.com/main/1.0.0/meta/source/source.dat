{
  "openapi": "3.1.0",
  "info": {
    "title": "HProxy API",
    "version": "1.0.0",
    "description": "Buy and manage proxies from a prepaid wallet, run the Scraper API, or use the free no-key APIs: a live proxy list, a proxy checker and an IP lookup. JSON in, JSON out. Money is always integer cents (120 = $1.20), never floats.",
    "contact": {
      "url": "https://hproxy.com/contact"
    },
    "license": {
      "name": "Proprietary"
    }
  },
  "servers": [
    {
      "url": "https://hproxy.com",
      "description": "Production"
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Your API key. Free keyless endpoints ignore it."
      }
    }
  },
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/api/v1/me": {
      "get": {
        "operationId": "me",
        "summary": "Who am I",
        "description": "The fastest check that a key works. Accepts **any** valid key (no scope needed) and echoes the account it acts for plus the scopes the key carries.",
        "tags": [
          "Account & wallet"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "userId": "usr_1a2b3c",
                  "email": "you@example.com",
                  "scopes": [
                    "buy",
                    "scrape"
                  ],
                  "dailySpendCapCents": null
                }
              }
            }
          },
          "400": {
            "description": "Invalid input. The body names the field and the accepted set."
          },
          "401": {
            "description": "Missing or invalid API key."
          },
          "429": {
            "description": "Rate limited. Retry after the delay in the response."
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/api/v1/wallet": {
      "get": {
        "operationId": "wallet",
        "summary": "Get wallet",
        "description": "Your current wallet balance, in integer cents.",
        "tags": [
          "Account & wallet"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "balanceCents": 25765,
                  "currency": "USD"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input. The body names the field and the accepted set."
          },
          "401": {
            "description": "Missing or invalid API key."
          },
          "429": {
            "description": "Rate limited. Retry after the delay in the response."
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/api/v1/deposits": {
      "post": {
        "operationId": "partner-deposit-create",
        "summary": "Let the named customer pay you",
        "description": "With `X-Reseller-Customer-Id`, this creates an invoice on **your own** payment gateway (connected under Payments in your business dashboard) and returns its pay page: crypto through Heleket or NOWPayments (`method: \"crypto\"`), cards through Stripe Checkout or Payoneer Checkout (`method: \"card\"`); one live gateway per rail. The page shows your merchant name, the money goes to your account, and when it arrives we credit the customer's store credit automatically: the exact amount, the whole amount when they overpay, and what actually arrived when a crypto invoice closes short. Amounts are whole cents; sub-floor amounts are raised to the method floor ($3 crypto, $10 card) and one invoice is at most $5,000. Send an `Idempotency-Key` and a retried request returns the same open invoice. No gateway for that method ⇒ `403 deposits_not_available`.\n\n**An order can pay for itself.** [`POST /orders`](/docs/proxy-api/orders) for a named customer with `method: \"crypto\"` or `\"card\"` and short credit still answers `402 customer_credit_insufficient`, but with `payUrl`, `depositId`, `chargeCents` (the shortfall raised to the rail's minimum) and `shortfallCents` added. Send the customer to `payUrl`: when the money lands, the credit is granted and the order is placed automatically under the same `Idempotency-Key`, a Telegram customer is told in the store's bot, and [`GET /deposits/{id}`](#partner-deposit-get) shows `for_order: true`. Without a gateway for that rail the 402 carries no pay page and the customer needs credit first.",
        "tags": [
          "Reseller API: act as your customers"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "deposit_id": "rpay_cmt9x2k1a0001",
                  "pay_url": "https://pay.heleket.com/pay/4f1c…",
                  "amount_cents": 2500,
                  "status": "awaiting_payment"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input. The body names the field and the accepted set."
          },
          "401": {
            "description": "Missing or invalid API key."
          },
          "429": {
            "description": "Rate limited. Retry after the delay in the response."
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "amount_cents": {
                    "type": "integer",
                    "description": "Whole cents at your prices."
                  },
                  "method": {
                    "type": "string",
                    "description": "\"crypto\" or \"card\". Default \"card\"."
                  },
                  "return_url": {
                    "type": "string",
                    "description": "Where the customer lands after paying (https). Default: your website, else your Telegram storefront."
                  }
                },
                "required": [
                  "amount_cents"
                ]
              }
            }
          }
        }
      }
    },
    "/api/v1/announcements": {
      "get": {
        "operationId": "announcements",
        "summary": "List live notices",
        "description": "Every published notice addressed to an audience your account belongs to, newest first, at most 50. Accepts **any** valid key (no scope needed). Poll it once an hour at most: it is not a queue, and nothing is lost by polling less. Branch on `kind`.",
        "tags": [
          "Service notices"
        ],
        "parameters": [
          {
            "name": "kind",
            "in": "query",
            "required": false,
            "description": "`INFO`, `MAINTENANCE`, `INCIDENT`, `RELEASE`, `PRICING` or `ACTION_REQUIRED`. Treat `ACTION_REQUIRED` as a ticket: an integration has something to change, usually with a date in the body.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "audience",
            "in": "query",
            "required": false,
            "description": "`ALL`, `CUSTOMERS`, `PARTNERS` or `DEVELOPERS`. Every account holding an API key is in `DEVELOPERS`, so notices about the API always reach you here.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "publishedAt, expiresAt",
            "in": "query",
            "required": false,
            "description": "The feed is ordered by `publishedAt`. An expired notice (a maintenance window that has passed) drops out on its own; `expiresAt` is `null` while a notice stands.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "linkHref, linkLabel",
            "in": "query",
            "required": false,
            "description": "An optional deep link, relative to hproxy.com or absolute. `null` when there is nothing more to read.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "unread",
            "in": "query",
            "required": false,
            "description": "Read state belongs to the account and is set from the dashboard, not from this endpoint. A key-only integration sees `true` until someone opens the notice there.",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "announcements": [
                    {
                      "id": "1f3c9a7e-…",
                      "title": "Order bodies are now strict: unknown fields return 400",
                      "body": "From 2026-09-03, POST /orders and every other write endpoint refuse a top-level field they do not read with 400 unknown_field. Check your client for fields outside the documented set.",
                      "kind": "ACTION_REQUIRED",
                      "audience": "DEVELOPERS",
                      "publishedAt": "2026-09-03T18:40:12+00:00",
                      "expiresAt": null,
                      "linkHref": "/docs/errors",
                      "linkLabel": "Errors",
                      "unread": true
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid input. The body names the field and the accepted set."
          },
          "401": {
            "description": "Missing or invalid API key."
          },
          "429": {
            "description": "Rate limited. Retry after the delay in the response."
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/api/v1/products": {
      "get": {
        "operationId": "products",
        "summary": "List products",
        "description": "The buyable catalog: for each product its family, its shape (what buying and delivery look like), its unit, description and features, its lifecycle, its published price, its quantity bounds and a how-to with the exact calls for that shape.",
        "tags": [
          "Products & pricing"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input. The body names the field and the accepted set."
          },
          "401": {
            "description": "Missing or invalid API key."
          },
          "429": {
            "description": "Rate limited. Retry after the delay in the response."
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/api/v1/products/{id}": {
      "get": {
        "operationId": "product-get",
        "summary": "Read one product",
        "description": "One product by its id, or by any id it used to carry, with its lifecycle. A retired product answers `200` with `state: \"retired\"` and `successorId`, never a `404`, so a menu built from an old catalog can tell its customer what to buy now. `state` is `active`, `parked` (listed, orders answer `409 product_unavailable` until it is back) or `retired`. `family` names the umbrella (`residential`, `isp`, `mobile`, `ipv4`, `ipv6`) so a storefront groups products without guessing from the name. `shape` says what buying and delivery look like, and it is what to key an integration on, never a list of ids: `gateway_gb` and `gateway_time` are a plan you generate lines from (`delivery` is `lines`), `addresses` and `addresses_mobile` are dedicated IPs that land in [proxies](/docs/proxy-api/proxies) (`delivery` is `addresses`). `renewal` is `topup` (order again, the units land on the plan you hold), `repurchase` (a fresh plan for a fresh period) or `extend` (an extension naming the addresses to keep). `howTo` spells the exact calls for that shape, from the price to the first use, with the targeting fields its network takes. A product we add on a known shape works in your code the day it lands.",
        "tags": [
          "Products & pricing"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "id": "residential-lite",
                  "name": "Residential Lite",
                  "family": "residential",
                  "state": "active",
                  "successorId": null,
                  "available": true,
                  "shape": "gateway_gb",
                  "unit": "GB",
                  "delivery": "lines",
                  "renewal": "topup",
                  "minQuantity": 1,
                  "maxQuantity": 10000,
                  "billing": {
                    "payg": true,
                    "subscription": true,
                    "intervals": [
                      "month",
                      "year"
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input. The body names the field and the accepted set."
          },
          "401": {
            "description": "Missing or invalid API key."
          },
          "429": {
            "description": "Rate limited. Retry after the delay in the response."
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/api/v1/products/{id}/price": {
      "get": {
        "operationId": "price",
        "summary": "Price a product",
        "description": "A server-authoritative quote: the exact amount `POST /orders` will charge for the same inputs. Pass the quantity as a query parameter. For dedicated per-IP products, add `country` and `period_days` to quote the exact targeting you'll order. Omitted, they default to `USA` / 30 days.\n\n**On a reseller key** the answer also says what the order costs **you**: `yourCostCents` is what we debit from your balance when one of your customers places it, `amountCents` is what that customer pays (your retail or markup, else our price), `marginCents` is the difference, `listCents` is our own price, and `note` spells out which is which. To see every period of a country at once, use the [price list](#price-list).",
        "tags": [
          "Products & pricing"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "quantity",
            "in": "query",
            "required": true,
            "description": "GB for residential, or number of IPs for dedicated products.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "Per-IP products: target country, alpha-3 (e.g. USA, DEU). Default USA.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "period_days",
            "in": "query",
            "required": false,
            "description": "Per-IP products: rental period in days (e.g. 30, 90). Default 30.",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "productId": "residential-lite",
                  "quantity": 5,
                  "unitPriceCents": 100,
                  "amountCents": 500,
                  "currency": "USD",
                  "billingType": "PAYG"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input. The body names the field and the accepted set."
          },
          "401": {
            "description": "Missing or invalid API key."
          },
          "429": {
            "description": "Rate limited. Retry after the delay in the response."
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/api/v1/products/{id}/price-list": {
      "get": {
        "operationId": "price-list",
        "summary": "Price list for a country",
        "description": "For **dedicated per-IP products** (ISP, IPv4, IPv6 and mobile IPs): every rental period of one country priced in one call, so you can print a price table without one quote per period. Each line carries `listCents`, our price for the order, and `available` (false when that period is sold out right now). Mobile answers one line per carrier, service and rotation mode for one period instead (pick it with `period_days`; the carrier ids go straight into `fulfillment_meta`), from the day's price refresh, so quote one mobile order with [price](#price) for the exact figure.\n\n**On a reseller key every line also says what it costs you**: `yourCostCents` is what we debit from your balance when one of your customers orders that line, `customerCents` what that customer pays (our price times your markup), and `marginCents` what you keep; `partner` states your discount, your markup and whether the product is on your catalog. The same table is under Pricing in your business dashboard. Products sold per GB or per speed tier answer `400 no_price_list`: they have one price per unit, which [price](#price) quotes.",
        "tags": [
          "Products & pricing"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "country",
            "in": "query",
            "required": true,
            "description": "Alpha-3 from [options](#options), e.g. USA.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "quantity",
            "in": "query",
            "required": false,
            "description": "How many IPs every line prices. Default: the product's smallest order (1, or 10 for IPv6). A bigger order can cost less per IP.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "period_days",
            "in": "query",
            "required": false,
            "description": "Mobile only: the period every carrier is priced for. Default 30.",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "productId": "isp",
                  "unit": "IP",
                  "country": "USA",
                  "quantity": 1,
                  "currency": "USD",
                  "countries": [
                    {
                      "alpha3": "USA",
                      "name": "United States"
                    },
                    {
                      "alpha3": "TUR",
                      "name": "Turkey"
                    }
                  ],
                  "partner": {
                    "discountPct": 20,
                    "markup": 1.3,
                    "sellable": true
                  },
                  "lines": [
                    {
                      "days": 7,
                      "period": "1 week",
                      "available": true,
                      "listCents": 250,
                      "yourCostCents": 200,
                      "customerCents": 325,
                      "marginCents": 125
                    },
                    {
                      "days": 30,
                      "period": "1 month",
                      "available": true,
                      "listCents": 270,
                      "yourCostCents": 216,
                      "customerCents": 351,
                      "marginCents": 135
                    }
                  ],
                  "note": "listCents is our own price for this order. yourCostCents is what we debit from your balance when one of your customers orders it …"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input. The body names the field and the accepted set."
          },
          "401": {
            "description": "Missing or invalid API key."
          },
          "429": {
            "description": "Rate limited. Retry after the delay in the response."
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/api/v1/products/{id}/options": {
      "get": {
        "operationId": "options",
        "summary": "Available countries & periods",
        "description": "For **dedicated per-IP products** (IPv4, IPv6, ISP), the live list of countries you can order and the rental periods available, so you can build a picker without hardcoding anything. Countries come back as `{ name, alpha3 }` and are **kept current for you**: the list is refreshed from stock and a country that has run out is removed automatically, so what this returns is always orderable. Feed an `alpha3` straight into the `country` of [price](#price) and [orders](/docs/proxy-api/orders), and a `days` into `period_days`. Gateway products (`delivery` is `lines`: residential, mobile, ISP rotating, IPv4 and IPv6 per GB) have no per-country configurator and return `400 no_options`: they target by country at generation time instead (see [generate](/docs/proxy-api/plans#generate)).",
        "tags": [
          "Products & pricing"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "productId": "ipv4",
                  "unit": "IP",
                  "minQuantity": 1,
                  "maxQuantity": 1000,
                  "countries": [
                    {
                      "name": "United States",
                      "alpha3": "USA"
                    },
                    {
                      "name": "Germany",
                      "alpha3": "DEU"
                    },
                    {
                      "name": "United Kingdom",
                      "alpha3": "GBR"
                    }
                  ],
                  "periods": [
                    {
                      "days": 30,
                      "label": "30 days"
                    },
                    {
                      "days": 90,
                      "label": "90 days"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid input. The body names the field and the accepted set."
          },
          "401": {
            "description": "Missing or invalid API key."
          },
          "429": {
            "description": "Rate limited. Retry after the delay in the response."
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/api/v1/orders": {
      "post": {
        "operationId": "orders-create",
        "summary": "Create an order",
        "description": "Buy a product. By default this is a wallet prepay: it debits your balance and returns immediately, or fails with `402` if the balance is short (it never silently charges a card you didn't pick). Set `method` to `\"card\"` or `\"crypto\"` to get a hosted `payUrl` back instead. Always send an `Idempotency-Key` so a retry never double-charges; on a reseller key an order without one is refused.\n\nThe body takes **only the five fields below**. Anything else, including a top-level `country`, is refused with `400 unknown_field` before anything is charged. What goes in it depends on the product's `delivery` on [GET /products](/docs/proxy-api/products).\n\n**Residential and other gateway products** (`delivery` is `lines`): send `product_id` and `quantity`, nothing else. There is no country in the order. You choose the country for each line when you [generate lines](/docs/proxy-api/plans#generate) from the plan, so one plan serves every country. A package size is the `quantity` (1 GB is `1`, 10 GB is `10`), never a separate product id, and it is a whole number from the product's `minQuantity`.\n\n**Dedicated IPs** (`delivery` is `addresses`: IPv4, IPv6, ISP and mobile IPs): `quantity` counts IPs, and the targeting goes inside `fulfillment_meta`, for example `{\"country\": \"DEU\", \"period_days\": 30}`.",
        "tags": [
          "Orders"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input. The body names the field and the accepted set."
          },
          "401": {
            "description": "Missing or invalid API key."
          },
          "429": {
            "description": "Rate limited. Retry after the delay in the response."
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "product_id": {
                    "type": "string",
                    "description": "A product id from GET /products, e.g. \"residential-lite\"."
                  },
                  "quantity": {
                    "type": "integer",
                    "description": "A whole number; a fraction is refused. GB for residential and other per-GB products, or number of IPs for dedicated products, between the product's `minQuantity` and `maxQuantity`. For renewals: the number of ids."
                  },
                  "method": {
                    "type": "string",
                    "description": "\"wallet\" (default), \"card\" or \"crypto\". card/crypto return a payUrl."
                  },
                  "fulfillment_meta": {
                    "type": "object",
                    "description": "Dedicated IPs: country (alpha-3, e.g. \"DEU\"), period_days, and operator_id on mobile. For a RENEWAL of dedicated proxies: {\"kind\": \"extension\", \"ids\": [\"…\"], \"period_days\": 30} (ids from GET /proxies, ownership-checked server-side). Leave it out for residential and other per-GB products: you choose their country per line at POST /plans/{id}/generate."
                  },
                  "expected_amount_cents": {
                    "type": "integer",
                    "description": "The total you showed the buyer (the `amountCents` of your quote). If the price moved in between, the order is refused with `409 price_changed` carrying the new `amountCents`, and nothing is charged. Omit it to be charged the price at the moment of the order."
                  }
                },
                "required": [
                  "product_id",
                  "quantity"
                ]
              }
            }
          }
        }
      },
      "get": {
        "operationId": "orders-list",
        "summary": "List orders",
        "description": "Your order history, newest first, one page at a time. Without parameters you get the 15 most recent.",
        "tags": [
          "Orders"
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Page size, 1 to 200. Default 15. A larger value is capped at 200.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "Rows to skip, newest first. Default 0. Page 3 of 50 is `limit=50&offset=100`.",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "orders": [
                    {
                      "orderId": "ord_8f491789-58cd-4e82-81a2-ec7c28088821",
                      "productId": "residential-lite",
                      "type": "PURCHASE",
                      "status": "PAYMENT_RECEIVED",
                      "quantityGb": 1,
                      "amountCents": 120,
                      "currency": "USD",
                      "createdAt": "2026-07-11T09:46:05.191+00:00"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid input. The body names the field and the accepted set."
          },
          "401": {
            "description": "Missing or invalid API key."
          },
          "429": {
            "description": "Rate limited. Retry after the delay in the response."
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
