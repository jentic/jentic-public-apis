    "/permissions/list-objects": {
      "post": {
        "operationId": "listPermissionObjects",
        "summary": "List objects a subject has access to",
        "description": "Returns a list of objects that a given subject (user or group) has access to.",
        "tags": [
          "Permissions"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "subject"
                ],
                "properties": {
                  "subject": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "user",
                          "group"
                        ]
                      },
                      "id": {
                        "type": "string"
                      }
                    }
                  },
                  "object_type": {
                    "type": "string"
                  },
                  "access_level": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "List of accessible objects"
          }
        }
      }
    },
    "/permissions/grant": {
      "post": {
        "operationId": "grantPermission",
        "summary": "Grant permission to a subject",
        "description": "Grants a specific access level to a subject for a given object.",
        "tags": [
          "Permissions"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "subject",
                  "object",
                  "access_level"
                ],
                "properties": {
                  "subject": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "user",
                          "group"
                        ]
                      },
                      "id": {
                        "type": "string"
                      }
                    }
                  },
                  "object": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string"
                      },
                      "id": {
                        "type": "string"
                      }
                    }
                  },
                  "access_level": {
                    "type": "string",
                    "enum": [
                      "use",
                      "edit",
                      "own"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Permission granted"
          }
        }
      }
    },
    "/permissions/revoke": {
      "post": {
        "operationId": "revokePermission",
        "summary": "Revoke permission from a subject",
        "description": "Revokes a specific access level from a subject for a given object.",
        "tags": [
          "Permissions"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "subject",
                  "object",
                  "access_level"
                ],
                "properties": {
                  "subject": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string"
                      },
                      "id": {
                        "type": "string"
                      }
                    }
                  },
                  "object": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string"
                      },
                      "id": {
                        "type": "string"
                      }
                    }
                  },
                  "access_level": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Permission revoked"
          }
        }
      }
    },
    "/source_control/settings": {
      "get": {
        "operationId": "getSourceControlSettings",
        "summary": "Get source control settings",
        "description": "Returns the current source control configuration.",
        "tags": [
          "Source Control"
        ],
        "responses": {
          "200": {
            "description": "Source control settings",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "provider": {
                          "type": "string"
                        },
                        "org": {
                          "type": "string"
                        },
                        "repo": {
                          "type": "string"
                        },
                        "default_branch": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "updateSourceControlSettings",
        "summary": "Update source control settings",
        "description": "Updates the source control configuration for the organization.",
        "tags": [
          "Source Control"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "provider": {
                    "type": "string",
                    "enum": [
                      "github",
                      "gitlab",
                      "bitbucket",
                      "azure_devops"
                    ]
                  },
                  "org": {
                    "type": "string"
                  },
                  "repo": {
                    "type": "string"
                  },
                  "default_branch": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Settings updated"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Bearer token authentication. Generate tokens in Settings > Retool API. Tokens support scope-based permissions for Users, Groups, Folders, Permissions, Spaces, Source Control, and App Themes."
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "first_name": {
            "type": "string"
          },
          "last_name": {
            "type": "string"
          },
          "active": {
            "type": "boolean"
          },
          "is_admin": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "last_active": {
            "type": "string",
            "format": "date-time"
          },
          "metadata": {
            "type": "object"
          }
        }
      },
      "Group": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "universal_app_access": {
            "type": "string"
          },
          "universal_resource_access": {
            "type": "string"
          },
          "user_list_access": {
            "type": "boolean"
          },
          "audit_log_access": {
            "type": "boolean"
          },
          "unpublished_release_access": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "members": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/User"
            }
          }
        }
      },
      "Folder": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "parent_folder_id": {
            "type": "string",
            "nullable": true
          },
          "folder_type": {
            "type": "string"
          },
          "is_system_folder": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Space": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
