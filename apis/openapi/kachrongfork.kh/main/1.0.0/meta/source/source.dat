{
  "openapi": "3.0.0",
  "info": {
    "title": "Cambodia Smart Banking + Web3 API",
    "description": "Hybrid CeDeFi API for fiat (KHR via KHQR/Bakong) and crypto (USDC swaps on Polygon). Non-custodial.",
    "version": "1.0.0",
    "contact": {
      "name": "API Support",
      "email": "support@yourapp.kh"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/VANNAKKM33/kachrongfork/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.kachrongfork.kh/v1",
      "description": "Production"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "email": {
            "type": "string"
          },
          "kyc_status": {
            "type": "string",
            "enum": [
              "pending",
              "verified",
              "rejected"
            ]
          }
        }
      },
      "Transaction": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "amount": {
            "type": "number",
            "format": "decimal"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "completed",
              "failed"
            ]
          },
          "metadata": {
            "type": "object"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "detail": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/auth/register": {
      "post": {
        "summary": "Register user (triggers KYC)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  },
                  "phone": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created",
            "content": {
              "application/json": {
                "example": {
                  "id": 1,
                  "email": "user@example.com",
                  "kyc_status": "pending"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "example": {
                  "code": 400,
                  "message": "Email exists"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Login with JWT",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token granted",
            "content": {
              "application/json": {
                "example": {
                  "access_token": "eyJ...",
                  "refresh_token": "eyJ..."
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/wallets/fiat": {
      "get": {
        "summary": "Get fiat wallets (requires auth)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Wallets list",
            "content": {
              "application/json": {
                "example": [
                  {
                    "currency": "KHR",
                    "balance": 1000000.0,
                    "khqr_id": "khqr_abc123"
                  }
                ]
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create fiat wallet",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "currency": {
                    "type": "string",
                    "enum": [
                      "KHR",
                      "USD"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Wallet created",
            "content": {
              "application/json": {
                "example": {
                  "id": 1,
                  "balance": 0.0
                }
              }
            }
          }
        }
      }
    },
    "/wallets/crypto": {
      "get": {
        "summary": "Get crypto wallets",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Wallets",
            "content": {
              "application/json": {
                "example": [
                  {
                    "address": "0x123...",
                    "chain": "polygon",
                    "balance": 100.0
                  }
                ]
              }
            }
          }
        }
      },
      "post": {
        "summary": "Generate new crypto address (non-custodial)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "chain": {
                    "type": "string"
                  },
                  "token": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Address generated"
          }
        }
      }
    },
    "/transactions/khqr/generate": {
      "post": {
        "summary": "Generate KHQR for deposit",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "amount": {
                    "type": "number"
                  },
                  "currency": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "KHQR code",
            "content": {
              "application/json": {
                "example": {
                  "khqr_url": "https://bakong.kh/qr?data=...",
                  "reference_id": "tx_123"
                }
              }
            }
          }
        }
      }
    },
    "/transactions/transfer": {
      "post": {
        "summary": "Fiat transfer via Bakong",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "to_account": {
                    "type": "string"
                  },
                  "amount": {
                    "type": "number"
                  },
                  "currency": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Transfer initiated",
            "content": {
              "application/json": {
                "example": {
                  "id": 1,
                  "status": "pending",
                  "reference_id": "bakong_tx_456"
                }
              }
            }
          }
        }
      }
    },
    "/transactions/swap": {
      "post": {
        "summary": "DEX swap (via 1inch aggregator)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "from_token": {
                    "type": "string"
                  },
                  "to_token": {
                    "type": "string"
                  },
                  "amount": {
                    "type": "number"
                  },
                  "wallet_address": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Swap quote & tx data",
            "content": {
              "application/json": {
                "example": {
                  "quote": 99.5,
                  "tx_hash": "0xabc...",
                  "gas_estimate": 200000
                }
              }
            }
          }
        }
      }
    },
    "/transactions": {
      "get": {
        "summary": "List user transactions",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Transactions",
            "content": {
              "application/json": {
                "example": [
                  {
                    "id": 1,
                    "type": "transfer_fiat",
                    "amount": 50000.0,
                    "status": "completed",
                    "created_at": "2025-12-17T10:00:00Z"
                  }
                ]
              }
            }
          }
        }
      }
    }
  }
}
