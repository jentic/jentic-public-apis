{"openapi":"3.1.0","info":{"title":"RunDossier API","version":"1.0.0","description":"Generate executive pre-meeting dossiers programmatically. Create dossiers, poll their status, and fetch the finished briefing. Human-readable docs live at https://rundossier.com/docs/api.","contact":{"name":"RunDossier Support","url":"https://rundossier.com/support"},"license":{"name":"Proprietary","identifier":"LicenseRef-Proprietary"}},"servers":[{"url":"https://rundossier.com/api/v1","description":"Production"}],"security":[{"bearerAuth":[]}],"paths":{"/dossiers":{"post":{"operationId":"createDossier","summary":"Create a dossier","description":"Deducts one credit, creates the dossier, and dispatches it for generation. Returns immediately with status `pending`.","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateDossierRequest"}}}},"responses":{"201":{"description":"Dossier created and queued.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateDossierResponse"}}}},"400":{"description":"The request body is missing or invalid.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"The API key is missing, malformed, unknown, or revoked.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"402":{"description":"The credit balance is zero.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Too many requests. Retry after the indicated number of seconds.","headers":{"Retry-After":{"description":"Seconds to wait before retrying.","schema":{"type":"integer"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}},"get":{"operationId":"listDossiers","summary":"List dossiers","description":"Lists the caller's non-deleted dossiers, newest first. Cursor-paginated.","parameters":[{"name":"limit","in":"query","required":false,"description":"Maximum results to return. Capped at 50.","schema":{"type":"integer","minimum":1,"maximum":50,"default":20}},{"name":"before","in":"query","required":false,"description":"ISO 8601 timestamp; returns dossiers created strictly before it. Pass the previous response's `next_before` to page.","schema":{"type":"string","format":"date-time"}}],"responses":{"200":{"description":"A page of dossiers.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DossierListResponse"}}}},"400":{"description":"The `before` cursor is not a valid ISO 8601 timestamp.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"The API key is missing, malformed, unknown, or revoked.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Too many requests. Retry after the indicated number of seconds.","headers":{"Retry-After":{"description":"Seconds to wait before retrying.","schema":{"type":"integer"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/dossiers/{id}":{"get":{"operationId":"getDossier","summary":"Retrieve a dossier","description":"Returns the current state of one of the caller's dossiers. Poll this to track progress. `word_doc_url` is a signed download link valid for 5 minutes.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"The dossier. `candidate_profiles` is present only when `status` is `awaiting_selection`.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DossierDetail"}}}},"401":{"description":"The API key is missing, malformed, unknown, or revoked.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"No dossier with that id belongs to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Too many requests. Retry after the indicated number of seconds.","headers":{"Retry-After":{"description":"Seconds to wait before retrying.","schema":{"type":"integer"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/dossiers/{id}/select":{"post":{"operationId":"selectDossierProfile","summary":"Resolve a disambiguation","description":"Resolves a dossier in the `awaiting_selection` state. Provide the `url` of the chosen candidate to continue, or `null` to cancel and refund the credit.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SelectRequest"}}}},"responses":{"200":{"description":"Selecting a profile returns `processing`; cancelling returns `error`.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SelectResponse"}}}},"400":{"description":"The body is invalid, `selected_url` is not a candidate URL, or the dossier is not awaiting selection.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"The API key is missing, malformed, unknown, or revoked.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"No dossier with that id belongs to the caller.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Too many requests. Retry after the indicated number of seconds.","headers":{"Retry-After":{"description":"Seconds to wait before retrying.","schema":{"type":"integer"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/credits":{"get":{"operationId":"getCredits","summary":"Get credit balance","description":"Returns the caller's credit balance across both pools.","responses":{"200":{"description":"The current credit balance.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Credits"}}}},"401":{"description":"The API key is missing, malformed, unknown, or revoked.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Too many requests. Retry after the indicated number of seconds.","headers":{"Retry-After":{"description":"Seconds to wait before retrying.","schema":{"type":"integer"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}}},"components":{"securitySchemes":{"bearerAuth":{"type":"http","scheme":"bearer","bearerFormat":"dsk_live_...","description":"A personal API key created in Settings → API Keys."}},"schemas":{"Error":{"type":"object","required":["error"],"properties":{"error":{"type":"object","required":["code","message"],"properties":{"code":{"type":"string","description":"Machine-readable error code.","examples":["invalid_request","invalid_state","unauthorized","insufficient_credits","not_found","rate_limited","internal_error"]},"message":{"type":"string","description":"Human-readable explanation."}}}}},"CandidateProfile":{"type":"object","required":["url","title"],"properties":{"url":{"type":"string","format":"uri"},"title":{"type":"string"},"headline":{"type":"string"},"location":{"type":"string"},"current_role":{"type":"string"},"current_company":{"type":"string"}}},"CreateDossierRequest":{"type":"object","required":["subject_name"],"properties":{"subject_name":{"type":"string","minLength":1,"maxLength":200,"description":"The person to research."},"context":{"type":"string","maxLength":1000,"description":"Extra context to focus or disambiguate the research."}}},"CreateDossierResponse":{"type":"object","required":["id","status"],"properties":{"id":{"type":"string","format":"uuid"},"status":{"type":"string","const":"pending"}}},"SelectRequest":{"type":"object","required":["selected_url"],"properties":{"selected_url":{"type":["string","null"],"description":"A candidate `url` to proceed with, or `null` to cancel and refund."}}},"SelectResponse":{"type":"object","required":["id","status"],"properties":{"id":{"type":"string","format":"uuid"},"status":{"type":"string","enum":["processing","error"]}}},"DossierSummary":{"type":"object","required":["id","status","subject_name","error_message","created_at","duration_ms"],"properties":{"id":{"type":"string","format":"uuid"},"status":{"type":"string","enum":["pending","processing","awaiting_selection","complete","error"]},"subject_name":{"type":"string"},"error_message":{"type":["string","null"]},"created_at":{"type":"string","format":"date-time"},"duration_ms":{"type":["integer","null"]}}},"DossierDetail":{"type":"object","required":["id","status","subject_name","status_message","error_message","result_markdown","google_doc_url","word_doc_url","photo_url","created_at","duration_ms"],"properties":{"id":{"type":"string","format":"uuid"},"status":{"type":"string","enum":["pending","processing","awaiting_selection","complete","error"]},"subject_name":{"type":"string"},"status_message":{"type":["string","null"]},"error_message":{"type":["string","null"]},"result_markdown":{"type":["string","null"]},"google_doc_url":{"type":["string","null"]},"word_doc_url":{"type":["string","null"],"description":"Signed S3 download link for the Word export, valid for 5 minutes."},"photo_url":{"type":["string","null"]},"created_at":{"type":"string","format":"date-time"},"duration_ms":{"type":["integer","null"]},"candidate_profiles":{"type":"array","description":"Present only when `status` is `awaiting_selection`.","items":{"$ref":"#/components/schemas/CandidateProfile"}}}},"DossierListResponse":{"type":"object","required":["dossiers","next_before"],"properties":{"dossiers":{"type":"array","items":{"$ref":"#/components/schemas/DossierSummary"}},"next_before":{"type":["string","null"],"format":"date-time","description":"Cursor for the next page, or null when there are no more results."}}},"Credits":{"type":"object","required":["monthly","topup","total"],"properties":{"monthly":{"type":"integer","description":"Recurring plan allowance."},"topup":{"type":"integer","description":"Purchased credits."},"total":{"type":"integer","description":"Sum of both pools."}}}}}}