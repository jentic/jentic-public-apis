                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Invalid media type or file format"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "N\u00e3o autorizado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
