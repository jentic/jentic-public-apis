{
  "openapi": "3.0.0",
  "info": {
    "version": "1.0.0",
    "title": "Kikz Forms AZG",
    "description": "An api to load a form remotely, thats generated in a donatie platform.",
    "termsOfService": "https://kikz.nl/termsofservice",
    "contact": {
      "name": "Ruben Peters",
      "url": "https://kikz.nl/",
      "email": "contact@kikz.nl"
    },
    "license": {
      "name": "KikzForms",
      "url": "https://kikz.nl/"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/kikz-75b/KikzFormsAZG/1.0.0"
  },
  "servers": [
    {
      "description": "SwaggerHub API Auto Mocking",
      "url": "https://virtserver.swaggerhub.com/kikz-75b/KikzFormsAZG/1.0.0"
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "API key for authentication"
      }
    }
  },
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/api/subscription/get_formulier_data": {
      "get": {
        "description": "Obtain data regarding the form, termijn, bedrag.",
        "responses": {
          "200": {
            "description": "Formulier Data array.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "properties": {
                      "id": {
                        "type": "integer",
                        "example": 2
                      },
                      "naam": {
                        "type": "string",
                        "example": "Donatie formulier"
                      },
                      "title": {
                        "type": "string",
                        "example": "ja, ik geef vpro cadeau"
                      },
                      "campaigns": {
                        "type": "array",
                        "items": {
                          "properties": {
                            "campaignID": {
                              "type": "string",
                              "example": "Geef VPRO cadeau"
                            }
                          }
                        }
                      },
                      "termijn": {
                        "type": "array",
                        "items": {
                          "properties": {
                            "id": {
                              "type": "integer",
                              "example": 2
                            },
                            "naam": {
                              "type": "string",
                              "example": "Geef VPRO cadeau eenmalig 1 Euro"
                            },
                            "bedrag": {
                              "type": "array",
                              "items": {
                                "properties": {
                                  "amount": {
                                    "type": "integer",
                                    "example": 10
                                  },
                                  "productID": {
                                    "type": "string",
                                    "example": "4805b8f2-42ac-e811-a2dd-005056bc253c"
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Get Remote Formulier Data from Platform.",
        "tags": [
          "Formulier"
        ]
      }
    },
    "/api/subscription/formulier": {
      "post": {
        "description": "Get Form display Object (html).",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "form_id"
                ],
                "properties": {
                  "form_id": {
                    "type": "integer",
                    "example": 15
                  },
                  "campaign_id": {
                    "type": "integer",
                    "example": 13
                  },
                  "mode": {
                    "type": "string",
                    "description": "values can be full or custom",
                    "default": "custom",
                    "example": "full"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Formulier HTML."
          }
        },
        "summary": "Get Formulier html from Platform.",
        "tags": [
          "Formulier"
        ]
      }
    }
  },
  "tags": [
    {
      "name": "Formulier"
    }
  ]
}
