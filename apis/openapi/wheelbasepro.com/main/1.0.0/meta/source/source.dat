{"openapi":"3.0.0","info":{"version":"1.0.0","title":"Wheelbase Partner API","description":"External-facing partner API for Wheelbase. Stable contract; internal services churn freely behind a translation layer.\n\n## Authentication\nAll `/v1/*` and `/mcp` endpoints require a bearer token: `Authorization: Bearer <token>`. Tokens are issued per credential and carry scopes; a missing scope returns `403`.\n\n## Rate limits\nFixed wall-clock window of 500 requests/minute per credential. Every response carries `X-RateLimit-Limit`, `X-RateLimit-Remaining`, and `X-RateLimit-Reset` (the Unix epoch second at which the window resets). A `429` includes `Retry-After` (seconds).\n\n## Errors\nErrors return `{ \"error\": { \"code\", \"message\" } }`. Beyond each operation's documented responses, these can occur on any endpoint: `401` (missing/invalid token), `403` (missing scope / not dealer-scoped), `422`/`400` (validation), `429` (rate limited), and `5xx` (upstream unavailable). Treat `429` and `5xx` as retryable with backoff; `401`/`403`/`422` are not.\n\n## Result ordering\nList and report endpoints return newest-first (creation date descending) unless noted. Because new rows insert at the front, a report paged while data is being written can re-deliver a row on a later page — dedupe by `id`."},"servers":[{"url":"https://api.wheelbasepro.com","description":"Current environment"}],"security":[{"bearerAuth":[]}],"components":{"securitySchemes":{"bearerAuth":{"type":"http","scheme":"bearer","description":"Partner API token issued per credential. Send as `Authorization: Bearer <token>`."}},"schemas":{"UsageSummary":{"type":"object","properties":{"window":{"type":"object","properties":{"from":{"type":"string"},"to":{"type":"string"},"days":{"type":"number"}},"required":["from","to","days"]},"truncated":{"type":"boolean","description":"True if more than 50000 records matched and the summary is over a capped sample."},"totals":{"type":"object","properties":{"requests":{"type":"number"},"errors":{"type":"number"},"error_rate":{"type":"number","description":"0..1, errors / requests."},"p50_ms":{"type":"number"},"p95_ms":{"type":"number"}},"required":["requests","errors","error_rate","p50_ms","p95_ms"]},"by_credential":{"type":"array","items":{"type":"object","properties":{"requests":{"type":"number"},"errors":{"type":"number"},"error_rate":{"type":"number","description":"0..1, errors / requests."},"p50_ms":{"type":"number"},"p95_ms":{"type":"number"},"client_id":{"type":"string"},"name":{"type":"string"},"last_seen":{"type":"string","nullable":true}},"required":["requests","errors","error_rate","p50_ms","p95_ms","client_id","name","last_seen"]}},"top_routes":{"type":"array","items":{"type":"object","properties":{"requests":{"type":"number"},"errors":{"type":"number"},"error_rate":{"type":"number","description":"0..1, errors / requests."},"p50_ms":{"type":"number"},"p95_ms":{"type":"number"},"route":{"type":"string"}},"required":["requests","errors","error_rate","p50_ms","p95_ms","route"]}}},"required":["window","truncated","totals","by_credential","top_routes"]},"Me":{"type":"object","properties":{"client_id":{"type":"string"},"name":{"type":"string"},"user_id":{"type":"number"},"scopes":{"type":"array","items":{"type":"string"}},"environment":{"type":"string","nullable":true,"enum":["live","test"]},"status":{"type":"string"},"created_at":{"type":"string","format":"date-time"},"created_by":{"type":"string","nullable":true},"last_used_at":{"type":"string","nullable":true,"format":"date-time"},"token_issued_at":{"type":"string","nullable":true,"format":"date-time"},"token_expires_at":{"type":"string","nullable":true,"format":"date-time"}},"required":["client_id","name","user_id","scopes","environment","status","created_at","created_by","last_used_at","token_issued_at","token_expires_at"]},"Money":{"type":"object","nullable":true,"properties":{"value":{"type":"number","description":"Amount in minor units (cents for USD/CAD). Derived per-unit prices may carry fractional cents.","example":1200},"currency":{"type":"string","example":"USD"},"display":{"type":"string","example":"$12.00"}},"required":["value","currency","display"]},"Listing":{"type":"object","properties":{"id":{"type":"number","example":12345},"name":{"type":"string","example":"Sunset Camper Van"},"slug":{"type":"string"},"type":{"type":"string","example":"camper-van"},"vehicle_type":{"type":"string","nullable":true,"example":"Camper van"},"price_per_day":{"$ref":"#/components/schemas/Money"},"currency":{"type":"string","example":"USD"},"security_deposit":{"$ref":"#/components/schemas/Money"},"sleeps":{"type":"number","nullable":true},"instant_book":{"type":"boolean"},"primary_image_url":{"type":"string","nullable":true},"rating":{"type":"number","nullable":true},"reviews_count":{"type":"number","nullable":true},"location":{"type":"object","nullable":true,"properties":{"city":{"type":"string","nullable":true},"state":{"type":"string","nullable":true},"country":{"type":"string","nullable":true},"lat":{"type":"number","nullable":true},"lng":{"type":"number","nullable":true}},"required":["city","state","country","lat","lng"]}},"required":["id","name","slug","type","vehicle_type","price_per_day","currency","security_deposit","sleeps","instant_book","primary_image_url","rating","reviews_count","location"]},"Addon":{"type":"object","properties":{"id":{"type":"number"},"name":{"type":"string"},"description":{"type":"string"},"category":{"type":"string"},"image_url":{"type":"string"},"pricing_type":{"type":"string","enum":["fixed","percent_of_rental"],"description":"`fixed` — price applies per unit (× nights when `daily`). `percent_of_rental` — charged as a percentage of the rental amount; `price` shows zero, see `percent`. Re-quote with the addon applied for the actual cost."},"price":{"$ref":"#/components/schemas/Money"},"percent":{"type":"number","description":"Percentage (fraction, e.g. 0.05 for 5%) when pricing_type is percent_of_rental; 0 otherwise."},"daily":{"type":"boolean","description":"True = charged per night; false = one-time."},"max_quantity":{"type":"number","description":"Maximum selectable quantity. 0 = no declared limit."}},"required":["id","name","description","category","image_url","pricing_type","price","percent","daily","max_quantity"]},"Availability":{"type":"object","properties":{"listing_id":{"type":"number"},"window":{"type":"object","properties":{"from":{"type":"string","example":"2026-07-06"},"to":{"type":"string","example":"2027-07-06"}},"required":["from","to"]},"unavailable":{"type":"array","items":{"type":"object","properties":{"start_date":{"type":"string","example":"2026-07-18"},"end_date":{"type":"string","example":"2026-07-24"}},"required":["start_date","end_date"]},"description":"Date ranges (inclusive) that cannot be booked — bookings, owner blocks, and turnaround buffers, merged. Dates inside the window and not listed here are available. The reason for a block is deliberately not exposed."}},"required":["listing_id","window","unavailable"]},"PriceAdjustment":{"type":"object","nullable":true,"properties":{"mode":{"type":"string","enum":["set","amount","percent"]},"amount":{"allOf":[{"$ref":"#/components/schemas/Money"},{"description":"Present for `set` (absolute nightly price) and `amount` (signed adjustment)."}]},"percent":{"type":"number","description":"Present for `percent`. Signed whole number; -10 = 10% off, 15 = 15% surcharge."}},"required":["mode"],"description":"The price change. Null for `min_stay` rules."},"PricingRule":{"type":"object","properties":{"id":{"type":"string","example":"rl_9f3a"},"kind":{"type":"string","enum":["price","min_stay"],"description":"`price` sets/adjusts the nightly rate; `min_stay` sets a minimum-night requirement."},"listing_ids":{"type":"array","items":{"type":"number"},"description":"Listings the rule applies to."},"dates":{"type":"object","nullable":true,"properties":{"from":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$","example":"2026-08-21"},"to":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$","example":"2026-08-24"}},"required":["from","to"],"description":"Stay dates the rule applies to. Null means every date."},"days_of_week":{"type":"array","items":{"type":"string","enum":["mon","tue","wed","thu","fri","sat","sun"]},"description":"Days of week the rule applies to. Empty means every day."},"price":{"$ref":"#/components/schemas/PriceAdjustment"},"min_nights":{"type":"number","nullable":true,"description":"Minimum nights required. Null for `price` rules."},"active":{"type":"boolean"},"description":{"type":"string","description":"Free-text label. Empty string when none — never null."},"created_at":{"type":"string"},"updated_at":{"type":"string"}},"required":["id","kind","listing_ids","dates","days_of_week","price","min_nights","active","description","created_at","updated_at"]},"PricingRuleListResponse":{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/PricingRule"}},"page":{"type":"number"},"page_size":{"type":"number"},"total":{"type":"number","nullable":true}},"required":["data","page","page_size","total"]},"PricingRuleCreate":{"type":"object","properties":{"kind":{"type":"string","enum":["price","min_stay"]},"dates":{"type":"object","properties":{"from":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$","example":"2026-08-21"},"to":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$","example":"2026-08-24"}},"required":["from","to"]},"days_of_week":{"type":"array","items":{"type":"string","enum":["mon","tue","wed","thu","fri","sat","sun"]},"maxItems":7},"price":{"type":"object","properties":{"mode":{"type":"string","enum":["set","amount","percent"]},"amount":{"type":"integer","description":"Cents. Required for `set` (absolute price) and `amount` (signed adjustment)."},"percent":{"type":"number","description":"Signed whole number for `percent` mode; -10 = 10% off."}},"required":["mode"]},"min_nights":{"type":"integer","minimum":0,"exclusiveMinimum":true},"active":{"type":"boolean","default":true},"description":{"type":"string","maxLength":500}},"required":["kind"]},"PricingRuleUpdate":{"type":"object","properties":{"dates":{"type":"object","properties":{"from":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$","example":"2026-08-21"},"to":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$","example":"2026-08-24"}},"required":["from","to"]},"days_of_week":{"type":"array","items":{"type":"string","enum":["mon","tue","wed","thu","fri","sat","sun"]},"maxItems":7},"price":{"type":"object","properties":{"mode":{"type":"string","enum":["set","amount","percent"]},"amount":{"type":"integer"},"percent":{"type":"number"}},"required":["mode"]},"min_nights":{"type":"integer","minimum":0,"exclusiveMinimum":true},"active":{"type":"boolean"},"description":{"type":"string","maxLength":500}}},"InsuranceOption":{"type":"object","properties":{"id":{"type":"string","example":"bun_1HY5oXH7C3IOs2i3QacnkSDiHn3"},"name":{"type":"string","example":"Essential"},"tier":{"type":"number","description":"Ordering rank; lower = more basic."},"is_default":{"type":"boolean","description":"True for the tier pre-selected at checkout."},"description":{"type":"string","description":"Short marketing description; empty when none."},"disclaimer":{"type":"string","description":"Requirement/legal note shown with the option; empty when none."},"price_per_day":{"$ref":"#/components/schemas/Money"},"total_price":{"allOf":[{"$ref":"#/components/schemas/Money"},{"description":"Total for the option. Equals price_per_day unless trip dates were supplied."}]},"deductible":{"$ref":"#/components/schemas/Money"},"coverage":{"type":"object","properties":{"liability":{"type":"string","description":"Liability/insurance summary.","example":"State minimum"},"physical_damage":{"type":"string","description":"Physical damage summary.","example":"Up to $1M"}},"required":["liability","physical_damage"],"description":"Headline coverage summaries (also present in `features`