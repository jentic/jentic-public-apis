ion":"Days since the trip ended; 0 if the trip has not ended yet."},"days_held":{"type":"number","description":"Days the deposit has been held (from the hold activity)."},"max_hold_days":{"type":"number","description":"Maximum hold window for this booking (0 = marketplace, 30 = dealer)."},"over_max_hold":{"type":"boolean","description":"True when days_held exceeds max_hold_days."}},"required":["booking","source","trip","amount","claimed_amount","status","outstanding","overdue","days_since_trip_end","days_held","max_hold_days","over_max_hold"]},"SecurityDepositReportResponse":{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/SecurityDepositRow"}},"page":{"type":"number"},"page_size":{"type":"number"},"total":{"type":"number","nullable":true,"description":"Count of rows matching the filters before pagination. Null when unavailable."}},"required":["data","page","page_size","total"]},"Customer":{"type":"object","properties":{"id":{"type":"number"},"managed_by":{"type":"string","enum":["dealer","marketplace"],"description":"`dealer` — created and managed by your account; fully editable. `marketplace` — a marketplace account; contact fields are masked until the customer has a confirmed booking with you, and the record cannot be edited."},"first_name":{"type":"string"},"last_name":{"type":"string"},"email":{"type":"string","description":"Empty string for marketplace customers without a confirmed booking (masked upstream)."},"phone":{"type":"string","description":"Masked the same way as email for marketplace customers."},"birthdate":{"type":"string","description":"YYYY-MM-DD. Only populated for dealer-managed customers; always empty for marketplace customers."},"address":{"type":"object","properties":{"line_1":{"type":"string"},"line_2":{"type":"string"},"city":{"type":"string"},"state":{"type":"string"},"zip":{"type":"string"},"country":{"type":"string"}},"required":["line_1","line_2","city","state","zip","country"]},"avatar_url":{"type":"string"},"archived":{"type":"boolean"},"stats":{"type":"object","properties":{"reservations":{"type":"number","description":"Bookings this customer has with your account."},"lifetime_value":{"allOf":[{"$ref":"#/components/schemas/Money"},{"description":"Sum of booking subtotals with your account. Null on detail reads (only computed by search)."}]},"last_trip_end":{"type":"string","description":"YYYY-MM-DD of the last completed trip; empty when none."}},"required":["reservations","lifetime_value","last_trip_end"]}},"required":["id","managed_by","first_name","last_name","email","phone","birthdate","address","avatar_url","archived","stats"]},"CustomerCreate":{"type":"object","properties":{"first_name":{"type":"string","minLength":1,"maxLength":100},"last_name":{"type":"string","minLength":1,"maxLength":100},"email":{"type":"string","format":"email"},"phone":{"type":"string","maxLength":30},"birthdate":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"},"address":{"type":"object","properties":{"line_1":{"type":"string"},"line_2":{"type":"string"},"city":{"type":"string"},"state":{"type":"string"},"zip":{"type":"string"},"country":{"type":"string"}}},"location_ids":{"type":"array","items":{"type":"integer","minimum":0,"exclusiveMinimum":true},"description":"Dealer locations to associate the customer with."}},"required":["first_name","last_name","email"]},"CustomerUpdate":{"type":"object","properties":{"first_name":{"type":"string","minLength":1,"maxLength":100},"last_name":{"type":"string","minLength":1,"maxLength":100},"email":{"type":"string","format":"email"},"phone":{"type":"string","maxLength":30},"birthdate":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"},"address":{"type":"object","properties":{"line_1":{"type":"string"},"line_2":{"type":"string"},"city":{"type":"string"},"state":{"type":"string"},"zip":{"type":"string"},"country":{"type":"string"}}}}},"Location":{"type":"object","properties":{"id":{"type":"number"},"name":{"type":"string"},"phone":{"type":"string"},"address":{"type":"object","properties":{"line_1":{"type":"string"},"line_2":{"type":"string"},"city":{"type":"string"},"state":{"type":"string"},"zip":{"type":"string"},"country":{"type":"string"}},"required":["line_1","line_2","city","state","zip","country"]},"coordinates":{"type":"object","nullable":true,"properties":{"lat":{"type":"number"},"lng":{"type":"number"}},"required":["lat","lng"]},"hours":{"type":"object","properties":{"pickup":{"type":"object","properties":{"monday":{"type":"object","properties":{"closed":{"type":"boolean"},"open":{"type":"object","nullable":true,"properties":{"value":{"type":"string","description":"HH:MM, 24-hour, local to the location.","example":"09:00"},"display":{"type":"string","example":"9:00 AM"}},"required":["value","display"]},"close":{"type":"object","nullable":true,"properties":{"value":{"type":"string","description":"HH:MM, 24-hour, local to the location.","example":"09:00"},"display":{"type":"string","example":"9:00 AM"}},"required":["value","display"]}},"required":["closed","open","close"]},"tuesday":{"type":"object","properties":{"closed":{"type":"boolean"},"open":{"type":"object","nullable":true,"properties":{"value":{"type":"string","description":"HH:MM, 24-hour, local to the location.","example":"09:00"},"display":{"type":"string","example":"9:00 AM"}},"required":["value","display"]},"close":{"type":"object","nullable":true,"properties":{"value":{"type":"string","description":"HH:MM, 24-hour, local to the location.","example":"09:00"},"display":{"type":"string","example":"9:00 AM"}},"required":["value","display"]}},"required":["closed","open","close"]},"wednesday":{"type":"object","properties":{"closed":{"type":"boolean"},"open":{"type":"object","nullable":true,"properties":{"value":{"type":"string","description":"HH:MM, 24-hour, local to the location.","example":"09:00"},"display":{"type":"string","example":"9:00 AM"}},"required":["value","display"]},"close":{"type":"object","nullable":true,"properties":{"value":{"type":"string","description":"HH:MM, 24-hour, local to the location.","example":"09:00"},"display":{"type":"string","example":"9:00 AM"}},"required":["value","display"]}},"required":["closed","open","close"]},"thursday":{"type":"object","properties":{"closed":{"type":"boolean"},"open":{"type":"object","nullable":true,"properties":{"value":{"type":"string","description":"HH:MM, 24-hour, local to the location.","example":"09:00"},"display":{"type":"string","example":"9:00 AM"}},"required":["value","display"]},"close":{"type":"object","nullable":true,"properties":{"value":{"type":"string","description":"HH:MM, 24-hour, local to the location.","example":"09:00"},"display":{"type":"string","example":"9:00 AM"}},"required":["value","display"]}},"required":["closed","open","close"]},"friday":{"type":"object","properties":{"closed":{"type":"boolean"},"open":{"type":"object","nullable":true,"properties":{"value":{"type":"string","description":"HH:MM, 24-hour, local to the location.","example":"09:00"},"display":{"type":"string","example":"9:00 AM"}},"required":["value","display"]},"close":{"type":"object","nullable":true,"properties":{"value":{"type":"string","description":"HH:MM, 24-hour, local to the location.","example":"09:00"},"display":{"type":"string","example":"9:00 AM"}},"required":["value","display"]}},"required":["closed","open","close"]},"saturday":{"type":"object","properties":{"closed":{"type":"boolean"},"open":{"type":"object","nullable":true,"properties":{"value":{"type":"string","description":"HH:MM, 24-hour, local to the location.","example":"09:00"},"display":{"type":"string","example":"9:00 AM"}},"required":["value","display"]},"close":{"type":"object","nullable":true,"properties":{"value":{"type":"string","description":"HH:MM, 24-hour, local to the location.","example":"09:00"},"display":{"type":"string","example":"9:00 AM"}},"required":["value","display"]}},"required":["closed","open","close"]},"sunday":{"type":"object","properties":{"closed":{"type":"boolean"},"open":{"type":"object","nullable":true,"properties":{"value":{"type":"string","description":"HH:MM, 24-hour, local to the location.","example":"09:00"},"display":{"type":"string","example":"9:00 AM"}},"required":["value","display"]},"close":{"type":"object","nullable":true,"properties":{"value":{"type":"string","description":"HH:MM, 24-hour, local to the location.","example":"09:00"},"display":{"type":"string","example":"9:00 AM"}},"required":["value","display"]}},"required":["closed","open","close"]}},"description":"Per-weekday hours. Only days with configured hours appear; a day not listed has no restriction."},"dropoff":{"type":"object","properties":{"monday":{"type":"object","properties":{"closed":{"type":"boolean"},"open":{"type":"object","nullable":true,"properties":{"value":{"type":"string","description":"HH:MM, 24-hour, local to the location.","example":"09:00"},"display":{"type":"string","example":"9:00 AM"}},"required":["value","display"]},"close":{"type":"object","nullable":true,"properties":{"value":{"type":"string","description":"HH:MM, 24-hour, local to the location.","example":"09:00"},"display":{"type":"string","example":"9:00 AM"}},"required":["value","display"]}},"required":["closed","open","close"]},"tuesday":{"type":"object","properties":{"closed":{"type":"boolean"},"open":{"type":"object","nullable":true,"properties":{"value":{"type":"string","description":"HH:MM, 24-hour, local to the location.","example":"09:00"},"display":{"type":"string","example":"9:00 AM"}},"required":["value","display"]},"close":{"type":"object","nullable":true,"properties":{"value":{"type":"string","description":"HH:MM, 24-hour, local to the location.","example":"09:00"},"display":{"type":"string","example":"9:00 AM"}},"required":["value","display"]}},"required":["closed","open","close"]},"wednesday":{"type":"object","properties":{"closed":{"type":"boolean"},"open":{"type":"object","nullable":true,"properties":{"value":{"type":"string","description":"HH:MM, 24-hour, local to the location.","example":"09:00"},"display":{"type":"string","example":"9:00 AM"}},"required":["value","display"]},"close":{"type":"object","nullable":true,"properties":{"value":{"type":"string","description":"HH:MM, 24-hour, local to the location.","example":"09:00"},"display":{"type":"string","example":"9:00 AM"}},"required":["value","display"]}},"required":["closed","open","close"]},"thursday":{"type":"object","properties":{"closed":{"type":"boolean"},"open":{"type":"object","nullable":true,"properties":{"value":{"type":"string","description":"HH:MM, 24-hour, local to the location.","example":"09:00"},"display":{"type":"string","example":"9:00 AM"}},"required":["value","display"]},"close":{"type":"object","nullable":true,"properties":{"value":{"type":"string","description":"HH:MM, 24-hour, local to the location.","example":"09:00"},"display":{"type":"string","example":"9:00 AM"}},"required":["value","display"]}},"required":["closed","open","close"]},"friday":{"type":"object","properties":{"closed":{"type":"boolean"},"open":{"type":"object","nullable":true,"properties":{"value":{"type":"string","description":"HH:MM, 24-hour, local to the location.","example":"09:00"},"display":{"type":"string","example":"9:00 AM"}},"required":["value","display"]},"close":{"type":"object","nullable":true,"properties":{"value":{"type":"string","description":"HH:MM, 24-hour, local to the location.","example":"09:00"},"display":{"type":"string","example":"9:00 AM"}},"required":["value","display"]}},"required":["closed","open","close"]},"saturday":{"type":"object","properties":{"closed":{"type":"boolean"},"open":{"type":"object","nullable":true,"properties":{"value":{"type":"string","description":"HH:MM, 24-hour, local to the location.","example":"09:00"},"display":{"type":"string","example":"9:00 AM"}},"required":["value","display"]},"close":{"type":"object","nullable":true,"properties":{"value":{"type":"string","description":"HH:MM, 24-hour, local to the location.","example":"09:00"},"display":{"type":"string","example":"9:00 AM"}},"required":["value","display"]}},"required":["closed","open","close"]},"sunday":{"type":"object","properties":{"closed":{"type":"boolean"},"open":{"type":"object","nullable":true,"properties":{"value":{"type":"string","description":"HH:MM, 24-hour, local to the location.","example":"09:00"},"display":{"type":"string","example":"9:00 AM"}},"required":["value","display"]},"close":{"type":"object","nullable":true,"properties":{"value":{"type":"string","description":"HH:MM, 24-hour, local to the location.","example":"09:00"},"display":{"type":"string","example":"9:00 AM"}},"required":["value","display"]}},"required":["closed","open","close"]}},"description":"Per-weekday hours. Only days with configured hours appear; a day not listed has no restriction."}},"required":["pickup","dropoff"],"description":"Weekly pickup and drop-off hours."}},"required":["id","name","phone","address","coordinates","hours"]},"LocationsResponse":{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/Location"}}},"required":["data"]}},"parameters":{}},"paths":{"/v1/me":{"get":{"summary":"Get current credential","description":"Returns the identity and metadata for the credential authenticating this request. Useful for verifying an integration is wired up correctly (\"is my token being accepted, and as whom?\"). No scope required.","tags":["Auth"],"responses":{"200":{"description":"Credential info","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Me"}}}}}}},"/v1/listings":{"get":{"summary":"Search listings","description":"Returns a page of listings matching the supplied filters. Backed by an eventually-consistent search index; use GET /v1/listings/{id} for source-of-truth state.","tags":["Listings"],"parameters":[{"schema":{"type":"string","description":"Free-text location search (city, address, or place name).","example":"Austin, TX"},"required":false,"name":"location","in":"query"},{"schema":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$","description":"ISO date (YYYY-MM-DD).","example":"2026-07-15"},"required":false,"name":"start_date","in":"query"},{"schema":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$","description":"ISO date (YYYY-MM-DD).","example":"2026-07-22"},"required":false,"name":"end_date","in":"query"},{"schema":{"type":"integer","minimum":0,"exclusiveMinimum":true},"required":false,"name":"guests","in":"query"},{"schema":{"type":"boolean","nullable":true},"required":false,"name":"instant_book","in":"query"},{"schema":{"type":"string"},"required":false,"name":"vehicle_type","in":"query"},{"schema":{"type":"integer","minimum":0,"exclusiveMinimum":true,"default":1},"required":false,"name":"page","in":"query"},{"schema":{"type":"integer","minimum":0,"exclusiveMinimum":true,"maximum":150,"default":20},"required":false,"name":"page_size","in":"query"}],"responses":{"200":{"description":"Listings page","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/Listing"}},"page":{"type":"number"},"page_size":{"type":"number"},"total":{"type":"number","nullable":true}},"required":["data","page","page_size","total"]}}}}}}},"/v1/listings/{id}/addons":{"get":{"summary":"List a listing's add-ons","description":"Returns the optional add-ons bookable on this listing (account-wide and listing-specific, filtered to what applies at its location and vehicle type). Apply them via `addons: [{id, quantity}]` on POST /v1/quotes or booking create/update.\n\nRequired items (prep fees etc.) are attached to bookings automatically and are not listed here.","tags":["Listings"],"parameters":[{"schema":{"type":"integer","minimum":0,"exclusiveMinimum":true,"example":452064},"required":true,"name":"id","in":"path"}],"responses":{"200":{"description":"Add-ons for the listing","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/Addon"}}},"required":["data"]}}}},"404":{"description":"Listing not found (or not in this credential's scope)"}}}},"/v1/listings/{id}/availability":{"get":{"summary":"Get a listing's availability","description":"Returns the date ranges that cannot be booked within the window — existing bookings, owner blocks, and turnaround buffer days, merged into anonymous ranges. Dates not listed are available.\n\nThis reads the booking source of truth (not the search index) and reflects the same rules booking creation enforces.","tags":["Listings"],"parameters":[{"schema":{"type":"integer","minimum":0,"exclusiveMinimum":true,"example":452064},"required":true,"name":"id","in":"path"},{"schema":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$","description":"Window start (inclusive). Defaults to today."},"required":false,"name":"from","in":"query"},{"schema":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$","description":"Window end (inclusive). Defaults to 12 months from `from`. Max window: 24 months."},"required":false,"name":"to","in":"query"}],"responses":{"200":{"description":"Availability for the window","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Availability"}}}},"400":{"description":"Invalid window"},"404":{"description":"Listing not found (or not in this credential's scope)"}}}},"/v1/listings/{id}/pricing-rules":{"get":{"summary":"List a listing’s pricing rules","description":"The listing's price and minimum-stay rules. Filter by kind (price | min_stay) and stay-date window. Only price and min_stay rules are returned; internal smart-pricing rules are omitted.","tags":["Pricing"],"parameters":[{"schema":{"type":"integer","minimum":0,"exclusiveMinimum":true,"example":8339},"required":true,"name":"id","in":"path"},{"schema":{"type":"string","enum":["price","min_stay"]},"required":false,"name":"kind","in":"query"},{"schema":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$","description":"Only rules whose stay dates fall on/after this date."},"required":false,"name":"from","in":"query"},{"schema":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"},"required":false,"name":"to","in":"query"},{"schema":{"type":"integer","minimum":0,"exclusiveMinimum":true,"default":1},"required":false,"name":"page","in":"query"},{"schema":{"type":"integer","minimum":0,"exclusiveMinimum":true,"maximum":100,"default":50},"required":false,"name":"page_size","in":"query"}],"responses":{"200":{"description":"Pricing rules for the listing","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PricingRuleListResponse"}}}},"404":{"description":"Listing not found"}}},"post":{"summary":"Create a pricing rule on a listing","description":"Create a `price` rule (set/adjust the nightly rate) or a `min_stay` rule (minimum nights) over a stay-date range and optional days of week. Applied immediately and visible to shoppers.","tags":["Pricing"],"parameters":[{"schema":{"type":"integer","minimum":0,"exclusiveMinimum":true,"example":8339},"required":true,"name":"id","in":"path"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/PricingRuleCreate"}}}},"responses":{"201":{"description":"Rule created","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PricingRule"}}}},"404":{"description":"Listing not found"}}}},"/v1/listings/{id}/pricing-rules/{ruleId}":{"get":{"summary":"Get a pricing rule","tags":["Pricing"],"parameters":[{"schema":{"type":"integer","minimum":0,"exclusiveMinimum":true,"example":8339},"required":true,"name":"id","in":"path"},{"schema":{"type":"string","minLength":1,"example":"rl_9f3a"},"required":true,"name":"ruleId","in":"path"}],"responses":{"200":{"description":"Pricing rule","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PricingRule"}}}},"404":{"description":"Rule not found for this listing"}}},"patch":{"summary":"Update a pricing rule","description":"Partially update a rule (dates, days_of_week, price, min_nights, active, description).","tags":["Pricing"],"parameters":[{"schema":{"type":"integer","minimum":0,"exclusiveMinimum":true,"example":8339},"required":true,"name":"id","in":"path"},{"schema":{"type":"string","minLength":1,"example":"rl_9f3a"},"required":true,"name":"ruleId","in":"path"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/PricingRuleUpdate"}}}},"responses":{"200":{"description":"Updated rule","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PricingRule"}}}},"404":{"description":"Rule not found for this listing"}}},"delete":{"summary":"Delete a pricing rule","tags":["Pricing"],"parameters":[{"schema":{"type":"integer","minimum":0,"exclusiveMinimum":true,"example":8339},"required":true,"name":"id","in":"path"},{"schema":{"type":"string","minLength":1,"example":"rl_9f3a"},"required":true,"name":"ruleId","in":"path"}],"responses":{"204":{"description":"Rule deleted"},"404":{"description":"Rule not found for this listing"}}}},"/v1/listings/{id}/insurance-options":{"get":{"summary":"List a listing’s insurance options","description":"The insurance/protection options (tiers) offered on a listing — price per day, deductible, coverage summary, and feature list. Dealer credentials get dealer-priced options; other credentials get marketplace pricing.","tags":["Insurance"],"parameters":[{"schema":{"type":"integer","minimum":0,"exclusiveMinimum":true,"example":103823},"required":true,"name":"id","in":"path"}],"responses":{"200":{"description":"Insurance options for the listing","content":{"application/json":{"schema":{"$ref":"#/components/schemas/InsuranceOptionsResponse"}}}},"404":{"description":"Listing not found"}}}},"/v1/listings/{id}":{"get":{"summary":"Get listing detail","description":"Returns source-of-truth detail for a single listing. Use this for read-modify-write flows — the search index is eventually consistent.\n\nDealer credentials (with `owner_ids`) can only view listings in their own fleet; other listings return 404 (same as if the listing didn't exist, to avoid confirming other dealers' listing IDs). Marketplace credentials (empty `owner_ids`) can view any listing.","tags":["Listings"],"parameters":[{"schema":{"type":"integer","minimum":0,"exclusiveMinimum":true,"example":452064},"required":true,"name":"id","in":"path"}],"responses":{"200":{"description":"Listing detail","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ListingDetail"}}}},"404":{"description":"Listing not found (or not in this credential's scope)"}}},"patch":{"summary":"Update a listing","description":"Partially update a listing. Only whitelisted fields (`name`, `description`, `price_per_day`, `instant_book`) are accepted; anything else is silently dropped. The authenticated user must have owner-equivalent rights on the listing.","tags":["Listings"],"parameters":[{"schema":{"type":"integer","minimum":0,"exclusiveMinimum":true,"example":452064},"required":true,"name":"id","in":"path"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ListingUpdate"}}}},"responses":{"200":{"description":"Updated listing","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ListingDetail"}}}},"404":{"description":"Listing not found"}}}},"/v1/quotes":{"post":{"summary":"Get a quote","description":"Returns a non-destructive full price breakdown for a listing and date range. Quote calculation does not reserve availability or create a booking.","tags":["Quotes"],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"listing_id":{"type":"integer","minimum":0,"exclusiveMinimum":true,"example":452064},"start_date":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$","example":"2026-10-15"},"end_date":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$","example":"2026-10-18"},"addons":{"type":"array","items":{"type":"object","properties":{"id":{"type":"integer","minimum":0,"exclusiveMinimum":true},"quantity":{"type":"integer","minimum":0,"exclusiveMinimum":true,"maximum":100,"default":1}},"required":["id"]},"maxItems":50,"description":"Optional add-ons to include (ids from GET /v1/listings/{id}/addons). Each shows up in line_items with its cost and tax.","example":[{"id":4821,"quantity":1}]},"insurance_option_id":{"type":"string","description":"Insurance/protection option to price into the quote (id from GET /v1/listings/{id}/insurance-options). Omit to use the listing default.","example":"bun_1HY5oXH7C3IOs2i3QacnkSDiHn3"},"delivery":{"$ref":"#/components/schemas/DeliveryInput"}},"required":["listing_id","start_date","end_date"]}}}},"responses":{"200":{"description":"Quote breakdown","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Quote"}}}}}}},"/v1/bookings":{"get":{"summary":"List bookings","description":"Returns bookings the credential participates in — either as renter (bookings where renter_id = credential user_id) or as owner (bookings on rentals in the credential's owner_ids).","tags":["Bookings"],"parameters":[{"schema":{"type":"string","description":"Filter by booking status (e.g. `negotiating`, `confirmed`)."},"required":false,"name":"status","in":"query"},{"schema":{"type":"integer","minimum":0,"exclusiveMinimum":true,"description":"Only this customer's bookings (find the id via GET /v1/customers). Dealer credentials only."},"required":false,"name":"customer_id","in":"query"},{"schema":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$","description":"Only return bookings whose start_date is on/after this date."},"required":false,"name":"start_date_from","in":"query"},{"schema":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"},"required":false,"name":"start_date_to","in":"query"},{"schema":{"type":"integer","minimum":0,"exclusiveMinimum":true,"default":1},"required":false,"name":"page","in":"query"},{"schema":{"type":"integer","minimum":0,"exclusiveMinimum":true,"maximum":150,"default":20},"required":false,"name":"page_size","in":"query"}],"responses":{"200":{"description":"Bookings page","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/BookingSummary"}},"page":{"type":"number"},"page_size":{"type":"number"},"total":{"type":"number","nullable":true}},"required":["data","page","page_size","total"]}}}}}},"post":{"summary":"Create a booking","description":"Creates a booking in `negotiating` status.\n\nSend an `Idempotency-Key` header to make retries safe — repeating a request with the same key returns the original response instead of creating a duplicate booking. Without the header, every request creates a new booking.\n\nPayment collection (Stripe client_secret) is not yet wired here; a dedicated endpoint will be added for that.","tags":["Bookings"],"parameters":[{"schema":{"type":"string","minLength":1,"maxLength":255,"description":"Optional but strongly recommended in production. Any unique string per logical create; retrying with the same key returns the original response instead of creating a duplicate booking.","example":"booking-2026-10-15-user42"},"required":false,"name":"idempotency-key","in":"header"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/BookingCreate"}}}},"responses":{"201":{"description":"Booking created","content":{"application/json":{"schema":{"$ref":"#/components/schemas/BookingDetail"}}}},"400":{"description":"Validation or upstream rejection"}}}},"/v1/bookings/{id}/documents":{"get":{"summary":"List a booking's documents","description":"Returns the booking's documents: platform-generated PDFs (receipt, contract, e-sign receipt, departure/return forms) and uploaded files (driver documents, message attachments). Fetch on demand — availability of generated documents changes with booking state (e.g. the receipt appears once the booking is approved).","tags":["Bookings"],"parameters":[{"schema":{"type":"integer","minimum":0,"exclusiveMinimum":true},"required":true,"name":"id","in":"path"}],"responses":{"200":{"description":"Booking documents","content":{"application/json":{"schema":{"$ref":"#/components/schemas/BookingDocuments"}}}},"404":{"description":"Booking not found"}}}},"/v1/bookings/{id}/links":{"post":{"summary":"Create a shareable checkout link","description":"Mints a single-use-style deep link the customer can open without a password — resolving it signs them in and lands them on the booking's checkout or payment step. Send it through your own channel (SMS, email).\n\nOnly available when the booking's customer is one of **your** customers (`managed_by: \"dealer\"`) — marketplace customers have their own accounts and cannot be signed in via links. Links expire after ~3 days; mint a fresh one per send.\n\nTypical flow for a dealer-sent quote: create the booking → `POST /{id}/approve` with `notify: false` → create a `payment` link → send it to the customer yourself.","tags":["Bookings"],"parameters":[{"schema":{"type":"integer","minimum":0,"exclusiveMinimum":true},"required":true,"name":"id","in":"path"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/BookingLinkRequest"}}}},"responses":{"201":{"description":"Link created","content":{"application/json":{"schema":{"$ref":"#/components/schemas/BookingLink"}}}},"400":{"description":"Rejected — commonly because the booking's customer is a marketplace account (links are dealer-customer only)"},"404":{"description":"Booking not found"}}}},"/v1/bookings/{id}/payments":{"get":{"summary":"List a booking's payments","description":"Returns the booking's money movement, newest first, in two groups:\n\n- `payments` — the customer timeline: settled charges and refunds plus scheduled/pending future charges (e.g. the remainder auto-charge). `scheduled: true` entries carry a `due_date`; refund entries carry `original_payment_id`.\n- `payouts` — money paid out to your account for this booking, with expected/actual bank deposit dates.\n\nComplements the `payment` block on booking detail: that block is the summary (total paid / balance / plan); this is the itemized history behind it.","tags":["Bookings"],"parameters":[{"schema":{"type":"integer","minimum":0,"exclusiveMinimum":true},"required":true,"name":"id","in":"path"}],"responses":{"200":{"description":"Payments and payouts","content":{"application/json":{"schema":{"type":"object","properties":{"payments":{"type":"array","items":{"$ref":"#/components/schemas/BookingPayment"}},"payouts":{"type":"array","items":{"$ref":"#/components/schemas/BookingPayout"}}},"required":["payments","payouts"]}}}},"404":{"description":"Booking not found"}}}},"/v1/bookings/{id}":{"get":{"summary":"Get a booking","description":"Returns a single booking. Only accessible to the renter or the owner of the associated listing.","tags":["Bookings"],"parameters":[{"schema":{"type":"integer","minimum":0,"exclusiveMinimum":true},"required":true,"name":"id","in":"path"}],"responses":{"200":{"description":"Booking","content":{"application/json":{"schema":{"$ref":"#/components/schemas/BookingDetail"}}}},"404":{"description":"Booking not found"}}},"patch":{"summary":"Modify a booking","description":"Partially update a booking. Only dates, guests, discount code, and insurance can be modified. Go api rejects updates once a booking is confirmed — you'll see a 400 with an upstream reason.","tags":["Bookings"],"parameters":[{"schema":{"type":"integer","minimum":0,"exclusiveMinimum":true},"required":true,"name":"id","in":"path"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/BookingUpdate"}}}},"responses":{"200":{"description":"Updated booking","content":{"application/json":{"schema":{"$ref":"#/components/schemas/BookingDetail"}}}},"404":{"description":"Booking not found"}}}},"/v1/bookings/{id}/approve":{"post":{"summary":"Approve a booking","description":"Approves the booking from the calling credential's side (renter if user_id = renter_id, owner otherwise). Both sides approving triggers payment capture / confirmation.\n\n**Sending a quote:** when a dealer creates a booking on behalf of a customer and then calls approve, the platform marks the owner side approved and emails the customer their quote with a link to review and pay. Include `reason` to add a personal message to that email and the conversation thread.","tags":["Bookings"],"parameters":[{"schema":{"type":"integer","minimum":0,"exclusiveMinimum":true},"required":true,"name":"id","in":"path"}],"requestBody":{"required":false,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/BookingAction"}}}},"responses":{"200":{"description":"Booking after the action","content":{"application/json":{"schema":{"$ref":"#/components/schemas/BookingDetail"}}}},"404":{"description":"Booking not found"},"409":{"description":"Wrong state — use the other endpoint"}}}},"/v1/bookings/{id}/decline":{"post":{"summary":"Decline a booking","description":"Declines a pre-confirmation booking. Returns 409 if the booking is already confirmed (use /cancel instead).","tags":["Bookings"],"parameters":[{"schema":{"type":"integer","minimum":0,"exclusiveMinimum":true},"required":true,"name":"id","in":"path"}],"requestBody":{"required":false,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/BookingAction"}}}},"responses":{"200":{"description":"Booking after the action","content":{"application/json":{"schema":{"$ref":"#/components/schemas/BookingDetail"}}}},"404":{"description":"Booking not found"},"409":{"description":"Wrong state — use the other endpoint"}}}},"/v1/bookings/{id}/cancel":{"post":{"summary":"Cancel a booking","description":"Cancels a confirmed booking. Returns 409 if the booking has not been confirmed (use /decline instead). Cancellation may trigger refund logic per the listing's cancel policy.","tags":["Bookings"],"parameters":[{"schema":{"type":"integer","minimum":0,"exclusiveMinimum":true},"required":true,"name":"id","in":"path"}],"requestBody":{"required":false,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/BookingAction"}}}},"responses":{"200":{"description":"Booking after the action","content":{"application/json":{"schema":{"$ref":"#/components/schemas/BookingDetail"}}}},"404":{"description":"Booking not found"},"409":{"description":"Wrong state — use the other endpoint"}}}},"/v1/reports/vehicles":{"get":{"summary":"Vehicle inventory report","description":"Dealer fleet vehicle export — returns every vehicle in the credential's fleet with make/model, capacity, pricing, and location. Filterable by search, status, type, location, and length range.\n\nRequires a dealer credential (single `owner_ids` entry). Marketplace credentials (empty `owner_ids`) currently receive an empty page — the underlying report is dealer-scoped only.","tags":["Reports"],"parameters":[{"schema":{"type":"string","description":"Case-insensitive contains on name, internal_id, or VIN.","example":"sunseeker"},"required":false,"name":"search","in":"query"},{"schema":{"type":"string","enum":["published","unpublished"]},"required":false,"name":"status","in":"query"},{"schema":{"type":"string","description":"Exact match on rental type (e.g. `class-c`, `travel-trailer`)."},"required":false,"name":"type","in":"query"},{"schema":{"type":"integer","minimum":0,"exclusiveMinimum":true,"description":"Filter to vehicles currently assigned to this location."},"required":false,"name":"location_id","in":"query"},{"schema":{"type":"number","nullable":true,"minimum":0,"description":"Minimum vehicle length (feet)."},"required":false,"name":"min_length","in":"query"},{"schema":{"type":"number","nullable":true,"minimum":0,"description":"Maximum vehicle length (feet)."},"required":false,"name":"max_length","in":"query"},{"schema":{"type":"boolean","description":"Include child rentals — individual units under a parent/fleet listing. Defaults to true (matching the dealer dashboard fleet count). Set false for parent listings only."},"required":false,"name":"include_children","in":"query"},{"schema":{"type":"boolean","description":"Include archived (deleted/removed-from-fleet) vehicles, marked with `status: \"archived\"`. Defaults to false (active fleet only). Use to reconcile historical bookings against vehicles no longer in the fleet."},"required":false,"name":"include_archived","in":"query"},{"schema":{"type":"integer","minimum":0,"exclusiveMinimum":true,"default":1},"required":false,"name":"page","in":"query"},{"schema":{"type":"integer","minimum":0,"exclusiveMinimum":true,"maximum":200,"default":50},"required":false,"name":"page_size","in":"query"}],"responses":{"200":{"description":"Vehicle report page","content":{"application/json":{"schema":{"$ref":"#/components/schemas/VehicleReportResponse"}}}},"403":{"description":"Credential missing required scope"}}}},"/v1/reports/bookings":{"get":{"summary":"Booking export report","description":"Dealer booking export — one row per booking with renter, dates, usage meters, and a full money breakdown. Filterable by ONE date window per request (trip start, booked, or created — combining dimensions returns 400), plus locations and sources.\n\n**Default window:** when no date filter is supplied, the report returns bookings *created in the last 30 days*. Pass an explicit window to fetch older bookings.\n\n**Pagination:** `total` is the pre-filter-pagination row count when available; if `total` is null, page until you receive fewer rows than `page_size`.\n\nRequires a dealer credential (single `owner_ids` entry).","tags":["Reports"],"parameters":[{"schema":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$","description":"Filter by trip start date (inclusive lower bound).","example":"2026-06-01"},"required":false,"name":"trip_start_from","in":"query"},{"schema":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"},"required":false,"name":"trip_start_to","in":"query"},{"schema":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$","description":"Filter by when the booking was confirmed."},"required":false,"name":"booked_from","in":"query"},{"schema":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"},"required":false,"name":"booked_to","in":"query"},{"schema":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$","description":"Filter by when the booking record was created."},"required":false,"name":"created_from","in":"query"},{"schema":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"},"required":false,"name":"created_to","in":"query"},{"schema":{"type":"string","pattern":"^\\d+(,\\d+)*$","description":"Comma-separated location ids.","example":"12,15"},"required":false,"name":"location_ids","in":"query"},{"schema":{"type":"string","description":"Comma-separated booking sources."},"required":false,"name":"sources","in":"query"},{"schema":{"type":"boolean","description":"When true, omit cancelled bookings. Accepts true/1/yes; false/0/no (and omitting it) include them."},"required":false,"name":"exclude_cancelled","in":"query"},{"schema":{"type":"integer","minimum":0,"exclusiveMinimum":true,"default":1},"required":false,"name":"page","in":"query"},{"schema":{"type":"integer","minimum":0,"exclusiveMinimum":true,"maximum":1000,"default":100},"required":false,"name":"page_size","in":"query"}],"responses":{"200":{"description":"Booking report page","content":{"application/json":{"schema":{"$ref":"#/components/schemas/BookingReportResponse"}}}},"403":{"description":"Credential missing required scope or not dealer-scoped"}}}},"/v1/reports/transactions":{"get":{"summary":"Transaction ledger report","description":"Account-wide transaction ledger — one row per money movement (charges, refunds, payouts, fees) across all of your bookings, with a normalized category, a dealer-facing fee breakdown, deposit tracking, and a full money breakdown.\n\n**Amounts** are always positive; the `category` field conveys direction (`refund` and `payout` reduce your net). Marketplace-internal amounts (our fee, Stripe/settlement ids) are never included.\n\n**Date window:** filter by transaction date via `created_from`/`created_to`, or by deposit date via `deposited_from`/`deposited_to`. Each bound is independent, so a one-sided window works. With no filter, returns the most recent transactions.\n\n**Summary:** `summary.total` is the summed net across the whole filtered set (all pages), not just this page.\n\n**Pagination:** `total` is the pre-pagination row count; page until you receive fewer rows than `page_size` if it's null.\n\nRequires a dealer credential (single `owner_ids` entry).","tags":["Reports"],"parameters":[{"schema":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$","description":"Filter by transaction date (inclusive lower bound, account timezone).","example":"2026-07-01"},"required":false,"name":"created_from","in":"query"},{"schema":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$","description":"Filter by transaction date (inclusive upper bound, account timezone).","example":"2026-07-31"},"required":false,"name":"created_to","in":"query"},{"schema":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$","description":"Filter by deposit date (inclusive lower bound)."},"required":false,"name":"deposited_from","in":"query"},{"schema":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"},"required":false,"name":"deposited_to","in":"query"},{"schema":{"type":"string","description":"Comma-separated raw transaction types to include (e.g. reservation_charge,refund). Omit to get the standard ledger set (charges, refunds, fees, deposit transfers, adjustments) — the same scope as the dashboard. Pass explicit types to widen (e.g. payout,withdrawal) or narrow."},"required":false,"name":"type","in":"query"},{"schema":{"type":"string","description":"Filter by transaction status (e.g. completed, failed, authorized)."},"required":false,"name":"status","in":"query"},{"schema":{"type":"string","enum":["cash","card"],"description":"Restrict to cash or card (non-cash) transactions."},"required":false,"name":"method","in":"query"},{"schema":{"type":"string","pattern":"^\\d+(,\\d+)*$","description":"Comma-separated location ids.","example":"12,15"},"required":false,"name":"location_ids","in":"query"},{"schema":{"type":"boolean","description":"When true, return pending/scheduled transactions instead of settled ones."},"required":false,"name":"scheduled","in":"query"},{"schema":{"type":"integer","minimum":0,"exclusiveMinimum":true,"default":1},"required":false,"name":"page","in":"query"},{"schema":{"type":"integer","minimum":0,"exclusiveMinimum":true,"maximum":100,"default":100,"description":"Rows per page (max 100 — the ledger returns at most 100 per request)."},"required":false,"name":"page_size","in":"query"}],"responses":{"200":{"description":"Transaction ledger page","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TransactionReportResponse"}}}},"403":{"description":"Credential missing required scope or not dealer-scoped"}}}},"/v1/reports/security-deposits":{"get":{"summary":"Security deposits report","description":"Security deposit holds across your bookings — one row per deposit with the amount, status, trip dates, and how long it's been held.\n\n**Answering \"what should I have released by now?\":** each row carries `outstanding` (the deposit still holds the renter's money) and `overdue` (outstanding AND the trip has already ended), plus `days_since_trip_end` and `over_max_hold`. Pass `outstanding=true` to fetch only deposits you're still holding.\n\n**Date window:** `created_from`/`created_to` filter by when the booking was created. **Pagination:** `total` is the pre-pagination row count.\n\nRequires a dealer credential (single `owner_ids` entry).","tags":["Reports"],"parameters":[{"schema":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$","description":"Filter by booking-created date (inclusive lower bound). Omit both bounds to return deposits across all time (so old, still-held deposits surface).","example":"2026-01-01"},"required":false,"name":"created_from","in":"query"},{"schema":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$","description":"Filter by booking-created date (inclusive upper bound)."},"required":false,"name":"created_to","in":"query"},{"schema":{"type":"string","description":"Comma-separated security_deposit_status values (e.g. hold,authorized). Overrides `outstanding`."},"required":false,"name":"status","in":"query"},{"schema":{"type":"boolean","description":"When true, return only deposits still holding the renter’s money (hold, authorized, paid, partially_refunded, disputed). Ignored if `status` is given."},"required":false,"name":"outstanding","in":"query"},{"schema":{"type":"integer","minimum":0,"exclusiveMinimum":true,"default":1},"required":false,"name":"page","in":"query"},{"schema":{"type":"integer","minimum":0,"exclusiveMinimum":true,"maximum":1000,"default":100},"required":false,"name":"page_size","in":"query"}],"responses":{"200":{"description":"Security deposits page","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SecurityDepositReportResponse"}}}},"403":{"description":"Credential missing required scope or not dealer-scoped"}}}},"/v1/customers":{"get":{"summary":"Search customers","description":"Searches the dealer's customers — both dealer-managed records and marketplace guests who have booked with the dealer.\n\nMarketplace customers (`managed_by: \"marketplace\"`) have `email` and `phone` masked (empty strings) in search results, regardless of booking history. Use `GET /v1/customers/{id}` to read contact info once a confirmed booking exists.","tags":["Customers"],"parameters":[{"schema":{"type":"string","description":"Matches name, email, phone, or customer id.","example":"smith"},"required":false,"name":"search","in":"query"},{"schema":{"type":"string","pattern":"^\\d+(,\\d+)*$"},"required":false,"name":"location_ids","in":"query"},{"schema":{"type":"boolean","description":"Only customers with more than one booking."},"required":false,"name":"repeat_guest","in":"query"},{"schema":{"type":"boolean","description":"Only customers with a current or upcoming booking."},"required":false,"name":"active_guest","in":"query"},{"schema":{"type":"integer","minimum":0,"exclusiveMinimum":true,"default":1},"required":false,"name":"page","in":"query"},{"schema":{"type":"integer","minimum":0,"exclusiveMinimum":true,"maximum":200,"default":50},"required":false,"name":"page_size","in":"query"}],"responses":{"200":{"description":"Customers page","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/Customer"}},"page":{"type":"number"},"page_size":{"type":"number"},"total":{"type":"number","nullable":true}},"required":["data","page","page_size","total"]}}}},"403":{"description":"Credential missing required scope or not dealer-scoped"}}},"post":{"summary":"Create a customer","description":"Creates a dealer-managed customer. Find-or-create semantics by email: if a customer with this email already exists in your account, that record is updated and returned instead of creating a duplicate.\n\nCreated customers are `managed_by: \"dealer\"` and fully editable. You cannot create a customer using your own account email.","tags":["Customers"],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CustomerCreate"}}}},"responses":{"201":{"description":"Customer created (or existing record updated by email match)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Customer"}}}},"400":{"description":"Validation or upstream rejection"}}}},"/v1/customers/{id}":{"get":{"summary":"Get a customer","description":"Returns a single customer.\n\nDealer-managed customers (`managed_by: \"dealer\"`) return all fields. Marketplace customers are only readable when they have an interaction with your account (booking or conversation) — otherwise 404 — and their `email`/`phone` are populated only once a confirmed booking exists. `birthdate` is never available for marketplace customers.","tags":["Customers"],"parameters":[{"schema":{"type":"integer","minimum":0,"exclusiveMinimum":true},"required":true,"name":"id","in":"path"}],"responses":{"200":{"description":"Customer","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Customer"}}}},"404":{"description":"Customer not found (or no relationship with this account)"}}},"patch":{"summary":"Update a customer","description":"Partially update a dealer-managed customer. Marketplace customers (`managed_by: \"marketplace\"`) are managed by the marketplace and cannot be edited — attempts return 403.","tags":["Customers"],"parameters":[{"schema":{"type":"integer","minimum":0,"exclusiveMinimum":true},"required":true,"name":"id","in":"path"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CustomerUpdate"}}}},"responses":{"200":{"description":"Updated customer","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Customer"}}}},"403":{"description":"Marketplace customers cannot be edited"},"404":{"description":"Customer not found"}}}},"/v1/locations":{"get":{"summary":"List locations","description":"Returns the dealer's pickup/drop-off locations with address and weekly hours. Use the ids with the `location_ids` filters on vehicle/booking reports and customer search — and to tie a booking or vehicle to its pickup location's hours.","tags":["Locations"],"responses":{"200":{"description":"Locations for the account","content":{"application/json":{"schema":{"$ref":"#/components/schemas/LocationsResponse"}}}},"403":{"description":"Credential missing required scope or not dealer-scoped"}}}}}}