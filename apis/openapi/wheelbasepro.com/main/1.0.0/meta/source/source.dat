-night owners; may be higher for owners charged per 24-hour period from the reservation time."},"booked_at":{"type":"string","description":"RFC3339 UTC timestamp when the booking was confirmed.","example":"2026-09-01T18:23:44Z"},"created_date":{"type":"string","description":"Date the booking record was created.","example":"2026-09-01"}},"required":["start_date","start_time","end_date","end_time","nights","duration","booked_at","created_date"]},"usage":{"type":"object","properties":{"mileage_out":{"type":"number"},"mileage_in":{"type":"number"},"mileage_used":{"type":"number"},"generator_out":{"type":"number"},"generator_in":{"type":"number"},"generator_used":{"type":"number"}},"required":["mileage_out","mileage_in","mileage_used","generator_out","generator_in","generator_used"]},"billing":{"type":"object","properties":{"rental_amount":{"$ref":"#/components/schemas/Money"},"addons":{"allOf":[{"$ref":"#/components/schemas/Money"},{"type":"object","properties":{"breakdown":{"type":"array","items":{"type":"object","properties":{"name":{"type":"string"},"amount":{"$ref":"#/components/schemas/Money"}},"required":["name","amount"]},"description":"Per-item breakdown of the addon total (name + amount); amounts sum to this total. Empty when the booking has no addons."}},"required":["breakdown"]}]},"discount":{"$ref":"#/components/schemas/Money"},"mileage_fee":{"$ref":"#/components/schemas/Money"},"generator_fee":{"$ref":"#/components/schemas/Money"},"subtotal":{"$ref":"#/components/schemas/Money"},"tax_total":{"$ref":"#/components/schemas/Money"},"outdoorsy_remitted_taxes":{"allOf":[{"$ref":"#/components/schemas/Money"},{"description":"Portion of tax_total that Outdoorsy remits on your behalf."}]},"owner_fees":{"$ref":"#/components/schemas/Money"},"renter_fees":{"$ref":"#/components/schemas/Money"},"renter_services_fees":{"allOf":[{"$ref":"#/components/schemas/Money"},{"description":"Renter-paid services (insurance, roadside, etc.)."}]},"total":{"$ref":"#/components/schemas/Money"},"security_deposit":{"$ref":"#/components/schemas/Money"},"amount_paid":{"$ref":"#/components/schemas/Money"},"balance_due":{"allOf":[{"$ref":"#/components/schemas/Money"},{"description":"total − amount_paid; zero when fully paid."}]},"cc_fees":{"$ref":"#/components/schemas/Money"}},"required":["rental_amount","addons","discount","mileage_fee","generator_fee","subtotal","tax_total","outdoorsy_remitted_taxes","owner_fees","renter_fees","renter_services_fees","total","security_deposit","amount_paid","balance_due","cc_fees"]},"payout":{"type":"object","nullable":true,"properties":{"id":{"type":"number"},"status":{"type":"string"}},"required":["id","status"],"description":"Consigned payout, when the booking is part of one."}},"required":["id","status","source","import_id","agent_name","listing","renter","dates","usage","billing","payout"]},"BookingReportResponse":{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/BookingReportRow"}},"page":{"type":"number"},"page_size":{"type":"number"},"total":{"type":"number","nullable":true,"description":"Count of rows matching the filters before pagination. Null only when the upstream cannot provide a count; then page until you receive fewer rows than page_size."}},"required":["data","page","page_size","total"]},"TransactionRow":{"type":"object","properties":{"id":{"type":"number"},"category":{"type":"string","enum":["charge","refund","payout","transfer","fee","adjustment"],"description":"Normalized money movement. `refund`/`payout` reduce dealer net; `transfer` is internal settlement.","example":"charge"},"type":{"type":"string","description":"Raw upstream transaction type (e.g. reservation_charge, cash_refund).","example":"reservation_charge"},"display_type":{"type":"string","description":"Human-readable label for the transaction type.","example":"Reservation Charge"},"status":{"type":"string","example":"completed"},"description":{"type":"string"},"amount":{"allOf":[{"$ref":"#/components/schemas/Money"},{"description":"Gross transaction amount, always positive. See `category` for direction."}]},"refunded":{"allOf":[{"$ref":"#/components/schemas/Money"},{"description":"Amount refunded against this row; a meaningful zero on non-refund rows."}]},"fees":{"type":"object","properties":{"cc_fee":{"$ref":"#/components/schemas/Money"},"sales_tax":{"$ref":"#/components/schemas/Money"},"owner_fee":{"$ref":"#/components/schemas/Money"},"service_fee":{"$ref":"#/components/schemas/Money"},"fx_fee":{"$ref":"#/components/schemas/Money"}},"required":["cc_fee","sales_tax","owner_fee","service_fee","fx_fee"],"description":"Dealer-facing fee breakdown for this transaction. Excludes the marketplace's own fee."},"method":{"type":"object","nullable":true,"properties":{"kind":{"type":"string","example":"card"},"brand":{"type":"string"},"last_four":{"type":"string"}},"required":["kind","brand","last_four"],"description":"Payment instrument. `kind` is `card` for card payments, otherwise the source (cash, check, credits)."},"dates":{"type":"object","properties":{"created":{"type":"string","description":"RFC3339 UTC timestamp the transaction was created/charged.","example":"2026-07-15T18:23:44Z"},"charged":{"type":"string","nullable":true,"example":"2026-07-15"},"expected_deposit_date":{"type":"string","nullable":true,"description":"When funds are expected to deposit; null if not yet scheduled."},"deposited_at":{"type":"string","nullable":true,"description":"Actual deposit date; null until settled."}},"required":["created","charged","expected_deposit_date","deposited_at"]},"booking":{"type":"object","nullable":true,"properties":{"id":{"type":"number"}},"required":["id"],"description":"The booking this transaction belongs to."},"refund_of":{"type":"number","nullable":true,"description":"For refund rows, the id of the original charge; null otherwise."}},"required":["id","category","type","display_type","status","description","amount","refunded","fees","method","dates","booki