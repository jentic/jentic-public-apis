{
  "openapi": "3.0.3",
  "info": {
    "title": "Cobrat API v2",
    "description": "API Cobrat v2 para consulta de boletos e NFS-e",
    "version": "2.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/G7472/cobrat-api-v2/2.0"
  },
  "servers": [
    {
      "url": "https://api.cobrat.com.br/v2"
    }
  ],
  "security": [
    {
      "OAuth2ClientCredentials": []
    }
  ],
  "components": {
    "securitySchemes": {
      "OAuth2ClientCredentials": {
        "type": "oauth2",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://api.cobrat.com.br/v2/oauth/token",
            "scopes": {
              "api_v2": "Acesso à API v2"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/oauth/token": {
      "post": {
        "summary": "Obter access token OAuth2",
        "description": "Geração de token usando Client Credentials",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "grant_type",
                  "client_id",
                  "client_secret",
                  "scope"
                ],
                "properties": {
                  "grant_type": {
                    "type": "string",
                    "example": "client_credentials"
                  },
                  "client_id": {
                    "type": "string",
                    "example": "SEU_CLIENT_ID"
                  },
                  "client_secret": {
                    "type": "string",
                    "example": "SEU_CLIENT_SECRET"
                  },
                  "scope": {
                    "type": "string",
                    "example": "api_v2"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token gerado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "access_token": {
                      "type": "string"
                    },
                    "token_type": {
                      "type": "string",
                      "example": "Bearer"
                    },
                    "expires_in": {
                      "type": "integer",
                      "example": 3600
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/boletos": {
      "get": {
        "summary": "Listar boletos",
        "description": "Retorna boletos de acordo com os filtros informados",
        "parameters": [
          {
            "name": "start_date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Data inicial (YYYY-MM-DD)"
          },
          {
            "name": "end_date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Data final (YYYY-MM-DD)"
          },
          {
            "name": "filter_date_by",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "due_date",
                "created_at",
                "payment_cancellation_date"
              ]
            },
            "description": "Campo usado para o filtro de data"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Status do boleto (ex. EMABERTO,VENCIDO,PAGO)"
          },
          {
            "name": "issuer",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "inter",
                "itau",
                "cora"
              ]
            },
            "description": "Emissor do boleto"
          },
          {
            "name": "client_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "ID do cliente"
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de boletos",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/nfses": {
      "get": {
        "summary": "Listar NFS-es",
        "description": "Retorna notas fiscais de serviço conforme filtros",
        "parameters": [
          {
            "name": "start_date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Data inicial (YYYY-MM-DD)"
          },
          {
            "name": "end_date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Data final (YYYY-MM-DD)"
          },
          {
            "name": "filter_date_by",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "created_at"
              ]
            },
            "description": "Campo usado para o filtro de data"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Status da NFS-e (PROCESSANDO, CONCLUIDO, etc)"
          },
          {
            "name": "client_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "ID do cliente"
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de NFS-es",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    }
  }
}
