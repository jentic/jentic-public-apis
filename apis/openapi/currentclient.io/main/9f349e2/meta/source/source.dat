            "description": "List of participants currently in the call",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CallParticipant"
            }
          },
          "ParticipantsVersion": {
            "title": "Participantsversion",
            "description": "Monotonic counter bumped by every write of `Participants` this service makes (stamped centrally in CRUDCall.update_call), and pinned by crud_calls.pin_call_to_what_was_read so a read-modify-write of the whole list is refused when ANOTHER roster writer has rewritten it since the read (PRO-8606). `Status`/`CallEndedTime` alone only catch the call's finaliser: two roster writers read the same values for both, so the slower one used to put back a row the faster one removed. Absent on records last written before PRO-8606, which the pin reads as \"no version yet\". Internal bookkeeping: excluded from the `Call` response model, like `RefusedAddKeys` -- though a `CallInDBBase` response such as `CallSharedResponse` still carries both.",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "RecordingDurationTime": {
            "title": "RecordingDurationTime",
            "description": "Time in seconds of the call recording",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "RecordingSid": {
            "title": "RecordingSid",
            "description": "Specific recording sid for the call, useful for twilio api",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "RecordingStatus": {
            "title": "RecordingStatus",
            "description": "Status of the recording",
            "anyOf": [
              {
                "$ref": "#/components/schemas/RecordingStatusEnum"
              },
              {
                "type": "null"
              }
            ]
          },
          "RecordingUrl": {
            "title": "RecordingUrl",
            "description": "Url to the call recording",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "RefusedAddKeys": {
            "title": "Refusedaddkeys",
            "description": "Participant keys (Type|TeamMemberId|Number) whose mid-call add this service staged and then took back because the conference refused it with nothing dialled -- newest last, see crud_calls._refused_add_key. Written beside the removal itself and cleared for a key by every later write this service makes for that identity (a new add staging its row, a cc-sip lifecycle event the roster consumer applies). Read by crud_calls.hide_refused_phantom_rows, which uses it to keep a FINISHED row another service's reconciliation re-materialised out of a reader's copy of the roster (PRO-8264 QA round 20). Internal bookkeeping: excluded from every `Call` response, and cleared off the instance by hide_refused_phantom_rows as it reads it.",
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "SK": {
            "title": "Sk",
            "type": "string"
          },
          "Searchable": {
            "title": "Searchable",
            "type": "string"
          },
          "SourceCallSK": {
            "title": "Sourcecallsk",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "Status": {
            "$ref": "#/components/schemas/CallStatusEnum"
          },
          "StatusCallSid": {
            "title": "Statuscallsid",
            "description": "The Twilio CallSid that produced the current StatusSequence.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "StatusSequence": {
            "title": "Statussequence",
            "description": "Highest Twilio SequenceNumber processed for status updates. Stored as a DynamoDB N type for correct numeric comparison.",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "StatusWeight": {
            "title": "Statusweight",
            "description": "Numeric weight of the current Status, used to prevent cross-CallSid status regressions.",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "TYPE": {
            "title": "Type",
            "type": "string"
          },
          "Tags": {
            "title": "Tags",
            "description": "Tags for the message",
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "TranscriptionStatus": {
            "title": "TranscriptionStatus",
            "description": "Status of the transcription",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "TranscriptionText": {
            "title": "TranscriptionText",
            "description": "Text of the voicemail",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "TransferredAtTime": {
            "title": "Transferredattime",
            "description": "Epoch timestamp when the call was transferred",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "TransferredByMemberId": {
            "title": "Transferredbymemberid",
            "description": "The id of the member that transferred the call away. On the unattended transfer_to_inbox path the transferred record is de-keyed off GSI4 and a NEW destination leg reuses the call id, so the destination's AnsweredByMemberId is the RECIPIENT, not the transferrer. read_call backfills this from the source record's AnsweredByMemberId (PRO-7260). The attended path (CRUDCall.transfer) stamps in place and keeps GSI4, so there AnsweredByMemberId is already the transferrer and this stays unset.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "TransferredToMemberId": {
            "title": "Transferredtomemberid",
            "description": "The id of the member that the call was transferred to",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "TransferredToNumber": {
            "title": "Transferredtonumber",
            "description": "The phone number that the call was transferred to",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "UpdatedTime": {
            "title": "Updatedtime",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "UserId": {
            "title": "User Id",
            "description": "Id of the app user",
            "type": "string",
            "example": "1234-abcd-4567-ABCD"
          },
          "UserNumber": {
            "title": "Number for the app user",
            "description": "Number with a leading +1, or `member:<id>` on a direct team-member call (PRO-8680)",
            "type": "string",
            "example": "+18008675309",
            "pattern": "^(\\+[1-9]\\d{1,14}|member:.+)$"
          }
        },
        "required": [
          "CallId",
          "TYPE",
          "PK",
          "SK",
          "Searchable"
        ]
      },
