                    "pattern": "([A-Za-z0-9:]+):(eq|ne|like|notlike|contains|containsany|beginswith|isin|between|notcontains|gt|gte|lt|lte|exists|notexists):([\\w\\d\\s.,_@/#&+-]*)"
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "style": "form"
          },
          {
