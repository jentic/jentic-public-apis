            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WebhookEndpoint"
            }
          }
        },
        "required": [
          "records"
        ]
      },
      "WebhookEventSubscription": {
        "title": "WebhookEventSubscription",
        "description": "One event this webhook endpoint is (or could be) subscribed to.\n\nEventName may be an event this API cannot itself subscribe to, if the\nsubscription was created elsewhere in the app; PUT /{id}/events leaves\nthose alone rather than removing them.",
        "type": "object",
        "properties": {
          "EventName": {
            "$ref": "#/components/schemas/RoutingEventNamesEnum"
          },
          "IsEnabled": {
            "title": "Isenabled",
            "type": "boolean"
          }
        },
        "required": [
          "EventName",
          "IsEnabled"
        ]
      },
      "WebhookEventSubscriptionsUpdate": {
        "title": "WebhookEventSubscriptionsUpdate",
        "description": "Desired set of subscribed events for PUT /api/v1/webhooks/{id}/events.\n\nReplaces the full set of event subscriptions with exactly the events\nlisted here (not a delta):\n- An event listed here with no existing subscription is subscribed\n  (enabled).\n- An event listed here that's already subscribed but disabled is\n  re-enabled.\n- A currently-enabled subscription for an event not listed here is\n  removed.\n- A currently-disabled subscription for an event not listed here is\n  left untouched.\n\nOnly the events listed under EventNames below can be subscribed to\nhere. A subscription for any other event -- created elsewhere in the\napp -- is left untouched by this call, listed or not.",
        "type": "object",
        "properties": {
          "EventNames": {
            "title": "Eventnames",
            "description": "Events to subscribe this webhook endpoint to. Accepts only: MESSAGE_INCOMING, SMS_SENT, SMS_UNDELIVERED, CONVERSATION_REMINDER_DUE, CALL_LOG, CALL_MISSED, VOICEMAIL_RECEIVED, CALL_RECORDING_COMPLETED, CALL_TRANSCRIPT_COMPLETED, CALL_AI_SUMMARY_COMPLETED, NEW_SUBMISSION, TETHER_WIDGET_SUBMISSION, INBOX_CREATED, INBOX_DELETED. Any other event is rejected with a 400 -- including one this endpoint already has a subscription for, created elsewhere in the app, which GET /{id}/events will report but this call cannot manage.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RoutingEventNamesEnum"
            }
          }
        },
        "required": [
          "EventNames"
        ]
      },
      "ChannelType": {
        "type": "string",
        "enum": [
          "sms",
          "whatsapp"
        ]
      },
