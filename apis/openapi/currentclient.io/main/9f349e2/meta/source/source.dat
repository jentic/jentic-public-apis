      "MessageStatusEnum": {
        "title": "MessageStatusEnum",
        "description": "MessageStatusEnum\n\nStatus of the message",
        "type": "string",
        "enum": [
          "created",
          "pending",
          "ready",
          "cancelled",
          "blockednumber",
          "unsubscriber",
          "cannotroute",
          "error",
          "invalid",
          "nosms",
          "presenderror",
          "senderror",
          "unsubscribed",
          "sessionexpired",
          "accepted",
          "delivered",
          "failed",
          "queued",
          "read",
          "sending",
          "sent",
          "undelivered",
          "received",
          "receiving",
          "partiallydelivered"
        ]
      },
      "NotetakerProviderEnum": {
        "title": "NotetakerProviderEnum",
        "description": "Notetaker Provider Enum\n\nPRO-7319: which AI notetaker's dedicated phone number this inbox should\nauto-conference into a call once it connects. Purely a visual/reference\nlabel for the team (which icon/name to show in settings) -- it has no\neffect on how the dial-in itself works, since that always just dials\n`NotetakerPhoneNumber`. OTHER covers any notetaker not in this list yet;\nnew named providers get appended here as they're added.",
        "type": "string",
        "enum": [
          "JUMP",
          "ZOCKS",
          "HAZEL",
          "WEALTHBOX",
          "OTHER"
        ]
      },
      "PermissionSettings": {
        "title": "PermissionSettings",
        "description": "Model to hold inbox permission settings",
        "type": "object",
        "properties": {
          "Editors": {
            "title": "Editors",
            "type": "array",
            "default": [],
            "items": {
              "type": "string"
            }
          },
          "Viewers": {
            "title": "Viewers",
            "type": "array",
            "default": [],
            "items": {
              "type": "string"
            }
          }
        }
      },
      "RecordingStatusEnum": {
        "title": "RecordingStatusEnum",
        "description": "RecordingStatusEnum\n\nRecording Status of the call",
        "type": "string",
        "enum": [
          "in-progress",
          "completed",
          "absent"
        ]
      },
      "VoiceProviderEnum": {
        "title": "VoiceProviderEnum",
        "description": "Voice Provider Enum\n\nPRO-7115: which voice stack places and receives calls for THIS inbox.\nPer inbox, deliberately not per workspace: one workspace has to be able\nto run a Twilio inbox and a CC SIP inbox side by side, both live in the\nsame session.\n\nValues are lowercase, unlike the ALL-CAPS `InboundTypeEnum` /\n`ForwardingVoicemailModeEnum` above. That is not a style slip: cc-app-core\npasses this string verbatim from `resolveProviderConfig` into\n`createVoiceDriver`, whose registered driver ids are lowercase\n(`registerVoiceDriver('twilio', ...)`), and there is no normalization seam\nbetween the two. An ALL-CAPS value here would raise\nUnknownVoiceProviderError in the client.",
        "type": "string",
        "enum": [
          "twilio",
          "sip"
        ]
      },
      "WhatsAppOptInInfo": {
        "title": "WhatsAppOptInInfo",
        "description": "WhatsAppOptInInfo\n\nRecords the current state of a contact's consent to receive WhatsApp\nbusiness-initiated (template) messages, and how/when that state was\nlast set. Distinct from SMS opt-OUT, which is tracked separately via\nOPT_OUT_KEYWORDS/Unsubscriber (PRO-4154).\n\nThis must always be written as a persistent record, never removed:\nan opt-out (STOP) sets OptedIn=False rather than deleting the field,\nbecause a merely-absent field is indistinguishable from \"never\ncontacted\" -- which would let the very next inbound WhatsApp message\nsilently re-enable opt-in via the auto-opt-in path in\nCRUDConversation._record_inbound_session_signal.",
        "type": "object",
        "properties": {
          "OptedIn": {
            "title": "Optedin",
            "type": "boolean",
            "default": true
          },
          "Source": {
            "$ref": "#/components/schemas/WhatsAppOptInSourceEnum"
          },
          "Time": {
            "title": "Time",
            "type": "integer"
          }
        },
        "required": [
          "Time",
          "Source"
        ]
      },
      "WhatsAppOptInSourceEnum": {
        "title": "WhatsAppOptInSourceEnum",
        "description": "WhatsAppOptInSourceEnum\n\nHow WhatsAppOptIn on a conversation was captured.",
        "type": "string",
        "enum": [
          "inbound_message",
          "manual",
          "stop_keyword",
          "start_keyword"
        ]
      },
      "ConditionEnum": {
        "title": "ConditionEnum",
        "description": "ConditionEnum\n\nEnum for condition check",
        "type": "string",
        "enum": [
          "NOREPLYSINCE",
          "NONE"
        ]
      },
      "ConversationContact": {
        "title": "ConversationContact",
