      "WebhookEndpoint": {
        "title": "WebhookEndpoint",
        "description": "A webhook endpoint.\n\nNever includes the signing secret -- that's returned only once, by\nPOST /api/v1/webhooks (creation) or POST /{id}/rotate-secret. Save it\nthen; it cannot be retrieved again afterward.",
        "type": "object",
        "properties": {
          "ConnectorName": {
            "title": "Connectorname",
            "type": "string"
          },
          "CreatedAt": {
            "title": "Createdat",
            "type": "string"
          },
          "IsEnabled": {
            "title": "Isenabled",
            "type": "boolean"
          },
          "Url": {
            "title": "Url",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "WebhookEndpointId": {
            "title": "Webhookendpointid",
            "description": "The connector id",
            "type": "string"
          }
        },
        "required": [
          "WebhookEndpointId",
          "ConnectorName",
          "IsEnabled",
          "CreatedAt"
        ]
      },
      "WebhookEndpointCreate": {
        "title": "WebhookEndpointCreate",
        "description": "Properties to receive on POST /api/v1/webhooks",
        "type": "object",
        "properties": {
          "ConnectorName": {
            "title": "Connectorname",
            "description": "Display name; defaults to a generated name if omitted",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "IsEnabled": {
            "title": "Isenabled",
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": true
          },
          "Url": {
            "title": "Url",
            "description": "HTTPS URL deliveries are POSTed to",
            "type": "string"
          }
        },
        "required": [
          "Url"
        ]
      },
      "WebhookEndpointUpdate": {
        "title": "WebhookEndpointUpdate",
        "description": "Properties to receive on PUT /api/v1/webhooks/{id}",
        "type": "object",
        "properties": {
          "ConnectorName": {
            "title": "Connectorname",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "IsEnabled": {
            "title": "Isenabled",
