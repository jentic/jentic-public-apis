              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "Url": {
            "title": "Url",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "WebhookEndpointWithSecret": {
        "title": "WebhookEndpointWithSecret",
        "description": "Same shape as WebhookEndpoint, plus the signing secret.\n\nOnly returned by POST /api/v1/webhooks (creation) and\nPOST /api/v1/webhooks/{id}/rotate-secret. Save this value immediately\n-- it cannot be retrieved again after this response.",
        "type": "object",
        "properties": {
          "ConnectorName": {
            "title": "Connectorname",
            "type": "string"
          },
          "CreatedAt": {
            "title": "Createdat",
            "type": "string"
          },
          "IsEnabled": {
            "title": "Isenabled",
            "type": "boolean"
          },
          "Secret": {
            "title": "Secret",
            "description": "HMAC-SHA256 signing secret; shown only here and on rotate",
            "type": "string"
          },
          "Url": {
            "title": "Url",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "WebhookEndpointId": {
            "title": "Webhookendpointid",
            "description": "The connector id",
            "type": "string"
          }
        },
        "required": [
          "WebhookEndpointId",
          "ConnectorName",
          "IsEnabled",
          "CreatedAt",
          "Secret"
        ]
      },
      "WebhookEndpointsPaginated": {
        "title": "WebhookEndpointsPaginated",
        "description": "Pagination wrapper for GET /api/v1/webhooks",
        "type": "object",
        "properties": {
          "meta": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ResponseMetaBase"
              },
              {
                "type": "null"
              }
            ]
          },
          "records": {
