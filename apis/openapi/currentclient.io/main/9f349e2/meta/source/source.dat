        ]
      },
      "ScheduledMessage": {
        "title": "ScheduledMessage",
        "description": "ScheduledMessage\n\nThe model to be used for responses. Doesnt include internal PK and SK",
        "type": "object",
        "properties": {
          "ChannelType": {
            "title": "Channel Type",
            "description": "PRO-10056: the channel the sender picked in the composer. Sent to outbounds as RequestedChannelType when the message fires. Omit to let outbounds derive it, as before.",
            "anyOf": [
              {
                "$ref": "#/components/schemas/ChannelTypeEnum"
              },
              {
                "type": "null"
              }
            ],
            "example": "whatsapp"
          },
          "Condition": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ConditionEnum"
              },
              {
                "type": "null"
              }
            ]
          },
          "ContactId": {
            "title": "Contact Id",
            "description": "Id of the contact for outbounds",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "example": "1234-abcd-4567-ABCD"
          },
          "ContactName": {
            "title": "Contactname",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "ContactNumber": {
            "title": "Contact Number",
            "description": "Phone with a leading +1",
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\+1[0-9]{10}$"
              },
              {
                "type": "null"
              }
            ],
            "example": "+18008675309"
          },
          "Contacts": {
            "title": "Contacts",
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ConversationContact"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "ConversationId": {
            "title": "Conversation Id",
            "description": "Id of the conversation for outbounds",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "example": "CH132314234"
          },
          "CreatedTime": {
            "title": "Createdtime",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          },
          "Message": {
            "title": "Message",
            "description": "Field of message to send",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "example": "Mr. Watson, come here. I want to see you"
          },
          "MessageMediaItems": {
            "title": "MessageMediaItems",
            "description": "Media to include in message",
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/MessageMediaItem"
                }
              },
              {
                "type": "null"
              }
            ],
            "example": [
              {
                "MediaType": "image/png",
                "MediaUrl": "https://unsplash.com/photos/5bMj6krNKiM/download?force=true&w=640"
              }
            ]
          },
          "Meta": {
            "title": "Meta",
            "description": "Key values of meta data for this message, will be published as attributes to topic on callbacks",
            "type": "object",
            "additionalProperties": true
          },
          "ScheduledMessageId": {
            "title": "Scheduledmessageid",
            "type": "string"
          },
          "SendAttempted": {
            "title": "Send Attempted",
            "description": "PRO-7740: whether the outbounds SMS POST was attempted before the failure this update records. Set only on a FAILED write coming from module-messages' SendScheduledMessage. Once true, the row is terminal regardless of remaining retry budget -- the SMS may already have reached the customer (WithRequests' 5s timeout means a slow-but-accepted POST looks identical to a failed one), so a retry can only send it again, never repair it. False/absent means the failure happened before any send was attempted (e.g. GetUserProfile/CheckCondition), which IS safely retryable.",
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "SendAttemptsCount": {
            "title": "Sendattemptscount",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "SendTime": {
            "title": "Sendtime",
            "type": "string"
          },
          "SenderMemberId": {
            "title": "Sender Member Id",
            "description": "Memeber id for the sender",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "example": "1234-abcd-4567-ABCD"
          },
          "SenderName": {
            "title": "Sender Name",
            "description": "Name of the Sender for quick reference",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "example": "Jen Framer"
          },
          "SourceType": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SourceTypeEnum"
              },
              {
                "type": "null"
              }
            ]
          },
          "Status": {
            "$ref": "#/components/schemas/ScheduledMessageStatusEnum"
          },
          "UpdatedTime": {
            "title": "Updatedtime",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "UserId": {
            "title": "Userid",
            "type": "string"
          },
          "UserNumber": {
            "title": "Number for the app user",
            "description": "Number with a leading +1",
            "type": "string",
            "example": "+18008675309",
            "pattern": "^\\+1[0-9]{10}$"
          }
        },
        "required": [
          "SendTime",
          "UserNumber",
          "UserId",
          "ScheduledMessageId",
          "CreatedTime",
          "Status"
        ]
      },
