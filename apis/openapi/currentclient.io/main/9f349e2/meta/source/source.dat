                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "ErrorMessage": {
            "title": "Errormessage",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "HoldUntil": {
            "title": "Hold Until",
            "description": "PRO-8559: epoch-seconds when a Status=pending message's undo-send grace period ends and it is actually handed to Twilio. Set only while Status is pending; the frontend renders the remaining hold from this instead of re-deriving its own client-side timer, so the window survives a reload. Never cleared -- it stays on the row, stale, once the message leaves pending -- so consumers must gate on Status==pending, not merely on this field being set.",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "IsIgnored": {
            "title": "Isignored",
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "IsSilenced": {
            "title": "Issilenced",
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "LinkedComplianceMessageId": {
            "title": "Linked Compliance Message Id",
            "description": "PRO-8589: set on a held real (non-compliance) message whose first-contact compliance sub-message was ALSO held for the same undo-send grace window, pointing at that sub-message's own MessageId. cancel_pending_send follows it to cancel the compliance row in lockstep with this one, so undoing a first-ever send never leaves the contact holding a bare Reply-STOP line with no message attached to it. Unset for every other message -- compliance resends, and automated / admin-or-service / CH sends, which skip the hold entirely.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
