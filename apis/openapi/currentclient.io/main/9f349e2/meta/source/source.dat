          "BestDeliveryStatus": {
            "title": "Best Delivery Status",
            "description": "For a group-conversation message, the highest-ranked leg success (delivered/read, by MESSAGE_STATUS_WEIGHT) ever recorded on this row, kept independent of the row's own Status. Written on every success receipt via the group-delivery path and never downgraded. Exists because a later failing leg can resolve the row's Status to partiallydelivered -- a single scalar that cannot also encode 'and the best success so far was read' -- so once that happens, prior_status stops being a usable record of it. Without this field, a read receipt followed by a failing leg followed by that leg merely CORRECTING to delivered (rather than read) permanently lost the fact that someone had already read the message (PRO-7413). Populated only via the onDeliveryUpdated group-delivery path (crud.message.update_status resolve_as_group_delivery=True); unset for a 1:1 message.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
