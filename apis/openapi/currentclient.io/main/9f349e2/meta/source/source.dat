      "InboxTypeEnum": {
        "title": "InboxTypeEnum",
        "description": "Inbox Type Enum\n\nPRO-4150 shipped this as a mutable flip on one row per number -- \"an\ninbox is either REGULAR or WHATSAPP, never both.\" PRO-7929 corrects\nthat: a number can hold a REGULAR inbox and a WHATSAPP inbox at the\nsame time, as two separate coexisting records (see `Inbox.make_sk`).\nThis enum still names the two channels; it is no longer a toggle on a\nsingle record, and outbound channel is still determined by which of\nthe two inbox records you composed from.",
        "type": "string",
        "enum": [
          "REGULAR",
          "WHATSAPP"
        ]
      },
      "Message": {
        "title": "Message",
        "description": "Message\n\nThe model to be used for responses. Doesnt include internal PK and SK",
        "type": "object",
        "properties": {
          "ArchiverIds": {
            "title": "Archiverids",
            "description": "Dictionary to store archiver ids - key is ArchiverId, value is ArchiverType",
            "anyOf": [
