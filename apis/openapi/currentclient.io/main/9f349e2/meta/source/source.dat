      "Conversation": {
        "title": "Conversation",
        "description": "Conversation\n\nThe model to be used for responses. Doesnt include internal PK and SK",
        "type": "object",
        "properties": {
          "AssignedByUserId": {
            "title": "Assigned By User Id",
            "description": "Member ID of the team member who made the assignment",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "AssignedTime": {
            "title": "Assigned Time",
            "description": "ISO-8601 timestamp of when the assignment was made",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "AssignedToUserId": {
            "title": "Assigned To User Id",
            "description": "Member ID of the team member this conversation is assigned to",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "ChannelType": {
