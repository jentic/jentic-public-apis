              }
            ]
          },
          "ConversationId": {
            "title": "Conversation Id",
            "description": "Id of the conversation for outbounds",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "example": "CH132314234"
          },
          "Message": {
            "title": "Message",
            "description": "Field of message to send",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "example": "Mr. Watson, come here. I want to see you"
          },
          "MessageMediaItems": {
            "title": "MessageMediaItems",
            "description": "Media to include in message",
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/MessageMediaItem"
                }
              },
              {
                "type": "null"
              }
            ],
            "example": [
              {
                "MediaType": "image/png",
                "MediaUrl": "https://unsplash.com/photos/5bMj6krNKiM/download?force=true&w=640"
              }
            ]
          },
          "Meta": {
            "title": "Meta",
            "description": "Key values of meta data for this message, will be published as attributes to topic on callbacks",
            "type": "object",
            "additionalProperties": true
          },
          "SendAttempted": {
            "title": "Send Attempted",
            "description": "PRO-7740: whether the outbounds SMS POST was attempted before the failure this update records. Set only on a FAILED write coming from module-messages' SendScheduledMessage. Once true, the row is terminal regardless of remaining retry budget -- the SMS may already have reached the customer (WithRequests' 5s timeout means a slow-but-accepted POST looks identical to a failed one), so a retry can only send it again, never repair it. False/absent means the failure happened before any send was attempted (e.g. GetUserProfile/CheckCondition), which IS safely retryable.",
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "SendAttemptsCount": {
            "title": "Sendattemptscount",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "SendTime": {
            "title": "Sendtime",
            "type": "string"
          },
          "SenderMemberId": {
            "title": "Sender Member Id",
            "description": "Memeber id for the sender",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "example": "1234-abcd-4567-ABCD"
          },
          "SenderName": {
            "title": "Sender Name",
            "description": "Name of the Sender for quick reference",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "example": "Jen Framer"
          },
          "SourceType": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SourceTypeEnum"
              },
              {
                "type": "null"
              }
            ]
          },
          "UserNumber": {
            "title": "Number for the app user",
            "description": "Number with a leading +1",
            "type": "string",
            "example": "+18008675309",
            "pattern": "^\\+1[0-9]{10}$"
          }
        },
        "required": [
          "SendTime",
          "UserNumber"
        ]
      },
