{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "CompanyProof REST API",
    "version": "2.0.0",
    "description": "Resolve companies, retrieve structured profiles, stream adaptive intelligence, inspect the current API allowance, and create durable claim-verification proofs through CompanyProof. All endpoints require a CompanyProof API key.",
    "termsOfService": "https://companyproof.ai/terms"
  },
  "externalDocs": {
    "description": "CompanyProof developer documentation",
    "url": "https://companyproof.ai/docs"
  },
  "servers": [
    {
      "url": "https://companyproof.ai",
      "description": "CompanyProof production API"
    }
  ],
  "tags": [
    {
      "name": "Companies",
      "description": "Deterministic company resolution and structured profile retrieval."
    },
    {
      "name": "Intelligence",
      "description": "Adaptive company intelligence streamed as Server-Sent Events."
    },
    {
      "name": "Verification",
      "description": "Claim verification, evidence, and optional monitoring."
    },
    {
      "name": "Usage",
      "description": "Read-only plan, billing, credit-allowance, and request-rate information."
    }
  ],
  "security": [
    {
      "CompanyProofApiKey": []
    }
  ],
  "paths": {
    "/v2/companies/search": {
      "post": {
        "tags": [
          "Companies"
        ],
        "summary": "Resolve companies",
        "description": "Resolve legal entities by name, registration number, VAT/tax ID, or ticker and country. For US, CA, and CN, optionally narrow registry coverage with a matching subdivision; up to 10 non-empty city or state values can further narrow the search. This endpoint requires an active CompanyProof evaluation or paid entitlement and a `cp_live_` key. One accepted request consumes one shared credit.",
        "x-companyproof-plans": ["evaluation", "starter", "production", "enterprise"],
        "operationId": "searchCompanies",
        "x-companyproof-key-environments": [
          "live"
        ],
        "requestBody": {
          "required": true,
          "description": "JSON request body. Maximum size: 32 KiB.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompanySearchRequest"
              },
              "examples": {
                "nameSearch": {
                  "summary": "Search by company name and subdivision",
                  "value": {
                    "identifier_type": "name",
                    "identifier": "Example Technology",
                    "country": "US",
                    "subdivision": "US-CA",
                    "city_or_state": [
                      "Cupertino"
                    ],
                    "limit": 5
                  }
                },
                "tickerSearch": {
                  "summary": "Search by stock ticker",
                  "value": {
                    "identifier_type": "ticker",
                    "identifier": "EXM",
                    "country": "US",
                    "limit": 5
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Matching companies, ranked by identifier match.",
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/XRateLimitLimit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/XRateLimitRemaining"
              },
              "X-RateLimit-Reset": {
                "$ref": "#/components/headers/XRateLimitReset"
              },
              "X-Usage-Limit": {
                "$ref": "#/components/headers/XUsageLimit"
              },
              "X-Usage-Remaining": {
                "$ref": "#/components/headers/XUsageRemaining"
              },
              "X-Usage-Reset": {
                "$ref": "#/components/headers/XUsageReset"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompanySearchResponse"
                },
                "examples": {
                  "tickerMatch": {
                    "summary": "A registry-backed ticker match",
                    "value": {
                      "companies": [
                        {
                          "id": "company_12345",
                          "name": "EXAMPLE TECHNOLOGY INC.",
                          "registration_number": "C1234567",
                          "vat_tax_id": "",
                          "ticker": "EXM",
                          "country": "US",
                          "country_name": "United States",
                          "state": "CA",
                          "jurisdiction": "California",
                          "status": "Active",
                          "legal_form": "Corporation",
                          "incorporation_date": "2020-01-15",
                          "website": "https://example.com/",
                          "logo_url": "https://example.com/favicon.ico",
                          "evidence": {
                            "source_name": "Official registry",
                            "source_url": null,
                            "source_category": "Government Registry",
                            "source_comment": "Current registry record.",
                            "source_record_id": "registry-source-1",
                            "retrieved_at": "2026-09-02T12:00:00Z"
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationError"
          },
          "402": {
            "$ref": "#/components/responses/BillingPaymentRequired"
          },
          "403": {
            "$ref": "#/components/responses/LiveKeyRequired"
          },
          "413": {
            "$ref": "#/components/responses/BodyTooLarge"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "429": {
            "$ref": "#/components/responses/VerificationLimitExceeded"
          },
          "502": {
            "$ref": "#/components/responses/CompanyIntelligenceUnavailable"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    },
    "/v2/companies/{id}/profile": {
      "get": {
        "tags": [
          "Companies"
        ],
        "summary": "Retrieve a company profile",
        "description": "Retrieve a consolidated company profile and independently reported optional enrichment. Profile module payloads remain extensible; use `section_status` to determine availability. This endpoint requires an active CompanyProof evaluation or paid entitlement and a `cp_live_` key. One accepted request consumes one shared credit.",
        "x-companyproof-plans": ["evaluation", "starter", "production", "enterprise"],
        "operationId": "getCompanyProfile",
        "x-companyproof-key-environments": [
          "live"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "CompanyProof company identifier returned by company search.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._:-]+$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The consolidated profile. Optional enrichment may be unavailable without failing the core profile request.",
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/XRateLimitLimit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/XRateLimitRemaining"
              },
              "X-RateLimit-Reset": {
                "$ref": "#/components/headers/XRateLimitReset"
              },
              "X-Usage-Limit": {
                "$ref": "#/components/headers/XUsageLimit"
              },
              "X-Usage-Remaining": {
                "$ref": "#/components/headers/XUsageRemaining"
              },
              "X-Usage-Reset": {
                "$ref": "#/components/headers/XUsageReset"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompanyProfileResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationError"
          },
          "402": {
            "$ref": "#/components/responses/BillingPaymentRequired"
          },
          "403": {
            "$ref": "#/components/responses/LiveKeyRequired"
          },
          "404": {
            "$ref": "#/components/responses/CompanyNotFound"
          },
          "429": {
            "$ref": "#/components/responses/VerificationLimitExceeded"
          },
          "502": {
            "$ref": "#/components/responses/CompanyIntelligenceUnavailable"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    },
    "/v2/intelligence/query": {
      "post": {
        "tags": [
          "Intelligence"
        ],
        "summary": "Stream an intelligence query",
        "description": "Run an adaptive company-intelligence query. A successful response is a Server-Sent Events stream. Known events are `status`, `tool_call`, `tool_result`, `text`, `sources` (source name, link, nullable source update date and check time), `suggested_actions`, terminal `done`, and terminal `error`; clients must ignore unknown event types for forward compatibility. This endpoint requires an active CompanyProof evaluation or paid entitlement and a `cp_live_` key. One accepted stream consumes one shared credit.",
        "x-companyproof-plans": ["evaluation", "starter", "production", "enterprise"],
        "operationId": "queryCompanyIntelligence",
        "x-companyproof-key-environments": [
          "live"
        ],
        "requestBody": {
          "required": true,
          "description": "JSON request body. Maximum size: 64 KiB.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IntelligenceQueryRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A Server-Sent Events stream. Parse it with an SSE-compatible client and treat event payloads as adaptive output rather than the stable company-profile schema.",
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/XRateLimitLimit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/XRateLimitRemaining"
              },
              "X-RateLimit-Reset": {
                "$ref": "#/components/headers/XRateLimitReset"
              },
              "X-Usage-Limit": {
                "$ref": "#/components/headers/XUsageLimit"
              },
              "X-Usage-Remaining": {
                "$ref": "#/components/headers/XUsageRemaining"
              },
              "X-Usage-Reset": {
                "$ref": "#/components/headers/XUsageReset"
              },
              "Cache-Control": {
                "description": "The stream is private, is not cached, and must not be transformed. Additional cache directives may be present.",
                "schema": {
                  "type": "string",
                  "pattern": "(^|.*,\\s*)no-store(\\s*,.*|$)"
                }
              }
            },
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "A standards-compliant Server-Sent Events byte stream."
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationError"
          },
          "402": {
            "$ref": "#/components/responses/BillingPaymentRequired"
          },
          "403": {
            "$ref": "#/components/responses/LiveKeyRequired"
          },
          "413": {
            "$ref": "#/components/responses/BodyTooLarge"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "429": {
            "$ref": "#/components/responses/VerificationLimitExceeded"
          },
          "502": {
            "$ref": "#/components/responses/CompanyIntelligenceUnavailable"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    },
    "/v2/usage": {
      "get": {
        "tags": [
          "Usage"
        ],
        "summary": "Inspect the current API allowance",
        "description": "Return the plan, billing state, active period, claim-credit allowance, and request-per-minute limit for the authenticated key. The key environment selects the isolated live or test allowance. This read-only preflight consumes no claim credits, although it is subject to the shared request-rate limit.",
        "operationId": "getUsage",
        "x-companyproof-key-environments": [
          "test",
          "live"
        ],
        "x-companyproof-plans": [
          "sandbox",
          "evaluation",
          "starter",
          "production",
          "enterprise"
        ],
        "responses": {
          "200": {
            "description": "The isolated allowance for the authenticated key environment. Calling this endpoint does not increment credits.used.",
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/XRateLimitLimit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/XRateLimitRemaining"
              },
              "X-RateLimit-Reset": {
                "$ref": "#/components/headers/XRateLimitReset"
              },
              "X-Usage-Limit": {
                "$ref": "#/components/headers/XUsageLimit"
              },
              "X-Usage-Remaining": {
                "$ref": "#/components/headers/XUsageRemaining"
              },
              "X-Usage-Reset": {
                "$ref": "#/components/headers/XUsageReset"
              },
              "Cache-Control": {
                "description": "Usage responses are private and are not cached.",
                "schema": {
                  "type": "string",
                  "pattern": "(^|.*,\\s*)no-store(\\s*,.*|$)"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsageResponse"
                },
                "examples": {
                  "liveAllowance": {
                    "summary": "Production live-key allowance",
                    "value": {
                      "environment": "live",
                      "plan": "production",
                      "billing_status": "paid",
                      "period": {
                        "id": "stripe:sub_example:1797408000",
                        "starts_at": 1797408000,
                        "resets_at": 1800000000
                      },
                      "credits": {
                        "used": 7,
                        "limit": 5000,
                        "remaining": 4993
                      },
                      "requests_per_minute": 60
                    }
                  },
                  "testAllowance": {
                    "summary": "Isolated test-key allowance",
                    "value": {
                      "environment": "test",
                      "plan": "sandbox",
                      "billing_status": "free",
                      "period": {
                        "id": "test:2026-09",
                        "starts_at": null,
                        "resets_at": 1790812800
                      },
                      "credits": {
                        "used": 2,
                        "limit": 10,
                        "remaining": 8
                      },
                      "requests_per_minute": 10
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationError"
          },
          "429": {
            "$ref": "#/components/responses/RateLimitExceeded"
          },
          "503": {
            "description": "The active billing or evaluation period could not be established. No credits are consumed; retry after the indicated delay.",
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/XRateLimitLimit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/XRateLimitRemaining"
              },
              "X-RateLimit-Reset": {
                "$ref": "#/components/headers/XRateLimitReset"
              },
              "Retry-After": {
                "$ref": "#/components/headers/RetryAfter"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "billing_period_unavailable",
                    "message": "The current billing period is temporarily unavailable."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v2/claims/verify": {
      "post": {
        "tags": [
          "Verification"
        ],
        "summary": "Verify company claims",
        "description": "Verify structured claims or extract supported claims from a natural-language answer. One claim credit is reserved per claim. `cp_test_` keys are restricted to the documented CompanyProof sandbox sample; `cp_live_` keys can resolve eligible live company records. Monitoring requires an eligible plan and a live key.",
        "operationId": "verifyCompanyClaims",
        "x-companyproof-key-environments": [
          "test",
          "live"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Recommended for every verification write. A key is scoped to the account and key environment. Reusing it with an identical request replays the stored response; reusing it with a different request returns 409.",
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._:-]+$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "description": "JSON request body. Maximum size: 64 KiB.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClaimVerificationRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "A new verification proof was recorded.",
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/XRateLimitLimit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/XRateLimitRemaining"
              },
              "X-RateLimit-Reset": {
                "$ref": "#/components/headers/XRateLimitReset"
              },
              "X-Usage-Limit": {
                "$ref": "#/components/headers/XUsageLimit"
              },
              "X-Usage-Remaining": {
                "$ref": "#/components/headers/XUsageRemaining"
              },
              "X-Usage-Reset": {
                "$ref": "#/components/headers/XUsageReset"
              },
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClaimVerificationResponse"
                }
              }
            }
          },
          "200": {
            "description": "An existing proof was replayed for an identical idempotent request.",
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/XRateLimitLimit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/XRateLimitRemaining"
              },
              "X-RateLimit-Reset": {
                "$ref": "#/components/headers/XRateLimitReset"
              },
              "X-Usage-Limit": {
                "$ref": "#/components/headers/XUsageLimit"
              },
              "X-Usage-Remaining": {
                "$ref": "#/components/headers/XUsageRemaining"
              },
              "X-Usage-Reset": {
                "$ref": "#/components/headers/XUsageReset"
              },
              "X-Request-Id": {
                "$ref": "#/components/headers/XRequestId"
              },
              "Idempotent-Replayed": {
                "$ref": "#/components/headers/IdempotentReplayed"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClaimVerificationResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationError"
          },
          "402": {
            "$ref": "#/components/responses/BillingPaymentRequired"
          },
          "403": {
            "$ref": "#/components/responses/VerificationForbidden"
          },
          "409": {
            "$ref": "#/components/responses/IdempotencyConflict"
          },
          "404": {
            "$ref": "#/components/responses/CompanyNotFound"
          },
          "413": {
            "$ref": "#/components/responses/BodyTooLarge"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "422": {
            "$ref": "#/components/responses/NoSupportedClaims"
          },
          "429": {
            "$ref": "#/components/responses/VerificationLimitExceeded"
          },
          "502": {
            "$ref": "#/components/responses/VerificationUnavailable"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "CompanyProofApiKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "cp_live_… or cp_test_…",
        "description": "Send a CompanyProof API key as `Authorization: Bearer <key>` and keep it server-side. `cp_test_` keys are isolated to fixture verification. `cp_live_` keys can verify real-company claims; search, profile and intelligence additionally require an active CompanyProof evaluation or Starter, Production or Enterprise access. REST and MCP share account-wide rate and usage limits. Valid live credentials return HTTP 402 while a formerly paid account is suspended for billing; restoring payment reactivates the same credentials."
      }
    },
    "headers": {
      "XRateLimitLimit": {
        "description": "Account-wide request limit for the current 60-second window, shared by all keys and REST/MCP calls.",
        "schema": {
          "type": "integer",
          "minimum": 0
        }
      },
      "XRateLimitRemaining": {
        "description": "Requests remaining in the current 60-second window.",
        "schema": {
          "type": "integer",
          "minimum": 0
        }
      },
      "XRateLimitReset": {
        "description": "Unix timestamp in seconds when the request window resets.",
        "schema": {
          "type": "integer",
          "minimum": 0
        }
      },
      "RetryAfter": {
        "description": "Seconds to wait before retrying.",
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      },
      "XUsageLimit": {
        "description": "Claim-credit allowance for the active usage period.",
        "schema": {
          "type": "integer",
          "minimum": 0
        }
      },
      "XUsageRemaining": {
        "description": "Claim credits remaining in the active usage period.",
        "schema": {
          "type": "integer",
          "minimum": 0
        }
      },
      "XUsageReset": {
        "description": "Unix timestamp in seconds when the claim-credit allowance resets.",
        "schema": {
          "type": "integer",
          "minimum": 0
        }
      },
      "XRequestId": {
        "description": "Proof identifier for the verification request.",
        "schema": {
          "type": "string"
        }
      },
      "IdempotentReplayed": {
        "description": "Present with value `true` when an existing proof is replayed.",
        "schema": {
          "type": "string",
          "const": "true"
        }
      }
    },
    "responses": {
      "InvalidRequest": {
        "description": "The request body, identifier, path parameter, or idempotency key is invalid.",
        "headers": {
          "X-RateLimit-Limit": {
            "$ref": "#/components/headers/XRateLimitLimit"
          },
          "X-RateLimit-Remaining": {
            "$ref": "#/components/headers/XRateLimitRemaining"
          },
          "X-RateLimit-Reset": {
            "$ref": "#/components/headers/XRateLimitReset"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "AuthenticationError": {
        "description": "The CompanyProof API key is missing, invalid, or revoked.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "examples": {
              "missing": {
                "value": {
                  "error": {
                    "code": "authentication_required",
                    "message": "Use a CompanyProof API key in the Authorization header."
                  }
                }
              },
              "invalid": {
                "value": {
                  "error": {
                    "code": "invalid_api_key",
                    "message": "The API key is invalid or revoked."
                  }
                }
              }
            }
          }
        }
      },
      "BillingPaymentRequired": {
        "description": "The credential is valid, but live REST and MCP access is suspended because billing is not active. Dashboard, evidence and credential management remain available; access resumes after Stripe confirms payment.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "error": {
                "code": "billing_payment_required",
                "message": "Live CompanyProof API and MCP access is suspended until billing is resolved.",
                "billing_url": "/dashboard/billing"
              }
            }
          }
        }
      },
      "LiveKeyRequired": {
        "description": "This advanced operation requires both a `cp_live_` CompanyProof API key and either an active CompanyProof evaluation or Starter, Production or Enterprise access.",
        "headers": {
          "X-RateLimit-Limit": {
            "$ref": "#/components/headers/XRateLimitLimit"
          },
          "X-RateLimit-Remaining": {
            "$ref": "#/components/headers/XRateLimitRemaining"
          },
          "X-RateLimit-Reset": {
            "$ref": "#/components/headers/XRateLimitReset"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "examples": {
              "liveKeyRequired": {
                "value": {
                  "error": {
                    "code": "live_key_required",
                    "message": "This operation requires a live CompanyProof API key."
                  }
                }
              },
              "planUpgradeRequired": {
                "value": {
                  "error": {
                    "code": "plan_upgrade_required",
                    "message": "This operation requires Starter, Production or Enterprise access."
                  }
                }
              }
            }
          }
        }
      },
      "VerificationForbidden": {
        "description": "The requested verification is not allowed for the key environment or plan. Test keys are restricted to the CompanyProof sandbox sample; monitoring requires an eligible plan and a live key.",
        "headers": {
          "X-RateLimit-Limit": {
            "$ref": "#/components/headers/XRateLimitLimit"
          },
          "X-RateLimit-Remaining": {
            "$ref": "#/components/headers/XRateLimitRemaining"
          },
          "X-RateLimit-Reset": {
            "$ref": "#/components/headers/XRateLimitReset"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "BodyTooLarge": {
        "description": "The request body exceeds the endpoint limit.",
        "headers": {
          "X-RateLimit-Limit": {
            "$ref": "#/components/headers/XRateLimitLimit"
          },
          "X-RateLimit-Remaining": {
            "$ref": "#/components/headers/XRateLimitRemaining"
          },
          "X-RateLimit-Reset": {
            "$ref": "#/components/headers/XRateLimitReset"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "UnsupportedMediaType": {
        "description": "The request `Content-Type` is not `application/json`.",
        "headers": {
          "X-RateLimit-Limit": {
            "$ref": "#/components/headers/XRateLimitLimit"
          },
          "X-RateLimit-Remaining": {
            "$ref": "#/components/headers/XRateLimitRemaining"
          },
          "X-RateLimit-Reset": {
            "$ref": "#/components/headers/XRateLimitReset"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "RateLimitExceeded": {
        "description": "The request rate limit has been exceeded.",
        "headers": {
          "X-RateLimit-Limit": {
            "$ref": "#/components/headers/XRateLimitLimit"
          },
          "X-RateLimit-Remaining": {
            "$ref": "#/components/headers/XRateLimitRemaining"
          },
          "X-RateLimit-Reset": {
            "$ref": "#/components/headers/XRateLimitReset"
          },
          "Retry-After": {
            "$ref": "#/components/headers/RetryAfter"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "VerificationLimitExceeded": {
        "description": "The request rate limit or claim-credit allowance has been exceeded.",
        "headers": {
          "X-RateLimit-Limit": {
            "$ref": "#/components/headers/XRateLimitLimit"
          },
          "X-RateLimit-Remaining": {
            "$ref": "#/components/headers/XRateLimitRemaining"
          },
          "X-RateLimit-Reset": {
            "$ref": "#/components/headers/XRateLimitReset"
          },
          "X-Usage-Limit": {
            "$ref": "#/components/headers/XUsageLimit"
          },
          "X-Usage-Remaining": {
            "$ref": "#/components/headers/XUsageRemaining"
          },
          "X-Usage-Reset": {
            "$ref": "#/components/headers/XUsageReset"
          },
          "Retry-After": {
            "$ref": "#/components/headers/RetryAfter"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "IdempotencyConflict": {
        "description": "The idempotency key was previously used with a different request.",
        "headers": {
          "X-RateLimit-Limit": {
            "$ref": "#/components/headers/XRateLimitLimit"
          },
          "X-RateLimit-Remaining": {
            "$ref": "#/components/headers/XRateLimitRemaining"
          },
          "X-RateLimit-Reset": {
            "$ref": "#/components/headers/XRateLimitReset"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "NoSupportedClaims": {
        "description": "No supported claims were supplied or extracted.",
        "headers": {
          "X-RateLimit-Limit": {
            "$ref": "#/components/headers/XRateLimitLimit"
          },
          "X-RateLimit-Remaining": {
            "$ref": "#/components/headers/XRateLimitRemaining"
          },
          "X-RateLimit-Reset": {
            "$ref": "#/components/headers/XRateLimitReset"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "CompanyNotFound": {
        "description": "Entity resolution returned no company, or no profile exists for the supplied CompanyProof company ID.",
        "headers": {
          "X-RateLimit-Limit": {
            "$ref": "#/components/headers/XRateLimitLimit"
          },
          "X-RateLimit-Remaining": {
            "$ref": "#/components/headers/XRateLimitRemaining"
          },
          "X-RateLimit-Reset": {
            "$ref": "#/components/headers/XRateLimitReset"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "CompanyIntelligenceUnavailable": {
        "description": "Company intelligence is temporarily unavailable.",
        "headers": {
          "X-RateLimit-Limit": {
            "$ref": "#/components/headers/XRateLimitLimit"
          },
          "X-RateLimit-Remaining": {
            "$ref": "#/components/headers/XRateLimitRemaining"
          },
          "X-RateLimit-Reset": {
            "$ref": "#/components/headers/XRateLimitReset"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "VerificationUnavailable": {
        "description": "Verification could not complete before a verdict was recorded.",
        "headers": {
          "X-RateLimit-Limit": {
            "$ref": "#/components/headers/XRateLimitLimit"
          },
          "X-RateLimit-Remaining": {
            "$ref": "#/components/headers/XRateLimitRemaining"
          },
          "X-RateLimit-Reset": {
            "$ref": "#/components/headers/XRateLimitReset"
          },
          "X-Usage-Limit": {
            "$ref": "#/components/headers/XUsageLimit"
          },
          "X-Usage-Remaining": {
            "$ref": "#/components/headers/XUsageRemaining"
          },
          "X-Usage-Reset": {
            "$ref": "#/components/headers/XUsageReset"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "ServiceUnavailable": {
        "description": "The requested CompanyProof service is temporarily unavailable.",
        "headers": {
          "X-RateLimit-Limit": {
            "$ref": "#/components/headers/XRateLimitLimit"
          },
          "X-RateLimit-Remaining": {
            "$ref": "#/components/headers/XRateLimitRemaining"
          },
          "X-RateLimit-Reset": {
            "$ref": "#/components/headers/XRateLimitReset"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Stable machine-readable error code."
              },
              "message": {
                "type": "string",
                "description": "Human-readable explanation safe to display in developer tooling."
              },
              "billing_url": {
                "type": "string",
                "format": "uri-reference",
                "description": "Optional dashboard URL for resolving a billing-related error."
              }
            }
          }
        }
      },
      "CountryCode": {
        "type": "string",
        "description": "Uppercase ISO 3166-1 alpha-2 country code.",
        "pattern": "^[A-Z]{2}$",
        "examples": [
          "GB"
        ]
      },
      "CompanySearchRequest": {
        "type": "object",
        "required": [
          "identifier",
          "country"
        ],
        "properties": {
          "identifier_type": {
            "type": "string",
            "enum": [
              "name",
              "registration_number",
              "vat_tax_id",
              "ticker"
            ],
            "default": "name"
          },
          "identifier": {
            "type": "string",
            "minLength": 1,
            "description": "Company name, registration number, VAT/tax ID, or ticker, matching `identifier_type`."
          },
          "country": {
            "$ref": "#/components/schemas/CountryCode"
          },
          "subdivision": {
            "type": "string",
            "maxLength": 6,
            "pattern": "^$|^[A-Za-z]{2}-[A-Za-z0-9]{1,3}$",
            "description": "Optional ISO-style country-subdivision code for US, CA, or CN. Its country prefix must match `country`, for example `US-CA`."
          },
          "city_or_state": {
            "type": "array",
            "maxItems": 10,
            "description": "Optional city or state values used to narrow company resolution. Empty values are ignored.",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "\\S"
            }
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "default": 8
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "identifier_type": {
                  "enum": [
                    "registration_number",
                    "vat_tax_id",
                    "ticker"
                  ]
                }
              },
              "required": [
                "identifier_type"
              ]
            },
            "then": {
              "properties": {
                "identifier": {
                  "maxLength": 80
                }
              }
            },
            "else": {
              "properties": {
                "identifier": {
                  "maxLength": 200
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "subdivision": {
                  "minLength": 1
                }
              },
              "required": [
                "subdivision"
              ]
            },
            "then": {
              "properties": {
                "country": {
                  "enum": [
                    "US",
                    "CA",
                    "CN"
                  ]
                }
              }
            }
          }
        ]
      },
      "EvidenceReference": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_name",
          "source_url",
          "source_category",
          "source_comment",
          "source_record_id",
          "retrieved_at"
        ],
        "properties": {
          "source_name": {
            "type": "string"
          },
          "source_url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "source_category": {
            "type": "string",
            "description": "Source class, such as Government Registry, Enriched or Modelled."
          },
          "source_comment": {
            "type": "string"
          },
          "source_record_id": {
            "type": "string",
            "description": "Provider-independent string form of the source record identifier."
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          },
          "source_updated_at": {
            "type": [
              "string",
              "null"
            ],
            "description": "Last update date reported by the source, in ISO 8601 form. Null when unavailable; never the time CompanyProof ran the check."
          }
        }
      },
      "CompanySearchItem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "registration_number",
          "vat_tax_id",
          "ticker",
          "country",
          "country_name",
          "state",
          "jurisdiction",
          "status",
          "legal_form",
          "incorporation_date",
          "website",
          "logo_url",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "registration_number": {
            "type": "string"
          },
          "vat_tax_id": {
            "type": "string"
          },
          "ticker": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "country_name": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "jurisdiction": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "legal_form": {
            "type": "string"
          },
          "incorporation_date": {
            "type": "string"
          },
          "website": {
            "type": "string"
          },
          "logo_url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "evidence": {
            "$ref": "#/components/schemas/EvidenceReference"
          }
        }
      },
      "CompanySearchResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "companies"
        ],
        "properties": {
          "companies": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CompanySearchItem"
            }
          }
        }
      },
      "UsagePeriod": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "starts_at",
          "resets_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Stable identifier for the active test, free, evaluation, or Stripe billing period."
          },
          "starts_at": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "description": "Unix timestamp in seconds when the period began. Null for periods without an authoritative start timestamp."
          },
          "resets_at": {
            "type": "integer",
            "minimum": 0,
            "description": "Unix timestamp in seconds when the allowance resets or expires."
          }
        }
      },
      "UsageCredits": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "used",
          "limit",
          "remaining"
        ],
        "properties": {
          "used": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 0
          },
          "remaining": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "UsageResponse": {
        "type": "object",
        "description": "Current allowance for the authenticated API key environment. Reading this object consumes no claim credits.",
        "additionalProperties": false,
        "required": [
          "environment",
          "plan",
          "billing_status",
          "period",
          "credits",
          "requests_per_minute"
        ],
        "properties": {
          "environment": {
            "type": "string",
            "enum": [
              "live",
              "test"
            ],
            "description": "API-key environment whose isolated allowance is shown."
          },
          "plan": {
            "type": "string",
            "enum": [
              "sandbox",
              "evaluation",
              "starter",
              "production",
              "enterprise"
            ]
          },
          "billing_status": {
            "type": "string",
            "enum": [
              "test",
              "free",
              "evaluation",
              "paid",
              "grace",
              "suspended"
            ]
          },
          "period": {
            "$ref": "#/components/schemas/UsagePeriod"
          },
          "credits": {
            "$ref": "#/components/schemas/UsageCredits"
          },
          "requests_per_minute": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "ProfileSource": {
        "type": "object",
        "description": "Source-level provenance returned with registry, enriched or modelled profile data. New provenance metadata can be added without a version change.",
        "additionalProperties": true,
        "properties": {
          "category": {
            "type": [
              "string",
              "null"
            ],
            "description": "Source class, such as Government Registry, Enriched or Modelled."
          },
          "comment": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": [
              "integer",
              "string",
              "null"
            ],
            "description": "Provider source identifier. Upstream records can encode identifiers as integers or strings."
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri",
            "description": "Source URL when it can be disclosed; otherwise null."
          },
          "retrieved_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "ProfileModuleAccess": {
        "type": "object",
        "description": "Access metadata that can accompany an unavailable profile module.",
        "additionalProperties": true,
        "properties": {
          "permission": {
            "type": [
              "string",
              "integer",
              "null"
            ]
          },
          "permission_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "module": {
            "type": [
              "string",
              "integer",
              "null"
            ]
          },
          "module_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "app": {
            "type": [
              "string",
              "integer",
              "null"
            ]
          },
          "app_name": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ProfileModuleErrorContext": {
        "type": "object",
        "description": "Structured provider context for a module-level error. Providers can append diagnostic fields.",
        "additionalProperties": true,
        "properties": {
          "access": {
            "$ref": "#/components/schemas/ProfileModuleAccess"
          },
          "error_guard": {
            "type": [
              "string",
              "boolean",
              "null"
            ]
          },
          "message_guard": {
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ProfileModuleErrorDetail": {
        "description": "Provider explanation for an unavailable module. It can be text or structured access metadata.",
        "oneOf": [
          {
            "type": "string"
          },
          {
            "$ref": "#/components/schemas/ProfileModuleErrorContext"
          },
          {
            "type": "null"
          }
        ]
      },
      "ProfileModuleForbiddenError": {
        "type": "object",
        "description": "A profile section can contain this object inside an otherwise successful HTTP 200 response when the account lacks access to that module.",
        "additionalProperties": true,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "status_code"
            ],
            "properties": {
              "status_code": {
                "type": "integer",
                "const": 403
              },
              "detail": {
                "$ref": "#/components/schemas/ProfileModuleErrorDetail"
              },
              "message": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      },
      "ProfileModuleNotFoundError": {
        "type": "object",
        "description": "A profile section can contain this object inside an otherwise successful HTTP 200 response when no record is available for that module.",
        "additionalProperties": true,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "status_code"
            ],
            "properties": {
              "status_code": {
                "type": "integer",
                "const": 404
              },
              "detail": {
                "$ref": "#/components/schemas/ProfileModuleErrorDetail"
              },
              "message": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      },
      "ProfileModuleUnavailable": {
        "description": "The two module-level error shapes that can be embedded in a successful consolidated profile response.",
        "oneOf": [
          {
            "$ref": "#/components/schemas/ProfileModuleForbiddenError"
          },
          {
            "$ref": "#/components/schemas/ProfileModuleNotFoundError"
          }
        ]
      },
      "CompanyProfileLiteBasic": {
        "type": "object",
        "description": "Legal-identity fields in the provenance-enabled lite profile.",
        "additionalProperties": true,
        "properties": {
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "registration_number": {
            "type": [
              "string",
              "null"
            ]
          },
          "vat_number": {
            "type": [
              "string",
              "null"
            ]
          },
          "incorporation_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": [
              "string",
              "null"
            ]
          },
          "legal_form": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ProfileSource"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "CompanyProfileLiteAddress": {
        "type": "object",
        "description": "Registered-address fields in the provenance-enabled lite profile.",
        "additionalProperties": true,
        "properties": {
          "country_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "country_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "country_region": {
            "type": [
              "string",
              "null"
            ]
          },
          "address_street": {
            "type": [
              "string",
              "null"
            ]
          },
          "address_location": {
            "type": [
              "string",
              "null"
            ]
          },
          "address_city": {
            "type": [
              "string",
              "null"
            ]
          },
          "zip_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "jurisdiction": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ProfileSource"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "CompanyProfileLiteContact": {
        "type": "object",
        "description": "Public contact fields in the provenance-enabled lite profile.",
        "additionalProperties": true,
        "properties": {
          "website": {
            "type": [
              "string",
              "null"
            ]
          },
          "linkedin": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ProfileSource"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "CompanyProfileLiteProvenance": {
        "type": "object",
        "description": "Lite company record when provenance is enabled. Facts are grouped by source-bearing modules.",
        "additionalProperties": true,
        "required": [
          "basic"
        ],
        "properties": {
          "id": {
            "type": [
              "integer",
              "string"
            ]
          },
          "basic": {
            "$ref": "#/components/schemas/CompanyProfileLiteBasic"
          },
          "address": {
            "$ref": "#/components/schemas/CompanyProfileLiteAddress"
          },
          "contact": {
            "$ref": "#/components/schemas/CompanyProfileLiteContact"
          }
