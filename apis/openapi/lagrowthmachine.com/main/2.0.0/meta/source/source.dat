    "/flow/inbox/conversations/note": {
      "post": {
        "operationId": "postInboxConversationsNote",
        "tags": [
          "Inbox"
        ],
        "summary": "Edit Inbox Conversation Note",
        "description": "Edit Inbox Conversation Note",
        "requestBody": {
          "content": {
            "text/plain": {
              "schema": {
                "type": "string"
              },
              "example": "{\n    \"conversationId\": \"string\",\n    \"leadId\": \"string\",\n    \"email\": \"string\",\n    \"linkedinUrl\": \"string\",\n    \"note\": \"This is email\",\n    \"mode\": \"append\", //'replace' | 'append';\n    \"identityId\": \"string\",\n    \"campaignId\": \"string\",\n    \"campaignName\": \"string\"\n}"
            }
          }
        },
        "responses": {
          "200": {
            "description": "Edit Inbox Conversation Note",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "examples": {
                  "edit_inbox_conversation_note": {
                    "summary": "Edit Inbox Conversation Note",
                    "value": {
                      "success": true,
                      "data": {
                        "conversationId": "651e981118082022cc099851",
                        "leadId": "650c056ca3f66db7f6b700df",
                        "note": "Lead phone found on Lusha\n-- 2026-02-11 04:48 --\nCall ASAP",
                        "mode": "append",
                        "truncated": false,
                        "noteLength": 54,
                        "timestamp": "2026-02-11T04:48:37.200Z"
