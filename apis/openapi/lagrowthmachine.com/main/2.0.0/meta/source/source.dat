                "schema": {
                  "type": "object"
                },
                "examples": {
                  "from_linkedin_search_url": {
                    "summary": "From linkedin search url",
                    "value": {
                      "statusCode": 200
                    }
                  }
                }
              }
            }
          }
        }
      }
