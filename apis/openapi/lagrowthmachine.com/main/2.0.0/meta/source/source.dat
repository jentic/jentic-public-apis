                          "identityId": "60a1b2c3d4e5f60012345678",
                          "status": "ACTIVE",
                          "lastMessageAt": "2026-03-18T11:20:00.000Z",
                          "lastMessagePreview": "Hi Jean, I noticed your work at Acme Corp...",
                          "leadReplied": false,
