    "/flow/campaigns/{campaignId}/messages": {
      "get": {
        "operationId": "getCampaignsCampaignIdMessages",
        "tags": [
          "Campaigns"
        ],
        "summary": "Get Campaign Messages",
        "description": "Returns all message templates configured in a campaign's sequence. Path Parameters: campaignId (required) \u2014 MongoDB ObjectId (24-char hex string) Response fields (per message template): id \u2014 Template ID type \u2014 Template type channel \u2014 Channel (EMAIL, LINKEDIN, TWITTER, etc.) contentHtml \u2014 HTML content of the message subjectHtml \u2014 HTML subject (for emails) order \u2014 Position in the sequence active \u2014 Whether the template is active",
        "parameters": [
          {
            "name": "campaignId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "examples": {
                  "success": {
                    "summary": "Success",
                    "value": {
                      "statusCode": 200,
                      "data": [
                        {
                          "id": "62f1a2b3c4d5e60078901234",
                          "type": "INITIAL",
                          "channel": "EMAIL",
                          "contentHtml": "<p>Hi {{firstname}}, I noticed you work at {{companyName}}...</p>",
                          "subjectHtml": "Quick question about {{companyName}}",
                          "order": 0,
                          "active": true
                        },
                        {
                          "id": "62f1a2b3c4d5e60078901235",
                          "type": "FOLLOW_UP",
                          "channel": "LINKEDIN",
                          "contentHtml": "Hi {{firstname}}, just following up on my previous message...",
                          "subjectHtml": "",
                          "order": 1,
                          "active": true
                        }
                      ],
                      "total": 2
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/flow/campaigns/{campaignId}/settings": {
      "post": {
        "operationId": "postCampaignsCampaignIdSettings",
        "tags": [
          "Campaigns"
        ],
        "summary": "Update Campaign",
        "description": "Use this endpoint to update the settings of one campaign Send only the settings you want to change. At least one of name , audienceId , enrich , autoRescheduleOutOfOffice , hubspot , pipedrive , skipAlreadyContacted is required. The other settings of the campaign are left unchanged. Some settings depend on the campaign status: audienceId : can only be changed while the campaign has not been started yet (status READY ). hubspot / pipedrive : the campaign must be paused, and your plan must include the CRM sync. skipAlreadyContacted : the campaign must be READY or PAUSED . The response returns the updated settings of the campaign.",
        "parameters": [
          {
            "name": "campaignId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "audienceId": {
                    "type": "string"
                  },
                  "enrich": {
                    "type": "string"
                  },
                  "autoRescheduleOutOfOffice": {
                    "type": "string"
                  },
                  "hubspot": {
                    "type": "string"
                  },
                  "pipedrive": {
                    "type": "string"
                  },
                  "skipAlreadyContacted": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Rename a campaign",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "examples": {
                  "rename_a_campaign": {
                    "summary": "Rename a campaign",
                    "value": {
                      "statusCode": 200,
                      "data": {
                        "id": "34b5349b5490f3dec0b32043",
                        "name": "My renamed campaign",
                        "audience": {
                          "id": "64f1c20b8a5d7e1234567890",
                          "name": "Tests #1",
                          "size": 120
                        },
                        "enrich": false,
                        "autoRescheduleOutOfOffice": true,
                        "hubspot": false,
                        "pipedrive": false,
                        "skipAlreadyContacted": true,
                        "status": "PAUSED"
                      }
                    }
                  },
                  "assign_an_audience_campaign_not_started_yet": {
                    "summary": "Assign an audience (campaign not started yet)",
                    "value": {
                      "statusCode": 200,
                      "data": {
                        "id": "34b5349b5490f3dec0b32043",
                        "name": "My Campaign",
                        "audience": {
                          "id": "64f1c20b8a5d7e1234567890",
                          "name": "Tests #1",
                          "size": 120
                        },
                        "enrich": false,
                        "autoRescheduleOutOfOffice": true,
                        "hubspot": false,
                        "pipedrive": false,
                        "skipAlreadyContacted": true,
                        "status": "READY"
                      }
                    }
                  },
                  "enable_hubspot_sync_campaign_paused": {
                    "summary": "Enable HubSpot sync (campaign paused)",
                    "value": {
                      "statusCode": 200,
                      "data": {
                        "id": "34b5349b5490f3dec0b32043",
                        "name": "My Campaign",
                        "audience": {
                          "id": "64f1c20b8a5d7e1234567890",
                          "name": "Tests #1",
                          "size": 120
                        },
                        "enrich": false,
                        "autoRescheduleOutOfOffice": true,
                        "hubspot": true,
                        "pipedrive": false,
                        "skipAlreadyContacted": true,
                        "status": "PAUSED"
                      }
                    }
                  },
                  "disable_skip_already_contacted_and_auto_enrich": {
                    "summary": "Disable skip already contacted and auto-enrich",
                    "value": {
                      "statusCode": 200,
                      "data": {
                        "id": "34b5349b5490f3dec0b32043",
                        "name": "My Campaign",
                        "audience": {
                          "id": "64f1c20b8a5d7e1234567890",
                          "name": "Tests #1",
                          "size": 120
                        },
                        "enrich": false,
                        "autoRescheduleOutOfOffice": true,
                        "hubspot": false,
                        "pipedrive": false,
                        "skipAlreadyContacted": false,
                        "status": "PAUSED"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "No setting provided",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "examples": {
                  "no_setting_provided": {
                    "summary": "No setting provided",
                    "value": {
                      "error": "\"value\" must contain at least one of [name, audienceId, enrich, autoRescheduleOutOfOffice, hubspot, pipedrive, skipAlreadyContacted]"
                    }
                  },
                  "crm_sync_not_included_in_your_plan": {
                    "summary": "CRM sync not included in your plan",
                    "value": {
                      "error": "Please upgrade to sync your campaign with your CRM"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Campaign not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "examples": {
                  "campaign_not_found": {
                    "summary": "Campaign not found",
                    "value": {
                      "error": "Campaign not found"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Campaign name already used",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "examples": {
                  "campaign_name_already_used": {
                    "summary": "Campaign name already used",
