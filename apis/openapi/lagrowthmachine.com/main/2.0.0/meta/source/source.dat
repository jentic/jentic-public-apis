    "/flow/inboxWebhooks": {
      "post": {
        "operationId": "postInboxwebhooks",
        "tags": [
          "Inbox"
        ],
        "summary": "Create Inbox Event Webhook",
        "description": "\ud83d\udcec Create an Inbox Webhook Use this endpoint to register a new webhook that will receive real-time inbox events (LinkedIn and Email messages). Request body: { \"url\": \"https://webhook.site/boris-webhook\", // required: must be a valid, accessible POST URL \"name\": \"Demo webhook\", // required: webhook identifier \"description\": \"My demo webhook\", // optional: internal description \"campaigns\": [\"camp_123\", \"camp_456\"] // optional: array of campaign IDs to filter messages } url must be publicly accessible and respond to POST requests with a 200 OK. If campaigns is omitted or left empty, the webhook will receive messages from all campaigns.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              },
              "example": {
                "url": "{{customWebhookUrl}}",
                "name": "Demo webhook",
                "description": "My demo webhook",
                "campaigns": [
                  "all"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Create Inbox Event Webhook",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "examples": {
                  "create_inbox_event_webhook": {
                    "summary": "Create Inbox Event Webhook",
                    "value": {
                      "id": "f7e97bab-0880-4eca-b913-1e0e8a0505a1",
                      "url": "your-webhook-url",
                      "key": "Demo webhook",
                      "type": "INBOX_EVENT",
                      "campaigns": [],
                      "audiences": [
                        "all"
                      ],
                      "tags": [],
                      "createdAt": "2025-06-26T14:01:15.155Z"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "getInboxwebhooks",
        "tags": [
          "Inbox"
        ],
        "summary": "List Inbox Webhooks",
        "description": "Use this endpoint to list all the inbox webhooks currently configured in your workspace. It returns the full list of registered webhooks along with their IDs, names, and target URLs.",
        "responses": {
          "200": {
            "description": "List Inbox Webhooks",
