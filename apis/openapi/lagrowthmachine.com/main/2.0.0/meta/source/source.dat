                      "error": "Once started, you can not change the audience of a campaign"
                    }
                  },
                  "crm_settings_can_not_be_changed_on_a_running_campaign": {
                    "summary": "CRM settings can not be changed on a running campaign",
                    "value": {
                      "error": "Please pause the campaign to change crm settings"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/flow/audiences": {
      "get": {
        "operationId": "getAudiences",
