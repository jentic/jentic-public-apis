{
  "openapi": "3.1.0",
  "info": {
    "title": "MoviOdds bet365 Odds API",
    "version": "2026.10",
    "summary": "Free real-time bet365 odds for soccer, tennis, basketball, American football, ice hockey, baseball, rugby, cricket and Australian rules: every market, pre-match and in-play.",
    "description": "MoviOdds serves exclusively bet365 odds for soccer, tennis, basketball, American football, ice hockey, baseball, rugby union and league, cricket and Australian rules (more sports being added): every market bet365 prices for a match, pre-match and in-play. Soccer is the default; pass sport=<key> (see the sport parameter), or sport=all, to /odds and /catalog for other sports. Load the board with GET /odds, then keep it current over the WebSocket at wss://moviodds.com/ws (send {\"op\":\"subscribe\"}, optionally with \"fixtures\" and \"groups\" lists; you receive a snapshot per match, then delta messages as prices change, and a remove message when a market closes or a match leaves the board). WebSockets are not describable in OpenAPI, so the stream is documented at https://moviodds.com/doc.\n\nThe odds feed needs no key. Only POST /betbuilder/price needs an API key (X-API-Key).\n\nMoviOdds is an independent project and is not affiliated with or endorsed by bet365.",
    "contact": {
      "name": "MoviOdds on Discord",
      "url": "https://discord.gg/aXNfRCjtNq"
    }
  },
  "externalDocs": {
    "description": "Guide: load the board, stream changes, every market",
    "url": "https://moviodds.com/doc"
  },
  "servers": [
    {
      "url": "https://moviodds.com"
    }
  ],
  "tags": [
    {
      "name": "Odds",
      "description": "Matches and their current bet365 prices"
    },
    {
      "name": "Bet Builder",
      "description": "bet365's real combined price for a set of legs",
      "externalDocs": {
        "url": "https://moviodds.com/docs/betbuilder/"
      }
    },
    {
      "name": "Status",
      "description": "Service health"
    }
  ],
  "paths": {
    "/odds": {
      "get": {
        "tags": [
          "Odds"
        ],
        "operationId": "getOdds",
        "summary": "Every match and its current odds",
        "description": "Every listed match with its current quotes. Matches not priced yet carry an empty quotes array. Use the filters to fetch a slice instead of the whole board. Rate limit: 300 requests per minute per IP; for live updates use the WebSocket instead of polling.",
        "parameters": [
          {
            "name": "sport",
            "in": "query",
            "description": "Which sport to return. Default soccer; all = every sport. Every match carries its own sport field.",
            "schema": {
              "type": "string",
              "enum": [
                "soccer",
                "tennis",
                "basketball",
                "american_football",
                "ice_hockey",
                "baseball",
                "rugby_union",
                "rugby_league",
                "cricket",
                "australian_rules",
                "table_tennis",
                "volleyball",
                "handball",
                "badminton",
                "esports",
                "darts",
                "snooker",
                "boxing",
                "mma",
                "futsal",
                "bandy",
                "floorball",
                "field_hockey",
                "gaelic_sports",
                "all"
              ],
              "default": "soccer"
            }
          },
          {
            "name": "in_play",
            "in": "query",
            "description": "1 = only matches currently in play.",
            "schema": {
              "type": "string",
              "enum": [
                "1",
                "true"
              ]
            }
          },
          {
            "name": "groups",
            "in": "query",
            "description": "Comma-separated market group ids; only quotes in these groups are returned. Soccer Full Time Result is 40 before kickoff and 1777 in play; tennis To Win Match is 83 before the match and To Win (67, line \"Match\") in play. See https://moviodds.com/docs/markets/. Other sports: the match winner is the selection with line \"To Win\" in the \"Game\" market (side = the team); its group id can differ between pre-match and in-play.",
            "schema": {
              "type": "string",
              "examples": [
                "40,1777"
              ]
            }
          },
          {
            "name": "links",
            "in": "query",
            "description": "1 = add a ready-made bet365 deep-link object to every match (the links property). Opt-in so the default board is unchanged. See the MatchLinks schema; the host is server-configured (default www.bet365.com) and works on any regional domain.",
            "schema": {
              "type": "string",
              "enum": [
                "1",
                "true"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The board (or the filtered slice).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OddsResponse"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": []
      }
    },
    "/history": {
      "get": {
        "tags": [
          "Odds"
        ],
        "operationId": "getHistory",
        "summary": "A selection's recorded price timeline",
        "description": "Recorded price points for a match, oldest first. Each point carries the same selection-identity fields as /odds (group_id, group_name, market_id, sel_id, label, and side/line/handicap/n2 where the market uses them), so a point maps to a team/side/line without re-fetching /odds. Narrow with group, sel and a from/to window; results are capped at limit rows (default 5000, max 50000; the newest within the window are kept). odds_frac is derived from odds_dec, which is authoritative. A match with separate pre-match and live ids is returned whole: pass either id; fixture_ids lists the ids included. A busy or timed-out archive read answers 503 with a Retry-After header. Rate limit: 120 requests per minute per IP.",
        "parameters": [
          {
            "name": "fi",
            "in": "query",
            "required": true,
            "description": "The match (fixture) id.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "group",
            "in": "query",
            "description": "Only quotes in this market-group id.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sel",
            "in": "query",
            "description": "Only this selection id.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "description": "Window start: RFC3339 (e.g. 2026-10-04T12:00:00Z) or Unix seconds.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "to",
            "in": "query",
            "description": "Window end: RFC3339 or Unix seconds.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Max rows (default 5000, max 50000).",
            "schema": {
              "type": "integer",
              "default": 5000,
              "maximum": 50000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The price timeline (oldest first).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "fixture_id": {
                      "type": "string"
                    },
                    "fixture_ids": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "The ids included: the requested id plus its linked pre-match or live id."
                    },
                    "count": {
                      "type": "integer"
                    },
                    "truncated": {
                      "type": "boolean",
                      "description": "True when the row cap was hit; narrow the window or filter and page back."
                    },
                    "limit": {
                      "type": "integer"
                    },
                    "group": {
                      "type": "string"
                    },
                    "sel": {
                      "type": "string"
                    },
                    "points": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "ts": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "fixture_id": {
                            "type": "string",
                            "description": "The id that recorded this point. Present only when fixture_ids has more than one id."
                          },
                          "group_id": {
                            "type": "string"
                          },
                          "group_name": {
                            "type": "string",
                            "description": "Market display name (same as /odds). Present when known."
                          },
                          "market_id": {
                            "type": "string"
                          },
                          "sel_id": {
                            "type": "string"
                          },
                          "label": {
                            "type": "string"
                          },
                          "side": {
                            "type": "string",
                            "description": "Selection side where the market uses one (e.g. 'O'/'U', 'H'/'A'); same field as /odds. Present when non-empty."
                          },
                          "line": {
                            "type": "string",
                            "description": "The market line where applicable (e.g. '2.5'); same field as /odds. Present when non-empty."
                          },
                          "handicap": {
                            "type": "string",
                            "description": "The handicap where applicable; same field as /odds. Present when non-empty."
                          },
                          "n2": {
                            "type": "string",
                            "description": "Second participant where the market names one; same field as /odds. Present when non-empty."
                          },
                          "odds_dec": {
                            "type": "number"
                          },
                          "odds_frac": {
                            "type": "string",
                            "description": "Derived display fraction; odds_dec is authoritative."
                          },
                          "suspended": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "ts",
                          "odds_dec",
                          "suspended"
                        ]
                      }
                    }
                  },
                  "required": [
                    "fixture_id",
                    "count",
                    "points"
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": []
      }
    },
    "/closing": {
      "get": {
        "tags": [
          "Odds"
        ],
        "operationId": "getClosing",
        "summary": "Each selection's closing line",
        "description": "Per selection, the pre-match close (pre_close: the last price recorded at or before kickoff) and the last recorded price (last). Each selection row and its pre_close/last points carry the same selection-identity fields as /odds (group_name, and side/line/handicap/n2 where the market uses them), so a row maps to a team/side/line without a /odds round-trip. A match with separate pre-match and live ids is returned whole: pass either id; fixture_ids lists the ids included and prematch_id names the pre-match one. pre_close_basis says how the close was found (kickoff, prematch-records or omitted); kickoff_estimated is true when the kickoff is an estimate, and an estimate is never used to pick the close. closed is false while the match is upcoming (pre_close is provisional) and true once it has kicked off, gone in play, or finished. A busy or timed-out archive read answers 503 with a Retry-After header. Rate limit: 120 requests per minute per IP.",
        "parameters": [
          {
            "name": "fi",
            "in": "query",
            "required": true,
            "description": "The match (fixture) id.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The closing line per selection.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "fixture_id": {
                      "type": "string"
                    },
                    "fixture_ids": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "The ids included: the requested id plus its linked pre-match or live id."
                    },
                    "prematch_id": {
                      "type": "string",
                      "description": "The pre-match anchor id pre_close was taken from (present when a distinct pre-match id was identified)."
                    },
                    "kickoff_utc": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "kickoff_known": {
                      "type": "boolean"
                    },
                    "kickoff_estimated": {
                      "type": "boolean",
                      "description": "True when kickoff_utc is a live-derived estimate (first time seen in play, later than the true start), not bet365's scheduled kickoff. An estimated kickoff is never used as the pre_close cutoff."
                    },
                    "pre_close_basis": {
                      "type": "string",
                      "enum": [
                        "kickoff",
                        "prematch-records",
                        "omitted"
                      ],
                      "description": "How pre_close was chosen: 'kickoff' = last price at/<=the real scheduled kickoff; 'prematch-records' = no reliable kickoff but a separate live id exists, so the last price recorded under the pre-match id; 'omitted' = no pre-match close is reported (a live-only game, or no price was recorded at/before the real kickoff). When 'omitted', selections carry no pre_close."
                    },
                    "in_play": {
                      "type": "boolean"
                    },
                    "closed": {
                      "type": "boolean",
                      "description": "False while the match is upcoming (pre_close just mirrors the current pre-match price and keeps moving until kickoff); true once the match has kicked off, gone in play, or finished. Treat pre_close as a settled closing line only when closed is true."
                    },
                    "selection_count": {
                      "type": "integer"
                    },
                    "selections": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "group_id": {
                            "type": "string"
                          },
                          "group_name": {
                            "type": "string",
                            "description": "Market display name (same as /odds). Present when known."
                          },
                          "market_id": {
                            "type": "string"
                          },
                          "sel_id": {
                            "type": "string"
                          },
                          "label": {
                            "type": "string"
                          },
                          "side": {
                            "type": "string",
                            "description": "Selection side where the market uses one (e.g. 'O'/'U', 'H'/'A'); same field as /odds. Present when non-empty."
                          },
                          "line": {
                            "type": "string",
                            "description": "The market line where applicable (e.g. '2.5'); same field as /odds. Present when non-empty."
                          },
                          "handicap": {
                            "type": "string",
                            "description": "The handicap where applicable; same field as /odds. Present when non-empty."
                          },
                          "n2": {
                            "type": "string",
                            "description": "Second participant where the market names one; same field as /odds. Present when non-empty."
                          },
                          "pre_close": {
                            "$ref": "#/components/schemas/ClosingPricePoint"
                          },
                          "last": {
                            "$ref": "#/components/schemas/ClosingPricePoint"
                          }
                        },
                        "required": [
                          "sel_id"
                        ]
                      }
                    }
                  },
                  "required": [
                    "fixture_id",
                    "kickoff_known",
                    "selections"
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": []
      }
    },
    "/catalog": {
      "get": {
        "tags": [
          "Odds"
        ],
        "operationId": "getCatalog",
        "summary": "Every match, without odds",
        "description": "All catalogued matches (pre-match and in-play) with names, league and kickoff. Use it to find a match id.",
        "responses": {
          "200": {
            "description": "The match list.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "count": {
                      "type": "integer"
                    },
                    "sweeps": {
                      "type": "integer",
                      "description": "How many catalog refreshes have run since start."
                    },
                    "fixtures": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Fixture"
                      }
                    }
                  },
                  "required": [
                    "count",
                    "fixtures"
                  ]
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        },
        "security": [],
        "parameters": [
          {
            "name": "sport",
            "in": "query",
            "description": "Which sport to return. Default soccer; all = every sport. Every match carries its own sport field.",
            "schema": {
              "type": "string",
              "enum": [
                "soccer",
                "tennis",
                "basketball",
                "american_football",
                "ice_hockey",
                "baseball",
                "rugby_union",
                "rugby_league",
                "cricket",
                "australian_rules",
                "table_tennis",
                "volleyball",
                "handball",
                "badminton",
                "esports",
                "darts",
                "snooker",
                "boxing",
                "mma",
                "futsal",
                "bandy",
                "floorball",
                "field_hockey",
                "gaelic_sports",
                "all"
              ],
              "default": "soccer"
            }
          }
        ]
      }
    },
    "/snapshot": {
      "get": {
        "tags": [
          "Odds"
        ],
        "operationId": "getSnapshot",
        "summary": "One match's current odds",
        "parameters": [
          {
            "name": "fi",
            "in": "query",
            "required": true,
            "description": "Match id from /catalog or /odds.",
            "schema": {
              "type": "string",
              "pattern": "^[0-9]+$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Every current quote for the match.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "fixture": {
                      "type": "string"
                    },
                    "count": {
                      "type": "integer",
                      "description": "Number of quotes."
                    },
                    "groups": {
                      "type": "integer",
                      "description": "Number of markets."
                    },
                    "server_time": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "polled_at": {
                      "type": "string",
                      "format": "date-time",
                      "description": "When this match was last refreshed. Absent if never seen."
                    },
                    "quotes": {
                      "type": [
                        "array",
                        "null"
                      ],
                      "items": {
                        "$ref": "#/components/schemas/Quote"
                      }
                    }
                  },
                  "required": [
                    "fixture",
                    "count",
                    "groups",
                    "server_time"
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        },
        "security": []
      }
    },
    "/betbuilder/price": {
      "post": {
        "tags": [
          "Bet Builder"
        ],
        "operationId": "priceBetBuilder",
        "summary": "bet365's Bet Builder price for one or more slips",
        "description": "Returns bet365's real combined price for each slip (2-12 legs from one pre-match match). This is not the single odds multiplied together: bet365 adjusts for linked legs. Leg ids are sel_id values from /snapshot. Needs an API key; ask on Discord.",
        "security": [
          {
            "ApiKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "slips": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 50,
                    "items": {
                      "type": "object",
                      "properties": {
                        "fixture": {
                          "type": "string",
                          "pattern": "^[0-9]+$"
                        },
                        "legs": {
                          "type": "array",
                          "minItems": 2,
                          "maxItems": 12,
                          "items": {
                            "type": "string"
                          },
                          "description": "sel_id values."
                        }
                      },
                      "required": [
                        "fixture",
                        "legs"
                      ]
                    }
                  }
                },
                "required": [
                  "slips"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "One result per slip, in request order.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "server_time": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "results": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/SlipResult"
                      }
                    }
                  },
                  "required": [
                    "server_time",
                    "results"
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Status"
        ],
        "operationId": "getHealth",
        "summary": "Service status",
        "responses": {
          "200": {
            "description": "Status and cache size.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "examples": [
                        "ok"
                      ]
                    },
                    "warming": {
                      "type": "boolean",
                      "description": "True right after a restart while the board loads."
                    },
                    "catalog_fixtures": {
                      "type": "integer"
                    },
                    "cache_fixtures": {
                      "type": "integer"
                    },
                    "cache_quotes": {
                      "type": "integer"
                    },
                    "last_change_unix": {
                      "type": "integer"
                    },
                    "last_fixture_seen_by_sport": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "description": "Per sport, the most recent time a fixture for that sport was seen in a catalog sweep. A recent timestamp means the sport is being read (a quiet off-week); a stale or missing one suggests a broken sport."
                    }
                  }
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        },
        "security": []
      }
    },
    "/outrights": {
      "get": {
        "tags": [
          "Odds"
        ],
        "operationId": "getOutrights",
        "summary": "Outright / futures markets (field winners)",
        "description": "Outright (futures) markets: a field of participants priced for one winner question, such as a race or golf tournament winner, or a season future (Super Bowl, NFL/NCAAF/CFL outright/conference/division, NBA Championship, Stanley Cup, World Series, AFL and AFL Women Grand Final, Rugby World Cup, NRL, plus MVP, regular season awards, Heisman, winning conference, Brownlow, team perfect/winless record, team undefeated, final exact forecast, and each top soccer league's winner, top goalscorer and relegation). The per-team grids are also served: to make the playoffs (a Yes/No selection per team) and regular season wins (an Over/Under selection per team, carrying the team's line) -- each cell is a selection with side and, for over/under, line. Separate from /odds, which has head-to-head match odds. Prices update every few minutes. When futures are not available for a sport the response is {\"enabled\": false}.",
        "responses": {
          "200": {
            "description": "The outright events for the sport, each with its markets and current prices. A valid sport with no futures (a covered sport still warming, or a real sport the feature does not cover) returns an empty events list. When the whole feature is off: {\"enabled\": false}.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "generated_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "sport": {
                      "type": "string",
                      "description": "Echo of the requested sport; 'all' when every sport was requested (or sport was omitted)."
                    },
                    "event_count": {
                      "type": "integer"
                    },
                    "events": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/OutrightEvent"
                      }
                    },
                    "enabled": {
                      "type": "boolean",
                      "description": "Present and false only when futures are not available."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Unknown sport key: {\"error\":\"unknown sport key: X\"}. Returned when sport is not a valid sport key. A valid sport with no futures is a 200 with an empty events list, not a 400."
          }
        },
        "security": [],
        "parameters": [
          {
            "name": "sport",
            "in": "query",
            "description": "Which sport's futures to return. all (or omitted) returns every sport that has futures. An unknown key is a 400.",
            "schema": {
              "type": "string",
              "enum": [
                "formula1",
                "golf",
                "cycling",
                "american_football",
                "basketball",
                "ice_hockey",
                "baseball",
                "rugby_union",
                "rugby_league",
                "australian_rules",
                "soccer",
                "all"
              ],
              "default": "all"
            }
          }
        ]
      }
    },
    "/results": {
      "get": {
        "tags": [
          "Odds"
        ],
        "operationId": "getResults",
        "summary": "Results / settlement (finished matches, final & period scores)",
        "description": "Finished matches with the final score, per-period scores where available (halves for soccer, sets for tennis, table tennis, volleyball and badminton, quarters for basketball and American football, periods for ice hockey, innings for baseball), a status and the time the match finished. status is finished when the match reached full time (a player or side won the required sets, or baseball reached the 9th inning), and unknown when it stopped before that, usually because it was abandoned, suspended or postponed, or a tennis retirement (which bet365 does not expose); the last score is still returned. An overtime flag and a note are added when the match was decided beyond regulation, and cricket carries its run result and score format (wickets/runs per innings) in the note.",
        "responses": {
          "200": {
            "description": "The finished matches for the sport, newest first.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "sport": {
                      "type": "string"
                    },
                    "date": {
                      "type": "string",
                      "description": "Echo of the date filter (UTC, YYYY-MM-DD) when supplied."
                    },
                    "count": {
                      "type": "integer"
                    },
                    "results": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/MatchResult"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing/invalid sport, or a malformed date / fi."
          },
          "503": {
            "description": "Results tracking is disabled (RESULTS_DISABLE set or no sports enabled)."
          }
        },
        "security": [],
        "parameters": [
          {
            "name": "sport",
            "in": "query",
            "required": true,
            "description": "Which sport's finished matches to return (e.g. soccer, tennis, basketball, ice_hockey, american_football, volleyball).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "date",
            "in": "query",
            "required": false,
            "description": "Restrict to matches that finished on this UTC calendar day (YYYY-MM-DD).",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "fi",
            "in": "query",
            "required": false,
            "description": "Restrict to a single bet365 fixture id.",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Only for /betbuilder/price. Ask @Movisu on Discord."
      }
    },
    "responses": {
      "Error": {
        "description": "Error.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string"
                }
              },
              "required": [
                "error"
              ]
            }
          }
        }
      },
      "RateLimited": {
        "description": "Too many requests from this IP. Slow down, or use the WebSocket for live updates."
      }
    },
    "schemas": {
      "ClosingPricePoint": {
        "type": "object",
        "description": "One recorded price. odds_frac is a derived display fraction; odds_dec is authoritative.",
        "properties": {
          "ts": {
            "type": "string",
            "format": "date-time"
          },
          "fixture_id": {
            "type": "string",
            "description": "The id this price was recorded under. Present only when the response includes more than one id."
          },
          "group_id": {
            "type": "string",
            "description": "Selection identity (same fields as /odds). Present when non-empty."
          },
          "group_name": {
            "type": "string",
            "description": "The one stable English name for this group id across every match, even where bet365's feed names it differently or in another language on some matches. Absent only for a market bet365 never names anywhere."
          },
          "market_id": {
            "type": "string"
          },
          "sel_id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "side": {
            "type": "string"
          },
          "line": {
            "type": "string"
          },
          "handicap": {
            "type": "string",
            "description": "The line/handicap for this selection. For an Over/Under total it carries the numeric line whether bet365 put it on the selection or in a positional label column. Present when non-empty."
          },
          "n2": {
            "type": "string"
          },
          "odds_dec": {
            "type": "number"
          },
          "odds_frac": {
            "type": "string"
          },
          "suspended": {
            "type": "boolean"
          }
        },
        "required": [
          "ts",
          "odds_dec",
          "suspended"
        ]
      },
      "PeriodScore": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Period/set name: '1st Half','2nd Half','Quarter 1','Period 1','Set 1', …"
          },
          "score": {
            "type": "string",
            "description": "The score for that period (home-away), or the set score (e.g. '7-6')."
          }
        }
      },
      "MatchResult": {
        "type": "object",
        "properties": {
          "fixture_id": {
            "type": "string",
            "description": "bet365 match id."
          },
          "sport": {
            "type": "string"
          },
          "home": {
            "type": "string"
          },
          "away": {
            "type": "string"
          },
          "league": {
            "type": "string"
          },
          "final_score": {
            "type": "string",
            "description": "The last scoreline seen (aggregate home-away; a comma-separated set list for set sports; for cricket bet365's Australian wickets/runs per innings in batting order, for example 7/199,8/141). For table tennis, badminton and volleyball the deciding set is included even though bet365 delists the match before adding it to its completed-set field."
          },
          "periods": {
            "type": "array",
            "description": "Per-period / per-set scores where the sport exposes them.",
            "items": {
              "$ref": "#/components/schemas/PeriodScore"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "finished",
              "unknown"
            ],
            "description": "finished: the match reached full time (a player or side won the required sets, baseball reached the 9th inning, or a cricket run result was derived). unknown: it stopped before that, usually abandoned, suspended or postponed, or the sport has no finish model, or (tennis) a retirement or walkover, which bet365's live feed does not expose, so no winner is given. The last score is still returned."
          },
          "overtime": {
            "type": "boolean",
            "description": "Present and true when the match was decided beyond regulation: the final period seen was overtime or a shoot-out, or (for ice hockey) the final score is level so an overtime or shoot-out settled it. Omitted otherwise."
          },
          "note": {
            "type": "string",
            "description": "A short qualifier when the score alone is not enough, for example a tied ice-hockey final whose shoot-out or overtime winning goal is not part of bet365's score feed, or a cricket result by innings (bet365 lists innings in batting order, not home/away, so the winner is named by innings). Omitted otherwise."
          },
          "finished_at": {
            "type": "string",
            "format": "date-time",
            "description": "The last instant the match was seen live (≈ when it finished)."
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Fixture": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "bet365 match id."
          },
          "home": {
            "type": "string"
          },
          "away": {
            "type": "string"
          },
          "league": {
            "type": "string"
          },
          "region": {
            "type": "string"
          },
          "kickoff_utc": {
            "type": "string",
            "format": "date-time",
            "description": "The match's scheduled kickoff (UTC). Omitted when unknown. For a live match listed without a start time this is an estimate of when it started, and kickoff_estimated is true."
          },
          "kickoff_estimated": {
            "type": "boolean",
            "description": "True when kickoff_utc is not bet365's scheduled start but an estimate derived from the live feed (the instant the match was first seen live), used only when the real start is unknown. Absent/false for a real scheduled kickoff."
          },
          "in_play": {
            "type": "boolean",
            "description": "True while the match is actually under way. A match bet365 lists on a court/table but has not started yet is not in play, and a finished match drops out of in play once bet365 stops streaming it live or the results tracker records it finished."
          },
          "score": {
            "type": "string",
            "description": "Live scoreline while in play, home-away. One pair for goal/point sports ('1-0'). For set sports it is the set list: tennis gives games ('6-4,2-3'); table tennis, volleyball and badminton give the completed games plus the current game's points ('11-7,6-11,12-14,11-9,2-6'). Omitted before kickoff and when bet365 sends none."
          },
          "last_seen": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "home",
          "away",
          "in_play"
        ]
      },
      "Quote": {
        "type": "object",
        "description": "One price. Key a quote by (fixture_id, group_id, market_id, sel_id).",
        "properties": {
          "fixture_id": {
            "type": "string"
          },
          "group_id": {
            "type": "string",
            "description": "Market id, stable across matches and languages (e.g. 40 = Full Time Result pre-match, 1777 in play)."
          },
          "group_name": {
            "type": "string",
            "description": "Market name as bet365 shows it."
          },
          "market_id": {
            "type": "string"
          },
          "sel_id": {
            "type": "string",
            "description": "Selection id; also the leg id for Bet Builder."
          },
          "label": {
            "type": "string"
          },
          "n2": {
            "type": "string"
          },
          "handicap": {
            "type": "string"
          },
          "side": {
            "type": "string",
            "description": "Column, e.g. Over/Under, Yes/No."
          },
          "line": {
            "type": "string",
            "description": "Line, handicap or row label."
          },
          "odds_dec": {
            "type": "number"
          },
          "odds_frac": {
            "type": "string"
          },
          "suspended": {
            "type": "boolean"
          },
          "ts": {
            "type": "string",
            "format": "date-time",
            "description": "When this price last changed."
          }
        },
        "required": [
          "fixture_id",
          "group_id",
          "sel_id",
          "odds_dec",
          "ts"
        ]
      },
      "Match": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Fixture"
          },
          {
            "type": "object",
            "properties": {
              "links": {
                "$ref": "#/components/schemas/MatchLinks",
                "description": "Ready-made bet365 deep links. Present only when the request sent links=1."
              },
              "quotes": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Quote"
                }
              },
              "market_count": {
                "type": "integer",
                "description": "Markets priced for this match (unaffected by the groups filter)."
              },
              "polled_at": {
                "type": "string",
                "format": "date-time",
                "description": "When this match was last refreshed."
              }
            },
            "required": [
              "quotes",
              "market_count"
            ]
          }
        ]
      },
      "MatchLinks": {
        "type": "object",
        "description": "Ready-made bet365 deep links for a match, built from ids the API already carries. Opt in with links=1 on /odds. They are client-side SPA hash routes, so the same path works on every regional bet365 domain (the host is server-configured, default www.bet365.com). A field is present only when the ids needed to build it are; no bet-slip add-selection link is offered because bet365 exposes no stateless URL for that (it uses a logged-in Bet Share referral code instead).",
        "properties": {
          "match": {
            "type": "string",
            "description": "The link to open for the match in its CURRENT state: the live route when the match is in play, otherwise the pre-match coupon route.",
            "examples": [
              "https://www.bet365.com/#/AC/B1/C1/D8/E201200339/F3/"
            ]
          },
          "prematch": {
            "type": "string",
            "description": "The coupon-page route. Valid before kickoff; once the match goes in play bet365 purges the coupon node and this route bounces to the lobby (use live instead).",
            "examples": [
              "https://www.bet365.com/#/AC/B1/C1/D8/E201200339/F3/"
            ]
          },
          "live": {
            "type": "string",
            "description": "The in-play route. Present only for a match bet365 has indexed live.",
            "examples": [
              "https://www.bet365.com/#/IP/EV151382572392C1/"
            ]
          }
        }
      },
      "OddsResponse": {
        "type": "object",
        "properties": {
          "generated_at": {
            "type": "string",
            "format": "date-time"
          },
          "server_time": {
            "type": "string",
            "format": "date-time",
            "description": "Use server_time minus a quote's ts for its age."
          },
          "match_count": {
            "type": "integer",
            "description": "Matches in this response."
          },
          "catalog_matches": {
            "type": "integer",
            "description": "All catalogued matches, regardless of filters."
          },
          "cached_matches": {
            "type": "integer"
          },
          "quote_count": {
            "type": "integer"
          },
          "warming": {
            "type": "boolean",
            "description": "Present and true right after a restart; retry in about 30 seconds."
          },
          "note": {
            "type": "string"
          },
          "matches": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Match"
            }
          }
        },
        "required": [
          "generated_at",
          "server_time",
          "match_count",
          "quote_count",
          "matches"
        ]
      },
      "SlipResult": {
        "type": "object",
        "properties": {
          "fixture": {
            "type": "string"
          },
          "home": {
            "type": "string"
          },
          "away": {
            "type": "string"
          },
          "legs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sel_id": {
                  "type": "string"
                },
                "market": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "odds_dec": {
                  "type": "number"
                }
              },
              "required": [
                "sel_id"
              ]
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "priced",
              "unavailable",
              "error"
            ],
            "description": "priced: odds set. unavailable: bet365 declined the combination. error: see error and retryable."
          },
          "odds_dec": {
            "type": "number"
          },
          "odds_frac": {
            "type": "string"
          },
          "naive_odds_dec": {
            "type": "number",
            "description": "The legs' single odds multiplied, for comparison."
          },
          "priced_at": {
            "type": "string",
            "format": "date-time"
          },
          "error": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "required": [
          "fixture",
          "legs",
          "status"
        ]
      },
      "OutrightEvent": {
        "type": "object",
        "description": "One outright event (a Grand Prix, tournament, race or season championship / league futures group) with its field markets.",
        "properties": {
          "event_id": {
            "type": "string",
            "description": "bet365 event id (the drilled body's EV FI)."
          },
          "event_name": {
            "type": "string",
            "description": "Event name, e.g. 'Bahrain Grand Prix', 'NFL 2026/27', 'AFL 2027', 'World Cup 2027'."
          },
          "sport": {
            "type": "string",
            "enum": [
              "formula1",
              "golf",
              "cycling",
              "american_football",
              "basketball",
              "ice_hockey",
              "baseball",
              "rugby_union",
              "rugby_league",
              "australian_rules"
            ]
          },
          "class_id": {
            "type": "string",
            "description": "bet365 class id (F1 10, golf 7, cycling 38, American football 12, baseball 16, ice hockey 17, basketball 18, rugby union 8, rugby league 19, Australian rules 36)."
          },
          "markets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OutrightMarket"
            }
          },
          "polled_at": {
            "type": "string",
            "format": "date-time",
            "description": "When this event's prices were last refreshed."
          }
        },
        "required": [
          "event_id",
          "sport",
          "class_id",
          "markets"
        ]
      },
      "OutrightMarket": {
        "type": "object",
        "description": "One field market: a winner / top-N / championship question over the event's field, with each-way terms when offered. Distinct from /odds Quote (variable-size field, each_way).",
        "properties": {
          "event_id": {
            "type": "string"
          },
          "event_name": {
            "type": "string"
          },
          "group_id": {
            "type": "string",
            "description": "bet365 market-group id (stable across languages). NOT unique on its own: the eight NFL division winners share one group_id, and MLB serves two distinct World Series markets under one group_id. Key and dedupe markets on market_id, not group_id."
          },
          "market_id": {
            "type": "string",
            "description": "Stable, distinct per-market id (the field group's bet365 id). Use this to key or dedupe markets within an event; group_id can repeat across markets in the same event."
          },
          "market_name": {
            "type": "string",
            "description": "e.g. 'To Win Outright', 'Outrights', 'AFC East'. For same-named variants the column_name distinguishes them (e.g. 'Win Only' vs 'Win Only Live In-Play.')."
          },
          "column_name": {
            "type": "string",
            "description": "The named price column that supplied the field, e.g. 'Win Only', 'E/W 1/5 1-2-3'."
          },
          "field_truncated": {
            "type": "boolean",
            "description": "Present and true only when the served field is a partial top-N. bet365's featured outright widget first serves a market's 12 shortest-priced runners (a served-count cap ON alongside the 'more available' flag OM=1); for those markets the feed follows bet365's own 'Show more' request (matchmarketscontentapi/outrightspartial) and serves the complete field, clearing this flag. It stays true only when bet365 offers no 'Show more' for the market (e.g. the MLB World Series in the postseason) or when that follow-up request was empty this cycle (kept as last-good); then the field and its sub-100%-overround are a partial top 12, not the full field. Absent for a complete field, including markets (e.g. a 4-team NFL division) whose column repeats OM=1 but which carry no ON cap."
          },
          "runners_shown": {
            "type": "integer",
            "description": "On a truncated field, how many runners bet365 served (its ON count). Omitted when the field is complete."
          },
          "each_way": {
            "$ref": "#/components/schemas/EachWayTerms"
          },
          "selections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OutrightSelection"
            }
          },
          "ts": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "event_id",
          "group_id",
          "market_id",
          "selections",
          "ts"
        ]
      },
      "OutrightSelection": {
        "type": "object",
        "description": "One runner in the field, priced for one market column.",
        "properties": {
          "sel_id": {
            "type": "string",
            "description": "bet365 selection id (the stable key; never the localized name)."
          },
          "name": {
            "type": "string",
            "description": "Runner/participant name (the team, for a grid market)."
          },
          "side": {
            "type": "string",
            "description": "For a team-row x price-column grid market (to make the playoffs, regular season wins) the price column this cell belongs to: 'Yes'/'No' or 'Over'/'Under'. Absent for an ordinary winner/field selection."
          },
          "line": {
            "type": "string",
            "description": "For a per-team over/under grid cell (regular season wins), the team's line, e.g. '9.5'. Absent for a yes/no grid or an ordinary field selection."
          },
          "odds_dec": {
            "type": "number",
            "description": "Decimal odds; 0 only when suspended with no price."
          },
          "odds_frac": {
            "type": "string",
            "description": "Fractional odds verbatim, e.g. '5/2'."
          },
          "suspended": {
            "type": "boolean"
          }
        },
        "required": [
          "sel_id",
          "name",
          "odds_dec"
        ]
      },
      "EachWayTerms": {
        "type": "object",
        "description": "Each-way place terms: back to win, a fraction of the odds pays for a place. Absent for a win-only market. 'E/W 1/5 1-2-3' => frac_num 1, frac_den 5, places 3.",
        "properties": {
          "places": {
            "type": "integer",
            "description": "Number of paying places, from the raw terms: 'E/W 1/2 1-2' and 'E/W 1/3 1-2' pay 2, '1-2-3' pays 3, '1-2-3-4' pays 4."
          },
          "frac_num": {
            "type": "integer",
            "description": "Place-fraction numerator (the 1 in 1/5)."
          },
          "frac_den": {
            "type": "integer",
            "description": "Place-fraction denominator (the 5 in 1/5)."
          },
          "raw": {
            "type": "string",
            "description": "Verbatim terms label."
          }
        }
      }
    }
  }
}
