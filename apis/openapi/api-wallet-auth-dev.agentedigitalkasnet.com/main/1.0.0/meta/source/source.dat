{
  "openapi": "3.0.3",
  "info": {
    "title": "QR Interop API - Clientes",
    "version": "1.0.0",
    "description": "API pública para generación y consulta de códigos QR interoperables.",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/prabasilioorganizati/qr-interop-api-clientes/1.0.0"
  },
  "servers": [
    {
      "url": "https://api-wallet-auth.prd.agentedigitalkasnet.com/reg-walletenduser-auth-api/v1",
      "description": "Servidor Producción"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "tags": [
    {
      "name": "Clients Interop",
      "description": "Operaciones relacionadas a generación y consulta de QR"
    }
  ],
  "paths": {
    "/clients-interop/generate-qr": {
      "post": {
        "tags": [
          "Clients Interop"
        ],
        "summary": "Generar código QR dinámico",
        "description": "Genera un QR dinámico interoperable para ser pagado desde billeteras digitales.",
        "operationId": "generateQr",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateQrRequestDTO"
              },
              "example": {
                "amount": 100,
                "glosa": "Pago de servicio",
                "expirationDate": "20260307",
                "paymentCount": 3,
                "info": [
                  {
                    "code": "clientName",
                    "value": "Alexis Basilio"
                  },
                  {
                    "code": "clientDni",
                    "value": "45188873"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "QR generado exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerateQrResponseDTO"
                },
                "example": {
                  "idQr": "QR123456789",
                  "qrContent": "000201010211...",
                  "expirationDate": "20260307"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "API Key inválida o no proporcionada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/clients-interop/query-qr": {
      "post": {
        "tags": [
          "Clients Interop"
        ],
        "summary": "Consultar estado de QR",
        "description": "Permite consultar el estado de un QR previamente generado.",
        "operationId": "queryQr",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QueryQrRequestDTO"
              },
              "example": {
                "idQr": "QR123456789"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consulta exitosa",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryQrResponseDTO"
                },
                "example": {
                  "idQr": "QR123456789",
                  "status": "PAID",
                  "amount": 100,
                  "paymentDate": "20260305"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "API Key inválida o no proporcionada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "QR no encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "API Key entregada para autenticación del cliente."
      }
    },
    "schemas": {
      "GenerateQrRequestDTO": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "description": "Monto del QR",
            "example": 100
          },
          "glosa": {
            "type": "string",
            "description": "Descripción del pago",
            "example": "Pago de servicio"
          },
          "expirationDate": {
            "type": "string",
            "description": "Fecha de expiración del QR (YYYYMMDD)",
            "example": "20260307"
          },
          "paymentCount": {
            "type": "number",
            "description": "Cantidad máxima de pagos permitidos",
            "example": 3
          },
          "info": {
            "type": "array",
            "description": "Información adicional del cliente",
            "items": {
              "$ref": "#/components/schemas/InfoItem"
            }
          }
        },
        "required": [
          "amount",
          "glosa",
          "expirationDate",
          "paymentCount"
        ]
      },
      "InfoItem": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Código del dato",
            "example": "clientName"
          },
          "value": {
            "type": "string",
            "description": "Valor del dato",
            "example": "Alexis Basilio"
          }
        }
      },
      "GenerateQrResponseDTO": {
        "type": "object",
        "properties": {
          "idQr": {
            "type": "string",
            "description": "Identificador único del QR",
            "example": "QR123456789"
          },
          "qrContent": {
            "type": "string",
            "description": "Contenido del QR generado"
          },
          "expirationDate": {
            "type": "string",
            "description": "Fecha de expiración"
          }
        }
      },
      "QueryQrRequestDTO": {
        "type": "object",
        "properties": {
          "idQr": {
            "type": "string",
            "description": "Identificador del QR"
          }
        },
        "required": [
          "idQr"
        ]
      },
      "QueryQrResponseDTO": {
        "type": "object",
        "properties": {
          "idQr": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "description": "Estado del QR",
            "example": "PAID"
          },
          "amount": {
            "type": "number",
            "example": 100
          },
          "paymentDate": {
            "type": "string",
            "description": "Fecha en la que se realizó el pago"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "API Key inválida"
          },
          "error": {
            "type": "string",
            "example": "Unauthorized"
          },
          "statusCode": {
            "type": "integer",
            "example": 401
          }
        }
      }
    }
  }
}
