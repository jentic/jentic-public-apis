{
  "openapi": "3.0.3",
  "info": {
    "title": "Google Ads Transparency Scraper: Competitor Ads",
    "description": "Google Ads Transparency Center scraper: enter a competitor's website or advertiser ID, get its new, running and stopped Google ads with first and last shown dates, days shown and ad links. No login, no proxy. Pay per ad.\n\nRuns on your own Apify account (pay-per-use). Store: https://apify.com/publicrecords/google-ads-transparency-scraper\nMCP: https://mcp.apify.com?tools=publicrecords/google-ads-transparency-scraper\nAuthor: Public Records.",
    "version": "0.1.7",
    "contact": {
      "name": "Public Records",
      "url": "https://apify.com/publicrecords",
      "email": "publicrecords@users.noreply.github.com"
    },
    "x-origin": [
      {
        "url": "https://apify.com/publicrecords/google-ads-transparency-scraper",
        "format": "openapi",
        "version": "3.0"
      }
    ],
    "x-apisguru-categories": [
      "developer_tools"
    ]
  },
  "servers": [
    {
      "url": "https://api.apify.com/v2",
      "description": "Apify API"
    }
  ],
  "tags": [
    {
      "name": "runs",
      "description": "Start a run and read dataset items"
    }
  ],
  "paths": {
    "/acts/publicrecords~google-ads-transparency-scraper/runs": {
      "post": {
        "operationId": "start_google_ads_transparency_scraper_run",
        "tags": [
          "runs"
        ],
        "summary": "Start a run of publicrecords/google-ads-transparency-scraper",
        "description": "Starts the Actor asynchronously. Poll the returned run, then read dataset items. Docs: https://apify.com/publicrecords/google-ads-transparency-scraper",
        "security": [
          {
            "ApiKeyQuery": []
          },
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "timeout",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Timeout in seconds"
          },
          {
            "name": "memory",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Memory in MB"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "title": "Google Ads Transparency Scraper",
                "description": "Competitors in, every Google ad they run out — new, running and stopped, with first and last shown dates.",
                "type": "object",
                "schemaVersion": 1,
                "properties": {
                  "targets": {
                    "title": "Competitors",
                    "type": "array",
                    "description": "One per line: a website domain (nike.com), a Google advertiser ID (AR…), an Ads Transparency Center link, or an exact advertiser name.",
                    "editor": "stringList",
                    "prefill": [
                      "nike.com"
                    ]
                  },
                  "sinceDays": {
                    "title": "Look-back window (days)",
                    "type": "integer",
                    "description": "Ads first shown in this window are \"new\"; ads that stopped inside it are \"stopped\". Google lists an ad 2–3 days after it runs, so on a schedule use your interval plus 3 days (10 for weekly) and match repeats by adId.",
                    "default": 7,
                    "minimum": 1,
                    "prefill": 7
                  },
                  "region": {
                    "title": "Region",
                    "type": "string",
                    "description": "Only ads shown in this country. \"Anywhere\" returns ads from every country.",
                    "editor": "select",
                    "enum": [
                      "anywhere",
                      "AR",
                      "AU",
                      "AT",
                      "BD",
                      "BE",
                      "BR",
                      "BG",
                      "CA",
                      "CL",
                      "CO",
                      "HR",
                      "CY",
                      "CZ",
                      "DK",
                      "EG",
                      "EE",
                      "FI",
                      "FR",
                      "DE",
                      "GR",
                      "HK",
                      "HU",
                      "IS",
                      "IN",
                      "ID",
                      "IE",
                      "IL",
                      "IT",
                      "JP",
                      "KE",
                      "KW",
                      "LV",
                      "LT",
                      "LU",
                      "MY",
                      "MT",
                      "MX",
                      "MA",
                      "NL",
                      "NZ",
                      "NG",
                      "NO",
                      "PK",
                      "PE",
                      "PH",
                      "PL",
                      "PT",
                      "QA",
                      "RO",
                      "SA",
                      "RS",
                      "SG",
                      "SK",
                      "SI",
                      "ZA",
                      "KR",
                      "ES",
                      "SE",
                      "CH",
                      "TW",
                      "TH",
                      "TR",
                      "UA",
                      "AE",
                      "GB",
                      "US",
                      "VN"
                    ],
                    "enumTitles": [
                      "Anywhere",
                      "Argentina",
                      "Australia",
                      "Austria",
                      "Bangladesh",
                      "Belgium",
                      "Brazil",
                      "Bulgaria",
                      "Canada",
                      "Chile",
                      "Colombia",
                      "Croatia",
                      "Cyprus",
                      "Czechia",
                      "Denmark",
                      "Egypt",
                      "Estonia",
                      "Finland",
                      "France",
                      "Germany",
                      "Greece",
                      "Hong Kong",
                      "Hungary",
                      "Iceland",
                      "India",
                      "Indonesia",
                      "Ireland",
                      "Israel",
                      "Italy",
                      "Japan",
                      "Kenya",
                      "Kuwait",
                      "Latvia",
                      "Lithuania",
                      "Luxembourg",
                      "Malaysia",
                      "Malta",
                      "Mexico",
                      "Morocco",
                      "Netherlands",
                      "New Zealand",
                      "Nigeria",
                      "Norway",
                      "Pakistan",
                      "Peru",
                      "Philippines",
                      "Poland",
                      "Portugal",
                      "Qatar",
                      "Romania",
                      "Saudi Arabia",
                      "Serbia",
                      "Singapore",
                      "Slovakia",
                      "Slovenia",
                      "South Africa",
                      "South Korea",
                      "Spain",
                      "Sweden",
                      "Switzerland",
                      "Taiwan",
                      "Thailand",
                      "Türkiye",
                      "Ukraine",
                      "United Arab Emirates",
                      "United Kingdom",
                      "United States",
                      "Vietnam"
                    ],
                    "default": "anywhere",
                    "prefill": "US",
                    "sectionCaption": "Advanced"
                  },
                  "statuses": {
                    "title": "Which ads",
                    "type": "array",
                    "description": "Leave all selected for every ad Google still lists (about one year back). Select only new, running and stopped for a faster weekly monitor.",
                    "editor": "select",
                    "items": {
                      "type": "string",
                      "enum": [
                        "new",
                        "running",
                        "stopped",
                        "inactive"
                      ],
                      "enumTitles": [
                        "New in the window",
                        "Still running",
                        "Stopped in the window",
                        "Stopped before the window"
                      ]
                    },
                    "default": [
                      "new",
                      "running",
                      "stopped",
                      "inactive"
                    ]
                  },
                  "maxAdsPerTarget": {
                    "title": "Max ads per competitor",
                    "type": "integer",
                    "description": "0 means no limit. A website search returns every ad that links to it, which for big marketplaces is millions; use an advertiser ID for one company's own ads.",
                    "default": 1000,
                    "minimum": 0,
                    "prefill": 25
                  },
                  "includeRegionStats": {
                    "title": "Add countries and EU impressions",
                    "type": "boolean",
                    "description": "Adds the countries each ad ran in and, for EU countries, Google's impression ranges. Slower: one extra request per ad.",
                    "default": false
                  }
                },
                "required": [
                  "targets"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Run started",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
