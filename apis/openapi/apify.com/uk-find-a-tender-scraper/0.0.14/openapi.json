{
  "openapi": "3.0.3",
  "info": {
    "title": "Find a Tender & Contracts Finder: UK government tenders",
    "description": "Which UK government tenders were published today? Returns Find a Tender and Contracts Finder notices with buyer, value, deadline and source link.\n\nRuns on your own Apify account (pay-per-use). Store: https://apify.com/publicrecords/uk-find-a-tender-scraper\nMCP: https://mcp.apify.com?tools=publicrecords/uk-find-a-tender-scraper\nAuthor: Public Records.",
    "version": "0.0.14",
    "contact": {
      "name": "Public Records",
      "url": "https://apify.com/publicrecords",
      "email": "publicrecords@users.noreply.github.com"
    },
    "x-origin": [
      {
        "url": "https://apify.com/publicrecords/uk-find-a-tender-scraper",
        "format": "openapi",
        "version": "3.0"
      }
    ],
    "x-apisguru-categories": [
      "developer_tools"
    ]
  },
  "servers": [
    {
      "url": "https://api.apify.com/v2",
      "description": "Apify API"
    }
  ],
  "tags": [
    {
      "name": "runs",
      "description": "Start a run and read dataset items"
    }
  ],
  "paths": {
    "/acts/publicrecords~uk-find-a-tender-scraper/runs": {
      "post": {
        "operationId": "start_uk_find_a_tender_scraper_run",
        "tags": [
          "runs"
        ],
        "summary": "Start a run of publicrecords/uk-find-a-tender-scraper",
        "description": "Starts the Actor asynchronously. Poll the returned run, then read dataset items. Docs: https://apify.com/publicrecords/uk-find-a-tender-scraper",
        "security": [
          {
            "ApiKeyQuery": []
          },
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "timeout",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Timeout in seconds"
          },
          {
            "name": "memory",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Memory in MB"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://apify.com/schemas/v1/input.ide.json",
                "title": "UK Find a Tender Scraper",
                "description": "Public OCDS 1.1 packages from Find a Tender. Keywords and CPV are applied client-side after flatten.",
                "type": "object",
                "schemaVersion": 1,
                "properties": {
                  "keywords": {
                    "title": "Keywords",
                    "type": "array",
                    "description": "Case-insensitive match on tender title, description, or buyer name (client-side).",
                    "editor": "stringList",
                    "default": []
                  },
                  "cpv": {
                    "title": "CPV codes",
                    "type": "array",
                    "description": "Match when tender.items[].classification.id starts with any code (client-side).",
                    "editor": "stringList",
                    "default": []
                  },
                  "noticeType": {
                    "title": "Notice stages",
                    "type": "array",
                    "description": "Mapped to API stages: planning | tender | award. Omit for all.",
                    "editor": "stringList",
                    "default": [],
                    "prefill": [
                      "tender"
                    ]
                  },
                  "updatedFrom": {
                    "title": "Updated from",
                    "type": "string",
                    "description": "ISO datetime. Default: 7 days ago.",
                    "editor": "textfield",
                    "nullable": true
                  },
                  "updatedTo": {
                    "title": "Updated to",
                    "type": "string",
                    "description": "ISO datetime. Default: now.",
                    "editor": "textfield",
                    "nullable": true
                  },
                  "maxItems": {
                    "title": "Max items",
                    "type": "integer",
                    "description": "Cap on notice rows.",
                    "default": 50,
                    "minimum": 1,
                    "maximum": 5000
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Run started",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/acts/publicrecords~uk-find-a-tender-scraper/run-sync-get-dataset-items": {
      "post": {
        "operationId": "run_uk_find_a_tender_scraper_sync_get_items",
        "tags": [
          "runs"
        ],
        "summary": "Run publicrecords/uk-find-a-tender-scraper and return dataset items",
        "description": "Synchronous convenience endpoint. Waits for the run to finish and returns dataset items.",
        "security": [
          {
            "ApiKeyQuery": []
          },
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://apify.com/schemas/v1/input.ide.json",
                "title": "UK Find a Tender Scraper",
                "description": "Public OCDS 1.1 packages from Find a Tender. Keywords and CPV are applied client-side after flatten.",
                "type": "object",
                "schemaVersion": 1,
                "properties": {
                  "keywords": {
                    "title": "Keywords",
                    "type": "array",
                    "description": "Case-insensitive match on tender title, description, or buyer name (client-side).",
                    "editor": "stringList",
                    "default": []
                  },
                  "cpv": {
                    "title": "CPV codes",
                    "type": "array",
                    "description": "Match when tender.items[].classification.id starts with any code (client-side).",
                    "editor": "stringList",
                    "default": []
                  },
                  "noticeType": {
                    "title": "Notice stages",
                    "type": "array",
                    "description": "Mapped to API stages: planning | tender | award. Omit for all.",
                    "editor": "stringList",
                    "default": [],
                    "prefill": [
                      "tender"
                    ]
                  },
                  "updatedFrom": {
                    "title": "Updated from",
                    "type": "string",
                    "description": "ISO datetime. Default: 7 days ago.",
                    "editor": "textfield",
                    "nullable": true
                  },
                  "updatedTo": {
                    "title": "Updated to",
                    "type": "string",
                    "description": "ISO datetime. Default: now.",
                    "editor": "textfield",
                    "nullable": true
                  },
                  "maxItems": {
                    "title": "Max items",
                    "type": "integer",
                    "description": "Cap on notice rows.",
                    "default": 50,
                    "minimum": 1,
                    "maximum": 5000
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Dataset items",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyQuery": {
        "type": "apiKey",
        "in": "query",
        "name": "token",
        "description": "Apify API token for the caller's own account"
      },
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Apify API token as Bearer token"
      }
    }
  },
  "externalDocs": {
    "description": "Apify Store listing",
    "url": "https://apify.com/publicrecords/uk-find-a-tender-scraper"
  }
}
