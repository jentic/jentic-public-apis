{
  "openapi": "3.0.3",
  "info": {
    "title": "City Council Meeting Minutes & Agendas Scraper (Legistar)",
    "description": "City council meeting scraper for Legistar: pull meetings for public Legistar cities by date range, with body, date, agenda and minutes status and links (PDF when posted), optional agenda item titles and the official source link. No login.\n\nRuns on your own Apify account (pay-per-use). Store: https://apify.com/publicrecords/legistar-meetings-scraper\nMCP: https://mcp.apify.com?tools=publicrecords/legistar-meetings-scraper\nAuthor: Public Records.",
    "version": "0.0.15",
    "contact": {
      "name": "Public Records",
      "url": "https://apify.com/publicrecords",
      "email": "publicrecords@users.noreply.github.com"
    },
    "x-origin": [
      {
        "url": "https://apify.com/publicrecords/legistar-meetings-scraper",
        "format": "openapi",
        "version": "3.0"
      }
    ],
    "x-apisguru-categories": [
      "developer_tools"
    ]
  },
  "servers": [
    {
      "url": "https://api.apify.com/v2",
      "description": "Apify API"
    }
  ],
  "tags": [
    {
      "name": "runs",
      "description": "Start a run and read dataset items"
    }
  ],
  "paths": {
    "/acts/publicrecords~legistar-meetings-scraper/runs": {
      "post": {
        "operationId": "start_legistar_meetings_scraper_run",
        "tags": [
          "runs"
        ],
        "summary": "Start a run of publicrecords/legistar-meetings-scraper",
        "description": "Starts the Actor asynchronously. Poll the returned run, then read dataset items. Docs: https://apify.com/publicrecords/legistar-meetings-scraper",
        "security": [
          {
            "ApiKeyQuery": []
          },
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "timeout",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Timeout in seconds"
          },
          {
            "name": "memory",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Memory in MB"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://apify.com/schemas/v1/input.ide.json",
                "title": "Legistar Meetings Scraper",
                "description": "Public Granicus Legistar Web API. Client slug is the first label of {slug}.legistar.com (e.g. seattle). chicago currently 500s; phila 403s.",
                "type": "object",
                "schemaVersion": 1,
                "properties": {
                  "clients": {
                    "title": "Client slugs",
                    "type": "array",
                    "description": "Legistar client codes. Use the hostname label of {slug}.legistar.com. Working examples: seattle, milwaukee, madison, oakland, sanjose, boston, denver, columbus.",
                    "editor": "stringList",
                    "default": [
                      "seattle"
                    ],
                    "prefill": [
                      "seattle"
                    ]
                  },
                  "dateFrom": {
                    "title": "From date",
                    "type": "string",
                    "description": "Inclusive YYYY-MM-DD (EventDate / MatterIntroDate). Default: 30 days ago.",
                    "editor": "datepicker",
                    "nullable": true
                  },
                  "dateTo": {
                    "title": "To date",
                    "type": "string",
                    "description": "Inclusive YYYY-MM-DD. Default: today + 14 days.",
                    "editor": "datepicker",
                    "nullable": true
                  },
                  "maxItems": {
                    "title": "Max items",
                    "type": "integer",
                    "description": "Cap on dataset rows (events + matters combined).",
                    "default": 50,
                    "minimum": 1,
                    "maximum": 5000
                  },
                  "resource": {
                    "title": "Resource",
                    "type": "string",
                    "description": "Which Legistar collection to pull.",
                    "enum": [
                      "events",
                      "matters",
                      "both"
                    ],
                    "enumTitles": [
                      "Meetings (events)",
                      "Matters (legislation)",
                      "Both"
                    ],
                    "default": "events"
                  },
                  "includeEventItems": {
                    "title": "Include agenda item titles",
                    "type": "boolean",
                    "description": "Extra HTTP call per event. Titles flattened into eventItemTitles (pipe-separated). Default off.",
                    "default": false
                  }
                },
                "required": [
                  "clients"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Run started",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/acts/publicrecords~legistar-meetings-scraper/run-sync-get-dataset-items": {
      "post": {
        "operationId": "run_legistar_meetings_scraper_sync_get_items",
        "tags": [
          "runs"
        ],
        "summary": "Run publicrecords/legistar-meetings-scraper and return dataset items",
        "description": "Synchronous convenience endpoint. Waits for the run to finish and returns dataset items.",
        "security": [
          {
            "ApiKeyQuery": []
          },
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://apify.com/schemas/v1/input.ide.json",
                "title": "Legistar Meetings Scraper",
                "description": "Public Granicus Legistar Web API. Client slug is the first label of {slug}.legistar.com (e.g. seattle). chicago currently 500s; phila 403s.",
                "type": "object",
                "schemaVersion": 1,
                "properties": {
                  "clients": {
                    "title": "Client slugs",
                    "type": "array",
                    "description": "Legistar client codes. Use the hostname label of {slug}.legistar.com. Working examples: seattle, milwaukee, madison, oakland, sanjose, boston, denver, columbus.",
                    "editor": "stringList",
                    "default": [
                      "seattle"
                    ],
                    "prefill": [
                      "seattle"
                    ]
                  },
                  "dateFrom": {
                    "title": "From date",
                    "type": "string",
                    "description": "Inclusive YYYY-MM-DD (EventDate / MatterIntroDate). Default: 30 days ago.",
                    "editor": "datepicker",
                    "nullable": true
                  },
                  "dateTo": {
                    "title": "To date",
                    "type": "string",
                    "description": "Inclusive YYYY-MM-DD. Default: today + 14 days.",
                    "editor": "datepicker",
                    "nullable": true
                  },
                  "maxItems": {
                    "title": "Max items",
                    "type": "integer",
                    "description": "Cap on dataset rows (events + matters combined).",
                    "default": 50,
                    "minimum": 1,
                    "maximum": 5000
                  },
                  "resource": {
                    "title": "Resource",
                    "type": "string",
                    "description": "Which Legistar collection to pull.",
                    "enum": [
                      "events",
                      "matters",
                      "both"
                    ],
                    "enumTitles": [
                      "Meetings (events)",
                      "Matters (legislation)",
                      "Both"
                    ],
                    "default": "events"
                  },
                  "includeEventItems": {
                    "title": "Include agenda item titles",
                    "type": "boolean",
                    "description": "Extra HTTP call per event. Titles flattened into eventItemTitles (pipe-separated). Default off.",
                    "default": false
                  }
                },
                "required": [
                  "clients"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Dataset items",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyQuery": {
        "type": "apiKey",
        "in": "query",
        "name": "token",
        "description": "Apify API token for the caller's own account"
      },
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Apify API token as Bearer token"
      }
    }
  },
  "externalDocs": {
    "description": "Apify Store listing",
    "url": "https://apify.com/publicrecords/legistar-meetings-scraper"
  }
}
