                    "prefill": {
                      "useApifyProxy": true
                    },
                    "default": {
                      "useApifyProxy": true
                    }
                  }
                },
                "required": []
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Dataset items",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyQuery": {
        "type": "apiKey",
        "in": "query",
        "name": "token",
        "description": "Apify API token for the caller's own account"
      },
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Apify API token as Bearer token"
      }
    }
  },
