                        "Unibet — RO (ubro)",
                        "Paf — FI (paf)",
                        "Paf — ES (pafes)",
                        "Svenska Spel — SE (svenskaspel)",
                        "ATG — SE (atg)"
                      ]
                    },
                    "default": [
                      "rsiusnj",
                      "rsiusny",
                      "rsiuspa",
                      "rsicaon",
                      "ubuk",
                      "ubca",
                      "paf",
                      "svenskaspel",
                      "atg"
                    ]
                  },
                  "markets": {
                    "title": "Markets",
                    "type": "string",
                    "editor": "select",
                    "enum": [
                      "main",
