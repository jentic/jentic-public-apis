{
  "openapi": "3.0.3",
  "info": {
    "title": "Sports Betting Odds API: BetRivers, Unibet, Paf, Svenska Spel",
    "description": "Sports betting odds API: live and pre-game odds from BetRivers (12 US states + Ontario), Unibet (7 countries), Paf, Svenska Spel and ATG in one call. One row per game with every book's price and the best price per outcome. No API key. Pay per game.\n\nRuns on your own Apify account (pay-per-use). Store: https://apify.com/publicrecords/sports-odds-api\nMCP: https://mcp.apify.com?tools=publicrecords/sports-odds-api\nAuthor: Public Records.",
    "version": "0.0.3",
    "contact": {
      "name": "Public Records",
      "url": "https://apify.com/publicrecords",
      "email": "publicrecords@users.noreply.github.com"
    },
    "x-origin": [
      {
        "url": "https://apify.com/publicrecords/sports-odds-api",
        "format": "openapi",
        "version": "3.0"
      }
    ],
    "x-apisguru-categories": [
      "developer_tools"
    ]
  },
  "servers": [
    {
      "url": "https://api.apify.com/v2",
      "description": "Apify API"
    }
  ],
  "tags": [
    {
      "name": "runs",
      "description": "Start a run and read dataset items"
    }
  ],
  "paths": {
    "/acts/publicrecords~sports-odds-api/runs": {
      "post": {
        "operationId": "start_sports_odds_api_run",
        "tags": [
          "runs"
        ],
        "summary": "Start a run of publicrecords/sports-odds-api",
        "description": "Starts the Actor asynchronously. Poll the returned run, then read dataset items. Docs: https://apify.com/publicrecords/sports-odds-api",
        "security": [
          {
            "ApiKeyQuery": []
          },
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "timeout",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Timeout in seconds"
          },
          {
            "name": "memory",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Memory in MB"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "title": "Kambi sportsbook odds",
                "type": "object",
                "schemaVersion": 1,
                "properties": {
                  "leagues": {
                    "title": "Leagues or sports",
                    "type": "array",
                    "editor": "stringList",
                    "description": "Kambi paths, sport or league level: \"basketball/nba\", \"american_football/nfl\", \"ice_hockey/nhl\", \"baseball/mlb\", \"football/england/premier_league\", or a whole sport such as \"tennis\". Unknown paths are answered with suggestions and are never charged.",
                    "prefill": [
                      "basketball/nba",
                      "american_football/nfl",
                      "ice_hockey/nhl",
                      "baseball/mlb",
                      "football/england/premier_league"
                    ],
                    "default": [
                      "basketball/nba",
                      "american_football/nfl",
                      "ice_hockey/nhl",
                      "baseball/mlb",
                      "football/england/premier_league"
                    ]
                  },
                  "operators": {
                    "title": "Sportsbooks",
                    "type": "array",
                    "editor": "select",
                    "description": "Kambi-powered books to price. Each book is a separate brand/jurisdiction feed; prices can differ between them. The list contains only books verified open on the date in the README.",
                    "items": {
                      "type": "string",
                      "enum": [
                        "rsiusnj",
                        "rsiusny",
                        "rsiuspa",
                        "rsiusil",
                        "rsiusin",
                        "rsiusco",
                        "rsiusmi",
                        "rsiusaz",
                        "rsiusla",
                        "rsiusmd",
                        "rsiusoh",
                        "rsiuswv",
                        "rsicaon",
                        "ubuk",
                        "ubca",
                        "ubse",
                        "ubdk",
                        "ubbe",
                        "ubnl",
                        "ubro",
                        "paf",
                        "pafes",
                        "svenskaspel",
                        "atg"
                      ],
                      "enumTitles": [
                        "BetRivers — US-NJ (rsiusnj)",
                        "BetRivers — US-NY (rsiusny)",
                        "BetRivers — US-PA (rsiuspa)",
                        "BetRivers — US-IL (rsiusil)",
                        "BetRivers — US-IN (rsiusin)",
                        "BetRivers — US-CO (rsiusco)",
                        "BetRivers — US-MI (rsiusmi)",
                        "BetRivers — US-AZ (rsiusaz)",
                        "BetRivers — US-LA (rsiusla)",
                        "BetRivers — US-MD (rsiusmd)",
                        "BetRivers — US-OH (rsiusoh)",
                        "BetRivers — US-WV (rsiuswv)",
                        "BetRivers — CA-ON (rsicaon)",
                        "Unibet — GB (ubuk)",
                        "Unibet — CA-ON (ubca)",
                        "Unibet — SE (ubse)",
                        "Unibet — DK (ubdk)",
                        "Unibet — BE (ubbe)",
                        "Unibet — NL (ubnl)",
                        "Unibet — RO (ubro)",
                        "Paf — FI (paf)",
                        "Paf — ES (pafes)",
                        "Svenska Spel — SE (svenskaspel)",
                        "ATG — SE (atg)"
                      ]
                    },
                    "default": [
                      "rsiusnj",
                      "rsiusny",
                      "rsiuspa",
                      "rsicaon",
                      "ubuk",
                      "ubca",
                      "paf",
                      "svenskaspel",
                      "atg"
                    ]
                  },
                  "markets": {
                    "title": "Markets",
                    "type": "string",
                    "editor": "select",
                    "enum": [
                      "main",
                      "all"
                    ],
                    "enumTitles": [
                      "Main lines (moneyline, spread, total)",
                      "Every market incl. player props and alternates"
                    ],
                    "description": "\"main\" returns the headline markets per game. \"all\" returns each game's full board (often 300–500 markets) and is priced higher.",
                    "default": "main"
                  },
                  "includeLive": {
                    "title": "Include in-play games",
                    "type": "boolean",
                    "description": "Include games already started (live prices at the moment of the run).",
                    "default": true
                  },
                  "startsWithinHours": {
                    "title": "Only games starting within (hours)",
                    "type": "integer",
                    "minimum": 0,
                    "description": "0 = no limit. Live games are kept when \"Include in-play games\" is on.",
                    "default": 0
                  },
                  "maxEvents": {
                    "title": "Max games",
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000,
                    "description": "Soonest games first. You pay per game returned.",
                    "prefill": 10,
                    "default": 50
                  },
                  "proxyConfiguration": {
                    "title": "Proxy (optional)",
                    "type": "object",
                    "editor": "proxy",
                    "description": "On by default. Kambi limits how often one IP may ask; your run moves to a fresh Apify Proxy IP whenever it is slowed down. Turn off only to test without a proxy.",
                    "prefill": {
                      "useApifyProxy": true
                    },
                    "default": {
                      "useApifyProxy": true
                    }
                  }
                },
                "required": []
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Run started",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/acts/publicrecords~sports-odds-api/run-sync-get-dataset-items": {
