                  }
                }
              },
              "usageTotalUsd": {
                "type": "number",
                "example": 5e-05
              },
              "usageUsd": {
                "type": "object",
                "properties": {
                  "ACTOR_COMPUTE_UNITS": {
                    "type": "integer",
                    "example": 0
                  },
                  "DATASET_READS": {
