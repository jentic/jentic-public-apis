{
  "openapi": "3.0.1",
  "info": {
    "title": "Google News API",
    "description": "Search and scrape news articles from Google News.  Fast.  Location-based searches, language filters, safe search, pagination control. Returns structured JSON data with article titles, links, sources, snippets, and publication dates. News monitoring, markets, and content aggregation.",
    "version": "0.0",
    "x-build-id": "uQGjEUOb6k6XKRNli"
  },
  "servers": [
    {
      "url": "https://api.apify.com/v2"
    }
  ],
  "paths": {
    "/acts/johnvc~GoogleNewsAPI/run-sync-get-dataset-items": {
      "post": {
        "operationId": "run-sync-get-dataset-items-johnvc-GoogleNewsAPI",
        "x-openai-isConsequential": false,
        "summary": "Executes an Actor, waits for its completion, and returns Actor's dataset items in response.",
        "tags": [
          "Run Actor"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/inputSchema"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Enter your Apify token here"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/acts/johnvc~GoogleNewsAPI/runs": {
      "post": {
        "operationId": "runs-sync-johnvc-GoogleNewsAPI",
        "x-openai-isConsequential": false,
        "summary": "Executes an Actor and returns information about the initiated run in response.",
        "tags": [
          "Run Actor"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/inputSchema"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Enter your Apify token here"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/runsResponseSchema"
                }
              }
            }
          }
        }
      }
    },
    "/acts/johnvc~GoogleNewsAPI/run-sync": {
      "post": {
        "operationId": "run-sync-johnvc-GoogleNewsAPI",
        "x-openai-isConsequential": false,
        "summary": "Executes an Actor, waits for completion, and returns the OUTPUT from Key-value store in response.",
        "tags": [
          "Run Actor"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/inputSchema"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Enter your Apify token here"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "inputSchema": {
        "type": "object",
        "properties": {
          "q": {
            "title": "Search Query",
            "type": "string",
            "description": "Search query string for news articles (e.g., 'technology news', 'coffee', 'artificial intelligence'). Provide this, Search Queries, or both."
          },
          "queries": {
            "title": "Search Queries",
            "type": "array",
            "description": "Several search queries in one run (e.g., 'Nvidia', 'OpenAI', 'Anthropic'). Each query is searched separately with the same settings, and every page of every query is its own dataset item. Used together with Search Query when both are set; repeats are skipped. The setup fee is charged once per run, not per query.",
            "items": {
              "type": "string"
            }
          },
          "time_range": {
            "title": "Time Range",
            "enum": [
              "any",
              "hour",
              "day",
              "week",
              "month",
              "year"
            ],
            "type": "string",
            "description": "Only return articles published within this window. Any value other than 'Any time' sorts results newest first and stops at the first article older than the window, so you only pay for pages with recent news.",
            "default": "any"
          },
          "location": {
            "title": "Location",
            "type": "string",
            "description": "Geographic location for localized news results (e.g., 'Austin, TX, Texas, United States', 'New York, NY'). Optional. Helps narrow down news to a specific area."
          },
          "google_domain": {
            "title": "Google Domain",
            "type": "string",
            "description": "Google domain to use for the search (e.g., 'google.com', 'google.co.uk', 'google.fr'). Optional. Defaults to 'google.com' if not specified."
          },
