Rounds raised by this company.","schema":{"type":"string","format":"uuid"}},{"name":"stage","in":"query","required":false,"description":"Exact stage.","schema":{"type":"string","enum":["pre_seed","seed","series_a","series_b","series_c","series_d","series_e","series_f","series_g","series_h","series_i","series_j","growth","debt","grant","ipo","acquired","other"]}},{"name":"announced_after","in":"query","required":false,"description":"Announced on or after this date (YYYY-MM-DD). Excludes rounds with no announced date.","schema":{"type":"string","format":"date"}},{"name":"announced_before","in":"query","required":false,"description":"Announced on or before this date (YYYY-MM-DD), inclusive of the whole day. Excludes rounds with no announced date.","schema":{"type":"string","format":"date"}}],"responses":{"200":{"description":"Success.","content":{"application/json":{"schema":{"type":"object","required":["data","pagination"],"properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/Round"}},"pagination":{"$ref":"#/components/schemas/Pagination"}}}}}},"401":{"description":"Missing or invalid API key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Either the free monthly call allowance is used up, or the endpoint needs a higher plan than this key holds. The body says which: a plan refusal carries `required_plan` and `current_plan`.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"No such resource — or, for lists, not one of yours.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limit exceeded. Retry after the `Retry-After` header.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"500":{"description":"Something failed on our side. Safe to retry.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/signals":{"get":{"tags":["Signals"],"summary":"List signals, newest first.","operationId":"getSignals","parameters":[{"name":"page","in":"query","required":false,"description":"1-indexed page number. Default 1.","schema":{"type":"integer"}},{"name":"limit","in":"query","required":false,"description":"Rows per page. Default 20, maximum 100.","schema":{"type":"integer"}},{"name":"family","in":"query","required":false,"description":"The audience lens. Omit for the mixed feed, which interleaves every family evenly rather than returning whichever detector ran last.","schema":{"type":"string","enum":["sales","hiring","job_hunting","investor","raise"]}},{"name":"type","in":"query","required":false,"description":"Exact signal type.","schema":{"type":"string","examples":["new_funding","actively_hiring","new_executive","geo_expansion","event_presence"]}},{"name":"sector","in":"query","required":false,"description":"Industry of the signal's subject.","schema":{"type":"string"}},{"name":"geo","in":"query","required":false,"description":"Country the signal happened in — where the reader's next move is, which for an expansion or an event is not the subject's home market.","schema":{"type":"string"}},{"name":"stage","in":"query","required":false,"description":"Funding stage the signal is about — the anchoring round's stage, and for the behavioural raise signals every stage the fund wrote a cheque at in the window, so a fund spanning seed and Series A answers both.","schema":{"type":"string","enum":["pre_seed","seed","series_a","series_b","series_c","series_d","series_e","growth","grant","debt","ipo"]}},{"name":"days","in":"query","required":false,"description":"Only signals detected within this many days.","schema":{"type":"integer"}}],"responses":{"200":{"description":"Success.","content":{"application/json":{"schema":{"type":"object","required":["data","pagination"],"properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/Signal"}},"pagination":{"$ref":"#/components/schemas/Paginatio