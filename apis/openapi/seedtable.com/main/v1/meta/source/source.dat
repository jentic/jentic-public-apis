"required":false,"description":"Rows per page. Default 20, maximum 100.","schema":{"type":"integer"}},{"name":"q","in":"query","required":false,"description":"Search names — and, on a plan that carries contacts, email addresses too.","schema":{"type":"string"}},{"name":"company_id","in":"query","required":false,"description":"People affiliated with this company.","schema":{"type":"string","format":"uuid"}},{"name":"role","in":"query","required":false,"description":"Role held at a company (ceo, founder, cto, …). Repeatable — several roles are OR'd.","schema":{"type":"string","enum":["founder","ceo","cto","cfo","coo","cpo","cmo","cro","executive","vp_engineering","vp_sales","vp_marketing","vp","head_of_product","director","manager","general_partner","limited_partner","partner","investor","board_member","advisor","other"]}},{"name":"title","in":"query","required":false,"description":"Partial, case-insensitive match on the job title as written.","schema":{"type":"string"}},{"name":"function","in":"query","required":false,"description":"Department grouping (engineering, sales, marketing, …), matching role or title. Repeatable.","schema":{"type":"string"}},{"name":"category","in":"query","required":false,"description":"Only people at companies in this curated sector (exact slug). Repeatable.","schema":{"type":"string"}},{"name":"funding_stage","in":"query","required":false,"description":"Only people at companies at this funding stage. Repeatable.","schema":{"type":"string","enum":["pre_seed","seed","series_a","series_b","series_c","series_d","series_e","series_f","series_g","series_h","series_i","series_j","growth","debt","grant","ipo","acquired","other"]}},{"name":"country","in":"query","required":false,"description":"Only people at companies in this country (alias-aware).","schema":{"type":"string"}},{"name":"geo_country","in":"query","required":false,"description":"Headquarters-resolved country scope, matching the `/people/{country}/…` pages. Takes precedence over `country`.","schema":{"type":"string"}},{"name":"geo_region","in":"query","required":false,"description":"Headquarters state/region scope.","schema":{"type":"string"}},{"name":"geo_city","in":"query","required":false,"description":"Headquarters city scope.","schema":{"type":"string"}},{"name":"min_employees","in":"query","required":false,"description":"Only people at companies of at least this headcount.","schema":{"type":"integer"}},{"name":"max_employees","in":"query","required":false,"description":"Only people at companies of at most this headcount.","schema":{"type":"integer"}},{"name":"likely_to_move","in":"query","required":false,"description":"Only people whose company signals a likely move (recently funded, wound down, acquired or low-momentum).","schema":{"type":"boolean"}},{"name":"educated_at","in":"query","required":false,"description":"Alumni of this institution.","schema":{"type":"string","format":"uuid"}},{"name":"is_decision_maker","in":"query","required":false,"description":"Only people flagged as decision makers.","schema":{"type":"boolean"}}],"responses":{"200":{"description":"Success.","content":{"application/json":{"schema":{"type":"object","required":["data","pagination"],"properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/Person"}},"pagination":{"$ref":"#/components/schemas/Pagination"}}}}}},"401":{"description":"Missing or invalid API key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Either the free monthly call allowance is used up, or the endpoint needs a higher plan than this key holds. The body says which: a plan refusal carries `required_plan` and `current_plan`.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"No such resource — or, for lists, not one of yours.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limit exceeded. Retry after the `Retry