m":["sales","hiring","job_hunting","investor","raise"]}},{"name":"type","in":"query","required":false,"description":"Exact signal type.","schema":{"type":"string","examples":["new_funding","actively_hiring","new_executive","geo_expansion"]}}],"responses":{"200":{"description":"Success.","content":{"application/json":{"schema":{"type":"object","required":["data","pagination"],"properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/Alert"}},"pagination":{"$ref":"#/components/schemas/Pagination"}}}}}},"401":{"description":"Missing or invalid API key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Either the free monthly call allowance is used up, or the endpoint needs a higher plan than this key holds. The body says which: a plan refusal carries `required_plan` and `current_plan`.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"No such resource — or, for lists, not one of yours.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limit exceeded. Retry after the `Retry-After` header.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"500":{"description":"Something failed on our side. Safe to retry.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/events":{"get":{"tags":["Events"],"summary":"List events (series and editions).","operationId":"getEvents","parameters":[{"name":"page","in":"query","required":false,"description":"1-indexed page number. Default 1.","schema":{"type":"integer"}},{"name":"limit","in":"query","required":false,"description":"Rows per page. Default 20, maximum 100.","schema":{"type":"integer"}},{"name":"q","in":"query","required":false,"description":"Partial, case-insensitive match on the event name.","schema":{"type":"string"}},{"name":"kind","in":"query","required":false,"description":"`series` for the brand, `edition` for one running of it.","schema":{"type":"string","enum":["series","edition"]}},{"name":"event_type","in":"query","required":false,"description":"Format of the event.","schema":{"type":"string","enum":["conference","trade_show","summit","expo","meetup","other"]}},{"name":"city","in":"query","required":false,"description":"Partial match on host city (editions only).","schema":{"type":"string"}},{"name":"country","in":"query","required":false,"description":"Partial match on host country (editions only).","schema":{"type":"string"}},{"name":"year","in":"query","required":false,"description":"Edition year.","schema":{"type":"integer"}},{"name":"series_id","in":"query","required":false,"description":"Editions of this series.","schema":{"type":"string","format":"uuid"}},{"name":"starts_after","in":"query","required":false,"description":"Editions starting on or after this date (YYYY-MM-DD).","schema":{"type":"string","format":"date"}},{"name":"starts_before","in":"query","required":false,"description":"Editions starting on or before this date.","schema":{"type":"string","format":"date"}},{"name":"company_id","in":"query","required":false,"description":"Editions this company attends, exhibits at or sponsors. Accepts either the company's UUID or its slug.","schema":{"type":"string"}},{"name":"sort_by","in":"query","required":false,"description":"Field to sort by.","schema":{"type":"string","enum":["startDate","name","attendance","score","createdAt","updatedAt"]}},{"name":"sort_order","in":"query","required":false,"description":"Sort direction. Default desc.","schema":{"type":"string","enum":["asc","desc"]}}],"responses":{"200":{"description":"Success.","content":{"application/json":{"schema":{"type":"object","required":["data","pagination"],"properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/Event"}},"pagination":{"$ref":"#/components/schemas/Pagination"}}}}}},"401":{"description":"Missing or invalid API key.","content":{"app