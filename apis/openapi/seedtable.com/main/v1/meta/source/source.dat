{"openapi":"3.1.0","info":{"title":"Seedtable API","version":"v1","description":"Read access to Seedtable's database of companies, investors, people, funding rounds, events, products and the customer/supplier graph — plus lookalike search and read-write access to your own saved lists. Every account gets 100 free calls a month; Pro and Scale lift the cap.","termsOfService":"https://seedtable.com/terms","contact":{"name":"Seedtable","url":"https://seedtable.com/developers"}},"servers":[{"url":"https://seedtable.com/api/v1","description":"Seedtable API v1"}],"security":[{"bearerAuth":[]}],"components":{"securitySchemes":{"bearerAuth":{"type":"http","scheme":"bearer","description":"An API key minted at /members/api, sent as `Authorization: Bearer st_live_…`. The `X-Api-Key` header is accepted as an alternative."}},"schemas":{"Pagination":{"type":"object","required":["page","limit","total","totalPages"],"properties":{"page":{"type":"integer","description":"1-indexed page returned."},"limit":{"type":"integer","description":"Rows per page."},"total":{"type":"integer","description":"Total rows matching the query."},"totalPages":{"type":"integer","description":"Total pages at this limit."}}},"Error":{"type":"object","required":["error"],"properties":{"error":{"type":"string","description":"Human-readable message."},"details":{"type":"object","description":"Field-level validation problems, on a 400."}}},"Company":{"type":"object","properties":{"id":{"type":"string","format":"uuid","description":"Stable Seedtable identifier."},"name":{"type":"string","description":"Company name."},"slug":{"type":"string","description":"URL key — the /companies/<slug> path segment."},"description":{"type":["string","null"],"description":"One-paragraph description of what the company does."},"website":{"type":["string","null"],"description":"Official website."},"logo":{"type":["string","null"],"description":"Logo URL."},"city":{"type":["string","null"],"description":"Headquarters city."},"country":{"type":["string","null"],"description":"Headquarters country. HQ only — offices elsewhere are not reflected here."},"industry":{"type":["string","null"],"description":"Primary industry."},"employeeCount":{"type":["integer","null"],"description":"Latest known headcount."},"foundedYear":{"type":["integer","null"],"description":"Year founded."},"status":{"type":["string","null"],"description":"Lifecycle status (active, acquired, closed, …)."},"fundingStage":{"type":["string","null"],"enum":["pre_seed","seed","series_a","series_b","series_c","series_d","series_e","series_f","series_g","series_h","series_i","series_j","growth","debt","grant","ipo","acquired","other",null],"description":"Stage of the most recent round."},"totalFunding":{"type":["integer","null"],"description":"Total disclosed funding raised, in USD."},"lastFundingAmount":{"type":["integer","null"],"description":"Amount of the most recent round, in USD."},"lastFundingDate":{"type":["string","null"],"format":"date","description":"Announcement date of the most recent round."},"score":{"type":["number","null"],"description":"Seedtable score (0–100): the composite ranking signal."},"likelyToHire":{"type":["boolean","null"],"description":"Model flag: showing hiring signals."},"likelyToOutsource":{"type":["boolean","null"],"description":"Model flag: showing outsourcing signals."},"tags":{"type":["array","null"],"items":{"type":"string"},"description":"Free-form tags."},"createdAt":{"type":"string","format":"date-time","description":"When the row was first created in Seedtable (ISO 8601, UTC)."},"updatedAt":{"type":"string","format":"date-time","description":"When any field on the row last changed."}}},"Investor":{"type":"object","properties":{"id":{"type":"string","format":"uuid","description":"Stable Seedtable identifier."},"name":{"type":"string","description":"Investor name."},"slug":{"type":"string","description":"URL key."},"type":{"type":["string","null"],"enum":["vc","angel","solo_gp","pe","cvc","accelerator","family_office","fund_lp","fund_of_funds","other","fund","private_credit","foundation",null],"description":"Investor type. `fund` is a single vehicle; the firm behind it is `parentInvestorId`."},"parentInvestorId":{"type":["string","null"],"format":"uuid","description":"For a fund vehicle, the firm that manages it."},"city":{"type":["string","null"],"description":"Head office city."},"country":{"type":["string","null"],"description":"Head office country."},"website":{"type":["string","null"],"description":"Official website."},"description":{"type":["string","null"],"description":"What the investor backs."},"score":{"type":["number","null"],"description":"Seedtable score (0–100)."},"portfolioCount":{"type":["integer","null"],"description":"Number of portfolio companies we hold."},"totalInvested":{"type":["integer","null"],"description":"Sum of disclosed participation, in USD."},"createdAt":{"type":"string","format":"date-time","description":"When the row was first created in Seedtable (ISO 8601, UTC)."},"updatedAt":{"type":"string","format":"date-time","description":"When any field on the row last changed."}}},"Person":{"type":"object","properties":{"id":{"type":"string","format":"uuid","description":"Stable Seedtable identifier."},"firstName":{"type":["string","null"],"description":"First name."},"lastName":{"type":["string","null"],"description":"Last name."},"slug":{"type":["string","null"],"description":"URL key."},"email":{"type":["string","null"],"description":"Verified work email. Pro and Team only, and present for roughly one person in eight — where we have no verified address, see `inferredEmail`."},"phone":{"type":["string","null"],"description":"Phone number, where verified. Pro and Team only."},"inferredEmail":{"type":["string","null"],"description":"The likely work email, derived from this person's name and their employer's observed email format, when no verified address exists. Pro and Team only. A guess — read `inferredEmailConfidence` before sending to it."},"inferredEmailSource":{"type":["string","null"],"description":"How the guess was reached: `inferred_format` (the company's learned address format), `inferred_default` (the common first.last pattern), `human` (a Seedtable member confirmed it), `editorial`, `external`."},"inferredEmailConfidence":{"type":["string","null"],"description":"`verified` (confirmed by a member), `high`, `low`, or `reported` — which means a member told us mail to it bounced. Do not send to a reported address."},"linkedin":{"type":["string","null"],"description":"LinkedIn profile URL."},"twitter":{"type":["string","null"],"description":"X/Twitter handle."},"createdAt":{"type":"string","format":"date-time","description":"When the row was first created in Seedtable (ISO 8601, UTC)."},"updatedAt":{"type":"string","format":"date-time","description":"When any field on the row last changed."}}},"Round":{"type":"object","properties":{"id":{"type":"string","format":"uuid","description":"Stable Seedtable identifier."},"companyId":{"type":"string","format":"uuid","description":"The company that raised."},"slug":{"type":["string","null"],"description":"URL key for the round page."},"stage":{"type":["string","null"],"enum":["pre_seed","seed","series_a","series_b","series_c","series_d","series_e","series_f","series_g","series_h","series_i","series_j","growth","debt","grant","ipo","acquired","other",null],"description":"Round stage."},"amount":{"type":["integer","null"],"description":"Amount raised, in `currency`."},"currency":{"type":["string","null"],"description":"ISO 4217 code of `amount`."},"announcedDate":{"type":["string","null"],"format":"date","description":"Date the round was announced."},"preMoneyValuation":{"type":["integer","null"],"description":"Pre-money valuation, where disclosed."},"postMoneyValuation":{"type":["integer","null"],"description":"Post-money valuation, where disclosed."},"createdAt":{"type":"string","format":"date-time","description":"When the row was first created in Seedtable (ISO 8601, UTC)."},"updatedAt":{"type":"string","format":"date-time","description":"When any field on the row last changed."}}},"Signal":{"type":"object","properties":{"id":{"type":"string","format":"uuid","description":"Stable Seedtable identifier."},"family":{"type":"string","enum":["sales","hiring","job_hunting","investor","raise"],"description":"Audience the signal is for."},"type":{"type":"string","description":"What was detected."},"entityType":{"type":"string","examples":["company","investor"],"description":"Whether the subject is a company or an investor."},"headline":{"type":"string","description":"One-line statement of the change."},"detail":{"type":["object","null"],"description":"Type-specific payload — the amount for a raise, the role for an appointment, the country for an expansion."},"confidence":{"type":["number","null"],"description":"How sure the detector is (0–1)."},"detectedAt":{"type":"string","format":"date-time","description":"When it was detected."},"companyId":{"type":["string","null"],"format":"uuid","description":"Company subject, where there is one."},"companyName":{"type":["string","null"],"description":"Company name."},"companySlug":{"type":["string","null"],"description":"Company URL key."},"investorId":{"type":["string","null"],"format":"uuid","description":"Investor subject — raise signals only."},"investorName":{"type":["string","null"],"description":"Investor name."},"investorSlug":{"type":["string","null"],"description":"Investor URL key."},"industry":{"type":["string","null"],"description":"Sector of the subject."},"country":{"type":["string","null"],"description":"Country the signal happened in."},"companyScore":{"type":["number","null"],"description":"Seedtable score of the company subject."}}},"Alert":{"type":"object","properties":{"id":{"type":"string","format":"uuid","description":"Stable Seedtable identifier."},"family":{"type":"string","enum":["sales","hiring","job_hunting","investor","raise"],"description":"Audience the signal is for."},"type":{"type":"string","description":"What was detected."},"entityType":{"type":"string","examples":["company","investor"],"description":"Whether the subject is a company or an investor."},"headline":{"type":"string","description":"One-line statement of the change."},"detail":{"type":["object","null"],"description":"Type-specific payload — the amount for a raise, the role for an appointment, the country for an expansion."},"confidence":{"type":["number","null"],"description":"How sure the detector is (0–1)."},"detectedAt":{"type":"string","format":"date-time","description":"When it was detected."},"companyId":{"type":["string","null"],"format":"uuid","description":"Company subject, where there is one."},"companyName":{"type":["string","null"],"description":"Company name."},"companySlug":{"type":["string","null"],"description":"Company URL key."},"investorId":{"type":["string","null"],"format":"uuid","description":"Investor subject — raise signals only."},"investorName":{"type":["string","null"],"description":"Investor name."},"investorSlug":{"type":["string","null"],"description":"Investor URL key."},"industry":{"type":["string","null"],"description":"Sector of the subject."},"country":{"type":["string","null"],"description":"Country the signal happened in."},"companyScore":{"type":["number","null"],"description":"Seedtable score of the company subject."}}},"Event":{"type":"object","properties":{"id":{"type":"string","format":"uuid","description":"Stable Seedtable identifier."},"name":{"type":"string","description":"Event name."},"slug":{"type":"string","description":"Globally unique URL key. Editions are `<series-slug>-<year>`."},"kind":{"type":"string","enum":["series","edition"],"description":"Whether this row is the recurring series or one edition of it."},"seriesId":{"type":["string","null"],"format":"uuid","description":"On an edition, its parent series. Null on a series."},"description":{"type":["string","null"],"description":"What the event covers."},"website":{"type":["string","null"],"description":"Official website."},"ticketUrl":{"type":["string","null"],"description":"Where to buy tickets."},"eventType":{"type":["string","null"],"enum":["conference","trade_show","summit","expo","meetup","other",null],"description":"Format of the event."},"startDate":{"type":["string","null"],"format":"date","description":"First day (editions only)."},"endDate":{"type":["string","null"],"format":"date","description":"Last day (editions only)."},"year":{"type":["integer","null"],"description":"Edition year (editions only)."},"venue":{"type":["string","null"],"description":"Venue name (editions only)."},"city":{"type":["string","null"],"description":"Host city (editions only)."},"country":{"type":["string","null"],"description":"Host country (editions only)."},"attendance":{"type":["integer","null"],"description":"Reported or estimated attendee headcount."},"score":{"type":["number","null"],"description":"Seedtable score for the event."},"status":{"type":"string","description":"`active` for everything the API returns."},"createdAt":{"type":"string","format":"date-time","description":"When the row was first created in Seedtable (ISO 8601, UTC)."},"updatedAt":{"type":"string","format":"date-time","description":"When any field on the row last changed."}}},"EventParticipant":{"type":"object","properties":{"id":{"type":"string","format":"uuid","description":"Identifier of the participation edge."},"eventId":{"type":"string","format":"uuid","description":"The edition."},"companyId":{"type":"string","format":"uuid","description":"The participating company."},"role":{"type":"string","enum":["attendee","exhibitor","sponsor"],"description":"How the company took part. A company can hold more than one role at an edition."},"sourceUrl":{"type":["string","null"],"description":"The page this was read off."},"lastVerified":{"type":["string","null"],"format":"date","description":"When that page was last confirmed to still say so."},"companyName":{"type":"string","description":"Inlined company name."},"companySlug":{"type":"string","description":"Inlined company slug."},"companyWebsite":{"type":["string","null"],"description":"Inlined company website."},"companyLogo":{"type":["string","null"],"description":"Inlined company logo URL."},"createdAt":{"type":"string","format":"date-time","description":"When the edge was recorded."}}},"EventSpeaker":{"type":"object","properties":{"id":{"type":"string","format":"uuid","description":"Identifier of the speaking slot."},"eventId":{"type":"string","format":"uuid","description":"The edition."},"personId":{"type":"string","format":"uuid","description":"The speaker."},"companyId":{"type":["string","null"],"format":"uuid","description":"The speaker's company at the time."},"talkTitle":{"type":["string","null"],"description":"Title of the talk, where published."},"track":{"type":["string","null"],"description":"Programme track."},"talkDate":{"type":["string","null"],"format":"date","description":"Day of the talk."},"role":{"type":["string","null"],"examples":["speaker","keynote","panelist","moderator","fireside"],"description":"How they appeared. Free text — where a programme published a job title instead of a role, that is what we hold."},"sourceUrl":{"type":["string","null"],"description":"The programme page this was read off."},"lastVerified":{"type":["string","null"],"format":"date","description":"When that page was last confirmed."},"firstName":{"type":["string","null"],"description":"Inlined speaker first name."},"lastName":{"type":["string","null"],"description":"Inlined speaker last name."},"personSlug":{"type":["string","null"],"description":"Inlined speaker slug."},"personLinkedin":{"type":["string","null"],"description":"Inlined speaker LinkedIn URL."},"companyName":{"type":["string","null"],"description":"Inlined company name."},"companySlug":{"type":["string","null"],"description":"Inlined company slug."},"createdAt":{"type":"string","format":"date-time","description":"When the slot was recorded."}}},"Product":{"type":"object","properties":{"id":{"type":"string","format":"uuid","description":"Stable Seedtable identifier."},"companyId":{"type":"string","format":"uuid","description":"The company that makes it."},"name":{"type":"string","description":"Product name."},"slug":{"type":"string","description":"URL key, unique within the company."},"description":{"type":["string","null"],"description":"What the product does."},"website":{"type":["string","null"],"description":"Product website."},"logo":{"type":["string","null"],"description":"Product logo URL."},"createdAt":{"type":"string","format":"date-time","description":"When the row was first created in Seedtable (ISO 8601, UTC)."},"updatedAt":{"type":"string","format":"date-time","description":"When any field on the row last changed."},"companyName":{"type":["string","null"],"description":"Inlined maker name."},"companySlug":{"type":["string","null"],"description":"Inlined maker slug."},"customerCount":{"type":["integer","null"],"description":"Known buyers of this product (single-product response only)."}}},"Customer":{"type":"object","properties":{"id":{"type":"string","format":"uuid","description":"Identifier of the edge."},"supplierCompanyId":{"type":"string","format":"uuid","description":"The company doing the selling."},"customerCompanyId":{"type":["string","null"],"format":"uuid","description":"The buyer, when we hold it as a company."},"customerName":{"type":"string","description":"The buyer's name, always populated."},"customerDomain":{"type":["string","null"],"description":"The buyer's domain, where known."},"customerContactName":{"type":["string","null"],"description":"The champion: the named person at the buyer who chose or uses the product, as at the evidence date."},"customerContactTitle":{"type":["string","null"],"description":"Their title at the buyer, as at the evidence date."},"customerContactPersonId":{"type":["string","null"],"format":"uuid","description":"The champion resolved to a person record. Null unless the match is corroborated — a common name is left unresolved rather than guessed."},"productId":{"type":["string","null"],"format":"uuid","description":"The product bought, on product-level edges."},"relationshipType":{"type":"string","examples":["customer","pilot","partner","partner_reseller","supplier"],"description":"Nature of the relationship."},"status":{"type":"string","examples":["active","ended","rumoured"],"description":"Current state. An ended relationship is kept, never deleted."},"startedOn":{"type":["string","null"],"format":"date","description":"Start date, when a full date is known."},"startedYear":{"type":["integer","null"],"description":"Start year, when only the year is known."},"startedMonth":{"type":["integer","null"],"description":"Start month (1–12), when known."},"endedOn":{"type":["string","null"],"format":"date","description":"End date, when a full date is known."},"endedYear":{"type":["integer","null"],"description":"End year, when only the year is known."},"endedMonth":{"type":["integer","null"],"description":"End month (1–12), when known."},"endReason":{"type":["string","null"],"examples":["churned","switched_vendor","insourced","acquired","shut_down","contract_expired","security_incident","unknown"],"description":"Why the relationship ended."},"switchedToCompanyId":{"type":["string","null"],"format":"uuid","description":"The competitor that won the account, when resolved."},"switchedToName":{"type":["string","null"],"description":"The competitor that won the account, by name."},"confidence":{"type":"string","examples":["confirmed","reported","inferred"],"description":"How firmly the edge is established."},"evidenceType":{"type":["string","null"],"examples":["case_study","press_release","customer_page","logo_wall","news_article"],"description":"Kind of source behind the edge. Free text — the list is open."},"evidenceUrl":{"type":["string","null"],"description":"The source URL."},"evidenceTitle":{"type":["string","null"],"description":"Title of the source."},"evidencePublishedOn":{"type":["string","null"],"format":"date","description":"Publication date of the source."},"evidenceMissingSince":{"type":["string","null"],"format":"date-time","description":"Set only when a re-crawl SUCCEEDED and the reference was gone — the difference between 'evidence removed' and 'we stopped looking'."},"annualValueUsd":{"type":["integer","null"],"description":"Annual contract value, where disclosed."},"revenueSharePct":{"type":["number","null"],"description":"Share of the supplier's revenue, where disclosed."},"isPublicReference":{"type":"boolean","description":"Whether the buyer can be named publicly (logo wall, joint release)."},"lastSeenAt":{"type":"string","format":"date-time","description":"When the edge was last confirmed by a crawl."},"supplierName":{"type":"string","description":"Inlined supplier name."},"supplierSlug":{"type":"string","description":"Inlined supplier slug."},"customerSlug":{"type":["string","null"],"description":"Inlined buyer slug, when resolved."},"productName":{"type":["string","null"],"description":"Inlined product name, on product-level edges."},"productSlug":{"type":["string","null"],"description":"Inlined product slug."},"createdAt":{"type":"string","format":"date-time","description":"When the row was first created in Seedtable (ISO 8601, UTC)."},"updatedAt":{"type":"string","format":"date-time","description":"When any field on the row last changed."}}},"Lookalike":{"type":"object","properties":{"id":{"type":"string","format":"uuid","description":"The matched company."},"name":{"type":"string","description":"Company name."},"slug":{"type":"string","description":"URL key on seedtable.com."},"city":{"type":["string","null"],"description":"Headquarters city."},"country":{"type":["string","null"],"description":"Headquarters country."},"industry":{"type":["string","null"],"description":"Primary industry."},"fundingStage":{"type":["string","null"],"enum":["pre_seed","seed","series_a","series_b","series_c","series_d","series_e","series_f","series_g","series_h","series_i","series_j","growth","debt","grant","ipo","acquired","other",null],"description":"Latest funding stage."},"score":{"type":["number","null"],"description":"Seedtable score, 0–100."},"employeeCount":{"type":["integer","null"],"description":"Latest headcount."},"sharedCategories":{"type":"array","items":{"type":"string"},"description":"Categories this company shares with the seed set, rarest first — the reason it ranked."},"sharedInvestors":{"type":"array","items":{"type":"string"},"description":"Investors that backed both it and at least one seed."},"matchedSeeds":{"type":"integer","description":"How many of the seeds it shares a category with. A row matching one seed out of twenty is an edge of the set, not its centre."}}},"List":{"type":"object","properties":{"id":{"type":"string","format":"uuid","description":"Stable identifier."},"name":{"type":"string","description":"List name."},"description":{"type":["string","null"],"description":"Short internal subtitle."},"commentary":{"type":["string","null"],"description":"Longer curator note, shown only on the public share page."},"persona":{"type":"string","enum":["general","job_seeker","sales","investor","founder","recruiter","data_partner"],"description":"What kind of list this is."},"isPublic":{"type":"boolean","description":"Whether /l/<publicSlug> is live."},"publicSlug":{"type":["string","null"],"description":"The share slug — stable once minted."},"createdAt":{"type":"string","format":"date-time","description":"When the row was first created in Seedtable (ISO 8601, UTC)."},"updatedAt":{"type":"string","format":"date-time","description":"When any field on the row last changed."},"itemCount":{"type":["integer","null"],"description":"Number of items on the list."}}},"ListItem":{"type":"object","properties":{"itemId":{"type":"string","format":"uuid","description":"Identifier of the row on the list."},"entityType":{"type":"string","enum":["company","investor","person","round","job","product"],"description":"What the item points at."},"entityId":{"type":"string","format":"uuid","description":"Identifier of the entity itself."},"name":{"type":"string","description":"The entity's current name."},"slug":{"type":["string","null"],"description":"The entity's URL key."},"subtitle":{"type":["string","null"],"description":"One-line summary of the entity."},"score":{"type":["number","null"],"description":"Seedtable score, where the entity has one."},"note":{"type":["string","null"],"description":"Your note on the item."},"stage":{"type":"string","enum":["in_review","to_contact","emailed","contacted","invested"],"description":"CRM pipeline stage — the columns of the per-list kanban board."},"addedAt":{"type":"string","format":"date-time","description":"When it was added to the list."},"missing":{"type":"boolean","description":"True when the underlying entity has been deleted since it was saved."}}},"Follow":{"type":"object","properties":{"id":{"type":"string","format":"uuid","description":"Identifier of the follow itself, not of what it points at."},"entityType":{"type":"string","enum":["company","investor","person","category"],"description":"What kind of thing is followed."},"entityId":{"type":"string","format":"uuid","description":"The followed entity."},"name":{"type":["string","null"],"description":"Its current name. Null if it no longer exists."},"slug":{"type":["string","null"],"description":"Its URL key — the `path` for a category. Null if it no longer exists."},"url":{"type":["string","null"],"description":"Its page on Seedtable. Null if it no longer exists."},"source":{"type":"string","examples":["button","api","list","onboarding","newsletter_link"],"description":"What created the follow: `button` in the app, `api` through this route, `list` as a side effect of adding to a list, or `onboarding` / `newsletter_link`."},"createdAt":{"type":"string","format":"date-time","description":"When it was followed."}}}}},"paths":{"/companies":{"get":{"tags":["Companies"],"summary":"List companies.","operationId":"getCompanies","parameters":[{"name":"page","in":"query","required":false,"description":"1-indexed page number. Default 1.","schema":{"type":"integer"}},{"name":"limit","in":"query","required":false,"description":"Rows per page. Default 20, maximum 100.","schema":{"type":"integer"}},{"name":"q","in":"query","required":false,"description":"Full-text search over the company record.","schema":{"type":"string"}},{"name":"city","in":"query","required":false,"description":"Partial, case-insensitive match on city.","schema":{"type":"string"}},{"name":"country","in":"query","required":false,"description":"Country match on the company record. Alias-aware, so `UK` and `England` both resolve to `United Kingdom`; a partial string still matches as a substring.","schema":{"type":"string"}},{"name":"industry","in":"query","required":false,"description":"Partial, case-insensitive match on industry.","schema":{"type":"string"}},{"name":"funding_stage","in":"query","required":false,"description":"Funding stage. Repeatable — several values are OR'd within the facet.","schema":{"type":"string","enum":["pre_seed","seed","series_a","series_b","series_c","series_d","series_e","series_f","series_g","series_h","series_i","series_j","growth","debt","grant","ipo","acquired","other"]}},{"name":"category","in":"query","required":false,"description":"Curated category. Without an `hq_*` scope this is an industry PATH (`financial-services/fintech`, or a leaf slug) and matches the category AND its descendants — the same set the `/companies/industry/…` page lists. With an `hq_*` scope it is a sector slug matched exactly, and is repeatable.","schema":{"type":"string"}},{"name":"hq_city","in":"query","required":false,"description":"Companies headquartered in this city. Exact match through the locations table — an office here does not qualify.","schema":{"type":"string"}},{"name":"hq_country","in":"query","required":false,"description":"Companies headquartered in this country. Alias-aware (`England` counts as `United Kingdom`).","schema":{"type":"string"}},{"name":"hq_region","in":"query","required":false,"description":"Companies headquartered in this state/region.","schema":{"type":"string"}},{"name":"hq_continent","in":"query","required":false,"description":"Companies headquartered on this continent.","schema":{"type":"string"}},{"name":"min_score","in":"query","required":false,"description":"Minimum Seedtable score.","schema":{"type":"number"}},{"name":"max_score","in":"query","required":false,"description":"Maximum Seedtable score.","schema":{"type":"number"}},{"name":"min_employees","in":"query","required":false,"description":"Minimum headcount.","schema":{"type":"integer"}},{"name":"max_employees","in":"query","required":false,"description":"Maximum headcount.","schema":{"type":"integer"}},{"name":"min_raised","in":"query","required":false,"description":"Minimum total funding raised, in USD.","schema":{"type":"integer"}},{"name":"max_raised","in":"query","required":false,"description":"Maximum total funding raised, in USD.","schema":{"type":"integer"}},{"name":"raised_within","in":"query","required":false,"description":"Companies whose last round closed within this many months.","schema":{"type":"integer"}},{"name":"raised_after","in":"query","required":false,"description":"Last round on or after this date (YYYY-MM-DD).","schema":{"type":"string","format":"date"}},{"name":"raised_before","in":"query","required":false,"description":"Last round on or before this date (YYYY-MM-DD), inclusive of the whole day.","schema":{"type":"string","format":"date"}},{"name":"likely_to_hire","in":"query","required":false,"description":"Only companies flagged as likely to be hiring.","schema":{"type":"boolean"}},{"name":"likely_to_outsource","in":"query","required":false,"description":"Only companies flagged as likely to outsource.","schema":{"type":"boolean"}},{"name":"bootstrapped","in":"query","required":false,"description":"Self-funded companies — `true` for those with no disclosed institutional round, `false` to exclude them.","schema":{"type":"boolean"}},{"name":"uses_technology","in":"query","required":false,"description":"Companies on record as using a technology: linked to it directly, or buying a product that uses it. The technology's slug, as in seedtable.com/technologies/<slug>. Pair with `include=all`: many users are universities, hospitals and corporates, which the startup-only default leaves out.","schema":{"type":"string","examples":["water-purification","crispr"]}},{"name":"uses_supplier","in":"query","required":false,"description":"Companies on record as using a product made by this vendor. The vendor's slug, as in its seedtable.com URL.","schema":{"type":"string","examples":["merck-group","thermo-fisher-scientific"]}},{"name":"uses_product","in":"query","required":false,"description":"Companies on record as using this product. The product's slug, as in seedtable.com/products/<slug>.","schema":{"type":"string","examples":["milli-q","purelab"]}},{"name":"include","in":"query","required":false,"description":"`startups` (default) keeps the startup-only surface described above. `all` lifts it, returning every company row — investment vehicles, corporates and wound-down companies included. That is what a CSV export of the same list contains, so the API shortcut beside a download sends it.","schema":{"type":"string","enum":["startups","all"]}},{"name":"sort_by","in":"query","required":false,"description":"Field to sort by.","schema":{"type":"string","enum":["name","score","createdAt","updatedAt","employeeCount","totalFunding","foundedYear"]}},{"name":"sort_order","in":"query","required":false,"description":"Sort direction. Default desc.","schema":{"type":"string","enum":["asc","desc"]}}],"responses":{"200":{"description":"Success.","content":{