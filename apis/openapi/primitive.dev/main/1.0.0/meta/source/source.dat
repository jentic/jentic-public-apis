ers/ratelimit-policy-429"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"},"example":{"success":false,"error":{"code":"rate_limit_exceeded","message":"Rate limit exceeded"}}}}}}},"patch":{"operationId":"updateAgentConnectionSettings","tags":["Agent Connections"],"summary":"update Agent Connection Settings","description":"Update the organization agent settings. Set idle_hide_after_days to a whole number of days from 1 to 365, or null to turn auto-hide off. Turning it off, or raising it, shows again the agents that were hidden for idleness and no longer qualify. Manual hides are unchanged. Organization owners and admins only.","security":[{"BearerAuth":[]}],"parameters":[],"responses":{"200":{"description":"Success","headers":{"Cache-Control":{"description":"Credentials and status must not be cached.","schema":{"type":"string","const":"no-store"}},"ratelimit-limit":{"$ref":"#/components/headers/ratelimit-limit"},"ratelimit-remaining":{"$ref":"#/components/headers/ratelimit-remaining"},"ratelimit-reset":{"$ref":"#/components/headers/ratelimit-reset"},"ratelimit-policy":{"$ref":"#/components/headers/ratelimit-policy"}},"content":{"application/json":{"schema":{"type":"object","required":["success","data"],"properties":{"success":{"const":true},"data":{"type":"object","properties":{"idle_hide_after_days":{"anyOf":[{"type":"integer","minimum":1,"maximum":365},{"type":"null"}]}},"required":["idle_hide_after_days"],"additionalProperties":false}}}}}},"400":{"description":"Invalid request parameters","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"},"example":{"success":false,"error":{"code":"validation_error","message":"Invalid domain format"}}}}},"401":{"description":"Invalid or missing API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"},"example":{"success":false,"error":{"code":"unauthorized","message":"Invalid or missing API key"}}}},"headers":{"ratelimit-