tatus","created_at","updated_at","claimed_at","verified_at","last_seen_at","ownership_kind","owner_user_id","owner_active"],"additionalProperties":false},"PublicAddressNote":{"type":"object","additionalProperties":false,"properties":{"address":{"type":"string","format":"email","maxLength":254,"description":"Bare email address, normalized to lowercase. Plus tags are preserved."},"name":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$","description":"Case-sensitive note name. AGENT_INFO, AGENT_USES and AGENT_RUNTIME (where the agent runs, e.g. its runtime, machine and working directory) are conventions, with no required value schema."},"value":{"description":"Any JSON value. Both UTF-8 serialized JSON and stored JSONB text must fit within 65536 bytes."},"updated_at":{"type":"string","format":"date-time"}},"required":["address","name","value","updated_at"]},"AddressNote":{"type":"object","additionalProperties":false,"properties":{"address":{"type":"string","format":"email","maxLength":254,"description":"Bare email address, normalized to lowercase. Plus tags are preserved."},"name":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$","description":"Case-sensitive note name. AGENT_INFO, AGENT_USES and AGENT_RUNTIME (where the agent runs, e.g. its runtime, machine and working directory) are conventions, with no required value schema."},"value":{"description":"Any JSON value. Both UTF-8 serialized JSON and stored JSONB text must fit within 65536 bytes."},"updated_at":{"type":"string","format":"date-time"},"visibility":{"type":"string","enum":["private","public"]},"version":{"type":"string","pattern":"^[0-9]+$","maxLength":19,"description":"Monotonic version for this org, address and name, including deletion and recreation."},"created_at":{"type":"string","format":"date-time"}},"required":["address","name","value","updated_at","visibility","version","created_at"]},"PutAddressNoteRequest":{"type":"object","additionalProperties":false,"required":["value"],"properties":{"value":{"description":"Any JSON value. Both UTF-8 serialized JSON and stored JSONB text must fit within 65536 bytes."},"visibility":{"type":"string","enum":["private","public"],"description":"New notes default to private. Omit to retain current visibility. Public edits become public immediately. Publishing requires current active verified domain ownership."},"if_absent":{"type":"boolean","description":"When true, fail with 409 if a live note exists. Mutually exclusive with if_version."},"if_version":{"type":"string","pattern":"^[0-9]+$","maxLength":19,"description":"Monotonic version for this org, address and name, including deletion and recreation."}},"not":{"required":["if_absent","if_version"],"properties":{"if_absent":{"const":true}}}},"Contact":{"type":"object","additionalProperties":false,"properties":{"address":{"type":"string","format":"email","maxLength":254,"description":"Bare email address; trim and lowercase, preserving dots and plus tags."},"display_name":{"type":["string","null"],"maxLength":200},"version":{"type":"string","format":"uuid","description":"Opaque CAS token. Changes on mutations and cannot be reused after deletion/recreation."},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"}},"required":["address","display_name","version","created_at","updated_at"]},"AgentContact":{"type":"object","additionalProperties":false,"properties":{"agent_address":{"type":"string","format":"email","maxLength":254,"description":"Bare email address; trim and lowercase, preserving dots and plus tags."},"contact_address":{"type":"string","format":"email","maxLength":254,"description":"Bare email address; trim and lowercase, preserving dots and plus tags."},"purpose":{"type":["string","null"],"maxLength":2000},"notify":{"type":"boolean"},"notify_since":{"type":["string","null"],"format":"date-time"},"notification_generation":{"type":["string","null"],"format":"uuid"},"version":{"type":"string","format":"uuid","description":"Opaque CAS token. Changes on mutations and cannot be reused after deletion/recreation."},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"}},"required":["agent_address","contact_address","purpose","notify","notify_since","notification_generation","version","created_at","updated_at"]},"PutContactRequest":{"type":"object","additionalProperties":false,"properties":{"display_name":{"type":["string","null"],"maxLength":200},"if_absent":{"type":"boolean","const":true},"if_version":{"type":"string","format":"uuid","description":"Opaque CAS token. Changes on mutations and cannot be reused after deletion/recreation."}},"oneOf":[{"required":["if_absent"],"not":{"required":["if_version"]}},{"required":["if_version"],"not":{"required":["if_absent"]}}]},"PutAgentContactRequest":{"type":"object","additionalProperties":false,"properties":{"purpose":{"type":["string","null"],"maxLength":2000},"notify":{"type":"boolean"},"if_absent":{"type":"boolean","const":true},"if_version":{"type":"string","format":"uuid","description":"Opaque CAS token. Changes on mutations and cannot be reused after deletion/recreation."}},"oneOf":[{"required":["if_absent"],"not":{"required":["if_version"]}},{"required":["if_version"],"not":{"required":["if_absent"]}}]},"ThreadMute":{"type":"object","additionalProperties":false,"required":["thread_id","address","muted","muted_at"],"properties":{"thread_id":{"type":"string","format":"uuid"},"address":{"type":"string","description":"The receiving address the mute applies to, lowercased."},"muted":{"type":"boolean"},"muted_at":{"type":["string","null"],"format":"date-time"}}},"EmailSignalInput":{"type":"object","additionalProperties":false,"required":["kind"],"properties":{"kind":{"type":"string","enum":["read","working","typing"],"description":"`read`: you read the email. `working`: you are working on it. `typing`: you are writing a reply."},"expires_in_seconds":{"type":"integer","minimum":1,"maximum":60,"description":"working and typing only: how long the signal holds. Defaults to 30. Not allowed for read."}}},"ThreadReadState":{"type":"object","additionalProperties":false,"required":["thread_id","last_read_at","last_read_email_id","unread_count","updated_at"],"properties":{"thread_id":{"type":"string","format":"uuid"},"last_read_at":{"type":["string","null"],"format":"date-time","description":"Arrival time of the newest message the member has read in this thread, in microsecond UTC form, or null when the member never marked it. Sending it back as `up_to` names the same instant; a timestamp cursor covers every message that arrived at that instant, so it is at or ahead of an id cursor at the same instant."},"last_read_email_id":{"type":["string","null"],"format":"uuid","description":"The email or sent email the cursor was set from, or null (never marked, or marked by `up_to`)."},"unread_count":{"type":"integer","minimum":0,"description":"Inbound mail in the thread that arrived after the cursor, counting only mail from others: informational signals (`fyi: true`, such as read and acknowledgement notices) and mail the member sent from their own address are not counted. A thread the member never marked counts all of it."},"updated_at":{"type":["string","null"],"format":"date-time","description":"When the cursor last moved, or null when it never did. Orders the `updated_since` change feed."}}},"MarkThreadReadResult":{"type":"object","additionalProperties":false,"required":["thread_id","last_read_at","last_read_email_id","unread_count","updated_at","advanced"],"properties":{"thread_id":{"type":"string","format":"uuid"},"last_read_at":{"type":["string","null"],"format":"date-time","description":"Arrival time of the newest message the member has read in this thread, in microsecond UTC form, or null when the member never marked it. Sending it back as `up_to` names the same instant; a timestamp cursor covers every message that arrived at that instant, so it is at or ahead of an id cursor at the same instant."},"last_read_email_id":{"type":["string","null"],"format":"uuid","description":"The email or sent email the cursor was set from, or null (never marked, or marked by `up_to`)."},"unread_count":{"type":["integer","null"],"minimum":0,"description":"Inbound mail in the thread that arrived after the cursor, counting only mail from others: informational signals (`fyi: true`, such as read and acknowledgement notices) and mail the member sent from their own address are not counted. A thread the member never marked counts all of it. Null only together with `state_unavailable`."},"updated_at":{"type":["string","null"],"format":"date-time","description":"When the cursor last moved, or null when it never did. Orders the `updated_since` change feed."},"advanced":{"type":"boolean","description":"False when the request named a position at or behind the stored cursor, so nothing changed."},"state_unavailable":{"type":"boolean","const":true,"description":"Present only when the cursor write committed but the unread count could not be read afterwards. The cursor fields are the committed ones and `unread_count` is null: treat the write as done and read the count later from `GET /threads/read-state` rather than retrying the write."}}},"MarkThreadReadInput":{"type":"object","additionalProperties":false,"description":"Name exactly one of `up_to_email_id` or `up_to`.","properties":{"up_to_email_id":{"type":"string","format":"uuid","description":"An email or sent email in this thread. It and everything that arrived before it are read."},"up_to":{"type":"string","format":"date-time","description":"Everything that arrived at or before this instant is read. A future instant is clamped to now."}}},"EmailReadableLink":{"type":"object","additionalProperties":false,"required":["n","url"],"properties":{"n":{"type":"integer","minimum":1,"description":"The number in this link's `[n]` marker in `body_text`."},"url":{"type":"string","description":"The target as the email wrote it. It can be long, and can be a tracking redirect."}}},"EmailReadableAttachment":{"type":"object","additionalProperties":false,"description":"One attached file. Download it with `GET /emails/{id}/attachments/{part_index}`.","required":["filename","content_type","size_bytes","part_index"],"properties":{"filename":{"type":["string","null"],"description":"The name the sender gave it, if any."},"content_type":{"type":["string","null"],"description":"The declared media type, such as `application/pdf`."},"size_bytes":{"type":["integer","null"],"minimum":0,"description":"Size of the decoded file."},"part_index":{"type":["integer","null"],"minimum":0,"description":"Its position among the attachments."}}},"EmailReadable":{"type":"object","additionalProperties":false,"description":"What an inbound email says, as plain text, with the fields that identify it.","required":["id","thread_id","received_at","from","to","subject","parse_status","preheader","body_text","body_source","body_chars","body_offset","body_next_offset","body_incomplete","quoted_chars_removed","image_count","link_count","attachments"],"properties":{"id":{"type":"string","format":"uuid","description":"The inbound email id."},"thread_id":{"type":["string","null"],"format":"uuid","description":"Its conversation, once it has been placed in one."},"received_at":{"type":"string","format":"date-time","description":"When it was received."},"from":{"type":"string","description":"The From header with its display name, or the bare sender address when there is none."},"to":{"type":"string","description":"The address it was delivered to."},"subject":{"type":["string","null"],"description":"The subject line."},"parse_status":{"type":["string","null"],"enum":["pending","processing","complete","failed",null],"description":"How far parsing has got, as on `GET /emails/{id}`. While it is `pending` or `processing`, the body, `thread_id` and attachments may be missing or change, so read again shortly. `complete` is final. `failed` is final too: parsing ended without them, so they may be empty. Null on an email older than this field, and before parsing is recorded."},"preheader":{"type":["string","null"],"description":"The preview line a mail client shows beside the subject, hidden at the top of the body. Not repeated in `body_text`."},"body_text":{"type":"string","description":"One page of the readable body: the words of the email in reading order. Each link is a `[n]` marker beside its label, without its target (see `links`). Hidden content and the quoted history below a reply are left out. Empty when there is nothing to read or the content is withheld."},"body_source":{"type":"string","enum":["html","text","none"],"description":"The stored body the text came from, or `none` when there was nothing to read."},"body_chars":{"type":"integer","minimum":0,"description":"Length in characters of the whole readable body, across every page."},"body_offset":{"type":"integer","minimum":0,"description":"Where this page starts in the readable body: the `offset` sent, or 0."},"body_next_offset":{"type":["integer","null"],"minimum":0,"description":"The `offset` of the next page. Null at the end of the body."},"body_incomplete":{"type":"boolean","description":"True when the HTML body was nested too deeply to read to the end and there was no text body to use: the readable body stops early. Use the detail read for the rest."},"quoted_chars_removed":{"type":"integer","minimum":0,"description":"Characters of quoted history (earlier messages a reply repeats) removed."},"image_count":{"type":"integer","minimum":0,"description":"Images in the body. Many images with little text means the email says most of it in pictures."},"link_count":{"type":"integer","minimum":0,"description":"Different links the whole readable body refers to, across every page."},"links":{"type":"array","items":{"$ref":"#/components/schemas/EmailReadableLink"},"description":"Link targets. Present only when the request carried `links`."},"attachments":{"type":"array","items":{"$ref":"#/components/schemas/EmailReadableAttachment"},"description":"The attached files. Empty when there are none or the content is withheld."}}},"Change":{"type":"object","additionalProperties":false,"description":"One invalidation: what changed, by id, never its content. Every field is present; fields that do not apply to the kind are null. Apply idempotently: a change can repeat.","required":["kind","email_id","sent_email_id","thread_id","status","agent_address","reason","changed_at"],"properties":{"kind":{"type":"string","enum":["email.visible","email.updated","email.deleted","sent_email.created","sent_email.updated","sent_email.deleted","thread.read_state_changed","thread.mute_changed","agent.changed","access.changed"],"description":"`email.visible`: an inbound email became visible to this credential (arrived, or its sender-authentication hold was released). `email.updated`: something a list row or conversation shows changed. `email.deleted`: gone, or withdrawn from view. `sent_email.created` / `sent_email.updated`: a send appeared or changed; `status` is its current status, and several changes between two reads collapse into one entry. Created is a hint (first committed after the cursor): treat both as upsert, including `sent_email.updated` for an id you have not seen. `sent_email.deleted`: the send was deleted. `thread.read_state_changed`: the signed-in member's read cursor for `thread_id` moved, on any device. `thread.mute_changed`: `thread_id` was muted or unmuted for an address this credential reads, which changes the `muted` flag and `exclude_muted` results of its mail. `agent.changed`: an agent in the directory changed (connected, disconnected, renamed, hidden, listed, presence extended, receiver live). `access.changed`: this credential's own access changed; rebuild every snapshot from `since=start`."},"email_id":{"type":["string","null"],"format":"uuid","description":"email.* kinds."},"sent_email_id":{"type":["string","null"],"format":"uuid","description":"sent_email.* kinds."},"thread_id":{"type":["string","null"],"format":"uuid","description":"The conversation, when known. Null for a connected agent reading a send, or its deletion, that it received but did not send, matching what GET /sent-emails withholds. Inbound mail is announced when it becomes visible, which can be before its conversation is resolved, so `email.visible` can carry null; resolving or changing the conversation is always announced afterwards as `email.updated` with the `thread_id`."},"status":{"type":["string","null"],"description":"sent_email.created and sent_email.updated: the send's current status."},"agent_address":{"type":["string","null"],"description":"agent.changed: the agent's address."},"reason":{"type":["string","null"],"enum":["membership","agent_connection",null],"description":"access.changed: `membership` (the member's role or membership) or `agent_connection` (this agent connection's status, owner or generation)."},"changed_at":{"type":"string","format":"date-time","description":"The commit position in microsecond UTC form. Orders the feed; not a business timestamp."}}},"ChangePage":{"type":"object","additionalProperties":false,"required":["changes","next_cursor","has_more","baseline"],"properties":{"changes":{"type":"array","items":{"$ref":"#/components/schemas/Change"},"description":"Oldest first, in commit order."},"next_cursor":{"type":"string","description":"Always present. Send it unchanged as `since` next time, and store it only after applying the page. It is exactly the `since` you sent when nothing at all happened after it; it moves past changes this credential cannot see, so the page can be empty with a new cursor."},"has_more":{"type":"boolean","description":"More changes are already pending: call again at once, without waiting."},"baseline":{"type":"boolean","description":"True only for a `since=start` request, whose page is always empty."}}},"PutM