[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"}},"evidence":{"type":"string","minLength":1,"maxLength":20000,"pattern":"\\S"}},"required":["id","text","source_message_ids","evidence"],"additionalProperties":false}}},"required":["kind","topic_id","sources","input_digest","provider","summary","summary_source_message_ids","tasks"],"additionalProperties":false}]},"version":{"type":"integer","exclusiveMinimum":0,"maximum":9007199254740991},"mutation_id":{"type":"string","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},"updated_at":{"type":"string"}},"required":["generation","version","mutation_id","updated_at"],"additionalProperties":false}},"required":["mailbox","item"],"additionalProperties":false},"TemplateVendorConsumption":{"type":"object","additionalProperties":false,"properties":{"slug":{"type":"string","minLength":1},"required":{"type":"boolean","default":true}},"required":["slug"]},"SendMailIdempotencyReplay":{"type":"object","description":"Present only when the request was answered with an existing send instead of making a new one (`idempotent_replay: true`). Nothing was sent for this request. Says how the idempotency key was derived and which send the request collapsed onto.","required":["replayed","key_source","original_sent_email_id","original_created_at","window_seconds"],"properties":{"replayed":{"type":"boolean","const":true,"description":"Always `true`. The object is absent on a request that made a send of its own."},"key_source":{"type":"string","enum":["explicit","auto_content","function_trigger"],"description":"`explicit`: the request carried an `Idempotency-Key` header. `auto_content`: no header was sent, so the key was derived from the canonical request content (recipients included) and a fixed 5-minute window; an identical send inside the same window was not sent again. `function_trigger`: no header on a send made by a Function, so the key was derived from the content, the Function and the inbound email (or event) that invoked it."},"original_sent_email_id":{"type":"string","format":"uuid","description":"The send this request collapsed onto. Same value as `id`."},"original_created_at":{"type":["string","null"],"format":"date-time","description":"When that send was created."},"window_seconds":{"type":["integer","null"],"description":"Length of the content window (300) when an `auto_content` key matched on content. Null for `explicit` and `function_trigger` keys, which have no window, and for a keyless reply matched because its parent already has a reply (`dedup_reason: parent_already_replied`)."}}}},"headers":{"IdempotentReplayed":{"description":"Set to `true` when the request was answered with an existing send instead of making a new one. Absent on a request that sent. On a batch it means at least one message replayed; see `Idempotent-Replayed-Count`.","schema":{"type":"string","enum":["true"]}},"IdempotentReplayedCount":{"description":"Batch sends only: how many messages were answered with an existing send instead of being sent. Absent when every message sent.","schema":{"type":"integer","minimum":1}},"IdempotencyKey":{"description":"Effective idempotency key for this request. When the caller supplies an `Idempotency-Key` request header the same value is echoed; otherwise the server derives one from the canonical payload hash and, on sends, a fixed 5-minute window, so an identical keyless send inside the same window replays the first instead of sending again (the response then carries `Idempotent-Replayed: true`). Use this to correlate a request to its stored sent-email record via the `idempotency_key` filter on `GET /sent-emails`.","schema":{"type":"string","minLength":1,"maxLength":255}},"ratelimit-limit":{"description":"Maximum number of requests allowed in the current window. Example: a standard authenticated organization.","schema":{"type":"integer","minimum":1,"example":3000}},"ratelimit-remaining":{"description":"Remaining requests in the current window.","schema":{"type":"integer","minimum":0,"example":2998}},"ratelimit-reset":{"description":"Unix timestamp (seconds) when the current window resets.","schema":{"type":"integer","example":1700000060}},"ratelimit-policy":{"description":"Rate-limit policy in `limit;w=seconds` format. Example: a standard authenticated organization.","schema":{"type":"string","example":"3000;w=60"}},"ratelimit-limit-unauthenticated":{"description":"Request limit of the bucket this request was charged to: the unauthenticated IP bucket for a missing or invalid bearer token (example), or the organization bucket when an authenticated request is refused.","schema":{"type":"integer","minimum":1,"example":120}},"ratelimit-remaining-unauthenticated":{"description":"Requests remaining in the bucket this request was charged to (see ratelimit-limit). Absent while the limiter is unavailable.","schema":{"type":"integer","minimum":0,"example":119}},"ratelimit-reset-unauthenticated":{"description":"Unix timestamp (seconds) when the bucket this request was charged to resets. Absent while the limiter is unavailable.","schema":{"type":"integer","example":1700000060}},"ratelimit-policy-unauthenticated":{"description":"Policy of the bucket this request was charged to, in `limit;w=seconds` format. The example is the unauthenticated IP policy.","schema":{"type":"string","example":"120;w=60"}},"ratelimit-limit-429":{"description":"Limit of the limiter that rejected this request: the API limit (example), a send cap, or a per-resource limit. Absent, with the other ratelimit headers, when that limiter reports only a wait.","schema":{"type":"integer","minimum":1,"example":3000}},"ratelimit-remaining-429":{"description":"Requests left in the limiter that rejected this request.","schema":{"type":"integer","minimum":0,"example":0}},"ratelimit-policy-429":{"description":"That limiter as `limit;w=seconds`, with its own window: 60 for API limits, 3600 or 86400 for send caps.","schema":{"type":"string","example":"3000;w=60"}}}},"x-tag-specs":"https://api.primitive.dev/v1/openapi/tags"}