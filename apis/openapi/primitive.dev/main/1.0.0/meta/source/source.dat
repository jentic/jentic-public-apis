 acceptance of a received contact request","description":"Validates a received contact request (authenticated sender, valid unexpired primitive.contact/1 request, delivered to you) and returns the POST /send-mail call that accepts it, threaded to the request and addressed to its authenticated sender (never to a Reply-To). Nothing is sent and no contact preference changes. Preparing twice returns the same message and Idempotency-Key.","tags":["Contacts"],"security":[{"BearerAuth":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"required":["email_id"],"properties":{"email_id":{"type":"string","format":"uuid","description":"The received contact request email."}}}}}},"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"allOf":[{"$ref":"#/components/schemas/SuccessEnvelope"},{"type":"object","properties":{"data":{"type":"object","required":["request","send"],"properties":{"request":{"type":"object","description":"Identity of the prepared step. Keep interaction_id, step_id and expires_at to match a later acceptance.","properties":{"interaction_id":{"type":"string"},"step_id":{"type":"string","format":"uuid"},"prev_step_id":{"type":["string","null"],"format":"uuid"},"expires_at":{"type":"string","format":"date-time"}}},"send":{"type":"object","description":"The exact request to make next, unchanged: method, path, headers (including Idempotency-Key) and JSON body.","properties":{"method":{"type":"string","const":"POST"},"path":{"type":"string"},"headers":{"type":"object","additionalProperties":{"type":"string"}},"body":{"type":"object","additionalProperties":true}}}}}}}]}}},"headers":{"ratelimit-limit":{"$ref":"#/components/headers/ratelimit-limit"},"ratelimit-remaining":{"$ref":"#/components/headers/ratelimit-remaining"},"ratelimit-reset":{"$ref":"#/components/headers/ratelimit-reset"},"ratelimit-policy":{"$ref":"#/components/headers/ratelimit-policy"}}},"400":{"descr